// 4-way set-associative read-only instruction cache
// 4KB: 16 sets × 4 ways × 64B lines (16 words per line, 32-bit words)
// Blocking: stalls pipeline on miss until line fill completes
// Replacement: pseudo-LRU (3-bit tree per set)
//
// Address breakdown (64-bit byte address):
//   [63:10] tag  |  [9:6] index (4 bits, 16 sets)  |  [5:2] offset (4 bits, 16 words)  |  [1:0] byte
pub module icache (
    clk: input clock,
    rst: input reset,
    // CPU side (32-bit instruction output + next word for straddled instrs)
    i_addr      : input  logic<64>,
    i_ren       : input  logic    ,
    i_flush     : input  logic    , // FENCE.I: invalidate all entries
    o_rdata     : output logic<32>,
    o_rdata_next: output logic<32>, // next 32-bit word (for straddled 4-byte instrs at halfword boundary)
    o_stall     : output logic    ,
    // Memory side (32-bit read interface)
    o_mem_addr : output logic<64>,
    i_mem_rdata: input  logic<32>,
    o_mem_ren  : output logic    ,
) {
    // Address decomposition
    let tag     : logic<54> = i_addr[63:10];
    let index   : logic<4>  = i_addr[9:6];
    let offset  : logic<4>  = i_addr[5:2];
    let data_idx: logic<8>  = {index, offset};

    // Cache storage: 4 ways
    var valid_0: logic     [16] ;
    var valid_1: logic     [16] ;
    var valid_2: logic     [16] ;
    var valid_3: logic     [16] ;
    var tags_0 : logic<54> [16] ;
    var tags_1 : logic<54> [16] ;
    var tags_2 : logic<54> [16] ;
    var tags_3 : logic<54> [16] ;
    var data_0 : logic<32> [256]; // 16 sets × 16 words
    var data_1 : logic<32> [256];
    var data_2 : logic<32> [256];
    var data_3 : logic<32> [256];

    // Pseudo-LRU tree: 3 bits per set
    // bit[2]: root → 0=left(way 0,1), 1=right(way 2,3)
    // bit[1]: left child → 0=way 0, 1=way 1
    // bit[0]: right child → 0=way 2, 1=way 3
    var plru: logic<3> [16];

    // Cache lookup: per-way hit
    let hit_0    : logic = valid_0[index] && tags_0[index] == tag;
    let hit_1    : logic = valid_1[index] && tags_1[index] == tag;
    let hit_2    : logic = valid_2[index] && tags_2[index] == tag;
    let hit_3    : logic = valid_3[index] && tags_3[index] == tag;
    let cache_hit: logic = hit_0 || hit_1 || hit_2 || hit_3;

    // Hit way select (for data read)
    let hit_way: logic<2> = if hit_0 ? 2'd0 : if hit_1 ? 2'd1 : if hit_2 ? 2'd2 : 2'd3;

    // Read data from hit way
    let rdata_0: logic<32> = data_0[data_idx];
    let rdata_1: logic<32> = data_1[data_idx];
    let rdata_2: logic<32> = data_2[data_idx];
    let rdata_3: logic<32> = data_3[data_idx];

    // Fill state
    var filling      : logic    ;
    var fill_count   : logic<4> ; // 0..15, which word to fill
    var fill_index   : logic<4> ; // index being filled
    var fill_tag     : logic<54>; // tag being filled
    var fill_way     : logic<2> ; // which way to fill
    let fill_data_idx: logic<8>  = {fill_index, fill_count};

    // Miss: read request, not hit, not already filling
    let miss: logic = i_ren && !cache_hit && !filling;

    // PLRU victim selection: choose replacement way from tree
    let plru_bits: logic<3> = plru[index];
    // Prefer invalid way over PLRU eviction
    let has_invalid: logic    = !valid_0[index] || !valid_1[index] || !valid_2[index] || !valid_3[index];
    let invalid_way: logic<2> = if !valid_0[index] ? 2'd0 : if !valid_1[index] ? 2'd1 : if !valid_2[index] ? 2'd2 : 2'd3;
    let plru_way   : logic<2> = {plru_bits[2], if !plru_bits[2] ? plru_bits[1] : plru_bits[0]};
    let victim_way : logic<2> = if has_invalid ? invalid_way : plru_way;

    // Next word for straddled instruction support
    let next_addr     : logic<64> = {i_addr[63:2], 2'b00} + 64'd4;
    let next_tag      : logic<54> = next_addr[63:10];
    let next_index    : logic<4>  = next_addr[9:6];
    let next_offset   : logic<4>  = next_addr[5:2];
    let next_same_line: logic     = offset != 4'd15;
    // Next-line hit: check all 4 ways
    let next_hit_0   : logic     = valid_0[next_index] && tags_0[next_index] == next_tag;
    let next_hit_1   : logic     = valid_1[next_index] && tags_1[next_index] == next_tag;
    let next_hit_2   : logic     = valid_2[next_index] && tags_2[next_index] == next_tag;
    let next_hit_3   : logic     = valid_3[next_index] && tags_3[next_index] == next_tag;
    let next_hit     : logic     = if next_same_line ? cache_hit : (next_hit_0 || next_hit_1 || next_hit_2 || next_hit_3);
    let next_data_idx: logic<8>  = {next_index, next_offset};
    let next_rdata_0 : logic<32> = data_0[next_data_idx];
    let next_rdata_1 : logic<32> = data_1[next_data_idx];
    let next_rdata_2 : logic<32> = data_2[next_data_idx];
    let next_rdata_3 : logic<32> = data_3[next_data_idx];

    // Straddle miss detection
    let straddled_4byte: logic = i_addr[1] && o_rdata[17:16] == 2'b11;
    let straddle_miss  : logic = i_ren && cache_hit && !next_same_line && !next_hit && !filling && straddled_4byte;

    // PLRU victim for straddle miss (different index)
    let straddle_plru    : logic<3> = plru[next_index];
    let straddle_invalid : logic    = !valid_0[next_index] || !valid_1[next_index] || !valid_2[next_index] || !valid_3[next_index];
    let straddle_inv_way : logic<2> = if !valid_0[next_index] ? 2'd0 : if !valid_1[next_index] ? 2'd1 : if !valid_2[next_index] ? 2'd2 : 2'd3;
    let straddle_plru_way: logic<2> = {straddle_plru[2], if !straddle_plru[2] ? straddle_plru[1] : straddle_plru[0]};
    let straddle_victim  : logic<2> = if straddle_invalid ? straddle_inv_way : straddle_plru_way;

    always_ff (clk, rst) {
        if_reset {
            filling    = 1'b0;
            fill_count = 4'd0;
            fill_index = 4'd0;
            fill_tag   = '0;
            fill_way   = 2'd0;
            for i in 0..16 {
                valid_0[i] = 1'b0;
                valid_1[i] = 1'b0;
                valid_2[i] = 1'b0;
                valid_3[i] = 1'b0;
            }
        } else if i_flush {
            for i in 0..16 {
                valid_0[i] = 1'b0;
                valid_1[i] = 1'b0;
                valid_2[i] = 1'b0;
                valid_3[i] = 1'b0;
            }
            filling = 1'b0;
        } else if filling {
            // Fill one word per cycle from memory
            if fill_way == 2'd0 {
                data_0[fill_data_idx] = i_mem_rdata;
            }
            if fill_way == 2'd1 {
                data_1[fill_data_idx] = i_mem_rdata;
            }
            if fill_way == 2'd2 {
                data_2[fill_data_idx] = i_mem_rdata;
            }
            if fill_way == 2'd3 {
                data_3[fill_data_idx] = i_mem_rdata;
            }
            if fill_count == 4'd15 {
                // Fill complete: update tag and valid
                if fill_way == 2'd0 {
                    tags_0[fill_index]  = fill_tag;
                    valid_0[fill_index] = 1'b1;
                }
                if fill_way == 2'd1 {
                    tags_1[fill_index]  = fill_tag;
                    valid_1[fill_index] = 1'b1;
                }
                if fill_way == 2'd2 {
                    tags_2[fill_index]  = fill_tag;
                    valid_2[fill_index] = 1'b1;
                }
                if fill_way == 2'd3 {
                    tags_3[fill_index]  = fill_tag;
                    valid_3[fill_index] = 1'b1;
                }
                filling = 1'b0;
            } else {
                fill_count = fill_count + 4'd1;
            }
        } else if miss {
            fill_index = index;
            fill_tag   = tag;
            fill_way   = victim_way;
            fill_count = 4'd0;
            filling    = 1'b1;
        } else if straddle_miss {
            fill_index = next_index;
            fill_tag   = next_tag;
            fill_way   = straddle_victim;
            fill_count = 4'd0;
            filling    = 1'b1;
        }

        // Update PLRU on cache hit (point tree AWAY from accessed way)
        if cache_hit && i_ren && !filling {
            if hit_way[1] == 1'b0 {
                // Accessed way 0 or 1 → root points right, update left child
                plru[index][2] = 1'b1;
                plru[index][1] = if hit_way[0] ? 1'b0 : 1'b1;
            } else {
                // Accessed way 2 or 3 → root points left, update right child
                plru[index][2] = 1'b0;
                plru[index][0] = if hit_way[0] ? 1'b0 : 1'b1;
            }
        }
    }

    // Read data: select from hit way. On miss, return NOP (32'h00000013)
    // instead of `i_mem_rdata`. The previous behavior would return the
    // current word being filled into a different line — fine if the
    // pipeline always stalls on cache_stall, but on `redirect_ok` the
    // hazard unit overrides cache_stall and IF/ID can latch garbage.
    // NOP is safe: decode produces a bubble, fetch will retry once the
    // fill completes.
    assign o_rdata = if hit_0 ? rdata_0 : if hit_1 ? rdata_1 : if hit_2 ? rdata_2 : if hit_3 ? rdata_3 : 32'h00000013;

    // Next word: for straddled instruction support
    assign o_rdata_next = if next_same_line ?
        // Same line: use same hit way
        (if hit_0 ?
            data_0[next_data_idx]
        : if hit_1 ?
            data_1[next_data_idx]
        : if hit_2 ?
            data_2[next_data_idx]
        :
            data_3[next_data_idx]
        )
    :
        // Cross line: check next line's ways
        (if next_hit_0 ?
            next_rdata_0
        : if next_hit_1 ?
            next_rdata_1
        : if next_hit_2 ?
            next_rdata_2
        : if next_hit_3 ?
            next_rdata_3
        :
            32'd0
        )
    ;

    // Stall on miss, straddle miss, or during fill
    assign o_stall = filling || miss || straddle_miss;

    // Memory address: during fill, sequential word addresses
    assign o_mem_addr = if filling ? {fill_tag, fill_index, fill_count, 2'b00} : i_addr;

    assign o_mem_ren = i_ren || filling;
}
