// icache_array: the storage and fill engine of the instruction cache.
//
// 4-way set-associative, 64-byte lines, 2^INDEX_W sets (INDEX_W = 7 is 32 KiB),
// pseudo-LRU replacement. Read-only from the CPU side; the CPU-side protocol
// (request/response, IDs, MISS responses, uncached fetch) lives in `icache`,
// which instantiates this module.
//
// Lookup (combinational): i_rd_pa selects the 256-bit block {index, pa[5]};
// o_hit is set when the line is valid in a way that is not being refilled,
// or when it is the line being filled and its dwords up to i_rd_last_dw have
// already arrived (streaming). o_blk is that way's block.
//
// Fill: i_fill_start latches the line and picks the victim (an invalid way,
// else PLRU); then the k-th i_fill_beat writes dword k of it. The 8th beat
// writes the tag and sets valid, unless an i_inval_all hit the fill, which
// leaves the line invalid (the beats are still consumed so that the slot owner
// stays in lockstep with the stream). The victim way is excluded from lookup
// from start to the end of the fill (hit-under-fill on every other way).
pub module icache_array #(
    param INDEX_W: u32 = 7,
) (
    clk           : input  clock     ,
    rst           : input  reset     ,
    i_rd_valid    : input  logic     ,
    i_rd_pa       : input  logic<56> ,
    i_rd_last_dw  : input  logic<3>  , // last dword of the line the lookup needs
    o_hit         : output logic     ,
    o_blk         : output logic<256>,
    i_inval_all   : input  logic     ,
    i_fill_start  : input  logic     ,
    i_fill_line   : input  logic<50> ,
    i_fill_beat   : input  logic     ,
    i_fill_data   : input  logic<64> ,
    o_filling     : output logic     ,
    o_fill_line   : output logic<50> ,
    o_fill_last   : output logic     , // the 8th beat is this cycle
    o_fill_aborted: output logic     , // with o_fill_last: the line was not installed
) {
    const SETS : u32 = 1 << INDEX_W;
    const TAG_W: u32 = 50 - INDEX_W;

    let tag  : logic<TAG_W>   = i_rd_pa[55:INDEX_W + 6];
    let index: logic<INDEX_W> = i_rd_pa[INDEX_W + 5:6];

    // A 256-bit block holding dword dw at slot s, else 0 (fill write value and mask).
    function wr_slot (
        s : input logic<2> ,
        dw: input logic<64>,
    ) -> logic<256> {
        return {
            if s == 2'd3 ? dw : 64'd0, if s == 2'd2 ? dw : 64'd0, if s == 2'd1 ? dw : 64'd0, if s == 2'd0 ? dw : 64'd0,
        };
    }

    var valid_0: logic        [SETS]    ;
    var valid_1: logic        [SETS]    ;
    var valid_2: logic        [SETS]    ;
    var valid_3: logic        [SETS]    ;
    var tags_0 : logic<TAG_W> [SETS]    ;
    var tags_1 : logic<TAG_W> [SETS]    ;
    var tags_2 : logic<TAG_W> [SETS]    ;
    var tags_3 : logic<TAG_W> [SETS]    ;
    var data_0 : logic<256>   [SETS * 2];
    var data_1 : logic<256>   [SETS * 2];
    var data_2 : logic<256>   [SETS * 2];
    var data_3 : logic<256>   [SETS * 2];

    // PLRU tree per set: bit 2 root (0 = ways 0/1), bit 1 left child, bit 0 right child.
    var plru: logic<3> [SETS];

    var filling     : logic         ;
    var fill_count  : logic<3>      ;
    var fill_index  : logic<INDEX_W>;
    var fill_tag    : logic<TAG_W>  ;
    var fill_way    : logic<2>      ;
    var fill_aborted: logic         ;

    // Lookup with the victim way of an in-flight fill excluded.
    let fx   : logic    = filling && fill_index == index;
    let hit_0: logic    = valid_0[index] && tags_0[index] == tag && !(fx && fill_way == 2'd0);
    let hit_1: logic    = valid_1[index] && tags_1[index] == tag && !(fx && fill_way == 2'd1);
    let hit_2: logic    = valid_2[index] && tags_2[index] == tag && !(fx && fill_way == 2'd2);
    let hit_3: logic    = valid_3[index] && tags_3[index] == tag && !(fx && fill_way == 2'd3);
    let hit_c: logic    = hit_0 || hit_1 || hit_2 || hit_3;
    let way_c: logic<2> = {hit_2 || hit_3, hit_1 || hit_3};

    // Streaming: dwords 0..fill_count-1 of the line being filled are written.
    let stream: logic = filling && !fill_aborted && {fill_tag, fill_index} == {tag, index} && i_rd_last_dw
        <: fill_count;

    let blk_i : logic<INDEX_W + 1> = {index, i_rd_pa[5]};
    let rd_way: logic<2>           = if hit_c ? way_c : fill_way;
    assign o_hit = i_rd_valid && (hit_c || stream);
    assign o_blk = if rd_way == 2'd0 ?
        data_0[blk_i]
    : if rd_way == 2'd1 ?
        data_1[blk_i]
    : if rd_way == 2'd2 ?
        data_2[blk_i]
    :
        data_3[blk_i]
    ;

    // Victim of the line being started: an invalid way first, else PLRU.
    let s_tag  : logic<TAG_W>   = i_fill_line[49:INDEX_W];
    let s_index: logic<INDEX_W> = i_fill_line[INDEX_W - 1:0];
    let s_plru : logic<3>       = plru[s_index];
    let s_way  : logic<2>       = if !valid_0[s_index] ?
        2'd0
    : if !valid_1[s_index] ?
        2'd1
    : if !valid_2[s_index] ?
        2'd2
    : if !valid_3[s_index] ?
        2'd3
    :
        {s_plru[2], if !s_plru[2] ? s_plru[1] : s_plru[0]}
    ;

    let last : logic              = filling && i_fill_beat && fill_count == 3'd7;
    let f_blk: logic<INDEX_W + 1> = {fill_index, fill_count[2]};
    let f_new: logic<256>         = wr_slot(fill_count[1:0], i_fill_data);
    let f_msk: logic<256>         = wr_slot(fill_count[1:0], {1'b1 repeat 64});

    always_ff {
        if_reset {
            filling      = 1'b0;
            fill_count   = 3'd0;
            fill_index   = '0;
            fill_tag     = '0;
            fill_way     = 2'd0;
            fill_aborted = 1'b0;
            for i in 0..SETS {
                valid_0[i] = 1'b0;
                valid_1[i] = 1'b0;
                valid_2[i] = 1'b0;
                valid_3[i] = 1'b0;
                plru[i]    = 3'd0;
            }
        } else {
            if i_inval_all {
                for i in 0..SETS {
                    valid_0[i] = 1'b0;
                    valid_1[i] = 1'b0;
                    valid_2[i] = 1'b0;
                    valid_3[i] = 1'b0;
                }
                if filling {
                    fill_aborted = 1'b1;
                }
            }
            if filling {
                if i_fill_beat {
                    if fill_count == 3'd7 {
                        let fin: logic = !fill_aborted && !i_inval_all;
                        if fill_way == 2'd0 {
                            valid_0[fill_index] = fin;
                        }
                        if fill_way == 2'd1 {
                            valid_1[fill_index] = fin;
                        }
                        if fill_way == 2'd2 {
                            valid_2[fill_index] = fin;
                        }
                        if fill_way == 2'd3 {
                            valid_3[fill_index] = fin;
                        }
                        filling      = 1'b0;
                        fill_aborted = 1'b0;
                    } else {
                        fill_count = fill_count + 3'd1;
                    }
                }
            } else if i_fill_start {
                fill_index   = s_index;
                fill_tag     = s_tag;
                fill_way     = s_way;
                fill_count   = 3'd0;
                fill_aborted = 1'b0;
                filling      = 1'b1;
            }
            // PLRU points away from the way just read.
            if i_rd_valid && hit_c {
                if way_c[1] == 1'b0 {
                    plru[index][2] = 1'b1;
                    plru[index][1] = !way_c[0];
                } else {
                    plru[index][2] = 1'b0;
                    plru[index][0] = !way_c[0];
                }
            }
        }
    }

    // Data and tags: the fill is the only writer.
    always_ff {
        if filling && i_fill_beat {
            if fill_way == 2'd0 {
                data_0[f_blk] = (data_0[f_blk] & ~f_msk) | (f_new & f_msk);
            }
            if fill_way == 2'd1 {
                data_1[f_blk] = (data_1[f_blk] & ~f_msk) | (f_new & f_msk);
            }
            if fill_way == 2'd2 {
                data_2[f_blk] = (data_2[f_blk] & ~f_msk) | (f_new & f_msk);
            }
            if fill_way == 2'd3 {
                data_3[f_blk] = (data_3[f_blk] & ~f_msk) | (f_new & f_msk);
            }
            if fill_count == 3'd7 {
                if fill_way == 2'd0 {
                    tags_0[fill_index] = fill_tag;
                }
                if fill_way == 2'd1 {
                    tags_1[fill_index] = fill_tag;
                }
                if fill_way == 2'd2 {
                    tags_2[fill_index] = fill_tag;
                }
                if fill_way == 2'd3 {
                    tags_3[fill_index] = fill_tag;
                }
            }
        }
    }

    assign o_filling      = filling;
    assign o_fill_line    = {fill_tag, fill_index};
    assign o_fill_last    = last;
    assign o_fill_aborted = fill_aborted || i_inval_all;
}
