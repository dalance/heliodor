// l2_tag_bank: one way of the L2 tag and directory array, a 1R1W array of
// SETS words of W bits with a registered read and one whole-word write.
//
// Ports (timing contract):
//   i_ridx  : the word read this cycle
//   o_rdata : registered: the word i_ridx named in the previous cycle, as it
//             is after that cycle's write
//   i_we, i_widx, i_wdata : one write, applied on this edge
// Owns:
//   - a read and a write of the same word in one cycle return the written
//     word (write-forward); the forward is outside the array, which itself
//     reads old data
//   - no reset: the L2 clears every word after reset through the write port
pub module l2_tag_bank #(
    param SETS: u32 = 512,
    param W   : u32 = 48 ,
) (
    clk: input clock,

    i_ridx : input  logic<$clog2(SETS)>,
    o_rdata: output logic<W>           ,

    i_we   : input logic               ,
    i_widx : input logic<$clog2(SETS)> ,
    i_wdata: input logic<W>            ,
) {
    var mem_q: logic<W> [SETS];
    var rd_q : logic<W>       ;
    var fwd_q: logic          ;
    var fwd_d: logic<W>       ;

    always_ff (clk) {
        if i_we {
            mem_q[i_widx] = i_wdata;
        }
    }

    always_ff (clk) {
        rd_q  = mem_q[i_ridx];
        fwd_q = i_we && i_widx == i_ridx;
        fwd_d = i_wdata;
    }

    assign o_rdata = if fwd_q ? fwd_d : rd_q;
}
