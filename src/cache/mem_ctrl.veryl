// mem_ctrl: the coherent home of the new-core SoC and its AXI4 master.
//
// Sits between the per-slot L1 read channels and the shared L2, and drives
// the SoC's DRAM side as one AXI4 master port (64-bit data, INCR bursts of
// AxSIZE 3). The old core uses the frozen copy v14_mem_ctrl.
//
// Read transaction of a slot:
//   ACCEPT  : a 1-cycle o_hgrant pulse; the L1 latches its FILL state on it.
//   LOOKUP  : the line is looked up in the shared L2 (an LK op, see below).
//   L2 hit  : the line is copied into the slot buffer and streams to the L1
//             HIT_WAIT + 1 cycles after the op issued.
//   L2 miss : the slot asks for the AR channel (ST_AR). The AR is a line
//             burst (ARLEN 7 from the line base, ARID = slot); the R beats
//             land in the slot buffer in arrival order, then the line is
//             installed into the L2 and streams (an I-read streams without
//             installing).
//   STREAM  : o_hgrant held for 8 cycles; o_hrdata serves the dword the L1
//             addresses (i_haddr[5:3]), so critical-word-first is the L1's.
//   UNCACHED: an i_hunc read (DRAM or ROM) waits in LOOKUP until no L1 owns
//             the line (a ROM read does not look up), then reads one beat
//             (ARLEN 0, 8-byte aligned) and grants it for one cycle (ST_UNCD).
//
// Writes: a granted DRAM write enters the write buffer (WB_N line entries,
// one FIFO in grant order); the grant means "accepted by the home", not
// "reached DRAM". Each entry is one INCR burst over the lanes between its
// first and last strobed lane, AWID 0 for every write so that the slave
// keeps them in grant order. AW and W are raised independently; an entry is
// freed by its B. o_wb_full stops the SoC's write grant.
//
// AXI rules this module keeps: every valid and payload comes from registers
// and holds until its ready; RREADY and BREADY are always 1 (the slot buffer
// is the R sink, so R never needs backpressure). No AR is raised for a line
// while a write to that line is buffered or granted this cycle (a later read
// must not pass an earlier write); a write granted while the AR of a slot is
// presented or its R beats are arriving clears install_ok, as before.
//
// Non-DRAM, non-ROM (MMIO) reads keep the legacy path: their bus request
// and grant pass straight through (o_bus_rreq / o_hgrant) and the SoC muxes
// their data.
//
// The last slot (SBA_S) belongs to the Debug Module's System Bus Access and
// to no hart; it only makes i_hunc requests. A read is the uncached beat
// above. A write (i_sba_wr) waits in LOOKUP like a read, so the recall
// engine brings an owned line home, then holds the line in ST_UNCD
// (o_sba_wok) until the SoC grants it the write channel (i_w_sba). Holding
// the slot keeps every other accept off the line, so no L1 can own it again
// before the write, and the write invalidates every sharer.
//
// CMO_HOME (i_hcmo with i_hunc, a hart's D slot): the flush of one line
// for cbo.clean/flush/inval, after the requester dropped its own copy. It
// waits in LOOKUP like an uncached read, so the recall engine brings an
// owned line home (a dirty copy enters the write buffer), then, in the one
// cycle it proceeds, invalidates every listed sharer on an inv port and
// the line in the L2 (o_l2_cinv_v), and records the write-buffer entries
// of the line. It holds the line in ST_UNCD until each of them has its B,
// then grants for one cycle: the line is in no cache and its last write is
// in DRAM. Holding the slot keeps every accept off the line, so no cache
// can take the line again before the grant. Progress: the recall and the
// inv-port wait end as for an uncached read or an RFO, the recorded entries
// drain in order, and the requester has at most one CMO_HOME (its single
// D slot), so no retry is involved.
//
// Protocol invariant relied upon: an accept grant ALWAYS starts the L1 fill
// (the requester suppresses its request when it could not start the fill).
//
// L2 tag port: every decision on the L2 directory is an op on the L2's one
// tag port. An op issues (presents its line, o_t_addr) and executes in the
// next cycle, when the L2's verdict on the line is valid and the op applies
// at most one action to it. One op issues per cycle, so one executes per
// cycle, in issue order; the L2 forwards each action to the read of the
// same cycle. The op kinds: LK, the lookup of a LOOKUP slot; IN, the install
// of an INSTALL slot (issued at the last R beat already); WR, the SoC's
// selected DRAM write, granted only in its execute cycle (o_wt_ok); EC, the
// recall engine's clean-ack directory update, issued with the ack and
// carrying the lookup that asked for the recall when that slot still waits.
// A slot, the write channel and the engine have at most one op in flight.
// EC goes first; LK, IN and WR rotate (the class served last goes last), so
// a wanting class issues within three cycles. Whatever op executes owns the
// invalidate port that cycle.
// Progress: an op that cannot complete (an owned line, a vetoed write, a
// blocked install) changes nothing and issues again. What it waits for is a
// recall, which ends with an EC op (issued once, first) or with the owner's
// WB, a WR op; the SoC's write rotation moves to the next requester after
// every WR op, so the WB gets one within a turn of the requesting harts.
// Same-line order is unchanged: the per-line serialization below.
//
// MESI home rules:
//  - PER-LINE SERIALIZATION: an accept is blocked while another slot or the
//    recall engine is active on the same line, which keeps directory
//    updates race-free.
//  - LOOKUP hit on an OWNED line: the RECALL ENGINE probes the owner; a dirty
//    copy comes back as a WB on the write channel (the home merges it and
//    clears ownership), a clean one answers probe_ack (o_eclr). The slot
//    re-looks-up until the line is unowned, or captures the WB (c2c).
//  - LOOKUP hit, not owned: READ grants E (N = 1) or S; RFO grants M and
//    invalidates the other sharers in the same cycle.
//  - INSTALL: an OWNED victim is recalled before the eviction; the installer
//    becomes owner.
//  - The recall engine also serves the SoC's WRITE-GRANT VETO (a non-WB
//    write targeting a line owned by another hart).
pub module mem_ctrl #(
    param N_HARTS  : u32 = 1 ,
    // ── Block N (cp_mshr_mlp_plan.md §5): transaction SLOTS per hart. ──
    // Slot numbering is SLOT-MAJOR: slots [0, N_HARTS) are one requester class (the
    // D side), [N_HARTS, 2*N_HARTS) the next (the I side), so hart_of(s) = s % N_HARTS.
    // Hart-major numbering would give hart 0 SPH CONSECUTIVE slots, and both
    // lowest-id-wins encoders here (accept, and the single L2 lookup port — which a
    // slot re-enters every cycle while it retries an OWNED line) would then rank all
    // of hart 0's slots above hart 1's, starving the higher harts. Slot-major keeps
    // the inter-hart order identical to the pre-Block-N module.
    // This module used N_HARTS for two different things: how many L1 caches the
    // directory addresses (a hart count) and how many line reads can be in flight
    // (a slot count). They were the same number only because the D-cache has one
    // fill FSM. SPH separates them; at SPH=1, N_SLOTS == N_HARTS and every
    // slot->hart map (slot / SPH) is the identity, so the module is byte-identical
    // to the pre-Block-N version.
    param SPH      : u32 = 2 ,
    param HIT_WAIT : u32 = 2 , // LK issue -> first stream beat, minus one (L2 latency model), >= 1
    param WB_N     : u32 = 2 * N_HARTS, // write buffer entries
    const SBA_S    : u32 = N_HARTS * SPH, // the SBA slot
    const N_SLOTS  : u32 = SBA_S + 1,
    const ID_W     : u32 = $clog2(N_SLOTS), // ARID = slot
    const SLOT_W   : u32 = $clog2(N_SLOTS),
) (
    clk: input clock,
    rst: input reset,
    // Hart side (read channel, per hart): request/addr from the dcache,
    // i_hdram = SoC's DRAM decode of the addr. o_hgrant feeds i_memr_grant.
    i_hreq  : input  logic     [N_SLOTS],
    i_haddr : input  logic<64> [N_SLOTS],
    i_hdram : input  logic     [N_SLOTS],
    o_hgrant: output logic     [N_SLOTS],
    o_hrdata: output logic<64> [N_SLOTS],
    // P9.2: read-for-ownership flag (store fill) + grant state to the L1
    // (sampled at fill completion: 1 = E/M-capable, 0 = S).
    i_hrfo : input  logic [N_SLOTS],
    // P9.6: the request is an I-cache fill — an UNCOUNTED coherent read. It
    // looks up / recalls / gathers exactly like a normal read but adds NO
    // directory sharer (no cadd) and does NOT install the gathered line into
    // the L2; on GATHER completion it streams straight to the L1. The I-cache
    // is kept coherent by FENCE.I + recall-on-owned, not by directory tracking.
    i_iread: input  logic [N_SLOTS],
    // An uncached single-beat read of DRAM or ROM (i_hdram = 0). The slot
    // holds it in LOOKUP until no L1 owns the line (the recall engine brings
    // a dirty copy home), then reads one AXI beat. It adds no sharer and
    // installs nothing; the requester holds its request until the beat's
    // grant.
    i_hunc : input  logic [N_SLOTS],
    i_hrom : input  logic [N_SLOTS], // the i_hunc read targets ROM (no lookup)
    // The i_hunc request is a CMO_HOME (see the header).
    i_hcmo : input  logic [N_SLOTS],
    o_hexcl: output logic [N_SLOTS],
    // The SBA slot's request is a write; o_sba_wok (registered) holds the
    // line for it.
    i_sba_wr : input  logic,
    o_sba_wok: output logic,
    // Bus side: read-channel cycle requests of legacy (MMIO) reads, which
    // the memory_bus arbitrates with its rotation.
    o_bus_rreq  : output logic [N_HARTS],
    i_bus_rgrant: input  logic [N_HARTS],
    // L2 tag port (see the header): the line presented this cycle, and the
    // L2's verdict on the line of the op executing (line x).
    o_t_addr    : output logic<64>     ,
    i_x_hit     : input  logic         ,
    i_x_shr     : input  logic<N_HARTS>,
    i_x_owned   : input  logic         ,
    i_l2_cdata  : input  logic<64>  [8],
    i_iv_valid  : input  logic         , // an install of x would evict a valid line
    i_iv_addr   : input  logic<64>     ,
    i_iv_sharers: input  logic<N_HARTS>,
    i_iv_owned  : input  logic         , // ... which is owned: recall it first
    i_iv_blocked: input  logic         ,
    // Actions on line x: an LK (PLRU touch, sharer add with the grant state,
    // CMO_HOME invalidate of the line and its directory entry), an IN (the
    // gathered line and the installing hart), an EC (o_eclr_*).
    o_l2_cren     : output logic        ,
    o_cadd_v      : output logic        ,
    o_cadd_hart   : output logic<3>     ,
    o_cadd_own    : output logic        ,
    o_l2_cinv_v   : output logic        ,
    o_l2_inst_v   : output logic        ,
    o_l2_inst_data: output logic<64> [8],
    o_inst_hart   : output logic<3>     ,
    // Active-transaction lines, excluded from the L2's victim selection.
    o_busy_line: output logic<58> [N_SLOTS],
    o_busy_v   : output logic     [N_SLOTS],
    // The SoC's selected DRAM write (pre-grant) asks for a WR op; o_wt_ok:
    // the WR op of its line executes, so the write may be granted this cycle.
    // o_wt_x: a WR op executes (the SoC's write rotation advances).
    i_wt_req : input  logic    ,
    i_wt_line: input  logic<58>,
    o_wt_ok  : output logic    ,
    o_wt_x   : output logic    ,
    // The granted write's hart. i_w_wb: the write is an L1 WRITEBACK — no
    // invalidates (the home just absorbs the dirty line; the writer already
    // invalidated its copy).
    i_w_hart: input logic<3>,
    i_w_wb  : input logic   ,
    // P9.2 Phase B recall engine: per-hart probe (recall the line — WB if
    // dirty, invalidate either way) + clean ack; directory owner clear on a
    // clean ack; the SoC's write-veto recall request (line + owner).
    o_probe_v   : output logic     [N_HARTS],
    o_probe_addr: output logic<64>          ,
    // The recall was requested by the probed hart's OWN transaction (stale
    // self-owner entry): the L1 must NOT abort its in-flight fill of the
    // line — that fill IS the recall's requester (abort = livelock).
    o_probe_self: output logic              ,
    i_probe_ack : input  logic     [N_HARTS],
    o_eclr_v    : output logic              , // an EC op: the clean owner leaves line x
    o_eclr_hart : output logic<3>           ,
    i_wv_req    : input  logic              ,
    i_wv_line   : input  logic<58>          ,
    i_wv_hart   : input  logic<3>           ,
    // P9.2: per-hart precise invalidates, owned by the executing op: a
    // granted write's sharers, an install's back-invalidate or abort, a
    // lookup's RFO or CMO_HOME sharers.
    o_inv1_v   : output logic     [N_HARTS],
    o_inv1_addr: output logic<64>           ,
    // AXI4 master (the attributes that are constant live in the SoC).
    o_arvalid: output logic      ,
    i_arready: input  logic      ,
    o_arid   : output logic<ID_W>,
    o_araddr : output logic<56>  ,
    o_arlen  : output logic<8>   ,
    i_rvalid : input  logic      ,
    o_rready : output logic      ,
    i_rid    : input  logic<ID_W>,
    i_rdata  : input  logic<64>  ,
    i_rresp  : input  logic<2>   ,
    i_rlast  : input  logic      ,
    o_awvalid: output logic      ,
    i_awready: input  logic      ,
    o_awid   : output logic<ID_W>,
    o_awaddr : output logic<56>  ,
    o_awlen  : output logic<8>   ,
    o_wvalid : output logic      ,
    i_wready : input  logic      ,
    o_wdata  : output logic<64>  ,
    o_wstrb  : output logic<8>   ,
    o_wlast  : output logic      ,
    i_bvalid : input  logic      ,
    o_bready : output logic      ,
    i_bid    : input  logic<ID_W>,
    i_bresp  : input  logic<2>   ,
    // Sticky: bit 0 an R beat, bit 1 a B, answered other than OKAY; bit 2 a
    // slave protocol fault: an R beat for a slot not gathering, RLAST not on
    // the burst's last beat, or a B with BID != 0. The data of an errored
    // beat is used as it came; nothing reaches the core.
    o_axi_err: output logic<3>   ,
    // The write buffer has no free entry: the SoC grants no write.
    o_wb_full: output logic,
    // i_drain: no new AR is presented (the SoC also grants no write), so the
    // port goes idle before an ndmreset. o_axi_idle: no AR presented, no R
    // beat awaited and the write buffer empty.
    i_drain   : input  logic,
    o_axi_idle: output logic,
    // The granted DRAM write this cycle. It is snooped by the slots and
    // enters the write buffer.
    i_w_valid: input logic    ,
    i_w_sba  : input logic    , // ... is the SBA slot's write (no writer hart)
    i_w_addr : input logic<64>,
    i_w_strb : input logic<8> [8],
    // P9.3 c2c: the granted write's data lanes. A slot waiting in LOOKUP on
    // an owned line captures the recall's WB directly off the write channel
    // (owner-to-requester transfer through the home) instead of re-looking
    // the merged line up — see the c2c block below.
    i_w_lanes: input logic<64> [8],
    // P9.3 c2c: requester directory add, coinciding with the captured WB.
    // The L2 applies it after the WB's owner-clear on the same edge.
    o_w_cadd_v   : output logic   ,
    o_w_cadd_hart: output logic<3>,
    o_w_cadd_own : output logic   ,
    // Event wires; wb_full is left 0 (the SoC sees the write requests).
    o_perf: output soc_pkg::McPerf,
    // Sticky (HELIODOR_CHK only, else 0): while a CMO_HOME holds its line
    // after invalidating it, another slot became active on the line, or the
    // line was installed in the L2 or added to the directory; or a DRAM
    // write was granted outside the WR op of its line.
    o_chk: output logic,
) {
    // Slot states.
    const ST_IDLE   : logic<3> = 3'd0;
    const ST_LOOKUP : logic<3> = 3'd1;
    const ST_HWAIT  : logic<3> = 3'd2;
    const ST_AR     : logic<3> = 3'd3; // waiting for the AR channel
    const ST_GATHER : logic<3> = 3'd4; // AR accepted, R beats arriving
    const ST_INSTALL: logic<3> = 3'd5;
    const ST_STREAM : logic<3> = 3'd6;
    const ST_UNCD   : logic<3> = 3'd7; // uncached beat in the buffer, granted this cycle; an SBA write holds its line

    let w_line: logic<58> = i_w_addr[63:6];

    // Cross-hart visible slot state (each element driven by its own slot).
    var st_all     : logic<3>  [N_SLOTS]    ;
    var line_all   : logic<58> [N_SLOTS]    ;
    var iok_all    : logic     [N_SLOTS]    ;
    var rfo_all    : logic     [N_SLOTS]    ; // P9.2: slot transaction is an RFO
    var iread_all  : logic     [N_SLOTS]    ; // P9.6: slot transaction is an I-read (uncounted)
    var unc_all    : logic     [N_SLOTS]    ; // slot transaction is an uncached single beat
    var ulive_all  : logic     [N_SLOTS]    ; // ... whose requester still asks for it
    var inspec_all : logic     [N_SLOTS]    ; // the last R beat of a line to install arrives
    var cmo_all    : logic     [N_SLOTS]    ; // ... which is a CMO_HOME
    var cmo_go_all : logic     [N_SLOTS]    ; // the CMO_HOME invalidates its line this cycle
    var wbl_all    : logic<WB_N> [N_SLOTS]  ; // write-buffer entries of the slot's line, less this cycle's B
    var wb_bclr    : logic<WB_N>            ; // the entry whose B arrives this cycle (the oldest)
    var dw_all     : logic<3>  [N_SLOTS]    ; // the dword of an uncached beat
    var rom_all    : logic     [N_SLOTS]    ; // ... which targets ROM (o_perf only)
    var rd_fly     : logic     [N_SLOTS]    ; // AR presented or R beats arriving
    var r_ok       : logic     [N_SLOTS]    ; // this cycle's R beat is the slot's expected one
    var inst_go_all: logic     [N_SLOTS]    ; // P9.2: INSTALL→STREAM go (assigned below)
    var lk_go_all  : logic     [N_SLOTS]    ; // P9.2: LOOKUP-hit grant go (assigned below)
    var lk_excl_w  : logic                  ; // P9.2: grant state for the lookup go
    var inst_excl_w: logic     [N_SLOTS]    ; // P9.2: grant state at install go
    var buf_all    : logic<64> [N_SLOTS * 8];
    // The legacy (MMIO) read channel stays ONE request per hart: a hart's
    // slots share it and the lowest-indexed asking slot takes the grant.
    var slot_bus_req: logic [N_SLOTS];
    var slot_bus_gnt: logic [N_SLOTS];

    // AR channel owner (registered): the slot whose AR is presented.
    var ar_busy_q: logic      ;
    var ar_slot_q: logic<ID_W>;
    var ar_pick  : logic [N_SLOTS]; // lowest ST_AR slot free of a write hazard
    var ar_take  : logic [N_SLOTS]; // ... that takes the AR channel this cycle
    let ar_hs    : logic = ar_busy_q && i_arready;
    // An R beat of this cycle belongs to slot i_rid.
    var r_mine: logic [N_SLOTS];
    for h in 0..N_SLOTS :gen_rmine {
        assign r_mine[h] = i_rvalid && (i_rid == (h as ID_W));
    }

    // P9.2 Phase B: recall engine state (registered; probes are asserted
    // while busy, completion = clean probe-ack OR the owner's WB arriving on
    // the write channel).
    var eng_busy: logic    ;
    var eng_line: logic<58>;
    var eng_hart: logic<3> ;
    var eng_self: logic    ; // requester == probed owner (lk self-recall)

    // P9.2: active-transaction lines for the L2's victim exclusion.
    for h in 0..N_SLOTS :gen_busy {
        assign o_busy_v[h]    = st_all[h] != ST_IDLE;
        assign o_busy_line[h] = line_all[h];
    }

    // ------------------------------------------------------------------
    // L2 tag port (see the header): issue, and the executing op (x_*).
    // ------------------------------------------------------------------
    const OP_LK: logic<2> = 2'd0;
    const OP_IN: logic<2> = 2'd1;
    const OP_WR: logic<2> = 2'd2;
    const OP_EC: logic<2> = 2'd3;
    var x_v_q   : logic        ;
    var x_kind_q: logic<2>     ;
    var x_slot_q: logic<SLOT_W>;
    var x_line_q: logic<58>    ;
    var rr_q    : logic<2>     ; // the class (LK, IN, WR) that issued last
    var eng_ec_q: logic        ; // the engine's EC op is due
    var eng_lk_q: logic        ; // the recall was requested by the lookup of slot eng_ls_q
    var eng_ls_q: logic<SLOT_W>;
    var x_fuse_q: logic        ; // the EC op carries the lookup of slot x_slot_q
    let x_lk    : logic         = x_v_q && x_kind_q == OP_LK;
    let x_in    : logic         = x_v_q && x_kind_q == OP_IN;
    let x_wr    : logic         = x_v_q && x_kind_q == OP_WR;
    let x_ec    : logic         = x_v_q && x_kind_q == OP_EC;
    let x_ecl   : logic         = x_ec && x_fuse_q;

    var lk_want: logic [N_SLOTS];
    var in_want: logic [N_SLOTS];
    var lk_pick: logic [N_SLOTS];
    var in_pick: logic [N_SLOTS];
    var lk_fnd : logic [N_SLOTS];
    var in_fnd : logic [N_SLOTS];
    var lkx_all: logic [N_SLOTS]; // the slot's LK op executes
    var inx_all: logic [N_SLOTS]; // the slot's IN op executes
    for h in 0..N_SLOTS :gen_want {
        let mine: logic = x_v_q && x_slot_q == (h as SLOT_W) && (x_kind_q == OP_LK || x_kind_q == OP_IN || x_fuse_q);
        assign lk_want[h] = st_all[h] == ST_LOOKUP && !mine && (!unc_all[h] || ulive_all[h]) && !rom_all[h];
        assign in_want[h] = (st_all[h] == ST_INSTALL || inspec_all[h]) && !mine;
        assign lkx_all[h] = (x_lk || x_ecl) && x_slot_q == (h as SLOT_W) && st_all[h] == ST_LOOKUP;
        assign inx_all[h] = x_in && x_slot_q == (h as SLOT_W) && st_all[h] == ST_INSTALL;
        if h == 0 :gen_first {
            assign lk_pick[h] = lk_want[h];
            assign in_pick[h] = in_want[h];
            assign lk_fnd[h]  = lk_want[h];
            assign in_fnd[h]  = in_want[h];
        } else :gen_rest {
            assign lk_pick[h] = lk_want[h] && !lk_fnd[h - 1];
            assign in_pick[h] = in_want[h] && !in_fnd[h - 1];
            assign lk_fnd[h]  = lk_fnd[h - 1] || lk_want[h];
            assign in_fnd[h]  = in_fnd[h - 1] || in_want[h];
        }
    }
    var eng_ack_ec: logic; // the probed owner answered clean: an EC op is due
    let wr_want   : logic = i_wt_req && !x_wr;
    // The EC op issues in the cycle of the clean ack and carries the lookup
    // that asked for the recall when that slot still waits on the line.
    let ec_want: logic    = (eng_ack_ec || eng_ec_q) && !x_ec;
    let ec_fuse: logic    = eng_lk_q && st_all[eng_ls_q] == ST_LOOKUP && line_all[eng_ls_q] == eng_line;
    let c_want : logic<3> = {wr_want, in_fnd[N_SLOTS - 1], lk_fnd[N_SLOTS - 1]};
    let rr_c0  : logic<2> = if rr_q == OP_WR ? OP_LK : rr_q + 2'd1;
    let rr_c1  : logic<2> = if rr_c0 == OP_WR ? OP_LK : rr_c0 + 2'd1;
    let t_cls  : logic<2> = if c_want[rr_c0] ? rr_c0 : if c_want[rr_c1] ? rr_c1 : rr_q;
    let t_ec   : logic    = ec_want;
    let t_go   : logic    = !ec_want && c_want != 3'd0;
    var t_slot : logic<SLOT_W>;
    var t_line : logic<58>    ;
    always_comb {
        t_slot = '0;
        for h in 0..N_SLOTS {
            if (t_cls == OP_LK && lk_pick[h]) || (t_cls == OP_IN && in_pick[h]) {
                t_slot = h as SLOT_W;
            }
        }
        if t_ec {
            t_slot = eng_ls_q;
        }
        t_line = if t_ec ? eng_line : if t_cls == OP_WR ? i_wt_line : line_all[t_slot];
    }
    assign o_t_addr = {t_line, 6'd0};
    always_ff (clk, rst) {
        if_reset {
            x_v_q    = 1'b0;
            x_kind_q = OP_LK;
            x_fuse_q = 1'b0;
            rr_q     = OP_WR;
        } else {
            x_v_q    = t_ec || t_go;
            x_kind_q = if t_ec ? OP_EC : t_cls;
            x_fuse_q = t_ec && ec_fuse;
            if t_go {
                rr_q = t_cls;
            }
        }
    }
    always_ff (clk) {
        x_slot_q = t_slot;
        x_line_q = t_line;
    }
    assign o_wt_ok = x_wr && i_wt_line == x_line_q;
    assign o_wt_x  = x_wr;

    // A lookup whose line was written in the cycle its data was read retries.
    var wg_v_q   : logic    ;
    var wg_line_q: logic<58>;
    always_ff (clk, rst) {
        if_reset {
            wg_v_q = 1'b0;
        } else {
            wg_v_q = i_w_valid;
        }
    }
    always_ff (clk) {
        wg_line_q = w_line;
    }
    let lk_cf: logic = wg_v_q && wg_line_q == x_line_q;

    // The verdict as the lookup sees it: an EC op carrying the lookup has
    // already dropped the probed owner.
    var ec_oh: logic<N_HARTS>;
    for h in 0..N_HARTS :gen_ec_oh {
        assign ec_oh[h] = x_ec && eng_hart == (h as 3);
    }
    let lk_shr  : logic<N_HARTS> = i_x_shr & ~ec_oh;
    let lk_owned: logic          = i_x_owned && !x_ec;

    // ------------------------------------------------------------------
    // P9.3 c2c transfer: a slot waiting in LOOKUP on line L (the verdict
    // keeps coming back OWNED while the recall engine works) captures a
    // granted WB to L straight off the write channel: the WB carries the
    // owner's current (dirty) copy, so the buffer takes it and the slot
    // streams — no re-lookup, no HWAIT. The directory is fixed up the same
    // edge: the WB merge clears the old owner, o_w_cadd_* adds the
    // requester (owned for an RFO; S for a READ, the same anti-ping-pong
    // policy as the lookup grant). The writer's own slot is excluded
    // (self-recall / own-eviction WB keeps the re-lookup path). No lk_go
    // race exists: a WB for L implies the directory still shows L owned
    // this cycle, so lk_hit_ok is false.
    // ------------------------------------------------------------------
    var c2c_go_all: logic [N_SLOTS];
    for h in 0..N_SLOTS :gen_c2c {
        assign c2c_go_all[h] = (st_all[h] == ST_LOOKUP) && i_w_valid && i_w_wb
            && (w_line == line_all[h]) && (i_w_hart != ((h % N_HARTS) as 3)) && !unc_all[h];
    }
    always_comb {
        o_w_cadd_v    = 1'b0;
        o_w_cadd_hart = 3'd0;
        o_w_cadd_own  = 1'b0;
        for h in 0..N_SLOTS {
            // P9.6: an I-read captures the c2c WB data (current copy) but adds
            // NO directory sharer — suppress the requester add for it.
            if c2c_go_all[h] && !iread_all[h] {
                o_w_cadd_v    = 1'b1;
                o_w_cadd_hart = (h % N_HARTS) as 3;
                o_w_cadd_own  = rfo_all[h] || (N_HARTS == 1);
            }
        }
    }

    // P9.2 Phase B: per-line accept blocking (another slot or the recall
    // engine active on the requested line). P9.3: the RFO AMO-lock gating
    // is gone with the bus lock — per-line serialization alone keeps the
    // directory race-free; RMW atomicity lives in the L1 (ownership).
    var acc_line_busy: logic [N_SLOTS];
    always_comb {
        for h in 0..N_SLOTS {
            acc_line_busy[h] = eng_busy && (eng_line == i_haddr[h][63:6]);
            for g in 0..N_SLOTS {
                if g != h {
                    if (st_all[g] != ST_IDLE) && (line_all[g] == i_haddr[h][63:6]) {
                        acc_line_busy[h] = 1'b1;
                    }
                }
            }
        }
    }

    // Accept arbitration: at most one accept per cycle (the L2 lookup port is
    // single), lowest-id wins. A slot passed over for STARVE_WAIT cycles goes
    // first: harts bouncing one line hand it over in the single cycle it is
    // free (acc_line_busy holds it the rest of the time), so under fixed priority
    // a higher-id slot waiting on that line is never accepted.
    const STARVE_WAIT: logic<8> = 8'd64;
    var acc_found : logic    [N_SLOTS];
    var accept    : logic    [N_SLOTS];
    var acc_ok    : logic    [N_SLOTS];
    var acc_wait_q: logic<8> [N_SLOTS];
    var acc_old   : logic    [N_SLOTS];
    var old_found : logic    [N_SLOTS];
    for h in 0..N_SLOTS :gen_accok {
        assign acc_ok[h] = (st_all[h] == ST_IDLE) && i_hreq[h] && (i_hdram[h] || i_hunc[h])
            && !acc_line_busy[h];
        assign acc_old[h] = acc_ok[h] && (acc_wait_q[h] >= STARVE_WAIT);
        always_ff (clk, rst) {
            if_reset {
                acc_wait_q[h] = 8'd0;
            } else if accept[h] || !((st_all[h] == ST_IDLE) && i_hreq[h] && (i_hdram[h] || i_hunc[h])) {
                acc_wait_q[h] = 8'd0;
            } else if acc_wait_q[h] <: STARVE_WAIT {
                acc_wait_q[h] = acc_wait_q[h] + 8'd1;
            }
        }
    }
    for h in 0..N_SLOTS :gen_old {
        if h == 0 :gen_first {
            assign old_found[h] = acc_old[h];
        } else :gen_rest {
            assign old_found[h] = old_found[h - 1] || acc_old[h];
        }
    }
    let any_old: logic = old_found[N_SLOTS - 1];
    for h in 0..N_SLOTS :gen_acc {
        let cand: logic = if any_old ? acc_old[h] : acc_ok[h];
        if h == 0 :gen_first {
            assign accept[h]    = cand;
            assign acc_found[h] = accept[h];
        } else :gen_rest {
            assign accept[h]    = cand && !acc_found[h - 1];
            assign acc_found[h] = acc_found[h - 1] || accept[h];
        }
    }

    // Per-slot transaction state.
    for h in 0..N_SLOTS :gen_slot {
        var st_q   : logic<3>     ;
        var line_q : logic<58>    ;
        var dw_q   : logic<3>     ;
        var wcnt_q : logic<8>     ;
        var gcnt_q : logic<3>     ;
        var scnt_q : logic<3>     ;
        var iok_q  : logic        ;
        var rfo_q  : logic        ; // transaction is a read-for-ownership
        var iread_q: logic        ; // transaction is an I-read (uncounted)
        var unc_q  : logic        ;
        var rom_q  : logic        ;
        var excl_q : logic        ; // grant state (E/M vs S), set at grant
        var wr_q   : logic        ; // the SBA slot's transaction is a write
        var cmo_q  : logic        ; // the transaction is a CMO_HOME
        var pend_q : logic<WB_N>  ; // write-buffer entries of the line a CMO_HOME waits for
        var buf_q  : logic<64> [8];

        assign st_all[h]    = st_q;
        assign line_all[h]  = line_q;
        assign dw_all[h]    = dw_q;
        assign iok_all[h]   = iok_q;
        assign rfo_all[h]   = rfo_q;
        assign iread_all[h] = iread_q;
        assign unc_all[h]   = unc_q;
        assign cmo_all[h]   = cmo_q;
        assign rom_all[h]   = rom_q;
        // The uncached requester may leave (kill) or move to another line.
        let unc_live: logic = i_hreq[h] && i_hunc[h] && (i_haddr[h][63:6] == line_q);
        assign ulive_all[h]  = unc_live;
        assign inspec_all[h] = st_q == ST_GATHER && r_mine[h] && gcnt_q == 3'd7 && !unc_q && !iread_q;
        let ar_mine : logic = ar_busy_q && (ar_slot_q == (h as ID_W));
        assign rd_fly[h] = ar_mine || (st_q == ST_GATHER);
        assign r_ok[h]   = r_mine[h] && (st_q == ST_GATHER) && (i_rlast == (unc_q || (gcnt_q == 3'd7)));
        for l in 0..8 :gen_buf_exp {
            assign buf_all[h * 8 + l] = buf_q[l];
        }

        // A write granted to this slot's line.
        let conflict: logic = i_w_valid && w_line == line_q;

        always_ff (clk, rst) {
            if_reset {
                st_q    = ST_IDLE;
                line_q  = '0;
                dw_q    = 3'd0;
                wcnt_q  = 8'd0;
                gcnt_q  = 3'd0;
                scnt_q  = 3'd0;
                iok_q   = 1'b0;
                rfo_q   = 1'b0;
                iread_q = 1'b0;
                unc_q   = 1'b0;
                rom_q   = 1'b0;
                excl_q  = 1'b0;
                wr_q    = 1'b0;
                cmo_q   = 1'b0;
                pend_q  = '0;
                for l in 0..8 {
                    buf_q[l] = 64'd0;
                }
            } else {
                case st_q {
                    ST_IDLE: {
                        if accept[h] {
                            line_q  = i_haddr[h][63:6];
                            dw_q    = i_haddr[h][5:3];
                            wcnt_q  = 8'd0;
                            gcnt_q  = 3'd0;
                            scnt_q  = 3'd0;
                            iok_q   = 1'b1;
                            rfo_q   = i_hrfo[h] && !i_hunc[h];
                            iread_q = i_iread[h];
                            unc_q   = i_hunc[h];
                            rom_q   = i_hunc[h] && i_hrom[h];
                            excl_q  = 1'b0;
                            wr_q    = h == SBA_S && i_sba_wr;
                            cmo_q   = h <: N_HARTS && i_hunc[h] && i_hcmo[h];
                            st_q    = ST_LOOKUP;
                        }
                    }
                    ST_LOOKUP: {
                        // The grant decision (selection, write-snoop retry,
                        // OWNED recall wait, RFO sharer-invalidate port wait,
                        // grant state) is computed at module level. A recall
                        // WB for this line is captured directly (c2c).
                        if unc_q {
                            if !unc_live {
                                st_q = ST_IDLE;
                            } else if cmo_q {
                                if cmo_go_all[h] {
                                    pend_q = wbl_all[h];
                                    st_q   = ST_UNCD;
                                }
                            } else if rom_q || (lkx_all[h] && !(i_x_hit && lk_owned)) {
                                // ROM is never written, so no cache holds a
                                // newer copy: its beat needs no lookup.
                                st_q = if wr_q ? ST_UNCD : ST_AR;
                            }
                        } else if c2c_go_all[h] {
                            for l in 0..8 {
                                buf_q[l] = i_w_lanes[l];
                            }
                            excl_q = rfo_q || (N_HARTS == 1);
                            scnt_q = 3'd0;
                            st_q   = ST_STREAM;
                        } else if lk_go_all[h] {
                            for l in 0..8 {
                                buf_q[l] = i_l2_cdata[l];
                            }
                            excl_q = lk_excl_w;
                            wcnt_q = 8'd1;
                            scnt_q = 3'd0;
                            st_q   = if HIT_WAIT == 1 ? ST_STREAM : ST_HWAIT;
                        } else if lkx_all[h] && !lk_cf && !i_x_hit {
                            st_q = ST_AR;
                        }
                    }
                    ST_HWAIT: {
                        wcnt_q = wcnt_q + 8'd1;
                        if wcnt_q == (HIT_WAIT as 8) - 8'd1 {
                            scnt_q = 3'd0;
                            st_q   = ST_STREAM;
                        }
                    }
                    ST_AR: {
                        if ar_mine && i_arready {
                            gcnt_q = 3'd0;
                            st_q   = ST_GATHER;
                        } else if unc_q && !unc_live && !ar_mine && !ar_take[h] {
                            st_q = ST_IDLE;
                        }
                        // Once the AR is presented, the slave may order it
                        // either side of a write granted now.
                        if conflict && ar_mine {
                            iok_q = 1'b0;
                        }
                    }
                    ST_GATHER: {
                        if r_mine[h] {
                            if unc_q {
                                buf_q[dw_q] = i_rdata;
                                st_q        = ST_UNCD;
                            } else {
                                buf_q[gcnt_q] = i_rdata;
                                if gcnt_q == 3'd7 {
                                    // An I-read does not install into the L2.
                                    if iread_q {
                                        scnt_q = 3'd0;
                                        st_q   = ST_STREAM;
                                    } else {
                                        st_q = ST_INSTALL;
                                    }
                                } else {
                                    gcnt_q = gcnt_q + 3'd1;
                                }
                            }
                        }
                        if conflict {
                            iok_q = 1'b0;
                        }
                    }
                    ST_INSTALL: {
                        // INSTALL holds (no IN op yet, a blocked or OWNED
                        // victim): advance only on inst_go, folding write
                        // conflicts into iok.
                        if inst_go_all[h] {
                            excl_q = inst_excl_w[h];
                            scnt_q = 3'd0;
                            st_q   = ST_STREAM;
                        }
                        if conflict {
                            iok_q = 1'b0;
                        }
                    }
                    ST_STREAM: {
                        scnt_q = scnt_q + 3'd1;
                        if scnt_q == 3'd7 {
                            st_q = ST_IDLE;
                        }
                    }
                    ST_UNCD: {
                        if cmo_q {
                            if pend_q == '0 || !unc_live {
                                st_q = ST_IDLE;
                            }
                            pend_q = pend_q & ~wb_bclr;
                        } else if !wr_q || !unc_live || (i_w_valid && i_w_sba) {
                            st_q = ST_IDLE;
                        }
                    }
                    default: {
                        st_q = ST_IDLE;
                    }
                }
            }
        }

        // Hart-facing grant: accept pulse, the 8 stream beats, the uncached
        // beat, or the legacy (MMIO) combinational passthrough of the bus
        // grant.
        let legacy : logic = i_hreq[h] && !i_hdram[h] && !i_hunc[h];
        let unc_dlv: logic = (st_q == ST_UNCD) && !wr_q && !cmo_q && unc_live && (i_haddr[h][5:3] == dw_q);
        let cmo_dlv: logic = (st_q == ST_UNCD) && cmo_q && unc_live && pend_q == '0;
        // A STREAM beat is granted only to a consumer addressing this slot's
        // line: the core's routing of the shared read port can drift
        // mid-STREAM, and mismatched beats must stream out unconsumed.
        let stream_ok: logic = (st_q == ST_STREAM) && (i_haddr[h][63:6] == line_q);
        assign o_hgrant[h] = (accept[h] && !i_hunc[h]) || stream_ok || unc_dlv || cmo_dlv || (legacy && slot_bus_gnt[h]);
        assign o_hrdata[h] = buf_q[i_haddr[h][5:3]];
        assign o_hexcl[h]  = excl_q;

        assign slot_bus_req[h] = legacy;
        if h == SBA_S :gen_sba_wok {
            assign o_sba_wok = (st_q == ST_UNCD) && wr_q;
        }
    }

    // Per-hart aggregation of the slot bus requests, and the reverse distribution
    // of the hart's single grant. At SPH=1 `lower` folds to 0 and this is exactly
    // the old `o_bus_rreq[h] = req` / `i_bus_rgrant[h]` pair.
    for hh in 0..N_HARTS :gen_bus_agg {
        var hreq: logic;
        always_comb {
            hreq = 1'b0;
            for k in 0..SPH {
                if slot_bus_req[hh + k * N_HARTS] {
                    hreq = 1'b1;
                }
            }
        }
        assign o_bus_rreq[hh] = hreq;
    }
    for h in 0..N_SLOTS :gen_bus_gnt {
        var lower: logic;
        always_comb {
            lower = 1'b0;
            for k in 0..SPH {
                if ((h % N_HARTS) + k * N_HARTS <: h) && slot_bus_req[(h % N_HARTS) + k * N_HARTS] {
                    lower = 1'b1;
                }
            }
        }
        assign slot_bus_gnt[h] = i_bus_rgrant[h % N_HARTS] && slot_bus_req[h] && !lower;
    }

    // ------------------------------------------------------------------
    // P9.2 Phase B lookup grant decision, in the execute cycle of an LK op:
    //   - OWNED line → wait (the recall engine is requested below; the slot
    //     issues the lookup again after the recall clears ownership).
    //   - RFO with other sharers → they are invalidated with the grant.
    //   - grant state: RFO or sole-sharer READ ⇒ E/M (cadd_own), else S.
    // ------------------------------------------------------------------
    var lk_v  : logic         ;
    var lk_oh : logic<N_HARTS>;
    var lk_h  : logic<3>      ;
    var lk_sba: logic         ;
    var lk_rfo: logic         ;
    var lk_cmo: logic         ;
    always_comb {
        lk_v   = 1'b0;
        lk_oh  = '0;
        lk_h   = 3'd0;
        lk_sba = 1'b0;
        lk_rfo = 1'b0;
        lk_cmo = 1'b0;
        for h in 0..N_SLOTS {
            if lkx_all[h] {
                lk_v   = 1'b1;
                lk_rfo = rfo_all[h];
                lk_cmo = cmo_all[h];
                if h == SBA_S {
                    lk_sba = 1'b1;
                } else {
                    lk_oh[h % N_HARTS] = 1'b1; // HART one-hot: lk_others ANDs it with the directory
                    lk_h               = (h % N_HARTS) as 3;
                }
            }
        }
    }
    assign o_l2_cren = lk_v;
    let lk_others  : logic<N_HARTS> = lk_shr & ~lk_oh;
    // An RFO invalidates the other sharers, a CMO_HOME every sharer.
    let lk_imask   : logic<N_HARTS> = if lk_cmo ? lk_shr : lk_others;
    let lk_hit_ok  : logic          = lk_v && !lk_cf && i_x_hit && !lk_owned;
    let lk_need_inv: logic          = lk_hit_ok && (lk_rfo || lk_cmo) && (lk_imask != '0);
    // Grant policy: at N>1 a lookup-hit READ gets S even as the sole sharer
    // — an E grant here makes two read-spinning harts invalidate each other
    // through recalls every iteration (barrier/lock spin ping-pong). E is
    // granted only at INSTALL (DRAM first touch) and by RFO. At N=1 there
    // is no spinner to ping and silent E→M matters for store performance,
    // so the sole-sharer E grant stays (the self-recall it can regenerate
    // is answered without aborting the requester's own fill — probe-self).
    assign lk_excl_w = lk_rfo || (N_HARTS == 1);
    for h in 0..N_SLOTS :gen_lkgo {
        assign lk_go_all[h] = lkx_all[h] && lk_hit_ok && !unc_all[h];
    }
    // A CMO_HOME proceeds once the line is unowned and was not written in
    // the cycle its lookup issued.
    let cmo_go: logic = lk_cmo && lk_v && !lk_cf && !(i_x_hit && lk_owned);
    for h in 0..N_SLOTS :gen_cmogo {
        assign cmo_go_all[h] = lkx_all[h] && cmo_go;
    }
    assign o_l2_cinv_v = cmo_go && i_x_hit;
    // Recall request: lookup hit on an OWNED line (owner = the one-hot mask).
    let lk_recall_req: logic = lk_v && !lk_cf && i_x_hit && lk_owned;
    var lk_owner: logic<3>;
    always_comb {
        lk_owner = 3'd0;
        for h in 0..N_HARTS {
            if i_x_shr[h] {
                lk_owner = h as 3;
            }
        }
    }

    always_comb {
        o_cadd_v    = 1'b0;
        o_cadd_hart = 3'd0;
        for h in 0..N_SLOTS {
            // P9.6: an I-read (uncounted) grants S but adds NO directory sharer.
            if lk_go_all[h] && !iread_all[h] {
                o_cadd_v    = 1'b1;
                o_cadd_hart = (h % N_HARTS) as 3;
            }
        }
    }
    assign o_cadd_own = lk_excl_w;

    // ------------------------------------------------------------------
    // Write buffer: WB_N line entries in grant order. wb_hd is the oldest
    // entry (waiting for its B), wb_aw / wb_w the next AW / W burst to send.
    // ------------------------------------------------------------------
    const WBI: u32 = if WB_N >= 2 ? $clog2(WB_N) : 1;
    const WBC: u32 = $clog2(WB_N + 1);

    function wb_inc (
        p: input logic<WBI>,
    ) -> logic<WBI> {
        return if p == (WB_N - 1) as WBI ? '0 : p + 1;
    }

    var wb_v   : logic     [WB_N]    ;
    var wb_line: logic<58> [WB_N]    ;
    var wb_lo  : logic<3>  [WB_N]    ;
    var wb_hi  : logic<3>  [WB_N]    ;
    var wb_data: logic<64> [WB_N * 8];
    var wb_strb: logic<8>  [WB_N * 8];
    var wb_tl  : logic<WBI>          ;
    var wb_hd  : logic<WBI>          ;
    var wb_aw  : logic<WBI>          ;
    var wb_w   : logic<WBI>          ;
    var wb_n   : logic<WBC>          ;
    var aw_n   : logic<WBC>          ;
    var w_n    : logic<WBC>          ;
    var w_beat : logic<3>            ;

    // First and last strobed lane of the granted write.
    var in_any: logic   ;
    var in_lo : logic<3>;
    var in_hi : logic<3>;
    always_comb {
        in_any = 1'b0;
        in_lo  = 3'd0;
        in_hi  = 3'd0;
        for l in 0..8 {
            if i_w_strb[l] != 8'd0 {
                if !in_any {
                    in_lo = l as 3;
                }
                in_any = 1'b1;
                in_hi  = l as 3;
            }
        }
    }
    let wb_enq: logic = i_w_valid && in_any;
    always_comb {
        for e in 0..WB_N {
            wb_bclr[e] = i_bvalid && wb_hd == e as WBI;
        }
        for h in 0..N_SLOTS {
            for e in 0..WB_N {
                wbl_all[h][e] = wb_v[e] && wb_line[e] == line_all[h] && !wb_bclr[e];
            }
        }
    }

    // The payload has no reset: an entry is read only while wb_v holds it.
    always_ff (clk) {
        for e in 0..WB_N {
            if wb_enq && (wb_tl == e as WBI) {
                for l in 0..8 {
                    wb_data[e * 8 + l] = i_w_lanes[l];
                    wb_strb[e * 8 + l] = i_w_strb[l];
                }
            }
        }
    }

    let aw_hs  : logic     = o_awvalid && i_awready;
    let w_hs   : logic     = o_wvalid && i_wready;
    let w_lane : logic<3>  = wb_lo[wb_w] + w_beat;
    let w_end  : logic     = w_lane == wb_hi[wb_w];
    let aw_line: logic<58> = wb_line[wb_aw];
    let aw_lo  : logic<3>  = wb_lo[wb_aw];

    assign o_wb_full = wb_n == WB_N as WBC;
    assign o_awvalid = aw_n != '0;
    assign o_awid    = '0;
    let aw_full: logic<64> = {aw_line, aw_lo, 3'b000};
    assign o_awaddr  = aw_full[55:0];
    assign o_awlen   = {5'd0, wb_hi[wb_aw] - aw_lo};
    assign o_wvalid  = w_n != '0;
    assign o_wdata   = wb_data[{wb_w, w_lane}];
    assign o_wstrb   = wb_strb[{wb_w, w_lane}];
    assign o_wlast   = w_end;
    assign o_bready  = 1'b1;

    always_ff (clk, rst) {
        if_reset {
            for e in 0..WB_N {
                wb_v[e]    = 1'b0;
                wb_line[e] = '0;
                wb_lo[e]   = 3'd0;
                wb_hi[e]   = 3'd0;
            }
            wb_tl  = '0;
            wb_hd  = '0;
            wb_aw  = '0;
            wb_w   = '0;
            wb_n   = '0;
            aw_n   = '0;
            w_n    = '0;
            w_beat = 3'd0;
        } else {
            for e in 0..WB_N {
                if wb_enq && (wb_tl == e as WBI) {
                    wb_v[e]    = 1'b1;
                    wb_line[e] = w_line;
                    wb_lo[e]   = in_lo;
                    wb_hi[e]   = in_hi;
                }
                if i_bvalid && (wb_hd == e as WBI) {
                    wb_v[e] = 1'b0;
                }
            }
            if wb_enq {
                wb_tl = wb_inc(wb_tl);
            }
            if i_bvalid {
                wb_hd = wb_inc(wb_hd);
            }
            wb_n = wb_n + (wb_enq as WBC) - (i_bvalid as WBC);
            if aw_hs {
                wb_aw = wb_inc(wb_aw);
            }
            aw_n = aw_n + (wb_enq as WBC) - (aw_hs as WBC);
            if w_hs {
                if w_end {
                    wb_w   = wb_inc(wb_w);
                    w_beat = 3'd0;
                } else {
                    w_beat = w_beat + 3'd1;
                }
            }
            w_n = w_n + (wb_enq as WBC) - ((w_hs && w_end) as WBC);
        }
    }

    // ------------------------------------------------------------------
    // AR channel. A slot in ST_AR may take it unless its line has a write
    // buffered or granted this cycle (a later read must not pass an earlier
    // write: AR and AW are unordered at the slave). The lowest such slot
    // takes the channel when it is free or frees this cycle; the AR then
    // holds from registers until ARREADY.
    // ------------------------------------------------------------------
    var ar_wt  : logic [N_SLOTS]; // in ST_AR, AR not presented yet
    var ar_haz : logic [N_SLOTS];
    var ar_cand: logic [N_SLOTS];
    always_comb {
        for h in 0..N_SLOTS {
            ar_wt[h]  = (st_all[h] == ST_AR) && !(ar_busy_q && (ar_slot_q == (h as ID_W)));
            ar_haz[h] = i_w_valid && (w_line == line_all[h]);
            for e in 0..WB_N {
                if wb_v[e] && (wb_line[e] == line_all[h]) {
                    ar_haz[h] = 1'b1;
                }
            }
            ar_cand[h] = ar_wt[h] && !ar_haz[h] && !i_drain;
        }
    }
    var ar_found: logic [N_SLOTS];
    for h in 0..N_SLOTS :gen_arpick {
        if h == 0 :gen_first {
            assign ar_pick[h]  = ar_cand[h];
            assign ar_found[h] = ar_cand[h];
        } else :gen_rest {
            assign ar_pick[h]  = ar_cand[h] && !ar_found[h - 1];
            assign ar_found[h] = ar_found[h - 1] || ar_cand[h];
        }
    }
    let ar_free: logic = !ar_busy_q || ar_hs;
    for h in 0..N_SLOTS :gen_artake {
        assign ar_take[h] = ar_pick[h] && ar_free;
    }
    var ar_next: logic<ID_W>;
    always_comb {
        ar_next = '0;
        for h in 0..N_SLOTS {
            if ar_pick[h] {
                ar_next = h as ID_W;
            }
        }
    }
    always_ff (clk, rst) {
        if_reset {
            ar_busy_q = 1'b0;
            ar_slot_q = '0;
        } else if ar_free && ar_found[N_SLOTS - 1] {
            ar_busy_q = 1'b1;
            ar_slot_q = ar_next;
        } else if ar_hs {
            ar_busy_q = 1'b0;
        }
    }
    let ar_line: logic<58> = line_all[ar_slot_q];
    let ar_unc : logic     = unc_all[ar_slot_q];
    assign o_arvalid = ar_busy_q;
    var gather_any: logic;
    always_comb {
        gather_any = 1'b0;
        for h in 0..N_SLOTS {
            gather_any |= st_all[h] == ST_GATHER;
        }
    }
    assign o_axi_idle = !ar_busy_q && !gather_any && wb_n == '0;
    assign o_arid    = ar_slot_q;
    let ar_full: logic<64> = if ar_unc ? {ar_line, dw_all[ar_slot_q], 3'b000} : {ar_line, 6'd0};
    assign o_araddr  = ar_full[55:0];
    assign o_arlen   = if ar_unc ? 8'd0 : 8'd7;
    assign o_rready  = 1'b1;

    // ------------------------------------------------------------------
    // P9.2 install stage, in the execute cycle of an IN op. Before the slot
    // may stream:
    //   - a real install (iok): an eligible L2 way (!i_iv_blocked), an
    //     unowned victim (an owned one is recalled first), and the
    //     BACK-INVALIDATE of the victim's sharers (inclusion).
    //   - a suppressed install (gather/install-window write conflict): the
    //     ABORT invalidate to the requester — its L1 fill must not complete
    //     with the stale gathered line (under precise invalidation no
    //     write-side inv reaches it: the line was never entered into the
    //     directory).
    // ------------------------------------------------------------------
    var inst_sel_v: logic;
    var inst_do   : logic; // the slot installs (vs abort)
    always_comb {
        inst_sel_v = 1'b0;
        inst_do    = 1'b0;
        for h in 0..N_SLOTS {
            if inx_all[h] {
                inst_sel_v = 1'b1;
                inst_do    = iok_all[h];
            }
        }
    }

    // The HART view of the installing slot (the abort invalidate's target,
    // and the in-place-overwrite sharer test). Identity at SPH=1.
    var inst_sel_hart_oh: logic<N_HARTS>;
    always_comb {
        inst_sel_hart_oh = '0;
        for h in 0..N_SLOTS {
            if inx_all[h] {
                inst_sel_hart_oh[h % N_HARTS] = 1'b1;
            }
        }
    }

    // Precise-invalidate events. Write events are POSTED (same cycle as the
    // granted write — the "invalidate lands with the write" timing).
    var w_hart_oh: logic<N_HARTS>;
    for h in 0..N_HARTS :gen_w_oh {
        assign w_hart_oh[h] = !i_w_sba && i_w_hart == (h as 3);
    }
    // A plain write keeps the writer's own copy (its L1 merged the data
    // itself), and an SBA write has no writer. A WB (eviction, recall or
    // flush) invalidates nobody: the writer already dropped its copy and no
    // other sharer exists (it was the owner).
    let ev_w1_mask: logic<N_HARTS> = i_x_shr & ~w_hart_oh;
    let ev_w1_v   : logic          = i_w_valid && !i_w_wb && (ev_w1_mask != '0);

    // An OWNED victim is NOT back-invalidated — the recall engine fetches
    // its (possibly dirty) copy home first; a plain invalidate would drop
    // modified data on the floor (observed: h0's freshly-stored mem_map
    // pointer line, owned-M, killed by the back-inv sent while the install
    // sat blocked WAITING for that very recall → stale reload → N=2 boot
    // Oops). After the recall the re-evaluated victim is unowned.
    let inst_need_backinv: logic          = inst_do && i_iv_valid && !i_iv_owned && (i_iv_sharers != '0);
    let inst_need_inv    : logic          = inst_sel_v && (inst_need_backinv || !inst_do);
    let ev_i_addr        : logic<64>      = if inst_do ? i_iv_addr : {x_line_q, 6'd0};
    let ev_i_mask        : logic<N_HARTS> = if inst_do ? i_iv_sharers : inst_sel_hart_oh;

    assign o_inv1_addr = if ev_w1_v ? {w_line, 6'd0} : if inst_need_inv ? ev_i_addr : {x_line_q, 6'd0};
    for h in 0..N_HARTS :gen_inv_out {
        assign o_inv1_v[h] = if ev_w1_v ? ev_w1_mask[h] : if inst_need_inv ? ev_i_mask[h] : (lk_need_inv && lk_imask[h]);
    }

    // Go/hold for the installing slot. Phase B: an OWNED victim must be
    // recalled before the eviction (engine request below).
    let inst_blocked: logic = inst_do && (i_iv_blocked || i_iv_owned);
    for h in 0..N_SLOTS :gen_inst_go {
        assign inst_go_all[h] = inx_all[h] && !inst_blocked;
    }
    // Phase B: grant state at install — the installer becomes owner (E for a
    // read miss, M-capable for an RFO) unless an in-place overwrite finds
    // other harts still listed.
    for h in 0..N_SLOTS :gen_inst_excl {
        assign inst_excl_w[h] = rfo_all[h] || ((i_x_shr & ~inst_sel_hart_oh) == '0);
    }
    // Victim-recall owner (one-hot victim sharer mask).
    var iv_owner: logic<3>;
    always_comb {
        iv_owner = 3'd0;
        for h in 0..N_HARTS {
            if i_iv_sharers[h] {
                iv_owner = h as 3;
            }
        }
    }
    let iv_recall_req: logic = inst_sel_v && inst_do && i_iv_valid && i_iv_owned;

    // ------------------------------------------------------------------
    // P9.2 Phase B: recall engine. One outstanding recall, requested by the
    // executing op: a vetoed write, an install with an owned victim, or a
    // lookup of an owned line. Completion: the probed owner's WB for the
    // line arrives on the write channel (dirty copy — the home merges it
    // and clears ownership), or the owner answers probe_ack (clean copy /
    // already gone / WB already in its buffer ⇒ wait for that WB instead),
    // upon which the engine's EC op drops it from the directory; the line
    // stays held until then.
    // ------------------------------------------------------------------
    let eng_done_ack: logic = eng_busy && !eng_ec_q && i_probe_ack[eng_hart];
    let eng_done_wb : logic = eng_busy && !eng_ec_q && i_w_valid && i_w_wb && (w_line == eng_line);
    assign eng_ack_ec = eng_done_ack && !eng_done_wb;
    let eng_start   : logic = !eng_busy && (i_wv_req || iv_recall_req || lk_recall_req);
    always_ff (clk, rst) {
        if_reset {
            eng_busy = 1'b0;
            eng_ec_q = 1'b0;
            eng_lk_q = 1'b0;
            eng_ls_q = '0;
            eng_line = '0;
            eng_hart = 3'd0;
            eng_self = 1'b0;
        } else if eng_start {
            eng_busy = 1'b1;
            eng_lk_q = 1'b0;
            if i_wv_req {
                eng_line = i_wv_line;
                eng_hart = i_wv_hart;
                eng_self = 1'b0;
            } else if iv_recall_req {
                eng_line = i_iv_addr[63:6];
                eng_hart = iv_owner;
                eng_self = 1'b0;
            } else {
                eng_lk_q = 1'b1;
                eng_ls_q = x_slot_q;
                eng_line = x_line_q;
                eng_hart = lk_owner;
                eng_self = lk_owner == lk_h && !lk_sba;
            }
        } else if eng_done_wb {
            eng_busy = 1'b0;
        } else if eng_ack_ec {
            eng_ec_q = 1'b1;
        } else if x_ec {
            eng_busy = 1'b0;
            eng_ec_q = 1'b0;
        }
    }
    for h in 0..N_HARTS :gen_probe {
        assign o_probe_v[h] = eng_busy && !eng_ec_q && (eng_hart == (h as 3));
    }
    assign o_probe_addr = {eng_line, 6'd0};
    assign o_probe_self = eng_self;
    assign o_eclr_v     = x_ec;
    assign o_eclr_hart  = eng_hart;

    // L2 install: the executing IN op's slot.
    always_comb {
        o_inst_hart = 3'd0;
        for l in 0..8 {
            o_l2_inst_data[l] = 64'd0;
        }
        for h in 0..N_SLOTS {
            if inx_all[h] {
                o_inst_hart = h as 3;
                for l in 0..8 {
                    o_l2_inst_data[l] = buf_all[h * 8 + l];
                }
            }
        }
    }
    assign o_l2_inst_v = inst_sel_v && inst_do && !inst_blocked;

    let r_err: logic = i_rvalid && (i_rresp != 2'b00);
    let b_err: logic = i_bvalid && (i_bresp != 2'b00);
    var r_any_ok: logic;
    always_comb {
        r_any_ok = 1'b0;
        for h in 0..N_SLOTS {
            if r_ok[h] {
                r_any_ok = 1'b1;
            }
        }
    }
    let p_err: logic = (i_rvalid && !r_any_ok) || (i_bvalid && (i_bid != '0));
    always_ff (clk, rst) {
        if_reset {
            o_axi_err = 3'b000;
        } else {
            o_axi_err = o_axi_err | {p_err, b_err, r_err};
        }
    }

    // ------------------------------------------------------------------
    // Event wires.
    // ------------------------------------------------------------------
    // Write-buffer entries whose AW is presented or accepted and whose B is
    // still due: the oldest wb_n - aw_n (+1 while an AW is presented).
    var wr_fly: logic [WB_N];
    for e in 0..WB_N :gen_wrfly {
        let age : logic<WBC> = if (e as WBI) >= wb_hd ? (e as WBC) - (wb_hd as WBC) : (e as WBC) + (WB_N as WBC) - (wb_hd as WBC);
        let sent: logic<WBC> = wb_n - aw_n;
        assign wr_fly[e] = (age <: wb_n) && (age <: sent || ((age == sent) && (aw_n != '0)));
    }
    always_comb {
        o_perf            = 0;
        o_perf.ar_line    = ar_hs && !ar_unc;
        o_perf.ar_dram1   = ar_hs && ar_unc && !rom_all[ar_slot_q];
        o_perf.ar_rom     = ar_hs && ar_unc && rom_all[ar_slot_q];
        o_perf.aw         = aw_hs;
        o_perf.w_beat     = w_hs;
        o_perf.ar_bp      = o_arvalid && !i_arready;
        o_perf.inst_abort = inst_sel_v && !inst_do && !inst_blocked;
        o_perf.r_err      = r_err;
        o_perf.b_err      = b_err;
        for h in 0..N_SLOTS {
            if st_all[h] == ST_UNCD && cmo_all[h] && o_hgrant[h] {
                o_perf.cmo = 1'b1;
            }
        }
        for h in 0..N_SLOTS {
            if ar_wt[h] && ar_haz[h] {
                o_perf.i1_hold = 1'b1;
            }
            if ar_wt[h] && !ar_haz[h] && !ar_take[h] {
                o_perf.ar_wait = 1'b1;
            }
            // The latency vectors are MC_PERF_N wide; later slots and
            // entries are not counted.
            if h <: soc_pkg::MC_PERF_N {
                o_perf.lat_line[h]  = rd_fly[h] && !unc_all[h];
                o_perf.lat_dram1[h] = rd_fly[h] && unc_all[h] && !rom_all[h];
                o_perf.lat_rom[h]   = rd_fly[h] && unc_all[h] && rom_all[h];
            }
        }
        for e in 0..WB_N {
            if e <: soc_pkg::MC_PERF_N {
                o_perf.lat_wr[e] = wr_fly[e];
            }
        }
    }

    #[ifdef(HELIODOR_CHK)]
    {
        var chk_q: logic;
        var bad  : logic;
        always_comb {
            bad = 1'b0;
            for h in 0..N_SLOTS {
                if st_all[h] == ST_UNCD && cmo_all[h] {
                    if ((o_l2_inst_v || o_cadd_v) && x_line_q == line_all[h])
                        || (o_w_cadd_v && w_line == line_all[h]) {
                        bad = 1'b1;
                    }
                    for g in 0..N_SLOTS {
                        if g != h && st_all[g] != ST_IDLE && line_all[g] == line_all[h] {
                            bad = 1'b1;
                        }
                    }
                }
            }
            if i_w_valid && !(x_wr && w_line == x_line_q) {
                bad = 1'b1;
            }
        }
        always_ff (clk, rst) {
            if_reset {
                chk_q = 1'b0;
            } else if bad {
                chk_q = 1'b1;
            }
        }
        assign o_chk = chk_q;
    }
    #[ifndef(HELIODOR_CHK)]
    assign o_chk = 1'b0;
}
