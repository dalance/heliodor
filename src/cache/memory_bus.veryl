// Multi-hart MMIO arbiter.
//
// Lowest-ID active hart wins. Per-hart MMIO request bundles are arbitrated
// to a single shared peripheral interface. Peripheral rdata coming back is
// broadcast to every hart by heliodor_soc (with a 1-cycle flop to break
// cross-module comb paths).
//
// Invalidate broadcast for dcache coherence is implemented in heliodor_soc
// directly (per-hart wires) so the dynamic-index pattern doesn't surface
// in this module — the simulator's analyze_dependency mishandles dynamic
// indices into N_HARTS-sized arrays.
//
// N_HARTS == 1 is a degenerate case (no arbitration) and is split out via
// generate-if so the multi-hart `i_*[grant_idx]` dynamic-index pattern
// never appears when the param is 1. Without this split, the Veryl
// simulator panics during pub-module analysis (default param N_HARTS=1)
// at expression.rs:4232 with "len=1, index=1".
pub module memory_bus #(
    param N_HARTS: u32 = 1,
) (
    clk: input clock,
    rst: input reset,
    // MMIO inputs
    i_mmio_paddr: input  logic<32> [N_HARTS],
    i_mmio_wdata: input  logic<64> [N_HARTS],
    i_mmio_wstrb: input  logic<8>  [N_HARTS],
    i_mmio_wen  : input  logic     [N_HARTS],
    i_mmio_ren  : input  logic     [N_HARTS],
    i_clint_sel : input  logic     [N_HARTS],
    i_plic_sel  : input  logic     [N_HARTS],
    i_uart_sel  : input  logic     [N_HARTS],
    i_stall_mem : input  logic     [N_HARTS],
    o_mmio_paddr    : output logic<32>,
    o_mmio_wdata    : output logic<64>,
    o_mmio_wstrb    : output logic<8> ,
    o_mmio_wen_clint: output logic    ,
    o_mmio_ren_clint: output logic    ,
    o_mmio_wen_plic : output logic    ,
    o_mmio_ren_plic : output logic    ,
    o_mmio_wen_uart : output logic    ,
    o_mmio_ren_uart : output logic    ,

    // Phase 5: DRAM bus arbitration (single shared port).
    // Per-hart dcache request bundles + amo_inflight (priority lock).
    // When any hart asserts amo_inflight, only that hart wins grants
    // until amo_inflight drops — gives bus-atomic AMO RMW windows.
    i_dmem_addr     : input  logic<64> [N_HARTS],
    i_dmem_wdata    : input  logic<64> [N_HARTS],
    i_dmem_wstrb    : input  logic<8>  [N_HARTS],
    i_dmem_wen      : input  logic     [N_HARTS],
    i_dmem_ren      : input  logic     [N_HARTS],
    i_dmem_req      : input  logic     [N_HARTS],
    i_amo_inflight  : input  logic     [N_HARTS],
    o_dmem_grant    : output logic     [N_HARTS],
    o_dmem_addr     : output logic<64>,
    o_dmem_wdata    : output logic<64>,
    o_dmem_wstrb    : output logic<8> ,
    o_dmem_wen      : output logic    ,
    o_dmem_ren      : output logic    ,
    // Invalidate broadcast: address granted hart wrote, exposed to all harts
    // as inv pulse for cache coherence.
    o_dmem_inv_valid: output logic    ,
    o_dmem_inv_addr : output logic<64>,
) {
    if N_HARTS == 1: gen_n1 {
        // Degenerate: hart 0 owns the bus, no arbitration.
        let active0: logic = (i_mmio_wen[0] || i_mmio_ren[0])
                          && (i_clint_sel[0] || i_plic_sel[0] || i_uart_sel[0])
                          && !i_stall_mem[0];
        assign o_mmio_paddr     = i_mmio_paddr[0];
        assign o_mmio_wdata     = i_mmio_wdata[0];
        assign o_mmio_wstrb     = i_mmio_wstrb[0];
        assign o_mmio_wen_clint = active0 && i_mmio_wen[0] && i_clint_sel[0];
        assign o_mmio_ren_clint = active0 && i_mmio_ren[0] && i_clint_sel[0];
        assign o_mmio_wen_plic  = active0 && i_mmio_wen[0] && i_plic_sel [0];
        assign o_mmio_ren_plic  = active0 && i_mmio_ren[0] && i_plic_sel [0];
        assign o_mmio_wen_uart  = active0 && i_mmio_wen[0] && i_uart_sel [0];
        assign o_mmio_ren_uart  = active0 && i_mmio_ren[0] && i_uart_sel [0];

        // DRAM bus: hart 0 always granted (no contention).
        assign o_dmem_grant[0]   = i_dmem_req[0];
        assign o_dmem_addr       = i_dmem_addr [0];
        assign o_dmem_wdata      = i_dmem_wdata[0];
        assign o_dmem_wstrb      = i_dmem_wstrb[0];
        assign o_dmem_wen        = i_dmem_wen  [0];
        assign o_dmem_ren        = i_dmem_ren  [0];
        // Invalidate broadcast unused at N=1 (no other hart to notify).
        assign o_dmem_inv_valid  = 1'b0;
        assign o_dmem_inv_addr   = 64'd0;
    } else if N_HARTS == 2: gen_n2 {
        // N=2: round-robin arbitration (Phase 5 SMP fix). Static-priority
        // for hart 0 starved hart 1's MMIO writes — observed h1 holding
        // a msip[1] write request for 603K cycles without being granted
        // because hart 0 had bursty CLINT activity (timer/printk ecalls),
        // which made the kernel stop_machine livelock unrecoverable.
        // Round-robin matches the dmem path's fairness and unblocks hart
        // 1's IPI delivery to itself (ack writes / etc).
        var last_granted_mmio_h0: logic;
        // !i_stall_mem gate REMOVED (Phase 5 fix). The hart's stall_mem
        // can stay high while it's WAITING for an MMIO grant, which made
        // the gate self-deadlocking — observed h1_req_msip1=603K cycles
        // pending without ever being granted because stall_mem[1] stayed
        // high during the pending request.
        let active0: logic = (i_mmio_wen[0] || i_mmio_ren[0])
                          && (i_clint_sel[0] || i_plic_sel[0] || i_uart_sel[0]);
        let active1: logic = (i_mmio_wen[1] || i_mmio_ren[1])
                          && (i_clint_sel[1] || i_plic_sel[1] || i_uart_sel[1]);
        let both_active_mmio: logic = active0 && active1;
        let grant_h0: logic = if both_active_mmio ? !last_granted_mmio_h0
                            : active0;
        let grant_h1: logic = if both_active_mmio ? last_granted_mmio_h0
                            : (!active0 && active1);
        always_ff (clk, rst) {
            if_reset {
                last_granted_mmio_h0 = 1'b0;
            } else if grant_h0 {
                last_granted_mmio_h0 = 1'b1;
            } else if grant_h1 {
                last_granted_mmio_h0 = 1'b0;
            }
        }

        assign o_mmio_paddr = if grant_h0 ? i_mmio_paddr[0] : i_mmio_paddr[1];
        assign o_mmio_wdata = if grant_h0 ? i_mmio_wdata[0] : i_mmio_wdata[1];
        assign o_mmio_wstrb = if grant_h0 ? i_mmio_wstrb[0] : i_mmio_wstrb[1];

        assign o_mmio_wen_clint = (grant_h0 && i_mmio_wen[0] && i_clint_sel[0])
                               || (grant_h1 && i_mmio_wen[1] && i_clint_sel[1]);
        assign o_mmio_ren_clint = (grant_h0 && i_mmio_ren[0] && i_clint_sel[0])
                               || (grant_h1 && i_mmio_ren[1] && i_clint_sel[1]);
        assign o_mmio_wen_plic  = (grant_h0 && i_mmio_wen[0] && i_plic_sel[0])
                               || (grant_h1 && i_mmio_wen[1] && i_plic_sel[1]);
        assign o_mmio_ren_plic  = (grant_h0 && i_mmio_ren[0] && i_plic_sel[0])
                               || (grant_h1 && i_mmio_ren[1] && i_plic_sel[1]);
        assign o_mmio_wen_uart  = (grant_h0 && i_mmio_wen[0] && i_uart_sel[0])
                               || (grant_h1 && i_mmio_wen[1] && i_uart_sel[1]);
        assign o_mmio_ren_uart  = (grant_h0 && i_mmio_ren[0] && i_uart_sel[0])
                               || (grant_h1 && i_mmio_ren[1] && i_uart_sel[1]);

        // Phase 5 DRAM arbitration (N=2). amo_inflight gives priority lock
        // for the holder; otherwise round-robin (track last-granted hart and
        // give the OTHER one priority next cycle when both request).
        // Burst self-holds because dcache keeps i_dmem_req high through an
        // 8-cycle FILL — and during those bursts only one hart usually has
        // a request, so the alternation only triggers when both contend.
        var last_granted_h0: logic;
        let amo_lock_0: logic = i_amo_inflight[0];
        let amo_lock_1: logic = i_amo_inflight[1] && !amo_lock_0;
        let both_req   : logic = i_dmem_req[0] && i_dmem_req[1];
        let dmem_grant_h0: logic = if amo_lock_0 ? 1'b1
                                 : if amo_lock_1 ? 1'b0
                                 : if both_req ? !last_granted_h0
                                 : i_dmem_req[0];
        let dmem_grant_h1: logic = if amo_lock_0 ? 1'b0
                                 : if amo_lock_1 ? 1'b1
                                 : if both_req ? last_granted_h0
                                 : !i_dmem_req[0] && i_dmem_req[1];
        assign o_dmem_grant[0] = dmem_grant_h0 && i_dmem_req[0];
        assign o_dmem_grant[1] = dmem_grant_h1 && i_dmem_req[1];

        always_ff (clk, rst) {
            if_reset {
                last_granted_h0 = 1'b0;
            } else if dmem_grant_h0 && i_dmem_req[0] {
                last_granted_h0 = 1'b1;
            } else if dmem_grant_h1 && i_dmem_req[1] {
                last_granted_h0 = 1'b0;
            }
        }

        // Single-port DRAM mux. When neither hart actually has a live
        // transaction (just amo_lock holding), o_dmem_wen/o_dmem_ren are 0
        // because the granted hart's i_dmem_wen/i_dmem_ren are 0.
        assign o_dmem_addr  = if dmem_grant_h0 ? i_dmem_addr [0] : i_dmem_addr [1];
        assign o_dmem_wdata = if dmem_grant_h0 ? i_dmem_wdata[0] : i_dmem_wdata[1];
        assign o_dmem_wstrb = if dmem_grant_h0 ? i_dmem_wstrb[0] : i_dmem_wstrb[1];
        assign o_dmem_wen   = (dmem_grant_h0 && i_dmem_wen[0] && i_dmem_req[0])
                           || (dmem_grant_h1 && i_dmem_wen[1] && i_dmem_req[1]);
        assign o_dmem_ren   = (dmem_grant_h0 && i_dmem_ren[0] && i_dmem_req[0])
                           || (dmem_grant_h1 && i_dmem_ren[1] && i_dmem_req[1]);

        // Invalidate broadcast: any cycle the granted hart writes DRAM,
        // pulse invalidate so the other hart drops the line.
        assign o_dmem_inv_valid = o_dmem_wen;
        assign o_dmem_inv_addr  = o_dmem_addr;
    } else: gen_arb {
        // Generic N>=3 path (untested; preserved for future N=4 expansion).
        var active : logic [N_HARTS];
        for h in 0..N_HARTS: gen_active {
            assign active[h] = (i_mmio_wen[h] || i_mmio_ren[h])
                            && (i_clint_sel[h] || i_plic_sel[h] || i_uart_sel[h])
                            && !i_stall_mem[h];
        }

        var grant_found : logic    [N_HARTS];
        var grant_idx_st: logic<3> [N_HARTS];
        for h in 0..N_HARTS: gen_grant {
            if h == 0: gen_first {
                assign grant_found [h] = active[h];
                assign grant_idx_st[h] = 3'd0;
            } else: gen_rest {
                assign grant_found [h] = grant_found[h - 1] || active[h];
                assign grant_idx_st[h] = if grant_found[h - 1] ? grant_idx_st[h - 1] : h as 3;
            }
        }
        let grant_valid: logic    = grant_found [N_HARTS - 1];
        let grant_idx  : logic<3> = grant_idx_st[N_HARTS - 1];

        assign o_mmio_paddr = i_mmio_paddr[grant_idx];
        assign o_mmio_wdata = i_mmio_wdata[grant_idx];
        assign o_mmio_wstrb = i_mmio_wstrb[grant_idx];

        let g_wen   : logic = grant_valid && i_mmio_wen[grant_idx];
        let g_ren   : logic = grant_valid && i_mmio_ren[grant_idx];
        let g_clint : logic = grant_valid && i_clint_sel[grant_idx];
        let g_plic  : logic = grant_valid && i_plic_sel [grant_idx];
        let g_uart  : logic = grant_valid && i_uart_sel [grant_idx];

        assign o_mmio_wen_clint = g_wen && g_clint;
        assign o_mmio_ren_clint = g_ren && g_clint;
        assign o_mmio_wen_plic  = g_wen && g_plic;
        assign o_mmio_ren_plic  = g_ren && g_plic;
        assign o_mmio_wen_uart  = g_wen && g_uart;
        assign o_mmio_ren_uart  = g_ren && g_uart;

        // Phase 5 DRAM arbitration N>=3 (untested; future N=4 use).
        // amo_inflight wins; otherwise lowest-id requesting hart.
        var amo_found : logic    [N_HARTS];
        var amo_idx_st: logic<3> [N_HARTS];
        for h in 0..N_HARTS: gen_amo {
            if h == 0: gen_first {
                assign amo_found [h] = i_amo_inflight[h];
                assign amo_idx_st[h] = 3'd0;
            } else: gen_rest {
                assign amo_found [h] = amo_found[h - 1] || i_amo_inflight[h];
                assign amo_idx_st[h] = if amo_found[h - 1] ? amo_idx_st[h - 1] : h as 3;
            }
        }
        let amo_lock     : logic    = amo_found [N_HARTS - 1];
        let amo_holder   : logic<3> = amo_idx_st[N_HARTS - 1];

        var dreq_found : logic    [N_HARTS];
        var dreq_idx_st: logic<3> [N_HARTS];
        for h in 0..N_HARTS: gen_dreq {
            if h == 0: gen_first {
                assign dreq_found [h] = i_dmem_req[h];
                assign dreq_idx_st[h] = 3'd0;
            } else: gen_rest {
                assign dreq_found [h] = dreq_found[h - 1] || i_dmem_req[h];
                assign dreq_idx_st[h] = if dreq_found[h - 1] ? dreq_idx_st[h - 1] : h as 3;
            }
        }
        let dmem_grant_valid: logic    = if amo_lock ? 1'b1 : dreq_found[N_HARTS - 1];
        let dmem_grant_idx  : logic<3> = if amo_lock ? amo_holder : dreq_idx_st[N_HARTS - 1];

        for h in 0..N_HARTS: gen_dgrant {
            assign o_dmem_grant[h] = dmem_grant_valid && (h == dmem_grant_idx) && i_dmem_req[h];
        }
        assign o_dmem_addr  = i_dmem_addr [dmem_grant_idx];
        assign o_dmem_wdata = i_dmem_wdata[dmem_grant_idx];
        assign o_dmem_wstrb = i_dmem_wstrb[dmem_grant_idx];
        assign o_dmem_wen   = dmem_grant_valid && i_dmem_wen[dmem_grant_idx] && i_dmem_req[dmem_grant_idx];
        assign o_dmem_ren   = dmem_grant_valid && i_dmem_ren[dmem_grant_idx] && i_dmem_req[dmem_grant_idx];
        assign o_dmem_inv_valid = o_dmem_wen;
        assign o_dmem_inv_addr  = o_dmem_addr;
    }
}
