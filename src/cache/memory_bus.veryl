// Multi-hart MMIO arbiter.
//
// Lowest-ID active hart wins. Per-hart MMIO request bundles are arbitrated
// to a single shared peripheral interface. Peripheral rdata coming back is
// broadcast to every hart by heliodor_soc (with a 1-cycle flop to break
// cross-module comb paths).
//
// Invalidate broadcast for dcache coherence is implemented in heliodor_soc
// directly (per-hart wires) so the dynamic-index pattern doesn't surface
// in this module — the simulator's analyze_dependency mishandles dynamic
// indices into N_HARTS-sized arrays.
//
// N=1 falls through to gen_arb (the generic dynamic-index path). The
// earlier dedicated gen_n1 split was kept because the Veryl analyzer
// used to panic when default param N_HARTS=1 hit the dynamic-index
// pattern (expression.rs:4232 "len=1, index=1"); that bug has since
// been fixed upstream, so the split is no longer necessary.
//
// N=4 has its own gen_n4 round-robin path (Phase 6.A.1) so the
// 4-way fairness is explicit and easily auditable; gen_arb's
// generic priority encoder defaults to lowest-id-wins which would
// starve high-id harts under bus contention.
pub module memory_bus #(
    param N_HARTS: u32 = 1,
) (
    clk: input clock,
    rst: input reset,
    // MMIO inputs
    i_mmio_paddr    : input  logic<32> [N_HARTS],
    i_mmio_wdata    : input  logic<64> [N_HARTS],
    i_mmio_wstrb    : input  logic<8>  [N_HARTS],
    i_mmio_wen      : input  logic     [N_HARTS],
    i_mmio_ren      : input  logic     [N_HARTS],
    i_clint_sel     : input  logic     [N_HARTS],
    i_plic_sel      : input  logic     [N_HARTS],
    i_uart_sel      : input  logic     [N_HARTS],
    i_stall_mem     : input  logic     [N_HARTS],
    o_mmio_paddr    : output logic<32>          ,
    o_mmio_wdata    : output logic<64>          ,
    o_mmio_wstrb    : output logic<8>           ,
    o_mmio_wen_clint: output logic              ,
    o_mmio_ren_clint: output logic              ,
    o_mmio_wen_plic : output logic              ,
    o_mmio_ren_plic : output logic              ,
    o_mmio_wen_uart : output logic              ,
    o_mmio_ren_uart : output logic              ,
    // Per-hart MMIO grant — back-pressure to heliodor_core. When a hart
    // asserts an MMIO request but loses arbitration, o_mmio_grant=0 for
    // that hart, and the core must stall MEM and retry next cycle. This
    // fixes the Phase 5 SMP livelock where hart 0's msip[1] writes were
    // silently dropped because the pipeline assumed 1-cycle MMIO.
    o_mmio_grant: output logic [N_HARTS],

    // Phase 5 / S23: DRAM bus arbitration, now TWO independent channels —
    // READ (dcache fills / miss reads) and WRITE (write-through stores +
    // drains) — each with its own per-hart request/grant and rotation.
    // The downstream DRAM port is still single: READS (fills) keep their
    // pre-split priority; the SoC computes i_wgrant_ok (= the read channel
    // does not need DRAM this cycle — L2 read-hit or idle — minus
    // same-peripheral conflicts) and the WRITE grant is gated on it, so
    // drains fill only the read channel's free slots.
    // S25 write-combining: the write channel carries a full 64B LINE per
    // transaction — 8 dword lanes with per-lane byte strobes (hart h lane l
    // = flat index h*8+l). A single-dword write (slow store / MMIO) is a
    // line write with one populated lane; lanes with wstrb==0 are dont-care.
    i_dmemr_addr  : input  logic<64> [N_HARTS]    ,
    i_dmemr_ren   : input  logic     [N_HARTS]    ,
    i_dmemr_req   : input  logic     [N_HARTS]    ,
    i_dmemw_addr  : input  logic<64> [N_HARTS]    ,
    i_dmemw_wdata : input  logic<64> [N_HARTS * 8],
    i_dmemw_wstrb : input  logic<8>  [N_HARTS * 8],
    i_dmemw_wen   : input  logic     [N_HARTS]    ,
    i_dmemw_req   : input  logic     [N_HARTS]    ,
    // P9.2: per-hart WRITEBACK flag (an L1 dirty-line writeback rides the
    // write channel; the home merges it without invalidates).
    i_dmemw_wb    : input  logic     [N_HARTS]    ,
    // (P9.3: the bus-wide AMO lock ports are gone — RMW atomicity moved
    // into the L1 via MESI ownership; see dcache/heliodor_core.)
    i_wgrant_ok   : input  logic                  ,
    o_dmemr_grant : output logic     [N_HARTS]    ,
    o_dmemw_grant : output logic     [N_HARTS]    ,
    o_dmemr_addr  : output logic<64>              ,
    o_dmemr_ren   : output logic                  ,
    o_dmemw_addr  : output logic<64>              ,
    o_dmemw_wdata : output logic<64> [8]          ,
    o_dmemw_wstrb : output logic<8>  [8]          ,
    o_dmemw_wen   : output logic                  ,
    // P9.2: the muxed writeback flag + the write channel's SELECTED hart
    // (valid with the selection, independent of i_wgrant_ok — the SoC's
    // ownership VETO consults the directory on the selected address before
    // the grant fires).
    o_dmemw_wb    : output logic                  ,
    o_dmemw_sel   : output logic<3>               ,
    // Invalidate broadcast: address the granted hart wrote (write channel),
    // exposed to all harts as an inv pulse for cache coherence.
    o_dmem_inv_valid: output logic    ,
    o_dmem_inv_addr : output logic<64>,
) {
    if N_HARTS == 2 :gen_n2 {
        // N=2: round-robin arbitration (Phase 5 SMP fix). Static-priority
        // for hart 0 starved hart 1's MMIO writes — observed h1 holding
        // a msip[1] write request for 603K cycles without being granted
        // because hart 0 had bursty CLINT activity (timer/printk ecalls),
        // which made the kernel stop_machine livelock unrecoverable.
        // Round-robin matches the dmem path's fairness and unblocks hart
        // 1's IPI delivery to itself (ack writes / etc).
        var last_granted_mmio_h0: logic;
        // !i_stall_mem gate REMOVED (Phase 5 fix). The hart's stall_mem
        // can stay high while it's WAITING for an MMIO grant, which made
        // the gate self-deadlocking — observed h1_req_msip1=603K cycles
        // pending without ever being granted because stall_mem[1] stayed
        // high during the pending request.
        let active0         : logic = (i_mmio_wen[0] || i_mmio_ren[0])
            && (i_clint_sel[0] || i_plic_sel[0] || i_uart_sel[0]);
        let active1         : logic = (i_mmio_wen[1] || i_mmio_ren[1])
            && (i_clint_sel[1] || i_plic_sel[1] || i_uart_sel[1]);
        let both_active_mmio: logic = active0 && active1;
        let grant_h0        : logic = if both_active_mmio ? !last_granted_mmio_h0 : active0;
        let grant_h1        : logic = if both_active_mmio ? last_granted_mmio_h0 : (!active0 && active1);
        always_ff (clk, rst) {
            if_reset {
                last_granted_mmio_h0 = 1'b0;
            } else if grant_h0 {
                last_granted_mmio_h0 = 1'b1;
            } else if grant_h1 {
                last_granted_mmio_h0 = 1'b0;
            }
        }

        assign o_mmio_paddr = if grant_h0 ? i_mmio_paddr[0] : i_mmio_paddr[1];
        assign o_mmio_wdata = if grant_h0 ? i_mmio_wdata[0] : i_mmio_wdata[1];
        assign o_mmio_wstrb = if grant_h0 ? i_mmio_wstrb[0] : i_mmio_wstrb[1];

        assign o_mmio_wen_clint = (grant_h0 && i_mmio_wen[0] && i_clint_sel[0])
            || (grant_h1 && i_mmio_wen[1] && i_clint_sel[1]);
        assign o_mmio_ren_clint = (grant_h0 && i_mmio_ren[0] && i_clint_sel[0])
            || (grant_h1 && i_mmio_ren[1] && i_clint_sel[1]);
        assign o_mmio_wen_plic  = (grant_h0 && i_mmio_wen[0] && i_plic_sel[0])
            || (grant_h1 && i_mmio_wen[1] && i_plic_sel[1]);
        assign o_mmio_ren_plic  = (grant_h0 && i_mmio_ren[0] && i_plic_sel[0])
            || (grant_h1 && i_mmio_ren[1] && i_plic_sel[1]);
        assign o_mmio_wen_uart  = (grant_h0 && i_mmio_wen[0] && i_uart_sel[0])
            || (grant_h1 && i_mmio_wen[1] && i_uart_sel[1]);
        assign o_mmio_ren_uart  = (grant_h0 && i_mmio_ren[0] && i_uart_sel[0])
            || (grant_h1 && i_mmio_ren[1] && i_uart_sel[1]);
        // MMIO grant back-pressure: signal each hart whether ITS request
        // was actually granted this cycle. heliodor_core uses this to
        // stall MEM until granted (otherwise the write was silently
        // dropped — observed root cause of Phase 5 SMP livelock).
        assign o_mmio_grant[0] = grant_h0 && active0;
        assign o_mmio_grant[1] = grant_h1 && active1;

        // Phase 5 / S23 DRAM arbitration (N=2), two channels. Round-robin
        // per channel. P9.3: the bus-wide AMO lock is GONE — RMW atomicity
        // now comes from MESI ownership in the L1 (in-cache AMO) with the
        // core's watch/replay backstop, so neither channel is ever pinned.
        var last_granted_r_h0: logic; // 1 => hart0 was served last (read ch)
        var last_granted_w_h0: logic; // 1 => hart0 was served last (write ch)
        // S20R note kept for the rotation shape: the read rotation's "wants"
        // include WRITE requests so a write-only hart takes (and yields) a
        // rotation slot — fairness across the two channels.
        let wantr0          : logic = i_dmemr_req[0] || i_dmemw_req[0];
        let wantr1          : logic = i_dmemr_req[1] || i_dmemw_req[1];
        let any_wantr       : logic = wantr0 || wantr1;
        let rr_r_idx        : logic = if wantr0 && wantr1 ? last_granted_r_h0 : wantr1;
        let dmemr_grant_h0  : logic = any_wantr && !rr_r_idx;
        let dmemr_grant_h1  : logic = any_wantr && rr_r_idx;
        assign o_dmemr_grant[0] = dmemr_grant_h0 && i_dmemr_req[0];
        assign o_dmemr_grant[1] = dmemr_grant_h1 && i_dmemr_req[1];

        let wantw0        : logic = i_dmemw_req[0];
        let wantw1        : logic = i_dmemw_req[1];
        let any_wantw     : logic = wantw0 || wantw1;
        let rr_w_idx      : logic = if wantw0 && wantw1 ? last_granted_w_h0 : wantw1;
        let dmemw_grant_h0: logic = any_wantw && !rr_w_idx;
        let dmemw_grant_h1: logic = any_wantw && rr_w_idx;
        assign o_dmemw_grant[0] = dmemw_grant_h0 && i_dmemw_req[0] && i_wgrant_ok;
        assign o_dmemw_grant[1] = dmemw_grant_h1 && i_dmemw_req[1] && i_wgrant_ok;

        always_ff (clk, rst) {
            if_reset {
                last_granted_r_h0 = 1'b0;
                last_granted_w_h0 = 1'b0;
            } else {
                if any_wantr {
                    last_granted_r_h0 = !rr_r_idx;
                }
                if any_wantw {
                    last_granted_w_h0 = !rr_w_idx;
                }
            }
        }

        // Per-channel downstream muxes.
        assign o_dmemr_addr = if dmemr_grant_h0 ? i_dmemr_addr[0] : i_dmemr_addr[1];
        assign o_dmemr_ren  = ((dmemr_grant_h0 && i_dmemr_ren[0] && i_dmemr_req[0])
            || (dmemr_grant_h1 && i_dmemr_ren[1] && i_dmemr_req[1]));
        assign o_dmemw_addr = if dmemw_grant_h0 ? i_dmemw_addr[0] : i_dmemw_addr[1];
        for l in 0..8 :gen_wlane_n2 {
            assign o_dmemw_wdata[l] = if dmemw_grant_h0 ? i_dmemw_wdata[l] : i_dmemw_wdata[8 + l];
            assign o_dmemw_wstrb[l] = if dmemw_grant_h0 ? i_dmemw_wstrb[l] : i_dmemw_wstrb[8 + l];
        }
        assign o_dmemw_wen = ((dmemw_grant_h0 && i_dmemw_wen[0] && i_dmemw_req[0])
            || (dmemw_grant_h1 && i_dmemw_wen[1] && i_dmemw_req[1])) && i_wgrant_ok;
        assign o_dmemw_wb  = if dmemw_grant_h0 ? i_dmemw_wb[0] : i_dmemw_wb[1];
        assign o_dmemw_sel = if dmemw_grant_h0 ? 3'd0 : 3'd1;

        // Invalidate broadcast: any cycle the granted hart writes DRAM,
        // pulse invalidate so the other hart drops the line.
        assign o_dmem_inv_valid = o_dmemw_wen;
        assign o_dmem_inv_addr  = o_dmemw_addr;
        } else if N_HARTS == 4 :gen_n4 {
        // 4-way round-robin (Phase 6.A.1). Same fairness shape as gen_n2 —
        // track last-granted hart index, give the OTHER three priority
        // through a priority encoder over rotated candidates. AMO lock has
        // priority over round-robin (lowest-id breaks AMO ties — Linux SMP
        // kernel never has overlapping AMOs from multiple harts in
        // practice, so the tie path is unreachable but kept for safety).

        // ---- MMIO arbitration ----
        var last_granted_mmio_idx: logic<2>;

        var active_mmio: logic [4];
        for h in 0..4 :gen_active_mmio {
            assign active_mmio[h] = (i_mmio_wen[h] || i_mmio_ren[h])
                && (i_clint_sel[h] || i_plic_sel[h] || i_uart_sel[h]);
        }

        // Candidate hart for priority position p: (last+1+p) mod 4
        var cand_mmio: logic<2> [4];
        for p in 0..4 :gen_cand_mmio {
            assign cand_mmio[p] = last_granted_mmio_idx + (p as 2) + 2'd1;
        }

        var sel_found_mmio: logic    [4];
        var sel_idx_mmio  : logic<2> [4];
        for p in 0..4 :gen_sel_mmio {
            if p == 0 :gen_first {
                assign sel_found_mmio[p] = active_mmio[cand_mmio[p]];
                assign sel_idx_mmio[p]   = cand_mmio[p];
            } else :gen_rest {
                assign sel_found_mmio[p] = sel_found_mmio[p - 1] || active_mmio[cand_mmio[p]];
                assign sel_idx_mmio[p]   = if sel_found_mmio[p - 1] ? sel_idx_mmio[p - 1] : cand_mmio[p];
            }
        }
        let grant_valid_mmio: logic    = sel_found_mmio[3];
        let grant_idx_mmio  : logic<2> = sel_idx_mmio[3];

        always_ff (clk, rst) {
            if_reset {
                last_granted_mmio_idx = 2'd3;
            } else if grant_valid_mmio {
                last_granted_mmio_idx = grant_idx_mmio;
            }
        }

        assign o_mmio_paddr = i_mmio_paddr[grant_idx_mmio];
        assign o_mmio_wdata = i_mmio_wdata[grant_idx_mmio];
        assign o_mmio_wstrb = i_mmio_wstrb[grant_idx_mmio];

        let g_wen_mmio_n4: logic = grant_valid_mmio && i_mmio_wen[grant_idx_mmio];
        let g_ren_mmio_n4: logic = grant_valid_mmio && i_mmio_ren[grant_idx_mmio];
        let g_clint_n4   : logic = grant_valid_mmio && i_clint_sel[grant_idx_mmio];
        let g_plic_n4    : logic = grant_valid_mmio && i_plic_sel[grant_idx_mmio];
        let g_uart_n4    : logic = grant_valid_mmio && i_uart_sel[grant_idx_mmio];

        assign o_mmio_wen_clint = g_wen_mmio_n4 && g_clint_n4;
        assign o_mmio_ren_clint = g_ren_mmio_n4 && g_clint_n4;
        assign o_mmio_wen_plic  = g_wen_mmio_n4 && g_plic_n4;
        assign o_mmio_ren_plic  = g_ren_mmio_n4 && g_plic_n4;
        assign o_mmio_wen_uart  = g_wen_mmio_n4 && g_uart_n4;
        assign o_mmio_ren_uart  = g_ren_mmio_n4 && g_uart_n4;

        for h in 0..4 :gen_mmio_grant_n4 {
            assign o_mmio_grant[h] = grant_valid_mmio && (grant_idx_mmio == (h as 2)) && active_mmio[h];
        }

        // ---- DMEM arbitration (S23: two channels) ----
        // P9.3: the bus-wide AMO lock is GONE (RMW atomicity = L1 ownership
        // + the core's watch/replay backstop). Plain per-channel rotation.
        // Read-channel rotation over "wants the read channel" = a live fill /
        // miss read (write requests participate for fairness — S20R shape).
        var last_granted_r_idx: logic<2>    ;
        var cand_r            : logic<2> [4];
        for p in 0..4 :gen_cand_r {
            assign cand_r[p] = last_granted_r_idx + (p as 2) + 2'd1;
        }
        var sel_found_r: logic    [4];
        var sel_idx_r  : logic<2> [4];
        for p in 0..4 :gen_sel_r {
            if p == 0 :gen_first {
                assign sel_found_r[p] = i_dmemr_req[cand_r[p]] || i_dmemw_req[cand_r[p]];
                assign sel_idx_r[p]   = cand_r[p];
            } else :gen_rest {
                assign sel_found_r[p] = sel_found_r[p - 1] || i_dmemr_req[cand_r[p]] || i_dmemw_req[cand_r[p]];
                assign sel_idx_r[p]   = if sel_found_r[p - 1] ? sel_idx_r[p - 1] : cand_r[p];
            }
        }
        let rr_r_found    : logic    = sel_found_r[3];
        let rr_r_idx_n4   : logic<2> = sel_idx_r[3];
        let dmemr_grant_valid: logic    = rr_r_found;
        let dmemr_grant_idx  : logic<2> = rr_r_idx_n4;

        // Write-channel rotation over live write requests.
        var last_granted_w_idx: logic<2>    ;
        var cand_w            : logic<2> [4];
        for p in 0..4 :gen_cand_w {
            assign cand_w[p] = last_granted_w_idx + (p as 2) + 2'd1;
        }
        var sel_found_w: logic    [4];
        var sel_idx_w  : logic<2> [4];
        for p in 0..4 :gen_sel_w {
            if p == 0 :gen_first {
                assign sel_found_w[p] = i_dmemw_req[cand_w[p]];
                assign sel_idx_w[p]   = cand_w[p];
            } else :gen_rest {
                assign sel_found_w[p] = sel_found_w[p - 1] || i_dmemw_req[cand_w[p]];
                assign sel_idx_w[p]   = if sel_found_w[p - 1] ? sel_idx_w[p - 1] : cand_w[p];
            }
        }
        let rr_w_found: logic    = sel_found_w[3];
        let rr_w_idx_n4: logic<2> = sel_idx_w[3];
        let dmemw_grant_valid: logic    = rr_w_found;
        let dmemw_grant_idx  : logic<2> = rr_w_idx_n4;

        always_ff (clk, rst) {
            if_reset {
                last_granted_r_idx = 2'd3;
                last_granted_w_idx = 2'd3;
            } else {
                if rr_r_found {
                    last_granted_r_idx = rr_r_idx_n4;
                }
                if rr_w_found {
                    last_granted_w_idx = rr_w_idx_n4;
                }
            }
        }

        for h in 0..4 :gen_rgrant_n4 {
            assign o_dmemr_grant[h] = dmemr_grant_valid && (dmemr_grant_idx == (h as 2)) && i_dmemr_req[h];
        }
        for h in 0..4 :gen_wgrant_n4 {
            assign o_dmemw_grant[h] = dmemw_grant_valid && (dmemw_grant_idx == (h as 2)) && i_dmemw_req[h] && i_wgrant_ok;
        }

        assign o_dmemr_addr     = i_dmemr_addr[dmemr_grant_idx];
        assign o_dmemr_ren      = dmemr_grant_valid && i_dmemr_ren[dmemr_grant_idx] && i_dmemr_req[dmemr_grant_idx];
        assign o_dmemw_addr = i_dmemw_addr[dmemw_grant_idx];
        for l in 0..8 :gen_wlane_n4 {
            assign o_dmemw_wdata[l] = i_dmemw_wdata[{dmemw_grant_idx, l as 3}];
            assign o_dmemw_wstrb[l] = i_dmemw_wstrb[{dmemw_grant_idx, l as 3}];
        }
        assign o_dmemw_wen      = dmemw_grant_valid && i_dmemw_wen[dmemw_grant_idx] && i_dmemw_req[dmemw_grant_idx] && i_wgrant_ok;
        assign o_dmemw_wb       = i_dmemw_wb[dmemw_grant_idx];
        assign o_dmemw_sel      = {1'b0, dmemw_grant_idx};
        assign o_dmem_inv_valid = o_dmemw_wen;
        assign o_dmem_inv_addr  = o_dmemw_addr;
    } else :gen_arb {
        // Generic N=1 / N>=5 path. P9.4: ROUND-ROBIN fairness on all three
        // channels (was lowest-id-wins, which starves high-id harts — the
        // Phase 5/6 SMP-livelock class: hart 1's msip writes held off 603K
        // cycles, and at N=8 a litmus barrier never completes if any hart is
        // starved). Same rotation shape as gen_n4, generalized over N: each
        // channel keeps a `last granted` register and scans the N candidates
        // in rotated order (last+1, last+2, …) so the most-recently-served
        // hart has the lowest priority next cycle. N<=8 (hart index logic<3>;
        // the SoC instantiates N in {1,2,4,8}). The candidate index uses a
        // conditional wrap (raw-N) so it is correct for non-power-of-2 N too.
        // P9.3: the AMO lock is gone — plain rotation, no holder pinning.

        // ---- MMIO round-robin ----
        var active: logic [N_HARTS];
        for h in 0..N_HARTS :gen_active {
            // !i_stall_mem gate REMOVED (Phase 5 fix) — would self-deadlock
            // with the mmio_grant back-pressure below.
            assign active[h] = (i_mmio_wen[h] || i_mmio_ren[h]) && (i_clint_sel[h] || i_plic_sel[h] || i_uart_sel[h]);
        }
        var last_mmio_idx: logic<3>    ;
        var cand_mmio    : logic<3> [N_HARTS];
        for p in 0..N_HARTS :gen_cand_mmio {
            let raw: logic<4> = ({1'b0, last_mmio_idx} as 4) + (p as 4) + 4'd1;
            assign cand_mmio[p] = (if raw >= (N_HARTS as 4) ? raw - (N_HARTS as 4) : raw) as 3;
        }
        var mfound: logic    [N_HARTS];
        var midx  : logic<3> [N_HARTS];
        for p in 0..N_HARTS :gen_msel {
            if p == 0 :gen_first {
                assign mfound[p] = active[cand_mmio[p]];
                assign midx[p]   = cand_mmio[p];
            } else :gen_rest {
                assign mfound[p] = mfound[p - 1] || active[cand_mmio[p]];
                assign midx[p]   = if mfound[p - 1] ? midx[p - 1] : cand_mmio[p];
            }
        }
        let grant_valid: logic    = mfound[N_HARTS - 1];
        let grant_idx  : logic<3> = midx[N_HARTS - 1];
        always_ff (clk, rst) {
            if_reset {
                last_mmio_idx = (N_HARTS - 1) as 3;
            } else if grant_valid {
                last_mmio_idx = grant_idx;
            }
        }

        assign o_mmio_paddr = i_mmio_paddr[grant_idx];
        assign o_mmio_wdata = i_mmio_wdata[grant_idx];
        assign o_mmio_wstrb = i_mmio_wstrb[grant_idx];

        let g_wen  : logic = grant_valid && i_mmio_wen[grant_idx];
        let g_ren  : logic = grant_valid && i_mmio_ren[grant_idx];
        let g_clint: logic = grant_valid && i_clint_sel[grant_idx];
        let g_plic : logic = grant_valid && i_plic_sel[grant_idx];
        let g_uart : logic = grant_valid && i_uart_sel[grant_idx];

        assign o_mmio_wen_clint = g_wen && g_clint;
        assign o_mmio_ren_clint = g_ren && g_clint;
        assign o_mmio_wen_plic  = g_wen && g_plic;
        assign o_mmio_ren_plic  = g_ren && g_plic;
        assign o_mmio_wen_uart  = g_wen && g_uart;
        assign o_mmio_ren_uart  = g_ren && g_uart;
        for h in 0..N_HARTS :gen_mmio_grant {
            assign o_mmio_grant[h] = grant_valid && (grant_idx == (h as 3)) && active[h];
        }

        // ---- DRAM read channel round-robin ----
        // S20R: a write request also counts as "wants the read channel" so a
        // write-only hart takes (and yields) a rotation slot (fairness across
        // the two channels — see gen_n2).
        var rwant : logic [N_HARTS];
        for h in 0..N_HARTS :gen_rwant {
            assign rwant[h] = i_dmemr_req[h] || i_dmemw_req[h];
        }
        var last_r_idx: logic<3>    ;
        var cand_r    : logic<3> [N_HARTS];
        for p in 0..N_HARTS :gen_cand_r {
            let raw: logic<4> = ({1'b0, last_r_idx} as 4) + (p as 4) + 4'd1;
            assign cand_r[p] = (if raw >= (N_HARTS as 4) ? raw - (N_HARTS as 4) : raw) as 3;
        }
        var rfound: logic    [N_HARTS];
        var ridx  : logic<3> [N_HARTS];
        for p in 0..N_HARTS :gen_rsel {
            if p == 0 :gen_first {
                assign rfound[p] = rwant[cand_r[p]];
                assign ridx[p]   = cand_r[p];
            } else :gen_rest {
                assign rfound[p] = rfound[p - 1] || rwant[cand_r[p]];
                assign ridx[p]   = if rfound[p - 1] ? ridx[p - 1] : cand_r[p];
            }
        }
        let dmemr_grant_valid: logic    = rfound[N_HARTS - 1];
        let dmemr_grant_idx  : logic<3> = ridx[N_HARTS - 1];
        always_ff (clk, rst) {
            if_reset {
                last_r_idx = (N_HARTS - 1) as 3;
            } else if dmemr_grant_valid {
                last_r_idx = dmemr_grant_idx;
            }
        }

        // ---- DRAM write channel round-robin ----
        var last_w_idx: logic<3>    ;
        var cand_w    : logic<3> [N_HARTS];
        for p in 0..N_HARTS :gen_cand_w {
            let raw: logic<4> = ({1'b0, last_w_idx} as 4) + (p as 4) + 4'd1;
            assign cand_w[p] = (if raw >= (N_HARTS as 4) ? raw - (N_HARTS as 4) : raw) as 3;
        }
        var wfound: logic    [N_HARTS];
        var widx  : logic<3> [N_HARTS];
        for p in 0..N_HARTS :gen_wsel {
            if p == 0 :gen_first {
                assign wfound[p] = i_dmemw_req[cand_w[p]];
                assign widx[p]   = cand_w[p];
            } else :gen_rest {
                assign wfound[p] = wfound[p - 1] || i_dmemw_req[cand_w[p]];
                assign widx[p]   = if wfound[p - 1] ? widx[p - 1] : cand_w[p];
            }
        }
        let dmemw_grant_valid: logic    = wfound[N_HARTS - 1];
        let dmemw_grant_idx  : logic<3> = widx[N_HARTS - 1];
        always_ff (clk, rst) {
            if_reset {
                last_w_idx = (N_HARTS - 1) as 3;
            } else if dmemw_grant_valid {
                last_w_idx = dmemw_grant_idx;
            }
        }

        for h in 0..N_HARTS :gen_rgrant {
            assign o_dmemr_grant[h] = dmemr_grant_valid && (h == dmemr_grant_idx) && i_dmemr_req[h];
        }
        for h in 0..N_HARTS :gen_wgrant {
            assign o_dmemw_grant[h] = dmemw_grant_valid && (h == dmemw_grant_idx) && i_dmemw_req[h] && i_wgrant_ok;
        }
        assign o_dmemr_addr     = i_dmemr_addr[dmemr_grant_idx];
        assign o_dmemr_ren      = dmemr_grant_valid && i_dmemr_ren[dmemr_grant_idx] && i_dmemr_req[dmemr_grant_idx];
        assign o_dmemw_addr = i_dmemw_addr[dmemw_grant_idx];
        for l in 0..8 :gen_wlane {
            assign o_dmemw_wdata[l] = i_dmemw_wdata[{dmemw_grant_idx, l as 3}];
            assign o_dmemw_wstrb[l] = i_dmemw_wstrb[{dmemw_grant_idx, l as 3}];
        }
        assign o_dmemw_wen      = dmemw_grant_valid && i_dmemw_wen[dmemw_grant_idx] && i_dmemw_req[dmemw_grant_idx] && i_wgrant_ok;
        assign o_dmemw_wb       = i_dmemw_wb[dmemw_grant_idx];
        assign o_dmemw_sel      = dmemw_grant_idx;
        assign o_dmem_inv_valid = o_dmemw_wen;
        assign o_dmem_inv_addr  = o_dmemw_addr;
    }
}
