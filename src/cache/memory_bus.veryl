// Multi-hart MMIO arbiter (debug-minimal form).
//
// First-pass implementation: forward only hart 0's MMIO bundle to the shared
// peripherals. Other harts' MMIO requests are dropped, which is fine while
// secondary harts are stuck in the firmware's `_secondary_park` wfi loop
// (they don't issue MMIO). Once SBI HSM lands and secondaries actually run
// kernel code, this needs to grow back into a real arbiter.
pub module memory_bus #(
    param N_HARTS: u32 = 1,
) (
    clk: input clock,
    rst: input reset,
    i_mmio_paddr: input  logic<32> [N_HARTS],
    i_mmio_wdata: input  logic<64> [N_HARTS],
    i_mmio_wstrb: input  logic<8>  [N_HARTS],
    i_mmio_wen  : input  logic     [N_HARTS],
    i_mmio_ren  : input  logic     [N_HARTS],
    i_clint_sel : input  logic     [N_HARTS],
    i_plic_sel  : input  logic     [N_HARTS],
    i_uart_sel  : input  logic     [N_HARTS],
    i_stall_mem : input  logic     [N_HARTS],
    o_mmio_paddr    : output logic<32>,
    o_mmio_wdata    : output logic<64>,
    o_mmio_wstrb    : output logic<8> ,
    o_mmio_wen_clint: output logic    ,
    o_mmio_ren_clint: output logic    ,
    o_mmio_wen_plic : output logic    ,
    o_mmio_ren_plic : output logic    ,
    o_mmio_wen_uart : output logic    ,
    o_mmio_ren_uart : output logic    ,
) {
    // Hart 0 owns the MMIO path for now. Plain scalar muxes only.
    assign o_mmio_paddr     = i_mmio_paddr[0];
    assign o_mmio_wdata     = i_mmio_wdata[0];
    assign o_mmio_wstrb     = i_mmio_wstrb[0];
    assign o_mmio_wen_clint = i_mmio_wen[0] && i_clint_sel[0] && !i_stall_mem[0];
    assign o_mmio_ren_clint = i_mmio_ren[0] && i_clint_sel[0];
    assign o_mmio_wen_plic  = i_mmio_wen[0] && i_plic_sel [0] && !i_stall_mem[0];
    assign o_mmio_ren_plic  = i_mmio_ren[0] && i_plic_sel [0];
    assign o_mmio_wen_uart  = i_mmio_wen[0] && i_uart_sel [0] && !i_stall_mem[0];
    assign o_mmio_ren_uart  = i_mmio_ren[0] && i_uart_sel [0] && !i_stall_mem[0];
}
