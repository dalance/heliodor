// Shared L2 cache (Phase 6.E.3 — 4-way set-associative, write-through;
// P9.1 — line-granular, split-transaction read side via mem_ctrl).
//
// 128KB total, 4-way set-associative:
//   line  = 64B (8 dwords) — same as L1 dcache
//   ways  = 4
//   sets  = 512 per way (32KB per way)
//   addr[63:15] = tag (49 bits)
//   addr[14:6]  = index (9 bits, 512 sets)
//   addr[5:3]   = word offset (3 bits, 8 dwords)
//   addr[2:0]   = byte offset (ignored — request granularity is 8B)
//
// P9.1: the old combinational read passthrough (per-word lazy fills riding
// the L1's 8 sequential miss reads) is gone. The read side now serves the
// mem_ctrl transaction controller through two ports:
//   - LOOKUP/COPY (i_caddr/i_cren): combinational full-LINE hit verdict
//     (o_chit) + the hit way's 8 dwords (o_cdata). The per-word valid bits
//     are gone — installs are always full lines, so line-valid suffices.
//   - INSTALL (i_inst_*): a gathered DRAM line is written whole at one edge.
//     If the line is already present (a second hart gathered the same line),
//     the matching way is overwritten in place — never double-allocated.
//
// Policy: write-through, no-write-allocate (unchanged).
//   - write hit  : update hit way's data (byte-merge), forward to DRAM.
//   - write miss : pure pass-through.
// The lower interface is now WRITE-ONLY (o_mem_*); DRAM reads are owned by
// mem_ctrl.
//
// Replacement: tree-pseudo-LRU (3 bits per set, same encoding as L1
// dcache) — bit[2] selects LRU sub-group; bit[1] LRU in {way0,way1};
// bit[0] LRU in {way2,way3}. Touched on lookup hits, installs, write hits.
//
// Same-cycle install + write-merge interaction: a write conflicting with the
// install LINE never reaches this module (mem_ctrl suppresses the install).
// A write-hit MERGE into a different line that the install happens to EVICT
// (same set, victim way) is ordered merge-first/install-last below, so the
// install wins the array cells — the merge's bytes belonged to the dying
// line and are already in DRAM (write-through), so nothing is lost.
//
// P9.2: INCLUSIVE DIRECTORY. Each L2 line carries a sharers bitmask (which
// harts' L1 D$ may hold the line). mem_ctrl maintains it through this
// module's ports:
//   - i_cadd_v: add i_cadd_hart as a sharer of the c-port line (a lookup-hit
//     grant). mem_ctrl retries a lookup that collides with a same-cycle
//     write to the line, so a cadd never races a same-line write update.
//   - i_inst_hart: the installed line's sharer set becomes {hart} (plus the
//     old sharers when the line was already present — a second hart gathered
//     the same line and the in-place overwrite must not drop the first).
//   - install victim preview (o_iv_*, comb on i_inst_addr): the line the
//     install would evict + its sharers, so mem_ctrl back-invalidates them
//     (inclusion). Victim selection EXCLUDES lines with an active mem_ctrl
//     slot (i_busy_*) — evicting a line mid-transaction would let the
//     requesting L1 complete a fill the directory no longer covers.
//     o_iv_blocked = no eligible way this cycle (mem_ctrl holds the install).
//   - write side: o_w_sharers / o_w_sharers_hi expose the sharer masks of
//     the write line (and its +8 line for a misaligned store) so mem_ctrl
//     emits PRECISE invalidates; the directory keeps only the writer's bit
//     on a write hit (the other copies are invalidated), and clears the
//     mask(s) on the misaligned invalidate path.
// The directory may OVER-approximate (an L1 that silently dropped a clean
// line stays listed): that costs spurious invalidates, never correctness.
pub module l2cache #(
    param N_HARTS: u32 = 1,
) (
    clk: input clock,
    rst: input reset,
    // P9.1 lookup/copy port (mem_ctrl): combinational full-line lookup at
    // i_caddr. i_cren marks a real read access (PLRU touch on hit).
    i_caddr: input  logic<64>    ,
    i_cren : input  logic        ,
    o_chit : output logic        ,
    o_cdata: output logic<64> [8],
    // P9.2 directory: lookup-grant sharer add (same line as i_caddr).
    // i_cadd_own: the grant is an OWNERSHIP grant (RFO / sole-sharer E) —
    // the entry becomes owned with mask {hart} (mem_ctrl invalidates the
    // other sharers the same cycle for the RFO case).
    i_cadd_v   : input  logic          ,
    i_cadd_hart: input  logic<3>       ,
    i_cadd_own : input  logic          ,
    o_c_sharers: output logic<N_HARTS> ,
    o_c_owned  : output logic          , // c-port line is OWNED (E/M in an L1)
    // P9.1 full-line install port (mem_ctrl: gathered DRAM line).
    i_inst_v   : input logic        ,
    i_inst_addr: input logic<64>    ,
    i_inst_data: input logic<64> [8],
    // P9.2 directory: installing hart + victim preview (comb on i_inst_addr)
    // + active-transaction lines excluded from victim selection.
    i_inst_hart : input  logic<3>           ,
    o_iv_valid  : output logic              , // install would evict a valid line
    o_iv_addr   : output logic<64>          ,
    o_iv_sharers: output logic<N_HARTS>     ,
    o_iv_owned  : output logic              , // Phase B: victim OWNED → recall first
    o_iv_blocked: output logic              , // no eligible way this cycle
    // P3.a L2 1R1W: a same-bank merge write is using the install's data port
    // this cycle → mem_ctrl HOLDS the install (retry). 0 unless L2_PORTS_1R1W.
    o_inst_port_busy: output logic          ,
    // Phase B: sharers already on the install line (in-place overwrite case;
    // 0 when the line is absent). mem_ctrl downgrades the grant to S when
    // another hart is listed.
    o_inst_oldshr: output logic<N_HARTS>    ,
    i_busy_line : input  logic<58> [N_HARTS],
    i_busy_v    : input  logic     [N_HARTS],
    // P9.2 directory: writer hart + sharer masks / ownership of the write
    // target line(s). i_w_wb marks an L1 WRITEBACK (eviction/recall/flush):
    // full-line merge, and the writer LEAVES the sharer set (owner cleared)
    // instead of becoming its sole member.
    i_w_hart      : input  logic<3>          ,
    i_w_wb        : input  logic             ,
    // P9.3 c2c: requester add coinciding with a WB write (mem_ctrl captured
    // the WB for a waiting slot): applied to the WB line's directory entry
    // AFTER the owner-clear, same edge. Only meaningful with i_w_wb.
    i_w_cadd_v   : input logic   ,
    i_w_cadd_hart: input logic<3>,
    i_w_cadd_own : input logic   ,
    o_w_sharers   : output logic<N_HARTS>    ,
    o_w_sharers_hi: output logic<N_HARTS>    ,
    o_w_owned     : output logic             ,
    o_w_owned_hi  : output logic             ,
    // Phase B: recall-engine CLEAN-ACK ownership clear — the probed owner
    // had no dirty copy (silent E drop / clean invalidate), so no WB will
    // arrive; drop it from the directory here.
    i_eclr_v   : input logic    ,
    i_eclr_addr: input logic<64>,
    i_eclr_hart: input logic<3> ,
    // Upper WRITE interface (S23: from memory_bus's write channel — the
    // granted hart's write-through store). Always forwards to DRAM.
    // S25 write-combining: a write is a full 64B LINE — 8 dword lanes with
    // per-lane byte strobes. A single-dword write (slow store / MMIO) has
    // one populated lane; i_waddr keeps its byte offset for those (the
    // misaligned hi-dword invalidate below decodes i_waddr+8).
    i_waddr: input logic<64>    ,
    i_wdata: input logic<64> [8],
    i_wstrb: input logic<8>  [8],
    // M8.D.2: hi-side strobe for a misaligned 2-dword STORE (v4 SoC). When
    // nonzero the store's hi dword is written to DRAM via a SoC bypass that
    // skips L2, so L2's cached copy of the touched line(s) would go stale.
    // Non-v4 instantiations tie this to 0 (the invalidate path never fires).
    i_wstrb_hi: input logic<8>,
    i_wen     : input logic   ,
    // P3.b (L2_READ_1R1W): a DRAM write is REQUESTED this cycle (pre-grant; the
    // bus drives i_waddr with the selected write's addr independent of the grant).
    // Lets l2cache speculatively read the write-hit's old line BEFORE granting so
    // the merge write is atomic on a single read port. Tie 0 when L2_READ_1R1W=0.
    i_w_req      : input  logic ,
    // P3.b: raw pieces of the write-grant HOLD, combined at the SoC (like w_veto,
    // to avoid a bundled output that trips the comb-loop analyzer). o_w_hit = the
    // write hits L2 (needs a merge-read), gated by L2_READ_1R1W (0 at =0).
    // o_w_spec_ready = the pending hit's old line is already spec-read (registered).
    o_w_hit       : output logic ,
    o_w_spec_ready: output logic ,
    // Lower interface — P9.1: write passthrough ONLY (DRAM reads moved to
    // mem_ctrl, which owns the external read port and its arbitration).
    o_mem_addr : output logic<64>    ,
    o_mem_wdata: output logic<64> [8],
    o_mem_wstrb: output logic<8>  [8],
    o_mem_wen  : output logic        ,
) {
    // -----------------------------------------------------------------
    // Address decomposition
    // -----------------------------------------------------------------
    // Lookup-side decode (i_caddr).
    let c_tag  : logic<49> = i_caddr[63:15];
    let c_index: logic<9>  = i_caddr[14:6];
    // Install-side decode (i_inst_addr).
    let in_tag  : logic<49> = i_inst_addr[63:15];
    let in_index: logic<9>  = i_inst_addr[14:6];
    // Write-side decode (i_waddr) — drives the write-hit merge. S25: lanes
    // carry the dword offsets; only the line part of i_waddr is decoded.
    let w_tag  : logic<49> = i_waddr[63:15];
    let w_index: logic<9>  = i_waddr[14:6];

    // -----------------------------------------------------------------
    // Storage — 4 separate banks (one per way). P9.1: per-word valid bits
    // are gone (installs are always full lines).
    // -----------------------------------------------------------------
    var tag_0 : logic<49> [512] ;
    var tag_1 : logic<49> [512] ;
    var tag_2 : logic<49> [512] ;
    var tag_3 : logic<49> [512] ;
    var lv_0  : logic     [512] ;
    var lv_1  : logic     [512] ;
    var lv_2  : logic     [512] ;
    var lv_3  : logic     [512] ;
    // Line-width data banks: one 512-bit word per set (8 × 64-bit dwords), so
    // each way reads/writes a whole line through a single port — the shape a
    // line-wide SRAM macro infers as RAM.  Per-lane access becomes a constant
    // bit-slice; partial writes become a whole-line write of the merged line.
    var data_0: logic<512> [512];
    var data_1: logic<512> [512];
    var data_2: logic<512> [512];
    var data_3: logic<512> [512];
    var plru  : logic<3>  [512] ; // tree-PLRU per set
    // P9.2 directory: per-line sharer bitmask (meaningful only while lv_*) +
    // OWNED bit (Phase B: the mask is one-hot = the owner; its L1 state is E
    // or M — a recall finds out which).
    var shr_0: logic<N_HARTS> [512];
    var shr_1: logic<N_HARTS> [512];
    var shr_2: logic<N_HARTS> [512];
    var shr_3: logic<N_HARTS> [512];
    var own_0: logic [512];
    var own_1: logic [512];
    var own_2: logic [512];
    var own_3: logic [512];

    // One-hot of a hart index (i_*_hart ports are logic<3> regardless of N).
    var cadd_oh : logic<N_HARTS>;
    var inst_oh : logic<N_HARTS>;
    var w_oh    : logic<N_HARTS>;
    var eclr_oh : logic<N_HARTS>;
    var wcadd_oh: logic<N_HARTS>;
    for h in 0..N_HARTS :gen_hart_oh {
        assign cadd_oh[h]  = i_cadd_hart == (h as 3);
        assign inst_oh[h]  = i_inst_hart == (h as 3);
        assign w_oh[h]     = i_w_hart == (h as 3);
        assign eclr_oh[h]  = i_eclr_hart == (h as 3);
        assign wcadd_oh[h] = i_w_cadd_hart == (h as 3);
    }
    // P9.3 c2c: the WB directory update folds the requester add in.
    let wcadd_mask: logic<N_HARTS> = if i_w_cadd_v ? wcadd_oh : '0;
    let wcadd_own : logic          = i_w_cadd_v && i_w_cadd_own;
    // Engine clean-ack decode.
    let e_tag  : logic<49> = i_eclr_addr[63:15];
    let e_index: logic<9>  = i_eclr_addr[14:6];
    let etm_0  : logic     = lv_0[e_index] && (tag_0[e_index] == e_tag);
    let etm_1  : logic     = lv_1[e_index] && (tag_1[e_index] == e_tag);
    let etm_2  : logic     = lv_2[e_index] && (tag_2[e_index] == e_tag);
    let etm_3  : logic     = lv_3[e_index] && (tag_3[e_index] == e_tag);

    // -----------------------------------------------------------------
    // Lookup port: per-way line hit + full-line copy.
    // -----------------------------------------------------------------
    let ctm_0  : logic = lv_0[c_index] && (tag_0[c_index] == c_tag);
    let ctm_1  : logic = lv_1[c_index] && (tag_1[c_index] == c_tag);
    let ctm_2  : logic = lv_2[c_index] && (tag_2[c_index] == c_tag);
    let ctm_3  : logic = lv_3[c_index] && (tag_3[c_index] == c_tag);
    let any_ctm: logic = ctm_0 || ctm_1 || ctm_2 || ctm_3;

    let c_way: logic<2> = if ctm_0 ? 2'd0 : if ctm_1 ? 2'd1 : if ctm_2 ? 2'd2 : 2'd3;

    // ── L2 sync-read: ONLY the DATA array is synchronous (goal-(b) SRAM realism, cp_l2_sync_read_plan.md) ──
    // The 1 Mbit data array (data_0..3, logic<512>[512]×4) is the fake-flop SRAM target. Read it
    // SYNCHRONOUSLY (register o_cdata) so it maps to a real line-wide sync SRAM macro. The DIRECTORY
    // (chit via tags / sharers / owned — small flop arrays a real chip keeps as flops, sram_inventory.md)
    // stays COMBINATIONAL, so every coherence decision (hit / owned / recall / RFO-invalidate /
    // sharer-add) is timing-UNCHANGED. mem_ctrl captures o_cdata one cycle after the lookup (its first
    // HWAIT cycle), so the L2-access latency model (HIT_WAIT ≥ 1) HIDES the sync-read latency →
    // CYCLE-IDENTICAL to =0 (data value + timing). At =0 the register DCEs (reset-only) and o_cdata ==
    // c_line_raw → byte-identical. Flip TOGETHER with mem_ctrl.veryl's L2_SYNC_READ (the capture-timing).
    const L2_SYNC_READ: bit = 1;
    // ── L2 1R1W port collapse (goal-(b) SRAM realism, cp_l2_sync_read_plan.md §8) ──
    // The data array (data_0..3) currently infers 512×512 2R2W: two reads (R1 lookup @c_index
    // [sync], R2 merge-read-old @w_index) + two writes (W1 merge @w_index, W2 install @in_index).
    // P3.a collapses the two WRITES to a single per-bank write port (2R2W → 2R1W) by MUXING the
    // merge/install write into one write statement per bank. Correctness rests on merge and install
    // NEVER co-firing: the SoC's wgrant_ok gate VETOES a bus write (store/WB) the cycle an install
    // fires (const-gated there, flip TOGETHER), so the mux is unambiguous and no write is lost — the
    // vetoed write retries next cycle via the existing dmemw-grant retry. At =0 the muxed block DCEs
    // (reset-nothing / const-false) and the original two writes remain → byte-identical.
    // P3.b (later) folds R2 onto the read port for the true 1R1W. Flip together with soc/soc_smp.
    const L2_PORTS_1R1W: bit = 1;
    // ── L2 P3.b: fold R2 (merge-read-old) onto the sync read port → true 1R1W ──
    // Today (P3.a) the data array is 2R1W: R1 lookup @c_index (sync c_line_q) + R2 merge-read-old
    // @w_index (combinational, in write_merged). P3.b removes R2 as a separate read port by serving
    // the write-hit merge's old line from the SAME sync read port (c_line_q). To keep the L2-write
    // ATOMIC (directory + data same cycle — no stale-read window), the old line is read SPECULATIVELY
    // one cycle BEFORE the store is accepted: on a cycle the read port is free (!i_cren = mem_ctrl not
    // looking up) l2cache presents the selected store's w_index to the read port; the next cycle the
    // old line is in c_line_q and the store is GRANTED (SoC wgrant_ok waits on o_w_spec_hold) →
    // directory update + merged data write, atomically. Reading only when !i_cren keeps mem_ctrl's
    // c_line_q timeline undisturbed (no mem_ctrl change). wgrant_ok gates on the REGISTERED spec-ready
    // (+ w_any_tm/i_w_wb, comb on the pre-grant i_waddr) → no comb loop. At =0 the whole path DCEs
    // (rd_sel_store=0 → rd_index==c_index, write_merged uses the combinational read) → byte-identical
    // 2R1W. At =1 the array infers 1R1W. Flip TOGETHER with soc/soc_smp (i_w_req + wgrant_ok).
    const L2_READ_1R1W: bit = 0;
    assign o_chit = any_ctm;
    // P9.2: sharers of the c-port line (0 on miss). Combinational (directory flop array).
    assign o_c_sharers = if ctm_0 ?
        shr_0[c_index]
    : if ctm_1 ?
        shr_1[c_index]
    : if ctm_2 ?
        shr_2[c_index]
    : if ctm_3 ?
        shr_3[c_index]
    :
        '0
    ;
    assign o_c_owned = if ctm_0 ?
        own_0[c_index]
    : if ctm_1 ?
        own_1[c_index]
    : if ctm_2 ?
        own_2[c_index]
    : if ctm_3 ?
        own_3[c_index]
    :
        1'b0
    ;
    // Write-side line match (i_waddr) — the write-hit merge target. Hoisted
    // above the DATA read so P3.b's read-port mux can select the write-hit way.
    let w_tm_0  : logic    = lv_0[w_index] && (tag_0[w_index] == w_tag);
    let w_tm_1  : logic    = lv_1[w_index] && (tag_1[w_index] == w_tag);
    let w_tm_2  : logic    = lv_2[w_index] && (tag_2[w_index] == w_tag);
    let w_tm_3  : logic    = lv_3[w_index] && (tag_3[w_index] == w_tag);
    let w_any_tm: logic    = w_tm_0 || w_tm_1 || w_tm_2 || w_tm_3;
    let w_tm_way: logic<2> = if w_tm_0 ? 2'd0 : if w_tm_1 ? 2'd1 : if w_tm_2 ? 2'd2 : 2'd3;

    // ── P3.b read-port fold: the DATA array's SINGLE read port. rd_index/rd_way
    // muxes {lookup @c_index/c_way, store spec-read @w_index/w_tm_way}. At =0
    // (L2_READ_1R1W=0) rd_sel_store is const-false → rd_index==c_index,
    // rd_way==c_way → byte-identical lookup read (the merge keeps its own
    // combinational read below). At =1 a REQUESTED partial write-hit whose old
    // line is not yet in c_line_q steals the read port on a free cycle
    // (!i_cren = mem_ctrl not looking up), so next cycle the old line is in
    // c_line_q and the store is granted (SoC waits on o_w_spec_hold).
    // The spec FSM registers (rmw_spec_ready_q / rmw_spec_waddr_q) are below.
    var rmw_spec_ready_q: logic     ;
    var rmw_spec_waddr_q: logic<64> ;
    // A requested partial write-hit that needs a byte-merge (WB = full line and
    // misaligned = invalidate-only need no old-line read). i_w_req/i_w_wb/
    // i_wstrb_hi are the SELECTED write's attributes (valid pre-grant).
    let req_merge: logic = i_w_req && w_any_tm && !i_w_wb;
    // The spec-read for the pending store is already in c_line_q (addr-matched).
    let spec_ready : logic = rmw_spec_ready_q && (rmw_spec_waddr_q == i_waddr);
    let do_spec_read: logic = L2_READ_1R1W && req_merge && !spec_ready && !i_cren;
    let rd_sel_store: logic  = do_spec_read;
    let rd_index    : logic<9> = if rd_sel_store ? w_index : c_index;
    let rd_way      : logic<2> = if rd_sel_store ? w_tm_way : c_way;
    // The DATA line. At =1 (L2_READ_1R1W) one read index net per bank — the
    // muxed {lookup, store spec-read} port (a line-wide 1R macro). At =0 the
    // original ctm-chain lookup read @c_index (gate-neutral, byte-identical; the
    // rd_index/rd_way path DCEs). The merge keeps its own combinational read at =0.
    let c_line_raw: logic<512> = if L2_READ_1R1W ? (
        if rd_way == 2'd0 ?
            data_0[rd_index]
        : if rd_way == 2'd1 ?
            data_1[rd_index]
        : if rd_way == 2'd2 ?
            data_2[rd_index]
        :
            data_3[rd_index]
    ) : (
        if ctm_0 ?
            data_0[c_index]
        : if ctm_1 ?
            data_1[c_index]
        : if ctm_2 ?
            data_2[c_index]
        :
            data_3[c_index]
    );
    var c_line_q: logic<512>;
    always_ff (clk, rst) {
        if_reset {
            c_line_q = 512'd0;
        } else if L2_SYNC_READ {
            c_line_q = c_line_raw;
        }
    }
    for l in 0..8 :gen_cdata {
        assign o_cdata[l] = if L2_SYNC_READ ? c_line_q[l*64 +: 64] : c_line_raw[l*64 +: 64];
    }
    // P3.b: raw hold pieces — the SoC forms the grant hold as
    // wv_req_on && o_w_hit && !o_w_spec_ready. o_w_hit encodes "a partial write-hit
    // that needs a merge-read" (a WB is a full line, a misaligned store is
    // invalidate-only → neither needs the old line). Combinational on the selected
    // write's attributes (like l2_w_owned) → loop-safe. Gated (0 at =0).
    // NB: i_wstrb_hi (the misaligned hi-strobe) is grant-gated at the SoC, so it
    // must NOT appear here (it would close a comb loop through wgrant_ok). A
    // misaligned store that hits simply takes one harmless spec-read cycle before
    // its invalidate (its data write never fires — mrg_data_wr excludes mis_store).
    assign o_w_hit        = L2_READ_1R1W && w_any_tm && !i_w_wb;
    assign o_w_spec_ready = spec_ready;

    // -----------------------------------------------------------------
    // M8.D.2: misaligned-store hi-side invalidate (mirror of dcache B.3).
    // A v4 misaligned store writes its lo dword through L2 (i_wstrb) and its
    // hi dword straight to DRAM via the SoC bypass (i_wstrb_hi). The hi dword
    // lands in the line at i_addr+8, whose cached copy in L2 would go stale —
    // so on such a store we invalidate any cached way for BOTH the lo line
    // (i_addr) and the i_addr+8 line, and skip the byte-merge below. A later
    // read refills the merged bytes from DRAM (which holds both halves).
    // -----------------------------------------------------------------
    let mis_store: logic     = i_wen && (i_wstrb_hi != 8'd0);
    let nxt_addr : logic<64> = i_waddr + 64'd8;
    let nxt_tag  : logic<49> = nxt_addr[63:15];
    let nxt_index: logic<9>  = nxt_addr[14:6];
    let ntm_0    : logic     = lv_0[nxt_index] && (tag_0[nxt_index] == nxt_tag);
    let ntm_1    : logic     = lv_1[nxt_index] && (tag_1[nxt_index] == nxt_tag);
    let ntm_2    : logic     = lv_2[nxt_index] && (tag_2[nxt_index] == nxt_tag);
    let ntm_3    : logic     = lv_3[nxt_index] && (tag_3[nxt_index] == nxt_tag);

    // P9.2: sharer masks of the write line (and the +8 line) for mem_ctrl's
    // precise invalidate emission. 0 on a miss (no L1 holds it — inclusion).
    assign o_w_sharers = if w_tm_0 ?
        shr_0[w_index]
    : if w_tm_1 ?
        shr_1[w_index]
    : if w_tm_2 ?
        shr_2[w_index]
    : if w_tm_3 ?
        shr_3[w_index]
    :
        '0
    ;
    assign o_w_sharers_hi = if ntm_0 ?
        shr_0[nxt_index]
    : if ntm_1 ?
        shr_1[nxt_index]
    : if ntm_2 ?
        shr_2[nxt_index]
    : if ntm_3 ?
        shr_3[nxt_index]
    :
        '0
    ;
    // Phase B: ownership of the write target line(s) — feeds the SoC's
    // write-grant VETO (a non-WB write to a line owned by ANOTHER hart must
    // recall it first, or the owner's later writeback would bury this write).
    assign o_w_owned = if w_tm_0 ?
        own_0[w_index]
    : if w_tm_1 ?
        own_1[w_index]
    : if w_tm_2 ?
        own_2[w_index]
    : if w_tm_3 ?
        own_3[w_index]
    :
        1'b0
    ;
    assign o_w_owned_hi = if ntm_0 ?
        own_0[nxt_index]
    : if ntm_1 ?
        own_1[nxt_index]
    : if ntm_2 ?
        own_2[nxt_index]
    : if ntm_3 ?
        own_3[nxt_index]
    :
        1'b0
    ;

    // -----------------------------------------------------------------
    // Install victim selection — same-line way (overwrite in place) first,
    // then invalid way, then a non-BUSY valid way (PLRU's pick when it is
    // not busy, else the first non-busy way). P9.2: a way is BUSY when its
    // line has an active mem_ctrl transaction (i_busy_*) — evicting it
    // would break inclusion for the L1 fill in flight. All four ways busy
    // ⇒ o_iv_blocked, mem_ctrl holds the install and retries.
    // -----------------------------------------------------------------
    let itm_0: logic = lv_0[in_index] && (tag_0[in_index] == in_tag);
    let itm_1: logic = lv_1[in_index] && (tag_1[in_index] == in_tag);
    let itm_2: logic = lv_2[in_index] && (tag_2[in_index] == in_tag);
    let itm_3: logic = lv_3[in_index] && (tag_3[in_index] == in_tag);
    let i_any_tm: logic    = itm_0 || itm_1 || itm_2 || itm_3;
    let itm_way : logic<2> = if itm_0 ? 2'd0 : if itm_1 ? 2'd1 : if itm_2 ? 2'd2 : 2'd3;

    // Per-way busy: a valid line matching any active transaction line.
    var way_busy: logic [4];
    var bm_0    : logic [N_HARTS];
    var bm_1    : logic [N_HARTS];
    var bm_2    : logic [N_HARTS];
    var bm_3    : logic [N_HARTS];
    for h in 0..N_HARTS :gen_busy_m {
        assign bm_0[h] = i_busy_v[h] && (i_busy_line[h] == {tag_0[in_index], in_index});
        assign bm_1[h] = i_busy_v[h] && (i_busy_line[h] == {tag_1[in_index], in_index});
        assign bm_2[h] = i_busy_v[h] && (i_busy_line[h] == {tag_2[in_index], in_index});
        assign bm_3[h] = i_busy_v[h] && (i_busy_line[h] == {tag_3[in_index], in_index});
    }
    var bany_0: logic;
    var bany_1: logic;
    var bany_2: logic;
    var bany_3: logic;
    always_comb {
        bany_0 = 1'b0;
        bany_1 = 1'b0;
        bany_2 = 1'b0;
        bany_3 = 1'b0;
        for h in 0..N_HARTS {
            if bm_0[h] {
                bany_0 = 1'b1;
            }
            if bm_1[h] {
                bany_1 = 1'b1;
            }
            if bm_2[h] {
                bany_2 = 1'b1;
            }
            if bm_3[h] {
                bany_3 = 1'b1;
            }
        }
    }
    assign way_busy[0] = lv_0[in_index] && bany_0;
    assign way_busy[1] = lv_1[in_index] && bany_1;
    assign way_busy[2] = lv_2[in_index] && bany_2;
    assign way_busy[3] = lv_3[in_index] && bany_3;

    let i_plru_bits: logic<3> = plru[in_index];
    let i_has_inv  : logic    = !lv_0[in_index] || !lv_1[in_index] || !lv_2[in_index] || !lv_3[in_index];
    let i_inv_way  : logic<2> = if !lv_0[in_index] ? 2'd0 : if !lv_1[in_index] ? 2'd1 : if !lv_2[in_index] ? 2'd2 : 2'd3;
    let i_plru_way : logic<2> = {i_plru_bits[2], if !i_plru_bits[2] ? i_plru_bits[1] : i_plru_bits[0]};
    let plru_ok: logic = !(if i_plru_way == 2'd0 ?
        way_busy[0]
    : if i_plru_way == 2'd1 ?
        way_busy[1]
    : if i_plru_way == 2'd2 ?
        way_busy[2]
    :
        way_busy[3]
    );
    let any_nonbusy: logic    = !way_busy[0] || !way_busy[1] || !way_busy[2] || !way_busy[3];
    let nonbusy_way: logic<2> = if !way_busy[0] ? 2'd0 : if !way_busy[1] ? 2'd1 : if !way_busy[2] ? 2'd2 : 2'd3;
    let evict_way  : logic<2> = if plru_ok ? i_plru_way : nonbusy_way;
    let install_way: logic<2> = if i_any_tm ? itm_way : if i_has_inv ? i_inv_way : evict_way;

    // Victim preview: an install would EVICT a valid, different-tag line.
    assign o_iv_blocked = !i_any_tm && !i_has_inv && !any_nonbusy;
    assign o_iv_valid   = !i_any_tm && !i_has_inv && any_nonbusy;
    let iv_tag: logic<49> = if evict_way == 2'd0 ?
        tag_0[in_index]
    : if evict_way == 2'd1 ?
        tag_1[in_index]
    : if evict_way == 2'd2 ?
        tag_2[in_index]
    :
        tag_3[in_index]
    ;
    assign o_iv_addr    = {iv_tag, in_index, 6'd0};
    assign o_iv_sharers = if evict_way == 2'd0 ?
        shr_0[in_index]
    : if evict_way == 2'd1 ?
        shr_1[in_index]
    : if evict_way == 2'd2 ?
        shr_2[in_index]
    :
        shr_3[in_index]
    ;
    assign o_iv_owned = o_iv_valid && (if evict_way == 2'd0 ?
        own_0[in_index]
    : if evict_way == 2'd1 ?
        own_1[in_index]
    : if evict_way == 2'd2 ?
        own_2[in_index]
    :
        own_3[in_index]
    );
    // Phase B: sharers already on the install line (in-place overwrite).
    assign o_inst_oldshr = if itm_0 ?
        shr_0[in_index]
    : if itm_1 ?
        shr_1[in_index]
    : if itm_2 ?
        shr_2[in_index]
    : if itm_3 ?
        shr_3[in_index]
    :
        '0
    ;

    // -----------------------------------------------------------------
    // DRAM bus driving — P9.1: write passthrough only.
    // -----------------------------------------------------------------
    assign o_mem_addr = i_waddr;
    for l in 0..8 :gen_memw_lane {
        assign o_mem_wdata[l] = i_wdata[l];
        assign o_mem_wstrb[l] = i_wstrb[l];
    }
    assign o_mem_wen = i_wen;

    // -----------------------------------------------------------------
    // Byte-merge for write hit — per lane (S25). Lanes with wstrb==0 keep
    // the cached dword (the FF block skips them anyway).
    // -----------------------------------------------------------------
    var write_merged: logic<64> [8];
    always_comb {
        for l in 0..8 {
            // P3.b: at =1 the old line was spec-read into c_line_q one cycle before
            // this (the grant) cycle — no separate w_index read port. At =0 the
            // merge keeps its own combinational read (byte-identical, 2R1W). The
            // merge only feeds the data write on the grant cycle, where c_line_q
            // holds this store's spec-read old line (WB/miss don't reach here with
            // wstrb==0 lanes that matter, so a stale c_line_q there is unused).
            let w_lold: logic<64> = if L2_READ_1R1W ?
                c_line_q[l*64 +: 64]
            : if w_tm_0 ?
                data_0[w_index][l*64 +: 64]
            : if w_tm_1 ?
                data_1[w_index][l*64 +: 64]
            : if w_tm_2 ?
                data_2[w_index][l*64 +: 64]
            :
                data_3[w_index][l*64 +: 64]
            ;
            write_merged[l] = {
                if i_wstrb[l][7] ? i_wdata[l][63:56] : w_lold[63:56], if i_wstrb[l][6] ? i_wdata[l][55:48] : w_lold[55:48],
                if i_wstrb[l][5] ? i_wdata[l][47:40] : w_lold[47:40], if i_wstrb[l][4] ? i_wdata[l][39:32] : w_lold[39:32],
                if i_wstrb[l][3] ? i_wdata[l][31:24] : w_lold[31:24], if i_wstrb[l][2] ? i_wdata[l][23:16] : w_lold[23:16],
                if i_wstrb[l][1] ? i_wdata[l][15:8] : w_lold[15:8], if i_wstrb[l][0] ? i_wdata[l][7:0] : w_lold[7:0],
            };
        }
    }

    // PLRU update targets — lookup hits (read access), installs, and (S23)
    // write hits on their own index. Same-set collisions resolve write-last
    // (accuracy-only).
    let c_access_valid: logic    = i_cren && any_ctm;
    let c_new_plru    : logic<3> = {
        !c_way[1], if !c_way[1] ? !c_way[0] : plru[c_index][1],
        if c_way[1] ? !c_way[0] : plru[c_index][0],
    };
    let i_new_plru: logic<3> = {
        !install_way[1], if !install_way[1] ? !install_way[0] : i_plru_bits[1],
        if install_way[1] ? !install_way[0] : i_plru_bits[0],
    };
    let w_plru_bits: logic<3> = plru[w_index];
    let w_new_plru : logic<3> = {
        !w_tm_way[1], if !w_tm_way[1] ? !w_tm_way[0] : w_plru_bits[1],
        if w_tm_way[1] ? !w_tm_way[0] : w_plru_bits[0],
    };
    let w_access_valid: logic = i_wen && w_any_tm && !mis_store;

    // -----------------------------------------------------------------
    // Data-array write assembly — the merged write line (W1) and the
    // gathered install line (W2), hoisted so both the =0 (two writes) and
    // =1 (single muxed port) paths share them.
    // -----------------------------------------------------------------
    let w_merged_line: logic<512> = {
        write_merged[7], write_merged[6], write_merged[5], write_merged[4],
        write_merged[3], write_merged[2], write_merged[1], write_merged[0]
    };
    let inst_line: logic<512> = {
        i_inst_data[7], i_inst_data[6], i_inst_data[5], i_inst_data[4],
        i_inst_data[3], i_inst_data[2], i_inst_data[1], i_inst_data[0]
    };
    // W1 (merge) data-write condition — a write hit that is not a misaligned
    // invalidate. (mis_store writes no data, only invalidates lv/shr/own.)
    let mrg_data_wr: logic = i_wen && w_any_tm && !mis_store;
    // P3.a 1R1W: each bank (data_0..3) is a SEPARATE array, so it gets its OWN
    // 1RW write port. Bank k's write muxes {install→in_index/inst_line if the
    // install targets k, else merge→w_index/w_merged_line}. Different-bank
    // merge+install co-fire is fine (each bank writes its own port). The ONLY
    // real port contention is the SAME bank (w_tm_way == install_way): there the
    // install YIELDS to the merge via o_inst_port_busy (mem_ctrl holds/retries the
    // install), so at most one of {merge, install} writes bank k per cycle.
    let ins1rw_0: logic = i_inst_v && install_way == 2'd0;
    let ins1rw_1: logic = i_inst_v && install_way == 2'd1;
    let ins1rw_2: logic = i_inst_v && install_way == 2'd2;
    let ins1rw_3: logic = i_inst_v && install_way == 2'd3;
    let wr1rw_idx_0: logic<9>   = if ins1rw_0 ? in_index : w_index;
    let wr1rw_idx_1: logic<9>   = if ins1rw_1 ? in_index : w_index;
    let wr1rw_idx_2: logic<9>   = if ins1rw_2 ? in_index : w_index;
    let wr1rw_idx_3: logic<9>   = if ins1rw_3 ? in_index : w_index;
    let wr1rw_dat_0: logic<512> = if ins1rw_0 ? inst_line : w_merged_line;
    let wr1rw_dat_1: logic<512> = if ins1rw_1 ? inst_line : w_merged_line;
    let wr1rw_dat_2: logic<512> = if ins1rw_2 ? inst_line : w_merged_line;
    let wr1rw_dat_3: logic<512> = if ins1rw_3 ? inst_line : w_merged_line;
    let wr1rw_v_0: logic = (mrg_data_wr && w_tm_0) || ins1rw_0;
    let wr1rw_v_1: logic = (mrg_data_wr && w_tm_1) || ins1rw_1;
    let wr1rw_v_2: logic = (mrg_data_wr && w_tm_2) || ins1rw_2;
    let wr1rw_v_3: logic = (mrg_data_wr && w_tm_3) || ins1rw_3;
    // Install yields to a same-bank merge write. Computed WITHOUT i_inst_v (uses
    // install_way, which is combinational on i_inst_addr = registered slot state)
    // so it does NOT depend on the install decision → no comb loop when mem_ctrl
    // folds it into inst_blocked. 0 at =0 (byte-identical). Only meaningful while
    // an install is actually pending (else o_l2_inst_v is 0 regardless).
    assign o_inst_port_busy = L2_PORTS_1R1W && mrg_data_wr && (w_tm_way == install_way);

    // -----------------------------------------------------------------
    // Cache update
    // -----------------------------------------------------------------
    always_ff (clk, rst) {
        if_reset {
            for i in 0..512 {
                lv_0[i]  = 1'b0;
                lv_1[i]  = 1'b0;
                lv_2[i]  = 1'b0;
                lv_3[i]  = 1'b0;
                plru[i]  = 3'b0;
                shr_0[i] = '0;
                shr_1[i] = '0;
                shr_2[i] = '0;
                shr_3[i] = '0;
                own_0[i] = 1'b0;
                own_1[i] = 1'b0;
                own_2[i] = 1'b0;
                own_3[i] = 1'b0;
            }
            rmw_spec_ready_q = 1'b0;
            rmw_spec_waddr_q = 64'd0;
        } else {
            // P3.b spec-read FSM (L2_READ_1R1W). Present a store's merge-read on a
            // free read-port cycle (do_spec_read) → next cycle its old line is in
            // c_line_q and spec_ready gates the grant. A granted write (i_wen)
            // consumes/invalidates the pending spec. At =0 this DCEs (reset-only).
            if L2_READ_1R1W {
                if do_spec_read {
                    rmw_spec_ready_q = 1'b1;
                    rmw_spec_waddr_q = i_waddr;
                } else if i_wen {
                    rmw_spec_ready_q = 1'b0;
                }
            }
            // P9.2 directory: lookup-grant sharer add (mem_ctrl guarantees no
            // same-cycle same-line write — it retries the lookup on a write
            // collision — and the install path below cannot touch this line's
            // way: an active-slot line is excluded from victim selection and
            // a same-line install never happens while the slot is in LOOKUP).
            // Phase B: an OWNERSHIP grant (i_cadd_own) makes the mask {hart}
            // — mem_ctrl invalidated the other sharers this same cycle.
            if i_cadd_v {
                if ctm_0 {
                    shr_0[c_index] = if i_cadd_own ? cadd_oh : shr_0[c_index] | cadd_oh;
                    own_0[c_index] = i_cadd_own;
                }
                if ctm_1 {
                    shr_1[c_index] = if i_cadd_own ? cadd_oh : shr_1[c_index] | cadd_oh;
                    own_1[c_index] = i_cadd_own;
                }
                if ctm_2 {
                    shr_2[c_index] = if i_cadd_own ? cadd_oh : shr_2[c_index] | cadd_oh;
                    own_2[c_index] = i_cadd_own;
                }
                if ctm_3 {
                    shr_3[c_index] = if i_cadd_own ? cadd_oh : shr_3[c_index] | cadd_oh;
                    own_3[c_index] = i_cadd_own;
                }
            }
            // Phase B: recall-engine clean-ack — drop the probed owner.
            if i_eclr_v {
                if etm_0 {
                    shr_0[e_index] = shr_0[e_index] & ~eclr_oh;
                    own_0[e_index] = 1'b0;
                }
                if etm_1 {
                    shr_1[e_index] = shr_1[e_index] & ~eclr_oh;
                    own_1[e_index] = 1'b0;
                }
                if etm_2 {
                    shr_2[e_index] = shr_2[e_index] & ~eclr_oh;
                    own_2[e_index] = 1'b0;
                }
                if etm_3 {
                    shr_3[e_index] = shr_3[e_index] & ~eclr_oh;
                    own_3[e_index] = 1'b0;
                }
            }
            // PLRU updates: lookup hit, then install, then write hit (a
            // same-set collision resolves last-writer-wins; accuracy-only).
            if c_access_valid {
                plru[c_index] = c_new_plru;
            }
            if i_inst_v {
                plru[in_index] = i_new_plru;
            }
            if w_access_valid {
                plru[w_index] = w_new_plru;
            }

            // Write side FIRST (merge / misaligned invalidate), install LAST —
            // see the header note on the same-set eviction collision.
            if mis_store {
                // M8.D.2: misaligned store — invalidate the lo line and the
                // i_addr+8 line in any way that holds them (the hi dword
                // bypassed L2 to DRAM). No merge. P9.2: clear the sharer
                // masks too (mem_ctrl invalidates all listed sharers this
                // cycle — both lines leave the L2, so no L1 may keep them).
                if w_tm_0 {
                    lv_0[w_index]  = 1'b0;
                    shr_0[w_index] = '0;
                    own_0[w_index] = 1'b0;
                }
                if w_tm_1 {
                    lv_1[w_index]  = 1'b0;
                    shr_1[w_index] = '0;
                    own_1[w_index] = 1'b0;
                }
                if w_tm_2 {
                    lv_2[w_index]  = 1'b0;
                    shr_2[w_index] = '0;
                    own_2[w_index] = 1'b0;
                }
                if w_tm_3 {
                    lv_3[w_index]  = 1'b0;
                    shr_3[w_index] = '0;
                    own_3[w_index] = 1'b0;
                }
                if ntm_0 {
                    lv_0[nxt_index]  = 1'b0;
                    shr_0[nxt_index] = '0;
                    own_0[nxt_index] = 1'b0;
                }
                if ntm_1 {
                    lv_1[nxt_index]  = 1'b0;
                    shr_1[nxt_index] = '0;
                    own_1[nxt_index] = 1'b0;
                }
                if ntm_2 {
                    lv_2[nxt_index]  = 1'b0;
                    shr_2[nxt_index] = '0;
                    own_2[nxt_index] = 1'b0;
                }
                if ntm_3 {
                    lv_3[nxt_index]  = 1'b0;
                    shr_3[nxt_index] = '0;
                    own_3[nxt_index] = 1'b0;
                }
            } else if i_wen && w_any_tm {
                // P9.2: directory update. A WRITEBACK (i_w_wb) removes the
                // writer (its L1 invalidated the line — eviction / recall /
                // flush) and clears ownership. A normal write keeps only the
                // writer's bit (mem_ctrl precisely invalidates the others
                // this cycle); ownership survives only if the writer was the
                // owner (a write to a line owned by ANOTHER hart is vetoed
                // at the grant and recalled first).
                // P9.3 c2c: a WB captured by a waiting mem_ctrl slot also adds
                // the requester (wcadd_mask, owned for an RFO) right here.
                if w_tm_0 {
                    shr_0[w_index] = if i_w_wb ? (shr_0[w_index] & ~w_oh) | wcadd_mask : shr_0[w_index] & w_oh;
                    own_0[w_index] = if i_w_wb ? wcadd_own : own_0[w_index] && ((shr_0[w_index] & w_oh) != '0);
                }
                if w_tm_1 {
                    shr_1[w_index] = if i_w_wb ? (shr_1[w_index] & ~w_oh) | wcadd_mask : shr_1[w_index] & w_oh;
                    own_1[w_index] = if i_w_wb ? wcadd_own : own_1[w_index] && ((shr_1[w_index] & w_oh) != '0);
                }
                if w_tm_2 {
                    shr_2[w_index] = if i_w_wb ? (shr_2[w_index] & ~w_oh) | wcadd_mask : shr_2[w_index] & w_oh;
                    own_2[w_index] = if i_w_wb ? wcadd_own : own_2[w_index] && ((shr_2[w_index] & w_oh) != '0);
                }
                if w_tm_3 {
                    shr_3[w_index] = if i_w_wb ? (shr_3[w_index] & ~w_oh) | wcadd_mask : shr_3[w_index] & w_oh;
                    own_3[w_index] = if i_w_wb ? wcadd_own : own_3[w_index] && ((shr_3[w_index] & w_oh) != '0);
                }
                // Write hit — one whole-line write into the matching way.
                // write_merged already keeps the cached dword on every
                // wstrb==0 lane, so the concatenated line carries the per-lane
                // byte-merge (the SRAM has no sub-word write port). P3.a: at =1
                // this data write moves to the shared muxed port below (this
                // branch keeps only the directory update); at =0 it stays here.
                if !L2_PORTS_1R1W {
                    if w_tm_0 {
                        data_0[w_index] = w_merged_line;
                    } else if w_tm_1 {
                        data_1[w_index] = w_merged_line;
                    } else if w_tm_2 {
                        data_2[w_index] = w_merged_line;
                    } else {
                        data_3[w_index] = w_merged_line;
                    }
                }
            }

            // P9.1: full-line install (gathered DRAM line from mem_ctrl).
            // P9.2: the directory entry becomes {installer} — plus the old
            // sharers on an in-place overwrite (defensive: per-line accept
            // blocking should make that case unreachable). Phase B: the
            // installer takes OWNERSHIP (E for a read miss, M-capable for an
            // RFO) unless another hart is still listed (then mem_ctrl also
            // downgrades the grant to S via o_inst_oldshr).
            if i_inst_v {
                // Full-line install. P3.a: the data write moves to the shared
                // muxed port below at =1 (this branch keeps only tag/lv/shr/own);
                // at =0 it stays here (inst_line hoisted to module scope).
                if install_way == 2'd0 {
                    tag_0[in_index] = in_tag;
                    lv_0[in_index]  = 1'b1;
                    shr_0[in_index] = if i_any_tm ? shr_0[in_index] | inst_oh : inst_oh;
                    own_0[in_index] = !i_any_tm || ((shr_0[in_index] & ~inst_oh) == '0);
                    if !L2_PORTS_1R1W {
                        data_0[in_index] = inst_line;
                    }
                } else if install_way == 2'd1 {
                    tag_1[in_index] = in_tag;
                    lv_1[in_index]  = 1'b1;
                    shr_1[in_index] = if i_any_tm ? shr_1[in_index] | inst_oh : inst_oh;
                    own_1[in_index] = !i_any_tm || ((shr_1[in_index] & ~inst_oh) == '0);
                    if !L2_PORTS_1R1W {
                        data_1[in_index] = inst_line;
                    }
                } else if install_way == 2'd2 {
                    tag_2[in_index] = in_tag;
                    lv_2[in_index]  = 1'b1;
                    shr_2[in_index] = if i_any_tm ? shr_2[in_index] | inst_oh : inst_oh;
                    own_2[in_index] = !i_any_tm || ((shr_2[in_index] & ~inst_oh) == '0);
                    if !L2_PORTS_1R1W {
                        data_2[in_index] = inst_line;
                    }
                } else {
                    tag_3[in_index] = in_tag;
                    lv_3[in_index]  = 1'b1;
                    shr_3[in_index] = if i_any_tm ? shr_3[in_index] | inst_oh : inst_oh;
                    own_3[in_index] = !i_any_tm || ((shr_3[in_index] & ~inst_oh) == '0);
                    if !L2_PORTS_1R1W {
                        data_3[in_index] = inst_line;
                    }
                }
            }

            // P3.a 1R1W: the single shared per-bank data write port. Muxes the
            // merge (W1 @w_index) and install (W2 @in_index) into ONE write per
            // bank — the merge and install NEVER co-fire at =1 (SoC wgrant_ok
            // vetoes the bus write the cycle an install fires), so wr1rw_v_* is
            // a clean OR and wr1rw_idx/dat pick install-first. At =0 this whole
            // block DCEs (const-false) and the original writes above stand.
            if L2_PORTS_1R1W {
                if wr1rw_v_0 {
                    data_0[wr1rw_idx_0] = wr1rw_dat_0;
                }
                if wr1rw_v_1 {
                    data_1[wr1rw_idx_1] = wr1rw_dat_1;
                }
                if wr1rw_v_2 {
                    data_2[wr1rw_idx_2] = wr1rw_dat_2;
                }
                if wr1rw_v_3 {
                    data_3[wr1rw_idx_3] = wr1rw_dat_3;
                }
            }
        }
    }
}
