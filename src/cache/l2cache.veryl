// Shared L2 cache (Phase 6.E.3 — 4-way set-associative, write-through;
// P9.1 — line-granular, split-transaction read side via mem_ctrl).
//
// 128KB total, 4-way set-associative:
//   line  = 64B (8 dwords) — same as L1 dcache
//   ways  = 4
//   sets  = 512 per way (32KB per way)
//   addr[63:15] = tag (49 bits)
//   addr[14:6]  = index (9 bits, 512 sets)
//   addr[5:3]   = word offset (3 bits, 8 dwords)
//   addr[2:0]   = byte offset (ignored — request granularity is 8B)
//
// P9.1: the old combinational read passthrough (per-word lazy fills riding
// the L1's 8 sequential miss reads) is gone. The read side now serves the
// mem_ctrl transaction controller through two ports:
//   - LOOKUP/COPY (i_caddr/i_cren): combinational full-LINE hit verdict
//     (o_chit) + the hit way's 8 dwords (o_cdata). The per-word valid bits
//     are gone — installs are always full lines, so line-valid suffices.
//   - INSTALL (i_inst_*): a gathered DRAM line is written whole at one edge.
//     If the line is already present (a second hart gathered the same line),
//     the matching way is overwritten in place — never double-allocated.
//
// Policy: write-through, no-write-allocate (unchanged).
//   - write hit  : update hit way's data (byte-merge), forward to DRAM.
//   - write miss : pure pass-through.
// The lower interface is now WRITE-ONLY (o_mem_*); DRAM reads are owned by
// mem_ctrl.
//
// Replacement: tree-pseudo-LRU (3 bits per set, same encoding as L1
// dcache) — bit[2] selects LRU sub-group; bit[1] LRU in {way0,way1};
// bit[0] LRU in {way2,way3}. Touched on lookup hits, installs, write hits.
//
// Same-cycle install + write-merge interaction: a write conflicting with the
// install LINE never reaches this module (mem_ctrl suppresses the install).
// A write-hit MERGE into a different line that the install happens to EVICT
// (same set, victim way) is ordered merge-first/install-last below, so the
// install wins the array cells — the merge's bytes belonged to the dying
// line and are already in DRAM (write-through), so nothing is lost.
pub module l2cache (
    clk: input clock,
    rst: input reset,
    // P9.1 lookup/copy port (mem_ctrl): combinational full-line lookup at
    // i_caddr. i_cren marks a real read access (PLRU touch on hit).
    i_caddr: input  logic<64>    ,
    i_cren : input  logic        ,
    o_chit : output logic        ,
    o_cdata: output logic<64> [8],
    // P9.1 full-line install port (mem_ctrl: gathered DRAM line).
    i_inst_v   : input logic        ,
    i_inst_addr: input logic<64>    ,
    i_inst_data: input logic<64> [8],
    // Upper WRITE interface (S23: from memory_bus's write channel — the
    // granted hart's write-through store). Always forwards to DRAM.
    // S25 write-combining: a write is a full 64B LINE — 8 dword lanes with
    // per-lane byte strobes. A single-dword write (slow store / MMIO) has
    // one populated lane; i_waddr keeps its byte offset for those (the
    // misaligned hi-dword invalidate below decodes i_waddr+8).
    i_waddr: input logic<64>    ,
    i_wdata: input logic<64> [8],
    i_wstrb: input logic<8>  [8],
    // M8.D.2: hi-side strobe for a misaligned 2-dword STORE (v4 SoC). When
    // nonzero the store's hi dword is written to DRAM via a SoC bypass that
    // skips L2, so L2's cached copy of the touched line(s) would go stale.
    // Non-v4 instantiations tie this to 0 (the invalidate path never fires).
    i_wstrb_hi: input logic<8>,
    i_wen     : input logic   ,
    // Lower interface — P9.1: write passthrough ONLY (DRAM reads moved to
    // mem_ctrl, which owns the external read port and its arbitration).
    o_mem_addr : output logic<64>    ,
    o_mem_wdata: output logic<64> [8],
    o_mem_wstrb: output logic<8>  [8],
    o_mem_wen  : output logic        ,
) {
    // -----------------------------------------------------------------
    // Address decomposition
    // -----------------------------------------------------------------
    // Lookup-side decode (i_caddr).
    let c_tag  : logic<49> = i_caddr[63:15];
    let c_index: logic<9>  = i_caddr[14:6];
    // Install-side decode (i_inst_addr).
    let in_tag  : logic<49> = i_inst_addr[63:15];
    let in_index: logic<9>  = i_inst_addr[14:6];
    // Write-side decode (i_waddr) — drives the write-hit merge. S25: lanes
    // carry the dword offsets; only the line part of i_waddr is decoded.
    let w_tag  : logic<49> = i_waddr[63:15];
    let w_index: logic<9>  = i_waddr[14:6];

    // -----------------------------------------------------------------
    // Storage — 4 separate banks (one per way). P9.1: per-word valid bits
    // are gone (installs are always full lines).
    // -----------------------------------------------------------------
    var tag_0 : logic<49> [512] ;
    var tag_1 : logic<49> [512] ;
    var tag_2 : logic<49> [512] ;
    var tag_3 : logic<49> [512] ;
    var lv_0  : logic     [512] ;
    var lv_1  : logic     [512] ;
    var lv_2  : logic     [512] ;
    var lv_3  : logic     [512] ;
    var data_0: logic<64> [4096];
    var data_1: logic<64> [4096];
    var data_2: logic<64> [4096];
    var data_3: logic<64> [4096];
    var plru  : logic<3>  [512] ; // tree-PLRU per set

    // -----------------------------------------------------------------
    // Lookup port: per-way line hit + full-line copy.
    // -----------------------------------------------------------------
    let ctm_0  : logic = lv_0[c_index] && (tag_0[c_index] == c_tag);
    let ctm_1  : logic = lv_1[c_index] && (tag_1[c_index] == c_tag);
    let ctm_2  : logic = lv_2[c_index] && (tag_2[c_index] == c_tag);
    let ctm_3  : logic = lv_3[c_index] && (tag_3[c_index] == c_tag);
    let any_ctm: logic = ctm_0 || ctm_1 || ctm_2 || ctm_3;

    let c_way: logic<2> = if ctm_0 ? 2'd0 : if ctm_1 ? 2'd1 : if ctm_2 ? 2'd2 : 2'd3;

    assign o_chit = any_ctm;
    for l in 0..8 :gen_cdata {
        assign o_cdata[l] = if ctm_0 ?
            data_0[{c_index, l as 3}]
        : if ctm_1 ?
            data_1[{c_index, l as 3}]
        : if ctm_2 ?
            data_2[{c_index, l as 3}]
        :
            data_3[{c_index, l as 3}]
        ;
    }

    // -----------------------------------------------------------------
    // Write-side line match (i_waddr) — write-hit merge target.
    // -----------------------------------------------------------------
    let w_tm_0  : logic = lv_0[w_index] && (tag_0[w_index] == w_tag);
    let w_tm_1  : logic = lv_1[w_index] && (tag_1[w_index] == w_tag);
    let w_tm_2  : logic = lv_2[w_index] && (tag_2[w_index] == w_tag);
    let w_tm_3  : logic = lv_3[w_index] && (tag_3[w_index] == w_tag);
    let w_any_tm: logic = w_tm_0 || w_tm_1 || w_tm_2 || w_tm_3;

    // -----------------------------------------------------------------
    // M8.D.2: misaligned-store hi-side invalidate (mirror of dcache B.3).
    // A v4 misaligned store writes its lo dword through L2 (i_wstrb) and its
    // hi dword straight to DRAM via the SoC bypass (i_wstrb_hi). The hi dword
    // lands in the line at i_addr+8, whose cached copy in L2 would go stale —
    // so on such a store we invalidate any cached way for BOTH the lo line
    // (i_addr) and the i_addr+8 line, and skip the byte-merge below. A later
    // read refills the merged bytes from DRAM (which holds both halves).
    // -----------------------------------------------------------------
    let mis_store: logic     = i_wen && (i_wstrb_hi != 8'd0);
    let nxt_addr : logic<64> = i_waddr + 64'd8;
    let nxt_tag  : logic<49> = nxt_addr[63:15];
    let nxt_index: logic<9>  = nxt_addr[14:6];
    let ntm_0    : logic     = lv_0[nxt_index] && (tag_0[nxt_index] == nxt_tag);
    let ntm_1    : logic     = lv_1[nxt_index] && (tag_1[nxt_index] == nxt_tag);
    let ntm_2    : logic     = lv_2[nxt_index] && (tag_2[nxt_index] == nxt_tag);
    let ntm_3    : logic     = lv_3[nxt_index] && (tag_3[nxt_index] == nxt_tag);

    // -----------------------------------------------------------------
    // Install victim selection — same-line way (overwrite in place) first,
    // then invalid way, then PLRU.
    // -----------------------------------------------------------------
    let itm_0: logic = lv_0[in_index] && (tag_0[in_index] == in_tag);
    let itm_1: logic = lv_1[in_index] && (tag_1[in_index] == in_tag);
    let itm_2: logic = lv_2[in_index] && (tag_2[in_index] == in_tag);
    let itm_3: logic = lv_3[in_index] && (tag_3[in_index] == in_tag);
    let i_any_tm: logic    = itm_0 || itm_1 || itm_2 || itm_3;
    let itm_way : logic<2> = if itm_0 ? 2'd0 : if itm_1 ? 2'd1 : if itm_2 ? 2'd2 : 2'd3;

    let i_plru_bits: logic<3> = plru[in_index];
    let i_has_inv  : logic    = !lv_0[in_index] || !lv_1[in_index] || !lv_2[in_index] || !lv_3[in_index];
    let i_inv_way  : logic<2> = if !lv_0[in_index] ? 2'd0 : if !lv_1[in_index] ? 2'd1 : if !lv_2[in_index] ? 2'd2 : 2'd3;
    let i_plru_way : logic<2> = {i_plru_bits[2], if !i_plru_bits[2] ? i_plru_bits[1] : i_plru_bits[0]};
    let install_way: logic<2> = if i_any_tm ? itm_way : if i_has_inv ? i_inv_way : i_plru_way;

    // -----------------------------------------------------------------
    // DRAM bus driving — P9.1: write passthrough only.
    // -----------------------------------------------------------------
    assign o_mem_addr = i_waddr;
    for l in 0..8 :gen_memw_lane {
        assign o_mem_wdata[l] = i_wdata[l];
        assign o_mem_wstrb[l] = i_wstrb[l];
    }
    assign o_mem_wen = i_wen;

    // -----------------------------------------------------------------
    // Byte-merge for write hit — per lane (S25). Lanes with wstrb==0 keep
    // the cached dword (the FF block skips them anyway).
    // -----------------------------------------------------------------
    var write_merged: logic<64> [8];
    always_comb {
        for l in 0..8 {
            let w_lold: logic<64> = if w_tm_0 ?
                data_0[{w_index, l as 3}]
            : if w_tm_1 ?
                data_1[{w_index, l as 3}]
            : if w_tm_2 ?
                data_2[{w_index, l as 3}]
            :
                data_3[{w_index, l as 3}]
            ;
            write_merged[l] = {
                if i_wstrb[l][7] ? i_wdata[l][63:56] : w_lold[63:56], if i_wstrb[l][6] ? i_wdata[l][55:48] : w_lold[55:48],
                if i_wstrb[l][5] ? i_wdata[l][47:40] : w_lold[47:40], if i_wstrb[l][4] ? i_wdata[l][39:32] : w_lold[39:32],
                if i_wstrb[l][3] ? i_wdata[l][31:24] : w_lold[31:24], if i_wstrb[l][2] ? i_wdata[l][23:16] : w_lold[23:16],
                if i_wstrb[l][1] ? i_wdata[l][15:8] : w_lold[15:8], if i_wstrb[l][0] ? i_wdata[l][7:0] : w_lold[7:0],
            };
        }
    }

    // PLRU update targets — lookup hits (read access), installs, and (S23)
    // write hits on their own index. Same-set collisions resolve write-last
    // (accuracy-only).
    let c_access_valid: logic    = i_cren && any_ctm;
    let c_new_plru    : logic<3> = {
        !c_way[1], if !c_way[1] ? !c_way[0] : plru[c_index][1],
        if c_way[1] ? !c_way[0] : plru[c_index][0],
    };
    let i_new_plru: logic<3> = {
        !install_way[1], if !install_way[1] ? !install_way[0] : i_plru_bits[1],
        if install_way[1] ? !install_way[0] : i_plru_bits[0],
    };
    let w_tm_way   : logic<2> = if w_tm_0 ? 2'd0 : if w_tm_1 ? 2'd1 : if w_tm_2 ? 2'd2 : 2'd3;
    let w_plru_bits: logic<3> = plru[w_index];
    let w_new_plru : logic<3> = {
        !w_tm_way[1], if !w_tm_way[1] ? !w_tm_way[0] : w_plru_bits[1],
        if w_tm_way[1] ? !w_tm_way[0] : w_plru_bits[0],
    };
    let w_access_valid: logic = i_wen && w_any_tm && !mis_store;

    // -----------------------------------------------------------------
    // Cache update
    // -----------------------------------------------------------------
    always_ff (clk, rst) {
        if_reset {
            for i in 0..512 {
                lv_0[i] = 1'b0;
                lv_1[i] = 1'b0;
                lv_2[i] = 1'b0;
                lv_3[i] = 1'b0;
                plru[i] = 3'b0;
            }
        } else {
            // PLRU updates: lookup hit, then install, then write hit (a
            // same-set collision resolves last-writer-wins; accuracy-only).
            if c_access_valid {
                plru[c_index] = c_new_plru;
            }
            if i_inst_v {
                plru[in_index] = i_new_plru;
            }
            if w_access_valid {
                plru[w_index] = w_new_plru;
            }

            // Write side FIRST (merge / misaligned invalidate), install LAST —
            // see the header note on the same-set eviction collision.
            if mis_store {
                // M8.D.2: misaligned store — invalidate the lo line and the
                // i_addr+8 line in any way that holds them (the hi dword
                // bypassed L2 to DRAM). No merge.
                if w_tm_0 {
                    lv_0[w_index] = 1'b0;
                }
                if w_tm_1 {
                    lv_1[w_index] = 1'b0;
                }
                if w_tm_2 {
                    lv_2[w_index] = 1'b0;
                }
                if w_tm_3 {
                    lv_3[w_index] = 1'b0;
                }
                if ntm_0 {
                    lv_0[nxt_index] = 1'b0;
                }
                if ntm_1 {
                    lv_1[nxt_index] = 1'b0;
                }
                if ntm_2 {
                    lv_2[nxt_index] = 1'b0;
                }
                if ntm_3 {
                    lv_3[nxt_index] = 1'b0;
                }
            } else if i_wen && w_any_tm {
                // Write hit on the write-side tm way — merge every populated lane.
                for l in 0..8 {
                    if i_wstrb[l] != 8'd0 {
                        if w_tm_0 {
                            data_0[{w_index, l as 3}] = write_merged[l];
                        } else if w_tm_1 {
                            data_1[{w_index, l as 3}] = write_merged[l];
                        } else if w_tm_2 {
                            data_2[{w_index, l as 3}] = write_merged[l];
                        } else {
                            data_3[{w_index, l as 3}] = write_merged[l];
                        }
                    }
                }
            }

            // P9.1: full-line install (gathered DRAM line from mem_ctrl).
            if i_inst_v {
                if install_way == 2'd0 {
                    tag_0[in_index] = in_tag;
                    lv_0[in_index]  = 1'b1;
                    for l in 0..8 {
                        data_0[{in_index, l as 3}] = i_inst_data[l];
                    }
                } else if install_way == 2'd1 {
                    tag_1[in_index] = in_tag;
                    lv_1[in_index]  = 1'b1;
                    for l in 0..8 {
                        data_1[{in_index, l as 3}] = i_inst_data[l];
                    }
                } else if install_way == 2'd2 {
                    tag_2[in_index] = in_tag;
                    lv_2[in_index]  = 1'b1;
                    for l in 0..8 {
                        data_2[{in_index, l as 3}] = i_inst_data[l];
                    }
                } else {
                    tag_3[in_index] = in_tag;
                    lv_3[in_index]  = 1'b1;
                    for l in 0..8 {
                        data_3[{in_index, l as 3}] = i_inst_data[l];
                    }
                }
            }
        }
    }
}
