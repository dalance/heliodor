// l2cache: the shared L2 of the SoC, 128 KB in 4 ways of 512 sets of 64-byte
// lines, write-through to DRAM without write allocate, holding the inclusive
// directory of the L1 D-caches. DRAM reads belong to mem_ctrl; DRAM writes
// leave through mem_ctrl's write buffer, so this module only keeps its copy.
//
// Address: tag = PA[PA_W-1:15], index = [14:6]. Only PAs enter the L2.
//
// Arrays, all 1R1W without reset: per way a tag word {own, shr, tag}
// (l2_tag_bank) and a data row (l2_data_bank). The line-valid bits (4 per
// set, read at the executing line's index) and the PLRU bits (3 per set) are
// flops with reset, so the L2 is empty from the first cycle; a tag word is
// meaningful only while its valid bit is set, and every install writes it
// whole.
//
// Tag port: mem_ctrl presents one line per cycle (i_t_addr); its tag words
// and data rows of all four ways are read at the index. In the next cycle
// (the execute cycle of that line, x) the module presents its verdict, and
// at most one action on line x arrives, which writes one tag word and one
// data row:
//   - lookup: PLRU touch (i_cren), a sharer add (i_cadd_*), or the CMO_HOME
//     invalidate of the line and its directory entry (i_cinv_v)
//   - install (i_inst_*): the victim way takes line x; its sharer set becomes
//     {installer} (plus the old sharers when x was present), owned unless
//     another hart is listed
//   - recall-engine clean ack (i_eclr_*): the probed owner leaves the entry,
//     alone or before a lookup's action on the same line
//   - write (i_wen, ...): the strobed bytes are merged on a hit; a writeback
//     removes the writer (and adds a c2c requester), a plain write keeps
//     only the writer, whose ownership survives only if it was the owner
// The tag read forwards the write of its own cycle, so the actions apply to
// the directory in issue order. The data read does not forward; mem_ctrl
// retries a lookup whose line was written in its read cycle.
//
// Directory: shr lists the harts whose L1 may hold the line; it may
// over-approximate (an L1 that silently dropped a clean line stays listed),
// which costs spurious invalidates only. own: the single listed hart holds
// the line in E or M.
//
// Install victim: line x itself (in place), else an invalid way, else a
// valid way whose line has no active mem_ctrl transaction (i_busy_*), PLRU's
// choice when it qualifies. o_iv_blocked: no such way.
pub module l2cache #(
    param N_HARTS: u32 = 1            ,
    // mem_ctrl's transaction slots: the victim exclusion is per slot, the
    // directory masks per hart.
    param SPH    : u32 = 1            ,
    param N_SLOTS: u32 = N_HARTS * SPH,
) (
    clk: input clock,
    rst: input reset,

    i_t_addr: input logic<64>,

    // Verdict on line x.
    o_x_hit     : output logic             ,
    o_x_shr     : output logic<N_HARTS>    , // 0 on a miss
    o_x_owned   : output logic             ,
    o_cdata     : output logic<64>     [8] ,
    o_iv_valid  : output logic             , // an install of x would evict a valid line
    o_iv_addr   : output logic<64>         ,
    o_iv_sharers: output logic<N_HARTS>    ,
    o_iv_owned  : output logic             ,
    o_iv_blocked: output logic             ,
    i_busy_line : input  logic<58> [N_SLOTS],
    i_busy_v    : input  logic     [N_SLOTS],

    // Actions on line x.
    i_cren       : input logic        ,
    i_cadd_v     : input logic        ,
    i_cadd_hart  : input logic<3>     ,
    i_cadd_own   : input logic        ,
    i_cinv_v     : input logic        ,
    i_inst_v     : input logic        ,
    i_inst_hart  : input logic<3>     ,
    i_inst_data  : input logic<64> [8],
    i_eclr_v     : input logic        ,
    i_eclr_hart  : input logic<3>     ,
    i_wen        : input logic        ,
    i_w_hart     : input logic<3>     ,
    i_w_nohart   : input logic        , // a System Bus Access write keeps no sharer
    i_w_wb       : input logic        ,
    i_w_cadd_v   : input logic        ,
    i_w_cadd_hart: input logic<3>     ,
    i_w_cadd_own : input logic        ,
    i_wdata      : input logic<64> [8],
    i_wstrb      : input logic<8>  [8],
) {
    const SETS  : u32 = 512;
    const TAG_W : u32 = $bits(pma_pkg::Pa) - 15;
    const WORD_W: u32 = TAG_W + N_HARTS + 1;

    let t_idx: logic<9> = i_t_addr[14:6];

    var x_tag: logic<TAG_W>;
    var x_idx: logic<9>    ;
    always_ff (clk) {
        x_tag = i_t_addr[TAG_W + 14:15];
        x_idx = t_idx;
    }

    var plru: logic<3> [SETS];

    // Tag words.
    var tw_rd: logic<WORD_W>  [4];
    var tw_we: logic<4>          ;
    var tw_wd: logic<WORD_W>     ;
    var lv   : logic<4>          ;
    var own  : logic<4>          ;
    var shr  : logic<N_HARTS> [4];
    var tg   : logic<TAG_W>   [4];
    var hm   : logic<4>          ;
    var nw_v  : logic             ; // the action's tag word
    var nw_way: logic<2>          ;
    var nw_lv : logic             ;
    var nw_own: logic             ;
    var nw_shr: logic<N_HARTS>    ;
    for k in 0..4 :gen_tag {
        inst u_tag: l2_tag_bank #(
            SETS: SETS  ,
            W   : WORD_W,
        ) (
            clk                               ,
            i_ridx : t_idx                    ,
            o_rdata: tw_rd[k]                 ,
            i_we   : tw_we[k]                 ,
            i_widx : x_idx                    ,
            i_wdata: tw_wd                    ,
        );
        var lv_q: logic [SETS];
        always_ff (clk, rst) {
            if_reset {
                for i in 0..SETS {
                    lv_q[i] = 1'b0;
                }
            } else if tw_we[k] {
                lv_q[x_idx] = nw_lv;
            }
        }
        assign lv[k]  = lv_q[x_idx];
        assign own[k] = tw_rd[k][WORD_W - 1];
        assign shr[k] = tw_rd[k][TAG_W + N_HARTS - 1:TAG_W];
        assign tg[k]  = tw_rd[k][TAG_W - 1:0];
        assign hm[k]  = lv[k] && tg[k] == x_tag;
    }
    let hit : logic          = hm != 4'd0;
    let hway: logic<2>       = if hm[0] ? 2'd0 : if hm[1] ? 2'd1 : if hm[2] ? 2'd2 : 2'd3;
    let hshr: logic<N_HARTS> = shr[hway];
    let hown: logic          = own[hway];
    assign o_x_hit   = hit;
    assign o_x_shr   = if hit ? hshr : '0;
    assign o_x_owned = hit && hown;

    // Install victim.
    var way_busy: logic<4>;
    always_comb {
        for k in 0..4 {
            way_busy[k] = 1'b0;
            for h in 0..N_SLOTS {
                if i_busy_v[h] && i_busy_line[h] == ({tg[k], x_idx} as 58) {
                    way_busy[k] = lv[k];
                }
            }
        }
    }
    let plru_bits  : logic<3> = plru[x_idx];
    let has_inv    : logic    = lv != 4'hf;
    let inv_way    : logic<2> = if !lv[0] ? 2'd0 : if !lv[1] ? 2'd1 : if !lv[2] ? 2'd2 : 2'd3;
    let plru_way   : logic<2> = {plru_bits[2], if !plru_bits[2] ? plru_bits[1] : plru_bits[0]};
    let any_nonbusy: logic    = way_busy != 4'hf;
    let nonbusy_way: logic<2> = if !way_busy[0] ? 2'd0 : if !way_busy[1] ? 2'd1 : if !way_busy[2] ? 2'd2 : 2'd3;
    let evict_way  : logic<2> = if !way_busy[plru_way] ? plru_way : nonbusy_way;
    let install_way: logic<2> = if hit ? hway : if has_inv ? inv_way : evict_way;
    assign o_iv_blocked = !hit && !has_inv && !any_nonbusy;
    assign o_iv_valid   = !hit && !has_inv && any_nonbusy;
    assign o_iv_addr    = {tg[evict_way], x_idx, 6'd0} as 64;
    assign o_iv_sharers = shr[evict_way];
    assign o_iv_owned   = o_iv_valid && own[evict_way];

    // The action's tag word.
    var cadd_oh : logic<N_HARTS>;
    var inst_oh : logic<N_HARTS>;
    var w_oh    : logic<N_HARTS>;
    var eclr_oh : logic<N_HARTS>;
    var wcadd_oh: logic<N_HARTS>;
    for h in 0..N_HARTS :gen_hart_oh {
        assign cadd_oh[h]  = i_cadd_hart == (h as 3);
        assign inst_oh[h]  = i_inst_hart == (h as 3);
        assign w_oh[h]     = !i_w_nohart && i_w_hart == (h as 3);
        assign eclr_oh[h]  = i_eclr_hart == (h as 3);
        assign wcadd_oh[h] = i_w_cadd_hart == (h as 3);
    }
    let wcadd_mask: logic<N_HARTS> = if i_w_cadd_v ? wcadd_oh : '0;
    let wcadd_own : logic          = i_w_cadd_v && i_w_cadd_own;
    // A clean ack may come with the lookup it unblocks: the lookup's
    // action applies to the entry without the probed owner.
    let e_shr     : logic<N_HARTS> = if i_eclr_v ? hshr & ~eclr_oh : hshr;
    let e_own     : logic          = !i_eclr_v && hown;
    always_comb {
        nw_v   = 1'b0;
        nw_way = hway;
        nw_lv  = 1'b1;
        nw_own = e_own;
        nw_shr = e_shr;
        if i_inst_v {
            nw_v   = 1'b1;
            nw_way = install_way;
            nw_shr = if hit ? hshr | inst_oh : inst_oh;
            nw_own = !hit || ((hshr & ~inst_oh) == '0);
        } else if hit {
            nw_v = i_cinv_v || i_cadd_v || i_eclr_v || i_wen;
            if i_cinv_v {
                nw_lv  = 1'b0;
                nw_own = 1'b0;
                nw_shr = '0;
            } else if i_cadd_v {
                nw_own = i_cadd_own;
                nw_shr = if i_cadd_own ? cadd_oh : e_shr | cadd_oh;
            } else if i_wen {
                nw_own = if i_w_wb ? wcadd_own : hown && ((hshr & w_oh) != '0);
                nw_shr = if i_w_wb ? (hshr & ~w_oh) | wcadd_mask : hshr & w_oh;
            }
        }
    }
    assign tw_wd = {nw_own, nw_shr, x_tag};
    for k in 0..4 :gen_tag_we {
        assign tw_we[k] = nw_v && nw_way == k;
    }

    // Data rows: all four ways read at the presented index, the hit way
    // selected in the execute cycle.
    var rd_line: logic<512> [4];
    let c_line : logic<512>     = rd_line[hway];
    for l in 0..8 :gen_cdata {
        assign o_cdata[l] = c_line[l * 64+:64];
    }
    let inst_line: logic<512> = {
        i_inst_data[7], i_inst_data[6], i_inst_data[5], i_inst_data[4],
        i_inst_data[3], i_inst_data[2], i_inst_data[1], i_inst_data[0]
    };
    let w_line: logic<512> = {
        i_wdata[7], i_wdata[6], i_wdata[5], i_wdata[4],
        i_wdata[3], i_wdata[2], i_wdata[1], i_wdata[0]
    };
    let w_be: logic<64> = {
        i_wstrb[7], i_wstrb[6], i_wstrb[5], i_wstrb[4],
        i_wstrb[3], i_wstrb[2], i_wstrb[1], i_wstrb[0]
    };
    let dw_way: logic<2> = if i_inst_v ? install_way : hway;
    let dw_v  : logic    = i_inst_v || (i_wen && hit);
    for k in 0..4 :gen_data {
        inst u_data: l2_data_bank #(
            SETS : SETS,
            ROW_W: 512 ,
        ) (
            clk                                      ,
            i_ridx : t_idx                           ,
            o_rdata: rd_line[k]                      ,
            i_we   : dw_v && dw_way == k             ,
            i_widx : x_idx                           ,
            i_wdata: if i_inst_v ? inst_line : w_line,
            i_wbe  : if i_inst_v ? '1 : w_be         ,
        );
    }

    // PLRU: touched by lookup hits, installs and write hits.
    let p_way: logic<2> = if i_inst_v ? install_way : hway;
    let p_new: logic<3> = {
        !p_way[1], if !p_way[1] ? !p_way[0] : plru_bits[1],
        if p_way[1] ? !p_way[0] : plru_bits[0],
    };
    always_ff (clk, rst) {
        if_reset {
            for i in 0..SETS {
                plru[i] = 3'b0;
            }
        } else {
            if i_inst_v || ((i_cren || i_wen) && hit) {
                plru[x_idx] = p_new;
            }
        }
    }
}
