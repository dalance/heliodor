// Shared L2 cache (Phase 6.E.2 — direct-mapped, write-through).
//
// 32KB direct-mapped:
//   line  = 64B (8 dwords) — same as L1 dcache
//   sets  = 512
//   addr[63:15] = tag (49 bits)
//   addr[14:6]  = index (9 bits, 512 sets)
//   addr[5:3]   = word offset (3 bits, 8 dwords)
//   addr[2:0]   = byte offset (ignored — request granularity is 8B)
//
// Sits between memory_bus's granted DRAM request and the SoC-level DRAM
// port. Per-word valid bits track which dwords of a line are populated
// (filled lazily as L1 fills walk through 8 sequential reads).
//
// Policy: write-through, no-write-allocate.
//   - read hit  : serve from L2 array, do NOT forward to DRAM.
//   - read miss : forward to DRAM, install word in L2 (replace tag if conflict).
//   - write hit : update L2 entry (byte-merge with wstrb), forward to DRAM.
//   - write miss: forward to DRAM, leave L2 untouched.
//
// MSHR is intentionally absent: the testbench DRAM is 1-cycle
// combinational, so there is no fill latency to overlap. Real-DRAM
// latency would warrant adding it; current value is zero.
//
// Coherence: invalidate broadcast still fires from memory_bus directly to
// L1 dcaches (heliodor_soc bus_inv_valid path). L2 does not yet drive its
// own invalidates — a future Phase 6.E.4 will add L2-eviction-driven L1
// invalidate fanout. For N=1 (current scope) coherence is moot.
pub module l2cache (
    clk: input clock,
    rst: input reset,
    // Upper interface (from memory_bus — the granted hart's request)
    i_addr : input  logic<64>,
    i_wdata: input  logic<64>,
    i_wstrb: input  logic<8> ,
    i_wen  : input  logic    ,
    i_ren  : input  logic    ,
    o_rdata: output logic<64>,
    // Lower interface (to SoC-level DRAM port)
    o_mem_addr : output logic<64>,
    o_mem_wdata: output logic<64>,
    o_mem_wstrb: output logic<8> ,
    o_mem_wen  : output logic    ,
    o_mem_ren  : output logic    ,
    i_mem_rdata: input  logic<64>,
) {
    // -----------------------------------------------------------------
    // Address decomposition
    // -----------------------------------------------------------------
    let req_tag    : logic<49> = i_addr[63:15];
    let req_index  : logic<9>  = i_addr[14:6];
    let req_offset : logic<3>  = i_addr[5:3];

    // -----------------------------------------------------------------
    // Storage
    // -----------------------------------------------------------------
    var tag_array  : logic<49> [512];
    var line_valid : logic     [512];
    var word_valid : logic<8>  [512];      // per-word valid (8 bits per line)
    var data_array : logic<64> [4096];     // 512 sets × 8 dwords flattened

    let data_idx   : logic<12> = {req_index, req_offset};

    // -----------------------------------------------------------------
    // Lookup
    // -----------------------------------------------------------------
    let cur_tag       : logic<49> = tag_array [req_index];
    let cur_line_valid: logic     = line_valid[req_index];
    let cur_word_valid: logic<8>  = word_valid[req_index];
    let cur_data      : logic<64> = data_array[data_idx];

    let tag_match : logic = cur_line_valid && (cur_tag == req_tag);
    let word_hit  : logic = tag_match && cur_word_valid[req_offset];

    let read_hit  : logic = i_ren && word_hit;
    let read_miss : logic = i_ren && !word_hit;

    // -----------------------------------------------------------------
    // DRAM bus driving
    //   read hit  → suppress ren (no DRAM access)
    //   read miss → ren, addr=i_addr  (DRAM responds combinationally)
    //   any write → wen, addr=i_addr, wdata, wstrb (write-through)
    // -----------------------------------------------------------------
    assign o_mem_addr  = i_addr;
    assign o_mem_wdata = i_wdata;
    assign o_mem_wstrb = i_wstrb;
    assign o_mem_wen   = i_wen;
    assign o_mem_ren   = read_miss;

    // o_rdata: from L2 on hit, from DRAM on miss.
    assign o_rdata = if read_hit ? cur_data : i_mem_rdata;

    // -----------------------------------------------------------------
    // Write merge — byte-granular wstrb on existing L2 line content.
    // Only used on write-hit; computed combinationally for clarity.
    // -----------------------------------------------------------------
    let write_merged: logic<64> = {
        if i_wstrb[7] ? i_wdata[63:56] : cur_data[63:56],
        if i_wstrb[6] ? i_wdata[55:48] : cur_data[55:48],
        if i_wstrb[5] ? i_wdata[47:40] : cur_data[47:40],
        if i_wstrb[4] ? i_wdata[39:32] : cur_data[39:32],
        if i_wstrb[3] ? i_wdata[31:24] : cur_data[31:24],
        if i_wstrb[2] ? i_wdata[23:16] : cur_data[23:16],
        if i_wstrb[1] ? i_wdata[15:8]  : cur_data[15:8] ,
        if i_wstrb[0] ? i_wdata[7:0]   : cur_data[7:0]  ,
    };

    // -----------------------------------------------------------------
    // Cache update
    //   - read miss + same-tag : install this word, OR in valid bit.
    //   - read miss + diff-tag : replace line; valid = single-bit at offset.
    //   - write hit            : update word with byte-merged value.
    //   - write miss           : pure pass-through (no allocate).
    // -----------------------------------------------------------------
    // One-hot mask for the requested word's valid bit. Used to either OR
    // into the existing word_valid (same-line miss) or to seed a fresh
    // word_valid on conflict miss.
    let one_hot_word: logic<8> = 8'd1 << req_offset;

    always_ff (clk, rst) {
        if_reset {
            for i in 0..512 {
                line_valid[i] = 1'b0;
                word_valid[i] = 8'b0;
            }
        } else {
            if read_miss {
                tag_array [req_index] = req_tag;
                line_valid[req_index] = 1'b1;
                word_valid[req_index] = if tag_match
                                      ? cur_word_valid | one_hot_word
                                      : one_hot_word;
                data_array[data_idx]  = i_mem_rdata;
            } else if i_wen && tag_match {
                // Write hit: update L2 with byte-merged value (write-through
                // also fires through o_mem_wen so DRAM stays current).
                data_array[data_idx] = write_merged;
            }
        }
    }
}
