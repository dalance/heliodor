// Shared L2 cache (Phase 6.E.1 — passthrough shell).
//
// Sits between memory_bus and the SoC-level DRAM port. In this initial
// shell phase L2 contains no storage: every request is forwarded straight
// through to DRAM, and DRAM rdata is forwarded straight back. The
// interface exists so a future Phase 6.E.2 can drop in tag/data arrays
// without re-wiring heliodor_soc.
//
// Cycle latency of a DRAM access is unchanged from the pre-L2 hierarchy
// (purely combinational pass-through). clk/rst are wired now so future
// state machines don't reshuffle the port list.
pub module l2cache (
    clk: input clock,
    rst: input reset,
    // Upper interface (from memory_bus — the granted hart's request)
    i_addr : input  logic<64>,
    i_wdata: input  logic<64>,
    i_wstrb: input  logic<8> ,
    i_wen  : input  logic    ,
    i_ren  : input  logic    ,
    o_rdata: output logic<64>,
    // Lower interface (to SoC-level DRAM port)
    o_mem_addr : output logic<64>,
    o_mem_wdata: output logic<64>,
    o_mem_wstrb: output logic<8> ,
    o_mem_wen  : output logic    ,
    o_mem_ren  : output logic    ,
    i_mem_rdata: input  logic<64>,
) {
    // Passthrough — no cache state yet (Phase 6.E.1).
    assign o_mem_addr  = i_addr;
    assign o_mem_wdata = i_wdata;
    assign o_mem_wstrb = i_wstrb;
    assign o_mem_wen   = i_wen;
    assign o_mem_ren   = i_ren;
    assign o_rdata     = i_mem_rdata;
}
