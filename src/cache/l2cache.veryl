// Shared L2 cache (Phase 6.E.3 — 4-way set-associative, write-through).
//
// 128KB total, 4-way set-associative:
//   line  = 64B (8 dwords) — same as L1 dcache
//   ways  = 4
//   sets  = 512 per way (32KB per way)
//   addr[63:15] = tag (49 bits)
//   addr[14:6]  = index (9 bits, 512 sets)
//   addr[5:3]   = word offset (3 bits, 8 dwords)
//   addr[2:0]   = byte offset (ignored — request granularity is 8B)
//
// Sits between memory_bus's granted DRAM request and the SoC-level DRAM
// port. Per-word valid bits track which dwords of a line are populated
// (filled lazily as L1 fills walk through 8 sequential reads).
//
// Policy: write-through, no-write-allocate.
//   - read hit  : serve from L2 array, do NOT forward to DRAM.
//   - read miss : forward to DRAM, install word in chosen victim way
//                 (replace tag if conflict; clear word_valid).
//   - write hit : update hit way's data (byte-merge), forward to DRAM.
//   - write miss: pure pass-through.
//
// Replacement: tree-pseudo-LRU (3 bits per set, same encoding as L1
// dcache) — bit[2] selects LRU sub-group; bit[1] LRU in {way0,way1};
// bit[0] LRU in {way2,way3}. Updated on every access (hit + install).
//
// MSHR is intentionally absent: testbench DRAM is 1-cycle combinational.
// Coherence: invalidate broadcast still fires from memory_bus to L1
// dcaches directly. L2 does not yet drive its own invalidates.
pub module l2cache (
    clk: input clock,
    rst: input reset,
    // Upper interface (from memory_bus — the granted hart's request)
    i_addr : input  logic<64>,
    i_wdata: input  logic<64>,
    i_wstrb: input  logic<8> ,
    i_wen  : input  logic    ,
    i_ren  : input  logic    ,
    o_rdata: output logic<64>,
    // Lower interface (to SoC-level DRAM port)
    o_mem_addr : output logic<64>,
    o_mem_wdata: output logic<64>,
    o_mem_wstrb: output logic<8> ,
    o_mem_wen  : output logic    ,
    o_mem_ren  : output logic    ,
    i_mem_rdata: input  logic<64>,
) {
    // -----------------------------------------------------------------
    // Address decomposition
    // -----------------------------------------------------------------
    let req_tag    : logic<49> = i_addr[63:15];
    let req_index  : logic<9>  = i_addr[14:6];
    let req_offset : logic<3>  = i_addr[5:3];
    let data_idx   : logic<12> = {req_index, req_offset};

    // -----------------------------------------------------------------
    // Storage — 4 separate banks (one per way)
    // -----------------------------------------------------------------
    var tag_0 : logic<49> [512];
    var tag_1 : logic<49> [512];
    var tag_2 : logic<49> [512];
    var tag_3 : logic<49> [512];
    var lv_0  : logic     [512];
    var lv_1  : logic     [512];
    var lv_2  : logic     [512];
    var lv_3  : logic     [512];
    var wv_0  : logic<8>  [512];
    var wv_1  : logic<8>  [512];
    var wv_2  : logic<8>  [512];
    var wv_3  : logic<8>  [512];
    var data_0: logic<64> [4096];
    var data_1: logic<64> [4096];
    var data_2: logic<64> [4096];
    var data_3: logic<64> [4096];
    var plru  : logic<3>  [512]; // tree-PLRU per set

    // -----------------------------------------------------------------
    // Per-way lookup
    // -----------------------------------------------------------------
    let cur_tag_0 : logic<49> = tag_0 [req_index];
    let cur_tag_1 : logic<49> = tag_1 [req_index];
    let cur_tag_2 : logic<49> = tag_2 [req_index];
    let cur_tag_3 : logic<49> = tag_3 [req_index];
    let cur_lv_0  : logic     = lv_0  [req_index];
    let cur_lv_1  : logic     = lv_1  [req_index];
    let cur_lv_2  : logic     = lv_2  [req_index];
    let cur_lv_3  : logic     = lv_3  [req_index];
    let cur_wv_0  : logic<8>  = wv_0  [req_index];
    let cur_wv_1  : logic<8>  = wv_1  [req_index];
    let cur_wv_2  : logic<8>  = wv_2  [req_index];
    let cur_wv_3  : logic<8>  = wv_3  [req_index];
    let cur_data_0: logic<64> = data_0[data_idx];
    let cur_data_1: logic<64> = data_1[data_idx];
    let cur_data_2: logic<64> = data_2[data_idx];
    let cur_data_3: logic<64> = data_3[data_idx];

    // tag_match: line-level (line valid AND tag matches) — controls
    // write-hit and "same-line miss" (word missing on existing line).
    let tm_0: logic = cur_lv_0 && (cur_tag_0 == req_tag);
    let tm_1: logic = cur_lv_1 && (cur_tag_1 == req_tag);
    let tm_2: logic = cur_lv_2 && (cur_tag_2 == req_tag);
    let tm_3: logic = cur_lv_3 && (cur_tag_3 == req_tag);
    let any_tm: logic = tm_0 || tm_1 || tm_2 || tm_3;

    // word_hit: tag_match AND requested word present.
    let wh_0: logic = tm_0 && cur_wv_0[req_offset];
    let wh_1: logic = tm_1 && cur_wv_1[req_offset];
    let wh_2: logic = tm_2 && cur_wv_2[req_offset];
    let wh_3: logic = tm_3 && cur_wv_3[req_offset];
    let any_wh: logic = wh_0 || wh_1 || wh_2 || wh_3;

    // Hit way select (priority irrelevant — at most one way matches).
    let hit_way: logic<2> = if wh_0 ? 2'd0 : if wh_1 ? 2'd1 : if wh_2 ? 2'd2 : 2'd3;
    let tm_way : logic<2> = if tm_0 ? 2'd0 : if tm_1 ? 2'd1 : if tm_2 ? 2'd2 : 2'd3;

    let hit_data: logic<64> = if wh_0 ? cur_data_0
                            : if wh_1 ? cur_data_1
                            : if wh_2 ? cur_data_2 : cur_data_3;

    let read_hit  : logic = i_ren && any_wh;
    let read_miss : logic = i_ren && !any_wh;

    // -----------------------------------------------------------------
    // Victim selection — invalid first, otherwise PLRU.
    // -----------------------------------------------------------------
    let plru_bits  : logic<3> = plru[req_index];
    let has_inv    : logic    = !cur_lv_0 || !cur_lv_1 || !cur_lv_2 || !cur_lv_3;
    let invalid_way: logic<2> = if !cur_lv_0 ? 2'd0
                              : if !cur_lv_1 ? 2'd1
                              : if !cur_lv_2 ? 2'd2 : 2'd3;
    let plru_way   : logic<2> = {plru_bits[2], if !plru_bits[2] ? plru_bits[1] : plru_bits[0]};
    let victim_way : logic<2> = if has_inv ? invalid_way : plru_way;

    // For read_miss, the install way:
    //   - same-line miss (any_tm): use the existing same-line way (tm_way)
    //                              so we don't double-allocate the same line
    //   - conflict miss          : use victim_way (LRU or invalid)
    let install_way: logic<2> = if any_tm ? tm_way : victim_way;

    // -----------------------------------------------------------------
    // DRAM bus driving
    // -----------------------------------------------------------------
    assign o_mem_addr  = i_addr;
    assign o_mem_wdata = i_wdata;
    assign o_mem_wstrb = i_wstrb;
    assign o_mem_wen   = i_wen;
    assign o_mem_ren   = read_miss;

    assign o_rdata = if read_hit ? hit_data : i_mem_rdata;

    // -----------------------------------------------------------------
    // Byte-merge for write hit
    // -----------------------------------------------------------------
    let cur_data_hit: logic<64> = if tm_0 ? cur_data_0
                                : if tm_1 ? cur_data_1
                                : if tm_2 ? cur_data_2 : cur_data_3;
    let write_merged: logic<64> = {
        if i_wstrb[7] ? i_wdata[63:56] : cur_data_hit[63:56],
        if i_wstrb[6] ? i_wdata[55:48] : cur_data_hit[55:48],
        if i_wstrb[5] ? i_wdata[47:40] : cur_data_hit[47:40],
        if i_wstrb[4] ? i_wdata[39:32] : cur_data_hit[39:32],
        if i_wstrb[3] ? i_wdata[31:24] : cur_data_hit[31:24],
        if i_wstrb[2] ? i_wdata[23:16] : cur_data_hit[23:16],
        if i_wstrb[1] ? i_wdata[15:8]  : cur_data_hit[15:8] ,
        if i_wstrb[0] ? i_wdata[7:0]   : cur_data_hit[7:0]  ,
    };

    // PLRU update target — way that was accessed (hit or new install).
    let access_way: logic<2> = if read_hit ? hit_way
                             : install_way;
    let access_valid: logic = read_hit || read_miss || (i_wen && any_tm);

    // -----------------------------------------------------------------
    // PLRU bit update — point AWAY from accessed way.
    // -----------------------------------------------------------------
    let new_plru: logic<3> = {
        !access_way[1],
        if !access_way[1] ? !access_way[0] : plru_bits[1],
        if  access_way[1] ? !access_way[0] : plru_bits[0],
    };

    // One-hot mask for the requested word's valid bit.
    let one_hot_word: logic<8> = 8'd1 << req_offset;

    // -----------------------------------------------------------------
    // Cache update
    // -----------------------------------------------------------------
    always_ff (clk, rst) {
        if_reset {
            for i in 0..512 {
                lv_0[i] = 1'b0;
                lv_1[i] = 1'b0;
                lv_2[i] = 1'b0;
                lv_3[i] = 1'b0;
                wv_0[i] = 8'b0;
                wv_1[i] = 8'b0;
                wv_2[i] = 8'b0;
                wv_3[i] = 8'b0;
                plru[i] = 3'b0;
            }
        } else {
            // PLRU update on any access (hit or install).
            if access_valid {
                plru[req_index] = new_plru;
            }

            if read_miss {
                // Install in install_way: same-line OR-in valid bit, else
                // start fresh. Per-way conditional needed because each
                // way has its own bank.
                let new_wv: logic<8> = if any_tm
                                     ? if install_way == 2'd0 ? cur_wv_0 | one_hot_word
                                       : if install_way == 2'd1 ? cur_wv_1 | one_hot_word
                                       : if install_way == 2'd2 ? cur_wv_2 | one_hot_word
                                       :                          cur_wv_3 | one_hot_word
                                     : one_hot_word;
                if install_way == 2'd0 {
                    tag_0 [req_index] = req_tag;
                    lv_0  [req_index] = 1'b1;
                    wv_0  [req_index] = new_wv;
                    data_0[data_idx]  = i_mem_rdata;
                } else if install_way == 2'd1 {
                    tag_1 [req_index] = req_tag;
                    lv_1  [req_index] = 1'b1;
                    wv_1  [req_index] = new_wv;
                    data_1[data_idx]  = i_mem_rdata;
                } else if install_way == 2'd2 {
                    tag_2 [req_index] = req_tag;
                    lv_2  [req_index] = 1'b1;
                    wv_2  [req_index] = new_wv;
                    data_2[data_idx]  = i_mem_rdata;
                } else {
                    tag_3 [req_index] = req_tag;
                    lv_3  [req_index] = 1'b1;
                    wv_3  [req_index] = new_wv;
                    data_3[data_idx]  = i_mem_rdata;
                }
            } else if i_wen && any_tm {
                // Write hit on tm_way.
                if tm_way == 2'd0 {
                    data_0[data_idx] = write_merged;
                } else if tm_way == 2'd1 {
                    data_1[data_idx] = write_merged;
                } else if tm_way == 2'd2 {
                    data_2[data_idx] = write_merged;
                } else {
                    data_3[data_idx] = write_merged;
                }
            }
        }
    }
}
