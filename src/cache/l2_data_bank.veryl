// l2_data_bank: one way of the L2 data array, a 1R1W array of SETS rows of
// ROW_W bits with a registered read and one byte-enable write.
//
// Ports (timing contract):
//   i_ridx  : the row read this cycle
//   o_rdata : registered: the row i_ridx named in the previous cycle, as it
//             was before that cycle's write (read-old)
//   i_we, i_widx, i_wdata, i_wbe : one write, applied on this edge to the
//             bytes set in i_wbe
// Owns:
//   - no reset: rows are undefined until written and are never used before
//     the tag says so
// Rationale:
//   - the byte enables replace a read-modify-write of the row, so the array
//     keeps exactly one read port and one write port
//   - a read of a row written in the same cycle is never consumed: mem_ctrl
//     retries a lookup whose line was written in its read cycle
pub module l2_data_bank #(
    param SETS : u32 = 512      ,
    param ROW_W: u32 = 512      ,
    const BYTES: u32 = ROW_W / 8,
) (
    clk: input clock,

    i_ridx : input  logic<$clog2(SETS)>,
    o_rdata: output logic<ROW_W>       ,

    i_we   : input logic              ,
    i_widx : input logic<$clog2(SETS)>,
    i_wdata: input logic<ROW_W>       ,
    i_wbe  : input logic<BYTES>       ,
) {
    var mem_q: logic<ROW_W> [SETS];
    var rd_q : logic<ROW_W>       ;

    always_ff (clk) {
        if i_we {
            for b in 0..BYTES {
                if i_wbe[b] {
                    mem_q[i_widx][b * 8+:8] = i_wdata[b * 8+:8];
                }
            }
        }
    }

    always_ff (clk) {
        rd_q = mem_q[i_ridx];
    }

    assign o_rdata = rd_q;
}
