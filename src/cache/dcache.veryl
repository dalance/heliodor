// 4-way set-associative data cache
// Size = 2^INDEX_W sets × 4 ways × 64B lines (8 doublewords per line):
// INDEX_W=4 → 4KB, 6 → 16KB (default), 7 → 32KB.
//
// P9.2: WRITE-BACK with MESI line states for the store-drain path. Each
// line carries valid + excl (E/M: sole copy at the directory) + dirty (M):
//   - a drain (i_swen) that hits an EXCL way merges locally and acks with
//     NO bus transaction (the write-channel traffic collapse this phase is
//     about); the line goes M (dirty).
//   - a drain that misses (or hits a mere S copy) raises a READ-FOR-
//     OWNERSHIP fill (o_memr_rfo): the home invalidates the other sharers
//     and grants M-capability; the S copy's way doubles as the fill victim
//     (overwrite in place). The drain retries after the fill and merges.
//   - the i_wen path (AMO/LR-SC stores, misaligned, MMIO, slow stores)
//     stays WRITE-THROUGH (the home merges + precisely invalidates).
//   - every invalidation of a possibly-DIRTY line detours through the
//     single-entry WRITEBACK BUFFER (capture + invalidate, then drain the
//     full line over the write channel with o_memw_wb set): fill victims,
//     misaligned self-invalidates, PROBES (recalls from
//     the home: dirty → WB, clean → o_probe_ack), and the FLUSH sweep
//     (i_flush_req: FENCE.I / SFENCE.VMA / satp — write back + invalidate
//     every dirty line so the tb-direct ifetch/I-PTW see current DRAM).
//   - i_fill_excl (the home's grant, sampled at fill completion) decides
//     E/M-capable vs S.
// Non-blocking for loads: MSHR absorbs load miss, pipeline continues.
// Replacement: pseudo-LRU (3-bit tree per set)
//
// Address breakdown (64-bit byte address):
//   [63:INDEX_W+6] tag  |  [INDEX_W+5:6] index  |  [5:3] offset (8 dwords)  |  [2:0] byte
pub module dcache #(
    param INDEX_W: u32 = 6, // log2(#sets)
) (
    clk: input clock,
    rst: input reset,
    // CPU side
    i_addr : input  logic<64>,
    i_wdata: input  logic<64>,
    i_wen  : input  logic    ,
    // P9.3 in-cache AMO: the i_wen write is an AMO/SC commit write to a
    // cacheable line — merge it LOCALLY into the owned (E/M) way (line → M)
    // with no write-channel transaction. It fires only while the line is
    // owned here; if the line departed since the value capture the write
    // holds (o_stall) and the core's watch poisons → commit replay drops
    // the request. Ineligible writes (MMIO / tohost pages) tie 0 and keep
    // the write-through path.
    i_wen_excl: input logic,
    // Zacas amocas.q: a 128-bit (register-pair) in-cache AMO commit write. When
    // set (together with i_wen_excl), the exclusive merge writes the LO dword as
    // usual (i_wdata at i_addr) AND the HI dword (i_wdata_hi) into the adjacent
    // lane (i_addr+8). amocas.q is 16-byte aligned, so both dwords sit in one
    // owned (E/M) line. Single-dword AMOs tie this 0.
    i_wen_excl_q: input logic    ,
    i_wdata_hi  : input logic<64>,
    i_ren  : input  logic    ,
    // P9.5: this READ is an uncached MMIO load. Do a SINGLE exact-address bus
    // read (i_addr, byte offset preserved) — no line fill, no array/MESI
    // install — and surface i_mem_rdata as o_rdata on the granted cycle. The
    // core asserts it for loads to non-DRAM (MMIO) physical addresses; the
    // device read-enable (o_memr_ren) then pulses only on the grant so a
    // read-with-side-effect (e.g. a PLIC claim) fires exactly once.
    i_uncached: input logic,
    i_wstrb: input  logic<8> ,
    // M8.B (B.3): hi-side strobe for a misaligned STORE that spans into the
    // next dword. Nonzero ⇒ the store also writes (i_addr&~7)+8 via the core's
    // o_dmem_wstrb_hi bypass; the dcache cannot hold the partial result, so it
    // INVALIDATES both touched lines (lo + next) instead of merging and lets a
    // later load refill the merged bytes from memory. Single-dword callers tie 0.
    i_wstrb_hi: input logic<8>,
    // M8.B (B.3): set when a LOAD's data spans into the next dword (byte_off +
    // size > 8). When that next dword falls in a DIFFERENT line, the dcache
    // fills the next line too (a second sequential fill) so o_rdata_next is
    // valid before o_stall drops. Same-line spans need no extra fill. Tie 0.
    i_load_next: input logic,
    // P9.3 in-cache AMO: this read is an AMO/LR value-capture (read-for-RMW)
    // and requires OWNERSHIP. An E/M hit serves locally (an owned copy is the
    // only copy — coherent by construction); an S hit or a miss raises an RFO
    // fill (in-place upgrade for the S case) and serves after DONE. The M9.4
    // force-miss + bus-lock protocol is gone: RMW atomicity = ownership held
    // from this read to the commit write (i_wen_excl), backstopped by the
    // core's watch/replay when the line departs in between.
    i_amo_read: input logic,
    // Phase 8 S5.2: 2nd hit-only READ port (dual-issue loads, bare mode). A
    // purely combinational, additive read of the SAME tag/data arrays — no
    // state, no bus, o_stall unchanged. The core drives i_addr2 with a slot-1
    // LOAD's effective address and completes that load on pipe-1 only when
    // o_hit2. S10.2: o_hit2 is FILL-safe (hit-under-miss) — the way being
    // filled is excluded per-set (fill_busy2 below), so the core no longer
    // gates on !o_stall. MISS / cross-line-not-cached → o_hit2=0 and the load
    // falls back to pipe-0. i_ren2=0 ties the port off (o_hit2=0, no
    // behavioral effect). i_load_next2 = the 2nd load spans into the next
    // dword (so o_hit2 also requires that dword present).
    i_addr2     : input  logic<64>,
    i_ren2      : input  logic    ,
    i_load_next2: input  logic    ,
    // Phase C delta-5 (cp_dcache_sync_read_plan §11.2): Stage-A demand-load
    // tag-read port. Under DCACHE_SYNC_READ the core presents the load's PA one
    // cycle EARLY (at lsr_capture, i_addr_r=dmu_dmem_addr) so the tag-compare /
    // hit decision is REGISTERED into Stage-B (lsr_drive) — the demand hit then
    // delivers off flops (synchronous SRAM read) with NO extra load-use cycle.
    // Only the demand HIT folds to Stage-A; the miss/fill selection stays on the
    // Stage-B port (deltas 1-2). DCACHE_SYNC_READ only — tie i_ren_r=0 to disable
    // (the Stage-A read then feeds only reset-held regs → DCE, byte-identical).
    i_addr_r    : input  logic<64>,
    i_ren_r     : input  logic    ,
    // Phase C delta-5: the Stage-B DELIVERY strobe for the folded plain load (=
    // lsr_drive). The registered dhit delivers ONLY on the cycle the core is
    // actually consuming the folded load's Stage-B (i.e. lsr_drive), NOT merely
    // whenever a Stage-A read fired last cycle — a stalled lsr_drive would else
    // assert o_hit_safe/o_rdata a cycle early on a non-consuming cycle (i_ren=0),
    // desyncing the core's load completion. Tie 0 to disable.
    i_ren_folded: input  logic    ,
    o_rdata2     : output logic<64>,
    o_rdata2_next: output logic<64>,
    o_hit2       : output logic    ,
    // Phase 8 S6: 2nd WRITE port (store-drain). A PHYSICALLY SEPARATE address
    // (i_saddr) so a store write-through coexists with a load read on
    // i_addr/i_ren in the same cycle (the data arrays are comb-read +
    // registered-write). The core routes ONLY bare-mode aligned plain stores
    // here; AMO/Sv39/misaligned stay on the combined i_wen path. The store
    // drain shares the single bus o_mem_*: a load-miss FILL/read wins, the
    // store drain waits (o_sdrain_ack=0, store held at the ROB head). Tie
    // i_swen=0 to disable the port entirely (no behavioral effect).
    // S25 write-combining: the drain delivers a full 64B LINE per ack —
    // i_saddr is line-aligned, i_swdata/i_swstrb carry 8 dword lanes (lanes
    // with wstrb==0 are dont-care). One bus transaction per line.
    i_saddr     : input  logic<64>,
    i_swen      : input  logic    ,
    // Phase 8 S20.2: drain URGENCY. When high (the core's store buffer is
    // near full and about to block retire), the pending drain takes the next
    // slot BEFORE a new demand-miss fill may start: the fill start is held
    // and this hart's miss read is suppressed, which also satisfies the
    // SoC's wgrant_ok (no own read needing DRAM) so the write goes through.
    i_sdrain_urgent: input logic,
    i_swdata    : input  logic<64> [8],
    i_swstrb    : input  logic<8>  [8],
    o_sdrain_ack: output logic    ,
    o_rdata: output logic<64>,
    // M8.B: combinational read of the NEXT dword (at (i_addr&~7)+8), for v4
    // misaligned loads that span two dwords (mirrors the old i_dmem_rdata_next).
    // o_rdata_next_miss flags that the next dword's line is not cached so the
    // consumer can stall and let a fill bring it in. Purely additive — the
    // dcache state machine is unchanged, so single-dword callers tie these off.
    o_rdata_next     : output logic<64>,
    o_rdata_next_miss: output logic    ,
    o_stall: output logic    ,
    // Phase 5 SMP fix: rdata is valid for THIS hart's request only when
    // cache hit or just-filled (DONE). Low during MISS/FILL when o_rdata
    // mirrors the shared bus value (potentially another hart's rdata
    // when not yet granted). Consumers (e.g. memory.veryl amo_saved_rdata)
    // gate on this to avoid latching shared-bus rdata destined for a
    // different hart while waiting for this hart's cache fill.
    o_data_valid: output logic,
    // Non-blocking miss interface (MSHR support)
    o_miss_valid   : output logic    , // 1-cycle pulse on fill START (MSHR capture trigger)
    o_fill_complete: output logic    , // DONE state, fill not aborted (fill data readable)
    o_fill_rdata   : output logic<64>, // filled doubleword at original miss offset
    o_fill_aborted : output logic    , // DONE state, fill ABORTED by i_inv (data may be stale)
    // S14.2: the missing dword (fill_offset) is already in the data array —
    // with critical-word-first it is transfer #0, so this rises ~7 cycles
    // before o_fill_complete. Held until DONE; drops if the fill aborts
    // (the consumer must then fall back to the abort path). o_fill_rdata is
    // valid whenever this is high.
    o_fill_data_ready: output logic,
    o_hit_safe     : output logic    , // S10.4: fill-safe pipe-0 hit on i_addr (see assign)
    // Memory side — S23: split READ channel (fills / miss reads) and WRITE
    // channel (i_wen write-through + store drain), each with its own
    // request/grant pair, so a store drain proceeds DURING a fill burst
    // (the old single port serialized them — the S20 residual bottleneck).
    o_memr_addr : output logic<64>,
    o_memr_ren  : output logic    ,
    // P9.2: the current read request/transaction is a READ-FOR-OWNERSHIP
    // (store fill); the home invalidates the other sharers and grants M.
    o_memr_rfo  : output logic    ,
    // P9.2: grant state from the home (1 = E/M-capable, 0 = S), sampled at
    // fill completion. Single-hart harnesses tie 1.
    i_fill_excl : input  logic    ,
    i_mem_rdata : input  logic<64>,
    // S25: the write channel carries a LINE (8 dword lanes + per-lane byte
    // strobes). An i_wen write (slow store / AMO / MMIO) occupies the single
    // lane at i_addr[5:3]; o_memw_addr keeps i_addr's byte offset for the
    // SoC's MMIO decode. A drain puts all of i_swdata/i_swstrb on the lanes.
    o_memw_addr : output logic<64>    ,
    o_memw_wdata: output logic<64> [8],
    o_memw_wstrb: output logic<8>  [8],
    o_memw_wen  : output logic        ,
    // P9.2: the write-channel transaction is a WRITEBACK (full dirty line
    // from the writeback buffer; the home merges it and clears ownership —
    // no invalidates). The buffer outranks a same-cycle i_wen write.
    o_memw_wb   : output logic        ,
    // P9.2: PROBE port (recall from the home): invalidate the line; a dirty
    // copy is written back (the WB completes the recall), a clean/absent
    // one answers o_probe_ack. Held by the engine until answered.
    i_probe_v   : input  logic    ,
    i_probe_addr: input  logic<64>,
    // The recall was requested by THIS hart's own transaction (stale
    // self-owner entry at the home): answer it without aborting the
    // in-flight fill — that fill is the recall's own requester.
    i_probe_self: input  logic    ,
    o_probe_ack : output logic    ,
    // P9.2: FLUSH sweep (level request → level done): write back +
    // invalidate every dirty line. The core raises it for FENCE.I /
    // SFENCE.VMA / satp writes at the commit head (store buffer already
    // empty) and gates the retire ack on o_flush_done.
    i_flush_req : input  logic,
    o_flush_done: output logic,
    // Invalidate port (memory_bus → dcache, multi-hart coherence).
    // Asserted by memory_bus when another core writes a line. The dcache
    // invalidates any matching way at i_inv_addr's index/tag. If a fill is
    // in progress for the same line, fill_aborted is latched so the fill
    // completes without setting valid (line stays Invalid).
    i_inv_valid: input logic    ,
    i_inv_addr : input logic<64>,
    // P9.2: second invalidate port — under precise invalidation a granted
    // misaligned store invalidates its lo and hi lines in the SAME cycle
    // (two different lines, one address port each). Applied identically to
    // port 1, including the mid-fill abort latch and the completion-cycle
    // fold. Tie i_inv2_valid=0 where unused.
    i_inv2_valid: input logic    ,
    i_inv2_addr : input logic<64>,
    // P9.2: combinational line-presence checks (core: LR/SC reservation and
    // SC watch). Present = cached in a way that is not the mid-fill victim,
    // or being filled un-aborted. Under precise invalidation a remote write
    // to a line NOT cached here produces no invalidate pulse, so the core
    // clears its reservation the moment the line leaves this cache —
    // rsv_valid ⇒ line present ⇒ the directory lists this hart ⇒ every
    // remote write to it is observed.
    i_chk_addr    : input  logic<64>,
    o_chk_present : output logic    ,
    i_chk2_addr   : input  logic<64>,
    o_chk2_present: output logic    ,
    // P9.3: third presence port — the core's AMO watch (RMW window).
    i_chk3_addr   : input  logic<64>,
    o_chk3_present: output logic    ,
    // P9.2: local line-DEPARTURE events (this cycle a valid line is being
    // dropped: fill victim, store-miss victim, misaligned self-invalidate,
    // AMO force-miss). The core feeds them to the ROB's CoRR poison scan —
    // under precise invalidation a remote write to a line that already left
    // this cache produces no invalidate pulse, so executed-uncommitted load
    // records on a departing line must be poisoned at departure time. Two
    // ports: the sources of each are mutually exclusive per cycle.
    o_evict1_v   : output logic    ,
    o_evict1_addr: output logic<64>,
    o_evict2_v   : output logic    ,
    o_evict2_addr: output logic<64>,
    // Bus arbitration — one request/grant pair per channel. State advances
    // only when the matching channel is granted; non-granted cycles stall.
    o_memr_req  : output logic,
    i_memr_grant: input  logic,
    o_memw_req  : output logic,
    i_memw_grant: input  logic,
) {
    // Address decomposition
    // Derived geometry
    const SETS : u32 = 1 << INDEX_W;
    const TAG_W: u32 = 58 - INDEX_W;

    let tag     : logic<TAG_W> = i_addr[63:INDEX_W + 6];
    let index   : logic<INDEX_W> = i_addr[INDEX_W + 5:6];
    let offset  : logic<3>  = i_addr[5:3];

    // Cache storage: 4 ways
    var valid_0: logic         [SETS];
    var valid_1: logic         [SETS];
    var valid_2: logic         [SETS];
    var valid_3: logic         [SETS];
    var tags_0 : logic<TAG_W>  [SETS];
    var tags_1 : logic<TAG_W>  [SETS];
    var tags_2 : logic<TAG_W>  [SETS];
    var tags_3 : logic<TAG_W>  [SETS];
    // Line-width data arrays: one 512-bit word per set (8 × 64-bit dwords),
    // so each way reads/writes a whole line through a single port — the shape
    // a line-wide SRAM macro + external dword merge logic infers as RAM.
    var data_0 : logic<512>    [SETS];
    var data_1 : logic<512>    [SETS];
    var data_2 : logic<512>    [SETS];
    var data_3 : logic<512>    [SETS];
    // P9.2 MESI state alongside valid: excl (E/M — sole copy, may be
    // written locally) and dirty (M — must be written back on departure).
    // Meaningful only while the way is valid; fills rewrite both.
    var excl_0 : logic [SETS];
    var excl_1 : logic [SETS];
    var excl_2 : logic [SETS];
    var excl_3 : logic [SETS];
    var dirty_0: logic [SETS];
    var dirty_1: logic [SETS];
    var dirty_2: logic [SETS];
    var dirty_3: logic [SETS];

    // P9.2: single-entry WRITEBACK BUFFER (capture-and-invalidate of a dirty
    // line; drained over the write channel with o_memw_wb). At most one
    // capture per cycle (arbitrated where the captures fire).
    var wb_v   : logic        ;
    var wb_line: logic<58>    ;
    var wb_data: logic<64> [8];
    // 14.13 R3 cap → 1R1W: the +1-latch writeback-capture state (assigned in the
    // cap-latch always_ff after rd1_data; declared here so the early wb_fire drain-ready
    // gate can read wb_folded_q / wb_data_rdy_q). All reset-only → DCE at DCACHE_CAP_1R=0.
    var cap_way_q     : logic<2>     ; // way of the folded cap capture (for rd1_cap_line)
    var cap_pending_q : logic        ; // a +1-latch is due this cycle (set at cap_go_latch)
    var wb_folded_q   : logic        ; // the current wb_v came from a FOLDED cap source
    var wb_data_rdy_q : logic        ; // wb_data_lat holds the latched line (drain may fire)
    var dhit_cap_pre_q: logic        ; // a folded demand HIT was preempted by the cap present
    var wb_data_lat   : logic<64> [8]; // the +1-latched writeback data (folded source)

    // Pseudo-LRU tree: 3 bits per set
    // bit[2]: root → 0=left(way 0,1), 1=right(way 2,3)
    // bit[1]: left child → 0=way 0, 1=way 1
    // bit[0]: right child → 0=way 2, 1=way 3
    var plru: logic<3> [SETS];

    // Line-width data helpers: select / replace one 64-bit dword in a 512-bit
    // cache line, and byte-enable-merge a store into a dword. Whole-line writes
    // are read-modify-write (the SRAM has no sub-word write port); dynamic
    // part-select is avoided in favor of an 8-way constant mux.
    function rd_dword (
        line: input logic<512>,
        off : input logic<3>  ,
    ) -> logic<64> {
        return case off {
            3'd0   : line[63:0],
            3'd1   : line[127:64],
            3'd2   : line[191:128],
            3'd3   : line[255:192],
            3'd4   : line[319:256],
            3'd5   : line[383:320],
            3'd6   : line[447:384],
            3'd7   : line[511:448],
            default: line[63:0],
        };
    }
    function wr_dword (
        line: input logic<512>,
        off : input logic<3>  ,
        dw  : input logic<64> ,
    ) -> logic<512> {
        return {
            if off == 3'd7 ? dw : line[511:448],
            if off == 3'd6 ? dw : line[447:384],
            if off == 3'd5 ? dw : line[383:320],
            if off == 3'd4 ? dw : line[319:256],
            if off == 3'd3 ? dw : line[255:192],
            if off == 3'd2 ? dw : line[191:128],
            if off == 3'd1 ? dw : line[127:64],
            if off == 3'd0 ? dw : line[63:0],
        };
    }
    function merge_dword (
        old: input logic<64>,
        be : input logic<8> ,
        nw : input logic<64>,
    ) -> logic<64> {
        return {
            if be[7] ? nw[63:56] : old[63:56],
            if be[6] ? nw[55:48] : old[55:48],
            if be[5] ? nw[47:40] : old[47:40],
            if be[4] ? nw[39:32] : old[39:32],
            if be[3] ? nw[31:24] : old[31:24],
            if be[2] ? nw[23:16] : old[23:16],
            if be[1] ? nw[15:8] : old[15:8],
            if be[0] ? nw[7:0] : old[7:0],
        };
    }
    // Expand an 8-bit byte-enable to a 64-bit bit-mask (each byte-enable bit
    // replicated across its 8 data bits) — the byte-write-enable form of a
    // store's per-byte strobe (DCACHE_DATA_1RW, mirrors L2's w_wmask).
    function be_expand (
        be: input logic<8>,
    ) -> logic<64> {
        return {
            be[7] repeat 8, be[6] repeat 8, be[5] repeat 8, be[4] repeat 8,
            be[3] repeat 8, be[2] repeat 8, be[1] repeat 8, be[0] repeat 8
        };
    }

    // Cache lookup: per-way hit. P9.5: an uncached MMIO load never hits (it must
    // do a fresh single bus read and not alias a stale cached line), so suppress
    // every way's hit for it — this also forces o_rdata to the i_mem_rdata path
    // and keeps it off lo_miss / PLRU / hit_safe below.
    let hit_0    : logic = valid_0[index] && tags_0[index] == tag && !i_uncached;
    let hit_1    : logic = valid_1[index] && tags_1[index] == tag && !i_uncached;
    let hit_2    : logic = valid_2[index] && tags_2[index] == tag && !i_uncached;
    let hit_3    : logic = valid_3[index] && tags_3[index] == tag && !i_uncached;
    let cache_hit: logic = hit_0 || hit_1 || hit_2 || hit_3;

    // Same-cycle remote invalidate stall (multi-hart coherence).
    // i_inv_valid pulses combinationally the cycle a remote hart writes a
    // line at (inv_tag, inv_index). Without this stall, our load in the same
    // cycle would still hit the soon-to-be-invalid line and read stale data
    // (the registered invalidate below only takes effect on the next clock
    // edge). Detect the same-cycle race against an active access and add
    // it to o_stall so the pipeline retries next cycle, by which time the
    // line has been invalidated and the retry naturally misses → fills
    // fresh data from memory_bus.
    //
    // Routed through o_stall (not cache_hit) to avoid a structural comb
    // loop: gating cache_hit would feed o_mem_ren / o_mem_req → bus
    // arbiter → other-hart grant → other-hart o_dmem_wen → bus inv →
    // self.i_inv_valid, which the simulator flags as a cycle even when
    // the grants are mutually exclusive. o_stall only feeds pipeline
    // sequential stages, breaking the cycle.
    let inv_hits_active: logic = i_inv_valid && (i_wen || i_ren) && cache_hit && (index == i_inv_addr[INDEX_W + 5:6])
        && (tag == i_inv_addr[63:INDEX_W + 6]);
    // P9.2: same race on the second invalidate port.
    let inv2_hits_active: logic = i_inv2_valid && (i_wen || i_ren) && cache_hit && (index == i_inv2_addr[INDEX_W + 5:6])
        && (tag == i_inv2_addr[63:INDEX_W + 6]);

    // Hit way select
    let hit_way: logic<2> = if hit_0 ? 2'd0 : if hit_1 ? 2'd1 : if hit_2 ? 2'd2 : 2'd3;

    // Read data from hit way (R1 = data_X[index]). Defined below as a const-guarded
    // statement block (after DCACHE_R1_DCE) so the reads DCE at =1; see rdata_* there.

    // State machine for line fill
    enum State: logic<2> {
        IDLE = 2'd0,
        FILL = 2'd1,
        DONE = 2'd2,
    }

    var state        : State    ;
    var fill_count   : logic<3> ; // 0..7, which TRANSFER of the burst (not the dword)
    var fill_index   : logic<INDEX_W>; // index being filled
    var fill_tag     : logic<TAG_W>; // tag being filled
    var fill_way     : logic<2> ; // which way to fill
    var fill_offset  : logic<3> ; // original miss dword offset (for MSHR re-read)
    var fill_aborted : logic    ; // remote invalidate hit the line being filled
    var fill_rfo     : logic    ; // P9.2: this fill is a read-for-ownership (store)
    // Phase 8 S14.2: critical-word-first. The fill bursts the 8 dwords
    // starting at the MISSING dword (fill_offset) and wraps, so the demand
    // word is transfer #0 — the owner's early writeback (o_fill_data_ready)
    // and any streaming consumer get it ~7 cycles sooner. The L2 is per-word
    // (lazy word-valid fills, no order assumption) and the bus passes
    // addresses through, so the wrapped order is safe end-to-end.
    let s14_cwf_en   : logic    = 1'b1;
    let fill_woff    : logic<3> = if s14_cwf_en ? fill_offset + fill_count : fill_count;

    // P9.3 in-cache AMO: an AMO/LR read serves from an OWNED (E/M) hit; an S
    // hit must first be upgraded by an RFO fill of the same line (in place —
    // the S way doubles as the fill victim via f_match below). amo_upg folds
    // into `miss`, so the fill selection and o_stall handle it like any miss.
    let hit_excl: logic = (hit_0 && excl_0[index]) || (hit_1 && excl_1[index])
        || (hit_2 && excl_2[index]) || (hit_3 && excl_3[index]);
    let amo_upg: logic = i_amo_read && i_ren && cache_hit && !hit_excl && (state == State::IDLE);

    // Invalidate decode (combinational from request port)
    let inv_tag  : logic<TAG_W> = i_inv_addr[63:INDEX_W + 6];
    let inv_index: logic<INDEX_W> = i_inv_addr[INDEX_W + 5:6];
    let inv2_tag  : logic<TAG_W> = i_inv2_addr[63:INDEX_W + 6];
    let inv2_index: logic<INDEX_W> = i_inv2_addr[INDEX_W + 5:6];
    // Any-port invalidate pulse on the line being filled (mid-fill abort).
    let inv_fill_hit: logic = (i_inv_valid && state == State::FILL && fill_index == inv_index && fill_tag == inv_tag)
        || (i_inv2_valid && state == State::FILL && fill_index == inv2_index && fill_tag == inv2_tag);

    // CPU request present
    let cpu_req: logic = i_wen || i_ren;

    // M8.B (B.3): next-dword line decode (also used by o_rdata_next below).
    // The next dword is at (i_addr & ~7) + 8: same line when offset != 7,
    // otherwise the following line (different index/tag).
    let next_addr     : logic<64> = {i_addr[63:3], 3'b000} + 64'd8;
    let next_index    : logic<INDEX_W> = next_addr[INDEX_W + 5:6];
    let next_offset   : logic<3>  = next_addr[5:3];
    let next_tag      : logic<TAG_W> = next_addr[63:INDEX_W + 6];
    let next_same_line: logic     = offset != 3'd7;
    let next_hit_0    : logic     = valid_0[next_index] && tags_0[next_index] == next_tag;
    let next_hit_1    : logic     = valid_1[next_index] && tags_1[next_index] == next_tag;
    let next_hit_2    : logic     = valid_2[next_index] && tags_2[next_index] == next_tag;
    let next_hit_3    : logic     = valid_3[next_index] && tags_3[next_index] == next_tag;
    let next_line_hit : logic     = next_hit_0 || next_hit_1 || next_hit_2 || next_hit_3;
    // Hit way of the NEXT line (cross-line misaligned hi dword) — the phase-1 read-port
    // way select for the xline serialize (14.3-f). Only one way can hold {next_tag,
    // next_index}, so this names the registered hi line's way in rd1_nf_line.
    let next_hit_way  : logic<2>  = if next_hit_0 ? 2'd0 : if next_hit_1 ? 2'd1 : if next_hit_2 ? 2'd2 : 2'd3;

    let filling: logic = state == State::FILL;

    // ------------------------------------------------------------------
    // P9.3: bounded ownership PIN (forward progress for the in-cache RMW
    // and the LR→SC window). The pin self-arms the cycle an AMO/LR read
    // gets its data — an RFO fill completing (DONE) or an E/M hit on a NEW
    // line (a spin re-reading the same line must NOT refresh the pin, or a
    // remote recall starves past the bound). While armed and the saturating
    // counter is under 64, a PROBE of the pinned line is DEFERRED (not
    // answered; the recall engine waits). The bound keeps the defer from
    // closing a deadlock cycle through the single engine; past it the probe
    // proceeds and the core's watch/replay keeps correctness. The pin
    // releases early when the RMW's commit write lands (wenl_fires) so the
    // waiting hart gets the line immediately.
    // (pin_arm_*/wenl_fires/hit_excl are defined below; declared-by-use is
    // fine for the FF, the lets live near their inputs.)
    // ------------------------------------------------------------------
    var pin_cnt_q : logic<7> ;
    var pin_line_q: logic<58>;
    let probe_pinned: logic = !pin_cnt_q[6] && (i_probe_addr[63:6] == pin_line_q) && !i_probe_self;

    // ------------------------------------------------------------------
    // Store-drain decode (P9.2: moved up — the store-RFO fill shares the
    // fill path below). Combinational tag-match on i_saddr, independent of
    // the i_addr read port.
    // ------------------------------------------------------------------
    let stag       : logic<TAG_W>   = i_saddr[63:INDEX_W + 6];
    let sindex     : logic<INDEX_W> = i_saddr[INDEX_W + 5:6];
    // S23: exclude the way being filled (its tag is the dying line's).
    let fill_busy_s: logic = filling && fill_index == sindex;
    let shit_0     : logic = valid_0[sindex] && tags_0[sindex] == stag && !(fill_busy_s && fill_way == 2'd0);
    let shit_1     : logic = valid_1[sindex] && tags_1[sindex] == stag && !(fill_busy_s && fill_way == 2'd1);
    let shit_2     : logic = valid_2[sindex] && tags_2[sindex] == stag && !(fill_busy_s && fill_way == 2'd2);
    let shit_3     : logic = valid_3[sindex] && tags_3[sindex] == stag && !(fill_busy_s && fill_way == 2'd3);
    let scache_hit : logic = shit_0 || shit_1 || shit_2 || shit_3;
    // P9.2: the drain may merge locally (no bus) only into an EXCL (E/M) way.
    let s_hit_excl: logic = (shit_0 && excl_0[sindex]) || (shit_1 && excl_1[sindex])
        || (shit_2 && excl_2[sindex]) || (shit_3 && excl_3[sindex]);

    // Miss handling. A normal read miss fills the i_addr line (lo_miss). A
    // misaligned LOAD whose next dword crosses into a DIFFERENT line needs that
    // next line filled too: once the lo line is cached (cache_hit), hi_miss
    // triggers a SECOND sequential fill of the next line. Both keep o_stall
    // high until the data is present.
    let lo_miss: logic = i_ren && !cache_hit && !i_uncached && state == State::IDLE;
    let hi_miss: logic = i_ren && i_load_next && !next_same_line && cache_hit && !next_line_hit && state == State::IDLE;
    // P9.3: an AMO read's S-hit upgrade is a miss for fill/stall purposes.
    let miss_raw: logic = lo_miss || hi_miss || amo_upg;
    // P9.5: an uncached MMIO read is "active" while its single bus read is
    // outstanding. It stays in IDLE (never enters FILL — excluded from lo_miss
    // above), so nothing is fetched line-wise or installed. o_memr_req holds the
    // request; o_memr_ren pulses only on the grant (below).
    let uncached_active: logic = i_uncached && i_ren && state == State::IDLE;

    // P9.2: a FULL-LINE drain entry (all 64 bytes strobed — memset/memcpy
    // write-combining) keeps the posted WRITE-THROUGH path: an RFO would
    // serialize a ~12-40-cycle fill per line for data the store overwrites
    // entirely (observed as a >5x Linux-boot slowdown). The home invalidates
    // the other sharers as for any write; our own (S) copy is invalidated
    // at the fire below.
    var s_full_line: logic;
    always_comb {
        s_full_line = 1'b1;
        for l in 0..8 {
            if i_swstrb[l] != 8'hff {
                s_full_line = 1'b0;
            }
        }
    }

    // P9.2: store-RFO fill want — a pending PARTIAL-line drain that cannot
    // merge (miss, or an S copy without write permission) raises a
    // read-for-ownership fill of the drain line. Arbitration keeps the
    // S20.2 shape: a load miss goes first unless the store buffer is
    // near-full (urgent).
    let srfo_want: logic = i_swen && (state == State::IDLE) && !i_wen && !s_hit_excl && !s_full_line;
    let srfo_sel_raw: logic = srfo_want && (!miss_raw || i_sdrain_urgent);
    let load_sel_raw: logic = miss_raw && !(srfo_want && i_sdrain_urgent);

    // Fill target: the drain line for a store-RFO, else the lo line, or the
    // next line for a hi_miss (lo already cached, so lo_miss is 0).
    // P9.3: an AMO/LR read's fill (miss or S upgrade) is an RFO too.
    let f_rfo_raw   : logic          = srfo_sel_raw || (load_sel_raw && i_amo_read);
    let fill_is_hi  : logic          = hi_miss && !lo_miss;
    let f_index_raw : logic<INDEX_W> = if srfo_sel_raw ? sindex : if fill_is_hi ? next_index : index;
    let f_tag_raw   : logic<TAG_W>   = if srfo_sel_raw ? stag : if fill_is_hi ? next_tag : tag;
    let f_offset_raw: logic<3>       = if srfo_sel_raw ? 3'd0 : if fill_is_hi ? next_offset : offset;

    // PLRU victim selection for the fill-target index. P9.2: a way already
    // holding the fill line (an S copy being upgraded by a store-RFO) is
    // overwritten IN PLACE — never double-allocate.
    let fm_0: logic = valid_0[f_index_raw] && tags_0[f_index_raw] == f_tag_raw;
    let fm_1: logic = valid_1[f_index_raw] && tags_1[f_index_raw] == f_tag_raw;
    let fm_2: logic = valid_2[f_index_raw] && tags_2[f_index_raw] == f_tag_raw;
    let fm_3: logic = valid_3[f_index_raw] && tags_3[f_index_raw] == f_tag_raw;
    let f_match    : logic    = fm_0 || fm_1 || fm_2 || fm_3;
    let f_match_way: logic<2> = if fm_0 ? 2'd0 : if fm_1 ? 2'd1 : if fm_2 ? 2'd2 : 2'd3;
    let plru_bits  : logic<3> = plru[f_index_raw];
    let has_invalid: logic    = !valid_0[f_index_raw] || !valid_1[f_index_raw] || !valid_2[f_index_raw] || !valid_3[f_index_raw];
    let invalid_way: logic<2> = if !valid_0[f_index_raw] ?
        2'd0
    : if !valid_1[f_index_raw] ?
        2'd1
    : if !valid_2[f_index_raw] ?
        2'd2
    :
        2'd3
    ;
    let plru_way      : logic<2> = {plru_bits[2], if !plru_bits[2] ? plru_bits[1] : plru_bits[0]};
    let victim_way_raw: logic<2> = if f_match ? f_match_way : if has_invalid ? invalid_way : plru_way;

    // Victim line state + the WB-block gate are computed at Stage-D from the
    // REGISTERED selection (f_index / victim_way / f_tag) — see below, after
    // the DCACHE_SYNC_READ scaffold (§11.1 C1/C2 of cp_dcache_sync_read_plan).

    // ── Phase C: DCACHE_SYNC_READ scaffold — synchronous-read Stage-R ──
    // Register ONLY the fill SELECTION (the deep tag→miss→srfo→victim-argmin
    // cone, ~3.1 ns, cp_vrf_cut_plan.md §6.1) so o_memr_req / o_memr_addr /
    // o_stall become a SHALLOW function of flops. The victim STATE
    // (valid/dirty/tag/data) and the WB-block gate are RE-READ at Stage-D from
    // the registered selection (below) — a shallow array[flop]→mux, off the
    // cone — so the writeback carries CURRENT bytes even if a drain/inv/probe
    // mutates the victim line in the Stage-R→Stage-D window (§11.1 C1/C2 of
    // cp_dcache_sync_read_plan.md; a registered STALE vic_dirty_q would skip
    // the writeback of a line dirtied in the window = a litmus MP class bug).
    // Pattern = VALU_PIPE: DEAD at 0 — *_eff == *_raw (byte-identical), every
    // *_q reset-only via the `if DCACHE_SYNC_READ` write-fold → DCE'd,
    // synth-CP-neutral. At 1 the decision is a cycle late; the load-use-neutral
    // fold (Stage-A tag port, §11.2) + the C3 R→D hit re-validation (§11.1 C3)
    // are the remaining functional work, so =1 is still partial.
    const DCACHE_SYNC_READ: bit = 1;
    // goal-b SRAM: data-array write-port collapse to a true 1-write byte-write-
    // enable SRAM. All four data writers (plain store-merge, AMO/SC commit, fill
    // beat, store drain) are MUTUALLY EXCLUSIVE per cycle (store-merge/AMO/drain
    // are state==IDLE + i_wen-exclusive; fill is state==FILL) and each targets a
    // one-hot way, so per bank at most one writer fires. They collapse into ONE
    // muxed write per bank: data_k[idx] = (data_k[idx] & ~msk) | (new & msk),
    // where the retention read data_k[idx] folds into the SRAM byte-enable (the
    // veryl byte-write-enable inference, same as L2 P3.b-B). This drops the four
    // write ports to one AND folds the store-drain's old-line read (the only
    // read at sindex) — data 8R4W → 7R1W. Byte-identical: the masked-write value
    // equals wr_dword(old, off, merge_dword(...)) for every writer (see below).
    // DEAD at 0 (the muxed block DCEs, the original four writes stand); at 1 the
    // original writes DCE and the array is 7R1W. Cycle-identical (write values +
    // timing unchanged, only the port shape changes).
    const DCACHE_DATA_1RW: bit = 1;
    // goal-b SRAM S0 (cp_dcache_sync_read_plan §13): read-port arbitration — the
    // true 1R1W read side. The write side is done (7R1W above); this collapses the
    // seven data READ-index nets (demand index_r/dhit_index_d, cap_index,
    // next_index, fill_index, slot-1 index2/next_index2) onto ONE synchronous read
    // port. Unlike the write-collapse the read flip is NOT byte-identical — it adds
    // a stage/stalls (a real SRAM read is synchronous: present one index per cycle,
    // data registered out next cycle). This DEAD scaffold (S0) reserves the const +
    // the arbiter (priority mux, demand > cap > next > fill) + the single registered
    // read output (rd1_data_*), and routes the demand registered read (dhit_rdata_d,
    // R2) through it via the o_rdata const-mux. DEAD at 0: the mux folds to
    // dhit_rdata_d, rd1_data_* is reset-only → DCE (its data_X[rd1_index] read has
    // no consumer), so the array stays 7R1W = byte-identical. The non-folded /
    // next-dword / slot-1 re-routing + the demand-yield stalls are the staged flip
    // (§13.4 S1-S4). See §13 for the full design.
    //   S1 (5b4a72b): the demand read (dhit_rdata_d) is a const-guarded statement
    //     block → at 1 it DCEs and the demand IS rd1_index (8R1W → 7R1W).
    //   S2 (2dde798): R5 fill-DONE (o_fill_rdata) is served from a captured
    //     critical-word flop (fill_crit_q) instead of re-reading the array — the
    //     old data_X[fill_index] read is a statement block that DCEs at 1 (7R1W →
    //     6R1W). NOT via rd1_index: the early-restart (o_fill_data_ready) samples
    //     combinationally, so a registered read is 1-cycle stale (§13.8).
    //   S3 (this commit): R6/R7 slot-1 (index2 / next_index2) — the live dual-issue
    //     read port — is BEST-EFFORT DENIED at 1 (o_hit2=0 → pipe-0 fallback); the
    //     rdata2 / next_rdata2 reads are statement blocks that DCE at 1 (6R1W →
    //     4R1W). The IPC cost of losing dual-issue loads is the measurement that
    //     decides best-effort-vs-bank (§13.9). Taken ahead of the R1-demand-unify
    //     (cap/next/R1 are harder — coherence stall / S3-coupled).
    // 14.3-f DEFAULT-ON (2026-07-14, §14.12): the read side is now the SHIPPED design.
    // With S1/S2/S3 + the nf reroute (14.3-c..f: AMO/misaligned/replay/streaming/
    // cross-line) all folded, the data array is 2R1W (R2 rd1_index + R3 cap_index).
    // 14.13/14.14 DEFAULT-ON (2026-07-15): the R3 cap read (whole-line writeback capture)
    // now folds onto rd1_index too (DCACHE_CAP_1R below), so the data array is TRUE 1R1W.
    // Validated full ladder + Verilator N1/N2 (see §14.11/§14.12/§14.14). Set this back to 0 to
    // restore the byte-identical 7R1W live-read design for debugging).
    const DCACHE_DATA_READ_1R: bit = 1;
    // Per-fold Verilator-bisect knobs (§14.6/§14.7): each gates ONE of the S1/S2/S3
    // folds' DELIVERY so a Verilator/NBA hang can be isolated to a single fold while
    // the others stay folded. They track DCACHE_DATA_READ_1R (so =0 is byte-identical);
    // for a bisect, temp-set DCACHE_DATA_READ_1R=1 and override ONE of these to 0 to
    // revert just that fold to its live read. (This is how §14.7's S1 NBA hang was
    // pinned to the demand registered read.)
    const S1_DEMAND: bit = DCACHE_DATA_READ_1R; // demand read: rd1_dhit_rdata (reg) vs dhit_rdata_d (live)
    const S2_FILL  : bit = DCACHE_DATA_READ_1R; // fill-DONE: fill_crit_q (flop) vs fill_rdata_live
    const S3_SLOT1 : bit = DCACHE_DATA_READ_1R; // slot-1: best-effort deny vs live 2nd hit port
    // 14.3-d (§14): streaming reroute. The mid-fill early-restart read (stream_rdata0
    // = data_X[index], an R1 consumer) folds onto the S2 fill_crit_q flop: with CWF
    // the streaming demand is the CRITICAL word (offset==fill_offset), whose value is
    // exactly fill_crit_q (i_mem_rdata of beat #0 — the same equivalence S2 uses for
    // o_fill_rdata). At =1 streaming serves ONLY the critical word from fill_crit_q
    // (no R1 read); a non-critical stream hit (offset!=fill_offset) is DENIED and falls
    // to the DONE path — best-effort, like S3 slot-1. Drops streaming's R1 dependency.
    const S4_STREAM: bit = DCACHE_DATA_READ_1R; // streaming: fill_crit_q (critical only) vs data_X[index] (R1)
    // 14.3-c isolation knob: gates ONLY the nf delivery/stall reroute (AMO/misaligned
    // -lo → registered read), separate from DCACHE_DATA_READ_1R which also gates the
    // S1/S2/S3 folds (demand/fill/slot-1) + the nf regs. Set to 0 (with DATA_READ_1R=1)
    // to run S1/S2/S3 at =1 with AMO/misaligned staying LIVE — isolates whether an
    // NBA-semantics (Verilator) hang is in S1/S2/S3 or in the 14.3-c reroute.
    // 14.3-f DEFAULT-ON (2026-07-14, §14.12): the nf reroute (AMO/misaligned/replay +
    // the cross-line xline serialize) is now the shipped design (drops R1/R4 → 2R1W).
    const DCACHE_NF_REROUTE: bit = 1;
    // 14.3-e isolation knob: gates ONLY the REPLAY reroute (the non-folded ordinary
    // cache-hit = an MSHR replay re-read, `data_X[index]` = R1's last live consumer).
    // Tracks DCACHE_NF_REROUTE (active with the full stack) but separable so an
    // NBA-semantics hang can be pinned to the replay fold vs the AMO/misaligned nf.
    // Unlike AMO/misaligned (which complete via o_data_valid), a replay completes via
    // o_hit_safe (same-cycle combinational capture: mshra_data_q=dcache_rdata). To fold
    // it onto the +1 registered read, o_hit_safe is gated on nf_ready so the replay
    // does NOT complete on the request cycle; the core holds replay_q (no hit → no
    // retire, no fill → no claim, no re-capture while replay_q=1) and re-drives the
    // stable MSHR address next cycle, when nf_ready delivers rd1_nf_rdata. See §14.9.
    const DCACHE_NF_REPLAY: bit = DCACHE_NF_REROUTE;
    // 14.3-f isolation knob: gates ONLY the CROSS-LINE hi serialize (R4 =
    // data_X[next_index], the last live consumer of the next-line read). A cross-line
    // misaligned load needs BOTH the lo line (index) and the hi line (next_index) — two
    // reads on one registered port, so they SERIALIZE: phase 0 registers the lo line
    // (existing nf), phase 1 registers the hi line. The lo dword is captured
    // (xline_lo_q) and held — with a §14.7 write-forward bypass for a store draining to
    // the lo line during the hi read — so the final (unstalled) cycle delivers lo
    // (xline_lo_q) + hi (from the registered hi line) TOGETHER, as the core's LSU
    // samples o_rdata / o_rdata_next combinationally on the same cycle. Tracks
    // DCACHE_NF_REROUTE but separable so an NBA hang can be pinned to the xline fold.
    const DCACHE_NF_XLINE: bit = DCACHE_NF_REROUTE;
    // 14.3-e R1 DCE: R1 (rdata_0..3 = data_X[index], the live demand read) drops only
    // when EVERY consumer is off it — AMO/misaligned + replay via the nf reroute
    // (DCACHE_NF_REROUTE + DCACHE_NF_REPLAY), streaming via fill_crit_q (S4_STREAM);
    // the RMW-old reads are already dead at DCACHE_DATA_1RW=1. Gated on all three so the
    // §14.7 bisect configs (DATA_READ_1R=1 with a reroute const held 0 → that consumer
    // stays live) keep rdata_X alive and correct. Only then may rdata_X DCE (a STATEMENT
    // block, not a ternary — the L2 P3.b lesson). The dcache no longer serves a
    // combinational held-address read at i_ren=0 (that fake-flop is what the 1R1W SRAM
    // removes) — the real core never samples o_rdata at i_ren=0; see §14.9.
    const DCACHE_R1_DCE: bit = DCACHE_NF_REROUTE && DCACHE_NF_REPLAY && S4_STREAM;
    // 14.3-f R4 DCE: R4 (next_rdata_same / next_rdata_xline = data_X[next_index]) drops
    // only when BOTH its consumers are off it — the same-line misaligned hi via the nf
    // reroute (DCACHE_NF_REROUTE → rd1_next_same) and the CROSS-line hi via the xline
    // serialize (DCACHE_NF_XLINE → rd1_next_same on the registered hi line). Gated on
    // both so the §14.7 bisect configs keep next_rdata_* alive and correct. Only then
    // may the two next-index reads DCE (STATEMENT blocks, not ternaries — the L2 P3.b
    // lesson). With R1 (§14.10) and R4 dropped the data array is 2R1W (R2 rd1_index +
    // R3 cap_index remain; R3 cap → true 1R is 14.3-f's follow-up).
    const DCACHE_R4_DCE: bit = DCACHE_NF_REROUTE && DCACHE_NF_XLINE;
    // 14.13 R3 cap → true 1R1W (the FINAL read fold): the last non-arbitrated data read
    // is cap_data = data_X[cap_index], the whole-line writeback-buffer capture (R3). Its
    // five sources (fill-evict / probe-recall / misaligned-detour lo+hi / flush-sweep)
    // are mutually exclusive per cycle (the cap_*_go priority chain), so they share ONE
    // read. Fold cap_data onto rd1_index via a UNIFORM +1-latch: at the cap_*_go cycle C
    // present cap_index on the arbiter with TOP priority (above demand — a preempted
    // folded demand load replays via a dhit squash, dhit_cap_pre_q; cap events are rare)
    // and set wb_v / invalidate / the evict/probe notify UNCHANGED at C; the NEXT cycle
    // latch wb_data (→ wb_data_lat) from the registered read rd1_data[cap_way_q]. The
    // drain gates on wb_data_rdy_q so the first writeback beat may slip ≤1 cycle.
    // Coherence-neutral by construction (only the data SOURCE changes; invalidate + the
    // evict/probe notify stay at cap_*_go). Fill is safe under the same +1-latch: the
    // beat-0 fill write to the victim lands at C+1 (state==FILL) while rd1_data holds the
    // read-OLD victim registered at C, and drain_fill_set_clash bars a same-cycle store
    // to f_index, so the registered line = the =0 live victim exactly. Then cap_data DCEs
    // (statement block) → true 1R1W. DEAD at 0 (byte-identical: cap_data stays the live
    // read, the +1-latch path is reset-only → DCE, the priority mux folds to the original
    // demand>nf>cap). NEEDS the full slow gate (Verilator N1/N2 + litmus N4 + SMP N2/N4
    // boot): a stale writeback = silent dirty-data loss, a probe-recall/evict livelock.
    const DCACHE_CAP_1R: bit = 1;
    // Per-source bisect knobs (track DCACHE_CAP_1R): fold each cap source independently so
    // a coherence failure can be pinned to one source. A disabled source keeps its LIVE
    // cap_data capture (wb_folded_q=0 → the live wb_data drains immediately); cap_data DCEs
    // only when ALL four are folded (DCACHE_CAP_DCE).
    const CAP_FILL_1R : bit = DCACHE_CAP_1R; // fill-victim eviction writeback
    const CAP_PROBE_1R: bit = DCACHE_CAP_1R; // probe-recall writeback
    const CAP_MIS_1R  : bit = DCACHE_CAP_1R; // misaligned-store dirty detour (lo+hi)
    const CAP_FLUSH_1R: bit = DCACHE_CAP_1R; // flush-sweep writeback
    // cap_data DCE gate: only when every consumer is off the live read.
    const DCACHE_CAP_DCE: bit = CAP_FILL_1R && CAP_PROBE_1R && CAP_MIS_1R && CAP_FLUSH_1R;
    // R1 read: default 0, else (if !DCACHE_R1_DCE) the live data_X[index] read. As a
    // statement block the four read ports DCE at DCACHE_R1_DCE=1.
    var rdata_0: logic<64>;
    var rdata_1: logic<64>;
    var rdata_2: logic<64>;
    var rdata_3: logic<64>;
    always_comb {
        rdata_0 = 64'd0;
        rdata_1 = 64'd0;
        rdata_2 = 64'd0;
        rdata_3 = 64'd0;
        if !DCACHE_R1_DCE {
            rdata_0 = rd_dword(data_0[index], offset);
            rdata_1 = rd_dword(data_1[index], offset);
            rdata_2 = rd_dword(data_2[index], offset);
            rdata_3 = rd_dword(data_3[index], offset);
        }
    }
    var miss_q      : logic         ;
    var load_sel_q  : logic         ;
    var srfo_sel_q  : logic         ;
    var f_index_q   : logic<INDEX_W>;
    var f_tag_q     : logic<TAG_W>  ;
    var f_offset_q  : logic<3>      ;
    var f_rfo_q     : logic         ;
    var victim_way_q: logic<2>      ;
    always_ff (clk, rst) {
        if_reset {
            miss_q       = 1'b0;
            load_sel_q   = 1'b0;
            srfo_sel_q   = 1'b0;
            f_index_q    = '0;
            f_tag_q      = '0;
            f_offset_q   = 3'd0;
            f_rfo_q      = 1'b0;
            victim_way_q = 2'd0;
        } else if DCACHE_SYNC_READ {
            miss_q       = miss_raw;
            load_sel_q   = load_sel_raw;
            srfo_sel_q   = srfo_sel_raw;
            f_index_q    = f_index_raw;
            f_tag_q      = f_tag_raw;
            f_offset_q   = f_offset_raw;
            f_rfo_q      = f_rfo_raw;
            victim_way_q = victim_way_raw;
        }
    }
    let miss      : logic          = if DCACHE_SYNC_READ ? miss_q       : miss_raw;
    let load_sel  : logic          = if DCACHE_SYNC_READ ? load_sel_q   : load_sel_raw;
    let srfo_sel  : logic          = if DCACHE_SYNC_READ ? srfo_sel_q   : srfo_sel_raw;
    let f_index   : logic<INDEX_W> = if DCACHE_SYNC_READ ? f_index_q    : f_index_raw;
    let f_tag     : logic<TAG_W>   = if DCACHE_SYNC_READ ? f_tag_q      : f_tag_raw;
    let f_offset  : logic<3>       = if DCACHE_SYNC_READ ? f_offset_q   : f_offset_raw;
    let f_rfo     : logic          = if DCACHE_SYNC_READ ? f_rfo_q      : f_rfo_raw;
    let victim_way: logic<2>       = if DCACHE_SYNC_READ ? victim_way_q : victim_way_raw;

    // ── Stage-D victim-state re-read (§11.1 C1) from the registered selection.
    // Byte-identical at =0 (f_index=f_index_raw, victim_way=victim_way_raw); at
    // =1 it reads the CURRENT victim line so the writeback is not stale.
    let vic_valid: logic = if victim_way == 2'd0 ?
        valid_0[f_index]
    : if victim_way == 2'd1 ?
        valid_1[f_index]
    : if victim_way == 2'd2 ?
        valid_2[f_index]
    :
        valid_3[f_index]
    ;
    let vic_tag: logic<TAG_W> = if victim_way == 2'd0 ?
        tags_0[f_index]
    : if victim_way == 2'd1 ?
        tags_1[f_index]
    : if victim_way == 2'd2 ?
        tags_2[f_index]
    :
        tags_3[f_index]
    ;
    let vic_dirty: logic = vic_valid && (if victim_way == 2'd0 ?
        dirty_0[f_index]
    : if victim_way == 2'd1 ?
        dirty_1[f_index]
    : if victim_way == 2'd2 ?
        dirty_2[f_index]
    :
        dirty_3[f_index]
    );
    // vic_data (fill-victim line) folded into the shared cap_data read below.
    // A dirty victim needs the writeback buffer; while it is busy the fill
    // start is HELD — and so is its bus request (grant ⇒ fill-start invariant,
    // see want_fill_start). The fill is ALSO held while the buffer holds the
    // very line being fetched: the home would serve the PRE-writeback data, and
    // a WB carries no invalidate so nothing aborts the stale fill (observed as
    // ra/s0 restored as ZEROS from a stack line evicted dirty and immediately
    // reloaded → kernel Oops at pc 0). §11.1 C2: re-eval at Stage-D from LIVE
    // wb_v/wb_line + the re-read vic_dirty (a stale registered fill_blocked_wb_q
    // could start a fill while the buffer holds the fetched line → stale-fill).
    let fill_blocked_wb: logic = wb_v && (vic_dirty || (wb_line == {f_tag, f_index}));
    // The IDLE→FILL transition fires this cycle.
    let fill_start_fire: logic = (load_sel || srfo_sel) && !fill_blocked_wb && i_memr_grant;

    // ── Phase C delta-5: Stage-A demand-load tag read (§11.2 the load-use fold) ──
    // The core presents the load's PA one cycle early on i_addr_r (= dmu_dmem_addr
    // at lsr_capture). Read tags/valid at that Stage-A index and compute the hit
    // HERE, then register it (below) so Stage-B delivers off flops — synchronous
    // read, load-use-neutral. (An uncached MMIO load never hits — but it is not a
    // plain load, so i_ren_r excludes it at the core; the hit here mirrors the
    // Stage-B cache_hit's tag/valid compare on the Stage-A index.)
    let index_r    : logic<INDEX_W> = i_addr_r[INDEX_W + 5:6];
    let tag_r      : logic<TAG_W>   = i_addr_r[63:INDEX_W + 6];
    let offset_r   : logic<3>       = i_addr_r[5:3];
    let hit_r_0    : logic = valid_0[index_r] && tags_0[index_r] == tag_r;
    let hit_r_1    : logic = valid_1[index_r] && tags_1[index_r] == tag_r;
    let hit_r_2    : logic = valid_2[index_r] && tags_2[index_r] == tag_r;
    let hit_r_3    : logic = valid_3[index_r] && tags_3[index_r] == tag_r;
    let cache_hit_r: logic = hit_r_0 || hit_r_1 || hit_r_2 || hit_r_3;
    let hit_way_r  : logic<2> = if hit_r_0 ? 2'd0 : if hit_r_1 ? 2'd1 : if hit_r_2 ? 2'd2 : 2'd3;
    // An inv hitting the Stage-A line in the SAME (Stage-R) cycle → the C3 flag.
    let inv_r_at_a : logic = (i_inv_valid && ({inv_tag, inv_index} == {tag_r, index_r}))
        || (i_inv2_valid && ({inv2_tag, inv2_index} == {tag_r, index_r}));

    // ── Phase C delta-3+5: register the Stage-A demand hit + C3 R→D re-validation ──
    // A demand-load HIT is decided at Stage-R (the Stage-A tag read above) and its
    // data delivered at Stage-D (Stage-B, off dhit_*_q). A remote invalidate
    // landing on that line in the R→D window makes the registered hit stale — the
    // load would read a value OLDER than a write it is ordered after (the litmus MP
    // class the live inv_hits_active guards one stage earlier). Re-validate: carry
    // the hit line + an "inv hit at Stage-R" flag, and at Stage-D squash the
    // registered hit (→ o_stall replay, drop o_data_valid/o_hit_safe) if an inv
    // matched the line at EITHER the Stage-R decide cycle (dhit_inv_r_q) or the
    // Stage-D delivery cycle (live i_inv*). DEAD at =0: dhit_*_q are reset-only
    // (DCE'd) and dhit_c3_squash const-folds to 0, so the outputs are byte-id.
    // dhit_ren_q gates the Stage-D DELIVERY: only a FOLDED plain-load Stage-B read
    // (its Stage-A tag read fired last cycle via i_ren_r) delivers off the registered
    // dhit; every OTHER dcache accessor sharing the i_addr port this cycle (AMO read,
    // replay_drive, commit-store, slot-1, DONE re-read) keeps the LIVE combinational
    // path — so the sync-read fold does not steal their same-cycle data. Without this
    // gate the =1 flip drives o_data_valid/o_rdata from dhit (=0 for a non-folded read)
    // → the load never completes / reads garbage.
    var dhit_v_q    : logic                 ; // a demand-load hit is in-flight R→D
    var dhit_ren_q  : logic                 ; // a folded plain-load read fired at Stage-A
    var dhit_way_q  : logic<2>              ; // the Stage-A hit way (data mux at Stage-D)
    var dhit_line_q : logic<TAG_W + INDEX_W>; // {tag, index} of the hit line
    var dhit_off_q  : logic<3>              ; // dword offset of the load
    var dhit_inv_r_q: logic                 ; // an inv hit the line at Stage-R
    always_ff (clk, rst) {
        if_reset {
            dhit_v_q     = 1'b0;
            dhit_ren_q   = 1'b0;
            dhit_way_q   = 2'd0;
            dhit_line_q  = '0;
            dhit_off_q   = 3'd0;
            dhit_inv_r_q = 1'b0;
        } else if DCACHE_SYNC_READ {
            dhit_v_q     = i_ren_r && cache_hit_r;
            dhit_ren_q   = i_ren_r;
            dhit_way_q   = hit_way_r;
            dhit_line_q  = {tag_r, index_r};
            dhit_off_q   = offset_r;
            dhit_inv_r_q = inv_r_at_a;
        }
    }
    let dhit_inv_d: logic = (i_inv_valid && ({inv_tag, inv_index} == dhit_line_q))
        || (i_inv2_valid && ({inv2_tag, inv2_index} == dhit_line_q));
    let dhit_c3_squash: logic = DCACHE_SYNC_READ && dhit_v_q && (dhit_inv_r_q || dhit_inv_d);
    // Stage-D data read: ONLY the registered hit way's data[index] (the 9R→1R
    // way-mux read that becomes the 1RW SRAM macro). index/off come from flops.
    let dhit_index_d: logic<INDEX_W> = dhit_line_q[INDEX_W - 1:0];
    // Fill-safety: a folded hit whose line is being FILLED at Stage-D must NOT
    // deliver off the (mid-write) data array — fall back to the LIVE path, whose
    // o_hit_safe fill_busy0 exclusion + o_stall(FILL) handle mid-fill exactly as
    // the live demand read does. Without this, a folded load hitting a mid-fill
    // line reads a partially-written dword (observed: rv64ui-ld subtest-5 garbage).
    // Misaligned-safety (§11.10/§11.13): a CROSS-DWORD load (i_load_next) needs BOTH
    // dwords — o_rdata (lo) + the LIVE o_rdata_next (hi). The folded dhit path only
    // delivers the registered LO dword (dhit_rdata_d, a cycle old), so combining it
    // with the live hi dword mis-delivers. The live o_hit_safe already EXCLUDES
    // i_load_next (o_hit_safe_live below); exclude it from the fold too so a
    // misaligned load falls back entirely to the live path = identical to =0
    // (observed: rv64ui-ma_data garbage).
    let dhit_use    : logic = dhit_ren_q && i_ren_folded && !i_load_next && !(filling && fill_index == dhit_index_d);
    // A folded plain-load that MISSED at Stage-A must stall its Stage-B cycle: the
    // registered miss (miss_q, the Stage-B live compute of deltas 1-2) is a cycle
    // LATE vs the Stage-A-folded hit (dhit_v_q), so on the load's first Stage-B
    // cycle BOTH dhit_v_q=0 (Stage-A miss) AND miss_q=0 (not yet) — without this
    // term o_stall drops and the load completes prematurely with pre-fill data
    // (observed: a cold-miss load returned 0). dhit_miss covers that one-cycle gap;
    // miss_q takes over next cycle (its miss_raw is 1 this cycle). Byte-id at 0.
    let dhit_miss   : logic = dhit_ren_q && i_ren_folded && !dhit_v_q && !i_uncached;
    // ── Phase C delta-5: non-folded read miss-stall (§11.11 AMO cluster) ──
    // AMO reads / replay reads drive i_addr LIVE (not the Stage-A fold), so their
    // registered miss decision (miss_q, deltas 1-2) is a cycle LATE: on the read's
    // FIRST cycle miss=miss_q reflects the PREVIOUS access, so a non-folded MISS
    // sees o_stall drop and the core completes it prematurely (iss_dc_ok fires with
    // the line ABSENT → the AMO watch arms present=0 → poison + a wrong writeback;
    // observed: the cold AMO on 0x80002000 read raw DRAM, not the prior store's
    // value, then replayed on its own poisoned write, committing 3×). The folded
    // plain-load covers the identical gap via dhit_miss (off the registered Stage-A
    // hit dhit_v_q); the non-folded accessors have no Stage-A read, so gate on the
    // LIVE miss (miss_raw = lo_miss|hi_miss|amo_upg) instead. This MUST gate on the
    // actual miss/upgrade, NOT merely "a new read": stalling a clean hit-exclusive
    // AMO opens a one-cycle window for the remote hart to recall the line before the
    // RMW completes → neither hart makes progress = contended-atomic LIVELOCK
    // (observed: litmus N2 both harts wedged at the amoadd 0x800007a8). With
    // miss_raw an AMO that already owns the line (miss_raw=0) keeps its 1-cycle fast
    // path, so the line-bounce still terminates. Gated by DCACHE_SYNC_READ →
    // const-folds to 0 at =0 = byte-identical (there o_stall = miss = miss_raw
    // already covers the non-folded read, so this term is redundant at =0).
    // §11.13: a CROSS-LINE misaligned load (i_load_next) is excluded from the fold
    // (dhit_use above) so it delivers via the LIVE path — but its stall must ALSO be
    // live: its HIGH-line miss (hi_miss) is a miss_raw term whose miss_q is a cycle
    // late, so when the LO line hits (dhit_v_q=1 → dhit_miss=0) the o_stall drops
    // before the HI line is filled and o_rdata_next reads 0 (observed: rv64ui-ma_data
    // `lh 63(s0)` dropped its high byte, 0x403f→0x003f). Treat a misaligned load as
    // non-folded here too so nf_gap_stall = miss_raw covers BOTH the lo- and hi-miss
    // gaps → the misaligned load is fully on the live path (delivery + stall) = =0.
    let nf_read_now : logic = i_ren && (!(dhit_ren_q && i_ren_folded) || i_load_next);
    let nf_gap_stall: logic = DCACHE_SYNC_READ && nf_read_now && miss_raw;
    // S1 (§13.7): the demand read as a const-guarded STATEMENT block so its
    // data_X[dhit_index_d] read port DCEs at DCACHE_DATA_READ_1R=1 (a ternary let
    // does NOT drop the port — veryl infers a read per index net before global DCE;
    // same as L2 P3.b w_old_line and the write-collapse's `if !DCACHE_DATA_1RW`).
    // At =1 the demand delivers from the arbitrated port (rd1_dhit_rdata); this is
    // cycle-identical (§13.7 de-risk: boot cy-EXACT, the read-during-write hazard is
    // masked by the core's store-to-load forwarding). Default 0 first = no latch.
    var dhit_rdata_d: logic<64>;
    always_comb {
        dhit_rdata_d = 64'd0; // =1: demand served by rd1_dhit_rdata
        if !S1_DEMAND {
            dhit_rdata_d = if dhit_way_q == 2'd0 ?
                rd_dword(data_0[dhit_index_d], dhit_off_q)
            : if dhit_way_q == 2'd1 ?
                rd_dword(data_1[dhit_index_d], dhit_off_q)
            : if dhit_way_q == 2'd2 ?
                rd_dword(data_2[dhit_index_d], dhit_off_q)
            :
                rd_dword(data_3[dhit_index_d], dhit_off_q)
            ;
        }
    }

    // S2 critical-word flop (§13.8): capture the demanded dword (fill_woff==
    // fill_offset = CWF beat #0) so o_fill_rdata (DONE) and the 14.3-d streaming
    // read source it from a flop instead of re-reading data_X[fill_index]. Defined
    // here (before the streaming block that consumes it); the fill_rdata_live =0 arm
    // + the o_fill_rdata const-mux stay below. Reset-only → DCE at 0.
    var fill_crit_q: logic<64>;
    always_ff (clk, rst) {
        if_reset {
            fill_crit_q = 64'd0;
        } else if S2_FILL && filling && i_memr_grant && (fill_woff == fill_offset) {
            fill_crit_q = i_mem_rdata; // CWF beat #0 = the demanded dword
        }
    }

    // Phase 8 S14.1: streaming (early restart) on the pipe-0 read port. Fill
    // dword k commits to the data array at the granted FILL cycle where
    // fill_count==k, so dwords 0..fill_count-1 of the line BEING FILLED are
    // already readable from the fill way (its tag/valid are rewritten only at
    // completion; identification is by the latched fill line). A load that
    // demands one of them completes through the hit-under-miss path
    // (o_hit_safe) instead of waiting out the 8-dword fill. Excluded: an
    // aborted fill (a remote invalidate hit the line — its dwords may be
    // stale) and the same-cycle invalidate race on the fill line (mirrors
    // inv_hits_active for ordinary hits). AMO reads and cross-dword spans are
    // excluded by the o_hit_safe gates below, exactly like ordinary safe hits.
    let s14_st_en    : logic     = 1'b1;
    // Streaming written-dword test: transfer k writes dword
    // fill_offset+k (cwf) or k (linear), so dword w is present iff
    // (w - first_dword) mod 8 < fill_count.
    let stream_rel   : logic<3>  = offset - (if s14_cwf_en ? fill_offset : 3'd0);
    let stream_line  : logic<58> = {fill_tag, fill_index};
    // 14.3-d (§14): at =1 restrict streaming to the CRITICAL word (stream_rel==0,
    // i.e. offset==fill_offset) so stream_rdata0 folds onto fill_crit_q (below). A
    // non-critical stream hit is denied here and completes via the DONE path — a
    // best-effort deny (like S3 slot-1), so the R1 read drops. At 0 unrestricted =
    // byte-identical.
    let stream_hit0  : logic     = s14_st_en && filling && stream_line == {tag, index}
        && stream_rel <: fill_count && !fill_aborted
        && (!S4_STREAM || stream_rel == 3'd0)
        && !(i_inv_valid && {inv_tag, inv_index} == stream_line)
        && !(i_inv2_valid && {inv2_tag, inv2_index} == stream_line);
    // 14.3-d: the streaming dword. At =1 stream_hit0 is critical-word only, and the
    // critical word equals fill_crit_q (i_mem_rdata of beat #0), so serve the flop —
    // no data_X[index] (R1) read. At 0 the live rdata_X hit mux = exact original.
    let stream_rdata0_live: logic<64> = if fill_way == 2'd0 ?
        rdata_0
    : if fill_way == 2'd1 ?
        rdata_1
    : if fill_way == 2'd2 ?
        rdata_2
    :
        rdata_3
    ;
    let stream_rdata0: logic<64> = if S4_STREAM ? fill_crit_q : stream_rdata0_live;

    // ============================================================
    // P9.2 store drain = LOCAL MERGE into an owned (E/M) way — no bus
    // transaction, no grant. The decode lives up at the fill-selection
    // section (shit_* / s_hit_excl); a drain that cannot merge raises the
    // store-RFO fill there instead (srfo_sel). A same-cycle PROBE of the
    // drain line wins over the merge (the recall must not lose the bytes:
    // the merge retries after the refetched ownership).
    // ============================================================
    // P9.3: a PINNED (deferred) probe does not clash — it acts only after
    // the pin releases, and the eventual capture includes the merged bytes.
    let drain_probe_clash: logic = i_probe_v && !probe_pinned && (i_probe_addr[63:6] == i_saddr[63:6]);
    // A same-cycle fill START in the drain's SET must win: its victim could
    // be the very way this merge writes — the capture would snapshot the
    // pre-merge data and the fill then overwrites the line, silently losing
    // an ACKED store (a litmus MP violation when it was a fence-ordered
    // flag's predecessor). The merge retries next cycle.
    let drain_fill_set_clash: logic = fill_start_fire && (f_index == sindex);
    // (P9.3: the AMO force-miss is gone — an AMO read no longer invalidates
    // a hit line, so the old drain_amo_clash same-cycle hazard no longer
    // exists; an AMO read's S-upgrade fill is covered by the fill-set clash.)
    let store_can_drain: logic = i_swen && state == State::IDLE && !i_wen && s_hit_excl
        && !drain_probe_clash && !drain_fill_set_clash;
    // P9.2: full-line WRITE-THROUGH drain (see s_full_line). Fires on its
    // write-channel grant; the writeback buffer outranks it there, and a
    // same-cycle fill start in the set must win (shared departure-event
    // port + its victim could be our S copy's way).
    let want_store_wt: logic = i_swen && state == State::IDLE && !i_wen && !s_hit_excl && s_full_line
        && !drain_probe_clash;
    let wt_fires: logic = want_store_wt && i_memw_grant && !wb_v && !fill_start_fire;
    assign o_sdrain_ack = store_can_drain || wt_fires;

    // ==================================================================
    // P9.2: dirty-line bookkeeping + WRITEBACK-BUFFER capture arbitration
    // (one capture per cycle; the fill-start capture is guaranteed free by
    // fill_blocked_wb, the others defer). Priority: fill > AMO force >
    // probe > misaligned detour > flush — the AMO-before-probe order breaks
    // a would-be comb cycle through the shared departure-event port.
    // ==================================================================
    // i_addr line's hit way: dirty flag + full-line data (AMO force-miss
    // capture and the misaligned-store lo-line capture share this decode).
    let hit_dirty: logic = (hit_0 && dirty_0[index]) || (hit_1 && dirty_1[index])
        || (hit_2 && dirty_2[index]) || (hit_3 && dirty_3[index]);
    // hitway_data (misaligned-store lo line) folded into shared cap_data below.
    // Misaligned-store hi line (i_addr+8).
    let next_hit_dirty: logic = (next_hit_0 && dirty_0[next_index]) || (next_hit_1 && dirty_1[next_index])
        || (next_hit_2 && dirty_2[next_index]) || (next_hit_3 && dirty_3[next_index]);
    // nexthit_data (misaligned-store hi line) folded into shared cap_data below.
    // A misaligned store whose touched line(s) are DIRTY detours them
    // through the writeback buffer first (the self-invalidate would lose
    // the dirty bytes); the write itself is held meanwhile.
    let mis_active       : logic = i_wen && (state == State::IDLE) && (i_wstrb_hi != 8'd0);
    let mis_lo_dirty     : logic = mis_active && cache_hit && hit_dirty;
    let mis_hi_dirty     : logic = mis_active && next_line_hit && next_hit_dirty;
    let mis_dirty_pending: logic = mis_lo_dirty || mis_hi_dirty;

    // Probe decode (recall): any-way match on i_probe_addr. The mid-fill
    // victim way is NOT excluded — its dirty bytes (if any) were captured
    // at the fill start, so a probe finds it clean and may invalidate it.
    let p_tag  : logic<TAG_W>   = i_probe_addr[63:INDEX_W + 6];
    let p_index: logic<INDEX_W> = i_probe_addr[INDEX_W + 5:6];
    let phit_0 : logic = valid_0[p_index] && tags_0[p_index] == p_tag;
    let phit_1 : logic = valid_1[p_index] && tags_1[p_index] == p_tag;
    let phit_2 : logic = valid_2[p_index] && tags_2[p_index] == p_tag;
    let phit_3 : logic = valid_3[p_index] && tags_3[p_index] == p_tag;
    let p_any  : logic = phit_0 || phit_1 || phit_2 || phit_3;
    let p_dirty: logic = (phit_0 && dirty_0[p_index]) || (phit_1 && dirty_1[p_index])
        || (phit_2 && dirty_2[p_index]) || (phit_3 && dirty_3[p_index]);
    // p_data (probe recall line) folded into the shared cap_data read below.
    // The probed line already sits in the writeback buffer (evicted, WB in
    // flight): no ack — that WB completes the recall at the home.
    let probe_wb_wait: logic = wb_v && (wb_line == i_probe_addr[63:6]);
    // The probed line is being FILLED here: the tag arrays don't show it yet
    // (they would answer "absent" → ack → the home drops this hart from the
    // directory → the write that triggered the recall sends no invalidate →
    // the fill completes with the PRE-write line = stale-forever; observed
    // as the litmus MP+fence (1,0) violation). ABORT the fill with the ack:
    // the load replays and refetches the post-write line. EXCEPT for a
    // SELF-recall (i_probe_self): the fill is the recall's own requester
    // and the home serializes any real writer behind the engine — aborting
    // would re-arm the stale owner via the same grant and livelock.
    let p_fill_hit: logic = filling && (fill_index == p_index) && (fill_tag == p_tag) && !i_probe_self;

    // Flush sweep decode (scan counter: {set, way}).
    var fl_active: logic           ;
    var fl_idx   : logic<INDEX_W + 2>;
    var fl_done_q: logic           ;
    let fl_set: logic<INDEX_W> = fl_idx[INDEX_W + 1:2];
    let fl_way: logic<2>       = fl_idx[1:0];
    // P9.4: a flush touches only ~2 dirty lines but scanned all 256 {set,way}
    // entries — ~45% of the Linux boot was the flush scan. Skip a whole CLEAN
    // set in one cycle (jump to the next set's way 0) instead of walking its 4
    // ways: `fl_set_clean` is the combinational "no valid+dirty way in this
    // set" test, checked at way 0. Dirty sets still walk their 4 ways (the WB
    // buffer is single-entry, so dirty lines drain one at a time anyway).
    let fl_set_clean: logic = !((valid_0[fl_set] && dirty_0[fl_set]) || (valid_1[fl_set] && dirty_1[fl_set])
        || (valid_2[fl_set] && dirty_2[fl_set]) || (valid_3[fl_set] && dirty_3[fl_set]));
    let fl_valid: logic = if fl_way == 2'd0 ?
        valid_0[fl_set]
    : if fl_way == 2'd1 ?
        valid_1[fl_set]
    : if fl_way == 2'd2 ?
        valid_2[fl_set]
    :
        valid_3[fl_set]
    ;
    let fl_dirty: logic = fl_valid && (if fl_way == 2'd0 ?
        dirty_0[fl_set]
    : if fl_way == 2'd1 ?
        dirty_1[fl_set]
    : if fl_way == 2'd2 ?
        dirty_2[fl_set]
    :
        dirty_3[fl_set]
    );
    let fl_tag: logic<TAG_W> = if fl_way == 2'd0 ?
        tags_0[fl_set]
    : if fl_way == 2'd1 ?
        tags_1[fl_set]
    : if fl_way == 2'd2 ?
        tags_2[fl_set]
    :
        tags_3[fl_set]
    ;
    // fl_data (flush-sweep line) folded into the shared cap_data read below.

    // i_wen write fire (the local merge and the bus write must coincide):
    // the writeback buffer outranks it on the channel, and a misaligned
    // store waits out its dirty detours. P9.3: an in-cache AMO/SC commit
    // write (i_wen_excl) never touches the channel — see wenl_fires below.
    let amo_miss : logic = i_ren && i_wen && !cache_hit;
    let wen_fires: logic = i_wen && !i_wen_excl && state == State::IDLE && i_memw_grant && !amo_miss
        && !wb_v && !mis_dirty_pending;
    // 14.13: a FOLDED cap writeback (wb_folded_q) drains only once its +1-latched data
    // has landed (wb_data_rdy_q); a live writeback (=0 / a disabled cap source, wb_folded_q
    // =0) drains as soon as wb_v is set, exactly as before. Byte-identical at CAP_1R=0
    // (wb_folded_q const-0 → wb_drain_ok = wb_v).
    let wb_drain_ok: logic = wb_v && (!wb_folded_q || wb_data_rdy_q);
    let wb_fire: logic = wb_drain_ok && i_memw_grant;

    // P9.3: in-cache AMO/SC commit write — merge LOCALLY into the owned
    // (E/M) way, line → M. Same-cycle losers: a fill start in the set (its
    // victim could be this way), an UNPINNED probe of the line (the recall
    // must capture pre- or post-merge atomically — the merge retries or the
    // core replays), and the same-cycle invalidate races. If the line is no
    // longer owned here the write HOLDS (o_stall); the core's watch poisons
    // and the commit replay drops the request.
    let wenl_probe_clash: logic = i_probe_v && !probe_pinned && (i_probe_addr[63:6] == i_addr[63:6]);
    let wenl_fires: logic = i_wen && i_wen_excl && (state == State::IDLE) && hit_excl
        && !(fill_start_fire && (f_index == index)) && !wenl_probe_clash
        && !inv_hits_active && !inv2_hits_active;

    // P9.3 pin arming (see the pin block above) + counter.
    let pin_arm_fill: logic = (state == State::DONE) && fill_rfo && i_amo_read && !fill_aborted;
    let pin_arm_hit : logic = i_amo_read && i_ren && (state == State::IDLE) && cache_hit && hit_excl
        && ({tag, index} != pin_line_q);
    always_ff (clk, rst) {
        if_reset {
            pin_cnt_q  = 7'h40; // saturated — no pin out of reset
            pin_line_q = '0;
        } else if pin_arm_fill || pin_arm_hit {
            pin_line_q = if pin_arm_hit ? {tag, index} : {fill_tag, fill_index};
            pin_cnt_q  = '0;
        } else if wenl_fires && (i_addr[63:6] == pin_line_q) {
            // RMW committed — release so the waiting hart gets the line.
            pin_cnt_q = 7'h40;
        } else if !pin_cnt_q[6] {
            pin_cnt_q = pin_cnt_q + 7'd1;
        }
    }

    // Capture arbitration + departure events (fill_start_fire is defined up
    // at the fill-selection section). P9.3: the AMO force-miss arms are gone;
    // a PINNED probe (probe_pinned) is deferred entirely.
    let cap_fill_go: logic = fill_start_fire && vic_dirty;
    let ev_mis_hi      : logic = wen_fires && (i_wstrb_hi != 8'd0) && next_line_hit;
    let probe_act      : logic = i_probe_v && !probe_wb_wait && !ev_mis_hi && !probe_pinned;
    let cap_probe_go   : logic = probe_act && p_dirty && !wb_v && !cap_fill_go;
    assign o_probe_ack = probe_act && !p_dirty;
    let cap_mis_go    : logic = mis_dirty_pending && !wb_v && !cap_fill_go && !cap_probe_go;
    let cap_mis_hi_sel: logic = !mis_lo_dirty; // lo line first, then hi
    let ev_fill_vic   : logic = fill_start_fire && vic_valid && (vic_tag != f_tag);
    let ev_mis_lo     : logic = wen_fires && (i_wstrb_hi != 8'd0) && cache_hit;
    let ev_drain_wt   : logic = wt_fires && scache_hit; // own S copy dropped
    let cap_flush_want: logic = fl_active && fl_dirty;
    let cap_flush_go  : logic = cap_flush_want && !wb_v && !cap_fill_go
        && !cap_probe_go && !cap_mis_go && !(ev_fill_vic || ev_mis_lo || ev_drain_wt);
    let fl_step      : logic = fl_active && (!cap_flush_want || cap_flush_go);
    let probe_depart : logic = probe_act && ((p_any && (!p_dirty || cap_probe_go)) || p_fill_hit);
    assign o_flush_done = fl_done_q && !wb_v;

    // 14.13: the ENABLED cap sources' capture-go — the cycle-C trigger for the +1-latch
    // fold (present cap_index at top arbiter priority this cycle, latch wb_data from the
    // registered read next cycle). Per-source knobs so a disabled source stays LIVE. At
    // DCACHE_CAP_1R=0 this is const-0 → the whole fold DCEs (byte-identical).
    let cap_go_latch: logic = (CAP_FILL_1R && cap_fill_go) || (CAP_PROBE_1R && cap_probe_go)
        || (CAP_MIS_1R && cap_mis_go) || (CAP_FLUSH_1R && cap_flush_go);

    // ── Phase C: SRAM port-narrowing — the shared write-back-capture read ──
    // The five writeback-buffer captures (fill-victim / probe / misaligned
    // lo+hi detour / flush) are mutually exclusive by the cap_*_go priority
    // chain (at most one capture per cycle, fill > probe > mis > flush), so
    // they SHARE a single line-read port instead of five. This drops the
    // data-array reads at f_index / p_index / fl_set, narrowing data_0..3 from
    // 10R to 8R toward the realistic 1RW + write-merge-buffer macro
    // (sram_inventory.md row 1). cap_index / cap_way mirror the SAME priority
    // as the wb_data captures below, so cap_data is byte-identical to whichever
    // per-source read (vic_data / p_data / hitway_data / nexthit_data /
    // fl_data) it replaces.
    let cap_index: logic<INDEX_W> = if cap_fill_go ?
        f_index
    : if cap_probe_go ?
        p_index
    : if cap_mis_go && !cap_mis_hi_sel ?
        index
    : if cap_mis_go && cap_mis_hi_sel ?
        next_index
    :
        fl_set
    ;
    let cap_way: logic<2> = if cap_fill_go ?
        victim_way
    : if cap_probe_go ?
        (if phit_0 ? 2'd0 : if phit_1 ? 2'd1 : if phit_2 ? 2'd2 : 2'd3)
    : if cap_mis_go && !cap_mis_hi_sel ?
        hit_way
    : if cap_mis_go && cap_mis_hi_sel ?
        (if next_hit_0 ? 2'd0 : if next_hit_1 ? 2'd1 : if next_hit_2 ? 2'd2 : 2'd3)
    :
        fl_way
    ;
    // 14.13: at DCACHE_CAP_DCE=1 (all four cap sources folded onto the registered read)
    // cap_data has no consumer — a STATEMENT block (default 0, guarded read) so the four
    // data_X[cap_index] reads DCE = R3 drops → the data array is 1R1W (the ternary-let
    // would NOT DCE — the L2 P3.b lesson). Byte-identical at 0 (the live per-source read).
    var cap_data: logic<64> [8];
    always_comb {
        for l in 0..8 {
            cap_data[l] = 64'd0;
        }
        if !DCACHE_CAP_DCE {
            for l in 0..8 {
                cap_data[l] = if cap_way == 2'd0 ?
                    data_0[cap_index][l*64 +: 64]
                : if cap_way == 2'd1 ?
                    data_1[cap_index][l*64 +: 64]
                : if cap_way == 2'd2 ?
                    data_2[cap_index][l*64 +: 64]
                :
                    data_3[cap_index][l*64 +: 64]
                ;
            }
        }
    }

    // DCACHE_DATA_1RW: single muxed byte-write-enable write per data bank. The
    // four writers are mutually exclusive per cycle, so one global (idx,new,msk)
    // tuple describes whichever fires; only the per-bank fire (way select)
    // differs. new/msk build the raw write data + per-byte mask so the SRAM
    // byte-enable performs the merge with the retention read (data_k[idx]) at the
    // write port — no separate old-line read (byte-identical to wr_dword+merge).
    //   idle store (plain store-merge OR AMO/SC): dword `offset`, bytes i_wstrb;
    //     amocas.q additionally writes the full hi dword (offset+1) = i_wdata_hi.
    //   fill beat: full dword `fill_woff` = i_mem_rdata.
    //   store drain: per-lane byte-merge (i_swstrb → mask, i_swdata → new).
    let d1_idle_fire : logic = (wen_fires && i_wstrb_hi == 8'd0 && cache_hit) || wenl_fires;
    let d1_fill_fire : logic = filling && i_memr_grant;
    let d1_drain_fire: logic = store_can_drain;
    let d1_aq_off_hi : logic<3> = offset + 3'd1;
    let d1_amo_hi    : logic = wenl_fires && i_wen_excl_q;
    let d1_idle_new  : logic<512> = wr_dword(512'd0, offset, i_wdata)
     | (if d1_amo_hi ? wr_dword(512'd0, d1_aq_off_hi, i_wdata_hi) : 512'd0);
    let d1_idle_msk  : logic<512> = wr_dword(512'd0, offset, be_expand(i_wstrb))
     | (if d1_amo_hi ? wr_dword(512'd0, d1_aq_off_hi, {1'b1 repeat 64}) : 512'd0);
    let d1_fill_new  : logic<512> = wr_dword(512'd0, fill_woff, i_mem_rdata);
    let d1_fill_msk  : logic<512> = wr_dword(512'd0, fill_woff, {1'b1 repeat 64});
    let d1_drain_new : logic<512> = {
        i_swdata[7], i_swdata[6], i_swdata[5], i_swdata[4],
        i_swdata[3], i_swdata[2], i_swdata[1], i_swdata[0]
    };
    let d1_drain_msk : logic<512> = {
        be_expand(i_swstrb[7]), be_expand(i_swstrb[6]), be_expand(i_swstrb[5]), be_expand(i_swstrb[4]),
        be_expand(i_swstrb[3]), be_expand(i_swstrb[2]), be_expand(i_swstrb[1]), be_expand(i_swstrb[0])
    };
    let d1_idx: logic<INDEX_W> = if d1_fill_fire ? fill_index : if d1_drain_fire ? sindex : index;
    let d1_new: logic<512>     = if d1_fill_fire ? d1_fill_new : if d1_drain_fire ? d1_drain_new : d1_idle_new;
    let d1_msk: logic<512>     = if d1_fill_fire ? d1_fill_msk : if d1_drain_fire ? d1_drain_msk : d1_idle_msk;
    let d1_fire_0: logic = (d1_idle_fire && hit_0) || (d1_fill_fire && fill_way == 2'd0) || (d1_drain_fire && shit_0);
    let d1_fire_1: logic = (d1_idle_fire && hit_1) || (d1_fill_fire && fill_way == 2'd1) || (d1_drain_fire && shit_1);
    let d1_fire_2: logic = (d1_idle_fire && hit_2) || (d1_fill_fire && fill_way == 2'd2) || (d1_drain_fire && shit_2);
    let d1_fire_3: logic = (d1_idle_fire && hit_3) || (d1_fill_fire && fill_way == 2'd3) || (d1_drain_fire && shit_3);

    always_ff (clk, rst) {
        if_reset {
            state        = State::IDLE;
            fill_count   = 3'd0;
            fill_index   = 4'd0;
            fill_tag     = '0;
            fill_way     = 2'd0;
            fill_offset  = 3'd0;
            fill_aborted = 1'b0;
            fill_rfo     = 1'b0;
            wb_v         = 1'b0;
            wb_line      = '0;
            fl_active    = 1'b0;
            fl_idx       = '0;
            fl_done_q    = 1'b0;
            for l in 0..8 {
                wb_data[l] = 64'd0;
            }
            for i in 0..SETS {
                valid_0[i] = 1'b0;
                valid_1[i] = 1'b0;
                valid_2[i] = 1'b0;
                valid_3[i] = 1'b0;
                excl_0[i]  = 1'b0;
                excl_1[i]  = 1'b0;
                excl_2[i]  = 1'b0;
                excl_3[i]  = 1'b0;
                dirty_0[i] = 1'b0;
                dirty_1[i] = 1'b0;
                dirty_2[i] = 1'b0;
                dirty_3[i] = 1'b0;
            }
        } else {
            case state {
                State::IDLE: {
                    // (P9.3: the M9.4 AMO force-miss invalidate is gone — an
                    // AMO/LR read serves from an owned hit or RFO-fills.)
                    // Phase 5: gate fill start and write-through on bus grant.
                    // Without grant we hold the IDLE state and stall the pipe;
                    // memory_bus arbitrates between harts and holds grant for
                    // the entire 8-cycle FILL burst once we transition.
                    // S23: a remote write can now land the SAME cycle a fill
                    // starts (independent write channel) — the FILL-state inv
                    // check below sees state==IDLE this cycle and would miss
                    // it, so seed fill_aborted from the same-cycle invalidate.
                    // P9.2: load misses and store-RFO fills share this path
                    // (load_sel/srfo_sel selection); a DIRTY victim is
                    // captured into the writeback buffer here (guaranteed
                    // free — fill_blocked_wb holds the start otherwise).
                    if fill_start_fire {
                        if vic_dirty {
                            wb_v    = 1'b1;
                            wb_line = {vic_tag, f_index};
                            if !CAP_FILL_1R {
                                for l in 0..8 {
                                    wb_data[l] = cap_data[l];
                                }
                            }
                            if victim_way == 2'd0 {
                                dirty_0[f_index] = 1'b0;
                            }
                            if victim_way == 2'd1 {
                                dirty_1[f_index] = 1'b0;
                            }
                            if victim_way == 2'd2 {
                                dirty_2[f_index] = 1'b0;
                            }
                            if victim_way == 2'd3 {
                                dirty_3[f_index] = 1'b0;
                            }
                        }
                        fill_index   = f_index;
                        fill_tag     = f_tag;
                        fill_way     = victim_way;
                        fill_offset  = f_offset;
                        fill_count   = 3'd0;
                        fill_rfo     = f_rfo;
                        fill_aborted = (i_inv_valid && inv_index == f_index && inv_tag == f_tag)
                            || (i_inv2_valid && inv2_index == f_index && inv2_tag == f_tag);
                        state = State::FILL;
                    }
                    // Write-through (i_wen: AMO/LR-SC, misaligned, MMIO, slow
                    // stores): update cache on write hit. Only commit the
                    // cache change + DRAM write when the write actually fires
                    // (wen_fires: granted, buffer not occupying the channel,
                    // no pending misaligned dirty detour) so the local merge
                    // and the DRAM emission stay in lockstep.
                    if wen_fires {
                        if i_wstrb_hi != 8'd0 {
                            // M8.B (B.3): misaligned 2-dword STORE. tb gets the
                            // lo dword (mem-side write-through below, o_mem_wen)
                            // and the hi dword (core o_dmem_wdata_hi bypass). The
                            // dcache can't hold the partial result, so invalidate
                            // any cached way for both touched lines (lo + next);
                            // a later load refills the merged bytes from memory.
                            if hit_0 {
                                valid_0[index] = 1'b0;
                            }
                            if hit_1 {
                                valid_1[index] = 1'b0;
                            }
                            if hit_2 {
                                valid_2[index] = 1'b0;
                            }
                            if hit_3 {
                                valid_3[index] = 1'b0;
                            }
                            if next_hit_0 {
                                valid_0[next_index] = 1'b0;
                            }
                            if next_hit_1 {
                                valid_1[next_index] = 1'b0;
                            }
                            if next_hit_2 {
                                valid_2[next_index] = 1'b0;
                            }
                            if next_hit_3 {
                                valid_3[next_index] = 1'b0;
                            }
                        } else if cache_hit {
                            let old   : logic<64> = if hit_0 ?
                                rdata_0
                            : if hit_1 ?
                                rdata_1
                            : if hit_2 ?
                                rdata_2
                            :
                                rdata_3
                            ;
                            let merged: logic<64> = merge_dword(old, i_wstrb, i_wdata);
                            if !DCACHE_DATA_1RW {
                                if hit_0 {
                                    data_0[index] = wr_dword(data_0[index], offset, merged);
                                }
                                if hit_1 {
                                    data_1[index] = wr_dword(data_1[index], offset, merged);
                                }
                                if hit_2 {
                                    data_2[index] = wr_dword(data_2[index], offset, merged);
                                }
                                if hit_3 {
                                    data_3[index] = wr_dword(data_3[index], offset, merged);
                                }
                            }
                        }
                        // P9.2: a write-through MISS needs no local action
                        // (the pre-P9.2 victim invalidate was a no-allocate
                        // artifact; under MESI it would evict an innocent —
                        // possibly dirty — line for nothing).
                    }
                    // P9.3: in-cache AMO/SC commit write — merge into the
                    // owned way, line goes M. Aligned single-dword by ISA
                    // (wstrb_hi never set for AMO/SC).
                    if wenl_fires {
                        let lold   : logic<64> = if hit_0 ?
                            rdata_0
                        : if hit_1 ?
                            rdata_1
                        : if hit_2 ?
                            rdata_2
                        :
                            rdata_3
                        ;
                        let lmerged: logic<64> = merge_dword(lold, i_wstrb, i_wdata);
                        // Zacas amocas.q also writes the HI dword (i_addr+8). 16-byte
                        // aligned ⇒ same owned line, so dword offset+1 stays in-line.
                        // Both dwords ride ONE whole-line write — a second write to
                        // the same line element would last-write-wins and drop the lo.
                        // (The two wr_dword calls go through a `let` so they are not
                        // nested — a nested same-function call cannot be inlined.)
                        let aq_off_hi: logic<3> = offset + 3'd1;
                        if hit_0 {
                            if !DCACHE_DATA_1RW {
                                let base0: logic<512> = wr_dword(data_0[index], offset, lmerged);
                                data_0[index] = if i_wen_excl_q ? wr_dword(base0, aq_off_hi, i_wdata_hi) : base0;
                            }
                            dirty_0[index] = 1'b1;
                        }
                        if hit_1 {
                            if !DCACHE_DATA_1RW {
                                let base1: logic<512> = wr_dword(data_1[index], offset, lmerged);
                                data_1[index] = if i_wen_excl_q ? wr_dword(base1, aq_off_hi, i_wdata_hi) : base1;
                            }
                            dirty_1[index] = 1'b1;
                        }
                        if hit_2 {
                            if !DCACHE_DATA_1RW {
                                let base2: logic<512> = wr_dword(data_2[index], offset, lmerged);
                                data_2[index] = if i_wen_excl_q ? wr_dword(base2, aq_off_hi, i_wdata_hi) : base2;
                            }
                            dirty_2[index] = 1'b1;
                        }
                        if hit_3 {
                            if !DCACHE_DATA_1RW {
                                let base3: logic<512> = wr_dword(data_3[index], offset, lmerged);
                                data_3[index] = if i_wen_excl_q ? wr_dword(base3, aq_off_hi, i_wdata_hi) : base3;
                            }
                            dirty_3[index] = 1'b1;
                        }
                    }
                }
                State::FILL: {
                    // Phase 5: only write fill data and advance the count when
                    // bus is granted. memory_bus is expected to hold grant for
                    // the entire 8-cycle burst once a fill starts.
                    // P9.1: a remote invalidate landing on the COMPLETION cycle
                    // must not be lost — the `if i_inv_valid` block below runs
                    // after this case arm, so the valid write here would use the
                    // stale (pre-invalidate) fill_aborted and leave a stale line
                    // valid. Fold the same-cycle invalidate in directly. (Pre-
                    // P9.1 a non-holder's fill could not complete while a remote
                    // hart held the AMO bus lock — the burst needed per-beat bus
                    // grants — so the litmus barrier never hit this; with
                    // mem_ctrl's bus-independent STREAM beats it does.)
                    // P9.2: either inv port + a same-cycle PROBE of the fill
                    // line (same completion-edge fold as the P9.1 inv fix).
                    let inv_hits_done: logic = inv_fill_hit || (probe_act && p_fill_hit);
                    if i_memr_grant {
                        // Per-beat RMW: drop dword fill_woff of this beat into the
                        // line, accumulating across the 8-beat burst.
                        if !DCACHE_DATA_1RW {
                            if fill_way == 2'd0 {
                                data_0[fill_index] = wr_dword(data_0[fill_index], fill_woff, i_mem_rdata);
                            }
                            if fill_way == 2'd1 {
                                data_1[fill_index] = wr_dword(data_1[fill_index], fill_woff, i_mem_rdata);
                            }
                            if fill_way == 2'd2 {
                                data_2[fill_index] = wr_dword(data_2[fill_index], fill_woff, i_mem_rdata);
                            }
                            if fill_way == 2'd3 {
                                data_3[fill_index] = wr_dword(data_3[fill_index], fill_woff, i_mem_rdata);
                            }
                        }
                        if fill_count == 3'd7 {
                            // Fill complete. If a remote invalidate hit this line
                            // mid-fill, leave valid=0 so the next access misses
                            // and re-fills. Tag write is harmless either way.
                            // P9.2: latch the home's grant state (E/M vs S);
                            // the line starts CLEAN (dirty comes from drain
                            // merges only).
                            if fill_way == 2'd0 {
                                tags_0[fill_index]  = fill_tag;
                                valid_0[fill_index] = !fill_aborted && !inv_hits_done;
                                excl_0[fill_index]  = i_fill_excl;
                                dirty_0[fill_index] = 1'b0;
                            }
                            if fill_way == 2'd1 {
                                tags_1[fill_index]  = fill_tag;
                                valid_1[fill_index] = !fill_aborted && !inv_hits_done;
                                excl_1[fill_index]  = i_fill_excl;
                                dirty_1[fill_index] = 1'b0;
                            }
                            if fill_way == 2'd2 {
                                tags_2[fill_index]  = fill_tag;
                                valid_2[fill_index] = !fill_aborted && !inv_hits_done;
                                excl_2[fill_index]  = i_fill_excl;
                                dirty_2[fill_index] = 1'b0;
                            }
                            if fill_way == 2'd3 {
                                tags_3[fill_index]  = fill_tag;
                                valid_3[fill_index] = !fill_aborted && !inv_hits_done;
                                excl_3[fill_index]  = i_fill_excl;
                                dirty_3[fill_index] = 1'b0;
                            }
                            state = State::DONE;
                        } else {
                            fill_count = fill_count + 3'd1;
                        }
                    }
                }
                State::DONE: {
                    state = State::IDLE;
                }
                default: {
                    state = State::IDLE;
                }
            }

            // P9.2 store drain = LOCAL MERGE into the owned (E/M) way — the
            // line goes M (dirty); NO bus transaction. A drain that cannot
            // merge raised the store-RFO fill instead (the IDLE arm above).
            // Aligned plain stores only; mutually exclusive with the i_wen
            // block at the core level. No PLRU update (replacement-policy
            // only).
            if store_can_drain {
                // Build the whole merged line combinationally (each populated lane
                // byte-merges, the rest pass through), then one line write per hit
                // way — the SRAM has no sub-word write port.
                if !DCACHE_DATA_1RW {
                    let s_old_line: logic<512> = if shit_0 ?
                        data_0[sindex]
                    : if shit_1 ?
                        data_1[sindex]
                    : if shit_2 ?
                        data_2[sindex]
                    :
                        data_3[sindex]
                    ;
                    let new_s_line: logic<512> = {
                        if i_swstrb[7] != 8'd0 ? merge_dword(s_old_line[511:448], i_swstrb[7], i_swdata[7]) : s_old_line[511:448],
                        if i_swstrb[6] != 8'd0 ? merge_dword(s_old_line[447:384], i_swstrb[6], i_swdata[6]) : s_old_line[447:384],
                        if i_swstrb[5] != 8'd0 ? merge_dword(s_old_line[383:320], i_swstrb[5], i_swdata[5]) : s_old_line[383:320],
                        if i_swstrb[4] != 8'd0 ? merge_dword(s_old_line[319:256], i_swstrb[4], i_swdata[4]) : s_old_line[319:256],
                        if i_swstrb[3] != 8'd0 ? merge_dword(s_old_line[255:192], i_swstrb[3], i_swdata[3]) : s_old_line[255:192],
                        if i_swstrb[2] != 8'd0 ? merge_dword(s_old_line[191:128], i_swstrb[2], i_swdata[2]) : s_old_line[191:128],
                        if i_swstrb[1] != 8'd0 ? merge_dword(s_old_line[127:64], i_swstrb[1], i_swdata[1]) : s_old_line[127:64],
                        if i_swstrb[0] != 8'd0 ? merge_dword(s_old_line[63:0], i_swstrb[0], i_swdata[0]) : s_old_line[63:0]
                    };
                    if shit_0 {
                        data_0[sindex] = new_s_line;
                    }
                    if shit_1 {
                        data_1[sindex] = new_s_line;
                    }
                    if shit_2 {
                        data_2[sindex] = new_s_line;
                    }
                    if shit_3 {
                        data_3[sindex] = new_s_line;
                    }
                }
                if shit_0 {
                    dirty_0[sindex] = 1'b1;
                }
                if shit_1 {
                    dirty_1[sindex] = 1'b1;
                }
                if shit_2 {
                    dirty_2[sindex] = 1'b1;
                }
                if shit_3 {
                    dirty_3[sindex] = 1'b1;
                }
            }

            // DCACHE_DATA_1RW: the single muxed byte-write-enable write per bank.
            // At most one of {plain store-merge, AMO/SC, fill beat, store drain}
            // fires this cycle, and each targets a one-hot way, so per bank at
            // most one d1_fire_k is set. The masked write folds the retention read
            // data_k[d1_idx] into the SRAM byte-enable → 1 write port + no old-line
            // read (data 8R4W → 7R1W). Byte-identical to the four gated writes:
            // for the firing bank data_k[d1_idx] IS the old line, and the mask
            // reproduces wr_dword(old, off, merge_dword(...)) exactly.
            if DCACHE_DATA_1RW {
                if d1_fire_0 {
                    data_0[d1_idx] = (data_0[d1_idx] & ~d1_msk) | (d1_new & d1_msk);
                }
                if d1_fire_1 {
                    data_1[d1_idx] = (data_1[d1_idx] & ~d1_msk) | (d1_new & d1_msk);
                }
                if d1_fire_2 {
                    data_2[d1_idx] = (data_2[d1_idx] & ~d1_msk) | (d1_new & d1_msk);
                }
                if d1_fire_3 {
                    data_3[d1_idx] = (data_3[d1_idx] & ~d1_msk) | (d1_new & d1_msk);
                }
            }

            // P9.2: full-line WRITE-THROUGH drain — drop our own (clean S)
            // copy; the home merges the line and invalidates the other
            // sharers. Keeping the local copy would leave it stale against
            // the bytes the home just took.
            if wt_fires {
                if shit_0 {
                    valid_0[sindex] = 1'b0;
                }
                if shit_1 {
                    valid_1[sindex] = 1'b0;
                }
                if shit_2 {
                    valid_2[sindex] = 1'b0;
                }
                if shit_3 {
                    valid_3[sindex] = 1'b0;
                }
            }

            // P9.2: misaligned-store dirty detour — capture+invalidate one
            // dirty touched line per cycle (lo first); the write itself is
            // held until both lines are clean (wen_fires gating).
            if cap_mis_go {
                wb_v = 1'b1;
                if !cap_mis_hi_sel {
                    wb_line = {tag, index};
                    if !CAP_MIS_1R {
                        for l in 0..8 {
                            wb_data[l] = cap_data[l];
                        }
                    }
                    if hit_0 {
                        valid_0[index] = 1'b0;
                        dirty_0[index] = 1'b0;
                    }
                    if hit_1 {
                        valid_1[index] = 1'b0;
                        dirty_1[index] = 1'b0;
                    }
                    if hit_2 {
                        valid_2[index] = 1'b0;
                        dirty_2[index] = 1'b0;
                    }
                    if hit_3 {
                        valid_3[index] = 1'b0;
                        dirty_3[index] = 1'b0;
                    }
                } else {
                    wb_line = {next_tag, next_index};
                    if !CAP_MIS_1R {
                        for l in 0..8 {
                            wb_data[l] = cap_data[l];
                        }
                    }
                    if next_hit_0 {
                        valid_0[next_index] = 1'b0;
                        dirty_0[next_index] = 1'b0;
                    }
                    if next_hit_1 {
                        valid_1[next_index] = 1'b0;
                        dirty_1[next_index] = 1'b0;
                    }
                    if next_hit_2 {
                        valid_2[next_index] = 1'b0;
                        dirty_2[next_index] = 1'b0;
                    }
                    if next_hit_3 {
                        valid_3[next_index] = 1'b0;
                        dirty_3[next_index] = 1'b0;
                    }
                }
            }

            // P9.2: PROBE (recall). A dirty copy is captured+invalidated
            // (the WB completes the recall at the home); a clean one is
            // invalidated with a same-cycle o_probe_ack. probe_act defers
            // to same-cycle users of the shared departure-event port.
            if probe_act {
                if p_dirty {
                    if cap_probe_go {
                        wb_v    = 1'b1;
                        wb_line = i_probe_addr[63:6];
                        if !CAP_PROBE_1R {
                            for l in 0..8 {
                                wb_data[l] = cap_data[l];
                            }
                        }
                        if phit_0 {
                            valid_0[p_index] = 1'b0;
                            dirty_0[p_index] = 1'b0;
                        }
                        if phit_1 {
                            valid_1[p_index] = 1'b0;
                            dirty_1[p_index] = 1'b0;
                        }
                        if phit_2 {
                            valid_2[p_index] = 1'b0;
                            dirty_2[p_index] = 1'b0;
                        }
                        if phit_3 {
                            valid_3[p_index] = 1'b0;
                            dirty_3[p_index] = 1'b0;
                        }
                    }
                } else {
                    if phit_0 {
                        valid_0[p_index] = 1'b0;
                    }
                    if phit_1 {
                        valid_1[p_index] = 1'b0;
                    }
                    if phit_2 {
                        valid_2[p_index] = 1'b0;
                    }
                    if phit_3 {
                        valid_3[p_index] = 1'b0;
                    }
                }
                // The probed line is mid-FILL here: abort it (see p_fill_hit).
                if p_fill_hit {
                    fill_aborted = 1'b1;
                }
            }

            // P9.2: FLUSH sweep (FENCE.I / SFENCE.VMA / satp): write back +
            // invalidate every dirty line; clean lines stay. One step per
            // cycle; a dirty target holds the scan until its capture wins
            // the buffer + departure-event arbitration.
            if !i_flush_req {
                fl_active = 1'b0;
                fl_done_q = 1'b0;
                fl_idx    = '0;
            } else if !fl_active && !fl_done_q {
                fl_active = 1'b1;
                fl_idx    = '0;
            } else if fl_active {
                if cap_flush_go {
                    wb_v    = 1'b1;
                    wb_line = {fl_tag, fl_set};
                    if !CAP_FLUSH_1R {
                        for l in 0..8 {
                            wb_data[l] = cap_data[l];
                        }
                    }
                    if fl_way == 2'd0 {
                        valid_0[fl_set] = 1'b0;
                        dirty_0[fl_set] = 1'b0;
                    }
                    if fl_way == 2'd1 {
                        valid_1[fl_set] = 1'b0;
                        dirty_1[fl_set] = 1'b0;
                    }
                    if fl_way == 2'd2 {
                        valid_2[fl_set] = 1'b0;
                        dirty_2[fl_set] = 1'b0;
                    }
                    if fl_way == 2'd3 {
                        valid_3[fl_set] = 1'b0;
                        dirty_3[fl_set] = 1'b0;
                    }
                }
                if fl_step {
                    // P9.4: at a set's way 0, if the whole set is clean, jump
                    // straight to the next set (skip ways 1-3). The set walk is
                    // then ~64 cycles + the few dirty ways, not 256.
                    if (fl_way == 2'd0) && fl_set_clean {
                        if fl_set == '1 {
                            fl_active = 1'b0;
                            fl_done_q = 1'b1;
                        } else {
                            fl_idx = {fl_set + 1, 2'd0};
                        }
                    } else if fl_idx == '1 {
                        fl_active = 1'b0;
                        fl_done_q = 1'b1;
                    } else {
                        fl_idx = fl_idx + 1;
                    }
                }
            }

            // P9.2: writeback-buffer drain (the buffer outranks i_wen on the
            // write channel; captures never coincide with the fire — they
            // all require the buffer free).
            if wb_fire {
                wb_v = 1'b0;
            }

            // Update PLRU on cache hit (point tree AWAY from accessed way)
            if cache_hit && cpu_req && !filling {
                if hit_way[1] == 1'b0 {
                    plru[index][2] = 1'b1;
                    plru[index][1] = if hit_way[0] ? 1'b0 : 1'b1;
                } else {
                    plru[index][2] = 1'b0;
                    plru[index][0] = if hit_way[0] ? 1'b0 : 1'b1;
                }
            }

            // Remote invalidate: clear valid for matching tag in any way.
            // If the line currently being filled matches, latch fill_aborted
            // so the FILL completion does not set valid (forcing a re-fill on
            // the next access).
            if i_inv_valid {
                if valid_0[inv_index] && tags_0[inv_index] == inv_tag {
                    valid_0[inv_index] = 1'b0;
                }
                if valid_1[inv_index] && tags_1[inv_index] == inv_tag {
                    valid_1[inv_index] = 1'b0;
                }
                if valid_2[inv_index] && tags_2[inv_index] == inv_tag {
                    valid_2[inv_index] = 1'b0;
                }
                if valid_3[inv_index] && tags_3[inv_index] == inv_tag {
                    valid_3[inv_index] = 1'b0;
                }
                if state == State::FILL && fill_index == inv_index && fill_tag == inv_tag {
                    fill_aborted = 1'b1;
                }
            }
            // P9.2: second invalidate port — identical handling.
            if i_inv2_valid {
                if valid_0[inv2_index] && tags_0[inv2_index] == inv2_tag {
                    valid_0[inv2_index] = 1'b0;
                }
                if valid_1[inv2_index] && tags_1[inv2_index] == inv2_tag {
                    valid_1[inv2_index] = 1'b0;
                }
                if valid_2[inv2_index] && tags_2[inv2_index] == inv2_tag {
                    valid_2[inv2_index] = 1'b0;
                }
                if valid_3[inv2_index] && tags_3[inv2_index] == inv2_tag {
                    valid_3[inv2_index] = 1'b0;
                }
                if state == State::FILL && fill_index == inv2_index && fill_tag == inv2_tag {
                    fill_aborted = 1'b1;
                }
            }

        }
    }

    // ============================================================
    // goal-b SRAM S0 (cp_dcache_sync_read_plan §13): the single synchronous READ
    // port (see the DCACHE_DATA_READ_1R const above). The arbiter presents ONE
    // index per cycle (priority demand > cap > next > fill-DONE) and registers the
    // four-way line read; the demand registered read (R2) is the first consumer.
    // DEAD at 0 (rd1_data_* reset-only → DCE, the o_rdata const-mux folds to
    // dhit_rdata_d). Slot-1 (index2/next_index2, defined below o_rdata) joins the
    // arbiter in S4. Priority mux is byte-independent of which requester wins at 1.
    // ============================================================
    // 14.3-f cross-line serialize state. A cross-line misaligned load (i_load_next,
    // offset==7) with BOTH lines cached needs a SECOND registered read for the hi line
    // (data_X[next_index]) — the last R4 consumer. xline_ph_q sequences the single
    // registered port: phase 0 presents the lo line (index), phase 1 the hi line
    // (next_index). xline_lo_q holds the captured lo dword (with a write-forward bypass)
    // across the hi read so both deliver on the final cycle. DEAD at 0 (DCACHE_NF_XLINE
    // → the phase never advances, nf_rd_* fold to the lo line = byte-identical).
    var xline_ph_q: logic     ; // 0 = presenting lo (index), 1 = presenting hi (next_index)
    var xline_lo_q: logic<64> ; // captured lo dword, held (bypassed) across the hi read
    let xline_arm : logic     = DCACHE_NF_XLINE && i_ren && i_load_next && !next_same_line && cache_hit && next_line_hit;
    // The nf read's current target line: lo (phase 0) or hi (phase 1, cross-line only).
    let nf_rd_index: logic<INDEX_W> = if DCACHE_NF_XLINE && xline_ph_q ? next_index : index;
    let nf_rd_tag  : logic<TAG_W>   = if DCACHE_NF_XLINE && xline_ph_q ? next_tag : tag;
    let nf_rd_way  : logic<2>       = if DCACHE_NF_XLINE && xline_ph_q ? next_hit_way : hit_way;
    let rd1_req_demand: logic = i_ren_r; // Stage-A demand read (→ dhit at Stage-D)
    // 14.3-a (§14): the non-folded reads (AMO / misaligned-lo / streaming) have no
    // Stage-A strobe, so they present `index` LIVE at Stage-B here, below the folded
    // demand (priority demand > nf: a folded Stage-A read `index_r` wins a same-cycle
    // port conflict; nf then stalls a cycle — the §14.2-a contention). DEAD scaffold:
    // rd1_req_nf feeds only rd1_index (DCE'd at 0) and the nf-Stage-A regs below
    // (reset-only at 0). Delivery reroute is 14.3-c/d.
    let rd1_req_nf    : logic = i_ren && !dhit_use && !i_uncached;
    let rd1_req_cap   : logic = cap_fill_go || cap_probe_go || cap_mis_go || cap_flush_go;
    let rd1_req_next  : logic = i_ren && i_load_next; // cross-line misaligned hi dword
    // 14.13: an ENABLED cap capture (cap_go_latch) takes the port with TOP priority so
    // its whole line registers into rd1_data for next cycle's wb_data latch; a folded
    // demand load preempted here replays via the dhit squash (dhit_cap_pre_q). At
    // DCACHE_CAP_1R=0 cap_go_latch=0, so cap falls back to its original low-priority slot
    // (rd1_req_cap below) = byte-identical.
    let rd1_index: logic<INDEX_W> = if cap_go_latch ?
        cap_index
    : if rd1_req_demand ?
        index_r
    : if rd1_req_nf ?
        nf_rd_index
    : if rd1_req_cap ?
        cap_index
    : if rd1_req_next ?
        next_index
    :
        fill_index // fill-DONE re-read / benign idle default
    ;
    var rd1_data_0: logic<512>;
    var rd1_data_1: logic<512>;
    var rd1_data_2: logic<512>;
    var rd1_data_3: logic<512>;
    always_ff (clk, rst) {
        if_reset {
            rd1_data_0 = '0;
            rd1_data_1 = '0;
            rd1_data_2 = '0;
            rd1_data_3 = '0;
        } else if DCACHE_DATA_READ_1R {
            // Write-forward bypass (§14.7 — the S1 NBA hang fix): a real 1R1W SRAM
            // registered read is read-OLD w.r.t. a same-cycle write to the same index
            // (NBA / Verilator). The =0 live read is read-NEW (it reads data_X
            // combinationally at Stage-B, AFTER the store landed), so without this
            // bypass rd1_data lags one write-generation for a store that writes the
            // read line THIS cycle — a just-drained store the store buffer no longer
            // forwards → a stale demand load → boot wedge on Verilator (the Veryl sim
            // masks it by evaluating the write before the read = read-NEW). Forward
            // the merged write per way when it fires to rd1_index (write-first). No new
            // read port (same data_k[rd1_index] net + the already-computed d1_new/msk).
            rd1_data_0 = if d1_fire_0 && (d1_idx == rd1_index) ? (data_0[rd1_index] & ~d1_msk) | (d1_new & d1_msk) : data_0[rd1_index];
            rd1_data_1 = if d1_fire_1 && (d1_idx == rd1_index) ? (data_1[rd1_index] & ~d1_msk) | (d1_new & d1_msk) : data_1[rd1_index];
            rd1_data_2 = if d1_fire_2 && (d1_idx == rd1_index) ? (data_2[rd1_index] & ~d1_msk) | (d1_new & d1_msk) : data_2[rd1_index];
            rd1_data_3 = if d1_fire_3 && (d1_idx == rd1_index) ? (data_3[rd1_index] & ~d1_msk) | (d1_new & d1_msk) : data_3[rd1_index];
        }
    }
    // ── 14.13: R3 cap → 1R1W — the +1-latch writeback capture off the registered read ──
    // cap_go_latch presented cap_index at TOP priority last cycle, so rd1_data now holds
    // the cap line; latch it into wb_data_lat (the folded writeback data). cap_way_q =
    // the cap source's way (registered at cap_go_latch); rd1_cap_line = rd1_data[cap_way_q].
    // wb_folded_q marks the current wb_v as fold-sourced (so the o_memw_wdata mux + the
    // drain-ready gate pick wb_data_lat / wb_data_rdy_q; a disabled/live source keeps the
    // combinational wb_data and drains immediately). dhit_cap_pre_q = a folded demand HIT
    // preempted by the cap present, replayed next cycle via the dhit squash. DEAD at 0
    // (DCACHE_CAP_1R=0 → the else-if never runs, all reset-only → DCE). The cap-latch vars
    // are declared up by wb_data (the drain-ready gate wb_fire reads wb_folded_q/rdy).
    let rd1_cap_line: logic<512> = if cap_way_q == 2'd0 ?
        rd1_data_0
    : if cap_way_q == 2'd1 ?
        rd1_data_1
    : if cap_way_q == 2'd2 ?
        rd1_data_2
    :
        rd1_data_3
    ;
    always_ff (clk, rst) {
        if_reset {
            cap_way_q      = 2'd0;
            cap_pending_q  = 1'b0;
            wb_folded_q    = 1'b0;
            wb_data_rdy_q  = 1'b0;
            dhit_cap_pre_q = 1'b0;
            for l in 0..8 {
                wb_data_lat[l] = 64'd0;
            }
        } else if DCACHE_CAP_1R {
            cap_pending_q  = cap_go_latch;
            dhit_cap_pre_q = cap_go_latch && i_ren_r && cache_hit_r;
            if cap_go_latch {
                cap_way_q   = cap_way;
                wb_folded_q = 1'b1;
            }
            if cap_pending_q {
                for l in 0..8 {
                    wb_data_lat[l] = rd1_cap_line[l*64 +: 64];
                }
                wb_data_rdy_q = 1'b1;
            }
            if wb_fire {
                wb_data_rdy_q = 1'b0;
                wb_folded_q   = 1'b0;
            }
        }
    }
    // 14.3-c (§14.5): the nf handshake — deliver the non-folded AMO / misaligned-lo
    // HIT dword from the registered read (rd1_data_*) instead of the live
    // data_X[index] (R1). A non-folded read presents `index` at Stage-B (rd1_req_nf
    // above); it WINS the single read port only when demand isn't requesting
    // (priority demand > nf). nf_won_q marks "nf won last cycle → its four-way line
    // is in rd1_data_*"; nf_addr_q records WHICH line, so a still-held request (same
    // {tag,index}) delivers from the register and a NEW request to a different line
    // re-reads (nf_reg_stall) rather than misdelivering the stale line. The reroute
    // + stall apply to the blocking-path reads (i_amo_read / i_load_next, which
    // o_hit_safe excludes) AND — under DCACHE_NF_REPLAY (14.3-e) — the REPLAY
    // (non-folded ordinary hit), R1's last live consumer. Streaming stays LIVE via
    // fill_crit_q (14.3-d, cache_hit=0 so it never reaches nf_hit_sel/nf_reg_stall).
    // DEAD at 0 (else-if DCACHE_DATA_READ_1R → reset-only → DCE; nf_ready/nf_reg_stall
    // const-fold to 0).
    // 14.3-e: the replay is a non-folded read (rd1_req_nf) that is neither AMO nor
    // misaligned. rd1_req_nf ⊇ {AMO, misaligned}, so nf_reroute reduces to rd1_req_nf
    // at DCACHE_NF_REPLAY=1 (the unified R1→R2 fold). Streaming (rd1_req_nf, cache_hit
    // =0) is included but harmless — nf_hit_sel/nf_reg_stall are cache_hit-gated.
    let nf_replay : logic = rd1_req_nf && !i_amo_read && !i_load_next; // MSHR replay re-read
    let nf_reroute: logic = i_amo_read || i_load_next || (DCACHE_NF_REPLAY && nf_replay);
    // 14.13: cap_go_latch takes the port at TOP priority (above nf), so nf did NOT win
    // when a cap capture fires — without this exclusion nf_won_q/nf_ready would deliver
    // the cap line (wrong) to an AMO/replay/misaligned nf read a cap probe preempted.
    let nf_won    : logic = rd1_req_nf && !rd1_req_demand && !cap_go_latch; // nf takes the read port this cycle
    var nf_won_q  : logic    ; // nf won the read port last cycle (line now in rd1_data_*)
    var nf_addr_q : logic<58>; // {tag,index} of that registered nf line (lo or, in the
    //                            xline serialize phase 1, the hi line — nf_rd_tag/index)
    always_ff (clk, rst) {
        if_reset {
            nf_won_q  = 1'b0;
            nf_addr_q = '0;
        } else if DCACHE_DATA_READ_1R {
            nf_won_q = nf_won;
            if nf_won {
                nf_addr_q = {nf_rd_tag, nf_rd_index};
            }
        }
    }
    // nf_ready: the registered nf line is present AND is the current request's line,
    // so the demanded dword extracts from it at the LIVE offset (the full 512-bit
    // line is registered). In the xline serialize the target switches to {next_tag,
    // next_index} in phase 1, so nf_ready re-asserts only once the hi line registers.
    // Const-0 at 0.
    let nf_ready: logic = DCACHE_DATA_READ_1R && nf_won_q && ({nf_rd_tag, nf_rd_index} == nf_addr_q);
    // The +1 registered-read stall for an AMO/misaligned-lo HIT: hold until nf owns
    // the line in rd1_data_* (nf_ready). Excludes streaming/miss (cache_hit=0 there;
    // the miss path / nf_gap_stall covers those). Requires i_ren: nf can only make
    // progress toward nf_ready when the read is actually driven (nf_won needs
    // rd1_req_nf → i_ren); stalling while i_ren=0 (port yielded to a store) would
    // deadlock (stall high, but nf can never win). The AMO clean-hit pin (pin_arm_hit,
    // combinational on this same cycle) covers the extra cycle, so the +1 does NOT
    // open a new remote-recall window — the §14.2-b make-or-break. Feeds o_stall.
    // nf_deliver_ready: for a cross-line load the read takes TWO registered reads (lo
    // then hi), so the stall holds until the hi phase (xline_ph_q) is ready. Folds to
    // nf_ready for every non-xline access (AMO / misaligned-lo / same-line / replay).
    let nf_deliver_ready: logic = nf_ready && (!xline_arm || xline_ph_q);
    let nf_reg_stall: logic = DCACHE_NF_REROUTE && i_ren && nf_reroute && cache_hit && !nf_deliver_ready;
    // rd1_nf_line: the registered four-way line selected by the current read's hit way
    // (a {tag,index} match means the line is unchanged, so the hit way still names it).
    // In the xline serialize phase 1 nf_rd_way = next_hit_way selects the hi line.
    // rd1_nf_rdata / rd1_next_same (below) extract the lo / misaligned-hi dwords.
    let rd1_nf_line : logic<512> = if nf_rd_way == 2'd0 ?
        rd1_data_0
    : if nf_rd_way == 2'd1 ?
        rd1_data_1
    : if nf_rd_way == 2'd2 ?
        rd1_data_2
    :
        rd1_data_3
    ;
    let rd1_nf_rdata: logic<64> = rd_dword(rd1_nf_line, offset);
    // Demand registered read off the arbitrated port: the folded plain load's
    // Stage-D delivery sourced from the SRAM output register (rd1_data_*, index
    // presented last cycle) instead of the fake-flop comb read data_X[dhit_index_d].
    let rd1_dhit_line: logic<512> = if dhit_way_q == 2'd0 ?
        rd1_data_0
    : if dhit_way_q == 2'd1 ?
        rd1_data_1
    : if dhit_way_q == 2'd2 ?
        rd1_data_2
    :
        rd1_data_3
    ;
    let rd1_dhit_rdata: logic<64> = rd_dword(rd1_dhit_line, dhit_off_q);

    // 14.3-f cross-line serialize: sequence the single registered port over the two
    // lines. Phase 0 presents the lo line (index) — the existing nf read; on nf_ready
    // capture the lo dword (rd1_nf_rdata, already write-forward-bypassed for the
    // same-cycle store via rd1_data_*) and advance to phase 1, which presents the hi
    // line (next_index). While the lo dword is HELD it is kept current with a §14.7
    // write-forward bypass for a store draining to the lo line (a d1_fire to the lo way
    // at index — e.g. the concurrent store-drain at sindex==index): both the capture
    // (base = rd1_nf_rdata, reflecting stores ≤ C-1) and every hold cycle (base =
    // xline_lo_q) merge the this-cycle store so the delivery matches the =0 live read.
    // Reset to phase 0 whenever not arming (load done / miss / not cross-line). DEAD at
    // 0 (DCACHE_NF_XLINE → reset-only → DCE).
    let xline_lo_wr      : logic     = ((d1_fire_0 && hit_way == 2'd0) || (d1_fire_1 && hit_way == 2'd1) || (d1_fire_2 && hit_way == 2'd2) || (d1_fire_3 && hit_way == 2'd3)) && (d1_idx == index);
    let xline_lo_byp_cap : logic<64> = (rd1_nf_rdata & ~rd_dword(d1_msk, offset)) | (rd_dword(d1_new, offset) & rd_dword(d1_msk, offset));
    let xline_lo_byp_hold: logic<64> = (xline_lo_q & ~rd_dword(d1_msk, offset)) | (rd_dword(d1_new, offset) & rd_dword(d1_msk, offset));
    always_ff (clk, rst) {
        if_reset {
            xline_ph_q = 1'b0;
            xline_lo_q = 64'd0;
        } else if DCACHE_NF_XLINE {
            if xline_arm {
                if !xline_ph_q {
                    if nf_ready {
                        // phase 0 done: lo line registered. Capture the lo dword (merge a
                        // store draining to the lo line THIS cycle) and start the hi read.
                        xline_lo_q = if xline_lo_wr ? xline_lo_byp_cap : rd1_nf_rdata;
                        xline_ph_q = 1'b1;
                    }
                } else {
                    // phase 1: keep the held lo dword current while the hi line registers.
                    if xline_lo_wr {
                        xline_lo_q = xline_lo_byp_hold;
                    }
                }
            } else {
                xline_ph_q = 1'b0;
            }
        }
    }

    // Read data: from hit way on cache hit, from the fill way for a streaming
    // hit (S14.1; the raw hits are all 0 then — the new line's tag is not
    // written yet and the victim's old tag cannot equal it), from memory
    // during fill (legacy fallback, gated by o_data_valid at the consumers).
    // delta-5: at =1 the demand hit delivers off the registered Stage-A read
    // (dhit_rdata_d); miss/stream/uncached stay live. =0 arm = exact original.
    // S0: the demand registered read routes through the arbitrated port
    // (rd1_dhit_rdata) at DCACHE_DATA_READ_1R=1; the const-mux folds to
    // dhit_rdata_d at 0 = byte-identical.
    // 14.3-c: at =1 the AMO/misaligned-lo HIT dword comes from the registered read
    // (rd1_nf_rdata, +1 late, gated on nf_reroute); replay/streaming and the miss/mem
    // fallback stay live. At 0 nf_hit_sel folds to the live hit mux = exact original.
    let live_hit_rdata: logic<64> = if hit_0 ? rdata_0 : if hit_1 ? rdata_1 : if hit_2 ? rdata_2 : rdata_3;
    // 14.3-f: in the xline serialize phase 1 the registered port holds the HI line, so
    // the lo dword comes from the held xline_lo_q (o_stall keeps the core off it until
    // the final delivery cycle, where lo = xline_lo_q and hi = rd1_next_same together).
    let nf_hit_sel    : logic<64> = if DCACHE_NF_XLINE && xline_ph_q ? xline_lo_q : if DCACHE_NF_REROUTE && nf_reroute ? rd1_nf_rdata : live_hit_rdata;
    let o_rdata_live  : logic<64> = if cache_hit ? nf_hit_sel : if stream_hit0 ? stream_rdata0 : i_mem_rdata;
    let dhit_rdata_sel: logic<64> = if S1_DEMAND ? rd1_dhit_rdata : dhit_rdata_d;
    assign o_rdata = if uncached_active ? i_mem_rdata : if DCACHE_SYNC_READ ? (if dhit_use ? (if dhit_v_q ? dhit_rdata_sel : if stream_hit0 ? stream_rdata0 : i_mem_rdata) : o_rdata_live) : o_rdata_live;

    // M8.B: next-dword read for misaligned 2-dword loads (decode moved up to the
    // miss-handling section). Same line ⇒ reuse the lo-access hit way; cross line
    // ⇒ pick the next line's hit way (filled by the hi_miss second fill above).
    // o_rdata_next_miss = a read is active and the next dword's line is not
    // cached (informational; the hi_miss path already stalls cross-line loads).
    // 14.3-f R4 DCE: both next-line reads (data_X[next_index]) as const-guarded
    // STATEMENT blocks so the read port DCEs at DCACHE_R4_DCE=1 (a ternary let would
    // NOT drop the port — the L2 P3.b lesson). At =1 the same-line hi comes from
    // rd1_next_same (nf_reroute) and the cross-line hi from rd1_next_same on the
    // registered hi line (the xline serialize), so neither block is consumed. Default 0.
    var next_rdata_same : logic<64>;
    var next_rdata_xline: logic<64>;
    always_comb {
        next_rdata_same  = 64'd0;
        next_rdata_xline = 64'd0;
        if !DCACHE_R4_DCE {
            next_rdata_same = if hit_0 ?
                rd_dword(data_0[next_index], next_offset)
            : if hit_1 ?
                rd_dword(data_1[next_index], next_offset)
            : if hit_2 ?
                rd_dword(data_2[next_index], next_offset)
            :
                rd_dword(data_3[next_index], next_offset)
            ;
            next_rdata_xline = if next_hit_0 ?
                rd_dword(data_0[next_index], next_offset)
            : if next_hit_1 ?
                rd_dword(data_1[next_index], next_offset)
            : if next_hit_2 ?
                rd_dword(data_2[next_index], next_offset)
            :
                rd_dword(data_3[next_index], next_offset)
            ;
        }
    }
    // 14.3-c (§14.5): at =1 the same-line misaligned hi dword extracts from the nf
    // registered line (rd1_nf_line) at the LIVE next_offset (the {tag,index} match in
    // nf_ready makes the full 512-bit line valid, so any dword is exact) — no separate
    // data_X[next_index] read (this absorbs R4's same-line usage). Gated on nf_reroute
    // (a misaligned load is i_load_next).
    // 14.3-f: the CROSS-line hi dword is served from rd1_next_same too — the xline
    // serialize registers the HI line (nf_rd_way = next_hit_way) into rd1_nf_line by
    // phase 1, so rd_dword(rd1_nf_line, next_offset) IS the hi dword on the delivery
    // cycle (o_stall holds the core off it until then). Removes the last R4 read. At 0
    // (DCACHE_NF_XLINE) folds back to the live next_rdata_xline = exact original.
    let rd1_next_same       : logic<64> = rd_dword(rd1_nf_line, next_offset);
    let next_rdata_same_sel : logic<64> = if DCACHE_NF_REROUTE && nf_reroute ? rd1_next_same : next_rdata_same;
    assign o_rdata_next      = if next_same_line ? next_rdata_same_sel : if DCACHE_NF_XLINE ? rd1_next_same : next_rdata_xline;
    assign o_rdata_next_miss = i_ren && (if next_same_line ? !cache_hit : !next_line_hit);

    // Memory interface — S23 split, P9.2 rework.
    // READ channel: fill bursts + the fill-start read (load miss or
    // store-RFO; o_memr_rfo tells the home to grant ownership).
    // WRITE channel: the WRITEBACK BUFFER (full dirty line, o_memw_wb) and
    // the i_wen write-through — the buffer outranks i_wen on a granted
    // cycle. Drains no longer touch this channel (local merges).
    // P9.5: an uncached read drives the EXACT byte address (offset preserved, so
    // a 0x..4 register hits its own decode) and only asserts the device read on
    // the granted cycle.
    assign o_memr_addr = if uncached_active ?
        i_addr
    : if filling ?
        {fill_tag, fill_index, fill_woff, 3'b000}
    :
        {f_tag, f_index, 3'd0, 3'b000}
    ;
    assign o_memr_ren = if uncached_active ? i_memr_grant : if filling ? 1'b1 : if fill_start_fire ? 1'b1 : 1'b0;
    assign o_memr_rfo = if uncached_active ? 1'b0 : if filling ? fill_rfo : f_rfo;

    assign o_memw_addr = if wb_v ? {wb_line, 6'd0} : if i_wen ? i_addr : i_saddr;
    assign o_memw_wb   = wb_v;

    // S25: per-lane line write. The i_wen dword rides its i_addr[5:3] lane;
    // a writeback / full-line drain carries all 8 lanes.
    let wen_lane: logic<3> = i_addr[5:3];
    for l in 0..8 :gen_memw_lane {
        assign o_memw_wdata[l] = if wb_v ?
            (if wb_folded_q ? wb_data_lat[l] : wb_data[l]) // 14.13: folded cap → +1-latched line
        : if i_wen ?
            (if wen_lane == (l as 3) ? i_wdata : '0)
        :
            i_swdata[l]
        ;
        assign o_memw_wstrb[l] = if wb_v ?
            8'hff
        : if i_wen ?
            (if wen_fires && wen_lane == (l as 3) ? i_wstrb : '0)
        : if wt_fires ?
            i_swstrb[l]
        :
            '0
        ;
    }
    assign o_memw_wen = wb_fire || wen_fires || wt_fires;

    // Channel requests. memory_bus arbitrates among harts per channel.
    // The fill-start request is suppressed while the writeback buffer holds
    // a dirty victim's only copy (fill_blocked_wb) — mem_ctrl treats a
    // granted request as a committed transaction, so a grant must ALWAYS
    // coincide with the IDLE→FILL transition.
    let want_fill_start: logic = (load_sel || srfo_sel) && !fill_blocked_wb;
    let want_write     : logic = i_wen && !i_wen_excl && !amo_miss && state == State::IDLE && !mis_dirty_pending;
    assign o_memr_req = filling || want_fill_start || uncached_active;
    // 14.13: a folded cap writeback withholds its channel request until its +1-latched
    // data is ready (wb_drain_ok) so a grant never lands on an empty wb_data_lat (no
    // phantom write). Byte-identical at CAP_1R=0 (wb_drain_ok = wb_v).
    assign o_memw_req = wb_drain_ok || want_write || want_store_wt;

    // Non-blocking miss interface (Phase 8 S10). o_miss_valid pulses on the
    // cycle a LOAD fill actually STARTS (the IDLE→FILL edge), not on the raw
    // miss: without the grant the FSM stays IDLE and needs i_ren held to
    // keep requesting the bus, so a core that captured the load into an
    // MSHR on the raw miss and dropped i_ren would strand the fill. P9.2:
    // store-RFO fills never pulse it (no load to capture).
    // o_fill_complete excludes an aborted fill (remote-write i_inv during the
    // fill): the line stays Invalid and the filled data may be stale, so the
    // MSHR consumer must NOT complete the load from o_fill_rdata — it replays.
    assign o_miss_valid = load_sel && !fill_blocked_wb && i_memr_grant;
    assign o_fill_complete = state == State::DONE && !fill_aborted;
    assign o_fill_aborted  = state == State::DONE && fill_aborted;
    // S14.2: owner early restart. With critical-word-first the demanded dword
    // is written at the fill_count==0 transfer, so it is readable from
    // fill_count==1 onward. Guarded like stream_hit0 against an aborted fill
    // and the same-cycle invalidate race on the fill line; without cwf the
    // demand dword's transfer slot is offset-dependent, so this stays 0.
    assign o_fill_data_ready = s14_cwf_en && filling && fill_count != 3'd0 && !fill_aborted
        && !(i_inv_valid && {inv_tag, inv_index} == stream_line)
        && !(i_inv2_valid && {inv2_tag, inv2_index} == stream_line);
    // Phase 8 S10.4a: fill-safe PIPE-0 hit on i_addr — the same per-way
    // victim exclusion the port-2 read got in S10.2 (mid-FILL the filling way
    // carries a stale tag over partially-overwritten data; every other way is
    // consistent). o_rdata is correct whenever o_hit_safe holds: at most one
    // way matches a tag, and the excluded filling way therefore cannot be the
    // o_rdata mux's source. AMO reads (force-miss protocol) and cross-dword
    // spans (o_rdata_next not fill-checked) are excluded — they keep the
    // blocking path.
    let fill_busy0: logic = filling && fill_index == index;
    // delta-5: at =1 the fill-safe pipe-0 hit is the registered Stage-A hit,
    // C3-revalidated. =0 arm = exact original (no squash — const-0 at =0).
    // 14.3-e: the replay hit is the only non-folded ordinary hit reaching
    // o_hit_safe_live (AMO/misaligned are excluded above; streaming is cache_hit=0).
    // When the replay's data comes from the +1 registered read (DCACHE_NF_REPLAY), it
    // must NOT complete on the request cycle — gate the hit terms on nf_ready so
    // o_hit_safe (→ replay_hit_fire, which captures dcache_rdata combinationally) fires
    // the cycle rd1_nf_rdata is valid. The core holds replay_q and re-drives the stable
    // MSHR address until then. Streaming stays +0 (fill_crit_q) → stream_hit0 ungated.
    // At DCACHE_NF_REPLAY=0 nf_replay_ready folds to 1 = exact original.
    let nf_replay_ready: logic = if DCACHE_NF_REPLAY ? nf_ready : 1'b1;
    let hit_lo_safe    : logic = (hit_0 && !(fill_busy0 && fill_way == 2'd0)) || (hit_1 && !(fill_busy0 && fill_way == 2'd1)) || (hit_2 && !(fill_busy0 && fill_way == 2'd2)) || (hit_3 && !(fill_busy0 && fill_way == 2'd3));
    let o_hit_safe_live: logic = i_ren && !i_amo_read && !i_load_next && ((hit_lo_safe && nf_replay_ready) || stream_hit0);
    assign o_hit_safe = if DCACHE_SYNC_READ ? (if dhit_use ? (dhit_v_q && !dhit_c3_squash && !dhit_cap_pre_q) : o_hit_safe_live) : o_hit_safe_live;
    // Phase 5 SMP fix: data is valid for this hart's request only when
    // the cache actually has the data (hit) or the fill just completed
    // (DONE state — filled doubleword is in data_X arrays). During
    // MISS/FILL, o_rdata mirrors shared bus rdata which may be another
    // hart's transaction; consumers (e.g. memory.veryl amo_saved_rdata)
    // must gate on this to avoid mid-fill stale captures.
    // delta-5: at =1 the demand-hit term is the registered Stage-A hit (dhit_v_q),
    // C3-revalidated; DONE/uncached stay live. =0 arm = exact pre-delta-3 original.
    // 14.3-c: the non-folded HIT valid (AMO/misaligned-lo) waits for the registered
    // read (nf_ready) at =1 so it is held 0 on the request cycle and 1 on delivery;
    // replay (also non-folded, but LIVE via o_hit_safe) keeps cache_hit. At 0 = cache_hit.
    let nf_valid_hit: logic = if DCACHE_NF_REROUTE && nf_reroute ? (cache_hit && nf_ready) : cache_hit;
    assign o_data_valid = if DCACHE_SYNC_READ ? ((if dhit_use ? (dhit_v_q && !dhit_c3_squash && !dhit_cap_pre_q) : nf_valid_hit) || (state == State::DONE) || (uncached_active && i_memr_grant)) : (cache_hit || (state == State::DONE) || (uncached_active && i_memr_grant));

    // Re-read filled data at original miss offset (valid during DONE, and early
    // from fill_count==1 via o_fill_data_ready).
    // S2 (§13.8): the demanded dword IS the critical-word-first beat #0 transfer
    // (fill_woff == fill_offset when fill_count == 0), so instead of re-reading the
    // data array we CAPTURE i_mem_rdata at that beat into a 64-bit flop and deliver
    // o_fill_rdata from it — exactly the critical-word buffer a real CWF fill uses.
    // This drops the data_X[fill_index] read port (7R1W → 6R1W at =1) with a small
    // flop instead of the shared read port: folding this early-restart read onto
    // the arbitrated (registered) port is 1-cycle stale — o_fill_data_ready samples
    // o_fill_rdata combinationally the cycle beat #0 becomes visible, but a
    // registered SRAM read lags one cycle (and, heliodor being non-blocking, would
    // also collide with a hit-under-miss demand read that same cycle). The capture
    // matches the live read cycle-for-cycle: fill_crit_q at fill_count==1 equals
    // data_X[fill_index][fill_offset] (beat #0 written at fill_count==0), and the
    // demanded dword is written once, so it is stable through DONE.
    //   The old combinational read is a const-guarded statement block (default 0
    //   first, else if !DCACHE_DATA_READ_1R) so its data_X[fill_index] read port
    //   DCEs at =1; the fill_crit_q write is DCACHE_DATA_READ_1R-gated so the flop
    //   is reset-only → DCE at 0. The const-mux folds to fill_rdata_live at 0 =
    //   byte-identical.
    var fill_rdata_live: logic<64>;
    always_comb {
        fill_rdata_live = 64'd0;
        if !S2_FILL {
            fill_rdata_live = if fill_way == 2'd0 ?
                rd_dword(data_0[fill_index], fill_offset)
            : if fill_way == 2'd1 ?
                rd_dword(data_1[fill_index], fill_offset)
            : if fill_way == 2'd2 ?
                rd_dword(data_2[fill_index], fill_offset)
            :
                rd_dword(data_3[fill_index], fill_offset)
            ;
        }
    }
    assign o_fill_rdata = if S2_FILL ? fill_crit_q : fill_rdata_live;

    // ============================================================
    // Phase 8 S5.2: 2nd hit-only READ port. Pure combinational mirror of the
    // lo/hi hit logic above on i_addr2. No state writes, no o_stall effect.
    // ============================================================
    let tag2      : logic<TAG_W> = i_addr2[63:INDEX_W + 6];
    let index2    : logic<INDEX_W> = i_addr2[INDEX_W + 5:6];
    let offset2   : logic<3>  = i_addr2[5:3];
    // Phase 8 S10.2 (hit-under-miss): mid-FILL the victim way (fill_way at
    // fill_index) still carries its OLD tag + valid while its DATA words are
    // being overwritten — a port-2 hit on that way would return corrupted
    // data (the hazard that previously forced the core to gate o_hit2 on
    // !o_stall). Exclude exactly that way per-set so the 2nd port is safe
    // DURING a fill; every other line/way is consistent mid-fill (stores
    // only write arrays in IDLE, tags+valid update atomically with the last
    // fill word, DONE/IDLE need no exclusion).
    let fill_busy2: logic = filling && fill_index == index2;
    let hit2_0    : logic     = valid_0[index2] && tags_0[index2] == tag2 && !(fill_busy2 && fill_way == 2'd0);
    let hit2_1    : logic     = valid_1[index2] && tags_1[index2] == tag2 && !(fill_busy2 && fill_way == 2'd1);
    let hit2_2    : logic     = valid_2[index2] && tags_2[index2] == tag2 && !(fill_busy2 && fill_way == 2'd2);
    let hit2_3    : logic     = valid_3[index2] && tags_3[index2] == tag2 && !(fill_busy2 && fill_way == 2'd3);
    let cache_hit2: logic     = hit2_0 || hit2_1 || hit2_2 || hit2_3;
    // S3 slot-1 (§13.9): R6/R7 (index2 / next_index2) are the LIVE combinational
    // dual-issue read port. A real 1R1W SRAM cannot serve a second same-cycle read,
    // so under DCACHE_DATA_READ_1R the slot-1 loads are BEST-EFFORT DENIED (o_hit2
    // forced 0 → the core re-issues them on pipe-0, ld2_complete; no stall, pure
    // loss of a dual-issue load). The data reads are const-guarded statement blocks
    // so the data_X[index2] / data_X[next_index2] read ports DCE at =1 (6R1W →
    // 4R1W). The IPC cost of denying dual-issue loads is the measurement that
    // decides best-effort-vs-bank (13.3.5). =0 arm = byte-identical.
    var rdata2_0: logic<64>;
    var rdata2_1: logic<64>;
    var rdata2_2: logic<64>;
    var rdata2_3: logic<64>;
    always_comb {
        rdata2_0 = 64'd0;
        rdata2_1 = 64'd0;
        rdata2_2 = 64'd0;
        rdata2_3 = 64'd0;
        if !S3_SLOT1 {
            rdata2_0 = rd_dword(data_0[index2], offset2);
            rdata2_1 = rd_dword(data_1[index2], offset2);
            rdata2_2 = rd_dword(data_2[index2], offset2);
            rdata2_3 = rd_dword(data_3[index2], offset2);
        }
    }
    assign o_rdata2 = if hit2_0 ? rdata2_0 : if hit2_1 ? rdata2_1 : if hit2_2 ? rdata2_2 : rdata2_3;
    // Next-dword for a misaligned 2-dword 2nd load (mirror of o_rdata_next).
    let next_addr2     : logic<64> = {i_addr2[63:3], 3'b000} + 64'd8;
    let next_index2    : logic<INDEX_W> = next_addr2[INDEX_W + 5:6];
    let next_offset2   : logic<3>  = next_addr2[5:3];
    let next_tag2      : logic<TAG_W> = next_addr2[63:INDEX_W + 6];
    let next_same_line2: logic     = offset2 != 3'd7;
    // S10.2: same victim-way exclusion for the next-line hit (cross-dword span).
    let fill_busy2_next: logic     = filling && fill_index == next_index2;
    let next_hit2_0    : logic     = valid_0[next_index2] && tags_0[next_index2] == next_tag2 && !(fill_busy2_next && fill_way == 2'd0);
    let next_hit2_1    : logic     = valid_1[next_index2] && tags_1[next_index2] == next_tag2 && !(fill_busy2_next && fill_way == 2'd1);
    let next_hit2_2    : logic     = valid_2[next_index2] && tags_2[next_index2] == next_tag2 && !(fill_busy2_next && fill_way == 2'd2);
    let next_hit2_3    : logic     = valid_3[next_index2] && tags_3[next_index2] == next_tag2 && !(fill_busy2_next && fill_way == 2'd3);
    let next_line_hit2 : logic     = next_hit2_0 || next_hit2_1 || next_hit2_2 || next_hit2_3;
    var next_rdata2_same : logic<64>;
    var next_rdata2_xline: logic<64>;
    always_comb {
        next_rdata2_same  = 64'd0;
        next_rdata2_xline = 64'd0;
        if !S3_SLOT1 {
            next_rdata2_same = if hit2_0 ?
                rd_dword(data_0[next_index2], next_offset2)
            : if hit2_1 ?
                rd_dword(data_1[next_index2], next_offset2)
            : if hit2_2 ?
                rd_dword(data_2[next_index2], next_offset2)
            :
                rd_dword(data_3[next_index2], next_offset2)
            ;
            next_rdata2_xline = if next_hit2_0 ?
                rd_dword(data_0[next_index2], next_offset2)
            : if next_hit2_1 ?
                rd_dword(data_1[next_index2], next_offset2)
            : if next_hit2_2 ?
                rd_dword(data_2[next_index2], next_offset2)
            :
                rd_dword(data_3[next_index2], next_offset2)
            ;
        }
    }
    assign o_rdata2_next = if next_same_line2 ? next_rdata2_same : next_rdata2_xline;
    // Hit iff the lo line is cached AND (no span / span in same line / next line
    // also cached). i_ren2 gates the whole port. S3 (§13.9): at =1 slot-1 is
    // best-effort denied (o_hit2=0) so the shared 1R port never owes a 2nd read.
    let hi_ok2: logic = !i_load_next2 || next_same_line2 || next_line_hit2;
    assign o_hit2 = !S3_SLOT1 && i_ren2 && cache_hit2 && hi_ok2;

    // ============================================================
    // P9.2: local line-departure events (see the port note). The component
    // signals are defined in the capture-arbitration section; mutual
    // exclusion per port:
    //   ev1: fill-start victim (i_ren or i_swen path — no granted i_wen
    //        action those cycles), OR misaligned-store self-invalidates
    //        (the final-write cycle's clean invalidate ev_mis_lo, or a
    //        dirty-detour capture cap_mis_go — write held, so never both),
    //        OR a flush capture (defers to all of the above).
    //   ev2: misaligned-store hi self-invalidate, OR the AMO force-miss
    //        invalidate, OR a probe invalidate (probe_act defers to the
    //        other two).
    // ============================================================
    assign o_evict1_v = ev_fill_vic || ev_mis_lo || cap_mis_go || ev_drain_wt || cap_flush_go;
    assign o_evict1_addr = if ev_fill_vic ?
        {vic_tag, f_index, 6'd0}
    : if ev_mis_lo ?
        {tag, index, 6'd0}
    : if cap_mis_go ?
        (if cap_mis_hi_sel ? {next_tag, next_index, 6'd0} : {tag, index, 6'd0})
    : if ev_drain_wt ?
        {stag, sindex, 6'd0}
    :
        {fl_tag, fl_set, 6'd0}
    ;
    assign o_evict2_v    = ev_mis_hi || probe_depart;
    assign o_evict2_addr = if ev_mis_hi ?
        {next_tag, next_index, 6'd0}
    :
        {i_probe_addr[63:6], 6'd0}
    ;

    // ============================================================
    // P9.2: line-presence checks (combinational, registered state only — a
    // same-cycle invalidate pulse drops presence on the NEXT cycle; the
    // core's own same-cycle inv compares cover that window). The mid-fill
    // victim way is NOT present (its old line is unreadable and dies at
    // completion); the line being filled IS present unless aborted.
    // ============================================================
    let chk_tag      : logic<TAG_W>   = i_chk_addr[63:INDEX_W + 6];
    let chk_index    : logic<INDEX_W> = i_chk_addr[INDEX_W + 5:6];
    let fill_busy_chk: logic          = filling && fill_index == chk_index;
    let chk_hit      : logic          = (valid_0[chk_index] && tags_0[chk_index] == chk_tag && !(fill_busy_chk && fill_way == 2'd0))
        || (valid_1[chk_index] && tags_1[chk_index] == chk_tag && !(fill_busy_chk && fill_way == 2'd1))
        || (valid_2[chk_index] && tags_2[chk_index] == chk_tag && !(fill_busy_chk && fill_way == 2'd2))
        || (valid_3[chk_index] && tags_3[chk_index] == chk_tag && !(fill_busy_chk && fill_way == 2'd3));
    assign o_chk_present = chk_hit || (filling && {fill_tag, fill_index} == {chk_tag, chk_index} && !fill_aborted);

    let chk2_tag      : logic<TAG_W>   = i_chk2_addr[63:INDEX_W + 6];
    let chk2_index    : logic<INDEX_W> = i_chk2_addr[INDEX_W + 5:6];
    let fill_busy_chk2: logic          = filling && fill_index == chk2_index;
    let chk2_hit      : logic          = (valid_0[chk2_index] && tags_0[chk2_index] == chk2_tag && !(fill_busy_chk2 && fill_way == 2'd0))
        || (valid_1[chk2_index] && tags_1[chk2_index] == chk2_tag && !(fill_busy_chk2 && fill_way == 2'd1))
        || (valid_2[chk2_index] && tags_2[chk2_index] == chk2_tag && !(fill_busy_chk2 && fill_way == 2'd2))
        || (valid_3[chk2_index] && tags_3[chk2_index] == chk2_tag && !(fill_busy_chk2 && fill_way == 2'd3));
    assign o_chk2_present = chk2_hit || (filling && {fill_tag, fill_index} == {chk2_tag, chk2_index} && !fill_aborted);

    // P9.3: third presence port (AMO watch).
    let chk3_tag      : logic<TAG_W>   = i_chk3_addr[63:INDEX_W + 6];
    let chk3_index    : logic<INDEX_W> = i_chk3_addr[INDEX_W + 5:6];
    let fill_busy_chk3: logic          = filling && fill_index == chk3_index;
    let chk3_hit      : logic          = (valid_0[chk3_index] && tags_0[chk3_index] == chk3_tag && !(fill_busy_chk3 && fill_way == 2'd0))
        || (valid_1[chk3_index] && tags_1[chk3_index] == chk3_tag && !(fill_busy_chk3 && fill_way == 2'd1))
        || (valid_2[chk3_index] && tags_2[chk3_index] == chk3_tag && !(fill_busy_chk3 && fill_way == 2'd2))
        || (valid_3[chk3_index] && tags_3[chk3_index] == chk3_tag && !(fill_busy_chk3 && fill_way == 2'd3));
    assign o_chk3_present = chk3_hit || (filling && {fill_tag, fill_index} == {chk3_tag, chk3_index} && !fill_aborted);



    // Stall on miss, during fill, DONE, and writes during fill.
    // Fill state stalls all accesses (original conservative behavior).
    // Phase 5: also stall while waiting for bus grant on a write-through.
    let write_during_fill: logic = filling && i_wen;
    // P9.2: the write FIRES only via wen_fires (buffer priority + misaligned
    // dirty detours included), so the stall covers all its hold reasons.
    // P9.3: an in-cache AMO/SC commit write holds until its local merge
    // fires; if the line departed it holds until the core's commit replay
    // drops the request.
    let write_wait_grant: logic = state == State::IDLE && i_wen && !i_wen_excl && !amo_miss && !wen_fires;
    let write_wait_local: logic = state == State::IDLE && i_wen && i_wen_excl && !wenl_fires;
    assign o_stall = (state == State::FILL) || miss || (state == State::DONE) || write_during_fill || write_wait_grant
        || write_wait_local || inv_hits_active || inv2_hits_active || dhit_c3_squash || dhit_cap_pre_q || dhit_miss || nf_gap_stall || nf_reg_stall || (uncached_active && !i_memr_grant);

}
