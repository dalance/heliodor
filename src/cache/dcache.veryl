// 4-way set-associative data cache
// 4KB: 16 sets × 4 ways × 64B lines (8 doublewords per line)
// Write-through, no-write-allocate
// Non-blocking for loads: MSHR absorbs load miss, pipeline continues.
// Replacement: pseudo-LRU (3-bit tree per set)
//
// Address breakdown (64-bit byte address):
//   [63:10] tag  |  [9:6] index (4 bits, 16 sets)  |  [5:3] offset (3 bits, 8 words)  |  [2:0] byte
pub module dcache (
    clk: input clock,
    rst: input reset,
    // CPU side
    i_addr : input  logic<64>,
    i_wdata: input  logic<64>,
    i_wen  : input  logic    ,
    i_ren  : input  logic    ,
    i_wstrb: input  logic<8> ,
    o_rdata: output logic<64>,
    o_stall: output logic    ,
    // Non-blocking miss interface (MSHR support)
    o_miss_valid   : output logic    , // 1-cycle pulse on load miss (MSHR capture trigger)
    o_fill_complete: output logic    , // high during DONE state (fill data readable)
    o_fill_rdata   : output logic<64>, // filled doubleword at original miss offset
    // Memory side
    o_mem_addr : output logic<64>,
    o_mem_wdata: output logic<64>,
    i_mem_rdata: input  logic<64>,
    o_mem_wen  : output logic    ,
    o_mem_ren  : output logic    ,
    o_mem_wstrb: output logic<8> ,
    // Invalidate port (memory_bus → dcache, multi-hart coherence).
    // Asserted by memory_bus when another core writes a line. The dcache
    // invalidates any matching way at i_inv_addr's index/tag. If a fill is
    // in progress for the same line, fill_aborted is latched so the fill
    // completes without setting valid (line stays Invalid).
    i_inv_valid: input logic    ,
    i_inv_addr : input logic<64>,
    // Bus arbitration (Phase 5 single-port DRAM bus).
    //   o_mem_req — combinational request: high while we need the DRAM bus
    //               (waiting to start a fill, mid-fill, or issuing a write).
    //   i_mem_grant — high when memory_bus has granted this hart access this
    //                 cycle. State advances only when granted; non-granted
    //                 cycles stall (o_stall stays high so the pipeline holds).
    o_mem_req  : output logic,
    i_mem_grant: input  logic,
) {
    // Address decomposition
    let tag     : logic<54> = i_addr[63:10];
    let index   : logic<4>  = i_addr[9:6];
    let offset  : logic<3>  = i_addr[5:3];
    let data_idx: logic<7>  = {index, offset};

    // Cache storage: 4 ways
    var valid_0: logic     [16] ;
    var valid_1: logic     [16] ;
    var valid_2: logic     [16] ;
    var valid_3: logic     [16] ;
    var tags_0 : logic<54> [16] ;
    var tags_1 : logic<54> [16] ;
    var tags_2 : logic<54> [16] ;
    var tags_3 : logic<54> [16] ;
    var data_0 : logic<64> [128]; // 16 sets × 8 dwords
    var data_1 : logic<64> [128];
    var data_2 : logic<64> [128];
    var data_3 : logic<64> [128];

    // Pseudo-LRU tree: 3 bits per set
    // bit[2]: root → 0=left(way 0,1), 1=right(way 2,3)
    // bit[1]: left child → 0=way 0, 1=way 1
    // bit[0]: right child → 0=way 2, 1=way 3
    var plru: logic<3> [16];

    // Cache lookup: per-way hit
    let hit_0    : logic = valid_0[index] && tags_0[index] == tag;
    let hit_1    : logic = valid_1[index] && tags_1[index] == tag;
    let hit_2    : logic = valid_2[index] && tags_2[index] == tag;
    let hit_3    : logic = valid_3[index] && tags_3[index] == tag;
    let cache_hit: logic = hit_0 || hit_1 || hit_2 || hit_3;

    // Same-cycle remote invalidate stall (multi-hart coherence).
    // i_inv_valid pulses combinationally the cycle a remote hart writes a
    // line at (inv_tag, inv_index). Without this stall, our load in the same
    // cycle would still hit the soon-to-be-invalid line and read stale data
    // (the registered invalidate below only takes effect on the next clock
    // edge). Detect the same-cycle race against an active access and add
    // it to o_stall so the pipeline retries next cycle, by which time the
    // line has been invalidated and the retry naturally misses → fills
    // fresh data from memory_bus.
    //
    // Routed through o_stall (not cache_hit) to avoid a structural comb
    // loop: gating cache_hit would feed o_mem_ren / o_mem_req → bus
    // arbiter → other-hart grant → other-hart o_dmem_wen → bus inv →
    // self.i_inv_valid, which the simulator flags as a cycle even when
    // the grants are mutually exclusive. o_stall only feeds pipeline
    // sequential stages, breaking the cycle.
    let inv_hits_active: logic = i_inv_valid && (i_wen || i_ren) && cache_hit
                              && (index as 4 == i_inv_addr[9:6])
                              && (tag == i_inv_addr[63:10]);

    // Hit way select
    let hit_way: logic<2> = if hit_0 ? 2'd0 : if hit_1 ? 2'd1 : if hit_2 ? 2'd2 : 2'd3;

    // Read data from hit way
    let rdata_0: logic<64> = data_0[data_idx];
    let rdata_1: logic<64> = data_1[data_idx];
    let rdata_2: logic<64> = data_2[data_idx];
    let rdata_3: logic<64> = data_3[data_idx];

    // State machine for line fill
    enum State: logic<2> {
        IDLE = 2'd0,
        FILL = 2'd1,
        DONE = 2'd2,
    }

    var state        : State    ;
    var fill_count   : logic<3> ; // 0..7, which word to fill
    var fill_index   : logic<4> ; // index being filled
    var fill_tag     : logic<54>; // tag being filled
    var fill_way     : logic<2> ; // which way to fill
    var fill_offset  : logic<3> ; // original miss dword offset (for MSHR re-read)
    var fill_aborted : logic    ; // remote invalidate hit the line being filled
    let fill_data_idx: logic<7>  = {fill_index, fill_count};

    // Invalidate decode (combinational from request port)
    let inv_tag  : logic<54> = i_inv_addr[63:10];
    let inv_index: logic<4>  = i_inv_addr[9:6];

    // CPU request present
    let cpu_req: logic = i_wen || i_ren;

    // Miss: read request, not hit, not already filling
    let miss: logic = i_ren && !cache_hit && state == State::IDLE;

    // PLRU victim selection
    let plru_bits  : logic<3> = plru[index];
    let has_invalid: logic    = !valid_0[index] || !valid_1[index] || !valid_2[index] || !valid_3[index];
    let invalid_way: logic<2> = if !valid_0[index] ? 2'd0 : if !valid_1[index] ? 2'd1 : if !valid_2[index] ? 2'd2 : 2'd3;
    let plru_way   : logic<2> = {plru_bits[2], if !plru_bits[2] ? plru_bits[1] : plru_bits[0]};
    let victim_way : logic<2> = if has_invalid ? invalid_way : plru_way;

    let filling: logic = state == State::FILL;

    always_ff (clk, rst) {
        if_reset {
            state        = State::IDLE;
            fill_count   = 3'd0;
            fill_index   = 4'd0;
            fill_tag     = '0;
            fill_way     = 2'd0;
            fill_offset  = 3'd0;
            fill_aborted = 1'b0;
            for i in 0..16 {
                valid_0[i] = 1'b0;
                valid_1[i] = 1'b0;
                valid_2[i] = 1'b0;
                valid_3[i] = 1'b0;
            }
        } else {
            case state {
                State::IDLE: {
                    // Phase 5: gate fill start and write-through on bus grant.
                    // Without grant we hold the IDLE state and stall the pipe;
                    // memory_bus arbitrates between harts and holds grant for
                    // the entire 8-cycle FILL burst once we transition.
                    if miss && i_mem_grant {
                        fill_index   = index;
                        fill_tag     = tag;
                        fill_way     = victim_way;
                        fill_offset  = offset;
                        fill_count   = 3'd0;
                        fill_aborted = 1'b0;
                        state        = State::FILL;
                    }
                    // Write-through: update cache on write hit, invalidate on miss.
                    // Only commit the cache change + DRAM write when granted so
                    // the local update and the DRAM emission stay in lockstep.
                    if i_wen && i_mem_grant {
                        if cache_hit {
                            let old: logic<64> = if hit_0 ? rdata_0 : if hit_1 ? rdata_1 : if hit_2 ? rdata_2 : rdata_3;
                            let merged: logic<64> = {
                                if i_wstrb[7] ? i_wdata[63:56] : old[63:56],
                                if i_wstrb[6] ? i_wdata[55:48] : old[55:48],
                                if i_wstrb[5] ? i_wdata[47:40] : old[47:40],
                                if i_wstrb[4] ? i_wdata[39:32] : old[39:32],
                                if i_wstrb[3] ? i_wdata[31:24] : old[31:24],
                                if i_wstrb[2] ? i_wdata[23:16] : old[23:16],
                                if i_wstrb[1] ? i_wdata[15:8] : old[15:8],
                                if i_wstrb[0] ? i_wdata[7:0] : old[7:0]
                            };
                            if hit_0 {
                                data_0[data_idx] = merged;
                            }
                            if hit_1 {
                                data_1[data_idx] = merged;
                            }
                            if hit_2 {
                                data_2[data_idx] = merged;
                            }
                            if hit_3 {
                                data_3[data_idx] = merged;
                            }
                        } else {
                            // Invalidate the way that would be selected if this were a read miss
                            if victim_way == 2'd0 {
                                valid_0[index] = 1'b0;
                            }
                            if victim_way == 2'd1 {
                                valid_1[index] = 1'b0;
                            }
                            if victim_way == 2'd2 {
                                valid_2[index] = 1'b0;
                            }
                            if victim_way == 2'd3 {
                                valid_3[index] = 1'b0;
                            }
                        }
                    }
                }
                State::FILL: {
                    // Phase 5: only write fill data and advance the count when
                    // bus is granted. memory_bus is expected to hold grant for
                    // the entire 8-cycle burst once a fill starts.
                    if i_mem_grant {
                        if fill_way == 2'd0 {
                            data_0[fill_data_idx] = i_mem_rdata;
                        }
                        if fill_way == 2'd1 {
                            data_1[fill_data_idx] = i_mem_rdata;
                        }
                        if fill_way == 2'd2 {
                            data_2[fill_data_idx] = i_mem_rdata;
                        }
                        if fill_way == 2'd3 {
                            data_3[fill_data_idx] = i_mem_rdata;
                        }
                        if fill_count == 3'd7 {
                            // Fill complete. If a remote invalidate hit this line
                            // mid-fill, leave valid=0 so the next access misses
                            // and re-fills. Tag write is harmless either way.
                            if fill_way == 2'd0 {
                                tags_0[fill_index]  = fill_tag;
                                valid_0[fill_index] = !fill_aborted;
                            }
                            if fill_way == 2'd1 {
                                tags_1[fill_index]  = fill_tag;
                                valid_1[fill_index] = !fill_aborted;
                            }
                            if fill_way == 2'd2 {
                                tags_2[fill_index]  = fill_tag;
                                valid_2[fill_index] = !fill_aborted;
                            }
                            if fill_way == 2'd3 {
                                tags_3[fill_index]  = fill_tag;
                                valid_3[fill_index] = !fill_aborted;
                            }
                            state = State::DONE;
                        } else {
                            fill_count = fill_count + 3'd1;
                        }
                    }
                }
                State::DONE: {
                    state = State::IDLE;
                }
                default: {
                    state = State::IDLE;
                }
            }

            // Update PLRU on cache hit (point tree AWAY from accessed way)
            if cache_hit && cpu_req && !filling {
                if hit_way[1] == 1'b0 {
                    plru[index][2] = 1'b1;
                    plru[index][1] = if hit_way[0] ? 1'b0 : 1'b1;
                } else {
                    plru[index][2] = 1'b0;
                    plru[index][0] = if hit_way[0] ? 1'b0 : 1'b1;
                }
            }

            // Remote invalidate: clear valid for matching tag in any way.
            // If the line currently being filled matches, latch fill_aborted
            // so the FILL completion does not set valid (forcing a re-fill on
            // the next access).
            if i_inv_valid {
                if valid_0[inv_index] && tags_0[inv_index] == inv_tag {
                    valid_0[inv_index] = 1'b0;
                }
                if valid_1[inv_index] && tags_1[inv_index] == inv_tag {
                    valid_1[inv_index] = 1'b0;
                }
                if valid_2[inv_index] && tags_2[inv_index] == inv_tag {
                    valid_2[inv_index] = 1'b0;
                }
                if valid_3[inv_index] && tags_3[inv_index] == inv_tag {
                    valid_3[inv_index] = 1'b0;
                }
                if state == State::FILL && fill_index == inv_index && fill_tag == inv_tag {
                    fill_aborted = 1'b1;
                }
            }
        }
    }

    // Read data: from hit way on cache hit, from memory during fill
    assign o_rdata = if hit_0 ? rdata_0 : if hit_1 ? rdata_1 : if hit_2 ? rdata_2 : if hit_3 ? rdata_3 : i_mem_rdata;

    // Memory interface
    assign o_mem_addr = if filling ?
        {fill_tag, fill_index, fill_count, 3'b000}
    : if i_wen ?
        i_addr
    : if i_ren && !cache_hit ?
        {tag, index, 3'd0, 3'b000}
    :
        '0
    ;

    assign o_mem_wdata = if i_wen && !filling ? i_wdata : '0;

    // Suppress write-through on cache miss when AMO (ren && wen) to prevent
    // corrupting DRAM before the fill reads the old value.
    let amo_miss: logic = i_ren && i_wen && !cache_hit;
    // Phase 5: only emit DRAM write strobe when bus is granted. Otherwise the
    // write must wait until the arbiter gives us a slot.
    assign o_mem_wen = if filling ? 1'b0 : if amo_miss ? 1'b0 : (i_wen && i_mem_grant);
    assign o_mem_ren = if filling ? 1'b1 : if i_ren && !cache_hit && i_mem_grant ? 1'b1 : 1'b0;
    assign o_mem_wstrb = if i_wen && !filling && i_mem_grant ? i_wstrb : '0;

    // Bus request: any cycle we need DRAM access. memory_bus arbitrates
    // among harts and asserts i_mem_grant when this hart's turn comes.
    let want_fill_start: logic = miss;                                  // IDLE+miss
    let want_write     : logic = i_wen && !amo_miss && state == State::IDLE;
    assign o_mem_req = filling || want_fill_start || want_write;

    // Non-blocking miss interface
    assign o_miss_valid    = miss; // 1-cycle pulse on load miss (state == IDLE)
    assign o_fill_complete = state == State::DONE;

    // Re-read filled data at original miss offset (valid during DONE)
    let fill_rdata_idx: logic<7> = {fill_index, fill_offset};
    assign o_fill_rdata = if fill_way == 2'd0 ? data_0[fill_rdata_idx]
                        : if fill_way == 2'd1 ? data_1[fill_rdata_idx]
                        : if fill_way == 2'd2 ? data_2[fill_rdata_idx]
                        : data_3[fill_rdata_idx];

    // Stall on miss, during fill, DONE, and writes during fill.
    // Fill state stalls all accesses (original conservative behavior).
    // Phase 5: also stall while waiting for bus grant on a write-through.
    let write_during_fill: logic = filling && i_wen;
    let write_wait_grant : logic = state == State::IDLE && i_wen && !amo_miss && !i_mem_grant;
    assign o_stall = (state == State::FILL) || miss || (state == State::DONE) || write_during_fill || write_wait_grant || inv_hits_active;

}
