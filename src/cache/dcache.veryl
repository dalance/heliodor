// 4-way set-associative data cache
// 4KB: 16 sets × 4 ways × 64B lines (8 doublewords per line)
// Write-through, no-write-allocate
// Non-blocking for loads: MSHR absorbs load miss, pipeline continues.
// Replacement: pseudo-LRU (3-bit tree per set)
//
// Address breakdown (64-bit byte address):
//   [63:10] tag  |  [9:6] index (4 bits, 16 sets)  |  [5:3] offset (3 bits, 8 words)  |  [2:0] byte
pub module dcache (
    clk: input clock,
    rst: input reset,
    // CPU side
    i_addr : input  logic<64>,
    i_wdata: input  logic<64>,
    i_wen  : input  logic    ,
    i_ren  : input  logic    ,
    i_wstrb: input  logic<8> ,
    // M8.B (B.3): hi-side strobe for a misaligned STORE that spans into the
    // next dword. Nonzero ⇒ the store also writes (i_addr&~7)+8 via the core's
    // o_dmem_wstrb_hi bypass; the dcache cannot hold the partial result, so it
    // INVALIDATES both touched lines (lo + next) instead of merging and lets a
    // later load refill the merged bytes from memory. Single-dword callers tie 0.
    i_wstrb_hi: input logic<8>,
    // M8.B (B.3): set when a LOAD's data spans into the next dword (byte_off +
    // size > 8). When that next dword falls in a DIFFERENT line, the dcache
    // fills the next line too (a second sequential fill) so o_rdata_next is
    // valid before o_stall drops. Same-line spans need no extra fill. Tie 0.
    i_load_next: input logic,
    // M9.4 SMP: this read is an AMO/LR value-capture (read-for-RMW). The bus
    // amo_inflight lock serializes AMOs across harts, but a cache HIT returns
    // data without a bus grant — so a hart locked out of the bus (not the
    // amo_holder) could read a STALE cached value while a lower-id holder is
    // mid-RMW, producing a lost update (observed as the N=4 stop_machine
    // multi_cpu_stop ack-counter never reaching EXIT). On an AMO read that
    // HITS, force the line to miss (invalidate + re-fill via the bus) so the
    // value is fetched coherently under the lock. See amo_force_trigger below.
    i_amo_read: input logic,
    // Phase 8 S5.2: 2nd hit-only READ port (dual-issue loads, bare mode). A
    // purely combinational, additive read of the SAME tag/data arrays — no
    // state, no bus, o_stall unchanged. The core drives i_addr2 with a slot-1
    // LOAD's effective address and completes that load on pipe-1 only when
    // o_hit2. S10.2: o_hit2 is FILL-safe (hit-under-miss) — the way being
    // filled is excluded per-set (fill_busy2 below), so the core no longer
    // gates on !o_stall. MISS / cross-line-not-cached → o_hit2=0 and the load
    // falls back to pipe-0. i_ren2=0 ties the port off (o_hit2=0, no
    // behavioral effect). i_load_next2 = the 2nd load spans into the next
    // dword (so o_hit2 also requires that dword present).
    i_addr2     : input  logic<64>,
    i_ren2      : input  logic    ,
    i_load_next2: input  logic    ,
    o_rdata2     : output logic<64>,
    o_rdata2_next: output logic<64>,
    o_hit2       : output logic    ,
    // Phase 8 S6: 2nd WRITE port (store-drain). A PHYSICALLY SEPARATE address
    // (i_saddr) so a store write-through coexists with a load read on
    // i_addr/i_ren in the same cycle (the data arrays are comb-read +
    // registered-write). The core routes ONLY bare-mode aligned plain stores
    // here; AMO/Sv39/misaligned stay on the combined i_wen path. The store
    // drain shares the single bus o_mem_*: a load-miss FILL/read wins, the
    // store drain waits (o_sdrain_ack=0, store held at the ROB head). Tie
    // i_swen=0 to disable the port entirely (no behavioral effect).
    i_saddr     : input  logic<64>,
    i_swen      : input  logic    ,
    i_swdata    : input  logic<64>,
    i_swstrb    : input  logic<8> ,
    o_sdrain_ack: output logic    ,
    o_rdata: output logic<64>,
    // M8.B: combinational read of the NEXT dword (at (i_addr&~7)+8), for v4
    // misaligned loads that span two dwords (mirrors the old i_dmem_rdata_next).
    // o_rdata_next_miss flags that the next dword's line is not cached so the
    // consumer can stall and let a fill bring it in. Purely additive — the
    // dcache state machine is unchanged, so single-dword callers tie these off.
    o_rdata_next     : output logic<64>,
    o_rdata_next_miss: output logic    ,
    o_stall: output logic    ,
    // Phase 5 SMP fix: rdata is valid for THIS hart's request only when
    // cache hit or just-filled (DONE). Low during MISS/FILL when o_rdata
    // mirrors the shared bus value (potentially another hart's rdata
    // when not yet granted). Consumers (e.g. memory.veryl amo_saved_rdata)
    // gate on this to avoid latching shared-bus rdata destined for a
    // different hart while waiting for this hart's cache fill.
    o_data_valid: output logic,
    // Non-blocking miss interface (MSHR support)
    o_miss_valid   : output logic    , // 1-cycle pulse on fill START (MSHR capture trigger)
    o_fill_complete: output logic    , // DONE state, fill not aborted (fill data readable)
    o_fill_rdata   : output logic<64>, // filled doubleword at original miss offset
    o_fill_aborted : output logic    , // DONE state, fill ABORTED by i_inv (data may be stale)
    // Memory side
    o_mem_addr : output logic<64>,
    o_mem_wdata: output logic<64>,
    i_mem_rdata: input  logic<64>,
    o_mem_wen  : output logic    ,
    o_mem_ren  : output logic    ,
    o_mem_wstrb: output logic<8> ,
    // Invalidate port (memory_bus → dcache, multi-hart coherence).
    // Asserted by memory_bus when another core writes a line. The dcache
    // invalidates any matching way at i_inv_addr's index/tag. If a fill is
    // in progress for the same line, fill_aborted is latched so the fill
    // completes without setting valid (line stays Invalid).
    i_inv_valid: input logic    ,
    i_inv_addr : input logic<64>,
    // Bus arbitration (Phase 5 single-port DRAM bus).
    //   o_mem_req — combinational request: high while we need the DRAM bus
    //               (waiting to start a fill, mid-fill, or issuing a write).
    //   i_mem_grant — high when memory_bus has granted this hart access this
    //                 cycle. State advances only when granted; non-granted
    //                 cycles stall (o_stall stays high so the pipeline holds).
    o_mem_req  : output logic,
    i_mem_grant: input  logic,
) {
    // Address decomposition
    let tag     : logic<54> = i_addr[63:10];
    let index   : logic<4>  = i_addr[9:6];
    let offset  : logic<3>  = i_addr[5:3];
    let data_idx: logic<7>  = {index, offset};

    // Cache storage: 4 ways
    var valid_0: logic     [16] ;
    var valid_1: logic     [16] ;
    var valid_2: logic     [16] ;
    var valid_3: logic     [16] ;
    var tags_0 : logic<54> [16] ;
    var tags_1 : logic<54> [16] ;
    var tags_2 : logic<54> [16] ;
    var tags_3 : logic<54> [16] ;
    var data_0 : logic<64> [128]; // 16 sets × 8 dwords
    var data_1 : logic<64> [128];
    var data_2 : logic<64> [128];
    var data_3 : logic<64> [128];

    // Pseudo-LRU tree: 3 bits per set
    // bit[2]: root → 0=left(way 0,1), 1=right(way 2,3)
    // bit[1]: left child → 0=way 0, 1=way 1
    // bit[0]: right child → 0=way 2, 1=way 3
    var plru: logic<3> [16];

    // Cache lookup: per-way hit
    let hit_0    : logic = valid_0[index] && tags_0[index] == tag;
    let hit_1    : logic = valid_1[index] && tags_1[index] == tag;
    let hit_2    : logic = valid_2[index] && tags_2[index] == tag;
    let hit_3    : logic = valid_3[index] && tags_3[index] == tag;
    let cache_hit: logic = hit_0 || hit_1 || hit_2 || hit_3;

    // Same-cycle remote invalidate stall (multi-hart coherence).
    // i_inv_valid pulses combinationally the cycle a remote hart writes a
    // line at (inv_tag, inv_index). Without this stall, our load in the same
    // cycle would still hit the soon-to-be-invalid line and read stale data
    // (the registered invalidate below only takes effect on the next clock
    // edge). Detect the same-cycle race against an active access and add
    // it to o_stall so the pipeline retries next cycle, by which time the
    // line has been invalidated and the retry naturally misses → fills
    // fresh data from memory_bus.
    //
    // Routed through o_stall (not cache_hit) to avoid a structural comb
    // loop: gating cache_hit would feed o_mem_ren / o_mem_req → bus
    // arbiter → other-hart grant → other-hart o_dmem_wen → bus inv →
    // self.i_inv_valid, which the simulator flags as a cycle even when
    // the grants are mutually exclusive. o_stall only feeds pipeline
    // sequential stages, breaking the cycle.
    let inv_hits_active: logic = i_inv_valid && (i_wen || i_ren) && cache_hit && (index as 4 == i_inv_addr[9:6])
        && (tag == i_inv_addr[63:10]);

    // Hit way select
    let hit_way: logic<2> = if hit_0 ? 2'd0 : if hit_1 ? 2'd1 : if hit_2 ? 2'd2 : 2'd3;

    // Read data from hit way
    let rdata_0: logic<64> = data_0[data_idx];
    let rdata_1: logic<64> = data_1[data_idx];
    let rdata_2: logic<64> = data_2[data_idx];
    let rdata_3: logic<64> = data_3[data_idx];

    // State machine for line fill
    enum State: logic<2> {
        IDLE = 2'd0,
        FILL = 2'd1,
        DONE = 2'd2,
    }

    var state        : State    ;
    var fill_count   : logic<3> ; // 0..7, which word to fill
    var fill_index   : logic<4> ; // index being filled
    var fill_tag     : logic<54>; // tag being filled
    var fill_way     : logic<2> ; // which way to fill
    var fill_offset  : logic<3> ; // original miss dword offset (for MSHR re-read)
    var fill_aborted : logic    ; // remote invalidate hit the line being filled
    let fill_data_idx: logic<7>  = {fill_index, fill_count};

    // M9.4 SMP AMO coherence: an AMO/LR read that HITS the cache must not return
    // a possibly-stale line (a non-amo_holder hart is locked out of the bus but
    // a hit needs no grant). Force such a read to miss: invalidate the hit way
    // (registered below), which makes the next cycle a normal lo_miss → fill via
    // the bus under the amo_inflight lock → coherent value. amo_filled_q is a
    // one-shot guard: after that forced re-fill the line is fresh, so the
    // post-fill hit must NOT re-trigger the force (else it loops forever). It is
    // set when the fill completes for the pending AMO read and cleared when the
    // AMO read request drops.
    var amo_filled_q     : logic;
    let amo_force_trigger: logic = i_amo_read && i_ren && cache_hit && state == State::IDLE && !amo_filled_q;

    // Invalidate decode (combinational from request port)
    let inv_tag  : logic<54> = i_inv_addr[63:10];
    let inv_index: logic<4>  = i_inv_addr[9:6];

    // CPU request present
    let cpu_req: logic = i_wen || i_ren;

    // M8.B (B.3): next-dword line decode (also used by o_rdata_next below).
    // The next dword is at (i_addr & ~7) + 8: same line when offset != 7,
    // otherwise the following line (different index/tag).
    let next_addr     : logic<64> = {i_addr[63:3], 3'b000} + 64'd8;
    let next_index    : logic<4>  = next_addr[9:6];
    let next_offset   : logic<3>  = next_addr[5:3];
    let next_tag      : logic<54> = next_addr[63:10];
    let next_same_line: logic     = offset != 3'd7;
    let next_data_idx : logic<7>  = {next_index, next_offset};
    let next_hit_0    : logic     = valid_0[next_index] && tags_0[next_index] == next_tag;
    let next_hit_1    : logic     = valid_1[next_index] && tags_1[next_index] == next_tag;
    let next_hit_2    : logic     = valid_2[next_index] && tags_2[next_index] == next_tag;
    let next_hit_3    : logic     = valid_3[next_index] && tags_3[next_index] == next_tag;
    let next_line_hit : logic     = next_hit_0 || next_hit_1 || next_hit_2 || next_hit_3;

    // Miss handling. A normal read miss fills the i_addr line (lo_miss). A
    // misaligned LOAD whose next dword crosses into a DIFFERENT line needs that
    // next line filled too: once the lo line is cached (cache_hit), hi_miss
    // triggers a SECOND sequential fill of the next line. Both keep o_stall
    // high until the data is present.
    let lo_miss: logic = i_ren && !cache_hit && state == State::IDLE;
    let hi_miss: logic = i_ren && i_load_next && !next_same_line && cache_hit && !next_line_hit && state == State::IDLE;
    let miss   : logic = lo_miss || hi_miss;

    // Fill target: the lo line normally, or the next line for a hi_miss (lo
    // already cached, so lo_miss is 0). i_ren-only, so stores/AMO use the lo
    // line (fill_is_hi stays 0).
    let fill_is_hi: logic     = hi_miss && !lo_miss;
    let f_index   : logic<4>  = if fill_is_hi ? next_index : index;
    let f_tag     : logic<54> = if fill_is_hi ? next_tag : tag;
    let f_offset  : logic<3>  = if fill_is_hi ? next_offset : offset;

    // PLRU victim selection for the fill-target index.
    let plru_bits  : logic<3> = plru[f_index];
    let has_invalid: logic    = !valid_0[f_index] || !valid_1[f_index] || !valid_2[f_index] || !valid_3[f_index];
    let invalid_way: logic<2> = if !valid_0[f_index] ?
        2'd0
    : if !valid_1[f_index] ?
        2'd1
    : if !valid_2[f_index] ?
        2'd2
    :
        2'd3
    ;
    let plru_way   : logic<2> = {plru_bits[2], if !plru_bits[2] ? plru_bits[1] : plru_bits[0]};
    let victim_way : logic<2> = if has_invalid ? invalid_way : plru_way;

    let filling: logic = state == State::FILL;

    // ============================================================
    // Phase 8 S6: store-drain (2nd write port) decode. Combinational tag-match
    // on i_saddr, independent of the i_addr read port. The actual data-array
    // write happens in the IDLE state of the always_ff below (mutually exclusive
    // with the i_wen write at the core level — a store fires EITHER i_wen or
    // i_swen, never both). Tie i_swen=0 ⇒ want_store/store_can_drain=0 ⇒ no effect.
    // ============================================================
    let stag       : logic<54> = i_saddr[63:10];
    let sindex     : logic<4>  = i_saddr[9:6];
    let soffset    : logic<3>  = i_saddr[5:3];
    let sdata_idx  : logic<7>  = {sindex, soffset};
    let shit_0     : logic     = valid_0[sindex] && tags_0[sindex] == stag;
    let shit_1     : logic     = valid_1[sindex] && tags_1[sindex] == stag;
    let shit_2     : logic     = valid_2[sindex] && tags_2[sindex] == stag;
    let shit_3     : logic     = valid_3[sindex] && tags_3[sindex] == stag;
    let scache_hit : logic     = shit_0 || shit_1 || shit_2 || shit_3;
    // Victim way for a store MISS (write-through, no-allocate → invalidate the
    // victim so a later load refills the merged bytes from DRAM).
    let s_has_invalid: logic    = !valid_0[sindex] || !valid_1[sindex] || !valid_2[sindex] || !valid_3[sindex];
    let s_invalid_way: logic<2> = if !valid_0[sindex] ?
        2'd0
    : if !valid_1[sindex] ?
        2'd1
    : if !valid_2[sindex] ?
        2'd2
    :
        2'd3
    ;
    let s_plru_bits  : logic<3> = plru[sindex];
    let s_plru_way   : logic<2> = {s_plru_bits[2], if !s_plru_bits[2] ? s_plru_bits[1] : s_plru_bits[0]};
    let s_victim_way : logic<2> = if s_has_invalid ? s_invalid_way : s_plru_way;
    // The drain wins the single bus only when granted and no load-miss FILL is
    // using it (miss ⇒ IDLE+load-miss). want_store presents the request/address
    // pre-grant; store_can_drain qualifies the actual write strobe + cache write.
    let want_store     : logic = i_swen && state == State::IDLE && !miss;
    let store_can_drain: logic = want_store && i_mem_grant;
    assign o_sdrain_ack = store_can_drain;

    always_ff (clk, rst) {
        if_reset {
            state        = State::IDLE;
            fill_count   = 3'd0;
            fill_index   = 4'd0;
            fill_tag     = '0;
            fill_way     = 2'd0;
            fill_offset  = 3'd0;
            fill_aborted = 1'b0;
            amo_filled_q = 1'b0;
            for i in 0..16 {
                valid_0[i] = 1'b0;
                valid_1[i] = 1'b0;
                valid_2[i] = 1'b0;
                valid_3[i] = 1'b0;
            }
        } else {
            case state {
                State::IDLE: {
                    // M9.4 SMP: force an AMO/LR read-HIT to miss by invalidating
                    // the hit way. Next cycle cache_hit drops → lo_miss → the line
                    // re-fills from the bus under the amo_inflight lock (coherent).
                    // i_wen=0 for an AMO read phase, so this never races the write
                    // block below; miss=0 here (still a hit) so no fill starts yet.
                    if amo_force_trigger {
                        if hit_0 {
                            valid_0[index] = 1'b0;
                        }
                        if hit_1 {
                            valid_1[index] = 1'b0;
                        }
                        if hit_2 {
                            valid_2[index] = 1'b0;
                        }
                        if hit_3 {
                            valid_3[index] = 1'b0;
                        }
                    }
                    // Phase 5: gate fill start and write-through on bus grant.
                    // Without grant we hold the IDLE state and stall the pipe;
                    // memory_bus arbitrates between harts and holds grant for
                    // the entire 8-cycle FILL burst once we transition.
                    if miss && i_mem_grant {
                        fill_index   = f_index;
                        fill_tag     = f_tag;
                        fill_way     = victim_way;
                        fill_offset  = f_offset;
                        fill_count   = 3'd0;
                        fill_aborted = 1'b0;
                        state        = State::FILL;
                    }
                    // Write-through: update cache on write hit, invalidate on miss.
                    // Only commit the cache change + DRAM write when granted so
                    // the local update and the DRAM emission stay in lockstep.
                    if i_wen && i_mem_grant {
                        if i_wstrb_hi != 8'd0 {
                            // M8.B (B.3): misaligned 2-dword STORE. tb gets the
                            // lo dword (mem-side write-through below, o_mem_wen)
                            // and the hi dword (core o_dmem_wdata_hi bypass). The
                            // dcache can't hold the partial result, so invalidate
                            // any cached way for both touched lines (lo + next);
                            // a later load refills the merged bytes from memory.
                            if hit_0 {
                                valid_0[index] = 1'b0;
                            }
                            if hit_1 {
                                valid_1[index] = 1'b0;
                            }
                            if hit_2 {
                                valid_2[index] = 1'b0;
                            }
                            if hit_3 {
                                valid_3[index] = 1'b0;
                            }
                            if next_hit_0 {
                                valid_0[next_index] = 1'b0;
                            }
                            if next_hit_1 {
                                valid_1[next_index] = 1'b0;
                            }
                            if next_hit_2 {
                                valid_2[next_index] = 1'b0;
                            }
                            if next_hit_3 {
                                valid_3[next_index] = 1'b0;
                            }
                        } else if cache_hit {
                            let old   : logic<64> = if hit_0 ?
                                rdata_0
                            : if hit_1 ?
                                rdata_1
                            : if hit_2 ?
                                rdata_2
                            :
                                rdata_3
                            ;
                            let merged: logic<64> = {
                                if i_wstrb[7] ? i_wdata[63:56] : old[63:56],
                                if i_wstrb[6] ? i_wdata[55:48] : old[55:48],
                                if i_wstrb[5] ? i_wdata[47:40] : old[47:40],
                                if i_wstrb[4] ? i_wdata[39:32] : old[39:32],
                                if i_wstrb[3] ? i_wdata[31:24] : old[31:24],
                                if i_wstrb[2] ? i_wdata[23:16] : old[23:16], if i_wstrb[1] ? i_wdata[15:8] : old[15:8],
                                if i_wstrb[0] ? i_wdata[7:0] : old[7:0]
                            };
                            if hit_0 {
                                data_0[data_idx] = merged;
                            }
                            if hit_1 {
                                data_1[data_idx] = merged;
                            }
                            if hit_2 {
                                data_2[data_idx] = merged;
                            }
                            if hit_3 {
                                data_3[data_idx] = merged;
                            }
                        } else {
                            // Invalidate the way that would be selected if this were a read miss
                            if victim_way == 2'd0 {
                                valid_0[index] = 1'b0;
                            }
                            if victim_way == 2'd1 {
                                valid_1[index] = 1'b0;
                            }
                            if victim_way == 2'd2 {
                                valid_2[index] = 1'b0;
                            }
                            if victim_way == 2'd3 {
                                valid_3[index] = 1'b0;
                            }
                        }
                    }
                    // Phase 8 S6: store-drain WRITE (separate i_saddr port).
                    // Mirrors the i_wen hit/miss logic on sindex/sdata_idx with
                    // i_swdata/i_swstrb. Aligned plain stores only (no i_swstrb_hi
                    // straddle path — the core keeps misaligned stores on i_wen).
                    // Mutually exclusive with the i_wen block above at the core
                    // level, so no same-element double write. No PLRU update
                    // (replacement-policy only; correctness unaffected).
                    if store_can_drain {
                        if scache_hit {
                            let sold   : logic<64> = if shit_0 ?
                                data_0[sdata_idx]
                            : if shit_1 ?
                                data_1[sdata_idx]
                            : if shit_2 ?
                                data_2[sdata_idx]
                            :
                                data_3[sdata_idx]
                            ;
                            let smerged: logic<64> = {
                                if i_swstrb[7] ? i_swdata[63:56] : sold[63:56],
                                if i_swstrb[6] ? i_swdata[55:48] : sold[55:48],
                                if i_swstrb[5] ? i_swdata[47:40] : sold[47:40],
                                if i_swstrb[4] ? i_swdata[39:32] : sold[39:32],
                                if i_swstrb[3] ? i_swdata[31:24] : sold[31:24],
                                if i_swstrb[2] ? i_swdata[23:16] : sold[23:16], if i_swstrb[1] ? i_swdata[15:8] : sold[15:8],
                                if i_swstrb[0] ? i_swdata[7:0] : sold[7:0]
                            };
                            if shit_0 {
                                data_0[sdata_idx] = smerged;
                            }
                            if shit_1 {
                                data_1[sdata_idx] = smerged;
                            }
                            if shit_2 {
                                data_2[sdata_idx] = smerged;
                            }
                            if shit_3 {
                                data_3[sdata_idx] = smerged;
                            }
                        } else {
                            // Store miss: write-through to DRAM (o_mem below),
                            // invalidate the victim way (no-allocate).
                            if s_victim_way == 2'd0 {
                                valid_0[sindex] = 1'b0;
                            }
                            if s_victim_way == 2'd1 {
                                valid_1[sindex] = 1'b0;
                            }
                            if s_victim_way == 2'd2 {
                                valid_2[sindex] = 1'b0;
                            }
                            if s_victim_way == 2'd3 {
                                valid_3[sindex] = 1'b0;
                            }
                        }
                    }
                }
                State::FILL: {
                    // Phase 5: only write fill data and advance the count when
                    // bus is granted. memory_bus is expected to hold grant for
                    // the entire 8-cycle burst once a fill starts.
                    if i_mem_grant {
                        if fill_way == 2'd0 {
                            data_0[fill_data_idx] = i_mem_rdata;
                        }
                        if fill_way == 2'd1 {
                            data_1[fill_data_idx] = i_mem_rdata;
                        }
                        if fill_way == 2'd2 {
                            data_2[fill_data_idx] = i_mem_rdata;
                        }
                        if fill_way == 2'd3 {
                            data_3[fill_data_idx] = i_mem_rdata;
                        }
                        if fill_count == 3'd7 {
                            // Fill complete. If a remote invalidate hit this line
                            // mid-fill, leave valid=0 so the next access misses
                            // and re-fills. Tag write is harmless either way.
                            if fill_way == 2'd0 {
                                tags_0[fill_index]  = fill_tag;
                                valid_0[fill_index] = !fill_aborted;
                            }
                            if fill_way == 2'd1 {
                                tags_1[fill_index]  = fill_tag;
                                valid_1[fill_index] = !fill_aborted;
                            }
                            if fill_way == 2'd2 {
                                tags_2[fill_index]  = fill_tag;
                                valid_2[fill_index] = !fill_aborted;
                            }
                            if fill_way == 2'd3 {
                                tags_3[fill_index]  = fill_tag;
                                valid_3[fill_index] = !fill_aborted;
                            }
                            state = State::DONE;
                        } else {
                            fill_count = fill_count + 3'd1;
                        }
                    }
                }
                State::DONE: {
                    state = State::IDLE;
                }
                default: {
                    state = State::IDLE;
                }
            }

            // Update PLRU on cache hit (point tree AWAY from accessed way)
            if cache_hit && cpu_req && !filling {
                if hit_way[1] == 1'b0 {
                    plru[index][2] = 1'b1;
                    plru[index][1] = if hit_way[0] ? 1'b0 : 1'b1;
                } else {
                    plru[index][2] = 1'b0;
                    plru[index][0] = if hit_way[0] ? 1'b0 : 1'b1;
                }
            }

            // Remote invalidate: clear valid for matching tag in any way.
            // If the line currently being filled matches, latch fill_aborted
            // so the FILL completion does not set valid (forcing a re-fill on
            // the next access).
            if i_inv_valid {
                if valid_0[inv_index] && tags_0[inv_index] == inv_tag {
                    valid_0[inv_index] = 1'b0;
                }
                if valid_1[inv_index] && tags_1[inv_index] == inv_tag {
                    valid_1[inv_index] = 1'b0;
                }
                if valid_2[inv_index] && tags_2[inv_index] == inv_tag {
                    valid_2[inv_index] = 1'b0;
                }
                if valid_3[inv_index] && tags_3[inv_index] == inv_tag {
                    valid_3[inv_index] = 1'b0;
                }
                if state == State::FILL && fill_index == inv_index && fill_tag == inv_tag {
                    fill_aborted = 1'b1;
                }
            }

            // M9.4 SMP: AMO force-miss one-shot guard. Set when the forced
            // re-fill for the pending AMO read completes (DONE) — the line is now
            // fresh, so the post-fill hit must not re-trigger amo_force_trigger.
            // Cleared when the AMO read request drops (next AMO re-arms the guard).
            if !i_amo_read {
                amo_filled_q = 1'b0;
            } else if state == State::DONE {
                amo_filled_q = 1'b1;
            }
        }
    }

    // Read data: from hit way on cache hit, from memory during fill
    assign o_rdata = if hit_0 ? rdata_0 : if hit_1 ? rdata_1 : if hit_2 ? rdata_2 : if hit_3 ? rdata_3 : i_mem_rdata;

    // M8.B: next-dword read for misaligned 2-dword loads (decode moved up to the
    // miss-handling section). Same line ⇒ reuse the lo-access hit way; cross line
    // ⇒ pick the next line's hit way (filled by the hi_miss second fill above).
    // o_rdata_next_miss = a read is active and the next dword's line is not
    // cached (informational; the hi_miss path already stalls cross-line loads).
    let next_rdata_same : logic<64> = if hit_0 ?
        data_0[next_data_idx]
    : if hit_1 ?
        data_1[next_data_idx]
    : if hit_2 ?
        data_2[next_data_idx]
    :
        data_3[next_data_idx]
    ;
    let next_rdata_xline: logic<64> = if next_hit_0 ?
        data_0[next_data_idx]
    : if next_hit_1 ?
        data_1[next_data_idx]
    : if next_hit_2 ?
        data_2[next_data_idx]
    :
        data_3[next_data_idx]
    ;
    assign o_rdata_next      = if next_same_line ? next_rdata_same : next_rdata_xline;
    assign o_rdata_next_miss = i_ren && (if next_same_line ? !cache_hit : !next_line_hit);

    // Memory interface. Phase 8 S6: the store-drain (i_saddr/i_swdata) is the
    // LOWEST-priority bus user: FILL > i_wen write > load-miss read > store
    // drain. want_store requires !miss, so it never coexists with a load-miss
    // read; i_wen and i_swen are mutually exclusive at the core, so the i_wen
    // and store-drain write terms never both fire.
    assign o_mem_addr = if filling ?
        {fill_tag, fill_index, fill_count, 3'b000}
    : if i_wen ?
        i_addr
    : if i_ren && !cache_hit ?
        {tag, index, 3'd0, 3'b000}
    : if want_store ?
        i_saddr
    :
        '0
    ;

    assign o_mem_wdata = if i_wen && !filling ? i_wdata : if store_can_drain ? i_swdata : '0;

    // Suppress write-through on cache miss when AMO (ren && wen) to prevent
    // corrupting DRAM before the fill reads the old value.
    let amo_miss: logic = i_ren && i_wen && !cache_hit;
    // Phase 5: only emit DRAM write strobe when bus is granted. Otherwise the
    // write must wait until the arbiter gives us a slot. S6: the store drain
    // adds its write strobe (store_can_drain already implies i_mem_grant + !miss).
    assign o_mem_wen   = if filling ? 1'b0 : if amo_miss ? 1'b0 : (i_wen && i_mem_grant) || store_can_drain;
    assign o_mem_ren   = if filling ? 1'b1 : if i_ren && !cache_hit && i_mem_grant ? 1'b1 : 1'b0;
    assign o_mem_wstrb = if i_wen && !filling && i_mem_grant ? i_wstrb : if store_can_drain ? i_swstrb : '0;

    // Bus request: any cycle we need DRAM access. memory_bus arbitrates
    // among harts and asserts i_mem_grant when this hart's turn comes.
    let want_fill_start: logic = miss; // IDLE+miss
    let want_write     : logic = i_wen && !amo_miss && state == State::IDLE;
    assign o_mem_req = filling || want_fill_start || want_write || want_store;

    // Non-blocking miss interface (Phase 8 S10). o_miss_valid pulses on the
    // cycle the fill actually STARTS (miss && grant — the IDLE→FILL edge), not
    // on the raw miss: without the grant the FSM stays IDLE and needs i_ren
    // held to keep requesting the bus, so a core that captured the load into
    // an MSHR on the raw miss and dropped i_ren would strand the fill.
    // o_fill_complete excludes an aborted fill (remote-write i_inv during the
    // fill): the line stays Invalid and the filled data may be stale, so the
    // MSHR consumer must NOT complete the load from o_fill_rdata — it replays.
    assign o_miss_valid    = miss && i_mem_grant;
    assign o_fill_complete = state == State::DONE && !fill_aborted;
    assign o_fill_aborted  = state == State::DONE && fill_aborted;
    // Phase 5 SMP fix: data is valid for this hart's request only when
    // the cache actually has the data (hit) or the fill just completed
    // (DONE state — filled doubleword is in data_X arrays). During
    // MISS/FILL, o_rdata mirrors shared bus rdata which may be another
    // hart's transaction; consumers (e.g. memory.veryl amo_saved_rdata)
    // must gate on this to avoid mid-fill stale captures.
    assign o_data_valid = cache_hit || (state == State::DONE);

    // Re-read filled data at original miss offset (valid during DONE)
    let fill_rdata_idx: logic<7> = {fill_index, fill_offset};
    assign o_fill_rdata = if fill_way == 2'd0 ?
        data_0[fill_rdata_idx]
    : if fill_way == 2'd1 ?
        data_1[fill_rdata_idx]
    : if fill_way == 2'd2 ?
        data_2[fill_rdata_idx]
    :
        data_3[fill_rdata_idx]
    ;

    // ============================================================
    // Phase 8 S5.2: 2nd hit-only READ port. Pure combinational mirror of the
    // lo/hi hit logic above on i_addr2. No state writes, no o_stall effect.
    // ============================================================
    let tag2      : logic<54> = i_addr2[63:10];
    let index2    : logic<4>  = i_addr2[9:6];
    let offset2   : logic<3>  = i_addr2[5:3];
    let data_idx2 : logic<7>  = {index2, offset2};
    // Phase 8 S10.2 (hit-under-miss): mid-FILL the victim way (fill_way at
    // fill_index) still carries its OLD tag + valid while its DATA words are
    // being overwritten — a port-2 hit on that way would return corrupted
    // data (the hazard that previously forced the core to gate o_hit2 on
    // !o_stall). Exclude exactly that way per-set so the 2nd port is safe
    // DURING a fill; every other line/way is consistent mid-fill (stores
    // only write arrays in IDLE, tags+valid update atomically with the last
    // fill word, DONE/IDLE need no exclusion).
    let fill_busy2: logic = filling && fill_index == index2;
    let hit2_0    : logic     = valid_0[index2] && tags_0[index2] == tag2 && !(fill_busy2 && fill_way == 2'd0);
    let hit2_1    : logic     = valid_1[index2] && tags_1[index2] == tag2 && !(fill_busy2 && fill_way == 2'd1);
    let hit2_2    : logic     = valid_2[index2] && tags_2[index2] == tag2 && !(fill_busy2 && fill_way == 2'd2);
    let hit2_3    : logic     = valid_3[index2] && tags_3[index2] == tag2 && !(fill_busy2 && fill_way == 2'd3);
    let cache_hit2: logic     = hit2_0 || hit2_1 || hit2_2 || hit2_3;
    let rdata2_0  : logic<64> = data_0[data_idx2];
    let rdata2_1  : logic<64> = data_1[data_idx2];
    let rdata2_2  : logic<64> = data_2[data_idx2];
    let rdata2_3  : logic<64> = data_3[data_idx2];
    assign o_rdata2 = if hit2_0 ? rdata2_0 : if hit2_1 ? rdata2_1 : if hit2_2 ? rdata2_2 : rdata2_3;
    // Next-dword for a misaligned 2-dword 2nd load (mirror of o_rdata_next).
    let next_addr2     : logic<64> = {i_addr2[63:3], 3'b000} + 64'd8;
    let next_index2    : logic<4>  = next_addr2[9:6];
    let next_offset2   : logic<3>  = next_addr2[5:3];
    let next_tag2      : logic<54> = next_addr2[63:10];
    let next_same_line2: logic     = offset2 != 3'd7;
    let next_data_idx2 : logic<7>  = {next_index2, next_offset2};
    // S10.2: same victim-way exclusion for the next-line hit (cross-dword span).
    let fill_busy2_next: logic     = filling && fill_index == next_index2;
    let next_hit2_0    : logic     = valid_0[next_index2] && tags_0[next_index2] == next_tag2 && !(fill_busy2_next && fill_way == 2'd0);
    let next_hit2_1    : logic     = valid_1[next_index2] && tags_1[next_index2] == next_tag2 && !(fill_busy2_next && fill_way == 2'd1);
    let next_hit2_2    : logic     = valid_2[next_index2] && tags_2[next_index2] == next_tag2 && !(fill_busy2_next && fill_way == 2'd2);
    let next_hit2_3    : logic     = valid_3[next_index2] && tags_3[next_index2] == next_tag2 && !(fill_busy2_next && fill_way == 2'd3);
    let next_line_hit2 : logic     = next_hit2_0 || next_hit2_1 || next_hit2_2 || next_hit2_3;
    let next_rdata2_same : logic<64> = if hit2_0 ?
        data_0[next_data_idx2]
    : if hit2_1 ?
        data_1[next_data_idx2]
    : if hit2_2 ?
        data_2[next_data_idx2]
    :
        data_3[next_data_idx2]
    ;
    let next_rdata2_xline: logic<64> = if next_hit2_0 ?
        data_0[next_data_idx2]
    : if next_hit2_1 ?
        data_1[next_data_idx2]
    : if next_hit2_2 ?
        data_2[next_data_idx2]
    :
        data_3[next_data_idx2]
    ;
    assign o_rdata2_next = if next_same_line2 ? next_rdata2_same : next_rdata2_xline;
    // Hit iff the lo line is cached AND (no span / span in same line / next line
    // also cached). i_ren2 gates the whole port.
    let hi_ok2: logic = !i_load_next2 || next_same_line2 || next_line_hit2;
    assign o_hit2 = i_ren2 && cache_hit2 && hi_ok2;

    // Stall on miss, during fill, DONE, and writes during fill.
    // Fill state stalls all accesses (original conservative behavior).
    // Phase 5: also stall while waiting for bus grant on a write-through.
    let write_during_fill: logic = filling && i_wen;
    let write_wait_grant : logic = state == State::IDLE && i_wen && !amo_miss && !i_mem_grant;
    assign o_stall = (state == State::FILL) || miss || (state == State::DONE) || write_during_fill || write_wait_grant
        || inv_hits_active || amo_force_trigger;

}
