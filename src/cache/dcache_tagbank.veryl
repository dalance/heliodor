// D-cache TAG bank — one replication copy (TAG array only; Phase 13 realistic-SRAM
// tag migration). See doc/cp_dcache_tag_replication_plan.md.
//
// ONLY the tag is migrated to 1R1W SRAM. valid/dirty/excl stay flops in the parent:
// they are read associatively every cycle AND a misaligned store clears two sets of
// the same way in one cycle (valid_k[index] + valid_k[next_index]), which no 1W SRAM
// can serve — see sram_inventory.md §Refinement. The tag, by contrast, is written on
// FILL only (one way, one index per cycle), so it maps cleanly to 1R1W.
//
// One instance = one copy = one 64×TAG_W 1R1W macro per way: a single combinational
// read at i_ridx (o_tag_*), and a single per-way fill write (we/idx/val). The parent
// resolves the fill write ONCE and broadcasts it identically to every instance, so all
// copies hold identical tags (byte-identical); only the read index differs per instance.
// Tags are don't-care while the way is invalid (the parent's valid flop gates them), so
// they are intentionally not reset (benign missing_reset, matching the parent dcache).
pub module dcache_tagbank #(
    param INDEX_W: u32 = 6,  // log2(#sets)
    param TAG_W  : u32 = 52, // 58 - INDEX_W at the default
) (
    clk: input clock,
    rst: input reset,
    // --- per-way TAG write (fill; parent-resolved, broadcast identical to all instances) ---
    i_t_we_0: input logic, i_t_idx_0: input logic<INDEX_W>, i_t_val_0: input logic<TAG_W>,
    i_t_we_1: input logic, i_t_idx_1: input logic<INDEX_W>, i_t_val_1: input logic<TAG_W>,
    i_t_we_2: input logic, i_t_idx_2: input logic<INDEX_W>, i_t_val_2: input logic<TAG_W>,
    i_t_we_3: input logic, i_t_idx_3: input logic<INDEX_W>, i_t_val_3: input logic<TAG_W>,
    // --- per-instance READ (one combinational 4-way tag read at i_ridx) ---
    i_ridx  : input  logic<INDEX_W>,
    o_tag_0 : output logic<TAG_W>,
    o_tag_1 : output logic<TAG_W>,
    o_tag_2 : output logic<TAG_W>,
    o_tag_3 : output logic<TAG_W>,
) {
    const SETS: u32 = 1 << INDEX_W;

    var tags_0: logic<TAG_W> [SETS];
    var tags_1: logic<TAG_W> [SETS];
    var tags_2: logic<TAG_W> [SETS];
    var tags_3: logic<TAG_W> [SETS];

    always_ff {
        if_reset {
            // tags intentionally unreset (valid flop gates them); benign missing_reset.
        } else {
            if i_t_we_0 {
                tags_0[i_t_idx_0] = i_t_val_0;
            }
            if i_t_we_1 {
                tags_1[i_t_idx_1] = i_t_val_1;
            }
            if i_t_we_2 {
                tags_2[i_t_idx_2] = i_t_val_2;
            }
            if i_t_we_3 {
                tags_3[i_t_idx_3] = i_t_val_3;
            }
        }
    }

    // Single combinational 4-way tag read at i_ridx (the 1R port of each 1R1W macro).
    assign o_tag_0 = tags_0[i_ridx];
    assign o_tag_1 = tags_1[i_ridx];
    assign o_tag_2 = tags_2[i_ridx];
    assign o_tag_3 = tags_3[i_ridx];
}
