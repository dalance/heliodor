// dmi_apb: APB4 slave that turns each transfer into one DMI access.
//
// Ports (timing contract):
//   i_psel..i_pstrb : APB4 completer inputs, synchronous to clk. paddr[8:2]
//                     is the DMI address, paddr[1:0] is ignored.
//   o_raddr         : paddr[8:2], combinational; the DM decodes its read
//                     value from it
//   i_rdata         : the DM's read value for o_raddr, combinational
//   o_pready, o_prdata, o_pslverr : registered. Every transfer has one wait
//                     state: the first ACCESS cycle registers the read value,
//                     the second one completes with pready = 1.
//   o_req           : valid in the completing cycle only; the DM applies the
//                     write and every read side effect on that edge
// Owns:
//   - Exactly one o_req per completed transfer that is not an error, and none
//     for a write whose strobes are not all set: such a write is dropped and
//     completes with pslverr = 1.
//   - No combinational path from DM state to the APB outputs.
module dmi_apb (
    clk      : input  clock          ,
    rst      : input  reset          ,
    i_psel   : input  logic          ,
    i_penable: input  logic          ,
    i_pwrite : input  logic          ,
    i_paddr  : input  logic<9>       ,
    i_pwdata : input  logic<32>      ,
    i_pstrb  : input  logic<4>       ,
    o_pready : output logic          ,
    o_prdata : output logic<32>      ,
    o_pslverr: output logic          ,
    o_raddr  : output logic<7>       ,
    i_rdata  : input  logic<32>      ,
    o_req    : output dm_pkg::DmiReq ,
) {
    var wait_q : logic    ;
    var err_q  : logic    ;
    var rdata_q: logic<32>;

    let first: logic = i_psel && i_penable && !wait_q;

    always_ff {
        if_reset {
            wait_q  = 1'b0;
            err_q   = 1'b0;
            rdata_q = 32'd0;
        } else if first {
            wait_q  = 1'b1;
            err_q   = i_pwrite && i_pstrb != 4'hf;
            rdata_q = if i_pwrite ? 32'd0 : i_rdata;
        } else {
            wait_q = 1'b0;
            err_q  = 1'b0;
        }
    }

    assign o_raddr   = i_paddr[8:2];
    assign o_pready  = wait_q;
    assign o_prdata  = rdata_q;
    assign o_pslverr = err_q;
    assign o_req     = dm_pkg::DmiReq'{
        valid: wait_q && !err_q,
        write: i_pwrite        ,
        addr : i_paddr[8:2]    ,
        data : i_pwdata        ,
    };
}
