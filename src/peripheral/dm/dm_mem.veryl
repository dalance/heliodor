// dm_mem: debug memory, the harts' view of the Debug Module on the SoC bus.
//
// Ports (timing contract):
//   i_raddr/o_rdata : combinational single-beat read; the offset from
//                     DM_BASE in, the aligned dword out (the bus's legacy
//                     read channel takes data in the grant cycle)
//   i_wen, i_waddr, i_wdata : a write granted this cycle; i_wdata is the
//                     dword lane of the written address
//   i_resume        : per-hart RESUME flags (dm)
//   o_halted, o_resuming, o_hartid : combinational decode of this cycle's
//                     write to HALTED or RESUMING and the hartid it carries
// Owns:
//   - The code region reads the debug ROM (dm_rom_pkg) and zero past it;
//     the data region reads the flag bytes and zero elsewhere.
//   - Reads have no side effects; only the word writes above are decoded.
module dm_mem #(
    param N_HARTS: u32 = 1,
) (
    i_raddr   : input  logic<13>     ,
    o_rdata   : output logic<64>     ,
    i_wen     : input  logic         ,
    i_waddr   : input  logic<13>     ,
    i_wdata   : input  logic<64>     ,
    i_resume  : input  logic<N_HARTS>,
    o_halted  : output logic         ,
    o_resuming: output logic         ,
    o_hartid  : output logic<32>     ,
) {
    const ROM_DW: u32 = dm_rom_pkg::ROM_N / 2;

    var flags: logic<64>;
    always_comb {
        flags = 64'd0;
        for h in 0..N_HARTS {
            flags[h * 8 + dm_pkg::FLAG_RESUME] = i_resume[h];
        }
    }

    let dw   : logic<10> = {1'b0, i_raddr[11:3]};
    let rom_v: logic     = !i_raddr[12] && ((dw as u32) <: ROM_DW);
    let rom_i: logic<10> = if rom_v ? dw : 10'd0;
    let rom  : logic<64> = {dm_rom_pkg::ROM[{rom_i[8:0], 1'b1}], dm_rom_pkg::ROM[{rom_i[8:0], 1'b0}]};

    assign o_rdata = if rom_v ?
        rom
    : if i_raddr[12:3] == dm_pkg::MEM_FLAGS[12:3] ?
        flags
    :
        64'd0
    ;

    let wword: logic<13> = {i_waddr[12:2], 2'b00};
    assign o_halted   = i_wen && wword == dm_pkg::MEM_HALTED;
    assign o_resuming = i_wen && wword == dm_pkg::MEM_RESUMING;
    assign o_hartid   = if i_waddr[2] ? i_wdata[63:32] : i_wdata[31:0];
}
