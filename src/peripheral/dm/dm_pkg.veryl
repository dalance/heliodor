// dm_pkg: the DMI access record and the Debug Module address maps.
//
// DMI registers are the Debug Spec 1.0 ones (7-bit DMI address). Debug memory
// offsets are from DM_BASE: the code region [0x0000, 0x1000) holds the ROM
// (dm_rom.S, entry at 0x000) and from ABS_OFF the abstract command program,
// the program buffer and the implicit ebreak; the data region [0x1000,
// 0x2000) holds data0/data1, the words a hart writes and the per-hart flag
// bytes. dm_rom.S uses the same offsets.
package dm_pkg {
    const DMI_DATA0       : logic<7> = 7'h04;
    const DMI_DATA1       : logic<7> = 7'h05;
    const DMI_DMCONTROL   : logic<7> = 7'h10;
    const DMI_DMSTATUS    : logic<7> = 7'h11;
    const DMI_HARTINFO    : logic<7> = 7'h12;
    const DMI_ABSTRACTCS  : logic<7> = 7'h16;
    const DMI_COMMAND     : logic<7> = 7'h17;
    const DMI_ABSTRACTAUTO: logic<7> = 7'h18;
    const DMI_PROGBUF0    : logic<7> = 7'h20;

    const DATACOUNT  : u32 = 2;
    const PROGBUFSIZE: u32 = 8;

    // One DMI access, valid for the single cycle that carries its side
    // effects. A read has write = 0; data is the write data.
    struct DmiReq {
        valid: logic    ,
        write: logic    ,
        addr : logic<7> ,
        data : logic<32>,
    }

    // A hart's write to one of the words it reports through, decoded by
    // dm_mem. value is the written word.
    struct HartWr {
        halted   : logic    ,
        going    : logic    ,
        resuming : logic    ,
        exception: logic    ,
        value    : logic<32>,
    }

    // Debug memory offsets (13 bits: the code and data regions).
    const MEM_ABS      : logic<13> = 13'h0300; // abstract command program (ABS_N words), progbuf, impebreak
    const MEM_DATA     : logic<13> = 13'h1000; // data0, data1
    const MEM_HALTED   : logic<13> = 13'h1100; // hart writes its hartid on every halt loop pass
    const MEM_GOING    : logic<13> = 13'h1104; // hart writes its dcsr.mprven bit before jumping to MEM_ABS
    const MEM_RESUMING : logic<13> = 13'h1108; // hart writes its hartid before dret
    const MEM_EXCEPTION: logic<13> = 13'h110C; // hart writes after an exception in Debug Mode
    const MEM_FLAGS    : logic<13> = 13'h1400; // byte h: bit 0 GO, bit 1 RESUME of hart h

    // Words from MEM_ABS: the generated program, the program buffer and the
    // implicit ebreak after it.
    const ABS_N : u32 = 12;
    const CODE_N: u32 = ABS_N + PROGBUFSIZE + 1;

    // Per-hart flag bits in the flag byte.
    const FLAG_GO    : u32 = 0;
    const FLAG_RESUME: u32 = 1;

    // abstractcs.cmderr values.
    const ERR_NONE : logic<3> = 3'd0;
    const ERR_BUSY : logic<3> = 3'd1;
    const ERR_NOSUP: logic<3> = 3'd2;
    const ERR_EXC  : logic<3> = 3'd3;
    const ERR_HALT : logic<3> = 3'd4;

    // Kind of an accepted abstract command, for the observation port.
    enum CmdKind: logic<2> {
        EXEC, // no transfer (postexec only)
        GPR,
        FPR,
        CSR,
    }

    // Abstract command events for the SoC's observation port.
    struct CmdObs {
        start : logic   , // a command was accepted and the hart told to run it
        kind  : CmdKind , // its kind, with start
        err   : logic<3>, // cmderr became this nonzero value this cycle
        busy  : logic   ,
        halted: logic   , // the command hart is halted (while busy)
    }

    // cmderr for starting command cmd: 2 (not supported) unless it is an
    // Access Register of a GPR, FPR or CSR, size 32 or 64, without
    // aarpostincrement; the register is checked only with transfer.
    function cmd_err (
        cmd: input logic<32>,
    ) -> logic<3> {
        let size : logic<3>  = cmd[22:20];
        let rn   : logic<16> = cmd[15:0];
        let known: logic     = rn[15:12] == 4'h0 || rn[15:6] == 10'h040;
        let bad  : logic     = cmd[31:24] != 8'd0 || cmd[19] || (cmd[17] && ((size != 3'd2 && size != 3'd3) || !known));
        return if bad ? ERR_NOSUP : ERR_NONE;
    }

    function cmd_kind (
        cmd: input logic<32>,
    ) -> CmdKind {
        return if !cmd[17] ?
            CmdKind::EXEC
        : if cmd[15:5] == 11'h080 ?
            CmdKind::GPR
        : if cmd[15:5] == 11'h081 ?
            CmdKind::FPR
        :
            CmdKind::CSR
        ;
    }
}
