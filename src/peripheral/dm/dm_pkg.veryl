// dm_pkg: the DMI access record and the Debug Module address maps.
//
// DMI registers are the Debug Spec 1.0 ones (7-bit DMI address). Debug memory
// offsets are from DM_BASE: the code region [0x0000, 0x1000) holds the ROM
// (dm_rom.S, entry at 0x000) and from MEM_ABS the abstract command program,
// the program buffer and the implicit ebreak; the data region [0x1000,
// 0x2000) holds data0/data1, the words a hart writes and the per-hart flag
// bytes. dm_rom.S uses the same offsets.
package dm_pkg {
    const DMI_DATA0       : logic<7> = 7'h04;
    const DMI_DATA1       : logic<7> = 7'h05;
    const DMI_DMCONTROL   : logic<7> = 7'h10;
    const DMI_DMSTATUS    : logic<7> = 7'h11;
    const DMI_HARTINFO    : logic<7> = 7'h12;
    const DMI_HAWINDOWSEL : logic<7> = 7'h14;
    const DMI_HAWINDOW    : logic<7> = 7'h15;
    const DMI_ABSTRACTCS  : logic<7> = 7'h16;
    const DMI_COMMAND     : logic<7> = 7'h17;
    const DMI_ABSTRACTAUTO: logic<7> = 7'h18;
    const DMI_PROGBUF0    : logic<7> = 7'h20;
    const DMI_DMCS2       : logic<7> = 7'h32;
    const DMI_SBCS        : logic<7> = 7'h38;
    const DMI_SBADDRESS0  : logic<7> = 7'h39;
    const DMI_SBADDRESS1  : logic<7> = 7'h3A;
    const DMI_SBDATA0     : logic<7> = 7'h3C;
    const DMI_SBDATA1     : logic<7> = 7'h3D;
    const DMI_HALTSUM0    : logic<7> = 7'h40;

    const DATACOUNT  : u32 = 2;
    const PROGBUFSIZE: u32 = 8;

    // One DMI access, valid for the single cycle that carries its side
    // effects. A read has write = 0; data is the write data.
    struct DmiReq {
        valid: logic    ,
        write: logic    ,
        addr : logic<7> ,
        data : logic<32>,
    }

    // A hart's write to one of the words it reports through, decoded by
    // dm_mem. value is the written word.
    struct HartWr {
        halted   : logic    ,
        going    : logic    ,
        resuming : logic    ,
        exception: logic    ,
        value    : logic<32>,
    }

    // Debug memory offsets (13 bits: the code and data regions).
    const MEM_ABS      : logic<13> = 13'h0300; // abstract command program (ABS_N words), progbuf, impebreak
    const MEM_DATA     : logic<13> = 13'h1000; // data0, data1
    const MEM_HALTED   : logic<13> = 13'h1100; // hart writes its hartid on every halt loop pass
    const MEM_GOING    : logic<13> = 13'h1104; // hart writes its dcsr.mprven bit before jumping to MEM_ABS
    const MEM_RESUMING : logic<13> = 13'h1108; // hart writes its hartid before dret
    const MEM_EXCEPTION: logic<13> = 13'h110C; // hart writes after an exception in Debug Mode
    const MEM_FLAGS    : logic<13> = 13'h1400; // byte h: bit 0 GO, bit 1 RESUME of hart h

    // Words from MEM_ABS: the generated program, the program buffer and the
    // implicit ebreak after it.
    const ABS_N : u32 = 12;
    const CODE_N: u32 = ABS_N + PROGBUFSIZE + 1;

    // Per-hart flag bits in the flag byte.
    const FLAG_GO    : u32 = 0;
    const FLAG_RESUME: u32 = 1;

    // abstractcs.cmderr values.
    const ERR_NONE : logic<3> = 3'd0;
    const ERR_BUSY : logic<3> = 3'd1;
    const ERR_NOSUP: logic<3> = 3'd2;
    const ERR_EXC  : logic<3> = 3'd3;
    const ERR_HALT : logic<3> = 3'd4;

    // Kind of an accepted abstract command, for the observation port.
    enum CmdKind: logic<2> {
        EXEC, // no transfer (postexec only)
        GPR,
        FPR,
        CSR,
    }

    // Abstract command events for the SoC's observation port.
    struct CmdObs {
        start : logic   , // a command was accepted and the hart told to run it
        kind  : CmdKind , // its kind, with start
        err   : logic<3>, // cmderr became this nonzero value this cycle
        busy  : logic   ,
        halted: logic   , // the command hart is halted (while busy)
    }

    // Per-hart run state and group membership for the SoC's observation
    // port, hart h in bit h (halted, resume, ghalt, gresume) or in nibble h
    // (hgrp, rgrp: the halt and resume group, 0 = none).
    struct HartObs {
        halted : logic<8> , // the DM counts the hart as halted
        resume : logic<8> , // the RESUME flag the ROM waits for
        ghalt  : logic<8> , // a halt request raised by the hart's halt group is outstanding
        gresume: logic<8> , // RESUME raised through a resume group this cycle
        hgrp   : logic<32>,
        rgrp   : logic<32>,
    }

    // Reset state for the SoC's observation port, hart h in bit h.
    struct RstObs {
        ndm      : logic   , // the platform is held in reset (ndmreset)
        drain    : logic   , // an ndmreset waits for mem_ctrl to go idle on AXI
        idle     : logic   , // mem_ctrl has no AXI transaction outstanding
        hrst     : logic<8>, // the hart is in reset (ndmreset or hartreset)
        hreq     : logic<8>, // a hartreset request waits for the core to quiesce
        quiet    : logic<8>, // the core has quiesced for hartreset
        havereset: logic<8>,
        resethalt: logic<8>, // resethaltreq
    }

    // The one System Bus Access dm_sba presents, held from its start to its
    // completion. wdata is the dword with the written bytes in their byte
    // lanes and strb their strobes; size is log2 of the byte count.
    struct SbaReq {
        valid: logic    ,
        write: logic    ,
        addr : logic<56>,
        size : logic<2> ,
        wdata: logic<64>,
        strb : logic<8> ,
    }

    // sbcs.sberror values.
    const SBERR_NONE : logic<3> = 3'd0;
    const SBERR_ADDR : logic<3> = 3'd2;
    const SBERR_ALIGN: logic<3> = 3'd3;
    const SBERR_SIZE : logic<3> = 3'd4;

    // System Bus Access events for the SoC's observation port.
    struct SbaObs {
        start  : logic   , // an access starts (sbbusy rises on this edge)
        done   : logic   , // the outstanding access completes (or dmactive drops it) this cycle
        write  : logic   , // the completing access is a write, with done
        err    : logic<3>, // sberror became this nonzero value this cycle
        busyerr: logic   , // sbbusyerror became set this cycle
        busy   : logic   , // an access is outstanding (sbbusy)
    }

    // cmderr for starting command cmd: 2 (not supported) unless it is an
    // Access Register of a GPR, FPR or CSR, size 32 or 64, without
    // aarpostincrement; the register is checked only with transfer.
    // dscratch0/1 are rejected: the abstract program keeps s0/s1 in them.
    function cmd_err (
        cmd: input logic<32>,
    ) -> logic<3> {
        let size : logic<3>  = cmd[22:20];
        let rn   : logic<16> = cmd[15:0];
        let dscr : logic     = rn == 16'h07b2 || rn == 16'h07b3;
        let known: logic     = (rn[15:12] == 4'h0 && !dscr) || rn[15:6] == 10'h040;
        let bad  : logic     = cmd[31:24] != 8'd0 || cmd[19] || (cmd[17] && ((size != 3'd2 && size != 3'd3) || !known));
        return if bad ? ERR_NOSUP : ERR_NONE;
    }

    function cmd_kind (
        cmd: input logic<32>,
    ) -> CmdKind {
        return if !cmd[17] ?
            CmdKind::EXEC
        : if cmd[15:5] == 11'h080 ?
            CmdKind::GPR
        : if cmd[15:5] == 11'h081 ?
            CmdKind::FPR
        :
            CmdKind::CSR
        ;
    }
}
