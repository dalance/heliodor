// PLIC (Platform-Level Interrupt Controller) — multi-hart capable.
//
// 32 interrupt sources (1-31 usable, source 0 reserved).
// 2 contexts per hart: ctx = 2*hart + 0 → M-mode, ctx = 2*hart + 1 → S-mode.
// 3-bit prio (0 = disabled, 1-7 = active).
//
// Memory map (base 0x0C000000):
//   0x000004 + 4*src         : prio[src]                (src 1..31)
//   0x001000                 : pending bits [31:0]      (read-only)
//   0x002000 + 0x80*ctx      : enable[ctx]              [31:0]
//   0x200000 + 0x1000*ctx    : threshold[ctx]
//   0x200004 + 0x1000*ctx    : claim/complete[ctx]
//
// Up to 8 harts (16 contexts) supported in the current 24-bit address space.
pub module plic #(
    param N_HARTS: u32 = 1,
) (
    clk: input clock,
    rst: input reset,
    // Interrupt sources (active-high, directly from peripherals)
    i_src: input logic<32>, // bit 0 unused (reserved)
    // Memory-mapped register interface
    i_addr : input  logic<24>, // byte address offset within PLIC region
    i_wdata: input  logic<64>,
    i_wen  : input  logic    ,
    i_ren  : input  logic    ,
    o_rdata: output logic<64>,
    // Interrupt outputs per hart
    o_irq_m: output logic [N_HARTS], // M-mode external (MEIP[h])
    o_irq_s: output logic [N_HARTS], // S-mode external (SEIP[h])
) {
    // Total context count (M and S per hart)
    const N_CTX: u32 = 2 * N_HARTS;

    // Priority registers: 3 bits each, 0 = disabled
    var prio: logic<3> [32];

    // Pending bits (latched from i_src)
    var pending: logic<32>;

    // Per-context state
    var enable   : logic<32> [N_CTX];
    var threshold: logic<3>  [N_CTX];
    var claimed  : logic<5>  [N_CTX]; // claimed source per context (0 = none)

    // ============================================================
    // Best candidate selection per context
    // ============================================================
    var best_id : logic<5> [N_CTX];
    var best_pri: logic<3> [N_CTX];

    always_comb {
        for c in 0..N_CTX {
            best_id[c]  = 5'd0;
            best_pri[c] = 3'd0;
        }
        for c in 0..N_CTX {
            for i in 1..32 {
                if pending[i] && enable[c][i] && prio[i] >: best_pri[c] {
                    best_id[c]  = i[4:0];
                    best_pri[c] = prio[i];
                }
            }
        }
    }

    // IRQ output per hart: ctx 2h = M-mode, ctx 2h+1 = S-mode
    always_comb {
        for h in 0..N_HARTS {
            o_irq_m[h] = best_pri[2 * h] >: threshold[2 * h];
            o_irq_s[h] = best_pri[2 * h + 1] >: threshold[2 * h + 1];
        }
    }

    // ============================================================
    // Address decode regions
    // ============================================================
    let is_prio: logic    = i_addr[23:12] == 12'h000 && i_addr[11:2] != 10'd0; // 0x000004..0x00007C
    let src_idx: logic<5> = i_addr[6:2];

    let is_pending: logic = i_addr[23:0] == 24'h001000;

    // Enable region: 0x002000 + 0x80*ctx, ctx fits in i_addr[11:7].
    // Up to 32 contexts addressable; we range-check against N_CTX.
    let is_enable_region: logic    = i_addr[23:12] == 12'h002;
    let enable_ctx      : logic<5> = i_addr[11:7];
    let is_enable       : logic    = is_enable_region && enable_ctx <: N_CTX as 5;

    // Threshold/claim region: 0x200000 + 0x1000*ctx, ctx in i_addr[15:12]
    // (4-bit, supports up to 16 contexts = 8 harts). Region base 0x200000 ⇒
    // i_addr[23:16] == 8'h20 (ctx occupies bits 15:12).
    let is_thresh_region: logic    = i_addr[23:16] == 8'h20;
    let thresh_ctx      : logic<4> = i_addr[15:12];
    // Range-check in 5 bits: N_CTX (up to 16) does NOT fit in 4 (16 as 4 = 0,
    // the P9.4 CLINT truncation class), so zero-extend both operands.
    let thresh_in_range : logic    = ({1'b0, thresh_ctx} as 5) <: (N_CTX as 5);
    let is_thresh       : logic    = is_thresh_region && thresh_in_range && i_addr[11:0] == 12'h000;
    let is_claim        : logic    = is_thresh_region && thresh_in_range && i_addr[11:0] == 12'h004;

    // ============================================================
    // Register read
    // ============================================================
    // All PLIC registers are 32-bit. The 32-bit value is placed on the 64-bit
    // bus's high or low word per i_addr[2]: a 4-byte access to a 0x..4 address
    // (claim, odd-context threshold, odd-source priority) lands in the HIGH
    // word, matching the core's load byte-offset shift (ld_concat >> addr[2:0]*8
    // in alu_wrap). Returning everything in the low word would make those reads
    // come back as 0 through the core's load path.
    var rval32: logic<32>;
    always_comb {
        rval32 = 32'd0;
        if is_prio {
            rval32 = {29'd0, prio[src_idx]};
        } else if is_pending {
            rval32 = pending;
        } else if is_enable {
            rval32 = enable[enable_ctx[3:0]];
        } else if is_thresh {
            rval32 = {29'd0, threshold[thresh_ctx]};
        } else if is_claim {
            rval32 = {27'd0, best_id[thresh_ctx]};
        }
        o_rdata = if i_addr[2] ? {rval32, 32'd0} : {32'd0, rval32};
    }

    // ============================================================
    // Register write + claim/complete + gateway
    // ============================================================
    // Write data lane: a 4-byte store to a 0x..4 address carries its value in
    // the HIGH 32-bit word of the bus dword (i_addr[2]=1), mirroring the read
    // lane above. Select it so 32-bit register writes work at either offset.
    let wval32: logic<32> = if i_addr[2] ? i_wdata[63:32] : i_wdata[31:0];
    always_ff (clk, rst) {
        if_reset {
            for i in 0..32 {
                prio[i] = 3'd0;
            }
            pending = 32'd0;
            for c in 0..N_CTX {
                enable[c]    = 32'd0;
                threshold[c] = 3'd0;
                claimed[c]   = 5'd0;
            }
        } else {
            // Gateway: latch new interrupt sources into pending
            for i in 1..32 {
                if i_src[i] && !pending[i] {
                    pending[i] = 1'b1;
                }
            }

            if i_wen {
                if is_prio {
                    prio[src_idx] = wval32[2:0];
                } else if is_enable {
                    enable[enable_ctx[3:0]] = wval32;
                } else if is_thresh {
                    threshold[thresh_ctx] = wval32[2:0];
                } else if is_claim {
                    // Complete: release claimed source for this context
                    if wval32[4:0] != 5'd0 {
                        claimed[thresh_ctx] = 5'd0;
                    }
                }
            } else if i_ren {
                // Claim: atomically clear pending and record claimed source.
                // If multiple contexts target the same source in the same cycle,
                // the read transaction itself is bus-serialized so only one
                // context observes the claim; the loser sees best_id=0.
                if is_claim && best_id[thresh_ctx] != 5'd0 {
                    claimed[thresh_ctx]          = best_id[thresh_ctx];
                    pending[best_id[thresh_ctx]] = 1'b0;
                }
            }
        }
    }
}
