// CLINT (Core Local Interruptor) — SiFive-compatible layout, multi-hart capable.
// Provides per-hart machine software interrupt (MSIP) and timer interrupt (MTIP).
// Memory-mapped interface (base 0x02000000):
//   0x0000+4*hart : msip[hart]     (read/write, 32-bit, only bit 0 used)
//   0x4000+8*hart : mtimecmp[hart] (read/write, 64-bit)
//   0xBFF8        : mtime          (read-only, 64-bit, auto-increments — global)
pub module clint #(
    param N_HARTS: u32 = 1,
) (
    clk: input clock,
    rst: input reset,
    // Memory-mapped interface
    i_addr : input  logic<16>,
    i_wdata: input  logic<64>,
    i_wen  : input  logic    ,
    i_ren  : input  logic    ,
    o_rdata: output logic<64>,
    // Interrupt outputs (per-hart)
    o_timer_irq: output logic [N_HARTS],
    o_sw_irq   : output logic [N_HARTS],
    // mtime value for CSR TIME register (global)
    o_mtime: output logic<64>,
) {
    var msip    : logic     [N_HARTS];
    var mtime   : logic<64>          ;
    var mtimecmp: logic<64> [N_HARTS];

    // Address decode. We support N_HARTS ≤ 8 with the existing 16-bit
    // address space (msip occupies 0x0000-0x001F, mtimecmp occupies
    // 0x4000-0x403F at most).
    //   msip[h]     @ 0x0000 + 4*h  → addr[15:5]==0,            hart=addr[4:2]
    //   mtimecmp[h] @ 0x4000 + 8*h  → addr[15:6]==0b0100_000000, hart=addr[5:3]
    let msip_hart    : logic<3> = i_addr[4:2];
    let mtimecmp_hart: logic<3> = i_addr[5:3];

    let is_msip_region    : logic = i_addr[15:5] == 11'd0; // 0x0000-0x001F
    let is_mtimecmp_region: logic = i_addr[15:6] == 10'b01_0000_0000; // 0x4000-0x403F
    let is_mtime          : logic = i_addr[15:0] == 16'hBFF8;

    // NB: compare in 4 bits. `N_HARTS as 3` truncates N_HARTS==8 to 0 (8 =
    // 0b1000, low 3 bits = 000), which made the range check always-false at
    // N=8 — the CLINT then silently dropped every msip/mtimecmp write, so no
    // IPIs and no timer interrupts were ever delivered. Widen to 4 bits so
    // N_HARTS up to 8 compares correctly (the SoC instantiates N in {1,2,4,8}).
    let msip_hart_in_range    : logic = ({1'b0, msip_hart} as 4) <: (N_HARTS as 4);
    let mtimecmp_hart_in_range: logic = ({1'b0, mtimecmp_hart} as 4) <: (N_HARTS as 4);

    let is_msip    : logic = is_msip_region && msip_hart_in_range;
    let is_mtimecmp: logic = is_mtimecmp_region && mtimecmp_hart_in_range;

    // mtime prescaler: increment every 10 CPU cycles to match
    // DTB timebase-frequency = 10 MHz (assumes ~100 MHz CPU clock).
    var prescaler: logic<4>;

    always_ff (clk, rst) {
        if_reset {
            for h in 0..N_HARTS {
                msip[h]     = 1'b0;
                mtimecmp[h] = 64'hFFFFFFFFFFFFFFFF;
            }
            mtime     = 64'd0;
            prescaler = 4'd0;
        } else {
            if prescaler == 4'd9 {
                mtime     += 64'd1;
                prescaler =  4'd0;
            } else {
                prescaler += 4'd1;
            }
            if i_wen {
                if is_msip {
                    // Heliodor's data bus is 64-bit, so an `sw` to address
                    // 0x02000004 (msip[1]) places its 32-bit value in
                    // bytes 4-7 of the bus (i_wdata[39:32]), not bytes
                    // 0-3. Pick the appropriate slice based on which 32-bit
                    // half of the doubleword the address selects (bit 2 of
                    // the address).
                    let msip_bit       : logic = if i_addr[2] ? i_wdata[32] : i_wdata[0];
                    msip[msip_hart] = msip_bit;
                } else if is_mtimecmp {
                    mtimecmp[mtimecmp_hart] = i_wdata;
                }
            }
        }
    }

    always_comb {
        if is_msip {
            // Place the read value at the appropriate 32-bit half of the
            // 64-bit bus, matching the doubleword half the address
            // selects. Mirrors the write-side wdata-half pick above.
            o_rdata = if i_addr[2] ? {31'd0, msip[msip_hart], 32'd0} : {63'd0, msip[msip_hart]};
        } else if is_mtimecmp {
            o_rdata = mtimecmp[mtimecmp_hart];
        } else if is_mtime {
            o_rdata = mtime;
        } else {
            o_rdata = 64'd0;
        }
    }

    always_comb {
        for h in 0..N_HARTS {
            o_timer_irq[h] = mtime >= mtimecmp[h];
            o_sw_irq[h]    = msip[h];
        }
    }

    assign o_mtime = mtime;

}
