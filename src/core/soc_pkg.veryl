// soc_pkg: the core selection of heliodor_soc_smp and the widths of its
// per-hart observation outputs, sized for the widest supported core.
pub package soc_pkg {
    enum CoreSel: logic<2> {
        V14,
        W2,
        W4,
    }

    // Retire lanes per hart on the SoC ports; a core with fewer lanes leaves
    // the upper ones invalid.
    const RET_LANES: u32 = 4;

    // Flattened core checker flags per hart, zero-extended.
    const CHK_W: u32 = 128;

    // Flattened core event wires (CorePerf) per hart, zero-extended.
    const PERF_W: u32 = 512;

    // mem_ctrl AXI4 event wires of a new-core SoC. A scalar is one count
    // per cycle; a vector has one bit per slot (or write-buffer entry), so
    // the sum of its bit counts is the total latency of that transaction
    // class. Sized for 8 harts (2 slots per hart, WB_N = 2 * N_HARTS).
    const MC_PERF_N: u32 = 16;
    struct McPerf {
        ar_line   : logic           , // AR handshake of a line burst
        ar_dram1  : logic           , // AR handshake of a DRAM single beat
        ar_rom    : logic           , // AR handshake of a ROM single beat
        aw        : logic           , // AW handshake (one write burst)
        w_beat    : logic           , // W handshake
        i1_hold   : logic           , // a slot's AR held off by a write to its line
        ar_wait   : logic           , // a slot waits while another slot holds the AR channel
        ar_bp     : logic           , // ARVALID and not ARREADY
        wb_full   : logic           , // a write is requested while the write buffer is full
        inst_abort: logic           , // a gathered line not installed (write in its window)
        lat_line  : logic<MC_PERF_N>, // slot: line read, AR valid to last R
        lat_dram1 : logic<MC_PERF_N>, // slot: DRAM single beat, AR valid to R
        lat_rom   : logic<MC_PERF_N>, // slot: ROM single beat, AR valid to R
        lat_wr    : logic<MC_PERF_N>, // write-buffer entry: AW valid to B
    }

    // mtime sources (MTIME_SRC). CYCLE: one tick every MTIME_DIV cycles.
    // INSTRET: one tick per MTIME_DIV non-trap retire records of hart 0.
    // EXTERNAL: one tick per i_mtime_tick cycle. OFF: mtime stays 0.
    const MTIME_CYCLE   : u32 = 0;
    const MTIME_INSTRET : u32 = 1;
    const MTIME_EXTERNAL: u32 = 2;
    const MTIME_OFF     : u32 = 3;

    // One device-side access to CLINT, PLIC or UART, as the device sees it.
    // A read carries the data the device returned; a write carries the
    // granted hart's lane of the line and its byte strobes.
    struct IoObs {
        valid: logic    ,
        write: logic    ,
        hart : logic<3> ,
        addr : logic<64>,
        data : logic<64>,
        strb : logic<8> ,
    }
}
