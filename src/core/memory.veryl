// MEM stage: Data memory access, load alignment/sign-extension, AMO
// Supports hardware misaligned access including cross-doubleword splits.
pub module memory (
    clk: input clock,
    rst: input reset,
    // From EX/MEM register
    i_valid        : input logic                  ,
    i_pc           : input logic              <64>,
    i_alu_out      : input logic              <64>,
    i_rs2_data     : input logic              <64>,
    i_rd_addr      : input logic              <5> ,
    i_wb_sel       : input pipeline_pkg::WbSel    ,
    i_reg_wen      : input logic                  ,
    i_mem_ren      : input logic                  ,
    i_mem_wen      : input logic                  ,
    i_mem_funct3   : input logic              <3> ,
    i_amo_funct5   : input logic              <5> ,
    i_is_compressed: input logic                  ,
    i_rob_idx      : input logic              <5> , // ROB index (pipeline register)
    i_rob_epoch    : input logic              <2> , // ROB epoch (pipeline register)
    i_is_div       : input logic                  , // DIV instruction (suppress normal WB complete)
    i_is_fp        : input logic                  ,
    i_fp_reg_wen   : input logic                  ,
    i_fp_rs2_data  : input logic              <64>,
    i_was_lq       : input logic                  , // load was captured by LQ (LQ-4 infrastructure)
    i_lq_idx       : input logic              <3> , // LQ entry index for this load (LQ-4.4-b)
    // Stall
    i_stall: input logic,
    // Flush: suppress MEM→WB latch on trap (prevents double-execution)
    i_flush: input logic,
    // rdata valid: high when i_dmem_rdata carries actual memory data (not MMU walk zeros)
    i_rdata_valid: input logic,
    // Phase 5 SMP fix: dcache asserts this only when its rdata is valid
    // for THIS hart's request (cache hit or fill-complete DONE state).
    // amo_saved_rdata gates on this to avoid latching shared-bus rdata
    // from another hart while waiting for this hart's fill grant.
    i_dcache_data_valid: input logic,
    // Data memory interface
    o_dmem_addr : output logic<64>,
    o_dmem_wdata: output logic<64>,
    i_dmem_rdata_raw: input logic<64>,
    o_dmem_wen  : output logic    ,
    o_dmem_ren  : output logic    ,
    o_dmem_wstrb: output logic<8> ,
    // Store-buffer forwarding inputs (E1-d workaround for Veryl sim
    // cross-module comb bug): picking the mux internally keeps the
    // forwarding selection inside memory's own comb evaluation.
    i_sb_fwd_hit : input logic    ,
    i_sb_fwd_data: input logic<64>,
    // Shadow-mode validation: assert when SB forwards a value whose
    // load-masked bytes match/differ from what dcache returned this
    // cycle. P3.3-b counters track these to confirm the byte-granular
    // forwarding is bit-for-bit correct before dropping the equality
    // guard in P3.3-c.
    o_sb_fwd_match   : output logic,
    o_sb_fwd_mismatch: output logic,
    // Outputs to MEM/WB register
    o_valid        : output logic                  ,
    o_pc           : output logic              <64>,
    o_alu_out      : output logic              <64>,
    o_mem_data     : output logic              <64>,
    o_rd_addr      : output logic              <5> ,
    o_wb_sel       : output pipeline_pkg::WbSel    ,
    o_reg_wen      : output logic                  ,
    o_is_compressed: output logic                  ,
    o_rob_idx      : output logic              <5> , // ROB index (registered pipeline output)
    o_rob_epoch    : output logic              <2> , // ROB epoch (registered pipeline output)
    o_is_div       : output logic                  ,
    o_is_fp        : output logic                  ,
    o_fp_reg_wen   : output logic                  ,
    o_was_lq       : output logic                  , // load was captured by LQ (registered MEM-stage)
    o_lq_idx       : output logic              <3> , // LQ entry index (registered MEM-stage)
    // Combinational load data for MEM→EX forwarding
    o_load_data: output logic<64>,
    // SC result for forwarding (combinational: 0=success, 1=fail)
    o_sc_result: output logic<64>,
    o_is_sc    : output logic    ,
    // Misaligned access exception
    o_misaligned : output logic,
    o_misalign_st: output logic, // 1=store, 0=load
    // Cross-DW split stall
    o_split_stall: output logic,
    // MSHR support
    i_mshr_absorb: input  logic, // MSHR absorbed this load miss (suppress reg write)
    o_crosses_dw    : output logic, // cross-doubleword access (MSHR should not absorb)
    o_split_phase2  : output logic, // 1 in phase 2 of a cross-DW access (probing addr_hi)
    o_mshr_absorbed : output logic, // instruction was MSHR-absorbed (WB complete suppressed)
    // Remote invalidate (multi-hart coherence): when another hart writes a
    // line whose address matches the active LR reservation (cache-line
    // granularity), the reservation must be flushed so a subsequent SC fails.
    // Tied to 0 in single-hart configuration.
    i_remote_inv_valid: input logic    ,
    i_remote_inv_addr : input logic<64>,
    // AMO inflight: high while an AMO read-modify-write is occupying MEM
    // stage. memory_bus uses this to lock the bus arbiter so another hart
    // cannot inject a store / invalidate between the AMO's read and write.
    // Excludes LR (read-only) and SC (write only after success check).
    o_amo_inflight: output logic,
    // LR-SC reservation status — exposed so the SoC can keep remote
    // invalidates from flushing this hart's reservation while we're in
    // the LR→SC retry loop (Step C bus lock extension).
    o_reserv_valid: output logic,
) {
    import riscv_pkg::AmoFunct5;

    let is_lr : logic = i_amo_funct5 == 5'b00010; // LR
    let is_sc : logic = i_amo_funct5 == 5'b00011; // SC
    let is_amo: logic = i_mem_ren && i_mem_wen || is_lr || is_sc;

    // LR/SC reservation register
    var reserv_valid: logic    ;
    var reserv_addr : logic<64>;

    // AMO write-once guard: prevent AMO write from repeating during stall
    var amo_done: logic;

    // SC succeeds if reservation is valid and address matches
    let sc_success: logic = is_sc && reserv_valid && reserv_addr == i_alu_out;

    // Byte offset within doubleword
    let byte_off: logic<3> = i_alu_out[2:0];

    // Size from funct3[1:0]
    let size: logic<2> = i_mem_funct3[1:0];

    // Access size in bytes minus 1
    let access_bytes_m1: logic<3> = if size == 2'd0 ? 3'd0 : if size == 2'd1 ? 3'd1 : if size == 2'd2 ? 3'd3 : 3'd7;

    // Detect cross-doubleword boundary (byte_off + size > 8)
    let access_end: logic<4> = {1'b0, byte_off} + {1'b0, access_bytes_m1};
    let crosses_dw: logic    = access_end >= 4'd8 && (i_mem_ren || i_mem_wen) && i_valid && !is_amo;

    // Load byte mask (which bytes within the aligned 8B the load touches).
    // Used for shadow-mode SB forwarding validation: we only care about
    // bytes the load actually consumes; bytes outside the mask are
    // allowed to differ (SB returns 0 in uncovered bytes).
    let size_base_mask: logic<8> =
        if size == 2'd0 ? 8'b0000_0001
        : if size == 2'd1 ? 8'b0000_0011
        : if size == 2'd2 ? 8'b0000_1111
        : 8'b1111_1111;
    let load_byte_mask: logic<8> = size_base_mask << byte_off;
    let load_mask_64: logic<64> = {
        load_byte_mask[7] repeat 8, load_byte_mask[6] repeat 8,
        load_byte_mask[5] repeat 8, load_byte_mask[4] repeat 8,
        load_byte_mask[3] repeat 8, load_byte_mask[2] repeat 8,
        load_byte_mask[1] repeat 8, load_byte_mask[0] repeat 8
    };
    let sb_fwd_masked_match: logic =
        (i_sb_fwd_data & load_mask_64) == (i_dmem_rdata_raw & load_mask_64);
    // Exclude mshr-absorbed cycles: the dcache response is stale until
    // MSHR fill arrives, so a "mismatch" is expected and the load result
    // takes the MSHR path (port 3), not the shadow mux.
    assign o_sb_fwd_match    = i_sb_fwd_hit && sb_fwd_masked_match && !i_mshr_absorb;
    assign o_sb_fwd_mismatch = i_sb_fwd_hit && !sb_fwd_masked_match && !i_mshr_absorb;

    // Store-buffer forwarding mux (P3.3-d): SB is authoritative on hit.
    // The masked-equality guard was dropped after SRS-3c enablement
    // cleared the remaining 457 direct-path-store vs SB-shadow race
    // mismatches observed during Linux boot. With SRS-3c routing plain
    // stores through the queue, the SB and dcache stay in sync for
    // any load that hits a pending store — so falling back to dcache
    // on mismatch would just delay the correct value by the eventual
    // dcache commit latency.
    let i_dmem_rdata: logic<64> =
        if i_sb_fwd_hit ? i_sb_fwd_data : i_dmem_rdata_raw;


    // No misaligned exception — handled in hardware
    assign o_misaligned  = 1'b0;
    assign o_misalign_st = 1'b0;

    // ============================================================
    // Cross-DW split state machine
    // ============================================================
    var split_phase2  : logic    ; // in second phase of split access
    var split_rdata_lo: logic<64>; // first-phase read data (lower DW)

    // Aligned addresses for split access
    let addr_lo: logic<64> = {i_alu_out[63:3], 3'b000}; // aligned DW containing first byte
    let addr_hi: logic<64> = {i_alu_out[63:3], 3'b000} + 64'd8; // next aligned DW

    // Stall pipeline during first phase of cross-DW access
    assign o_split_stall   = crosses_dw && !split_phase2;
    assign o_crosses_dw    = crosses_dw;
    assign o_split_phase2  = split_phase2;

    // Split state advances independently of pipeline stall (to avoid deadlock:
    // split_stall → dcache_stall → stall_mem → i_stall → split can't advance).
    // Only gate on EXTERNAL stalls (dcache/MMU), not the split's own stall.
    let external_stall: logic = i_stall && !o_split_stall;

    // AMO read-modify-write flag (not LR/SC)
    let amo_rw: logic = is_amo && !is_lr && !is_sc;

    // AMO done tracking: set when AMO data is captured, clear when instruction advances.
    // Only set when i_rdata_valid to avoid premature marking during MMU PTW.
    always_ff (clk, rst) {
        if_reset {
            amo_done = 1'b0;
        } else if !i_stall {
            // New instruction entering MEM stage — reset
            amo_done = 1'b0;
        } else if amo_rw && i_valid && i_rdata_valid && i_dcache_data_valid {
            // AMO data arrived and captured — mark as done to suppress repeat writes.
            // Phase 5 SMP fix: also gate on i_dcache_data_valid so we don't
            // latch shared-bus rdata from another hart while waiting for this
            // hart's cache fill to complete.
            amo_done = 1'b1;
        }
    }

    always_ff (clk, rst) {
        if_reset {
            split_phase2   = 1'b0;
            split_rdata_lo = '0;
        } else if crosses_dw && !split_phase2 && !external_stall {
            // Phase 1 → Phase 2: save lower DW data
            split_phase2   = 1'b1;
            split_rdata_lo = i_dmem_rdata;
        } else if split_phase2 && !external_stall {
            split_phase2 = 1'b0;
        }
    }

    // Memory address: phase 2 reads/writes the upper DW
    assign o_dmem_addr = if split_phase2 ? addr_hi : if crosses_dw ? addr_lo : i_alu_out;

    // AMO write gating: for AMO, always allow wen/ren to the MMU/dcache.
    let amo_wen_ok: logic = 1'b1;

    // Forward-declare flush_q for use in o_dmem_wen/ren suppression
    // (defined later near MEM/WB pipeline register)
    var flush_q: logic;

    // Memory enables
    // Suppress dmem access when flush_q is active: a stale instruction
    // from the previous cycle (that should have been flushed) may still
    // be in EX/MEM due to simulator comb ordering. Without suppression,
    // a store with a corrupted address writes to random DRAM, causing
    // heap corruption (e.g., slab freelist poisoned).
    assign o_dmem_wen = i_valid && (if is_sc ? sc_success : i_mem_wen) && amo_wen_ok && !flush_q;
    assign o_dmem_ren = i_valid && i_mem_ren && amo_wen_ok && !flush_q;

    // ============================================================
    // Store data alignment and strobe generation
    // ============================================================
    let store_data: logic<64> = if i_is_fp ? i_fp_rs2_data : i_rs2_data;

    var wdata: logic<64>;
    var wstrb: logic<8> ;

    always_comb {
        wdata = '0;
        wstrb = '0;
        if crosses_dw && !split_phase2 {
            // Phase 1: write lower bytes (from byte_off to byte 7)
            // wdata must be shifted to align store bytes with wstrb positions
            case size {
                2'd1: {
                    wdata = {store_data[7:0] repeat 8};
                    wstrb = 8'b00000001 << byte_off;
                }
                2'd2: {
                    wdata = store_data << {byte_off, 3'b000};
                    wstrb = (8'b00001111 << byte_off) & 8'b11111111;
                }
                2'd3: {
                    wdata = store_data << {byte_off, 3'b000};
                    wstrb = (8'b11111111 << byte_off) & 8'b11111111;
                }
                default: {}
            }
        } else if split_phase2 {
            // Phase 2: write upper bytes (from byte 0 to remaining)
            let remaining: logic<3> = access_end[2:0]; // bytes that spill into upper DW
            case size {
                2'd1: {
                    wdata = {store_data[15:8] repeat 8};
                    wstrb = 8'b00000001;
                }
                2'd2: {
                    wdata = store_data >> {~byte_off + 3'd1, 3'b000};
                    // remaining is 0-indexed: 0=1byte, 1=2bytes, 2=3bytes
                    wstrb = if remaining == 3'd0 ? 8'b00000001 : if remaining == 3'd1 ? 8'b00000011 : 8'b00000111;
                }
                2'd3: {
                    wdata = store_data >> {~byte_off + 3'd1, 3'b000};
                    // remaining is 0-indexed: 0=1byte, 1=2bytes, ...
                    wstrb = (8'b11111111 >> (4'd7 - {1'b0, remaining}));
                }
                default: {}
            }
        } else {
            // Normal (non-crossing) access
            // wdata must be shifted by byte_off to align store data with
            // the correct byte lanes. For SB, byte replication works at any
            // offset. For SH/SW, the data must be left-shifted to match
            // the wstrb byte positions.
            case size {
                2'd0: {
                    wdata = {store_data[7:0] repeat 8};
                    wstrb = 8'b00000001 << byte_off;
                }
                2'd1: {
                    wdata = store_data << {byte_off, 3'b000};
                    wstrb = 8'b00000011 << byte_off;
                }
                2'd2: {
                    wdata = store_data << {byte_off, 3'b000};
                    wstrb = 8'b00001111 << byte_off;
                }
                2'd3: {
                    wdata = store_data;
                    wstrb = 8'b11111111;
                }
                default: {}
            }
        }
    }

    // AMO read-modify-write: compute new value from old memory value and rs2
    let amo_word: logic = i_mem_funct3[0] == 1'b0; // funct3=010 → word, 011 → dword
    // Byte-offset adjusted read data for AMO (read the correct word position)
    let amo_shifted: logic<64> = i_dmem_rdata >> {byte_off, 3'b000};
    // Latch AMO read value when data is valid (rdata changes after write).
    // Only capture when i_rdata_valid to avoid latching zeros from MMU during PTW.
    var amo_saved_rdata: logic<64>;
    always_ff (clk, rst) {
        if_reset {
            amo_saved_rdata = '0;
        } else if amo_rw && i_valid && !amo_done && i_rdata_valid && i_dcache_data_valid {
            // Phase 5 SMP fix: only capture when this hart's cache has
            // valid data, not on every cycle bus rdata happens to be valid.
            amo_saved_rdata = amo_shifted;
        }
    }
    // For word AMO, use sign-extended 32-bit values
    let amo_old_raw: logic<64> = if amo_done ? amo_saved_rdata : amo_shifted;
    let amo_old    : logic<64> = if amo_word ? {amo_old_raw[31] repeat 32, amo_old_raw[31:0]} : amo_old_raw;
    let amo_src    : logic<64> = if amo_word ? {i_rs2_data[31] repeat 32, i_rs2_data[31:0]} : i_rs2_data;

    // Signed less-than: XOR MSBs to handle sign difference
    let amo_slt: logic = if (amo_old[63] ^ amo_src[63]) ? amo_old[63] // different signs: old is less if old is negative
     : (amo_old <: amo_src); // same signs: unsigned compare works

    var amo_result: logic<64>;
    always_comb {
        case i_amo_funct5 {
            5'b00001: amo_result = amo_src; // AMOSWAP
            5'b00000: amo_result = amo_old + amo_src; // AMOADD
            5'b00100: amo_result = amo_old ^ amo_src; // AMOXOR
            5'b01100: amo_result = amo_old & amo_src; // AMOAND
            5'b01000: amo_result = amo_old | amo_src; // AMOOR
            5'b10000: amo_result = if amo_slt ? amo_old : amo_src; // AMOMIN
            5'b10100: amo_result = if !amo_slt ? amo_old : amo_src; // AMOMAX
            5'b11000: amo_result = if amo_old <: amo_src ? amo_old : amo_src; // AMOMINU
            5'b11100: amo_result = if amo_old >: amo_src ? amo_old : amo_src; // AMOMAXU
            default : amo_result = amo_src;
        }
    }

    // For AMO (not LR/SC): write the computed result back
    // For normal stores and SC: use the original wdata
    var final_wdata: logic<64>;
    var final_wstrb: logic<8> ;
    always_comb {
        if is_amo && !is_lr && !is_sc {
            // AMO write: result goes to the addressed location
            // Must account for byte offset within doubleword
            if amo_word {
                final_wdata = amo_result << {byte_off, 3'b000};
                final_wstrb = 8'b00001111 << byte_off;
            } else {
                final_wdata = amo_result;
                final_wstrb = 8'b11111111;
            }
        } else {
            final_wdata = wdata;
            final_wstrb = wstrb;
        }
    }

    assign o_dmem_wdata = final_wdata;
    assign o_dmem_wstrb = final_wstrb;

    // ============================================================
    // Load data: combine for cross-DW, shift for normal
    // ============================================================
    // For cross-DW loads: combine lower and upper DW data
    // split_rdata_lo has the lower DW (saved in phase 1)
    // i_dmem_rdata has the upper DW (read in phase 2)
    // Build a 128-bit value: {upper_dw, lower_dw}, then shift by byte_off
    let combined_lo: logic<64> = if split_phase2 ? split_rdata_lo : i_dmem_rdata;
    let combined_hi: logic<64> = i_dmem_rdata;
    // Shift the 128-bit combined value right by byte_off*8
    // Result is in the lower 64 bits
    let combined_shifted: logic<64> = if split_phase2 ?
        (combined_lo >> {byte_off, 3'b000}) | (combined_hi << {~byte_off + 3'd1, 3'b000})
    :
        i_dmem_rdata >> {byte_off, 3'b000}
    ;

    let is_unsigned: logic = i_mem_funct3[2];

    var load_data: logic<64>;

    always_comb {
        load_data = combined_shifted;
        case size {
            2'd0: {
                // LB/LBU
                if is_unsigned {
                    load_data = {56'b0, combined_shifted[7:0]};
                } else {
                    load_data = {combined_shifted[7] repeat 56, combined_shifted[7:0]};
                }
            }
            2'd1: {
                // LH/LHU
                if is_unsigned {
                    load_data = {48'b0, combined_shifted[15:0]};
                } else {
                    load_data = {combined_shifted[15] repeat 48, combined_shifted[15:0]};
                }
            }
            2'd2: {
                // LW/LWU/FLW. FLW must NaN-box the single-precision value
                // (upper 32 bits all 1s) per RISC-V spec.
                if i_fp_reg_wen {
                    load_data = {32'hFFFFFFFF, combined_shifted[31:0]};
                } else if is_unsigned {
                    load_data = {32'b0, combined_shifted[31:0]};
                } else {
                    load_data = {combined_shifted[31] repeat 32, combined_shifted[31:0]};
                }
            }
            2'd3: {
                // LD
                load_data = combined_shifted;
            }
            default: {}
        }
    }

    // Combinational load data output for MEM→EX forwarding
    // For AMO: return old value (before modification) to rd
    assign o_load_data = if amo_rw ? amo_old : load_data;

    // SC result: 0 = success, 1 = failure
    let sc_result: logic<64> = if sc_success ? 64'd0 : 64'd1;

    // For SC: override alu_out with SC result (0/1) for WB
    let alu_out_final: logic<64> = if is_sc ? sc_result : i_alu_out;

    // SC result and flag for EX/MEM forwarding
    assign o_sc_result = sc_result;
    assign o_is_sc     = is_sc;

    // AMO inflight (multi-hart): asserted while an AMO RMW is in MEM stage.
    // memory_bus uses this to hold off other harts' writes / invalidates so
    // the read-modify-write window is atomic.
    // Cover LR/SC as well as AMO-RMW so the SoC-level bus lock protects
    // the entire reservation window (LR → optional retry → SC).
    assign o_amo_inflight = is_amo && i_valid;
    assign o_reserv_valid = reserv_valid;

    // LR/SC reservation tracking
    // LR sets the reservation even during stalls (the address is stable).
    // SC/store clears are guarded by !i_stall to prevent premature clear
    // during dcache stalls (SC result would flip from success to failure).
    always_ff (clk, rst) {
        if_reset {
            reserv_valid = 1'b0;
            reserv_addr  = '0;
        } else if i_valid && is_lr {
            // LR: set reservation (even during stall — address is stable)
            reserv_valid = 1'b1;
            reserv_addr  = i_alu_out;
        } else if reserv_valid && i_remote_inv_valid && i_remote_inv_addr[63:6] == reserv_addr[63:6] {
            // Remote write on the same cache line: flush reservation so the
            // pending SC fails. Cache-line (64B) granularity matches dcache
            // invalidate; Linux atomic retry loops absorb false flushes.
            reserv_valid = 1'b0;
        } else if !i_stall {
            if i_valid && is_sc {
                // SC: clear reservation (regardless of success)
                reserv_valid = 1'b0;
            } else if i_valid && i_mem_wen && !is_amo {
                // Normal store: clear any reservation
                reserv_valid = 1'b0;
            }
        }
    }

    // Registered flush: compensate for simulator comb ordering issue where
    // i_flush (trap_taken) may not be evaluated before the MEM/WB always_ff.
    // (flush_q declared earlier for use in o_dmem_wen/ren suppression)
    always_ff (clk, rst) {
        if_reset {
            flush_q = 1'b0;
        } else {
            flush_q = i_flush;
        }
    }

    // Pipeline register MEM/WB
    always_ff (clk, rst) {
        if_reset {
            o_valid         = 1'b0;
            o_reg_wen       = 1'b0;
            o_is_compressed = 1'b0;
            o_is_div        = 1'b0;
            o_rob_idx       = '0;
            o_rob_epoch     = '0;
            o_is_fp         = 1'b0;
            o_fp_reg_wen    = 1'b0;
            o_was_lq        = 1'b0;
            o_lq_idx        = 3'd0;
            o_pc            = '0;
            o_alu_out       = '0;
            o_mem_data      = '0;
            o_rd_addr       = '0;
            o_wb_sel        = pipeline_pkg::WbSel::ALU;
        } else if i_flush || flush_q {
            // Flush MEM/WB on trap or 1 cycle after
            o_valid         = 1'b0;
            o_reg_wen       = 1'b0;
            o_is_compressed = 1'b0;
            o_is_div        = 1'b0;
            o_rob_idx       = '0;
            o_rob_epoch     = '0;
            o_is_fp         = 1'b0;
            o_fp_reg_wen    = 1'b0;
            o_was_lq        = 1'b0;
            o_lq_idx        = 3'd0;
            o_mshr_absorbed = 1'b0;
        } else if i_stall {
            o_valid         = o_valid;
            o_pc            = o_pc;
            o_alu_out       = o_alu_out;
            o_mem_data      = o_mem_data;
            o_rd_addr       = o_rd_addr;
            o_wb_sel        = o_wb_sel;
            o_reg_wen       = o_reg_wen;
            o_is_compressed = o_is_compressed;
            o_is_div        = o_is_div;
            o_rob_idx       = o_rob_idx;
            o_rob_epoch     = o_rob_epoch;
            o_is_fp         = o_is_fp;
            o_fp_reg_wen    = o_fp_reg_wen;
            o_was_lq        = o_was_lq;
            o_lq_idx        = o_lq_idx;
            o_mshr_absorbed = o_mshr_absorbed;
        } else {
            o_valid         = i_valid;
            o_pc            = i_pc;
            o_alu_out       = alu_out_final;
            o_mem_data      = if amo_rw ? amo_old : load_data;
            o_rd_addr       = i_rd_addr;
            o_wb_sel        = i_wb_sel;
            // MSHR absorb: suppress register write (MSHR will write later)
            o_reg_wen       = if i_mshr_absorb ? 1'b0 : i_reg_wen;
            o_is_compressed = i_is_compressed;
            o_is_div        = i_is_div;
            o_rob_idx       = i_rob_idx;
            o_rob_epoch     = i_rob_epoch;
            o_is_fp         = i_is_fp;
            o_fp_reg_wen    = if i_mshr_absorb ? 1'b0 : i_fp_reg_wen;
            o_was_lq        = i_was_lq;
            o_lq_idx        = i_lq_idx;
            o_mshr_absorbed = i_mshr_absorb;
        }
    }

}
