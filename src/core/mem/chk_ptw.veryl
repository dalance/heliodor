// chk_ptw: observation-only invariant checker of ptw (sticky flags)
//
//   o_chk[0] : an owner response to a tag that the kill of the previous
//              cycle (the response's forming cycle) killed
//   o_chk[1] : an install of a walk that saw a full kill or an invalidation
//              since its start
//   o_chk[2] : a nonspec walk whose owner was dropped reached its leaf with a
//              D update pending (a started store was killed)
//   o_chk[3] : a memory request of the walker without its response exactly
//              LAT cycles later
pub module chk_ptw::<CFG: core_cfg> #(
    param LAT: u32 = fu_pkg::RESP_LAT,
) (
    clk        : input  clock                          ,
    rst        : input  reset                          ,
    i_kill     : input  core_types::<CFG>::Kill        ,
    i_inv_valid: input  logic                          ,
    i_start    : input  logic                          ,
    i_install  : input  logic                          ,
    i_resp     : input  core_types::<CFG>::XlateResp   ,
    i_lost     : input  logic                          ,
    i_mem_acc  : input  logic                          ,
    i_mem_tag  : input  core_types::<CFG>::MemTag      ,
    i_mem_resp : input  core_types::<CFG>::MemResp     ,
    o_chk      : output logic                       <4>,
) {
    import core_types::<CFG>::*;

    let mv: logic = (i_kill.valid && i_kill.full) || i_inv_valid;

    var kill_q : Kill                        ;
    var moved_q: logic                       ;
    var acc_v  : logic     [LAT];
    var acc_t  : MemTag    [LAT];
    var chk_q  : logic <4>                   ;

    let ex_v: logic  = acc_v[LAT - 1];
    let ex_t: MemTag = acc_t[LAT - 1];

    always_ff {
        if_reset {
            chk_q        = 4'd0;
            kill_q.valid = 1'b0;
            moved_q      = 1'b0;
            for k in 0..LAT {
                acc_v[k] = 1'b0;
            }
        } else {
            kill_q   = i_kill;
            moved_q  = if i_start ? mv : moved_q || mv;
            acc_v[0] = i_mem_acc;
            acc_t[0] = i_mem_tag;
            for k in 1..LAT {
                acc_v[k] = acc_v[k - 1];
                acc_t[k] = acc_t[k - 1];
            }
            if i_resp.valid && i_resp.tag.rob_v && killed(kill_q, i_resp.tag.rob) {
                chk_q[0] = 1'b1;
            }
            if i_install && (moved_q || mv) {
                chk_q[1] = 1'b1;
            }
            if i_lost {
                chk_q[2] = 1'b1;
            }
            if ex_v && !(i_mem_resp.valid && i_mem_resp.tag == ex_t) {
                chk_q[3] = 1'b1;
            }
        }
    }
    assign o_chk = chk_q;
}
