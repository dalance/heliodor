// xlate_ctx: the translation context of data and fetch accesses, from the
// live CSR state
//
// Ports (timing contract):
//   inputs          : csr outputs; they change only at a flushing retire
//   i_dpriv         : the privilege of loads and stores (MPP under MPRV)
//   o_d_on, o_d_ctx : data accesses at i_dpriv; Sv39 is on when satp.MODE is
//                     8 and that privilege is below M
//   o_i_on, o_i_ctx : fetch, with the current privilege
// Owns: none (no state)
// Rationale:
//   - ADUE is 0 in both contexts: the walkers' A/D writes are STORE_WT
//     requests that this build's dcache_port_adapter does not serve, so a
//     leaf with A = 0, or D = 0 under a store, is a page fault (Svade)
pub module xlate_ctx (
    i_priv : input  csr_pkg::PrivLevel     ,
    i_dpriv: input  csr_pkg::PrivLevel     ,
    i_satp : input  logic              <64>,
    i_sum  : input  logic                  ,
    i_mxr  : input  logic                  ,
    i_pbmte: input  logic                  ,
    o_d_on : output logic                  ,
    o_d_ctx: output xlate_pkg::XlateCtx    ,
    o_i_on : output logic                  ,
    o_i_ctx: output xlate_pkg::XlateCtx    ,
) {
    let sv39: logic = i_satp[63:60] == 4'd8;

    function ctx_of (
        prv  : input csr_pkg::PrivLevel     ,
        satp : input logic              <64>,
        sum  : input logic                  ,
        mxr  : input logic                  ,
        pbmte: input logic                  ,
    ) -> xlate_pkg::XlateCtx {
        var c      : xlate_pkg::XlateCtx;
        c.prv   = prv;
        c.sum   = sum;
        c.mxr   = mxr;
        c.adue  = 1'b0;
        c.pbmte = pbmte;
        c.asid  = satp[59:44];
        c.root  = satp[43:0];
        return c;
    }

    assign o_d_on  = sv39 && i_dpriv != csr_pkg::PrivLevel::MACHINE;
    assign o_d_ctx = ctx_of(i_dpriv, i_satp, i_sum, i_mxr, i_pbmte);
    assign o_i_on  = sv39 && i_priv != csr_pkg::PrivLevel::MACHINE;
    assign o_i_ctx = ctx_of(i_priv, i_satp, i_sum, i_mxr, i_pbmte);
}
