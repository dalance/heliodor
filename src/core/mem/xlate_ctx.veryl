// xlate_ctx: the translation context of data and fetch accesses, from the
// live CSR state
//
// Ports (timing contract):
//   inputs          : csr outputs; they change only at a flushing retire
//   i_dpriv, i_dvirt: the privilege and V of loads and stores (MPP and MPV
//                     under MPRV)
//   o_d_on, o_d_ctx : data accesses at i_dpriv; Sv39 is on (V = 0) when
//                     satp.MODE is 8 and that privilege is below M. A guest
//                     access (V = 1, or an HLV/HSV through xlate_pkg::xeff)
//                     translates by vsatp and hgatp instead
//   o_i_on, o_i_ctx : fetch, with the current privilege and V
//   o_d_pmm         : the pointer-masking mode of data accesses at i_dpriv
//                     (mseccfg.PMM in M, menvcfg.PMM in HS, henvcfg.PMM in VS,
//                     senvcfg.PMM in U and VU)
//   o_h_pmm         : that of HLV and HSV (hstatus.HUPMM)
//   i_adue          : menvcfg.ADUE, for both contexts (Svadu when 1, Svade
//                     when 0); it also governs the G-stage
// Owns: none (no state)
pub module xlate_ctx (
    i_priv  : input  csr_pkg::PrivLevel     ,
    i_virt  : input  logic                  ,
    i_dpriv : input  csr_pkg::PrivLevel     ,
    i_dvirt : input  logic                  ,
    i_satp  : input  logic              <64>,
    i_sum   : input  logic                  ,
    i_mxr   : input  logic                  ,
    i_pbmte : input  logic                  ,
    i_adue  : input  logic                  ,
    i_vsatp : input  logic              <64>,
    i_hgatp : input  logic              <64>,
    i_vsum  : input  logic                  ,
    i_vmxr  : input  logic                  ,
    i_vpbmte: input  logic                  ,
    i_spvp  : input  logic                  ,
    i_pmm_m : input  logic              <2> ,
    i_pmm_s : input  logic              <2> ,
    i_pmm_u : input  logic              <2> ,
    i_pmm_vs: input  logic              <2> ,
    i_pmm_hu: input  logic              <2> ,
    o_d_on  : output logic                  ,
    o_d_ctx : output xlate_pkg::XlateCtx    ,
    o_i_on  : output logic                  ,
    o_i_ctx : output xlate_pkg::XlateCtx    ,
    o_d_pmm : output logic              <2> ,
    o_h_pmm : output logic              <2> ,
) {
    let sv39: logic = i_satp[63:60] == 4'd8;

    function ctx_of (
        prv: input csr_pkg::PrivLevel,
        v  : input logic             ,
    ) -> xlate_pkg::XlateCtx {
        var c       : xlate_pkg::XlateCtx;
        c.prv    = prv;
        c.sum    = i_sum;
        c.mxr    = i_mxr;
        c.adue   = i_adue;
        c.pbmte  = i_pbmte;
        c.asid   = i_satp[59:44];
        c.root   = i_satp[43:0];
        c.virt   = v;
        c.vprv   = if i_spvp ? csr_pkg::PrivLevel::SUPERVISOR : csr_pkg::PrivLevel::USER;
        c.vsum   = i_vsum;
        c.vmxr   = i_vmxr;
        c.vpbmte = i_vpbmte;
        c.vs_on  = i_vsatp[63:60] == 4'd8;
        c.vasid  = i_vsatp[59:44];
        c.vroot  = i_vsatp[43:0];
        c.g_on   = i_hgatp[63:60] == 4'd8;
        c.vmid   = i_hgatp[57:44];
        c.groot  = i_hgatp[43:0];
        return c;
    }

    assign o_d_on  = sv39 && i_dpriv != csr_pkg::PrivLevel::MACHINE;
    assign o_d_ctx = ctx_of(i_dpriv, i_dvirt);
    assign o_i_on  = sv39 && i_priv != csr_pkg::PrivLevel::MACHINE;
    assign o_i_ctx = ctx_of(i_priv, i_virt);
    assign o_d_pmm = case i_dpriv {
        csr_pkg::PrivLevel::MACHINE   : i_pmm_m,
        csr_pkg::PrivLevel::SUPERVISOR: if i_dvirt ? i_pmm_vs : i_pmm_s,
        default                       : i_pmm_u,
    };
    assign o_h_pmm = i_pmm_hu;
}
