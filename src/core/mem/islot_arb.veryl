// islot_arb: arbiter of the per-hart I read slot of mem_ctrl.
//
// Ports (timing contract):
//   i_req/i_addr/i_line : client c requests a read of i_addr, a 64-byte line
//                         transaction (i_line = 1) or one 8-byte beat; held
//                         until o_acc[c]
//   o_acc               : the slot accepted client c's request this cycle
//   o_beat/o_rdata      : a data beat for client c this cycle. A line
//                         transaction delivers 8 beats after its accept,
//                         critical dword first: beat k is dword
//                         (addr[5:3] + k) mod 8 of the line. A single beat
//                         arrives in the accept cycle.
//   o_slot_* / i_slot_* : mem_ctrl slot protocol (accept grant, then 8 STREAM
//                         grants for a line; one grant with data otherwise)
// Owns:
//   - from a line accept to its 8th beat the slot belongs to that client;
//     every beat goes to it even if its request dropped meanwhile, and the
//     presented address is the one latched at accept, never a live input
//   - no client waits more than one line transaction of every
//     higher-priority client (index 0 first): fetch translates before it
//     fills, so the higher clients do not request back to back
// Rationale:
//   - the address is latched so a redirect that changes a client's request
//     cannot re-point the dword mem_ctrl streams
//   - line or single beat is the requester's attribute (a cacheable fill or
//     PTE read vs an uncached fetch), not an address decode
pub module islot_arb #(
    param N_CL: u32 = 3,
) (
    clk         : input  clock           ,
    rst         : input  reset           ,
    i_req       : input  logic     [N_CL],
    i_addr      : input  logic<56> [N_CL],
    i_line      : input  logic     [N_CL],
    o_acc       : output logic     [N_CL],
    o_beat      : output logic     [N_CL],
    o_rdata     : output logic<64>       ,
    o_slot_req  : output logic           ,
    o_slot_addr : output logic<64>       ,
    o_slot_dram : output logic           , // line transaction (mem_ctrl i_hdram)
    o_slot_iread: output logic           , // uncounted coherent read
    i_slot_grant: input  logic           ,
    i_slot_rdata: input  logic<64>       ,
) {
    var own_q : logic      ;
    var who_q : logic<N_CL>; // one-hot owner
    var line_q: logic<50>  ;
    var dw_q  : logic<3>   ;
    var cnt_q : logic<3>   ;

    var reqv : logic<N_CL>       ;
    var addrs: logic<56>   [N_CL];
    var lines: logic<N_CL>       ;
    always_comb {
        for c in 0..N_CL {
            reqv[c]  = i_req[c];
            addrs[c] = i_addr[c];
            lines[c] = i_line[c];
        }
    }

    let pick  : logic<N_CL> = tree_first::<N_CL>(reqv);
    let p_addr: logic<56>   = tree_onehot_mux::<N_CL, 56>(pick, addrs);
    let p_line: logic       = |(pick & lines);

    let acc : logic = !own_q && pick != 0 && i_slot_grant;
    let beat: logic = own_q && i_slot_grant;

    assign o_slot_req   = !own_q && pick != 0;
    assign o_slot_addr  = if own_q ? {8'd0, line_q, dw_q + cnt_q, 3'd0} : {8'd0, p_addr};
    assign o_slot_dram  = own_q || p_line;
    assign o_slot_iread = own_q || p_line;
    assign o_rdata      = i_slot_rdata;

    always_comb {
        for c in 0..N_CL {
            o_acc[c] = acc && pick[c];
            // A single beat is its own accept.
            o_beat[c] = (beat && who_q[c]) || (acc && pick[c] && !p_line);
        }
    }

    always_ff {
        if_reset {
            own_q  = 1'b0;
            who_q  = 0;
            line_q = 0;
            dw_q   = 0;
            cnt_q  = 0;
        } else if acc && p_line {
            own_q  = 1'b1;
            who_q  = pick;
            line_q = p_addr[55:6];
            dw_q   = p_addr[5:3];
            cnt_q  = 0;
        } else if beat {
            cnt_q = cnt_q + 3'd1;
            if cnt_q == 3'd7 {
                own_q = 1'b0;
            }
        }
    }
}
