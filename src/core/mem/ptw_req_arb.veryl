// ptw_req_arb: picks one of the memory pipes' walk requests for the D
// walker's single request port
//
// Ports (timing contract):
//   i_valid[m], i_req[m] : m1 of pipe m, combinational
//   i_ready              : the walker's o_req_ready (registered)
//   o_valid, o_req       : to the walker, combinational
//   o_gnt[m]             : pipe m's request is taken this cycle
// Owns:
//   - at most one grant per cycle, and only with i_ready
// Rationale:
//   - the oldest op wins, so the machine's oldest memory op is never
//     refused by a younger one; a refused pass re-issues and asks again
pub module ptw_req_arb::<CFG: core_cfg> (
    i_valid: input  logic                        [CFG::MEM_W],
    i_req  : input  core_types::<CFG>::XlateReq  [CFG::MEM_W],
    i_ready: input  logic                                    ,
    o_valid: output logic                                    ,
    o_req  : output core_types::<CFG>::XlateReq              ,
    o_gnt  : output logic                        [CFG::MEM_W],
) {
    import core_types::<CFG>::*;

    const REQ_W: u32 = $bits(XlateReq);

    var cand : logic<CFG::MEM_W>                  ;
    var rtags: logic<ROB_TAG_W>    [CFG::MEM_W]   ;
    var reqs : logic<REQ_W>        [CFG::MEM_W]   ;
    always_comb {
        for m in 0..CFG::MEM_W {
            cand[m]  = i_valid[m];
            rtags[m] = {i_req[m].tag.rob.wrap, i_req[m].tag.rob.idx};
            reqs[m]  = i_req[m];
        }
    }
    let win: logic<CFG::MEM_W> = tree_oldest::<CFG::MEM_W, ROB_TAG_W>(cand, rtags);

    assign o_valid = cand != '0;
    assign o_req   = tree_onehot_mux::<CFG::MEM_W, REQ_W>(win, reqs) as XlateReq;
    for m in 0..CFG::MEM_W :g_gnt {
        assign o_gnt[m] = i_ready && win[m];
    }
}
