// dcache_bank: one data bank of the dcache, a 1R1W array of SETS rows of
// ROW_W bits with a registered read and one masked write.
//
// Ports (timing contract):
//   i_ridx  : the row read this cycle
//   o_rdata : registered: the row i_ridx named in the previous cycle, as it
//             is after that cycle's write
//   i_we, i_widx, i_wdata, i_wmask : one write, applied on this edge to the
//             bits set in i_wmask
// Owns:
//   - a read and a write of the same row in one cycle return the written
//     bits (write-forward)
// Rationale:
//   - the forward gives every simulator and a read-old SRAM the same data:
//     without it the native simulator (read-new) and Verilator (read-old)
//     disagree on a line written in the cycle it is read
pub module dcache_bank #(
    param SETS : u32 = 64 ,
    param ROW_W: u32 = 512,
) (
    clk: input clock,
    rst: input reset,

    i_ridx : input  logic<$clog2(SETS)>,
    o_rdata: output logic<ROW_W>       ,

    i_we   : input logic               ,
    i_widx : input logic<$clog2(SETS)> ,
    i_wdata: input logic<ROW_W>        ,
    i_wmask: input logic<ROW_W>        ,
) {
    var mem_q: logic<ROW_W> [SETS];
    var rd_q : logic<ROW_W>       ;

    let fwd: logic = i_we && i_widx == i_ridx;

    // The array holds data only; its rows are undefined until a fill writes
    // them and are never read before the tag says so.
    always_ff {
        if i_we {
            mem_q[i_widx] = (mem_q[i_widx] & ~i_wmask) | (i_wdata & i_wmask);
        }
    }

    always_ff {
        if_reset {
            rd_q = '0;
        } else {
            rd_q = if fwd ? (mem_q[i_ridx] & ~i_wmask) | (i_wdata & i_wmask) : mem_q[i_ridx];
        }
    }

    assign o_rdata = rd_q;
}
