// chk_dcache: checker of the dcache.
//
// Ports (timing contract):
//   i_req_valid, i_req : requests of this cycle (A), per port
//   i_resp     : the dcache's registered responses
//   i_bad      : design conditions that must never hold, of this cycle:
//                1 a pipe request and a non-pipe request on the HEAD port
//                2 the nf slot holds the UNC_READ or STORE_WT of a killed op
//                  (a CMO may outlive its op)
//                3 a done event arrived while the skid was full
//                4 two writes to one data bank
//                5 the uncached read owns the read channel while a fill
//                  requests or streams
//   i_mshr     : the sticky flags of dcache_mshr
//   i_alloc_*  : an MSHR allocation of this cycle: the fill id, line and
//                critical dword of the waiter it is bound to
//   i_miss_*[p]: a MISS decided this cycle (answered next cycle): fill id
//                and line of the waiter
//   i_ev       : the fill event of this cycle
//   o_chk      : registered sticky flags: 0 a response that is not exactly
//                RESP_LAT after a request of the same port and tag, or a
//                request without its response; 1-5 i_bad; 6-7 i_mshr;
//                8 a waiter bound to a fill of another line, or a fill event
//                whose line or critical dword is not the one bound at
//                allocation
// Owns:
//   - no output feeds design logic; instantiated only under HELIODOR_CHK
// Rationale:
//   - no Kill port although it holds MemTags: every request is answered,
//     killed or not, so a tag must stay until its response
pub module chk_dcache::<CFG: core_cfg> (
    clk        : input  clock                                   ,
    rst        : input  reset                                   ,
    i_req_valid: input  logic                     [CFG::MEM_W]  ,
    i_req      : input  core_types::<CFG>::MemReq  [CFG::MEM_W] ,
    i_resp     : input  core_types::<CFG>::MemResp [CFG::MEM_W] ,
    i_bad      : input  logic<6>                                ,
    i_mshr     : input  logic<2>                                ,
    i_alloc_v   : input logic                                   ,
    i_alloc_fid : input core_types::<CFG>::FillId               ,
    i_alloc_line: input logic<50>                               ,
    i_alloc_crit: input logic<3>                                ,
    i_miss_v    : input logic                       [CFG::MEM_W],
    i_miss_fid  : input core_types::<CFG>::FillId   [CFG::MEM_W],
    i_miss_line : input logic<50>                   [CFG::MEM_W],
    i_ev        : input core_types::<CFG>::MemEvent             ,
    o_chk      : output logic<core_types::<CFG>::CHK_DC_W>      ,
) {
    import core_types::<CFG>::*;

    var ev_v : logic  [fu_pkg::RESP_LAT, CFG::MEM_W];
    var ev_t : MemTag [fu_pkg::RESP_LAT, CFG::MEM_W];
    var chk_q: logic<CHK_DC_W>;

    const FN: u32 = 1 << FILL_ID_W;
    var b_v_q   : logic     [FN];
    var b_line_q: logic<50> [FN];
    var b_crit_q: logic<3>  [FN];

    var bad: logic<CHK_DC_W>;
    always_comb {
        bad = {1'b0, i_mshr, i_bad[5:1], 1'b0};
        for p in 0..CFG::MEM_W {
            let f: FillId = i_miss_fid[p];
            let n: logic  = i_alloc_v && i_alloc_fid == f;
            if i_miss_v[p] && (if n ? i_alloc_line : b_line_q[f]) != i_miss_line[p] && (n || b_v_q[f]) {
                bad[8] = 1'b1;
            }
        }
        if i_ev.valid && (i_ev.kind == EvKind::FILL_START || i_ev.kind == EvKind::FILL_CRIT || i_ev.kind == EvKind::FILL_DONE
            || i_ev.kind == EvKind::FILL_ABORT) && b_v_q[i_ev.fill_id]
            && (b_line_q[i_ev.fill_id] != i_ev.line || b_crit_q[i_ev.fill_id] != i_ev.crit) {
            bad[8] = 1'b1;
        }
        for p in 0..CFG::MEM_W {
            let ex_v: logic  = ev_v[fu_pkg::RESP_LAT - 1][p];
            let ex_t: MemTag = ev_t[fu_pkg::RESP_LAT - 1][p];
            if i_resp[p].valid != ex_v || (ex_v && i_resp[p].tag != ex_t) {
                bad[0] = 1'b1;
            }
        }
    }

    always_ff {
        if_reset {
            chk_q = '0;
            for f in 0..FN {
                b_v_q[f] = 1'b0;
            }
            for k in 0..fu_pkg::RESP_LAT {
                for p in 0..CFG::MEM_W {
                    ev_v[k][p] = 1'b0;
                }
            }
        } else {
            chk_q = chk_q | bad;
            if i_alloc_v {
                b_v_q[i_alloc_fid]    = 1'b1;
                b_line_q[i_alloc_fid] = i_alloc_line;
                b_crit_q[i_alloc_fid] = i_alloc_crit;
            }
            for p in 0..CFG::MEM_W {
                ev_v[0][p] = i_req_valid[p];
                ev_t[0][p] = i_req[p].tag;
                for k in 1..fu_pkg::RESP_LAT {
                    ev_v[k][p] = ev_v[k - 1][p];
                    ev_t[k][p] = ev_t[k - 1][p];
                }
            }
        }
    }
    assign o_chk = chk_q;
}
