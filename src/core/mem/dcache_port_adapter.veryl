// dcache_port_adapter: puts MEM_W logical memory ports on the single
// physical path of the reused dcache, with the final request/response/event
// types of the memory port contract. The walkers' STORE_WT (A/D writes) is
// not issued: this build runs them with ADUE = 0.
//
// Ports (timing contract):
//   i_req_valid[p], i_req[p] : cycle A; o_req_ready is the constant 1. A
//                     request that does not get the physical path this cycle
//                     is answered RETRY(BANK_CONFLICT)
//   i_np_valid[k], i_np_req[k] : cycle A, the non-pipe client k on the HEAD
//                     port (its pipe is empty that cycle, mem_port_arb
//                     reserved it); it wins over the pipe ports and is
//                     answered on that port's o_resp, which clients filter by
//                     MemTag.client
//   o_resp[p]       : registered, exactly RESP_LAT = 2 cycles after A, one per
//                     request
//   o_evt           : registered, one cycle after the dcache state it reports
//                     (UNC_DONE/WT_DONE: two or more), at most one per cycle;
//                     an event in the cycle of a response counts as after it
//                     and none precedes the response it completes
//   i_np_resv_next  : registered in mem_port_arb, high in A - 1 of a
//                     non-pipe request: the fold group is turned away so that
//                     the B position is free in A
//   o_dc_*          : the dcache main port and its Stage-A fold read
//   i_dc_*          : dcache outputs of this cycle (decision inputs)
//   i_inv*, i_ev*   : remote invalidates and local departures of this cycle
//   i_kill          : applied to a held request by its MemTag.rob when rob_v
//                     (a walker's request is never killed)
//   o_perf          : combinational event wires
//   o_chk           : sticky checker flags (HELIODOR_CHK only, else 0)
// Owns:
//   - fold group (LOAD, PTW_READ): presented at A on the Stage-A read and at V = A + 1
//     on the main port; decided at V by the first matching row:
//       1 killed -> RETRY(PREEMPTED)
//       2 the read is unsafe -> RETRY(INV_RACE): the line may have changed
//         between the dcache's tag check and the data it returns. Either an
//         invalidate or a local departure hit the line at A (slot_race_q) or
//         at V (inv_race), an invalidate hit the line of the folded read
//         between its two stages (dhit_c3_squash), or a writeback capture
//         took the read port from the folded read (dhit_cap_pre_q)
//       3 hit -> HIT. A 2-dword request hits only on the folded read
//         (i_dc_dhit_used), which alone also returns the next dword; on the
//         non-folded path it falls through to row 7/8 and is answered when
//         the held request hits (FILL_ABORT, then re-issue)
//       4 the critical word of the fill of its line -> HIT
//       5 a fill of its line -> MISS(that fill)
//       6 another fill -> RETRY(FILL_BUSY)
//       7/8 a transient stall or a miss -> MISS(gen) and the request is held
//         (HOLD)
//   - nf group (LOAD_EXCL, STORE_EXCL, STORE_WT, UNC_READ, CMO): accepted only
//     when the B position is empty and driven on the main port from A.
//     LOAD_EXCL is decided at V like the fold group, without row 4, and a
//     LOAD_EXCL that misses is held with i_amo_read until the DONE of its
//     line's fill, so the dcache arms the ownership pin. STORE_EXCL is
//     decided at A: the merge fired -> EXCL_PASS, the line is not owned
//     (write_wait_local) -> EXCL_FAIL, a fill holds the arrays ->
//     RETRY(FILL_BUSY). STORE_WT and UNC_READ answer PENDING(id) and are held
//     until the write fires or the read is granted, then WT_DONE(id) or
//     UNC_DONE(id, data) follows; the device sees one access. CMO answers HIT
//   - a held request presents itself non-folded every cycle until a fill
//     starts (its own or not: MISS(gen) names the next fill), it is killed, or
//     it hits without a fill; the last case advances gen and broadcasts
//     FILL_ABORT(gen), so every MISS(g) is followed by FILL_DONE(g) or
//     FILL_ABORT(g)
//   - fill attribution is by line and fill_id only, never by who drives the port
// Rationale:
//   - one held request doubles as the single MSHR of the reused dcache; a
//     fill's line and demanded dword come from the dcache's fill entry
//   - a 2-dword load folds like a 1-dword one: both dwords come from the same
//     registered line
//   - of two simultaneous pipe requests the older op wins, so the machine's
//     oldest load never loses a conflict; a non-pipe request wins over both,
//     since its slot was reserved ahead
//   - the request sources are a vector (MEM_W pipes, then NP_N non-pipe
//     clients) reduced with the tree helpers
//   - a done event goes through a one-entry skid: it yields to the dcache's
//     own events and never overtakes the PENDING response
pub module dcache_port_adapter::<CFG: core_cfg> (
    clk: input clock,
    rst: input reset,

    i_kill: input core_types::<CFG>::Kill,

    i_req_valid   : input  logic                        [CFG::MEM_W]             ,
    i_req         : input  core_types::<CFG>::MemReq    [CFG::MEM_W]             ,
    i_np_valid    : input  logic                        [core_types::<CFG>::NP_N],
    i_np_req      : input  core_types::<CFG>::MemReq    [core_types::<CFG>::NP_N],
    o_req_ready   : output logic                        [CFG::MEM_W]             ,
    o_resp        : output core_types::<CFG>::MemResp   [CFG::MEM_W]             ,
    o_evt         : output core_types::<CFG>::MemEvent                           ,
    i_np_resv_next: input  logic                                                 ,

    o_dc_addr       : output logic<64>,
    o_dc_ren        : output logic    ,
    o_dc_ren_folded : output logic    ,
    o_dc_addr_r     : output logic<64>,
    o_dc_ren_r      : output logic    ,
    o_dc_amo_read   : output logic    ,
    o_dc_load_next  : output logic    ,
    o_dc_uncached   : output logic    ,
    o_dc_wen        : output logic    ,
    o_dc_wen_excl   : output logic    ,
    o_dc_wen_excl_q : output logic    ,
    o_dc_wdata      : output logic<64>,
    o_dc_wdata_hi   : output logic<64>,
    o_dc_wstrb      : output logic<8> ,

    i_dc_rdata          : input logic<64>              ,
    i_dc_rdata_next     : input logic<64>              ,
    i_dc_stall          : input logic                  ,
    i_dc_data_valid     : input logic                  ,
    i_dc_fill_rdata     : input logic<64>              ,
    i_dc_fill_data_ready: input logic                  ,
    i_dc_fill_complete  : input logic                  ,
    i_dc_fill_aborted   : input logic                  ,
    i_dc_fill_start     : input logic                  ,
    i_dc_fill_start_line: input logic<58>              ,
    i_dc_fill_start_off : input logic<3>               ,
    i_dc_fill_busy      : input logic                  ,
    i_dc_fill_line      : input logic<58>              ,
    i_dc_fill_off       : input logic<3>               ,
    i_dc_stall_terms    : input dcache_pkg::StallTerms ,
    i_dc_dhit_used      : input logic                  ,
    i_dc_dhit_rdata_next: input logic<64>              ,

    i_inv_v    : input logic    ,
    i_inv_addr : input logic<64>,
    i_inv2_v   : input logic    ,
    i_inv2_addr: input logic<64>,
    i_ev1_v    : input logic    ,
    i_ev1_addr : input logic<64>,
    i_ev2_v    : input logic    ,
    i_ev2_addr : input logic<64>,

    o_chk: output logic<6>,

    o_perf: output core_types::<CFG>::AdapterPerf,
) {
    import core_types::<CFG>::*;

    const PW: u32 = tag_pkg::idx_w(CFG::MEM_W);
    // Request sources: the MEM_W pipe ports, then the NP_N HEAD-port clients.
    const NS: u32 = CFG::MEM_W + NP_N;
    const CL_W: u32 = $bits(MemClient);

    function src_port (
        s: input u32,
    ) -> u32 {
        return if s <: CFG::MEM_W ? s : HEAD_PORT;
    }

    function is_nf (
        c: input MemCls,
    ) -> logic {
        return c == MemCls::LOAD_EXCL || c == MemCls::STORE_EXCL || c == MemCls::STORE_WT || c == MemCls::UNC_READ
            || c == MemCls::CMO;
    }

    var slot_v_q    : logic    ;
    var slot_first_q: logic    ; // this cycle is the decision cycle V
    var slot_race_q : logic    ; // an invalidate or departure hit the line at A
    var slot_miss_q : logic    ; // the held request saw its own miss
    var slot_xw_q   : logic    ; // LOAD_EXCL: waits for the DONE of its line's fill
    var slot_q      : MemReq   ;
    var slot_port_q : logic<PW>;
    var slot_id_q   : FillId   ; // UNC_READ/STORE_WT: the PENDING id

    var gen_q : FillId;
    var fid_q : FillId;
    var crit_q: logic ;

    var rej_q     : logic    [NS]        ;
    var rej_tag_q : MemTag   [NS]        ;
    var resp_q    : MemResp  [CFG::MEM_W];
    var evt_q     : MemEvent             ;
    var nfr_q     : MemResp              ; // a response decided at A
    var nfr_port_q: logic<PW>            ;
    var sk_q      : MemEvent             ; // done-event skid

    // ---- the held request ----

    let s_line: logic<50> = slot_q.pa[55:6];
    let s_dw  : logic<3>  = slot_q.pa[5:3];
    let s_1dw : logic     = slot_q.mask[15:8] == 8'd0;
    let s_xl  : logic     = slot_q.cls == MemCls::LOAD_EXCL;
    let s_ur  : logic     = slot_q.cls == MemCls::UNC_READ;
    let s_wt  : logic     = slot_q.cls == MemCls::STORE_WT;
    let s_fold: logic     = !s_xl && !s_ur && !s_wt;
    let s_kill: logic     = slot_v_q && slot_q.tag.rob_v && killed(i_kill, slot_q.tag.rob);
    let st    : dcache_pkg::StallTerms = i_dc_stall_terms;
    let f_mine: logic     = i_dc_fill_line[49:0] == s_line;
    let f_smine: logic    = i_dc_fill_start && i_dc_fill_start_line[49:0] == s_line;
    let hit   : logic     = !i_dc_stall && i_dc_data_valid;

    let r1 : logic = s_kill;
    let r2 : logic = !r1 && (st.inv_race || st.dhit_c3_squash || st.dhit_cap_pre_q || slot_race_q);
    let r3 : logic = !r1 && !r2 && hit && (s_1dw || i_dc_dhit_used || s_xl);
    let r4 : logic = !r1 && !r2 && !r3 && !s_xl && i_dc_fill_busy && f_mine && s_1dw && i_dc_fill_off == s_dw && i_dc_fill_data_ready;
    let r5 : logic = !r1 && !r2 && !r3 && !r4 && i_dc_fill_busy && f_mine;
    let r6 : logic = !r1 && !r2 && !r3 && !r4 && !r5 && i_dc_fill_busy;
    let r78: logic = !r1 && !r2 && !r3 && !r4 && !r5 && !r6;

    let at_v   : logic = slot_v_q && slot_first_q;
    let at_hold: logic = slot_v_q && !slot_first_q && !slot_xw_q && (s_fold || s_xl);
    let at_xw  : logic = slot_v_q && slot_xw_q;

    // A LOAD_EXCL whose own line's fill is (or starts) in flight waits for
    // its DONE.
    let v_xw     : logic = at_v && s_xl && (r5 || (r78 && f_smine));
    let h_xw     : logic = at_hold && s_xl && f_smine;
    let v_hold   : logic = at_v && r78 && !i_dc_fill_start;
    let empty_gen: logic = at_hold && hit && !i_dc_fill_start && !s_kill;
    let h_release: logic = at_hold && !h_xw && (i_dc_fill_start || s_kill || hit);
    let x_release: logic = at_xw && (i_dc_fill_complete || i_dc_fill_aborted);

    // ---- acceptance at A ----

    var cand  : logic<NS>                  ;
    var npc   : logic<NS>                  ; // HEAD-port client sources
    var rtags : logic<ROB_TAG_W>     [NS]  ;
    var r_pa  : pma_pkg::Pa          [NS]  ;
    var r_mask: logic<16>            [NS]  ;
    var r_wd  : logic<128>           [NS]  ;
    var r_cls : logic<3>             [NS]  ;
    var r_cl  : logic<CL_W>          [NS]  ;
    var r_id  : logic<MEMID_W>       [NS]  ;
    var r_robv: logic                [NS]  ;
    var r_port: logic<PW>            [NS]  ;
    var r_tag : MemTag               [NS]  ;
    always_comb {
        for s in 0..NS {
            var q: MemReq;
            var v: logic ;
            if s <: CFG::MEM_W {
                q = i_req[s];
                v = i_req_valid[s];
            } else {
                q = i_np_req[s - CFG::MEM_W];
                v = i_np_valid[s - CFG::MEM_W];
            }
            cand[s]   = v;
            npc[s]    = v && s >= CFG::MEM_W;
            rtags[s]  = {q.tag.rob.wrap, q.tag.rob.idx};
            r_pa[s]   = q.pa;
            r_mask[s] = q.mask;
            r_wd[s]   = q.wdata;
            r_cls[s]  = q.cls;
            r_cl[s]   = q.tag.client;
            r_id[s]   = q.tag.id;
            r_robv[s] = q.tag.rob_v;
            r_port[s] = src_port(s) as PW;
            r_tag[s]  = q.tag;
        }
    }
    let win_oh: logic<NS>        = if npc != '0 ? tree_first::<NS>(npc) : tree_oldest::<NS, ROB_TAG_W>(cand, rtags);
    let w_port: logic<PW>        = tree_onehot_mux::<NS, PW>(win_oh, r_port);
    let w_pa  : pma_pkg::Pa      = tree_onehot_mux::<NS, 56>(win_oh, r_pa);
    let w_line: logic<50>        = w_pa[55:6];
    let w_mask: logic<16>        = tree_onehot_mux::<NS, 16>(win_oh, r_mask);
    let w_wd  : logic<128>       = tree_onehot_mux::<NS, 128>(win_oh, r_wd);
    let w_cls : MemCls           = tree_onehot_mux::<NS, 3>(win_oh, r_cls) as MemCls;
    let w_rob : logic<ROB_TAG_W> = tree_onehot_mux::<NS, ROB_TAG_W>(win_oh, rtags);
    var w_tag : MemTag           ;
    always_comb {
        w_tag.client   = tree_onehot_mux::<NS, CL_W>(win_oh, r_cl) as MemClient;
        w_tag.id       = tree_onehot_mux::<NS, MEMID_W>(win_oh, r_id);
        w_tag.rob_v    = tree_onehot_mux::<NS, 1>(win_oh, r_robv);
        w_tag.rob.wrap = w_rob[ROB_TAG_W - 1];
        w_tag.rob.idx  = w_rob[ROB_TAG_W - 2:0];
    }
    let race_a: logic = (i_inv_v && i_inv_addr[55:6] == w_line) || (i_inv2_v && i_inv2_addr[55:6] == w_line)
        || (i_ev1_v && i_ev1_addr[55:6] == w_line) || (i_ev2_v && i_ev2_addr[55:6] == w_line);

    let w_nf  : logic = is_nf(w_cls);
    let nf_acc: logic = cand != '0 && w_nf && !slot_v_q;

    for p in 0..CFG::MEM_W :g_rdy {
        assign o_req_ready[p] = 1'b1;
    }

    // ---- the main port (B position) ----

    let n_xl : logic = nf_acc && w_cls == MemCls::LOAD_EXCL;
    let n_xs : logic = nf_acc && w_cls == MemCls::STORE_EXCL;
    let n_wt : logic = nf_acc && w_cls == MemCls::STORE_WT;
    let n_ur : logic = nf_acc && w_cls == MemCls::UNC_READ;
    let b_pa : pma_pkg::Pa = if nf_acc ? w_pa : slot_q.pa;
    let b_m  : logic<16>   = if nf_acc ? w_mask : slot_q.mask;
    let b_wd : logic<128>  = if nf_acc ? w_wd : slot_q.wdata;

    // The fill state is idle exactly when no fill is busy, and an idle
    // uncached read stalls only until its grant.
    let b_unc  : logic = n_ur || (slot_v_q && s_ur);
    let ur_fire: logic = b_unc && !i_dc_fill_busy && !st.unc_wait;
    let wt_fire: logic = st.wen_fires;

    let s_free  : logic = !slot_v_q || (at_v && !v_hold && !v_xw) || h_release || x_release || ur_fire || wt_fire;
    let fold_acc: logic = cand != '0 && !w_nf && s_free && !i_np_resv_next;
    let acc     : logic = nf_acc || fold_acc;

    assign o_dc_addr       = {8'd0, b_pa};
    assign o_dc_ren        = n_xl || n_ur || (slot_v_q && !s_wt);
    assign o_dc_ren_folded = at_v && s_fold;
    assign o_dc_addr_r     = {8'd0, w_pa};
    assign o_dc_ren_r      = fold_acc;
    assign o_dc_amo_read   = n_xl || (slot_v_q && s_xl);
    assign o_dc_load_next  = o_dc_amo_read && b_m[15:8] != 8'd0;
    assign o_dc_uncached   = b_unc;
    assign o_dc_wen        = n_xs || n_wt || (slot_v_q && s_wt);
    assign o_dc_wen_excl   = n_xs;
    assign o_dc_wen_excl_q = n_xs && b_m[15:8] != 8'd0;
    assign o_dc_wdata      = b_wd[63:0];
    assign o_dc_wdata_hi   = b_wd[127:64];
    assign o_dc_wstrb      = b_m[7:0];

    // ---- decisions ----

    var v_resp: MemResp;
    always_comb {
        v_resp.valid   = at_v;
        v_resp.tag     = slot_q.tag;
        v_resp.kind    = RespKind::MISS;
        v_resp.reason  = RetryReason::BANK_CONFLICT;
        v_resp.fill_id = gen_q;
        v_resp.data    = {if s_xl ? i_dc_rdata_next : i_dc_dhit_rdata_next, i_dc_rdata};
        if r1 {
            v_resp.kind   = RespKind::RETRY;
            v_resp.reason = RetryReason::PREEMPTED;
        } else if r2 {
            v_resp.kind   = RespKind::RETRY;
            v_resp.reason = RetryReason::INV_RACE;
        } else if r3 {
            v_resp.kind = RespKind::HIT;
        } else if r4 {
            v_resp.kind = RespKind::HIT;
            v_resp.data = {64'd0, i_dc_fill_rdata};
        } else if r5 {
            v_resp.fill_id = fid_q;
        } else if r6 {
            v_resp.kind   = RespKind::RETRY;
            v_resp.reason = RetryReason::FILL_BUSY;
        }
    }

    // Decided at A: STORE_EXCL, CMO, and the PENDING of STORE_WT/UNC_READ.
    var a_resp: MemResp;
    always_comb {
        a_resp.valid   = nf_acc && !n_xl;
        a_resp.tag     = w_tag;
        a_resp.kind    = RespKind::PENDING;
        a_resp.reason  = RetryReason::FILL_BUSY;
        a_resp.fill_id = gen_q;
        a_resp.data    = '0;
        if w_cls == MemCls::CMO {
            a_resp.kind = RespKind::HIT;
        } else if n_xs {
            a_resp.kind = if st.wenl_fires ?
                RespKind::EXCL_PASS
            : if st.write_wait_local ?
                RespKind::EXCL_FAIL
            :
                RespKind::RETRY
            ;
        }
    }

    // ---- events ----

    let crit_rise: logic = i_dc_fill_data_ready && !crit_q;
    let dc_ev    : logic = i_dc_fill_start || crit_rise || i_dc_fill_complete || i_dc_fill_aborted || empty_gen;
    let sk_out   : logic = sk_q.valid && !dc_ev;
    let done_in  : logic = ur_fire || wt_fire;
    var sk_in    : MemEvent;
    always_comb {
        sk_in.valid   = done_in;
        sk_in.fill_id = if nf_acc ? gen_q : slot_id_q;
        sk_in.line    = b_pa[55:6];
        sk_in.crit    = b_pa[5:3];
        sk_in.data    = i_dc_rdata;
        sk_in.kind    = if ur_fire ? EvKind::UNC_DONE : EvKind::WT_DONE;
    }
    var evt_in: MemEvent;
    always_comb {
        evt_in.valid   = dc_ev;
        evt_in.fill_id = if i_dc_fill_start || empty_gen ? gen_q : fid_q;
        evt_in.line    = if i_dc_fill_start ? i_dc_fill_start_line[49:0] : if empty_gen ? s_line : i_dc_fill_line[49:0];
        evt_in.crit    = if i_dc_fill_start ? i_dc_fill_start_off : i_dc_fill_off;
        evt_in.data    = i_dc_fill_rdata;
        evt_in.kind    = if i_dc_fill_start ?
            EvKind::FILL_START
        : if crit_rise ?
            EvKind::FILL_CRIT
        : if i_dc_fill_complete ?
            EvKind::FILL_DONE
        :
            EvKind::FILL_ABORT
        ;
        if sk_out {
            evt_in = sk_q;
        }
    }

    // ---- state ----

    always_ff {
        if_reset {
            slot_v_q     = 1'b0;
            slot_first_q = 1'b0;
            slot_race_q  = 1'b0;
            slot_miss_q  = 1'b0;
            slot_xw_q    = 1'b0;
            slot_port_q  = '0;
            slot_id_q    = '0;
            gen_q        = '0;
            fid_q        = '0;
            crit_q       = 1'b0;
            evt_q.valid  = 1'b0;
            nfr_q.valid  = 1'b0;
            nfr_port_q   = '0;
            sk_q.valid   = 1'b0;
            for s in 0..NS {
                rej_q[s] = 1'b0;
            }
            for p in 0..CFG::MEM_W {
                resp_q[p].valid = 1'b0;
            }
        } else {
            crit_q = i_dc_fill_data_ready;
            evt_q  = evt_in;

            if i_dc_fill_start {
                fid_q = gen_q;
                gen_q = gen_q + 1;
            } else if empty_gen {
                gen_q = gen_q + 1;
            }

            for p in 0..CFG::MEM_W {
                resp_q[p]       = v_resp;
                resp_q[p].valid = 1'b0;
                for s in 0..NS {
                    if src_port(s) == p && rej_q[s] {
                        resp_q[p].valid  = 1'b1;
                        resp_q[p].tag    = rej_tag_q[s];
                        resp_q[p].kind   = RespKind::RETRY;
                        resp_q[p].reason = RetryReason::BANK_CONFLICT;
                    }
                }
                if at_v && slot_port_q == p {
                    resp_q[p] = v_resp;
                }
                if nfr_q.valid && nfr_port_q == p {
                    resp_q[p] = nfr_q;
                }
            }
            for s in 0..NS {
                rej_q[s]     = cand[s] && !(acc && win_oh[s]);
                rej_tag_q[s] = r_tag[s];
            }
            nfr_q      = a_resp;
            nfr_port_q = w_port;

            if done_in {
                sk_q = sk_in;
            } else if sk_out {
                sk_q.valid = 1'b0;
            }

            if fold_acc || n_xl || (n_ur && !ur_fire) || (n_wt && !wt_fire) {
                slot_v_q     = 1'b1;
                slot_first_q = fold_acc || n_xl;
                slot_race_q  = race_a;
                slot_miss_q  = 1'b0;
                slot_xw_q    = 1'b0;
                slot_q.tag   = w_tag;
                slot_q.cls   = w_cls;
                slot_q.pa    = w_pa;
                slot_q.mask  = w_mask;
                slot_q.wdata = w_wd;
                slot_port_q  = w_port;
                slot_id_q    = gen_q;
            } else if slot_v_q && !s_free {
                slot_first_q = 1'b0;
                if v_xw || h_xw {
                    slot_xw_q = 1'b1;
                }
                if at_hold && st.nf_gap_stall {
                    slot_miss_q = 1'b1;
                }
            } else {
                slot_v_q  = 1'b0;
                slot_xw_q = 1'b0;
            }
        }
    }

    assign o_resp = resp_q;
    assign o_evt  = evt_q;

    always_comb {
        var bank: logic<NS>;
        for s in 0..NS {
            bank[s] = cand[s] && !(acc && win_oh[s]);
        }
        o_perf.accept      = acc;
        o_perf.b2b         = fold_acc && at_v;
        o_perf.hit         = at_v && r3;
        o_perf.crit_hit    = at_v && r4;
        o_perf.attach      = at_v && r5;
        o_perf.hold        = v_hold;
        o_perf.empty_gen   = empty_gen;
        o_perf.r_fill_busy = at_v && r6;
        o_perf.r_inv_race  = at_v && r2;
        o_perf.r_preempted = at_v && r1;
        o_perf.r_bank      = |bank;
        o_perf.resv_turn   = i_np_resv_next && cand != '0 && !w_nf;
        o_perf.nf_accept   = nf_acc;
        o_perf.nf_bank     = cand != '0 && w_nf && slot_v_q;
        o_perf.excl_hold   = v_xw || h_xw;
        o_perf.excl_pass   = n_xs && st.wenl_fires;
        o_perf.excl_fail   = n_xs && st.write_wait_local;
        o_perf.excl_busy   = n_xs && !st.wenl_fires && !st.write_wait_local;
        o_perf.unc_done    = ur_fire;
        o_perf.wt_done     = wt_fire;
        o_perf.cmo         = nf_acc && w_cls == MemCls::CMO;
        o_perf.ev_skid     = sk_q.valid && dc_ev;
    }

    #[ifdef(HELIODOR_CHK)]
    {
        var c_src : logic<5>              ;
        var c_v   : logic    [CFG::MEM_W] ;
        var c_req : MemReq   [CFG::MEM_W] ;
        always_comb {
            c_src = {empty_gen, i_dc_fill_aborted, i_dc_fill_complete, crit_rise, i_dc_fill_start};
            for p in 0..CFG::MEM_W {
                c_v[p]   = 1'b0;
                c_req[p] = '0;
                for s in 0..NS {
                    if src_port(s) == p && cand[s] {
                        c_v[p]           = 1'b1;
                        c_req[p].tag     = r_tag[s];
                    }
                }
            }
        }
        inst u_chk: chk_mem_port::<CFG> (
            clk                                                     ,
            rst                                                     ,
            i_req_valid : c_v                                       ,
            i_req       : c_req                                     ,
            i_resp      : resp_q                                    ,
            i_ev_src    : c_src                                     ,
            i_miss_hit  : empty_gen && slot_miss_q                  ,
            i_nf_kill   : s_kill && !s_fold                         ,
            i_skid_lost : done_in && sk_q.valid && !sk_out          ,
            i_unc_fill  : slot_v_q && s_ur && i_dc_fill_start       ,
            o_chk                                                   ,
        );
    }
    #[ifndef(HELIODOR_CHK)]
    assign o_chk = 0;
}
