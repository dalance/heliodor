// ptw: page table walker with a request queue, walk coalescing, the epoch
// rule for installs, Svadu A/D updates and PTE reads as a tagged client of
// memory port 0. A V = 0 walk is Sv39 under satp; a guest walk (V1, HLV) is
// two-stage: Sv39 under vsatp whose every PTE address is translated by the
// Sv39x4 G-stage under hgatp, then the G-stage translation of the final GPA
//
// Ports (timing contract):
//   i_req_valid/i_req : a walk request, accepted when o_req_ready; i_req.valid
//                       is the lookup qualifier and is not read here. A
//                       request whose key {vpn, regime} matches a queued
//                       request or the running walk of the same epoch is
//                       accepted as a waiter (it gets o_evt only); nonspec
//                       requests always queue
//   o_req_ready       : registered state only (a free queue entry)
//   i_kill            : on its edge drops the queued requests whose oldest
//                       participant it kills and the owners it kills; a
//                       request without a RobTag (tag.rob_v = 0, the IFU) is
//                       dropped by every kill and by i_owner_drop
//   i_ctx, i_pmp*     : live CSR context; i_ctx is latched at walk start, the
//                       PMP registers change only under a flush
//   i_inv             : invalidation at retire; like a full kill it advances
//                       the epoch
//   o_fill            : combinational in the completion cycle, to this
//                       side's tlb: a faultless walk that saw no full kill and
//                       no invalidation since its start, this cycle included
//   o_resp            : registered, the cycle after completion: the full
//                       translation for the owner's access (pa, pma with PBMT,
//                       exc with gpa/gva/implicit, need_d), only while the
//                       owner lives and the walk is of the current epoch
//   o_evt             : registered, the cycle after every completion
//   o_mem_*, i_mem_*  : one request at a time on port 0 (valid/ready; valid
//                       never depends on ready). PTE reads are PTW_READ of
//                       client PTW_D (PTW_I for an IFU walk); an A/D update
//                       is an owned read-modify-write of client AD, LOAD_EXCL
//                       then STORE_EXCL; tag.id = {sequence, IFU walk},
//                       rob_v = 0. A response is taken by tag only, MEM_LAT
//                       cycles after accept; o_mem_req holds from accept
//                       until that response, so a port that presents the
//                       request later than the accept may read it there
//   i_mem_slot        : the accepted request is due on the port this cycle
//                       (the accept cycle itself for a port that presents at
//                       accept); o_mem_av presents it. A STORE_EXCL whose
//                       window broke since the grant is withdrawn there and
//                       gets no response
//   i_ordering_empty  : sb ordering_empty; the A/D read and write wait for it
//   i_coh_v/i_coh_line: inv, inv2 and the local departures of this cycle
//   o_idle            : registered state only: no walk and no queued request
// Owns:
//   - an install never carries a translation read before a full kill or an
//     invalidation
//   - the D bit of the leaf that maps the access (V = 0, VS-stage, or the
//     G-stage leaf of a guest's final GPA) is written only for a nonspec
//     request whose owner lives. The G-stage leaf of a VS-stage PTE gets D
//     only for that PTE's own A/D update, the write it is translated for
//   - every completion broadcasts o_evt; at most one o_resp per walk
//   - no result-holding state: the completion cycle installs, answers and
//     broadcasts, then the walker is idle
// Rationale:
//   - the owner always gets its own answer, so it progresses even if a
//     younger fill evicts the entry before it looks up again
//   - an A/D update reads the leaf with ownership once sb ordering_empty
//     holds and writes only if, up to the write's slot, ordering_empty held
//     and the line never left: an own store draining into the PTE or another
//     hart's write would otherwise be overwritten with the old value. A leaf
//     that differs from the walk's in more than A/D, or an EXCL_FAIL, restarts
//     the walk from the root (a stale walk ends instead)
//   - PTE reads use supervisor PMP (implicit accesses) and the PMA pte_ok bit,
//     both checked before the read is presented
//   - one cursor serves both stages of a guest walk: a G-stage walk runs
//     either for the next VS-stage PTE (its leaf resumes the VS-stage at the
//     HPA) or for the final GPA (its leaf completes). A guest leaf whose
//     permission fails ends the walk with the fault of its stage, so a page
//     fault is never reported as a guest-page fault of a later stage
//   - a guest walk updates A/D with the same owned read-modify-write as V = 0,
//     the VS-stage by henvcfg.ADUE and the G-stage by menvcfg.ADUE. The write
//     of a VS-stage leaf goes to a guest physical address, so it first needs
//     the G-stage leaf of that PTE to permit a store: when the leaf the read
//     walked does not already have W and D, the G-stage walk of that PTE is
//     redone as a store (w_vsw_q), which faults as an implicit write or sets
//     D, and the VS-stage leaf is read again
//   - a guest walk takes one extra cycle (RES) at each leaf it resumes from;
//     a V = 0 walk completes from its leaf directly
//   - requesters send no VA without a key (xlate_pkg::noncanon, gpa_big)
pub module ptw::<CFG: core_cfg> #(
    param QN     : u32                        = 4               ,
    param MEM_LAT: u32                        = fu_pkg::RESP_LAT, // accept to response
    param PMA_N  : u32                        = 1               ,
    param PMA_TBL: pma_pkg::PmaRegion [PMA_N] = '{
        default: pma_pkg::PmaRegion'{base: 0, mask: 0, attr: 0 as pma_pkg::PmaAttr}
    },
) (
    clk: input clock,
    rst: input reset,

    i_kill      : input core_types::<CFG>::Kill,
    i_owner_drop: input logic                  ,

    i_req_valid: input  logic                      ,
    i_req      : input  core_types::<CFG>::XlateReq,
    o_req_ready: output logic                      ,

    i_ctx    : input xlate_pkg::XlateCtx         ,
    i_pmpcfg : input logic              <64> [2] ,
    i_pmpaddr: input logic              <64> [16],
    i_inv    : input xlate_pkg::TlbInv           ,

    i_ordering_empty: input logic                                       ,
    i_coh_v         : input logic     [core_types::<CFG>::COH_N],
    i_coh_line      : input logic<50> [core_types::<CFG>::COH_N],

    o_fill: output xlate_pkg::TlbFill          ,
    o_resp: output core_types::<CFG>::XlateResp,
    o_evt : output core_types::<CFG>::PtwEvent ,

    o_mem_valid: output logic                      ,
    o_mem_req  : output core_types::<CFG>::MemReq  ,
    i_mem_ready: input  logic                      ,
    i_mem_slot : input  logic                      ,
    o_mem_av   : output logic                      ,
    i_mem_resp : input  core_types::<CFG>::MemResp ,
    i_mem_evt  : input  core_types::<CFG>::MemEvent,

    o_idle: output logic,
    o_chk: output logic<4>,

    o_perf: output xlate_pkg::PtwPerf,
) {
    import core_types::<CFG>::*;
    import xlate_pkg::*;

    const QW : u32 = tag_pkg::idx_w(QN);
    const IDW: u32 = MEMID_W - 1;

    enum Flt: logic<2> {
        NONE,
        PAGE,
        GUEST,
        ACCESS,
    }

    enum WSt: logic<3> {
        IDLE,
        REQ, // present the PTE read or the A/D write
        WAIT, // the response of an accepted request
        PARK, // a fill event before the read is presented again
        RES, // a guest leaf is final: resume the other stage or complete
        DONE, // completion: install, answer, broadcast
    }

    // The walk position after a G-stage walk of gpa is started; fin: for the
    // final GPA (else for the next VS-stage PTE). A Bare G-stage resolves at
    // once.
    struct Go {
        st : WSt        ,
        g  : logic      , // the next read is a G-stage PTE
        fin: logic      ,
        pa : pma_pkg::Pa,
        gpa: logic  <64>,
        flt: Flt        ,
    }

    function go_g (
        gpa: input logic<64>,
        fin: input logic    ,
        xe : input XEff     ,
    ) -> Go {
        var c    : Go;
        c.gpa = gpa;
        c.fin = fin;
        c.g   = xe.g_on || fin;
        c.flt = if xe.g_on && gpa[63:41] != '0 ? Flt::GUEST : Flt::NONE;
        c.pa  = if xe.g_on ? {xe.groot[43:2], gpa[40:30], 3'd0} : gpa[55:0];
        c.st  = if c.flt != Flt::NONE || (!xe.g_on && fin) ? WSt::DONE : WSt::REQ;
        return c;
    }

    // The first read of a walk (and of a walk restarted by an A/D update).
    function go_init (
        gva: input logic<64>,
        xe : input XEff     ,
    ) -> Go {
        var c: Go;
        if !xe.two {
            c.st  = WSt::REQ;
            c.g   = 1'b0;
            c.fin = 1'b0;
            c.pa  = {xe.root, gva[38:30], 3'd0};
            c.gpa = '0;
            c.flt = Flt::NONE;
        } else if xe.s1_on {
            c = go_g({8'd0, xe.root, gva[38:30], 3'd0}, 1'b0, xe);
        } else {
            c = go_g(gva, 1'b1, xe);
        }
        return c;
    }

    function key_of (
        r   : input XlateReq,
        virt: input logic   ,
    ) -> PtwKey {
        var k       : PtwKey;
        k.vpn    = vpn_of(r.va);
        k.regime = if r.hlv ? Regime::HLV : if virt ? Regime::V1 : Regime::V0;
        return k;
    }

    function leaf_entry (
        pte  : input logic<64>,
        lvl  : input logic<2> ,
        a_va : input logic<64>,
        pbmte: input logic    ,
    ) -> TlbEntry {
        var t      : TlbEntry;
        t       = '1;
        t.virt  = 1'b0;
        t.ppn   = if pte[63] ? {pte[53:14], a_va[15:12]} : pte[53:10];
        t.level = lvl;
        t.r     = pte[1];
        t.w     = pte[2];
        t.x     = pte[3];
        t.u     = pte[4];
        t.g     = pte[5];
        t.d     = pte[7];
        t.pbmt  = if pbmte ? pte[62:61] : 2'd0;
        t.napot = pte[63];
        return t;
    }

    function gone (
        k    : input Kill  ,
        drop : input logic ,
        rob_v: input logic ,
        t    : input RobTag,
    ) -> logic {
        return if rob_v ? killed(k, t) : k.valid || drop;
    }

    let kfull   : logic = i_kill.valid && i_kill.full;
    let epoch_mv: logic = kfull || i_inv.valid;

    // ---- request queue ----

    var q_v_q   : logic   <QN>     ;
    var q_own_q : logic   <QN>     ; // the owner lives
    var q_req_q : XlateReq     [QN];
    var q_live_q: RobTag       [QN]; // oldest participant
    var q_age_q : logic   <QN> [QN]; // q_age_q[e][f]: entry f was queued before entry e

    var w_st_q   : WSt             ;
    var w_req_q  : XlateReq        ;
    var w_own_q  : logic           ;
    var w_stale_q: logic           ;
    var w_ctx_q  : XlateCtx        ;
    var w_lvl_q  : logic      <2>  ; // first-stage level
    var w_glvl_q : logic      <2>  ; // G-stage level
    var w_pa_q   : pma_pkg::Pa     ;
    var w_gpa_q  : logic      <64> ; // the GPA under G-stage translation
    var w_pte_q  : logic      <64> ; // the first-stage leaf, or the value an A/D write stores
    var w_gpte_q : logic      <64> ; // the same for the G-stage
    var w_g_q    : logic           ; // the current PTE is a G-stage PTE
    var w_fin_q  : logic           ; // that G-stage walk is for the final GPA
    var w_flt_q  : Flt             ;
    var w_vsw_q  : logic           ; // G-stage walks of the VS-stage PTE check its A/D write
    var w_wr_q   : logic           ; // REQ presents the A/D write
    var w_seta_q : logic           ;
    var w_setd_q : logic           ;
    var w_adr_q  : logic           ; // A/D phase: owned reads after ordering_empty
    var w_clean_q: logic           ; // ordering_empty held and the line stayed since the A/D read
    var w_fid_q  : FillId          ;
    var w_any_q  : logic           ; // PARK waits for the end of any fill
    var w_id_q   : logic      <IDW>;
    var w_side_q : logic           ; // an IFU walk

    let in_key : PtwKey = key_of(i_req, i_ctx.virt);
    let in_gone: logic  = gone(i_kill, i_owner_drop, i_req.tag.rob_v, i_req.tag.rob);
    assign o_req_ready = q_v_q != '1;
    let acc_in: logic = i_req_valid && o_req_ready && !in_gone;

    let w_busy: logic     = w_st_q != WSt::IDLE;
    let hit_w : logic     = w_busy && !w_stale_q && !epoch_mv && key_of(w_req_q, w_ctx_q.virt) == in_key;
    var hit_q : logic<QN>;
    always_comb {
        for e in 0..QN {
            hit_q[e] = q_v_q[e] && key_of(q_req_q[e], i_ctx.virt) == in_key;
        }
    }
    let coal  : logic     = acc_in && !i_req.nonspec && (hit_w || hit_q != '0);
    let coal_q: logic<QN> = if coal && !hit_w ? tree_first::<QN>(hit_q) : '0;
    let enq   : logic     = acc_in && !coal;
    let fsel  : logic<QN> = tree_first::<QN>(~q_v_q);

    var drop : logic<QN>;
    var surv : logic<QN>;
    var own_n: logic<QN>;
    always_comb {
        for e in 0..QN {
            drop[e]  = q_v_q[e] && !coal_q[e] && gone(i_kill, i_owner_drop, q_req_q[e].tag.rob_v, q_live_q[e]);
            surv[e]  = q_v_q[e] && !drop[e];
            own_n[e] = q_own_q[e] && !gone(i_kill, i_owner_drop, q_req_q[e].tag.rob_v, q_req_q[e].tag.rob);
        }
    }

    // Kills leave holes in the queue, so the order is an age matrix rather
    // than a ring of sequence numbers: an old entry may outlive any number of
    // younger ones.
    var oldest: logic<QN>;
    always_comb {
        for e in 0..QN {
            oldest[e] = surv[e] && (q_age_q[e] & surv) == '0;
        }
    }
    let start : logic        = !w_busy && surv != '0;
    let pick  : logic   <QN> = if start ? oldest : '0;
    let pick_i: logic   <QW> = tree_onehot_enc::<QN, QW>(pick);
    let s_req : XlateReq     = q_req_q[pick_i];
    let s_own : logic        = own_n[pick_i];
    let s_x   : XEff         = xeff(i_ctx, s_req.hlv);
    let s_go  : Go           = go_init(s_req.va, s_x);

    always_ff {
        if_reset {
            q_v_q   = '0;
            q_own_q = '0;
        } else {
            q_v_q   = (surv & ~pick) | (if enq ? fsel : '0);
            q_own_q = own_n | (if enq ? fsel : '0);
        }
    }

    always_ff {
        for e in 0..QN {
            if enq && fsel[e] {
                q_req_q[e]  = i_req;
                q_live_q[e] = i_req.tag.rob;
                q_age_q[e]  = q_v_q;
            } else if coal_q[e] && tag_older::<ROB_TAG_W>(i_req.tag.rob, q_live_q[e]) {
                q_live_q[e] = i_req.tag.rob;
            }
            if enq && !fsel[e] {
                q_age_q[e] = q_age_q[e] & ~fsel;
            }
        }
    }

    // ---- the walk: memory request ----

    let x       : XEff      = xeff(w_ctx_q, w_req_q.hlv);
    let cur_pte : logic<64> = if w_g_q ? w_gpte_q : w_pte_q;
    let own_live: logic = w_own_q && !gone(i_kill, i_owner_drop, w_req_q.tag.rob_v, w_req_q.tag.rob);

    let pte_attr  : pma_pkg::PmaAttr = pma_check::<PMA_N>(w_pa_q, PMA_TBL);
    var pte_r_deny: logic           ;
    var pte_w_deny: logic           ;
    inst u_pmp_pr: pmp_check (
        i_addr   : {8'd0, w_pa_q},
        i_acc    : 2'd0                          ,
        i_priv   : csr_pkg::PrivLevel::SUPERVISOR,
        i_pmpcfg                                 ,
        i_pmpaddr                                ,
        o_fault  : pte_r_deny                    ,
    );
    inst u_pmp_pw: pmp_check (
        i_addr   : {8'd0, w_pa_q},
        i_acc    : 2'd1                          ,
        i_priv   : csr_pkg::PrivLevel::SUPERVISOR,
        i_pmpcfg                                 ,
        i_pmpaddr                                ,
        o_fault  : pte_w_deny                    ,
    );
    let pte_deny: logic = !pte_attr.pte_ok || pte_r_deny;

    var mtag: MemTag;
    always_comb {
        mtag        = '0;
        mtag.client = if w_adr_q ? MemClient::AD : if w_side_q ? MemClient::PTW_I : MemClient::PTW_D;
        mtag.id     = {w_id_q, w_side_q};
    }

    let in_req: logic = w_st_q == WSt::REQ;
    assign o_mem_valid = in_req
        && (if w_wr_q ? i_ordering_empty && w_clean_q : !pte_deny && (!w_adr_q || i_ordering_empty));
    always_comb {
        o_mem_req.tag   = mtag;
        o_mem_req.cls   = if w_wr_q ? MemCls::STORE_EXCL : if w_adr_q ? MemCls::LOAD_EXCL : MemCls::PTW_READ;
        o_mem_req.pa    = w_pa_q;
        o_mem_req.mask  = 16'h00ff;
        o_mem_req.wdata = {64'd0, cur_pte};
        o_mem_req.attr  = pte_attr;
    }
    let mem_acc: logic = o_mem_valid && i_mem_ready;

    let rs    : MemResp     = i_mem_resp;
    let ev    : MemEvent    = i_mem_evt;
    let r_my  : logic       = w_st_q == WSt::WAIT && rs.valid && rs.tag == mtag;
    let ev_end: logic       = ev.valid && (ev.kind == EvKind::FILL_DONE || ev.kind == EvKind::FILL_ABORT);
    let r_dw  : logic   <3> = w_pa_q[5:3];

    // An owned read waits for the whole fill: the critical dword is not
    // ownership.
    function fill_wake (
        e   : input MemEvent    ,
        fin : input logic       ,
        fid : input FillId      ,
        any : input logic       ,
        crit: input logic       ,
        line: input logic   <50>,
        dw  : input logic   <3> ,
    ) -> logic {
        return if any ?
            fin
        :
            (fin || (crit && e.valid && e.kind == EvKind::FILL_CRIT && e.line == line && e.crit == dw))
                && e.fill_id == fid
        ;
    }

    // ---- the walk: PTE decode (either stage) ----

    let va     : logic<64> = w_req_q.va;
    let d      : logic<64> = rs.data[63:0];
    let p_r    : logic     = d[1];
    let p_w    : logic     = d[2];
    let p_x    : logic     = d[3];
    let p_u    : logic     = d[4];
    let p_a    : logic     = d[6];
    let p_d   : logic     = d[7];
    let p_n   : logic     = d[63];
    let p_pbmt: logic<2>  = d[62:61];
    let p_ppn : logic<44> = d[53:10];
    let p_leaf: logic     = p_r || p_x;

    let c_lvl  : logic<2> = if w_g_q ? w_glvl_q : w_lvl_q;
    let c_pbmte: logic    = if w_g_q ? x.gpbmte : x.pbmte;
    let c_adue : logic    = if w_g_q ? x.gadue : x.adue;
    // A G-stage leaf under a VS-stage PTE is checked as an implicit load, or
    // as the store of that PTE's A/D update.
    let imp_w: logic   = w_g_q && !w_fin_q && w_vsw_q;
    let g_acc: AccKind = if w_fin_q ? w_req_q.acc : if w_vsw_q ? AccKind::STORE : AccKind::LOAD;
    let lp   : Perm    = if w_g_q ?
        stage_perm(p_r, p_w, p_x, p_u, p_d, g_acc, csr_pkg::PrivLevel::USER, 1'b0, x.gmxr, x.gadue, w_fin_q && w_req_q.hlvx)
    :
        stage_perm(p_r, p_w, p_x, p_u, p_d, w_req_q.acc, x.prv, x.sum, x.mxr, x.adue, w_req_q.hlvx)
    ;

    let nl_bad  : logic = c_lvl == 2'd0 || p_n || p_pbmt != 2'd0 || p_d || p_a || p_u;
    let pbmt_bad: logic = if c_pbmte ? p_pbmt == 2'd3 : p_pbmt != 2'd0;
    let mis     : logic = case c_lvl {
        2'd2   : p_ppn[17:0] != 18'd0,
        2'd1   : p_ppn[8:0] != 9'd0,
        default: 1'b0,
    };
    let napot_bad: logic    = p_n && (c_lvl != 2'd0 || p_ppn[3:0] != 4'b1000);
    // A is set only for a permitted access, so a V = 0 leaf with A clear
    // faults here like a guest leaf; with A set it is installed and the
    // access checked at completion.
    let leaf_bad : logic    = pbmt_bad || mis || napot_bad || (!p_a && !c_adue) || ((x.two || !p_a) && !lp.ok);
    // Bits 60:59 belong to software (Svrsw60t59b) at every level and stage.
    let p_fault  : logic    = !d[0] || d[58:54] != 5'd0 || (p_w && !p_r) || (if p_leaf ? leaf_bad : nl_bad);
    let next_idx : logic<9> = if w_lvl_q == 2'd2 ? va[29:21] : va[20:12];
    let g_idx    : logic<9> = if w_glvl_q == 2'd2 ? w_gpa_q[29:21] : w_gpa_q[20:12];

    let want_d : logic = (w_req_q.nonspec || imp_w) && lp.need_d;
    let set_a  : logic = !p_a;
    let set_d  : logic = want_d && (own_live || imp_w);
    let need_wr: logic = set_a || set_d;
    // A VS-stage leaf to update whose G-stage leaf may not take the write yet.
    let vs_gchk: logic = x.two && x.g_on && !w_g_q && !w_vsw_q && need_wr && !(w_gpte_q[2] && w_gpte_q[7]);

    var coh_hit: logic;
    always_comb {
        coh_hit = 1'b0;
        for c in 0..COH_N {
            coh_hit |= i_coh_v[c] && i_coh_line[c] == w_pa_q[55:6];
        }
    }
    let clean: logic = w_clean_q && i_ordering_empty && !coh_hit;

    // Registered only: the slot drives the port. A drain in the slot cycle
    // itself lands after the exclusive write.
    let wd: logic = i_mem_slot && w_wr_q && !w_clean_q;
    assign o_mem_av = i_mem_slot && !wd;

    let r_hit : logic = r_my && !w_wr_q && rs.kind == RespKind::HIT;
    let r_leaf: logic = r_hit && !p_fault && p_leaf;
    let r_lost: logic = r_leaf && want_d && !own_live && !imp_w;

    // The owned read found another leaf, or the exclusive write failed.
    let ad_diff: logic = r_hit && w_adr_q && (d & ~64'hc0) != (cur_pte & ~64'hc0);
    let ad_fail: logic = r_my && w_wr_q && rs.kind == RespKind::EXCL_FAIL;
    let redo   : logic = (ad_diff || ad_fail) && !w_stale_q && !epoch_mv;
    let r_go   : Go    = go_init(va, x);

    // A resolved leaf: a V = 0 walk completes, a guest walk resumes (RES).
    let leaf_st: WSt = if x.two ? WSt::RES : WSt::DONE;

    // ---- the walk: G-stage starts ----

    let s1e   : TlbEntry    = leaf_entry(w_pte_q, w_lvl_q, va, x.pbmte);
    let ge    : TlbEntry    = leaf_entry(w_gpte_q, w_glvl_q, w_gpa_q, x.gpbmte);
    let in_res: logic       = w_st_q == WSt::RES;
    // A VS-stage non-leaf: the next PTE's GPA. RES after a VS-stage leaf: the
    // final GPA.
    let nl_go : Go          = go_g({8'd0, p_ppn, next_idx, 3'd0}, 1'b0, x);
    let fin_go: Go          = go_g({8'd0, entry_pa(s1e, va)}, 1'b1, x);
    let vsw_go: Go          = go_g(w_gpa_q, 1'b0, x);
    let g_hpa : pma_pkg::Pa = entry_pa(ge, w_gpa_q);

    // ---- the walk: completion ----

    // A guest translation composed into one entry: the smaller level, the
    // final PA with the bits under that level cleared (they come from the
    // GVA), and the VS-stage PBMT over the G-stage one when not 0.
    var e_ent: TlbEntry;
    always_comb {
        var lv : logic      <2> ;
        var hpa: pma_pkg::Pa    ;
        var pb : logic      <2> ;
        lv    = if !x.s1_on ? ge.level : if !x.g_on || s1e.level <: ge.level ? s1e.level : ge.level;
        hpa   = if x.g_on ? g_hpa : w_gpa_q[55:0];
        pb    = if x.g_on ? ge.pbmt : 2'd0;
        e_ent = s1e;
        if x.two {
            e_ent.virt  = 1'b1;
            e_ent.s1_on = x.s1_on;
            e_ent.level = lv;
            e_ent.ppn   = hpa[55:12] & ~(case lv {
                2'd2   : 44'h3_ffff,
                2'd1   : 44'h1ff,
                default: 44'h0,
            });
            e_ent.gr = !x.g_on || ge.r;
            e_ent.gw = !x.g_on || ge.w;
            e_ent.gx = !x.g_on || ge.x;
            e_ent.gd = !x.g_on || ge.d;
            if x.s1_on {
                e_ent.pbmt = if s1e.pbmt != 2'd0 ? s1e.pbmt : pb;
            } else {
                e_ent.r     = 1'b1;
                e_ent.w     = 1'b1;
                e_ent.x     = 1'b1;
                e_ent.u     = 1'b0;
                e_ent.d     = 1'b1;
                e_ent.g     = 1'b1;
                e_ent.pbmt  = pb;
                e_ent.napot = x.g_on && ge.napot;
            }
        }
    }

    let f_pa : pma_pkg::Pa      = entry_pa(e_ent, va);
    let f_att: pma_pkg::PmaAttr = pbmt_attr(pma_check::<PMA_N>(f_pa, PMA_TBL), e_ent.pbmt);
    let f_p  : Perm             = perm_x(e_ent, w_req_q.acc, x, w_req_q.hlvx);
    var f_rd : logic           ;
    var f_wd : logic           ;
    var f_xd : logic           ;
    inst u_pmp_fr: pmp_check (
        i_addr   : {8'd0, f_pa},
        i_acc    : 2'd0        ,
        i_priv   : x.prv       ,
        i_pmpcfg               ,
        i_pmpaddr              ,
        o_fault  : f_rd        ,
    );
    inst u_pmp_fw: pmp_check (
        i_addr   : {8'd0, f_pa},
        i_acc    : 2'd1        ,
        i_priv   : x.prv       ,
        i_pmpcfg               ,
        i_pmpaddr              ,
        o_fault  : f_wd        ,
    );
    inst u_pmp_fx: pmp_check (
        i_addr   : {8'd0, f_pa},
        i_acc    : 2'd2        ,
        i_priv   : x.prv       ,
        i_pmpcfg               ,
        i_pmpaddr              ,
        o_fault  : f_xd        ,
    );
    let f_pmp: logic = case w_req_q.acc {
        AccKind::LOAD : f_rd,
        AccKind::STORE: f_wd,
        AccKind::AMO  : f_rd || f_wd,
        AccKind::FETCH: f_xd,
        default       : f_rd && f_wd,
    };
    let f_pma: logic = !f_att.backed || (w_req_q.acc == AccKind::FETCH && !f_att.executable);

    let done   : logic = w_st_q == WSt::DONE;
    let pf_end : logic = w_flt_q == Flt::PAGE || (w_flt_q == Flt::NONE && !f_p.ok);
    let gf_end : logic = w_flt_q == Flt::GUEST;
    let af_end : logic = !pf_end && !gf_end && (w_flt_q == Flt::ACCESS || f_pmp || f_pma);
    let install: logic = done && w_flt_q == Flt::NONE && !w_stale_q && !epoch_mv && (x.s1_on || x.g_on);

    always_comb {
        o_fill.valid = install;
        o_fill.vpn   = vpn_of(va);
        o_fill.asid  = x.asid;
        o_fill.virt  = e_ent.virt;
        o_fill.vmid  = x.vmid;
        o_fill.s1_on = e_ent.s1_on;
        o_fill.gr    = e_ent.gr;
        o_fill.gw    = e_ent.gw;
        o_fill.gx    = e_ent.gx;
        o_fill.gd    = e_ent.gd;
        o_fill.ppn   = e_ent.ppn;
        o_fill.level = e_ent.level;
        o_fill.r     = e_ent.r;
        o_fill.w     = e_ent.w;
        o_fill.x     = e_ent.x;
        o_fill.u     = e_ent.u;
        o_fill.d     = e_ent.d;
        o_fill.g     = e_ent.g;
        o_fill.pbmt  = e_ent.pbmt;
        o_fill.napot = e_ent.napot;
    }

    var resp_n: XlateResp;
    always_comb {
        resp_n.valid        = done && own_live && !w_stale_q && !epoch_mv;
        resp_n.tag          = w_req_q.tag;
        resp_n.hit          = 1'b1;
        resp_n.pa           = f_pa;
        resp_n.pma          = f_att;
        resp_n.exc.valid    = pf_end || gf_end || af_end;
        resp_n.exc.cause    = if pf_end ?
            pf_cause(w_req_q.acc)
        : if gf_end ?
            gpf_cause(w_req_q.acc)
        :
            af_cause(w_req_q.acc)
        ;
        resp_n.exc.tval     = va;
        resp_n.exc.gpa      = if gf_end ? w_gpa_q[63:2] : '0;
        resp_n.exc.gva      = x.two;
        resp_n.exc.implicit = gf_end && w_g_q && !w_fin_q;
        resp_n.exc.imp_wr   = gf_end && imp_w;
        resp_n.exc.dm       = 1'b0;
        resp_n.exc.trig     = 1'b0;
        resp_n.exc.trig_hit = 0;
        resp_n.need_d       = !pf_end && !gf_end && !af_end && f_p.need_d;
    }

    var resp_q: XlateResp;
    var evt_q : PtwEvent ;
    always_ff {
        if_reset {
            resp_q.valid = 1'b0;
            evt_q.valid  = 1'b0;
        } else {
            resp_q.valid = resp_n.valid;
            evt_q.valid  = done;
        }
    }
    always_ff {
        resp_q.tag    = resp_n.tag;
        resp_q.hit    = resp_n.hit;
        resp_q.pa     = resp_n.pa;
        resp_q.pma    = resp_n.pma;
        resp_q.exc    = resp_n.exc;
        resp_q.need_d = resp_n.need_d;
        evt_q.key     = key_of(w_req_q, w_ctx_q.virt);
        evt_q.fault   = w_flt_q != Flt::NONE;
    }
    assign o_resp = resp_q;
    assign o_evt  = evt_q;

    // ---- the walk: state ----

    always_ff {
        if_reset {
            w_st_q    = WSt::IDLE;
            w_own_q   = 1'b0;
            w_stale_q = 1'b0;
            w_wr_q    = 1'b0;
            w_adr_q   = 1'b0;
            w_clean_q = 1'b0;
            w_id_q    = '0;
        } else {
            w_own_q   = own_live;
            w_stale_q = w_stale_q || epoch_mv;
            w_clean_q = if mem_acc && !w_wr_q ? 1'b1 : clean;
            if redo {
                w_adr_q = 1'b0;
                w_wr_q  = 1'b0;
            }
            if r_my {
                w_id_q = w_id_q + 1;
            }
            case w_st_q {
                WSt::IDLE: {
                    if start {
                        w_st_q    = s_go.st;
                        w_own_q   = s_own;
                        w_stale_q = epoch_mv;
                        w_wr_q    = 1'b0;
                        w_adr_q   = 1'b0;
                    }
                }
                WSt::REQ: {
                    if w_wr_q && !clean {
                        w_wr_q = 1'b0; // ordering_empty dropped: read the leaf again
                    } else if !w_wr_q && pte_deny {
                        w_st_q = WSt::DONE;
                    } else if mem_acc {
                        w_st_q = WSt::WAIT;
                    }
                }
                WSt::WAIT: {
                    if wd {
                        w_st_q = WSt::REQ;
                        w_wr_q = 1'b0;
                    } else if r_my {
                        if ad_diff || ad_fail {
                            w_st_q = if redo ? r_go.st : WSt::DONE;
                        } else if w_wr_q {
                            w_st_q = if rs.kind == RespKind::EXCL_PASS ? leaf_st : WSt::REQ;
                        } else if rs.kind == RespKind::HIT {
                            if p_fault {
                                w_st_q = WSt::DONE;
                            } else if !p_leaf {
                                w_st_q = if x.two && !w_g_q ? nl_go.st : WSt::REQ;
                            } else if !need_wr {
                                w_st_q = leaf_st;
                            } else if vs_gchk {
                                w_st_q = vsw_go.st;
                            } else if pte_w_deny {
                                w_st_q = WSt::DONE;
                            } else {
                                w_st_q  = WSt::REQ;
                                w_adr_q = 1'b1;
                                w_wr_q  = w_adr_q && clean;
                            }
                        } else if rs.kind == RespKind::MISS {
                            w_st_q = if fill_wake(ev, ev_end, rs.fill_id, 1'b0, !w_adr_q, w_pa_q[55:6], r_dw) ?
                                WSt::REQ
                            :
                                WSt::PARK
                            ;
                        } else if rs.kind == RespKind::RETRY && rs.reason == RetryReason::FILL_BUSY {
                            w_st_q = if ev_end ? WSt::REQ : WSt::PARK;
                        } else {
                            w_st_q = WSt::REQ;
                        }
                    }
                }
                WSt::PARK: {
                    if fill_wake(ev, ev_end, w_fid_q, w_any_q, !w_adr_q, w_pa_q[55:6], r_dw) {
                        w_st_q = WSt::REQ;
                    }
                }
                WSt::RES: {
                    w_adr_q = 1'b0;
                    w_wr_q  = 1'b0;
                    w_st_q  = if !w_g_q ? fin_go.st : if w_fin_q ? WSt::DONE : WSt::REQ;
                }
                default: w_st_q = WSt::IDLE;
            }
        }
    }

    always_ff {
        if w_st_q == WSt::IDLE && start {
            w_req_q  = s_req;
            w_ctx_q  = i_ctx;
            w_lvl_q  = 2'd2;
            w_flt_q  = Flt::NONE;
            w_side_q = s_req.tag.client == MemClient::IFU;
            w_seta_q = 1'b0;
            w_setd_q = 1'b0;
            w_vsw_q  = 1'b0;
            w_pa_q   = s_go.pa;
            w_gpa_q  = s_go.gpa;
            w_g_q    = s_go.g;
            w_fin_q  = s_go.fin;
            w_glvl_q = 2'd2;
            if s_go.flt != Flt::NONE {
                w_flt_q = s_go.flt;
            }
        } else if in_req && !w_wr_q && pte_deny {
            w_flt_q = Flt::ACCESS;
        } else if redo {
            w_lvl_q  = 2'd2;
            w_seta_q = 1'b0;
            w_setd_q = 1'b0;
            w_vsw_q  = 1'b0;
            w_pa_q   = r_go.pa;
            w_gpa_q  = r_go.gpa;
            w_g_q    = r_go.g;
            w_fin_q  = r_go.fin;
            w_glvl_q = 2'd2;
            if r_go.flt != Flt::NONE {
                w_flt_q = r_go.flt;
            }
        } else if r_hit && !ad_diff {
            if p_fault {
                w_flt_q = if w_g_q ? Flt::GUEST : Flt::PAGE;
            } else if !p_leaf {
                if w_g_q {
                    w_pa_q   = {p_ppn, g_idx, 3'd0};
                    w_glvl_q = w_glvl_q - 2'd1;
                } else if x.two {
                    w_lvl_q = w_lvl_q - 2'd1;
                    w_pa_q   = nl_go.pa;
                    w_gpa_q  = nl_go.gpa;
                    w_g_q    = nl_go.g;
                    w_fin_q  = nl_go.fin;
                    w_glvl_q = 2'd2;
                    if nl_go.flt != Flt::NONE {
                        w_flt_q = nl_go.flt;
                    }
                } else {
                    w_pa_q  = {p_ppn, next_idx, 3'd0};
                    w_lvl_q = w_lvl_q - 2'd1;
                }
            } else if vs_gchk {
                w_vsw_q  = 1'b1;
                w_pa_q   = vsw_go.pa;
                w_g_q    = vsw_go.g;
                w_fin_q  = vsw_go.fin;
                w_glvl_q = 2'd2;
            } else if need_wr && pte_w_deny {
                w_flt_q = Flt::ACCESS;
            } else {
                if w_g_q {
                    w_gpte_q = d | (if need_wr ? 64'h40 : 64'h0) | (if set_d ? 64'h80 : 64'h0);
                } else {
                    w_pte_q = d | (if need_wr ? 64'h40 : 64'h0) | (if set_d ? 64'h80 : 64'h0);
                }
                w_seta_q = set_a;
                w_setd_q = set_d;
            }
        } else if in_res {
            if !w_g_q {
                w_pa_q   = fin_go.pa;
                w_gpa_q  = fin_go.gpa;
                w_g_q    = fin_go.g;
                w_fin_q  = fin_go.fin;
                w_glvl_q = 2'd2;
                if fin_go.flt != Flt::NONE {
                    w_flt_q = fin_go.flt;
                }
            } else if !w_fin_q {
                w_pa_q = g_hpa;
                w_g_q  = 1'b0;
            }
        } else if r_my {
            w_fid_q = rs.fill_id;
            w_any_q = rs.kind != RespKind::MISS;
        }
    }

    // ---- observation ----

    always_comb {
        o_perf.req      = enq;
        o_perf.coalesce = coal;
        o_perf.full     = i_req_valid && !o_req_ready;
        o_perf.q_drop   = drop != '0;
        o_perf.walk     = start;
        o_perf.pte_rd   = mem_acc && !w_wr_q;
        o_perf.park     = r_my && !w_wr_q && rs.kind == RespKind::MISS;
        o_perf.busy     = r_my && rs.kind == RespKind::RETRY && rs.reason == RetryReason::FILL_BUSY;
        o_perf.retry    = r_my && rs.kind == RespKind::RETRY && rs.reason != RetryReason::FILL_BUSY;
        o_perf.pfault   = done && w_flt_q == Flt::PAGE;
        o_perf.afault   = done && w_flt_q == Flt::ACCESS;
        o_perf.install  = install;
        o_perf.stale    = done && w_flt_q == Flt::NONE && !install;
        o_perf.own_drop = done && !own_live;
        o_perf.a_wr     = mem_acc && w_wr_q && w_seta_q;
        o_perf.d_wr     = mem_acc && w_wr_q && w_setd_q;
        o_perf.ad_rd    = mem_acc && !w_wr_q && w_adr_q;
        o_perf.ad_redo  = redo;
        o_perf.ad_wd    = wd;
        o_perf.two      = start && s_x.two;
        o_perf.g_rd     = mem_acc && !w_wr_q && w_g_q;
        o_perf.gfault   = done && gf_end;
        o_perf.vs_ad    = mem_acc && w_wr_q && x.two && !w_g_q;
        o_perf.vsw      = r_hit && !ad_diff && !p_fault && p_leaf && vs_gchk;
    }

    #[ifdef(HELIODOR_CHK)]
    {
        inst u_chk: chk_ptw::<CFG> #(
            LAT: MEM_LAT,
        ) (
            clk                     ,
            rst                     ,
            i_kill                  ,
            i_inv_valid: i_inv.valid,
            i_start    : start      ,
            i_install  : install    ,
            i_resp     : resp_q     ,
            i_lost     : r_lost     ,
            i_mem_acc  : mem_acc    ,
            i_mem_wd   : wd         ,
            i_mem_tag  : mtag       ,
            i_mem_resp : rs         ,
            o_chk                   ,
        );
    }
    #[ifndef(HELIODOR_CHK)]
    assign o_chk = 0;

    assign o_idle = w_st_q == WSt::IDLE && q_v_q == '0;
}
