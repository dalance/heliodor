// chk_mem_port: checker of the memory port of dcache_port_adapter.
//
// Ports (timing contract):
//   i_req_valid, i_req : requests accepted this cycle (A)
//   i_resp     : the adapter's registered responses
//   i_ev_src   : the event sources of this cycle, {empty-generation abort,
//                fill aborted, fill complete, critical word ready, fill start}
//   i_miss_hit : a held request that saw its own miss hit without a fill
//   o_chk      : registered sticky flags:
//                0 a response that is not exactly RESP_LAT after a request of
//                  the same port and tag, or a request without its response
//                1 i_miss_hit (the line cannot appear without a fill)
//                2 two event sources in one cycle
// Owns:
//   - no output feeds design logic; instantiated only under HELIODOR_CHK
// Rationale:
//   - no Kill port although it holds MemTags: the adapter answers every
//     request, killed or not, so a tag must stay until its response
pub module chk_mem_port::<CFG: core_cfg> (
    clk        : input  clock                                   ,
    rst        : input  reset                                   ,
    i_req_valid: input  logic                     [CFG::MEM_W]  ,
    i_req      : input  core_types::<CFG>::MemReq  [CFG::MEM_W] ,
    i_resp     : input  core_types::<CFG>::MemResp [CFG::MEM_W] ,
    i_ev_src   : input  logic<5>                                ,
    i_miss_hit : input  logic                                   ,
    o_chk      : output logic<3>                                ,
) {
    import core_types::<CFG>::*;

    var ev_v : logic  [fu_pkg::RESP_LAT, CFG::MEM_W];
    var ev_t : MemTag [fu_pkg::RESP_LAT, CFG::MEM_W];
    var chk_q: logic<3>;

    var bad: logic<3>;
    always_comb {
        bad = 3'd0;
        for p in 0..CFG::MEM_W {
            let ex_v: logic  = ev_v[fu_pkg::RESP_LAT - 1][p];
            let ex_t: MemTag = ev_t[fu_pkg::RESP_LAT - 1][p];
            if i_resp[p].valid != ex_v || (ex_v && i_resp[p].tag != ex_t) {
                bad[0] = 1'b1;
            }
        }
        bad[1] = i_miss_hit;
        bad[2] = tree_popcount::<5, 3>(i_ev_src) >: 3'd1;
    }

    always_ff {
        if_reset {
            chk_q = 3'd0;
            for k in 0..fu_pkg::RESP_LAT {
                for p in 0..CFG::MEM_W {
                    ev_v[k][p] = 1'b0;
                }
            }
        } else {
            chk_q = chk_q | bad;
            for p in 0..CFG::MEM_W {
                ev_v[0][p] = i_req_valid[p];
                ev_t[0][p] = i_req[p].tag;
                for k in 1..fu_pkg::RESP_LAT {
                    ev_v[k][p] = ev_v[k - 1][p];
                    ev_t[k][p] = ev_t[k - 1][p];
                }
            }
        }
    }
    assign o_chk = chk_q;
}
