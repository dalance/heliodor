// chk_tlb: observation-only invariant checker of tlb (sticky flags)
//
//   o_chk[0] : an installed entry is not a well-formed leaf (level 3, a
//              misaligned superpage ppn, or a napot entry above level 0)
//   o_chk[1] : a fill was written in a cycle with an invalidation
pub module chk_tlb (
    clk      : input  clock                ,
    rst      : input  reset                ,
    i_fill   : input  xlate_pkg::TlbFill   ,
    i_fill_we: input  logic                ,
    i_inv    : input  xlate_pkg::TlbInv    ,
    o_chk    : output logic             <2>,
) {
    let bad_shape: logic = i_fill.level == 2'd3 || (i_fill.level == 2'd2 && i_fill.ppn[17:0] != 18'd0)
        || (i_fill.level == 2'd1 && i_fill.ppn[8:0] != 9'd0) || (i_fill.napot && i_fill.level != 2'd0);

    var chk_q: logic<2>;
    always_ff {
        if_reset {
            chk_q = 2'd0;
        } else {
            if i_fill_we && bad_shape {
                chk_q[0] = 1'b1;
            }
            if i_fill_we && i_inv.valid {
                chk_q[1] = 1'b1;
            }
        }
    }
    assign o_chk = chk_q;
}
