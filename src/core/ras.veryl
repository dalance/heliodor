// Phase 8 M3: Return Address Stack.
//
// A call (jal/jalr writing a link reg) pushes its return address (pc + len);
// a return (jalr reading a link reg, no link write) pops and predicts the
// popped address as its target. This fixes returns, which the BTB mispredicts
// because a function's return target varies by caller.
//
// Two stacks: a SPECULATIVE one updated at fetch (drives the prediction) and an
// ARCHITECTURAL one updated at commit. On a pipeline flush the speculative
// stack is restored from the architectural stack (spec <- arch), exactly like
// rat_spec <- rat_arch — because the redirecting op commits at the ROB head,
// every in-flight (wrong-path) call/return is squashed, so the committed stack
// is the exact correct-path state. RAS imprecision only costs IPC; the
// commit-time target check (c_bp_mispredict) still guarantees correctness.
//
// 16-entry bounded stack (drops pushes when full, ignores pops when empty):
// deep call chains beyond 16 simply mispredict their returns. tos is a count
// in [0,16]; the top entry is at index tos-1. Resizing DEPTH requires updating
// the 5'd16 / [3:0] literals below.
pub module ras #(
    param DEPTH: u32 = 16,
) (
    clk: input clock,
    rst: input reset,

    // Speculative update at fetch (at most one push or pop per cycle).
    i_spec_push     : input  logic    ,
    i_spec_pop      : input  logic    ,
    i_spec_push_addr: input  logic<64>,
    o_spec_top      : output logic<64>,
    o_spec_valid    : output logic    , // stack non-empty → a prediction exists

    // Architectural update at commit.
    i_arch_push     : input  logic    ,
    i_arch_pop      : input  logic    ,
    i_arch_push_addr: input  logic<64>,

    // Recovery: restore the speculative stack + tos from the architectural one.
    i_recovery_fire: input logic,
) {
    var spec_stack: logic<64> [DEPTH];
    var spec_tos  : logic<5>          ; // 0..16
    var arch_stack: logic<64> [DEPTH];
    var arch_tos  : logic<5>          ;

    assign o_spec_valid = spec_tos != 5'd0;
    // Top entry = tos-1. When empty the index underflows but o_spec_valid=0 so
    // the consumer ignores o_spec_top.
    let spec_top_m1: logic<5> = spec_tos - 5'd1;
    assign o_spec_top = spec_stack[spec_top_m1[3:0]];

    always_ff (clk, rst) {
        if_reset {
            for i in 0..DEPTH {
                spec_stack[i] = 64'd0;
                arch_stack[i] = 64'd0;
            }
            spec_tos = 5'd0;
            arch_tos = 5'd0;
        } else {
            // Speculative stack (fetch).
            if i_recovery_fire {
                for i in 0..DEPTH {
                    spec_stack[i] = arch_stack[i];
                }
                spec_tos = arch_tos;
            } else if i_spec_push {
                if spec_tos != 5'd16 {
                    spec_stack[spec_tos[3:0]] = i_spec_push_addr;
                    spec_tos                  = spec_tos + 5'd1;
                }
            } else if i_spec_pop {
                if spec_tos != 5'd0 {
                    spec_tos = spec_tos - 5'd1;
                }
            }
            // Architectural stack (commit) — independent of the speculative one.
            if i_arch_push {
                if arch_tos != 5'd16 {
                    arch_stack[arch_tos[3:0]] = i_arch_push_addr;
                    arch_tos                  = arch_tos + 5'd1;
                }
            } else if i_arch_pop {
                if arch_tos != 5'd0 {
                    arch_tos = arch_tos - 5'd1;
                }
            }
        }
    }
}
