// Data forwarding unit: detects EX->EX and MEM->EX forwarding
// Covers both integer and floating-point register forwarding.
pub module forwarding_unit (
    // Source register addresses from ID/EX
    i_rs1_addr: input logic<5>,
    i_rs2_addr: input logic<5>,
    // EX/MEM stage
    i_exmem_rd : input logic<5>,
    i_exmem_wen: input logic   ,
    // MEM/WB stage
    i_memwb_rd : input logic<5>,
    i_memwb_wen: input logic   ,
    // Forwarding select signals
    o_fwd_a: output pipeline_pkg::FwdSel,
    o_fwd_b: output pipeline_pkg::FwdSel,
    // FP forwarding: separate because FP regs have no x0 hardwire
    i_fp_rs1_addr   : input  logic<5>            ,
    i_fp_rs2_addr   : input  logic<5>            ,
    i_fp_rs3_addr   : input  logic<5>            ,
    i_exmem_fp_wen  : input  logic               ,
    i_memwb_fp_wen  : input  logic               ,
    o_fp_fwd_a      : output pipeline_pkg::FwdSel,
    o_fp_fwd_b      : output pipeline_pkg::FwdSel,
    o_fp_fwd_c      : output pipeline_pkg::FwdSel, // rs3 for FMADD
) {
    import pipeline_pkg::FwdSel;

    // Integer forwarding for rs1
    assign o_fwd_a = if i_exmem_wen && i_exmem_rd != 5'd0 && i_exmem_rd == i_rs1_addr ?
        FwdSel::EX_MEM
    : if i_memwb_wen && i_memwb_rd != 5'd0 && i_memwb_rd == i_rs1_addr ?
        FwdSel::MEM_WB
    :
        FwdSel::NONE
    ;

    // Integer forwarding for rs2
    assign o_fwd_b = if i_exmem_wen && i_exmem_rd != 5'd0 && i_exmem_rd == i_rs2_addr ?
        FwdSel::EX_MEM
    : if i_memwb_wen && i_memwb_rd != 5'd0 && i_memwb_rd == i_rs2_addr ?
        FwdSel::MEM_WB
    :
        FwdSel::NONE
    ;

    // FP forwarding for fp_rs1
    assign o_fp_fwd_a = if i_exmem_fp_wen && i_exmem_rd == i_fp_rs1_addr ?
        FwdSel::EX_MEM
    : if i_memwb_fp_wen && i_memwb_rd == i_fp_rs1_addr ?
        FwdSel::MEM_WB
    :
        FwdSel::NONE
    ;

    // FP forwarding for fp_rs2
    assign o_fp_fwd_b = if i_exmem_fp_wen && i_exmem_rd == i_fp_rs2_addr ?
        FwdSel::EX_MEM
    : if i_memwb_fp_wen && i_memwb_rd == i_fp_rs2_addr ?
        FwdSel::MEM_WB
    :
        FwdSel::NONE
    ;

    // FP forwarding for fp_rs3 (FMADD/FMSUB/FNMADD/FNMSUB)
    assign o_fp_fwd_c = if i_exmem_fp_wen && i_exmem_rd == i_fp_rs3_addr ?
        FwdSel::EX_MEM
    : if i_memwb_fp_wen && i_memwb_rd == i_fp_rs3_addr ?
        FwdSel::MEM_WB
    :
        FwdSel::NONE
    ;
}
