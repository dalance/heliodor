// Data forwarding unit: detects EX->EX and MEM->EX forwarding
// Covers both integer and floating-point register forwarding.
// Extended for dual-issue: slot1's EX/WB result is also a forwarding source.
pub module forwarding_unit (
    // Source register addresses from ID/EX
    i_rs1_addr: input logic<5>,
    i_rs2_addr: input logic<5>,
    // Slot0 EX/MEM stage
    i_exmem_rd : input logic<5>,
    i_exmem_wen: input logic   ,
    // Slot1 EX/WB stage (previous cycle's slot1 result)
    i_s1exwb_rd : input logic<5>,
    i_s1exwb_wen: input logic   ,
    // Slot0 MEM/WB stage
    i_memwb_rd : input logic<5>,
    i_memwb_wen: input logic   ,
    // Forwarding select signals
    o_fwd_a: output pipeline_pkg::FwdSel,
    o_fwd_b: output pipeline_pkg::FwdSel,
    // Slot1 source registers (for slot1's forwarding)
    i_s1_rs1_addr: input  logic               <5>,
    i_s1_rs2_addr: input  logic               <5>,
    o_s1_fwd_a   : output pipeline_pkg::FwdSel   ,
    o_s1_fwd_b   : output pipeline_pkg::FwdSel   ,
    // FP forwarding: separate because FP regs have no x0 hardwire
    i_fp_rs1_addr : input  logic               <5>,
    i_fp_rs2_addr : input  logic               <5>,
    i_fp_rs3_addr : input  logic               <5>,
    i_exmem_fp_wen: input  logic                  ,
    i_memwb_fp_wen: input  logic                  ,
    o_fp_fwd_a    : output pipeline_pkg::FwdSel   ,
    o_fp_fwd_b    : output pipeline_pkg::FwdSel   ,
    o_fp_fwd_c    : output pipeline_pkg::FwdSel   , // rs3 for FMADD
) {
    import pipeline_pkg::FwdSel;

    // Integer forwarding for slot0 rs1
    // Priority: EX/MEM (slot0) > S1_EX/WB (slot1) > MEM/WB (slot0)
    assign o_fwd_a = if i_exmem_wen && i_exmem_rd != 5'd0 && i_exmem_rd == i_rs1_addr ?
        FwdSel::EX_MEM
    : if i_s1exwb_wen && i_s1exwb_rd != 5'd0 && i_s1exwb_rd == i_rs1_addr ?
        FwdSel::S1_EX_WB
    : if i_memwb_wen && i_memwb_rd != 5'd0 && i_memwb_rd == i_rs1_addr ?
        FwdSel::MEM_WB
    :
        FwdSel::NONE
    ;

    // Integer forwarding for slot0 rs2
    assign o_fwd_b = if i_exmem_wen && i_exmem_rd != 5'd0 && i_exmem_rd == i_rs2_addr ?
        FwdSel::EX_MEM
    : if i_s1exwb_wen && i_s1exwb_rd != 5'd0 && i_s1exwb_rd == i_rs2_addr ?
        FwdSel::S1_EX_WB
    : if i_memwb_wen && i_memwb_rd != 5'd0 && i_memwb_rd == i_rs2_addr ?
        FwdSel::MEM_WB
    :
        FwdSel::NONE
    ;

    // Integer forwarding for slot1 rs1
    // Same priority chain — slot1 also needs data from previous slots
    assign o_s1_fwd_a = if i_exmem_wen && i_exmem_rd != 5'd0 && i_exmem_rd == i_s1_rs1_addr ?
        FwdSel::EX_MEM
    : if i_s1exwb_wen && i_s1exwb_rd != 5'd0 && i_s1exwb_rd == i_s1_rs1_addr ?
        FwdSel::S1_EX_WB
    : if i_memwb_wen && i_memwb_rd != 5'd0 && i_memwb_rd == i_s1_rs1_addr ?
        FwdSel::MEM_WB
    :
        FwdSel::NONE
    ;

    // Integer forwarding for slot1 rs2
    assign o_s1_fwd_b = if i_exmem_wen && i_exmem_rd != 5'd0 && i_exmem_rd == i_s1_rs2_addr ?
        FwdSel::EX_MEM
    : if i_s1exwb_wen && i_s1exwb_rd != 5'd0 && i_s1exwb_rd == i_s1_rs2_addr ?
        FwdSel::S1_EX_WB
    : if i_memwb_wen && i_memwb_rd != 5'd0 && i_memwb_rd == i_s1_rs2_addr ?
        FwdSel::MEM_WB
    :
        FwdSel::NONE
    ;

    // FP forwarding for fp_rs1 (slot1 does not issue FP, so no slot1 FP forwarding needed)
    assign o_fp_fwd_a = if i_exmem_fp_wen && i_exmem_rd == i_fp_rs1_addr ?
        FwdSel::EX_MEM
    : if i_memwb_fp_wen && i_memwb_rd == i_fp_rs1_addr ?
        FwdSel::MEM_WB
    :
        FwdSel::NONE
    ;

    assign o_fp_fwd_b = if i_exmem_fp_wen && i_exmem_rd == i_fp_rs2_addr ?
        FwdSel::EX_MEM
    : if i_memwb_fp_wen && i_memwb_rd == i_fp_rs2_addr ?
        FwdSel::MEM_WB
    :
        FwdSel::NONE
    ;

    assign o_fp_fwd_c = if i_exmem_fp_wen && i_exmem_rd == i_fp_rs3_addr ?
        FwdSel::EX_MEM
    : if i_memwb_fp_wen && i_memwb_rd == i_fp_rs3_addr ?
        FwdSel::MEM_WB
    :
        FwdSel::NONE
    ;
}
