// chk_flush: observation-only invariant checker for flush_ctrl.
//
// Ports (timing contract):
//   inputs : flush_ctrl's WB inputs and adoption decision, and its
//            registered Kill and Redirect; the candidate resolves are
//            recomputed here
//   o_chk  : registered sticky flags, one bit per violated invariant:
//            0 more commit-time backstop kills (BR_CM) than mispredicted
//              resolves dropped so far: the early-kill path or the
//              recovered write is broken
//            1 Kill and Redirect are not valid together
// Owns:
//   - no output feeds design logic; instantiated only under HELIODOR_CHK
pub module chk_flush::<CFG: core_cfg> (
    clk       : input  clock                                                                                ,
    rst       : input  reset                                                                                ,
    i_wb      : input  core_types::<CFG>::WbPacket                                 [core_types::<CFG>::WB_N],
    i_adopt   : input  logic                                                                                ,
    i_cm_flush: input  core_types::<CFG>::CmFlush                                                           ,
    i_kill    : input  core_types::<CFG>::Kill                                                              ,
    i_redirect: input  core_types::<CFG>::Redirect                                                          ,
    o_chk     : output logic                      <core_types::<CFG>::CHK_FLUSH_W>                          ,
) {
    import core_types::<CFG>::*;

    const C_W: u32 = 32;

    var drop_q: logic<C_W>        ;
    var brcm_q: logic<C_W>        ;
    var chk_q : logic<CHK_FLUSH_W>;

    var cand: logic<BRU_N>;
    always_comb {
        for b in 0..BRU_N {
            let w      : WbPacket = i_wb[bru_port(b)];
            cand[b] = w.valid && w.br.valid && w.br.mispred && !killed(i_kill, w.tag.rob);
        }
    }

    let n_cand: logic<C_W> = tree_popcount::<BRU_N, C_W>(cand);
    let n_drop: logic<C_W> = n_cand - (i_adopt as C_W);
    let brcm  : logic      = i_cm_flush.valid && i_cm_flush.kind == RedirKind::BR_CM;

    always_ff {
        if_reset {
            drop_q = 0;
            brcm_q = 0;
            chk_q  = 0;
        } else {
            drop_q = drop_q + n_drop;
            brcm_q = brcm_q + (brcm as C_W);
            if brcm_q + (brcm as C_W) >: drop_q + n_drop {
                chk_q[0] = 1'b1;
            }
            if i_kill.valid != i_redirect.valid {
                chk_q[1] = 1'b1;
            }
        }
    }

    assign o_chk = chk_q;
}
