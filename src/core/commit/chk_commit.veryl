// chk_commit: observation-only invariant checker for the commit decision.
//
// Ports (timing contract):
//   inputs : commit's same-cycle decision (retire vector, flush sources,
//            window matches) and its registered sys_pending
//   o_chk  : registered sticky flags, one bit per violated invariant:
//            0 retire is not a prefix of the lanes
//            1 more than one flush source in a cycle
//            2 a lane retires in a trap, replay or interrupt cycle
//            3 a lane retires an op that the kill of the cycle selects
//            4 a SYS op retires without sys_pending holding its tag
//            5 a retiring or replaying load/store matches its LQ/SQ commit
//              window not exactly once
//            6 a started pulse while the oldest token is invalid
// Owns:
//   - no output feeds design logic; instantiated only under HELIODOR_CHK
// Rationale:
//   - observation only and built only under HELIODOR_CHK, so its serial
//     loops over the lanes are exempt from the tree rule
pub module chk_commit::<CFG: core_cfg> (
    clk          : input  clock                                                                      ,
    rst          : input  reset                                                                      ,
    i_retire     : input  logic                        <CFG::COMMIT_W>                               ,
    i_cm         : input  core_types::<CFG>::RobCm                                    [CFG::COMMIT_W],
    i_kill       : input  core_types::<CFG>::Kill                                                    ,
    i_trap_fire  : input  logic                                                                      ,
    i_replay_fire: input  logic                                                                      ,
    i_irq_take   : input  logic                                                                      ,
    i_rf_lane    : input  logic                        <CFG::COMMIT_W>                               ,
    i_sys_q      : input  core_types::<CFG>::SysPending                                              ,
    i_lq_hit     : input  logic                        <CFG::COMMIT_W>                [CFG::COMMIT_W],
    i_sq_hit     : input  logic                        <CFG::MEM_W>                   [CFG::COMMIT_W],
    i_started    : input  logic                        <core_types::<CFG>::STARTED_N>                ,
    i_oldest     : input  core_types::<CFG>::TagTok                                                  ,
    o_chk        : output logic                        <core_types::<CFG>::CHK_CM_W>                 ,
) {
    import core_types::<CFG>::*;
    import opclass_pkg::*;

    const CW: u32 = CFG::COMMIT_W;
    const MW: u32 = CFG::MEM_W;

    var chk_q: logic<CHK_CM_W>;

    var bad: logic<CHK_CM_W>;
    always_comb {
        var nf : u32;
        bad = 0;
        if i_retire != tree_prefix_and::<CW>(i_retire) {
            bad[0] = 1'b1;
        }
        nf = (i_trap_fire as u32) + (i_replay_fire as u32) + (i_irq_take as u32);
        for l in 0..CW {
            nf += i_rf_lane[l] as u32;
        }
        if nf >: 1 {
            bad[1] = 1'b1;
        }
        if i_retire != 0 && (i_trap_fire || i_replay_fire || i_irq_take) {
            bad[2] = 1'b1;
        }
        for l in 0..CW {
            let e   : RobEnt = i_cm[l].ent;
            let used: logic  = i_retire[l] || (l == 0 && i_replay_fire);
            if i_retire[l] && killed(i_kill, i_cm[l].tag) {
                bad[3] = 1'b1;
            }
            if i_retire[l] && e.fu == FuKind::SYS && !(i_sys_q.valid && i_sys_q.tag == i_cm[l].tag) {
                bad[4] = 1'b1;
            }
            if used && e.lq_v && (i_lq_hit[l] == 0 || i_lq_hit[l] != tree_first::<CW>(i_lq_hit[l])) {
                bad[5] = 1'b1;
            }
            if i_retire[l] && e.sq_v && (i_sq_hit[l] == 0 || i_sq_hit[l] != tree_first::<MW>(i_sq_hit[l])) {
                bad[5] = 1'b1;
            }
        }
        if i_started != 0 && !i_oldest.valid {
            bad[6] = 1'b1;
        }
    }

    always_ff {
        if_reset {
            chk_q = 0;
        } else {
            chk_q = chk_q | bad;
        }
    }

    assign o_chk = chk_q;
}
