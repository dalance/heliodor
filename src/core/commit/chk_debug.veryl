// chk_debug: observation-only invariant checker for Debug Mode.
//
// Ports (timing contract):
//   i_dm              : csr's debug_mode (registered)
//   i_irq_take, i_trap_in : commit's interrupt acceptance and trap_unit's
//                       trap input to csr, same cycle
//   i_dm_req, i_started : commit's pending Debug Mode entry and the started
//                       pulses of the units, same cycle
//   i_step, i_retire_cnt, i_trap_fire : commit's step_q and its retire and
//                       trap decision, same cycle
//   i_ic_req_valid, i_ic_req : the icache request (from ifu's f1 register)
//   i_retire, i_retire_dm : the registered retire records
//   i_acc, i_tdata1_wr : commit took a DEBUG, TRAP or icount (any outcome a
//                       trigger can cause), a tdata1 write retired; same cycle
//   i_hit             : trig_unit's hit bits (registered)
//   o_chk             : registered sticky flags, one bit per violated
//                       invariant:
//                       0 an interrupt is taken or csr gets a trap in Debug
//                         Mode
//                       1 a started pulse while a Debug Mode entry is pending
//                       2 more than one record or interrupt between arming a
//                         step and the next entry
//                       3 a probing icache request to debug memory outside
//                         Debug Mode
//                       4 a load or store record to debug memory outside
//                         Debug Mode
//                       5 a trigger hit bit set in a cycle that follows
//                         neither an acceptance nor a tdata1 write
// Owns:
//   - no output feeds design logic; instantiated only under HELIODOR_CHK
// Rationale:
//   - an icache request leaves f1 only when no kill is present, and the kill
//     of a dret arrives with the cleared debug_mode, so a request made in
//     Debug Mode never reaches the icache after it
pub module chk_debug::<CFG: core_cfg> #(
    param PMA_N      : u32                        = 1,
    param PMA_REGIONS: pma_pkg::PmaRegion [PMA_N] = '{
        default: pma_pkg::PmaRegion'{base: 0, mask: 0, attr: 0 as pma_pkg::PmaAttr}
    },
) (
    clk           : input  clock                                                                    ,
    rst           : input  reset                                                                    ,
    i_dm          : input  logic                                                                    ,
    i_irq_take    : input  logic                                                                    ,
    i_trap_in     : input  logic                                                                    ,
    i_dm_req      : input  logic                                                                    ,
    i_started     : input  logic                   <core_types::<CFG>::STARTED_N>                   ,
    i_step        : input  logic                                                                    ,
    i_retire_cnt  : input  logic                   <core_types::<CFG>::RETIRE_CNT_W>                ,
    i_trap_fire   : input  logic                                                                    ,
    i_ic_req_valid: input  logic                                                                    ,
    i_ic_req      : input  core_types::<CFG>::IcReq                                                 ,
    i_retire      : input  retire_pkg::RetireRec                                     [CFG::COMMIT_W],
    i_retire_dm   : input  logic                                                                    ,
    i_acc         : input  logic                                                                    ,
    i_tdata1_wr   : input  logic                                                                    ,
    i_hit         : input  logic                   <CFG::TRIG_N>                                    ,
    o_chk         : output logic                   <core_types::<CFG>::CHK_DBG_W>                   ,
) {
    import core_types::<CFG>::*;

    const CW: u32 = CFG::COMMIT_W;

    function is_dbg (
        pa: input pma_pkg::Pa,
    ) -> logic {
        let a: pma_pkg::PmaAttr = pma_check::<PMA_N>(pa, PMA_REGIONS);
        return a.target == pma_pkg::Target::DEBUG;
    }

    var chk_q : logic<CHK_DBG_W>;
    var hit_q : logic<CFG::TRIG_N>; // the hit bits and their write causes, last cycle
    var acc_q : logic             ;
    var step_n: u32             ; // records and interrupts since the step was armed

    var bad  : logic<CHK_DBG_W>;
    var n_nxt: u32             ;
    always_comb {
        bad   = 0;
        n_nxt = 0;
        if i_dm && (i_irq_take || i_trap_in) {
            bad[0] = 1'b1;
        }
        if i_dm_req && i_started != 0 {
            bad[1] = 1'b1;
        }
        if i_step {
            n_nxt = step_n + (i_retire_cnt as u32) + (i_trap_fire as u32) + (i_irq_take as u32);
            if n_nxt >: 1 {
                bad[2] = 1'b1;
            }
        }
        if i_ic_req_valid && i_ic_req.id.probe && !i_dm && is_dbg(i_ic_req.pa) {
            bad[3] = 1'b1;
        }
        if (i_hit & ~hit_q) != 0 && !acc_q {
            bad[5] = 1'b1;
        }
        for l in 0..CW {
            let r: retire_pkg::RetireRec = i_retire[l];
            if r.valid && !r.trap && !i_retire_dm && (r.mem_rmask != 0 || r.mem_wmask != 0)
                && is_dbg(r.mem_paddr[55:0]) {
                bad[4] = 1'b1;
            }
        }
    }

    always_ff {
        if_reset {
            chk_q  = 0;
            step_n = 0;
            hit_q  = 0;
            acc_q  = 1'b0;
        } else {
            chk_q  = chk_q | bad;
            hit_q  = i_hit;
            acc_q  = i_acc || i_tdata1_wr;
            step_n = if n_nxt >: 2 ? 2 : n_nxt;
        }
    }

    assign o_chk = chk_q;
}
