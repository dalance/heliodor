// trap_unit: trap cause, delegation, tval and target, and the xRET targets.
//
// Ports (timing contract):
//   all inputs are registered state (rob's exc_q, commit's o_irq_q and
//   o_epc, csr outputs) or commit's fire decisions; every output is
//   combinational
//   i_trap_fire/i_irq_take/i_bp_take : commit's decision for lane 0 this
//                            cycle; i_bp_take is the icount breakpoint
//   o_trap                 : csr trap inputs, fire = any of the three
//   o_target, o_tval       : trap vector and tval, valid whenever a trap fires
//   o_mret_pc, o_sret_pc, o_dret_pc : xRET targets, read from csr before the
//                            edge that updates it
//   i_dm_exc_pc            : static, the exception entry of debug memory
//   o_perf                 : combinational events of the trap that fires
// Owns:
//   - the epc of every trap is the committed next PC (i_epc); a synchronous
//     trap's cause comes only from the carried ExcRec, never from live state
//   - an interrupt wins over the head's exception (commit takes it first)
//   - in Debug Mode (i_dm) a trap writes no CSR: o_trap.fire stays 0 and the
//     target is i_dm_exc_pc (commit takes no interrupt there)
// Rationale:
//   - priv and V are csr's current values: they change only on a trap or an
//     xRET retire, both full kills, so they equal the mode the op ran in
//   - breakpoint tval: an EBREAK's is the epc, so decode needs no PC; an
//     address trigger carries its own (the op's PC or the access VA); the
//     icount breakpoint has no address and reports 0
//   - a synchronous trap from V = 1 goes to VS when both medeleg and
//     hedeleg delegate it; an interrupt's target comes from csr
//   - htval/mtval2 get ExcRec.gpa for a guest-page fault and 0 otherwise;
//     htinst/mtinst get the pseudoinstruction of a 64-bit read (0x3000) for
//     a guest-page fault of an implicit VS-stage PTE read and 0 otherwise
//   - gva: from V = 1 every cause whose tval is an address (breakpoint,
//     misaligned, access, page and guest-page faults) holds a guest virtual
//     address; from V = 0 only those of an HLV/HSV or an MPRV access with
//     MPV, which the source marks in ExcRec.gva
//   - Ssdbltrp: a trap into HS with mstatus.SDT set, or into VS with
//     vsstatus.SDT set (i_sdt, i_vsdt, already gated by DTE), is a double
//     trap: it goes to M with cause 16, writes the tval, gva and tinst of the
//     trap it replaces, and puts that trap's mcause value in mtval2
pub module trap_unit::<CFG: core_cfg> (
    i_trap_fire: input  logic                         ,
    i_irq_take : input  logic                         ,
    i_bp_take  : input  logic                         ,
    i_exc      : input  exc_pkg::ExcRec               ,
    i_irq      : input  core_types::<CFG>::IrqReq     ,
    i_epc      : input  logic                     <64>,
    i_priv     : input  csr_pkg::PrivLevel            ,
    i_virt     : input  logic                         ,
    i_medeleg  : input  logic                     <64>,
    i_sdt      : input  logic                         ,
    i_vsdt     : input  logic                         ,
    i_hedeleg  : input  logic                     <64>,
    i_mtvec    : input  logic                     <64>,
    i_stvec    : input  logic                     <64>,
    i_vstvec   : input  logic                     <64>,
    i_mepc     : input  logic                     <64>,
    i_sepc     : input  logic                     <64>,
    i_vsepc    : input  logic                     <64>,
    i_dpc      : input  logic                     <64>,
    i_dm       : input  logic                         ,
    i_dm_exc_pc: input  logic                     <64>,
    o_trap     : output core_types::<CFG>::CsrTrap    ,
    o_target   : output logic                     <64>,
    o_tval     : output logic                     <64>,
    o_mret_pc  : output logic                     <64>,
    o_sret_pc  : output logic                     <64>,
    o_dret_pc  : output logic                     <64>,
    o_perf     : output core_types::<CFG>::TrapPerf   ,
) {
    import core_types::<CFG>::*;
    import csr_pkg::*;

    let ecode: logic<6> = if i_bp_take ? 6'd3 : i_exc.cause;
    let code : logic<6> = if i_irq_take ? i_irq.code : ecode;
    let d_s  : logic    = if i_irq_take ? i_irq.to_s : i_priv != PrivLevel::MACHINE && i_medeleg[ecode];
    let d_vs : logic    = if i_irq_take ? i_irq.to_vs : d_s && i_virt && i_hedeleg[ecode];
    let dbl  : logic    = if d_vs ? i_vsdt : d_s && i_sdt;
    let to_s : logic    = d_s && !dbl;
    let to_vs: logic    = d_vs && !dbl;
    let sync : logic    = !i_irq_take && !i_bp_take;
    let gpf  : logic    = sync && (ecode == 6'd20 || ecode == 6'd21 || ecode == 6'd23);

    function addr_tval (
        c: input logic<6>,
    ) -> logic {
        return case c {
            6'd0, 6'd1, 6'd3, 6'd4, 6'd5, 6'd6, 6'd7, 6'd12, 6'd13, 6'd15, 6'd20, 6'd21, 6'd23: 1'b1,
            default                                                                       : 1'b0,
        };
    }

    let tvec: logic<64> = if to_vs ? i_vstvec : if to_s ? i_stvec : i_mtvec;
    let base: logic<64> = {tvec[63:2], 2'b00};

    always_comb {
        o_tval = if i_irq_take || i_bp_take ? 64'd0 : if i_exc.cause == 6'd3 && !i_exc.trig ? i_epc : i_exc.tval;

        o_trap.fire  = (i_trap_fire || i_irq_take || i_bp_take) && !i_dm;
        o_trap.pc    = i_epc;
        o_trap.cause = if dbl ? 64'd16 : {i_irq_take, 57'd0, code};
        o_trap.tval  = o_tval;
        o_trap.to_s  = to_s;
        o_trap.to_vs = to_vs;
        o_trap.htval = if dbl ? {i_irq_take, 57'd0, code} : if gpf ? {2'b00, i_exc.gpa} : 64'd0;
        o_trap.gva   = sync && (i_exc.gva || (i_virt && addr_tval(ecode)));
        o_trap.tinst = if gpf && i_exc.implicit ? (if i_exc.imp_wr ? 64'h3020 : 64'h3000) : 64'd0;

        o_target = if i_dm ? i_dm_exc_pc : base + (if tvec[0] && i_irq_take && !dbl ? {56'd0, code, 2'b00} : 64'd0);

        o_mret_pc = i_mepc;
        o_sret_pc = if i_virt ? i_vsepc : i_sepc;
        o_dret_pc = i_dpc;
    }

    let fire_x: logic = o_trap.fire && !i_irq_take;
    let fire_i: logic = o_trap.fire && i_irq_take;
    always_comb {
        o_perf.vs      = fire_x && to_vs;
        o_perf.virt_hs = fire_x && i_virt && !to_vs;
        o_perf.irq_vss = fire_i && to_vs && code == 6'd1;
        o_perf.irq_vst = fire_i && to_vs && code == 6'd5;
        o_perf.irq_vse = fire_i && to_vs && code == 6'd9;
        o_perf.irq_vhs = fire_i && !to_vs && (code == 6'd2 || code == 6'd6 || code == 6'd10);
    }
}
