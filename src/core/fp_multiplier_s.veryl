// IEEE 754 single-precision floating-point multiplier
// Combinational. Handles normals, subnormals, zeros, infinities, NaNs.
pub module fp_multiplier_s (
    i_a     : input  logic<32>,
    i_b     : input  logic<32>,
    i_rm    : input  logic<3> ,
    o_result: output logic<32>,
    o_fflags: output logic<5> ,
) {
    var result: logic<32>;
    var fflags: logic<5> ;

    always_comb {
        var sa    : logic    ;
        var ea    : logic<8> ;
        var ma    : logic<23>;
        var sb    : logic    ;
        var eb    : logic<8> ;
        var mb    : logic<23>;
        sa     = i_a[31];
        ea     = i_a[30:23];
        ma     = i_a[22:0];
        sb     = i_b[31];
        eb     = i_b[30:23];
        mb     = i_b[22:0];
        var r_sign: logic;
        r_sign = sa ^ sb;

        var a_is_zero: logic;
        var b_is_zero: logic;
        var a_is_inf : logic;
        var b_is_inf : logic;
        var a_is_nan : logic;
        var b_is_nan : logic;
        var a_is_snan: logic;
        var b_is_snan: logic;
        var a_is_sub : logic;
        var b_is_sub : logic;
        a_is_zero = ea == 8'd0 && ma == 23'd0;
        b_is_zero = eb == 8'd0 && mb == 23'd0;
        a_is_inf  = ea == 8'hFF && ma == 23'd0;
        b_is_inf  = eb == 8'hFF && mb == 23'd0;
        a_is_nan  = ea == 8'hFF && ma != 23'd0;
        b_is_nan  = eb == 8'hFF && mb != 23'd0;
        a_is_snan = a_is_nan && ma[22] == 1'b0;
        b_is_snan = b_is_nan && mb[22] == 1'b0;
        a_is_sub  = ea == 8'd0 && ma != 23'd0;
        b_is_sub  = eb == 8'd0 && mb != 23'd0;

        result = 32'd0;
        fflags = 5'd0;

        if a_is_nan || b_is_nan {
            result = 32'h7FC00000;
            if a_is_snan || b_is_snan {
                fflags = 5'b10000;
            }
        } else if a_is_inf || b_is_inf {
            if (a_is_inf && b_is_zero) || (b_is_inf && a_is_zero) {
                result = 32'h7FC00000;
                fflags = 5'b10000;
            } else {
                result = {r_sign, 8'hFF, 23'd0};
            }
        } else if a_is_zero || b_is_zero {
            result = {r_sign, 31'd0};
        } else {
            var ea_eff: logic<10>;
            var eb_eff: logic<10>;
            if a_is_sub {
                ea_eff = 10'd1;
            } else {
                ea_eff = {2'd0, ea};
            }
            if b_is_sub {
                eb_eff = 10'd1;
            } else {
                eb_eff = {2'd0, eb};
            }
            var sig_a: logic<24>;
            var sig_b: logic<24>;
            if a_is_sub {
                sig_a = {1'b0, ma};
            } else {
                sig_a = {1'b1, ma};
            }
            if b_is_sub {
                sig_b = {1'b0, mb};
            } else {
                sig_b = {1'b1, mb};
            }

            // 24x24 → 48-bit product using 32-bit partial products
            var wide_a : logic<48>;
            var wide_b : logic<48>;
            wide_a  = {24'd0, sig_a};
            wide_b  = {24'd0, sig_b};
            var product: logic<48>;
            product = wide_a * wide_b;

            // Normalize full 48-bit product so leading 1 lands at
            // bit 47. lead_shift = 48 is the sentinel for "no bit
            // found" (product == 0, which can't happen here because
            // zero operands are handled above).
            var lead_shift: logic<6>;
            lead_shift = 6'd48;
            for i in 0..48 {
                if product[47 - i] == 1'b1 && lead_shift == 6'd48 {
                    lead_shift = i[5:0];
                }
            }
            if lead_shift == 6'd48 {
                lead_shift = 6'd47;
            }
            var prod_norm: logic<48>;
            prod_norm = product << lead_shift;
            // exp = ea+eb-127+1 (treat significand as 1.xx × 2^47)
            //       - lead_shift (we shifted leading from some bit
            //       into bit 47 which counts as one "extra" 2^0).
            // Width-11 so the biased result exponent stays representable as a
            // SIGNED value: it ranges from ~-171 (deep underflow) to +636
            // (overflow). A width-10 unsigned value wrapped negative exponents
            // to large positives, so the `<= 0` underflow test below missed
            // them and they fell through to the overflow path (→ ∞ instead of
            // flush-to-zero). Detect underflow with a signed compare.
            var r_exp: logic<11>;
            r_exp = {1'b0, ea_eff} + {1'b0, eb_eff} - 11'd126 - {5'd0, lead_shift};

            // Extract 27 bits for mantissa + GRS: bits [47:21]
            // with the remaining [20:0] folded into sticky.
            var norm_m     : logic<27>;
            norm_m      = prod_norm[47:21];
            var prod_sticky: logic;
            prod_sticky = prod_norm[20:0] != 21'd0;
            var norm_e     : logic<11>;
            norm_e      = r_exp;

            var final_m: logic<27>;
            var final_e: logic<10>;
            if $signed(norm_e) <= 11'sd0 {
                var ss: logic<11>;
                ss = 11'd1 - norm_e;
                var sc: logic<5>;
                if ss >: 11'd27 {
                    sc = 5'd27;
                } else {
                    sc = ss[4:0];
                }
                var st         : logic;
                st          = (norm_m & ((27'd1 << sc) - 27'd1)) != 27'd0;
                final_m     = norm_m >> sc;
                final_m     = {final_m[26:1], final_m[0] | st | prod_sticky};
                final_e     = 10'd0;
                prod_sticky = 1'b0;
            } else {
                final_m     = {norm_m[26:1], norm_m[0] | prod_sticky};
                final_e     = norm_e[9:0];
                prod_sticky = 1'b0;
            }

            var g       : logic;
            var r       : logic;
            var s       : logic;
            var bit_lsb : logic;
            g        = final_m[2];
            r        = final_m[1];
            s        = final_m[0];
            bit_lsb  = final_m[3];
            var round_up: logic;
            case i_rm {
                3'b000 : round_up = g && (r || s || bit_lsb);
                3'b001 : round_up = 1'b0;
                3'b010 : round_up = r_sign && (g || r || s);
                3'b011 : round_up = !r_sign && (g || r || s);
                3'b100 : round_up = g;
                default: round_up = g && (r || s || bit_lsb);
            }
            var rounded : logic<24>;
            rounded  = final_m[26:3] + {23'd0, round_up};
            if rounded[23] && !final_m[26] {
                final_e = final_e + 10'd1;
            }
            var nx: logic;
            nx = g || r || s;
            if final_e >= 10'd255 {
                result = {r_sign, 8'hFF, 23'd0};
                fflags = 5'b00101;
            } else {
                result = {r_sign, final_e[7:0], rounded[22:0]};
                if nx {
                    fflags = 5'b00001;
                }
                if final_e == 10'd0 && nx {
                    fflags = 5'b00011;
                }
            }
        }
    }
    assign o_result = result;
    assign o_fflags = fflags;
}
