// Store Buffer: 8-entry circular FIFO for OoO stores.
//
// Stores enqueue on EX completion (addr+data+wstrb known) and drain to
// dcache only after the ROB commits the corresponding entry. This prevents
// speculative stores from reaching memory before the older instructions are
// known to not trap or be squashed.
//
// E1-a (skeleton): no OoO issue, no partial forwarding; addr/data are
// provided together at enqueue. Later phases will add addr/data update
// ports (CDB-style), load-address forwarding with partial-overlap stall,
// and fence/AMO serialization.
pub module store_buffer (
    clk: input clock,
    rst: input reset,

    // ----- Enqueue (EX/MEM stage or commit; caller decides timing) -----
    i_enq_valid: input  logic    ,
    i_enq_rob  : input  logic<5> , // ROB index of this store
    i_enq_epoch: input  logic<2> , // ROB epoch
    i_enq_addr : input  logic<64>,
    i_enq_data : input  logic<64>,
    i_enq_wstrb: input  logic<8> ,
    i_enq_size : input  logic<2> , // 0=B,1=H,2=W,3=D
    i_enq_is_sc: input  logic    , // SC (conditional store)
    i_enq_is_amo: input logic    , // AMO read-modify-write
    o_enq_ready: output logic    , // SB has space for a new store

    // ----- Commit (from ROB) -----
    i_commit_valid: input logic   ,
    i_commit_rob  : input logic<5>,
    i_commit_epoch: input logic<2>,

    // ----- Drain (to dcache) -----
    o_drain_valid : output logic    ,
    o_drain_addr  : output logic<64>,
    o_drain_data  : output logic<64>,
    o_drain_wstrb : output logic<8> ,
    o_drain_size  : output logic<2> ,
    o_drain_is_sc : output logic    ,
    o_drain_is_amo: output logic    ,
    o_drain_rob   : output logic<5> ,
    i_drain_ready : input  logic    , // dcache accepted the store

    // ----- Load-address forwarding -----
    // E1-a stub: exact 8B aligned match → hit; any overlap mismatch → partial.
    i_fwd_valid  : input  logic    ,
    i_fwd_addr   : input  logic<64>,
    i_fwd_size   : input  logic<2> ,
    o_fwd_hit    : output logic    ,
    o_fwd_data   : output logic<64>,
    o_fwd_partial: output logic    ,

    // ----- Squash (misprediction) -----
    // Invalidate uncommitted entries whose ROB index is in the squash bitmap.
    i_squash_valid: input logic     ,
    i_squash_mask : input logic [32],

    // ----- Flush (trap) -----
    // Drop uncommitted entries on trap/mret. Committed entries still drain.
    i_flush: input logic,

    // ----- Invalidate-by-address -----
    // When an AMO / cross-DW / other bypass path writes directly to the
    // dcache, any SB entry at the same 8B base holds stale data. The
    // pipeline asserts i_inval_valid with i_inval_addr to invalidate all
    // matching entries so forwarding never returns stale values. In
    // shadow mode (dcache direct write still active) the lost SB entry is
    // harmless — dcache holds the up-to-date value.
    i_inval_valid: input logic    ,
    i_inval_addr : input logic<64>,

    // ----- Debug -----
    o_count: output logic<4>,
    o_full : output logic   ,
    o_empty: output logic   ,
) {
    // ============================================================
    // Entry storage (8 entries)
    // ============================================================
    var valid    : logic    [8];
    var committed: logic    [8];
    var e_rob    : logic<5> [8];
    var e_epoch  : logic<2> [8];
    var e_addr   : logic<64>[8];
    var e_data   : logic<64>[8];
    var e_wstrb  : logic<8> [8];
    var e_size   : logic<2> [8];
    var e_is_sc  : logic    [8];
    var e_is_amo : logic    [8];

    // Circular FIFO. MSB of head/tail acts as wrap counter so tail==head+8
    // distinguishes full from empty.
    var head: logic<4>;
    var tail: logic<4>;

    let count_sub: logic<4> = tail - head;
    assign o_count = count_sub;
    assign o_full  = count_sub == 4'd8;
    assign o_empty = count_sub == 4'd0;

    let head_idx: logic<3> = head[2:0];
    let tail_idx: logic<3> = tail[2:0];

    // Drain head when valid & committed. i_drain_ready acks.
    let head_drainable: logic = valid[head_idx] && committed[head_idx];
    assign o_drain_valid  = head_drainable;
    assign o_drain_addr   = e_addr  [head_idx];
    assign o_drain_data   = e_data  [head_idx];
    assign o_drain_wstrb  = e_wstrb [head_idx];
    assign o_drain_size   = e_size  [head_idx];
    assign o_drain_is_sc  = e_is_sc [head_idx];
    assign o_drain_is_amo = e_is_amo[head_idx];
    assign o_drain_rob    = e_rob   [head_idx];

    assign o_enq_ready = !o_full;

    // ============================================================
    // Forwarding: walk entries, find youngest matching 8B-aligned store.
    // E1-a stub: only full 8B match with wstrb=0xFF and size=D returns data;
    // any other overlap → partial (load must stall or go to dcache after drain).
    // ============================================================
    let fwd_base: logic<61> = i_fwd_addr[63:3];
    var fwd_hit     : logic    ;
    var fwd_partial : logic    ;
    var fwd_data_out: logic<64>;

    // Walk newest→oldest so the youngest matching store wins when multiple
    // entries alias the same address. The newest entry is at (tail_idx-1);
    // iterate by decrementing k steps from there. `valid[i]` skips empty
    // slots so the loop body only fires on live entries.
    always_comb {
        fwd_hit      = 1'b0;
        fwd_partial  = 1'b0;
        fwd_data_out = 64'd0;
        if i_fwd_valid {
            for k: i32 in 0..8 {
                let idx: logic<3> = tail_idx - 3'd1 - k[2:0];
                if valid[idx] && e_addr[idx][63:3] == fwd_base
                    && !fwd_hit && !fwd_partial {
                    if e_wstrb[idx] == 8'hff && i_fwd_size == 2'd3 {
                        fwd_hit      = 1'b1;
                        fwd_data_out = e_data[idx];
                    } else {
                        fwd_partial = 1'b1;
                    }
                }
            }
        }
    }
    assign o_fwd_hit     = fwd_hit;
    assign o_fwd_partial = fwd_partial;
    assign o_fwd_data    = fwd_data_out;

    // ============================================================
    // Sequential: enqueue, commit-mark, drain, squash, flush
    // ============================================================
    always_ff (clk, rst) {
        if_reset {
            head = 4'd0;
            tail = 4'd0;
            for i: i32 in 0..8 {
                valid[i]     = 1'b0;
                committed[i] = 1'b0;
                e_rob[i]     = 5'd0;
                e_epoch[i]   = 2'd0;
                e_addr[i]    = 64'd0;
                e_data[i]    = 64'd0;
                e_wstrb[i]   = 8'd0;
                e_size[i]    = 2'd0;
                e_is_sc[i]   = 1'b0;
                e_is_amo[i]  = 1'b0;
            }
        } else {
            if i_flush {
                for i: i32 in 0..8 {
                    if valid[i] && !committed[i] {
                        valid[i] = 1'b0;
                    }
                }
            }

            if i_squash_valid {
                for i: i32 in 0..8 {
                    if valid[i] && !committed[i] && i_squash_mask[e_rob[i]] {
                        valid[i] = 1'b0;
                    }
                }
            }

            if i_commit_valid {
                for i: i32 in 0..8 {
                    if valid[i] && e_rob[i] == i_commit_rob && e_epoch[i] == i_commit_epoch {
                        committed[i] = 1'b1;
                    }
                }
            }

            // Invalidate by address (AMO / cross-DW / bypass-path write to
            // the same 8B base). Applies to committed and uncommitted
            // alike: in shadow mode the dcache already has the correct
            // post-bypass value, so losing the SB entry just prevents
            // stale forwarding.
            if i_inval_valid {
                for i: i32 in 0..8 {
                    if valid[i] && e_addr[i][63:3] == i_inval_addr[63:3] {
                        valid[i] = 1'b0;
                    }
                }
            }

            if head_drainable && i_drain_ready {
                valid    [head_idx] = 1'b0;
                committed[head_idx] = 1'b0;
                head                = head + 4'd1;
            }

            if i_enq_valid && !o_full {
                valid    [tail_idx] = 1'b1;
                committed[tail_idx] = 1'b0;
                e_rob    [tail_idx] = i_enq_rob;
                e_epoch  [tail_idx] = i_enq_epoch;
                e_addr   [tail_idx] = i_enq_addr;
                e_data   [tail_idx] = i_enq_data;
                e_wstrb  [tail_idx] = i_enq_wstrb;
                e_size   [tail_idx] = i_enq_size;
                e_is_sc  [tail_idx] = i_enq_is_sc;
                e_is_amo [tail_idx] = i_enq_is_amo;
                tail                = tail + 4'd1;
            }
        }
    }
}
