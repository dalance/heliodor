// Store Buffer: 8-entry circular FIFO for OoO stores.
//
// Stores enqueue on EX completion (addr+data+wstrb known) and drain to
// dcache only after the ROB commits the corresponding entry. This prevents
// speculative stores from reaching memory before the older instructions are
// known to not trap or be squashed.
//
// E1-a (skeleton): no OoO issue, no partial forwarding; addr/data are
// provided together at enqueue. Later phases will add addr/data update
// ports (CDB-style), load-address forwarding with partial-overlap stall,
// and fence/AMO serialization.
pub module store_buffer (
    clk: input clock,
    rst: input reset,

    // ----- Enqueue (EX/MEM stage or commit; caller decides timing) -----
    i_enq_valid: input  logic    ,
    i_enq_rob  : input  logic<5> , // ROB index of this store
    i_enq_epoch: input  logic<2> , // ROB epoch
    i_enq_addr : input  logic<64>,
    i_enq_data : input  logic<64>,
    i_enq_wstrb: input  logic<8> ,
    i_enq_size : input  logic<2> , // 0=B,1=H,2=W,3=D
    i_enq_is_sc: input  logic    , // SC (conditional store)
    i_enq_is_amo: input logic    , // AMO read-modify-write
    o_enq_ready: output logic    , // SB has space for a new store

    // ----- Commit (from ROB) -----
    i_commit_valid: input logic   ,
    i_commit_rob  : input logic<5>,
    i_commit_epoch: input logic<2>,

    // ----- Drain (to dcache) -----
    o_drain_valid : output logic    ,
    o_drain_addr  : output logic<64>,
    o_drain_data  : output logic<64>,
    o_drain_wstrb : output logic<8> ,
    o_drain_size  : output logic<2> ,
    o_drain_is_sc : output logic    ,
    o_drain_is_amo: output logic    ,
    o_drain_rob   : output logic<5> ,
    i_drain_ready : input  logic    , // dcache accepted the store

    // ----- Load-address forwarding -----
    // Probe with the 8B-aligned dcache address (or addr_hi for the
    // second phase of a cross-DW access) and an explicit byte mask of
    // bytes the load needs from this DW. The byte mask form lets the
    // caller drive cross-DW phase2 (which needs the upper-half bytes
    // of the original size_mask << byte_off shift).
    i_fwd_valid    : input  logic    ,
    i_fwd_addr     : input  logic<64>,
    i_fwd_byte_mask: input  logic<8> , // bytes the load needs from this DW
    // ROB index + epoch of the probing load. Forwarding entries with a
    // strictly newer ROB timestamp than the load are skipped to avoid
    // memory-order violations from out-of-order store enqueues.
    i_fwd_rob      : input  logic<5> ,
    i_fwd_epoch    : input  logic<2> ,
    o_fwd_hit      : output logic    ,
    o_fwd_data     : output logic<64>,
    o_fwd_partial  : output logic    ,

    // ----- Squash (misprediction) -----
    // Invalidate uncommitted entries whose ROB index is in the squash bitmap.
    i_squash_valid: input logic     ,
    i_squash_mask : input logic [32],

    // ----- Flush (trap) -----
    // Drop uncommitted entries on trap/mret. Committed entries still drain.
    i_flush: input logic,

    // ----- Invalidate-by-address -----
    // When an AMO / cross-DW / other bypass path writes directly to the
    // dcache, any SB entry at the same 8B base holds stale data. The
    // pipeline asserts i_inval_valid with i_inval_addr to invalidate all
    // matching entries so forwarding never returns stale values. In
    // shadow mode (dcache direct write still active) the lost SB entry is
    // harmless — dcache holds the up-to-date value.
    i_inval_valid: input logic    ,
    i_inval_addr : input logic<64>,

    // ----- Line-match query (Phase 4 AMO/cross-DW serialization) -----
    // Probe with an 8B-aligned address + a probing rob/epoch timestamp.
    // o_match_older asserts when at least one valid SB entry is at the
    // same 8B base AND its ROB timestamp is strictly older than the
    // probe. AMO/cross-DW use this at MEM stage to stall until the
    // SB drains the matching older entries.
    i_match_addr : input  logic<64>,
    i_match_rob  : input  logic<5> ,
    i_match_epoch: input  logic<2> ,
    o_match_older: output logic    ,

    // ----- Debug -----
    o_count: output logic<4>,
    o_full : output logic   ,
    o_empty: output logic   ,
) {
    // ============================================================
    // Entry storage (8 entries)
    // ============================================================
    var valid    : logic    [8];
    var committed: logic    [8];
    var e_rob    : logic<5> [8];
    var e_epoch  : logic<2> [8];
    var e_addr   : logic<64>[8];
    var e_data   : logic<64>[8];
    var e_wstrb  : logic<8> [8];
    var e_size   : logic<2> [8];
    var e_is_sc  : logic    [8];
    var e_is_amo : logic    [8];

    // Circular FIFO. MSB of head/tail acts as wrap counter so tail==head+8
    // distinguishes full from empty.
    var head: logic<4>;
    var tail: logic<4>;

    let count_sub: logic<4> = tail - head;
    assign o_count = count_sub;
    assign o_full  = count_sub == 4'd8;
    assign o_empty = count_sub == 4'd0;

    let head_idx: logic<3> = head[2:0];
    let tail_idx: logic<3> = tail[2:0];

    // Drain head when valid & committed. i_drain_ready acks.
    let head_drainable: logic = valid[head_idx] && committed[head_idx];
    assign o_drain_valid  = head_drainable;
    assign o_drain_addr   = e_addr  [head_idx];
    assign o_drain_data   = e_data  [head_idx];
    assign o_drain_wstrb  = e_wstrb [head_idx];
    assign o_drain_size   = e_size  [head_idx];
    assign o_drain_is_sc  = e_is_sc [head_idx];
    assign o_drain_is_amo = e_is_amo[head_idx];
    assign o_drain_rob    = e_rob   [head_idx];

    assign o_enq_ready = !o_full;

    // ============================================================
    // Byte-granular forwarding.
    // Build the load's byte mask from size + offset, walk SB newest first,
    // and take each byte from the newest matching entry whose wstrb covers
    // it. fwd_hit when every load byte is covered; fwd_partial when some
    // are covered but not all (caller must stall until the SB drains).
    // ============================================================
    let fwd_base: logic<61> = i_fwd_addr[63:3];
    let load_mask: logic<8> = i_fwd_byte_mask;

    var filled_mask: logic<8>  ;
    var fwd_bytes  : logic<8>[8];

    function byte_of (data: input logic<64>, b: input logic<3>) -> logic<8> {
        return
            if b == 3'd0 ? data[7:0]
            : if b == 3'd1 ? data[15:8]
            : if b == 3'd2 ? data[23:16]
            : if b == 3'd3 ? data[31:24]
            : if b == 3'd4 ? data[39:32]
            : if b == 3'd5 ? data[47:40]
            : if b == 3'd6 ? data[55:48]
            : data[63:56];
    }

    // Age comparison: an SB entry is "older than the probing load" iff
    // (load_ts - entry_ts) mod 128 is in (0, 64). Equal timestamps cannot
    // occur between a load and a store (different ROB slots), but treat
    // diff==0 as "not older" defensively. Diff >= 64 means the entry is
    // newer in the circular ROB order — skip those to avoid forwarding
    // a store that is younger than the load in program order.
    let load_ts: logic<7> = {i_fwd_epoch, i_fwd_rob};

    always_comb {
        filled_mask = 8'd0;
        for b in 0..8 {
            fwd_bytes[b] = 8'd0;
        }
        if i_fwd_valid {
            for k in 0..8 {
                let idx     : logic<3> = tail_idx - 3'd1 - k[2:0];
                let entry_ts: logic<7> = {e_epoch[idx], e_rob[idx]};
                let diff    : logic<7> = load_ts - entry_ts;
                let is_older: logic    = diff <: 7'd64 && diff != 7'd0;
                if valid[idx] && is_older && e_addr[idx][63:3] == fwd_base {
                    for b in 0..8 {
                        if load_mask[b] && e_wstrb[idx][b] && !filled_mask[b] {
                            fwd_bytes[b]   = byte_of(e_data[idx], b[2:0]);
                            filled_mask[b] = 1'b1;
                        }
                    }
                }
            }
        }
    }

    // ============================================================
    // Line-match query: any older valid entry at i_match_addr's 8B base?
    // Reuses the same age comparison as forwarding.
    // ============================================================
    let match_base: logic<61> = i_match_addr[63:3];
    let match_ts  : logic<7>  = {i_match_epoch, i_match_rob};
    var match_older_any: logic;
    always_comb {
        match_older_any = 1'b0;
        for k in 0..8 {
            let mt_diff   : logic<7> = match_ts - {e_epoch[k], e_rob[k]};
            let mt_is_older: logic   = mt_diff <: 7'd64 && mt_diff != 7'd0;
            if valid[k] && mt_is_older && e_addr[k][63:3] == match_base {
                match_older_any = 1'b1;
            }
        }
    }
    assign o_match_older = match_older_any;

    let needed_bytes: logic<8> = load_mask & ~filled_mask;
    // Require load_mask != 0 for a hit: an empty mask (e.g. cross-DW phase2
    // of a load fully contained in phase1) trivially covers nothing and
    // must not assert hit.
    assign o_fwd_hit     = i_fwd_valid && load_mask != 8'd0 && needed_bytes == 8'd0;
    assign o_fwd_partial = i_fwd_valid && filled_mask != 8'd0 && needed_bytes != 8'd0;
    assign o_fwd_data    = {
        fwd_bytes[7], fwd_bytes[6], fwd_bytes[5], fwd_bytes[4],
        fwd_bytes[3], fwd_bytes[2], fwd_bytes[1], fwd_bytes[0]
    };

    // ============================================================
    // Sequential: enqueue, commit-mark, drain, squash, flush
    // ============================================================
    always_ff (clk, rst) {
        if_reset {
            head = 4'd0;
            tail = 4'd0;
            for i in 0..8 {
                valid[i]     = 1'b0;
                committed[i] = 1'b0;
                e_rob[i]     = 5'd0;
                e_epoch[i]   = 2'd0;
                e_addr[i]    = 64'd0;
                e_data[i]    = 64'd0;
                e_wstrb[i]   = 8'd0;
                e_size[i]    = 2'd0;
                e_is_sc[i]   = 1'b0;
                e_is_amo[i]  = 1'b0;
            }
        } else {
            if i_flush {
                for i in 0..8 {
                    if valid[i] && !committed[i] {
                        valid[i] = 1'b0;
                    }
                }
            }

            if i_squash_valid {
                for i in 0..8 {
                    if valid[i] && !committed[i] && i_squash_mask[e_rob[i]] {
                        valid[i] = 1'b0;
                    }
                }
            }

            if i_commit_valid {
                for i in 0..8 {
                    if valid[i] && e_rob[i] == i_commit_rob && e_epoch[i] == i_commit_epoch {
                        committed[i] = 1'b1;
                    }
                }
            }

            // Invalidate by address (AMO / cross-DW / bypass-path write to
            // the same 8B base). Applies to committed and uncommitted
            // alike: in shadow mode the dcache already has the correct
            // post-bypass value, so losing the SB entry just prevents
            // stale forwarding.
            if i_inval_valid {
                for i in 0..8 {
                    if valid[i] && e_addr[i][63:3] == i_inval_addr[63:3] {
                        valid[i] = 1'b0;
                    }
                }
            }

            if head_drainable && i_drain_ready {
                valid    [head_idx] = 1'b0;
                committed[head_idx] = 1'b0;
                head                = head + 4'd1;
            }

            if i_enq_valid && !o_full {
                valid    [tail_idx] = 1'b1;
                committed[tail_idx] = 1'b0;
                e_rob    [tail_idx] = i_enq_rob;
                e_epoch  [tail_idx] = i_enq_epoch;
                e_addr   [tail_idx] = i_enq_addr;
                e_data   [tail_idx] = i_enq_data;
                e_wstrb  [tail_idx] = i_enq_wstrb;
                e_size   [tail_idx] = i_enq_size;
                e_is_sc  [tail_idx] = i_enq_is_sc;
                e_is_amo [tail_idx] = i_enq_is_amo;
                tail                = tail + 4'd1;
            }
        }
    }
}
