// Phase 7 v4 M9.2.b: N-hart SMP SoC wrapping heliodor_core.
//
// Mirrors the single-hart heliodor_soc (which stays untouched) but scales to
// N_HARTS cores sharing one memory_bus DRAM arbiter, one L2, one CLINT (N_HARTS
// contexts) and one UART. The v4 core has NO MMIO select ports (it emits DRAM
// and MMIO mixed on its flat o_dmem); the SoC address-decodes each core's o_dmem
// into DRAM (paddr[31]) / CLINT (paddr[31:24]==0x02) / UART (paddr[31:28]==0x1).
//
// MMIO needs NO separate arbiter: the dcache grant-gates o_dmem_wen/ren, so only
// the core that won the memory_bus DRAM arbiter this cycle asserts c_dmem_wen[h]
// / c_dmem_ren[h]. An OR-reduction over the harts therefore selects exactly the
// granted core's MMIO access, and the bus already muxes its address/wdata onto
// bus_dram_addr/bus_dram_wdata. c_dmem_req covers DRAM+MMIO, so the single DRAM
// grant serialises MMIO too. (MMIO is effectively write-only in this boot —
// mtime is read via the CSR i_mtime path, timer/sw IRQ arrive on pins, the UART
// is TX-only — so the dcache never caches a stale MMIO read.)
//
// Per-hart instruction fetch (o_imem_*) and instruction PTW (o_iptw_*) stay
// per-hart and are served by the tb. Coherence: the bus broadcasts every granted
// DRAM write to all cores' i_dcache_inv (filtered to skip the writer); AMO
// atomicity: each core's o_amo_inflight feeds the bus i_amo_inflight[h] lock.
pub module heliodor_soc_smp #(
    param N_HARTS : u32 = 2            ,
    param RESET_PC: u64 = 64'h8000_0000,
) (
    clk: input clock,
    rst: input reset,
    // Per-hart instruction fetch (tb-served)
    o_imem_addr : output logic<64> [N_HARTS],
    i_imem_rdata: input  logic<32> [N_HARTS],
    o_imem_ren  : output logic     [N_HARTS],
    // Per-hart instruction PTW (tb-served)
    o_iptw_addr : output logic<64> [N_HARTS],
    o_iptw_req  : output logic     [N_HARTS],
    i_iptw_rdata: input  logic<64> [N_HARTS],
    // Shared data DRAM (MMIO stripped out internally; tb serves DRAM)
    // S25: DRAM writes are LINE transactions — 8 dword lanes + per-lane byte
    // strobes (lanes with wstrb==0 are dont-care); the hi-side bypass stays
    // dword-wide.
    o_dmem_addr    : output logic<64>    ,
    o_dmem_wdata   : output logic<64> [8],
    i_dmem_rdata   : input  logic<64>    ,
    o_dmem_wen     : output logic        ,
    o_dmem_ren     : output logic        ,
    o_dmem_wstrb   : output logic<8>  [8],
    o_dmem_wdata_hi: output logic<64>    ,
    o_dmem_wstrb_hi: output logic<8>     ,
    // UART TX observation (shared)
    o_uart_tx_valid: output logic   ,
    o_uart_tx_data : output logic<8>,
    // Per-hart architectural x3 (boot pass = hart0 x3 == 0xAA) + retire PC + a
    // retire-valid pulse (for forward-progress / spin-vs-deadlock diagnosis).
    o_dbg_r3        : output logic<64> [N_HARTS],
    o_dbg_pc        : output logic<64> [N_HARTS],
    o_dbg_retire_v  : output logic     [N_HARTS],
    o_dbg_trap_fire : output logic     [N_HARTS],
    o_dbg_trap_cause: output logic<64> [N_HARTS],
    o_dbg_trap_pc   : output logic<64> [N_HARTS],
    o_dbg_stval     : output logic<64> [N_HARTS],
    o_dbg_satp      : output logic<64> [N_HARTS],
    o_dbg_stvec     : output logic<64> [N_HARTS],
    o_dbg_mtvec     : output logic<64> [N_HARTS],
    o_dbg_trap_to_s : output logic     [N_HARTS],
    // M9.3 secondary-stack trace: per-hart committed sp (arch_regs[2]) + the
    // lane-A retire stream (PC / rd-valid / rd / data) so the tb can catch the
    // exact `ld sp, 0(__cpu_up_stack_pointer[hartid])` value at secondary boot.
    o_dbg_sp         : output logic<64> [N_HARTS],
    o_dbg_tp         : output logic<64> [N_HARTS],
    // M9.3 spurious-load-fault characterization: per-hart DMMU fault/TLB/PTW state.
    o_dbg_dmem_fault : output logic     [N_HARTS],
    o_dbg_dtlb_hit   : output logic     [N_HARTS],
    o_dbg_dtlb_ppn   : output logic<44> [N_HARTS],
    o_dbg_dtlb_perm  : output logic<4>  [N_HARTS],
    o_dbg_dptw_addr  : output logic<64> [N_HARTS],
    o_dbg_dpte       : output logic<64> [N_HARTS],
    o_dbg_dmem_vaddr : output logic<64> [N_HARTS],
    o_dbg_redirect_fire: output logic    [N_HARTS],
    o_dbg_fl_push_en   : output logic    [N_HARTS],
    o_dbg_commit_rd    : output logic<5> [N_HARTS],
    o_dbg_commit_pdst  : output logic<6> [N_HARTS],
    o_dbg_agu_rs1_arch : output logic<5> [N_HARTS],
    o_dbg_agu_rs1_pdst : output logic<6> [N_HARTS],
    // M9.3: ARCH (committed) value of the issuing load's rs1 reg. Compared to the
    // load's effective addr to tell a rename/PRF READ bug (arch valid, read garbage)
    // from a dcache/data bug (arch itself garbage from an earlier wrong load).
    o_dbg_agu_rs1_archval: output logic<64>[N_HARTS],
    o_dbg_agu_is_load  : output logic    [N_HARTS],
    o_dbg_agu_addr     : output logic<64>[N_HARTS],
    o_dbg_lfault_inj   : output logic    [N_HARTS],
    o_dbg_walk_vaddr   : output logic<64>[N_HARTS],
    o_dbg_walk_v       : output logic    [N_HARTS],
    o_dbg_walk_rob     : output logic<5> [N_HARTS],
    o_dbg_orphan_walk  : output logic    [N_HARTS],
    // M9.3 walk-FSM ring enrichment + inject→commit linkage result.
    o_dbg_walk_phys    : output logic    [N_HARTS],
    o_dbg_walk_start   : output logic    [N_HARTS],
    o_dbg_dmem_idle    : output logic    [N_HARTS],
    o_dbg_dlk_seen     : output logic    [N_HARTS],
    o_dbg_dlk_genuine  : output logic    [N_HARTS],
    o_dbg_dlk_inj      : output logic    [N_HARTS],
    o_dbg_dlk_stval    : output logic<64>[N_HARTS],
    o_dbg_dlk_pc       : output logic<64>[N_HARTS],
    o_dbg_dlk_walkpc   : output logic<64>[N_HARTS],
    o_dbg_retire_pc  : output logic<64> [N_HARTS],
    o_dbg_retire_rdv : output logic     [N_HARTS],
    o_dbg_retire_rd  : output logic<5>  [N_HARTS],
    o_dbg_retire_dat : output logic<64> [N_HARTS],
) {
    // Per-hart core <-> SoC dmem wires (pre-decode, flat DRAM+MMIO).
    var c_dmem_addr    : logic<64> [N_HARTS]    ;
    var c_dmem_wdata   : logic<64> [N_HARTS * 8]; // S25: hart h lane l = [h*8+l]
    var c_dmem_wen     : logic     [N_HARTS]    ;
    var c_dmem_ren     : logic     [N_HARTS]    ;
    var c_dmem_wstrb   : logic<8>  [N_HARTS * 8];
    var c_dmem_wdata_hi: logic<64> [N_HARTS];
    var c_dmem_wstrb_hi: logic<8>  [N_HARTS];
    var c_dmem_req     : logic     [N_HARTS];
    var c_amo_inflight : logic     [N_HARTS];
    // S23: per-hart write-channel wires (write-through + store drain).
    var c_dmemw_addr   : logic<64> [N_HARTS];
    var c_dmemw_req    : logic     [N_HARTS];

    // Per-hart MMIO address decode (mirrors the standalone tb / N=1 SoC).
    var in_dram : logic [N_HARTS];
    var in_clint: logic [N_HARTS];
    var in_uart : logic [N_HARTS];
    var in_dram_w : logic [N_HARTS];
    var in_clint_w: logic [N_HARTS];
    var in_uart_w : logic [N_HARTS];
    for h in 0..N_HARTS :gen_dec {
        assign in_dram[h]    = c_dmem_addr[h][31];
        assign in_clint[h]   = c_dmem_addr[h][31:24] == 8'h02;
        assign in_uart[h]    = c_dmem_addr[h][31:28] == 4'h1;
        // S23: the write channel carries its own address.
        assign in_dram_w[h]  = c_dmemw_addr[h][31];
        assign in_clint_w[h] = c_dmemw_addr[h][31:24] == 8'h02;
        assign in_uart_w[h]  = c_dmemw_addr[h][31:28] == 4'h1;
    }

    // Per-hart DRAM request bundle into the memory_bus arbiter. wen/ren/wstrb are
    // gated to DRAM only (MMIO is decoded here, not in the bus); req covers both
    // so the single grant serialises DRAM and MMIO accesses.
    var bus_in_raddr: logic<64> [N_HARTS]    ;
    var bus_in_ren  : logic     [N_HARTS]    ;
    var bus_in_rreq : logic     [N_HARTS]    ;
    var bus_in_waddr: logic<64> [N_HARTS]    ;
    var bus_in_wdata: logic<64> [N_HARTS * 8]; // S25: line lanes per hart
    var bus_in_wstrb: logic<8>  [N_HARTS * 8];
    var bus_in_wen  : logic     [N_HARTS]    ;
    var bus_in_wreq : logic     [N_HARTS]    ;
    var bus_in_amo  : logic     [N_HARTS]    ;
    var bus_amo_locked: logic   [N_HARTS]    ; // P9.0: bus AMO-lock tenure per hart
    var bus_dgrant  : logic     [N_HARTS]    ; // arbiter -> per-hart READ grant
    var bus_wgrant  : logic     [N_HARTS]    ; // arbiter -> per-hart WRITE grant
    // P9.1: mem_ctrl <-> SoC wires (split-transaction DRAM reads).
    var ctrl_bus_rreq: logic     [N_HARTS];
    var ctrl_hgrant  : logic     [N_HARTS];
    var ctrl_hrdata  : logic<64> [N_HARTS];
    var ctrl_mem_addr: logic<64>          ;
    var ctrl_mem_ren : logic              ;
    var l2_caddr     : logic<64>          ;
    var l2_cren      : logic              ;
    var l2_chit      : logic              ;
    var l2_cdata     : logic<64> [8]      ;
    var l2_inst_v    : logic              ;
    var l2_inst_addr : logic<64>          ;
    var l2_inst_data : logic<64> [8]      ;
    var l2_mem_addr  : logic<64>          ;
    // P9.2: directory wires (mem_ctrl <-> l2cache) + precise invalidates.
    var l2_cadd_v    : logic              ;
    var l2_cadd_hart : logic<3>           ;
    var l2_cadd_own  : logic              ;
    var l2_c_sharers : logic<N_HARTS>     ;
    var l2_c_owned   : logic              ;
    var l2_inst_hart : logic<3>           ;
    var l2_inst_oldshr: logic<N_HARTS>    ;
    var l2_iv_valid  : logic              ;
    var l2_iv_addr   : logic<64>          ;
    var l2_iv_sharers: logic<N_HARTS>     ;
    var l2_iv_owned  : logic              ;
    var l2_iv_blocked: logic              ;
    var ctrl_busy_line: logic<58> [N_HARTS];
    var ctrl_busy_v   : logic     [N_HARTS];
    var l2_w_sharers   : logic<N_HARTS>   ;
    var l2_w_sharers_hi: logic<N_HARTS>   ;
    var l2_w_owned     : logic            ;
    var l2_w_owned_hi  : logic            ;
    var ctrl_inv1_v   : logic     [N_HARTS];
    var ctrl_inv1_addr: logic<64>          ;
    var ctrl_inv2_v   : logic     [N_HARTS];
    var ctrl_inv2_addr: logic<64>          ;
    // P9.2 Phase B: write-back / MESI wires.
    var c_dmemw_wb    : logic     [N_HARTS]; // core → bus: writeback flag
    var c_dmem_rfo    : logic     [N_HARTS]; // core → mem_ctrl: store fill = RFO
    var ctrl_hexcl    : logic     [N_HARTS]; // mem_ctrl → core: grant state
    var ctrl_probe_v  : logic     [N_HARTS]; // recall engine probes
    var ctrl_probe_addr: logic<64>         ;
    var ctrl_probe_self: logic             ;
    var core_probe_ack: logic     [N_HARTS];
    var ctrl_eclr_v   : logic              ;
    var ctrl_eclr_addr: logic<64>          ;
    var ctrl_eclr_hart: logic<3>           ;
    var bus_dramw_wb  : logic              ; // bus: selected write is a WB
    var bus_dramw_sel : logic<3>           ; // bus: write-channel selected hart
    for h in 0..N_HARTS :gen_busin {
        assign bus_in_raddr[h] = c_dmem_addr[h];
        // P9.1: the bus read channel now arbitrates LEGACY (non-DRAM: MMIO /
        // firmware-ROM) combinational reads plus mem_ctrl's DRAM gather
        // beats; DRAM read transactions are accepted/streamed by mem_ctrl.
        assign bus_in_ren[h]   = c_dmem_ren[h] && !in_dram[h];
        assign bus_in_rreq[h]  = ctrl_bus_rreq[h];
        assign bus_in_waddr[h] = c_dmemw_addr[h];
        for l in 0..8 :gen_busin_lane {
            assign bus_in_wdata[h * 8 + l] = c_dmem_wdata[h * 8 + l];
            assign bus_in_wstrb[h * 8 + l] = if in_dram_w[h] ? c_dmem_wstrb[h * 8 + l] : 8'd0;
        }
        assign bus_in_wen[h]  = c_dmem_wen[h] && in_dram_w[h];
        assign bus_in_wreq[h] = c_dmemw_req[h];
        assign bus_in_amo[h]  = c_amo_inflight[h];
    }

    // Tied-off MMIO bus ports (MMIO is SoC-decoded, not bus-arbitrated).
    var bus_mmio_paddr: logic<32> [N_HARTS];
    var bus_mmio_wdata: logic<64> [N_HARTS];
    var bus_mmio_wstrb: logic<8>  [N_HARTS];
    var bus_mmio_wen  : logic     [N_HARTS];
    var bus_mmio_ren  : logic     [N_HARTS];
    var bus_clint_sel : logic     [N_HARTS];
    var bus_plic_sel  : logic     [N_HARTS];
    var bus_uart_sel  : logic     [N_HARTS];
    var bus_stall_mem : logic     [N_HARTS];
    for h in 0..N_HARTS :gen_mmio_tie {
        assign bus_mmio_paddr[h] = 32'd0;
        assign bus_mmio_wdata[h] = 64'd0;
        assign bus_mmio_wstrb[h] = 8'd0;
        assign bus_mmio_wen[h]   = 1'b0;
        assign bus_mmio_ren[h]   = 1'b0;
        assign bus_clint_sel[h]  = 1'b0;
        assign bus_plic_sel[h]   = 1'b0;
        assign bus_uart_sel[h]   = 1'b0;
        assign bus_stall_mem[h]  = 1'b0;
    }

    // memory_bus DRAM arbiter outputs (S23: per-channel downstream → L2).
    var bus_dramr_addr: logic<64>    ;
    var bus_dramw_addr: logic<64>    ;
    var bus_dram_wdata: logic<64> [8]; // S25: granted line lanes
    var bus_dram_wstrb: logic<8>  [8];
    var bus_dram_wen  : logic        ;
    // S23: write-grant qualification — the downstream DRAM port is single
    // and reads keep their pre-split priority. P9.1: a write is held while
    // mem_ctrl gathers a line from DRAM (ctrl_mem_busy) and while a legacy
    // (firmware-ROM) read owns the external port this cycle; a write to a
    // peripheral being read the same cycle is also held (the peripheral has
    // one address port).
    var bus_dramr_ren: logic;
    var ctrl_mem_busy: logic;
    let w_in_clint: logic = bus_dramw_addr[31:24] == 8'h02;
    let w_in_uart : logic = bus_dramw_addr[31:28] == 4'h1;
    let r_in_clint: logic = bus_dramr_addr[31:24] == 8'h02;
    let r_in_uart : logic = bus_dramr_addr[31:28] == 4'h1;
    let legacy_ext_read: logic = bus_dramr_ren && !r_in_clint && !r_in_uart;
    var clint_wen_w: logic;
    var clint_ren_w: logic;
    var uart_wen_w : logic;
    var uart_ren_w : logic;
    // P9.2 Phase B: write-grant OWNERSHIP VETO. A non-WB write whose target
    // line (lo, or the +8 line of a misaligned store) is OWNED by a hart
    // other than the writer must wait — the owner's dirty copy is the only
    // truth and its later writeback would bury this write. The veto holds
    // the grant and asks the recall engine to fetch the line home first.
    // All inputs are selection-based (pre-grant): the bus's write-channel
    // hart selection is independent of i_wgrant_ok.
    var wv_sel_oh: logic<N_HARTS>;
    var wv_hi    : logic         ;
    var wv_req_on: logic         ;
    always_comb {
        wv_hi     = 1'b0;
        wv_req_on = 1'b0;
        for h in 0..N_HARTS {
            wv_sel_oh[h] = bus_dramw_sel == (h as 3);
            if bus_dramw_sel == (h as 3) {
                wv_hi = c_dmem_wstrb_hi[h] != 8'd0;
                // Intent, NOT the fired write enable (c_dmem_wen asserts only
                // WITH its grant — using it here would close a comb loop
                // through wgrant_ok). req + non-WB + DRAM target suffices.
                wv_req_on = c_dmemw_req[h] && in_dram_w[h];
            }
        }
    }
    let wv_lo_veto: logic = wv_req_on && !bus_dramw_wb && l2_w_owned && ((l2_w_sharers & ~wv_sel_oh) != '0);
    let wv_hi_veto: logic = wv_req_on && !bus_dramw_wb && wv_hi && l2_w_owned_hi && ((l2_w_sharers_hi & ~wv_sel_oh) != '0);
    let w_veto    : logic = wv_lo_veto || wv_hi_veto;
    var wv_owner: logic<3>;
    always_comb {
        wv_owner = 3'd0;
        for h in 0..N_HARTS {
            if (wv_lo_veto && l2_w_sharers[h]) || (!wv_lo_veto && l2_w_sharers_hi[h]) {
                wv_owner = h as 3;
            }
        }
    }
    let wv_addr_hi: logic<64> = bus_dramw_addr + 64'd8;
    let wv_line   : logic<58> = if wv_lo_veto ? bus_dramw_addr[63:6] : wv_addr_hi[63:6];

    let wgrant_ok: logic = !ctrl_mem_busy && !legacy_ext_read && !w_veto
        && !(clint_ren_w && w_in_clint) && !(uart_ren_w && w_in_uart);

    inst u_bus: memory_bus #(
        N_HARTS: N_HARTS,
    ) (
        clk                             ,
        rst                             ,
        i_mmio_paddr    : bus_mmio_paddr,
        i_mmio_wdata    : bus_mmio_wdata,
        i_mmio_wstrb    : bus_mmio_wstrb,
        i_mmio_wen      : bus_mmio_wen  ,
        i_mmio_ren      : bus_mmio_ren  ,
        i_clint_sel     : bus_clint_sel ,
        i_plic_sel      : bus_plic_sel  ,
        i_uart_sel      : bus_uart_sel  ,
        i_stall_mem     : bus_stall_mem ,
        o_mmio_paddr    : _             ,
        o_mmio_wdata    : _             ,
        o_mmio_wstrb    : _             ,
        o_mmio_wen_clint: _             ,
        o_mmio_ren_clint: _             ,
        o_mmio_wen_plic : _             ,
        o_mmio_ren_plic : _             ,
        o_mmio_wen_uart : _             ,
        o_mmio_ren_uart : _             ,
        o_mmio_grant    : _             ,
        i_dmemr_addr    : bus_in_raddr  ,
        i_dmemr_ren     : bus_in_ren    ,
        i_dmemr_req     : bus_in_rreq   ,
        i_dmemw_addr    : bus_in_waddr  ,
        i_dmemw_wdata   : bus_in_wdata  ,
        i_dmemw_wstrb   : bus_in_wstrb  ,
        i_dmemw_wen     : bus_in_wen    ,
        i_dmemw_req     : bus_in_wreq   ,
        i_dmemw_wb      : c_dmemw_wb    , // P9.2: writeback flag
        i_amo_inflight  : bus_in_amo    ,
        o_amo_lock_held : bus_amo_locked,
        i_wgrant_ok     : wgrant_ok     ,
        o_dmemr_grant   : bus_dgrant    ,
        o_dmemw_grant   : bus_wgrant    ,
        o_dmemr_addr    : bus_dramr_addr,
        o_dmemr_ren     : bus_dramr_ren ,
        o_dmemw_addr    : bus_dramw_addr,
        o_dmemw_wdata   : bus_dram_wdata,
        o_dmemw_wstrb   : bus_dram_wstrb,
        o_dmemw_wen     : bus_dram_wen  ,
        o_dmemw_wb      : bus_dramw_wb  , // P9.2: selected write is a WB
        o_dmemw_sel     : bus_dramw_sel , // P9.2: write-channel selection
        o_dmem_inv_valid: _             , // P9.2: precise inv via mem_ctrl
        o_dmem_inv_addr : _             ,
    );

    // P9.2: PRECISE invalidation. The all-hart write broadcast is gone — the
    // L2 directory (sharer masks) tells mem_ctrl exactly which harts cache a
    // written/evicted line, and mem_ctrl drives the two per-hart invalidate
    // ports directly. The bus's legacy broadcast outputs are discarded.
    var core_inv_valid: logic     [N_HARTS];
    var core_inv_addr : logic<64> [N_HARTS];
    for h in 0..N_HARTS :gen_inv {
        assign core_inv_valid[h] = ctrl_inv1_v[h];
        assign core_inv_addr[h]  = ctrl_inv1_addr;
    }
    // P9.2: writer hart index for the directory (one-hot write grant → idx).
    var w_hart_idx: logic<3>;
    always_comb {
        w_hart_idx = 3'd0;
        for h in 0..N_HARTS {
            if bus_wgrant[h] {
                w_hart_idx = h as 3;
            }
        }
    }

    // Misaligned-store hi-side (addr+8): carried per-hart by the core, not by the
    // bus. Select the granted DRAM writer's hi-side for the L2 invalidate hint and
    // the DRAM hi-side write bypass.
    var l2_wstrb_hi  : logic<8> ;
    var dram_wdata_hi: logic<64>;
    var dram_wstrb_hi: logic<8> ;
    always_comb {
        l2_wstrb_hi   = 8'd0;
        dram_wdata_hi = 64'd0;
        dram_wstrb_hi = 8'd0;
        for h in 0..N_HARTS {
            if bus_wgrant[h] && in_dram_w[h] {
                l2_wstrb_hi   = c_dmem_wstrb_hi[h];
                dram_wdata_hi = c_dmem_wdata_hi[h];
                dram_wstrb_hi = c_dmem_wstrb_hi[h];
            }
        }
    }

    // P9.1: split-transaction DRAM read controller (see the N=1 SoC /
    // mem_ctrl headers). Per-hart slots: one outstanding line read per hart;
    // gather beats are arbitrated through the bus's read-channel rotation
    // (which keeps the AMO-lock pinning + the S20R anti-starvation shape).
    inst u_mctrl: mem_ctrl #(
        N_HARTS: N_HARTS,
    ) (
        clk                                 ,
        rst                                 ,
        i_hreq        : c_dmem_req          ,
        i_haddr       : c_dmem_addr         ,
        i_hdram       : in_dram             ,
        o_hgrant      : ctrl_hgrant         ,
        o_hrdata      : ctrl_hrdata         ,
        i_hrfo        : c_dmem_rfo          , // P9.2: store fill = RFO
        o_hexcl       : ctrl_hexcl          , // P9.2: grant state to the L1
        i_amo_locked  : bus_amo_locked      , // P9.2: RFO lock gating
        o_bus_rreq    : ctrl_bus_rreq       ,
        i_bus_rgrant  : bus_dgrant          ,
        o_l2_caddr    : l2_caddr            ,
        o_l2_cren     : l2_cren             ,
        i_l2_chit     : l2_chit             ,
        i_l2_cdata    : l2_cdata            ,
        o_cadd_v      : l2_cadd_v           , // P9.2: directory maintenance
        o_cadd_hart   : l2_cadd_hart        ,
        o_cadd_own    : l2_cadd_own         ,
        i_l2_c_shr    : l2_c_sharers        ,
        i_l2_c_owned  : l2_c_owned          ,
        o_l2_inst_v   : l2_inst_v           ,
        o_l2_inst_addr: l2_inst_addr        ,
        o_l2_inst_data: l2_inst_data        ,
        o_inst_hart   : l2_inst_hart        ,
        i_iv_valid    : l2_iv_valid         ,
        i_iv_addr     : l2_iv_addr          ,
        i_iv_sharers  : l2_iv_sharers       ,
        i_iv_owned    : l2_iv_owned         ,
        i_iv_blocked  : l2_iv_blocked       ,
        i_inst_oldshr : l2_inst_oldshr      ,
        o_busy_line   : ctrl_busy_line      ,
        o_busy_v      : ctrl_busy_v         ,
        i_w_hart      : w_hart_idx          ,
        i_w_wb        : bus_dramw_wb        ,
        i_w_shr       : l2_w_sharers        ,
        i_w_shr_hi    : l2_w_sharers_hi     ,
        o_probe_v     : ctrl_probe_v        , // P9.2: recall engine
        o_probe_addr  : ctrl_probe_addr     ,
        o_probe_self  : ctrl_probe_self     ,
        i_probe_ack   : core_probe_ack      ,
        o_eclr_v      : ctrl_eclr_v         ,
        o_eclr_addr   : ctrl_eclr_addr      ,
        o_eclr_hart   : ctrl_eclr_hart      ,
        i_wv_req      : w_veto              ,
        i_wv_line     : wv_line             ,
        i_wv_hart     : wv_owner            ,
        o_inv1_v      : ctrl_inv1_v         ,
        o_inv1_addr   : ctrl_inv1_addr      ,
        o_inv2_v      : ctrl_inv2_v         ,
        o_inv2_addr   : ctrl_inv2_addr      ,
        o_mem_addr    : ctrl_mem_addr       ,
        o_mem_ren     : ctrl_mem_ren        ,
        i_mem_rdata   : i_dmem_rdata        ,
        o_mem_busy    : ctrl_mem_busy       ,
        i_w_valid     : bus_dram_wen        ,
        i_w_addr      : bus_dramw_addr      ,
        i_w_hi        : l2_wstrb_hi != 8'd0 ,
    );

    // Shared L2 (P9.1 line-granular): lookup/copy + line install from
    // mem_ctrl; write side keeps the bus write channel; lower interface is
    // write-passthrough only.
    inst u_l2: l2cache #(
        N_HARTS: N_HARTS,
    ) (
        clk                        ,
        rst                        ,
        i_caddr    : l2_caddr      ,
        i_cren     : l2_cren       ,
        o_chit     : l2_chit       ,
        o_cdata    : l2_cdata      ,
        i_cadd_v   : l2_cadd_v     , // P9.2: directory
        i_cadd_hart: l2_cadd_hart  ,
        i_cadd_own : l2_cadd_own   ,
        o_c_sharers: l2_c_sharers  ,
        o_c_owned  : l2_c_owned    ,
        i_inst_v   : l2_inst_v     ,
        i_inst_addr: l2_inst_addr  ,
        i_inst_data: l2_inst_data  ,
        i_inst_hart : l2_inst_hart ,
        o_iv_valid  : l2_iv_valid  ,
        o_iv_addr   : l2_iv_addr   ,
        o_iv_sharers: l2_iv_sharers,
        o_iv_owned  : l2_iv_owned  ,
        o_iv_blocked: l2_iv_blocked,
        o_inst_oldshr: l2_inst_oldshr,
        i_busy_line : ctrl_busy_line,
        i_busy_v    : ctrl_busy_v  ,
        i_w_hart      : w_hart_idx     ,
        i_w_wb        : bus_dramw_wb   ,
        o_w_sharers   : l2_w_sharers   ,
        o_w_sharers_hi: l2_w_sharers_hi,
        o_w_owned     : l2_w_owned     ,
        o_w_owned_hi  : l2_w_owned_hi  ,
        i_eclr_v   : ctrl_eclr_v   ,
        i_eclr_addr: ctrl_eclr_addr,
        i_eclr_hart: ctrl_eclr_hart,
        i_waddr    : bus_dramw_addr,
        i_wdata    : bus_dram_wdata,
        i_wstrb    : bus_dram_wstrb,
        i_wstrb_hi : l2_wstrb_hi   ,
        i_wen      : bus_dram_wen  ,
        o_mem_addr : l2_mem_addr   ,
        o_mem_wdata: o_dmem_wdata  ,
        o_mem_wstrb: o_dmem_wstrb  ,
        o_mem_wen  : o_dmem_wen    ,
    );
    assign o_dmem_wdata_hi = dram_wdata_hi;
    assign o_dmem_wstrb_hi = dram_wstrb_hi;

    // External DRAM port muxing — the three users are mutually exclusive by
    // construction (gather beats and legacy firmware-ROM reads block writes
    // through wgrant_ok; the single read grant excludes gather vs legacy).
    assign o_dmem_addr = if ctrl_mem_busy ?
        ctrl_mem_addr
    : if o_dmem_wen ?
        l2_mem_addr
    :
        bus_dramr_addr
    ;
    assign o_dmem_ren = ctrl_mem_ren || legacy_ext_read;

    // Shared CLINT / UART driven by the granted core's decoded MMIO access.
    // Enables are an OR-reduction (only the granted core has c_dmem_wen/ren=1);
    // address/wdata come from the bus-muxed granted request.
    always_comb {
        clint_wen_w = 1'b0;
        clint_ren_w = 1'b0;
        uart_wen_w  = 1'b0;
        uart_ren_w  = 1'b0;
        for h in 0..N_HARTS {
            if c_dmem_wen[h] && in_clint_w[h] {
                clint_wen_w = 1'b1;
            }
            if c_dmem_ren[h] && in_clint[h] {
                clint_ren_w = 1'b1;
            }
            if c_dmem_wen[h] && in_uart_w[h] {
                uart_wen_w = 1'b1;
            }
            if c_dmem_ren[h] && in_uart[h] {
                uart_ren_w = 1'b1;
            }
        }
    }

    var clint_rdata: logic<64>         ;
    var clint_t_irq: logic     [N_HARTS];
    var clint_s_irq: logic     [N_HARTS];
    var clint_mtime: logic<64>         ;
    inst u_clint: clint #(
        N_HARTS: N_HARTS,
    ) (
        clk                              ,
        rst                              ,
        i_addr     : if clint_wen_w ? bus_dramw_addr[15:0] : bus_dramr_addr[15:0],
        i_wdata    : bus_dram_wdata[bus_dramw_addr[5:3]]      , // S25: MMIO write = one-lane line
        i_wen      : clint_wen_w         ,
        i_ren      : clint_ren_w         ,
        o_rdata    : clint_rdata         ,
        o_timer_irq: clint_t_irq         ,
        o_sw_irq   : clint_s_irq         ,
        o_mtime    : clint_mtime         ,
    );

    var uart_rdata: logic<8>;
    var uart_irq  : logic   ;
    inst u_uart: uart (
        clk                             ,
        rst                             ,
        i_addr    : if uart_wen_w ? bus_dramw_addr[2:0] : bus_dramr_addr[2:0],
        i_wdata   : bus_dram_wdata[bus_dramw_addr[5:3]][7:0] ,
        i_wen     : uart_wen_w          ,
        i_ren     : uart_ren_w          ,
        o_rdata   : uart_rdata          ,
        o_tx_valid: o_uart_tx_valid     ,
        o_tx_data : o_uart_tx_data      ,
        i_rx_data : 8'd0                ,
        i_rx_valid: 1'b0                ,
        o_irq     : uart_irq            ,
    );
    let _unused_uart_irq: logic = uart_irq;

    // Per-hart load data: CLINT / UART / DRAM (mem_ctrl per-hart stream
    // beat) / firmware-ROM (external comb port, legacy path — only the
    // granted hart's dcache advances on it).
    var core_dmem_rdata: logic<64> [N_HARTS];
    for h in 0..N_HARTS :gen_rdata {
        assign core_dmem_rdata[h] = if in_clint[h] ?
            clint_rdata
        : if in_uart[h] ?
            {56'd0, uart_rdata}
        : if in_dram[h] ?
            ctrl_hrdata[h]
        :
            i_dmem_rdata
        ;
    }

    // N cores. HART_ID = loop index → mhartid. imem/iptw per-hart (tb-served).
    for h in 0..N_HARTS :gen_core {
        var core_regs : logic<64> [32];
        var agu_rs1a_l: logic<5>      ;
        assign o_dbg_sp[h] = core_regs[2];
        assign o_dbg_tp[h] = core_regs[4];
        assign o_dbg_agu_rs1_arch[h]    = agu_rs1a_l;
        assign o_dbg_agu_rs1_archval[h] = core_regs[agu_rs1a_l];
        // S25: per-hart line lanes, flattened into the shared c_dmem_* pools.
        var core_wdata: logic<64> [8];
        var core_wstrb: logic<8>  [8];
        for l in 0..8 :gen_core_lane {
            assign c_dmem_wdata[h * 8 + l] = core_wdata[l];
            assign c_dmem_wstrb[h * 8 + l] = core_wstrb[l];
        }
        inst u_core: heliodor_core #(
            RESET_PC    : RESET_PC,
            HART_ID     : h as 8  ,
            SMP_COHERENT: 1       , // P9.2: eviction → ROB CoRR poison
        ) (
            clk                                   ,
            rst                                   ,
            o_imem_addr       : o_imem_addr[h]    ,
            i_imem_rdata      : i_imem_rdata[h]   ,
            o_imem_ren        : o_imem_ren[h]     ,
            o_iptw_addr       : o_iptw_addr[h]    ,
            o_iptw_req        : o_iptw_req[h]     ,
            i_iptw_rdata      : i_iptw_rdata[h]   ,
            o_dmem_addr       : c_dmem_addr[h]    ,
            o_dmem_wdata      : core_wdata        ,
            i_dmem_rdata      : core_dmem_rdata[h],
            i_dmem_rdata_next : 64'd0             ,
            o_dmem_wen        : c_dmem_wen[h]     ,
            o_dmem_ren        : c_dmem_ren[h]     ,
            o_dmem_wstrb      : core_wstrb        ,
            o_dmem_wdata_hi   : c_dmem_wdata_hi[h],
            o_dmem_wstrb_hi   : c_dmem_wstrb_hi[h],
            o_dmem_req        : c_dmem_req[h]     ,
            i_dmem_grant      : ctrl_hgrant[h]    , // P9.1: mem_ctrl grant

            o_dmemw_addr      : c_dmemw_addr[h]   ,
            o_dmemw_req       : c_dmemw_req[h]    ,
            i_dmemw_grant     : bus_wgrant[h]     ,
            o_dmemw_wb        : c_dmemw_wb[h]     , // P9.2: writeback flag
            o_dmem_rfo        : c_dmem_rfo[h]     , // P9.2: store fill = RFO
            i_dmem_fill_excl  : ctrl_hexcl[h]     , // P9.2: home grant state
            i_dcache_probe_v   : ctrl_probe_v[h]  , // P9.2: recall probe
            i_dcache_probe_addr: ctrl_probe_addr  ,
            i_dcache_probe_self: ctrl_probe_self  ,
            o_dcache_probe_ack : core_probe_ack[h],
            i_dcache_inv_valid: core_inv_valid[h] ,
            i_dcache_inv_addr : core_inv_addr[h]  ,
            i_dcache_inv2_valid: ctrl_inv2_v[h]   , // P9.2: precise-inv 2nd port
            i_dcache_inv2_addr : ctrl_inv2_addr   ,
            o_amo_inflight    : c_amo_inflight[h] ,
            i_amo_locked      : bus_amo_locked[h] ,
            i_irq_timer_m     : clint_t_irq[h]    ,
            i_mtime           : clint_mtime       ,
            i_irq_sw_m        : clint_s_irq[h]    ,
            i_irq_ext_m       : 1'b0              ,
            o_dbg_x3          : o_dbg_r3[h]        ,
            o_dbg_pc          : o_dbg_pc[h]        ,
            o_dbg_retire_v_a  : o_dbg_retire_v[h]  ,
            o_dbg_trap_fire   : o_dbg_trap_fire[h] ,
            o_dbg_trap_cause  : o_dbg_trap_cause[h],
            o_dbg_trap_pc     : o_dbg_trap_pc[h]   ,
            o_dbg_stval_out   : o_dbg_stval[h]     ,
            o_dbg_satp        : o_dbg_satp[h]      ,
            o_dbg_stvec_out   : o_dbg_stvec[h]     ,
            o_dbg_mtvec_out   : o_dbg_mtvec[h]     ,
            o_dbg_trap_to_s   : o_dbg_trap_to_s[h] ,
            o_dbg_regs        : core_regs          ,
            o_dbg_dmem_fault  : o_dbg_dmem_fault[h],
            o_dbg_dtlb_hit    : o_dbg_dtlb_hit[h]  ,
            o_dbg_dtlb_ppn    : o_dbg_dtlb_ppn[h]  ,
            o_dbg_dtlb_perm   : o_dbg_dtlb_perm[h] ,
            o_dbg_dptw_addr   : o_dbg_dptw_addr[h] ,
            o_dbg_dpte        : o_dbg_dpte[h]      ,
            o_dbg_dmem_vaddr  : o_dbg_dmem_vaddr[h],
            o_dbg_redirect_fire: o_dbg_redirect_fire[h],
            o_dbg_fl_push_en  : o_dbg_fl_push_en[h] ,
            o_dbg_commit_rd   : o_dbg_commit_rd[h]  ,
            o_dbg_commit_pdst : o_dbg_commit_pdst[h],
            o_dbg_agu_rs1_arch: agu_rs1a_l           ,
            o_dbg_agu_rs1_pdst: o_dbg_agu_rs1_pdst[h],
            o_dbg_agu_is_load : o_dbg_agu_is_load[h] ,
            o_dbg_agu_addr    : o_dbg_agu_addr[h]    ,
            o_dbg_lfault_inj  : o_dbg_lfault_inj[h]  ,
            o_dbg_walk_vaddr  : o_dbg_walk_vaddr[h]  ,
            o_dbg_walk_v      : o_dbg_walk_v[h]      ,
            o_dbg_walk_rob    : o_dbg_walk_rob[h]    ,
            o_dbg_orphan_walk : o_dbg_orphan_walk[h] ,
            o_dbg_walk_phys   : o_dbg_walk_phys[h]   ,
            o_dbg_walk_start  : o_dbg_walk_start[h]  ,
            o_dbg_dmem_idle   : o_dbg_dmem_idle[h]   ,
            o_dbg_dlk_seen    : o_dbg_dlk_seen[h]    ,
            o_dbg_dlk_genuine : o_dbg_dlk_genuine[h] ,
            o_dbg_dlk_inj     : o_dbg_dlk_inj[h]     ,
            o_dbg_dlk_stval   : o_dbg_dlk_stval[h]   ,
            o_dbg_dlk_pc      : o_dbg_dlk_pc[h]      ,
            o_dbg_dlk_walkpc  : o_dbg_dlk_walkpc[h]  ,
            o_dbg_retire_pc_a : o_dbg_retire_pc[h] ,
            o_dbg_retire_rd_v_a: o_dbg_retire_rdv[h],
            o_dbg_retire_rd_a : o_dbg_retire_rd[h] ,
            o_dbg_retire_data_a: o_dbg_retire_dat[h],
        );
    }
}
