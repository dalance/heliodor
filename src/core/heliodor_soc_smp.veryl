// The heliodor SoC, for N_HARTS >= 1.
//
// N_HARTS cores share one memory_bus DRAM arbiter, one L2, one CLINT (N_HARTS
// contexts), one PLIC and one UART. N_HARTS=1 is the single-hart platform; the
// coherence wiring (precise invalidates, SMP_COHERENT) stays live there too. The
// v4 core has NO MMIO select ports (it emits DRAM and MMIO mixed on its flat
// o_dmem); the SoC address-decodes each core's o_dmem into DRAM (paddr[31]) /
// CLINT (paddr[31:24]==0x02) / UART (paddr[31:28]==0x1) / PLIC
// (paddr[31:24]==0x0c).
//
// MMIO needs NO separate arbiter: the dcache grant-gates o_dmem_wen/ren, so only
// the core that won the memory_bus DRAM arbiter this cycle asserts c_dmem_wen[h]
// / c_dmem_ren[h]. An OR-reduction over the harts therefore selects exactly the
// granted core's MMIO access, and the bus already muxes its address/wdata onto
// bus_dram_addr/bus_dram_wdata. c_dmem_req covers DRAM+MMIO, so the single DRAM
// grant serialises MMIO too. (MMIO is effectively write-only in this boot —
// mtime is read via the CSR i_mtime path, timer/sw IRQ arrive on pins, the UART
// is TX-only — so the dcache never caches a stale MMIO read.)
//
// Per-hart instruction fetch (o_imem_*) and instruction PTW (o_iptw_*) stay
// per-hart and are served by the tb. Coherence: mem_ctrl drives precise per-hart
// invalidates from the L2 directory (see core_inv_valid below).
pub module heliodor_soc_smp #(
    param N_HARTS    : u32                            = 2                    ,
    param RESET_PC   : u64                            = 64'h8000_0000        ,
    param CORE       : soc_pkg::CoreSel               = soc_pkg::CoreSel::V14,
    // mtime source (soc_pkg::MTIME_*). The default CYCLE with MTIME_DIV=10 is
    // the CLINT's own prescaler. INSTRET needs a new core, N_HARTS=1 and
    // MTIME_DIV >= its retire lanes, so a cycle makes at most one tick.
    param MTIME_SRC  : u32                            = soc_pkg::MTIME_CYCLE ,
    param MTIME_DIV  : u32                            = 10                   ,
    // Test aid: a read of UART + 0x100 (bits [11:8] == 1) returns the number
    // of device-side UART writes so far instead of a UART register.
    param UART_WRCNT : bit                            = 1'b0                 ,
    param PMA_N      : u32                            = 1                    ,
    param PMA_REGIONS: pma_pkg::PmaRegion     [PMA_N] = '{
        default: pma_pkg::PmaRegion'{base: 0, mask: 0, attr: 0 as pma_pkg::PmaAttr}
    },
    // Write-buffer entries of the new-core AXI master (mem_ctrl WB_N).
    param AXI_WB_N: u32 = 2 * N_HARTS,
    // AXI ID width of the new-core DRAM port: the ARID is the mem_ctrl slot.
    const AXI_ID_W: u32 = $clog2(N_HARTS * 2),
) (
    clk: input clock,
    rst: input reset,
    // Per-hart instruction fetch (tb-served)
    o_imem_addr : output logic<64> [N_HARTS],
    i_imem_rdata: input  logic<32> [N_HARTS],
    o_imem_ren  : output logic     [N_HARTS],
    // Per-hart instruction PTW (tb-served)
    o_iptw_addr : output logic<64> [N_HARTS],
    o_iptw_req  : output logic     [N_HARTS],
    i_iptw_rdata: input  logic<64> [N_HARTS],
    // Old-core DRAM port (CORE == V14 only, 0 otherwise; MMIO stripped out
    // internally; tb serves DRAM). S25: DRAM writes are LINE transactions,
    // 8 dword lanes + per-lane byte strobes (lanes with wstrb==0 are dont-
    // care); the hi-side bypass stays dword-wide.
    o_dmem_addr    : output logic<64>    ,
    o_dmem_wdata   : output logic<64> [8],
    i_dmem_rdata   : input  logic<64>     = 0,
    o_dmem_wen     : output logic        ,
    o_dmem_ren     : output logic        ,
    o_dmem_wstrb   : output logic<8>  [8],
    o_dmem_wdata_hi: output logic<64>    ,
    o_dmem_wstrb_hi: output logic<8>     ,
    // New-core DRAM and ROM port (CORE != V14 only, idle otherwise): AXI4
    // master, 64-bit data, INCR bursts of AxSIZE 3, 56-bit PA. A line read
    // is ARLEN 7 from the line base, an uncached read ARLEN 0; a write is
    // one burst over its strobed lanes of one line. RREADY and BREADY are 1.
    o_axi_arvalid: output logic          ,
    i_axi_arready: input  logic           = 1'b0,
    o_axi_arid   : output logic<AXI_ID_W>,
    o_axi_araddr : output logic<56>      ,
    o_axi_arlen  : output logic<8>       ,
    o_axi_arsize : output logic<3>       ,
    o_axi_arburst: output logic<2>       ,
    o_axi_arlock : output logic          ,
    o_axi_arcache: output logic<4>       ,
    o_axi_arprot : output logic<3>       ,
    o_axi_arqos  : output logic<4>       ,
    i_axi_rvalid : input  logic           = 1'b0,
    o_axi_rready : output logic          ,
    i_axi_rid    : input  logic<AXI_ID_W> = 0,
    i_axi_rdata  : input  logic<64>       = 0,
    i_axi_rresp  : input  logic<2>        = 0,
    i_axi_rlast  : input  logic           = 1'b0,
    o_axi_awvalid: output logic          ,
    i_axi_awready: input  logic           = 1'b0,
    o_axi_awid   : output logic<AXI_ID_W>,
    o_axi_awaddr : output logic<56>      ,
    o_axi_awlen  : output logic<8>       ,
    o_axi_awsize : output logic<3>       ,
    o_axi_awburst: output logic<2>       ,
    o_axi_awlock : output logic          ,
    o_axi_awcache: output logic<4>       ,
    o_axi_awprot : output logic<3>       ,
    o_axi_awqos  : output logic<4>       ,
    o_axi_wvalid : output logic          ,
    i_axi_wready : input  logic           = 1'b0,
    o_axi_wdata  : output logic<64>      ,
    o_axi_wstrb  : output logic<8>       ,
    o_axi_wlast  : output logic          ,
    i_axi_bvalid : input  logic           = 1'b0,
    o_axi_bready : output logic          ,
    i_axi_bid    : input  logic<AXI_ID_W> = 0,
    i_axi_bresp  : input  logic<2>        = 0,
    // Sticky AXI errors (0 on V14): bit 0 RRESP, bit 1 BRESP != OKAY, bit 2
    // a slave protocol fault (unexpected R beat, RLAST misplaced, BID != 0).
    o_axi_err    : output logic<3>       ,
    // UART TX observation (shared)
    o_uart_tx_valid: output logic   ,
    o_uart_tx_data : output logic<8>,
    // Per-hart architectural x3 (boot pass = hart0 x3 == 0xAA) + retire PC + a
    // retire-valid pulse (for forward-progress / spin-vs-deadlock diagnosis).
    // L3 census: per-hart memory-order counters. o_dbg_lw_cause is hart-major:
    // hart h bucket c = [h*128+c].
    o_dbg_load_viol_cnt : output logic<32> [N_HARTS],
    o_dbg_load_replay_cnt: output logic<32> [N_HARTS],
    o_dbg_inv_viol_cnt  : output logic<32> [N_HARTS],
    o_dbg_mshr_pois_cnt : output logic<32> [N_HARTS],
    o_dbg_viol_exact_cnt: output logic<32> [N_HARTS],
    o_dbg_viol_pgx_cnt  : output logic<32> [N_HARTS],
    o_dbg_st_resolve_cnt: output logic<32> [N_HARTS],
    o_dbg_viol_store_cnt: output logic<32> [N_HARTS],
    o_dbg_viol_self_cnt : output logic<32> [N_HARTS],
    o_dbg_lw_cause      : output logic<32> [N_HARTS * 128],
    o_dbg_load_wait_cnt : output logic<32> [N_HARTS],
    o_dbg_rob_commit_cnt: output logic<32> [N_HARTS],
    o_dbg_r3        : output logic<64> [N_HARTS],
    o_dbg_pc        : output logic<64> [N_HARTS],
    o_dbg_retire_v  : output logic     [N_HARTS],
    o_dbg_trap_fire : output logic     [N_HARTS],
    o_dbg_trap_cause: output logic<64> [N_HARTS],
    o_dbg_trap_pc   : output logic<64> [N_HARTS],
    o_dbg_stval     : output logic<64> [N_HARTS],
    o_dbg_satp      : output logic<64> [N_HARTS],
    o_dbg_stvec     : output logic<64> [N_HARTS],
    o_dbg_mtvec     : output logic<64> [N_HARTS],
    o_dbg_trap_to_s : output logic     [N_HARTS],
    // M9.3 secondary-stack trace: per-hart committed sp (arch_regs[2]) + the
    // lane-A retire stream (PC / rd-valid / rd / data) so the tb can catch the
    // exact `ld sp, 0(__cpu_up_stack_pointer[hartid])` value at secondary boot.
    o_dbg_sp         : output logic<64> [N_HARTS],
    o_dbg_tp         : output logic<64> [N_HARTS],
    // M9.3 spurious-load-fault characterization: per-hart DMMU fault/TLB/PTW state.
    o_dbg_dmem_fault : output logic     [N_HARTS],
    o_dbg_dtlb_hit   : output logic     [N_HARTS],
    o_dbg_dtlb_ppn   : output logic<44> [N_HARTS],
    o_dbg_dtlb_perm  : output logic<4>  [N_HARTS],
    o_dbg_dptw_addr  : output logic<64> [N_HARTS],
    o_dbg_dpte       : output logic<64> [N_HARTS],
    o_dbg_dmem_vaddr : output logic<64> [N_HARTS],
    o_dbg_redirect_fire: output logic    [N_HARTS],
    o_dbg_fl_push_en   : output logic    [N_HARTS],
    o_dbg_commit_rd    : output logic<5> [N_HARTS],
    o_dbg_commit_pdst  : output logic<6> [N_HARTS],
    o_dbg_agu_rs1_arch : output logic<5> [N_HARTS],
    o_dbg_agu_rs1_pdst : output logic<6> [N_HARTS],
    // M9.3: ARCH (committed) value of the issuing load's rs1 reg. Compared to the
    // load's effective addr to tell a rename/PRF READ bug (arch valid, read garbage)
    // from a dcache/data bug (arch itself garbage from an earlier wrong load).
    o_dbg_agu_rs1_archval: output logic<64>[N_HARTS],
    o_dbg_agu_is_load  : output logic    [N_HARTS],
    o_dbg_agu_addr     : output logic<64>[N_HARTS],
    o_dbg_lfault_inj   : output logic    [N_HARTS],
    o_dbg_walk_vaddr   : output logic<64>[N_HARTS],
    o_dbg_walk_v       : output logic    [N_HARTS],
    o_dbg_walk_rob     : output logic<5> [N_HARTS],
    o_dbg_orphan_walk  : output logic    [N_HARTS],
    // M9.3 walk-FSM ring enrichment + inject→commit linkage result.
    o_dbg_walk_phys    : output logic    [N_HARTS],
    o_dbg_walk_start   : output logic    [N_HARTS],
    o_dbg_dmem_idle    : output logic    [N_HARTS],
    o_dbg_dlk_seen     : output logic    [N_HARTS],
    o_dbg_dlk_genuine  : output logic    [N_HARTS],
    o_dbg_dlk_inj      : output logic    [N_HARTS],
    o_dbg_dlk_stval    : output logic<64>[N_HARTS],
    o_dbg_dlk_pc       : output logic<64>[N_HARTS],
    o_dbg_dlk_walkpc   : output logic<64>[N_HARTS],
    o_dbg_retire_pc  : output logic<64> [N_HARTS],
    o_dbg_retire_rdv : output logic     [N_HARTS],
    o_dbg_retire_rd  : output logic<5>  [N_HARTS],
    o_dbg_retire_dat : output logic<64> [N_HARTS],
    // New cores only (CORE != V14): per-hart retire records (hart h lane l =
    // [h * RET_LANES + l]), interrupt events, flattened checker flags and
    // flattened event wires.
    o_retire   : output retire_pkg::RetireRec      [N_HARTS * soc_pkg::RET_LANES],
    o_irq_evt  : output retire_pkg::IrqEvent       [N_HARTS]                     ,
    o_core_chk : output logic<soc_pkg::CHK_W>      [N_HARTS]                     ,
    o_core_perf: output logic<soc_pkg::PERF_W>     [N_HARTS]                     ,
    // mem_ctrl AXI event wires (new cores; 0 for V14).
    o_mc_perf: output soc_pkg::McPerf,
    // mtime tick for MTIME_SRC = EXTERNAL.
    i_mtime_tick: input logic = 1'b0,
    // Per-hart schedule-replay inputs of a new core (design section 5.13);
    // ignored by V14.
    i_dbg_retire_limit_en: input logic<N_HARTS>     = 0,
    i_dbg_retire_limit   : input logic<N_HARTS, 64> = 0,
    i_dbg_irq_mask       : input logic<N_HARTS>     = 0,
    i_dbg_irq_allow      : input logic<N_HARTS>     = 0,
    // External interrupt sources, ORed into the PLIC sources (bit 10 is the
    // UART's).
    i_ext_irq_src: input logic<32> = 0,
    // Device-side CLINT/PLIC/UART accesses of this cycle: [0] read, [1] write.
    o_io_obs: output soc_pkg::IoObs [2],
) {
    // Per-hart core <-> SoC dmem wires (pre-decode, flat DRAM+MMIO).
    var c_dmem_addr    : logic<64> [N_HARTS]    ;
    var c_dmem_wdata   : logic<64> [N_HARTS * 8]; // S25: hart h lane l = [h*8+l]
    var c_dmem_wen     : logic     [N_HARTS]    ;
    var c_dmem_ren     : logic     [N_HARTS]    ;
    var c_dmem_wstrb   : logic<8>  [N_HARTS * 8];
    var c_dmem_wdata_hi: logic<64> [N_HARTS];
    var c_dmem_wstrb_hi: logic<8>  [N_HARTS];
    var c_dmem_req     : logic     [N_HARTS];
    // The D read slot's request is a line transaction (0: an uncached single
    // beat). The old core has no such output; its line reads are the DRAM ones.
    var c_dmem_line    : logic     [N_HARTS];
    // The I read slot (Block N): its address, request, line and I-read flags.
    var c_imemr_addr   : logic<64> [N_HARTS];
    var c_imemr_req    : logic     [N_HARTS];
    var c_imemr_line   : logic     [N_HARTS];
    var c_imemr_iread  : logic     [N_HARTS];
    // S23: per-hart write-channel wires (write-through + store drain).
    var c_dmemw_addr   : logic<64> [N_HARTS];
    var c_dmemw_req    : logic     [N_HARTS];

    // The new cores reach DRAM and ROM through the AXI4 port.
    const AXI: bit = CORE != soc_pkg::CoreSel::V14;

    // Per-hart MMIO address decode.
    var in_dram : logic [N_HARTS];
    var in_clint: logic [N_HARTS];
    var in_uart : logic [N_HARTS];
    var in_plic : logic [N_HARTS];
    var in_dram_w : logic [N_HARTS];
    var in_clint_w: logic [N_HARTS];
    var in_uart_w : logic [N_HARTS];
    var in_plic_w : logic [N_HARTS];
    var w_dram: logic [N_HARTS];
    for h in 0..N_HARTS :gen_wdec {
        let w_attr: pma_pkg::PmaAttr = pma_check::<PMA_N>(c_dmemw_addr[h][55:0], PMA_REGIONS);
        assign w_dram[h] = w_attr.backed && (w_attr.target == pma_pkg::Target::DRAM);
    }
    for h in 0..N_HARTS :gen_dec {
        assign in_dram[h]    = c_dmem_addr[h][31];
        assign in_clint[h]   = c_dmem_addr[h][31:24] == 8'h02;
        assign in_uart[h]    = c_dmem_addr[h][31:28] == 4'h1;
        assign in_plic[h]    = c_dmem_addr[h][31:24] == 8'h0c; // P9.5: PLIC
        // S23: the write channel carries its own address. A new core decodes
        // DRAM writes with the PMA table, as its reads.
        assign in_dram_w[h]  = if AXI ? w_dram[h] : c_dmemw_addr[h][31];
        assign in_clint_w[h] = c_dmemw_addr[h][31:24] == 8'h02;
        assign in_uart_w[h]  = c_dmemw_addr[h][31:28] == 4'h1;
        assign in_plic_w[h]  = c_dmemw_addr[h][31:24] == 8'h0c;
    }

    // Per-hart DRAM request bundle into the memory_bus arbiter. wen/ren/wstrb are
    // gated to DRAM only (MMIO is decoded here, not in the bus); req covers both
    // so the single grant serialises DRAM and MMIO accesses.
    var bus_in_raddr: logic<64> [N_HARTS]    ;
    var bus_in_ren  : logic     [N_HARTS]    ;
    var bus_in_rreq : logic     [N_HARTS]    ;
    var bus_in_waddr: logic<64> [N_HARTS]    ;
    var bus_in_wdata: logic<64> [N_HARTS * 8]; // S25: line lanes per hart
    var bus_in_wstrb: logic<8>  [N_HARTS * 8];
    var bus_in_wen  : logic     [N_HARTS]    ;
    var bus_in_wreq : logic     [N_HARTS]    ;
    var bus_dgrant  : logic     [N_HARTS]    ; // arbiter -> per-hart READ grant
    var bus_wgrant  : logic     [N_HARTS]    ; // arbiter -> per-hart WRITE grant
    // P9.1: mem_ctrl <-> SoC wires (split-transaction DRAM reads).
    var ctrl_bus_rreq: logic     [N_HARTS];
    var ctrl_hgrant  : logic     [N_HARTS * 2];
    var ctrl_hhold   : logic     [N_HARTS * 2]; // uncached DRAM read waiting for a recall
    var ctrl_hrdata  : logic<64> [N_HARTS * 2];
    var ctrl_mem_addr: logic<64>          ;
    var ctrl_mem_ren : logic              ;
    var l2_caddr     : logic<64>          ;
    var l2_cren      : logic              ;
    var l2_chit      : logic              ;
    var l2_cdata     : logic<64> [8]      ;
    var l2_inst_v    : logic              ;
    var l2_inst_addr : logic<64>          ;
    var l2_inst_data : logic<64> [8]      ;
    var l2_mem_addr  : logic<64>          ;
    var l2_mem_wdata : logic<64> [8]      ;
    var l2_mem_wstrb : logic<8>  [8]      ;
    var l2_mem_wen   : logic              ;
    // P9.2: directory wires (mem_ctrl <-> l2cache) + precise invalidates.
    var l2_cadd_v    : logic              ;
    var l2_cadd_hart : logic<3>           ;
    var l2_cadd_own  : logic              ;
    var l2_c_sharers : logic<N_HARTS>     ;
    var l2_c_owned   : logic              ;
    var l2_inst_hart : logic<3>           ;
    var l2_inst_oldshr: logic<N_HARTS>    ;
    var l2_iv_valid  : logic              ;
    var l2_iv_addr   : logic<64>          ;
    var l2_iv_sharers: logic<N_HARTS>     ;
    var l2_iv_owned  : logic              ;
    var l2_iv_blocked: logic              ;
    var l2_inst_port_busy: logic          ; // P3.a L2 1R1W: install-yields-to-write hold
    var l2_w_hit         : logic          ; // P3.b L2 1R1W: write hits L2 (needs merge-read), gated
    var l2_w_spec_ready  : logic          ; // P3.b L2 1R1W: pending write-hit's old line spec-read
    var ctrl_busy_line: logic<58> [N_HARTS * 2];
    var ctrl_busy_v   : logic     [N_HARTS * 2];
    var l2_w_sharers   : logic<N_HARTS>   ;
    var l2_w_sharers_hi: logic<N_HARTS>   ;
    var l2_w_owned     : logic            ;
    var l2_w_owned_hi  : logic            ;
    var ctrl_inv1_v   : logic     [N_HARTS];
    var ctrl_inv1_addr: logic<64>          ;
    var ctrl_inv2_v   : logic     [N_HARTS];
    var ctrl_inv2_addr: logic<64>          ;
    // P9.2 Phase B: write-back / MESI wires.
    var c_dmemw_wb    : logic     [N_HARTS]; // core → bus: writeback flag
    var c_dmem_rfo    : logic     [N_HARTS * 2]; // core → mem_ctrl: store fill = RFO (per SLOT)
    var c_dmem_iread  : logic     [N_HARTS * 2]; // P9.6: core → mem_ctrl: I-cache fill (uncounted, per SLOT)
    var ctrl_hexcl    : logic     [N_HARTS * 2]; // mem_ctrl → core: grant state (per SLOT)
    var ctrl_probe_v  : logic     [N_HARTS]; // recall engine probes
    var ctrl_probe_addr: logic<64>         ;
    var ctrl_probe_self: logic             ;
    var core_probe_ack: logic     [N_HARTS];
    var ctrl_eclr_v   : logic              ;
    var ctrl_eclr_addr: logic<64>          ;
    var ctrl_eclr_hart: logic<3>           ;
    var bus_dramw_wb  : logic              ; // bus: selected write is a WB
    var bus_dramw_sel : logic<3>           ; // bus: write-channel selected hart
    // P9.3 c2c: requester directory add coinciding with a captured WB.
    var l2_wcadd_v   : logic   ;
    var l2_wcadd_hart: logic<3>;
    var l2_wcadd_own : logic   ;
    // A new core's single beat to DRAM or ROM is an uncached AXI read in
    // mem_ctrl; only its MMIO single beats use the bus read channel.
    var d_on_axi: logic [N_HARTS];
    var i_on_axi: logic [N_HARTS];
    var d_rom   : logic [N_HARTS];
    var i_rom   : logic [N_HARTS];
    for h in 0..N_HARTS :gen_axidec {
        let d_attr: pma_pkg::PmaAttr = pma_check::<PMA_N>(c_dmem_addr[h][55:0], PMA_REGIONS);
        let i_attr: pma_pkg::PmaAttr = pma_check::<PMA_N>(c_imemr_addr[h][55:0], PMA_REGIONS);
        assign d_on_axi[h] = d_attr.backed && (d_attr.target != pma_pkg::Target::IO);
        assign i_on_axi[h] = i_attr.backed && (i_attr.target != pma_pkg::Target::IO);
        assign d_rom[h]    = d_attr.target == pma_pkg::Target::ROM;
        assign i_rom[h]    = i_attr.target == pma_pkg::Target::ROM;
    }
    for h in 0..N_HARTS :gen_busin {
        // The bus read channel carries the LEGACY combinational single beats:
        // MMIO, plus the old core's firmware-ROM reads and its DRAM gather
        // beats. A new core's DRAM and ROM reads go to mem_ctrl's AXI port.
        // mem_ctrl gives the hart's bus grant to its D slot before its I slot.
        // An old core's single beat held by mem_ctrl for a recall is not on
        // the bus.
        let d_single: logic = c_dmem_req[h] && !c_dmem_line[h] && (if AXI ? !d_on_axi[h] : !ctrl_hhold[h]);
        let i_single: logic = c_imemr_req[h] && !c_imemr_line[h] && (if AXI ? !i_on_axi[h] : !ctrl_hhold[N_HARTS + h]);
        assign bus_in_raddr[h] = if !d_single && i_single ? c_imemr_addr[h] : c_dmem_addr[h];
        assign bus_in_ren[h]   = (c_dmem_ren[h] && !c_dmem_line[h] && (if AXI ? !d_on_axi[h] : !ctrl_hhold[h]))
            || (i_single && ctrl_hgrant[N_HARTS + h]);
        assign bus_in_rreq[h]  = ctrl_bus_rreq[h];
        assign bus_in_waddr[h] = c_dmemw_addr[h];
        for l in 0..8 :gen_busin_lane {
            assign bus_in_wdata[h * 8 + l] = c_dmem_wdata[h * 8 + l];
            assign bus_in_wstrb[h * 8 + l] = if in_dram_w[h] ? c_dmem_wstrb[h * 8 + l] : 8'd0;
        }
        assign bus_in_wen[h]  = c_dmem_wen[h] && in_dram_w[h];
        assign bus_in_wreq[h] = c_dmemw_req[h];
    }

    // Tied-off MMIO bus ports (MMIO is SoC-decoded, not bus-arbitrated).
    var bus_mmio_paddr: logic<32> [N_HARTS];
    var bus_mmio_wdata: logic<64> [N_HARTS];
    var bus_mmio_wstrb: logic<8>  [N_HARTS];
    var bus_mmio_wen  : logic     [N_HARTS];
    var bus_mmio_ren  : logic     [N_HARTS];
    var bus_clint_sel : logic     [N_HARTS];
    var bus_plic_sel  : logic     [N_HARTS];
    var bus_uart_sel  : logic     [N_HARTS];
    var bus_stall_mem : logic     [N_HARTS];
    for h in 0..N_HARTS :gen_mmio_tie {
        assign bus_mmio_paddr[h] = 32'd0;
        assign bus_mmio_wdata[h] = 64'd0;
        assign bus_mmio_wstrb[h] = 8'd0;
        assign bus_mmio_wen[h]   = 1'b0;
        assign bus_mmio_ren[h]   = 1'b0;
        assign bus_clint_sel[h]  = 1'b0;
        assign bus_plic_sel[h]   = 1'b0;
        assign bus_uart_sel[h]   = 1'b0;
        assign bus_stall_mem[h]  = 1'b0;
    }

    // memory_bus DRAM arbiter outputs (S23: per-channel downstream → L2).
    var bus_dramr_addr: logic<64>    ;
    var bus_dramw_addr: logic<64>    ;
    var bus_dram_wdata: logic<64> [8]; // S25: granted line lanes
    var bus_dram_wstrb: logic<8>  [8];
    var bus_dram_wen  : logic        ;
    // S23: write-grant qualification — the downstream DRAM port is single
    // and reads keep their pre-split priority. P9.1: a write is held while
    // mem_ctrl gathers a line from DRAM (ctrl_mem_busy) and while a legacy
    // (firmware-ROM) read owns the external port this cycle; a write to a
    // peripheral being read the same cycle is also held (the peripheral has
    // one address port).
    var bus_dramr_ren: logic;
    var ctrl_mem_busy: logic;
    var ctrl_wb_full : logic; // new cores: the AXI write buffer is full
    var wreq_any     : logic;
    always_comb {
        wreq_any = 1'b0;
        for h in 0..N_HARTS {
            if c_dmemw_req[h] {
                wreq_any = 1'b1;
            }
        }
    }
    let w_in_clint: logic = bus_dramw_addr[31:24] == 8'h02;
    let w_in_uart : logic = bus_dramw_addr[31:28] == 4'h1;
    let w_in_plic : logic = bus_dramw_addr[31:24] == 8'h0c; // P9.5: PLIC
    let r_in_clint: logic = bus_dramr_addr[31:24] == 8'h02;
    let r_in_uart : logic = bus_dramr_addr[31:28] == 4'h1;
    let r_in_plic : logic = bus_dramr_addr[31:24] == 8'h0c;
    // P9.5: PLIC reads are internal MMIO (served by plic_rdata), not legacy
    // firmware-ROM reads — exclude them from driving the external read port.
    let legacy_ext_read: logic = !AXI && bus_dramr_ren && !r_in_clint && !r_in_uart && !r_in_plic;
    var clint_wen_w: logic;
    var clint_ren_w: logic;
    var uart_wen_w : logic;
    var uart_ren_w : logic;
    var plic_wen_w : logic;
    var plic_ren_w : logic;
    // P9.2 Phase B: write-grant OWNERSHIP VETO. A non-WB write whose target
    // line (lo, or the +8 line of a misaligned store) is OWNED by a hart
    // other than the writer must wait — the owner's dirty copy is the only
    // truth and its later writeback would bury this write. The veto holds
    // the grant and asks the recall engine to fetch the line home first.
    // All inputs are selection-based (pre-grant): the bus's write-channel
    // hart selection is independent of i_wgrant_ok.
    var wv_sel_oh: logic<N_HARTS>;
    var wv_hi    : logic         ;
    var wv_req_on: logic         ;
    always_comb {
        wv_hi     = 1'b0;
        wv_req_on = 1'b0;
        for h in 0..N_HARTS {
            wv_sel_oh[h] = bus_dramw_sel == (h as 3);
            if bus_dramw_sel == (h as 3) {
                wv_hi = c_dmem_wstrb_hi[h] != 8'd0;
                // Intent, NOT the fired write enable (c_dmem_wen asserts only
                // WITH its grant — using it here would close a comb loop
                // through wgrant_ok). req + non-WB + DRAM target suffices.
                wv_req_on = c_dmemw_req[h] && in_dram_w[h];
            }
        }
    }
    let wv_lo_veto: logic = wv_req_on && !bus_dramw_wb && l2_w_owned && ((l2_w_sharers & ~wv_sel_oh) != '0);
    let wv_hi_veto: logic = wv_req_on && !bus_dramw_wb && wv_hi && l2_w_owned_hi && ((l2_w_sharers_hi & ~wv_sel_oh) != '0);
    let w_veto    : logic = wv_lo_veto || wv_hi_veto;
    var wv_owner: logic<3>;
    always_comb {
        wv_owner = 3'd0;
        for h in 0..N_HARTS {
            if (wv_lo_veto && l2_w_sharers[h]) || (!wv_lo_veto && l2_w_sharers_hi[h]) {
                wv_owner = h as 3;
            }
        }
    }
    let wv_addr_hi: logic<64> = bus_dramw_addr + 64'd8;
    let wv_line   : logic<58> = if wv_lo_veto ? bus_dramw_addr[63:6] : wv_addr_hi[63:6];

    // P3.b L2 1R1W: hold the grant until l2cache has speculatively read the
    // write-hit's old line so the merge write is atomic on a single read port.
    // Formed at SoC level (like w_veto) from raw l2 pieces to avoid the comb-loop
    // analyzer tripping on a bundled l2 output. 0 unless L2_READ_1R1W (o_w_hit
    // is gated). Comb on pre-grant selection + registered spec state — no loop.
    let l2_w_spec_hold: logic = wv_req_on && l2_w_hit && !l2_w_spec_ready;
    let wgrant_ok: logic = !ctrl_mem_busy && !ctrl_wb_full && !legacy_ext_read && !w_veto
        && !(clint_ren_w && w_in_clint) && !(uart_ren_w && w_in_uart)
        && !(plic_ren_w && w_in_plic) && !l2_w_spec_hold;

    inst u_bus: memory_bus #(
        N_HARTS: N_HARTS,
    ) (
        clk                             ,
        rst                             ,
        i_mmio_paddr    : bus_mmio_paddr,
        i_mmio_wdata    : bus_mmio_wdata,
        i_mmio_wstrb    : bus_mmio_wstrb,
        i_mmio_wen      : bus_mmio_wen  ,
        i_mmio_ren      : bus_mmio_ren  ,
        i_clint_sel     : bus_clint_sel ,
        i_plic_sel      : bus_plic_sel  ,
        i_uart_sel      : bus_uart_sel  ,
        i_stall_mem     : bus_stall_mem ,
        o_mmio_paddr    : _             ,
        o_mmio_wdata    : _             ,
        o_mmio_wstrb    : _             ,
        o_mmio_wen_clint: _             ,
        o_mmio_ren_clint: _             ,
        o_mmio_wen_plic : _             ,
        o_mmio_ren_plic : _             ,
        o_mmio_wen_uart : _             ,
        o_mmio_ren_uart : _             ,
        o_mmio_grant    : _             ,
        i_dmemr_addr    : bus_in_raddr  ,
        i_dmemr_ren     : bus_in_ren    ,
        i_dmemr_req     : bus_in_rreq   ,
        i_dmemw_addr    : bus_in_waddr  ,
        i_dmemw_wdata   : bus_in_wdata  ,
        i_dmemw_wstrb   : bus_in_wstrb  ,
        i_dmemw_wen     : bus_in_wen    ,
        i_dmemw_req     : bus_in_wreq   ,
        i_dmemw_wb      : c_dmemw_wb    , // P9.2: writeback flag
        i_wgrant_ok     : wgrant_ok     ,
        o_dmemr_grant   : bus_dgrant    ,
        o_dmemw_grant   : bus_wgrant    ,
        o_dmemr_addr    : bus_dramr_addr,
        o_dmemr_ren     : bus_dramr_ren ,
        o_dmemw_addr    : bus_dramw_addr,
        o_dmemw_wdata   : bus_dram_wdata,
        o_dmemw_wstrb   : bus_dram_wstrb,
        o_dmemw_wen     : bus_dram_wen  ,
        o_dmemw_wb      : bus_dramw_wb  , // P9.2: selected write is a WB
        o_dmemw_sel     : bus_dramw_sel , // P9.2: write-channel selection
        o_dmem_inv_valid: _             , // P9.2: precise inv via mem_ctrl
        o_dmem_inv_addr : _             ,
    );

    // P9.2: PRECISE invalidation. The all-hart write broadcast is gone — the
    // L2 directory (sharer masks) tells mem_ctrl exactly which harts cache a
    // written/evicted line, and mem_ctrl drives the two per-hart invalidate
    // ports directly. The bus's legacy broadcast outputs are discarded.
    var core_inv_valid: logic     [N_HARTS];
    var core_inv_addr : logic<64> [N_HARTS];
    for h in 0..N_HARTS :gen_inv {
        assign core_inv_valid[h] = ctrl_inv1_v[h];
        assign core_inv_addr[h]  = ctrl_inv1_addr;
    }
    // P9.2: writer hart index for the directory (one-hot write grant → idx).
    var w_hart_idx: logic<3>;
    always_comb {
        w_hart_idx = 3'd0;
        for h in 0..N_HARTS {
            if bus_wgrant[h] {
                w_hart_idx = h as 3;
            }
        }
    }

    // Misaligned-store hi-side (addr+8): carried per-hart by the core, not by the
    // bus. Select the granted DRAM writer's hi-side for the L2 invalidate hint and
    // the DRAM hi-side write bypass.
    var l2_wstrb_hi  : logic<8> ;
    var dram_wdata_hi: logic<64>;
    var dram_wstrb_hi: logic<8> ;
    always_comb {
        l2_wstrb_hi   = 8'd0;
        dram_wdata_hi = 64'd0;
        dram_wstrb_hi = 8'd0;
        for h in 0..N_HARTS {
            if bus_wgrant[h] && in_dram_w[h] {
                l2_wstrb_hi   = c_dmem_wstrb_hi[h];
                dram_wdata_hi = c_dmem_wdata_hi[h];
                dram_wstrb_hi = c_dmem_wstrb_hi[h];
            }
        }
    }

    // P9.1: split-transaction DRAM read controller (see the mem_ctrl header).
    // It accepts a hart's DRAM read, looks the line up in the L2 and streams
    // the 8 beats. For the old core (v14_mem_ctrl) a miss is a modeled
    // DRAM_WAIT plus an 8-cycle gather over the bus read-channel rotation;
    // for a new core (mem_ctrl) it is an AXI4 read burst, and writes leave
    // through mem_ctrl's AXI write buffer. Legacy (MMIO, and the old core's
    // firmware-ROM) reads pass through combinationally on the read grant.
    // ── Block N SHIPPED: TWO transaction slots per hart (cp_mshr_mlp_plan.md §10.2). ──
    // Slot 2h is the D side (loads, store-RFO fills, uncached MMIO), slot 2h+1 the
    // I side (I-cache fill + I-side page-table walk). The old core's I-side read is
    // always a DRAM line I-read (its non-DRAM fetch uses the o_imem passthrough);
    // a new core marks its uncached fetch as a single beat, an uncached AXI read
    // like a D-side single beat to DRAM or ROM.
    var mc_req  : logic     [N_HARTS * 2];
    var mc_addr : logic<64> [N_HARTS * 2];
    var mc_dram : logic     [N_HARTS * 2];
    var mc_unc  : logic     [N_HARTS * 2];
    var mc_rom  : logic     [N_HARTS * 2];
    // SLOT-MAJOR (see mem_ctrl's header): slots [0, N_HARTS) are the D side, one per
    // hart in hart order, and [N_HARTS, 2*N_HARTS) the I side. Hart-major numbering
    // would hand hart 0 two consecutive slots and let it win both lowest-id-wins
    // encoders in mem_ctrl, starving the higher harts.
    for h in 0..N_HARTS :gen_mcslot {
        assign mc_req[h]      = c_dmem_req[h];
        assign mc_addr[h]     = c_dmem_addr[h];
        assign mc_dram[h]     = c_dmem_line[h];
        assign mc_unc[h]      = c_dmem_req[h] && !c_dmem_line[h] && (if AXI ? d_on_axi[h] : c_dmem_addr[h][31]);
        assign mc_rom[h]      = d_rom[h];
        assign mc_req[N_HARTS + h]  = c_imemr_req[h];
        assign mc_rom[N_HARTS + h]  = i_rom[h];
        assign mc_addr[N_HARTS + h] = c_imemr_addr[h];
        assign mc_dram[N_HARTS + h] = c_imemr_line[h];
        assign mc_unc[N_HARTS + h]  = c_imemr_req[h] && !c_imemr_line[h] && (if AXI ? i_on_axi[h] : c_imemr_addr[h][31]);
        assign c_dmem_rfo[N_HARTS + h]   = 1'b0;
        assign c_dmem_iread[N_HARTS + h] = c_imemr_iread[h];
    }

    // The old core keeps its frozen copy of mem_ctrl and the old DRAM port.
    if CORE == soc_pkg::CoreSel::V14 :g_mc14 {
        inst u_mctrl: v14_mem_ctrl #(
            N_HARTS: N_HARTS,
            SPH    : 2      ,
        ) (
            clk                                 ,
            rst                                 ,
            i_hreq        : mc_req              ,
            i_haddr       : mc_addr             ,
            i_hdram       : mc_dram             ,
            o_hgrant      : ctrl_hgrant         ,
            o_hrdata      : ctrl_hrdata         ,
            i_hrfo        : c_dmem_rfo          , // P9.2: store fill = RFO
            i_iread       : c_dmem_iread        , // P9.6: I-cache fill (uncounted read)
            i_hunc        : mc_unc              ,
            o_hhold       : ctrl_hhold          ,
            o_hexcl       : ctrl_hexcl          , // P9.2: grant state to the L1
            o_bus_rreq    : ctrl_bus_rreq       ,
            i_bus_rgrant  : bus_dgrant          ,
            o_l2_caddr    : l2_caddr            ,
            o_l2_cren     : l2_cren             ,
            i_l2_chit     : l2_chit             ,
            i_l2_cdata    : l2_cdata            ,
            o_cadd_v      : l2_cadd_v           , // P9.2: directory maintenance
            o_cadd_hart   : l2_cadd_hart        ,
            o_cadd_own    : l2_cadd_own         ,
            i_l2_c_shr    : l2_c_sharers        ,
            i_l2_c_owned  : l2_c_owned          ,
            o_l2_inst_v   : l2_inst_v           ,
            o_l2_inst_addr: l2_inst_addr        ,
            o_l2_inst_data: l2_inst_data        ,
            o_inst_hart   : l2_inst_hart        ,
            i_iv_valid    : l2_iv_valid         ,
            i_iv_addr     : l2_iv_addr          ,
            i_iv_sharers  : l2_iv_sharers       ,
            i_iv_owned    : l2_iv_owned         ,
            i_iv_blocked  : l2_iv_blocked       ,
            i_inst_port_busy: l2_inst_port_busy ,
            i_inst_oldshr : l2_inst_oldshr      ,
            o_busy_line   : ctrl_busy_line      ,
            o_busy_v      : ctrl_busy_v         ,
            i_w_hart      : w_hart_idx          ,
            i_w_wb        : bus_dramw_wb        ,
            i_w_shr       : l2_w_sharers        ,
            i_w_shr_hi    : l2_w_sharers_hi     ,
            o_probe_v     : ctrl_probe_v        , // P9.2: recall engine
            o_probe_addr  : ctrl_probe_addr     ,
            o_probe_self  : ctrl_probe_self     ,
            i_probe_ack   : core_probe_ack      ,
            o_eclr_v      : ctrl_eclr_v         ,
            o_eclr_addr   : ctrl_eclr_addr      ,
            o_eclr_hart   : ctrl_eclr_hart      ,
            i_wv_req      : w_veto              ,
            i_wv_line     : wv_line             ,
            i_wv_hart     : wv_owner            ,
            o_inv1_v      : ctrl_inv1_v         ,
            o_inv1_addr   : ctrl_inv1_addr      ,
            o_inv2_v      : ctrl_inv2_v         ,
            o_inv2_addr   : ctrl_inv2_addr      ,
            o_mem_addr    : ctrl_mem_addr       ,
            o_mem_ren     : ctrl_mem_ren        ,
            i_mem_rdata   : i_dmem_rdata        ,
            o_mem_busy    : ctrl_mem_busy       ,
            i_w_valid     : bus_dram_wen        ,
            i_w_addr      : bus_dramw_addr      ,
            i_w_hi        : l2_wstrb_hi != 8'd0 ,
            i_w_lanes     : bus_dram_wdata      , // P9.3: c2c WB capture
            o_w_cadd_v    : l2_wcadd_v          ,
            o_w_cadd_hart : l2_wcadd_hart       ,
            o_w_cadd_own  : l2_wcadd_own        ,
        );
        assign o_mc_perf     = 0;
        assign ctrl_wb_full  = 1'b0;
        assign o_axi_arvalid = 1'b0;
        assign o_axi_arid    = '0;
        assign o_axi_araddr  = '0;
        assign o_axi_arlen   = '0;
        assign o_axi_rready  = 1'b0;
        assign o_axi_awvalid = 1'b0;
        assign o_axi_awid    = '0;
        assign o_axi_awaddr  = '0;
        assign o_axi_awlen   = '0;
        assign o_axi_wvalid  = 1'b0;
        assign o_axi_wdata   = '0;
        assign o_axi_wstrb   = '0;
        assign o_axi_wlast   = 1'b0;
        assign o_axi_bready  = 1'b0;
        assign o_axi_err     = 3'b000;
    } else :g_mc {
        var mc_perf: soc_pkg::McPerf;
        inst u_mctrl: mem_ctrl #(
            N_HARTS: N_HARTS ,
            SPH    : 2       ,
            WB_N   : AXI_WB_N,
        ) (
            clk                                 ,
            rst                                 ,
            i_hreq        : mc_req              ,
            i_haddr       : mc_addr             ,
            i_hdram       : mc_dram             ,
            o_hgrant      : ctrl_hgrant         ,
            o_hrdata      : ctrl_hrdata         ,
            i_hrfo        : c_dmem_rfo          , // P9.2: store fill = RFO
            i_iread       : c_dmem_iread        , // P9.6: I-cache fill (uncounted read)
            i_hunc        : mc_unc              ,
            i_hrom        : mc_rom              ,
            o_hexcl       : ctrl_hexcl          , // P9.2: grant state to the L1
            o_bus_rreq    : ctrl_bus_rreq       ,
            i_bus_rgrant  : bus_dgrant          ,
            o_l2_caddr    : l2_caddr            ,
            o_l2_cren     : l2_cren             ,
            i_l2_chit     : l2_chit             ,
            i_l2_cdata    : l2_cdata            ,
            o_cadd_v      : l2_cadd_v           , // P9.2: directory maintenance
            o_cadd_hart   : l2_cadd_hart        ,
            o_cadd_own    : l2_cadd_own         ,
            i_l2_c_shr    : l2_c_sharers        ,
            i_l2_c_owned  : l2_c_owned          ,
            o_l2_inst_v   : l2_inst_v           ,
            o_l2_inst_addr: l2_inst_addr        ,
            o_l2_inst_data: l2_inst_data        ,
            o_inst_hart   : l2_inst_hart        ,
            i_iv_valid    : l2_iv_valid         ,
            i_iv_addr     : l2_iv_addr          ,
            i_iv_sharers  : l2_iv_sharers       ,
            i_iv_owned    : l2_iv_owned         ,
            i_iv_blocked  : l2_iv_blocked       ,
            i_inst_port_busy: l2_inst_port_busy ,
            i_inst_oldshr : l2_inst_oldshr      ,
            o_busy_line   : ctrl_busy_line      ,
            o_busy_v      : ctrl_busy_v         ,
            i_w_hart      : w_hart_idx          ,
            i_w_wb        : bus_dramw_wb        ,
            i_w_shr       : l2_w_sharers        ,
            i_w_shr_hi    : l2_w_sharers_hi     ,
            o_probe_v     : ctrl_probe_v        , // P9.2: recall engine
            o_probe_addr  : ctrl_probe_addr     ,
            o_probe_self  : ctrl_probe_self     ,
            i_probe_ack   : core_probe_ack      ,
            o_eclr_v      : ctrl_eclr_v         ,
            o_eclr_addr   : ctrl_eclr_addr      ,
            o_eclr_hart   : ctrl_eclr_hart      ,
            i_wv_req      : w_veto              ,
            i_wv_line     : wv_line             ,
            i_wv_hart     : wv_owner            ,
            o_inv1_v      : ctrl_inv1_v         ,
            o_inv1_addr   : ctrl_inv1_addr      ,
            o_inv2_v      : ctrl_inv2_v         ,
            o_inv2_addr   : ctrl_inv2_addr      ,
            o_arvalid     : o_axi_arvalid       ,
            i_arready     : i_axi_arready       ,
            o_arid        : o_axi_arid          ,
            o_araddr      : o_axi_araddr        ,
            o_arlen       : o_axi_arlen         ,
            i_rvalid      : i_axi_rvalid        ,
            o_rready      : o_axi_rready        ,
            i_rid         : i_axi_rid           ,
            i_rdata       : i_axi_rdata         ,
            i_rresp       : i_axi_rresp         ,
            i_rlast       : i_axi_rlast         ,
            o_awvalid     : o_axi_awvalid       ,
            i_awready     : i_axi_awready       ,
            o_awid        : o_axi_awid          ,
            o_awaddr      : o_axi_awaddr        ,
            o_awlen       : o_axi_awlen         ,
            o_wvalid      : o_axi_wvalid        ,
            i_wready      : i_axi_wready        ,
            o_wdata       : o_axi_wdata         ,
            o_wstrb       : o_axi_wstrb         ,
            o_wlast       : o_axi_wlast         ,
            i_bvalid      : i_axi_bvalid        ,
            o_bready      : o_axi_bready        ,
            i_bid         : i_axi_bid           ,
            i_bresp       : i_axi_bresp         ,
            o_axi_err     : o_axi_err           ,
            o_wb_full     : ctrl_wb_full        ,
            i_w_valid     : bus_dram_wen        ,
            i_w_addr      : bus_dramw_addr      ,
            i_w_hi        : l2_wstrb_hi != 8'd0 ,
            i_w_strb      : bus_dram_wstrb      ,
            i_w_lanes     : bus_dram_wdata      , // P9.3: c2c WB capture
            o_w_cadd_v    : l2_wcadd_v          ,
            o_w_cadd_hart : l2_wcadd_hart       ,
            o_w_cadd_own  : l2_wcadd_own        ,
            o_perf        : mc_perf             ,
        );
        always_comb {
            o_mc_perf         = mc_perf;
            o_mc_perf.wb_full = ctrl_wb_full && wreq_any;
        }
        assign ctrl_mem_addr = 64'd0;
        assign ctrl_mem_ren  = 1'b0;
        assign ctrl_mem_busy = 1'b0;
        // An uncached read is held by its pending request, not by a hold.
        for s in 0..N_HARTS * 2 :gen_nohold {
            assign ctrl_hhold[s] = 1'b0;
        }
    }

    // Shared L2 (P9.1 line-granular): lookup/copy + line install from
    // mem_ctrl; write side keeps the bus write channel; lower interface is
    // write-passthrough only.
    inst u_l2: l2cache #(
        N_HARTS: N_HARTS,
        SPH    : 2      ,
    ) (
        clk                        ,
        rst                        ,
        i_caddr    : l2_caddr      ,
        i_cren     : l2_cren       ,
        o_chit     : l2_chit       ,
        o_cdata    : l2_cdata      ,
        i_cadd_v   : l2_cadd_v     , // P9.2: directory
        i_cadd_hart: l2_cadd_hart  ,
        i_cadd_own : l2_cadd_own   ,
        o_c_sharers: l2_c_sharers  ,
        o_c_owned  : l2_c_owned    ,
        i_inst_v   : l2_inst_v     ,
        i_inst_addr: l2_inst_addr  ,
        i_inst_data: l2_inst_data  ,
        i_inst_hart : l2_inst_hart ,
        o_iv_valid  : l2_iv_valid  ,
        o_iv_addr   : l2_iv_addr   ,
        o_iv_sharers: l2_iv_sharers,
        o_iv_owned  : l2_iv_owned  ,
        o_iv_blocked: l2_iv_blocked,
        o_inst_port_busy: l2_inst_port_busy,
        o_inst_oldshr: l2_inst_oldshr,
        i_busy_line : ctrl_busy_line,
        i_busy_v    : ctrl_busy_v  ,
        i_w_hart      : w_hart_idx     ,
        i_w_wb        : bus_dramw_wb   ,
        i_w_cadd_v   : l2_wcadd_v   , // P9.3: c2c requester add
        i_w_cadd_hart: l2_wcadd_hart,
        i_w_cadd_own : l2_wcadd_own ,
        o_w_sharers   : l2_w_sharers   ,
        o_w_sharers_hi: l2_w_sharers_hi,
        o_w_owned     : l2_w_owned     ,
        o_w_owned_hi  : l2_w_owned_hi  ,
        i_eclr_v   : ctrl_eclr_v   ,
        i_eclr_addr: ctrl_eclr_addr,
        i_eclr_hart: ctrl_eclr_hart,
        i_waddr    : bus_dramw_addr,
        i_wdata    : bus_dram_wdata,
        i_wstrb    : bus_dram_wstrb,
        i_wstrb_hi : l2_wstrb_hi   ,
        i_wen      : bus_dram_wen  ,
        i_w_req      : wv_req_on      , // P3.b: selected DRAM write requested (pre-grant)
        o_w_hit       : l2_w_hit      , // P3.b: raw hold pieces (combined at SoC)
        o_w_spec_ready: l2_w_spec_ready,
        o_mem_addr : l2_mem_addr   ,
        o_mem_wdata: l2_mem_wdata  ,
        o_mem_wstrb: l2_mem_wstrb  ,
        o_mem_wen  : l2_mem_wen    ,
    );
    // External DRAM port muxing (old core): the three users are mutually
    // exclusive by construction (gather beats and legacy firmware-ROM reads
    // block writes through wgrant_ok; the single read grant excludes gather
    // vs legacy). A new core's writes leave through the AXI write buffer.
    for l in 0..8 :gen_dmem_lane {
        assign o_dmem_wdata[l] = if AXI ? 64'd0 : l2_mem_wdata[l];
        assign o_dmem_wstrb[l] = if AXI ? 8'd0 : l2_mem_wstrb[l];
    }
    assign o_dmem_wen      = !AXI && l2_mem_wen;
    assign o_dmem_wdata_hi = if AXI ? 64'd0 : dram_wdata_hi;
    assign o_dmem_wstrb_hi = if AXI ? 8'd0 : dram_wstrb_hi;
    assign o_dmem_addr     = if AXI ?
        64'd0
    : if ctrl_mem_busy ?
        ctrl_mem_addr
    : if o_dmem_wen ?
        l2_mem_addr
    :
        bus_dramr_addr
    ;
    assign o_dmem_ren = ctrl_mem_ren || legacy_ext_read;

    // Constant AXI attributes: INCR bursts of 8-byte beats, Normal
    // Non-cacheable Bufferable, no exclusive access.
    assign o_axi_arsize  = 3'd3;
    assign o_axi_arburst = 2'b01;
    assign o_axi_arlock  = 1'b0;
    assign o_axi_arcache = 4'b0011;
    assign o_axi_arprot  = 3'd0;
    assign o_axi_arqos   = 4'd0;
    assign o_axi_awsize  = 3'd3;
    assign o_axi_awburst = 2'b01;
    assign o_axi_awlock  = 1'b0;
    assign o_axi_awcache = 4'b0011;
    assign o_axi_awprot  = 3'd0;
    assign o_axi_awqos   = 4'd0;

    // Shared CLINT / UART driven by the granted core's decoded MMIO access.
    // Enables are an OR-reduction (only the granted core has c_dmem_wen/ren=1);
    // address/wdata come from the bus-muxed granted request.
    always_comb {
        clint_wen_w = 1'b0;
        clint_ren_w = 1'b0;
        uart_wen_w  = 1'b0;
        uart_ren_w  = 1'b0;
        plic_wen_w  = 1'b0;
        plic_ren_w  = 1'b0;
        for h in 0..N_HARTS {
            if c_dmem_wen[h] && in_clint_w[h] {
                clint_wen_w = 1'b1;
            }
            if c_dmem_ren[h] && in_clint[h] {
                clint_ren_w = 1'b1;
            }
            if c_dmem_wen[h] && in_uart_w[h] {
                uart_wen_w = 1'b1;
            }
            if c_dmem_ren[h] && in_uart[h] {
                uart_ren_w = 1'b1;
            }
            if c_dmem_wen[h] && in_plic_w[h] {
                plic_wen_w = 1'b1;
            }
            if c_dmem_ren[h] && in_plic[h] {
                plic_ren_w = 1'b1;
            }
        }
    }

    // mtime tick, combinational from hart 0's registered retire records: a
    // register here would let a time read that follows the retire miss its
    // tick.
    var mt_cnt  : logic<3> ;
    var mt_acc_q: logic<32>;
    always_comb {
        mt_cnt = 3'd0;
        for l in 0..soc_pkg::RET_LANES {
            mt_cnt += {2'd0, o_retire[l].valid && !o_retire[l].trap};
        }
    }
    let mt_sum : logic<32> = if MTIME_SRC == soc_pkg::MTIME_INSTRET ? mt_acc_q + {29'd0, mt_cnt} : mt_acc_q + 32'd1;
    let mt_wrap: logic     = mt_sum >= MTIME_DIV;
    let mt_tick: logic     = if MTIME_SRC == soc_pkg::MTIME_EXTERNAL ?
        i_mtime_tick
    : if MTIME_SRC == soc_pkg::MTIME_OFF ?
        1'b0
    :
        mt_wrap
    ;
    always_ff {
        if_reset {
            mt_acc_q = 32'd0;
        } else if mt_wrap {
            mt_acc_q = mt_sum - MTIME_DIV;
        } else {
            mt_acc_q = mt_sum;
        }
    }

    var clint_rdata: logic<64>         ;
    var clint_t_irq: logic     [N_HARTS];
    var clint_s_irq: logic     [N_HARTS];
    var clint_mtime: logic<64>         ;
    inst u_clint: clint #(
        N_HARTS: N_HARTS,
    ) (
        clk                              ,
        rst                              ,
        i_addr     : if clint_wen_w ? bus_dramw_addr[15:0] : bus_dramr_addr[15:0],
        i_wdata    : bus_dram_wdata[bus_dramw_addr[5:3]]      , // S25: MMIO write = one-lane line
        i_wen      : clint_wen_w         ,
        i_ren      : clint_ren_w         ,
        o_rdata    : clint_rdata         ,
        o_timer_irq: clint_t_irq         ,
        o_sw_irq   : clint_s_irq         ,
        o_mtime    : clint_mtime         ,
        i_tick_sel : !(MTIME_SRC == soc_pkg::MTIME_CYCLE && MTIME_DIV == 10),
        i_tick     : mt_tick             ,
    );

    // A new core places a UART byte in its byte lane of the dword; the old
    // core uses byte 0 whatever the offset.
    const UART_LANE : bit       = CORE != soc_pkg::CoreSel::V14;
    let uart_wlane: logic<64> = bus_dram_wdata[bus_dramw_addr[5:3]];
    let uart_wbyte: logic<64> = if UART_LANE ? uart_wlane >> {bus_dramw_addr[2:0], 3'd0} : uart_wlane;
    var uart_rdata: logic<8>;
    var uart_irq  : logic   ;
    inst u_uart: uart (
        clk                             ,
        rst                             ,
        i_addr    : if uart_wen_w ? bus_dramw_addr[2:0] : bus_dramr_addr[2:0],
        i_wdata   : uart_wbyte[7:0]     ,
        i_wen     : uart_wen_w          ,
        i_ren     : uart_ren_w          ,
        o_rdata   : uart_rdata          ,
        o_tx_valid: o_uart_tx_valid     ,
        o_tx_data : o_uart_tx_data      ,
        i_rx_data : 8'd0                ,
        i_rx_valid: 1'b0                ,
        o_irq     : uart_irq            ,
    );

    // P9.5: shared PLIC (base 0x0C00_0000). N_HARTS*2 contexts (M+S per hart).
    // The UART is PLIC source 10 (device tree serial@10000000 interrupts=<10>).
    // The granted hart's decoded MMIO access drives the single register port
    // (address mux mirrors the CLINT/UART pattern); o_irq_m/s feed each core's
    // MEIP/SEIP. Linux services device IRQs from S-mode → o_irq_s drives SEIP.
    var plic_rdata: logic<64>          ;
    var plic_irq_m: logic     [N_HARTS];
    var plic_irq_s: logic     [N_HARTS];
    let plic_src  : logic<32> = {21'd0, uart_irq, 10'd0} | i_ext_irq_src; // bit 10 = UART
    inst u_plic: plic #(
        N_HARTS: N_HARTS,
    ) (
        clk                       ,
        rst                       ,
        i_src  : plic_src         ,
        i_addr : if plic_wen_w ? bus_dramw_addr[23:0] : bus_dramr_addr[23:0],
        i_wdata: bus_dram_wdata[bus_dramw_addr[5:3]], // S25: one-lane line write
        i_wen  : plic_wen_w       ,
        i_ren  : plic_ren_w       ,
        o_rdata: plic_rdata       ,
        o_irq_m: plic_irq_m       ,
        o_irq_s: plic_irq_s       ,
    );

    var uart_wr_n: logic<32>;
    always_ff {
        if_reset {
            uart_wr_n = 32'd0;
        } else if UART_WRCNT && uart_wen_w {
            uart_wr_n = uart_wr_n + 32'd1;
        }
    }

    // Device-side access observation. The enables are hart-exclusive (only
    // the granted hart's are set), so the AND-OR over harts selects it; the
    // strobes come from the hart because the bus zeroes them outside DRAM.
    let io_ren  : logic     = clint_ren_w || uart_ren_w || plic_ren_w;
    let io_wen  : logic     = clint_wen_w || uart_wen_w || plic_wen_w;
    let io_rdat : logic<64> = if clint_ren_w ?
        clint_rdata
    : if plic_ren_w ?
        plic_rdata
    :
        {56'd0, uart_rdata} << {bus_dramr_addr[2:0], 3'd0}
    ;
    var io_rhart: logic<3> ;
    var io_whart: logic<3> ;
    var io_wstrb: logic<8> ;
    always_comb {
        io_rhart = 3'd0;
        io_whart = 3'd0;
        io_wstrb = 8'd0;
        for h in 0..N_HARTS {
            if c_dmem_ren[h] && (in_clint[h] || in_uart[h] || in_plic[h]) {
                io_rhart = io_rhart | (h as 3);
            }
            if c_dmem_wen[h] && (in_clint_w[h] || in_uart_w[h] || in_plic_w[h]) {
                io_whart = io_whart | (h as 3);
                io_wstrb = io_wstrb | c_dmem_wstrb[h * 8 + c_dmemw_addr[h][5:3]];
            }
        }
    }
    assign o_io_obs[0] = soc_pkg::IoObs'{valid: io_ren, write: 1'b0, hart: io_rhart, addr: bus_dramr_addr, data: io_rdat,
        strb: 8'd0};
    assign o_io_obs[1] = soc_pkg::IoObs'{valid: io_wen, write: 1'b1, hart: io_whart, addr: bus_dramw_addr,
        data: bus_dram_wdata[bus_dramw_addr[5:3]], strb: io_wstrb};

    // Per-hart load data: CLINT / UART / PLIC / DRAM (mem_ctrl per-hart stream
    // beat) / firmware-ROM (external comb port, legacy path — only the
    // granted hart's dcache advances on it).
    var core_dmem_rdata: logic<64> [N_HARTS];
    for h in 0..N_HARTS :gen_rdata {
        assign core_dmem_rdata[h] = if in_clint[h] ?
            clint_rdata
        : if in_uart[h] && UART_WRCNT && c_dmem_addr[h][11:8] == 4'h1 ?
            {32'd0, uart_wr_n}
        : if in_uart[h] && UART_LANE ?
            {56'd0, uart_rdata} << {c_dmem_addr[h][2:0], 3'd0}
        : if in_uart[h] ?
            {56'd0, uart_rdata}
        : if in_plic[h] ?
            plic_rdata
        : if c_dmem_line[h] ?
            ctrl_hrdata[h]
        : if AXI ?
            ctrl_hrdata[h]
        :
            i_dmem_rdata
        ;
    }
    // A new core's I slot: a single beat reads the external port.
    var core_imemr_rdata: logic<64> [N_HARTS];
    for h in 0..N_HARTS :gen_irdata {
        assign core_imemr_rdata[h] = if c_imemr_line[h] || AXI ? ctrl_hrdata[N_HARTS + h] : i_dmem_rdata;
    }

    // N cores. HART_ID = loop index → mhartid. imem/iptw per-hart (tb-served).
    for h in 0..N_HARTS :gen_core {
        if CORE == soc_pkg::CoreSel::V14 :g_v14 {
            var core_regs : logic<64> [32];
            var agu_rs1a_l: logic<5>      ;
            assign o_dbg_sp[h] = core_regs[2];
            assign o_dbg_tp[h] = core_regs[4];
            assign o_dbg_agu_rs1_arch[h]    = agu_rs1a_l;
            assign o_dbg_agu_rs1_archval[h] = core_regs[agu_rs1a_l];
            assign c_dmem_line[h]  = in_dram[h];
            assign c_imemr_line[h]  = 1'b1;
            assign c_imemr_iread[h] = 1'b1;
            // S25: per-hart line lanes, flattened into the shared c_dmem_* pools.
            var core_wdata: logic<64> [8];
            var core_wstrb: logic<8>  [8];
            for l in 0..8 :gen_core_lane {
                assign c_dmem_wdata[h * 8 + l] = core_wdata[l];
                assign c_dmem_wstrb[h * 8 + l] = core_wstrb[l];
            }
            var core_lw_cause: logic<32> [128];
            for c in 0..128 :gen_core_lw {
                assign o_dbg_lw_cause[h * 128 + c] = core_lw_cause[c];
            }
            inst u_core: v14_heliodor_core #(
                ID_SPLIT: 1, // Block N SHIPPED: the I side has its own mem_ctrl slot
                RESET_PC    : RESET_PC,
                HART_ID     : h as 8  ,
                SMP_COHERENT: 1       , // P9.2: eviction → ROB CoRR poison
                COHERENT_IFETCH: 1    , // P9.6: coherent I-side (mem_ctrl/L2 recall) — no flush sweep
            ) (
                clk                                   ,
                rst                                   ,
                o_imem_addr       : o_imem_addr[h]    ,
                i_imem_rdata      : i_imem_rdata[h]   ,
                o_imem_ren        : o_imem_ren[h]     ,
                o_iptw_addr       : o_iptw_addr[h]    ,
                o_iptw_req        : o_iptw_req[h]     ,
                i_iptw_rdata      : i_iptw_rdata[h]   ,
                o_dmem_addr       : c_dmem_addr[h]    ,
                o_dmem_wdata      : core_wdata        ,
                i_dmem_rdata      : core_dmem_rdata[h],
                i_dmem_rdata_next : 64'd0             ,
                o_dmem_wen        : c_dmem_wen[h]     ,
                o_dmem_ren        : c_dmem_ren[h]     ,
                o_dmem_wstrb      : core_wstrb        ,
                o_dmem_wdata_hi   : c_dmem_wdata_hi[h],
                o_dmem_wstrb_hi   : c_dmem_wstrb_hi[h],
                o_dmem_req        : c_dmem_req[h]     ,
                i_dmem_grant      : ctrl_hgrant[h]    , // P9.1: mem_ctrl grant (D slot)
                o_imemr_addr      : c_imemr_addr[h]  , // Block N: I-side read channel (slot 2h+1)
                o_imemr_req       : c_imemr_req[h]   ,
                i_imemr_grant     : ctrl_hgrant[N_HARTS + h],
                i_imemr_rdata     : ctrl_hrdata[N_HARTS + h],

                o_dmemw_addr      : c_dmemw_addr[h]   ,
                o_dmemw_req       : c_dmemw_req[h]    ,
                i_dmemw_grant     : bus_wgrant[h]     ,
                o_dmemw_wb        : c_dmemw_wb[h]     , // P9.2: writeback flag
                o_dmem_rfo        : c_dmem_rfo[h]     , // P9.2: store fill = RFO
                o_dmem_iread      : c_dmem_iread[h]   , // P9.6: I-cache fill (uncounted read)
                i_dmem_fill_excl  : ctrl_hexcl[h]     , // P9.2: home grant state
                i_dcache_probe_v   : ctrl_probe_v[h]  , // P9.2: recall probe
                i_dcache_probe_addr: ctrl_probe_addr  ,
                i_dcache_probe_self: ctrl_probe_self  ,
                o_dcache_probe_ack : core_probe_ack[h],
                i_dcache_inv_valid: core_inv_valid[h] ,
                i_dcache_inv_addr : core_inv_addr[h]  ,
                i_dcache_inv2_valid: ctrl_inv2_v[h]   , // P9.2: precise-inv 2nd port
                i_dcache_inv2_addr : ctrl_inv2_addr   ,
                i_irq_timer_m     : clint_t_irq[h]    ,
                i_mtime           : clint_mtime       ,
                i_irq_sw_m        : clint_s_irq[h]    ,
                i_irq_ext_m       : plic_irq_m[h]     , // P9.5: PLIC M-ext (MEIP)
                i_irq_ext_s       : plic_irq_s[h]     , // P9.5: PLIC S-ext (SEIP)
                o_dbg_x3          : o_dbg_r3[h]        ,
                o_dbg_pc          : o_dbg_pc[h]        ,
                o_dbg_retire_v_a  : o_dbg_retire_v[h]  ,
                o_dbg_trap_fire   : o_dbg_trap_fire[h] ,
                o_dbg_trap_cause  : o_dbg_trap_cause[h],
                o_dbg_trap_pc     : o_dbg_trap_pc[h]   ,
                o_dbg_stval_out   : o_dbg_stval[h]     ,
                o_dbg_satp        : o_dbg_satp[h]      ,
                o_dbg_stvec_out   : o_dbg_stvec[h]     ,
                o_dbg_mtvec_out   : o_dbg_mtvec[h]     ,
                o_dbg_trap_to_s   : o_dbg_trap_to_s[h] ,
                o_dbg_regs        : core_regs          ,
                o_dbg_load_viol_cnt : o_dbg_load_viol_cnt[h] ,
                o_dbg_load_replay_cnt: o_dbg_load_replay_cnt[h],
                o_dbg_inv_viol_cnt  : o_dbg_inv_viol_cnt[h]  ,
                o_dbg_mshr_pois_cnt : o_dbg_mshr_pois_cnt[h] ,
                o_dbg_viol_exact_cnt: o_dbg_viol_exact_cnt[h],
                o_dbg_viol_pgx_cnt  : o_dbg_viol_pgx_cnt[h]  ,
                o_dbg_st_resolve_cnt: o_dbg_st_resolve_cnt[h],
                o_dbg_viol_store_cnt: o_dbg_viol_store_cnt[h],
                o_dbg_viol_self_cnt : o_dbg_viol_self_cnt[h] ,
                o_dbg_lw_cause      : core_lw_cause          ,
                o_dbg_load_wait_cnt : o_dbg_load_wait_cnt[h] ,
                o_dbg_rob_commit_cnt: o_dbg_rob_commit_cnt[h],
                o_dbg_dmem_fault  : o_dbg_dmem_fault[h],
                o_dbg_dtlb_hit    : o_dbg_dtlb_hit[h]  ,
                o_dbg_dtlb_ppn    : o_dbg_dtlb_ppn[h]  ,
                o_dbg_dtlb_perm   : o_dbg_dtlb_perm[h] ,
                o_dbg_dptw_addr   : o_dbg_dptw_addr[h] ,
                o_dbg_dpte        : o_dbg_dpte[h]      ,
                o_dbg_dmem_vaddr  : o_dbg_dmem_vaddr[h],
                o_dbg_redirect_fire: o_dbg_redirect_fire[h],
                o_dbg_fl_push_en  : o_dbg_fl_push_en[h] ,
                o_dbg_commit_rd   : o_dbg_commit_rd[h]  ,
                o_dbg_commit_pdst : o_dbg_commit_pdst[h],
                o_dbg_agu_rs1_arch: agu_rs1a_l           ,
                o_dbg_agu_rs1_pdst: o_dbg_agu_rs1_pdst[h],
                o_dbg_agu_is_load : o_dbg_agu_is_load[h] ,
                o_dbg_agu_addr    : o_dbg_agu_addr[h]    ,
                o_dbg_lfault_inj  : o_dbg_lfault_inj[h]  ,
                o_dbg_walk_vaddr  : o_dbg_walk_vaddr[h]  ,
                o_dbg_walk_v      : o_dbg_walk_v[h]      ,
                o_dbg_walk_rob    : o_dbg_walk_rob[h]    ,
                o_dbg_orphan_walk : o_dbg_orphan_walk[h] ,
                o_dbg_walk_phys   : o_dbg_walk_phys[h]   ,
                o_dbg_walk_start  : o_dbg_walk_start[h]  ,
                o_dbg_dmem_idle   : o_dbg_dmem_idle[h]   ,
                o_dbg_dlk_seen    : o_dbg_dlk_seen[h]    ,
                o_dbg_dlk_genuine : o_dbg_dlk_genuine[h] ,
                o_dbg_dlk_inj     : o_dbg_dlk_inj[h]     ,
                o_dbg_dlk_stval   : o_dbg_dlk_stval[h]   ,
                o_dbg_dlk_pc      : o_dbg_dlk_pc[h]      ,
                o_dbg_dlk_walkpc  : o_dbg_dlk_walkpc[h]  ,
                o_dbg_retire_pc_a : o_dbg_retire_pc[h] ,
                o_dbg_retire_rd_v_a: o_dbg_retire_rdv[h],
                o_dbg_retire_rd_a : o_dbg_retire_rd[h] ,
                o_dbg_retire_data_a: o_dbg_retire_dat[h],
            );
    
            for l in 0..soc_pkg::RET_LANES :g_ret {
                assign o_retire[h * soc_pkg::RET_LANES + l] = 0 as retire_pkg::RetireRec;
            }
            assign o_irq_evt[h]   = 0 as retire_pkg::IrqEvent;
            assign o_core_chk[h]  = 0;
            assign o_core_perf[h] = 0;
        } else {
            // The new core has no o_imem passthrough, no hi-side store carry
            // and no forensic outputs.
            var core_wdata: logic<64> [8];
            var core_wstrb: logic<8>  [8];
            for l in 0..8 :gen_core_lane {
                assign c_dmem_wdata[h * 8 + l] = core_wdata[l];
                assign c_dmem_wstrb[h * 8 + l] = core_wstrb[l];
            }
            for c in 0..128 :gen_core_lw {
                assign o_dbg_lw_cause[h * 128 + c] = 0;
            }
            assign c_dmem_wdata_hi[h] = 0;
            assign c_dmem_wstrb_hi[h] = 0;
            assign c_dmem_iread[h]    = 1'b0;
            assign o_imem_addr[h]     = 0;
            assign o_imem_ren[h]      = 1'b0;
            assign o_iptw_addr[h]     = 0;
            assign o_iptw_req[h]      = 1'b0;
            assign o_dbg_load_viol_cnt[h] = 0;
            assign o_dbg_load_replay_cnt[h] = 0;
            assign o_dbg_inv_viol_cnt[h] = 0;
            assign o_dbg_mshr_pois_cnt[h] = 0;
            assign o_dbg_viol_exact_cnt[h] = 0;
            assign o_dbg_viol_pgx_cnt[h] = 0;
            assign o_dbg_st_resolve_cnt[h] = 0;
            assign o_dbg_viol_store_cnt[h] = 0;
            assign o_dbg_viol_self_cnt[h] = 0;
            assign o_dbg_load_wait_cnt[h] = 0;
            assign o_dbg_rob_commit_cnt[h] = 0;
            assign o_dbg_r3[h] = 0;
            assign o_dbg_pc[h] = 0;
            assign o_dbg_retire_v[h] = 0;
            assign o_dbg_trap_fire[h] = 0;
            assign o_dbg_trap_cause[h] = 0;
            assign o_dbg_trap_pc[h] = 0;
            assign o_dbg_stval[h] = 0;
            assign o_dbg_satp[h] = 0;
            assign o_dbg_stvec[h] = 0;
            assign o_dbg_mtvec[h] = 0;
            assign o_dbg_trap_to_s[h] = 0;
            assign o_dbg_sp[h] = 0;
            assign o_dbg_tp[h] = 0;
            assign o_dbg_dmem_fault[h] = 0;
            assign o_dbg_dtlb_hit[h] = 0;
            assign o_dbg_dtlb_ppn[h] = 0;
            assign o_dbg_dtlb_perm[h] = 0;
            assign o_dbg_dptw_addr[h] = 0;
            assign o_dbg_dpte[h] = 0;
            assign o_dbg_dmem_vaddr[h] = 0;
            assign o_dbg_redirect_fire[h] = 0;
            assign o_dbg_fl_push_en[h] = 0;
            assign o_dbg_commit_rd[h] = 0;
            assign o_dbg_commit_pdst[h] = 0;
            assign o_dbg_agu_rs1_arch[h] = 0;
            assign o_dbg_agu_rs1_pdst[h] = 0;
            assign o_dbg_agu_rs1_archval[h] = 0;
            assign o_dbg_agu_is_load[h] = 0;
            assign o_dbg_agu_addr[h] = 0;
            assign o_dbg_lfault_inj[h] = 0;
            assign o_dbg_walk_vaddr[h] = 0;
            assign o_dbg_walk_v[h] = 0;
            assign o_dbg_walk_rob[h] = 0;
            assign o_dbg_orphan_walk[h] = 0;
            assign o_dbg_walk_phys[h] = 0;
            assign o_dbg_walk_start[h] = 0;
            assign o_dbg_dmem_idle[h] = 0;
            assign o_dbg_dlk_seen[h] = 0;
            assign o_dbg_dlk_genuine[h] = 0;
            assign o_dbg_dlk_inj[h] = 0;
            assign o_dbg_dlk_stval[h] = 0;
            assign o_dbg_dlk_pc[h] = 0;
            assign o_dbg_dlk_walkpc[h] = 0;
            assign o_dbg_retire_pc[h] = 0;
            assign o_dbg_retire_rdv[h] = 0;
            assign o_dbg_retire_rd[h] = 0;
            assign o_dbg_retire_dat[h] = 0;
            if CORE == soc_pkg::CoreSel::W2 :g_w2 {
                var ret: retire_pkg::RetireRec          [cfg_w2::COMMIT_W];
                var chk: core_types::<cfg_w2>::CoreChk                 ;
                var perf: core_types::<cfg_w2>::CorePerf               ;
                inst u_core: heliodor_core_w2 #(
                    PMA_N      : PMA_N      ,
                    PMA_REGIONS: PMA_REGIONS,
                ) (
                    clk                                            ,
                    rst                                            ,
                    i_hart_id            : h as 8                  ,
                    i_reset_pc           : RESET_PC                ,
                    o_dmem_addr          : c_dmem_addr[h]          ,
                    o_dmem_ren           : c_dmem_ren[h]           ,
                    o_dmem_req           : c_dmem_req[h]           ,
                    o_dmem_rfo           : c_dmem_rfo[h]           ,
                    o_dmem_dram          : c_dmem_line[h]          ,
                    i_dmem_grant         : ctrl_hgrant[h]          ,
                    i_dmem_rdata         : core_dmem_rdata[h]      ,
                    i_dmem_fill_excl     : ctrl_hexcl[h]           ,
                    o_imemr_addr         : c_imemr_addr[h]         ,
                    o_imemr_req          : c_imemr_req[h]          ,
                    o_imemr_dram         : c_imemr_line[h]         ,
                    o_imemr_iread        : c_imemr_iread[h]        ,
                    i_imemr_grant        : ctrl_hgrant[N_HARTS + h],
                    i_imemr_rdata        : core_imemr_rdata[h]     ,
                    o_dmemw_addr         : c_dmemw_addr[h]         ,
                    o_dmem_wdata         : core_wdata              ,
                    o_dmem_wstrb         : core_wstrb              ,
                    o_dmem_wen           : c_dmem_wen[h]           ,
                    o_dmemw_wb           : c_dmemw_wb[h]           ,
                    o_dmemw_req          : c_dmemw_req[h]          ,
                    i_dmemw_grant        : bus_wgrant[h]           ,
                    i_probe_v            : ctrl_probe_v[h]         ,
                    i_probe_addr         : ctrl_probe_addr         ,
                    i_probe_self         : ctrl_probe_self         ,
                    o_probe_ack          : core_probe_ack[h]       ,
                    i_inv_v              : core_inv_valid[h]       ,
                    i_inv_addr           : core_inv_addr[h]        ,
                    i_inv2_v             : ctrl_inv2_v[h]          ,
                    i_inv2_addr          : ctrl_inv2_addr          ,
                    i_irq_timer_m        : clint_t_irq[h]          ,
                    i_irq_sw_m           : clint_s_irq[h]          ,
                    i_irq_ext_m          : plic_irq_m[h]           ,
                    i_irq_ext_s          : plic_irq_s[h]           ,
                    i_mtime              : clint_mtime             ,
                    o_retire             : ret                     ,
                    o_irq_evt            : o_irq_evt[h]            ,
                    i_dbg_retire_limit_en: i_dbg_retire_limit_en[h]  ,
                    i_dbg_retire_limit   : i_dbg_retire_limit[h]     ,
                    i_dbg_irq_mask       : i_dbg_irq_mask[h]         ,
                    i_dbg_irq_allow      : i_dbg_irq_allow[h]        ,
                    o_perf               : perf                    ,
                    o_chk                : chk                     ,
                );
                for l in 0..soc_pkg::RET_LANES :g_ret {
                    if l <: cfg_w2::COMMIT_W :g_lane {
                        assign o_retire[h * soc_pkg::RET_LANES + l] = ret[l];
                    } else {
                        assign o_retire[h * soc_pkg::RET_LANES + l] = 0 as retire_pkg::RetireRec;
                    }
                }
                assign o_core_chk[h]  = chk as soc_pkg::CHK_W;
                assign o_core_perf[h] = perf as soc_pkg::PERF_W;
            } else {
                var ret: retire_pkg::RetireRec          [cfg_w4::COMMIT_W];
                var chk: core_types::<cfg_w4>::CoreChk                 ;
                var perf: core_types::<cfg_w4>::CorePerf               ;
                inst u_core: heliodor_core_w4 #(
                    PMA_N      : PMA_N      ,
                    PMA_REGIONS: PMA_REGIONS,
                ) (
                    clk                                            ,
                    rst                                            ,
                    i_hart_id            : h as 8                  ,
                    i_reset_pc           : RESET_PC                ,
                    o_dmem_addr          : c_dmem_addr[h]          ,
                    o_dmem_ren           : c_dmem_ren[h]           ,
                    o_dmem_req           : c_dmem_req[h]           ,
                    o_dmem_rfo           : c_dmem_rfo[h]           ,
                    o_dmem_dram          : c_dmem_line[h]          ,
                    i_dmem_grant         : ctrl_hgrant[h]          ,
                    i_dmem_rdata         : core_dmem_rdata[h]      ,
                    i_dmem_fill_excl     : ctrl_hexcl[h]           ,
                    o_imemr_addr         : c_imemr_addr[h]         ,
                    o_imemr_req          : c_imemr_req[h]          ,
                    o_imemr_dram         : c_imemr_line[h]         ,
                    o_imemr_iread        : c_imemr_iread[h]        ,
                    i_imemr_grant        : ctrl_hgrant[N_HARTS + h],
                    i_imemr_rdata        : core_imemr_rdata[h]     ,
                    o_dmemw_addr         : c_dmemw_addr[h]         ,
                    o_dmem_wdata         : core_wdata              ,
                    o_dmem_wstrb         : core_wstrb              ,
                    o_dmem_wen           : c_dmem_wen[h]           ,
                    o_dmemw_wb           : c_dmemw_wb[h]           ,
                    o_dmemw_req          : c_dmemw_req[h]          ,
                    i_dmemw_grant        : bus_wgrant[h]           ,
                    i_probe_v            : ctrl_probe_v[h]         ,
                    i_probe_addr         : ctrl_probe_addr         ,
                    i_probe_self         : ctrl_probe_self         ,
                    o_probe_ack          : core_probe_ack[h]       ,
                    i_inv_v              : core_inv_valid[h]       ,
                    i_inv_addr           : core_inv_addr[h]        ,
                    i_inv2_v             : ctrl_inv2_v[h]          ,
                    i_inv2_addr          : ctrl_inv2_addr          ,
                    i_irq_timer_m        : clint_t_irq[h]          ,
                    i_irq_sw_m           : clint_s_irq[h]          ,
                    i_irq_ext_m          : plic_irq_m[h]           ,
                    i_irq_ext_s          : plic_irq_s[h]           ,
                    i_mtime              : clint_mtime             ,
                    o_retire             : ret                     ,
                    o_irq_evt            : o_irq_evt[h]            ,
                    i_dbg_retire_limit_en: i_dbg_retire_limit_en[h]  ,
                    i_dbg_retire_limit   : i_dbg_retire_limit[h]     ,
                    i_dbg_irq_mask       : i_dbg_irq_mask[h]         ,
                    i_dbg_irq_allow      : i_dbg_irq_allow[h]        ,
                    o_perf               : perf                    ,
                    o_chk                : chk                     ,
                );
                for l in 0..soc_pkg::RET_LANES :g_ret {
                    if l <: cfg_w4::COMMIT_W :g_lane {
                        assign o_retire[h * soc_pkg::RET_LANES + l] = ret[l];
                    } else {
                        assign o_retire[h * soc_pkg::RET_LANES + l] = 0 as retire_pkg::RetireRec;
                    }
                }
                assign o_core_chk[h]  = chk as soc_pkg::CHK_W;
                assign o_core_perf[h] = perf as soc_pkg::PERF_W;
            }
        }
    }
}
