// Phase 7 v4: Register Alias Table (speculative + architectural).
//
// Two RATs coexist:
//   rat_spec — updated at rename (speculative)
//   rat_arch — updated at ROB commit (architectural, the source of truth
//              for misprediction/trap recovery)
//
// Reset: identity rat_spec[r] = rat_arch[r] = r (PRF 0..31). arch r0
// stays mapped to PRF 0 forever; rename never replaces it.
//
// Recovery: on `i_recovery_fire` (commit-time misprediction or trap)
// copy rat_arch into rat_spec single-cycle. M6 will upgrade to branch
// checkpoint restore for faster mispredict recovery.
pub module rat #(
    param PRF_W    : u32 = 6 ,
    param ARCH_N   : u32 = 32,
    param ROB_DEPTH: u32 = 32, // Phase 8 S8: per-branch checkpoint slots
    param ROB_IDX_W: u32 = 5 ,
) (
    clk: input clock,
    rst: input reset,

    // rat_spec read ports (rename source operands + rd old-pdst capture)
    i_rs1_arch   : input  logic<5>    ,
    o_rs1_pdst   : output logic<PRF_W>,
    i_rs2_arch   : input  logic<5>    ,
    o_rs2_pdst   : output logic<PRF_W>,
    i_rd_arch    : input  logic<5>    ,
    o_rd_old_pdst: output logic<PRF_W>,

    // Phase 8 S2: slot-1 (younger op of the rename bundle) read ports. The core
    // combinationally bypasses slot-0's just-popped pdst into these when slot-0
    // renames an arch reg that slot-1 reads (intra-bundle RAW/WAW); the RAT
    // itself returns the raw rat_spec value.
    i_rs1_arch2   : input  logic<5>    ,
    o_rs1_pdst2   : output logic<PRF_W>,
    i_rs2_arch2   : input  logic<5>    ,
    o_rs2_pdst2   : output logic<PRF_W>,
    i_rd_arch2    : input  logic<5>    ,
    o_rd_old_pdst2: output logic<PRF_W>,

    // rat_spec write (rename time)
    i_rename_en  : input logic       ,
    i_rename_arch: input logic<5>    ,
    i_rename_pdst: input logic<PRF_W>,
    // Phase 8 S2: slot-1 rename write (younger; ordered AFTER slot-0 so an
    // intra-bundle same-rd WAW leaves the slot-1 mapping).
    i_rename_en2  : input logic       ,
    i_rename_arch2: input logic<5>    ,
    i_rename_pdst2: input logic<PRF_W>,

    // rat_arch write (commit time) — port 0 (slot-0) + port 1 (slot-1, Phase 8
    // S1 2-wide commit). Slot-1 is younger; for a same-arch-reg WAW it must win.
    i_commit_en  : input logic       ,
    i_commit_arch: input logic<5>    ,
    i_commit_pdst: input logic<PRF_W>,
    i_commit_en2  : input logic       ,
    i_commit_arch2: input logic<5>    ,
    i_commit_pdst2: input logic<PRF_W>,

    // Recovery: copy rat_arch → rat_spec (commit-time mispredict/trap)
    i_recovery_fire: input logic,

    // Phase 8 S8: per-branch rat_spec checkpoint for EARLY (execute-time) branch
    // redirect (the branch-checkpoint restore anticipated in the header). At a
    // control op's rename, snapshot the speculative map AS OF that op (slot-0 op →
    // after slot-0's rename write; slot-1 op → after both writes), packed into the
    // op's rob_idx slot. On its later mispredict-restore, rat_spec is reloaded from
    // that snapshot in ONE cycle — exact rollback to the branch with no ROB walk.
    // The commit-time rat_arch→rat_spec path is unchanged. Restore is gated OFF by
    // the core (i_restore_en=0) until S8.E.
    i_ckpt0_en  : input logic           , // slot-0 op is a checkpointed control op
    i_ckpt0_idx : input logic<ROB_IDX_W>,
    i_ckpt1_en  : input logic           , // slot-1 op is a checkpointed control op
    i_ckpt1_idx : input logic<ROB_IDX_W>,
    i_restore_en : input logic          ,
    i_restore_idx: input logic<ROB_IDX_W>,
) {
    var rat_spec: logic<PRF_W> [ARCH_N];
    var rat_arch: logic<PRF_W> [ARCH_N];
    // Phase 8 S8: per-branch packed rat_spec checkpoints (one slot per ROB entry).
    // Packed (ARCH_N*PRF_W bits) so capture is a SINGLE whole-element dynamic-index
    // write — the rob/free_list-proven pattern — sidestepping the rat_spec
    // dynamic-index-write sim issue that forced the static ladder below.
    var rat_ckpt: logic<ARCH_N * PRF_W> [ROB_DEPTH];
    // Per-slot post-rename map (combinational): post0 = + slot-0 write, post1 =
    // + slot-0 then slot-1 (younger wins a same-rd WAW), then packed for capture.
    var post0    : logic<PRF_W>          [ARCH_N];
    var post1    : logic<PRF_W>          [ARCH_N];
    var post0_pak: logic<ARCH_N * PRF_W>        ;
    var post1_pak: logic<ARCH_N * PRF_W>        ;
    always_comb {
        for r in 0..ARCH_N {
            post0[r] = rat_spec[r];
            post1[r] = rat_spec[r];
        }
        if i_rename_en {
            for r in 1..ARCH_N {
                if i_rename_arch == (r as 5) {
                    post0[r] = i_rename_pdst;
                    post1[r] = i_rename_pdst;
                }
            }
        }
        if i_rename_en2 {
            for r in 1..ARCH_N {
                if i_rename_arch2 == (r as 5) {
                    post1[r] = i_rename_pdst2;
                }
            }
        }
        for r in 0..ARCH_N {
            post0_pak[r * PRF_W +: PRF_W] = post0[r];
            post1_pak[r * PRF_W +: PRF_W] = post1[r];
        }
    }
    let restore_map: logic<ARCH_N * PRF_W> = rat_ckpt[i_restore_idx];

    assign o_rs1_pdst    = rat_spec[i_rs1_arch];
    assign o_rs2_pdst    = rat_spec[i_rs2_arch];
    assign o_rd_old_pdst = rat_spec[i_rd_arch];
    // Phase 8 S2: slot-1 raw reads (core applies the intra-bundle bypass).
    assign o_rs1_pdst2    = rat_spec[i_rs1_arch2];
    assign o_rs2_pdst2    = rat_spec[i_rs2_arch2];
    assign o_rd_old_pdst2 = rat_spec[i_rd_arch2];

    always_ff (clk, rst) {
        if_reset {
            for i in 0..ARCH_N {
                rat_spec[i] = i as PRF_W;
                rat_arch[i] = i as PRF_W;
            }
            for j in 0..ROB_DEPTH {
                rat_ckpt[j] = 0;
            }
        } else {
            // Phase 8 S8: capture per-branch rat_spec snapshots (per slot). Two
            // distinct rob_idx slots → at most two whole-element dynamic writes.
            if i_ckpt0_en {
                rat_ckpt[i_ckpt0_idx] = post0_pak;
            }
            if i_ckpt1_en {
                rat_ckpt[i_ckpt1_idx] = post1_pak;
            }
            // rat_spec update: early-restore (S8, gated off until S8.E) >
            // commit-time recovery > rename writes.
            if i_restore_en {
                for r in 0..ARCH_N {
                    rat_spec[r] = restore_map[r * PRF_W +: PRF_W];
                }
            } else if i_recovery_fire {
                for i in 0..ARCH_N {
                    rat_spec[i] = rat_arch[i];
                }
            } else {
                if i_rename_en {
                    // Static-index ladder to avoid dynamic-index array WRITE
                    // (Veryl sim bug for dynamic ranges across renames).
                    // r=0 skipped — arch zero never renamed.
                    for r in 1..ARCH_N {
                        if i_rename_arch == (r as 5) {
                            rat_spec[r] = i_rename_pdst;
                        }
                    }
                }
                // Phase 8 S2: slot-1 rename write, ordered AFTER slot-0 so an
                // intra-bundle same-rd WAW leaves the younger (slot-1) mapping
                // (last-assign-wins). Gated off (i_rename_en2=0) until S4.
                if i_rename_en2 {
                    for r in 1..ARCH_N {
                        if i_rename_arch2 == (r as 5) {
                            rat_spec[r] = i_rename_pdst2;
                        }
                    }
                }
            }
            if i_commit_en {
                for r in 1..ARCH_N {
                    if i_commit_arch == (r as 5) {
                        rat_arch[r] = i_commit_pdst;
                    }
                }
            }
            // Phase 8 S1: slot-1 commit write, ordered AFTER slot-0 so a
            // same-arch-reg WAW (both commit slots write the same rd) leaves the
            // younger (slot-1) mapping — last-assign-wins.
            if i_commit_en2 {
                for r in 1..ARCH_N {
                    if i_commit_arch2 == (r as 5) {
                        rat_arch[r] = i_commit_pdst2;
                    }
                }
            }
        }
    }
}
