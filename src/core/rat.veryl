// Register Alias Table: 32-entry mapping from architectural register to ROB index.
// Entry valid=1 means the latest value for this register is in the ROB (not yet committed).
// Used to detect data dependencies and enable register renaming.
pub module rat (
    clk: input clock,
    rst: input reset,

    // Rename: map architectural register to ROB entry (called at ID stage)
    i_rename_valid: input logic    ,
    i_rename_rd   : input logic<5> , // destination register
    i_rename_idx  : input logic<3> , // ROB index holding the result

    // Commit: clear mapping when ROB commits (called at commit)
    // Only clears if the committed mapping is still the current one
    // (a newer instruction may have remapped the same register).
    i_commit_valid: input logic    ,
    i_commit_rd   : input logic<5> , // committed register
    i_commit_idx  : input logic<3> , // committed ROB index

    // Lookup: read current mapping for rs1/rs2 (combinational)
    i_rs1_addr    : input  logic<5> ,
    o_rs1_valid   : output logic    , // 1 = value in ROB, 0 = value in regfile
    o_rs1_rob_idx : output logic<3> , // ROB index (valid when o_rs1_valid=1)

    i_rs2_addr    : input  logic<5> ,
    o_rs2_valid   : output logic    ,
    o_rs2_rob_idx : output logic<3> ,

    // Additional lookup ports (for bubble fill independence check)
    i_rs3_addr    : input  logic<5> ,
    o_rs3_valid   : output logic    ,
    i_rs4_addr    : input  logic<5> ,
    o_rs4_valid   : output logic    ,

    // ID-stage lookup ports (for RS operand resolution at dispatch)
    i_id_rs1_addr    : input  logic<5> ,
    o_id_rs1_valid   : output logic    ,
    o_id_rs1_rob_idx : output logic<3> ,
    i_id_rs2_addr    : input  logic<5> ,
    o_id_rs2_valid   : output logic    ,
    o_id_rs2_rob_idx : output logic<3> ,

    // Flush: clear all mappings (on trap/mret/sret)
    i_flush: input logic,

    // Misprediction undo: restore the last overwritten rename.
    // On misprediction, one wrong-path instruction may have been renamed.
    // This undoes that rename, restoring the previous mapping.
    i_undo: input logic,

    // Squash cleanup: clear any RAT mapping that points to a squashed ROB entry.
    // The squash_mask[i]=1 means ROB entry i was squashed (invalidated).
    i_squash_valid: input logic      ,
    i_squash_mask : input logic   [8],

    // Undo buffer outputs: previous mapping that was overwritten by last rename.
    // Used by RS dispatch for self-reference resolution (rd == rs).
    o_undo_valid  : output logic    ,
    o_undo_rob_idx: output logic<3> ,
) {
    // RAT storage: 32 entries (one per architectural register)
    var valid  : logic    [32];
    var rob_idx: logic<3> [32];

    // Undo buffer: saves the entry overwritten by the last rename
    var undo_rd   : logic<5>;
    var undo_valid: logic;
    var undo_rob  : logic<3>;

    assign o_undo_valid   = undo_valid;
    assign o_undo_rob_idx = undo_rob;

    // x0 is always in regfile (never renamed)
    // Lookup: combinational read
    assign o_rs1_valid   = if i_rs1_addr == 5'd0 ? 1'b0 : valid[i_rs1_addr];
    assign o_rs1_rob_idx = rob_idx[i_rs1_addr];

    assign o_rs2_valid   = if i_rs2_addr == 5'd0 ? 1'b0 : valid[i_rs2_addr];
    assign o_rs2_rob_idx = rob_idx[i_rs2_addr];

    assign o_rs3_valid   = if i_rs3_addr == 5'd0 ? 1'b0 : valid[i_rs3_addr];
    assign o_rs4_valid   = if i_rs4_addr == 5'd0 ? 1'b0 : valid[i_rs4_addr];

    // ID-stage lookup: combinational read for RS operand resolution
    assign o_id_rs1_valid   = if i_id_rs1_addr == 5'd0 ? 1'b0 : valid[i_id_rs1_addr];
    assign o_id_rs1_rob_idx = rob_idx[i_id_rs1_addr];
    assign o_id_rs2_valid   = if i_id_rs2_addr == 5'd0 ? 1'b0 : valid[i_id_rs2_addr];
    assign o_id_rs2_rob_idx = rob_idx[i_id_rs2_addr];

    always_ff (clk, rst) {
        if_reset {
            for i: i32 in 0..32 {
                valid[i] = 1'b0;
            }
        } else if i_flush {
            for i: i32 in 0..32 {
                valid[i] = 1'b0;
            }
        } else if i_undo {
            // Misprediction recovery:
            // 1. Undo the wrong-path instruction's rename
            if undo_rd != 5'd0 {
                valid[undo_rd]   = undo_valid;
                rob_idx[undo_rd] = undo_rob;
            }
            // 2. Clear any RAT mapping pointing to squashed ROB entries.
            //    After squash, these entries will be reallocated for new instructions.
            //    Stale mappings would cause deadlocks.
            if i_squash_valid {
                for i: i32 in 0..32 {
                    if valid[i] && i_squash_mask[rob_idx[i]] {
                        valid[i] = 1'b0;
                    }
                }
            }
            // 3. Commit still needs to proceed during undo cycle
            if i_commit_valid && i_commit_rd != 5'd0
            && valid[i_commit_rd] && rob_idx[i_commit_rd] == i_commit_idx {
                valid[i_commit_rd] = 1'b0;
            }
        } else {
            // Commit: clear mapping if this is still the current mapping.
            // A newer instruction may have remapped the same register,
            // in which case we must NOT clear (the newer mapping is live).
            if i_commit_valid && i_commit_rd != 5'd0
            && valid[i_commit_rd] && rob_idx[i_commit_rd] == i_commit_idx {
                valid[i_commit_rd] = 1'b0;
            }

            // Rename: set new mapping (higher priority than commit —
            // if same register is committed and renamed in the same cycle,
            // the rename wins because it's the newer instruction).
            if i_rename_valid && i_rename_rd != 5'd0 {
                // Save old entry to undo buffer before overwriting
                undo_rd    = i_rename_rd;
                undo_valid = valid[i_rename_rd];
                undo_rob   = rob_idx[i_rename_rd];
                // Apply rename
                valid[i_rename_rd]   = 1'b1;
                rob_idx[i_rename_rd] = i_rename_idx;
            }
        }
    }
}
