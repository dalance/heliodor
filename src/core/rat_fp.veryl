// Phase 7 v4: Register Alias Table for the FP register file.
//
// Mirrors rat with two differences:
//   1. A 3rd read port (rs3) for the FMADD-family third operand.
//   2. f0 IS a renameable register — the rename and commit ladders
//      include r=0 (the integer rat skips r0 because x0 is the
//      hardwired arch zero; no such tie exists for the FP file).
//
// Two RATs: rat_spec (rename) + rat_arch (commit). Recovery copies
// rat_arch → rat_spec single-cycle, identical to rat.
pub module rat_fp #(
    param PRF_W    : u32 = 6 ,
    param ARCH_N   : u32 = 32,
    param ROB_DEPTH: u32 = 32, // Phase 8 S8: per-branch checkpoint slots
    param ROB_IDX_W: u32 = 5 ,
) (
    clk: input clock,
    rst: input reset,

    // rat_spec read ports (rename source operands + rd old-pdst capture)
    i_rs1_arch   : input  logic<5>    ,
    o_rs1_pdst   : output logic<PRF_W>,
    i_rs2_arch   : input  logic<5>    ,
    o_rs2_pdst   : output logic<PRF_W>,
    i_rs3_arch   : input  logic<5>    ,
    o_rs3_pdst   : output logic<PRF_W>,
    i_rd_arch    : input  logic<5>    ,
    o_rd_old_pdst: output logic<PRF_W>,

    // rat_spec write (rename time)
    i_rename_en  : input logic       ,
    i_rename_arch: input logic<5>    ,
    i_rename_pdst: input logic<PRF_W>,

    // rat_arch write (commit time)
    i_commit_en  : input logic       ,
    i_commit_arch: input logic<5>    ,
    i_commit_pdst: input logic<PRF_W>,

    // Recovery: copy rat_arch → rat_spec (commit-time mispredict/trap)
    i_recovery_fire: input logic,

    // Phase 8 S8: per-branch FP rat_spec checkpoint for EARLY branch redirect.
    // FP rename is slot-0 only (the 2-wide rename is integer-only), so the FP map
    // as-of a branch is rat_spec with the single slot-0 FP write applied —
    // identical for a slot-0 or slot-1 branch (no FP write is younger than a
    // bundled branch). Both capture ports store that one snapshot at their own
    // rob_idx. Restore is gated OFF (i_restore_en=0) until S8.E.
    i_ckpt0_en  : input logic           ,
    i_ckpt0_idx : input logic<ROB_IDX_W>,
    i_ckpt1_en  : input logic           ,
    i_ckpt1_idx : input logic<ROB_IDX_W>,
    i_restore_en : input logic          ,
    i_restore_idx: input logic<ROB_IDX_W>,
) {
    var rat_spec: logic<PRF_W> [ARCH_N];
    var rat_arch: logic<PRF_W> [ARCH_N];
    // Phase 8 S8: packed per-branch FP map checkpoints (one slot per ROB entry).
    var rat_ckpt: logic<ARCH_N * PRF_W> [ROB_DEPTH];
    var post_fp    : logic<PRF_W>          [ARCH_N];
    var post_fp_pak: logic<ARCH_N * PRF_W>        ;
    always_comb {
        for r in 0..ARCH_N {
            post_fp[r] = rat_spec[r];
        }
        if i_rename_en {
            for r in 0..ARCH_N {
                if i_rename_arch == (r as 5) {
                    post_fp[r] = i_rename_pdst;
                }
            }
        }
        for r in 0..ARCH_N {
            post_fp_pak[r * PRF_W +: PRF_W] = post_fp[r];
        }
    }
    let restore_map: logic<ARCH_N * PRF_W> = rat_ckpt[i_restore_idx];

    assign o_rs1_pdst    = rat_spec[i_rs1_arch];
    assign o_rs2_pdst    = rat_spec[i_rs2_arch];
    assign o_rs3_pdst    = rat_spec[i_rs3_arch];
    assign o_rd_old_pdst = rat_spec[i_rd_arch];

    always_ff (clk, rst) {
        if_reset {
            for i in 0..ARCH_N {
                rat_spec[i] = i as PRF_W;
                rat_arch[i] = i as PRF_W;
            }
            for j in 0..ROB_DEPTH {
                rat_ckpt[j] = 0;
            }
        } else {
            // Phase 8 S8: capture per-branch FP map snapshots (both slots store the
            // same post-slot-0-rename map at their own rob_idx).
            if i_ckpt0_en {
                rat_ckpt[i_ckpt0_idx] = post_fp_pak;
            }
            if i_ckpt1_en {
                rat_ckpt[i_ckpt1_idx] = post_fp_pak;
            }
            if i_restore_en {
                for r in 0..ARCH_N {
                    rat_spec[r] = restore_map[r * PRF_W +: PRF_W];
                }
            } else if i_recovery_fire {
                for i in 0..ARCH_N {
                    rat_spec[i] = rat_arch[i];
                }
            } else if i_rename_en {
                // Static-index ladder; r=0 INCLUDED (f0 renameable).
                for r in 0..ARCH_N {
                    if i_rename_arch == (r as 5) {
                        rat_spec[r] = i_rename_pdst;
                    }
                }
            }
            if i_commit_en {
                for r in 0..ARCH_N {
                    if i_commit_arch == (r as 5) {
                        rat_arch[r] = i_commit_pdst;
                    }
                }
            }
        }
    }
}
