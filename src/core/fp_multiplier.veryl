// IEEE 754 double-precision floating-point multiplier
// Handles normals, subnormals, zeros, infinities, NaNs.
// PIPE: 0 = combinational (legacy, byte-identical); 1 = 2-stage (result valid N+1).
// The datapath is cut after the 53x53 product (stage 1) / before normalize+round
// (stage 2); PIPE=0 bypasses the midpoint register → identical combinational result.
pub module fp_multiplier #(
    param PIPE: u32 = 0,
) (
    clk     : input  clock     ,
    rst     : input  reset     ,
    i_a     : input  logic<64>,
    i_b     : input  logic<64>,
    i_rm    : input  logic<3> , // rounding mode
    o_result: output logic<64>,
    o_fflags: output logic<5> , // {NV, DZ, OF, UF, NX}
) {
    import fpu_pkg::*;

    // Overflow result per rounding mode (IEEE/RISC-V): RNE/RMM -> inf,
    // RTZ -> max normal, RDN -> +max/-inf, RUP -> +inf/-max.
    function ovf_d (
        rm : input logic<3>,
        sgn: input logic   ,
    ) -> logic<64> {
        var r  : logic<64>;
        let inf: logic<64> = {sgn, 11'h7FF, 52'd0};
        let mx : logic<64> = {sgn, 11'h7FE, 52'hFFFFFFFFFFFFF};
        case rm {
            3'b001 : r = mx;
            3'b010 : r = if sgn ? inf : mx;
            3'b011 : r = if sgn ? mx : inf;
            default: r = inf;
        }
        return r;
    }

    function round_up_fn (
        rm : input logic<3>,
        sgn: input logic   ,
        g  : input logic   ,
        rr : input logic   ,
        ss : input logic   ,
        ll : input logic   ,
    ) -> logic {
        var ru: logic;
        case rm {
            3'b000 : ru = g && (rr || ss || ll);
            3'b001 : ru = 1'b0;
            3'b010 : ru = sgn && (g || rr || ss);
            3'b011 : ru = !sgn && (g || rr || ss);
            3'b100 : ru = g;
            default: ru = g && (rr || ss || ll);
        }
        return ru;
    }

    // ===== Stage 1: unpack / classify / special-case resolve / 53x53 multiply =====
    var s1_done: logic     ; // result fully resolved here (special case)
    var s1_res : logic<64> ; // resolved result (valid when s1_done)
    var s1_ffl : logic<5>  ; // resolved fflags (valid when s1_done)
    var s1_prod: logic<106>; // 106-bit product (normal path)
    var s1_esum: logic<13> ; // ea_eff + eb_eff (normal path)
    var s1_sign: logic     ; // result sign
    always_comb {
        // Extract fields
        var sa: logic    ;
        var ea: logic<11>;
        var ma: logic<52>;
        var sb: logic    ;
        var eb: logic<11>;
        var mb: logic<52>;

        sa = i_a[63];
        ea = i_a[62:52];
        ma = i_a[51:0];
        sb = i_b[63];
        eb = i_b[62:52];
        mb = i_b[51:0];

        // Result sign
        var r_sign: logic;
        r_sign = sa ^ sb;

        // Classify
        var a_is_zero: logic;
        var b_is_zero: logic;
        var a_is_inf : logic;
        var b_is_inf : logic;
        var a_is_nan : logic;
        var b_is_nan : logic;
        var a_is_snan: logic;
        var b_is_snan: logic;
        var a_is_sub : logic;
        var b_is_sub : logic;

        a_is_zero = ea == 11'd0 && ma == 52'd0;
        b_is_zero = eb == 11'd0 && mb == 52'd0;
        a_is_inf  = ea == 11'h7FF && ma == 52'd0;
        b_is_inf  = eb == 11'h7FF && mb == 52'd0;
        a_is_nan  = ea == 11'h7FF && ma != 52'd0;
        b_is_nan  = eb == 11'h7FF && mb != 52'd0;
        a_is_snan = a_is_nan && ma[51] == 1'b0;
        b_is_snan = b_is_nan && mb[51] == 1'b0;
        a_is_sub  = ea == 11'd0 && ma != 52'd0;
        b_is_sub  = eb == 11'd0 && mb != 52'd0;

        // Effective exponents (subnormals have biased exp = 1)
        var ea_eff: logic<13>;
        var eb_eff: logic<13>;
        if a_is_sub {
            ea_eff = 13'd1;
        } else {
            ea_eff = {2'd0, ea};
        }
        if b_is_sub {
            eb_eff = 13'd1;
        } else {
            eb_eff = {2'd0, eb};
        }

        // Significands with implicit bit (53 bits)
        var sig_a: logic<53>;
        var sig_b: logic<53>;
        if a_is_sub {
            sig_a = {1'b0, ma};
        } else {
            sig_a = {1'b1, ma};
        }
        if b_is_sub {
            sig_b = {1'b0, mb};
        } else {
            sig_b = {1'b1, mb};
        }

        // 53x53 → 106-bit product via 26/27-bit partial products
        var aH: logic<64>;
        var aL: logic<64>;
        var bH: logic<64>;
        var bL: logic<64>;
        aH = {37'd0, sig_a[52:26]};
        aL = {38'd0, sig_a[25:0]};
        bH = {37'd0, sig_b[52:26]};
        bL = {38'd0, sig_b[25:0]};

        var pp_ll: logic<64>;
        var pp_lh: logic<64>;
        var pp_hl: logic<64>;
        var pp_hh: logic<64>;
        pp_ll = aL * bL;
        pp_lh = aL * bH;
        pp_hl = aH * bL;
        pp_hh = aH * bH;

        var mid_sum: logic<64>;
        mid_sum = pp_lh + pp_hl;

        var mid_carry: logic;
        mid_carry = mid_sum <: pp_lh; // unsigned overflow

        var mid_lo: logic<64>;
        mid_lo = {38'd0, pp_ll[51:26]} + {38'd0, mid_sum[25:0]};

        var lower_carry: logic;
        lower_carry = mid_lo[26];

        var upper: logic<64>;
        upper = pp_hh + {37'd0, mid_sum[63:26]} + {63'd0, mid_carry} + {63'd0, lower_carry};

        // Full 106-bit product, reconstructed exactly.
        let prod106: logic<106> = {upper[53:0], mid_lo[25:0], pp_ll[25:0]};

        // Stage-1 outputs to the midpoint
        s1_prod = prod106;
        s1_esum = ea_eff + eb_eff;
        s1_sign = r_sign;
        s1_done = 1'b0;
        s1_res  = 64'd0;
        s1_ffl  = 5'd0;

        // === Special cases (resolved in stage 1) ===
        if a_is_nan || b_is_nan {
            s1_done = 1'b1;
            s1_res  = 64'h7FF8_0000_0000_0000; // canonical qNaN
            if a_is_snan || b_is_snan {
                s1_ffl = 5'b10000;
            }
        } else if a_is_inf || b_is_inf {
            s1_done = 1'b1;
            if (a_is_inf && (b_is_zero)) || (b_is_inf && (a_is_zero)) {
                // inf * 0 = NaN
                s1_res = 64'h7FF8_0000_0000_0000;
                s1_ffl = 5'b10000; // NV
            } else {
                s1_res = {r_sign, 11'h7FF, 52'd0}; // signed infinity
            }
        } else if a_is_zero || b_is_zero {
            s1_done = 1'b1;
            s1_res  = {r_sign, 63'd0}; // signed zero
        } else {
            s1_done = 1'b0; // normal/subnormal: stage 2
        }
    }

    // ===== Midpoint register (cut) + PIPE=0 bypass =====
    var s1_done_q: logic     ;
    var s1_res_q : logic<64> ;
    var s1_ffl_q : logic<5>  ;
    var s1_prod_q: logic<106>;
    var s1_esum_q: logic<13> ;
    var s1_sign_q: logic     ;
    var s1_rm_q  : logic<3>  ;
    always_ff (clk, rst) {
        if_reset {
            s1_done_q = 1'b0;
            s1_res_q  = 64'd0;
            s1_ffl_q  = 5'd0;
            s1_prod_q = 106'd0;
            s1_esum_q = 13'd0;
            s1_sign_q = 1'b0;
            s1_rm_q   = 3'd0;
        } else {
            s1_done_q = s1_done;
            s1_res_q  = s1_res;
            s1_ffl_q  = s1_ffl;
            s1_prod_q = s1_prod;
            s1_esum_q = s1_esum;
            s1_sign_q = s1_sign;
            s1_rm_q   = i_rm;
        }
    }
    let s1_done_sel: logic     = if PIPE == 1 ? s1_done_q : s1_done;
    let s1_res_sel : logic<64> = if PIPE == 1 ? s1_res_q : s1_res;
    let s1_ffl_sel : logic<5>  = if PIPE == 1 ? s1_ffl_q : s1_ffl;
    let s1_prod_sel: logic<106> = if PIPE == 1 ? s1_prod_q : s1_prod;
    let s1_esum_sel: logic<13> = if PIPE == 1 ? s1_esum_q : s1_esum;
    let s1_sign_sel: logic     = if PIPE == 1 ? s1_sign_q : s1_sign;
    let s1_rm_sel  : logic<3>  = if PIPE == 1 ? s1_rm_q : i_rm;

    // ===== Stage 2: normalize + round =====
    var result: logic<64>;
    var fflags: logic<5> ;
    always_comb {
        result = 64'd0;
        fflags = 5'd0;

        if s1_done_sel {
            result = s1_res_sel;
            fflags = s1_ffl_sel;
        } else {
            // === Normal/subnormal multiplication ===
            // Leading-one normalize so the leading 1 lands at bit 105.
            let lz106: logic<9> = clz::<106>(s1_prod_sel);
            var lead_shift: logic<7>;
            lead_shift = lz106[6:0];
            if lead_shift == 7'd106 {
                lead_shift = 7'd105;
            }
            let prod_norm: logic<106> = s1_prod_sel << lead_shift;
            // 1.0*1.0 -> prod106=2^104, lead_shift=1 -> biased 1023.
            let biased: logic<13> = s1_esum_sel - 13'd1022 - {6'd0, lead_shift};

            // 56-bit significand: [55:3]=53-bit (implicit+frac), [2:0]=G,R,S
            let nm: logic<56> = {prod_norm[105:51], prod_norm[50] | (prod_norm[49:0] != 50'd0)};

            // Unbounded rounding -> tininess (after rounding) for the UF flag.
            let ru0  : logic     = round_up_fn(s1_rm_sel, s1_sign_sel, nm[2], nm[1], nm[0], nm[3]);
            let sig0 : logic<54> = {1'b0, nm[55:3]} + {53'd0, ru0};
            let exp_u: logic<13> = biased + {12'd0, sig0[53]};
            let tiny : logic     = $signed(exp_u) <= 13'sd0;

            if $signed(biased) >= 13'sd1 {
                // normal result
                let nx    : logic = nm[2] || nm[1] || nm[0];
                var efield: logic<13>;
                var frac  : logic<52>;
                if sig0[53] == 1'b1 {
                    efield = biased + 13'd1;
                    frac   = 52'd0;
                } else {
                    efield = biased;
                    frac   = sig0[51:0];
                }
                if $signed(efield) >= 13'sd2047 {
                    result = ovf_d(s1_rm_sel, s1_sign_sel);
                    fflags = 5'b00101; // OF | NX
                } else {
                    result = {s1_sign_sel, efield[10:0], frac};
                    if nx {
                        fflags = 5'b00001;
                    }
                }
            } else {
                // subnormal result: bounded rounding for the value, `tiny` for UF
                let ss    : logic<13> = 13'd1 - biased;
                let scl   : logic<6>  = if $signed(ss) >: 13'sd56 ? 6'd56 : ss[5:0];
                let sm    : logic<56> = nm >> scl;
                let stk   : logic     = (nm & ((56'd1 << scl) - 56'd1)) != 56'd0;
                let nms   : logic<56> = {sm[55:1], sm[0] | stk};
                let nx_sub: logic     = nms[2] || nms[1] || nms[0];
                let ru1   : logic     = round_up_fn(s1_rm_sel, s1_sign_sel, nms[2], nms[1], nms[0], nms[3]);
                let sig1  : logic<54> = {1'b0, nms[55:3]} + {53'd0, ru1};
                let efield: logic<13> = {12'd0, sig1[52]};
                let frac  : logic<52> = sig1[51:0];
                result = {s1_sign_sel, efield[10:0], frac};
                if nx_sub {
                    fflags = 5'b00001;
                }
                if tiny && nx_sub {
                    fflags = 5'b00011; // UF | NX
                }
            }
        }
    }

    assign o_result = result;
    assign o_fflags = fflags;
}
