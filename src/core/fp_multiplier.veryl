// IEEE 754 double-precision floating-point multiplier
// Combinational (single-cycle). Handles normals, subnormals, zeros, infinities, NaNs.
pub module fp_multiplier (
    i_a     : input  logic<64>,
    i_b     : input  logic<64>,
    i_rm    : input  logic<3> , // rounding mode
    o_result: output logic<64>,
    o_fflags: output logic<5> , // {NV, DZ, OF, UF, NX}
) {
    import fpu_pkg::*;
    var result: logic<64>;
    var fflags: logic<5> ;

    // Overflow result per rounding mode (IEEE/RISC-V): RNE/RMM -> inf,
    // RTZ -> max normal, RDN -> +max/-inf, RUP -> +inf/-max.
    function ovf_d (
        rm : input logic<3>,
        sgn: input logic   ,
    ) -> logic<64> {
        var r  : logic<64>;
        let inf: logic<64> = {sgn, 11'h7FF, 52'd0};
        let mx : logic<64> = {sgn, 11'h7FE, 52'hFFFFFFFFFFFFF};
        case rm {
            3'b001 : r = mx;
            3'b010 : r = if sgn ? inf : mx;
            3'b011 : r = if sgn ? mx : inf;
            default: r = inf;
        }
        return r;
    }

    function round_up_fn (
        rm : input logic<3>,
        sgn: input logic   ,
        g  : input logic   ,
        rr : input logic   ,
        ss : input logic   ,
        ll : input logic   ,
    ) -> logic {
        var ru: logic;
        case rm {
            3'b000 : ru = g && (rr || ss || ll);
            3'b001 : ru = 1'b0;
            3'b010 : ru = sgn && (g || rr || ss);
            3'b011 : ru = !sgn && (g || rr || ss);
            3'b100 : ru = g;
            default: ru = g && (rr || ss || ll);
        }
        return ru;
    }

    always_comb {
        // Extract fields
        var sa: logic    ;
        var ea: logic<11>;
        var ma: logic<52>;
        var sb: logic    ;
        var eb: logic<11>;
        var mb: logic<52>;

        sa = i_a[63];
        ea = i_a[62:52];
        ma = i_a[51:0];
        sb = i_b[63];
        eb = i_b[62:52];
        mb = i_b[51:0];

        // Result sign
        var r_sign: logic;
        r_sign = sa ^ sb;

        // Classify
        var a_is_zero: logic;
        var b_is_zero: logic;
        var a_is_inf : logic;
        var b_is_inf : logic;
        var a_is_nan : logic;
        var b_is_nan : logic;
        var a_is_snan: logic;
        var b_is_snan: logic;
        var a_is_sub : logic;
        var b_is_sub : logic;

        a_is_zero = ea == 11'd0 && ma == 52'd0;
        b_is_zero = eb == 11'd0 && mb == 52'd0;
        a_is_inf  = ea == 11'h7FF && ma == 52'd0;
        b_is_inf  = eb == 11'h7FF && mb == 52'd0;
        a_is_nan  = ea == 11'h7FF && ma != 52'd0;
        b_is_nan  = eb == 11'h7FF && mb != 52'd0;
        a_is_snan = a_is_nan && ma[51] == 1'b0;
        b_is_snan = b_is_nan && mb[51] == 1'b0;
        a_is_sub  = ea == 11'd0 && ma != 52'd0;
        b_is_sub  = eb == 11'd0 && mb != 52'd0;

        result = 64'd0;
        fflags = 5'd0;

        // === Special cases ===
        if a_is_nan || b_is_nan {
            result = 64'h7FF8_0000_0000_0000; // canonical qNaN
            if a_is_snan || b_is_snan {
                fflags = 5'b10000;
            }
        } else if a_is_inf || b_is_inf {
            if (a_is_inf && (b_is_zero)) || (b_is_inf && (a_is_zero)) {
                // inf * 0 = NaN
                result = 64'h7FF8_0000_0000_0000;
                fflags = 5'b10000; // NV
            } else {
                result = {r_sign, 11'h7FF, 52'd0}; // signed infinity
            }
        } else if a_is_zero || b_is_zero {
            result = {r_sign, 63'd0}; // signed zero
        } else {
            // === Normal/subnormal multiplication ===

            // Effective exponents (subnormals have biased exp = 1)
            var ea_eff: logic<13>;
            var eb_eff: logic<13>;
            if a_is_sub {
                ea_eff = 13'd1;
            } else {
                ea_eff = {2'd0, ea};
            }
            if b_is_sub {
                eb_eff = 13'd1;
            } else {
                eb_eff = {2'd0, eb};
            }

            // Significands with implicit bit (53 bits)
            var sig_a: logic<53>;
            var sig_b: logic<53>;
            if a_is_sub {
                sig_a = {1'b0, ma};
            } else {
                sig_a = {1'b1, ma};
            }
            if b_is_sub {
                sig_b = {1'b0, mb};
            } else {
                sig_b = {1'b1, mb};
            }

            // 53x53 → 106-bit product
            // Use 64-bit partial products to compute the full 106-bit result
            // sig_a = aH(27) : aL(26)
            // sig_b = bH(27) : bL(26)
            // product = aH*bH << 52 + (aH*bL + aL*bH) << 26 + aL*bL
            var aH: logic<64>;
            var aL: logic<64>;
            var bH: logic<64>;
            var bL: logic<64>;
            aH = {37'd0, sig_a[52:26]};
            aL = {38'd0, sig_a[25:0]};
            bH = {37'd0, sig_b[52:26]};
            bL = {38'd0, sig_b[25:0]};

            var pp_ll: logic<64>;
            var pp_lh: logic<64>;
            var pp_hl: logic<64>;
            var pp_hh: logic<64>;
            pp_ll = aL * bL;
            pp_lh = aL * bH;
            pp_hl = aH * bL;
            pp_hh = aH * bH;

            // Combine: product[105:0]
            // pp_ll contributes to bits [51:0]
            // pp_lh + pp_hl contribute to bits [79:26]
            // pp_hh contributes to bits [105:52]
            // We need bits [105:50] for rounding (56 bits + sticky from [49:0])
            var mid_sum: logic<64>;
            mid_sum = pp_lh + pp_hl;

            // Carry from mid_sum addition
            var mid_carry: logic;
            mid_carry = mid_sum <: pp_lh; // unsigned overflow

            // product[51:26] = mid_lo[25:0]; the carry-out at bit 26 (mid_lo[26])
            // propagates into product[52] = upper[0].
            var mid_lo: logic<64>;
            mid_lo = {38'd0, pp_ll[51:26]} + {38'd0, mid_sum[25:0]};

            // product bits [105:52] = pp_hh + mid_sum[63:26] + carry_from_lower.
            // carry_from_lower is the bit-26 carry of the low add = mid_lo[26].
            // (The old `(pp_ll[63:26]+mid_sum[25:0]) <: pp_ll[63:26]` 64-bit
            // wraparound test was always 0 — that sum is < 2^27 and never wraps —
            // so product[52] silently dropped this carry, giving an off-by-one
            // (e.g. a wrong guard bit) in the rounded result for ~half of inputs.)
            var lower_carry: logic;
            lower_carry = mid_lo[26];

            var upper: logic<64>;
            upper = pp_hh + {37'd0, mid_sum[63:26]} + {63'd0, mid_carry} + {63'd0, lower_carry};

            // Full 106-bit product, reconstructed exactly.
            // product[105:52]=upper[53:0], [51:26]=mid_lo[25:0], [25:0]=pp_ll[25:0]
            let prod106: logic<106> = {upper[53:0], mid_lo[25:0], pp_ll[25:0]};

            // Leading-one normalize so the leading 1 lands at bit 105. Working on
            // the FULL product (not a 56-bit window) keeps the low significand
            // bits when one operand is subnormal and the leading 1 sits far below
            // bit 105 — the old prod_top[105:50] window dropped them to sticky.
            let lz106: logic<9> = clz::<106>(prod106);
            var lead_shift: logic<7>;
            lead_shift = lz106[6:0];
            if lead_shift == 7'd106 {
                lead_shift = 7'd105;
            }
            let prod_norm: logic<106> = prod106 << lead_shift;
            // 1.0*1.0 -> prod106=2^104, lead_shift=1 -> biased 1023.
            let biased: logic<13> = ea_eff + eb_eff - 13'd1022 - {6'd0, lead_shift};

            // 56-bit significand: [55:3]=53-bit (implicit+frac), [2:0]=G,R,S
            let nm: logic<56> = {prod_norm[105:51], prod_norm[50] | (prod_norm[49:0] != 50'd0)};

            // Unbounded rounding -> tininess (after rounding) for the UF flag.
            let ru0  : logic     = round_up_fn(i_rm, r_sign, nm[2], nm[1], nm[0], nm[3]);
            let sig0 : logic<54> = {1'b0, nm[55:3]} + {53'd0, ru0};
            let exp_u: logic<13> = biased + {12'd0, sig0[53]};
            let tiny : logic     = $signed(exp_u) <= 13'sd0;

            if $signed(biased) >= 13'sd1 {
                // normal result
                let nx    : logic = nm[2] || nm[1] || nm[0];
                var efield: logic<13>;
                var frac  : logic<52>;
                if sig0[53] == 1'b1 {
                    efield = biased + 13'd1;
                    frac   = 52'd0;
                } else {
                    efield = biased;
                    frac   = sig0[51:0];
                }
                if $signed(efield) >= 13'sd2047 {
                    result = ovf_d(i_rm, r_sign);
                    fflags  = 5'b00101; // OF | NX
                } else {
                    result = {r_sign, efield[10:0], frac};
                    if nx {
                        fflags = 5'b00001;
                    }
                }
            } else {
                // subnormal result: bounded rounding for the value, `tiny` for UF
                let ss    : logic<13> = 13'd1 - biased;
                let scl   : logic<6>  = if $signed(ss) >: 13'sd56 ? 6'd56 : ss[5:0];
                let sm    : logic<56> = nm >> scl;
                let stk   : logic     = (nm & ((56'd1 << scl) - 56'd1)) != 56'd0;
                let nms   : logic<56> = {sm[55:1], sm[0] | stk};
                let nx_sub: logic     = nms[2] || nms[1] || nms[0];
                let ru1   : logic     = round_up_fn(i_rm, r_sign, nms[2], nms[1], nms[0], nms[3]);
                let sig1  : logic<54> = {1'b0, nms[55:3]} + {53'd0, ru1};
                let efield: logic<13> = {12'd0, sig1[52]};
                let frac  : logic<52> = sig1[51:0];
                result = {r_sign, efield[10:0], frac};
                if nx_sub {
                    fflags = 5'b00001;
                }
                if tiny && nx_sub {
                    fflags = 5'b00011; // UF | NX
                }
            }
        }
    }

    assign o_result = result;
    assign o_fflags = fflags;
}
