// Phase 7 v4: Decode wrapper.
//
// Wraps v1 `decoder` + `imm_gen` and emits a v4-shaped DecodedOp.
// M1 only supports RV64I ALU/branch/JAL/JALR/LUI/AUIPC. Anything else
// (LOAD/STORE/CSR/AMO/FENCE/SFENCE/FP/SYS) is flagged illegal=1 so
// the ROB can take a precise trap. M3+/M4+/M5+ progressively un-illegal
// these classes.
pub module decode (
    i_pc    : input  logic                     <64>,
    i_instr : input  logic                     <32>,
    i_is_rvc: input  logic                         , // M7
    o_op    : output pipeline_pkg::DecodedOp    ,
) {
    import alu_pkg::AluOp;
    import pipeline_pkg::*;

    var alu_op    : AluOp                   ;
    var alu_src_a : decode_pkg::AluSrcA   ;
    var alu_src_b : decode_pkg::AluSrcB   ;
    var imm_type  : riscv_pkg::ImmType      ;
    var wb_sel    : decode_pkg::WbSel     ;
    var reg_wen   : logic                   ;
    var mem_ren   : logic                   ;
    var mem_wen   : logic                   ;
    var is_branch : logic                   ;
    var is_jal    : logic                   ;
    var is_jalr   : logic                   ;
    var is_ecall  : logic                   ;
    var is_ebreak : logic                   ;
    var is_mret   : logic                   ;
    var is_wfi    : logic                   ;
    var csr_op    : csr_pkg::CsrOp          ;
    var is_csr    : logic                   ;
    var csr_imm   : logic                   ;
    var d_illegal : logic                   ;
    var is_amo    : logic                   ;
    var amo_funct5: logic                <5>;
    var is_fp     : logic                   ;
    var fp_reg_wen: logic                   ;
    var fp_int_wen: logic                   ;
    var fpu_op    : fpu_pkg::FpuOp          ;
    var fp_rm     : logic                <3>;
    var fp_rs3    : logic                <5>;
    var is_sfence : logic                   ;
    var is_svinval_fence: logic             ;
    var is_fence_i: logic                   ;
    var is_fence  : logic                   ;
    var is_cbo_zero: logic                  ;
    var hlv       : logic                   ;
    var hlvx      : logic                   ;
    var is_vec         : logic              ;
    var vec_op         : vector_pkg::VecOp  ;
    var vec_uses_scalar: logic              ;
    var vec_writes_int : logic              ;

    inst u_dec: decoder (
        i_instr      : i_instr   ,
        o_alu_op     : alu_op    ,
        o_alu_src_a  : alu_src_a ,
        o_alu_src_b  : alu_src_b ,
        o_imm_type   : imm_type  ,
        o_wb_sel     : wb_sel    ,
        o_reg_wen    : reg_wen   ,
        o_mem_ren    : mem_ren   ,
        o_mem_wen    : mem_wen   ,
        o_is_branch  : is_branch ,
        o_is_jal     : is_jal    ,
        o_is_jalr    : is_jalr   ,
        o_is_ecall   : is_ecall  ,
        o_is_ebreak  : is_ebreak ,
        o_is_mret    : is_mret   ,
        o_is_wfi     : is_wfi    ,
        o_csr_op     : csr_op    ,
        o_is_csr     : is_csr    ,
        o_csr_imm    : csr_imm   ,
        o_illegal    : d_illegal ,
        o_is_amo     : is_amo    ,
        o_amo_funct5 : amo_funct5,
        o_is_fp      : is_fp     ,
        o_fp_reg_wen : fp_reg_wen,
        o_fp_int_wen : fp_int_wen,
        o_fpu_op     : fpu_op    ,
        o_fp_rm      : fp_rm     ,
        o_fp_rs3_addr: fp_rs3    ,
        o_is_sfence  : is_sfence ,
        o_is_svinval_fence: is_svinval_fence,
        o_is_fence_i : is_fence_i,
        o_is_fence   : is_fence  ,
        o_is_cbo_zero: is_cbo_zero,
        o_hlv        : hlv       ,
        o_hlvx       : hlvx      ,
        o_is_vec         : is_vec         ,
        o_vec_op         : vec_op         ,
        o_vec_uses_scalar: vec_uses_scalar,
        o_vec_writes_int : vec_writes_int ,
    );

    var imm: logic<64>;
    inst u_imm: imm_gen ( i_instr: i_instr, i_imm_type: imm_type, o_imm: imm );

    let rd : logic<5> = i_instr[11:7];
    let rs1: logic<5> = i_instr[19:15];
    let rs2: logic<5> = i_instr[24:20];

    // M4 promotes CSR / ECALL / EBREAK / MRET. WFI / SFENCE / FENCE
    // are no-ops (treat as supported but commit does nothing extra).
    // M5.A promotes A-extension (is_amo path). FP still illegal.
    // M6.B.3: all FP is handled now — OP-FP/FMADD via the FPU (M6.B.2) and
    // FLW/FLD/FSW/FSD via the LSU (M6.B.3). (FS=Off→illegal trap is deferred
    // to M6.B.4; the FP datapath assumes mstatus.FS is enabled.)
    let m5_supported: logic = !d_illegal;

    let funct3: logic<3> = i_instr[14:12];

    var br_cond: BrCond;
    always_comb {
        case funct3 {
            3'b000 : br_cond = BrCond::BEQ;
            3'b001 : br_cond = BrCond::BNE;
            3'b100 : br_cond = BrCond::BLT;
            3'b101 : br_cond = BrCond::BGE;
            3'b110 : br_cond = BrCond::BLTU;
            3'b111 : br_cond = BrCond::BGEU;
            default: br_cond = BrCond::NONE;
        }
    }

    // M6: FP operand/destination classification.
    //   fp_is_fpu  = OP-FP / FMADD op → routes to the FPU/iq_fp (not load/store)
    //   fp_int_src_c = the op reads integer rs1 (INT→FP: FMV.W/D.X, FCVT.{S,D}.int)
    //   fp_rd_rs2_c  = reads FP rs2; fp_rd_rs3_c = reads FP rs3 (FMADD family)
    let fp_is_fpu: logic = is_fp && !mem_ren && !mem_wen;

    // Phase 11-H HLV/HSV synthesise a normal load/store funct3 from the H-format
    // fields: size = funct7[2:1] (inst[27:26]: 00=B,01=H,10=W,11=D) maps to
    // mem_funct3[1:0]; the unsigned bit (mem_funct3[2]) comes from rs2[0]
    // (inst[20]) on loads — HLV.BU/.HU/.WU and HLVX.*U set it, signed HLV.* clear
    // it. Stores (HSV) don't use the sign bit. Only consulted when hlv.
    let hlv_funct3: logic<3> = {mem_ren & i_instr[20], i_instr[27:26]};

    // P10 Zfa FLI loads a constant selected by the rs1 *field* (an immediate
    // index, not a register). It reads NO source register, so it must be
    // excluded from fp_rs1_is_fp below — otherwise iq_fp would wait on a phantom
    // FP rs1 operand that is never produced.
    let fp_is_fli: logic = fpu_op == fpu_pkg::FpuOp::FLI_S || fpu_op == fpu_pkg::FpuOp::FLI_D;

    var fp_int_src_c: logic;
    var fp_rd_rs2_c : logic;
    var fp_rd_rs3_c : logic;
    always_comb {
        case fpu_op {
            fpu_pkg::FpuOp::FMV_W_X, fpu_pkg::FpuOp::FMV_D_X, fpu_pkg::FpuOp::FCVT_S_W, fpu_pkg::FpuOp::FCVT_S_WU, fpu_pkg::FpuOp::FCVT_S_L, fpu_pkg::FpuOp::FCVT_S_LU, fpu_pkg::FpuOp::FCVT_D_W, fpu_pkg::FpuOp::FCVT_D_WU, fpu_pkg::FpuOp::FCVT_D_L, fpu_pkg::FpuOp::FCVT_D_LU, fpu_pkg::FpuOp::FMV_H_X: {
                fp_int_src_c = 1'b1;
            }
            default: fp_int_src_c = 1'b0;
        }
        case fpu_op {
            fpu_pkg::FpuOp::FADD_S, fpu_pkg::FpuOp::FADD_D, fpu_pkg::FpuOp::FSUB_S, fpu_pkg::FpuOp::FSUB_D, fpu_pkg::FpuOp::FMUL_S, fpu_pkg::FpuOp::FMUL_D, fpu_pkg::FpuOp::FDIV_S, fpu_pkg::FpuOp::FDIV_D, fpu_pkg::FpuOp::FSGNJ_S, fpu_pkg::FpuOp::FSGNJN_S, fpu_pkg::FpuOp::FSGNJX_S, fpu_pkg::FpuOp::FSGNJ_D, fpu_pkg::FpuOp::FSGNJN_D, fpu_pkg::FpuOp::FSGNJX_D, fpu_pkg::FpuOp::FMIN_S, fpu_pkg::FpuOp::FMAX_S, fpu_pkg::FpuOp::FMIN_D, fpu_pkg::FpuOp::FMAX_D, fpu_pkg::FpuOp::FEQ_S, fpu_pkg::FpuOp::FLT_S, fpu_pkg::FpuOp::FLE_S, fpu_pkg::FpuOp::FEQ_D, fpu_pkg::FpuOp::FLT_D, fpu_pkg::FpuOp::FLE_D, fpu_pkg::FpuOp::FMADD_S, fpu_pkg::FpuOp::FMSUB_S, fpu_pkg::FpuOp::FNMADD_S, fpu_pkg::FpuOp::FNMSUB_S, fpu_pkg::FpuOp::FMADD_D, fpu_pkg::FpuOp::FMSUB_D, fpu_pkg::FpuOp::FNMADD_D, fpu_pkg::FpuOp::FNMSUB_D, fpu_pkg::FpuOp::FMINM_S, fpu_pkg::FpuOp::FMAXM_S, fpu_pkg::FpuOp::FMINM_D, fpu_pkg::FpuOp::FMAXM_D, fpu_pkg::FpuOp::FLEQ_S, fpu_pkg::FpuOp::FLTQ_S, fpu_pkg::FpuOp::FLEQ_D, fpu_pkg::FpuOp::FLTQ_D: {
                fp_rd_rs2_c = 1'b1;
            }
            default: fp_rd_rs2_c = 1'b0;
        }
        case fpu_op {
            fpu_pkg::FpuOp::FMADD_S, fpu_pkg::FpuOp::FMSUB_S, fpu_pkg::FpuOp::FNMADD_S, fpu_pkg::FpuOp::FNMSUB_S, fpu_pkg::FpuOp::FMADD_D, fpu_pkg::FpuOp::FMSUB_D, fpu_pkg::FpuOp::FNMADD_D, fpu_pkg::FpuOp::FNMSUB_D: {
                fp_rd_rs3_c = 1'b1;
            }
            default: fp_rd_rs3_c = 1'b0;
        }
    }

    var op: DecodedOp;
    always_comb {
        op.valid    = 1'b1;
        op.pc       = i_pc;
        op.instr    = i_instr;
        op.alu_op   = alu_op;
        op.rd_arch  = rd;
        op.rs1_arch = rs1;
        op.rs2_arch = rs2;
        // Zacas amocas.q (funct5=00101, funct3=100): 128-bit pair CAS. Handled as
        // a serializing op whose register operands (rd:rd+1 compare, rs2:rs2+1
        // new) are read from the architectural register file at commit, so it
        // needs neither a renamed integer rd (has_rd=0; both halves are written
        // in place at commit + flush) nor an IQ rs2 source (has_rs2=0). It still
        // loads at execute (mem_ren) and stores at commit (is_amo).
        let is_cas_q: logic = is_amo && amo_funct5 == 5'b00101 && funct3 == 3'b100;
        op.is_cas_q = is_cas_q;
        // LOAD: has_rd=true (target reg). STORE: has_rd=false. CSR rd
        // honored by reg_wen and rd!=0.
        // AMO writes rd (reg_wen=1) even though mem_wen may be set;
        // exempt is_amo from the !mem_wen disqualifier.
        op.has_rd = reg_wen && rd != 5'd0 && (!mem_wen || is_amo) && !is_cas_q;
        // LOAD/STORE need rs1 (base address). CSR rs1: only for the
        // non-immediate variant (csrrw / csrrs / csrrc). AMO needs rs1
        // (address) — covered by mem_ren / mem_wen.
        // Vector ops never read an integer rs1 except where vec_uses_scalar marks
        // it (vadd.vx / vset*vl AVL); the rs1 field is otherwise a vector reg (vs1)
        // and must NOT create an integer source dependency.
        op.has_rs1 = if is_vec ? vec_uses_scalar
            : ((alu_src_a == decode_pkg::AluSrcA::REG) || is_branch || is_jalr || mem_ren || mem_wen
            || (is_csr && !csr_imm));
        // STORE needs rs2 (data); LOAD/CSR don't. AMO* and SC need rs2
        // (data operand). LR does NOT need rs2.
        let is_lr        : logic = is_amo && amo_funct5 == 5'b00010;
        // P10 cbo.zero has no rs2 (the rs2 field is part of its funct12) and a
        // zero address offset (it acts on the block at rs1 exactly).
        // Vector ops have no integer rs2 source (the rs2 field is a vector reg vs2).
        op.has_rs2    = if is_vec ? 1'b0
            : (((alu_src_b == decode_pkg::AluSrcB::REG) || is_branch || mem_wen || (is_amo && !is_lr)) && !is_cbo_zero && !is_cas_q);
        // Phase 11-H HLV/HSV: the address IS rs1 (no immediate); the funct7/rs2
        // fields that occupy the I/S-immediate bits are opcode, not an offset.
        op.imm        = if is_cbo_zero || hlv ? 64'd0 : imm;
        op.use_imm_b  = alu_src_b == decode_pkg::AluSrcB::IMM;
        op.use_pc_a   = alu_src_a == decode_pkg::AluSrcA::PC;
        op.use_zero_a = alu_src_a == decode_pkg::AluSrcA::ZERO;
        op.is_branch  = is_branch;
        op.is_jal     = is_jal;
        op.is_jalr    = is_jalr;
        op.br_cond    = br_cond;
        op.wb_pc4     = wb_sel == decode_pkg::WbSel::PC4;
        op.is_load    = mem_ren;
        // For AMO/SC, suppress is_store in DecodedOp: alu_wrap uses a
        // dedicated amo_commit_store gate so SC failure path doesn't
        // commit a STORE. Plain STORE (mem_wen with !is_amo) untouched.
        op.is_store   = mem_wen && !is_amo;
        op.mem_funct3 = if hlv ? hlv_funct3 : funct3;
        // Phase 11-H HLV/HLVX/HSV markers (drive the dmem MMU's per-op two-stage
        // translation + the HLVX execute-permission read). 0 for ordinary ops.
        op.hlv        = hlv;
        op.hlvx       = hlvx;
        // M4 CSR + trap
        op.is_csr    = is_csr;
        op.csr_op    = csr_op;
        op.csr_imm   = csr_imm;
        op.csr_addr  = i_instr[31:20];
        op.is_ecall  = is_ecall;
        op.is_ebreak = is_ebreak;
        // M5.D: v1 decoder fires is_mret for both MRET (12'h302) and
        // SRET (12'h102). Split them here based on the funct12 field.
        op.is_mret   = is_mret && (i_instr[31:20] == 12'h302);
        op.is_sret   = is_mret && (i_instr[31:20] == 12'h102);
        op.is_sfence = is_sfence;
        op.is_svinval_fence = is_svinval_fence;
        // M8.A: FENCE.I — flush icache at commit (commit-time so prior stores
        // have already updated memory before the icache refills).
        op.is_fence_i = is_fence_i;
        // S15: plain FENCE — carried to the ROB as a load-ordering barrier
        // (younger loads must not issue past it once loads speculate past
        // stores; see the rob block-gate scan).
        op.is_fence   = is_fence;
        // P10 Zicboz cbo.zero — store-class block-zero (see DecodedOp note).
        op.is_cbo_zero = is_cbo_zero;
        // M5.A AMO
        op.is_amo     = is_amo;
        op.amo_funct5 = amo_funct5;
        op.amo_is_w   = funct3 == 3'b010; // .W vs .D
        // M7: tag RVC-origin so alu_wrap uses pc+2 for the link register
        op.is_rvc = i_is_rvc;
        // CSR has_rd: csrrs/csrrc with rs1=x0 ("csrr" pseudo) still
        // writes rd. csrrw with rd=x0 doesn't write. Above general rule
        // op.has_rd = reg_wen && rd != 0 already handles this since v1
        // decoder sets reg_wen=1 for CSR ops with rd != 0.
        // M6: FP fields. is_fp still flows into op.illegal via m5_supported
        // until the core wires the FP datapath (un-illegaled per class in M6.B).
        op.is_fp         = is_fp;
        op.is_fpu_op     = fp_is_fpu;
        op.fpu_op        = fpu_op;
        op.fp_rm         = fp_rm;
        op.rs3_arch      = fp_rs3;
        op.fp_writes_fp  = fp_reg_wen;
        op.fp_writes_int = fp_int_wen;
        op.fp_rs1_is_fp  = fp_is_fpu && !fp_int_src_c && !fp_is_fli;
        op.fp_rs2_is_fp  = fp_is_fpu && fp_rd_rs2_c;
        op.fp_uses_rs3   = fp_is_fpu && fp_rd_rs3_c;
        op.fp_int_src    = fp_is_fpu && fp_int_src_c;
        op.fp_ld         = is_fp && mem_ren;
        op.fp_st         = is_fp && mem_wen;
        // Phase 12 V0: vector (OP-V) fields.
        op.is_vec          = is_vec;
        op.vec_op          = vec_op;
        op.vec_uses_scalar = vec_uses_scalar;
        op.vec_writes_int  = vec_writes_int;
        op.illegal = d_illegal || !m5_supported;
        if is_branch || is_jal || is_jalr {
            op.fu_kind = FuKind::BRANCH;
        } else if is_amo {
            op.fu_kind = FuKind::AMO;
        } else if mem_ren || mem_wen {
            op.fu_kind = FuKind::AGU;
        } else if is_csr {
            op.fu_kind = FuKind::CSR;
        } else {
            op.fu_kind = FuKind::ALU;
        }
    }

    assign o_op = op;
}
