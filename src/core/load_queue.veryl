// Load Queue: 8-entry FIFO for tracking in-flight loads.
//
// Loads are allocated at dispatch (rob_idx, dest_rd, funct3, is_fp known).
// Address is provided once EX computes it (addr_update). The entry issues
// a dcache read when its address is ready and no older store-buffer entry
// aliases the address. The result is either returned via store-to-load
// forwarding (from store_buffer) or from dcache, and broadcast on CDB at
// completion.
//
// E1-a (skeleton): no OoO issue ordering yet. Just a FIFO that tracks
// allocation, addr-ready, and retirement. Later phases will add the full
// issue/completion path.
pub module load_queue (
    clk: input clock,
    rst: input reset,

    // ----- Allocate (from RS dispatch or ID) -----
    i_alloc_valid  : input  logic    ,
    i_alloc_rob    : input  logic<5> ,
    i_alloc_epoch  : input  logic<2> ,
    i_alloc_rd     : input  logic<5> ,
    i_alloc_funct3 : input  logic<3> , // size + signedness
    i_alloc_is_fp  : input  logic    , // FP load (NaN-box for FLW)
    i_alloc_pc     : input  logic<64>, // load PC (for re-inject at Stage 2)
    // P3.2 Stage 1: rs1 tracking for OoO load issue. When a load is
    // dispatched with an unresolved rs1, the caller sets s1_ready=0 and
    // supplies the producer's rob/epoch via s1_tag/s1_epoch. LQ captures
    // the value when the matching CDB broadcasts. Legacy callers that
    // supply a fully-resolved address pass s1_ready=1 + s1_data=addr +
    // imm=0 (or stay on the i_addr_* path — see below).
    i_alloc_s1_ready: input  logic    ,
    i_alloc_s1_tag  : input  logic<5> ,
    i_alloc_s1_epoch: input  logic<2> ,
    i_alloc_s1_data : input  logic<64>,
    i_alloc_imm     : input  logic<64>,
    // `i_alloc_pending` marks the alloc as "ID-stage, pending execution"
    // rather than "EX/MEM-stage capture of completed dcache access". The
    // former is re-injected later; the latter is data-ready at alloc.
    i_alloc_pending : input  logic    ,
    o_alloc_ready  : output logic    ,
    o_alloc_idx    : output logic<3> , // LQ index assigned to this load

    // ----- Address update (from EX) -----
    i_addr_valid: input logic    ,
    i_addr_idx  : input logic<3> ,
    i_addr_addr : input logic<64>,

    // ----- Issue (to dcache) -----
    // Oldest addr-ready entry with no SB alias issues to the dcache.
    o_issue_valid : output logic    ,
    o_issue_addr  : output logic<64>,
    o_issue_funct3: output logic<3> ,
    o_issue_is_fp : output logic    , // FP load (NaN-box for FLW on dcache return)
    o_issue_rob   : output logic<5> ,
    o_issue_idx   : output logic<3> ,
    i_issue_ready : input  logic    ,

    // ----- Complete (dcache result returned) -----
    i_complete_valid: input logic    ,
    i_complete_idx  : input logic<3> ,
    i_complete_data : input logic<64>,
    // ----- MSHR fill completion (second independent port) -----
    // Fires when a dcache miss completes via MSHR and the original
    // miss was captured into an LQ entry (`mshr_was_lq` at absorb).
    // Can co-occur with i_complete_* for a different load's hit.
    i_mshr_fill_valid: input logic    ,
    i_mshr_fill_idx  : input logic<3> ,
    i_mshr_fill_data : input logic<64>,

    // ----- Retire (CDB broadcast + free) -----
    o_retire_valid: output logic    ,
    o_retire_rob  : output logic<5> ,
    o_retire_epoch: output logic<2> ,
    o_retire_rd   : output logic<5> ,
    o_retire_data : output logic<64>,
    o_retire_is_fp: output logic    ,

    // ----- Squash (misprediction) -----
    i_squash_valid: input logic    ,
    i_squash_mask : input logic [32],

    // ----- Flush (trap) -----
    i_flush: input logic,

    // ----- Re-inject (Stage 2) -----
    // When an ID-stage pending alloc has its s1 resolved and no earlier
    // pending entry is re-injecting, emit the load back into the EX
    // pipeline. EX computes addr via s1_data + imm (like SRS), MMU
    // translates, MEM accesses dcache, and i_complete_* returns data.
    o_reinject_valid : output logic    ,
    o_reinject_pc    : output logic<64>,
    o_reinject_rob   : output logic<5> ,
    o_reinject_epoch : output logic<2> ,
    o_reinject_rd    : output logic<5> ,
    o_reinject_funct3: output logic<3> ,
    o_reinject_is_fp : output logic    ,
    o_reinject_s1    : output logic<64>,
    o_reinject_imm   : output logic<64>,
    o_reinject_idx   : output logic<3> ,
    i_reinject_fire  : input  logic    , // EX consumed the re-inject this cycle

    // ----- CDB (Stage 1 scaffold) -----
    // For pending-rs1 loads: wake when a matching producer broadcasts.
    // Currently captured in parallel with RS/SRS from the same CDB
    // signals; behavior change comes in Stage 2 when pending-rs1 loads
    // actually allocate here instead of stalling ID.
    i_cdb0_valid: input logic    ,
    i_cdb0_rob  : input logic<5> ,
    i_cdb0_epoch: input logic<2> ,
    i_cdb0_data : input logic<64>,
    i_cdb1_valid: input logic    ,
    i_cdb1_rob  : input logic<5> ,
    i_cdb1_epoch: input logic<2> ,
    i_cdb1_data : input logic<64>,
    i_cdb2_valid: input logic    ,
    i_cdb2_rob  : input logic<5> ,
    i_cdb2_epoch: input logic<2> ,
    i_cdb2_data : input logic<64>,

    // ----- Alias probe (P3.4 speculation replay) -----
    // Given a resolved store VA, find any LQ entry whose addr matches
    // (±1 8B line). On hit, return the entry's rob_idx + epoch so the
    // caller can decide whether the hit load is younger than the store
    // and trigger a squash.
    i_probe_valid  : input  logic    ,
    i_probe_addr   : input  logic<64>,
    o_probe_hit    : output logic    ,
    o_probe_hit_rob: output logic<5> ,
    o_probe_hit_epoch: output logic<2>,

    // ----- Debug -----
    o_count: output logic<4>,
    o_full : output logic   ,
    o_empty: output logic   ,
) {
    // ============================================================
    // Entry storage (8 entries)
    // ============================================================
    var valid     : logic    [8];
    var addr_ready: logic    [8];
    var data_ready: logic    [8];
    var e_rob     : logic<5> [8];
    var e_epoch   : logic<2> [8];
    var e_rd      : logic<5> [8];
    var e_funct3  : logic<3> [8];
    var e_is_fp   : logic    [8];
    var e_addr    : logic<64>[8];
    var e_data    : logic<64>[8];
    // P3.2 Stage 1 scaffold: rs1 tracking for future pending-dispatch loads.
    // Today every alloc supplies s1_ready=1 + s1_data=addr + imm=0, so the
    // existing `e_addr` / `addr_ready` path is unchanged. Stage 2 will
    // add pending-rs1 alloc where s1_data captures CDB and addr is computed
    // when s1 resolves.
    var s1_ready  : logic    [8];
    var s1_tag    : logic<5> [8];
    var s1_epoch  : logic<2> [8];
    var s1_data   : logic<64>[8];
    var e_imm     : logic<64>[8];
    var e_pc      : logic<64>[8];
    // `pending[i]=1` → entry was alloc'd at ID and awaits re-inject.
    // `reissued[i]=1` → entry was re-injected and awaits dcache return.
    // `data_ready[i]=1` (set by i_complete_*) → ready to retire.
    var pending   : logic    [8];
    var reissued  : logic    [8];

    // Circular FIFO head (oldest) / tail (next alloc)
    var head: logic<4>;
    var tail: logic<4>;

    let count_sub: logic<4> = tail - head;
    assign o_count = count_sub;
    assign o_full  = count_sub == 4'd8;
    assign o_empty = count_sub == 4'd0;

    let head_idx: logic<3> = head[2:0];
    let tail_idx: logic<3> = tail[2:0];

    assign o_alloc_ready = !o_full;
    assign o_alloc_idx   = tail_idx;

    // ============================================================
    // Issue: pick oldest addr_ready && !data_ready entry.
    // E1-a: no SB alias check (E1-b/c will add).
    // ============================================================
    var issue_found: logic   ;
    var issue_sel  : logic<3>;
    always_comb {
        issue_found = 1'b0;
        issue_sel   = 3'd0;
        // Walk from head to tail (oldest first)
        for i in 0..8 {
            // Not yet clear how to linearly order circular; use naive scan
            // and let the outer pipeline handle ordering. Good enough for
            // skeleton.
            if valid[i] && addr_ready[i] && !data_ready[i] && !issue_found {
                issue_found = 1'b1;
                issue_sel   = i[2:0];
            }
        }
    }
    assign o_issue_valid  = issue_found;
    assign o_issue_addr   = e_addr  [issue_sel];
    assign o_issue_funct3 = e_funct3[issue_sel];
    assign o_issue_is_fp  = e_is_fp [issue_sel];

    // ============================================================
    // Re-inject: oldest pending entry with s1 resolved.
    // Walks head→tail (FIFO order). Entries with `pending[i]` awaiting
    // s1 wake; once `s1_ready[i]` they can re-inject into the EX
    // pipeline. `reissued[i]` gates against double-injection while the
    // re-injected load is in flight through EX/MEM/dcache.
    // ============================================================
    var reinject_found_comb: logic   ;
    var reinject_sel_comb  : logic<3>;
    always_comb {
        reinject_found_comb = 1'b0;
        reinject_sel_comb   = 3'd0;
        for i in 0..8 {
            if valid[i] && pending[i] && !reissued[i] && s1_ready[i] && !reinject_found_comb {
                reinject_found_comb = 1'b1;
                reinject_sel_comb   = i[2:0];
            }
        }
    }
    assign o_reinject_valid  = reinject_found_comb;
    assign o_reinject_pc     = e_pc    [reinject_sel_comb];
    assign o_reinject_rob    = e_rob   [reinject_sel_comb];
    assign o_reinject_epoch  = e_epoch [reinject_sel_comb];
    assign o_reinject_rd     = e_rd    [reinject_sel_comb];
    assign o_reinject_funct3 = e_funct3[reinject_sel_comb];
    assign o_reinject_is_fp  = e_is_fp [reinject_sel_comb];
    assign o_reinject_s1     = s1_data [reinject_sel_comb];
    assign o_reinject_imm    = e_imm   [reinject_sel_comb];
    assign o_reinject_idx    = reinject_sel_comb;
    assign o_issue_rob    = e_rob   [issue_sel];
    assign o_issue_idx    = issue_sel;

    // ============================================================
    // Alias probe (±1 8B line) — pick oldest (lowest idx) match.
    // ============================================================
    var probe_hit_comb  : logic;
    var probe_rob_comb  : logic<5>;
    var probe_epoch_comb: logic<2>;
    let probe_line      : logic<61> = i_probe_addr[63:3];
    always_comb {
        probe_hit_comb   = 1'b0;
        probe_rob_comb   = 5'd0;
        probe_epoch_comb = 2'd0;
        for i in 0..8 {
            let ent_line: logic<61> = e_addr[i][63:3];
            let line_hit: logic = ent_line == probe_line
                               || ent_line + 61'd1 == probe_line
                               || probe_line + 61'd1 == ent_line;
            if i_probe_valid && valid[i] && addr_ready[i] && line_hit && !probe_hit_comb {
                probe_hit_comb   = 1'b1;
                probe_rob_comb   = e_rob[i];
                probe_epoch_comb = e_epoch[i];
            }
        }
    }
    assign o_probe_hit       = probe_hit_comb;
    assign o_probe_hit_rob   = probe_rob_comb;
    assign o_probe_hit_epoch = probe_epoch_comb;

    // ============================================================
    // Retire: oldest entry with data_ready → broadcast on CDB + free.
    // Head-skip: if head entry is !valid (squashed), advance head silently
    // without emitting a retire. Otherwise, an invalidated head would stall
    // the queue — later valid entries would never drain.
    // ============================================================
    let head_invalid  : logic = !valid[head_idx] && head != tail;
    let head_retire   : logic = valid[head_idx] && data_ready[head_idx];
    // MEM-sync removed: LQ-4.5 suppresses ROB port 1 for captured loads, so
    // port 3 is the sole completion source and must fire as soon as data is
    // ready (not gated by MEM stage position). The ROB epoch check
    // (i_complete3_epoch vs wrap_cnt[idx]) still guards against stale
    // completion if a slot was commit-recycled before port 3 fires.
    assign o_retire_valid = head_retire;
    assign o_retire_rob   = e_rob  [head_idx];
    assign o_retire_epoch = e_epoch[head_idx];
    assign o_retire_rd    = e_rd   [head_idx];
    assign o_retire_data  = e_data [head_idx];
    assign o_retire_is_fp = e_is_fp[head_idx];

    // ============================================================
    // Sequential: alloc, addr-update, complete, retire, squash, flush
    // ============================================================
    always_ff (clk, rst) {
        if_reset {
            head = 4'd0;
            tail = 4'd0;
            for i in 0..8 {
                valid[i]      = 1'b0;
                addr_ready[i] = 1'b0;
                data_ready[i] = 1'b0;
                e_rob[i]      = 5'd0;
                e_epoch[i]    = 2'd0;
                e_rd[i]       = 5'd0;
                e_funct3[i]   = 3'd0;
                e_is_fp[i]    = 1'b0;
                e_addr[i]     = 64'd0;
                e_data[i]     = 64'd0;
                s1_ready[i]   = 1'b0;
                s1_tag[i]     = 5'd0;
                s1_epoch[i]   = 2'd0;
                s1_data[i]    = 64'd0;
                e_imm[i]      = 64'd0;
                e_pc[i]       = 64'd0;
                pending[i]    = 1'b0;
                reissued[i]   = 1'b0;
            }
        } else {
            if i_flush {
                head = 4'd0;
                tail = 4'd0;
                for i in 0..8 {
                    valid[i]      = 1'b0;
                    addr_ready[i] = 1'b0;
                    data_ready[i] = 1'b0;
                    pending[i]    = 1'b0;
                    reissued[i]   = 1'b0;
                }
            } else {
                // Squash: invalidate entries in squash bitmap
                if i_squash_valid {
                    for i in 0..8 {
                        if valid[i] && i_squash_mask[e_rob[i]] {
                            valid[i]      = 1'b0;
                            addr_ready[i] = 1'b0;
                            data_ready[i] = 1'b0;
                            pending[i]    = 1'b0;
                            reissued[i]   = 1'b0;
                        }
                    }
                }

                // Retire head when data_ready, or skip past invalid head
                if head_retire {
                    valid     [head_idx] = 1'b0;
                    addr_ready[head_idx] = 1'b0;
                    data_ready[head_idx] = 1'b0;
                    head                 = head + 4'd1;
                } else if head_invalid {
                    head = head + 4'd1;
                }

                // Allocate at tail. Veryl always_ff uses non-blocking
                // semantics, so assignments in this block are not visible
                // to reads within the same cycle. The complete / addr_update
                // blocks below therefore can't use `valid[tail_idx]` to see
                // a just-allocated entry. Handle that case inline here.
                let do_alloc: logic = i_alloc_valid && !o_full;
                if do_alloc {
                    valid     [tail_idx] = 1'b1;
                    addr_ready[tail_idx] = 1'b0;
                    data_ready[tail_idx] = 1'b0;
                    e_rob     [tail_idx] = i_alloc_rob;
                    e_epoch   [tail_idx] = i_alloc_epoch;
                    e_rd      [tail_idx] = i_alloc_rd;
                    e_funct3  [tail_idx] = i_alloc_funct3;
                    e_is_fp   [tail_idx] = i_alloc_is_fp;
                    e_pc      [tail_idx] = i_alloc_pc;
                    pending   [tail_idx] = i_alloc_pending;
                    reissued  [tail_idx] = 1'b0;
                    // P3.2 Stage 1: capture rs1 state + imm at alloc. Same-cycle
                    // CDB bypass matches the RS/SRS convention: if a matching
                    // CDB is live this cycle, latch its data and mark ready.
                    let alloc_s1_cdb0: logic = i_cdb0_valid && i_alloc_s1_tag == i_cdb0_rob && i_alloc_s1_epoch == i_cdb0_epoch;
                    let alloc_s1_cdb1: logic = i_cdb1_valid && i_alloc_s1_tag == i_cdb1_rob && i_alloc_s1_epoch == i_cdb1_epoch;
                    let alloc_s1_cdb2: logic = i_cdb2_valid && i_alloc_s1_tag == i_cdb2_rob && i_alloc_s1_epoch == i_cdb2_epoch;
                    s1_ready  [tail_idx] = i_alloc_s1_ready || alloc_s1_cdb0 || alloc_s1_cdb1 || alloc_s1_cdb2;
                    s1_data   [tail_idx] = if i_alloc_s1_ready  ? i_alloc_s1_data
                                          : if alloc_s1_cdb0 ? i_cdb0_data
                                          : if alloc_s1_cdb1 ? i_cdb1_data
                                          : if alloc_s1_cdb2 ? i_cdb2_data
                                          : 64'd0;
                    s1_tag    [tail_idx] = i_alloc_s1_tag;
                    s1_epoch  [tail_idx] = i_alloc_s1_epoch;
                    e_imm     [tail_idx] = i_alloc_imm;
                    // Same-cycle complete targeting the just-alloc'd entry
                    if i_complete_valid && i_complete_idx == tail_idx {
                        e_data    [tail_idx] = i_complete_data;
                        data_ready[tail_idx] = 1'b1;
                    }
                    // Same-cycle addr_update targeting the just-alloc'd entry
                    if i_addr_valid && i_addr_idx == tail_idx {
                        e_addr    [tail_idx] = i_addr_addr;
                        addr_ready[tail_idx] = 1'b1;
                    }
                    tail = tail + 4'd1;
                }

                // Re-inject consumption: when EX accepts the re-inject, mark
                // the entry as issued so it doesn't re-fire. addr_ready is
                // also set since s1_data + e_imm is now effectively computed
                // (memory.veryl receives the VA for MMU translation).
                if i_reinject_fire && reinject_found_comb {
                    reissued  [reinject_sel_comb] = 1'b1;
                    addr_ready[reinject_sel_comb] = 1'b1;
                    e_addr    [reinject_sel_comb] = s1_data[reinject_sel_comb] + e_imm[reinject_sel_comb];
                }

                // Completion targeting an already-valid (pre-alloc) entry.
                // When i_complete_idx == tail_idx and do_alloc is firing,
                // the inline branch above handles it.
                if i_complete_valid && valid[i_complete_idx] && !(do_alloc && i_complete_idx == tail_idx) {
                    e_data    [i_complete_idx] = i_complete_data;
                    data_ready[i_complete_idx] = 1'b1;
                }

                // MSHR fill completion — independent of i_complete_* so a
                // dcache miss can fill on the same cycle that a new hit
                // is alloc'd + completed via the primary port.
                // MSHR fills target an ALREADY-valid entry from an earlier
                // miss-alloc (c2), so alloc collisions at tail_idx cannot
                // occur in practice — the entry isn't freed until retire.
                if i_mshr_fill_valid && valid[i_mshr_fill_idx] {
                    e_data    [i_mshr_fill_idx] = i_mshr_fill_data;
                    data_ready[i_mshr_fill_idx] = 1'b1;
                }

                // Address update targeting an already-valid entry.
                if i_addr_valid && valid[i_addr_idx] && !(do_alloc && i_addr_idx == tail_idx) {
                    e_addr    [i_addr_idx] = i_addr_addr;
                    addr_ready[i_addr_idx] = 1'b1;
                }

                // P3.2 Stage 1: CDB wakeup for pending-rs1 entries. Walks all
                // valid entries (skipping the one just alloc'd, whose initial
                // s1 was handled inline above) and captures a matching CDB.
                for i in 0..8 {
                    if valid[i] && !s1_ready[i] && !(do_alloc && tail_idx == i[2:0]) {
                        if i_cdb0_valid && s1_tag[i] == i_cdb0_rob && s1_epoch[i] == i_cdb0_epoch {
                            s1_ready[i] = 1'b1;
                            s1_data [i] = i_cdb0_data;
                        } else if i_cdb1_valid && s1_tag[i] == i_cdb1_rob && s1_epoch[i] == i_cdb1_epoch {
                            s1_ready[i] = 1'b1;
                            s1_data [i] = i_cdb1_data;
                        } else if i_cdb2_valid && s1_tag[i] == i_cdb2_rob && s1_epoch[i] == i_cdb2_epoch {
                            s1_ready[i] = 1'b1;
                            s1_data [i] = i_cdb2_data;
                        }
                    }
                }
            }
        }
    }
}
