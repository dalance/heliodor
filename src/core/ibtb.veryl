// Phase 8 S18: indirect-target buffer (iBTB).
//
// The BTB stores ONE target per PC, so a multi-target indirect jump (a
// switch jump table `jr a5`, an ops-table call `jalr ra, a5`) mispredicts
// every time the target changes — the S18 probe showed 22% of the N=1 boot's
// execute-time mispredicts are non-return JALRs, dominated by a handful of
// jump-table sites. The iBTB hashes global branch history into the index
// (same gshare index the BHT uses), so each (PC, path) pair gets its own
// target slot. Returns stay on the RAS; the BTB keeps providing the
// "this PC is an indirect op" kind bit (is_ind) and the fallback target.
//
// Trained at commit on every non-return JALR (last-target per (PC, path));
// wrong-path ops never train. A stale or aliased entry is not a correctness
// problem — commit recomputes the architectural next PC and redirects.
pub module ibtb #(
    param IDX_W: u32 = 9 , // log2(#entries): 9 -> 512
    param TAG_W: u32 = 16, // PC tag bits (pc[TAG_W:1])
) (
    clk: input clock,
    rst: input reset,

    // Lookup (combinational). i_index is the fetch-time gshare index slice
    // (pc ^ speculative GHR) computed in the core; i_pc supplies the tag.
    i_index : input  logic<IDX_W>,
    i_pc    : input  logic<64>   ,
    o_hit   : output logic       ,
    o_target: output logic<64>   ,

    // 2nd lookup port (slot-1 PC of a 2-wide fetch bundle).
    i_index2 : input  logic<IDX_W>,
    i_pc2    : input  logic<64>   ,
    o_hit2   : output logic       ,
    o_target2: output logic<64>   ,

    // Train (commit): a non-return JALR retired with this resolved target.
    // i_train_index is the op's fetch-time gshare index slice (carried
    // through the ROB as pred_index, same as BHT training).
    i_train_en    : input logic       ,
    i_train_index : input logic<IDX_W>,
    i_train_pc    : input logic<64>   ,
    i_train_target: input logic<64>   ,
) {
    const ENTRIES: u32 = 1 << IDX_W;

    var valid : logic        [ENTRIES];
    var tag   : logic<TAG_W> [ENTRIES];
    var target: logic<64>    [ENTRIES];

    let lk_tag: logic<TAG_W> = i_pc[TAG_W:1];
    assign o_hit    = valid[i_index] && tag[i_index] == lk_tag;
    assign o_target = target[i_index];

    let lk_tag2: logic<TAG_W> = i_pc2[TAG_W:1];
    assign o_hit2    = valid[i_index2] && tag[i_index2] == lk_tag2;
    assign o_target2 = target[i_index2];

    let tr_tag: logic<TAG_W> = i_train_pc[TAG_W:1];
    always_ff (clk, rst) {
        if_reset {
            // Only valid needs reset — it gates every lookup (`o_hit = valid &&
            // tag==`). tag/target are left un-reset to infer as SRAM; unwritten
            // garbage is masked by valid=0, so behavior is unchanged.
            for i in 0..ENTRIES {
                valid[i] = 1'b0;
            }
        } else {
            if i_train_en {
                valid[i_train_index]  = 1'b1;
                tag[i_train_index]    = tr_tag;
                target[i_train_index] = i_train_target;
            }
        }
    }
}
