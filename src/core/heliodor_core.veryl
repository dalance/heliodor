// Phase 7 v4: Heliodor OoO core (M1 wiring).
//
// 1-wide pure Tomasulo: F → D+R → IQ → ALU → C. Backing modules:
//   prf_int       : 64-entry physical register file (2R/1W)
//   free_list     : 32-entry PRF tag pool (1 pop + 1 push / cycle)
//   rat        : speculative + architectural rename map
//   rob        : 32-entry reorder buffer (in-order commit gate)
//   iq_int     : 8-entry integer issue queue
//   alu_wrap   : v1 alu + branch evaluator → CDB
//   decode    : v1 decoder + imm_gen → DecodedOp
//
// Pipeline:
//   F  : fetch instr from imem at pc_q → IF/ID reg
//   DR : decode + rename + ROB.alloc + IQ.alloc (combinational from
//        IF/ID reg; back-pressure stalls F when full)
//   IE : iq_int.issue → alu_wrap → CDB (same cycle).
//        CDB writes prf_int, snoops IQ wakeup, marks ROB.result_written.
//   C  : ROB.commit when head.result_written → arch RAT update + free
//        list push + retire stream output. Mispredict triggers redirect
//        next cycle (flush ROB+IQ, recover RAT, set pc_q to redirect_pc).
//
// M1 only supports RV64I ALU/branch/JAL/JALR/LUI/AUIPC; illegal ops
// raise a precise trap stub (redirect to RESET_PC) — M4 replaces this
// with the csr trap path. LOAD/STORE/CSR/AMO/FP are deferred.
pub module heliodor_core #(
    param RESET_PC: u64 = 64'h80000000,
    param HART_ID : u8  = 0           , // M9: mhartid (for SMP); 0 for single-hart
    // P9.2: SET TO 1 IN MULTI-HART SoCs. Feeds the dcache's local
    // line-departure events into the ROB's CoRR poison scan — required for
    // RVWMO read coherence under PRECISE invalidation (a remote write to a
    // line that already left this L1 is invisible here). Single-hart
    // configurations leave it 0: no remote writers exist, and the poison
    // replays would only cost cycles.
    param SMP_COHERENT: u8 = 0,
    // ── Block N step 3 (cp_mshr_mlp_plan.md §10.2): the instruction side uses its
    // OWN mem_ctrl transaction slot (o_imemr_*) instead of sharing the D-side read
    // port through ic_route. A PARAMETER, not a const: the bare testbenches that
    // instantiate this core directly have no mem_ctrl to give it a second slot, so
    // they keep the default 0 and the shared path. The SoCs pass 1.
    param ID_SPLIT: bit = 0,
    // P9.6: SET TO 1 IN SoCs WITH THE mem_ctrl/L2 MEMORY SYSTEM (both N=1 and
    // SMP). The instruction side (I-cache fill + I-PTW PTE read) is then
    // COHERENT — it reads through L2 with recall-on-owned, so a modified D-cache
    // line is pulled home before the fetch/walk reads it. The FENCE.I /
    // SFENCE.VMA / satp D$ flush SWEEP is then unnecessary and is dropped (the
    // I-cache i_flush + the coherent refill handle visibility on demand).
    // Leave 0 for the bare-core test harnesses, which serve o_dmem from a flat
    // combinational memory with NO recall — there the flush is what makes a
    // self-modified code page / page-table update visible to the next fetch.
    param COHERENT_IFETCH: u8 = 0,
    // PMA hole access-fault enable. With 1, a load/store/fetch to a PA outside the
    // backed map (DRAM pa[31] / CLINT 0x02 / UART 0x1 / PLIC 0x0C) raises an access
    // fault (cause 5/7/1). DEFAULT 0 because the boot/unit harnesses place firmware
    // ROM at low PAs (< 0x4000) and the smode_plic ROM at PA 0 — PAs the ACT4 arch
    // map instead leaves unbacked. The ACT4 arch harness (test_arch_common) sets it
    // to 1 so the compliance suites (PMPSm cfg_A_tor_zero, ExceptionsSv*) see the
    // hole faults; every other config keeps PMA off and is byte-for-byte unchanged.
    param PMA_FAULT: bit = 0,
) (
    clk: input clock,
    rst: input reset,

    // Instruction memory (read-only, 32-bit fetch granule)
    o_imem_addr : output logic<64>,
    i_imem_rdata: input  logic<32>,
    o_imem_ren  : output logic    ,

    // Instruction PTW memory (64-bit PTE reads for the IMMU page-table walk).
    // M8.C: a dedicated bus, split out of the dmem port (was muxed onto o_dmem).
    // Single combinational tb: i_iptw_rdata = dram[o_iptw_addr] dword. The SoC's
    // memory_bus arbitrates this as a separate per-hart port (mirrors v1).
    o_iptw_addr : output logic<64>,
    o_iptw_req  : output logic    ,
    i_iptw_rdata: input  logic<64>,

    // Data memory (M5+; M1 holds these inactive)
    // S25: the write channel carries a 64B LINE (8 dword lanes + per-lane
    // byte strobes) per transaction; a slow/MMIO store is a one-lane line
    // write at o_dmemw_addr[5:3] (the address keeps its byte offset).
    o_dmem_addr : output logic<64>    ,
    o_dmem_wdata: output logic<64> [8],
    i_dmem_rdata: input  logic<64>    ,
    // M8: combinational read of the NEXT dword (addr+8 aligned) — used
    // by alu_wrap for misaligned LD/LW/LH that span 2 dwords. Toy
    // memories drive it from the next dram slot; real caches will
    // synthesize via 2 fetches.
    i_dmem_rdata_next: input  logic<64>,
    o_dmem_wen       : output logic        ,
    o_dmem_ren       : output logic        ,
    o_dmem_wstrb     : output logic<8>  [8],
    // M8: hi-side write for misaligned STOREs that span 2 dwords.
    // Tests use this to write the carryover bytes into addr+8.
    o_dmem_wdata_hi: output logic<64>,
    o_dmem_wstrb_hi: output logic<8> ,

    // M9 SMP: dmem bus back-pressure. o_dmem_req = this hart wants the shared
    // DRAM/MMIO bus this cycle (= o_dmem_ren || o_dmem_wen). i_dmem_grant = the
    // SoC's memory_bus granted it. A LOAD/AMO-read completes (CDB + IQ ack) and
    // a STORE commits (rob_commit_ack) only when granted; otherwise the op is
    // held and re-requests. Single-hart SoCs tie i_dmem_grant high → no-op
    // (the request is asserted ungated, so the gate only affects completion).
    o_dmem_req   : output logic,
    i_dmem_grant : input  logic,
    // ── Block N step 3 (cp_mshr_mlp_plan.md §10.2): the instruction side's OWN
    // mem_ctrl transaction slot. Until now the I-cache fill and the I-side page-table
    // walker shared the D-side read port through `ic_route`, so an I-fill and a
    // D-fill were mutually exclusive (census bucket 101 = 146,647 cy at N=1). These
    // ports carry the I side when ID_SPLIT=1; at 0 they are tied off and the old
    // ic_route mux is unchanged.
    o_imemr_addr : output logic<64>,
    o_imemr_req  : output logic    ,
    i_imemr_grant: input  logic    ,
    i_imemr_rdata: input  logic<64>,

    // S23: the dcache mem side is split into a READ channel (o_dmem_addr/
    // o_dmem_ren/i_dmem_rdata + o_dmem_req/i_dmem_grant above, fills and miss
    // reads) and this WRITE channel (write-through + store drain). The write
    // data/strobe/enable keep their o_dmem_w* names; their address is now
    // o_dmemw_addr (it can differ from the read address in the same cycle).
    o_dmemw_addr : output logic<64>,
    o_dmemw_req  : output logic    ,
    i_dmemw_grant: input  logic    ,
    // P9.2: write-channel WRITEBACK flag (dirty-line writeback from the
    // dcache's buffer — the home merges it without invalidates) + the read
    // channel's READ-FOR-OWNERSHIP flag and the home's grant state.
    // Single-hart harnesses: tie i_dmem_fill_excl=1, discard the outputs.
    o_dmemw_wb      : output logic,
    o_dmem_rfo      : output logic,
    // P9.6: the read-channel request is an I-cache fill (UNCOUNTED coherent
    // read — recall-on-owned, no directory add/install). The I-cache fill
    // shares this hart's mem_ctrl read port with the D-cache (D has priority).
    o_dmem_iread    : output logic,
    i_dmem_fill_excl: input  logic,
    // P9.2: PROBE (recall) port from the home + clean ack. Tie 0 / discard
    // in single-hart harnesses.
    i_dcache_probe_v   : input  logic    ,
    i_dcache_probe_addr: input  logic<64>,
    i_dcache_probe_self: input  logic    ,
    o_dcache_probe_ack : output logic    ,

    // M9 SMP coherence: the SoC broadcasts every remote hart's granted DRAM
    // write here (filtered to exclude this hart's own write). It invalidates a
    // matching L1 dcache line AND clears this hart's LR/SC reservation if the
    // remote write hit the reserved address. Single-hart SoCs tie these to 0.
    i_dcache_inv_valid: input logic    ,
    i_dcache_inv_addr : input logic<64>,
    // P9.2: second invalidate port. Under PRECISE invalidation (L2 directory)
    // a granted remote misaligned store invalidates its lo and hi lines in
    // the same cycle — two different line addresses. Applied to the dcache
    // and all the same core-side consumers as port 1. Tie to 0 where unused.
    i_dcache_inv2_valid: input logic    ,
    i_dcache_inv2_addr : input logic<64>,
    // (P9.3: the M9.4 o_amo_inflight / i_amo_locked bus-lock ports are gone —
    // RMW atomicity is in-cache: L1 ownership + the AMO-watch commit replay.)

    // M8.C: external IRQ pins (CLINT / PLIC). Drive low if no SoC.
    i_irq_timer_m: input logic,
    // External CLINT mtime, exposed via CSR_TIME (0xC01)
    i_mtime    : input logic<64>,
    i_irq_sw_m : input logic    ,
    i_irq_ext_m: input logic    ,
    i_irq_ext_s: input logic    , // P9.5: S-mode external (SEIP) from PLIC

    // Debug / cosim observation
    o_dbg_pc            : output logic<64>     ,
    o_dbg_regs          : output logic<64> [32],
    // M9 SMP: architectural x3 exposed as a scalar so an SMP SoC can collect a
    // per-hart pass flag (hart0 x3==0xAA) without a 2D regfile array port.
    o_dbg_x3            : output logic<64>     ,
    o_dbg_retire_v_a    : output logic         ,
    o_dbg_retire_pc_a   : output logic<64>     ,
    o_dbg_retire_rd_v_a : output logic         ,
    o_dbg_retire_rd_a   : output logic<5>      ,
    o_dbg_retire_data_a : output logic<64>     ,
    o_dbg_rename_cnt    : output logic<32>     ,
    o_dbg_cdb_cnt       : output logic<32>     ,
    o_dbg_rob_size      : output logic<8>      ,
    o_dbg_if_v          : output logic         ,
    o_dbg_if_instr      : output logic<32>     ,
    o_dbg_stall_dr      : output logic         ,
    o_dbg_head_valid    : output logic         ,
    o_dbg_head_rw       : output logic         ,
    o_dbg_head_illegal  : output logic         ,
    o_dbg_rob_alloc_cnt : output logic<32>     ,
    o_dbg_rob_cdb_cnt   : output logic<32>     ,
    o_dbg_rob_commit_cnt: output logic<32>     ,
    o_dbg_rob_head      : output logic<6>      ,
    o_dbg_rob_tail      : output logic<6>      ,
    o_dbg_sepc          : output logic<64>     ,
    o_dbg_mepc          : output logic<64>     ,
    o_dbg_priv          : output logic<2>      ,
    o_dbg_trap_fire     : output logic         ,
    o_dbg_trap_pc       : output logic<64>     ,
    o_dbg_trap_cause    : output logic<64>     ,
    o_dbg_trap_to_s     : output logic         ,
    o_dbg_satp          : output logic<64>     ,
    o_dbg_imem_vaddr    : output logic<64>     ,
    o_dbg_imem_paddr    : output logic<64>     ,
    o_dbg_imem_valid    : output logic         ,
    o_dbg_imem_fault    : output logic         ,
    o_dbg_csrwr_v       : output logic         ,
    o_dbg_csrwr_addr    : output logic<12>     ,
    o_dbg_csrwr_wdata   : output logic<64>     ,
    // M9 diag: redirect observation (where does the pipeline jump to?)
    o_dbg_redirect_fire  : output logic    ,
    o_dbg_redirect_pc    : output logic<64>,
    o_dbg_redirect_src_pc: output logic<64>, // PC of the instr that caused the redirect (= c_pc at commit time)
    // Phase 8 perf counters (M0): branch mispredict / redirect / front-end idle.
    o_dbg_mispredict_cnt : output logic<32>, // committed branch mispredicts (= taken control transfers, static not-taken)
    o_dbg_redirect_cnt   : output logic<32>, // total redirect events (mispredict + trap + mret/sret + sc/satp)
    o_dbg_front_idle_cnt : output logic<32>, // cycles fetch could not deliver (icache/MMU stall or post-redirect refill bubble)
    o_dbg_early_mispredict_cnt: output logic<32>, // S8.A: execute-time control mispredicts (>= committed; wrong-path included)
    o_dbg_disp_stall_cnt : output logic<32>, // back-end back-pressure: a ready front-end instr can't rename (ROB/IQ/free-list full)
    o_dbg_mem_busy_cnt   : output logic<32>, // single memory-port occupancy (load issue / PTW walk / store drain / dcache fill)
    o_dbg_commit0_cnt    : output logic<32>, // ROB-head retire stall: cycles nothing commits (head op not finished)
    o_dbg_load_wait_cnt  : output logic<32>, // a selected load can't issue (store-ordering / dcache / PTW serialization)
    o_dbg_load_viol_cnt  : output logic<32>, // Phase 8 S9: memory-order violation events (store-resolve poisons a younger aliasing load)
    // L3 census: the replay event and the two poison sources load_viol_cnt misses.
    o_dbg_load_replay_cnt: output logic<32>, // commit-time load replays (full redirect + refetch)
    o_dbg_inv_viol_cnt   : output logic<32>, // P9.0 CoRR remote-invalidate poisons
    o_dbg_mshr_pois_cnt  : output logic<32>, // S10.3 aborted-MSHR-fill poisons
    o_dbg_viol_exact_cnt : output logic<32>, // violations a full-width compare also finds
    o_dbg_viol_pgx_cnt   : output logic<32>, // violations from the VM page-cross blanket
    o_dbg_st_resolve_cnt : output logic<32>, // store resolves (violation denominator)
    o_dbg_lw_cause       : output logic<32> [128], // L4 + W1 rename-width + W2 front-end + W2b producer census: load-issue stall by sole blocker (+ lsr drill-down)
    o_dbg_viol_store_cnt : output logic<32>, // store-resolve scan events
    o_dbg_viol_self_cnt  : output logic<32>, // S15 record-time self-scan events
    // M9 diag: ALU operand observation (verify base.pc passthrough)
    o_dbg_alu_pc_out      : output logic<64>,
    o_dbg_alu_src_a_out   : output logic<64>,
    o_dbg_alu_src_b_out   : output logic<64>,
    o_dbg_alu_use_pc_a_out: output logic    ,
    o_dbg_alu_rs1_data_out: output logic<64>,
    o_dbg_alu_valid_out   : output logic    ,
    o_dbg_alu_alu_out_out : output logic<64>,
    o_dbg_alu_instr_out   : output logic<32>,
    o_dbg_alu_imm_out     : output logic<64>,
    o_dbg_stval_out       : output logic<64>,
    o_dbg_mtval_out       : output logic<64>,
    o_dbg_stvec_out       : output logic<64>, // M9 SMP debug: stvec at trap
    o_dbg_mtvec_out       : output logic<64>, // M9 SMP debug: mtvec at trap
    o_dbg_ptw_req         : output logic    ,
    o_dbg_ptw_addr        : output logic<64>,
    o_dbg_ptw_data        : output logic<64>,
    // M9 diag: LSU / dmem_mmu state for hang localization
    o_dbg_dmem_mmu_busy    : output logic    ,
    o_dbg_core_dmem_vaddr  : output logic<64>,
    o_dbg_core_dmem_wen    : output logic    ,
    o_dbg_core_dmem_ren    : output logic    ,
    o_dbg_imem_ptw_req     : output logic    ,
    o_dbg_commit_store_fire: output logic    ,
    // M9.A.292: AGU input snoop (rs1 read at IQ issue → AGU). Used to
    // localize PRF/RAT race bugs where AGU sees wrong rs1 (e.g. sp=0x1058
    // instead of architectural 0xccbd90 at c.ldsp s0,32(sp)).
    o_dbg_agu_issue_v : output logic    ,
    o_dbg_agu_rs1_arch: output logic<5> ,
    o_dbg_agu_rs1_pdst: output logic<6> ,
    o_dbg_agu_rs1_data: output logic<64>,
    o_dbg_agu_imm     : output logic<64>,
    o_dbg_agu_addr    : output logic<64>,
    o_dbg_agu_is_load : output logic    ,
    o_dbg_agu_is_store: output logic    ,
    // M9.A.293: decisive test for IQ-select-flip-vs-RAT-mismap. rob_idx of
    // the currently-selected issue entry + dmem_mmu_busy. If at the bad cy
    // the issued rob_idx != the faulting c.ldsp ROB entry while busy was high
    // the prior cycle, the select-flip mechanism (A) is confirmed.
    o_dbg_agu_rob_idx: output logic<5>,
    // M9.A.295: F2 walk-owner / fault-inject internal state, to see which
    // load owns the faulting walk and what fault_vaddr is delivered.
    o_dbg_walk_v    : output logic    ,
    o_dbg_walk_rob  : output logic<5> ,
    o_dbg_walk_vaddr: output logic<64>,
    o_dbg_lfault_inj: output logic    ,
    o_dbg_orphan_walk: output logic   ,
    // M9.3 walk-FSM ring enrichment: physical-walk-in-flight, PTW-start pulse,
    // and dmem MMU IDLE, so the ring can disambiguate a fresh re-latch from a
    // stale/orphan walk leaking its fault.
    o_dbg_walk_phys : output logic    ,
    o_dbg_walk_start: output logic    ,
    o_dbg_dmem_idle : output logic    ,
    // M9.3 inject→commit linkage result (first committed garbage-VA load fault).
    o_dbg_dlk_seen   : output logic    ,
    o_dbg_dlk_genuine: output logic    ,
    o_dbg_dlk_inj    : output logic    ,
    o_dbg_dlk_stval  : output logic<64>,
    o_dbg_dlk_pc     : output logic<64>,
    o_dbg_dlk_walkpc : output logic<64>,
    // M9.A.298: CSR translation-state snoop. The MMU's permission check for a
    // U=1 page load in S-mode reduces to tlb_u_ok = i_sum. A TLB-hit load
    // page-fault therefore implies csr_sum==0 at translate time. Exposing the
    // SUM/priv/MXR the dmem MMU sees lets us confirm the OoO CSR-write-vs-load
    // ordering hazard (load translates before an older `csrs sstatus,SUM`
    // commits → MMU sees stale SUM=0 → spurious fault).
    o_dbg_csr_sum      : output logic   ,
    o_dbg_csr_mxr      : output logic   ,
    o_dbg_csr_dmem_priv: output logic<2>,
    // M9.A.303: dmem PTW / faulting-PTE / TLB-hit context for the kernel
    // load-fault loop (VA 0x80616198 spurious fault) characterization.
    o_dbg_dmem_fault: output logic    ,
    o_dbg_dptw_req  : output logic    ,
    o_dbg_dptw_addr : output logic<64>,
    o_dbg_dpte      : output logic<64>,
    o_dbg_dtlb_hit  : output logic    ,
    o_dbg_dtlb_ppn  : output logic<44>,
    o_dbg_dtlb_perm : output logic<4> ,
    // M9.3 SMP: the effective dmem access VA (pre-MMU, = AGU rs1+imm). At a
    // spurious fault this tells operand-garbage (VA==0 ⇒ load read sp≈-40) apart
    // from an MMU mis-fault (VA==the real, mapped address).
    o_dbg_dmem_vaddr: output logic<64>,
    // M9.3 SMP free_list/rat recovery hypothesis: redirect_fire (recovery, already
    // exposed above) and fl_push_en (an rd-bearing commit) in the SAME cycle ⇒ the
    // committing op's pop is still in n_inflight, so the recovery head-rewind
    // RECLAIMS its just-architectural new_pdst → double-alloc → register corruption.
    o_dbg_fl_push_en   : output logic         ,
    o_dbg_commit_rd    : output logic<5>      ,
    o_dbg_commit_pdst  : output logic<6>      ,
) {
    import pipeline_pkg::*;

    // ============================================================
    // Fetch (Stage F)
    // ============================================================
    var pc_q       : logic<64>;
    // Phase 8 S4a: the IF/ID hand-off is now a decoupled fetch buffer (FIFO),
    // not a single registered latch. The if_*_q names below are kept (every
    // consumer — decode, rename, rob alloc, IRQ trap-PC, debug — reads them) but
    // are now COMBINATIONAL reads of the FIFO head (see the fetch_buffer block
    // after the fetch always_ff). Decoupling lets the fetch engine run ahead of
    // rename during back-end stalls and (in S4b) drain 2/cycle for 2-wide rename.
    var if_v_q     : logic    ; // FIFO non-empty (head valid)
    var if_pc_q    : logic<64>;
    var if_instr_q : logic<32>;
    var if_is_rvc_q: logic    ; // M7: was the fetched instr a 2-byte RVC
    var if_pred_next_pc_q: logic<64>; // Phase 8 M1: next PC fetched after the delivered instr (= predicted)
    var if_pred_index_q  : logic<13>; // Phase 8 M4: gshare BHT index used for the delivered instr
    // ICACHE_SYNC_READ shape-N: the icache demand read is synchronous, so
    // o_rdata (= icache_rdata) is valid for pc_q only ONE cycle after pc_q
    // settled (present→deliver). ic_rd_settled_q = "the read arriving this cycle
    // is for the current, translated pc_q" — set the cycle after pc_q held with a
    // valid translation, cleared the cycle pc_q advances. Gates fetch delivery so
    // decode never combines pc_q's metadata with the previous fetch's bytes.
    // Must be flipped together with icache.veryl's ICACHE_SYNC_READ (cp_icache_
    // fetch_decouple_plan.md); DEAD at 0 (const-gated D → DCE, byte-identical).
    var ic_rd_settled_q  : logic     ;

    // ── Shape-W (CP §14): word-granular decoupled fetch — F0 read stream + WORD FIFO ──
    // The FINAL front-end structure under ICACHE_SYNC_READ=1: the icache demand read is
    // synchronous (a cycle late), so decouple the READ (dword-granular) from the DECODE
    // (instruction-granular). F0 streams pc_fetch_q += 8 (one 64-bit dword) every cycle
    // and pushes each returned sync-read dword into this raw WORD FIFO; the extract stage
    // (W2) drains it instruction-by-instruction — the whole RVC/straddle/dual-issue/predict
    // datapath moves onto the FIFO head + ext_pc_q. The fetch advance has NO length/branch
    // dependence, so sequential code never bubbles (removes shape-N's measured +20-38%).
    // Each entry is the natural 64-bit icache window {rdata_next, rdata} at a dword-aligned
    // PC (matches today's dual-issue window exactly), so one push/cycle sustains 2-wide
    // extract. DEAD at ICACHE_SYNC_READ=0: pc_fetch_q + every FIFO write is const-gated →
    // DCE, byte-identical (the live path stays the combinational pc_q fetch). W1 lands the
    // read-decouple structure; the =1 miss/PTW/fault back-pressure corners are hardened in W3.
    // Core-local mirror of icache.veryl's ICACHE_SYNC_READ (flip together). Declared here
    // (ahead of the W2 extract-source muxes near the RVC decode) — the demand read is
    // synchronous at =1; DEAD/byte-identical at 0.
    const ICACHE_SYNC_READ: bit = 1;
    const WF_N: u32 = 8;
    var pc_fetch_q      : logic<64>;       // F0 dword-aligned fetch address (presented this cycle)
    var wf_data   : logic<64> [WF_N];      // the 64-bit dword {high word, low word}
    var wf_pc     : logic<64> [WF_N];      // its dword-aligned PC
    var wf_ifault : logic     [WF_N];      // imem page fault marker (no data)
    var wf_iacc   : logic     [WF_N];      // imem access (PMP) fault marker
    var wf_gstage : logic     [WF_N];      // H-ext guest-page fault marker
    var wf_gpa    : logic<64> [WF_N];      // faulting guest PA (for htval)
    // f2.15e: the run-ahead block prediction rides its own dword all the way to extract. The FTQ is
    // dequeued at F0, four stages upstream of the consumer, so the descriptor has to be carried with
    // the fetched bytes exactly as the fault bits are. DEAD at FTQ_DESC=0 (written const-gated).
    var wf_d_taken : logic     [WF_N];     // this dword's block exits on a predicted-taken transfer
    var wf_d_target: logic<64> [WF_N];     // ... to here (dword+offset exact)
    var wf_d_off   : logic<2>  [WF_N];     // ... at this halfword offset within the dword
    // f2.16b INSTRUMENTATION: why the producer recorded no taken exit for this dword, carried down
    // to extract so an L0-only take can be attributed to its own producer-side cause instead of to
    // an aggregate rate. Read only under FTQ_STATS, so it DCEs with the counters at 0. See pd_why.
    var wf_d_why   : logic<3>  [WF_N];
    var wf_head   : logic<3>;
    var wf_tail   : logic<3>;
    var wf_count  : logic<4>;
    // F0→push pipeline: the sync-read dword for pc_fetch_q(T) arrives at T+1, so the PC +
    // fault bits presented at T are registered one cycle to push alongside the arriving data.
    var wf_push_valid_q : logic;           // a fetch was presented last cycle → push its dword now
    var wf_push_pc_q    : logic<64>;
    var wf_push_ifault_q: logic;
    var wf_push_iacc_q  : logic;
    var wf_push_gstage_q: logic;
    var wf_push_gpa_q   : logic<64>;
    var wf_push_d_taken_q : logic;         // f2.15e: the descriptor of the dword in flight
    var wf_push_d_target_q: logic<64>;
    var wf_push_d_off_q   : logic<2>;
    var wf_push_d_why_q   : logic<3>;
    // W3 non-cacheable 2-beat: a non-cacheable fetch (i_dram=0: boot ROM / MMIO) has NO next
    // word — the icache passthrough returns only the single presented 32-bit word (o_rdata_next
    // is 0). The dword-granular F0 would push {0, low_word}, so the high word (odd instr slot)
    // decodes as 0 → the firmware hangs at its 2nd instruction (PA+4). Fix: for non-cacheable,
    // F0 fetches WORD-granular over two beats — beat 0 presents the dword-low word, beat 1 the
    // dword-high word (pc_fetch_q+4) — assembling the full dword before the push. Boot ROM only
    // (arch/Linux run from cacheable DRAM), so the half-rate non-cacheable fetch is free.
    var f0_nc_beat_q       : logic;        // 0 = presenting dword-low word, 1 = presenting high word
    var f0_nc_lo_inflight_q: logic;        // a beat-0 (low-word) read was presented last cycle → capture now
    var f0_nc_lo_q         : logic<32>;    // the captured dword-low word (from beat 0), held for the beat-1 push
    var wf_push_nc_q       : logic;        // this pending push assembles {icache_rdata(high), f0_nc_lo_q(low)}

    // ── (b) B1: fetch-directed prefetch — unconditional-branch FTB (cp_icache_fetch_decouple_plan.md §24) ──
    // A small fetch-block table indexed by the F0 dword address (pc_fetch_q). It predicts an
    // UNCONDITIONAL taken branch (JAL / direct always-taken) that lives WHOLLY within the block and
    // its target, so F0 re-steers straight to the target as it fetches the branch dword — the target
    // dword is prefetched ahead of extract, so the extract-side taken redirect finds it already
    // buffered and does NOT flush → the taken-refill BUBBLE1 (§19) is removed for repeated
    // unconditional branches (calls / gotos / JAL loops). Trained by extract on an unconditional-taken
    // slot-0 delivery. A HINT only: extract stays authoritative — the flush is suppressed ONLY when the
    // buffered next dword actually matches extract's predicted target (ext_diverge below), so a stale
    // / aliased FTB entry costs at most a spurious flush, never correctness. Straddling branches (a
    // 32-bit op at dword byte-offset 6) are NOT trained: F0's redirect would skip the sequential dword
    // holding the branch's high half. DEAD at ICACHE_FETCH_DIRECTED=0 (only meaningful with
    // ICACHE_SYNC_READ=1; every write is `else if ICACHE_FETCH_DIRECTED` → reset-only at 0 → DCE).
    const ICACHE_FETCH_DIRECTED: bit = 1;
    // (b) B2a: extend the FTB to CONDITIONAL branches (loop back-edges are the residual taken-refill
    // bubble B1 leaves — B1 trains unconditional only). A conditional entry carries is_cond + a 2-bit
    // saturating confidence trained on EXTRACT's predicted direction (cond_taken0), so F0 tracks
    // extract's own predictor: F0 follows a conditional FTB hit ONLY when confidence is strong-taken
    // (==3), matching extract on strongly-biased branches (loops) and falling back to sequential (no
    // prefetch, today's flush) on weakly-biased ones — no spec_ghr mirror needed. A HINT: a wrong F0
    // direction is still just a flush (§24.4). Gated by ICACHE_FTB_COND (bisect knob); at 0 the FTB is
    // B1 (unconditional-only) and is_cond/conf DCE. DEAD at ICACHE_FETCH_DIRECTED=0.
    const ICACHE_FTB_COND: bit = 1;
    const FTB_IDX_W: u32 = 6;                       // 64 fetch-block entries
    const FTB_N    : u32 = 1 << FTB_IDX_W;
    const FTB_TAG_W: u32 = 64 - (FTB_IDX_W + 3);    // pc_fetch_q[63 : FTB_IDX_W+3]
    var ftb_valid  : logic           [FTB_N];
    var ftb_tag    : logic<FTB_TAG_W> [FTB_N];
    var ftb_target : logic<64>        [FTB_N];
    var ftb_is_cond: logic           [FTB_N]; // B2a: entry predicts a CONDITIONAL branch
    var ftb_conf   : logic<2>         [FTB_N]; // B2a: 2-bit saturating taken-confidence (3 = follow)
    // ── F2-full f2.5d: run-ahead RAS (cp_predictor_sram_plan.md "f2.5d") — DEAD at 0 ──
    // After f2.5c.1 the decoupled front end runs at F2-lite IPC, but RETURNS still pay the full
    // Stage-B override bubble: the FTB excludes returns (a stored target is caller-dependent and so
    // useless), so pc_pred cannot run ahead past a `ret` and the return target is never prefetched.
    // The classic decoupled-front-end answer is a RUN-AHEAD RAS on the predictor loop: mark the
    // block-terminating CALL / RETURN in the FTB, and let pc_pred push/pop its own stack as it
    // predicts — a return then gets a target AT THE PREDICTOR, one FTQ block ahead of fetch, so F0
    // prefetches it and f2.3's sb_ovr_soft turns the Stage-B return override from a hard flush into a
    // soft pop. The stack lives in ras.veryl as a THIRD stack (pred), resynced from the speculative
    // stack on every pc_pred re-seed (the f2.5a consistency invariant) and from the architectural one
    // on a pipeline flush. Accuracy-only: the run-ahead RAS feeds only the FTQ/prefetch stream; the
    // Stage-B clocked full pred (which uses the SPECULATIVE RAS) and commit c_bp_mispredict stay
    // authoritative. FLIP-COUPLED to FTQ_DECOUPLE (the run-ahead RAS is on the pc_pred loop; the
    // coupled f0_ftb_hit loop, DCE'd at FTQ_DECOUPLE=1, would follow a ret entry's unused target).
    // DEAD at 0: is_call/is_ret are reset-only (their train is under `if PRED_RAS_AHEAD`), so a ret
    // entry never exists and every consumer const-folds away.
    const PRED_RAS_AHEAD: bit = 0;
    var ftb_is_call : logic     [FTB_N]; // f2.5d: entry's branch is a CALL → push ftb_ret_addr
    var ftb_is_ret  : logic     [FTB_N]; // f2.5d: entry's branch is a RETURN → pop the run-ahead RAS
    var ftb_ret_addr: logic<64> [FTB_N]; // f2.5d: a call's return address (its fall-through PC)
    // (b) B1: gate f0_ftb_hit for the FIRST F0 fetch after any re-steer (redirect / early /
    // ext_taken / f0_diverged). A re-steer target can land MID-dword (a branch/jump/trap
    // target past a branch the FTB trained on that same dword); if F0 then FTB-redirected off
    // its re-entry dword it would (1) skip the sequential continuation extract still needs and
    // (2) leave wf_pc[head+1] non-sequential, so extract's straddle / slot-1 across-dword read
    // (wf_data[head+1]) would decode a WRONG high half. Suppressing the first-fetch redirect
    // keeps the re-entry dword's successor SEQUENTIAL. DEAD/DCE at ICACHE_FETCH_DIRECTED=0.
    var f0_no_ftb_q: logic;
    // W2 extract stage: ext_pc_q is the slot-0 INSTRUCTION PC being decoded this cycle
    // (replaces pc_q's extract role at =1; pc_q keeps only its now-vestigial fetch-FSM role,
    // DCE'd at =1). It indexes the WORD FIFO head (wf_pc[wf_head] == ext_pc_q dword-aligned);
    // the whole RVC/straddle/dual-issue/predict datapath reads it + the head dword via the
    // ic_pc/ic_rdata/ic_rdata_next const-muxes below. DEAD at 0 (ext_pc_q reset-only → DCE).
    var ext_pc_q : logic<64>;

    // ── F1 step 2: extract Stage-A/B pipeline register (PRED_PIPE) — DEAD at 0 ──
    // The overriding / decoupled-predictor restructure (cp_predictor_sram_plan.md, "extract
    // Stage-A/B split"). Today extract is ONE combinational cycle at T: pop the WORD FIFO,
    // read btb/bht/tage/ibtb on ext_pc_q, compute the predicted bundle, push it into the
    // fetch buffer + steer F0 — all at T. Making the predictor read clocked
    // ({BTB,BHT,TAGE,IBTB}_SYNC_READ=1) delays the prediction one cycle, so extract must
    // split into Stage-A (assemble the bundle + present ext_pc_q to the now-clocked
    // predictors at T) and Stage-B (apply the registered prediction + push + steer at T+1).
    // These regs are Stage-A's output — the assembled bundle {a_pc, a_s0, a_s1}, the slot-1
    // eligibility, the straddle state, and the FTB-followed next-PC — latched at T so Stage-B
    // consumes them at T+1. a_valid marks a Stage-A bundle produced this cycle.
    //
    // Order of implementation (cp_predictor_sram_plan.md): THIS is step 1 — declare the
    // substrate ONLY, no consumer rewire. DEAD at PRED_PIPE=0: written ONLY under `else if
    // PRED_PIPE` → reset-only → the registers (and their fanin) DCE → byte-identical (the
    // ext_pc_q / WORD-FIFO idiom). Step 2 routes the fetch-buffer push through Stage-B (=1
    // adds the +0 structural stage, measures its IPC); step 3 flips the predictor sync-reads
    // coupled to PRED_PIPE so the read is truly clocked; step 4 adds the override redirect.
    const PRED_PIPE: bit = 1;
    // ── F1 order-item-3 (A): overriding predictor — clocked read + Stage-B authority ──
    // The step-3/step-4 flip, unified (cp_predictor_sram_plan.md "order-item-3 design
    // analysis"): flipping {BTB,BHT,TAGE,IBTB}_SYNC_READ=1 registers the predictor OUTPUT, so
    // every core consumer sees the read of ic_pc(T-1) — the Stage-A steer (ext_taken_redir /
    // ext_pc_q advance / RAS / spec-history, all at T) would apply a stale prediction. There is
    // no "clock the arrays only" half-step: the consumers must move to Stage-B (T+1, where the
    // registered read matches a_pc), which forces Stage-A to advance ext_pc_q on something
    // available at T (NOT the clocked predictor) — i.e. the authority inversion. Chosen variant
    // (A), user 2026-07-24: Stage-A advances PURELY SEQUENTIALLY (never takes a branch), the
    // clocked BTB/BHT/TAGE/RAS/iBTB at Stage-B are authoritative and OVERRIDE (redirect F0 +
    // flush) on any taken branch. The F0 FTB is gated off so F0 is a plain sequential stream
    // (else its FTB-taken FIFO dwords disagree with the sequential Stage-A — the deferred
    // FIFO-follow reconciliation). Requires PRED_PIPE (rides the Stage-A/B skid). DEAD at 0:
    // every `if PRED_OVERRIDE ? new : old` folds to today's path → byte-identical. Increment
    // 3a.1/3a.2 here wire the Stage-A sequential advance only (still DEAD); 3a.3 moves the
    // predict/RAS/spec-history/FTB-train to Stage-B + couples the four *_SYNC_READ + gates the
    // FTB + adds the override redirect; 3a.4 flips =1, measures the inversion cost, ships at 0.
    const PRED_OVERRIDE: bit = 1;
    // F2-lite substrate (order-item f2.1, doc/cp_predictor_sram_plan.md "Increment plan"). Under
    // PRED_OVERRIDE=1 the F0 FTB is inert: its train (ftb_br_deliver) is gated `!PRED_OVERRIDE`, so
    // no entry is ever written → f0_ftb_hit never fires → F0 streams sequentially and the clocked
    // BTB/BHT/TAGE at Stage-B are the sole authority (the authority inversion, 3a.6). FTB_OVERRIDE
    // re-enables the FTB as a RUN-AHEAD F0 producer *while the clocked predictors stay on*: the FTB
    // trains again and F0 follows its taken targets a block ahead (prefetching the taken path, so
    // the icache-latency bubble on FTB-covered branches is removed), and the clocked full pred at
    // Stage-B OVERRIDES on FTB-vs-full disagreement (f2.3). This const couples the three
    // `!PRED_OVERRIDE` gates that keep the FTB inert — ftb_br_deliver (train), ext_taken_redir and
    // f0_diverged (the Stage-A FTB-follow reconciliation redirects) — to `!PRED_OVERRIDE ||
    // FTB_OVERRIDE`. DEAD at 0: with FTB_OVERRIDE=0 the disjunction folds back to `!PRED_OVERRIDE`
    // (and at PRED_OVERRIDE=0 the whole term is 1 either way) → byte-identical. Meaningful only with
    // PRED_OVERRIDE=1. f2.2 wires the extract-side FIFO-follow, f2.3 the FTB-vs-full override, f2.4
    // flips =1 and measures, f2.5 promotes to a first-class multi-block FTQ.
    const FTB_OVERRIDE: bit = 1;
    // ── F2-full (f2.5): decoupled FTQ — independent pc_pred loop + FTQ (cp_predictor_sram_plan.md,
    //    "F2-full (f2.5) — detailed design") ──
    // F2-lite's pc_fetch_q serves DOUBLE duty (icache read address + FTB-steer predictor loop),
    // coupled in lockstep (pc_fetch_q advances only on f0_present). F2-full SPLITS them: pc_pred runs
    // the FTB loop independently (1 block/cyc, gated only on FTQ room), enqueues each predicted dword
    // into the FTQ, and F0 (pc_fetch_q) DEQUEUES the FTQ head to fetch. The WORD-FIFO stream is
    // PROVABLY identical (pc_pred computes the same dword sequence pc_fetch_q's FTB loop did) → the
    // whole extract side (WORD FIFO + skid + straddle + Stage-B override) is UNCHANGED; f2.5 is purely
    // upstream of F0. f2.5a (this increment) declares the substrate + wires the pc_pred FTB PRODUCER +
    // FTQ enqueue (NO F0 consumer yet — F0 keeps its own coupled advance, so at =1 the producer runs
    // in parallel but is IGNORED; f2.5b routes F0's fetch address FROM ftq_pc[ftq_head] + adds the
    // dequeue). Consistency invariant: pc_pred re-seeds + the FTQ flushes on every redirect that
    // re-steers pc_fetch_q / flushes the WORD FIFO (sb_ovr_soft is the sole non-flushing case). DEAD
    // at FTQ_DECOUPLE=0: every write is `else if FTQ_DECOUPLE` → reset-only → pc_pred/pp_no_ftb_q/ftq_*
    // + their fanin DCE → byte-identical. Requires the F2-lite 9-const set at flip (PRED_L0_FAST=0).
    const FTQ_DECOUPLE: bit = 1;
    const FTQ_N: u32 = 8;
    var pc_pred    : logic<64>;         // independent predictor-loop dword pointer (leads pc_fetch_q)
    var pp_no_ftb_q: logic;             // mid-dword re-entry guard for the pc_pred FTB read (cf. f0_no_ftb_q)
    var ftq_pc     : logic<64> [FTQ_N]; // FTQ: the dword-PC sequence F0 will fetch (addresses only)
    var ftq_head   : logic<3>;
    var ftq_tail   : logic<3>;
    var ftq_count  : logic<4>;
    // ── f2.15d/e: the FTQ entry becomes a DESCRIPTOR — the const + the terms extract needs ──
    // Declared HERE rather than with the f2.15d logic far below because Veryl requires definition
    // before reference for module-level lets, and the consumer side (F0's fetch address, the L0
    // combine, the Stage-A advance) all sit above it. The design rationale, the two-stage producer
    // and every driver live at the f2.15d/e block; this is only the forward declaration.
    const FTQ_DESC: bit = 1;
    var pc_pred_q  : logic<64>;         // the dword whose blkpred result is arriving THIS cycle
    var pp_desc_vld: logic    ;         // pc_pred_q is a real in-flight lookup (cleared by a reseed)
    var pp_no_desc_q: logic   ;         // pp_no_ftb_q, delayed to match pc_pred_q
    var pp_ent_off_q: logic<2>;         // f2.16: the halfword extract RE-ENTERS pc_pred_q's dword at
    var ftq_d_taken : logic     [FTQ_N]; // this dword's block exits on a predicted-taken transfer
    var ftq_d_target: logic<64> [FTQ_N];
    var ftq_d_off   : logic<2>  [FTQ_N]; // halfword offset of that transfer within the dword
    var ftq_d_why   : logic<3>  [FTQ_N]; // f2.16b instrumentation, see wf_d_why / pd_why
    var ftq_d_call  : logic     [FTQ_N];
    var ftq_d_ret   : logic     [FTQ_N];
    var ftq_d_ind   : logic     [FTQ_N];
    // f2.15e: under FTQ_DESC the run-ahead pointer the FTQ/F0 side CONSUMES is pc_pred_q — the dword
    // whose descriptor is arriving this cycle — while pc_pred itself is one dword ahead, in the array
    // lookup. Everything downstream of the producer (the enqueue address, F0's empty-FTQ bypass) must
    // therefore read pp_cur, and must hold while pp_cur_ok is low (the one start-up cycle after a
    // re-seed, when pc_pred_q still holds the abandoned pointer). Folds to pc_pred / 1'b1 at 0.
    let pp_cur   : logic<64> = if FTQ_DESC ? pc_pred_q : pc_pred;
    let pp_cur_ok: logic     = !FTQ_DESC || pp_desc_vld;
    // Stage-B is a 1-deep SKID register between extract-assemble/predict (Stage-A, at T) and
    // the fetch-buffer write (Stage-B, at T+1). a_valid holds until the bundle drains into the
    // fetch buffer; a_push0/a_push1 are the registered slot deliveries (drive the fb write +
    // tail/count advance at drain). All the fb-push metadata is captured for both slots so the
    // write replays it a cycle later. Stage-A's ext_pc_q advance / WORD-FIFO pop / F0 steer /
    // RAS / spec-history / FTB-train stay at T (order-item-2 delays ONLY the fb write).
    var a_valid       : logic    ; // Stage-B holds a valid bundle (persists until drained)
    var a_push0       : logic    ; // registered fb_push0 (slot-0 delivered)
    var a_push1       : logic    ; // registered fb_push1 (slot-1 delivered)
    // slot-0 fb-write fields
    var a_pc          : logic<64>; // slot-0 instruction PC (= ic_pc at Stage-A)
    var a_s0          : logic<32>; // slot-0 RVC-expanded instruction (= fetched_instr)
    var a_is_rvc0     : logic    ; // slot-0 is_rvc (= !straddle_q && curr_is_rvc)
    var a_ifault      : logic    ; // slot-0 imem page fault (= ic_ifault)
    var a_iacc        : logic    ; // slot-0 imem access fault (= ic_iacc)
    var a_gstage      : logic    ; // slot-0 G-stage fault (= ic_gstage)
    var a_gpa         : logic<64>; // slot-0 faulting guest PA (= ic_gpa)
    var a_pred_next_pc0: logic<64>; // slot-0 predicted next PC (= pred_next_pc_bp)
    var a_pred_index0 : logic<13>; // slot-0 gshare BHT index (= bht_lk_index)
    var a_ghr_fold0   : logic    ; // slot-0 spec_ghr_l fold flag (= btb_hit && btb_is_cond)
    // slot-1 fb-write fields
    var a_s1_pc       : logic<64>; // slot-1 instruction PC (= s1_pc)
    var a_s1          : logic<32>; // slot-1 RVC-expanded instruction (= s1_instr)
    var a_s1_is_rvc   : logic    ; // slot-1 is_rvc (= s1_is_rvc)
    var a_pred_next_pc1: logic<64>; // slot-1 predicted next PC (= pred_next_pc1)
    var a_pred_index1 : logic<13>; // slot-1 gshare BHT index (= bht_lk_index1)
    var a_ghr_fold1   : logic    ; // slot-1 spec_ghr_l fold flag (= btb_hit2 && btb_is_cond2)
    // order-item-4 (override redirect) fields — captured now, consumed when the override lands
    var a_slot1_elig  : logic    ; // slot-1 eligibility (slot1_eligible) resolved at Stage-A
    var a_straddle    : logic    ; // straddle_q latched into Stage-A
    var a_ftb_next    : logic<64>; // FTB-followed / delivered next-PC (ext_next_pc); step-4 override compares against it
    // f2.4-fix: the ACTUAL Stage-A advance (ext_eff_next) captured at produce = the PC of the next
    // instruction extract delivered after this bundle. Under FTB_OVERRIDE ext_ftb_follow (f2.2)
    // advances NON-sequentially to the FTB target dword (offset 0); the recorded pred_next of the
    // bundle's LAST delivered slot MUST equal this actual successor (not the sequential fall-through),
    // else the commit-time c_bp_mispredict backstop is masked and a wrong-path offset-0 instr silently
    // retires (the strcpy 0x98 leak). Folds to ext_seq_next at FTB_OVERRIDE=0 → variant-A unchanged.
    var a_eff_next    : logic<64>; // = ext_eff_next at produce (the delivered next-PC)
    // F1 option (B) b.3: the L0 fast prediction Stage-A applied (l0_taken / l0_pred_target),
    // carried to Stage-B so the clocked full predictor can OVERRIDE only on DISAGREEMENT.
    var a_l0_taken    : logic    ; // L0 called slot-0 taken at Stage-A (→ ext_pc_q/F0 steered to a_l0_target)
    var a_l0_target   : logic<64>; // the L0 target Stage-A steered to
    var a_l0_taken1   : logic    ; // f2.9: L0 called SLOT-1 taken at Stage-A
    var a_l0_target1  : logic<64>; // f2.9: the slot-1 L0 target Stage-A steered to
    // f2.6: the TAGE direction READ AT STAGE-A, captured so Stage-B can replay it (see TAGE_STAGEA).
    var a_tage_hit    : logic    ;
    var a_tage_taken  : logic    ;
    var a_tage_hit2   : logic    ;
    var a_tage_taken2 : logic    ;

    // Phase 8 S4a: fetch buffer (decode queue). Depth-8 FIFO of clean fetched
    // records. Per-field plain arrays (NOT an array of structs) so the
    // combinational head read is not subject to the Veryl-sim dynamic-index
    // struct-field-read staleness bug. Filled by the fetch engine (<=1/cycle in
    // S4a.2, <=2/cycle from S4a.3), drained by rename (<=1/cycle until S4b).
    const FB_DEPTH: u32 = 8;
    var fb_pc          : logic<64> [FB_DEPTH];
    var fb_instr       : logic<32> [FB_DEPTH];
    var fb_is_rvc      : logic     [FB_DEPTH];
    var fb_pred_next_pc: logic<64> [FB_DEPTH];
    var fb_pred_index  : logic<13> [FB_DEPTH];
    var fb_ghr_fold    : logic     [FB_DEPTH]; // S22: spec_ghr_l folded this instance at delivery
    var fb_ifault      : logic     [FB_DEPTH];
    var fb_iacc        : logic     [FB_DEPTH]; // PMP: per-slot instruction access fault
    // Phase 11-H3d: per-entry G-stage-fault flag + faulting guest PA for an
    // instruction guest-page-fault. Latched with fb_ifault at push.
    var fb_ifault_gstage: logic    [FB_DEPTH];
    var fb_ifault_gpa   : logic<64>[FB_DEPTH];
    var fb_head : logic<3>; // read pointer (oldest, = IF/ID head)
    var fb_tail : logic<3>; // write pointer (next push slot)
    var fb_count: logic<4>; // occupancy 0..8

    // Forward-declared CSR outputs consumed by imem_mmu/dmem_mmu insts
    // below; driven by csr inst further down.
    var csr_satp: logic             <64>;
    var csr_priv: csr_pkg::PrivLevel    ;
    // M9.A.304: registered previous-cycle priv snapshot from csr, used for
    // sync-exception trap delegation to dodge the cross-module eval-order hazard.
    var csr_priv_prev: csr_pkg::PrivLevel   ;
    var csr_sum      : logic                ;
    var csr_mxr      : logic                ;
    var csr_mprv     : logic                ;
    var csr_pbmte    : logic                ; // P10 Svpbmt: menvcfg.PBMTE
    var dmu_pbmt_unc : logic                ; // P10 Svpbmt: data MMU NC/IO translation
    var csr_adue     : logic                ; // P10 Svadu: menvcfg.ADUE (HW A/D update)
    var dmu_ad_wb    : logic                ; // P10 Svadu: data MMU A/D write-back active
    var csr_pmpcfg   : logic<64> [2]        ; // PMP (Smpmp): pmpcfg0/pmpcfg2
    var csr_pmpaddr  : logic<64> [16]       ; // PMP (Smpmp): pmpaddr0..15
    var csr_pmm_m    : logic             <2>; // P10 Supm: mseccfg.PMM (M-mode pointer mask)
    var csr_pmm_s    : logic             <2>; // P10 Supm: menvcfg.PMM (S-mode)
    var csr_pmm_u    : logic             <2>; // P10 Ssnpm: senvcfg.PMM (U-mode)
    var csr_mpp      : logic             <2>;
    var csr_tvm      : logic                ;
    var csr_tsr      : logic                ;
    var csr_fs       : logic             <2>; // mstatus.FS (00=Off → FP illegal)
    var csr_vs_fs    : logic             <2>; // vsstatus.FS (guest FP unit state)
    // Phase 12 V0: vector unit state (mstatus.VS) + architectural vtype/vl feedback.
    var csr_vs       : logic             <2>; // mstatus.VS (00=Off → vector illegal)
    var csr_vtype    : logic            <64>;
    var csr_vl       : logic            <64>;
    // Phase 11-H: virtualization state for two-stage MMU translation.
    var csr_virt     : logic                ; // current V bit
    var csr_mpv      : logic                ; // mstatus.MPV (MPRV-effective V)
    var csr_hgatp    : logic             <64>;
    var csr_vsatp    : logic             <64>;
    var csr_vs_sum   : logic                ; // vsstatus.SUM (VS-stage)
    var csr_vs_mxr   : logic                ; // vsstatus.MXR (VS-stage)
    var csr_spvp     : logic                ; // hstatus.SPVP (HLV/HSV priv: 1=VS,0=VU)
    var csr_hstatus_hu: logic               ; // hstatus.HU (HLV/HSV allowed in HS-U)
    var csr_hstatus_vtvm: logic             ; // hstatus.VTVM (trap VS satp/sfence)
    var csr_hstatus_vtsr: logic             ; // hstatus.VTSR (trap VS sret)
    // Phase 11-H3: VS trap delegation.
    var csr_virt_prev: logic                ; // registered V snapshot (eval-order safe)
    var csr_hedeleg  : logic             <64>;
    var csr_hideleg  : logic             <64>;
    var csr_vstvec   : logic             <64>;
    // Phase 11-H3b: VS trap-return PC (used by a VS-mode SRET) + the IRQ→VS
    // routing flag (a pending virtual interrupt to be taken in VS-mode).
    var csr_vsepc    : logic             <64>;
    var csr_irq_to_vs: logic                ;
    // M9: satp shadow latched on sfence.vma. Linux head.S sets satp without
    // a preceding sfence, expecting the previous TLB/satp to remain effective
    // until the next sfence (QEMU-compatible behavior). v4's narrow IFU
    // cannot speculate past trampoline→early_pg_dir switch in 6 cycles, so
    // we honor the QEMU model: imem/dmem MMU see satp_shadow, not csr_satp.
    // always_ff for satp_shadow lives after commit_sfence_pulse assignment.
    var satp_shadow: logic<64>;
    // Phase 11-H5: the VS-stage (guest) satp shadow, latched atomically at the
    // guest's `csrw satp` / sfence commit just like satp_shadow, so the two-stage
    // MMU never sees a half-changed vsatp during the guest kernel's enable-MMU
    // trampoline. Inert at V=0 (i_vsatp is only read on the two-stage V=1 path).
    var vsatp_shadow: logic<64>;
    // Effective priv for dmem accesses (MPRV-aware). M-mode loads/stores
    // with MPRV=1 use mstatus.MPP as the priv level for translation.
    let dmem_eff_priv: csr_pkg::PrivLevel = if csr_mprv && csr_priv == csr_pkg::PrivLevel::MACHINE ?
        (if csr_mpp == 2'b11 ?
            csr_pkg::PrivLevel::MACHINE
        : if csr_mpp == 2'b01 ?
            csr_pkg::PrivLevel::SUPERVISOR
        :
            csr_pkg::PrivLevel::USER
        )
    :
        csr_priv
    ;
    // Phase 11-H: effective V for data accesses. MPRV brings M-mode + MPV into a
    // virtualized data access (the access translates as if in VS/VU). Fetch uses
    // csr_virt directly (M-mode fetch is never virtualized). VS-stage permission
    // bits come from the guest sstatus (vsstatus) when the access is virtualized.
    let dmem_eff_virt: logic = if csr_mprv && csr_priv == csr_pkg::PrivLevel::MACHINE ? csr_mpv : csr_virt;
    // Phase 11-H HLV/HSV: the op currently driving the dmem port is a hypervisor
    // virtual-memory access (per-op two-stage translation, even at V=0). Driven
    // (var + assign) near the dmem MMU where the issue/commit/walk sources are in
    // scope. dmem_op_hlvx flags the HLVX execute-permission read. Both 0 unless an
    // HLV/HSV is the driving op, so V=0 / ordinary behaviour is byte-identical.
    var dmem_op_hlv  : logic                ;
    var dmem_op_hlvx : logic                ;
    // A data access is virtualized (two-stage) when V/MPV says so OR it is an
    // HLV/HSV. SUM/MXR then come from the guest sstatus (vsstatus).
    let dmem_virt2   : logic = dmem_eff_virt || dmem_op_hlv;
    let dmem_sum     : logic = if dmem_virt2 ? csr_vs_sum : csr_sum;
    let dmem_mxr     : logic = if dmem_virt2 ? csr_vs_mxr : csr_mxr;
    // HLV/HSV run with the privilege selected by hstatus.SPVP (1=VS supervisor,
    // 0=VU user); ordinary accesses keep the MPRV-effective priv.
    let dmem_mmu_priv: csr_pkg::PrivLevel = if dmem_op_hlv ?
        (if csr_spvp ? csr_pkg::PrivLevel::SUPERVISOR : csr_pkg::PrivLevel::USER)
    :
        dmem_eff_priv
    ;
    let imem_sum     : logic = if csr_virt ? csr_vs_sum : csr_sum;
    let imem_mxr     : logic = if csr_virt ? csr_vs_mxr : csr_mxr;

    // Phase 8 S5.1: Sv39 dmem translation active (mirrors dmem_mmu vm_enabled =
    // satp.MODE==Sv39 && eff_priv != M). Drives rob i_conservative: VA-based
    // store-to-load forwarding/disambiguation is only sound when VA==PA (bare
    // mode); under an MMU the same PA aliases across VAs and MMIO would be
    // wrongly forwarded, so loads fall back to baseline store-ordering there.
    // Phase 11-H: a virtualized data access (dmem_eff_virt) is always translated
    // (two-stage), so it too must be conservative — OR it in (safe; V=0 inert).
    let dmem_vm_on: logic = (satp_shadow[63:60] == 4'd8 && dmem_eff_priv != csr_pkg::PrivLevel::MACHINE)
        || dmem_eff_virt;
    // Phase 11-H: an HLV/HSV is also a translated VA access (VA != PA), so the
    // store/load address-selection + fast-store gates must treat it as VM. This is
    // kept SEPARATE from dmem_vm_on because dmem_vm_on feeds the ROB's
    // i_conservative; folding the per-op flag there closes a combinational loop
    // (dmem_op_hlv → i_conservative → ROB block scan → commit → dmem_op_hlv). The
    // op-aware form below is used only by leaf store/forward gates that never feed
    // back into dmem_op_hlv. 0 unless an HLV/HSV drives the port.
    let dmem_vm_on_op: logic = dmem_vm_on || dmem_op_hlv;

    // P10 Supm/Ssnpm: select the pointer-masking mode by the data access's
    // effective privilege (M→mseccfg, S→menvcfg, U→senvcfg). The masked bits are
    // sign-extended when the address is a translated VA (dmem_vm_on), else zeroed
    // (bare PA). Fed to both ALU AGUs; PMM=0 at reset makes it a no-op.
    let pm_mode: logic<2> = if dmem_eff_priv == csr_pkg::PrivLevel::MACHINE ?
        csr_pmm_m
    : if dmem_eff_priv == csr_pkg::PrivLevel::SUPERVISOR ?
        csr_pmm_s
    :
        csr_pmm_u
    ;
    let pm_va: logic = dmem_vm_on;

    // M5.D.2: forward declaration for IQ-issue/CDB stall gate; driven
    // by the dmem_mmu inst near end of file. Bare mode keeps this at 0.
    var dmem_mmu_busy   : logic;
    var dmem_mmu_fault  : logic;
    var dmem_mmu_fault_s: logic;
    var dmem_mmu_acc_fault  : logic; // PMP (Smpmp) load access fault (cause 5)
    var dmem_mmu_acc_fault_s: logic; // PMP (Smpmp) store access fault (cause 7)
    var dmem_mmu_pte_acc_fault: logic; // SvPMP: PMP-denied PTE READ on the walk (cbo_m keeps this)
    var dmem_mmu_pma_hole     : logic; // PMA: final translated PA is a hole (cbo_m keeps this)
    // PMP (Smpmp) WRITE-permission denial for an SC at issue (forward-declared:
    // the pipe-0 alu_wrap inst consumes it but it is assigned near the AGU /
    // issue-SC logic far below). See u_pmp_sc_issue.
    var sc_issue_acc_fault: logic;
    // Phase 11-H3c: the current dmem fault is a G-stage (guest-physical) fault,
    // and the faulting guest PA (for htval). Valid alongside dmem_mmu_fault(_s)
    // — used at commit for a store guest-page-fault (cause 23). 0 while V=0.
    var dmem_mmu_gstage : logic;
    var dmem_mmu_gpa    : logic<64>;
    var dmem_walk_start : logic; // M9.A.296: PTW-start pulse (1 cy at IDLE→walk)
    var dmem_mmu_idle   : logic; // M9.3: dmem MMU FSM is IDLE (no walk owns port)
    // M9.A.303 debug: dmem PTW / faulting-PTE / TLB-hit snoop
    var dmem_dptw_req : logic    ;
    var dmem_dptw_addr: logic<64>;
    var dmem_dpte     : logic<64>;
    var dmem_dtlb_hit : logic    ;
    var dmem_dtlb_ppn : logic<44>;
    var dmem_dtlb_perm: logic<4> ;
    // M9.A.294 (F2): walk-owner tracking for correct load-fault attribution.
    // Latched when a LOAD's MMU walk goes busy; used to deliver the fault to
    // the owner's ROB entry (not the current issue) when o_fault asserts.
    // Declared here (forward) because the rob inst above references the
    // derived inject/suppress signals.
    var walk_v_q         : logic    ;
    var walk_rob_q       : logic<5> ;
    var walk_vaddr_q     : logic<64>;
    var walk_is_store_q  : logic    ; // M9.A.299: walk started by a commit-store
    var walk_is_amo_q    : logic    ; // walk started by an AMO (non-LR) read → store/AMO fault, not load
    var walk_is_misalign_q: logic   ; // walk started by a misaligned atomic → force ACCESS fault (not page)
    var walk_pc_q        : logic<64>; // M9.3 inject-linkage probe: PC of the load that started the walk
    // Phase 11-H HLV/HLVX: a LOAD walk's per-op virt flags, latched at walk start
    // so they stay stable across the multi-cycle two-stage walk (the issuing IQ
    // slot is gated off during dmem_mmu_busy). Store walks read c_is_mem_virt
    // directly (store_drive holds it), so these only matter for load walks.
    var walk_hlv_q       : logic    ;
    var walk_hlvx_q      : logic    ;
    // M9.3 SMP: physical PTW-walk-in-progress, tracked INDEPENDENTLY of the owner
    // (walk_v_q clears on a redirect; walk_phys_q does not). walk_phys_q && !walk_v_q
    // at a fault ⇒ an ORPHAN walk (its owner was squashed mid-walk) — its fault must
    // not leak to the current valid issue via the CDB. SMP exposes this because
    // hart1's bus contention stretches walks long enough to outlive a redirect.
    var walk_phys_q      : logic    ;
    var lfault_inj_v     : logic    ; // fault delivery to walk owner this cycle
    var lfault_inj_acc   : logic    ; // PMP: the injected walk fault is an access fault
    var rob_cdb_is_lfault: logic    ; // cdb.is_lfault with mis-attribution removed
    // M5.D: medeleg needed by trap_to_s computation in commit stage.
    var csr_medeleg_w: logic<64>;
    // M5.D: SFENCE.VMA commit pulse (1-cycle), drives mmu i_sfence inputs.
    var commit_sfence_pulse: logic;
    // P9.5: SFENCE.VMA selective-flush operands (forward-declared; assigned at
    // the commit stage, consumed by the imem/dmem MMU instances above).
    var sfence_vaddr   : logic<64>;
    var sfence_asid    : logic<16>;
    var sfence_rs1_zero: logic    ;
    var sfence_rs2_zero: logic    ;
    // M8.A: FENCE.I commit pulse (forward-declared; assigned in commit stage).
    var commit_fence_i_pulse: logic;

    // M9.A.288: forward-declared so commit_irq gate can reference it
    // (the always_ff that assigns redirect_fire_q lives near line 935).
    var redirect_fire_q: logic;

    var redirect_fire: logic    ;
    var redirect_pc  : logic<64>;
    // Phase 8 S8.E: early (execute-time) branch redirect. Forward-declared so the
    // fetch engine / fetch buffer / rename gates below can reference the registered
    // pulse, while the registration always_ff (which needs the late-defined
    // early_mispredict* signals + alu_cdb) lives near the bottom of the module.
    // early_redir_fire_q is a 1-cycle pulse (mirrors redirect_fire_q): the cycle
    // AFTER a control op resolves mispredicted at execute. _idx_q is the resolved
    // branch's rob_idx (drives the partial squash + checkpoint restore); _pc_q is
    // its resolved architectural next-PC (front-end steer target).
    var early_redir_fire_q: logic            ;
    var early_redir_idx_q : logic<ROB_IDX_W> ;
    var early_redir_pc_q  : logic<64>        ;
    // S8.E re-redirect guard: asserted (per CDB lane) the cycle a control op resolves
    // an acted-on execute-time mispredict, so the ROB rewrites that op's predicted
    // next-PC to the resolved target in the CDB writeback (forward-declared; assigned
    // beside early_redir_trigger near the bottom of the module).
    var early_redir_fix0: logic;
    var early_redir_fix1: logic;
    // Unified "a redirect recovery is in flight this cycle" gate. The commit-time
    // redirect (redirect_fire = trap/mret/sret/mispredict/SC-replay/satp) is precise
    // and OUTRANKS the early redirect everywhere; early_redir_fire_q is the
    // execute-time partial recovery. Front-end steering/draining keys on either.
    let any_redirect: logic = redirect_fire || early_redir_fire_q;
    // Phase 8 S4a: forward-declared (assigned by the csr inst's o_irq_pending
    // far below) so the fetch-buffer drain gate in fb_pop / rename_fire can
    // reference it. High when an enabled+pending interrupt should be taken.
    var csr_irq_pending: logic;
    var stall_dr     : logic    ; // back-pressure from D/R
    // Phase 8 S4b: declared early so fb_pop2 (FIFO drain) can reference them
    // before their drivers in the rename stage / ROB instance below.
    var rename_fire2 : logic    ; // 2-wide rename enable (assigned at rename)
    var rob_size     : logic<8> ; // ROB occupancy (driven by the ROB o_size port)

    // M7: RVC fetch path with straddle handling.
    // Normal: pc_q is the logical PC (2-byte aligned), imem fetches the
    // word containing pc_q. The half-word at pc_q[1] is decoded as RVC
    // (bits[1:0]!=11) or 32-bit (bits[1:0]==11).
    // Straddle: when pc[1]=1 and high half is 32-bit, we need bytes from
    // the NEXT word too. We enter STRADDLE state:
    //   cycle T   : detect straddle, save high half (= low 16 bits of
    //               the 32-bit instr) into straddle_low_q, set
    //               straddle_q=1, do NOT fire if_v_q this cycle.
    //   cycle T+1 : imem now fetches pc_q+2 (next word). The instr is
    //               {rdata[15:0], straddle_low_q}. Fire if_v_q, advance
    //               pc_q by 4, clear straddle_q.
    var straddle_q    : logic    ;
    var straddle_low_q: logic<16>;
    var if_ifault_q   : logic    ; // instruction page fault latched at fetch
    var if_iacc_q     : logic    ; // PMP: instruction access fault (cause 1) at fetch
    var if_iacc_q1    : logic    ; // PMP: instruction access fault for the 2nd alloc slot
    // imem_mmu outputs forward-declared so the fetch latch can sample
    // them. Actual assignment happens at the imem_mmu inst below.
    var imem_fault_w: logic;
    var imem_acc_fault_w: logic; // PMP: instruction access fault from imem_mmu
    // Phase 11-H3d: the fetch fault was a G-stage (guest-physical) fault, and the
    // faulting guest PA — for an instruction guest-page-fault (cause 20, htval).
    var imem_gstage_w: logic;
    var imem_gpa_w   : logic<64>;
    var imem_valid_w: logic;
    var imem_paddr_w: logic<64>; // translated fetch PA (S4a.3 slot-1 same-line check)
    // M8.A: I-cache outputs (instance after imem_mmu). icache_rdata replaces
    // the combinational i_imem_rdata in the fetch path; icache_stall folds
    // into fetch_ready and the imem_mmu i_icache_stall hook. icache_rdata_next
    // is unused — v4 resolves straddles via the explicit 2-cycle re-fetch.
    var icache_rdata     : logic<32>;
    var icache_rdata_next: logic<32>;
    var icache_rdata_next_valid: logic; // Phase 8 S4: next-word present this cycle
    var icache_stall     : logic    ;
    var icache_stall_comb: logic    ; // Shape-W: combinational demand-miss for the F0 stream

    // M8.B: D-cache outputs (instance after dmem_mmu, near end of file).
    // dcache_rdata replaces the combinational i_dmem_rdata for LOAD results
    // (alu_wrap) and PTW PTE reads (dmem_mmu). dcache_stall (combinational
    // on miss/fill/done) folds into the issue/ack/commit gates BLOCKING-style
    // and into dmem_mmu's i_dcache_stall so a PTE read mid-fill holds the walk.
    // Forward-declared because alu_wrap (issue) and the gates use them before
    // the dcache inst. dcache_rdata_next feeds misaligned LOADs (B.3).
    var dcache_rdata     : logic<64>;
    var dcache_rdata_next: logic<64>;
    var dcache_stall     : logic    ;
    // Phase 8 S5.2: 2nd hit-only dcache read port (slot-1 / pipe-1 LOAD). Driver
    // signals (dc_addr2/dc_ren2/dc_load_next2) and result (dcache_rdata2 / _next /
    // dcache_hit2). Forward-declared; the dcache inst is near end of file.
    var dc_addr2          : logic<64>;
    var dc_ren2           : logic    ;
    var dc_load_next2     : logic    ;
    var dcache_rdata2     : logic<64>;
    var dcache_rdata2_next: logic<64>;
    var dcache_hit2       : logic    ;
    // Phase 8 S5.1: a LOAD issue must NOT drive the single dcache port while an
    // older STORE is firing its commit write (store_drive). Without the M2 global
    // load-block, the relaxed store-to-load gate lets a load (even one forwarding
    // from that very store) issue concurrently with the store's commit. The core
    // would then assert BOTH core_dmem_ren (load) and core_dmem_wen (store) with
    // the address pinned to the store → a conflicting dcache request that wedges
    // dcache_stall high forever (the store never completes its write, so it never
    // commits, so store_drive never drops). Declared early (assigned after
    // store_drive); gates issue ack / alu valid / core_dmem_ren below.
    var load_blocks_on_store: logic;

    // Phase 8 S6: a committing BARE-mode aligned PLAIN store (not AMO/SC, not
    // misaligned) takes the SEPARATE dcache store-drain port (i_saddr/i_swen)
    // instead of the combined i_wen path, so it coexists with a load read in
    // the same cycle. fast_store is forward-declared (assigned after the store
    // data / commit_store_fire below); rob_commit_ack reads it here and gates a
    // fast store's retire on dc_sdrain_ack (the store drained) rather than
    // dcache_stall. dc_sdrain_ack is the dcache's o_sdrain_ack (instance below).
    var fast_store   : logic;
    // PMP (Smpmp): a fast (bare-mode store-drain) store bypasses the dmem_mmu
    // i_wen path, so it needs its own commit-time physical-address PMP check.
    // fast_store_acc_fault asserts when that store's PA is denied (cause 7); it
    // suppresses the store-buffer push and drives the commit store-fault path.
    var fast_store_acc_fault: logic;
    // PMP (Smpmp): an SC (and any AMO reaching commit) writes via the dcache
    // exclusive port (c_is_amo is excluded from fast_store / sb_vm_ok), so its
    // store PA needs a dedicated commit-time WRITE PMP check (cause 7). For an
    // AMO this is redundant (the RMW read already faulted on an R/W denial via
    // dmem_mmu); for an SC it is the only write-permission check.
    var amo_commit_acc_fault: logic;
    // PMP (Smpmp): cbo.clean/flush/inval take a store access fault (cause 7) only
    // when the block has NEITHER read NOR write permission (R-or-W rule, per
    // Sail) — assigned from a dedicated R+W pmp_check pair near the other
    // commit-time PMP checks. Forward-declared so commit_store_sacc/sfault read it.
    var cbo_m_acc_fault: logic;
    var dc_sdrain_ack: logic;
    // P9.2: dcache presence checks + line-departure events (forward-declared;
    // assigned at the dcache instance, consumed by the LR/SC reservation /
    // SC-watch logic and the ROB CoRR poison ports above the instance).
    var dc_rsv_present: logic    ;
    var dc_scw_present: logic    ;
    var dc_amo_present: logic    ; // P9.3: AMO-watch line presence (chk3)
    // P9.3: declared early — the rsv / AMO-watch PA latches (always_ff
    // blocks well above the dmem_mmu inst) read the translated address.
    var dmu_dmem_addr : logic<64>;
    var dc_evict1_v   : logic    ;
    var dc_evict1_addr: logic<64>;
    var dc_evict2_v   : logic    ;
    var dc_evict2_addr: logic<64>;
    // P9.2 Phase B: dcache flush sweep handshake (FENCE.I / SFENCE.VMA /
    // satp commit — write dirty lines back so the tb-direct instruction
    // fetch / I-PTW see current DRAM). dc_flush_req is assigned at the
    // commit-gate section; dc_flush_done gates the op's retire ack.
    var dc_flush_req : logic;
    var dc_flush_done: logic;
    // Phase 8 S20: committed-store buffer. A retiring aligned plain DRAM
    // store (bare, or VM with a same-cycle TLB-hit translation) is absorbed
    // into a small FIFO and retires IMMEDIATELY — even while a dcache fill or
    // a missing bus grant would have held it at the ROB head (the probe put
    // that head-block at 156K cycles ≈ 1.8% of the N=1 boot, virtually all of
    // it stores). The buffer drains in order through the S6 store-drain port
    // in the background. sb_elig/sb_full/sb_empty are forward-declared for
    // rob_commit_ack; the buffer itself lives next to the commit store path.
    var sb_elig : logic; // head store can be absorbed (classifier)
    var sb_full : logic;
    var sb_empty: logic;
    // Block L1.c COMPLETION (SB_EMPTY_EFF): the visibility contract for the readers that
    // CANNOT forward. SB_DRAIN_SHADOW closed the window for loads by keeping the drained
    // entry in the sbf* net for one cycle. AMO/LR have no forward net at all — they keep
    // order by WAITING on sb_empty — and sb_empty goes true on the drain ack, the very
    // edge the merge lands on. So the shipped contract ("an entry stays visible until
    // every reader that could have snapshotted the array before its write has completed")
    // is currently stated more strongly than it holds. sb_empty_eff is that contract for
    // the waiters: the buffer is not "empty" while its last entry is still in the shadow.
    // At most ONE cycle later than sb_empty (sbs_v_q = sb_pop, a single-cycle pulse), so
    // it cannot deadlock, and every use of it delays in the CONSERVATIVE direction.
    // ⚠️ Deliberately NOT applied to the two RESOURCE questions, which are a different
    // question from ordering: imem_aw_grant ("is the drain port free?" — it feeds
    // sb_pop's underflow guard) and sdrain_swen ("is there anything left to drain?" — a
    // shadow entry has ALREADY drained; asserting swen for it would re-drain the line).
    // Assigned after the shadow regs exist; forward-declared here for the early consumers.
    var sb_empty_eff: logic;
    var sb_push : logic;
    var sb_vm_ok: logic; // VM arm of the classifier (TLB-hit translate ready)
    var sb_pa   : logic<64>;
    // ── R3.1: atomic store-queue — forward declarations (DEAD at ATOMIC_SQ=0) ──
    // doc/cp_r3_atomic_reorder_plan.md §6. Declared here for the same reason
    // sb_elig/sb_full/sb_empty are: the retire gate (rob_commit_ack), the FENCE gate
    // and the load-issue gate all read the queue state, and they live above the
    // entry's D-cone (which sits with the atomic commit path). The queue holds an
    // atomic-without-return whose RMW the R3.2 drain performs at the memory system;
    // it carries OPERANDS ({pa, op, src, size, aq/rl}), never a pre-computed value.
    const ATOMIC_SQ: bit = 1;
    const ASQ_N    : u32 = 1; // one in flight (allocation stays head-serialised)
    // ── L3.2c: the first-class load queue is the AUTHORITY for load poison ──
    // At 0 the queue is built, records, scans and checks itself against the ROB
    // shadow every cycle, but the ROB's commit gate still reads sh_load_poison —
    // so the whole structure is inert. At 1 the ROB reads the queue instead.
    // Passed as a param to BOTH u_rob and (below) the queue, so there is one
    // source of truth. Expect ZERO cycle change at the flip: the queue
    // recomputes the same decisions from the same inputs, and L3.1 measured the
    // whole disambiguation prize at 0.41 % anyway. This block is structural.
    const LQ_REAL  : bit = 1;
    // ── R3.2c (§6.5): drop the class's EXECUTE-TIME READ — DEAD at ASQ_NOREAD=0 ──
    // With R3.2's drain computing the value at the memory system, a without-return
    // atomic no longer needs to read anything at execute: nothing architectural
    // depends on the execute-time `old`. At ASQ_NOREAD=1 the class keeps only
    // translate + fault-check at issue (like a store) and drops out of the RFO
    // (dc_amo_read / dmem_amord_m), the 2-cycle fetch handshake (amo_fetch_hold),
    // the RMW watch (amo_watch_*/amo_poison_q) and its commit replay
    // (commit_amo_replay) — which is where the issue-side serialisation lives.
    //
    // The one thing the execute side cannot know before it translates is whether the
    // PA is CACHEABLE, and asq_class needs that (an uncacheable atomic keeps today's
    // write-through path and therefore still needs a real `old`). That case is
    // resolved with the machinery already in place instead of new fallback logic:
    // a no-read atomic that translates to an uncacheable PA arms the AMO watch
    // ALREADY POISONED, so the existing commit_amo_replay re-fetches it, and the
    // sticky amo_fread_q makes the re-executed atomic take today's proven read path.
    // Exactly one replay, no new commit-side state, no new redirect arm.
    const ASQ_NOREAD: bit = 1;
    // Forward-declared like sb_elig/asq_ld_ovl: u_alu (i_amo_noread) is instantiated
    // above the issue block where this is assigned.
    var asq_nr_iss: logic;
    var asq_nr_acc: logic; // …and it is driving its translate-only dmem request now
    var asq_valid_q: logic     [ASQ_N];
    var asq_pa_q   : logic<64> [ASQ_N]; // write address (= ac_pa_q, the read-time PA)
    var asq_src_q  : logic<64> [ASQ_N]; // rs2 operand (NOT a pre-computed `new`)
    var asq_op_q   : logic<5>  [ASQ_N]; // AMO funct5
    var asq_sz_q   : logic<3>  [ASQ_N]; // funct3 (.w/.d, and Zabha .b/.h)
    var asq_aq_q   : logic     [ASQ_N];
    var asq_rl_q   : logic     [ASQ_N];
    var asq_ld_ovl : logic            ; // issuing access's dword span may hit the entry
    var asq_dr_st_q: logic<2>         ; // drain FSM: 0=IDLE 1=RD(ownership) 2=WR(merge)
    let asq_full   : logic = asq_valid_q[0];
    let asq_empty  : logic = !ATOMIC_SQ || !asq_valid_q[0];
    // R3.2b: the drain owns the dcache port opportunistically, so while it is busy new
    // load/AMO issue is held — that is what lets the port quiesce and keeps the engine
    // from starving behind a load stream (see asq_dr_port_ok).
    let asq_dr_busy: logic = ATOMIC_SQ && asq_dr_st_q != 2'd0;
    // R3 §7.2: while an atomic is queued, NO younger store may become visible — the
    // queued RMW is older in program order and has not been performed yet. Blocking the
    // store's RETIRE alone is not enough and in fact deadlocks: a store held at the head
    // keeps driving store_drive -> dc_i_wen -> m_wen_q every cycle, so asq_dr_port_ok
    // never opens and the entry never drains. The WRITE DRIVE has to stop too, which is
    // why this gates store_drive / fast_store as well as the retire gate. Constant 0 at
    // ATOMIC_SQ=0 (asq_empty is constant 1 there).
    let asq_st_block: logic = !asq_empty;
    // S25 write-combining: entries are cache LINES (64B), not dwords. A push
    // whose PA matches a live entry's line MERGES into that entry's dword lane
    // (byte-granular strobe OR) instead of allocating — a streaming store
    // sequence collapses to one entry per line, and a full buffer still
    // accepts merging stores. sb_lmap is the per-entry lane-occupancy bitmap
    // (bit l = lane l has any byte pending); all overlap scans test
    // line-match + lane bit, which is exactly the old dword granularity.
    const SB_N: u32 = 4;
    var sb_line : logic<58> [SB_N]    ; // PA[63:6] per entry
    var sb_data : logic<64> [SB_N * 8]; // entry i lane l = [i*8+l]
    var sb_strb : logic<8>  [SB_N * 8];
    var sb_lmap : logic<8>  [SB_N]    ;
    var sb_cnt  : logic<4>            ;
    var sb_merge_ok: logic; // this cycle's push can merge (rob_commit_ack reads it)
    var sb_ld_ovl: logic            ; // issuing load's dword span may hit the buffer
    var sb_st_ovl: logic            ; // slow store's dword span may hit the buffer
    assign sb_full  = sb_cnt == 4'd4;
    assign sb_empty = sb_cnt == 4'd0;

    var c_inst_w    : logic<16>;
    var c_expanded_w: logic<32>;
    var c_illegal_w : logic    ;
    inst u_cexp: c_expander ( i_cinstr: c_inst_w, o_instr: c_expanded_w, o_illegal: c_illegal_w );
    // Phase 8 S4a.3: slot-1 RVC expander (2-wide fetch bundle, younger op).
    var c_inst_w1    : logic<16>;
    var c_expanded_w1: logic<32>;
    var c_illegal_w1 : logic    ;
    inst u_cexp1: c_expander ( i_cinstr: c_inst_w1, o_instr: c_expanded_w1, o_illegal: c_illegal_w1 );

    // ── Shape-W extract-stage source muxes (CP §14/§15 W2) — DEAD at 0 ──
    // At =1 the extraction datapath reads the WORD FIFO head instead of the combinational
    // icache read: ext_pc_q is the instruction PC, wf_data[wf_head] the dword at its dword-
    // aligned PC. ext_pc_q[2] selects the low/high 32-bit word of the head dword (the
    // icache_rdata-equivalent); the "next word" is the head dword's high word (ext_pc_q[2]=0)
    // or the next FIFO entry's low word (ext_pc_q[2]=1). At =0 every mux picks the old
    // combinational value → byte-identical. (Precise pop / same-line / fault-word corners: W3.)
    let wf_head_data     : logic<64> = wf_data[wf_head];
    let wf_head_next_data: logic<64> = wf_data[wf_head + 3'd1];
    // ── FIFO read-around bypass (CP §19, W3.5) — recover the refill BUBBLE2 ──
    // The dword F0 fetched this cycle arrives now as the REGISTERED icache_rdata (the sync-read
    // result for last cycle's pc_fetch_q present) and is about to be pushed. If it is EXACTLY the
    // dword the extract wants but the FIFO does not hold it yet (post-redirect / miss refill), read
    // it DIRECTLY here instead of waiting the extra cycle for the FIFO register round-trip. This
    // recovers ~1 cycle/taken-branch (the FIFO write→read latency) — the taken-branch refill that
    // dominates the shape-W IPC residual (§18). icache_rdata is REGISTERED under sync-read, so this
    // is register→extract, NOT the combinational read cone → CP-safe. DEAD at 0 (the whole ext_*
    // block feeds only the ICACHE_SYNC_READ arm of ic_rdata → unused at 0 → DCE). ext_bypass ⟹
    // wf_do_push (== wf_push_valid_q && !icache_stall), so the FIFO push/pop arithmetic is unaffected
    // (the pushed dword is consumed via the bypass; it still lands in the FIFO for continued extract).
    let wf_push_dword: logic<64> = if wf_push_nc_q ? {icache_rdata, f0_nc_lo_q} : {icache_rdata_next, icache_rdata};
    // §19 FIFO read-around bypass — separate const (bisect knob), default OFF for the conservative
    // §18 body. It recovers the taken-branch refill BUBBLE2 (§19: shape-W IPC +9-15% within budget).
    // Its §20.2 data-staleness race (a redirect/miss-corner arriving-icache_rdata skew → wrong-data
    // dword → RVC-extract drift) hung the N4 SMP boot DETERMINISTICALLY on the FETCH_REG=0 tree, but is
    // RESOLVED on this FETCH_REG=1 (bundle-banked) tree: the FETCH_REG pipe stage shifts the fetch/
    // redirect timing enough to dissolve the corner — bypass-ON Verilator N4 SMP boot now runs to SBI
    // shutdown (x3==0xAA, ~30M cy). Default 0 (the unambiguous N4-clean §18 2-beat body, no bypass
    // mechanism); at 1 the de-risked within-budget bypass. The ideal IPC path is recovery (b)
    // fetch-directed prefetch (BTB-driven F0), which removes the taken-branch flush entirely (BUBBLE1
    // too) and SUPERSEDES this bypass. At ICACHE_FIFO_BYPASS=0 the ext_bypass cone DCEs; DEAD at
    // ICACHE_SYNC_READ=0 regardless (ext_* feeds only the =1 arm of ic_rdata).
    const ICACHE_FIFO_BYPASS: bit = 1;
    let ext_bypass   : logic     = ICACHE_SYNC_READ && ICACHE_FIFO_BYPASS && wf_push_valid_q && !icache_stall
        && (wf_push_pc_q[63:3] == ext_pc_q[63:3]);
    // Effective head dword: the arriving push when bypassing (FIFO not yet holding it), else the FIFO
    // head. During a bypass wf_count is ~0, so the across-dword "next word" (wf_head_next_data) is
    // correctly unavailable (ext_next_valid below), and slot-1/straddle just wait a cycle.
    let ext_eff_head : logic<64> = if ext_bypass ? wf_push_dword : wf_head_data;
    let ext_word     : logic<32> = if ext_pc_q[2] ? ext_eff_head[63:32] : ext_eff_head[31:0];
    let ext_word_next: logic<32> = if ext_pc_q[2] ? wf_head_next_data[31:0] : ext_eff_head[63:32];
    // (b) B1: head+1 is the SEQUENTIAL successor of head (dword contiguity). At
    // ICACHE_FETCH_DIRECTED=0 F0 always streams +8 so this holds by construction; at =1 an FTB
    // redirect can push a NON-sequential head+1 (a prefetched branch target). The across-dword
    // next-word read (ext_word_next = wf_data[head+1], used by a dword-boundary straddle and by
    // slot-1) MUST NOT consume such an entry — it would decode a WRONG high half / slot-1. DEAD
    // (const-masked) at ICACHE_FETCH_DIRECTED=0 → byte-identical to shape-W.
    let head1_seq: logic = wf_pc[wf_head + 3'd1][63:3] == wf_pc[wf_head][63:3] + 61'd1;
    // Next word present: within the head dword (ext_pc_q[2]=0) it always is; across the dword
    // boundary (ext_pc_q[2]=1) the next FIFO entry must be buffered (wf_count >= 2) AND — under
    // fetch-directed prefetch — be the sequential successor (else the straddle/slot-1 stalls and
    // f0_diverged re-fetches this dword sequentially; see the recovery below).
    // f2.4-fix: the across-dword next word (ext_word_next = wf_data[head+1]) is only the SLOT-0
    // dword's successor when head == ext_pc_q's dword (ext_head_match). During an ext_bypass the
    // slot-0 comes from the ARRIVING push (wf_push_dword), NOT wf_data[head] — head points at an
    // OLDER FIFO entry, so wf_data[head+1] is NOT ext_pc_q's next dword and head1_seq (comparing
    // head vs head+1) is irrelevant to it. The old code relied on wf_count~0 during a bypass to
    // fail the `wf_count >= 2` gate, but under FTB_OVERRIDE the FTB-follow leaves stale older
    // entries so a bypass can fire with wf_count>=2 — then the across-dword straddle/slot-1 read a
    // WRONG dword (the boot `slli ra,ra,29` garbage-ra leak). Require !ext_bypass so the across-dword
    // read only consumes head+1 when head is ext_pc_q's dword; the straddle/slot-1 just wait a cycle
    // during a bypass (its real next dword is the push's not-yet-fetched successor). Gated on
    // FTB_OVERRIDE (folds away at 0 → byte-identical; the lagging-head bypass only arises under the
    // FTB-follow timing, variant-A/HEAD boot clean without it).
    let ext_next_valid: logic = if ext_pc_q[2] ? (wf_count >= 4'd2 && (!ICACHE_FETCH_DIRECTED || head1_seq) && (!FTB_OVERRIDE || !ext_bypass)) : 1'b1;
    let ic_pc         : logic<64> = if ICACHE_SYNC_READ ? ext_pc_q      : pc_q;
    let ic_rdata      : logic<32> = if ICACHE_SYNC_READ ? ext_word      : icache_rdata;
    let ic_rdata_next : logic<32> = if ICACHE_SYNC_READ ? ext_word_next : icache_rdata_next;
    let ic_rdata_nv   : logic     = if ICACHE_SYNC_READ ? ext_next_valid : icache_rdata_next_valid;

    // Halfword pick for the non-straddle cases.
    let curr_hw       : logic<16> = if ic_pc[1] ? ic_rdata[31:16] : ic_rdata[15:0];
    let curr_is_rvc   : logic     = curr_hw[1:0] != 2'b11;
    let needs_straddle: logic     = !straddle_q && ic_pc[1] && !curr_is_rvc;
    // Phase 8 S7: single-cycle straddle resolution. A 32-bit instr at a halfword
    // boundary (pc_q[1], non-RVC) normally takes a 2-cycle re-fetch (straddle_q),
    // costing a fetch bubble (fetch_ready=0 the prep cycle). When the NEXT 32-bit
    // word is already present in the icache window this cycle (icache_rdata_next_valid)
    // AND in the same 4KB page (so the PA+4 word IS the virtual successor under
    // Sv39 — a cross-page straddle keeps the 2-cycle path, which re-translates
    // pc_q+2), assemble the instr in ONE cycle from {next_lo, curr_hi} and deliver
    // now (no bubble). This is the same {icache_rdata_next, icache_rdata} window the
    // slot-1 path already reads. RVC-mixed code with misaligned 32-bit instrs (e.g.
    // memcpy: 3 of 5 loop ops straddle → 37% i-fetch idle) is the big win.
    // At =1 the straddle high word is the next WORD FIFO dword — F0 fetched it with its own
    // translation, so a cross-page straddle needs NO re-translate (unlike the =0 2-cycle path);
    // "same page" is vacuously true (availability is ic_rdata_nv = ext_next_valid).
    let straddle_same_page : logic     = if ICACHE_SYNC_READ ? 1'b1 : (ic_pc[11:2] != 10'h3ff);
    let straddle_oneshot   : logic     = needs_straddle && ic_rdata_nv && straddle_same_page;
    let needs_straddle_slow: logic     = needs_straddle && !straddle_oneshot;
    let straddle1_instr    : logic<32> = {ic_rdata_next[15:0], ic_rdata[31:16]};
    assign c_inst_w = curr_hw;

    // Straddled 32-bit: low half saved last cycle + new fetch's low half.
    let straddled_instr: logic<32> = {ic_rdata[15:0], straddle_low_q};

    // Choose final 32-bit instr fed to decode.
    let fetched_instr: logic<32> = if straddle_q ?
        straddled_instr
    : if straddle_oneshot ?
        straddle1_instr
    : if curr_is_rvc && c_illegal_w ?
        32'h0000_0000
    : if curr_is_rvc ?
        c_expanded_w
    :
        ic_rdata
    ; // pc[1]=0 + 32b (or 1-cycle straddle)
    let pc_advance   : logic<64> = if straddle_q ? 64'd4 : if curr_is_rvc ? 64'd2 : 64'd4;

    // Fetch ready to deliver an instr to IF/ID this cycle. Under Sv39 the
    // imem_mmu only asserts valid (or fault) once the PT walk completes;
    // gate the latch on it so we don't advance with garbage. In Bare mode
    // imem_valid_w == i_req == 1, so no slowdown.
    // M8.A: also hold delivery while the icache is filling a miss. On a fault
    // i_ren=0 (no lookup) so icache_stall=0 — the fault still delivers.
    // SvPMP: a PTE-read PMP denial faults the walk as an instruction ACCESS fault
    // (imem_acc_fault_w) with neither valid nor page-fault set (the walk never
    // completed) — include it so the fetch advances and delivers cause 1 rather
    // than stalling forever on a walk that can never produce a translation.
    // ICACHE_SYNC_READ (core-local mirror of icache.veryl's const — flip together) is
    // declared up in the shape-W scaffold block (it now gates the W2 extract-source muxes,
    // which precede this point). Shape-N held fetch delivery a cycle after pc_q settled;
    // shape W (CP §14) supersedes that with the F0 stream + word FIFO + extract stage.
    // A fetch FAULT (imem page/access fault) needs no icache read (i_ren=0), so it
    // must deliver without waiting for the read to settle — else it hangs forever
    // (ic_rd_settled_q never sets: imem_valid_w=0 on a fault). The read-latency
    // stall only applies to a real lookup (hit/miss).
    let ic_rd_ok: logic = !ICACHE_SYNC_READ || ic_rd_settled_q || imem_fault_w || imem_acc_fault_w;
    // ── Shape-W extract deliver gate (=1) ── The WORD FIFO head dword is present AND is
    // ext_pc_q's dword (post-redirect refill / F0 read latency hold it low until the dword
    // lands = the redirect/miss bubble). Faults ride the FIFO entry (delivered in order).
    let ext_head_dw   : logic<64> = {ext_pc_q[63:3], 3'b000};
    let ext_head_match: logic     = ICACHE_SYNC_READ && (wf_count >= 4'd1) && (wf_pc[wf_head] == ext_head_dw);
    // §19 bypass: the wanted dword is available either from the FIFO head OR from this cycle's
    // arriving push (read-around). ext_bypass ⟹ !ext_head_match in practice (a bypass fires only
    // when the FIFO has drained to the fetch point), but they are OR'd for the deliver gate.
    let ext_head_avail: logic     = ext_head_match || ext_bypass;
    // Fault bits: at =1 from the FIFO head entry (or the bypassed arriving push); at =0 the live
    // imem_mmu outputs. A faulting dword can be bypassed too (the fault delivers a cycle earlier).
    let ic_ifault : logic     = if ICACHE_SYNC_READ ? (if ext_bypass ? wf_push_ifault_q : (ext_head_match && wf_ifault[wf_head])) : imem_fault_w;
    let ic_iacc   : logic     = if ICACHE_SYNC_READ ? (if ext_bypass ? wf_push_iacc_q   : (ext_head_match && wf_iacc[wf_head]))   : imem_acc_fault_w;
    let ic_gstage : logic     = if ICACHE_SYNC_READ ? (if ext_bypass ? wf_push_gstage_q : (ext_head_match && wf_gstage[wf_head])) : imem_gstage_w;
    let ic_gpa    : logic<64> = if ICACHE_SYNC_READ ? (if ext_bypass ? wf_push_gpa_q : wf_gpa[wf_head]) : imem_gpa_w;
    // Deliver: =1 gates on the FIFO head OR the §19 bypass (a fault entry delivers regardless of
    // straddle); =0 keeps the old combinational-fetch readiness.
    let fetch_ready: logic = if ICACHE_SYNC_READ ?
        (ext_head_avail && (ic_ifault || ic_iacc || !needs_straddle_slow))
      : (!needs_straddle_slow && (imem_valid_w || imem_fault_w || imem_acc_fault_w) && !icache_stall && ic_rd_ok);
    // The =0 straddle-prep holds pc_q + advances fetch_vaddr to pc_q+2 for the high word.
    // At =1 there is no such prep — the high word is a fetch-ahead FIFO dword (the straddle
    // just waits via needs_straddle_slow), so ic_straddle_prep is OFF.
    let ic_straddle_prep: logic = !ICACHE_SYNC_READ && needs_straddle_slow && (imem_valid_w || imem_fault_w) && !icache_stall && ic_rd_ok;

    // ============================================================
    // Phase 8 M2: branch prediction (BTB + bimodal BHT) — frontend redirect.
    // Looked up combinationally on pc_q (= the instr delivered this cycle).
    // predicted_taken steers the next fetch to btb_target with no bubble; a
    // wrong prediction is caught at commit (c_bp_mispredict) and flushed. The
    // tables are trained only by committed ops (signals near the commit stage),
    // so wrong-path fetches never pollute them. Prediction is applied only in
    // the delivery arm of the fetch latch below (never during straddle-prep).
    // ============================================================
    var btb_hit    : logic    ;
    var btb_target : logic<64>;
    var btb_is_cond: logic    ;
    var btb_is_call: logic    ;
    var btb_is_ret : logic    ;
    var btb_is_ind : logic    ; // S18: non-return JALR kind
    var bht_taken  : logic    ;
    // M4 gshare: speculative + committed global history. The lookup index folds
    // the speculative history into the low PC index bits. The committed history
    // tracks actual conditional-branch outcomes; on a flush spec <- committed.
    var spec_ghr     : logic<13>; // S13.3: widened to the full gshare index
    var committed_ghr: logic<13>;
    let bht_lk_index : logic<13> = ic_pc[13:1] ^ spec_ghr;
    // S22 TAGE-lite: tagged tables over geometrically longer history folds
    // override the base BHT direction when one hits (see tage.veryl). The
    // long history twins mirror spec_ghr/committed_ghr exactly (same shift
    // events, same flush restore) at TAGE's longest fold width.
    var spec_ghr_l     : logic<55>;
    var committed_ghr_l: logic<55>;
    var tage_hit    : logic;
    var tage_taken  : logic;
    var tage_hit2   : logic;
    var tage_taken2 : logic;
    let s22_tage_en : logic = 1'b1;
    // ── f2.6: TAGE stays COMBINATIONAL at Stage-A (TAGE_STAGEA) — DEAD at 0 ──
    // The 2026-08-01 decomposition put 76 % of the authority-inversion deficit in ONE mechanism:
    // ~1.0 cycle of front-end idle per taken control transfer, because Stage-A has no next-target.
    // Option (B)'s L0 attacks exactly that, and it under-delivered for a reason that is fixable
    // rather than fundamental: its gshare-less PC-bimodal disagreed with the full TAGE on
    // context-dependent conditionals, so an L0-taken branch the full predictor called not-taken paid
    // TWO bubbles instead of one (the coremark regression).
    //
    // The lever: TAGE is NOT an SRAM-shaped array. It is deliberately a register file and is never
    // inferred as SRAM (sram_inventory.md:111,156) — `TAGE_SYNC_READ` was added in F1 only to give
    // all four predictors a uniform scaffold, NOT because SRAM realism demands it. So TAGE may stay
    // combinational at Stage-A with the structural claim fully intact, and then the L0 can use the
    // REAL direction the full predictor will use — the disagreement disappears by construction.
    //
    // The catch this costs: a combinational TAGE read is aligned to Stage-A's ext_pc_q, NOT to the
    // bundle draining at Stage-B. Stage-B must therefore replay the value captured at produce
    // (a_tage_*, aligned to a_pc by construction); the clocked BHT fallback is already aligned. That
    // capture also freezes TAGE through a skid hold, i.e. it extends 3a.6's hold-drift fix to it.
    // Requires TAGE_SYNC_READ=0 at the flip. DEAD at 0: every mux folds to the live output and the
    // capture regs are reset-only → DCE.
    const TAGE_STAGEA: bit = 0;
    let tage_hit_sb   : logic = if TAGE_STAGEA ? a_tage_hit    : tage_hit;
    let tage_taken_sb : logic = if TAGE_STAGEA ? a_tage_taken  : tage_taken;
    let tage_hit2_sb  : logic = if TAGE_STAGEA ? a_tage_hit2   : tage_hit2;
    let tage_taken2_sb: logic = if TAGE_STAGEA ? a_tage_taken2 : tage_taken2;
    // Final direction prediction (slot-0): TAGE provider, else base gshare.
    let cond_taken0: logic = if s22_tage_en && tage_hit_sb ? tage_taken_sb : bht_taken;
    // M3 RAS speculative top (combinational).
    var ras_spec_top  : logic<64>;
    var ras_spec_valid: logic    ;
    // S18 iBTB lookup: history-hashed indirect targets. The index folds the
    // gshare index slice with the indirect PATH history (recent indirect
    // TARGETS) — a state-machine dispatch (`jr` through a jump table) keys
    // its next target on the current state, which IS the previous indirect
    // target; cond-branch GHR alone barely discriminates those (S18 probe:
    // −12% only). spec_ind_hist folds each predicted indirect target at
    // fetch and restores from committed_ind_hist on any flush (same
    // approximation as spec_ghr); the committed twin folds actual targets at
    // commit, so a committing op's PRE-update committed_ind_hist equals its
    // fetch-time spec_ind_hist (older indirects all committed; a mispredicted
    // one squashes this op) — training needs no extra ROB-carried state.
    var spec_ind_hist     : logic<9>;
    var committed_ind_hist: logic<9>;
    var ibtb_hit    : logic    ;
    var ibtb_target : logic<64>;
    var ibtb_hit2   : logic    ;
    var ibtb_target2: logic<64>;
    // ── F1 option (B) → f2.19: the Stage-A FAST PREDICTION path (PRED_L0_FAST) — DEAD at 0 ──
    // Under PRED_OVERRIDE the full BTB/BHT/TAGE are CLOCKED and resolve at Stage-B, so a bare
    // Stage-A advances sequentially and pays a +1 override bubble on every taken transfer. This
    // const enables a Stage-A first guess so it does not.
    //
    // That guess USED to come from l0pred: a 32-entry uBTB + 128-entry bimodal, async-read, FOUR
    // lookup ports, in the fetch path — the exact non-SRAM shape this plan exists to remove.
    // f2.19 DELETED it. The guess now comes entirely from the run-ahead block descriptor
    // (bd_taken0 / bd_taken1, below): 4096 dword entries, tagged, CLOCKED, 1R1W-shaped, read at
    // pc_pred with the FTQ absorbing the latency. See doc/cp_predictor_sram_plan.md f2.16c/f2.17
    // for how the descriptor took over the L0's remaining work, and f2.18 for what the deletion
    // costs. PRED_L0_FAST now gates the descriptor's Stage-A consumption and the l0_redir re-steer;
    // the l0_* naming is kept where it refers to that PATH rather than to the deleted module.
    const PRED_L0_FAST: bit = 1;
    // ── f2.15e: THE RUN-AHEAD BLOCK PREDICTION, CONSUMED ── DEAD at FTQ_DESC=0 ──
    // This is the L0's job — give Stage-A a first guess so it does not advance sequentially past a
    // taken transfer and pay a Stage-B override bubble — done from a fundamentally better source. The
    // L0 is a 32-entry ASYNC register file fighting a 4096-entry BTB, and the f2.15 census showed the
    // whole override population is that coverage gap (33 false positives and ZERO target errors over
    // a run: when the L0 knows a branch it is essentially never wrong). blkpred is 4096 dword entries
    // and CLOCKED, read at pc_pred with the FTQ absorbing the latency — the structure f2.14 proved
    // this core was missing, since every other predictor is indexed by the extract pointer and so can
    // never be read early no matter how deep the queue.
    //
    // Two properties make consuming it strictly cheaper than the L0, not merely wider. The producer
    // ALREADY FETCHED the target (it steered pc_pred there), so a descriptor-sourced take needs no
    // WORD-FIFO flush and no run-ahead re-seed — the target dword is sitting at head+1 and the normal
    // ext_pop walks straight into it. And the descriptor carries the branch's exact halfword OFFSET,
    // so extract knows WHICH slot the transfer belongs to instead of inferring it.
    // PRED_L0_FAST is required, not incidental: the descriptor steers through ext_l0_next and is
    // reconciled at Stage-B through a_l0_*/sb_disagree0, both of which exist only in that arm.
    let bd_valid : logic     = FTQ_DESC && PRED_L0_FAST
        && (if ext_bypass ? wf_push_d_taken_q : (ext_head_match && wf_d_taken[wf_head]));
    let bd_off   : logic<2>  = if ext_bypass ? wf_push_d_off_q    : wf_d_off[wf_head];
    let bd_why   : logic<3>  = if ext_bypass ? wf_push_d_why_q    : wf_d_why[wf_head];
    let bd_target: logic<64> = if ext_bypass ? wf_push_d_target_q : wf_d_target[wf_head];
    // Slot-0 sits at this dword's halfword offset ic_pc[2:1]; a straddling delivery is excluded here
    // and at the train, since a transfer whose own high half lives in the next dword cannot be the
    // block's exit (F0's jump would skip the dword extract still needs to decode it).
    // f2.20: a descriptor whose exit is a RETURN (bd_why == 7) carries no usable target — extract
    // resolves it against its own speculative RAS, exactly as the deleted L0 did (l0_use_ras). It
    // declines when the RAS is empty, which is the same fallback the L0 had.
    let bd_ret   : logic     = FTQ_DESC && (bd_why == 3'd7);
    let bd_taken0: logic     = bd_valid && !straddle_q && (bd_off == ic_pc[2:1])
        && (!bd_ret || ras_spec_valid);
    // The effective Stage-A prediction: the descriptor where it speaks, the L0 elsewhere (it still
    // owns conditionals, which the tail-slot-only descriptor does not describe).
    // The effective Stage-A prediction. Descriptor-only since f2.19 (the L0 that used to supply
    // the other arm is gone), so it folds to nothing at FTQ_DESC=0 exactly as the whole arm does.
    let l0e_taken : logic     = FTQ_DESC && bd_taken0;
    let l0e_target: logic<64> = if bd_ret ? ras_spec_top : bd_target;
    // f2.9: slot-1 conditional direction, from the L0's own bimodal read on the
    // slot-1 PC (port 2). Same strong-only rule as slot 0 — see o_bimodal_strong in
    // the deleted l0pred for why an unconfident fast direction is worse than declining. TAGE is
    // not consulted here: TAGE_STAGEA's Stage-A read is slot-0's.
    // A conditional branch is predicted taken per the direction predictor
    // (TAGE over base BHT); JAL/JALR/call/ret (is_cond=0) are predicted
    // taken on any BTB hit.
    let predicted_taken: logic = btb_hit && (!btb_is_cond || cond_taken0);
    // M3: a return's target comes from the RAS (the BTB stores the previous
    // caller's return addr, usually wrong); fall back to the BTB target when the
    // RAS is empty. A wrong target is caught at commit (c_bp_mispredict).
    // S18: a non-return JALR (jump table / ops-table call) takes its target
    // from the iBTB when the (PC, history) entry hits; the BTB's last-target
    // is the fallback. Returns keep the RAS.
    let pred_use_ras   : logic     = btb_hit && btb_is_ret && ras_spec_valid;
    let pred_use_ibtb  : logic     = btb_hit && btb_is_ind && !pred_use_ras && ibtb_hit;
    let pred_target    : logic<64> = if pred_use_ras ? ras_spec_top : if pred_use_ibtb ? ibtb_target : btb_target;
    let pred_next_pc_bp: logic<64> = if predicted_taken ? pred_target : ic_pc + pc_advance;

    // ============================================================
    // Phase 8 S4a.3: slot-1 (younger op of a 2-wide fetch bundle). Extracted
    // from the 64-bit window {icache_rdata_next, icache_rdata} when slot-0 is a
    // CLEAN non-straddle delivery (Option B: the proven straddle_q path is left
    // 100% intact — a straddling/faulting/taken slot-0 delivers alone). slot-1
    // is built here but its delivery is gated off in S4a.3-a (slot1_valid_gate=0)
    // and flipped on in S4a.3-b. The 64-bit window has 4 halfwords; with slot-0
    // non-straddling the slot-1 start index b1 is 1 or 2 (never crosses out of
    // the window or into a different page — slot-1 using the next word is
    // restricted to same-line, hence same page as slot-0).
    let fw_hw1: logic<16> = ic_rdata[31:16];     // window halfword 1
    let fw_hw2: logic<16> = ic_rdata_next[15:0]; // window halfword 2
    let fw_hw3: logic<16> = ic_rdata_next[31:16];// window halfword 3
    // ── Block W2a: admit slot-1 on a ONE-SHOT straddle (DEAD scaffold) ──
    // The W2.0 census (doc §Block W) prices the straddle exclusion at 2,035,379 boot
    // cycles of lost slot-1 — three times the predicted-taken term and the single
    // largest front-end item. `straddle_oneshot` is the case where the next dword is
    // ALREADY valid and same-page, so slot-0 costs no extra cycle; slot1_eligible
    // kills slot-1 anyway.
    // The real reason is HERE, not in the predicate: a straddling slot-0 (ic_pc[1] &&
    // 32-bit) puts slot-1 at window halfword **3**, and the s1_hw mux only ever
    // handled b1 ∈ {1,2}. Extend it — and note the limit that survives: slot-1's OWN
    // halfword (hw3) is inside the 64-bit window, but its SECOND halfword would be
    // hw4, one past the end. So a straddle may deliver slot-1 only when slot-1 is
    // RVC. In RVC-dense kernel code that is most of the population; a 32-bit slot-1
    // there still waits, which is exactly today's behaviour.
    // DEAD at 0: every W2A term folds away and b1==3 cannot reach slot-1 anyway
    // (slot1_eligible still excludes straddle_oneshot) → bit-identical.
    const W2A_STRADDLE_SLOT1: bit = 1;
    // b1 = halfword index where slot-1 starts (clean case: curr_is_rvc == slot-0
    // is RVC). pc[1]=0,rvc→1 / pc[1]=0,32b→2 / pc[1]=1,rvc→2 (pc[1]=1,32b is a
    // straddle, excluded by slot1_eligible).
    let s1_b1: logic<2> = (if ic_pc[1] ? 2'd1 : 2'd0) + (if curr_is_rvc ? 2'd1 : 2'd2);
    // W2a: b1==3 (straddling slot-0) reads window halfword 3. s1_hw_next is left at
    // fw_hw3 there on purpose — it would be hw4, outside the window, and an s1_b1==3
    // slot-1 is admitted ONLY when it is RVC (s1_past_win below), so s1_raw32's high
    // half is never consumed in that case.
    let s1_hw     : logic<16> = if s1_b1 == 2'd1 ? fw_hw1 : if W2A_STRADDLE_SLOT1 && s1_b1 == 2'd3 ? fw_hw3 : fw_hw2; // b1∈{1,2}, +3 at W2a
    let s1_hw_next: logic<16> = if s1_b1 == 2'd1 ? fw_hw2 : fw_hw3; // halfword b1+1
    let s1_is_rvc : logic     = s1_hw[1:0] != 2'b11;
    assign c_inst_w1 = s1_hw;
    let s1_raw32: logic<32> = {s1_hw_next, s1_hw};
    let s1_instr: logic<32> = if s1_is_rvc && c_illegal_w1 ?
        32'h0000_0000
    : if s1_is_rvc ?
        c_expanded_w1
    :
        s1_raw32
    ;
    let s1_pc: logic<64> = ic_pc + pc_advance; // = ic_pc + slot-0 length (clean case)
    let s1_len: logic<64> = if s1_is_rvc ? 64'd2 : 64'd4;
    // slot-1 prediction via the BTB/BHT 2nd read ports (lookup on s1_pc).
    var btb_hit2    : logic    ;
    var btb_target2 : logic<64>;
    var btb_is_cond2: logic    ;
    var btb_is_call2: logic    ;
    var btb_is_ret2 : logic    ;
    var btb_is_ind2 : logic    ; // S18
    var bht_taken2  : logic    ;
    let bht_lk_index1   : logic<13> = s1_pc[13:1] ^ spec_ghr;
    // S22: slot-1 final direction (TAGE 2nd port over base BHT 2nd port).
    let cond_taken1     : logic     = if s22_tage_en && tage_hit2_sb ? tage_taken2_sb : bht_taken2;
    let predicted_taken1: logic     = btb_hit2 && (!btb_is_cond2 || cond_taken1);
    let pred_use_ras1   : logic     = btb_hit2 && btb_is_ret2 && ras_spec_valid;
    let pred_use_ibtb1  : logic     = btb_hit2 && btb_is_ind2 && !pred_use_ras1 && ibtb_hit2;
    let pred_target1    : logic<64> = if pred_use_ras1 ? ras_spec_top : if pred_use_ibtb1 ? ibtb_target2 : btb_target2;
    let pred_next_pc1   : logic<64> = if predicted_taken1 ? pred_target1 : s1_pc + s1_len;
    // slot-1 delivery eligibility. slot-0 must be a clean (non-straddle, non-
    // fault) delivery that was NOT predicted taken (else slot-1 is wrong-path).
    // F1 order-item-3 (A): at PRED_OVERRIDE=1 there is NO Stage-A prediction (predicted_taken
    // here reads the STALE clocked output), so slot-1 is produced optimistically (assume slot-0
    // not-taken) and SQUASHED at Stage-B if slot-0 resolves taken. Drop the !predicted_taken gate
    // then. Byte-identical at 0 (the term folds back in via `!PRED_OVERRIDE`).
    // F1 option (B): with the L0 fast path, a taken slot-0 IS known at Stage-A (l0_taken),
    // so slot-1 (past the taken branch) is ineligible again — no need for the optimistic
    // produce+squash. Without L0 (PRED_L0_FAST=0) keep the PRED_OVERRIDE optimistic path.
    let slot1_pred_ok : logic = if PRED_OVERRIDE ? (if PRED_L0_FAST ? !l0e_taken : 1'b1) : !predicted_taken;
    // W2a: a one-shot straddle no longer kills slot-1 outright — only when slot-1
    // would need window halfword 4 (i.e. it is a 32-bit op at b1==3). The SLOW
    // straddle (straddle_q) stays excluded untouched: that path re-fetches, so the
    // window slot-1 would be extracted from is not the one it will run in.
    let s1_past_win  : logic = (s1_b1 == 2'd3) && !s1_is_rvc;
    let straddle_blk : logic = if W2A_STRADDLE_SLOT1 ? (straddle_oneshot && s1_past_win) : straddle_oneshot;
    let slot1_eligible: logic = fetch_ready && !straddle_q && !straddle_blk && !ic_ifault && slot1_pred_ok;
    // f2.9 SLOT-1 L0 FAST PATH. The front end is 2-wide but the L0 only ever looked
    // up slot 0, so a taken SLOT-1 branch paid a Stage-B override bubble
    // unconditionally — measured as 67 % (dhrystone) / 68 % (coremark) of ALL
    // override bubbles, far more than the L0's own slot-0 coverage gap. Give Stage-A
    // the same 0-bubble first guess for slot 1: originally from the l0pred's second
    // async read port (on s1_pc), advance there, and let the clocked full predictor
    // override at Stage-B only on DISAGREEMENT — exactly the slot-0 protocol.
    //
    // RETURNS and INDIRECTS are deliberately EXCLUDED. A slot-1 return would have to
    // consult the RAS at Stage-A in the same cycle slot-0 may itself push/pop it,
    // dragging RAS ordering into the fast path for a measured 5.6 % / 6.8 % of the
    // slot-1 population; indirects the L0 never predicts anyway. What remains — the
    // direct targets — is 53 % / 78 % of that population, so the simple version gets
    // nearly all of the prize with none of the ordering risk.
    //
    // Mutually exclusive with l0_taken by construction (slot1_pred_ok = !l0_taken
    // already gates slot1_eligible), so Stage-A never has two fast targets at once.
    // DEAD at 0: l0_taken1 const-false → every use below folds away byte-identically.
    const L0_SLOT1: bit = 1;
    // (l0_taken1 itself is defined below, next to fb_free — it has to be gated on the
    // SAME condition that actually delivers slot 1, and that needs fb_free.)
    // slot-1 needs the next word (rdata_next) unless it is an RVC sitting in the
    // slot-0 word (b1==1 && rvc). Using the next word requires it be in the SAME
    // cache line (→ same page as slot-0, so slot-1's fetch can't fault separately).
    // W2a: b1==3's own halfword lives in ic_rdata_next too, so it takes the same
    // "next word must be valid AND same-line" gate the b1==2 case already takes.
    let s1_needs_next: logic = (s1_b1 == 2'd2) || (s1_b1 == 2'd1 && !s1_is_rvc)
        || (W2A_STRADDLE_SLOT1 && s1_b1 == 2'd3);
    let s1_same_line : logic = imem_paddr_w[5:2] != 4'hf;
    // S4a.3-b: slot-1 delivery is LIVE. The slot-1 datapath (extraction, dual
    // BTB/BHT lookup, 2-push FIFO, 2-bit gshare, dual RAS) feeds the FIFO so the
    // back-end (2-issue since S3.b) drains 2 ops/cycle when operands allow.
    //
    // Enabling it surfaced a pre-existing lost-wakeup bug that S3.a/b had only
    // narrowly avoided: iq_fp's integer-source wakeup (for int→fp ops — FCVT.d.w,
    // FMV.d.x, …) snooped only CDB lane 0. With slot-1 live the IQ fills denser so
    // pipe-1 (lane 1, alu_cdb2) issues far more often, and an int→fp op whose
    // integer source landed on lane 1 never woke → it stalled at the ROB head
    // forever. Symptom: rv64u{f,d}-{fcvt,recoding} (int→fp-dense) ran out their
    // cycle budget with tohost=0; fcvt_w (fp→int, no integer source) passed. Fix:
    // iq_fp now snoops BOTH int CDB lanes (i_int_cdb / i_int_cdb2 = alu_cdb2),
    // mirroring iq_int. (The earlier hypothesis — gate pipe-1 ack on fpu_cdb —
    // was wrong: it would not have closed the lost wakeup.) 152/0 with slot-1 on.
    let slot1_valid_gate: logic = 1'b1;
    let slot1_valid: logic = slot1_valid_gate && slot1_eligible
        && (!s1_needs_next || (s1_same_line && ic_rdata_nv));

    // Phase 8 S4a: fetch buffer push/pop/full control.
    //   fb_pop   = rename drains the head this cycle (== rename_fire below;
    //              MUST stay identical or a popped record is never renamed).
    //   fb_full  = no room for a push (full and not simultaneously draining).
    //   fb_push  = the fetch engine delivers a record into the FIFO this cycle.
    // fb_pop depends only on registered state (if_v_q/fb_count) + external
    // resource readiness, so fb_full→fb_push has no combinational cycle.
    // !csr_irq_pending: see the interrupt-drain note at rename_fire — a pending
    // interrupt halts rename so the ROB drains to empty and commit_irq can fire.
    let fb_pop : logic = if_v_q && !stall_dr && !any_redirect && !csr_irq_pending;
    // Phase 8 S4b: slot-1 drain == rename_fire2 (defined below). rename_fire2
    // implies rename_fire (which is identical to fb_pop), so fb_pop2 is only ever
    // set when fb_pop is — the FIFO never drains slot-1 without slot-0.
    let fb_pop2: logic = rename_fire2;
    let fb_full: logic = fb_count == 4'd8 && !fb_pop;
    // Free slots available for a push this cycle (accounts for a simultaneous
    // drain freeing slots). fb_count 0..8, fb_pop/fb_pop2 0..1, so fb_free 0..8.
    let fb_free : logic<4> = (4'd8 - fb_count) + (if fb_pop ? 4'd1 : 4'd0) + (if fb_pop2 ? 4'd1 : 4'd0);
    // f2.9 slot-1 L0 take (see the L0_SLOT1 comment above). Gated on the EXACT
    // condition under which slot 1 is actually delivered — `fb_push1` minus its
    // `fb_push0` term, i.e. slot1_valid AND fetch-buffer room for two. Gating on the
    // weaker `slot1_eligible` is WRONG, and was measured to be: Stage-A advanced to
    // slot-1's target on a produce that pushed only slot 0 (no room, or the
    // cross-line s1_needs_next case), so slot 1 itself was never delivered and the
    // instruction was SKIPPED — dhrystone retired 264336 instead of 264834. Kept
    // produce-INDEPENDENT (like l0_taken) so ext_eff_next's every-cycle consumers
    // (f0_diverged / ext_exp_next) see the same shape they always did.
    let l0_slot1_deliv: logic = slot1_valid && (fb_free >= 4'd2);
    // f2.15e: the descriptor covers slot 1 with the SAME entry — a block predictor predicts the first
    // taken transfer in the dword and does not care which slot it lands in, which is why the f2.15
    // census could count the ~8020 slot-1 overrides (47 % of the population) as covered for free
    // rather than needing a second fast path the way the L0 did (f2.10's second async port).
    // L0_SLOT1 gates it for the same reason PRED_L0_FAST gates bd_valid: sb_ovr_taken1 and
    // sb_override_target only consult a_l0_taken1 under that const, so a slot-1 take made without it
    // would go unreconciled at Stage-B.
    let bd_taken1s: logic     = bd_valid && L0_SLOT1 && !l0e_taken && l0_slot1_deliv && !straddle_q
        && (s1_pc[63:3] == ic_pc[63:3]) && (bd_off == s1_pc[2:1]);
    // ── f2.16b: SLOT 1 IN THE NEXT DWORD ── DEAD at BD_SLOT1_NEXT=0 ──
    // The clause above is `s1_pc[63:3] == ic_pc[63:3]`, and f2.16b measured what it costs. Of the
    // 13504 L0-only Stage-A takes on dhrystone, 9461 (70 %) are slot-1 conditionals; ALL 9461 sit
    // at halfword 0, i.e. slot-0 ends exactly on the dword boundary and slot 1 is the FIRST
    // instruction of the next dword. The same-dword clause excludes every one of them by
    // construction — the descriptor that describes slot 1 is not the head's, it is head+1's.
    //
    // And it is already there: head+1 is slot-1's dword in 9461 of 9461, its descriptor records a
    // taken exit in 8964, and the exit offset matches slot 1 in 8964 of those 8964. So 66 % of the
    // whole residual is a correct prediction sitting one FIFO entry along, unread.
    //
    // The dword-match test is what makes this sound rather than a guess about FIFO geometry: the
    // entry is used ONLY when its stored PC is slot-1's own dword, so a bypass, a flush or a
    // non-sequential head+1 (the f2.2 ext_ftb_follow case) simply fails the test and falls back.
    //
    // ⚠️ The FREE-TAKE form of this (BDN_FREE_POP=1, below) was root-caused, fixed, and then found
    // not to be worth having. f2.16c keeps the take and drops the free-take ambition, which is
    // cycle-neutral and moves 66 % of the L0's remaining work onto blkpred — so THIS const is on
    // and BDN_FREE_POP is the one that stays off. The history, because it is easy to re-derive:
    //
    // (1) The bug. The double pop below assumes the branch TARGET is buffered at head+2, where the
    //     pop lands the head. Budget bisection (BDN_BUDGET, since removed) named the event exactly:
    //     takes #1-#4 are BIT-IDENTICAL to the control and every one has wf_pc[head+2] == the
    //     descriptor target, while take #5 is a BACKWARD branch whose head+2 is the sequential
    //     successor — and that one take hangs the N=2 SMP boot (hart 1 never leaves the boot-ROM
    //     spin, trap1 == 0 for the whole boot, 100 M timeout vs a 19.55 M baseline). With
    //     wf_count == 2 head+2 is not even a live entry, and the ext_buf_mismatch correction is
    //     gated on `>= 3`, so nothing caught it. The fix is the head+2 test now in bd1n_hit.
    //
    // (2) Why the FREE take stays off anyway. Requiring the target at head+2 is restrictive: the producer
    //     only has it there when it followed the branch AND the FIFO is filled three deep, which
    //     for a backward branch it usually is not. With the fix, dhrystone l0tk is 13558 against a
    //     13504 baseline and bd1 3696 against 3189 — about 500 extra takes, not the 8964 the
    //     census said were "already in the FIFO". The census measured the DESCRIPTOR being there;
    //     a FREE take needs the TARGET there too. The earlier "l0tk -66 %" was a product of the
    //     bug, not of the mechanism, and is withdrawn.
    //
    //     Measured at BDN_FREE_POP=1: dhrystone 263039, coremark 401013, N=1 boot 14.70 M, litmus
    //     N=4 cycle-identical, all instret bit-exact — but SMP N=2 boot 20.0 M against 19.55 M,
    //     +2.3 %. A ~0.5 % single-hart gain, a 2.3 % SMP cost, and no structural progress.
    const BD_SLOT1_NEXT: bit = 1;
    // The take costs nothing ONLY if the target dword is already buffered where the double pop
    // lands the head — at head+2. Budget bisection proved the point: takes #1-#4 are bit-identical
    // to the control and every one of them has wf_pc[head+2] == the descriptor target, while take
    // #5 is a BACKWARD branch whose head+2 is the sequential successor, and it hangs the N=2 boot.
    // With wf_count == 2 head+2 is not even a live entry, and the ext_buf_mismatch correction is
    // gated on `>= 3`, so nothing caught it. Test the invariant instead of assuming it: this is
    // the same shape as f0_prefetched_target for the ordinary taken path, one entry further along.
    // ── f2.16c: the same descriptor, aimed at STRUCTURE instead of IPC ── DEAD at 0 ──
    // BDN_FREE_POP=1 is the f2.16b form: demand the target at head+2 and double-pop, so the take is
    // free. Measured, that condition almost never holds for a backward branch, so it buys ~500
    // takes and leaves the L0's job intact (l0tk 13558 vs a 13504 baseline).
    //
    // =0 drops the free-take ambition and keeps only the PREDICTION. The descriptor at head+1
    // describes these branches correctly in 8964 of 9461 cases; taking it and letting the ordinary
    // ext_taken_redir flush + re-steer run is exactly what the L0 costs today for the same branch.
    // That is the point: the campaign exists to delete l0pred (a 32-entry async-read four-port
    // register file in the fetch path), not to win cycles. A cycle-NEUTRAL change that moves 70 %
    // of the L0's remaining work onto a clocked SRAM-shaped table is the win condition here.
    const BDN_FREE_POP: bit = 0;
    let bd1n_hit   : logic     = BD_SLOT1_NEXT && FTQ_DESC && PRED_L0_FAST && (wf_count >= 4'd2)
        && (wf_pc[wf_head + 3'd1][63:3] == s1_pc[63:3]) && wf_d_taken[wf_head + 3'd1]
        && (!BDN_FREE_POP || ((wf_count >= 4'd3)
            && (wf_pc[wf_head + 3'd2][63:3] == wf_d_target[wf_head + 3'd1][63:3])));
    let bd1n_target: logic<64> = wf_d_target[wf_head + 3'd1];
    let bd_taken1n : logic     = bd1n_hit && L0_SLOT1 && !l0e_taken && l0_slot1_deliv && !straddle_q
        && (s1_pc[63:3] != ic_pc[63:3]) && (wf_d_off[wf_head + 3'd1] == s1_pc[2:1]);
    let bd_taken1  : logic     = bd_taken1s || bd_taken1n;
    let l0e_taken1 : logic     = FTQ_DESC && bd_taken1;
    let l0e_target1: logic<64> = if bd_taken1n ? bd1n_target : bd_target;
    let fb_tail1: logic<3> = fb_tail + 3'd1; // slot-1 write index (wraps mod 8)
    // ── F1 order-item-2: Stage-B skid drain / accept (PRED_PIPE) ──
    // Stage-B (the a_* skid register) drains its held bundle into the fetch buffer when the
    // buffer has room for it (fb_free already counts a simultaneous rename drain). sb_ops = the
    // held bundle's op count (1 or 2). Stage-A produces a new bundle only when Stage-B is empty
    // OR draining this cycle (sb_can_accept) — the +1-deep back-pressure that REPLACES fb_push0's
    // direct !fb_full at PRED_PIPE=1 (fb-full checking moves to the drain side). DEAD at 0:
    // sb_drain = PRED_PIPE && … = const-false, sb_can_accept unused (the =0 mux arm keeps
    // !fb_full), so fb_push0/fb_push1 fold to today's byte-identical form.
    let sb_ops       : logic<4> = if a_push1 ? 4'd2 : 4'd1;
    let sb_drain     : logic    = PRED_PIPE && a_valid && (fb_free >= sb_ops);
    let sb_can_accept: logic    = !a_valid || sb_drain;
    // Stage-B (drain-cycle) resolved prediction. At PRED_OVERRIDE=1 the clocked predictor outputs
    // (btb_hit/bht_taken/tage_*/ibtb_*/ras_spec_top → predicted_taken/pred_target above) are read
    // combinationally on ic_pc=ext_pc_q, which on the bundle's ALIGNED drain cycle (T+1, one after
    // Stage-A presented it) equals pred(a_pc). Only the fall-through PC is recomputed from the
    // CAPTURED a_pc/a_s1_pc (the live pred_next_pc_bp uses ic_pc=ext_pc_q, already advanced past the
    // held bundle). sb_next0/1 are the Stage-B next-PC used by the fb write / override. DEAD at 0.
    //
    // HOLD-DRIFT approximation (variant A): if the skid HOLDS a bundle > 1 cycle (fb full), Stage-A
    // freezes ext_pc_q at the NEXT sequential PC, so the clocked outputs drift to pred(next) — the
    // held bundle then resolves with its successor's prediction. This is ACCURACY-ONLY, never a
    // correctness bug: every predictor output feeds only the speculative fetch path (fb next-PC,
    // override, RAS, spec-history, FTB-train), all validated + corrected at commit. In practice a
    // drifted branch ≈ predicted not-taken (the successor PC is usually not a BTB branch → sequential
    // = the held bundle's own fall-through). Freezing the predictor output register during a hold
    // (a per-module read-enable) would remove the drift; deferred — measure its IPC cost at 3a.4
    // first (a combinational re-present of a_pc is impossible here: it closes a spurious comb loop
    // pred-index → sb_hold → fb_free → rename_fire2 → slot1_valid → predicted_taken → pred-index that
    // the FETCH_REG=1-dead fb_bypass2/fb_fall terms keep symbolically live).
    let a_len0  : logic<64> = if a_is_rvc0 ? 64'd2 : 64'd4;   // slot-0 length (straddle/32b = 4)
    let a_s1_len: logic<64> = if a_s1_is_rvc ? 64'd2 : 64'd4; // slot-1 length
    // ── F1 order-item-3a.6: predictor hold-drift fix (PRED_HOLD_FREEZE) ──
    // Under a skid HOLD (fb full > 1 cyc) the clocked predictor keeps reading the FROZEN ext_pc_q, so
    // its output drifts from pred(a_pc) to pred(successor); Stage-B then resolves the held bundle with
    // a STRAY prediction (wrong sb_next0 / slot1_kill / override) → over-eager overrides + mispredicts
    // (the +48% inversion IPC cost) and the slot-1/boot wrong-path-commit corners. Fix: capture the
    // ALIGNED resolved prediction on the drain-aligned cycle (produce_q, the cycle after a produce)
    // and FREEZE it through the hold; Stage-B consumes the frozen *_eff. This is a REGISTERED capture,
    // NOT a combinational re-present of a_pc — so it avoids the spurious comb loop 3a.3's design pivot
    // hit. DEAD at 0 (*_eff == the live value → byte-identical). Meaningful only with PRED_OVERRIDE
    // (Stage-A does not predict otherwise); produce_q is fb_push0 delayed one cycle = the aligned drain.
    const PRED_HOLD_FREEZE: bit = 1;
    var produce_q: logic    ;
    var held_pt0 : logic    ;
    var held_tgt0: logic<64>;
    var held_pt1 : logic    ;
    var held_tgt1: logic<64>;
    // f2.5d.1: the RAW btb bundle (hit + kind + direction) is frozen too — 3a.6 left it live as the
    // documented "accuracy-only remainder", but the FTB train (retimed to Stage-B below) and the
    // speculative RAS push/pop READ these bits, so a drifted kind writes a wrong-PC FTB entry / pushes
    // a stray return address. Same capture cycle (produce_q) and the same fold-to-live at 0.
    var held_hit0 : logic;
    var held_cond0: logic;
    var held_call0: logic;
    var held_ret0 : logic;
    var held_ind0 : logic;
    var held_hit1 : logic;
    var held_call1: logic;
    var held_ret1 : logic;
    let pt0_eff : logic     = if PRED_HOLD_FREEZE ? (if produce_q ? predicted_taken  : held_pt0 ) : predicted_taken;
    let tgt0_eff: logic<64> = if PRED_HOLD_FREEZE ? (if produce_q ? pred_target      : held_tgt0) : pred_target;
    let pt1_eff : logic     = if PRED_HOLD_FREEZE ? (if produce_q ? predicted_taken1 : held_pt1 ) : predicted_taken1;
    let tgt1_eff: logic<64> = if PRED_HOLD_FREEZE ? (if produce_q ? pred_target1     : held_tgt1) : pred_target1;
    let hit0_eff : logic = if PRED_HOLD_FREEZE ? (if produce_q ? btb_hit      : held_hit0 ) : btb_hit;
    let cond0_eff: logic = if PRED_HOLD_FREEZE ? (if produce_q ? btb_is_cond  : held_cond0) : btb_is_cond;
    let call0_eff: logic = if PRED_HOLD_FREEZE ? (if produce_q ? btb_is_call  : held_call0) : btb_is_call;
    let ret0_eff : logic = if PRED_HOLD_FREEZE ? (if produce_q ? btb_is_ret   : held_ret0 ) : btb_is_ret;
    let ind0_eff : logic = if PRED_HOLD_FREEZE ? (if produce_q ? btb_is_ind   : held_ind0 ) : btb_is_ind;
    let hit1_eff : logic = if PRED_HOLD_FREEZE ? (if produce_q ? btb_hit2     : held_hit1 ) : btb_hit2;
    let call1_eff: logic = if PRED_HOLD_FREEZE ? (if produce_q ? btb_is_call2 : held_call1) : btb_is_call2;
    let ret1_eff : logic = if PRED_HOLD_FREEZE ? (if produce_q ? btb_is_ret2  : held_ret1 ) : btb_is_ret2;
    // f2.4-fix: the not-taken pred_next MUST equal the actual delivered successor (a_eff_next), not
    // the sequential fall-through, so the FTB-follow (f2.2) non-sequential advance stays consistent
    // with the recorded prediction and the commit c_bp_mispredict backstop fires on a disagreement
    // (FTB ran ahead to the target but the clocked full resolved not-taken → extract stranded at the
    // target's offset-0; recording that here makes commit catch + flush it). For the LAST delivered
    // slot the successor is a_eff_next; slot-0 in a dual bundle is followed by slot-1 (a_pc+a_len0 =
    // a_s1_pc). a_eff_next folds to ext_seq_next at FTB_OVERRIDE=0 (= a_pc+a_len0 slot-0-only /
    // a_s1_pc+a_s1_len dual) → variant-A unchanged; DEAD at PRED_OVERRIDE=0 (sb_next* unused → DCE).
    // f2.6-fix (2026-08-02): `a_eff_next` is right for the FTB-follow but WRONG under PRED_L0_FAST.
    // The rule is "record the ACTUAL delivered successor". Under FTB_OVERRIDE the Stage-A advance IS
    // that successor, hence a_eff_next. But under PRED_L0_FAST the Stage-A advance is the L0 TARGET,
    // and when the clocked full pred then resolves NOT-taken the disagreement override re-steers to
    // `sb_override_target` = the fall-through — so the delivered successor is the FALL-THROUGH, not
    // a_eff_next. Recording a_eff_next there put the L0's target in the fetch-buffer's pred_next of an
    // op that actually fell through, which silently corrupted the stream (dhrystone instret 206663 vs
    // 264834). This is why the option-(B) L0, documented as bit-exact when it was built (2026-07-25),
    // no longer reproduced: f2.4-fix corner 1 landed after it and nobody re-flipped (B). With the
    // fall-through recorded under PRED_L0_FAST, dhrystone is BIT-EXACT again (264834) at 296826 cy.
    // The three arms are mutually consistent: L0-took-and-full-agrees uses the taken arm; L0 did not
    // take → a_eff_next IS the fall-through anyway, so the mux only ever changes the disagreeing case.
    let sb_next0: logic<64> = if pt0_eff ? tgt0_eff : (if a_push1 ? a_pc + a_len0 : (if PRED_L0_FAST ? a_pc + a_len0 : a_eff_next));
    let sb_next1: logic<64> = if pt1_eff ? tgt1_eff : (if PRED_L0_FAST ? a_s1_pc + a_s1_len : a_eff_next);
    // Slot-1 is KILLED at Stage-B when slot-0 resolved taken (slot-1 is past the taken branch →
    // wrong-path); the fb slot-1 write + count/tail advance suppress it, and the override re-steers
    // to slot-0's target. DEAD at 0. Uses pt0_eff (the frozen aligned prediction under FREEZE).
    let sb_slot1_kill: logic = PRED_OVERRIDE && pt0_eff;
    // Phase 8 S4a.3: 2-wide push. fb_push0 = the slot-0 delivery (== the S4a.2
    // single push); fb_push1 = the slot-1 delivery (needs slot1_valid + room for
    // a 2nd record). slot-0 pushes to fb_tail, slot-1 to fb_tail+1.
    // At PRED_PIPE=1 fb_push0/fb_push1 are the Stage-A PRODUCE (into the skid), gated on
    // sb_can_accept instead of !fb_full; the actual fb write (fb_wr0/fb_wr1 below) is the
    // Stage-B drain. At =0 both fold to today's live push.
    let fb_push0: logic = !any_redirect && fetch_ready && (if PRED_PIPE ? sb_can_accept : !fb_full);
    // slot-1 keeps the produce-time fb_free>=2 gate at BOTH PRED_PIPE settings. An earlier
    // PRED_PIPE=1 variant dropped it (fb_push1 = fb_push0 && slot1_valid, deferring the fb-room
    // check to the Stage-B drain) so near-full slot-1 was always bundled; that skipped ext_pc_q
    // to pred_next_pc1 and parked a 2-op bundle in the skid that can only drain on fb_free>=2 —
    // pathologically stalling Stage-A under N2 lock contention → SMP-boot livelock (isolation
    // test: reverting ONLY this gate fixed N2 boot; the pure +1 skid latency is fine). Keeping
    // the =0 gate DEFERS near-full slot-1 to a future slot-0 exactly as at =0 (byte-identical at
    // 0). The drain still re-checks fb_free>=sb_ops, so a 1-op bundle can still form near-full.
    let fb_push1: logic = fb_push0 && slot1_valid && fb_free >= 4'd2;
    // F1 order-item-3a.6: capture the aligned resolved prediction (see PRED_HOLD_FREEZE above).
    // produce_q marks the drain-aligned cycle (fb_push0 of the PREVIOUS cycle → the clocked outputs
    // now equal pred(a_pc)); on that cycle latch the live prediction into held_*, then freeze it while
    // the bundle is held (produce_q=0). DEAD at PRED_HOLD_FREEZE=0 (reset-only → every reg + fanin DCE).
    always_ff (clk, rst) {
        if_reset {
            produce_q  = 1'b0;
            held_pt0   = 1'b0;
            held_tgt0  = 64'd0;
            held_pt1   = 1'b0;
            held_tgt1  = 64'd0;
            held_hit0  = 1'b0;
            held_cond0 = 1'b0;
            held_call0 = 1'b0;
            held_ret0  = 1'b0;
            held_ind0  = 1'b0;
            held_hit1  = 1'b0;
            held_call1 = 1'b0;
            held_ret1  = 1'b0;
        } else if PRED_HOLD_FREEZE {
            produce_q = fb_push0;
            if produce_q {
                held_pt0   = predicted_taken;
                held_tgt0  = pred_target;
                held_pt1   = predicted_taken1;
                held_tgt1  = pred_target1;
                held_hit0  = btb_hit;
                held_cond0 = btb_is_cond;
                held_call0 = btb_is_call;
                held_ret0  = btb_is_ret;
                held_ind0  = btb_is_ind;
                held_hit1  = btb_hit2;
                held_call1 = btb_is_call2;
                held_ret1  = btb_is_ret2;
            }
        }
    }
    // F1 order-item-3 (A): the DELIVERY (prediction applied → RAS / spec-history / FTB-train keyed
    // on it). At PRED_OVERRIDE=1 delivery moves to Stage-B (the skid drain), where the clocked
    // predictor outputs align to the drained bundle; the slot-1 delivery drops out when slot-0
    // resolved taken (sb_slot1_kill). Folds to the Stage-A push fb_push0/fb_push1 at 0 (deliver1 ==
    // fb_wr1's PRED_OVERRIDE arm — RAS slot-1 fires exactly when the fb slot-1 write does).
    let deliver0: logic = if PRED_OVERRIDE ? (sb_drain && a_push0) : fb_push0;
    let deliver1: logic = if PRED_OVERRIDE ? (sb_drain && a_push1 && !sb_slot1_kill) : fb_push1;
    // M3: an instruction is delivered (its prediction applied) this cycle when
    // the fetch engine pushes it into the FIFO. RAS speculative push/pop and the
    // gshare spec-history update are gated on this so a stalled / squashed /
    // straddle-prep cycle does not perturb them (straddle-prep has fetch_ready=0).
    let fetch_deliver : logic     = fb_push0;
    // RAS speculative update: at most one per cycle. A slot-0 call/ret is always
    // predicted taken (BTB hit, is_cond=0) → slot1_valid=0, so slot-0's RAS update
    // and slot-1's are mutually exclusive. ras_push_addr is the return address of
    // whichever slot is the call (slot-0's pc+len, or slot-1's pc+len).
    // F1 order-item-3 (A): keyed on the Stage-B delivery (deliver0/1) so push/pop happen in program
    // order at the drain (the 1-deep skid means at most one RAS op in flight; a call kills slot-1
    // via sb_slot1_kill so slot-0/slot-1 stay mutually exclusive). btb_is_call/ret are the clocked
    // outputs aligned to the drained bundle; the push addr uses the captured a_pc/a_s1_pc.
    // f2.5d.1: read the FROZEN kind bits (hit0_eff/call0_eff/…). Under a skid hold the live clocked
    // outputs drift to the successor's read, so a held bundle could push/pop the RAS for a call/return
    // that is not the one being delivered — 3a.6's "accuracy-only remainder". Folds to the live bits at
    // PRED_HOLD_FREEZE=0 → byte-identical.
    let s0_ras_push: logic = deliver0 && hit0_eff && call0_eff;
    let s0_ras_pop : logic = deliver0 && hit0_eff && ret0_eff;
    let s1_ras_push: logic = deliver1 && hit1_eff && call1_eff;
    let s1_ras_pop : logic = deliver1 && hit1_eff && ret1_eff;
    let ras_push_addr : logic<64> = if s1_ras_push ? (if PRED_OVERRIDE ? a_s1_pc + a_s1_len : s1_pc + s1_len) : (if PRED_OVERRIDE ? a_pc + a_len0 : ic_pc + pc_advance);
    let ras_spec_push : logic     = s0_ras_push || s1_ras_push;
    let ras_spec_pop  : logic     = s0_ras_pop || s1_ras_pop;

    // Training signals (driven from the commit stage; forward-referenced here).
    var btb_train_en     : logic    ;
    var bht_train_en     : logic    ;
    var bp_train_pc      : logic<64>;
    var btb_train_target : logic<64>;
    var btb_train_is_cond: logic    ;
    var btb_train_is_call: logic    ;
    var btb_train_is_ret : logic    ;
    var btb_train_is_ind : logic    ; // S18: non-return JALR kind
    var ibtb_train_en    : logic    ; // S18
    var ibtb_train_index : logic<9> ; // S18: fetch-time gshare index slice
    var bht_train_taken  : logic    ;
    var bht_train_index  : logic<13>; // M4 gshare: carried fetch-time index
    // S22 TAGE train (commit; forward-referenced). The index/tag are
    // recomputed inside tage from committed_ghr_l — no carried state.
    var tage_train_en     : logic;
    var tage_train_taken  : logic;
    var tage_train_mispred: logic; // fetch-time DIRECTION mispredict
    var bht_base_pred_c   : logic; // BHT read at the committing op's index
    // M3 RAS architectural push/pop (commit; forward-referenced).
    var ras_arch_push     : logic    ;
    var ras_arch_pop      : logic    ;
    var ras_arch_push_addr: logic<64>;
    // f2.5d run-ahead RAS (the pc_pred predictor loop; forward-referenced — the drivers live with
    // the pc_pred FTB producer far below). DEAD at PRED_RAS_AHEAD=0 (all const-false / unread).
    var ras_pred_push     : logic    ;
    var ras_pred_pop      : logic    ;
    var ras_pred_push_addr: logic<64>;
    var ras_pred_resync   : logic    ;
    var ras_pred_top      : logic<64>;
    var ras_pred_valid    : logic    ;

    inst u_btb: btb (
        clk                               ,
        rst                               ,
        i_pc           : ic_pc            ,
        o_hit          : btb_hit          ,
        o_target       : btb_target       ,
        o_is_cond      : btb_is_cond      ,
        o_is_call      : btb_is_call      ,
        o_is_ret       : btb_is_ret       ,
        o_is_ind       : btb_is_ind       , // S18
        // Phase 8 S4a.3: 2nd read port on the slot-1 PC.
        i_pc2          : s1_pc            ,
        o_hit2         : btb_hit2         ,
        o_target2      : btb_target2      ,
        o_is_cond2     : btb_is_cond2     ,
        o_is_call2     : btb_is_call2     ,
        o_is_ret2      : btb_is_ret2      ,
        o_is_ind2      : btb_is_ind2      , // S18
        i_train_en     : btb_train_en     ,
        i_train_pc     : bp_train_pc      ,
        i_train_target : btb_train_target ,
        i_train_is_cond: btb_train_is_cond,
        i_train_is_call: btb_train_is_call,
        i_train_is_ret : btb_train_is_ret ,
        i_train_is_ind : btb_train_is_ind , // S18
    );
    // S18: indirect-target buffer. The lookup index is the gshare index
    // slice XOR the indirect path history (see the spec_ind_hist comment).
    // Trained at commit on non-return JALRs.
    let ibtb_lk_idx0: logic<9> = bht_lk_index[8:0] ^ spec_ind_hist;
    let ibtb_lk_idx1: logic<9> = bht_lk_index1[8:0] ^ spec_ind_hist;
    inst u_ibtb: ibtb (
        clk                             ,
        rst                             ,
        i_index       : ibtb_lk_idx0    ,
        i_pc          : ic_pc           ,
        o_hit         : ibtb_hit        ,
        o_target      : ibtb_target     ,
        i_index2      : ibtb_lk_idx1    ,
        i_pc2         : s1_pc           ,
        o_hit2        : ibtb_hit2       ,
        o_target2     : ibtb_target2    ,
        i_train_en    : ibtb_train_en   ,
        i_train_index : ibtb_train_index,
        i_train_pc    : bp_train_pc     ,
        i_train_target: btb_train_target,
    );
    inst u_bht: bht (
        clk                            ,
        rst                            ,
        i_index      : bht_lk_index    ,
        o_taken      : bht_taken       ,
        // Phase 8 S4a.3: 2nd read port on the slot-1 gshare index.
        i_index2     : bht_lk_index1   ,
        o_taken2     : bht_taken2      ,
        // S22: commit-side read at the committing branch's carried index
        // (TAGE altpred fallback; bht_train_index == c_pred_index).
        i_index3     : bht_train_index ,
        o_taken3     : bht_base_pred_c ,
        i_train_en   : bht_train_en    ,
        i_train_index: bht_train_index ,
        i_train_taken: bht_train_taken ,
    );
    // S22 TAGE-lite: tagged direction tables (see tage.veryl). Lookup on the
    // speculative long history; trained at commit from the committed twin.
    inst u_tage: tage (
        clk                                  ,
        rst                                  ,
        i_pc             : ic_pc             ,
        i_hist           : spec_ghr_l        ,
        o_hit            : tage_hit          ,
        o_taken          : tage_taken        ,
        i_pc2            : s1_pc             ,
        o_hit2           : tage_hit2         ,
        o_taken2         : tage_taken2       ,
        i_train_en       : tage_train_en     ,
        i_train_pc       : bp_train_pc       ,
        i_train_hist     : committed_ghr_l   ,
        i_train_taken    : tage_train_taken  ,
        i_train_mispred  : tage_train_mispred,
        i_train_base_pred: bht_base_pred_c   ,
    );
    inst u_ras: ras #(
        // f2.5d: the run-ahead stack is flip-COUPLED to PRED_RAS_AHEAD through this param (no
        // duplicated const to keep in sync — cf. the rob::PRED_OVERRIDE hazard 3a.5 documented).
        PRED_AHEAD: PRED_RAS_AHEAD,
    ) (
        clk                                 ,
        rst                                 ,
        i_spec_push     : ras_spec_push     ,
        i_spec_pop      : ras_spec_pop      ,
        i_spec_push_addr: ras_push_addr     ,
        o_spec_top      : ras_spec_top      ,
        o_spec_valid    : ras_spec_valid    ,
        i_arch_push     : ras_arch_push     ,
        i_arch_pop      : ras_arch_pop      ,
        i_arch_push_addr: ras_arch_push_addr,
        // Phase 8 S8.E: restore the speculative RAS from the architectural stack on
        // an early redirect too (accuracy-only approximation — loses in-flight
        // call/ret nesting between the commit head and the resolved branch).
        i_recovery_fire : any_redirect      ,
        // f2.5d run-ahead stack (pc_pred loop) — drivers assigned with the FTB producer below.
        i_pred_push     : ras_pred_push     ,
        i_pred_pop      : ras_pred_pop      ,
        i_pred_push_addr: ras_pred_push_addr,
        i_pred_resync   : ras_pred_resync   ,
        o_pred_top      : ras_pred_top      ,
        o_pred_valid    : ras_pred_valid    ,
    );

    // F1 option (B): L0 fast predictor instance (see PRED_L0_FAST above). Read on the
    // Stage-A fetch PC (ic_pc); trained at commit from the same taken-control / cond
    // stream as the full BTB/BHT, gated by PRED_L0_FAST (reset-only → module DCE at 0).

    // o_imem_addr / o_imem_ren driven below (after imem_mmu inst). The
    // imem_mmu's i_vaddr is the fetch address — advances ahead of pc_q
    // by 2 during straddle so the next-word fetch lands cycle T+1.

    // ============================================================
    // Phase 8 S4a: fetch engine. Owns pc_q + the straddle state. Decoupled from
    // rename: it advances whenever the fetch buffer has room (fb_full=0), no
    // longer gated on rename back-pressure (was !stall_dr). The delivered record
    // is pushed into the fetch buffer (FIFO) below, not written into a single
    // latch. On a flush pc_q resets here and the FIFO is emptied in its own
    // always_ff. While the FIFO is full the engine freezes (pc_q/straddle held).
    // ============================================================
    always_ff (clk, rst) {
        if_reset {
            pc_q           = RESET_PC;
            straddle_q     = 1'b0;
            straddle_low_q = 16'd0;
        } else if redirect_fire {
            pc_q           = redirect_pc;
            straddle_q     = 1'b0;
            straddle_low_q = 16'd0;
        } else if early_redir_fire_q {
            // Phase 8 S8.E: execute-time redirect steers here a cycle after the
            // branch resolves (commit redirect, above, has priority when both fire).
            pc_q           = early_redir_pc_q;
            straddle_q     = 1'b0;
            straddle_low_q = 16'd0;
        } else if !fb_full {
            if ic_straddle_prep {
                // Straddle prep (cycle 1 of 2): latch the high half, advance the
                // fetch addr (fetch_vaddr = pc_q+2) next cycle, hold pc_q. Does
                // NOT push — the straddled 32-bit instr delivers on cycle 2.
                // M9.A.255: gate on imem_valid_w. During Sv39 PTW walks mmu's
                // o_paddr returns a stale `pa` derived from the previous walk's
                // leaf_pte_ppn — if this fired before imem_valid_w=1,
                // straddle_low_q would capture garbage from the wrong PA's word,
                // producing a corrupted 32-bit straddled instruction (boot
                // blocker, project_phase7_v4_m9_blocker.md M9.A.254). The old
                // !stall_dr gate (M9.A.315) is gone: with the FIFO decoupling,
                // back-end stalls hold the renamed instr in the FIFO, never in
                // the fetch engine, so straddle-prep can never drop it.
                straddle_q     = 1'b1;
                straddle_low_q = curr_hw;
            } else if fetch_ready {
                // Deliver: push handled in the fetch_buffer always_ff (fb_push0/
                // fb_push1). Steer the next fetch past the delivered bundle — to
                // slot-1's predicted next PC when slot-1 was also pushed, else
                // slot-0's (pred_next_pc_bp). Commit validates it (c_bp_mispredict).
                pc_q        = if fb_push1 ? pred_next_pc1 : pred_next_pc_bp;
                straddle_q  = 1'b0;
            }
            // else: icache filling a miss / Sv39 PTW still walking → hold pc_q +
            // straddle_q so fetch resumes at the same point once the stall clears.
        }
        // else fb_full → freeze the fetch engine (no push possible this cycle).
    }

    // ICACHE_SYNC_READ shape-N: track whether the synchronous icache read arriving
    // this cycle corresponds to the current pc_q. pc_q ADVANCES on a redirect or a
    // delivery (below), presenting a new fetch address whose read lands next cycle;
    // otherwise pc_q is held (stall / straddle-prep / fb_full) so a settled +
    // translated (imem_valid_w) address' read is available next cycle. D is
    // const-gated to 0 at ICACHE_SYNC_READ=0 → DCE (byte-identical, synth-neutral).
    // fetch_vaddr changes on a redirect, a delivery (pc_q advances), OR a straddle-prep
    // (straddle_q 0→1 shifts fetch_vaddr to pc_q+2) — all present a new icache address
    // whose synchronous read lands next cycle, so settled must clear on each.
    let ic_pc_advances: logic = any_redirect || (!fb_full && (fetch_ready || ic_straddle_prep));
    always_ff (clk, rst) {
        if_reset {
            ic_rd_settled_q = 1'b0;
        } else {
            ic_rd_settled_q = if ICACHE_SYNC_READ ? (imem_valid_w && !ic_pc_advances) : 1'b0;
        }
    }

    // ── Shape-W F0 read stream (CP §14) — DEAD at ICACHE_SYNC_READ=0 ──
    // Present pc_fetch_q (dword-aligned) to imem_mmu + icache; the sync-read dword lands
    // next cycle and is pushed into the WORD FIFO. pc_fetch_q += 8 each fetch (no length
    // dependence → sequential code never bubbles). The extract-side pop + the predicted-
    // taken redirect arrive in W2; here the FIFO only fills (F0 holds when full). W3
    // hardens the =1 miss / PTW / fault back-pressure (this skeleton is dead at 0).
    // Room for THIS present's push (lands next cycle) must account for the ALREADY in-flight
    // push (wf_push_valid_q, from last cycle's present, lands this cycle). Without the
    // wf_push_valid_q term, presenting at count==7 overflows: the in-flight push takes it to
    // 8, then this present's push to 9 → FIFO corruption (only under sustained back-pressure,
    // e.g. a long div / FP / atomic fills the FIFO — the W3 first-flip hang).
    let wf_full   : logic = (wf_count + (if wf_push_valid_q ? 4'd1 : 4'd0)) >= 4'd8;
    // F0 presents a fetch when the translation resolved (or faulted), the read path is free,
    // and the FIFO has room. On a fault i_ren=0 so icache_stall=0 and a fault-marked entry
    // still pushes, delivering the fault in program order at extract.
    // Gate on the COMBINATIONAL miss (icache_stall_comb) so F0 holds pc_fetch_q on the
    // exact cycle its presented address misses; the registered icache_stall is a cycle late
    // (the previous address' stall) and would stream past the miss. The push (wf_do_push)
    // keeps the registered icache_stall — it aligns with the registered o_rdata arrival.
    // Cacheable-region decode (fetch PA in the DRAM window). Defined here (ahead of its old
    // spot at the icache inst) so the shape-W 2-beat non-cacheable F0 below can read it.
    // imem_paddr_w is a forward-declared var (assigned by the imem_mmu inst further down).
    let ic_dram: logic = imem_paddr_w[63:25] == 39'h40;
    // f2.5b: F0's actual fetch address. Under FTQ_DECOUPLE F0 no longer advances its own pointer
    // via its FTB read — it DEQUEUES the FTQ head (which pc_pred filled). When the FTQ is momentarily
    // empty (the cycle after a redirect flush, before pc_pred refills — the decoupled-front-end
    // redirect bubble) fall back to pc_pred (a valid predicted address) rather than the stale ftq
    // slot, so the always-on MMU translate (i_req=!any_redirect) never walks a garbage address;
    // f0_present is gated off then anyway (ftq empty), so no fetch is presented. At FTQ_DECOUPLE=0
    // this folds to pc_fetch_q → byte-identical, and pc_fetch_q's coupled FTB loop stays authoritative.
    // f2.15e: the empty-FTQ fallback is pp_cur — pc_pred under the address-queue FTQ, pc_pred_q under
    // FTQ_DESC (the dword whose descriptor is arriving now; pc_pred is one lookup ahead of it).
    let f0_fetch_pc: logic<64> = if FTQ_DECOUPLE ? (if ftq_count >= 4'd1 ? ftq_pc[ftq_head] : pp_cur) : pc_fetch_q;
    // f2.5c.1: F0 presents whenever ready (no FTQ-non-empty gate) — when the FTQ is empty it fetches
    // pc_pred DIRECTLY (f0_fetch_pc's fallback = the bypass), removing the +1 redirect bubble. The FTQ
    // only buffers when F0 falls behind pc_pred (miss / wf_full). Unchanged at FTQ_DECOUPLE=0.
    // f2.15e: the empty-FTQ bypass fetches pp_cur, so it must wait out the one start-up cycle after a
    // re-seed in which pc_pred_q still holds the abandoned pointer. Folds to 1'b1 at FTQ_DESC=0.
    let f0_present: logic = ICACHE_SYNC_READ && !any_redirect && !icache_stall_comb && !wf_full
        && (!FTQ_DESC || ftq_count >= 4'd1 || pp_cur_ok)
        && (imem_valid_w || imem_fault_w || imem_acc_fault_w);
    // The dword presented last cycle arrives now (o_rdata is registered under sync-read);
    // push it unless the icache is still stalling a miss (W3 hardens the miss hold).
    let wf_do_push: logic = ICACHE_SYNC_READ && wf_push_valid_q && !icache_stall;
    // Non-cacheable 2-beat completion (W3). A present COMPLETES a dword — advances pc_fetch_q,
    // arms the push — when it is: a cacheable fetch (ic_dram, one dword per present); a fault
    // (delivered as a single fault-marked entry, no 2nd beat); or the SECOND beat of a non-
    // cacheable fetch (f0_nc_beat_q). A non-cacheable, non-faulting FIRST beat (f0_nc_beat_q=0)
    // only captures the low word — no push, no pc advance — and steps to beat 1.
    let f0_fault    : logic = imem_fault_w || imem_acc_fault_w;
    let f0_beat_done: logic = ic_dram || f0_fault || f0_nc_beat_q;
    // Extract pointer: on a normal delivery ext_pc_q advances past the delivered bundle
    // (slot-1's predicted next if the 2nd slot fired, else slot-0's). The extract POPS the
    // WORD FIFO head dword when the advance leaves it (crosses the dword boundary; a bundle
    // is <=8B so at most one dword is crossed per delivery).
    let ext_next_pc: logic<64> = if fb_push1 ? pred_next_pc1 : pred_next_pc_bp;
    // F1 order-item-3 (A): Stage-A never takes a branch — ext_seq_next is the SEQUENTIAL next-PC
    // past the delivered bundle (slot-1's fall-through if it delivered, else slot-0's). At
    // PRED_OVERRIDE=1 the ext_pc_q advance + ext_pop follow ext_eff_next(=ext_seq_next) instead of
    // the predicted ext_next_pc — the taken redirect becomes Stage-B's override (3a.3). DEAD at 0:
    // ext_eff_next folds to ext_next_pc → byte-identical.
    let ext_seq_next: logic<64> = if fb_push1 ? s1_pc + s1_len : ic_pc + pc_advance;
    // F1 option (B): under PRED_L0_FAST the Stage-A advance follows the L0 fast
    // prediction (taken slot-0 → l0_pred_target) instead of pure-sequential; the
    // accompanying F0 re-steer is added in b.2, the Stage-B disagreement-override in
    // b.3. Folds to ext_seq_next at PRED_L0_FAST=0 → byte-identical.
    // f2.9: a slot-1 L0 take advances Stage-A to slot-1's target (the bundle's ACTUAL
    // delivered successor), exactly as a slot-0 take does. Folds away at L0_SLOT1=0.
    // f2.15e: l0e_* is the L0 with the run-ahead block prediction folded in; folds to l0_* at 0.
    let ext_l0_next : logic<64> = if l0e_taken ? l0e_target : (if l0e_taken1 ? l0e_target1 : ext_seq_next);
    // f2.2: FIFO-follow advance. Under FTB_OVERRIDE the WORD FIFO holds F0's FTB-jumped
    // (non-sequential) stream. When the Stage-A sequential advance CROSSES the current head dword
    // AND the next FIFO entry is a non-sequential FTB target (buffered, !head1_seq), follow the
    // FIFO's next-entry PC (wf_pc[head+1] = the dword F0 actually fetched) instead of the sequential
    // successor — so ext_pc_q's dword tracks the FIFO and ext_head_match holds next cycle (no stall
    // on the non-sequential FIFO). The target's within-dword OFFSET is not recovered here (Stage-A
    // has none); extract resumes at offset 0 and Stage-B sb_override corrects the offset+path (f2.3).
    // ext_pop follows ext_eff_next so the head is consumed as the cross is taken. DEAD at
    // FTB_OVERRIDE=0: ext_ftb_follow is const-false → the inner mux folds to ext_seq_next and
    // ext_ftb_follow / wf_pc[head+1] DCE → ext_eff_next byte-identical to the pre-f2.2 expression.
    let ext_ftb_follow: logic = FTB_OVERRIDE && (ext_seq_next[63:3] != ext_pc_q[63:3]) && (wf_count >= 4'd2) && !head1_seq;
    let ext_eff_next: logic<64> = if PRED_OVERRIDE ? (if PRED_L0_FAST ? ext_l0_next : (if ext_ftb_follow ? wf_pc[wf_head + 3'd1] : ext_seq_next)) : ext_next_pc;
    let ext_pop    : logic     = ICACHE_SYNC_READ && fb_push0 && !straddle_q
        && (ext_eff_next[63:3] != ext_pc_q[63:3]);
    // f2.16b: a slot-1 take whose branch lived in head+1 consumes TWO dwords — the head dword
    // entirely, and head+1 up to a transfer that skips its remainder. A single pop leaves the
    // target at head+1 instead of head, and the first flip measured exactly what that costs:
    // ext_taken_redir 0 -> 8153 and f0_diverged 988 -> 9047, turning a correct prediction (bd1
    // 3189 -> 11162, l0tk 13504 -> 4135) into +9.6 % cycles. DEAD at BD_SLOT1_NEXT=0.
    // (sb_ovr_soft already outranks ext_pop at the head-advance site, so no term for it here —
    // and it is defined below this point, which Veryl would reject anyway.)
    // f2.16c: only the free-take arm double-pops. At BDN_FREE_POP=0 the take is an ordinary taken
    // branch — one pop, and ext_buf_mismatch raises ext_taken_redir exactly as it does for an L0
    // take of the same branch, so the cost is the L0's cost and the L0 is what gets replaced.
    let ext_pop2   : logic     = BD_SLOT1_NEXT && BDN_FREE_POP && bd_taken1n && ext_pop;
    // (b) B1: F0-side FTB lookup on the presented dword. A tag-matched hit predicts an
    // unconditional taken branch wholly within this dword → F0 re-steers to the stored target
    // (see the F0 FSM below). Combinational read of the small FTB register file on the flopped
    // pc_fetch_q (a realistic async-read RF, below the SRAM-compiler floor — sram_inventory §2).
    let ftb_lk_idx   : logic<FTB_IDX_W> = pc_fetch_q[FTB_IDX_W + 2:3];
    let ftb_lk_tag   : logic<FTB_TAG_W> = pc_fetch_q[63:FTB_IDX_W + 3];
    // (b) B2a: a CONDITIONAL FTB entry re-steers F0 only when its confidence is strong-taken (==3);
    // an unconditional entry (is_cond=0) always follows (B1). At ICACHE_FTB_COND=0 the is_cond/conf
    // terms fold away (is_cond is never set) → B1 behaviour, is_cond/conf DCE.
    let ftb_lk_follow: logic     = !ICACHE_FTB_COND || !ftb_is_cond[ftb_lk_idx] || (ftb_conf[ftb_lk_idx] == 2'd3);
    let f0_ftb_hit   : logic     = ICACHE_FETCH_DIRECTED && ftb_valid[ftb_lk_idx] && (ftb_tag[ftb_lk_idx] == ftb_lk_tag) && ftb_lk_follow;
    let f0_ftb_target: logic<64> = ftb_target[ftb_lk_idx];
    // Predicted-taken → F0 redirect: the extract delivered a taken branch (slot-0, or a
    // not-taken slot-0 + a taken slot-1), so the F0 stream — running sequentially past the
    // branch — must re-steer pc_fetch_q to the target (dword-aligned = ext_next_pc's dword)
    // and the WORD FIFO must flush its now-wrong-path words. Costs the taken +1 (the target
    // dword is a cycle late), same as the =0 fetch. Commit/early redirect (any_redirect) has
    // priority (older + authoritative). DEAD at 0.
    // (b) B1: two redirect reasons, OR'd (both flush + re-steer F0 to ext_next_pc):
    //  (1) TAKEN branch (as the original shape-W: a taken slot-0, or a not-taken slot-0 + taken slot-1)
    //      — F0 must fetch the target. SUPPRESSED only when F0 has ALREADY prefetched the exact target
    //      (its FTB redirect ran ahead → the target dword is buffered at wf_head+1 == ext_next_pc): then
    //      extract continues into it via the normal pop, no flush = the B1 BUBBLE1 win. If F0 did NOT
    //      prefetch it (no/other FTB entry, or not yet buffered) the flush fires exactly as before —
    //      REQUIRED, else the pop empties the FIFO and extract reads F0's wrong-path words as the target.
    //  (2) F0-FTB DIVERGENCE on a non-taken delivery: F0 FTB-redirected off this dword but extract did
    //      NOT take (stale FTB vs evicted BTB) → the buffered next dword (wf_head+1) is F0's wrong-path
    //      target, ≠ extract's fall-through; re-steer to the fall-through. Proven-divergence only
    //      (buffered AND different) so a normal catch-up cross (next dword not yet buffered) just stalls.
    // Commit/early redirect (any_redirect) has priority. DEAD at 0 (carries ICACHE_SYNC_READ).
    let wf_head_p1          : logic<3> = wf_head + 3'd1;
    let f0_prefetched_target: logic    = (wf_count >= 4'd2) && (wf_pc[wf_head_p1][63:3] == ext_next_pc[63:3]);
    // f2.5d.1b: under the authority inversion Stage-A NEVER takes a branch, and `predicted_taken` on
    // a Stage-A produce is the CLOCKED read of the PREVIOUS bundle's PC — one cycle stale. So this
    // term fired a full WORD-FIFO flush + an F0 re-steer to a STALE target on essentially every
    // produce that followed a taken branch, throwing away exactly the FTB prefetch f2.1/f2.3 exist to
    // create. Stage-B's sb_override is the taken redirect there; ext_buf_mismatch likewise compares
    // the buffered next dword against the advance Stage-A ACTUALLY took (ext_eff_next), not against a
    // stale prediction. Both fold to today's terms at PRED_OVERRIDE=0.
    let ext_deliver_taken   : logic    = !PRED_OVERRIDE && ((fb_push0 && predicted_taken) || (fb_push1 && predicted_taken1));
    let ext_exp_next        : logic<64> = if PRED_OVERRIDE ? ext_eff_next : ext_next_pc;
    // f2.16b: on an ext_pop2 the head advances by TWO, so the dword extract goes to next is at
    // head+2, not head+1. Comparing against head+1 there sees D+1 vs the branch target, calls it a
    // mismatch, and raises ext_taken_redir — which flushes the FIFO before the double pop can even
    // run. That single wrong index is what turned a correct prediction into +9.6 % cycles.
    let ext_buf_mismatch    : logic    = ext_pop && (if ext_pop2 ?
        ((wf_count >= 4'd3) && (wf_pc[wf_head + 3'd2][63:3] != ext_exp_next[63:3]))
    :   ((wf_count >= 4'd2) && (wf_pc[wf_head_p1][63:3] != ext_exp_next[63:3])));
    // F1 order-item-3 (A): the Stage-A taken/FTB redirect is REPLACED by the Stage-B sb_override
    // (below) — gate it off under PRED_OVERRIDE (Stage-A never takes a branch there).
    // f2.1: `(!PRED_OVERRIDE || FTB_OVERRIDE)` re-enables the Stage-A FTB-follow taken redirect under
    // PRED_OVERRIDE=1 when FTB_OVERRIDE=1 (F0 follows the FTB → this reconciles it with extract).
    // Folds to `!PRED_OVERRIDE` at FTB_OVERRIDE=0 → byte-identical.
    let ext_taken_redir     : logic    = ICACHE_SYNC_READ && (!PRED_OVERRIDE || FTB_OVERRIDE) && !any_redirect
        && ((ext_deliver_taken && !f0_prefetched_target) || ext_buf_mismatch);
    // (b) B1 divergence recovery — the HINT safety net (§24.4). An FTB redirect can steer F0 onto a
    // WRONG-path dword that extract never reaches / consumes wrongly. Two cases, both recovered by a
    // full flush + re-fetch of ext_pc_q's dword with the FTB gated (f0_no_ftb_q) so the re-fetch
    // streams SEQUENTIALLY (head+1 = ext_pc_q_dword+8). The delivery-gated ext_buf_mismatch cannot
    // catch these — it needs ext_pop ⟸ fb_push0, but both cases STALL extract (no delivery):
    //  (A) head mismatch — extract's dword is not at the FIFO head and F0 is neither presenting it
    //      (pc_fetch_q) nor has it in flight (wf_push_*_q); F0 ran off a wrong path. Guards exclude a
    //      normal refill (empty FIFO post-flush, or F0 holding on ext's OWN dword during a miss/2-beat).
    //  (B) straddle blocked — extract IS at the head dword but a dword-boundary straddle (offset 6,
    //      32-bit) needs head+8, which head+1 is NOT (an FTB redirect made head+1 non-sequential).
    //      ext_next_valid=0 (above) stalls the delivery so no WRONG high half is decoded; this
    //      re-fetches the dword sequentially to supply the real head+8.
    // DEAD/DCE at ICACHE_FETCH_DIRECTED=0.
    // f2.1: `(!PRED_OVERRIDE || FTB_OVERRIDE)` re-enables the Stage-A FTB divergence-recovery net under
    // PRED_OVERRIDE=1 when FTB_OVERRIDE=1. Folds to `!PRED_OVERRIDE` at FTB_OVERRIDE=0 → byte-identical.
    let f0_diverged: logic = ICACHE_SYNC_READ && ICACHE_FETCH_DIRECTED && (!PRED_OVERRIDE || FTB_OVERRIDE) && !any_redirect
        && (
            (!ext_head_match && (wf_count >= 4'd1)
             && (f0_fetch_pc[63:3] != ext_pc_q[63:3]) // f2.5b: F0's actual fetch dword (FTQ head under FTQ_DECOUPLE); folds to pc_fetch_q at 0
             && !(wf_push_valid_q && (wf_push_pc_q[63:3] == ext_pc_q[63:3])))
            || (ext_head_match && needs_straddle && ext_pc_q[2] && (wf_count >= 4'd2) && !head1_seq)
        );
    // F1 order-item-3 (A): the Stage-B OVERRIDE — the taken-branch redirect that REPLACES the
    // Stage-A ext_taken_redir/f0_diverged (both gated off under PRED_OVERRIDE). Stage-A advanced the
    // fetch stream SEQUENTIALLY; when the drained bundle's clocked prediction resolves TAKEN (slot-0,
    // or a not-taken slot-0 + a taken slot-1), that sequential F0 stream + the wrong-path Stage-A
    // capture are squashed and F0/ext_pc_q re-steer to the target. sb_ovr_taken1 already excludes a
    // taken slot-0 (deliver1 carries !sb_slot1_kill = !predicted_taken). Commit/early redirect
    // (any_redirect) outranks it. DEAD at 0 (PRED_OVERRIDE const-false).
    // f2.9: with the slot-1 fast path, Stage-A has ALREADY taken slot-1's L0 target,
    // so the clocked full slot-1 prediction overrides only on DISAGREEMENT — the same
    // shape as sb_disagree0. Folds to plain `pt1_eff` at L0_SLOT1=0 (a_l0_taken1
    // const-false) → byte-identical.
    let sb_ovr_taken1     : logic     = deliver1 && (if L0_SLOT1 ?
        ((pt1_eff != a_l0_taken1) || (pt1_eff && a_l0_taken1 && (tgt1_eff != a_l0_target1)))
      : pt1_eff);
    // F1 option (B) b.3: with the L0 fast path, Stage-A ALREADY took the L0-predicted branch
    // (a_l0_taken → a_l0_target, via l0_redir). The clocked full slot-0 prediction (pt0_eff/tgt0_eff)
    // now OVERRIDES only on DISAGREEMENT: full and L0 differ on taken, or both taken to different
    // targets (an aliased/cold L0 entry). A match is the 0-bubble common case — F0 was already steered
    // to the right target at Stage-A. sb_next0 (the FULL prediction) stays the fb_pred_next_pc / commit
    // check-of-record: whenever L0 and full agree it equals the L0 target, and whenever they disagree
    // the override makes the stream follow full — so it is the actual stream next-PC either way. At
    // PRED_L0_FAST=0, a_l0_taken=0 → sb_disagree0 folds to pt0_eff (the plain "any taken"). Byte-id.
    let sb_disagree0      : logic     = if PRED_L0_FAST ? ((pt0_eff != a_l0_taken) || (pt0_eff && a_l0_taken && (tgt0_eff != a_l0_target))) : pt0_eff;
    let sb_override       : logic     = PRED_OVERRIDE && sb_drain && !any_redirect && (sb_disagree0 || sb_ovr_taken1);
    // Override target: full-taken → full target; else the L0 falsely took slot-0 → the slot-0
    // fall-through; else slot-1's target. Folds to `pt0_eff ? tgt0_eff : tgt1_eff` at PRED_L0_FAST=0.
    // f2.9 adds one arm: the L0 falsely took SLOT-1 → slot-1's fall-through.
    let sb_override_target: logic<64> = if pt0_eff ? tgt0_eff
        : if (PRED_L0_FAST && a_l0_taken) ? a_pc + a_len0
        : if (L0_SLOT1 && a_l0_taken1 && !pt1_eff) ? a_s1_pc + a_s1_len
        : tgt1_eff;
    // f2.3: prefetch-reuse soft redirect. Under FTB_OVERRIDE the FTB-followed FIFO has already
    // prefetched the taken target — F0 jumped at the branch dword so the target dword sits at the
    // FIFO's next entry (wf_head+1, the f0_prefetched_target position). When sb_override's
    // offset-correct clocked target (tgt0_eff, since sb_ovr_soft ⟹ pt0_eff ⟹ sb_override_target ==
    // tgt0_eff) matches that prefetched dword — the FTB agreed with the clocked full pred, the common
    // case — the override is SOFT: rather than flushing the WORD FIFO and refetching the target (full
    // icache latency), just POP the branch dword (wf_head → the prefetched target entry), keep the
    // rest, set ext_pc_q = sb_override_target (offset-correct), and leave F0 running ahead. This
    // removes the taken-path icache bubble (only the Stage-A/B skid +1 remains). On DISAGREEMENT
    // (target not prefetched at head+1 — FTB miss / stale-FTB mispredict / different target) the
    // override stays HARD: today's flush + F0 re-steer + refetch. sb_override still fires either way
    // (ext_pc_q is re-steered offset-correctly for both); only the FLUSH + F0 re-steer are gated off
    // on soft. DEAD at FTB_OVERRIDE=0: sb_ovr_soft const-false → hard everywhere → byte-identical.
    // f2.3b (TRIED AND REJECTED 2026-07-31, kept as a design note): only 8-13 % of Stage-B overrides
    // are soft, because the FTB-followed Stage-A advance (f2.2) often crosses INTO the prefetched
    // target dword before the override fires — the "mid-dword FTB branch vs override" race the
    // f2.2/f2.3 analysis flagged — leaving the target at wf_head rather than wf_head+1, so this test
    // fails and the override HARD-flushes the very dword it wanted. Accepting the head case as a
    // second soft flavor (no pop, since the branch dword was already consumed) LOOKS right and is
    // faster on dhrystone, but it HANGS the N1 boot (45M timeout, x3=0x80a85b60) — and it hangs
    // IDENTICALLY under both hardenings tried: (b) an `ext_head_match && !ext_bypass` guard against a
    // stale head, and (c) additionally gating on a registered "last cycle's pop WAS an FTB-follow
    // cross", which proves a dword was consumed on this branch's behalf so the cycle PAIR still makes
    // forward progress. Both hardenings also erase the speedup (dhrystone 332665 → 336671, i.e. the
    // gain came from the UNSAFE firings; the safe upside is only −0.15 %). The boot-fatal interaction
    // is therefore neither staleness nor forward progress, and is not worth root-causing for 0.15 %.
    // If the soft rate is revisited, attack the CAUSE instead: hold the Stage-A FIFO-follow cross
    // while a drained bundle's override is still pending, so the target stays at head+1 and this
    // existing, pop-guaranteed soft path applies unchanged.
    let sb_ovr_soft       : logic     = FTB_OVERRIDE && sb_override && pt0_eff && (wf_count >= 4'd2)
        && (wf_pc[wf_head + 3'd1][63:3] == tgt0_eff[63:3]);
    // F1 option (B) b.2: Stage-A F0 re-steer. When the L0 fast predictor calls slot-0 TAKEN at a
    // Stage-A produce (fb_push0), F0 — streaming sequentially — must re-steer to the L0 target and
    // the sequential WORD FIFO flush, so the target is fetched now instead of at the Stage-B
    // override a cycle later (the +1 the L0 fast path recovers). ext_pc_q already advanced to
    // l0_pred_target via ext_eff_next (b.1); this is the F0-side analogue of sb_override. sb_override
    // (an OLDER, draining bundle's full-pred correction) OUTRANKS it (a wrong older bundle squashes
    // this younger produce). The skid still CAPTURES this bundle (the taken branch is correct-path,
    // unlike sb_override which squashes a wrong-path younger produce). DEAD at 0 (PRED_L0_FAST=0).
    // f2.15e: a DESCRIPTOR-sourced take is deliberately excluded — this is where the mechanism pays.
    // The run-ahead already steered fetch to that target, so the WORD FIFO holds it at head+1 and the
    // stream past the branch is CORRECT path: flushing it (and re-seeding pc_pred onto it) would throw
    // away the very prefetch the block predictor exists to produce, and re-pay the icache latency the
    // queue just hid. Only an L0-sourced take — a conditional the tail slot does not describe — still
    // needs the flush + re-seed, because there the producer really did run down the fall-through.
    // f2.16c: this suppression exists because a descriptor take needs no flush — the producer
    // already fetched the target, so the ordinary pop walks into it. That premise holds for
    // bd_taken0 / bd_taken1s (same dword) and for bd_taken1n ONLY in the free-pop arm, where the
    // target is proven to sit at head+2. A non-free bd_taken1n suppressed here loses the cheap
    // Stage-A re-steer and falls through to ext_taken_redir + f0_diverged instead: measured at
    // dhrystone 290017 (+9.6 %) with ext 0 -> 8153 and div 988 -> 9047. Let it redirect like an L0
    // take of the same branch, which is exactly the cost it is meant to replace.
    let l0_redir       : logic     = PRED_L0_FAST && fb_push0 && (l0e_taken || l0e_taken1) && !sb_override
        // f2.17: bd_why == 2 is a descriptor DELIVERED under the re-entry guard — the producer
        // never followed it, so its target was not prefetched and the flush is required.
        // f2.17: bd_why == 2 is a descriptor DELIVERED under the re-entry guard; f2.20: bd_why == 7
        // is one delivered as a RETURN. Neither was followed by the producer, so neither prefetched
        // its target and both need the flush.
        && !(FTQ_DESC && (bd_why != 3'd2) && (bd_why != 3'd7)
             && (bd_taken0 || bd_taken1s || (BDN_FREE_POP && bd_taken1n)));
    let l0_redir_target: logic<64> = if l0e_taken ? l0e_target : l0e_target1;
    // f2.5a: the FTB read on the INDEPENDENT pc_pred pointer (the F2-full predictor loop) — the same
    // logic as f0_ftb_hit/f0_ftb_target but indexed by pc_pred, steering the next pc_pred + the FTQ
    // enqueue. pp_no_ftb_q suppresses the redirect on the first pc_pred step after a re-seed (the
    // mid-dword re-entry guard, cf. f0_no_ftb_q). In the FINAL F2-full structure F0 no longer reads
    // the FTB (it dequeues the FTQ), so this REPLACES the pc_fetch_q FTB read port rather than adding
    // one; during scaffolding both coexist at =1 (harmless — F0's is ignored once f2.5b lands). DEAD
    // at FTQ_DECOUPLE=0: pp_ftb_hit const-false → pp_next = pc_pred+8, pc_pred reset-only → cone DCE.
    let pp_ftb_idx   : logic<FTB_IDX_W> = pc_pred[FTB_IDX_W + 2:3];
    let pp_ftb_tag   : logic<FTB_TAG_W> = pc_pred[63:FTB_IDX_W + 3];
    let pp_ftb_follow: logic     = !ICACHE_FTB_COND || !ftb_is_cond[pp_ftb_idx] || (ftb_conf[pp_ftb_idx] == 2'd3);
    // f2.5d: the CALL / RETURN kind of the block this FTB entry terminates. A return entry has NO
    // usable stored target — its target is the run-ahead RAS top, so it only predicts while that
    // stack is non-empty (else the entry is treated as a miss and pc_pred streams sequentially,
    // exactly as before f2.5d). Both const-false at PRED_RAS_AHEAD=0 → pp_ftb_hit/pp_next fold to
    // their f2.5a form and the ftb_is_call/ftb_is_ret reads DCE.
    let pp_ftb_is_call: logic = PRED_RAS_AHEAD && ftb_is_call[pp_ftb_idx];
    let pp_ftb_is_ret : logic = PRED_RAS_AHEAD && ftb_is_ret[pp_ftb_idx];
    let pp_ftb_hit   : logic     = FTQ_DECOUPLE && ICACHE_FETCH_DIRECTED && ftb_valid[pp_ftb_idx] && (ftb_tag[pp_ftb_idx] == pp_ftb_tag) && pp_ftb_follow && !pp_no_ftb_q
        && (!pp_ftb_is_ret || ras_pred_valid);
    let pp_ftb_target: logic<64> = ftb_target[pp_ftb_idx];
    // A followed RETURN block predicts the run-ahead RAS top (dword-aligned — the within-dword offset
    // is recovered at Stage-B by sb_override, as for every other FTB target under f2.2/f2.3).
    let pp_next      : logic<64> = if pp_ftb_hit ? (if pp_ftb_is_ret ? {ras_pred_top[63:3], 3'b000} : {pp_ftb_target[63:3], 3'b000}) : pc_pred + 64'd8;
    let ftq_full     : logic     = ftq_count >= 4'd8;
    // f2.5b/c.1: F0 DEQUEUES a real buffered FTQ entry when it presents + completes a fetch of the
    // head (beat-done; non-cacheable 2-beat pops once) AND the FTQ is non-empty. When the FTQ is empty
    // F0 instead BYPASSES — fetches pc_pred directly (f0_ftq_byp) — so no dequeue. Gated FTQ_DECOUPLE → DCE at 0.
    // f2.12 FTQ_RUNAHEAD. The bypass below is what keeps this FTQ at depth ZERO in
    // steady state: the moment the queue empties, F0 fetches pc_pred directly AND
    // the producer SKIPS the enqueue, so the queue can never refill while fetch is
    // running — it only ever accumulates while F0 is stalled, which is exactly when
    // depth is useless. A decoupled front end only pays off if the predictor RUNS
    // AHEAD: that is what hides its (now clocked) read latency, and it is the reason
    // real cores take no IPC hit for an overriding predictor. So: keep enqueuing on
    // a bypass cycle (pc_pred free-runs and fills the queue) and let the SAME cycle's
    // beat-done consume the bypassed entry, so it is not re-fetched from the queue
    // afterwards. Net count on a bypass+beat-done cycle is unchanged (+1 enq, -1 pop)
    // with head/tail both stepping past the entry F0 already took.
    // DEAD at 0 → the three terms below fold back to the f2.5c.1 forms exactly.
    const FTQ_RUNAHEAD: bit = 0;
    // (`ftq_count == 0` here IS f0_ftq_byp — FTQ_DECOUPLE && f0_present are already
    // ANDed in — written this way because f0_ftq_byp is defined just below.)
    // f2.15e: FTQ_DESC must ALWAYS enqueue — a dword may never reach F0 outside the queue, or its
    // descriptor never reaches the WORD FIFO. So an empty-queue fetch becomes an enqueue and a
    // dequeue in the same cycle: the FTQ_RUNAHEAD shape, mandatory here rather than optional. Without
    // this the f2.12 bypass suppression starves the whole mechanism — measured: the producer enqueued
    // 18 dwords in a 3M-cycle run and then stopped, with f0_diverged firing on 20 % of cycles.
    let f0_ftq_pop   : logic     = FTQ_DECOUPLE && f0_present && f0_beat_done
        && (ftq_count >= 4'd1 || FTQ_RUNAHEAD || FTQ_DESC);
    // f2.5c.1: F0 is bypassing this cycle — fetching pc_pred directly because the FTQ is empty (both
    // beats of a non-cacheable fetch). The producer then skips enqueuing pc_pred (F0 took it) and
    // advances pc_pred on beat-done. This is the in-sync / redirect-refill case = F2-lite behavior, 0 bubble.
    let f0_ftq_byp   : logic     = FTQ_DECOUPLE && f0_present && ftq_count == 4'd0;
    // f2.5d: the pc_pred loop's control terms, hoisted to module level so the run-ahead RAS (a
    // separate module instance) can be driven by them. pp_reseed = every redirect that re-seeds
    // pc_pred + flushes the FTQ (the f2.5a consistency invariant, sb_ovr_soft excluded — the FTB
    // agreed, the stream stands); ftq_enq / pp_advance are exactly the enqueue and pc_pred-advance
    // conditions of the producer always_ff's steady-state arm, which that arm now reads instead of
    // recomputing locally (inside it pp_reseed is false and FTQ_DECOUPLE true by construction, so the
    // hoisted terms are identical there). DEAD at FTQ_DECOUPLE=0 (all const-false).
    // f2.15e adds the sixth term: an L0-sourced Stage-A take re-seeds the run-ahead too (see the
    // producer arm for why — without it the decoupled front end has no way back to Stage-A's stream).
    // Folds away at FTQ_DESC=0 → the five-term expression byte-for-byte.
    let pp_reseed : logic = FTQ_DECOUPLE && (redirect_fire || early_redir_fire_q || (sb_override && !sb_ovr_soft) || (FTQ_DESC && l0_redir) || ext_taken_redir || f0_diverged);
    // ── f2.15e: the two-stage run-ahead pipe ──
    // pp_step is one step of {lookup, commit}: it advances pc_pred and pc_pred_q together, gated only
    // on FTQ room, so the pipe never half-advances. A commit — the actual enqueue — additionally needs
    // the in-flight lookup to be ON-PATH (pp_desc_vld); the one cycle after a re-seed, and the one
    // after a descriptor-taken re-steer, are lookup-only.
    //
    // Why the lookup pointer runs SPECULATIVELY SEQUENTIAL. A clocked array whose result supplies the
    // NEXT address is serially dependent: address -> 1 cycle -> next address is one dword per TWO
    // cycles, half of fetch's rate. f2.15d's note that "stage 1 for the next dword overlaps stage 2
    // for this one" only holds if stage 1's address is known without stage 2, and it is — for the
    // common case. A dword with no followed transfer continues at +8 BY CONSTRUCTION (f2.14's
    // FTQ_WIDE_ENQ rests on the same observation), so pc_pred just keeps stepping +8 while the
    // descriptor for pc_pred_q is in flight, and only a TAKEN descriptor re-steers it — invalidating
    // the fall-through lookup already in flight, which is the one bubble per taken block. Sequential
    // runs, i.e. the overwhelming majority of dwords, cost nothing.
    let pp_step   : logic = FTQ_DECOUPLE && FTQ_DESC && !pp_reseed && (!ftq_full || f0_ftq_pop);
    // f2.15e RE-SEED LOOKUP BYPASS. The re-seed target is known COMBINATIONALLY at the re-seed cycle
    // (it comes from extract or commit, never from the block array — so this costs no array-to-array
    // path), which means the target's lookup can start at T instead of T+1 and the pipe restarts with
    // ZERO start-up bubble. Without it every re-seed pays one cycle, and re-seeds are the dominant
    // event in this arm: measured 33100 per 262143 cycles, ~79 % of them an L0-sourced conditional
    // take the tail-slot descriptor does not cover. Same priority order as the producer's arms, so
    // pp_reseed_tgt is by construction the pc_pred those arms assign.
    let pp_reseed_tgt: logic<64> = if redirect_fire ? redirect_pc
        : if early_redir_fire_q            ? early_redir_pc_q
        : if (sb_override && !sb_ovr_soft) ? sb_override_target
        : if (FTQ_DESC && l0_redir)        ? l0_redir_target
        : if ext_taken_redir               ? ext_next_pc
        :                                    ext_pc_q;
    let pp_reseed_pc : logic<64> = {pp_reseed_tgt[63:3], 3'b000};
    let ftq_enq   : logic = FTQ_DECOUPLE && !pp_reseed && (!ftq_full || f0_ftq_pop)
        && (if FTQ_DESC ? pp_desc_vld : (FTQ_RUNAHEAD || !f0_ftq_byp));
    let pp_advance: logic = ftq_enq || (FTQ_DECOUPLE && !FTQ_DESC && !pp_reseed && !FTQ_RUNAHEAD && f0_ftq_byp && f0_beat_done);
    // ── f2.14: WIDE (2-dword) FTQ ENQUEUE — the producer/consumer RATE FIX ── DEAD at 0 ──
    // f2.12's root finding: `pp_next = pc_pred + 8` is one dword/cycle against a consumer that takes
    // one dword/beat, so the FTQ is rate-matched and CANNOT accumulate depth. This is the cheapest
    // possible test of "can depth be held at all" — strictly weaker than the descriptor FTQ the F2
    // plan sketches, but it moves the same lever (producer rate) and it is the measurement f2.13
    // gates the whole block-granularity idea on.
    //
    // When pc_pred's dword has NO followed FTB entry the next dword is sequential BY CONSTRUCTION
    // (pp_next = pc_pred + 8), so we already know it without a prediction: enqueue BOTH dwords this
    // cycle and run the FTB read for the second one on a second async port (pp_*_b). The emitted
    // dword sequence is therefore BIT-IDENTICAL to what the 1-wide producer would emit over two
    // cycles — only the timing changes. That invariant is what makes this safe: fetch sees the same
    // stream, so instret must not move.
    //
    // The RAS is deliberately excluded from the wide step (a call/ret at the second dword falls back
    // to 1-wide) — the run-ahead stack must see each followed block exactly once, and PRED_RAS_AHEAD
    // is 0 in this arm anyway, so those terms are const-false.
    // Only useful with FTQ_RUNAHEAD=1: at 0, ftq_enq is suppressed on a bypass cycle (97.9 % of them),
    // so the wide step would almost never fire.
    const FTQ_WIDE_ENQ: bit = 0;
    let pp_pc_b         : logic<64>        = pc_pred + 64'd8;
    let pp_ftb_idx_b    : logic<FTB_IDX_W> = pp_pc_b[FTB_IDX_W + 2:3];
    let pp_ftb_tag_b    : logic<FTB_TAG_W> = pp_pc_b[63:FTB_IDX_W + 3];
    let pp_ftb_follow_b : logic            = !ICACHE_FTB_COND || !ftb_is_cond[pp_ftb_idx_b] || (ftb_conf[pp_ftb_idx_b] == 2'd3);
    let pp_ftb_is_call_b: logic            = PRED_RAS_AHEAD && ftb_is_call[pp_ftb_idx_b];
    let pp_ftb_is_ret_b : logic            = PRED_RAS_AHEAD && ftb_is_ret[pp_ftb_idx_b];
    let pp_ftb_hit_b    : logic            = FTQ_WIDE_ENQ && FTQ_DECOUPLE && ICACHE_FETCH_DIRECTED
        && ftb_valid[pp_ftb_idx_b] && (ftb_tag[pp_ftb_idx_b] == pp_ftb_tag_b) && pp_ftb_follow_b;
    let pp_next_b       : logic<64>        = if pp_ftb_hit_b ? {ftb_target[pp_ftb_idx_b][63:3], 3'b000} : pp_pc_b + 64'd8;
    // Room for two entries, accounting for a concurrent dequeue (mirrors ftq_enq's `!ftq_full || pop`).
    let ftq_room2       : logic            = (ftq_count <: 4'd7) || (f0_ftq_pop && (ftq_count <: 4'd8));
    // The wide step: dword A is sequential (no followed entry — pp_no_ftb_q's forced-sequential case
    // included, which is exactly right: that dword must NOT re-follow its branch), the second dword
    // carries no RAS action, and there is room for both.
    // f2.15e makes the two mutually exclusive: under FTQ_DESC the second dword would need its own
    // descriptor (a second blkpred port) and pp_pc_b is derived from pc_pred, which is the LOOKUP
    // pointer there, not the one being committed. f2.14 measured the wide step at exactly zero
    // cycles anyway, so there is nothing to give up.
    let pp_wide         : logic            = FTQ_WIDE_ENQ && !FTQ_DESC && ftq_enq && !pp_ftb_hit && ftq_room2
        && !pp_ftb_is_call_b && !pp_ftb_is_ret_b;
    // blkpred's outputs, declared here so the f2.15d descriptor terms below can read them; the
    // instance itself lives with the f2.15c census further down.
    var blk_hit       : logic    ;
    var blk_novalid   : logic    ; // f2.16b: miss with valid CLEAR = never trained (see blkpred)
    var blk_b0_valid  : logic    ;
    var blk_b0_off    : logic<2> ;
    var blk_b0_toff   : logic<13>;
    var blk_b0_ctr    : logic<2> ;
    var blk_b1_valid  : logic    ;
    var blk_b1_off    : logic<2> ;
    var blk_b1_toff   : logic<13>;
    var blk_b1_ctr    : logic<2> ;
    var blk_tl_valid  : logic    ;
    var blk_tl_off    : logic<2> ;
    var blk_tl_is_call: logic    ;
    var blk_tl_is_ret : logic    ;
    var blk_tl_is_ind : logic    ;
    var blk_tl_target : logic<64>;
    // ── f2.15d: the FTQ entry becomes a DESCRIPTOR ── DEAD at FTQ_DESC=0 ──
    // f2.13 sketched this and f2.14 refuted its stated motivation: the value is NOT that the producer
    // emits more dwords per cycle (measured, worth exactly zero) — it is that the prediction is made
    // at the RUN-AHEAD pointer with a CLOCKED read, so the queue absorbs the read latency that
    // extract otherwise pays per branch. The entry therefore stays ONE DWORD (multi-dword blocks buy
    // producer rate, which f2.14 proved is worthless here); what it gains is the prediction itself.
    //
    // SCOPE OF THIS INCREMENT — unconditional transfers only. blkpred's tail slot (jal / jalr / call /
    // ret / indirect) is predicted taken on sight, so it needs NO direction predictor. That lets the
    // descriptor plumbing be built and proven with ZERO accuracy risk, which matters because f2.6 is
    // the standing warning here: moving a direction read earlier cost +5.4 % earlymis and made
    // coremark worse. Conditional blocks keep the existing path until the run-ahead direction read
    // (BHT/TAGE on the run-ahead dword index and ghr_pred, f2.15a's twin) is built and measured.
    //
    // The producer becomes two-stage: pc_pred is presented to blkpred at T and the entry arrives at
    // T+1, so the descriptor enqueued at T+1 belongs to pc_pred_q, not pc_pred. Rate is unchanged at
    // one dword per cycle (stage 1 for the next dword overlaps stage 2 for this one); the cost is one
    // cycle of start-up after each reseed, which is exactly the latency the queue exists to hide.
    // (FTQ_DESC + the descriptor arrays + pp_cur/pp_cur_ok are forward-declared with FTQ_DECOUPLE.)
    // The block predictor's answer for pc_pred_q. Only the tail slot is consumed in this increment;
    // a conditional-only dword reads as not-taken and the stream falls through sequentially, which is
    // precisely what the pre-f2.15 producer does, so nothing regresses while the direction read is
    // still missing.
    //
    // f2.15e narrows the FOLLOWED set to exactly what the F0 FTB follows (ftb_br_deliver): direct
    // unconditional transfers. RETURNS and INDIRECTS are excluded — blkpred stores their last-seen
    // target, which is the value the RAS / iBTB exist to replace, so following it would steer fetch
    // at a target extract will disagree with on most executions. They fall through sequentially and
    // keep today's Stage-B override, exactly as they do at FTQ_DESC=0.
    // pp_no_desc_q is the mid-dword re-entry guard, delayed to match pc_pred_q: a re-seed landing
    // MID-dword means extract enters PAST any transfer the entry records, so its block exit does not
    // apply to this pass (the pp_no_ftb_q idiom, one stage later).
    // ── f2.15e': CONDITIONAL BLOCK EXITS — the direction comes WITH the entry ── DEAD at 0 ──
    // f2.15e covers 21 % of Stage-A takes; the other 79 % are conditionals, which the tail-slot-only
    // scope leaves on the L0 where each one still costs a flush + a run-ahead re-seed. Closing that
    // is the rest of the prize.
    //
    // The f2.15 design note gated this increment on a direction-accuracy measurement, because the
    // obvious construction — read BHT/TAGE at the run-ahead pointer — changes the index resolution
    // (halfword -> dword) and the history (spec_ghr -> ghr_pred) at once, and f2.6 is the precedent
    // where exactly that cost earlymis +5.4 % and made coremark worse. THIS CONSTRUCTION AVOIDS BOTH,
    // so the measurement it was gated on does not apply:
    //
    //   * No history at all. The direction is a 2-bit counter carried in the block entry's own
    //     conditional slot, so there is no speculative history to be stale, no run-ahead GHR to
    //     maintain, and no resync on any of the 52418 re-seeds. PRED_GHR_AHEAD stays unused.
    //   * No index resolution lost. The slot records the branch's own halfword offset, so the counter
    //     is per-BRANCH, not per-dword — the aliasing the f2.15b census measured (coremark 6.4 %,
    //     kernel 9.9 %) is what the two slots already solved.
    //   * No extra producer stage and no extra BHT/TAGE read port. A serial "block read then direction
    //     read" would need a third stage and would cost TWO bubbles per taken block instead of one,
    //     which on 30585 takes would eat the entire gain.
    //
    // What remains is the risk the L0 already lives with (l0pred's o_bimodal_strong, and the FTB's
    // conf==3 follow gate): a bimodal that disagrees with the full TAGE steers FETCH wrong, so the
    // Stage-B correction costs a refetch rather than one bubble. Same mitigation — take only on
    // STRONG. A slot that has never committed taken cannot reach strong (init_c), so it can never
    // steer with the meaningless target a not-taken-only train would leave behind.
    const PRED_BLK_COND: bit = 1;
    // ── f2.16: RE-ENTRY REACHABILITY, replacing the whole-descriptor guard ── DEAD at 0 ──
    // The f2.16 census (doc §f2.16) refuted the hand-off's premise. Returns are 510 of the 13504
    // L0-only Stage-A takes; 9461 (70 %) are conditionals in the fetch bundle's slot 1, and ALL of
    // them have NO descriptor rather than a mismatched offset. The producer census then found the
    // largest addressable bucket: 48802 of 230269 descriptors (21 %) are thrown away by the
    // mid-dword re-entry guard.
    //
    // The guard looked blunt: a re-seed landing MID-dword means extract enters past part of the
    // dword, so an exit recorded BEFORE that point is unreachable on this pass, and the entry
    // records each transfer's own halfword offset — so reachability looks decidable per slot
    // instead of by discarding the entry.
    //
    // ⚠️ MEASURED AND REFUTED (2026-08-07). Kept DEAD at 0 with the mechanism, so it is not rebuilt.
    // At =1 dhrystone goes 264536 -> 267052 (+0.95 %) with instret bit-exact, and the reseed census
    // says why: ext_taken_redir 0 -> 1476 and f0_diverged 988 -> 1964. The run-ahead starts
    // following exits extract does not take. The guard was doing a SECOND job that offset
    // comparison cannot replace — DECODE-ALIGNMENT aliasing. A block entry's slot offsets were
    // trained on a pass that entered the dword at some alignment; entering at a different halfword
    // re-decodes the bytes, so a recorded offset at or after the re-entry point need not be an
    // instruction boundary on THIS pass. Following it steers fetch at a target extract never
    // reaches. That failure is invisible at =0 because the guard blocks every re-entered dword and
    // an aligned entry (offset 0) decodes canonically — which is exactly why ext_taken_redir is 0
    // there. Recovering these descriptors needs a reachability test on instruction boundaries, not
    // on offsets; the entry does not carry the information to build one.
    const PRED_BLK_REENT: bit = 0;
    // The construction itself, folded away at 0. pp_ent_off_q is 0 on every ordinary step
    // (it is non-zero only for the one descriptor following a mid-dword re-seed, which is precisely
    // when pp_no_desc_q is set). So `off >= pp_ent_off_q` is vacuously true on the common path and
    // is a no-op there by construction — it only filters the re-entry case, where a slot BEFORE the
    // re-entry point describes a transfer extract has already walked past on this pass.
    // Filtering per SLOT rather than rejecting the entry is what makes this better than the
    // conservative form: a dword whose slot 0 is unreachable can still exit correctly through
    // slot 1, which the whole-descriptor guard threw away along with everything else.
    let re_b0: logic = !PRED_BLK_REENT || (blk_b0_off >= pp_ent_off_q);
    let re_b1: logic = !PRED_BLK_REENT || (blk_b1_off >= pp_ent_off_q);
    let re_tl: logic = !PRED_BLK_REENT || (blk_tl_off >= pp_ent_off_q);
    // ── f2.21: the CONFIDENCE GATE, the one lever this plan flagged as tuning and left alone ──
    // Taking a conditional block exit only on a SATURATED counter (== 3) is the mitigation blkpred
    // inherited from the L0's o_bimodal_strong: a direction that disagrees with the full TAGE steers
    // FETCH wrong, so the Stage-B correction costs a refetch rather than one bubble. =1 relaxes it to
    // weakly-taken as well. coremark is where this should show — it is the arm's worst workload
    // (+14.8 % against the shipped path) and the doc has named this gate as its lever since f2.15e'.
    const BLK_COND_WEAK: bit = 0;
    let bc0_conf: logic = if BLK_COND_WEAK ? (blk_b0_ctr >= 2'd2) : (blk_b0_ctr == 2'd3);
    let bc1_conf: logic = if BLK_COND_WEAK ? (blk_b1_ctr >= 2'd2) : (blk_b1_ctr == 2'd3);
    let bc0_take: logic = PRED_BLK_COND && blk_b0_valid && bc0_conf && re_b0;
    let bc1_take: logic = PRED_BLK_COND && blk_b1_valid && bc1_conf && re_b1;
    let bct_take: logic = blk_tl_valid && !blk_tl_is_ret && !blk_tl_is_ind && re_tl;
    // ── f2.20: RETURNS, delivered but never followed ── DEAD at 0 ──
    // 512 of the l0tk residue are returns, and they are the one thing the deleted L0 did that the
    // descriptor still declines: a block entry stores the LAST return address, which is the value a
    // RAS exists to replace, so following it would steer fetch at a target extract disagrees with.
    //
    // The f2.16 hand-off proposed building the run-ahead RAS (PRED_RAS_AHEAD) so the PRODUCER could
    // follow returns. This does NOT do that, and deliberately. Every hazard this campaign has paid
    // for lives on the producer side — f2.16's decode-alignment refutation, f2.16b's SMP hang — and
    // f2.5d's own recorded hazard for the run-ahead RAS is a producer spin (a followed return lands
    // mid-dword in the dword the call was trained on, so the loop can go call->ret->call).
    //
    // f2.16c/f2.17 established the alternative: DELIVER without FOLLOWING. The descriptor says only
    // "this block exits at offset X on a return"; extract supplies the target from ras_spec_top —
    // the extract-side speculative RAS that already exists and that the deleted L0 used for exactly
    // this (l0_use_ras). No run-ahead stack, no new structure, and the take costs what an L0 return
    // take cost: the ordinary l0_redir re-steer. PRED_RAS_AHEAD stays unbuilt.
    const BD_RET_DELIVER: bit = 1;
    let bct_ret : logic = BD_RET_DELIVER && blk_tl_valid && blk_tl_is_ret && !blk_tl_is_ind && re_tl;
    // Each conditional slot's own PC and target. B-type reach is +/-4 KiB, so the stored 13-bit
    // signed displacement is exact and sign-extends to the full target.
    let bc0_pc  : logic<64> = {pc_pred_q[63:3], blk_b0_off, 1'b0};
    let bc1_pc  : logic<64> = {pc_pred_q[63:3], blk_b1_off, 1'b0};
    let bc0_sx  : logic<51> = if blk_b0_toff[12] ? '1 : '0;
    let bc1_sx  : logic<51> = if blk_b1_toff[12] ? '1 : '0;
    let bc0_tgt : logic<64> = bc0_pc + {bc0_sx, blk_b0_toff};
    let bc1_tgt : logic<64> = bc1_pc + {bc1_sx, blk_b1_toff};
    // The first TAKEN conditional in program order — blkpred keeps slot 0 as the earlier branch, so a
    // not-strong slot 0 simply falls through to slot 1.
    let bcs_take: logic     = bc0_take || bc1_take;
    let bcs_off : logic<2>  = if bc0_take ? blk_b0_off : blk_b1_off;
    let bcs_tgt : logic<64> = if bc0_take ? bc0_tgt : bc1_tgt;
    // The block exits at whichever of {first taken conditional, tail transfer} comes FIRST in the
    // dword. A tail ahead of the conditional makes the conditional unreachable on this pass, and vice
    // versa; the offsets settle it directly.
    let bx_tail : logic = bct_take && (!bcs_take || (blk_tl_off <: bcs_off));
    // A return exit competes for "first in the dword" on the same offset rule as any other tail.
    let bx_ret  : logic = bct_ret && (!bcs_take || (blk_tl_off <: bcs_off));
    let bx_cond : logic = bcs_take && !bx_tail && !bx_ret;
    let pd_target: logic<64> = if bx_cond ? bcs_tgt : blk_tl_target;
    let pd_off   : logic<2>  = if bx_cond ? bcs_off : blk_tl_off;
    // The f2.16 claim was that per-slot reachability SUBSUMES the whole-descriptor guard, so the
    // guard term can drop out. Measurement refuted it (see the const above) — offsets decide who
    // extract walked past, but not what decodes as an instruction on this pass. Also note the guard
    // has a second source, pp_no_ftb_q under PRED_RAS_AHEAD (const-false in this arm); re-flipping
    // that would need its own term rather than riding on pp_ent_off_q, which carries only the
    // re-seed offset.
    // FOLLOW covers only what the producer may act on — never a return, whose target it cannot know.
    let pd_exit    : logic = FTQ_DESC && pp_desc_vld && blk_hit && (bx_tail || bx_cond);
    let pd_taken   : logic = pd_exit && (!pp_no_desc_q || PRED_BLK_REENT);
    // DELIVER additionally covers the return, which extract resolves against its own RAS.
    let pd_exit_r  : logic = FTQ_DESC && pp_desc_vld && blk_hit && bx_ret;
    // ── f2.17: DELIVER the guarded descriptor without FOLLOWING it ── DEAD at 0 ──
    // The slot-0 census (doc §f2.17) put 1993 of the 3512 slot-0-only takes — 57 % — on the
    // mid-dword re-entry guard. f2.16's PRED_BLK_REENT tried to relax that guard for the PRODUCER
    // and was refuted: a slot offset trained under one decode alignment need not be an instruction
    // boundary when the dword is re-entered at another, so following it steers fetch where extract
    // never goes (ext_taken_redir 0 -> 1476).
    //
    // f2.16c showed the way around exactly this shape. Split the two jobs the descriptor does:
    //   * FOLLOW (pd_taken) — the producer re-steers pc_pred. Still guarded, unchanged.
    //   * DELIVER (pd_deliver) — extract may consult it. NOT guarded.
    // Extract's own test is self-validating where the producer's is not: bd_taken0 requires
    // `bd_off == ic_pc[2:1]`, and ic_pc IS an instruction boundary by construction — extract
    // decoded its way there. Equal offsets on identical bytes means the SAME instruction, so the
    // recorded transfer and its target apply. The decode-alignment hazard is a producer-side
    // hazard only, and this increment never lets the producer act.
    //
    // Such a take is NOT free (the producer did not prefetch the target), so it must keep the
    // ordinary cheap Stage-A re-steer instead of being caught by l0_redir's suppression — the very
    // mistake that cost f2.16c its first attempt. bd_why == 2 marks these at extract.
    const BD_REENT_DELIVER: bit = 1;
    let pd_deliver : logic = (if BD_REENT_DELIVER ? pd_exit : pd_taken) || pd_exit_r;
    // ── f2.16b INSTRUMENTATION: the producer's own reason, travelling with the descriptor ──
    // f2.16 measured the producer's reasons as an AGGREGATE and then attacked the largest bucket,
    // which turned out not to be the bucket connected to the extract-side gap: the 9461 slot-1
    // conditional L0-takes barely moved while cycles regressed. This carries the reason DOWN to
    // extract with the dword it belongs to, so each L0-only take is attributed to its own cause.
    // Same priority order as the FTQ_STATS producer census, so the two are directly comparable.
    let pd_why: logic<3> = if !pp_desc_vld ? 3'd1                        // lookup invalidated
     : if pd_taken ? 3'd0                                                // a taken exit was produced
     : if pd_exit_r ? 3'd7                                               // f2.20: a RETURN, delivered only
     : if pp_no_desc_q ? 3'd2                                            // mid-dword re-entry guard
     : if !blk_hit ? (if blk_novalid ? 3'd3 : 3'd6)                       // never trained / evicted
     : if blk_b0_valid || blk_b1_valid ? 3'd4                            // hit, but no slot is strong
     : 3'd5;                                                             // hit, nothing applicable
    // (f2.15d had a `pd_next = taken ? target : pc_pred_q + 8` here and fed pc_pred from it. That is
    // the phase error f2.15e found by measurement: pc_pred is one dword AHEAD of pc_pred_q, so
    // assigning it next(pc_pred_q) writes back the value it already held — the pointer stops, each
    // dword commits twice, and the front end wedges. The advance now lives on the LOOKUP pointer,
    // which steps +8 on its own and is re-steered only by a taken descriptor. See pp_step.)
    // Stage-1/stage-2 registers for the two-stage run-ahead lookup. Kept as their own always_ff so
    // the producer's five reseed arms need no edit: a reseed at T changes pc_pred at the end of T, so
    // the lookup that was in flight during T was for the pre-reseed pointer and is marked invalid.
    always_ff (clk, rst) {
        if_reset {
            pc_pred_q    = RESET_PC;
            pp_desc_vld  = 1'b0;
            pp_no_desc_q = 1'b0;
            pp_ent_off_q = 2'd0;
        } else if FTQ_DESC {
            // Stage 2 of the pipe, stepping in lockstep with pc_pred (both under pp_step) so the two
            // can never drift. A re-seed leaves the in-flight lookup off-path; so does a
            // descriptor-taken re-steer, since the lookup in flight was that block's fall-through.
            if pp_reseed {
                // The re-seed target was presented to blkpred THIS cycle (the lookup bypass on
                // u_blkpred's i_pc), so its descriptor is ready next cycle and stage 2 restarts on it
                // directly — valid, not a bubble. The producer's arms set pc_pred to the target + 8 to
                // match, keeping stage 1 exactly one dword ahead of stage 2.
                pc_pred_q    = pp_reseed_pc;
                pp_desc_vld  = 1'b1;
                pp_no_desc_q = pp_reseed_tgt[2:1] != 2'b00;
                // f2.16: WHERE in the dword extract re-enters. Only meaningful while pp_no_desc_q
                // is set, which is exactly when the guard consults it.
                pp_ent_off_q = pp_reseed_tgt[2:1];
            } else if pp_step {
                pc_pred_q    = pc_pred;
                pp_desc_vld  = !pd_taken;
                pp_no_desc_q = pp_no_ftb_q;
                pp_ent_off_q = 2'd0;
            }
        }
    }
    // f2.15e: the descriptor that belongs to the dword F0 is presenting THIS cycle (f0_fetch_pc). It
    // is the FTQ head's when the queue holds one, and the arriving pd_* on a bypass — where F0 fetches
    // pp_cur directly, which is precisely the dword pd_* describes, so the two agree by construction.
    // Registered one cycle alongside wf_push_pc_q so it lands in the WORD FIFO with its own bytes.
    let f0_d_taken : logic     = FTQ_DESC && (if ftq_count >= 4'd1 ? ftq_d_taken[ftq_head]  : pd_deliver);
    let f0_d_target: logic<64> = if ftq_count >= 4'd1 ? ftq_d_target[ftq_head] : pd_target;
    let f0_d_off   : logic<2>  = if ftq_count >= 4'd1 ? ftq_d_off[ftq_head]    : pd_off;
    let f0_d_why   : logic<3>  = if ftq_count >= 4'd1 ? ftq_d_why[ftq_head]    : pd_why;
    // ── f2.15a: RUN-AHEAD GHR — the direction-history twin for a run-ahead predictor ── DEAD at 0 ──
    // f2.14 established that a deeper FTQ cannot amortise the clocked predictor latency because every
    // clocked predictor is indexed by ext_pc_q (the EXTRACT pointer) and by spec_ghr, which is
    // likewise updated from Stage-A/B outcomes. Moving those reads onto pc_pred therefore needs a
    // history that is valid AT pc_pred — i.e. one that already includes every conditional branch the
    // producer has run past but extract has not yet reached.
    //
    // This is exactly f2.5d's run-ahead RAS problem, and it takes the same shape: a THIRD copy of the
    // history, advanced by the producer on the blocks pc_pred commits to, and resynced on every
    // pc_pred re-seed (pp_reseed) from the extract-side speculative history — which is the correct
    // source, because a reseed means the run-ahead was thrown away and must restart from where
    // extract actually is. Both widths mirror spec_ghr / spec_ghr_l so a later dword-indexed
    // BHT/TAGE read can use them directly.
    //
    // What the producer knows about a block's direction comes from the FTB's own metadata, which is
    // all a block predictor ever has: a FOLLOWED entry (pp_ftb_hit) on a conditional branch means
    // predicted-taken → shift in 1; a PRESENT but not-followed conditional entry means the block's
    // branch was predicted not-taken → shift in 0. A dword with no conditional entry shifts nothing.
    // Only meaningful under FTB_OVERRIDE (the FTB is not trained otherwise — see f2.1), which is the
    // arm f2.15 lives in.
    const PRED_GHR_AHEAD: bit = 0;
    var ghr_pred  : logic<13>;
    var ghr_pred_l: logic<55>;
    // The producer's view of this dword's conditional branch. pp_ftb_hit already requires
    // valid+tag+follow, so "present but not followed" needs its own (unfollowed) presence test.
    let pp_ftb_present : logic = PRED_GHR_AHEAD && FTQ_DECOUPLE && ICACHE_FETCH_DIRECTED
        && ftb_valid[pp_ftb_idx] && (ftb_tag[pp_ftb_idx] == pp_ftb_tag) && !pp_no_ftb_q;
    let pp_cond        : logic = pp_ftb_present && ftb_is_cond[pp_ftb_idx];
    let pp_cond_taken  : logic = pp_cond && pp_ftb_hit; // followed ⟹ the FTB predicted it taken
    // Advance only when the producer actually commits to the block (pp_advance is the enqueue /
    // bypass-beat-done condition the run-ahead RAS uses, so the two histories stay in step).
    let ghr_pred_upd   : logic = PRED_GHR_AHEAD && pp_advance && pp_cond && !pp_reseed;
    always_ff (clk, rst) {
        if_reset {
            ghr_pred   = 13'd0;
            ghr_pred_l = '0;
        } else if PRED_GHR_AHEAD {
            if pp_reseed {
                // The run-ahead was discarded — restart from where extract actually is. Same
                // approximation the spec_ghr restore makes (it lags by the in-flight branches), and
                // accuracy-only for gshare, exactly as documented there.
                ghr_pred   = spec_ghr;
                ghr_pred_l = spec_ghr_l;
            } else if ghr_pred_upd {
                ghr_pred   = {ghr_pred[11:0], pp_cond_taken};
                ghr_pred_l = {ghr_pred_l[53:0], pp_cond_taken};
            }
        }
    }
    // The run-ahead RAS follows the blocks pc_pred actually commits to: a followed CALL entry pushes
    // its recorded return address, a followed RETURN entry pops. Resynced on every pc_pred re-seed
    // (ras.veryl copies from the speculative stack; a pipeline flush copies from the architectural
    // one and outranks it). DEAD at PRED_RAS_AHEAD=0 — pp_ftb_is_call/ret are const-false.
    assign ras_pred_push      = pp_advance && pp_ftb_hit && pp_ftb_is_call;
    assign ras_pred_pop       = pp_advance && pp_ftb_hit && pp_ftb_is_ret;
    assign ras_pred_push_addr = ftb_ret_addr[pp_ftb_idx];
    assign ras_pred_resync    = PRED_RAS_AHEAD && pp_reseed;
    always_ff (clk, rst) {
        if_reset {
            pc_fetch_q          = RESET_PC;
            wf_push_valid_q     = 1'b0;
            wf_push_pc_q        = 64'd0;
            wf_push_ifault_q    = 1'b0;
            wf_push_iacc_q      = 1'b0;
            wf_push_gstage_q    = 1'b0;
            wf_push_gpa_q       = 64'd0;
            wf_push_d_taken_q   = 1'b0;
            wf_push_d_target_q  = 64'd0;
            wf_push_d_off_q     = 2'd0;
            wf_push_d_why_q     = 3'd0;
            f0_nc_beat_q        = 1'b0;
            f0_nc_lo_inflight_q = 1'b0;
            f0_nc_lo_q          = 32'd0;
            wf_push_nc_q        = 1'b0;
            f0_no_ftb_q         = 1'b0;
        } else if ICACHE_SYNC_READ {
            // Write ONLY at =1 → at =0 every reg here is reset-only (holds its reset
            // constant) → DCE (the icache o_rdata_q idiom; a mux(control,const,hold) D
            // with an explicit =0 write survives simple DCE as an off-path flop).
            // pc_fetch_q: redirect > early-redirect > predicted-taken > stream-advance > hold.
            // Dword-aligned. A non-cacheable fetch advances only on its 2nd beat (f0_beat_done);
            // the 1st (low-word) beat holds pc_fetch_q and steps f0_nc_beat_q to the high word.
            if redirect_fire {
                pc_fetch_q   = {redirect_pc[63:3], 3'b000};
                f0_nc_beat_q = 1'b0;
                // Gate the first FTB redirect ONLY when the re-steer target lands MID-dword
                // (offset != 0): only then could extract have entered PAST the dword's trained
                // branch, making F0's redirect wrong. An offset-0 (dword-start) target enters
                // at-or-before any branch in the dword, so F0's FTB redirect agrees with extract
                // — keep the prefetch (the IPC win). Correctness for a missed corner still holds:
                // head1_seq + f0_diverged(B) catch any residual non-sequential head+1.
                f0_no_ftb_q  = redirect_pc[2:1] != 2'b00;
            } else if early_redir_fire_q {
                pc_fetch_q   = {early_redir_pc_q[63:3], 3'b000};
                f0_nc_beat_q = 1'b0;
                f0_no_ftb_q  = early_redir_pc_q[2:1] != 2'b00;
            } else if sb_override && !sb_ovr_soft {
                // F1 order-item-3 (A): Stage-B taken override — re-steer F0 to the target dword
                // (the sequential stream past the branch was wrong-path; the WORD FIFO flushes in
                // its own always_ff). Mutually exclusive with ext_taken_redir/f0_diverged (gated off
                // under PRED_OVERRIDE). DEAD at 0. f2.3: only the HARD override re-steers F0; a SOFT
                // override (sb_ovr_soft) leaves F0 running ahead (it already prefetched the target
                // past the branch), so `!sb_ovr_soft` skips this arm and F0 keeps streaming. Folds to
                // `sb_override` at FTB_OVERRIDE=0 → byte-identical.
                pc_fetch_q   = {sb_override_target[63:3], 3'b000};
                f0_nc_beat_q = 1'b0;
                f0_no_ftb_q  = 1'b0; // FTB is off under PRED_OVERRIDE
            } else if l0_redir {
                // F1 option (B) b.2: Stage-A L0-taken → re-steer F0 to the L0 target dword (one
                // cycle earlier than sb_override would). DEAD at 0 (l0_redir const-false).
                pc_fetch_q   = {l0_redir_target[63:3], 3'b000};
                f0_nc_beat_q = 1'b0;
                f0_no_ftb_q  = 1'b0;
            } else if ext_taken_redir {
                pc_fetch_q   = {ext_next_pc[63:3], 3'b000};
                f0_nc_beat_q = 1'b0;
                f0_no_ftb_q  = ext_next_pc[2:1] != 2'b00;
            } else if f0_diverged {
                // (b) B1 recovery: F0 diverged onto a wrong path; re-steer to extract's
                // authoritative (stalled) dword. Mutually exclusive with ext_taken_redir
                // (that needs a delivery; f0_diverged needs the stall) and independent of
                // f0_present (fires even when wf_full blocks F0's own advance).
                pc_fetch_q   = {ext_pc_q[63:3], 3'b000};
                f0_nc_beat_q = 1'b0;
                f0_no_ftb_q  = ext_pc_q[2:1] != 2'b00;
            } else if f0_present {
                if f0_beat_done {
                    // (b) B1: an FTB hit on the just-completed dword re-steers F0 to the predicted
                    // unconditional target (dword-aligned) instead of the sequential +8, so the
                    // target is prefetched ahead of extract (removing the taken-refill bubble). DEAD
                    // at ICACHE_FETCH_DIRECTED=0 (f0_ftb_hit is const-false → the mux folds to +8).
                    // f0_no_ftb_q suppresses the redirect on the first fetch after a re-steer (the
                    // mid-dword re-entry guard); it is consumed (cleared) by this completing fetch.
                    pc_fetch_q   = if f0_ftb_hit && !f0_no_ftb_q ? {f0_ftb_target[63:3], 3'b000} : pc_fetch_q + 64'd8;
                    f0_nc_beat_q = 1'b0;
                    f0_no_ftb_q  = 1'b0;
                } else {
                    f0_nc_beat_q = 1'b1; // non-cacheable low-word beat done → present the high word
                }
            }
            // Low-word capture pipeline (non-cacheable 2-beat): a beat-0 present this cycle → its
            // 32-bit word arrives next cycle as icache_rdata; latch it for the beat-1 assembly.
            // A redirect / taken re-steer voids the in-flight low word (wrong-path).
            f0_nc_lo_inflight_q = f0_present && !ic_dram && !f0_fault && !f0_nc_beat_q
                && !any_redirect && !ext_taken_redir && !f0_diverged && !sb_override && !l0_redir;
            if f0_nc_lo_inflight_q {
                f0_nc_lo_q = icache_rdata;
            }
            // Push-pipeline register: the COMPLETING fetch's dword PC + fault bits, delayed one
            // cycle to land with its data. Only a beat-DONE present pushes (the low-word beat does
            // not). Cleared on a redirect / taken re-steer (fetch is wrong-path). wf_push_nc_q
            // flags a non-cacheable dword — its high word comes from f0_nc_lo_q + icache_rdata.
            wf_push_valid_q = f0_present && f0_beat_done && !any_redirect && !ext_taken_redir && !f0_diverged && !sb_override && !l0_redir;
            if f0_present && f0_beat_done {
                wf_push_pc_q     = f0_fetch_pc; // f2.5b: the FTQ head under FTQ_DECOUPLE; folds to pc_fetch_q at 0
                wf_push_ifault_q = imem_fault_w;
                wf_push_iacc_q   = imem_acc_fault_w;
                wf_push_gstage_q = imem_gstage_w;
                wf_push_gpa_q    = imem_gpa_w;
                wf_push_nc_q     = !ic_dram && !f0_fault;
                // f2.15e: the run-ahead block prediction for this very dword, delayed with it.
                wf_push_d_taken_q  = f0_d_taken;
                wf_push_d_target_q = f0_d_target;
                wf_push_d_off_q    = f0_d_off;
                wf_push_d_why_q    = f0_d_why;
            }
        }
    }
    // ── F2-full (f2.5a): the pc_pred FTB PRODUCER + FTQ enqueue — DEAD at FTQ_DECOUPLE=0 ──
    // pc_pred runs the FTB loop independently and enqueues each predicted dword into the FTQ. NO F0
    // consumer yet (F0 keeps its coupled advance; f2.5b routes pc_fetch_q FROM ftq_pc[ftq_head] + adds
    // the ftq_head/ftq_count dequeue). Re-seed pc_pred + flush the FTQ on every redirect that re-steers
    // pc_fetch_q / flushes the WORD FIFO (the consistency invariant) so pc_pred never leads F0 down a
    // redirected-off path; sb_ovr_soft (FTB agreed, WORD FIFO not flushed) is the sole non-flushing
    // case → pc_pred keeps running. Priority mirrors the pc_fetch_q FSM. Enqueue-only here (count rises
    // to FTQ_N then ftq_full halts the loop — harmless while DEAD; f2.5b adds the dequeue). DEAD at 0:
    // written ONLY under `else if FTQ_DECOUPLE` → reset-only → pc_pred/pp_no_ftb_q/ftq_* + fanin DCE.
    always_ff (clk, rst) {
        if_reset {
            pc_pred     = RESET_PC;
            pp_no_ftb_q = 1'b0;
            ftq_head    = 3'd0;
            ftq_tail    = 3'd0;
            ftq_count   = 4'd0;
            // Reset the FTQ storage so f0_fetch_pc's (const-gated, dead-at-0) read is never of an
            // unassigned array — at FTQ_DECOUPLE=0 ftq_pc is reset-only (0) and f0_fetch_pc selects
            // pc_fetch_q anyway → DCE, behaviorally identical.
            for i in 0..FTQ_N {
                ftq_pc[i]       = 64'd0;
                ftq_d_taken[i]  = 1'b0;
                ftq_d_target[i] = 64'd0;
                ftq_d_off[i]    = 2'd0;
                ftq_d_why[i]    = 3'd0;
                ftq_d_call[i]   = 1'b0;
                ftq_d_ret[i]    = 1'b0;
                ftq_d_ind[i]    = 1'b0;
            }
        } else if FTQ_DECOUPLE {
            if redirect_fire {
                pc_pred     = {redirect_pc[63:3], 3'b000} + (if FTQ_DESC ? 64'd8 : 64'd0);
                pp_no_ftb_q = !FTQ_DESC && (redirect_pc[2:1] != 2'b00);
                ftq_head    = 3'd0;
                ftq_tail    = 3'd0;
                ftq_count   = 4'd0;
            } else if early_redir_fire_q {
                pc_pred     = {early_redir_pc_q[63:3], 3'b000} + (if FTQ_DESC ? 64'd8 : 64'd0);
                pp_no_ftb_q = !FTQ_DESC && (early_redir_pc_q[2:1] != 2'b00);
                ftq_head    = 3'd0;
                ftq_tail    = 3'd0;
                ftq_count   = 4'd0;
            } else if sb_override && !sb_ovr_soft {
                pc_pred     = {sb_override_target[63:3], 3'b000} + (if FTQ_DESC ? 64'd8 : 64'd0);
                // f2.15e: an override target lands MID-dword on essentially every conditional /
                // return, and the run-ahead block entry for that dword records a transfer extract may
                // now be entering PAST. Arm the re-entry guard from the offset, as every other arm
                // does. Folds to 1'b0 at FTQ_DESC=0 → the pre-f2.15 arm byte-for-byte.
                pp_no_ftb_q = 1'b0;
                ftq_head    = 3'd0;
                ftq_tail    = 3'd0;
                ftq_count   = 4'd0;
            } else if FTQ_DESC && l0_redir {
                // f2.15e: Stage-A took a transfer the RUN-AHEAD did not — a conditional the L0 called
                // taken, which the tail-slot-only descriptor does not describe. Under FTQ_DECOUPLE
                // l0_redir re-steers pc_fetch_q (inert here — F0 reads the FTQ) and flushes the WORD
                // FIFO, but before f2.15e nothing re-seeded the QUEUE: F0 kept fetching the
                // sequential stream and only f0_diverged, a full extract stall later, recovered it.
                // That is measured: FTQ_DECOUPLE with the L0 and WITHOUT the FTB_OVERRIDE divergence
                // net DEADLOCKS outright (dhrystone, 3M cycles, instret 15). Re-seeding here makes
                // the run-ahead follow Stage-A's actual stream, which is the point of a decoupled
                // front end. Descriptor-sourced takes deliberately do NOT reach this arm — l0_redir
                // excludes them, because the producer already fetched that target.
                pc_pred     = {l0_redir_target[63:3], 3'b000} + 64'd8;
                pp_no_ftb_q = 1'b0;
                ftq_head    = 3'd0;
                ftq_tail    = 3'd0;
                ftq_count   = 4'd0;
            } else if ext_taken_redir {
                pc_pred     = {ext_next_pc[63:3], 3'b000} + (if FTQ_DESC ? 64'd8 : 64'd0);
                pp_no_ftb_q = !FTQ_DESC && (ext_next_pc[2:1] != 2'b00);
                ftq_head    = 3'd0;
                ftq_tail    = 3'd0;
                ftq_count   = 4'd0;
            } else if f0_diverged {
                pc_pred     = {ext_pc_q[63:3], 3'b000} + (if FTQ_DESC ? 64'd8 : 64'd0);
                pp_no_ftb_q = !FTQ_DESC && (ext_pc_q[2:1] != 2'b00);
                ftq_head    = 3'd0;
                ftq_tail    = 3'd0;
                ftq_count   = 4'd0;
            } else {
                // f2.5b/c.1: steady state — DEQUEUE (F0 drained a real head entry, f0_ftq_pop) +
                // ENQUEUE (pc_pred produced) + BYPASS (f2.5c.1). pc_pred is ENQUEUED only when F0 did
                // NOT bypass it this cycle (else a duplicate — F0 fetched it directly); it ADVANCES to
                // pp_next when enqueued OR when a bypass fetch completes (beat-done). enq accounts for a
                // concurrent dequeue for room. Count = +enq -deq (a bypass touches neither). The bypass
                // makes F0 track pc_pred with 0 bubble when in sync (FTQ empty); the FTQ buffers only
                // when F0 falls behind (stall → !f0_ftq_byp → enqueue fills it).
                // f2.5d: ftq_enq is now the hoisted module-level term (identical here — this arm
                // implies FTQ_DECOUPLE && !pp_reseed); the run-ahead RAS reads it too.
                if f0_ftq_pop {
                    ftq_head = ftq_head + 3'd1;
                }
                if ftq_enq {
                    // f2.15e: under FTQ_DESC the dword being COMMITTED to is pc_pred_q (the one whose
                    // descriptor arrived this cycle), not pc_pred (which is one lookup ahead).
                    ftq_pc[ftq_tail] = pp_cur;
                    // f2.14: the wide step also enqueues the (known-sequential) second dword. NBA
                    // semantics — both index expressions read the OLD ftq_tail, so tail+1 is the
                    // slot after the one just written.
                    if pp_wide {
                        ftq_pc[ftq_tail + 3'd1] = pp_pc_b;
                    }
                    // f2.15d/e: park the run-ahead block prediction beside the address; f2.15e's
                    // consumer picks it up out of the WORD FIFO, having ridden along with its dword.
                    if FTQ_DESC {
                        ftq_d_taken[ftq_tail]  = pd_deliver;
                        ftq_d_target[ftq_tail] = pd_target;
                        ftq_d_off[ftq_tail]    = pd_off;
                        ftq_d_why[ftq_tail]    = pd_why;
                        ftq_d_call[ftq_tail]   = blk_tl_is_call;
                        ftq_d_ret[ftq_tail]    = blk_tl_is_ret;
                        ftq_d_ind[ftq_tail]    = blk_tl_is_ind;
                    }
                    ftq_tail = ftq_tail + (if pp_wide ? 3'd2 : 3'd1);
                }
                if FTQ_DESC {
                    // f2.15e: the LOOKUP pointer. It steps +8 speculatively every cycle the pipe
                    // moves — a dword with no followed transfer continues sequentially by
                    // construction, so its successor needs no prediction — and a TAKEN descriptor
                    // (which describes pc_pred_q, one behind) re-steers it to the block target. The
                    // fall-through lookup already in flight is then wrong, and pp_desc_vld drops it:
                    // one bubble per taken block, nothing on a sequential run.
                    if pp_step {
                        pc_pred     = if pd_taken ? {pd_target[63:3], 3'b000} : pc_pred + 64'd8;
                        // f2.15e': a conditional target is a loop back-edge as often as not, so it
                        // lands MID-dword far more often than a call/jal target does. Arm the
                        // re-entry guard from the target's offset, exactly as the re-seed arms do:
                        // the producer must not follow a transfer recorded BEFORE the point it is
                        // entering the dword at. pp_no_desc_q picks this up one step later, matching
                        // the dword it guards (the register value is read before this clear lands).
                        pp_no_ftb_q = pd_taken && (pd_target[2:1] != 2'b00);
                    }
                } else if ftq_enq || (f0_ftq_byp && f0_beat_done) {
                    pc_pred = if pp_wide ? pp_next_b : pp_next;
                    // f2.5d: a followed RETURN lands at the instruction AFTER the call — i.e. almost
                    // always MID-dword, in the very dword the call was trained on. Without the
                    // re-entry guard the next pc_pred step re-reads that dword's CALL entry and jumps
                    // to the callee again: the predictor loop would spin call→ret→call. This is the
                    // pp_no_ftb_q/f0_no_ftb_q idiom applied to the run-ahead return target, which is
                    // the one case where the mid-dword re-entry is SYSTEMATIC rather than incidental.
                    // (Measured contribution is small — dhrystone 371155 → 370657 cy — because f2.5d's
                    // cost is dominated by the zero run-ahead depth, see the plan's f2.5d.4 entry.)
                    // Only the return arm can test the offset: a normal FTB follow aligns the target
                    // ({target[63:3],0}) and drops it. Folds to 1'b0 at PRED_RAS_AHEAD=0.
                    pp_no_ftb_q = if PRED_RAS_AHEAD ? (pp_ftb_hit && pp_ftb_is_ret && (ras_pred_top[2:1] != 2'b00)) : 1'b0;
                }
                ftq_count = ftq_count + (if ftq_enq ? (if pp_wide ? 4'd2 : 4'd1) : 4'd0) - (if f0_ftq_pop ? 4'd1 : 4'd0);
            }
        }
    }
    // ── f2.15c: the RUN-AHEAD BLOCK PREDICTOR — instantiated + trained + MEASURED ── DEAD at 0 ──
    // See blkpred.veryl for the geometry and why every field of it is what the f2.15b census said.
    // This increment builds and trains the array but does NOT yet steer anything: f2.15d/e wire the
    // descriptor into the FTQ and demote Stage-B to reconciliation. What it DOES do is answer the
    // question that decides whether those are worth building — the f2.15 deficit is COVERAGE (the L0
    // has 32 entries against a 4096-entry BTB; 33 false positives and ZERO target errors over a
    // whole run), so the only thing that matters about the block predictor is whether it HAS the
    // branch. That is measured here, against ground truth at commit, before any datapath moves.
    //
    // The read is placed on the dword-aligned EXTRACT pc rather than pc_pred so the measurement is
    // valid in any config (including the shipped =0 arm, where FTQ_DECOUPLE is off and pc_pred does
    // not run). Coverage is a property of the table and its training, not of where it is read.
    const PRED_BLK: bit = 1;
    // Forward-declared; driven from the commit-side c_is_rvc far below (see i_train_en).
    var blk_train_straddle: logic;
    // f2.21: IDX_W was swept to 14 (4x the entries) as a capacity test for coremark's 51 % miss
    // rate. BIT-IDENTICAL — not one cycle, not one miss. The misses are dwords that were never
    // trained, not entries that were evicted: there is no conflict pressure here, and a bigger
    // table buys nothing but area. Left at 12.
    inst u_blkpred: blkpred (
        clk                                        ,
        rst                                        ,
        // f2.15e: the run-ahead lookup pointer, with the RE-SEED BYPASS — on a re-seed cycle present
        // the new target instead of the pointer being abandoned, so the pipe restarts with no
        // start-up bubble. pp_reseed_tgt comes from extract/commit, never from this array, so the
        // bypass adds no array-read-to-array-index path.
        i_pc           : if FTQ_DESC ? (if pp_reseed ? pp_reseed_pc : {pc_pred[63:3], 3'b000}) : {ic_pc[63:3], 3'b000},
        o_hit          : blk_hit                   ,
        o_novalid      : blk_novalid               ,
        o_b0_valid     : blk_b0_valid              ,
        o_b0_off       : blk_b0_off                ,
        o_b0_toff      : blk_b0_toff               ,
        o_b0_ctr       : blk_b0_ctr                ,
        o_b1_valid     : blk_b1_valid              ,
        o_b1_off       : blk_b1_off                ,
        o_b1_toff      : blk_b1_toff               ,
        o_b1_ctr       : blk_b1_ctr                ,
        o_tl_valid     : blk_tl_valid              ,
        o_tl_off       : blk_tl_off                ,
        o_tl_is_call   : blk_tl_is_call            ,
        o_tl_is_ret    : blk_tl_is_ret             ,
        o_tl_is_ind    : blk_tl_is_ind             ,
        o_tl_target    : blk_tl_target             ,
        // Trained from the same committed taken control transfer the BTB is trained from, so the two
        // tables see an identical event stream and a coverage comparison between them is honest.
        // Gated by PRED_BLK so the arrays are never written at 0 → the whole instance is inert.
        // f2.15e adds the STRADDLE exclusion the F0 FTB has always had (ftb_br_deliver): a 32-bit
        // transfer at halfword offset 3 has its own high half in the NEXT dword, so a block that
        // exits there would have fetch jump past the dword extract still needs in order to decode it.
        // Same rule, same reason, and the f2.15c coverage census predates it by one increment.
        // f2.15e' widens the train to EVERY committed conditional, taken or not (bht_train_en), so
        // the slot counters see the full direction population — the BTB-shaped train only ever fires
        // on taken transfers, which would leave every counter saturated at taken. Folds back to
        // btb_train_en alone at PRED_BLK_COND=0 → the f2.15c/e table byte-for-byte.
        i_train_en     : PRED_BLK && (btb_train_en || (PRED_BLK_COND && bht_train_en)) && !blk_train_straddle,
        i_train_pc     : bp_train_pc               ,
        i_train_target : btb_train_target          ,
        i_train_is_cond: btb_train_is_cond         ,
        i_train_is_call: btb_train_is_call         ,
        i_train_is_ret : btb_train_is_ret          ,
        i_train_is_ind : btb_train_is_ind          ,
        i_train_dir    : bht_train_taken           ,
    );
    // ── f2.15c COVERAGE CENSUS (temporary; DEAD at BLKC_STATS=0) ──
    // At commit, does the block predictor hold THIS branch? The read is one cycle old (the array is
    // clocked, by design), so compare against the commit PC registered to match it.
    const BLKC_STATS: bit = 0;
    var bc_cy   : logic<32>;
    var bc_tot  : logic<32>; // committed taken control transfers
    var bc_ent  : logic<32>; // ... whose dword has an entry at all (tag hit)
    var bc_cov  : logic<32>; // ... AND a slot matching this branch's offset  = real coverage
    var bc_free : logic<32>; // coverage misses where the entry existed WITH a free slot
    var bc_tr   : logic<32>; // blkpred train events (must equal the BTB's)
    // The blkpred read is indexed by the CURRENT ic_pc; to ask about the committing branch we read
    // the table with a commit-side index instead. Reuse the probe's own tiny shadow: a direct
    // recompute of "would a dword-indexed table of this size, trained on this stream, have it".
    // PHASE: blkpred's read is CLOCKED, so its outputs this cycle describe the dword of ic_pc from
    // the PREVIOUS cycle. The comparison operands must be delayed to match, or the probe reports a
    // stale prediction against a fresh branch and undercounts coverage badly.
    var bc_pc_q : logic<64>;
    var bc_btb_q: logic    ;
    let bc_dw_hit: logic = blk_hit && (
        (blk_b0_valid && (blk_b0_off == bc_pc_q[2:1]))
     || (blk_b1_valid && (blk_b1_off == bc_pc_q[2:1]))
     || (blk_tl_valid && (blk_tl_off == bc_pc_q[2:1]))
    );
    always_ff (clk, rst) {
        if_reset {
            bc_cy    = 32'd0;
            bc_tot   = 32'd0;
            bc_ent   = 32'd0;
            bc_cov   = 32'd0;
            bc_free  = 32'd0;
            bc_tr    = 32'd0;
            bc_pc_q  = 64'd0;
            bc_btb_q = 1'b0;
        } else if BLKC_STATS {
            bc_cy    = bc_cy + 32'd1;
            bc_pc_q  = ic_pc;
            bc_btb_q = btb_hit;
            // Sampled on the FETCH side: for every dword extract is presenting that actually holds a
            // control transfer the full BTB knows about, did the block predictor know it too?
            if bc_btb_q {
                bc_tot = bc_tot + 32'd1;
                if blk_hit {
                    bc_ent = bc_ent + 32'd1;
                }
                if bc_dw_hit {
                    bc_cov = bc_cov + 32'd1;
                }
                // Diagnostic: the entry is present but this branch is not in it, AND a slot was
                // free. With dhrystone measured at zero within-dword aliasing there is no capacity
                // pressure, so a large count here means the branch never got allocated — an
                // allocation defect, not a sizing one.
                if blk_hit && !bc_dw_hit && (!blk_b0_valid || !blk_b1_valid || !blk_tl_valid) {
                    bc_free = bc_free + 32'd1;
                    // Sample the first few so the actual slot contents settle what "free slot but not
                    // allocated" means, instead of another round of reasoning about the merge.
                    if bc_free <: 32'd12 {
                        $display("BLKMISS pc=%h want_off=%d b0=%d/%d b1=%d/%d tl=%d/%d",
                            bc_pc_q, bc_pc_q[2:1],
                            blk_b0_valid, blk_b0_off,
                            blk_b1_valid, blk_b1_off,
                            blk_tl_valid, blk_tl_off);
                    }
                }
            }
            if PRED_BLK && btb_train_en {
                bc_tr = bc_tr + 32'd1;
            }
            if bc_cy[15:0] == 16'hffff {
                $display("BLKC cy=%d btb=%d blk_ent=%d blk_cov=%d free=%d tr=%d", bc_cy, bc_tot, bc_ent, bc_cov, bc_free, bc_tr);
            }
        }
    }
    // ── f2.15b DWORD-ALIASING PROBE (temporary; DEAD at BLK_STATS=0) ──
    // Gating measurement for the block predictor. A dword-indexed block predictor holds ONE entry per
    // dword, so two distinct conditional branches inside the same dword cannot both be represented —
    // they alias, and one of them is mispredicted every time. This counts that case with GROUND TRUTH
    // at commit (not agreement with the current predictor): committed conditional branches whose PC
    // lies in the same dword as the PREVIOUSLY committed conditional branch but at a different
    // halfword offset. With RVC, four instructions fit in a dword, so this is not a priori rare and
    // it is the structural part of the accuracy risk — the part no amount of table capacity fixes.
    const BLK_STATS: bit = 0;
    var bs_cy    : logic<32>;
    var bs_cond  : logic<32>; // committed conditional branches
    var bs_alias : logic<32>; // ... in the same dword as the previous one, different halfword
    var bs_same  : logic<32>; // ... the SAME branch again (a loop back-edge: no aliasing, benign)
    var bs_prevpc: logic<64>;
    var bs_prevok: logic     ;
    // Exact (non-consecutive) form: remember, per dword, the halfword offset of the last committed
    // conditional branch in it, with a tag so different dwords do not alias in the PROBE itself.
    // The consecutive-pair counters above are only a lower bound — a dword whose two branches are
    // never committed back-to-back would escape them.
    const BS_N: u32 = 4096;
    var bs_toff: logic<2>  [BS_N];
    var bs_ttag: logic<12> [BS_N];
    var bs_tval: logic     [BS_N];
    var bs_alias2: logic<32>;
    // How MANY branch slots a block entry needs. A dword holds at most four RVC instructions, so the
    // within-dword branch offset pc[2:1] has exactly four values — a 4-bit mask per dword records the
    // exact set of offsets at which a conditional branch has committed. Classifying each committed
    // branch by its dword's distinct-offset count answers the design parameter directly: popcount 1
    // needs one slot, 2 needs two, >2 would still alias with a two-slot entry.
    var bs_tmsk: logic<4> [BS_N];
    var bs_pc1 : logic<32>;
    var bs_pc2 : logic<32>;
    var bs_pc3 : logic<32>;
    var bs_pc4 : logic<32>;
    // Dynamic array reads are hoisted to module level (the simulator rejects them inside always_ff).
    let bs_idx  : logic<12> = bp_train_pc[14:3];
    let bs_tag  : logic<12> = bp_train_pc[26:15];
    let bs_rdoff: logic<2>  = bs_toff[bs_idx];
    let bs_rdtag: logic<12> = bs_ttag[bs_idx];
    let bs_rdval: logic     = bs_tval[bs_idx];
    let bs_rdmsk: logic<4>  = bs_tmsk[bs_idx];
    // The mask this dword has AFTER counting the branch committing now (a tag miss restarts it).
    let bs_setbit: logic<4> = (4'd1 << bp_train_pc[2:1]);
    let bs_newmsk: logic<4> = if (bs_rdval && (bs_rdtag == bs_tag)) ? (bs_rdmsk | bs_setbit) : bs_setbit;
    let bs_pop   : logic<3> = {2'd0, bs_newmsk[0]} + {2'd0, bs_newmsk[1]} + {2'd0, bs_newmsk[2]} + {2'd0, bs_newmsk[3]};
    always_ff (clk, rst) {
        if_reset {
            bs_cy     = 32'd0;
            bs_cond   = 32'd0;
            bs_alias  = 32'd0;
            bs_same   = 32'd0;
            bs_prevpc = 64'd0;
            bs_prevok = 1'b0;
            bs_alias2 = 32'd0;
            bs_pc1    = 32'd0;
            bs_pc2    = 32'd0;
            bs_pc3    = 32'd0;
            bs_pc4    = 32'd0;
            for i in 0..BS_N {
                bs_toff[i] = 2'd0;
                bs_ttag[i] = 12'd0;
                bs_tval[i] = 1'b0;
                bs_tmsk[i] = 4'd0;
            }
        } else if BLK_STATS {
            bs_cy = bs_cy + 32'd1;
            if bht_train_en {
                bs_cond   = bs_cond + 32'd1;
                bs_prevpc = bp_train_pc;
                bs_prevok = 1'b1;
                if bs_prevok && (bs_prevpc[63:3] == bp_train_pc[63:3]) {
                    if bs_prevpc[2:1] == bp_train_pc[2:1] {
                        bs_same = bs_same + 32'd1;
                    } else {
                        bs_alias = bs_alias + 32'd1;
                    }
                }
                if bs_rdval && (bs_rdtag == bs_tag) && (bs_rdoff != bp_train_pc[2:1]) {
                    bs_alias2 = bs_alias2 + 32'd1;
                }
                if bs_pop == 3'd1 {
                    bs_pc1 = bs_pc1 + 32'd1;
                } else if bs_pop == 3'd2 {
                    bs_pc2 = bs_pc2 + 32'd1;
                } else if bs_pop == 3'd3 {
                    bs_pc3 = bs_pc3 + 32'd1;
                } else {
                    bs_pc4 = bs_pc4 + 32'd1;
                }
                bs_toff[bs_idx] = bp_train_pc[2:1];
                bs_ttag[bs_idx] = bs_tag;
                bs_tval[bs_idx] = 1'b1;
                bs_tmsk[bs_idx] = bs_newmsk;
            }
            if bs_cy[15:0] == 16'hffff {
                $display("BLK cy=%d cond=%d alias2=%d pop1=%d pop2=%d pop3=%d pop4=%d", bs_cy, bs_cond, bs_alias2, bs_pc1, bs_pc2, bs_pc3, bs_pc4);
            }
        }
    }
    // ── f2.15 STAGE-B OVERRIDE CENSUS (temporary; DEAD at OVR_STATS=0) ──
    // Sizes the prize for "move the clocked prediction onto the run-ahead pointer": every
    // sb_override is one bubble that a prediction available AT Stage-A would not have cost.
    // Split by cause so we know the character of the remaining population at the best ladder
    // rung (variant-A + L0 + slot-1), not just its size.
    const OVR_STATS: bit = 0;
    var ov_cy    : logic<32>;
    var ov_drain : logic<32>; // sb_drain cycles (the delivery population overrides are drawn from)
    var ov_tot   : logic<32>; // sb_override fires
    var ov_s0_mis: logic<32>; // slot-0: full says TAKEN, L0 did not     → L0 coverage miss
    var ov_s0_fp : logic<32>; // slot-0: L0 took, full says NOT taken    → L0 false positive
    var ov_s0_tgt: logic<32>; // slot-0: both taken, targets differ      → L0 target wrong
    var ov_s1    : logic<32>; // slot-1 override (any cause)
    always_ff (clk, rst) {
        if_reset {
            ov_cy     = 32'd0;
            ov_drain  = 32'd0;
            ov_tot    = 32'd0;
            ov_s0_mis = 32'd0;
            ov_s0_fp  = 32'd0;
            ov_s0_tgt = 32'd0;
            ov_s1     = 32'd0;
        } else if OVR_STATS {
            ov_cy = ov_cy + 32'd1;
            if sb_drain {
                ov_drain = ov_drain + 32'd1;
            }
            if sb_override {
                ov_tot = ov_tot + 32'd1;
                if sb_disagree0 {
                    if pt0_eff && !a_l0_taken {
                        ov_s0_mis = ov_s0_mis + 32'd1;
                    } else if !pt0_eff && a_l0_taken {
                        ov_s0_fp = ov_s0_fp + 32'd1;
                    } else {
                        ov_s0_tgt = ov_s0_tgt + 32'd1;
                    }
                }
                if sb_ovr_taken1 {
                    ov_s1 = ov_s1 + 32'd1;
                }
            }
            if ov_cy[15:0] == 16'hffff {
                $display("OVR cy=%d drain=%d ovr=%d s0mis=%d s0fp=%d s0tgt=%d s1=%d",
                    ov_cy, ov_drain, ov_tot, ov_s0_mis, ov_s0_fp, ov_s0_tgt, ov_s1);
            }
        }
    }
    // ── f2.14 FTQ DEPTH INSTRUMENTATION (temporary; DEAD at FTQ_STATS=0) ──
    // Reproduces f2.12's control table AND decomposes pp_reseed by which flush term actually
    // fired (priority order, so the five counters sum to pp_reseed). Blocker 1 in the f2.13
    // hand-off is "reseed is 16 % of cycles" — but not which reseed, which is what decides
    // whether the reseed rate is even attackable.
    const FTQ_STATS: bit = 0;
    var st_cy      : logic<32>;
    var st_depth   : logic<48>; // sum of ftq_count → mean depth
    var st_dmax    : logic<4> ;
    var st_byp     : logic<32>;
    var st_enq     : logic<32>;
    var st_wide    : logic<32>;
    var st_pop     : logic<32>;
    var st_reseed  : logic<32>;
    var st_rs_redir: logic<32>;
    var st_rs_earl : logic<32>;
    var st_rs_sbov : logic<32>;
    var st_rs_ext  : logic<32>;
    var st_rs_div  : logic<32>;
    // f2.15e: the sixth reseed term, plus the split that matters here — how many Stage-A takes came
    // from the run-ahead DESCRIPTOR (free: fetch already went there) versus from the L0 (still costs
    // a flush + reseed). That ratio is the mechanism's coverage, measured directly.
    var st_rs_l0   : logic<32>;
    var st_bd0     : logic<32>;
    var st_bd1     : logic<32>;
    // f2.16 census: the same L0-only population, split by KIND. The descriptor declines returns
    // (a block entry holds the LAST return address — the value a RAS exists to replace) and
    // indirects (where the L0 declines too), so the split says whether the remaining 37 % is the
    // return gap the run-ahead RAS closes, or something else entirely. Measure before building.
    // The census said slot-1 conditionals are 70 % of the residual, so this splits THAT bucket by
    // why the descriptor declined it: no taken exit recorded for the dword at all, versus an exit
    // recorded at a different halfword than slot-1's. The two answers point at opposite fixes.
    // f2.16b: the same nodesc bucket, attributed to the PRODUCER's own reason for THIS dword
    // (bd_why, carried down with the descriptor) instead of to an aggregate producer rate.
    // f2.16b: WHERE in the dword the untrained slot-1 conditional sits. blkpred's train excludes a
    // 32-bit transfer at halfword 3 (blk_train_straddle) because its bytes cross into the next
    // dword, so it can never be that dword's exit. If this histogram piles up at 3, the gap is
    // structural — a per-dword block entry cannot describe a branch that straddles the boundary.
    // The same population counted at its SOURCE: committed conditionals the train refuses.
    // f2.16b: the histogram landed 100 % at halfword 0, which means slot-1 is at the START of a
    // dword — so it is in the NEXT dword, and bd_taken1's `s1_pc[63:3] == ic_pc[63:3]` excludes it
    // by construction. The descriptor that DOES describe it is one WORD-FIFO entry along. Measure
    // how much of the gap that entry would close, before building anything.
                                //    delivery-path loss (bypass/head mismatch), not a prediction one
    // f2.17: the SLOT-0 residue (cond 1994 + uncond 1007 of the 4549 left after f2.16c).
    // Unlike the slot-1 case, bd_why here describes ic_pc's OWN dword, so the attribution is direct.
    // nodesc measured at 100 % of that bucket, so the next question is at the PRODUCER: of the dwords
    // it describes, why does it record no taken exit? These partition every pp_step in priority order.
    var st_pp_step : logic<32>; // descriptors produced
    var st_pp_nvld : logic<32>; //   lookup in flight was invalidated by a re-seed
    var st_pp_nod  : logic<32>; //   suppressed by the mid-dword re-entry guard
    var st_pp_miss : logic<32>; //   blkpred tag miss (cold or evicted)
    var st_pp_weak : logic<32>; //   hit, a conditional slot is valid, but no slot is strong
    var st_pp_none : logic<32>; //   hit, and the dword records no taken exit and no conditional at all
    var st_pp_take : logic<32>; //   a taken exit WAS produced
    var st_pp_rcv  : logic<32>; //   of nodesc: the exit is AT OR AFTER the re-entry — recoverable
    always_ff (clk, rst) {
        if_reset {
            st_cy       = 32'd0;
            st_depth    = 48'd0;
            st_dmax     = 4'd0;
            st_byp      = 32'd0;
            st_enq      = 32'd0;
            st_wide     = 32'd0;
            st_pop      = 32'd0;
            st_reseed   = 32'd0;
            st_rs_redir = 32'd0;
            st_rs_earl  = 32'd0;
            st_rs_sbov  = 32'd0;
            st_rs_ext   = 32'd0;
            st_rs_div   = 32'd0;
            st_rs_l0    = 32'd0;
            st_bd0      = 32'd0;
            st_bd1      = 32'd0;
            st_pp_step  = 32'd0;
            st_pp_nvld  = 32'd0;
            st_pp_nod   = 32'd0;
            st_pp_miss  = 32'd0;
            st_pp_weak  = 32'd0;
            st_pp_none  = 32'd0;
            st_pp_take  = 32'd0;
            st_pp_rcv   = 32'd0;
        } else if FTQ_STATS {
            st_cy    = st_cy + 32'd1;
            st_depth = st_depth + {44'd0, ftq_count};
            if ftq_count >: st_dmax {
                st_dmax = ftq_count;
            }
            if f0_ftq_byp {
                st_byp = st_byp + 32'd1;
            }
            if ftq_enq {
                st_enq = st_enq + 32'd1;
            }
            if pp_wide {
                st_wide = st_wide + 32'd1;
            }
            if f0_ftq_pop {
                st_pop = st_pop + 32'd1;
            }
            if pp_reseed {
                st_reseed = st_reseed + 32'd1;
                if redirect_fire {
                    st_rs_redir = st_rs_redir + 32'd1;
                } else if early_redir_fire_q {
                    st_rs_earl = st_rs_earl + 32'd1;
                } else if sb_override && !sb_ovr_soft {
                    st_rs_sbov = st_rs_sbov + 32'd1;
                } else if FTQ_DESC && l0_redir {
                    st_rs_l0 = st_rs_l0 + 32'd1;
                } else if ext_taken_redir {
                    st_rs_ext = st_rs_ext + 32'd1;
                } else {
                    st_rs_div = st_rs_div + 32'd1;
                }
            }
            // Stage-A takes, split by SOURCE. bd_* is the free path (fetch already followed it);
            // l0tk is the L0-only take that still pays a flush + reseed.
            if fb_push0 {
                if bd_taken0 {
                    st_bd0 = st_bd0 + 32'd1;
                }
                if bd_taken1 {
                    st_bd1 = st_bd1 + 32'd1;
                }
            }
            if bht_train_en {
                if blk_train_straddle {
                }
            }
            // Producer-side census: for every descriptor the producer commits to, why is there no
            // taken exit? The six arms partition pp_step. `take` is tested BEFORE the guard so the
            // split reads correctly at PRED_BLK_REENT=1 too, where a guarded dword can still take.
            if pp_step {
                st_pp_step = st_pp_step + 32'd1;
                if !pp_desc_vld {
                    st_pp_nvld = st_pp_nvld + 32'd1;
                } else if pd_taken {
                    st_pp_take = st_pp_take + 32'd1;
                } else if pp_no_desc_q {
                    st_pp_nod = st_pp_nod + 32'd1;
                    // The opportunity PRED_BLK_REENT takes, computed independently of the const so it
                    // reads the same at both settings: the entry records SOME exit at or after the
                    // halfword extract re-enters at, so extract reaches it.
                    if blk_hit && (
                        (PRED_BLK_COND && blk_b0_valid && (blk_b0_ctr == 2'd3) && (blk_b0_off >= pp_ent_off_q))
                        || (PRED_BLK_COND && blk_b1_valid && (blk_b1_ctr == 2'd3) && (blk_b1_off >= pp_ent_off_q))
                        || (blk_tl_valid && !blk_tl_is_ret && !blk_tl_is_ind && (blk_tl_off >= pp_ent_off_q))
                    ) {
                        st_pp_rcv = st_pp_rcv + 32'd1;
                    }
                } else if !blk_hit {
                    st_pp_miss = st_pp_miss + 32'd1;
                } else if blk_b0_valid || blk_b1_valid {
                    st_pp_weak = st_pp_weak + 32'd1;
                } else {
                    st_pp_none = st_pp_none + 32'd1;
                }
            }
            if st_cy[15:0] == 16'hffff {
                $display("FTQ cy=%d depthsum=%d dmax=%d byp=%d enq=%d wide=%d pop=%d reseed=%d (redir=%d earl=%d sbov=%d l0=%d ext=%d div=%d) bd0=%d bd1=%d",
                    st_cy, st_depth, st_dmax, st_byp, st_enq, st_wide, st_pop, st_reseed,
                    st_rs_redir, st_rs_earl, st_rs_sbov, st_rs_l0, st_rs_ext, st_rs_div,
                    st_bd0, st_bd1);
                $display("FTQ-PROD cy=%d step=%d take=%d nvld=%d nodesc=%d (recoverable=%d) miss=%d weak=%d nocond=%d",
                    st_cy, st_pp_step, st_pp_take, st_pp_nvld, st_pp_nod, st_pp_rcv, st_pp_miss,
                    st_pp_weak, st_pp_none);
            }
        }
    }
    // Word FIFO storage. Push the arriving dword; the extract-side pop (W2) drains it.
    // Flushed on any redirect (wrong-path words younger than the resolved branch).
    always_ff (clk, rst) {
        if_reset {
            wf_head  = 3'd0;
            wf_tail  = 3'd0;
            wf_count = 4'd0;
            // f2.15e: reset the descriptor slots so the const-gated (dead-at-0) extract-side read is
            // never of an unassigned array — the ftq_pc idiom. At FTQ_DESC=0 they are reset-only → DCE.
            for i in 0..WF_N {
                wf_d_taken[i]  = 1'b0;
                wf_d_target[i] = 64'd0;
                wf_d_off[i]    = 2'd0;
                wf_d_why[i]    = 3'd0;
            }
        } else if ICACHE_SYNC_READ {
            // Write ONLY at =1 → reset-only at =0 → the FIFO pointers + data arrays DCE.
            // Flush on a commit/early redirect OR a predicted-taken re-steer (the buffered
            // words after the taken branch are wrong-path; F0 refetches from the target).
            // F1 order-item-3 (A): sb_override (Stage-B taken redirect) flushes the wrong-path
            // sequential dwords too. F1 option (B) b.2: l0_redir (Stage-A L0-taken re-steer) flushes
            // the same wrong-path sequential dwords, a cycle earlier. DEAD at 0.
            // f2.3: a SOFT override (sb_ovr_soft) does NOT flush — the FTB-followed FIFO already
            // holds the correct-path target at head+1, so `sb_override && !sb_ovr_soft` (HARD only)
            // flushes; the soft case falls through to the else arm and pops the branch dword instead.
            if any_redirect || ext_taken_redir || f0_diverged || (sb_override && !sb_ovr_soft) || l0_redir {
                wf_head  = 3'd0;
                wf_tail  = 3'd0;
                wf_count = 4'd0;
            } else {
                if wf_do_push {
                    // Cacheable: the natural 64-bit icache window {high, low}. Non-cacheable
                    // (wf_push_nc_q): assemble the dword from the beat-0 low word (f0_nc_lo_q)
                    // and the beat-1 high word arriving now as icache_rdata.
                    wf_data[wf_tail]   = if wf_push_nc_q ? {icache_rdata, f0_nc_lo_q} : {icache_rdata_next, icache_rdata};
                    wf_pc[wf_tail]     = wf_push_pc_q;
                    wf_ifault[wf_tail] = wf_push_ifault_q;
                    wf_iacc[wf_tail]   = wf_push_iacc_q;
                    wf_gstage[wf_tail] = wf_push_gstage_q;
                    wf_gpa[wf_tail]    = wf_push_gpa_q;
                    // f2.15e: the descriptor lands with its dword (const-gated → DCE at 0).
                    if FTQ_DESC {
                        wf_d_taken[wf_tail]  = wf_push_d_taken_q;
                        wf_d_target[wf_tail] = wf_push_d_target_q;
                        wf_d_off[wf_tail]    = wf_push_d_off_q;
                        wf_d_why[wf_tail]    = wf_push_d_why_q;
                    }
                    wf_tail            = wf_tail + 3'd1;
                }
                // f2.3 soft override: pop the branch dword so wf_head advances to the prefetched
                // target entry (head+1), keeping the rest of the FIFO — the wrong-path Stage-A produce
                // (its ext_pop) is squashed, so the soft pop is the authoritative single pop this
                // cycle. Else the normal extract-side pop: the head dword is consumed when ext_pc_q
                // crosses it. DEAD at 0: sb_ovr_soft const-false → folds to `if ext_pop`.
                if sb_ovr_soft {
                    wf_head = wf_head + 3'd1;
                } else if ext_pop {
                    // f2.16b: two dwords when the taken slot-1 lived in head+1 (see ext_pop2).
                    wf_head = wf_head + (if ext_pop2 ? 3'd2 : 3'd1);
                }
                wf_count = wf_count + (if wf_do_push ? 4'd1 : 4'd0)
                    - (if sb_ovr_soft ? 4'd1 : if ext_pop ? (if ext_pop2 ? 4'd2 : 4'd1) : 4'd0);
            }
        }
    }
    // W2 extract pointer register (the slot-0 instruction PC). Advances past the delivered
    // bundle on a delivery (mirrors the fetch FSM's pc_q next-PC, now computed on ext_pc_q via
    // ic_pc), reseeds on redirect / early-redirect. straddle_q (shared with the fetch FSM)
    // still carries the 2-cycle straddle; W3 re-times straddle onto the FIFO's fetch-ahead
    // high word and adds the FIFO-availability deliver gate + predicted-taken→F0 redirect.
    // DEAD at 0: written ONLY under `else if ICACHE_SYNC_READ` → reset-only at 0 → DCE.
    always_ff (clk, rst) {
        if_reset {
            ext_pc_q = RESET_PC;
        } else if ICACHE_SYNC_READ {
            if redirect_fire {
                ext_pc_q = redirect_pc;
            } else if early_redir_fire_q {
                ext_pc_q = early_redir_pc_q;
            } else if sb_override {
                // F1 order-item-3 (A): Stage-B taken override re-steers the extract pointer to the
                // target — the sequential ext_eff_next advance (this same cycle's Stage-A produce)
                // was wrong-path and its skid capture is squashed. DEAD at 0 (sb_override const-0).
                ext_pc_q = sb_override_target;
            // At PRED_PIPE=1 the Stage-A advance is gated on the skid accepting (sb_can_accept)
            // instead of !fb_full — fb-full back-pressure moved to the Stage-B drain. This
            // branch is only reached when !any_redirect, so sb_can_accept && fetch_ready ==
            // fb_push0 there (Stage-A produce). Byte-identical at 0 (folds to !fb_full).
            } else if (if PRED_PIPE ? sb_can_accept : !fb_full) {
                if fetch_ready {
                    // F1 order-item-3 (A): at PRED_OVERRIDE=1 advance SEQUENTIALLY (ext_eff_next =
                    // ext_seq_next); Stage-B overrides on a taken branch. Byte-identical at 0.
                    ext_pc_q = ext_eff_next;
                }
            }
        }
    }
    // F1 order-item-2: Stage-B skid register (DEAD at PRED_PIPE=0). A 1-deep holding register
    // between extract-assemble/predict (Stage-A, T) and the fetch-buffer write (Stage-B, T+1).
    //  - Stage-A PRODUCES (fb_push0, gated on sb_can_accept) → capture the bundle, a_valid=1.
    //  - the held bundle DRAINS (sb_drain) into the fetch buffer via fb_wr0/fb_wr1 below.
    //  - produce + drain the same cycle → the OLD bundle drains (fb_wr* read the pre-edge a_*)
    //    while the NEW one is captured; a_valid stays 1.
    //  - drain, no produce → a_valid=0.  any_redirect → flush the wrong-path skid (a_valid=0;
    //    fb_push0 is already 0 under a redirect, and the fb write takes its any_redirect branch
    //    so the skid is never drained on a redirect).
    // Written ONLY under `else if PRED_PIPE` → reset-only at 0 → every a_* reg (and its fanin)
    // DCEs, byte-identical (the fb write folds back to the live Stage-A push at =0).
    always_ff (clk, rst) {
        if_reset {
            a_valid         = 1'b0;
            a_push0         = 1'b0;
            a_push1         = 1'b0;
            a_pc            = 64'd0;
            a_s0            = 32'd0;
            a_is_rvc0       = 1'b0;
            a_ifault        = 1'b0;
            a_iacc          = 1'b0;
            a_gstage        = 1'b0;
            a_gpa           = 64'd0;
            a_pred_next_pc0 = 64'd0;
            a_pred_index0   = 13'd0;
            a_ghr_fold0     = 1'b0;
            a_s1_pc         = 64'd0;
            a_s1            = 32'd0;
            a_s1_is_rvc     = 1'b0;
            a_pred_next_pc1 = 64'd0;
            a_pred_index1   = 13'd0;
            a_ghr_fold1     = 1'b0;
            a_slot1_elig    = 1'b0;
            a_straddle      = 1'b0;
            a_ftb_next      = 64'd0;
            a_eff_next      = 64'd0;
            a_l0_taken      = 1'b0;
            a_l0_target     = 64'd0;
            a_l0_taken1     = 1'b0;
            a_l0_target1    = 64'd0;
            a_tage_hit      = 1'b0;
            a_tage_taken    = 1'b0;
            a_tage_hit2     = 1'b0;
            a_tage_taken2   = 1'b0;
        } else if PRED_PIPE {
            // F1 order-item-3 (A): sb_override (Stage-B taken redirect) flushes the wrong-path
            // Stage-A capture produced THIS cycle (the sequential bundle past the taken branch) —
            // the drained taken bundle itself still writes the fb via fb_wr0. sb_override const-0
            // at PRED_OVERRIDE=0 → byte-identical.
            if any_redirect || sb_override {
                a_valid = 1'b0;
            } else if fb_push0 {
                a_valid         = 1'b1;
                a_push0         = fb_push0;
                a_push1         = fb_push1;
                a_pc            = ic_pc;
                a_s0            = fetched_instr;
                a_is_rvc0       = !straddle_q && curr_is_rvc;
                a_ifault        = ic_ifault;
                a_iacc          = ic_iacc;
                a_gstage        = ic_gstage;
                a_gpa           = ic_gpa;
                a_pred_next_pc0 = pred_next_pc_bp;
                a_pred_index0   = bht_lk_index;
                a_ghr_fold0     = btb_hit && btb_is_cond;
                a_s1_pc         = s1_pc;
                a_s1            = s1_instr;
                a_s1_is_rvc     = s1_is_rvc;
                a_pred_next_pc1 = pred_next_pc1;
                a_pred_index1   = bht_lk_index1;
                a_ghr_fold1     = btb_hit2 && btb_is_cond2;
                a_slot1_elig    = slot1_eligible;
                a_straddle      = straddle_q;
                a_ftb_next      = ext_next_pc;
                a_eff_next      = ext_eff_next;
                // f2.15e: Stage-B reconciles against what Stage-A ACTUALLY applied, which is now the
                // descriptor wherever it spoke. Both tables are trained from the same committed
                // stream, so a descriptor take normally agrees with the clocked full prediction and
                // sb_override does not fire — that agreement is the whole prize.
                a_l0_taken      = l0e_taken;
                a_l0_target     = l0e_target;
                a_l0_taken1     = l0e_taken1;
                a_l0_target1    = l0e_target1;
                // f2.6: the Stage-A TAGE read, aligned to a_pc — Stage-B replays it (tage_*_sb).
                a_tage_hit      = tage_hit;
                a_tage_taken    = tage_taken;
                a_tage_hit2     = tage_hit2;
                a_tage_taken2   = tage_taken2;
            } else if sb_drain {
                a_valid = 1'b0;
            }
        }
    }
    // (b) B1: FTB training. On an unconditional-taken slot-0 delivery (JAL / direct always-taken:
    // btb_hit, not conditional / return / indirect → pred_target == btb_target, no speculative
    // RAS/BHT/iBTB state to reproduce at F0), record {target} at the branch dword. EXCLUDE a
    // straddling branch (a 32-bit op at dword byte-offset 6, ic_pc[2:1]==11): F0's redirect off
    // that dword would skip the sequential dword carrying the branch's high half. Indexed by the
    // branch's dword — the SAME index F0 reads on pc_fetch_q for the same dword. Only ftb_valid is
    // reset (it gates the hit); tag/target infer as an SRAM-like RF, masked by valid=0. DEAD/DCE at
    // ICACHE_FETCH_DIRECTED=0 (reset-only writes). A hint — extract stays authoritative (§24.4).
    // Any trainable branch delivery at slot-0: unconditional (B1) always; conditional too under
    // ICACHE_FTB_COND (B2a). Returns/indirect excluded (need RAS/iBTB); straddling excluded (F0's
    // redirect would skip the branch's high half). At ICACHE_FTB_COND=0 this folds to B1's
    // `!btb_is_cond` gate → byte-identical to B1 (is_cond/conf writes are then dead → DCE).
    // F1 order-item-3 (A): the SIMPLE variant gates the F0 FTB OFF (F0 is a plain sequential stream,
    // the Stage-B override is the only steer) — so its training is inert; suppress it under
    // PRED_OVERRIDE. f2.1: `(!PRED_OVERRIDE || FTB_OVERRIDE)` re-trains the FTB under PRED_OVERRIDE=1
    // when FTB_OVERRIDE=1 (F0 then follows it as a run-ahead producer). Folds to `!PRED_OVERRIDE` at
    // FTB_OVERRIDE=0 → byte-identical.
    // f2.5d.1: RE-TIME the train to Stage-B under PRED_OVERRIDE. f2.1 re-enabled this train while it
    // still keyed on the STAGE-A produce (fb_push0) and indexed by the Stage-A PC (ic_pc) — but with
    // the predictors clocked, btb_hit/btb_is_*/pred_target on that cycle are the read of ic_pc(T-1).
    // So the entry for dword(ic_pc(T)) was written with the target of the branch at ic_pc(T-1): every
    // trained entry was ALIASED by one bundle (the "stale/aliased FTB entry" the f2.4-fix corner-3
    // trace saw). Under PRED_OVERRIDE the aligned operands are the Stage-B ones — the delivery
    // (deliver0), the captured PC/length (a_pc/a_is_rvc0), and the frozen prediction (hit0_eff/
    // cond0_eff/ret0_eff/ind0_eff/pt0_eff/tgt0_eff, which correspond to a_pc by construction).
    // pt0_eff replaces cond_taken0 in the direction arm: that arm already implies hit && is_cond, and
    // predicted_taken == cond_taken0 there. Every mux folds to today's Stage-A operand at
    // PRED_OVERRIDE=0 → the =0 train is unchanged.
    let ftb_tr_fire: logic     = if PRED_OVERRIDE ? deliver0  : fb_push0;
    let ftb_tr_pc  : logic<64> = if PRED_OVERRIDE ? a_pc      : ic_pc;
    let ftb_tr_rvc : logic     = if PRED_OVERRIDE ? a_is_rvc0 : curr_is_rvc;
    let ftb_tr_hit : logic     = if PRED_OVERRIDE ? hit0_eff  : btb_hit;
    let ftb_tr_cond: logic     = if PRED_OVERRIDE ? cond0_eff : btb_is_cond;
    let ftb_tr_ret : logic     = if PRED_OVERRIDE ? ret0_eff  : btb_is_ret;
    let ftb_tr_ind : logic     = if PRED_OVERRIDE ? ind0_eff  : btb_is_ind;
    let ftb_tr_dir : logic     = if PRED_OVERRIDE ? pt0_eff   : cond_taken0;
    let ftb_tr_tgt : logic<64> = if PRED_OVERRIDE ? tgt0_eff  : pred_target;
    // f2.5d: the CALL kind + the call's return address (its fall-through PC — what the run-ahead RAS
    // pushes). Same Stage-A/Stage-B operand split; both are read only under PRED_RAS_AHEAD.
    let ftb_tr_call    : logic     = if PRED_OVERRIDE ? call0_eff : btb_is_call;
    let ftb_tr_ret_addr: logic<64> = if PRED_OVERRIDE ? a_pc + a_len0 : ic_pc + pc_advance;
    let ftb_br_deliver: logic = ICACHE_FETCH_DIRECTED && ICACHE_SYNC_READ && (!PRED_OVERRIDE || FTB_OVERRIDE) && ftb_tr_fire
        && ftb_tr_hit && !ftb_tr_ret && !ftb_tr_ind
        && (!ftb_tr_cond || ICACHE_FTB_COND)
        && (ftb_tr_rvc || ftb_tr_pc[2:1] != 2'b11);
    // f2.5d: RETURN entries — excluded from ftb_br_deliver above (no usable stored target), trainable
    // here because the run-ahead RAS supplies the target at predict time. Same straddle exclusion.
    // Returns are unconditional, so no confidence gate. DEAD at PRED_RAS_AHEAD=0 (const-false).
    let ftb_ret_deliver: logic = PRED_RAS_AHEAD && ICACHE_FETCH_DIRECTED && ICACHE_SYNC_READ
        && (!PRED_OVERRIDE || FTB_OVERRIDE) && ftb_tr_fire
        && ftb_tr_hit && ftb_tr_ret
        && (ftb_tr_rvc || ftb_tr_pc[2:1] != 2'b11);
    let ftb_tr_idx: logic<FTB_IDX_W> = ftb_tr_pc[FTB_IDX_W + 2:3];
    let ftb_tr_tag: logic<FTB_TAG_W> = ftb_tr_pc[63:FTB_IDX_W + 3];
    let ftb_tr_same: logic = ftb_valid[ftb_tr_idx] && (ftb_tag[ftb_tr_idx] == ftb_tr_tag);
    always_ff (clk, rst) {
        if_reset {
            for i in 0..FTB_N {
                ftb_valid[i] = 1'b0;
                // f2.5d: the two kind bits gate the run-ahead RAS, so reset them like ftb_valid
                // (ftb_ret_addr stays unreset — masked by is_call, as tag/target are by valid).
                ftb_is_call[i] = 1'b0;
                ftb_is_ret[i]  = 1'b0;
            }
        } else if ICACHE_FETCH_DIRECTED {
            if ftb_br_deliver {
                if !ftb_tr_cond {
                    // Unconditional: always taken, always followed (conf=3, is_cond=0) — B1.
                    ftb_valid[ftb_tr_idx]   = 1'b1;
                    ftb_tag[ftb_tr_idx]     = ftb_tr_tag;
                    ftb_target[ftb_tr_idx]  = ftb_tr_tgt;
                    ftb_is_cond[ftb_tr_idx] = 1'b0;
                    ftb_conf[ftb_tr_idx]    = 2'd3;
                    // f2.5d: a CALL (jal/jalr writing the link reg) is unconditional, so this is the
                    // only arm that can install one. Record its return address for the run-ahead RAS
                    // push; clear is_ret in case this index previously held a return entry.
                    // ftb_ret_addr is written UNGATED (like ftb_tag/ftb_target, and unlike the two
                    // kind bits) so the analyzer does not flag it unassigned at PRED_RAS_AHEAD=0; it
                    // is masked by ftb_is_call, which IS gated, so the array is unread → DCE at 0.
                    ftb_ret_addr[ftb_tr_idx] = ftb_tr_ret_addr;
                    if PRED_RAS_AHEAD {
                        ftb_is_call[ftb_tr_idx] = ftb_tr_call;
                        ftb_is_ret[ftb_tr_idx]  = 1'b0;
                    }
                } else if ftb_tr_dir {
                    // Conditional, extract predicts TAKEN: (re)store the target, bump confidence.
                    // A same-dword conditional entry saturates up; a new/aliased slot inits weak-taken.
                    ftb_valid[ftb_tr_idx]   = 1'b1;
                    ftb_tag[ftb_tr_idx]     = ftb_tr_tag;
                    ftb_target[ftb_tr_idx]  = ftb_tr_tgt;
                    ftb_is_cond[ftb_tr_idx] = 1'b1;
                    if ftb_tr_same && ftb_is_cond[ftb_tr_idx] {
                        if ftb_conf[ftb_tr_idx] != 2'd3 {
                            ftb_conf[ftb_tr_idx] = ftb_conf[ftb_tr_idx] + 2'd1;
                        }
                    } else {
                        ftb_conf[ftb_tr_idx] = 2'd2;
                    }
                    // f2.5d: a conditional branch is never a call/return — clear both in case this
                    // index previously held one (the entry is being re-tagged to this dword).
                    if PRED_RAS_AHEAD {
                        ftb_is_call[ftb_tr_idx] = 1'b0;
                        ftb_is_ret[ftb_tr_idx]  = 1'b0;
                    }
                } else {
                    // Conditional, extract predicts NOT-taken: decay only an existing conditional
                    // entry for this dword (no target on a fall-through). At conf 0 F0 stops following.
                    if ftb_tr_same && ftb_is_cond[ftb_tr_idx] && (ftb_conf[ftb_tr_idx] != 2'd0) {
                        ftb_conf[ftb_tr_idx] = ftb_conf[ftb_tr_idx] - 2'd1;
                    }
                }
            } else if ftb_ret_deliver {
                // f2.5d: RETURN entry. No stored target is used (the run-ahead RAS supplies it at
                // predict time); ftb_target is still written so the entry stays self-consistent.
                // Unconditional shape (is_cond=0, conf=3) so pp_ftb_follow always follows it.
                ftb_valid[ftb_tr_idx]   = 1'b1;
                ftb_tag[ftb_tr_idx]     = ftb_tr_tag;
                ftb_target[ftb_tr_idx]  = ftb_tr_tgt;
                ftb_is_cond[ftb_tr_idx] = 1'b0;
                ftb_conf[ftb_tr_idx]    = 2'd3;
                ftb_is_call[ftb_tr_idx] = 1'b0;
                ftb_is_ret[ftb_tr_idx]  = 1'b1;
            }
        }
    }

    // ============================================================
    // F1 order-item-2: fetch-buffer write drivers. At PRED_PIPE=1 the write is the Stage-B skid
    // DRAIN (registered a_push0/a_push1 gated by sb_drain); at =0 it is the live Stage-A push
    // (fb_push0/fb_push1). Byte-identical at 0 (the mux folds to the live push). The per-field
    // data-source muxes below fold likewise, so =0 emits today's exact write.
    let fb_wr0: logic = if PRED_PIPE ? (sb_drain && a_push0) : fb_push0;
    // F1 order-item-3 (A): the drained slot-1 is suppressed when slot-0 resolved taken at Stage-B
    // (sb_slot1_kill) — it sits past the taken branch. Folds to the order-item-2 form at
    // PRED_OVERRIDE=0 (sb_slot1_kill const-false) → byte-identical.
    let fb_wr1: logic = if PRED_PIPE ? (sb_drain && a_push1 && !sb_slot1_kill) : fb_push1;
    // Phase 8 S4a: fetch buffer (decode queue). The fetch engine pushes a clean
    // record (fb_push) and rename drains the head (fb_pop). The head is exposed
    // combinationally on the if_*_q names every downstream stage already reads.
    // On a flush the FIFO is emptied (head=tail, count=0). Per-field plain
    // arrays avoid the dynamic-index struct-field-read sim bug.
    // ============================================================
    always_ff (clk, rst) {
        if_reset {
            fb_head  = 3'd0;
            fb_tail  = 3'd0;
            fb_count = 4'd0;
        } else if any_redirect {
            // Phase 8 S8.E: drain the fetch buffer on an early redirect too (it
            // holds wrong-path records younger than the resolved branch). The
            // Stage-B skid is flushed in its own always_ff (a_valid=0) — a
            // wrong-path skid bundle is never written here (this branch skips fb_wr*).
            fb_head  = 3'd0;
            fb_tail  = 3'd0;
            fb_count = 4'd0;
        } else {
            if fb_wr0 {
                fb_pc[fb_tail]           = if PRED_PIPE ? a_pc : ic_pc;
                fb_instr[fb_tail]        = if PRED_PIPE ? a_s0 : fetched_instr;
                // M7: track RVC-origin for the link register (pc+2 vs pc+4). A
                // straddle resolves a 32-bit instr, so is_rvc=0 in that case.
                fb_is_rvc[fb_tail]       = if PRED_PIPE ? a_is_rvc0 : (!straddle_q && curr_is_rvc);
                fb_ifault[fb_tail]       = if PRED_PIPE ? a_ifault : ic_ifault;
                fb_iacc[fb_tail]         = if PRED_PIPE ? a_iacc : ic_iacc;
                fb_ifault_gstage[fb_tail] = if PRED_PIPE ? a_gstage : ic_gstage;
                fb_ifault_gpa[fb_tail]   = if PRED_PIPE ? a_gpa : ic_gpa;
                // F1 order-item-3 (A): at PRED_OVERRIDE=1 the delivered prediction is resolved at
                // Stage-B from the clocked outputs (sb_next0) + the live folded direction (aligned
                // to a_pc at the drain); a_pred_index0 stays the Stage-A fetch-time index (correct).
                // Both fold to the order-item-2 forms at 0 → byte-identical.
                fb_pred_next_pc[fb_tail] = if PRED_OVERRIDE ? sb_next0 : (if PRED_PIPE ? a_pred_next_pc0 : pred_next_pc_bp);
                fb_pred_index[fb_tail]   = if PRED_PIPE ? a_pred_index0 : bht_lk_index;
                fb_ghr_fold[fb_tail]     = if PRED_OVERRIDE ? (btb_hit && btb_is_cond) : (if PRED_PIPE ? a_ghr_fold0 : (btb_hit && btb_is_cond));
            }
            // Phase 8 S4a.3: slot-1 record into fb_tail+1. slot-1 is delivered
            // only on a clean, non-faulting, not-predicted-taken slot-0, so its
            // ifault is 0. Dead until S4a.3-b (fb_push1 needs slot1_valid_gate).
            if fb_wr1 {
                fb_pc[fb_tail1]           = if PRED_PIPE ? a_s1_pc : s1_pc;
                fb_instr[fb_tail1]        = if PRED_PIPE ? a_s1 : s1_instr;
                fb_is_rvc[fb_tail1]       = if PRED_PIPE ? a_s1_is_rvc : s1_is_rvc;
                fb_ifault[fb_tail1]       = 1'b0;
                fb_iacc[fb_tail1]         = 1'b0; // slot-1 same page as slot-0 → no PMP fault
                fb_ifault_gstage[fb_tail1] = 1'b0; // slot-1 never faults (same page as slot-0)
                fb_ifault_gpa[fb_tail1]   = 64'd0;
                fb_pred_next_pc[fb_tail1] = if PRED_OVERRIDE ? sb_next1 : (if PRED_PIPE ? a_pred_next_pc1 : pred_next_pc1);
                fb_pred_index[fb_tail1]   = if PRED_PIPE ? a_pred_index1 : bht_lk_index1;
                fb_ghr_fold[fb_tail1]     = if PRED_OVERRIDE ? (btb_hit2 && btb_is_cond2) : (if PRED_PIPE ? a_ghr_fold1 : (btb_hit2 && btb_is_cond2));
            }
            fb_tail = fb_tail + (if fb_wr0 ? (if fb_wr1 ? 3'd2 : 3'd1) : 3'd0);
            // Phase 8 S4b: 2-wide drain. fb_pop2 (== rename_fire2) drains the
            // head+1 record too, so head advances by 2 and count drops by 2.
            if fb_pop {
                fb_head = fb_head + (if fb_pop2 ? 3'd2 : 3'd1);
            }
            fb_count = fb_count + (if fb_wr0 ? (if fb_wr1 ? 4'd2 : 4'd1) : 4'd0) - (if fb_pop ? (if fb_pop2 ? 4'd2 : 4'd1) : 4'd0);
        }
    }

    // FIFO head → IF/ID hand-off (combinational reads; latency identical to the
    // old single registered latch since the record was pushed >=1 cycle earlier).
    // Phase 8 S17: fetch-buffer bypass. When the FIFO is EMPTY and the fetch
    // engine delivers this cycle, expose the live delivery directly as the
    // head so rename consumes it the SAME cycle instead of eating a 1-cycle
    // FIFO-traversal bubble (every post-redirect refill and icache-miss
    // return used to pay it). fb_bypass equals fb_push0 at count==0 (the
    // fb_full term is vacuous there) but is written WITHOUT fb_full, cutting
    // the would-be comb loop fb_pop → if_v_q → fb_push0 → fb_full → fb_pop.
    // The record is still physically pushed at the edge; a same-cycle fb_pop
    // just advances head past it (count 0+push−pop stays consistent). If
    // rename stalls or an IRQ is pending, fb_pop=0 and the pushed record is
    // consumed from the FIFO next cycle exactly as before.
    // CP Phase D (front-end pipeline): FETCH_REG makes the fetch buffer a TRUE
    // pipeline register — decode/rename read ONLY the registered FB head, never
    // the live combinational fetch (the S17 bypass / S17.2 fall-through). This
    // CUTS the front-end combinational sweep `pc_q -> imem_mmu -> icache -> cexp
    // -> decode -> rename` (the 14.565/14.315 critical cone) into a FETCH stage
    // (pc_q -> ... -> fb_*.D) and a DECODE stage (fb_*.Q -> decode -> rename).
    // DEAD at 0 = today's bypass (byte-identical). At 1 the bypass arms are
    // structurally removed (const-folds) and every fetch->decode hand-off costs
    // the 1-cycle FIFO bubble the S17 bypass used to hide (the +1 front-end
    // stage = the real IPC cost). The fetch FSM (pc_q advance, combinational
    // icache read for RVC length / prediction) is UNCHANGED — no block-fetch
    // redesign; the existing FB is the IF/ID register.
    const FETCH_REG: bit = 1;
    let s17_fb_bypass_en: logic = !FETCH_REG;
    let fb_bypass : logic = s17_fb_bypass_en && (fb_count == 4'd0) && fetch_ready && !any_redirect;
    // Slot-1 bypass: the slot-1 delivery (fb_push1) is also live this cycle.
    // At count==0 fb_free >= 8, so fb_push1 reduces to fb_push0 && slot1_valid.
    let fb_bypass2: logic = fb_bypass && slot1_valid;
    // S17.2 fall-through: with ONE record queued and a live delivery this
    // cycle, the live slot-0 delivery serves as the bundle's SECOND op (the
    // FIFO head is the first; fetch order == predicted program order, so the
    // pairing is correct even across a predicted-taken head). The record is
    // still pushed at the edge; fb_pop2 advances head past it (count
    // 1+push−2 = 0). fb_full is vacuous at count==1, same loop-cut as above.
    let fb_fall: logic = s17_fb_bypass_en && (fb_count == 4'd1) && fetch_ready && !any_redirect;
    // FETCH_REG: the `if FETCH_REG ? fb_*[fb_head] : <bypass mux>` wrappers
    // const-fold — at 0 the existing S17 bypass mux remains (byte-identical), at
    // 1 ONLY the registered FB read survives (the live arm is structurally gone,
    // cutting the icache->cexp->decode combinational path).
    assign if_v_q          = (fb_count != 4'd0) || fb_bypass;
    assign if_pc_q         = if FETCH_REG ? fb_pc[fb_head] : if fb_count != 4'd0 ? fb_pc[fb_head] : ic_pc;
    assign if_instr_q      = if FETCH_REG ? fb_instr[fb_head] : if fb_count != 4'd0 ? fb_instr[fb_head] : fetched_instr;
    assign if_is_rvc_q     = if FETCH_REG ? fb_is_rvc[fb_head] : if fb_count != 4'd0 ? fb_is_rvc[fb_head] : (!straddle_q && curr_is_rvc);
    assign if_pred_next_pc_q = if FETCH_REG ? fb_pred_next_pc[fb_head] : if fb_count != 4'd0 ? fb_pred_next_pc[fb_head] : pred_next_pc_bp;
    assign if_pred_index_q = if FETCH_REG ? fb_pred_index[fb_head] : if fb_count != 4'd0 ? fb_pred_index[fb_head] : bht_lk_index;
    let if_ghr_fold_q: logic     = if FETCH_REG ? fb_ghr_fold[fb_head] : if fb_count != 4'd0 ? fb_ghr_fold[fb_head] : (btb_hit && btb_is_cond);
    assign if_ifault_q     = if FETCH_REG ? fb_ifault[fb_head] : if fb_count != 4'd0 ? fb_ifault[fb_head] : ic_ifault;
    // PMP: instruction access fault, mirroring if_ifault_q (driven by the imem
    // PMP check; see imem_acc_fault_w / fb_iacc).
    assign if_iacc_q       = if FETCH_REG ? fb_iacc[fb_head] : if fb_count != 4'd0 ? fb_iacc[fb_head] : ic_iacc;
    // Phase 11-H3d: the gstage/gpa travelling with if_ifault_q (same mux).
    let if_ifault_gstage_q: logic     = if FETCH_REG ? fb_ifault_gstage[fb_head] : if fb_count != 4'd0 ? fb_ifault_gstage[fb_head] : ic_gstage;
    let if_ifault_gpa_q   : logic<64> = if FETCH_REG ? fb_ifault_gpa[fb_head] : if fb_count != 4'd0 ? fb_ifault_gpa[fb_head] : ic_gpa;

    // Phase 8 S4b: slot-1 (head+1) FIFO read for the 2nd decode/rename lane.
    // Combinational reads at fb_head+1 (wraps mod 8). Only meaningful when the
    // FIFO holds >=2 records (rename_fire2 checks fb_count below); harmless to
    // read a stale slot otherwise since every slot-1 consumer is rename_fire2-
    // gated.
    // S17: at count==0 the slot-1 head+1 read muxes to the live slot-1
    // delivery (rename_fire2 admits it via fb_bypass2). S17.2: at count==1
    // it muxes to the live SLOT-0 delivery (fall-through; admitted via
    // fb_fall) — the next record in fetch order after the lone queued head.
    // FETCH_REG: slot-1 reads ONLY fb_*[fb_head_p1] (registered) — the live
    // fall-through (fb_count==1) and bypass (fb_count==0) arms are const-folded
    // out, cutting the s1_instr->u_dec2 critical path. rename_fire2 already
    // gates on fb_count>=2 at FETCH_REG=1 (fb_bypass2/fb_fall are 0).
    let fb_head_p1: logic<3> = fb_head + 3'd1;
    let if_pc_q1          : logic<64> = if FETCH_REG ? fb_pc[fb_head_p1] : if fb_count >= 4'd2 ? fb_pc[fb_head_p1] : if fb_count == 4'd1 ? ic_pc : s1_pc;
    let if_instr_q1       : logic<32> = if FETCH_REG ? fb_instr[fb_head_p1] : if fb_count >= 4'd2 ? fb_instr[fb_head_p1] : if fb_count == 4'd1 ? fetched_instr : s1_instr;
    let if_is_rvc_q1      : logic     = if FETCH_REG ? fb_is_rvc[fb_head_p1] : if fb_count >= 4'd2 ? fb_is_rvc[fb_head_p1] : if fb_count == 4'd1 ? (!straddle_q && curr_is_rvc) : s1_is_rvc;
    let if_pred_next_pc_q1: logic<64> = if FETCH_REG ? fb_pred_next_pc[fb_head_p1] : if fb_count >= 4'd2 ? fb_pred_next_pc[fb_head_p1] : if fb_count == 4'd1 ? pred_next_pc_bp : pred_next_pc1;
    let if_pred_index_q1  : logic<13> = if FETCH_REG ? fb_pred_index[fb_head_p1] : if fb_count >= 4'd2 ? fb_pred_index[fb_head_p1] : if fb_count == 4'd1 ? bht_lk_index : bht_lk_index1;
    let if_ghr_fold_q1    : logic     = if FETCH_REG ? fb_ghr_fold[fb_head_p1] : if fb_count >= 4'd2 ? fb_ghr_fold[fb_head_p1] : if fb_count == 4'd1 ? (btb_hit && btb_is_cond) : (btb_hit2 && btb_is_cond2);
    let if_ifault_q1      : logic     = if FETCH_REG ? fb_ifault[fb_head_p1] : if fb_count >= 4'd2 ? fb_ifault[fb_head_p1] : if fb_count == 4'd1 ? ic_ifault : 1'b0;
    assign if_iacc_q1     = if FETCH_REG ? fb_iacc[fb_head_p1] : if fb_count >= 4'd2 ? fb_iacc[fb_head_p1] : if fb_count == 4'd1 ? ic_iacc : 1'b0;

    // ============================================================
    // M5.C: imem_mmu wrapper. Bare mode (M-mode or satp.MODE=0) is
    // pure passthrough; o_busy stays 0 and o_paddr == i_vaddr. PTW
    // port tied off for M5.C; M5.D adds Sv39 + dmem-shared PTW
    // arbitration.
    // ============================================================
    // imem_paddr_w forward-declared early (the S4a.3 slot-1 same-line check reads
    // imem_paddr_w[5:2] before this point); assigned by the imem_mmu inst below.
    // imem_valid_w forward-declared with the fetch latch above.
    var imem_busy_w: logic;
    // imem_fault_w forward-declared with the fetch latch above.
    var imem_ptw_addr_w: logic<64>;
    var imem_ptw_req_w : logic    ;
    // P10 Svadu: instruction-side A-bit write-back (imem_mmu WRITE_AD). The write
    // is routed through the d-cache store-drain port (see the dcache inst). These
    // are forward-referenced by the imem_mmu inst; imem_aw_ack is assigned after
    // the dcache (where dc_sdrain_ack is in scope).
    var imem_ptw_wen_w  : logic    ;
    var imem_ptw_wdata_w: logic<64>;
    var imem_aw_ack     : logic    ;
    // Fetch addr advances by 2 during straddle so the next word lands
    // on the next cycle; in normal cycles it tracks pc_q.
    // Shape-W (CP §14): under ICACHE_SYNC_READ the fetch address is the F0 stream's
    // dword-aligned pc_fetch_q (the read decouples from pc_q, which becomes the extract-
    // stage instruction PC in W2). DEAD at 0 → the old combinational pc_q fetch (byte-id).
    // Non-cacheable 2-beat (W3): beat 1 presents the dword-high word at pc_fetch_q+4 (the
    // passthrough icache returns one word per present); f0_nc_beat_q is 0 in every cacheable
    // fetch, so the +4 is exclusive to the boot-ROM / MMIO path.
    // f2.5b: the fetch address is f0_fetch_pc (= the FTQ head under FTQ_DECOUPLE, else pc_fetch_q).
    let fetch_vaddr: logic<64> = if ICACHE_SYNC_READ ? (f0_fetch_pc + (if f0_nc_beat_q ? 64'd4 : 64'd0)) : (if straddle_q ? pc_q + 64'd2 : pc_q);
    // M9 (2026-05-25): gate i_req with !redirect_fire. On the redirect cycle,
    // pc_q still holds the OLD value (NBA — update at clock edge), so
    // fetch_vaddr presents the old VA to MMU. Without this gate, MMU at IDLE
    // sees i_req=1 + TLB miss for the old VA and starts a PT walk with
    // old VPN[2] (often = 0 for firmware low-PA returning via mret). That
    // walk reads the wrong L2 PTE (= 0/invalid for VPN[2]=0 in kernel PT)
    // and FAULTs. Next cycle, the imem_fault_w is latched against the NEW
    // PC (post-redirect) as a spurious instr page fault. Cause: ~290K cy
    // wasted per char emission as the S-mode handler "fixes" the non-fault.
    // P9.6 phase 2: the I-PTW PTE reads are now COHERENT — routed through the
    // same mem_ctrl uncounted read as the I-cache fill (recall-on-owned brings a
    // modified PTE home), NOT the old non-coherent o_iptw bus. The FSM + arbiter
    // live after the dcache inst (where i_dmem_rdata/the grant are in scope);
    // iptw_data / iptw_done_q are forward-referenced here.
    var iptw_data  : logic<64>;
    var iptw_done_q: logic    ;
    var iptw_done_a: logic<61>; // dword of the captured PTE (matches o_ptw_addr while valid)
    // The captured PTE is valid ONLY while it matches the MMU's current request
    // dword — the moment the walk advances (o_ptw_addr changes) the still-set
    // iptw_done_q must NOT re-validate the stale PTE for the new level.
    let iptw_pte_valid: logic = iptw_done_q && imem_ptw_addr_w[63:3] == iptw_done_a;
    inst u_imem_mmu: imem_mmu #(
        PMA_FAULT: PMA_FAULT,
    ) (
        clk                        ,
        rst                        ,
        i_vaddr   : fetch_vaddr    ,
        i_req     : !any_redirect  ,
        o_paddr   : imem_paddr_w   ,
        o_valid   : imem_valid_w   ,
        o_fault   : imem_fault_w   ,
        o_acc_fault: imem_acc_fault_w,
        o_busy    : imem_busy_w    ,
        i_satp    : satp_shadow    ,
        i_priv    : csr_priv       ,
        i_sum     : imem_sum       ,
        i_mxr     : imem_mxr       ,
        i_pbmte   : csr_pbmte      ,
        i_adue    : csr_adue       ,
        i_pmpcfg  : csr_pmpcfg     ,
        i_pmpaddr : csr_pmpaddr    ,
        // Phase 11-H two-stage fetch translation. csr_virt is the fetch's V
        // (M-mode fetch is never virtualized). G-stage cause is H3 → discard.
        i_virt        : csr_virt   ,
        i_vsatp       : vsatp_shadow,
        i_hgatp       : csr_hgatp  ,
        o_gstage_fault: imem_gstage_w, // Phase 11-H3d: instruction guest-page-fault
        o_fault_gpa   : imem_gpa_w   ,
        o_ptw_addr: imem_ptw_addr_w,
        o_ptw_req : imem_ptw_req_w ,
        // P9.6 phase 2: PTE comes back from the coherent IS read FSM below.
        i_ptw_data    : iptw_data          ,
        i_ptw_valid   : iptw_pte_valid     ,
        // P10 Svadu: A-bit write-back routed through the d-cache store-drain port.
        o_ptw_wen       : imem_ptw_wen_w   ,
        o_ptw_wdata     : imem_ptw_wdata_w ,
        i_ptw_write_done: imem_aw_ack      ,
        i_icache_stall: icache_stall       , // M8.A: hold MMU/TLB during icache fill
        i_sfence      : commit_sfence_pulse,
        i_sfence_vaddr   : sfence_vaddr   , // P9.5: selective flush operands
        i_sfence_asid    : sfence_asid    ,
        i_sfence_rs1_zero: sfence_rs1_zero,
        i_sfence_rs2_zero: sfence_rs2_zero,
        i_redirect    : any_redirect       ,
    );
    let _unused_imem_fault: logic = imem_fault_w;
    let _unused_imem_valid: logic = imem_valid_w;
    let _unused_imem_busy : logic = imem_busy_w;

    // P9.6 phase 2: the dedicated o_iptw bus is retired — PTE reads go through
    // mem_ctrl/L2 (coherent). Tie it off; the tb's combinational iptw serving
    // is dead (the SoC fetches only DRAM PTEs through the shared read port).
    assign o_iptw_addr = 64'd0;
    assign o_iptw_req  = 1'b0;
    let _unused_iptw_rdata: logic<64> = i_iptw_rdata;

    // ============================================================
    // M8.A: L1 instruction cache, inserted between imem_mmu (imem_paddr_w)
    // and the external 32-bit instruction memory port (o_imem_addr /
    // i_imem_rdata). BLOCKING: o_stall (icache_stall) holds the fetch latch
    // and the imem_mmu on a miss until the 16-word line fill completes; the
    // pipeline then reads the combinational hit data (icache_rdata). Mem-side
    // goes DIRECT to the per-hart imem port (NOT through memory_bus); the tb's
    // combinational dram drives i_imem_rdata word-by-word during fill.
    //   - i_ren = imem_valid_w: only look up once the MMU has a valid paddr.
    //     On a page fault imem_valid_w=0 so no lookup/fill occurs (the fault
    //     delivers via if_ifault_q).
    //   - i_flush = commit_fence_i_pulse: FENCE.I invalidates all lines.
    //   - o_rdata_next is unused: v4 resolves halfword-straddled 32-bit instrs
    //     via the explicit 2-cycle re-fetch (fetch_vaddr+2), not a combo probe.
    // ============================================================
    // P9.6: the I-cache fill now rides this hart's mem_ctrl L2 read transaction
    // (coherent — recall-on-owned). It SHARES the D-cache read port through the
    // arbiter below (assigned after the dcache inst, where dc_mem_req is in
    // scope). ic_grant is forward-referenced; ic_mem_*/ic_fill_done are driven
    // by this inst and consumed by the arbiter.
    var ic_mem_addr : logic<64>;
    var ic_mem_req  : logic    ;
    var ic_grant    : logic    ;
    var ic_fill_done: logic    ;
    // The I side's read data: its own channel when split, else the shared D port.
    let is_rdata: logic<64> = if ID_SPLIT ? i_imemr_rdata : i_dmem_rdata;
    var ic_owns     : logic    ; // arbiter: instruction side owns the read port (txn in flight)
    var ic_route    : logic    ; // arbiter: route the shared read port to the instruction side
    // P9.6 phase 2: the instruction side has TWO consumers of the shared read
    // port — the I-cache fill and the I-PTW PTE read. is_ptw_q latches which one
    // owns the in-flight transaction; the I-PTW FSM state (busy/cnt) is below.
    var is_ptw_q    : logic    ; // in-flight IS txn is the I-PTW's (vs the I-fill's)
    var iptw_busy   : logic    ; // I-PTW PTE read accepted, streaming
    var iptw_cnt    : logic<3> ; // I-PTW stream beat counter
    var iptw_addr_q : logic<64>; // LATCHED PTE addr for the in-flight read (a
    //                              redirect can change imem_ptw_addr_w mid-read;
    //                              the captured dword must track the read's addr)
    // P9.6: the fetch PA is cacheable iff inside the DRAM window (PA[63:25]==0x40,
    // the same boundary as dc_uncached). A non-DRAM fetch (firmware/boot-ROM)
    // bypasses the cache and is served from the legacy o_imem passthrough.
    // (ic_dram is defined up near the shape-W F0 stream — the 2-beat non-cacheable
    // fetch reads it before this icache instantiation, so it must precede it.)
    // ── Block W2b: L1I 16 KB -> 32 KB (INDEX_W 6 -> 7; 128 sets x 4 ways x 64 B) ──
    // The W2b census partitioned the front-end wall exactly: of the 1,660,371 cycles
    // where the extract side wanted a dword and the fetch-ahead FIFO could not supply
    // it, 1,655,976 (99.7 %) were the FIFO GENUINELY EMPTY and only 4,395 were a
    // run-ahead address mismatch; of those empty cycles 1,224,545 (74 %) were an
    // ICACHE MISS, against I-PTW 902 and wf_full 0. So the run-ahead MACHINERY (FTQ
    // depth, predictor accuracy, FIFO depth) was never the problem — capacity was.
    // That also closes the f2.14 finding from the other side: deepening run-ahead is
    // unamortisable here because the miss, not the pointer, is what starves fetch.
    // Measured: icache-miss cycles 1,224,545 -> 426,402 (-65 %), FIFO-empty
    // 1,655,976 -> 843,393 (-49 %), boot -5.63 % on top of W1a+W2a.
    // COSTS DOUBLE THE L1I SRAM — adopted on the user's call (2026-08-15).
    inst u_icache: icache #(
        INDEX_W: 7,
    ) (
        clk                              ,
        rst                              ,
        i_addr      : imem_paddr_w       ,
        i_ren       : imem_valid_w       ,
        i_flush     : commit_fence_i_pulse,
        i_dram      : ic_dram            ,
        o_rdata     : icache_rdata       ,
        o_rdata_next: icache_rdata_next  ,
        o_rdata_next_valid: icache_rdata_next_valid,
        o_stall     : icache_stall       ,
        o_stall_comb: icache_stall_comb  ,
        o_mem_addr  : ic_mem_addr        ,
        i_mem_rdata : is_rdata            , // P9.6/Block N: 64-bit dword stream (own channel when split)
        o_mem_req   : ic_mem_req         ,
        i_mem_grant : ic_grant           ,
        o_fill_done : ic_fill_done       ,
        o_imem_addr : o_imem_addr        , // P9.6: non-DRAM passthrough
        i_imem_rdata: i_imem_rdata       ,
        o_imem_ren  : o_imem_ren         ,
    );
    let _unused_icache_rdata_next: logic<32> = icache_rdata_next;
    let _unused_icache_rdata_next_valid: logic = icache_rdata_next_valid;

    // ============================================================
    // Decode (Stage D)
    // ============================================================
    var dec_op_raw: DecodedOp;
    inst u_dec: decode ( i_pc: if_pc_q, i_instr: if_instr_q, i_is_rvc: if_is_rvc_q, o_op: dec_op_raw );
    // Phase 8 S4b: 2nd decode lane — the younger op (head+1) of a 2-wide rename
    // bundle. Dead until rename_fire2 flips on: dec_op2 feeds only rename_fire2-
    // gated slot-1 ports (RAT reads, free_list pop2, ROB alloc2, IQ alloc2).
    var dec_op2_raw: DecodedOp;
    inst u_dec2: decode ( i_pc: if_pc_q1, i_instr: if_instr_q1, i_is_rvc: if_is_rvc_q1, o_op: dec_op2_raw );

    // ── Phase D step C: DECODE_REG DEAD scaffold (D|R — the rename-stage input) ──
    // Register the DECODE output (dec_op / dec_op2) so rename + free-list + IQ/ROB
    // allocate read a flop instead of the ~5.3 ns combinational
    // if_instr_q→u_dec→dec_op→iq_alloc_rdy→rename_fire→prf_ready→rs1_rdy path (the
    // decode 2.05 + rename/allocate 3.21 halves fused in one cycle;
    // cp_frontend_pipeline_plan.md §7). This is the R-stage input register of the
    // FINAL diagram (F1 imem | F2 icache | D decode | R rename); FETCH_REG is the
    // F|D reg, so this D|R boundary was the last unbuilt front-end stage. Pattern =
    // EX_PIPE's alu_cdb_q / ICACHE_SYNC_READ (8344d0a): DEAD at 0 — dec_op ==
    // dec_op_raw (byte-identical, the live u_dec output) and each *_q is reset-only
    // (the `if DECODE_REG` write-fold) → DCE'd, synth-CP-neutral. At 1 the decoded
    // op is a cycle late; rename is STATEFUL (pops the free-list, writes the RAT,
    // allocates ROB/IQ), and the fetch metadata (if_pc_q/if_v_q/if_ifault_q/
    // if_iacc_q — NOT on the rs1_rdy critical path, they are rob_alloc payload)
    // stays live, so the FB-pop-timing / metadata-skew / intra-bundle
    // slot-0→slot-1 RAT-dependency corners are the functional bundle-flip work —
    // =1 is FF-insertion measurement only, not functional. Naming: *_raw = the live
    // decode output; the eff `let`s keep the ORIGINAL names dec_op/dec_op2 so every
    // rename/allocate consumer routes to the registered-or-raw value untouched.
    const DECODE_REG: bit = 0;
    var dec_op_q : DecodedOp;
    var dec_op2_q: DecodedOp;
    always_ff (clk, rst) {
        if_reset {
            dec_op_q  = '0;
            dec_op2_q = '0;
        } else if DECODE_REG {
            dec_op_q  = dec_op_raw;
            dec_op2_q = dec_op2_raw;
        }
    }
    let dec_op : DecodedOp = if DECODE_REG ? dec_op_q  : dec_op_raw;
    let dec_op2: DecodedOp = if DECODE_REG ? dec_op2_q : dec_op2_raw;

    // ============================================================
    // Rename (Stage R)
    // ============================================================
    var rs1_pdst   : logic<PRF_INT_W>;
    var rs2_pdst   : logic<PRF_INT_W>;
    var old_rd_pdst: logic<PRF_INT_W>;
    // Zacas amocas.q: slot-1 RAT rd old-pdst read (stolen to look up rd+1's pdst
    // when slot-0 is amocas.q). Declared early so the rename rob_alloc_entry /
    // ren_op (above the slot-1 datapath) can reference it.
    var rat_rd_old_pdst2: logic<PRF_INT_W>;
    var new_rd_pdst: logic<PRF_INT_W>;
    var free_empty : logic           ;
    var free_avail2: logic           ; // Phase 8 S4b: free-list has >=2 free pdsts
    var iq_alloc_rdy2: logic         ; // Phase 8 S4b: iq_int has a 2nd free slot

    // M6: FP rename / dual datapath (declared early; wired to rat_fp /
    // fp free_list / prf_fp / iq_fp / fpu_wrap instances below).
    var fp_rs1_pdst    : logic<PRF_FP_W>;
    var fp_rs2_pdst    : logic<PRF_FP_W>;
    var fp_rs3_pdst    : logic<PRF_FP_W>;
    var fp_old_rd_pdst : logic<PRF_FP_W>;
    var new_fp_rd_pdst : logic<PRF_FP_W>;
    var fp_free_empty  : logic          ;
    var csr_frm        : logic<3>       ;
    var csr_vxrm       : logic<2>       ; // V5b: fixed-point rounding mode to the VU
    // Dest pdst actually allocated (FP free-list for FP-dest ops, else int).
    let ren_dst_is_fp  : logic          = dec_op.fp_writes_fp;
    let ren_rd_pdst    : logic<PRF_FP_W> = if ren_dst_is_fp ? new_fp_rd_pdst : new_rd_pdst;
    let ren_old_rd_pdst: logic<PRF_FP_W> = if ren_dst_is_fp ? fp_old_rd_pdst : old_rd_pdst;
    // Merged CDB (ALU and FPU are mutually exclusive: at most one valid/cycle).
    var alu_cdb: CdbBus;
    // ============================================================
    // A-EXE (keystone execute staging — deep_pipeline_sram_plan "The keystone
    // (REVISED)"): register the lane-0 ALU CDB so the writeback/broadcast is driven
    // from a flop (an EX|WB stage boundary) instead of combinationally from the FR
    // output. Param-gated DEAD: at EX_PIPE=0 the unified mux + arbitration read the
    // LIVE alu_cdb (today's behavior, byte-identical) and alu_cdb_q feeds nothing
    // (synth DCEs it); at 1 they read the REGISTERED alu_cdb_q — the ALU result lands
    // one cycle later, so dependent ALU chains need the bypass network (E2) and a
    // registered result can lose the lane to a higher-priority FU completing the next
    // cycle, needing the §1.0b CDB writeback-arbitration buffer (E3). E1 adds only the
    // register + the effective-arm; alu_cdb_eff is what every arbitration/mux reader
    // consumes (the 5 direct alu_cdb reads below, and `cdb` via the mux). Cleared on
    // redirect_fire so a squashed op's staged result never broadcasts (dead at =0).
    const EX_PIPE: bit = 0;
    var alu_cdb_q: CdbBus;
    let alu_cdb_eff: CdbBus = if EX_PIPE ? alu_cdb_q : alu_cdb;
    // A-EXE E1 — the FP-load destination classification of the lane-0 ALU result must
    // travel WITH the result across the EX register. cdb_dest_is_fp's alu arm reads the
    // LIVE iq_iss_fp_ld (this cycle's issuing op); at EX_PIPE=1 alu_cdb_eff is the op
    // that issued LAST cycle, so the live flag belongs to a DIFFERENT op. When an FP
    // load issues the cycle a registered integer ALU result broadcasts, the stale
    // iq_iss_fp_ld=1 misroutes the integer result to the FP PRF and suppresses the int
    // IQ wakeup (prf_done) → the integer consumer wedges at the ROB head (observed:
    // rv64uf/ud FP-test hang under EX_PIPE=1). Register the flag alongside alu_cdb_q
    // (mirrors the LSU's lsr_fp_ld_q latched flag). alu_fp_ld_eff == iq_iss_fp_ld at
    // EX_PIPE=0 (byte-identical); at EX_PIPE=1 it is the flag of the op in alu_cdb_q —
    // always 0, since an FP load never rides u_alu (it is gated off for is_load).
    // (alu_fp_ld_eff itself is defined next to cdb_dest_is_fp below, where the live
    // iq_iss_fp_ld source is already in scope.)
    var alu_iss_fp_ld_q: logic;
    var fpu_cdb: CdbBus;
    // Phase 8 S10.1: deferred MSHR writeback (non-blocking load-miss fill
    // completion). Assigned in the MSHR block after the dcache instance;
    // muxed onto lane 0 below FPU priority.
    var mshr_cdb: CdbBus;
    // Multi-cycle integer divide/remainder (int_divider FU) completion bus —
    // muxed onto lane 0 below MSHR priority. Assigned in the int_divider block
    // after u_alu; held until it wins the lane (FPU/MSHR yield), mirroring MSHR.
    var int_div_cdb: CdbBus;
    // Phase 0 LSU extraction (doc/lsu_pipeline_plan.md): plain loads (is_load &&
    // !is_amo) write back on their own lane via u_lsu instead of riding alu_cdb.
    // Muxed onto lane 0 just below alu_cdb; mutually exclusive with alu_cdb (a
    // load op never drives alu_cdb and vice versa), so the relative order is a
    // no-op for the winner — it only needs a slot above vu_cdb (as the load had).
    var lsu_cdb: CdbBus;
    // Issue-cycle data effective address (rs1 + imm, pointer-masked). Declared
    // here (forward-ref) so u_lsu — which needs it for the load byte offset /
    // fault VA / LQ-record VA — can read it; assigned in an always_comb further
    // down (after agu_raw_iss / pm_mode are in scope).
    var agu_addr_iss: logic<64>;
    // Phase 8 S10.3: MSHR capture pulse (forward-ref var, assigned in the MSHR
    // block) — the issuing load misses, the fill starts, and the load is acked
    // OUT of the IQ with its writeback deferred to fill completion.
    var mshr_capture: logic;
    // step-2 (L4): capture-source-agnostic entry-write feeds. Forward-declared so
    // the rob instance's LQ-record port can read them; assigned by the MSHR block.
    var mshr_alloc_fire: logic            ;
    var mshr_alloc_rob : logic<ROB_IDX_W> ;
    var mshr_alloc_f3  : logic<3>         ;
    // The Stage-B handoff pulses. Assigned down with the LSR block (they need
    // lsr_squashed), read up here by the entry-write feeds.
    var mshr_cap_b     : logic            ;
    var mshr_cap_b_own : logic            ;
    // S10.3/S10.4b MSHR state + rob-port feeds (declared here so the rob
    // instance and the issue gates can consume them; assigned in the MSHR
    // block after the dcache instance). S10.4b: TWO entries (a/b) = one fill
    // OWNER + one QUEUED miss (miss-under-miss); own_q marks which entry the
    // in-flight dcache fill belongs to.
    var mshra_v_q      : logic           ;
    var mshra_done_q   : logic           ;
    var mshra_own_q    : logic           ;
    var mshra_rob_idx_q: logic<ROB_IDX_W>;
    var mshra_pdst_q   : logic<PRF_INT_W>;
    var mshra_has_rd_q : logic           ;
    var mshra_addr_q   : logic<64>       ;
    var mshra_funct3_q : logic<3>        ;
    var mshra_data_q   : logic<64>       ;
    var mshrb_v_q      : logic           ;
    var mshrb_done_q   : logic           ;
    var mshrb_own_q    : logic           ;
    var mshrb_rob_idx_q: logic<ROB_IDX_W>;
    var mshrb_pdst_q   : logic<PRF_INT_W>;
    var mshrb_has_rd_q : logic           ;
    var mshrb_addr_q   : logic<64>       ;
    var mshrb_funct3_q : logic<3>        ;
    var mshrb_data_q   : logic<64>       ;
    var mshr_rec_addr  : logic<64>       ; // = the capturing load's PA/VA (bare)
    var mshr_abort_poison: logic         ; // entry-A poison pulse → rob poison port
    var mshr_poison_idx: logic<ROB_IDX_W>; // entry A's rob idx
    var mshr_abort_poison2: logic         ; // entry-B poison pulse (S24.1 2nd port)
    var mshr_poison_idx2: logic<ROB_IDX_W>; // entry B's rob idx
    // S10.4b: replay injection active — a QUEUED entry's address is driven
    // onto the dcache CPU port (no fill in flight). While high, slot-0 dmem
    // readers yield the port (iss_dc_ok), so dc_hit_safe is the REPLAY
    // address's verdict, not an issuing load's.
    var replay_q: logic;
    var fill_busy_q: logic; // dcache fill FSM busy (start → DONE); read by the step-2 QUE gate
    // Phase 8 S10.4a: pipe-0 hit-under-miss. dc_hit_safe = the dcache's
    // fill-safe hit on i_addr; ld0_hum_ok (forward-ref, assigned in the MSHR
    // block) lets a plain bare-mode slot-0 load that HITS complete in-pipe
    // while a fill is in flight (dcache_stall high).
    var dc_hit_safe: logic;
    var ld0_hum_ok : logic;
    // Phase 1 (doc/lsu_pipeline_plan.md §10): Load Stage Register. A slot-0 plain
    // load is cut into 2 stages — Stage A (issue: AGU→translate→PMP) latches the
    // translated PA + metadata HERE and acks out of the IQ; Stage B (next cycle)
    // drives the dcache read at lsr_paddr_q, re-runs store→load forward, and
    // completes on lsu_cdb (a guaranteed-1-deep version of the MSHR/replay path).
    // VA and PA are kept apart: the dcache reads PA; byte_off (page-offset bits,
    // VA==PA), forward (vs store VAs) and the LQ-record VA use the VA.
    var lsr_v_q        : logic           ;
    var lsr_vaddr_q    : logic<64>       ; // = agu_addr_iss (VA): byte_off + LQ-rec + forward
    var lsr_paddr_q    : logic<64>       ; // = dmu_dmem_addr (PA): dcache read only
    var lsr_pdst_q     : logic<PRF_INT_W>;
    var lsr_rob_idx_q  : logic<ROB_IDX_W>;
    var lsr_funct3_q   : logic<3>        ;
    var lsr_has_rd_q   : logic           ;
    var lsr_fp_ld_q    : logic           ;
    var lsr_pc_q       : logic<64>       ; // redirect_pc = pc+4 CDB parity
    var lsr_rs2_q      : logic<64>       ; // store_data CDB parity
    var lsr_fault_pg_q : logic           ; // Stage-A page fault (dmem_mmu_fault)
    var lsr_fault_acc_q: logic           ; // Stage-A PMP access fault
    var lsr_unc_q      : logic           ; // Stage-A uncached/MMIO (dc_uncached) → Stage-B i_uncached
    var lsr_gstage_q   : logic           ; // Phase 11-H: Stage-A two-stage G-stage fault (cause 21/23 + htval)
    var lsr_gpa_q      : logic<64>       ; // Phase 11-H: Stage-A faulting guest PA (htval)
    // Phase 1 LSU 2-stage control (combinational; forward-declared so the EARLY
    // issue gates / dcache port muxes can read them — assigned after the dcache
    // instance / replay_drive where store_drive, dmem_mmu_idle, redirect_fire are
    // in scope). lsr_capture deliberately EXCLUDES iss_dc_ok (the dcache_stall
    // term): the Stage-A read is suppressed (no miss to wait on), so a dcache_stall
    // dependency here would close a comb loop (i_ren depends on lsr_capture).
    // ── Block L1.b (SQ_RETRY): the store-queue TRANSLATE RETRY ──────────────────
    // The execute-time probe fires on 81.4 % of store executes; 86 % of the misses are
    // the shared dmem port being busy at that one cycle, not a TLB miss
    // (cp_store_queue_plan.md §14.3). A missed store falls to sb_2cyc_ok and burns a
    // COMMIT cycle (rob_commit_ack's !store_fetched_q term) — ~345,000 of them on the
    // N=1 boot, ~2.8 % of it in retire bandwidth. So: re-probe the OLDEST ROB-resident
    // store that still has no PA, on a cycle nobody else drives the dmem port. The probe
    // is side-effect-free and needs only the ADDRESS mux (o_sprobe_* is a pure TLB read
    // off i_vaddr, gated on the MMU being IDLE) — no request, so a retry can never start
    // a walk. Assigned late (cdb / store_pretx_valid must be in scope); declared here so
    // core_dmem_vaddr can read them, the same forward-decl pattern as fast_store/sb_elig.
    var sqrt_sel_v : logic              ; // an entry needs a PA
    var sqrt_idx   : logic<ROB_IDX_W>   ; // ...its ROB index
    var sqrt_vaddr : logic<64>          ; // ...its VA
    var sqrt_age   : logic<ROB_IDX_W>   ; // ...its age, for the oldest-first select
    var sqrt_drive : logic              ; // the retry owns the dmem address this cycle
    var sqrt_cap   : logic              ; // ...and the probe hit: write the PA into the ROB
    var lsr_capture    : logic           ; // Stage-A latch enable + IQ ack (this cycle)
    var lsr_drive      : logic           ; // Stage-B owns the dcache read port
    var lsr_complete   : logic           ; // Stage-B writeback fires (→ u_lsu.i_valid)
    var lsr_dc_load_next: logic          ; // Stage-B misaligned cross-line fill
    // Block T: the LSR frees its slot THIS cycle, so a new load may latch into it
    // now instead of a cycle later (see LSR_B2B below). Assigned with lsr_complete.
    var lsr_b2b_free   : logic           ; // slot frees this cycle (back-to-back capture)
    var lsr_b2b_ok     : logic           ; // ...and the incumbent is a b2b-eligible load (REGISTERS ONLY)
    var lsr_b2b_spec   : logic           ; // ...and THIS cycle's dmem request is the speculative Stage-A load
    // Phase 1 step-1.5 (flexible writeback lane — recover the block-on-issue IPC):
    // a non-fault, non-FP plain load writes back on LANE 1 (the pipe-1 alu_cdb2
    // port, which carries result + is_load LQ-record), so its Stage-B writeback no
    // longer displaces a slot-0 ALU op on lane 0. pipe-1 yields lane 1 to the load
    // (it is the secondary issue). A faulting / FP load stays on lane 0 (only lane 0
    // carries the fault side-bands + the FP-regfile route). lsr_to_lane1 reads only
    // registers (no issue2_fire dep) → no comb loop with the pipe-1 issue path.
    var lsr_to_lane1   : logic           ; // load destined for lane 1 (non-fault, non-FP)
    var lsr_lane1_fire : logic           ; // load completes on lane 1 this cycle
    // ============================================================
    // CP MMU->dcache pipeline (cp_mmu_dcache_pipeline_plan.md, M1): a unified
    // dmem "M-stage" register that captures the MMU+PMP output (the translated PA
    // and the derived dcache control) so the dcache access can happen the NEXT
    // cycle, for ALL memory paths (VU mem / slow-store-commit / AMO), the way the
    // LSR already does it for plain loads. Param-gated DEAD: at MEM_PIPE=0 the
    // dcache reads the LIVE MMU output (today's behavior, byte-identical) and these
    // regs feed nothing (synth DCEs them); at 1 the dcache reads the registered
    // M-stage values. M1 only adds the register + the dcache read-mux arm; the VU
    // 2-cycle handshake (M2) and the store/AMO commit retire gate (M3) follow.
    // The M-stage captures the EFFECTIVE (post-gating) dcache execute-path inputs,
    // not the raw MMU outputs: i_ren/i_uncached/i_load_next fold in lsr_capture, so
    // at flip the dcache reads PURELY registered values and the head->MMU->PMP cone
    // is fully cut at this register (registering i_addr alone leaves dc_load_next /
    // lsr_capture live and the megacone uncut — measured: only -0.18 ns). The
    // LSR/replay Stage-B drives (already registered) and the commit-side store/AMO
    // terms stay live and OR over the M-stage; those are the back-half cone.
    const MEM_PIPE: bit = 1;
    // CP commit-store pre-translate (cp_commit_store_pretranslate_plan.md): at a store's
    // EXECUTE cycle the dmem MMU's TLB is side-effect-free probed (dmem_sprobe_*) for the
    // store's VA; a clean store-permitted cacheable DRAM hit latches its PA into the ROB
    // (store_pretx_*), and at commit the store drains that registered PA instead of
    // re-running the MMU — removing the head -> commit_store_fire -> AGU -> MMU ->
    // {n_inflight, dcache fill valid_*} sweep from the commit-store front. Anything that
    // is not a clean hit (miss / W/D/U/PMP/PMA deny / uncached / non-canonical / virt /
    // mid-walk / pending xlate-change) does NOT capture and falls back to commit
    // translation. NOTE: an EARLIER plan revision wrongly assumed the store's PA was
    // already produced at issue "for free"; it is not — a plain store asserts no MMU
    // request at execute (mem_req=0), so its dmu_dmem_addr is the untranslated VA. The
    // active TLB probe (dmem_sprobe_*) is what actually produces the PA. Built DEAD (=0):
    // the ROB fields are captured but the commit drain that reads them is wired in P3, so
    // =0 is byte-identical (the capture is written-but-unread).
    const STORE_PRETRANSLATE: bit = 1;
    var store_pretx_pa    : logic<64>;
    var store_pretx_xfault: logic    ;
    var store_pretx_valid : logic    ;
    // CP commit-store pre-translate: the dmem MMU's side-effect-free STORE TLB probe of
    // core_dmem_vaddr (= the store's VA at its execute cycle). pa = the hit PA; ok = a
    // clean store fast-path hit (see dmem_mmu o_sprobe_*).
    var dmem_sprobe_pa: logic<64>;
    var dmem_sprobe_ok: logic    ;
    var m_pa_q       : logic<64>; // = dmu_dmem_addr (translated PA)
    // CP commit-store pre-translate (P5a change B + trap-deferral): the committing
    // store's translate FAULT components, registered alongside m_pa_q. A non-pre-
    // translated VM store is held one cycle (store_fetched_q); cycle N+1 it SB-pushes the
    // registered m_pa_q ONLY when it did not fault (m_fault_q), else the REGISTERED fault
    // (page m_spage_q / access m_sacc_q / G-stage m_gstage_q) drives the commit trap —
    // taking the live MMU fault off the commit_excp / n_inflight cone. Dead at
    // STORE_PRETRANSLATE=0 (the _eff selectors collapse to the live faults → byte-id).
    var m_fault_q    : logic    ; // = m_spage_q || m_sacc_q (store translate fault, for sb_2cyc_ok gate)
    var m_spage_q    : logic    ; // = dmem_mmu_fault_s    (store page fault, cause 15)
    var m_sacc_q     : logic    ; // = dmem_mmu_acc_fault_s (store access fault, cause 7)
    var m_gstage_q   : logic    ; // = dmem_mmu_gstage      (two-stage G-stage flag, cause 23)
    // R3 L2 (retire decouple, cbo.m): a VM cbo.m is c_is_store (mem_wen=1) + !sb_elig,
    // so it already rides the M3a store_fetched_q 2-cycle commit — S0 registers its
    // page/access fault via m_spage_q/m_sacc_q. These flops register the REMAINING
    // cbo.m-specific commit-fault sources at the same translate cycle N (read at N+1
    // under store_fetched_q), so RETIRE_DECOUPLE=1 takes their live TLB+PMP cone off
    // rob_commit_ack too. Written unconditionally alongside m_spage_q; unread at
    // RETIRE_DECOUPLE=0 → DCE (byte-identical). See §7.4 / commit_store_s* below.
    var m_pte_acc_q  : logic    ; // = dmem_mmu_pte_acc_fault (cbo.m PTE-read PMP deny on the walk)
    var m_pma_hole_q : logic    ; // = dmem_mmu_pma_hole      (cbo.m translated PA is a PMA hole)
    var m_cbom_pmp_r_q: logic   ; // = cbo_m_pmp_deny_r       (cbo.m R-perm PMP deny)
    var m_cbom_pmp_w_q: logic   ; // = cbo_m_pmp_deny_w       (cbo.m W-perm PMP deny)
    var m_ren_q      : logic    ; // = dmu_dmem_ren && !lsr_capture (execute read term)
    var m_unc_q      : logic    ; // = dc_uncached && !lsr_capture
    var m_lnext_q    : logic    ; // = dc_load_next && !dc_uncached && !lsr_capture
    var m_wen_q      : logic    ; // = dc_i_wen (effective write-enable, pre-dcache)
    var m_wstrb_q    : logic<8> ; // = dmu_dmem_wstrb
    var m_wstrbhi_q  : logic<8> ; // = dc_st_wstrb_hi (misaligned-store hi invalidate)
    var m_wdata_q    : logic<64>; // = dmu_dmem_wdata
    var m_amo_read_q : logic    ; // = dc_amo_read
    var m_wen_excl_q : logic    ; // = dc_wen_excl
    var m_addr2_q    : logic<64>; // = dc_addr2 (slot-1 hit-only load port)
    var m_ren2_q     : logic    ; // = dc_ren2
    var m_lnext2_q   : logic    ; // = dc_load_next2
    // CP M2.5: the live PTW walk-dcache bundle from dmem_mmu (short path, no
    // TLB/PMP cone). At MEM_PIPE=1 a walk drives the dcache LIVE through these,
    // bypassing the M-stage, so the walk keeps MEM_PIPE=0 timing. Unused at 0.
    var ptw_dc_active: logic    ;
    var ptw_dc_ren   : logic    ;
    var ptw_dc_addr  : logic<64>;
    var ptw_dc_wdata : logic<64>;
    // CP M3a: slow-store commit 2-cycle handshake. At MEM_PIPE=1 a slow store
    // (c_is_store && !sb_elig, the i_wen write path) translates in cycle N (M-stage
    // latches the PA + wen) and the dcache WRITES it in cycle N+1; rob_commit_ack
    // must not retire it in the translate cycle. store_fetched_q marks "translated,
    // ready to write" (set when the slow store drives + !dmem_mmu_busy; cleared on
    // retire/redirect so the next store starts with its own translate cycle). Dead
    // at MEM_PIPE=0 (the gate is MEM_PIPE-conditioned; the reg is unread).
    var store_fetched_q: logic;
    // CP M3b: AMO/LR read 2-cycle handshake. A real AMO + LR (issue_amo_read, which
    // excludes SC) reads the dcache combinationally at execute (alu_wrap amo_old_algn
    // = i_load_data = dcache_rdata). At MEM_PIPE=1 the dcache reads the AMO's PA only
    // the NEXT cycle (the registered m_pa_q), so the execute-cycle dcache_rdata is the
    // PRIOR access's data. amo_fetched_q gives the AMO/LR a FETCH cycle (drive read ->
    // MMU translate -> M-stage latches PA + amo_read) before the ACCESS cycle (dcache
    // reads the latched PA -> dcache_rdata = the AMO value -> alu_wrap computes the
    // RMW). amo_fetch_hold suppresses iq_issue_ack + u_alu completion in the fetch
    // cycle; it clears whenever the AMO is not driving its read (port lost to a VU
    // op / committing store / blocked) so a re-fetch re-latches the right PA, and on
    // ack/redirect so back-to-back AMOs each re-fetch. The AMO commit WRITE is a slow
    // store (c_is_store && !sb_elig) already covered by M3a's store_fetched_q. SC
    // reads nothing (no dc_amo_read) and its store rides the M3a path, so it is not
    // held. Dead at MEM_PIPE=0 (amo_fetch_hold is MEM_PIPE-gated; the reg is unread).
    var amo_fetched_q  : logic;
    var amo_fetch_hold : logic;
    // CP M3b/M4: atomic-commit translation capture (recover the CP the live AMO/SC
    // commit write costs). The LIVE commit write (amo_commit_live) is atomic but routes
    // the commit-cycle dcache write through the live MMU TLB + AMO-write PMP (the
    // megacone: head -> u_dmem_mmu -> u_pmp_amo_w -> dc_i_wen -> dcache -> dcache_stall
    // -> rob_commit_ack -> n_inflight, ~11.5 ns of the path). But a real AMO / SC
    // ALREADY translated its address and passed the R+W PMP at its READ (dmem_mmu
    // acc_deny includes i_is_amo && pmp_deny_amo_w; a deny faults the op at execute, so
    // it never reaches the commit write). So the commit write needs NO live MMU/PMP —
    // capture the read-time PA + "write permitted" + "cacheable in-cache-merge" and
    // drive the dcache write off those registers (single-cycle, still live-hit_excl
    // atomic). Captured at the atomic's read/issue (ac_capture). Dead at MEM_PIPE=0
    // (only read inside the MEM_PIPE amo_commit_live mux arms).
    var ac_pa_q    : logic<64>; // atomic commit-write PA (= dmu_dmem_addr at read)
    var ac_wok_q   : logic    ; // atomic R+W PMP + translation OK (= !acc_fault && !fault)
    var ac_wexcl_q : logic    ; // atomic line is cacheable (in-cache merge, not MMIO/tohost)
    var ac_noread_q: logic    ; // R3.2c: this atomic performed NO execute-time read
    // R3.2c: sticky "the atomic at the head must take today's READ path". Set when a
    // no-read class atomic discovers at its translate cycle that its PA is
    // uncacheable (so the queue cannot perform its RMW); it is then replayed through
    // the existing AMO-poison redirect and the re-executed atomic reads normally.
    // Cleared when an atomic retires. Const-gated → constant 0 at ASQ_NOREAD=0.
    var amo_fread_q: logic    ;
    // Phase 8 S3: CDB lane 1 = pipe-1 (2nd integer ALU/branch). Independent of
    // the lane-0 FPU/ALU interlock; pipe-1 never executes FP.
    var alu_cdb2: CdbBus;
    // step-1.5: u_alu2 (pipe-1) drives this raw bus; alu_cdb2 is then muxed below to
    // carry EITHER pipe-1 OR a non-fault/non-FP plain load completing on lane 1.
    var alu2_pipe_cdb: CdbBus;
    // iq_fp issue outputs
    var iqf_issue_valid : logic          ;
    var iqf_iss_fpu_op  : fpu_pkg::FpuOp ;
    var iqf_iss_rm      : logic<3>       ;
    var iqf_iss_fli_idx : logic<5>       ;
    var iqf_iss_rd_pdst : logic<PRF_FP_W>;
    var iqf_iss_rob_idx : logic<ROB_IDX_W>;
    var iqf_iss_has_rd  : logic          ;
    var iqf_iss_wr_int  : logic          ;
    var iqf_iss_s1_pdst : logic<PRF_FP_W>;
    var iqf_iss_s2_pdst : logic<PRF_FP_W>;
    var iqf_iss_s3_pdst : logic<PRF_FP_W>;
    var iqf_iss_int_pdst: logic<PRF_FP_W>;
    var iqf_alloc_rdy   : logic          ;
    // prf_fp read data + prf_int 3rd-port (FPU int source) read data
    var prf_fp_rs1_data : logic<64>;
    var prf_fp_rs2_data : logic<64>;
    var prf_fp_rs3_data : logic<64>;
    var prf_int_rs3_data: logic<64>;
    // FPU side-band
    var fpu_fflags    : logic<5>;
    var fpu_fflags_wen: logic   ;
    var fpu_busy      : logic   ;
    // fp-pipeline: the scalar FPU is 2-stage (PIPE=1), so its writeback lands
    // one cycle after issue. dest-is-fp must come from the FPU's pipelined
    // metadata, not the live iq_fp issue (iqf_iss_wr_int) which has moved on.
    var fpu_dest_is_fp: logic   ;
    // iq_int → iq_fp int-source ready query result
    var iq_int_fp_query_rdy: logic;
    // M6.B.3: FP load/store
    var iq_iss_fp_ld     : logic    ; // issued op is an FP load (FLW/FLD)
    var iq_iss_fp_st     : logic    ; // issued op is an FP store (FSW/FSD)
    var prf_fp_store_data: logic<64>; // prf_fp rs2 read (FP store data)
    var iqf_fp_query_rdy : logic    ; // iq_fp → iq_int FP-store rs2 readiness
    // rs2 pdst routed to iq_int: FP rs2 for an FP store, else the int rs2.
    let ren_rs2_pdst: logic<PRF_FP_W> = if dec_op.fp_st ? fp_rs2_pdst : rs2_pdst;
    // alu_rs2_data (FP store data mux) is defined near u_alu where prf_rs2_data
    // is in scope.

    var rob_alloc_idx: logic<ROB_IDX_W>;
    var rob_head_idx : logic<ROB_IDX_W>; // declared early so iq instance can use it
    var rob_full     : logic           ;
    var iq_alloc_rdy : logic           ;

    // Phase 12 V0: Vector unit (vector_unit.veryl) datapath signals.
    var vu_alloc_rdy  : logic                    ;
    var vu_cdb_valid  : logic                    ;
    var vu_cdb_has_rd : logic                    ;
    var vu_cdb_pdst   : logic<PRF_INT_W>         ;
    var vu_cdb_data   : logic<64>                ;
    var vu_cdb_rob_idx: logic<ROB_IDX_W>         ;
    var vu_cdb_vset_wen: logic                   ;
    var vu_cdb_vtype  : logic<64>                ;
    var vu_cdb_vl     : logic<64>                ;
    var vu_scalar_pdst: logic<PRF_INT_W>         ;
    var vu_scalar_data: logic<64>                ;
    // Phase 12 V3b: VU FP scalar operand (.vf ops, f[rs1] read from prf_fp).
    var vu_fscalar_pdst: logic<PRF_FP_W>         ;
    var vu_fscalar_data: logic<64>               ;
    // Phase 12 V5h: VU 2nd int scalar operand (strided stride, x[rs2] from prf_int).
    var vu_scalar2_pdst: logic<PRF_INT_W>        ;
    var vu_scalar2_data: logic<64>               ;
    var vu_vs1_addr   : logic<vector_pkg::VRF_W> ;
    var vu_vs1_data   : logic<vector_pkg::VLEN>  ;
    var vu_vs2_addr   : logic<vector_pkg::VRF_W> ;
    var vu_vs2_data   : logic<vector_pkg::VLEN>  ;
    var vu_mask_addr  : logic<vector_pkg::VRF_W> ;
    var vu_mask_data  : logic<vector_pkg::VLEN>  ;
    var vu_vdold_addr : logic<vector_pkg::VRF_W> ;
    var vu_vdold_data : logic<vector_pkg::VLEN>  ;
    var vu_vd_addr    : logic<vector_pkg::VRF_W> ;
    var vu_vd_wen     : logic                    ;
    var vu_vd_data    : logic<vector_pkg::VLEN>  ;
    var vu_cdb        : CdbBus                   ;
    // Phase 12 V1: VU memory port (unit-stride vle/vse).
    var vu_mem_port_req : logic     ;
    var vu_mem_active   : logic     ;
    var vu_mem_vaddr    : logic<64> ;
    var vu_mem_is_load  : logic     ;
    var vu_mem_is_store : logic     ;
    var vu_mem_funct3   : logic<3>  ;
    var vu_mem_wdata    : logic<64> ;
    var vu_mem_wstrb    : logic<8>  ;
    var vu_cdb_is_lfault : logic     ;
    var vu_cdb_is_sfault : logic     ;
    var vu_cdb_fault_vaddr: logic<64>;
    var vu_cdb_vstart_wen: logic     ;
    var vu_cdb_vstart    : logic<64> ;
    var vu_cdb_vstore    : logic     ;
    // Phase 12 V3: VU FP fflags accrual (routed into fcsr at commit).
    var vu_cdb_fflags    : logic<5>  ;
    var vu_cdb_fflags_wen: logic     ;
    // Phase 12 V5a: VU fixed-point saturation accrual (OR'd into vxsat at commit).
    var vu_cdb_vxsat     : logic     ;
    var vu_cdb_vxsat_wen : logic     ;
    // Phase 12 V3f: VU writeback targets the scalar FP register file (vfmv.f.s).
    var vu_cdb_fp_dest   : logic     ;
    // VU memory-port arbitration (assigned after the dmem_mmu/dcache outputs).
    var vu_mem_idle    : logic   ;
    var vu_mem_ready   : logic   ;
    var vu_mem_fault   : logic   ;
    var vu_mem_fault_st: logic   ;
    var csr_vstart     : logic<64>;

    // M6: route IQ-readiness to iq_fp for FPU ops, iq_int otherwise; require
    // the int free-list for an int dest and the FP free-list for an FP dest.
    let resources_avail: logic = !rob_full
        && (if dec_op.is_vec ? vu_alloc_rdy : if dec_op.is_fpu_op ? iqf_alloc_rdy : iq_alloc_rdy)
        && (!dec_op.has_rd || !free_empty)
        && (!dec_op.fp_writes_fp || !fp_free_empty);
    assign stall_dr = if_v_q && !resources_avail;

    // Phase 8 S4a: interrupt-drain gate (!csr_irq_pending). An interrupt is taken
    // only at commit when the ROB is empty (commit_irq = rob_size==0 && ... &&
    // csr_irq_pending). With the 1-deep IF/ID latch the front end naturally left
    // the ROB empty often enough; the decoupled fetch buffer keeps rename fed
    // every cycle, so a hart in a WFI/idle busy-loop (WFI is a NOP in v4) keeps
    // the ROB non-empty and would NEVER reach rob_size==0 → the pending timer/IPI
    // interrupt is never taken → SMP boot livelocks past the normal finish and
    // eventually panics ("Fatal exception in interrupt"). Halting rename while an
    // interrupt is pending drains the in-flight ops so commit_irq can fire. This
    // is the standard precise-interrupt drain; it cannot deadlock (commit is not
    // gated, the ROB empties, and commit_irq keys on the SAME csr_irq_pending, so
    // the trap is taken and clears MIE/SIE → csr_irq_pending drops → rename
    // resumes). fb_pop carries the same gate so no FIFO record is dropped.
    let rename_fire: logic = if_v_q && !stall_dr && !any_redirect && !csr_irq_pending;

    // ROB alloc entry
    var rob_alloc_entry: RobEntry;
    always_comb {
        rob_alloc_entry.valid          = 1'b1;
        rob_alloc_entry.pc             = if_pc_q;
        rob_alloc_entry.instr          = dec_op.instr;
        rob_alloc_entry.rd_arch        = dec_op.rd_arch;
        // M6: dest pdst is the FP pdst for FP-dest ops, else the int pdst
        // (rd_pdst/old_rd_pdst are reused; is_fp_dest routes commit).
        rob_alloc_entry.rd_pdst        = ren_rd_pdst;
        rob_alloc_entry.old_rd_pdst    = ren_old_rd_pdst;
        rob_alloc_entry.has_rd         = dec_op.has_rd;
        rob_alloc_entry.is_fp_dest     = dec_op.fp_writes_fp;
        rob_alloc_entry.is_fp          = dec_op.is_fp;
        rob_alloc_entry.fflags         = 5'd0;
        rob_alloc_entry.fflags_wen     = 1'b0;
        rob_alloc_entry.result_written = 1'b0;
        rob_alloc_entry.is_branch      = dec_op.is_branch;
        rob_alloc_entry.is_jal         = dec_op.is_jal;
        rob_alloc_entry.is_jalr        = dec_op.is_jalr;
        rob_alloc_entry.mispredict     = 1'b0;
        rob_alloc_entry.redirect_pc    = 64'd0;
        // Phase 8 M1: carry the frontend's chosen next PC + control/length so
        // commit can decide mispredict (= pred_next_pc != arch_next_pc).
        rob_alloc_entry.pred_next_pc   = if_pred_next_pc_q;
        rob_alloc_entry.is_rvc         = if_is_rvc_q;
        rob_alloc_entry.is_control     = dec_op.is_branch || dec_op.is_jal || dec_op.is_jalr;
        // M3 RAS: call = jal/jalr writing a link reg (x1/x5); ret = jalr reading
        // a link reg with no link write (RISC-V return-address-stack hints).
        rob_alloc_entry.is_call        = (dec_op.is_jal || dec_op.is_jalr) && (dec_op.rd_arch == 5'd1 || dec_op.rd_arch == 5'd5);
        rob_alloc_entry.is_ret         = dec_op.is_jalr && (dec_op.rs1_arch == 5'd1 || dec_op.rs1_arch == 5'd5) && !(dec_op.rd_arch == 5'd1 || dec_op.rd_arch == 5'd5);
        // M4 gshare: carry the fetch-time BHT index (the speculative-history one
        // actually used for this op's prediction) so commit trains that entry.
        rob_alloc_entry.pred_index     = if_pred_index_q;
        rob_alloc_entry.ghr_fold       = if_ghr_fold_q;
        // PMP: an instruction ACCESS fault rides the instruction-fault delivery
        // path (is_ifault + illegal), and fault_acc overrides the cause to 1.
        rob_alloc_entry.illegal        = dec_op.illegal || if_ifault_q || if_iacc_q;
        rob_alloc_entry.is_ifault      = if_ifault_q || if_iacc_q;
        rob_alloc_entry.fault_acc      = if_iacc_q; // PMP: fetch access fault (cause 1)
        // Phase 11-H3d: carry the fetch G-stage-fault flag + guest PA for an
        // instruction guest-page-fault (cause 20 + htval). 0 unless V=1 fetch.
        rob_alloc_entry.ifault_gstage  = if_ifault_gstage_q;
        rob_alloc_entry.ifault_gpa     = if_ifault_gpa_q;
        rob_alloc_entry.result_data    = 64'd0;
        // M5.B: mark stores (and AMO*/SC which commit-store) at alloc so
        // pending-store check sees them BEFORE they CDB. Without this the
        // alloc→CDB window allows younger LOADs to issue past older STOREs.
        rob_alloc_entry.is_store     = dec_op.is_store || dec_op.is_amo;
        rob_alloc_entry.store_addr   = 64'd0;
        rob_alloc_entry.store_data   = 64'd0;
        rob_alloc_entry.store_funct3 = 3'd0;
        // M4 fields captured at alloc (decode)
        // M9.A.298: capture is_csr/csr_addr at alloc (was deferred to CDB) so
        // the ROB translation-barrier (o_has_pending_xlate) sees a pending CSR
        // write to sstatus/mstatus/satp from dispatch and blocks younger LOADs
        // from translating with stale SUM/MXR/satp. csr_wdata still filled at CDB.
        rob_alloc_entry.is_csr    = dec_op.is_csr;
        rob_alloc_entry.csr_addr  = dec_op.csr_addr;
        rob_alloc_entry.csr_wdata = 64'd0;
        rob_alloc_entry.is_ecall  = dec_op.is_ecall;
        rob_alloc_entry.is_ebreak = dec_op.is_ebreak;
        rob_alloc_entry.is_mret   = dec_op.is_mret;
        rob_alloc_entry.is_sret   = dec_op.is_sret;
        rob_alloc_entry.is_sfence = dec_op.is_sfence;
        rob_alloc_entry.is_svinval_fence = dec_op.is_svinval_fence;
        rob_alloc_entry.sfence_rs1 = dec_op.rs1_arch; // P9.5: SFENCE.VMA VA/ASID regs
        rob_alloc_entry.sfence_rs2 = dec_op.rs2_arch;
        rob_alloc_entry.is_fence_i = dec_op.is_fence_i;
        rob_alloc_entry.is_fence  = dec_op.is_fence;
        rob_alloc_entry.is_cbo_zero = dec_op.is_cbo_zero;
        rob_alloc_entry.is_cbo_m  = dec_op.is_cbo_m;
        rob_alloc_entry.is_amo    = dec_op.is_amo;
        // Zacas amocas.q: tag + the rd+1 old pdst (read via the slot-1 RAT port,
        // overridden to rd+1 below; slot-1 co-rename is suppressed for amocas.q).
        // cas_q_mem_lo/hi are filled at CDB writeback.
        rob_alloc_entry.is_cas_q     = dec_op.is_cas_q;
        rob_alloc_entry.rdh_pdst     = rat_rd_old_pdst2;
        rob_alloc_entry.cas_q_mem_lo = 64'd0;
        rob_alloc_entry.cas_q_mem_hi = 64'd0;
        // Phase 11-H HLV/HSV: carry the two-stage marker so a committing HSV store
        // drives the dmem MMU in two-stage mode + any HLV/HSV fault sets GVA.
        rob_alloc_entry.is_mem_virt = dec_op.hlv;
        // Phase 12 V0: vector op marker (commit-time VS-disabled trap + slot-1 gate).
        rob_alloc_entry.is_vec = dec_op.is_vec;
    }

    // RenamedOp
    var ren_op: RenamedOp;
    always_comb {
        ren_op.base        = dec_op;
        ren_op.rd_pdst     = ren_rd_pdst;
        ren_op.rs1_pdst    = rs1_pdst;
        ren_op.rs2_pdst    = ren_rs2_pdst;
        ren_op.old_rd_pdst = ren_old_rd_pdst;
        ren_op.rdh_pdst    = rat_rd_old_pdst2; // Zacas amocas.q (only used via ROB at commit)
        ren_op.rob_idx     = rob_alloc_idx;
    }

    // ============================================================
    // Phase 8 S2: slot-1 rename datapath (2-wide alloc/rename, built dead).
    // ============================================================
    // The slot-1 (younger) op of the rename bundle. The front end is still
    // 1-wide in S2/S3, so there is no second decode yet — slot-1 is sourced from
    // slot-0 as a placeholder and gated entirely off (rename_fire2 = 0). S4
    // repoints the dec_op2_* lets to the real second decode lane and flips
    // rename_fire2 on. With rename_fire2 = 0, every slot-1 module enable is 0, so
    // the pipeline behaves exactly as 1-wide (cycle-exact). This milestone only
    // builds and wires the ports + the intra-bundle rename bypass.
    // Phase 8 S4b: slot-1 eligibility. The slot-1 rename/alloc datapath is
    // integer-only — there is no FP slot-1 port (rat_fp / fp free_list / iq_fp
    // are 1-wide), and pipe-1 has no LOAD/STORE/AMO/CSR side-bands. Restrict
    // slot-1 to a simple register-writing integer ALU op (matches the ROB's
    // c2_simple 2-wide-commit eligibility), so a 2-wide-renamed bundle can also
    // 2-wide-commit. Control transfers are excluded for now (conservative first
    // flip); a later milestone can admit them. has_rd && !fp covers the dest.
    // ── Block W1: admit CONTROL TRANSFERS to rename slot-1 (DEAD scaffold) ──
    // The W0 census (doc §Block W) prices this at 1,205,693 boot cycles of 1-wide
    // rename whose sole blocker is an ineligible slot-1 op that is a branch/JAL/JALR.
    // Everything downstream is ALREADY BUILT — and, because iq_int's `pipe1_ok`
    // excludes only load/store/amo/csr/fp/div, control ops renamed on SLOT-0 already
    // ISSUE on pipe-1 today, so the whole lane-1 control path is not merely wired but
    // EXERCISED in the shipped design:
    //   • execute      u_alu2 is a full alu_wrap fed by iq_issue_op2 (S3: "ALU/branch/
    //                  JAL/JALR/LUI/AUIPC"), and ren_op2.base = dec_op2 carries every
    //                  field it needs.
    //   • mispredict   early_mispredict1 = alu_cdb2 vs rob_pred_next_pc[rob_idx],
    //                  exactly symmetric with lane 0, with an age-based pick between
    //                  the two lanes (early_redir_pick1).
    //   • ROB entry    rob_alloc_entry2 already fills is_branch / is_jal / is_jalr /
    //                  is_control / is_call / is_ret / pred_next_pc / pred_index /
    //                  ghr_fold — nothing is hardwired to 0, so predictor TRAINING is
    //                  correct for a slot-1 branch.
    //   • rd-less ops  i_rename_en2 and fl_pop_en2 are both `&& dec_op2_has_rd`, so a
    //                  branch (no rd) writes no RAT mapping and pops no pdst.
    //   • wrong path   sb_slot1_kill kills slot-1 at the FRONT END when slot-0 is
    //                  predicted taken, so the FIFO never holds a wrong-path slot-1.
    // No new signal enters the cone: the predicate already reads is_branch/is_jal/
    // is_jalr in order to EXCLUDE them.
    // Commit stays 1-wide for control (`c2_simple` keeps `!sh_is_control`, because a
    // slot-1 commit assumes the next PC is pc + (rvc?2:4), which a taken branch
    // breaks). That is a throughput limit, not a correctness one — a control op at
    // head+1 simply does not co-commit. Whether commit becomes the new limiter is for
    // the flip to say (W1b).
    // DEAD at 0: `(has_rd || 0)` folds to has_rd and `(0 || !br && !jal && !jalr)`
    // folds to the original three terms → bit-identical.
    const W1_CTRL_SLOT1: bit = 1;
    let dec_op2_ctrl: logic = dec_op2.is_branch || dec_op2.is_jal || dec_op2.is_jalr;
    let dec_op2_eligible: logic = (dec_op2.has_rd || (W1_CTRL_SLOT1 && dec_op2_ctrl)) && !dec_op2.fp_writes_fp
        && !dec_op2.is_fpu_op && !dec_op2.fp_ld && !dec_op2.fp_st
        && !dec_op2.is_load && !dec_op2.is_store && !dec_op2.is_amo
        && !dec_op2.is_csr && (W1_CTRL_SLOT1 || !dec_op2_ctrl)
        && !dec_op2.is_ecall && !dec_op2.is_ebreak && !dec_op2.is_mret && !dec_op2.is_sret
        && !dec_op2.is_sfence && !dec_op2.is_fence_i && !dec_op2.illegal
        // Phase 12 V0: a vector op (incl. vset*vl/vmv.x.s, which DO write an int rd)
        // must never take the integer-only slot-1 path — it has to reach the VU via
        // slot-0. Without this a has_rd vector op renames as a plain int ALU op and
        // bypasses the VU (vtype/vl never update → every vector op sees vl=0).
        && !dec_op2.is_vec;
    // S4b.2: 2-wide rename LIVE. slot-1 renames alongside slot-0 when: slot-0
    // fires (rename_fire), the slot-1 op is a simple int ALU op (dec_op2_eligible),
    // the FIFO holds the 2nd record (fb_count >= 2), and there is room for a 2nd
    // op in the int IQ (iq_alloc_rdy2), free-list (free_avail2), and ROB
    // (rob_size <= 30 = room for 2). rename_fire is itself gated on !redirect /
    // !csr_irq / !stall_dr, which rename_fire2 inherits.
    // S17: a 2-wide bundle is also available when BOTH slots are live
    // bypasses of an empty FIFO (fb_bypass2).
    // Zacas amocas.q (slot-0) steals the slot-1 RAT read port to look up rd+1's
    // pdst, so it must not co-rename a real slot-1 op (it would also be squashed
    // by amocas.q's commit flush anyway).
    assign rename_fire2 = rename_fire && dec_op2_eligible && (fb_count >= 4'd2 || fb_bypass2 || fb_fall)
        && iq_alloc_rdy2 && free_avail2 && rob_size <= 8'd30 && !dec_op.is_cas_q;
    // Slot-1 decoded arch fields (real 2nd decode lane). Slot-1 is integer-only,
    // so no FP-dest fields here.
    let dec_op2_rs1_arch : logic<5> = dec_op2.rs1_arch;
    let dec_op2_rs2_arch : logic<5> = dec_op2.rs2_arch;
    let dec_op2_rd_arch  : logic<5> = dec_op2.rd_arch;
    let dec_op2_has_rd   : logic    = dec_op2.has_rd;

    // slot-1 free-list pop (int dest only).
    var new_rd_pdst2: logic<PRF_INT_W>;
    let fl_pop_en2  : logic = rename_fire2 && dec_op2_has_rd;

    // slot-1 RAT raw reads (intra-bundle bypass applied below). rat_rd_old_pdst2
    // is declared earlier (Zacas amocas.q reads it during slot-0 rename).
    var rat_rs1_pdst2   : logic<PRF_INT_W>;
    var rat_rs2_pdst2   : logic<PRF_INT_W>;
    // o_alloc_idx2 from the ROB; consumed by ren_op2.rob_idx below.
    var rob_alloc_idx2: logic<ROB_IDX_W>;

    // Intra-bundle RAW/WAW bypass: slot-0 renames its int dest to new_rd_pdst
    // this same cycle. slot-1 (younger) must see that mapping for any source or
    // old-dest that names slot-0's rd, because the RAT write lands at the clock
    // edge (slot-1's combinational RAT read would otherwise see the stale value).
    // new_rd_pdst is the free-list registered read, combinationally available →
    // no comb loop. FP-dest slot-0 renames do not touch the int RAT, so the
    // bypass is int-dest-only.
    let s0_int_rename : logic = rename_fire && dec_op.has_rd && !ren_dst_is_fp && dec_op.rd_arch != 5'd0;
    let s1_rs1_pdst   : logic<PRF_INT_W> = if s0_int_rename && dec_op2_rs1_arch == dec_op.rd_arch ? new_rd_pdst : rat_rs1_pdst2;
    let s1_rs2_pdst   : logic<PRF_INT_W> = if s0_int_rename && dec_op2_rs2_arch == dec_op.rd_arch ? new_rd_pdst : rat_rs2_pdst2;
    let s1_old_rd_pdst: logic<PRF_INT_W> = if s0_int_rename && dec_op2_rd_arch == dec_op.rd_arch ? new_rd_pdst : rat_rd_old_pdst2;

    // slot-1 RenamedOp (consumes the bypass + slot-1 pdsts; fed to iq_int's
    // slot-1 alloc port, which is enable-gated off in S2).
    var ren_op2: RenamedOp;
    always_comb {
        ren_op2.base        = dec_op2; // S4b: real 2nd decode lane
        ren_op2.rd_pdst     = new_rd_pdst2;
        ren_op2.rs1_pdst    = s1_rs1_pdst;
        ren_op2.rs2_pdst    = s1_rs2_pdst;
        ren_op2.old_rd_pdst = s1_old_rd_pdst;
        ren_op2.rdh_pdst    = 6'd0; // Zacas amocas.q is slot-0 only
        ren_op2.rob_idx     = rob_alloc_idx2;
    }

    // Phase 8 S4b: slot-1 ROB entry (real 2nd-decode lane). Mirrors the slot-0
    // rob_alloc_entry but sourced from dec_op2 + the slot-1 head+1 fetch fields
    // and the slot-1 int pdsts. Slot-1 is integer-only, so is_fp_dest=0; for an
    // eligible op (dec_op2_eligible) the control/mem/csr/fp flags are all 0, but
    // every field is built faithfully so the entry stays correct if eligibility
    // is relaxed later. Consumed by the ROB i_alloc_entry2 port (gated by
    // rename_fire2; dead until S4b.2).
    var rob_alloc_entry2: RobEntry;
    always_comb {
        rob_alloc_entry2.valid          = 1'b1;
        rob_alloc_entry2.pc             = if_pc_q1;
        rob_alloc_entry2.instr          = dec_op2.instr;
        rob_alloc_entry2.rd_arch        = dec_op2.rd_arch;
        rob_alloc_entry2.rd_pdst        = new_rd_pdst2;
        rob_alloc_entry2.old_rd_pdst    = s1_old_rd_pdst;
        rob_alloc_entry2.has_rd         = dec_op2.has_rd;
        rob_alloc_entry2.is_fp_dest     = dec_op2.fp_writes_fp;
        rob_alloc_entry2.is_fp          = dec_op2.is_fp;
        rob_alloc_entry2.is_vec         = dec_op2.is_vec;
        rob_alloc_entry2.fflags         = 5'd0;
        rob_alloc_entry2.fflags_wen     = 1'b0;
        rob_alloc_entry2.result_written = 1'b0;
        rob_alloc_entry2.is_branch      = dec_op2.is_branch;
        rob_alloc_entry2.is_jal         = dec_op2.is_jal;
        rob_alloc_entry2.is_jalr        = dec_op2.is_jalr;
        rob_alloc_entry2.mispredict     = 1'b0;
        rob_alloc_entry2.redirect_pc    = 64'd0;
        rob_alloc_entry2.pred_next_pc   = if_pred_next_pc_q1;
        rob_alloc_entry2.is_rvc         = if_is_rvc_q1;
        rob_alloc_entry2.is_control     = dec_op2.is_branch || dec_op2.is_jal || dec_op2.is_jalr;
        rob_alloc_entry2.is_call        = (dec_op2.is_jal || dec_op2.is_jalr) && (dec_op2.rd_arch == 5'd1 || dec_op2.rd_arch == 5'd5);
        rob_alloc_entry2.is_ret         = dec_op2.is_jalr && (dec_op2.rs1_arch == 5'd1 || dec_op2.rs1_arch == 5'd5) && !(dec_op2.rd_arch == 5'd1 || dec_op2.rd_arch == 5'd5);
        rob_alloc_entry2.pred_index     = if_pred_index_q1;
        rob_alloc_entry2.ghr_fold       = if_ghr_fold_q1;
        rob_alloc_entry2.illegal        = dec_op2.illegal || if_ifault_q1 || if_iacc_q1;
        rob_alloc_entry2.is_ifault      = if_ifault_q1 || if_iacc_q1;
        rob_alloc_entry2.fault_acc      = if_iacc_q1; // PMP: fetch access fault
        // Phase 11-H3d: slot-1 shares slot-0's fetch line/page, so it never takes
        // a separate fetch fault — its instruction guest-page-fault info is 0.
        rob_alloc_entry2.ifault_gstage  = 1'b0;
        rob_alloc_entry2.ifault_gpa     = 64'd0;
        rob_alloc_entry2.result_data    = 64'd0;
        rob_alloc_entry2.is_store       = dec_op2.is_store || dec_op2.is_amo;
        rob_alloc_entry2.store_addr     = 64'd0;
        rob_alloc_entry2.store_data     = 64'd0;
        rob_alloc_entry2.store_funct3   = 3'd0;
        rob_alloc_entry2.is_csr         = dec_op2.is_csr;
        rob_alloc_entry2.csr_addr       = dec_op2.csr_addr;
        rob_alloc_entry2.csr_wdata      = 64'd0;
        rob_alloc_entry2.is_ecall       = dec_op2.is_ecall;
        rob_alloc_entry2.is_ebreak      = dec_op2.is_ebreak;
        rob_alloc_entry2.is_mret        = dec_op2.is_mret;
        rob_alloc_entry2.is_sret        = dec_op2.is_sret;
        rob_alloc_entry2.is_sfence      = dec_op2.is_sfence;
        rob_alloc_entry2.is_svinval_fence = dec_op2.is_svinval_fence;
        rob_alloc_entry2.sfence_rs1     = dec_op2.rs1_arch; // P9.5
        rob_alloc_entry2.sfence_rs2     = dec_op2.rs2_arch;
        rob_alloc_entry2.is_fence_i     = dec_op2.is_fence_i;
        rob_alloc_entry2.is_fence       = dec_op2.is_fence;
        rob_alloc_entry2.is_cbo_zero    = dec_op2.is_cbo_zero;
        rob_alloc_entry2.is_cbo_m       = dec_op2.is_cbo_m;
        rob_alloc_entry2.is_amo         = dec_op2.is_amo;
        // Zacas amocas.q is slot-0 only; assigned for struct completeness.
        rob_alloc_entry2.is_cas_q       = dec_op2.is_cas_q;
        rob_alloc_entry2.rdh_pdst       = 6'd0;
        rob_alloc_entry2.cas_q_mem_lo   = 64'd0;
        rob_alloc_entry2.cas_q_mem_hi   = 64'd0;
        // Phase 11-H: slot-1 is ALU-only (no LOAD/STORE), so this is always 0;
        // assigned for struct completeness.
        rob_alloc_entry2.is_mem_virt    = dec_op2.hlv;
    }

    // ============================================================
    // Issue / Execute (Stage IE)
    // ============================================================
    var iq_issue_valid: logic    ;
    var iq_issue_op   : RenamedOp;
    // Per-field issue outputs (sim-bug workaround for cross-module
    // struct-port; mirror of iq_issue_op).
    var iq_iss_rs1_pdst      : logic         <PRF_INT_W>;
    var iq_iss_rs2_pdst      : logic         <PRF_INT_W>;
    var iq_iss_rd_pdst       : logic         <PRF_INT_W>;
    var iq_iss_rd_old_pdst   : logic         <PRF_INT_W>; // Zacas: amocas compare value pdst
    var iq_iss_rob_idx       : logic         <ROB_IDX_W>;
    var iq_iss_is_load       : logic                    ;
    var iq_iss_is_amo        : logic                    ;
    var iq_iss_amo_funct5    : logic         <5>        ;
    var iq_iss_is_cas_q      : logic                    ; // Zacas amocas.q
    var iq_iss_is_csr        : logic                    ;
    var iq_iss_csr_addr      : logic         <12>       ;
    var iq_iss_csr_op        : csr_pkg::CsrOp           ;
    var iq_iss_csr_imm       : logic                    ;
    var iq_iss_rs1_arch      : logic         <5>        ;
    // Phase 8 S3.b: 2nd issue port (pipe-1). slot-1 op + per-field pdsts/rob_idx.
    // pipe-1 is integer ALU/branch only, so no is_load/amo/csr/fp per-field
    // outputs are needed (u_alu2 ties those off).
    var iq_issue_valid2      : logic                    ;
    var iq_issue_op2         : RenamedOp                 ;
    var iq_iss_rs1_pdst2     : logic         <PRF_INT_W>;
    var iq_iss_rs2_pdst2     : logic         <PRF_INT_W>;
    var iq_iss_rd_pdst2      : logic         <PRF_INT_W>;
    var iq_iss_rob_idx2      : logic         <ROB_IDX_W>;
    // Phase 8 S5.2: slot-1 op is a LOAD (per-field) + the slot-1 fire signal
    // (= valid2 for ALU; = a completed bare-mode LOAD hit for a slot-1 load).
    // issue2_fire is forward-ref (drives u_alu2.i_issue_valid + iq.i_issue_ack2)
    // and assigned after the dcache 2nd-port hit is known.
    var iq_iss_is_load2      : logic                    ;
    var issue2_fire          : logic                    ;
    var rob_has_pending_store: logic                    ;
    var rob_has_pending_xlate: logic                    ; // M9.A.298 translation-barrier
    // Phase 8 S5.1 store-to-load: age-relative gate (from u_rob) + the ROB's
    // per-entry store shadow (FF-derived). The byte-granular forward is computed
    // HERE in the core (below, after agu_addr_iss) — the ROB store arrays and
    // agu_addr_iss are forward-refs/local so the (large) byte-network reads only
    // settled values, avoiding the Veryl-sim comb-settle hang that a
    // backward-referenced cross-module array read in a big comb block triggers.
    // The merged result is delivered to alu_wrap as fwd_data[64]/fwd_mask[8].
    var rob_block_store_exists: logic                    ;
    var rob_block_store_age   : logic<ROB_IDX_W>         ;
    var rob_store_addr        : logic<64>     [ROB_DEPTH];
    var rob_store_data        : logic<64>     [ROB_DEPTH];
    var rob_store_funct3      : logic<3>      [ROB_DEPTH];
    var rob_store_fwdable     : logic         [ROB_DEPTH];
    // Phase 8 S8: per-entry prediction shadow for early-mispredict detection.
    var rob_pred_next_pc      : logic<64>     [ROB_DEPTH];
    var rob_is_control        : logic         [ROB_DEPTH];
    var stld_fwd_data         : logic<64>                ;
    var stld_fwd_mask         : logic<8>                 ;
    // M2a: the ROB half of that mask on its own (stld_fwd_mask ORs in the committed
    // store buffer). The load queue's port-1 exemption is interlocked against this.
    var sf_rob_mask           : logic<8>                 ;
    // Phase 8 S5.2: 2nd store-to-load forward network (slot-1 / pipe-1 LOAD at
    // agu_addr_iss2). Mirror of the slot-0 network below; feeds u_alu2.i_fwd_*.
    var stld_fwd_data2        : logic<64>                ;
    var stld_fwd_mask2        : logic<8>                 ;
    // Local copies of the ROB store shadow: the forward byte-network reads these
    // (same-module) instead of the cross-module rob_store_* arrays 8×32 times —
    // many cross-module array reads in a big comb block hang the Veryl sim.
    var ls_addr               : logic<64>     [ROB_DEPTH];
    var ls_data               : logic<64>     [ROB_DEPTH];
    var ls_f3                 : logic<3>      [ROB_DEPTH];
    var ls_fwd                : logic         [ROB_DEPTH];
    // M2 (Block M lever d): the same shadow's PHYSICAL addresses (L2's
    // STORE_PRETRANSLATE), local for the same Veryl-sim reason as the four above.
    var ls_pa                 : logic<64>     [ROB_DEPTH];
    var ls_pa_v               : logic         [ROB_DEPTH];

    var prf_rs1_data: logic<64>;
    var prf_rs2_data: logic<64>;
    // Phase 8 S3: pipe-1 PRF read data (5R total: rs1_0/rs2_0/fp-int/rs1_1/rs2_1).
    var prf_rs1_data2: logic<64>;
    var prf_rs2_data2: logic<64>;
    // Zacas: amocas compare/expected value = prf[old_rd_pdst of the issued op].
    var prf_rd_cmp_data: logic<64>;
    // Zacas amocas.q commit-time pair writeback drivers (rd lo / rd+1 hi). Declared
    // here for the prf instance port order; assigned at the commit stage below.
    var cas_q_wb_lo_en  : logic           ;
    var cas_q_wb_lo_pdst: logic<PRF_INT_W>;
    var cas_q_wb_lo_data: logic<64>       ;
    var cas_q_wb_hi_en  : logic           ;
    var cas_q_wb_hi_pdst: logic<PRF_INT_W>;
    var cas_q_wb_hi_data: logic<64>       ;

    var cdb: CdbBus;

    var csr_rd_data    : logic<64>;
    var csr_mtvec      : logic<64>;
    var csr_mepc       : logic<64>;
    var csr_stvec      : logic<64>;
    var dbg_csr_stval  : logic<64>;
    var dbg_csr_mtval  : logic<64>;
    var csr_sepc       : logic<64>;
    var csr_mideleg_w  : logic<64>;
    // csr_irq_pending forward-declared early (interrupt-drain gate in fb_pop /
    // rename_fire references it before this point).
    var csr_irq_cause  : logic<64>;
    var csr_irq_to_s   : logic    ;
    // csr_satp / csr_priv / csr_sum / csr_mxr / csr_medeleg_w declared
    // earlier (M5.C/M5.D forward declarations for inst use sites).

    var rsv_valid_q: logic    ;
    var rsv_addr_q : logic<64>;
    // P9.3: the reservation's PHYSICAL address, latched from the LR read's
    // translated dmem address. The dcache presence check and the precise-inv
    // compares are PA-based (the L1 is PIPT) — under Sv39 the old VA-based
    // compares could never match, leaving VM reservations effectively
    // unclearable by remote writes. rsv_addr_q (VA) stays for the SC's own
    // program-order address match (sc_match / issue_addr_match).
    var rsv_pa_q: logic<64>;
    // M9.4 SMP: the rob_idx of the LR that set the reservation. Used by the age gate
    // in sc_may_clear so an OoO-reordered OLDER sc.w (issuing after a YOUNGER lr.w,
    // e.g. when its result op was delayed by a force-miss fill under N=4 bus
    // contention) cannot wipe the younger lr.w's reservation — the read_lock livelock.
    var rsv_rob_q  : logic<ROB_IDX_W>;
    // Phase 8 M2: high once the reservation's owner LR has committed (the
    // reservation is then architectural; rsv_rob_q is stale). Gates sc_may_clear's
    // owner-committed escape — see the comment there.
    var rsv_committed_q: logic;
    // P9.2: the reserved line has been seen present in the L1 since the
    // owning LR (arms the presence-based clear — see the reservation FF).
    var rsv_present_seen_q: logic;

    // M9.4 SMP: SC commit-time re-validation state (declared early so the
    // commit-redirect always_ff can read it; logic + comment near the
    // reservation always_ff below). P9.3: sc_watch_addr_q holds the PA
    // (= rsv_pa_q at arm) — presence/inv tracking is PA-based.
    var sc_watch_valid_q: logic           ;
    var sc_watch_addr_q : logic<64>       ;
    var sc_watch_rob_q  : logic<ROB_IDX_W>;
    var sc_poison_q     : logic           ;
    // P9.3: AMO watch — the in-cache RMW window [value capture → commit
    // write]. Armed at the AMO read's issue ack with the translated PA;
    // poisoned when the line departs the L1 (presence / precise-inv /
    // departure events); a poisoned AMO at commit suppresses its store and
    // replays from its own PC (commit_amo_replay — the sc_watch shape).
    // While clean it also drives the dcache's bounded ownership PIN.
    var amo_watch_valid_q: logic           ;
    var amo_watch_pa_q   : logic<64>       ;
    var amo_watch_rob_q  : logic<ROB_IDX_W>;
    var amo_poison_q     : logic           ;

    // M5.D.2: dmem_mmu busy stall — issue is held while MMU is in PTW
    // / dcache-stall. In Bare mode busy stays 0 so behavior is
    // unchanged. The IQ's `lowest-idx ready` pick keeps the in-flight
    // LOAD selected every cycle until busy drops and the CDB fires.
    var dbg_alu_pc      : logic<64>;
    var dbg_alu_src_a   : logic<64>;
    var dbg_alu_src_b   : logic<64>;
    var dbg_alu_use_pc_a: logic    ;
    var dbg_alu_rs1_data: logic<64>;
    var dbg_alu_valid   : logic    ;
    var dbg_alu_alu_out : logic<64>;
    var dbg_alu_instr   : logic<32>;
    var dbg_alu_imm     : logic<64>;
    // M9.A.309: block a NON-OWNER load from issuing/acking while a load walk
    // is in flight (walk_v_q). In the 1 stale cycle after the walk owner
    // completes (walk_v_q still set but dmem_mmu_busy already 0) the IQ can
    // select a younger TLB-hit load; without this block it would issue+CDB
    // while core_dmem_vaddr is still pinned to the owner's walk_vaddr_q and so
    // read the OWNER's data (load-load aliasing — `c.ldsp s1,40(sp)` returned
    // [sp+56]=ra's value, broke the Linux boot, cosim diverged @cy7.9M). The
    // owner (iq_iss_rob_idx == walk_rob_q) is NOT blocked; a non-owner waits
    // <=1-2 cy until walk_v_q clears, then issues reading its OWN address.
    // walk_v_q clears on MMU completion regardless of issue, so no deadlock.
    // Loop-free: uses only registers (walk_v_q/walk_is_store_q/walk_rob_q) +
    // the IQ select (iq_issue_op/iq_iss_rob_idx), never core_dmem_vaddr.
    let load_walk_block: logic = walk_v_q && !walk_is_store_q && iq_issue_op.base.is_load && iq_iss_rob_idx
        != walk_rob_q;
    // M9 SMP: bus back-pressure (i_dmem_grant) is owned ENTIRELY by the dcache
    // (since M8.B). The dcache asserts o_dmem_req ungated, waits for i_dmem_grant
    // before filling a miss / writing through, and holds dcache_stall meanwhile;
    // dcache_stall already gates issue / ack / commit below. The earlier M9.1
    // core-level grant gate (`dmem_issue_grant_ok` on every LOAD/AMO issue) is
    // therefore redundant AND deadlocks under a LIVE arbiter grant: a load that
    // HITS makes no bus request, so grant(==req)=0 would block its issue forever
    // (no req → no grant → no issue → no req). Removed — the dcache is the
    // single grant authority. i_dmem_grant now flows only to u_dcache.i_mem_grant.
    // M6: FPU owns the single CDB / PRF-write slot whenever it writes back —
    // a single-cycle FP op this cycle, or an FDIV.D/FSQRT.D completion. The
    // ALU yields issue that cycle. While an FDIV is in flight (busy) the FPU
    // CDB is silent (fpu_cdb.valid=0), so int ops keep issuing — no deadlock
    // for an older int op stuck behind the FDIV in the ROB. fpu_cdb.valid
    // derives only from registered iq_fp / fpu_wrap state, so this is loop-free.
    // M6.B.3: on the ALU branch the dest is FP for an FP load (FLW/FLD).
    // FP-SMP fix: cdb_dest_is_fp MUST mirror the lane-0 mux priority below
    // (fpu_cdb > mshr_cdb > alu_cdb). The original form lumped the MSHR and ALU
    // tiers together as `iq_iss_fp_ld`, but an MSHR completion is a DEFERRED
    // writeback of an EARLIER load — its FP-ness has nothing to do with the op
    // the IQ is presenting THIS cycle (iq_iss_fp_ld). MSHR captures exclude FP
    // loads (mshr_plain_load requires !iq_iss_fp_ld), so every mshr_cdb is an
    // INT load. When mshr_cdb wins the mux while the IQ happens to present an FP
    // load (iq_iss_fp_ld=1, issue blocked by mshr_cdb.valid), cdb_dest_is_fp went
    // HIGH → the int PRF write (line ~1940) and the int IQ wakeup (i_cdb_has_rd,
    // line ~2228) were suppressed, AND the int load's data was wrongly written
    // to the FP PRF (line ~2118). The consumer of that load never woke → it sat
    // at the ROB head forever (observed: __schedule FP context switch wedge at
    // 0x800df482, FP-on N=2 boot). FP-off never triggers it (iq_iss_fp_ld==0).
    // Phase 12 V0: the VU writeback (vu_cdb) sits at LOWEST priority on lane 0 —
    // it drives the bus only when the scalar pipe is idle (vu_cdb_free). Its dest
    // is integer, none, or (Phase 12 V3f vfmv.f.s) FP. When it wins the mux the
    // tail is vu_cdb_fp_dest: 1 only for a vfmv.f.s writeback, else 0 — so a VU
    // FP move routes cdb.pdst/data to prf_fp, and V=0 (no vfmv.f.s) is
    // byte-identical (the tail is 0 exactly as before; when alu_cdb.valid the
    // original iq_iss_fp_ld is used unchanged).
    // Phase 1 LSU 2-stage: when lsu_cdb wins, the completing load's FP-ness is the
    // LSR's LATCHED flag (lsr_fp_ld_q), NOT the op the IQ presents at Stage B
    // (iq_iss_fp_ld) — those differ once the load is decoupled from issue. Using the
    // current-issue flag routed FP loads to the INT regfile (all rv64uf/ud/zfhmin/
    // vfarith load+arith tests failed). alu_cdb never carries an FP load now (plain
    // loads ride lsu_cdb), so its iq_iss_fp_ld branch is dead-0 and stays as-is.
    // step-1.5: a lane-1-destined load (lsr_to_lane1) does NOT ride lane 0, so its
    // lsu_cdb arm is masked out of the lane-0 mux / dest-fp / vu-free terms here.
    // A-EXE E1 — see the alu_iss_fp_ld_q declaration: the alu arm's FP-load
    // classification must track the op in alu_cdb_eff, which at EX_PIPE=1 is the
    // REGISTERED (previous-cycle) result — so use the registered flag, not the live
    // iq_iss_fp_ld. Byte-identical at EX_PIPE=0 (== iq_iss_fp_ld).
    let alu_fp_ld_eff : logic = if EX_PIPE ? alu_iss_fp_ld_q : iq_iss_fp_ld;
    let cdb_dest_is_fp: logic = if fpu_cdb.valid ? fpu_dest_is_fp : if mshr_cdb.valid ? 1'b0 : if int_div_cdb.valid ? 1'b0 : if alu_cdb_eff.valid ? alu_fp_ld_eff : if (lsu_cdb.valid && !lsr_to_lane1) ? lsr_fp_ld_q : vu_cdb_fp_dest;
    let vu_cdb_free   : logic = !fpu_cdb.valid && !mshr_cdb.valid && !int_div_cdb.valid && !alu_cdb_eff.valid && !(lsu_cdb.valid && !lsr_to_lane1);
    // rs2 operand fed to the ALU: FP store data from prf_fp, else int rs2.
    // A-EXE E2 — operand bypass spanning the EX register. At EX_PIPE=1 a lane-0
    // producer's result sits in alu_cdb_q for one cycle before the PRF write lands,
    // so a consumer executing THIS cycle whose int source pdst == the staged
    // producer's pdst must read alu_cdb_q.data, not the (stale) PRF read. The
    // scheduled wakeup already woke the consumer at the right cycle; this just
    // supplies the value. Single-level bypass: alu_cdb_q holds the most-recent
    // (1-cycle-old) lane-0 result; an older result is already in the PRF. DEAD at
    // EX_PIPE=0 (exb_live folds to 0 → prf_*_data_b == prf_*_data, byte-identical).
    // has_rd gates real int writebacks (an ALU/AMO result is always int-dest, and a
    // real producer's pdst is never 0, so an x0 source — iq_iss_rs*_pdst==0 — never
    // matches). Lane-1 (alu_cdb2) is not staged until E4, so it is not a bypass src.
    // pdst != 0 excludes an x0-dest producer (has_rd with pdst 0): a real producer
    // always allocates a fresh free-list pdst (>= 32), so only an x0-dest op carries
    // pdst 0. Without this an x0 SOURCE (iq_iss_rs*_pdst == 0 — e.g. a store's
    // commit-read data operand marked always-ready via rs2_pdst 0, or a `x0` base)
    // spuriously matches the x0-dest producer and bypasses ITS data (observed: the
    // write_tohost `sw gp,off(t5)` wrote t5 instead of gp at EX_PIPE=1).
    let exb_live      : logic     = EX_PIPE && alu_cdb_q.valid && alu_cdb_q.has_rd && alu_cdb_q.pdst != 0;
    let byp_rs1       : logic     = exb_live && iq_iss_rs1_pdst == alu_cdb_q.pdst;
    let byp_rs2       : logic     = exb_live && iq_iss_rs2_pdst == alu_cdb_q.pdst;
    let byp_rs1_2     : logic     = exb_live && iq_iss_rs1_pdst2 == alu_cdb_q.pdst;
    let byp_rs2_2     : logic     = exb_live && iq_iss_rs2_pdst2 == alu_cdb_q.pdst;
    let prf_rs1_data_b : logic<64> = if byp_rs1 ? alu_cdb_q.data : prf_rs1_data;
    let prf_rs2_data_b : logic<64> = if byp_rs2 ? alu_cdb_q.data : prf_rs2_data;
    let prf_rs1_data2_b: logic<64> = if byp_rs1_2 ? alu_cdb_q.data : prf_rs1_data2;
    let prf_rs2_data2_b: logic<64> = if byp_rs2_2 ? alu_cdb_q.data : prf_rs2_data2;
    let alu_rs2_data: logic<64> = if iq_iss_fp_st ? prf_fp_store_data : prf_rs2_data_b;
    // P9.3 in-cache AMO: the M9.4 bus-atomic AMO lock (amo_read_pending_q /
    // amo_issue_lock_ok / o_amo_inflight) is GONE. The AMO/LR read acquires
    // the line E/M in the L1 (RFO), the commit write merges locally, and a
    // line departure inside the RMW window poisons the AMO watch (below) for
    // a commit-time replay — no bus-wide serialization, no issue bubble.
    // Phase 8 S10.3: dcache_stall now gates ONLY ops that read the dcache at
    // issue (loads incl. FP loads, and AMO/LR/SC value-capture reads). Stores
    // (AGU-only at issue; their write drains at commit, separately gated),
    // CSR, MUL/DIV and plain ALU ops issue freely while a miss fills — the
    // memory pipe is non-blocking for independent work. Loads/AMOs that miss
    // while the fill is busy simply wait in the IQ (blocking fallback;
    // miss-under-miss is S10.4).
    // Phase 8 S10.4a: ld0_hum_ok additionally lets a plain bare-mode slot-0
    // load complete in-pipe while a fill is in flight, when the fill-safe
    // dcache hit (dc_hit_safe) says its data is consistent (the filling way
    // is excluded inside the dcache).
    // S10.4b: dmem readers also yield while a queued-MSHR replay is driving
    // the dcache port (!replay_q) — during a replay cycle i_addr is the
    // replayed entry's, so dc_hit_safe is not the issuing load's verdict.
    let iss_reads_dmem: logic = iq_issue_op.base.is_load || iq_iss_is_amo;
    // PMP (Smpmp): a load denied by PMP must issue its fault IMMEDIATELY, even if
    // the dcache is mid-fill (dcache_stall) — it never reads the dcache (its
    // o_dmem_ren is suppressed), so it must not wait for the fill, and must not
    // be captured into an MSHR for replay (see mshr_capture below). Without this
    // the denied load stalls behind an unrelated fill, gets replay-captured, and
    // its replay drives the protected line into the dcache (deadlock).
    let iss_dc_ok     : logic = !iss_reads_dmem || (!replay_q && (!dcache_stall || ld0_hum_ok || dmem_mmu_acc_fault));
    // Phase 8 S10.1: lane-0 priority FPU > MSHR (deferred load fill) > ALU.
    // The MSHR holds its completion (mshr_done_q) until the FPU lane is free,
    // and the ALU yields issue/ack the cycle the MSHR writes back (gates below).
    // Phase 12 V0: assemble the VU writeback as a CdbBus (no store/load/csr/fault
    // side-bands — a vector op only writes the int PRF (vmv.x.s/vset*vl) or just
    // sets result_written (vadd)).
    always_comb {
        vu_cdb.valid       = vu_cdb_valid;
        vu_cdb.has_rd      = vu_cdb_has_rd;
        vu_cdb.pdst        = vu_cdb_pdst;
        vu_cdb.data        = vu_cdb_data;
        vu_cdb.rob_idx     = vu_cdb_rob_idx;
        vu_cdb.mispredict  = 1'b0;
        vu_cdb.redirect_pc = 64'd0;
        vu_cdb.is_store    = 1'b0;
        vu_cdb.store_addr  = 64'd0;
        vu_cdb.store_data  = 64'd0;
        vu_cdb.store_funct3 = 3'd0;
        vu_cdb.is_load     = 1'b0;
        vu_cdb.is_csr      = 1'b0;
        vu_cdb.csr_addr    = 12'd0;
        vu_cdb.csr_wdata   = 64'd0;
        vu_cdb.csr_illegal = 1'b0;
        vu_cdb.cas_q_mem_lo = 64'd0; // Zacas amocas.q: vector ops carry no CAS payload
        vu_cdb.cas_q_mem_hi = 64'd0;
        // V1: a faulting vector mem op rides the vu_cdb's load/store fault path.
        vu_cdb.is_lfault   = vu_cdb_is_lfault;
        vu_cdb.is_sfault   = vu_cdb_is_sfault;
        vu_cdb.fault_acc   = 1'b0; // PMP: vector accesses don't drive a PMP fault yet
        vu_cdb.fault_vaddr = vu_cdb_fault_vaddr;
    }
    always_comb {
        cdb = if fpu_cdb.valid ? fpu_cdb : if mshr_cdb.valid ? mshr_cdb : if int_div_cdb.valid ? int_div_cdb : if alu_cdb_eff.valid ? alu_cdb_eff : if (lsu_cdb.valid && !lsr_to_lane1) ? lsu_cdb : vu_cdb;
    }
    // DIV/REM (incl. W variants) are routed to the multi-cycle int_divider FU
    // (below), so gate this ALU off for them — u_alu must never drive alu_cdb
    // for a divide.
    let iss_is_div: logic = iq_issue_op.base.alu_op == alu_pkg::AluOp::DIV
        || iq_issue_op.base.alu_op == alu_pkg::AluOp::DIVU
        || iq_issue_op.base.alu_op == alu_pkg::AluOp::REM
        || iq_issue_op.base.alu_op == alu_pkg::AluOp::REMU
        || iq_issue_op.base.alu_op == alu_pkg::AluOp::DIVW
        || iq_issue_op.base.alu_op == alu_pkg::AluOp::DIVUW
        || iq_issue_op.base.alu_op == alu_pkg::AluOp::REMW
        || iq_issue_op.base.alu_op == alu_pkg::AluOp::REMUW;
    // Phase 0 LSU extraction: a slot-0 PLAIN load (is_load && !is_amo) writes
    // back via u_lsu on lsu_cdb, so u_alu is gated OFF for it (and u_lsu gated ON
    // under the identical issue condition). AMO/LR/SC (is_amo) stay on u_alu.
    let iss_is_plain_load: logic = iq_issue_op.base.is_load && !iq_iss_is_amo;
    // A-EXE E3 — writeback-arbitration via issue deferral (speculative_wakeup_design
    // §1.0b). At EX_PIPE=1 a lane-0 ALU result registered THIS cycle (alu_cdb_q)
    // broadcasts NEXT cycle, where a higher-priority FU (fpu > mshr > int_div, the
    // unified-CDB mux at ~line 2425) newly winning would silently DROP it (the int
    // PRF write rides cdb.pdst/data → the ALU result is lost → its consumer never
    // wakes → ROB-head wedge). The existing issue gate (!fpu_cdb.valid &&
    // !mshr_cdb.valid, at cycle N) protects only the SAME-cycle combinational
    // broadcast (EX_PIPE=0). To preserve "a granted fixed-latency ALU op ALWAYS
    // broadcasts at N+1" — the invariant the scheduled wakeup + E2 bypass rely on —
    // defer the lane-0 issue at N whenever a higher-priority FU will drive the CDB
    // at N+1. Conservative predictor (any FP activity in flight, any MSHR fill, or
    // an int-divide in flight — each can land on the CDB next cycle); tightened for
    // IPC at the EX_PIPE=1 flip. Threaded into BOTH u_alu.i_issue_valid AND
    // iq_issue_ack so a deferred op stays in the IQ (no false wakeup, no lost op).
    // DEAD at EX_PIPE=0 (ex3_defer folds to 0 → both gates byte-identical, DCE'd).
    // int_div broadcasts at N+1 when its combinational done (int_div_valid_w,
    // registered into int_div_done_q next cycle → int_div_cdb.valid) fires THIS
    // cycle. int_div_valid_w is defined at the int_divider inst below, so forward-
    // declare the predictor here and assign it right after that inst.
    var ex3_int_div_next: logic;
    let ex3_hipri_next: logic = iqf_issue_valid || fpu_busy || fpu_cdb.valid
        || mshra_v_q || mshrb_v_q || mshr_cdb.valid
        || ex3_int_div_next || int_div_cdb.valid;
    let ex3_defer: logic = EX_PIPE && ex3_hipri_next;
    inst u_alu: alu_wrap (
        // Phase 1 step-1.5: slot-0 issues FREELY while a plain load is in Stage B
        // (lsr_v_q) — the load now writes back on lane 1 (flexible lane), so it no
        // longer contends with a Stage-A ALU op on lane 0. Only AMO/LR/SC stay
        // gated by !lsr_v_q: they READ the dcache at issue (dc_amo_read) and would
        // collide with the LSR's Stage-B read port. (A fault/FP load that DOES ride
        // lane 0 yields to alu_cdb via lsr_lane0_free, so no writeback is lost.)
        i_issue_valid     : iq_issue_valid && !iss_is_div && !dmem_mmu_busy && !load_walk_block && !fpu_cdb.valid && !mshr_cdb.valid && iss_dc_ok && !load_blocks_on_store && !iss_is_plain_load && !(lsr_v_q && iq_iss_is_amo) && !amo_fetch_hold && !ex3_defer,
        i_issue_op        : iq_issue_op                                         ,
        i_issue_rd_pdst   : iq_iss_rd_pdst                                      ,
        i_issue_rob_idx   : iq_iss_rob_idx                                      ,
        i_rs1_data        : prf_rs1_data_b                                      ,
        i_rs2_data        : alu_rs2_data                                        ,
        i_pm_mode         : pm_mode                                            ,
        i_pm_va           : pm_va                                              ,
        // M8.B: LOAD result + next-dword come from the dcache (combinational
        // hit data). On a miss dcache_stall=1 gates i_issue_valid above so the
        // CDB write is suppressed until the fill lands; the IQ keeps the op
        // (iq_issue_ack also gated) and re-issues it once the line is cached.
        i_load_data       : dcache_rdata                                        ,
        i_load_data_next  : dcache_rdata_next                                   ,
        // Phase 8 S5.1: core-computed store-to-load forward bytes + mask.
        i_fwd_data        : stld_fwd_data                                       ,
        i_fwd_mask        : stld_fwd_mask                                       ,
        i_dmem_fault      : dmem_mmu_fault                                      ,
        i_dmem_fault_s    : dmem_mmu_fault_s                                    ,
        i_dmem_acc_fault  : dmem_mmu_acc_fault                                  ,
        i_dmem_acc_fault_s: dmem_mmu_acc_fault_s                                ,
        i_sc_acc_fault    : sc_issue_acc_fault                                  ,
        i_csr_data        : csr_rd_data                                         ,
        i_rsv_valid       : rsv_valid_q                                         ,
        i_rsv_addr        : rsv_addr_q                                          ,
        i_is_amo          : iq_iss_is_amo                                       ,
        i_amo_noread      : asq_nr_iss                                          , // R3.2c: no execute read ⇒ not a load
        i_amo_funct5      : iq_iss_amo_funct5                                   ,
        i_rd_cmp_data     : prf_rd_cmp_data                                     , // Zacas: amocas compare value
        i_is_csr          : iq_iss_is_csr                                       ,
        i_csr_addr        : iq_iss_csr_addr                                     ,
        i_csr_op          : iq_iss_csr_op                                       ,
        i_csr_imm         : iq_iss_csr_imm                                      ,
        i_rs1_arch        : iq_iss_rs1_arch                                     ,
        i_priv            : csr_priv                                            ,
        i_fp_ld           : iq_iss_fp_ld                                        ,
        o_cdb             : alu_cdb                                             ,
        o_dbg_alu_pc      : dbg_alu_pc                                          ,
        o_dbg_alu_src_a   : dbg_alu_src_a                                       ,
        o_dbg_alu_src_b   : dbg_alu_src_b                                       ,
        o_dbg_alu_use_pc_a: dbg_alu_use_pc_a                                    ,
        o_dbg_alu_rs1_data: dbg_alu_rs1_data                                    ,
        o_dbg_alu_valid   : dbg_alu_valid                                       ,
        o_dbg_alu_alu_out : dbg_alu_alu_out                                     ,
        o_dbg_alu_instr   : dbg_alu_instr                                       ,
        o_dbg_alu_imm     : dbg_alu_imm                                         ,
    );

    // A-EXE EX register: capture the lane-0 ALU CDB every cycle (the EX|WB stage
    // boundary). Cleared on a commit-time redirect so a flushed op's staged result
    // never broadcasts. DEAD at EX_PIPE=0 (alu_cdb_q feeds nothing → DCE); the
    // bypass (E2) + WB-arbitration (E3) land before the EX_PIPE=1 flip.
    //
    // A-EXE (EX_PIPE=1) hvirq fix: an op that executes on the SAME cycle an early
    // (execute-time) redirect fires AND is YOUNGER than the redirect point is
    // WRONG-PATH — the early redirect (S8.E) partial-squashes its ROB entry, but the
    // early redirect does NOT flush the IQ (i_flush = commit redirect only; core:~7690
    // acknowledges wrong-path issue during early recovery yet guards only the REDIRECT,
    // not the WRITEBACK). Without this guard the EX register would hold that wrong-path
    // result and broadcast it NEXT cycle onto its rob_idx, which is rapidly reused by a
    // correct-path op — corrupting the reusing op's redirect_pc / result_written
    // (traced: hvirq's VS spin-loop `bne` at rob_idx=8 inherited a wrong-path
    // redirect_pc=0x66 from a squashed ecall → wrong IRQ resume PC vsepc=0x66 → VS-SRET
    // returned past the ECALL → handler re-ran → 2nd non-idempotent SRET set priv=USER →
    // csrr scause illegal → cause-2 trap). At EX_PIPE=0 the writeback is same-cycle
    // (non-registered) and lands before the reuse, so this is a pure EX_PIPE=1 hazard.
    // Squash the registration exactly like the commit-redirect arm. Age vs
    // early_redir_idx_q mirrors em0_age/em0_live. Dead at EX_PIPE=0 (EX_PIPE && … folds
    // to 0; alu_cdb_q unused → DCE) → byte-identical.
    let ec_age      : logic<ROB_IDX_W> = alu_cdb.rob_idx - rob_head_idx;
    let er_age      : logic<ROB_IDX_W> = early_redir_idx_q - rob_head_idx;
    let ec_wrongpath: logic = EX_PIPE && early_redir_fire_q && alu_cdb.valid
        && ({3'b000, ec_age} <: rob_size) && (ec_age >: er_age);
    always_ff (clk, rst) {
        if_reset {
            alu_cdb_q       = '0;
            alu_iss_fp_ld_q = 1'b0;
        } else if redirect_fire {
            alu_cdb_q       = '0;
            alu_iss_fp_ld_q = 1'b0;
        } else if ec_wrongpath {
            alu_cdb_q       = '0;
            alu_iss_fp_ld_q = 1'b0;
        } else {
            alu_cdb_q       = alu_cdb;
            alu_iss_fp_ld_q = iq_iss_fp_ld;
        }
    }

    // ---- Phase 0 LSU: plain-load writeback lane ----
    // u_lsu drives lsu_cdb for a slot-0 plain load under the SAME issue gate as
    // u_alu used (u_alu is gated off for the load via !iss_is_plain_load), so the
    // load writes back bit-identically — just on lsu_cdb instead of alu_cdb. The
    // load value, store→load forward overlay and fault flags are formed exactly as
    // the old alu_wrap load path did. AGU (agu_addr_iss), forward bytes
    // (stld_fwd_*) and the dcache read (dcache_rdata) stay in the core.
    // Phase 1 LSU 2-stage: u_lsu now reads the STAGE-B registered metadata (lsr_*_q)
    // and the Stage-B dcache read / re-pointed forward net; it fires when the LSR
    // completes (lsr_complete = hit/uncached read landed, or a Stage-A fault). The
    // dcache read at lsr_paddr_q (lsr_drive) puts the load data on dcache_rdata, and
    // the forward net (sf*/sbf*) is re-pointed to lsr_vaddr_q/lsr_paddr_q below.
    inst u_lsu: lsu (
        i_valid         : lsr_complete    ,
        i_has_rd        : lsr_has_rd_q     ,
        i_fp_ld         : lsr_fp_ld_q      ,
        i_pdst          : lsr_pdst_q       ,
        i_rob_idx       : lsr_rob_idx_q    ,
        i_funct3        : lsr_funct3_q     ,
        i_pc            : lsr_pc_q         ,
        i_agu_addr      : lsr_vaddr_q      ,
        i_rs2_data      : lsr_rs2_q        ,
        i_load_data     : dcache_rdata     ,
        i_load_data_next: dcache_rdata_next,
        i_fwd_data      : stld_fwd_data    ,
        i_fwd_mask      : stld_fwd_mask    ,
        i_dmem_fault    : lsr_fault_pg_q   ,
        i_dmem_acc_fault: lsr_fault_acc_q  ,
        o_cdb           : lsu_cdb          ,
    );

    // ---- Multi-cycle integer DIV/REM FU + per-op completion latch ----
    // Mirrors the FDIV.D handshake: the DIV/REM op is held at the iq_int head
    // (operand-held, so prf_rs1/rs2_data stay stable) while the radix-4
    // int_divider runs; the result is latched (owner-tracked by ROB index, so a
    // displaced-and-returned op or a back-to-back div reads the right result) and
    // driven on int_div_cdb when the op is at the head and lane 0 is free.
    var int_div_result_raw: logic<64>       ;
    var int_div_valid_w   : logic           ;
    var int_div_busy_w    : logic           ;
    var int_div_started   : logic           ;
    var int_div_result_q  : logic<64>       ;
    var int_div_done_q    : logic           ;
    var int_div_owner_q   : logic<ROB_IDX_W>;
    let int_div_done_for_me: logic = int_div_done_q && iq_iss_rob_idx == int_div_owner_q;
    let int_div_start      : logic = iq_issue_valid && iss_is_div && !redirect_fire
        && !int_div_busy_w && !int_div_started && !int_div_done_for_me; // step-1.5: div issues freely (a fault/FP load on lane 0 yields to int_div_cdb)
    inst u_int_div: int_divider (
        clk                              ,
        rst                              ,
        i_valid : int_div_start          ,
        i_alu_op: iq_issue_op.base.alu_op,
        i_a     : prf_rs1_data_b         ,
        i_b     : prf_rs2_data_b         ,
        i_flush : redirect_fire          ,
        o_result: int_div_result_raw     ,
        o_valid : int_div_valid_w        ,
        o_busy  : int_div_busy_w         ,
    );
    // A-EXE E3: int_div_valid_w (combinational done) THIS cycle ⇒ int_div_cdb.valid
    // next cycle → the ex3_defer predictor above defers a lane-0 ALU issue so the
    // registered ALU result is not dropped by int_div winning the CDB at N+1.
    assign ex3_int_div_next = int_div_valid_w;
    always_ff (clk, rst) {
        if_reset {
            int_div_started  = 1'b0;
            int_div_done_q   = 1'b0;
            int_div_result_q = '0;
            int_div_owner_q  = '0;
        } else if redirect_fire {
            int_div_started = 1'b0;
            int_div_done_q  = 1'b0;
        } else {
            if int_div_start {
                int_div_started = 1'b1;
                int_div_owner_q = iq_iss_rob_idx;
                int_div_done_q  = 1'b0;
            } else if int_div_valid_w {
                int_div_started = 1'b0;
            }
            if int_div_valid_w {
                int_div_result_q = int_div_result_raw;
                int_div_done_q   = 1'b1;
            } else if !(iq_issue_valid && iss_is_div) {
                int_div_done_q = 1'b0;
            }
        }
    }
    always_comb {
        int_div_cdb.valid        = iq_issue_valid && iss_is_div && !redirect_fire && int_div_done_for_me;
        int_div_cdb.has_rd       = int_div_cdb.valid && iq_issue_op.base.has_rd;
        int_div_cdb.pdst         = iq_iss_rd_pdst;
        int_div_cdb.data         = int_div_result_q;
        int_div_cdb.rob_idx      = iq_iss_rob_idx;
        int_div_cdb.mispredict   = 1'b0;
        int_div_cdb.redirect_pc  = 64'd0;
        int_div_cdb.is_store     = 1'b0;
        int_div_cdb.store_addr   = 64'd0;
        int_div_cdb.store_data   = 64'd0;
        int_div_cdb.store_funct3 = 3'd0;
        int_div_cdb.is_load      = 1'b0;
        int_div_cdb.is_csr       = 1'b0;
        int_div_cdb.csr_addr     = 12'd0;
        int_div_cdb.csr_wdata    = 64'd0;
        int_div_cdb.csr_illegal  = 1'b0;
        int_div_cdb.cas_q_mem_lo = 64'd0;
        int_div_cdb.cas_q_mem_hi = 64'd0;
        int_div_cdb.is_lfault    = 1'b0;
        int_div_cdb.is_sfault    = 1'b0;
        int_div_cdb.fault_acc    = 1'b0;
        int_div_cdb.fault_vaddr  = 64'd0;
    }

    // ============================================================
    // Phase 8 S3: pipe-1 — 2nd integer execute pipe (ALU/branch/JAL/JALR/LUI/
    // AUIPC only). Built DEAD in S3.a: issue2_valid=0, so alu_cdb2 is silent and
    // the 2nd PRF write / ROB writeback / IQ snoop never fire (cycle-exact vs
    // 1-wide issue). S3.b drives issue2_valid + the slot-1 issue op from the IQ's
    // 2nd issue port. mem/csr/amo/fp inputs are tied off — pipe-1 never executes
    // a LOAD/STORE/AMO/CSR/FP op (those stay slot-0 only).
    // S3.b: pipe-1 issues whenever the IQ's 2nd port presents an op. No extra
    // gating — pipe-1 has no LOAD/STORE/AMO/CSR/FP, so it is independent of the
    // pipe-0 hazards (dcache_stall / dmem_mmu_busy / load_walk_block /
    // fpu_cdb.valid / amo lock); its CDB lane 1, PRF write port 1 and ROB
    // writeback port 1 are all separate from lane 0.
    // Phase 8 S5.2: pipe-1 now also executes bare-mode LOADs. alu_wrap re-derives
    // the AGU (i_rs1_data2 + imm == agu_addr_iss2) and the load merge from the 2nd
    // dcache read (dcache_rdata2 / _next) + the 2nd forward network. i_issue_valid
    // = issue2_fire (an ALU op always fires; a slot-1 load fires only when it hits
    // the 2nd port — else it is held in the IQ). A slot-1 LOAD is bare-mode, so
    // i_dmem_fault stays 0; FP loads stay slot-0 (i_fp_ld=0).
    inst u_alu2: alu_wrap (
        i_issue_valid     : issue2_fire      ,
        i_issue_op        : iq_issue_op2    , // S3.b: slot-1 issue op
        i_issue_rd_pdst   : iq_iss_rd_pdst2 , // S3.b: slot-1 rd pdst
        i_issue_rob_idx   : iq_iss_rob_idx2 , // S3.b: slot-1 rob idx
        i_rs1_data        : prf_rs1_data2_b ,
        i_rs2_data        : prf_rs2_data2_b ,
        i_pm_mode         : pm_mode         , // P10 pointer masking (slot-1 bare loads)
        i_pm_va           : pm_va           ,
        i_load_data       : dcache_rdata2   , // S5.2: 2nd dcache read
        i_load_data_next  : dcache_rdata2_next,
        i_fwd_data        : stld_fwd_data2  , // S5.2: 2nd forward network
        i_fwd_mask        : stld_fwd_mask2  ,
        i_dmem_fault      : 1'b0            ,
        i_dmem_fault_s    : 1'b0            ,
        i_dmem_acc_fault  : 1'b0            , // PMP: a denied slot-1 load is held off slot-1 (see ld2_complete) and re-issued on pipe-0
        i_dmem_acc_fault_s: 1'b0            ,
        i_sc_acc_fault    : 1'b0            , // pipe-1: no AMO/SC
        i_csr_data        : 64'd0           , // pipe-1: no CSR
        i_rsv_valid       : 1'b0            ,
        i_rsv_addr        : 64'd0           ,
        i_is_amo          : 1'b0            , // pipe-1: no AMO
        i_amo_noread      : 1'b0            , // pipe-1: no AMO
        i_amo_funct5      : 5'd0            ,
        i_rd_cmp_data     : 64'd0           , // pipe-1: no AMO/CAS
        i_is_csr          : 1'b0            ,
        i_csr_addr        : 12'd0           ,
        i_csr_op          : csr_pkg::CsrOp::RW,
        i_csr_imm         : 1'b0            ,
        i_rs1_arch        : 5'd0            ,
        i_priv            : csr_priv        ,
        i_fp_ld           : 1'b0            , // pipe-1: no FP
        o_cdb             : alu2_pipe_cdb   , // step-1.5: raw pipe-1 bus, muxed into alu_cdb2 below
        o_dbg_alu_pc      : _               ,
        o_dbg_alu_src_a   : _               ,
        o_dbg_alu_src_b   : _               ,
        o_dbg_alu_use_pc_a: _               ,
        o_dbg_alu_rs1_data: _               ,
        o_dbg_alu_valid   : _               ,
        o_dbg_alu_alu_out : _               ,
        o_dbg_alu_instr   : _               ,
        o_dbg_alu_imm     : _               ,
    );

    // step-1.5: lane-1 writeback mux. A non-fault/non-FP plain load completing this
    // cycle (lsr_lane1_fire) takes lane 1, and pipe-1 yields (issue2_fire is gated by
    // !lsr_lane1_fire below, so alu2_pipe_cdb is silent then) — they are mutually
    // exclusive. Otherwise lane 1 carries pipe-1 verbatim. lsu_cdb already reproduces
    // a full CdbBus; the lane-1 (cdb2) consumers read only {valid, rob_idx, data,
    // has_rd, pdst, is_load, store_addr, store_funct3, redirect_pc, mispredict} — all
    // valid for a plain load (mispredict=0, is_lfault=0 since lsr_to_lane1 excludes
    // faults; the unused fields are ignored on this lane).
    always_comb {
        alu_cdb2 = if lsr_lane1_fire ? lsu_cdb : alu2_pipe_cdb;
    }

    // M5.D.2: gate ack on MMU busy. While busy the IQ holds the op.
    // M9.A.309: also hold a non-owner load while a load walk is in flight
    // (load_walk_block) so it cannot ack/leave the IQ without issuing.
    // M6: also yield the ack when the FPU owns the CDB this cycle, else the
    // ALU op would leave iq_int without writing back (lost op → ROB stuck).
    // M8.B: also hold the op in the IQ while the dcache stalls (load miss /
    // fill / write-during-fill). The op re-issues each cycle (core_dmem_ren
    // stays asserted, driving the fill) but does not ack/leave until the data
    // is cached and dcache_stall drops.
    // Phase 8 S10.1: also yield the ack when the MSHR owns the CDB (deferred
    // load-fill writeback), mirroring the FPU-yield term.
    // Phase 8 S10.3: a CAPTURED missing load acks OUT of the IQ on the
    // fill-start cycle (mshr_capture) even though dcache_stall holds — its
    // writeback is deferred to the MSHR; u_alu.i_issue_valid stays suppressed
    // that cycle (iss_dc_ok=0 for a load under stall), so no CDB write happens.
    // A DIV/REM stays at the iq_int head (operand-held) until the int_divider FU
    // completes AND wins lane 0 (FPU/MSHR have priority) — then it acks out as its
    // result writes back on int_div_cdb. Non-div ops use the existing handshake.
    // Phase 1 LSU 2-stage: a plain load no longer acks on the normal path — it acks
    // OUT of the IQ when it latches the LSR (lsr_capture, Stage A), exactly like the
    // MSHR capture folds in. The normal path is additionally gated by !lsr_v_q so no
    // OTHER slot-0 op acks/leaves the IQ while a load occupies the LSR (block-on-issue).
    let iq_issue_ack: logic = if iss_is_div ?
        (int_div_cdb.valid && !fpu_cdb.valid && !mshr_cdb.valid)
    : ((iq_issue_valid && !dmem_mmu_busy && !load_walk_block && !fpu_cdb.valid && !mshr_cdb.valid && iss_dc_ok && !load_blocks_on_store && !iss_is_plain_load && !(lsr_v_q && iq_iss_is_amo) && !amo_fetch_hold && !ex3_defer) || lsr_capture || mshr_capture);

    // A-LOOP A2 piece 1 (cp_a_loop_plan.md §11.6): dcache-FREE FR-drain ack for iq_int.
    // BYTE-IDENTICAL to iq_issue_ack for every op: a plain load's ack is already just
    // lsr_capture||mshr_capture (its iq_issue_ack normal branch is 0 via
    // !iss_is_plain_load); every other op takes the iq_issue_ack else-branch verbatim.
    // The only difference is STRUCTURAL — for the plain-load case the iss_dc_ok dcache
    // cone is absent, so at LOAD_SPEC=1 the fr_drain0 → slot0_grant → rs1_rdy path drops
    // the §11.5 (a1) dcache leak. Unused (DCE'd) at iq_int's LOAD_SPEC=0.
    let iq_fr_drain_ack: logic = if iss_is_plain_load ? (lsr_capture || mshr_capture) : iq_issue_ack;

    // ============================================================
    // PRF
    // ============================================================
    inst u_prf: prf_int (
        clk                                                  ,
        rst                                                  ,
        i_rd1_pdst: iq_iss_rs1_pdst                          ,
        o_rd1_data: prf_rs1_data                             ,
        i_rd2_pdst: iq_iss_rs2_pdst                          ,
        o_rd2_data: prf_rs2_data                             ,
        i_rd3_pdst: iqf_iss_int_pdst                         , // M6: FPU int source
        o_rd3_data: prf_int_rs3_data                         ,
        // Phase 8 S3.b: pipe-1 read pair — the slot-1 issue rs1/rs2 pdsts.
        i_rd4_pdst: iq_iss_rs1_pdst2                         ,
        o_rd4_data: prf_rs1_data2                            ,
        i_rd5_pdst: iq_iss_rs2_pdst2                         ,
        o_rd5_data: prf_rs2_data2                            ,
        i_rd6_pdst: vu_scalar_pdst                           , // Phase 12 V0: VU scalar
        o_rd6_data: vu_scalar_data                           ,
        i_rd7_pdst: vu_scalar2_pdst                          , // Phase 12 V5h: VU strided stride (x[rs2])
        o_rd7_data: vu_scalar2_data                          ,
        i_rd8_pdst: iq_iss_rd_old_pdst                       , // Zacas: amocas compare value
        o_rd8_data: prf_rd_cmp_data                          ,
        i_wr_en   : cdb.valid && cdb.has_rd && !cdb_dest_is_fp,
        i_wr_pdst : cdb.pdst                                 ,
        i_wr_data : cdb.data                                 ,
        // Phase 8 S3: CDB lane 1 (pipe-1) write — always integer (no FP on pipe-1).
        i_wr_en2  : alu_cdb2.valid && alu_cdb2.has_rd        ,
        i_wr_pdst2: alu_cdb2.pdst                            ,
        i_wr_data2: alu_cdb2.data                            ,
        // Zacas amocas.q commit-time pair writeback (rd lo / rd+1 hi). Driven by
        // the commit-stage always_comb (the commit signals are defined later, so
        // these go through forward-declared vars).
        i_wr_en3  : cas_q_wb_lo_en                           ,
        i_wr_pdst3: cas_q_wb_lo_pdst                         ,
        i_wr_data3: cas_q_wb_lo_data                         ,
        i_wr_en4  : cas_q_wb_hi_en                           ,
        i_wr_pdst4: cas_q_wb_hi_pdst                         ,
        i_wr_data4: cas_q_wb_hi_data                         ,
    );

    // ============================================================
    // free_list
    // ============================================================
    var fl_push_en  : logic           ;
    var fl_push_pdst: logic<PRF_INT_W>;
    // Phase 8 S1: 2-wide commit slot-1 integer free-list push.
    var fl_push_en2  : logic           ;
    var fl_push_pdst2: logic<PRF_INT_W>;

    // Phase 8 S8: branch-checkpoint capture controls, shared by the int/fp RAT and
    // both free lists. At a CONTROL op's rename, each module snapshots its rename
    // state (rat_spec map / free_list head) AS OF that op, keyed by its rob_idx, so
    // an execute-time mispredict (S8.A early_mispredict) can be recovered in one
    // cycle without a ROB walk. Restore is gated OFF here (s8_restore_en = 0) — the
    // checkpoints are captured but never applied — until S8.E wires the trigger.
    let s8_ckpt0_en   : logic            = rename_fire && rob_alloc_entry.is_control;
    let s8_ckpt0_idx  : logic<ROB_IDX_W> = rob_alloc_idx;
    let s8_ckpt1_en   : logic            = rename_fire2 && rob_alloc_entry2.is_control;
    let s8_ckpt1_idx  : logic<ROB_IDX_W> = rob_alloc_idx2;
    // Phase 8 S8.E: the flip. Restore the int/fp RAT + both free lists from the
    // resolved branch's checkpoint, and partial-squash the ROB + both IQs of every
    // entry younger than it, the cycle after the mispredict is detected at execute.
    // Gated by !redirect_fire so a same-cycle commit redirect (full flush) wins;
    // when it does, the ROB/RAT/free-list recover via i_redirect_fire/i_recovery_fire
    // instead. The restore index = the squash index = the resolved branch's rob_idx.
    let s8_restore_en : logic            = early_redir_fire_q && !redirect_fire;
    let s8_restore_idx: logic<ROB_IDX_W> = early_redir_idx_q;

    let fl_pop_en: logic = rename_fire && dec_op.has_rd;
    inst u_fl: free_list (
        clk                           ,
        rst                           ,
        i_pop_en       : fl_pop_en    ,
        o_pop_pdst     : new_rd_pdst  ,
        i_pop_en2      : fl_pop_en2   ,
        o_pop_pdst2    : new_rd_pdst2 ,
        o_empty        : free_empty   ,
        o_avail2       : free_avail2  ,
        i_push_en      : fl_push_en   ,
        i_push_pdst    : fl_push_pdst ,
        i_push_en2     : fl_push_en2  ,
        i_push_pdst2   : fl_push_pdst2,
        i_recovery_fire: redirect_fire,
        i_ckpt0_en     : s8_ckpt0_en  ,
        i_ckpt0_idx    : s8_ckpt0_idx ,
        i_ckpt1_en     : s8_ckpt1_en  ,
        i_ckpt1_idx    : s8_ckpt1_idx ,
        i_restore_en   : s8_restore_en,
        i_restore_idx  : s8_restore_idx,
    );

    // ============================================================
    // RAT
    // ============================================================
    var rat_commit_en  : logic           ;
    var rat_commit_arch: logic<5>        ;
    var rat_commit_pdst: logic<PRF_INT_W>;
    // Phase 8 S1: 2-wide commit slot-1 arch-RAT write.
    var rat_commit_en2  : logic           ;
    var rat_commit_arch2: logic<5>        ;
    var rat_commit_pdst2: logic<PRF_INT_W>;

    inst u_rat: rat (
        clk                                          ,
        rst                                          ,
        i_rs1_arch     : dec_op.rs1_arch             ,
        o_rs1_pdst     : rs1_pdst                    ,
        i_rs2_arch     : dec_op.rs2_arch             ,
        o_rs2_pdst     : rs2_pdst                    ,
        i_rd_arch      : dec_op.rd_arch              ,
        o_rd_old_pdst  : old_rd_pdst                 ,
        // Phase 8 S2: slot-1 raw reads (core applies the intra-bundle bypass).
        i_rs1_arch2    : dec_op2_rs1_arch            ,
        o_rs1_pdst2    : rat_rs1_pdst2               ,
        i_rs2_arch2    : dec_op2_rs2_arch            ,
        o_rs2_pdst2    : rat_rs2_pdst2               ,
        // Zacas amocas.q: steal the slot-1 rd old-pdst read port to look up rd+1's
        // current mapping (slot-1 co-rename is suppressed for amocas.q, so the
        // port is free). The captured pdst becomes RobEntry.rdh_pdst.
        i_rd_arch2     : if dec_op.is_cas_q ? dec_op.rd_arch + 5'd1 : dec_op2_rd_arch,
        o_rd_old_pdst2 : rat_rd_old_pdst2            ,
        i_rename_en    : rename_fire && dec_op.has_rd,
        i_rename_arch  : dec_op.rd_arch              ,
        i_rename_pdst  : new_rd_pdst                 ,
        // Phase 8 S2: slot-1 rename write (int dest), gated off until S4.
        i_rename_en2   : rename_fire2 && dec_op2_has_rd,
        i_rename_arch2 : dec_op2_rd_arch             ,
        i_rename_pdst2 : new_rd_pdst2                ,
        i_commit_en    : rat_commit_en               ,
        i_commit_arch  : rat_commit_arch             ,
        i_commit_pdst  : rat_commit_pdst             ,
        i_commit_en2   : rat_commit_en2              ,
        i_commit_arch2 : rat_commit_arch2            ,
        i_commit_pdst2 : rat_commit_pdst2            ,
        i_recovery_fire: redirect_fire               ,
        i_ckpt0_en     : s8_ckpt0_en                 ,
        i_ckpt0_idx    : s8_ckpt0_idx                ,
        i_ckpt1_en     : s8_ckpt1_en                 ,
        i_ckpt1_idx    : s8_ckpt1_idx                ,
        i_restore_en   : s8_restore_en               ,
        i_restore_idx  : s8_restore_idx              ,
    );

    // ============================================================
    // M6: FP datapath — rat_fp + fp free_list + prf_fp + iq_fp + fpu_wrap
    // ============================================================
    var fp_rat_commit_en: logic          ;
    var fp_fl_push_en   : logic          ;
    var fp_fl_push_pdst : logic<PRF_FP_W>;

    inst u_rat_fp: rat_fp (
        clk                                                ,
        rst                                                ,
        i_rs1_arch     : dec_op.rs1_arch                   ,
        o_rs1_pdst     : fp_rs1_pdst                       ,
        i_rs2_arch     : dec_op.rs2_arch                   ,
        o_rs2_pdst     : fp_rs2_pdst                       ,
        i_rs3_arch     : dec_op.rs3_arch                   ,
        o_rs3_pdst     : fp_rs3_pdst                       ,
        i_rd_arch      : dec_op.rd_arch                    ,
        o_rd_old_pdst  : fp_old_rd_pdst                    ,
        i_rename_en    : rename_fire && dec_op.fp_writes_fp,
        i_rename_arch  : dec_op.rd_arch                    ,
        i_rename_pdst  : new_fp_rd_pdst                    ,
        i_commit_en    : fp_rat_commit_en                  ,
        i_commit_arch  : rat_commit_arch                   , // = c_rd_arch (shared)
        i_commit_pdst  : rat_commit_pdst                   , // = c_rd_pdst (shared)
        i_recovery_fire: redirect_fire                     ,
        i_ckpt0_en     : s8_ckpt0_en                       ,
        i_ckpt0_idx    : s8_ckpt0_idx                      ,
        i_ckpt1_en     : s8_ckpt1_en                       ,
        i_ckpt1_idx    : s8_ckpt1_idx                      ,
        i_restore_en   : s8_restore_en                     ,
        i_restore_idx  : s8_restore_idx                    ,
    );

    inst u_fl_fp: free_list (
        clk                                                 ,
        rst                                                 ,
        i_pop_en       : rename_fire && dec_op.fp_writes_fp ,
        o_pop_pdst     : new_fp_rd_pdst                     ,
        // FP free list stays 1-wide (FP is rare, pipe-0 only): slot-1 pop/push
        // ports tied off.
        i_pop_en2      : 1'b0                               ,
        o_pop_pdst2    : _                                  ,
        o_empty        : fp_free_empty                      ,
        o_avail2       : _                                  , // FP free-list 1-wide

        i_push_en      : fp_fl_push_en                      ,
        i_push_pdst    : fp_fl_push_pdst                    ,
        i_push_en2     : 1'b0                               ,
        i_push_pdst2   : 6'd0                               ,
        i_recovery_fire: redirect_fire                      ,
        i_ckpt0_en     : s8_ckpt0_en                        ,
        i_ckpt0_idx    : s8_ckpt0_idx                       ,
        i_ckpt1_en     : s8_ckpt1_en                        ,
        i_ckpt1_idx    : s8_ckpt1_idx                       ,
        i_restore_en   : s8_restore_en                      ,
        i_restore_idx  : s8_restore_idx                     ,
    );

    inst u_prf_fp: prf_fp (
        clk                                                  ,
        rst                                                  ,
        i_rd1_pdst: iqf_iss_s1_pdst                          ,
        o_rd1_data: prf_fp_rs1_data                          ,
        i_rd2_pdst: iqf_iss_s2_pdst                          ,
        o_rd2_data: prf_fp_rs2_data                          ,
        i_rd3_pdst: iqf_iss_s3_pdst                          ,
        o_rd3_data: prf_fp_rs3_data                          ,
        i_rd4_pdst: iq_iss_rs2_pdst                          , // M6.B.3: FP store data
        o_rd4_data: prf_fp_store_data                        ,
        i_rd5_pdst: vu_fscalar_pdst                          , // V3b: VU FP scalar (.vf)
        o_rd5_data: vu_fscalar_data                          ,
        i_wr_en   : cdb.valid && cdb.has_rd && cdb_dest_is_fp,
        i_wr_pdst : cdb.pdst                                 ,
        i_wr_data : cdb.data                                 ,
    );

    let iqf_issue_ack: logic = iqf_issue_valid && !fpu_busy && !redirect_fire;
    inst u_iq_fp: iq_fp (
        clk                                                       ,
        rst                                                       ,
        i_alloc_en          : rename_fire && dec_op.is_fpu_op     ,
        i_alloc_fpu_op      : dec_op.fpu_op                       ,
        i_alloc_rm          : dec_op.fp_rm                        ,
        i_alloc_fli_idx     : dec_op.rs1_arch                     , // P10 Zfa FLI index = rs1 field

        i_alloc_rd_pdst     : ren_rd_pdst                         , // FP pdst (writes_fp) or INT pdst (writes_int)
        i_alloc_rob_idx     : rob_alloc_idx                       ,
        // FP→int ops (FCVT.w/FCLASS/FEQ/FMV.X) write an INTEGER rd, so rd=x0
        // must NOT write back — mirror the integer has_rd gate (rd!=0). Without
        // this the CDB writes prf[0] (the arch-zero hard tie) with the result,
        // which a nearby reader of x0 then sees (the int path gates via
        // dec_op.has_rd = reg_wen && rd!=0; the FP path skipped it). fp_writes_fp
        // targets an FP reg (f0 is real), so it needs no x0 gate.
        i_alloc_has_rd      : dec_op.fp_writes_fp || (dec_op.fp_writes_int && dec_op.rd_arch != 5'd0),
        i_alloc_writes_int  : dec_op.fp_writes_int               ,
        i_alloc_s1_pdst     : fp_rs1_pdst                         ,
        i_alloc_s2_pdst     : fp_rs2_pdst                         ,
        i_alloc_s3_pdst     : fp_rs3_pdst                         ,
        i_alloc_has_s1      : dec_op.fp_rs1_is_fp                 ,
        i_alloc_has_s2      : dec_op.fp_rs2_is_fp                 ,
        i_alloc_has_s3      : dec_op.fp_uses_rs3                  ,
        i_alloc_int_pdst    : rs1_pdst                            , // INT source (int→fp)
        i_alloc_has_int     : dec_op.fp_int_src                   ,
        i_alloc_int_ready   : iq_int_fp_query_rdy                 ,
        o_alloc_rdy         : iqf_alloc_rdy                       ,
        i_rename_set_pending: rename_fire && dec_op.fp_writes_fp  ,
        i_rename_pdst       : new_fp_rd_pdst                      ,
        i_fp_cdb_valid      : cdb.valid && cdb_dest_is_fp         ,
        i_fp_cdb_has_rd     : cdb.has_rd                          ,
        i_fp_cdb_pdst       : cdb.pdst                            ,
        i_int_cdb_valid     : cdb.valid && !cdb_dest_is_fp        ,
        i_int_cdb_has_rd    : cdb.has_rd                          ,
        i_int_cdb_pdst      : cdb.pdst                            ,
        // Phase 8 S4a.3: 2nd INT CDB snoop (pipe-1 / lane 1). alu_cdb2 is always
        // integer, so it feeds the int-source wakeup of int→fp ops unfiltered.
        i_int_cdb2_valid    : alu_cdb2.valid                     ,
        i_int_cdb2_has_rd   : alu_cdb2.has_rd                    ,
        i_int_cdb2_pdst     : alu_cdb2.pdst                      ,
        i_fp_query_pdst     : fp_rs2_pdst                         , // M6.B.3: FP-store rs2 readiness
        o_fp_query_rdy      : iqf_fp_query_rdy                    ,
        o_issue_valid       : iqf_issue_valid                    ,
        o_issue_fpu_op      : iqf_iss_fpu_op                     ,
        o_issue_rm          : iqf_iss_rm                         ,
        o_issue_fli_idx     : iqf_iss_fli_idx                    ,

        o_issue_rd_pdst     : iqf_iss_rd_pdst                    ,
        o_issue_rob_idx     : iqf_iss_rob_idx                    ,
        o_issue_has_rd      : iqf_iss_has_rd                     ,
        o_issue_writes_int  : iqf_iss_wr_int                     ,
        o_issue_s1_pdst     : iqf_iss_s1_pdst                    ,
        o_issue_s2_pdst     : iqf_iss_s2_pdst                    ,
        o_issue_s3_pdst     : iqf_iss_s3_pdst                    ,
        o_issue_int_pdst    : iqf_iss_int_pdst                   ,
        i_issue_ack         : iqf_issue_ack                      ,
        i_flush             : redirect_fire                      ,
        // Phase 8 S8.E: early partial squash (flip). Drop iq_fp entries younger
        // than the resolved branch; survivors keep their CDB wakeups.
        i_rob_head_idx      : rob_head_idx                       ,
        i_squash_en         : s8_restore_en                      ,
        i_squash_idx        : s8_restore_idx                     ,
    );

    // S1 (Phase-14): FROUND_PIPE / FMA_PIPE3 are DECOUPLED from EX_PIPE (held 0).
    // They were CP-only FP micro-stagings (3-stage Zfa FROUND / 3-stage double FMA)
    // added purely to patch synth-CP fronts that surface under EX_PIPE=1 (the
    // fround-add 13.86 / FMA s1_sum_mag fronts, deep_pipeline_status_and_replan.md).
    // Phase-14 is a STRUCTURAL mandate (not CP), so those fronts are out of scope.
    // More importantly FROUND_PIPE=1 carries a latent correctness bug the grown arch
    // suite now exposes (test_arch_zfa_s2: fround with STATIC rounding modes returns
    // the rne result for every mode, and froundnx drops the NX flag — the 3-stage
    // rint add applies the wrong rounding mode and the held-at-head op's metadata /
    // fflags are read live one cycle after the op has released; ACT4's single
    // dynamic-rm fround never exercised it). EX_PIPE=1 with the FPU at its committed
    // 2-stage FROUND/FMA (FROUND_PIPE=FMA_PIPE3=0) is correct (zfa 4/4). At EX_PIPE=0
    // this is byte-identical to the old `: EX_PIPE` coupling (both 0). TODO(FP-CP):
    // fix the FROUND_PIPE=1 rint-add rounding-mode / held-metadata bug, then re-couple
    // if the EX_PIPE=1 synth-CP fround front is worth cutting.
    inst u_fpu: fpu_wrap #(
        PIPE       : 1,
        FROUND_PIPE: 0,
        FMA_PIPE3  : 0,
    ) (
        clk                                ,
        rst                                ,
        i_issue_valid     : iqf_issue_valid,
        i_fpu_op          : iqf_iss_fpu_op ,
        i_fp_rm           : iqf_iss_rm     ,
        i_fli_idx         : iqf_iss_fli_idx,
        i_frm             : csr_frm        ,
        i_issue_rd_pdst   : iqf_iss_rd_pdst,
        i_issue_rob_idx   : iqf_iss_rob_idx,
        i_issue_has_rd    : iqf_iss_has_rd ,
        i_issue_writes_int: iqf_iss_wr_int ,
        i_s1_data         : prf_fp_rs1_data,
        i_s2_data         : prf_fp_rs2_data,
        i_s3_data         : prf_fp_rs3_data,
        i_int_rs1_data    : prf_int_rs3_data,
        i_flush           : redirect_fire  ,
        o_fpu_busy        : fpu_busy       ,
        o_cdb             : fpu_cdb        ,
        o_fflags          : fpu_fflags     ,
        o_fflags_wen      : fpu_fflags_wen ,
        o_dest_is_fp      : fpu_dest_is_fp ,
    );

    // ============================================================
    // IQ
    // ============================================================
    inst u_iq: iq_int (
        clk                                               ,
        rst                                               ,
        i_alloc_en          : rename_fire && !dec_op.is_fpu_op && !dec_op.is_vec,
        i_alloc_op          : ren_op                      ,
        o_alloc_rdy         : iq_alloc_rdy                ,
        // Phase 8 S2: slot-1 alloc (integer-only; gated off via rename_fire2=0
        // until S4). Phase 8 S4b: o_alloc_rdy2 now gates rename_fire2.
        i_alloc_en2         : rename_fire2                ,
        i_alloc_op2         : ren_op2                     ,
        o_alloc_rdy2        : iq_alloc_rdy2               ,
        // M6: clear int prf-ready only on an INT dest rename (has_rd covers
        // int ops + FP→INT). FP-dest renames clear the FP bitmap in iq_fp.
        i_rename_set_pending: rename_fire && dec_op.has_rd,
        i_rename_pdst       : new_rd_pdst                 ,
        // Phase 8 S2: slot-1 rename clear (int dest), gated off until S4.
        i_rename_set_pending2: rename_fire2 && dec_op2_has_rd,
        i_rename_pdst2       : new_rd_pdst2               ,
        i_cdb_valid         : cdb.valid                   ,
        i_cdb_has_rd        : cdb.has_rd && !cdb_dest_is_fp,
        i_cdb_pdst          : cdb.pdst                    ,
        // Phase 8 S3: 2nd int CDB snoop (pipe-1 lane). Silent in S3.a.
        i_cdb2_valid        : alu_cdb2.valid              ,
        i_cdb2_has_rd       : alu_cdb2.has_rd             ,
        i_cdb2_pdst         : alu_cdb2.pdst               ,
        i_fp_int_query_pdst : rs1_pdst                    , // M6: iq_fp int-source ready
        o_fp_int_query_rdy  : iq_int_fp_query_rdy         ,
        // M6.B.3: FP CDB snoop + FP-store rs2 initial readiness (from iq_fp).
        i_fp_cdb_valid      : cdb.valid && cdb_dest_is_fp ,
        i_fp_cdb_has_rd     : cdb.has_rd                  ,
        i_fp_cdb_pdst       : cdb.pdst                    ,
        i_alloc_rs2_fp_ready: iqf_fp_query_rdy            ,
        o_issue_valid       : iq_issue_valid              ,
        o_issue_op          : iq_issue_op                 ,
        o_issue_rs1_pdst    : iq_iss_rs1_pdst             ,
        o_issue_rs2_pdst    : iq_iss_rs2_pdst             ,
        o_issue_rd_pdst     : iq_iss_rd_pdst              ,
        o_issue_rd_old_pdst : iq_iss_rd_old_pdst          , // Zacas: amocas compare value pdst
        o_issue_rob_idx     : iq_iss_rob_idx              ,
        o_issue_is_load     : iq_iss_is_load              ,
        o_issue_is_amo      : iq_iss_is_amo               ,
        o_issue_amo_funct5  : iq_iss_amo_funct5           ,
        o_issue_is_cas_q    : iq_iss_is_cas_q            , // Zacas amocas.q

        o_issue_is_csr      : iq_iss_is_csr               ,
        o_issue_csr_addr    : iq_iss_csr_addr             ,
        o_issue_csr_op      : iq_iss_csr_op               ,
        o_issue_csr_imm     : iq_iss_csr_imm              ,
        o_issue_rs1_arch    : iq_iss_rs1_arch             ,
        o_issue_fp_ld       : iq_iss_fp_ld               , // M6.B.3
        o_issue_fp_st       : iq_iss_fp_st               ,
        i_issue_ack         : iq_issue_ack                ,
        i_fr_drain_ack      : iq_fr_drain_ack             , // A2 piece 1 (§11.6): dcache-free FR-drain ack
        // Phase 8 S3.b: 2nd issue port (pipe-1). ack2 == valid2 (pipe-1 has no
        // back-pressure), so an op that the IQ presents on slot-1 always leaves.
        o_issue_valid2      : iq_issue_valid2             ,
        o_issue_op2         : iq_issue_op2                ,
        o_issue_rs1_pdst2   : iq_iss_rs1_pdst2            ,
        o_issue_rs2_pdst2   : iq_iss_rs2_pdst2            ,
        o_issue_rd_pdst2    : iq_iss_rd_pdst2             ,
        o_issue_rob_idx2    : iq_iss_rob_idx2             ,
        o_issue_is_load2    : iq_iss_is_load2            , // Phase 8 S5.2
        i_issue_ack2        : issue2_fire                 ,
        i_flush             : redirect_fire               ,
        // Phase 8 S5.1 age-relative store-to-load gate (was global i_block_loads).
        i_block_store_exists: rob_block_store_exists      ,
        i_block_store_age   : rob_block_store_age         ,
        i_block_mem_xlate   : rob_has_pending_xlate       , // M9.A.298 xlate barrier
        i_rob_head_idx      : rob_head_idx                ,
        // Phase 8 S8.E: early partial squash (flip). Drop iq_int entries younger
        // than the resolved branch (age via the shared S4c head-relative metric).
        i_squash_en         : s8_restore_en               ,
        i_squash_idx        : s8_restore_idx              ,
    );

    // ============================================================
    // Phase 12 V0: Vector unit + vector register file
    // ============================================================
    inst u_vrf: vrf #(
        VRF_N: vector_pkg::VRF_N,
        VRF_W: vector_pkg::VRF_W,
        VLEN : vector_pkg::VLEN ,
    ) (
        clk                    ,
        rst                    ,
        i_rd1_addr: vu_vs1_addr,
        o_rd1_data: vu_vs1_data,
        i_rd2_addr: vu_vs2_addr,
        o_rd2_data: vu_vs2_data,
        i_rd3_addr: vu_mask_addr,
        o_rd3_data: vu_mask_data,
        i_rd4_addr: vu_vdold_addr,
        o_rd4_data: vu_vdold_data,
        i_wr_en   : vu_vd_wen  ,
        i_wr_addr : vu_vd_addr ,
        i_wr_data : vu_vd_data ,
    );
    inst u_vu: vector_unit #(
        VRF_W    : vector_pkg::VRF_W,
        VLEN     : vector_pkg::VLEN ,
        PRF_W    : PRF_INT_W        ,
        ROB_IDX_W: ROB_IDX_W        ,
        MEM_PIPE : MEM_PIPE         , // CP M2: VU mem 2-cycle handshake, in sync with the core M-stage
    ) (
        clk                                                                  ,
        rst                                                                  ,
        // Dispatch (in-order push from rename; gated on a non-illegal vec op).
        i_alloc_en          : rename_fire && dec_op.is_vec && !dec_op.illegal,
        i_alloc_vec_op      : dec_op.vec_op                                  ,
        i_alloc_instr       : dec_op.instr                                   ,
        i_alloc_vd          : dec_op.rd_arch                                 ,
        i_alloc_vs1         : dec_op.rs1_arch                                ,
        i_alloc_vs2         : dec_op.rs2_arch                                ,
        i_alloc_uses_scalar : dec_op.vec_uses_scalar                        ,
        i_alloc_scalar_pdst : rs1_pdst                                      ,
        i_alloc_scalar_ready: iq_int_fp_query_rdy                           , // rs1 readiness
        i_alloc_fscalar_pdst: fp_rs1_pdst                                   , // V3b .vf FP scalar (f[rs1])
        i_alloc_scalar2_pdst: rs2_pdst                                      , // V5h strided stride (x[rs2])
        i_alloc_has_rd      : dec_op.has_rd || dec_op.fp_writes_fp          , // scalar rd: int (vmv.x.s/vset) or FP (vfmv.f.s)
        i_alloc_rd_is_fp    : dec_op.fp_writes_fp                           , // vfmv.f.s → FP dest
        i_alloc_rd_pdst     : ren_rd_pdst                                   , // FP pdst when fp_writes_fp, else int pdst
        i_alloc_rob_idx     : rob_alloc_idx                                 ,
        o_alloc_rdy         : vu_alloc_rdy                                  ,
        // Int CDB snoop (merged lane 0 + pipe-1) — wakes the scalar operand.
        i_cdb_int_valid     : cdb.valid && !cdb_dest_is_fp && cdb.has_rd     ,
        i_cdb_int_pdst      : cdb.pdst                                      ,
        i_cdb2_valid        : alu_cdb2.valid                                ,
        i_cdb2_has_rd       : alu_cdb2.has_rd                               ,
        i_cdb2_pdst         : alu_cdb2.pdst                                 ,
        // Non-speculative execution gate (FIFO head must be the ROB head).
        i_rob_head_idx      : rob_head_idx                                  ,
        // Int PRF scalar read (combinational at execute).
        o_scalar_pdst       : vu_scalar_pdst                                ,
        i_scalar_data       : vu_scalar_data                               ,
        // FP PRF scalar read (V3b .vf ops).
        o_fscalar_pdst      : vu_fscalar_pdst                              ,
        i_fscalar_data      : vu_fscalar_data                             ,
        o_scalar2_pdst      : vu_scalar2_pdst                             , // V5h strided stride
        i_scalar2_data      : vu_scalar2_data                             ,
        // VRF interface.
        o_vs1_addr          : vu_vs1_addr                                   ,
        i_vs1_data          : vu_vs1_data                                  ,
        o_vs2_addr          : vu_vs2_addr                                   ,
        i_vs2_data          : vu_vs2_data                                  ,
        o_mask_addr         : vu_mask_addr                                  ,
        i_mask_data         : vu_mask_data                                 ,
        o_vdold_addr        : vu_vdold_addr                                 ,
        i_vdold_data        : vu_vdold_data                                 ,
        o_vd_addr           : vu_vd_addr                                    ,
        o_vd_wen            : vu_vd_wen                                    ,
        o_vd_data           : vu_vd_data                                   ,
        // CDB writeback (lowest priority — only when the scalar pipe is idle).
        i_cdb_free          : vu_cdb_free                                   ,
        o_cdb_valid         : vu_cdb_valid                                  ,
        o_cdb_has_rd        : vu_cdb_has_rd                                 ,
        o_cdb_pdst          : vu_cdb_pdst                                   ,
        o_cdb_data          : vu_cdb_data                                   ,
        o_cdb_rob_idx       : vu_cdb_rob_idx                                ,
        o_cdb_vset_wen      : vu_cdb_vset_wen                               ,
        o_cdb_vtype         : vu_cdb_vtype                                  ,
        o_cdb_vl            : vu_cdb_vl                                     ,
        // V1 unit-stride memory port.
        o_mem_port_req      : vu_mem_port_req                               ,
        o_mem_active        : vu_mem_active                                 ,
        o_mem_vaddr         : vu_mem_vaddr                                  ,
        o_mem_is_load       : vu_mem_is_load                               ,
        o_mem_is_store      : vu_mem_is_store                             ,
        o_mem_funct3        : vu_mem_funct3                                ,
        o_mem_wdata         : vu_mem_wdata                                 ,
        o_mem_wstrb         : vu_mem_wstrb                                 ,
        i_mem_idle          : vu_mem_idle                                  ,
        i_mem_ready         : vu_mem_ready                                 ,
        i_mem_rdata         : dcache_rdata                                 ,
        i_mem_fault         : vu_mem_fault                                 ,
        i_mem_fault_st      : vu_mem_fault_st                              ,
        i_csr_vstart        : csr_vstart                                   ,
        o_cdb_is_lfault     : vu_cdb_is_lfault                            ,
        o_cdb_is_sfault     : vu_cdb_is_sfault                            ,
        o_cdb_fault_vaddr   : vu_cdb_fault_vaddr                          ,
        o_cdb_vstart_wen    : vu_cdb_vstart_wen                           ,
        o_cdb_vstart        : vu_cdb_vstart                               ,
        o_cdb_vstore        : vu_cdb_vstore                               ,
        // V3 vector FP: rounding mode in (fcsr.frm), accrued fflags out.
        i_frm               : csr_frm                                       ,
        // V5b fixed-point rounding mode (vxrm) for averaging / scaling / clip.
        i_vxrm              : csr_vxrm                                       ,
        o_cdb_fflags        : vu_cdb_fflags                                ,
        o_cdb_fflags_wen    : vu_cdb_fflags_wen                            ,
        // V5a fixed-point saturation accrual (OR'd into vxsat at commit).
        o_cdb_vxsat         : vu_cdb_vxsat                                 ,
        o_cdb_vxsat_wen     : vu_cdb_vxsat_wen                             ,
        o_cdb_fp_dest       : vu_cdb_fp_dest                               ,
        // Architectural vtype/vl restore on flush.
        i_csr_vtype         : csr_vtype                                     ,
        i_csr_vl            : csr_vl                                        ,
        i_flush             : redirect_fire                                 ,
        i_squash_en         : s8_restore_en                                 ,
        i_squash_idx        : s8_restore_idx                                ,
    );

    // ---- VU memory-port arbitration signals (V1) ----------------------------
    // The VU owns the dmem port (highest priority) while a vle/vse streams. The
    // gating signals (vu_mem_idle / vu_mem_ready / vu_mem_fault*) are assigned
    // below, after the dmem_mmu + dcache outputs they depend on are defined; the
    // vars are declared up with the other vu_* state so the VU instance above
    // can reference them.

    // ============================================================
    // ROB
    // ============================================================
    var rob_commit_valid: logic              ;
    var rob_commit_entry: RobEntry           ;
    var rob_commit_idx  : logic   <ROB_IDX_W>;
    // rob_size declared early (near stall_dr) for the S4b rename_fire2 gate.

    // Per-field commit signals (sim-bug workaround for cross-module
    // struct-port; mirror of rob_commit_entry.X).
    var c_pc          : logic<64>       ;
    var c_instr       : logic<32>       ; // head instruction encoding (illegal-instr mtval)
    var c_rd_arch     : logic<5>        ;
    var c_rd_pdst     : logic<PRF_INT_W>;
    var c_old_rd_pdst : logic<PRF_INT_W>;
    // Phase 8 S1: 2-wide commit slot-1 (head+1, simple integer ops only).
    var c2_valid      : logic           ;
    var c2_pc         : logic<64>       ;
    var c2_rd_arch    : logic<5>        ;
    var c2_rd_pdst    : logic<PRF_INT_W>;
    var c2_old_rd_pdst: logic<PRF_INT_W>;
    var c2_has_rd     : logic           ;
    var c2_result_data: logic<64>       ;
    var c2_is_rvc     : logic           ;
    // The COMMITTED architectural next PC — the PC the hart would execute next if
    // it stopped here. Declared up with the other commit-stage signals so the csr
    // instance can take it as an interrupt's epc; maintained next to
    // c_arch_next_pc below, where its rationale is documented.
    var arch_next_pc_q: logic<64>       ;
    var c_has_rd      : logic           ;
    var c_illegal     : logic           ;
    var c_redirect_pc : logic<64>       ;
    // Phase 8 M1: carried fields for the commit-time mispredict decision.
    var c_pred_next_pc: logic<64>       ;
    var c_early_fix   : logic           ; // S22: op was early-redirected at execute
    var c_is_rvc      : logic           ;
    var c_is_control  : logic           ;
    var c_is_cond     : logic           ; // M2: conditional branch (BHT train)
    var c_is_call     : logic           ; // M3: call (RAS push + BTB kind)
    var c_is_ret      : logic           ; // M3: return (RAS pop + BTB kind)
    var c_pred_index  : logic<13>       ; // M4: carried gshare BHT index
    var c_ghr_fold    : logic           ; // S22: instance folded spec_ghr_l at fetch
    var c_result_data : logic<64>       ;
    var c_is_store    : logic           ;
    var c_is_amo      : logic           ; // Phase 8 S6: head is AMO/LR/SC (vs plain store)
    var c_is_cas_q    : logic           ; // Zacas amocas.q: head is a 128-bit pair CAS
    var c_cas_q_mem_lo: logic<64>       ; // loaded old low dword (→ rd)
    var c_cas_q_mem_hi: logic<64>       ; // loaded old high dword (→ rd+1)
    var c_rdh_pdst    : logic<PRF_INT_W>; // old pdst of rd+1 (in-place write target)
    var c_is_mem_virt : logic           ; // Phase 11-H HLV/HSV: committing head is a 2-stage access
    var c_store_addr  : logic<64>       ;
    var c_store_data  : logic<64>       ;
    var c_store_funct3: logic<3>        ;
    // CP commit-store pre-translate (P3): head store's pre-translated PA/fault/valid.
    var c_store_pa      : logic<64>     ;
    var c_store_xfault  : logic         ;
    var c_store_pa_valid: logic         ;
    var c_is_csr      : logic           ;
    var c_csr_addr    : logic<12>       ;
    var c_csr_wdata   : logic<64>       ;
    var c_is_ecall    : logic           ;
    var c_is_ebreak   : logic           ;
    var c_is_mret     : logic           ;
    var c_is_sret     : logic           ;
    var c_is_sfence   : logic           ;
    var c_is_svinval_fence: logic       ; // Svinval fence at head (U-mode illegal)
    var c_sfence_rs1  : logic<5>        ; // P9.5: SFENCE.VMA rs1 (VA reg) at head
    var c_sfence_rs2  : logic<5>        ; // P9.5: SFENCE.VMA rs2 (ASID reg) at head
    var c_is_fence_i  : logic           ; // M8.A FENCE.I → icache flush
    var c_is_fence    : logic           ; // P9.0: plain FENCE (drain-wait gate)
    var c_is_cbo_zero : logic           ; // P10 Zicboz cbo.zero at commit
    var c_is_cbo_m    : logic           ; // P10 Zicbom cbo.clean/flush/inval at commit
    var c_is_ifault   : logic           ;
    var c_is_lfault   : logic           ;
    var c_is_sfault   : logic           ;
    var c_fault_acc   : logic           ; // PMP: committing fault is an access fault
    var c_fault_vaddr : logic<64>       ;
    // Phase 11-H3c: committing load fault's G-stage flag + faulting guest PA.
    var c_fault_gstage: logic           ;
    var c_fault_gpa   : logic<64>       ;
    // M9.3 inject-linkage probe (debug): head entry's recorded walk-start PC
    // and inject-delivered flag.
    var commit_dbg_walk_pc: logic<64>   ;
    var commit_dbg_inj    : logic       ;
    // M6: FP commit
    var c_is_fp_dest  : logic           ;
    var c_is_fp       : logic           ;
    var c_fflags      : logic<5>        ;
    var c_fflags_wen  : logic           ;
    // Phase 12 V5a: committing saturating op's vxsat bit (OR'd into vxsat CSR).
    var c_vxsat       : logic           ;
    // Phase 12 V0: vector commit drain (VS-disabled trap + vset*vl config update).
    var c_is_vec      : logic           ;
    var c_vset_wen    : logic           ;
    var c_vtype       : logic<64>       ;
    var c_vl          : logic<64>       ;
    // Phase 12 V1: committing vector mem op vstart write + vector-store redirect.
    var c_vstart_wen  : logic           ;
    var c_vstart      : logic<64>       ;
    var c_vstore      : logic           ;
    // Phase 8 S9: the head load was poisoned (memory-order violation) → replay.
    var c_load_poison : logic           ;

    // M9.A.255: gate ROB commit_ack on dmem_mmu_busy when committing a
    // store. commit_store_fire is a single-cycle pulse derived from
    // rob_commit_valid; if dmem_mmu starts a TLB-miss PT walk on this
    // pulse, the walk takes multiple cycles. Without this gate, the
    // pulse drops before the walk completes, dmem_mmu's o_dmem_wen
    // remains 0 (gated on ptw_valid), and the store is silently
    // dropped. Manifested as the 2nd __set_fixmap call's `sd a2, 0(a4)`
    // (PC 0x80003e0e) populating entry 510 of fixmap_pte never reaching
    // dmem — vmemmap later loads via that PT entry and faults forever.
    // Pre-condition: SFENCE.VMA between the two __set_fixmap calls
    // wipes the entire TLB (v4 mmu flushes on any sfence regardless of
    // rs1), forcing a walk on the 2nd call's store.
    // M8.B / M9 SMP: also hold a committing STORE while the dcache stalls. A
    // write hit is single-cycle (dcache_stall=0), but if the dcache is mid-FILL
    // for a younger load (write_during_fill) OR still waiting for the bus grant
    // on the write-through (write_wait_grant), the store's write-through would be
    // lost — hold commit_store_fire/pop until dcache_stall drops and the write
    // lands. This subsumes the old M9.1 `!(c_is_store && !i_dmem_grant)` gate:
    // the dcache (not the core) now owns bus back-pressure (see dmem_issue note).
    // Phase 8 S6: a fast (bare aligned plain) store does NOT use the i_wen path,
    // so its retire is gated on the store-drain ack (dc_sdrain_ack = it wrote the
    // dcache this cycle) instead of dcache_stall/dmem_mmu_busy. The dmem_mmu_busy
    // / dcache_stall gates apply only to NON-fast stores (AMO/Sv39/misaligned on
    // the i_wen path). A waiting fast store does not raise dcache_stall, so a load
    // read is never blocked by it.
    // Phase 8 S9: a poisoned LOAD at the head is REPLAYED (re-executed), not
    // retired. It must NOT architecturally commit — committing its stale rd would
    // corrupt any register the re-execution depends on (e.g. a `lb t1,0(t1)` whose
    // base == dest: writing the stale value into t1 destroys the base, so the
    // re-fetch computes a garbage address). Suppressing rob_commit_ack gates every
    // commit-time mutation (arch_regs / rat_commit / free-list push / head
    // advance / retire), leaving the load to be re-fetched fresh by the replay
    // redirect with the pre-load register state intact (the redirect's RAT/
    // free-list recovery rolls back the load's rename).
    let commit_load_replay: logic = rob_commit_valid && c_load_poison;
    // P9.3/SMP: a poisoned in-cache AMO at the head REPLAYS (re-fetched from its
    // own PC, see the commit-redirect priority chain) instead of retiring. Like
    // the poisoned LOAD above it must NOT architecturally commit: a real AMO with
    // rd == rs1 (e.g. the kernel's `amoadd a5,s7,(a5)` in multi_cpu_stop) would
    // write its result into the base register and free the base's pdst on commit,
    // so the replay re-fetch then computes its address from the destroyed base —
    // observed under 7.1 N>=2 as a NULL deref at VA == the captured AMO result
    // (the old thread_ack value). Suppressing rob_commit_ack leaves the pre-AMO
    // register state intact for the replay (the redirect rolls back its rename).
    // amo_watch_valid_q / amo_watch_rob_q / amo_poison_q are forward-declared vars
    // (the equivalent `amo_at_head && amo_poison_q` let is defined later).
    let commit_amo_replay: logic = amo_watch_valid_q && rob_commit_valid
        && rob_commit_idx == amo_watch_rob_q && amo_poison_q;
    // S15: the slow-store retire must also wait out an in-flight LOAD walk
    // (walk_v_q && !walk_is_store_q == load_walk_busy, declared later). The
    // M9.A.303 gate suppresses store_drive for the whole load walk, but
    // dmem_mmu_busy drops one cycle BEFORE walk_v_q clears (the walk's DONE
    // cycle): in that window the old ack condition fired and the store retired
    // WITHOUT EVER DRIVING ITS WRITE — a committed store silently lost. Only
    // reachable once S15 lets a speculative load start a PTW while an older
    // store is committing (pre-S15 VM blocked every load behind every store).
    // Phase 8 S20: stores split three ways at retire.
    //  - sb_elig (aligned plain DRAM store, translation ready): retires the
    //    moment the store buffer has room (sb_push fires the same cycle) —
    //    no dcache_stall / bus-grant wait.
    //  - slow store (!sb_elig: AMO/SC, misaligned, MMIO, VM TLB-miss): the
    //    pre-S20 gates, PLUS !sb_empty — its i_wen write must not reach the
    //    bus before the OLDER buffered stores drain (write-order inversion).
    //  - serializing ops also wait for the buffer to drain: FENCE orders our
    //    stores for other harts, FENCE.I against our own re-fetch,
    //    SFENCE/satp against the page-table walker.
    // S20.2: ONLY those — the original "all CSR/MRET/SRET" superset made
    // every interrupt-path CSR op at N=4 pay a contention-bound drain wait
    // (part of the boot +13%); plain CSRs have no store-ordering semantics.
    // P9.0 FIX: read the DEDICATED shadow-sourced commit outputs, NOT
    // rob_commit_entry fields — is_fence/is_fence_i/is_sfence/is_csr were
    // never assembled into o_commit_entry (constant 0), so this whole
    // serializing drain-wait was dead: a FENCE retired with its older stores
    // still in the store buffer, and the post-fence load read the world
    // before they were globally visible (the litmus SB+fence (0,0) outcome).
    let c_serial: logic = c_is_fence || c_is_fence_i || c_is_sfence || (c_is_csr && c_csr_addr == 12'h180);
    // P9.2 (write-back D$): FENCE.I / SFENCE.VMA / satp writes additionally
    // FLUSH the dcache (write back + invalidate every dirty line) before
    // retiring — instruction fetch and the I-PTW read DRAM directly (tb
    // ports), so dirty data must reach it at these architectural sync
    // points. Plain FENCE needs no flush: store visibility between harts is
    // carried by the coherence protocol itself. The sweep starts once the
    // store buffer has drained (its drains create dirty lines) and the
    // retire ack below waits for dc_flush_done.
    let c_flush_op: logic = rob_commit_valid && (c_is_fence_i || c_is_sfence || (c_is_csr && c_csr_addr == 12'h180));
    // P9.6 phase 3: with a coherent instruction side the sweep is gone — the
    // I-cache i_flush + the coherent (recall-on-owned) refill make stores visible
    // to fetch on demand. The serializing op still waits for the store buffer to
    // drain (c_serial && sb_empty below), so the stores are merged into the
    // D-cache before the I-cache refill recalls them.
    assign dc_flush_req = c_flush_op && sb_empty_eff && (COHERENT_IFETCH == 0);
    // S20R: an MMIO (non-DRAM) store is a DOORBELL — firmware writes a DRAM
    // mailbox then rings CLINT msip with no fence between (legal on the old
    // never-reordering pipeline). If the doorbell passes the buffered
    // mailbox store, the woken hart reads a stale mailbox and parks forever
    // (the N=2 wedge: hart1 stuck in the FW wait loop, trap1=0). Treat every
    // MMIO store like an AMO release: wait for the buffer to fully drain.
    var c_store_mmio: logic; // assigned at the store-buffer block (needs dmu_dmem_addr)
    // The slow-store order gate is OVERLAP-only for plain stores (RVWMO lets
    // different-address stores become visible out of order without a fence);
    // an AMO/SC keeps the full-empty wait (release semantics: all prior
    // stores must be visible before it).
    // ── R3.1 §6.2: the atomic-without-return class ──────────────────────────────
    // An AMO whose rd is x0 discards the old value, so nothing architectural depends
    // on the execute-time read: it may retire into the atomic-SQ and have its RMW
    // performed later at the memory system (§6.2). Everything else must NOT — retire
    // is rd's architectural commit and there is no replay after it. Excluded by
    // funct5: LR (00010, never store_drives anyway), SC (00011, rd = success code),
    // amocas (00101, needs the compare result); excluded by flag: amocas.q, MMIO /
    // uncacheable (!ac_wexcl_q — a write-through cannot be an owned-line RMW) and a
    // faulting atomic (!ac_wok_q, so a fault can never surface at drain time).
    // asq_takeover is the retire-gate arm: the class does not wait out the in-cache
    // write's conditions because it is not doing that write. All const-gated → at
    // ATOMIC_SQ=0 asq_class is constant 0 and every gate below folds to today's.
    let asq_amo_f5  : logic<5> = c_instr[31:27];
    let asq_class   : logic    = ATOMIC_SQ && c_is_amo && !c_is_cas_q && c_rd_arch == 5'd0
        && asq_amo_f5 != 5'b00010 && asq_amo_f5 != 5'b00011 && asq_amo_f5 != 5'b00101
        && ac_wexcl_q && ac_wok_q;
    // The retire relaxation must mirror asq_alloc's conditions (it is asq_alloc minus
    // amo_commit_live, which is defined further down and is implied here anyway): relax
    // ONLY when the entry will actually be booked. If it cannot be, the atomic performs
    // its in-cache write and retires exactly as today — which is why there is no longer
    // any "class atomic stuck with nowhere to write" case to stall for.
    let asq_takeover: logic    = asq_class && !asq_full && sb_empty_eff;
    let rob_commit_ack: logic = rob_commit_valid && !commit_load_replay && !commit_amo_replay
        && !(c_is_store && !sb_elig && (dmem_mmu_busy || (walk_v_q && !walk_is_store_q)))
        // CP M3a: a slow store's dcache write happens the cycle AFTER it translates
        // (the M-stage latches the PA), so hold retire for the translate cycle. CP
        // M3b: AMO/SC commits write LIVE (amo_commit_live) and retire single-cycle, so
        // they are excluded (!c_is_amo) from this translate-cycle hold.
        && !(MEM_PIPE && c_is_store && !sb_elig && !c_is_amo && !store_fetched_q)
        // R3.1: a class atomic (asq_takeover) retires into the atomic-SQ instead of
        // performing the in-cache write, so it does not wait out that write's
        // conditions — the dcache stall and the sb_empty release-order wait belong to
        // the DRAIN, which is ordered behind the store buffer anyway (§6.4). Folds to
        // today's term at ATOMIC_SQ=0.
        && !(c_is_store && !sb_elig && ((dcache_stall && !asq_takeover) || (if c_is_amo || c_store_mmio ? !sb_empty_eff : sb_st_ovl)))
        // R3 §7.2: and no store retires while an atomic is still queued.
        && !(c_is_store && asq_st_block)
        && !(c_is_store && sb_elig && sb_full && !sb_merge_ok)
        // R3.1 §6.4: a FENCE must not complete ahead of a queued atomic's write.
        // asq_empty is constant 1 at ATOMIC_SQ=0 → the term folds to !sb_empty.
        && !(c_serial && !(sb_empty_eff && asq_empty))
        && !(c_flush_op && !dc_flush_done && (COHERENT_IFETCH == 0)); // P9.2 sweep (P9.6: gone when coherent)
    // Zacas amocas.q retires when the entry actually leaves the ROB (rob_commit_ack
    // already waits for the store to drain + excludes replays). At retire it writes
    // the loaded old 128-bit value into the rd:rd+1 pair (in place, via prf write
    // ports 3/4 + arch_regs) and triggers a full flush so re-fetched readers of the
    // un-renamed pair observe the new values.
    let cas_q_retire: logic = rob_commit_ack && c_is_cas_q;
    // Drive the prf commit-write ports (forward-declared near the prf instance).
    // amocas.q with rd=x0 discards the WHOLE loaded pair (x0 AND x1 are left
    // unchanged — the standard rd=x0 "discard result" rule applied to the pair),
    // so both halves are gated on rd!=x0. The compare still uses {x1, x0}={x1, 0}.
    always_comb {
        cas_q_wb_lo_en   = cas_q_retire && c_rd_arch != 5'd0;
        cas_q_wb_lo_pdst = c_old_rd_pdst;
        cas_q_wb_lo_data = c_cas_q_mem_lo;
        cas_q_wb_hi_en   = cas_q_retire && c_rd_arch != 5'd0;
        cas_q_wb_hi_pdst = c_rdh_pdst;
        cas_q_wb_hi_data = c_cas_q_mem_hi;
    }
    // Phase 8 S1: 2-wide commit. commit2_fire is a var assigned LATE (after all
    // the slot-0 redirect conditions: trap/mret/sret/satp/mispredict/sc-replay)
    // so it can also require that slot-0 does NOT redirect — otherwise the head+1
    // op is wrong-path (squashed by slot-0's redirect) and must not retire.
    // Declared here (var) so the rob i_commit_ack2 connection and the slot-1
    // commit always_comb may reference it before the assign.
    var commit2_fire: logic;

    var rob_head_valid  : logic    ;
    var rob_head_rw     : logic    ;
    var rob_head_illegal: logic    ;
    var rob_alloc_cnt_w   : logic<32>;
    var rob_cdb_cnt_w     : logic<32>;
    var rob_commit_cnt_w  : logic<32>;
    var rob_head_w        : logic<6> ;
    var rob_tail_w        : logic<6> ;
    var rob_load_viol_cnt_w: logic<32>; // Phase 8 S9: memory-order violation events
    var rob_inv_viol_cnt_w : logic<32>; // L3 census: P9.0 CoRR poison events
    var rob_mshr_pois_cnt_w: logic<32>; // L3 census: S10.3 aborted-fill poison events
    var rob_viol_exact_cnt_w: logic<32>; // L3 census: exact-compare-confirmed violations
    var rob_viol_pgx_cnt_w  : logic<32>; // L3 census: page-cross-blanket violations
    var rob_st_resolve_cnt_w: logic<32>; // L3 census: store resolves
    var rob_viol_store_cnt_w: logic<32>; // L3 census: store-resolve scan events
    var rob_viol_self_cnt_w : logic<32>; // L3 census: S15 self-scan events
    // Phase 14 L3.2a: the ROB's executed-load record set + the load queue's
    // equivalence counters (declared here: a var driven by an inst output port
    // must be defined before the instantiation).
    var rob_lq_rec_set   : logic [32];
    var rob_lq_pois_set  : logic [32];
    var rob_store_known  : logic [32];
    var rob_store_pa     : logic<64>[32];
    var rob_store_pa_v   : logic [32];
    var lq_dbg_alloc_cnt : logic<32>;
    var lq_dbg_orphan_cnt: logic<32>;
    var lq_dbg_mism_cnt  : logic<32>;
    var lq_dbg_full_cnt  : logic<32>;
    var lq_dbg_asq_cnt   : logic<32>;
    var lq_dbg_occ_max   : logic<32>;
    var lq_dbg_pmism_cnt : logic<32>;
    var lq_dbg_rec_cnt     : logic<32>;
    var lq_dbg_pa_rec_cnt  : logic<32>;
    var lq_dbg_exact_cnt   : logic<32>;
    var lq_dbg_saved_cnt   : logic<32>;
    var lq_dbg_invnopa_cnt : logic<32>;
    var lq_self_fire       : logic    ; // M1: a self-scan poison fired this cycle
    var lq_self_nopa       : logic    ; // M1: ...decided by the approximation, not a PA pair
    var lq_self_pamis      : logic    ; // M1: ...decided PA-to-PA with a load PA that is not the load's
    var lq_self_spamis     : logic    ; // M1: ...decided PA-to-PA with a store PA that is not the store's
    var lq_p1_exempt       : logic    ; // M2a: port 1 suppressed a poison this cycle
    var lq_p1_nomask       : logic    ; // M2a: ...with an empty mask, asked inside the LQ
    var lq_self_p0         : logic    ; // M2: self-scan fired on port 0 (Stage-B record)
    var lq_self_p2         : logic    ; // M2: self-scan fired on port 2 (MSHR fill)
    var lq_poison_head   : logic    ;
    var lq_poison_head1  : logic    ;

    inst u_rob: rob #(
        // Phase 14 L3.2c: one source of truth for the flip — the same value goes
        // to the load_queue below, so the ROB's commit gate and the queue that
        // answers it can never be built against different settings.
        LQ_REAL: LQ_REAL,
    ) (
        clk                                         ,
        rst                                         ,
        i_alloc_en           : rename_fire          ,
        i_alloc_entry        : rob_alloc_entry      ,
        o_alloc_idx          : rob_alloc_idx        ,
        o_full               : rob_full             ,
        // Phase 8 S4b: slot-1 alloc port (gated by rename_fire2; dead until
        // S4b.2). i_alloc_entry2 is now the real 2nd-decode entry. o_alloc_idx2
        // feeds ren_op2.rob_idx.
        i_alloc_en2          : rename_fire2         ,
        i_alloc_entry2       : rob_alloc_entry2     ,
        o_alloc_idx2         : rob_alloc_idx2       ,
        i_cdb_valid          : cdb.valid            ,
        i_cdb_rob_idx        : cdb.rob_idx          ,
        i_cdb_result_data    : cdb.data             ,
        i_cdb_mispredict     : cdb.mispredict       ,
        i_cdb_redirect_pc    : cdb.redirect_pc      ,
        i_cdb_is_store       : cdb.is_store         ,
        i_cdb_store_addr     : cdb.store_addr       ,
        i_cdb_store_data     : cdb.store_data       ,
        i_cdb_store_funct3   : cdb.store_funct3     ,
        i_cdb_store_pa       : store_pretx_pa       ,
        i_cdb_store_xfault   : store_pretx_xfault   ,
        i_cdb_store_pa_valid : store_pretx_valid    ,
        // Block L1.b: the translate-retry write port (DEAD at SQ_RETRY=0).
        i_sqrt_valid         : sqrt_cap             ,
        i_sqrt_idx           : sqrt_idx             ,
        i_sqrt_pa            : dmem_sprobe_pa       ,
        i_cdb_cas_q_mem_lo   : cdb.cas_q_mem_lo     , // Zacas amocas.q loaded 128b value
        i_cdb_cas_q_mem_hi   : cdb.cas_q_mem_hi     ,
        i_cdb_is_load        : cdb.is_load          , // Phase 8 S9 LQ record (lane 0)
        i_cdb_is_csr         : cdb.is_csr           ,
        i_cdb_csr_addr       : cdb.csr_addr         ,
        i_cdb_csr_wdata      : cdb.csr_wdata        ,
        i_cdb_csr_illegal    : cdb.csr_illegal      ,
        i_cdb_is_lfault      : rob_cdb_is_lfault    ,
        i_cdb_is_sfault      : cdb.is_sfault        ,
        i_cdb_fault_acc      : cdb.fault_acc        ,
        i_cdb_fault_vaddr    : cdb.fault_vaddr      ,
        // Phase 11-H A2: live MMU gstage/gpa for the CDB fault-delivery path.
        // Phase 1 LSU 2-stage: a plain load delivers its G-stage fault flag + GPA via
        // lsu_cdb at Stage B, when the LIVE dmem_mmu_gstage/gpa no longer reflect it
        // (the MMU moved on). Use the LATCHED LSR values for the lsu_cdb winner; an
        // AMO/store fault (alu_cdb) or a vector load fault (vu_cdb) is single-cycle,
        // so its live MMU gstage/gpa is correct (unchanged).
        i_cdb_fault_gstage   : if lsu_cdb.valid ? lsr_gstage_q : dmem_mmu_gstage,
        i_cdb_fault_gpa      : if lsu_cdb.valid ? lsr_gpa_q : dmem_mmu_gpa,
        // M6 + V3: FP exception flags accrued into fcsr at commit. Keyed by
        // cdb.rob_idx, so the source must follow the lane-0 mux winner. The
        // scalar FPU has highest priority (fpu_fflags_wen ⟹ fpu_cdb.valid ⟹ it
        // wins), and the VU only drives the bus when all higher lanes are idle
        // (vu_cdb_valid), so this picks the FPU's flags when it wrote back and
        // the VU's otherwise. V=0: vu_cdb_fflags_wen=0 → byte-identical.
        i_cdb_fflags         : if fpu_cdb.valid ? fpu_fflags : vu_cdb_fflags,
        i_cdb_fflags_wen     : if fpu_cdb.valid ? fpu_fflags_wen : (vu_cdb_valid && vu_cdb_fflags_wen),
        // Phase 12 V5a: fixed-point saturation accrual (VU-only; it is keyed by
        // cdb.rob_idx, and the VU drives the bus exactly when vu_cdb_valid).
        i_cdb_vxsat          : vu_cdb_vxsat                              ,
        i_cdb_vxsat_wen      : vu_cdb_valid && vu_cdb_vxsat_wen          ,
        // Phase 12 V0: vset*vl new config from the VU (latched at its CDB writeback).
        i_cdb_vset_wen       : vu_cdb_vset_wen      ,
        i_cdb_vtype          : vu_cdb_vtype         ,
        i_cdb_vl             : vu_cdb_vl            ,
        i_cdb_vstart_wen     : vu_cdb_vstart_wen    ,
        i_cdb_vstart         : vu_cdb_vstart        ,
        i_cdb_vstore         : vu_cdb_vstore        ,
        // Phase 8 S3: 2nd CDB writeback (pipe-1 = ALU/branch). Silent in S3.a.
        i_cdb2_valid         : alu_cdb2.valid       ,
        i_cdb2_rob_idx       : alu_cdb2.rob_idx     ,
        i_cdb2_result_data   : alu_cdb2.data        ,
        i_cdb2_mispredict    : alu_cdb2.mispredict  ,
        i_cdb2_redirect_pc   : alu_cdb2.redirect_pc ,
        // Phase 8 S9 LQ record (lane 1 = S5.2 bare-mode slot-1 load).
        i_cdb2_is_load       : alu_cdb2.is_load     ,
        i_cdb2_store_addr    : alu_cdb2.store_addr  ,
        i_cdb2_store_funct3  : alu_cdb2.store_funct3,
        // Phase 8 S10.3: MSHR capture-time LQ record + aborted-fill poison.
        // step-2: a Stage-B handoff records too — the load leaves the pipe with no
        // normal CDB writeback, so the disambiguation scan needs its address.
        i_lq_rec_valid       : mshr_alloc_fire      ,
        i_lq_rec_idx         : mshr_alloc_rob       ,
        i_lq_rec_addr        : mshr_rec_addr        ,
        i_lq_rec_funct3      : mshr_alloc_f3        ,
        // P9.0 CoRR: remote-invalidate poison (same pulses the dcache gets).
        i_inv_valid          : i_dcache_inv_valid   ,
        i_inv_addr           : i_dcache_inv_addr    ,
        // P9.2: 2nd precise-inv port + local line-departure events — every
        // way a line leaves the L1 poisons executed loads on it (CoRR).
        i_inv2_valid         : i_dcache_inv2_valid  ,
        i_inv2_addr          : i_dcache_inv2_addr   ,
        i_evict1_valid       : dc_evict1_v && (SMP_COHERENT != 0),
        i_evict1_addr        : dc_evict1_addr       ,
        i_evict2_valid       : dc_evict2_v && (SMP_COHERENT != 0),
        i_evict2_addr        : dc_evict2_addr       ,
        i_load_poison_v      : mshr_abort_poison    ,
        i_load_poison_idx    : mshr_poison_idx      ,
        i_load_poison_v2     : mshr_abort_poison2   ,
        i_load_poison_idx2   : mshr_poison_idx2     ,
        i_lfault_inj_v       : lfault_inj_v         ,
        i_lfault_inj_rob     : walk_rob_q           ,
        i_lfault_inj_vaddr   : walk_vaddr_q         ,
        i_lfault_inj_acc     : lfault_inj_acc       ,
        i_lfault_inj_is_amo  : walk_is_amo_q        ,
        // Phase 11-H3c: the MMU is in TS_FAULT this cycle (lfault_inj_v implies
        // dmem_mmu_fault), so its gstage/gpa outputs correspond to this walk.
        i_lfault_inj_gstage  : dmem_mmu_gstage      ,
        i_lfault_inj_gpa     : dmem_mmu_gpa         ,
        i_lfault_inj_pc      : walk_pc_q            ,
        o_commit_valid       : rob_commit_valid     ,
        o_commit_entry       : rob_commit_entry     ,
        o_commit_pc          : c_pc                 ,
        o_commit_instr       : c_instr              ,
        o_commit_rd_arch     : c_rd_arch            ,
        o_commit_rd_pdst     : c_rd_pdst            ,
        o_commit_old_rd_pdst : c_old_rd_pdst        ,
        o_commit_has_rd      : c_has_rd             ,
        o_commit_illegal     : c_illegal            ,
        o_commit_mispredict  : _                    , // Phase 8 M1: superseded by commit-time check
        o_commit_redirect_pc : c_redirect_pc        ,
        o_commit_pred_next_pc: c_pred_next_pc       ,
        o_commit_early_fix   : c_early_fix          ,
        o_commit_is_rvc      : c_is_rvc             ,
        o_commit_is_control  : c_is_control         ,
        o_commit_is_cond     : c_is_cond            ,
        o_commit_is_call     : c_is_call            ,
        o_commit_is_ret      : c_is_ret             ,
        o_commit_pred_index  : c_pred_index         ,
        o_commit_ghr_fold    : c_ghr_fold           ,
        o_commit_result_data : c_result_data        ,
        o_commit_is_store    : c_is_store           ,
        o_commit_is_amo      : c_is_amo             ,
        o_commit_is_cas_q    : c_is_cas_q          , // Zacas amocas.q
        o_commit_cas_q_mem_lo: c_cas_q_mem_lo       ,
        o_commit_cas_q_mem_hi: c_cas_q_mem_hi       ,
        o_commit_rdh_pdst    : c_rdh_pdst           ,
        o_commit_mem_virt    : c_is_mem_virt        , // Phase 11-H HLV/HSV
        o_commit_store_addr  : c_store_addr         ,
        o_commit_store_data  : c_store_data         ,
        o_commit_store_funct3: c_store_funct3       ,
        o_commit_store_pa      : c_store_pa         ,
        o_commit_store_xfault  : c_store_xfault     ,
        o_commit_store_pa_valid: c_store_pa_valid   ,
        o_has_pending_store  : rob_has_pending_store,
        o_has_pending_xlate  : rob_has_pending_xlate,
        // Phase 8 S5.1 store-to-load gate + per-entry store shadow (forwarded to
        // alu_wrap for the local byte-network).
        o_block_store_exists : rob_block_store_exists,
        o_block_store_age    : rob_block_store_age   ,
        i_conservative       : dmem_vm_on            ,
        o_store_addr         : rob_store_addr        ,
        o_store_data         : rob_store_data        ,
        o_store_funct3       : rob_store_funct3      ,
        o_store_fwdable      : rob_store_fwdable     ,
        o_pred_next_pc       : rob_pred_next_pc      ,
        o_is_control         : rob_is_control        ,
        o_commit_is_csr      : c_is_csr             ,
        o_commit_csr_addr    : c_csr_addr           ,
        o_commit_csr_wdata   : c_csr_wdata          ,
        o_commit_is_ecall    : c_is_ecall           ,
        o_commit_is_ebreak   : c_is_ebreak          ,
        o_commit_is_mret     : c_is_mret            ,
        o_commit_is_sret     : c_is_sret            ,
        o_commit_is_sfence   : c_is_sfence          ,
        o_commit_is_svinval_fence: c_is_svinval_fence,
        o_commit_sfence_rs1  : c_sfence_rs1         , // P9.5
        o_commit_sfence_rs2  : c_sfence_rs2         ,
        o_commit_is_fence_i  : c_is_fence_i         ,
        o_commit_is_fence    : c_is_fence           ,
        o_commit_is_cbo_zero : c_is_cbo_zero        ,
        o_commit_is_cbo_m    : c_is_cbo_m           ,
        o_commit_is_ifault   : c_is_ifault          ,
        o_commit_is_lfault   : c_is_lfault          ,
        o_commit_fault_acc   : c_fault_acc          ,
        o_commit_is_sfault   : c_is_sfault          ,
        o_commit_fault_vaddr : c_fault_vaddr        ,
        o_commit_fault_gstage: c_fault_gstage       ,
        o_commit_fault_gpa   : c_fault_gpa          ,
        o_commit_dbg_walk_pc : commit_dbg_walk_pc   ,
        o_commit_dbg_inj     : commit_dbg_inj       ,
        o_commit_is_fp_dest  : c_is_fp_dest         ,
        o_commit_is_fp       : c_is_fp              ,
        o_commit_fflags      : c_fflags             ,
        o_commit_fflags_wen  : c_fflags_wen         ,
        o_commit_vxsat       : c_vxsat              ,
        o_commit_is_vec      : c_is_vec             ,
        o_commit_vset_wen    : c_vset_wen           ,
        o_commit_vtype       : c_vtype              ,
        o_commit_vl          : c_vl                 ,
        o_commit_vstart_wen  : c_vstart_wen         ,
        o_commit_vstart      : c_vstart             ,
        o_commit_vstore      : c_vstore             ,
        o_commit_idx         : rob_commit_idx       ,
        o_commit_load_poison : c_load_poison        , // Phase 8 S9
        i_commit_ack         : rob_commit_ack       ,
        o_commit2_valid      : c2_valid             ,
        o_commit2_pc         : c2_pc                ,
        o_commit2_rd_arch    : c2_rd_arch           ,
        o_commit2_rd_pdst    : c2_rd_pdst           ,
        o_commit2_old_rd_pdst: c2_old_rd_pdst       ,
        o_commit2_has_rd     : c2_has_rd            ,
        o_commit2_result_data: c2_result_data       ,
        o_commit2_is_rvc     : c2_is_rvc            ,
        i_commit_ack2        : commit2_fire         ,
        i_redirect_fire      : redirect_fire        ,
        // Phase 8 S8.E: early partial squash (flip). Rewind tail to one past the
        // resolved branch and clear younger entries; coexists with CDB writeback
        // and head commit on the same cycle.
        i_squash_en          : s8_restore_en        ,
        i_squash_idx         : s8_restore_idx       ,
        // Phase 8 S8.E re-redirect guard (CDB-writeback pred rewrite).
        i_cdb_redir_fix      : early_redir_fix0     ,
        i_cdb2_redir_fix     : early_redir_fix1     ,
        o_head_idx           : rob_head_idx         ,
        o_size               : rob_size             ,
        o_dbg_head_valid     : rob_head_valid       ,
        o_dbg_head_rw        : rob_head_rw          ,
        o_dbg_head_illegal   : rob_head_illegal     ,
        o_dbg_alloc_cnt      : rob_alloc_cnt_w      ,
        o_dbg_cdb_cnt        : rob_cdb_cnt_w        ,
        o_dbg_commit_cnt     : rob_commit_cnt_w     ,
        o_dbg_head           : rob_head_w           ,
        o_dbg_tail           : rob_tail_w           ,
        o_dbg_load_viol_cnt  : rob_load_viol_cnt_w  , // Phase 8 S9
        o_dbg_inv_viol_cnt   : rob_inv_viol_cnt_w   , // L3 census
        o_dbg_mshr_pois_cnt  : rob_mshr_pois_cnt_w  , // L3 census
        o_dbg_viol_exact_cnt : rob_viol_exact_cnt_w , // L3 census
        o_dbg_viol_pgx_cnt   : rob_viol_pgx_cnt_w   , // L3 census
        o_dbg_st_resolve_cnt : rob_st_resolve_cnt_w , // L3 census
        o_dbg_viol_store_cnt : rob_viol_store_cnt_w , // L3 census
        o_dbg_viol_self_cnt  : rob_viol_self_cnt_w  , // L3 census
        o_lq_rec_set         : rob_lq_rec_set       , // Phase 14 L3.2a
        o_lq_pois_set        : rob_lq_pois_set      , // Phase 14 L3.2b
        o_store_known        : rob_store_known      , // Phase 14 L3.2b
        o_store_pa           : rob_store_pa         , // Phase 14 L3.2d
        o_store_pa_valid     : rob_store_pa_v       ,
        i_lq_poison_head     : lq_poison_head       , // Phase 14 L3.2c
        i_lq_poison_head1    : lq_poison_head1      ,
    );

    // ============================================================
    // Phase 14 L3.2 — first-class LOAD QUEUE (peer of the ROB)
    // ============================================================
    // The age-ordered load queue this design never had; see load_queue.veryl and
    // doc/phase14_frontend_deep_ooo_plan.md §L3.2. Every input below is a signal
    // the core already drives into the ROB — the queue is a restructuring of
    // state, not new information. DEAD at L3.2a: nothing reads its poison, so
    // the only thing it does is prove (LQ_CHECK) that it tracks exactly the
    // ROB's executed-load set through alloc / commit / squash / flush.
    // Record ports, matched to the ROB's three record sites verbatim
    // (rob.veryl:1500 / :1530 / :1543) so the queue's contents are bit-identical
    // to the shadow arrays it replaces. Note the address spaces: the two CDB
    // ports carry the AGU VA, the MSHR port carries the Stage-A PA. The shadow
    // array cannot tell them apart; this queue can, and L3.2d uses it.
    let lq_rec0_valid: logic = cdb.valid && cdb.is_load && !cdb.is_lfault;
    // L3.2d: the exact PA for a lane-0 load record. lsr_paddr_q is the Stage-A
    // translated PA of whatever the Load Stage Register currently holds, so it
    // is this load's PA only when the LSR still holds this rob_idx — the same
    // identity test mshr_cap_b uses. A wrong guess would be a correctness bug,
    // so the gate is conservative: no identity, no PA, and the scan falls back
    // to today's page-offset compare. Coverage is measured, not assumed
    // (o_dbg_lq_pa_rec_cnt vs the record count).
    let lq_rec0_pa_v : logic = lsr_v_q && (lsr_rob_idx_q == cdb.rob_idx);
    // ...and the same for lane 1, which is where the bulk of them actually are:
    // a plain integer load has lsr_to_lane1 = 1, so its writeback is routed to
    // alu_cdb2 (`alu_cdb2 = lsr_lane1_fire ? lsu_cdb : alu2_pipe_cdb`). Wiring
    // only lane 0 gave 3.8 % PA coverage on a boot — measured, which is how the
    // mistake surfaced at all.
    let lq_rec1_pa_v : logic = lsr_v_q && (lsr_rob_idx_q == alu_cdb2.rob_idx);
    let lq_rec1_valid: logic = alu_cdb2.valid && alu_cdb2.is_load;
    inst u_load_queue: load_queue #(
        LQ_N     : 32,
        LQ_IDX_W : 5 ,
        LQ_PTR_W : 6 ,
        ROB_DEPTH: 32,
        ROB_IDX_W: 5 ,
    ) (
        clk                                     ,
        rst                                     ,
        i_alloc_en       : rename_fire          ,
        i_alloc_is_load  : dec_op.is_load       ,
        i_alloc_idx      : rob_alloc_idx        ,
        i_alloc_en2      : rename_fire2         ,
        i_alloc_is_load2 : dec_op2.is_load      ,
        i_alloc_idx2     : rob_alloc_idx2       ,
        i_rob_full       : rob_full             ,
        i_rob_head_idx   : rob_head_idx         ,
        i_commit_fire    : rob_commit_valid && rob_commit_ack,
        i_commit_idx     : rob_commit_idx       ,
        i_commit_fire2   : commit2_fire         ,
        i_commit_idx2    : rob_commit_idx + 5'd1,
        i_redirect_fire  : redirect_fire        ,
        i_squash_en      : s8_restore_en        ,
        i_squash_idx     : s8_restore_idx       ,
        i_rec0_valid     : lq_rec0_valid        ,
        i_rec0_idx       : cdb.rob_idx          ,
        i_rec0_va        : cdb.store_addr       ,
        i_rec0_pa        : lsr_paddr_q          , // L3.2d
        i_rec0_pa_valid  : lq_rec0_pa_v         ,
        i_rec0_funct3    : cdb.store_funct3     ,
        i_rec1_valid     : lq_rec1_valid        ,
        i_rec1_idx       : alu_cdb2.rob_idx     ,
        i_rec1_va        : alu_cdb2.store_addr  ,
        i_rec1_pa        : lsr_paddr_q          , // L3.2d
        i_rec1_pa_valid  : lq_rec1_pa_v         ,
        i_rec1_funct3    : alu_cdb2.store_funct3,
        // The MSHR port's address IS the PA (mshr_rec_addr = lsr_paddr_q /
        // dmu_dmem_addr), so it fills both fields: `va` keeps the queue's scans
        // bit-identical to the shadow's (which stores this PA in sh_load_addr),
        // `pa` records what it actually is.
        i_rec2_valid     : mshr_alloc_fire      ,
        i_rec2_idx       : mshr_alloc_rob       ,
        i_rec2_va        : mshr_rec_addr        ,
        i_rec2_pa        : mshr_rec_addr        ,
        i_rec2_pa_valid  : 1'b1                 ,
        i_rec2_funct3    : mshr_alloc_f3        ,
        // L3.2b: the disambiguation event + the store side (still the ROB
        // shadow — L1 was never built) + every line-departure the dcache sees.
        i_st_valid       : cdb.valid && cdb.is_store,
        i_st_idx         : cdb.rob_idx          ,
        i_st_addr        : cdb.store_addr       ,
        i_st_funct3      : cdb.store_funct3     ,
        i_store_addr     : rob_store_addr       ,
        i_store_funct3   : rob_store_funct3     ,
        i_store_known    : rob_store_known      ,
        i_store_fwd      : rob_store_fwdable    , // M2
        i_fwd_mask       : sf_rob_mask          , // M2a interlock
        i_store_pa       : rob_store_pa         , // L3.2d
        i_store_pa_v     : rob_store_pa_v       ,
        i_st_pa          : store_pretx_pa       ,
        i_st_pa_valid    : store_pretx_valid    ,
        i_conservative   : dmem_vm_on           ,
        i_inv_valid      : i_dcache_inv_valid   ,
        i_inv_addr       : i_dcache_inv_addr    ,
        i_inv2_valid     : i_dcache_inv2_valid  ,
        i_inv2_addr      : i_dcache_inv2_addr   ,
        i_evict1_valid   : dc_evict1_v && (SMP_COHERENT != 0),
        i_evict1_addr    : dc_evict1_addr       ,
        i_evict2_valid   : dc_evict2_v && (SMP_COHERENT != 0),
        i_evict2_addr    : dc_evict2_addr       ,
        i_pois_v         : mshr_abort_poison    ,
        i_pois_idx       : mshr_poison_idx      ,
        i_pois_v2        : mshr_abort_poison2   ,
        i_pois_idx2      : mshr_poison_idx2     ,
        i_rob_rec_set    : rob_lq_rec_set       ,
        i_rob_pois_set   : rob_lq_pois_set      ,
        o_poison_head    : lq_poison_head       ,
        o_poison_head1   : lq_poison_head1      ,
        o_dbg_lq_alloc_cnt : lq_dbg_alloc_cnt   ,
        o_dbg_lq_orphan_cnt: lq_dbg_orphan_cnt  ,
        o_dbg_lq_mism_cnt  : lq_dbg_mism_cnt    ,
        o_dbg_lq_full_cnt  : lq_dbg_full_cnt    ,
        o_dbg_lq_asq_cnt   : lq_dbg_asq_cnt     ,
        o_dbg_lq_occ_max   : lq_dbg_occ_max     ,
        o_dbg_lq_pmism_cnt : lq_dbg_pmism_cnt   ,
        o_dbg_lq_rec_cnt   : lq_dbg_rec_cnt     , // L3.2d coverage
        o_dbg_lq_pa_rec_cnt: lq_dbg_pa_rec_cnt  ,
        o_dbg_lq_exact_cnt : lq_dbg_exact_cnt   ,
        o_dbg_lq_saved_cnt : lq_dbg_saved_cnt   ,
        o_dbg_lq_invnopa_cnt: lq_dbg_invnopa_cnt,
        o_dbg_self_fire     : lq_self_fire      , // M1
        o_dbg_self_nopa     : lq_self_nopa      ,
        o_dbg_self_pamis    : lq_self_pamis     ,
        o_dbg_self_spamis   : lq_self_spamis    ,
        o_dbg_p1_exempt     : lq_p1_exempt      ,
        o_dbg_p1_nomask     : lq_p1_nomask      ,
        o_dbg_self_p0       : lq_self_p0        ,
        o_dbg_self_p2       : lq_self_p2        ,
    );

    // ============================================================
    // Commit stage
    // ============================================================
    // TVM (mstatus.TVM) traps satp access / sfence.vma in S-mode; TSR
    // (mstatus.TSR) traps sret in S-mode. Commit-time priv + mstatus dependent,
    // so they raise an illegal-instruction trap (cause 2) at commit, not at
    // decode, and suppress the instruction's side effects (rd / csr write /
    // sfence pulse / sret). Matches v1 (heliodor_core.veryl:4442).
    // Phase 11-H3b: in VS-mode (V=1) the mstatus.TVM/TSR controls do not apply —
    // the guest is governed by hstatus.VTVM/VTSR (not yet implemented), so these
    // traps are gated off with !csr_virt. Inert at V=0 (byte-identical).
    let commit_tvm_trap    : logic = rob_commit_valid && csr_tvm && !csr_virt && csr_priv == csr_pkg::PrivLevel::SUPERVISOR
        && (c_is_sfence || (c_is_csr && c_csr_addr == 12'h180));
    let commit_tsr_trap    : logic = rob_commit_valid && csr_tsr && !csr_virt && csr_priv == csr_pkg::PrivLevel::SUPERVISOR
        && c_is_sret;
    // M6.B.4: an FP instruction committing while mstatus.FS == Off (FP unit
    // disabled) raises an illegal-instruction trap (cause 2) and has its side
    // effects suppressed — same machinery as the TVM/TSR commit traps.
    // Phase 11-H A1: in a virtualized guest (V=1), FP is also illegal when
    // vsstatus.FS == Off, even if the host's mstatus.FS is non-Off. This closes
    // the lazy-FP correctness hole: a guest that leaves vsstatus.FS=Off (deferred
    // restore) must trap on first FP use so the guest can fault in its FP context.
    // V=1-only term → byte-identical at V=0 (csr_virt=0 drops the added clause).
    let commit_fp_disabled : logic = rob_commit_valid && c_is_fp
        && (csr_fs == 2'b00 || (csr_virt && csr_vs_fs == 2'b00));
    // Phase 12 V0: a vector instruction committing while mstatus.VS == Off (vector
    // unit disabled) raises an illegal-instruction trap (cause 2), same machinery
    // as commit_fp_disabled. Inert for non-vector code (c_is_vec=0).
    let commit_vec_disabled: logic = rob_commit_valid && c_is_vec && csr_vs == 2'b00;
    // Phase 11-H B: HLV/HLVX/HSV (c_is_mem_virt) are valid only in M, HS-S, or
    // HS-U with hstatus.HU=1. Executed in VS/VU (V=1) they raise a VIRTUAL
    // instruction exception (cause 22); executed in HS-U with HU=0 they raise an
    // illegal instruction (cause 2). Inert for ordinary code (c_is_mem_virt=0)
    // and for the hypervisor's own HLV/HSV (it runs in HS-S). Byte-identical at
    // V=0 with no U-mode HLV use.
    let commit_hlv_vi      : logic = rob_commit_valid && c_is_mem_virt && csr_virt;
    let commit_hlv_illegal : logic = rob_commit_valid && c_is_mem_virt && !csr_virt
        && csr_priv == csr_pkg::PrivLevel::USER && !csr_hstatus_hu;
    // Phase 11-H B: a VS/VU (V=1) access to a hypervisor or VS-level CSR — the
    // 0x6xx HS range, the 0x2xx VS range, or hgeip (0xE12) — is a virtual
    // instruction (cause 22). The guest reaches its supervisor state only through
    // the aliased S-CSR addresses (0x1xx); a direct H/VS-CSR access would leak or
    // corrupt hypervisor state. The CSR read still returns the real value, but rd
    // and any CSR write are suppressed by commit_priv_illegal. Inert at V=0.
    let commit_vs_csr_vi   : logic = rob_commit_valid && c_is_csr && csr_virt
        && (c_csr_addr[11:8] == 4'h6 || c_csr_addr[11:8] == 4'h2 || c_csr_addr == 12'hE12);
    // Phase 11-H B: VS-mode analogues of TVM/TSR, controlled by hstatus.VTVM/VTSR.
    // A VS-supervisor satp (vsatp) access / SFENCE.VMA (VTVM) or SRET (VTSR) raises
    // a VIRTUAL instruction (cause 22), letting the hypervisor intercept guest
    // paging / return. Inert at V=0 and when the controls are clear (byte-identical).
    let commit_vtvm_trap   : logic = rob_commit_valid && csr_virt && csr_hstatus_vtvm
        && csr_priv == csr_pkg::PrivLevel::SUPERVISOR
        && (c_is_sfence || (c_is_csr && c_csr_addr == 12'h180));
    let commit_vtsr_trap   : logic = rob_commit_valid && csr_virt && csr_hstatus_vtsr
        && csr_priv == csr_pkg::PrivLevel::SUPERVISOR && c_is_sret;
    // Combined virtual-instruction (cause 22) sources.
    let commit_virt_instr  : logic = commit_hlv_vi || commit_vs_csr_vi || commit_vtvm_trap || commit_vtsr_trap;
    // Svinval: the sfence-class instructions are S-mode privileged, so executing
    // any of them in U-mode raises an illegal-instruction trap (cause 2) with the
    // side effects suppressed — same commit-time machinery as the TVM trap.
    //  - SFENCE.VMA / SINVAL.VMA (c_is_sfence): also trapped in S-mode by TVM
    //    (commit_tvm_trap above); here we add the U-mode case.
    //  - SFENCE.W.INVAL / SFENCE.INVAL.IR (c_is_svinval_fence): NOT trapped by
    //    TVM (a NOP in M/S), illegal only in U-mode — hence the separate flag.
    // Gated on !csr_virt: at V=1 the VS/VU-mode behaviour is governed by the
    // hypervisor controls (commit_vtvm_trap), leaving the guest path byte-
    // identical. The ACT4 priv suites run at V=0.
    let commit_sfence_u_illegal : logic = rob_commit_valid && !csr_virt
        && csr_priv == csr_pkg::PrivLevel::USER && (c_is_sfence || c_is_svinval_fence);
    let commit_priv_illegal: logic = commit_tvm_trap || commit_tsr_trap || commit_fp_disabled
        || commit_virt_instr || commit_hlv_illegal || commit_vec_disabled || commit_sfence_u_illegal;
    // M9.3 SMP FIX (cosim-pinned free-list double-alloc): gate the commit-side
    // architectural mutations on the actual RETIRE (rob_commit_ack), NOT on
    // rob_commit_valid. A store-class op held at the ROB head keeps
    // rob_commit_valid HIGH for every cycle it waits (rob_commit_ack low while
    // dmem_mmu_busy / dcache_stall). For an AMO (is_store AND has_rd — the
    // SMP-spinlock case, held by the bus-atomic lock + bus contention),
    // fl_push_en = rob_commit_valid && c_has_rd then PUSHES the displaced
    // old_rd_pdst to the free-list EVERY held cycle → the same pdst is enqueued
    // K times → it is later popped by K different renames → a DOUBLE-ALLOCATION.
    // The SMP cosim caught the symptom: `c.slli a3,0x3` @0x800df85e read a3 as
    // a4's value because the `lw a3` and the `addi a4` were both handed pdst 12.
    // rob_commit_ack == rob_commit_valid for every non-held op (so the common
    // path is unchanged); only a held AMO now pushes/commits exactly once, at
    // retire. (Gating rat_commit_en too keeps RAT-arch atomic with the push and
    // avoids committing a held AMO's rd before it actually retires / if it
    // faults.) v4 N=1 never hit this (AMOs rarely held without bus contention).
    always_comb {
        rat_commit_en   = rob_commit_ack && c_has_rd && !c_illegal && !commit_priv_illegal;
        rat_commit_arch = c_rd_arch;
        rat_commit_pdst = c_rd_pdst;

        fl_push_en   = rob_commit_ack && c_has_rd && !c_illegal && !commit_priv_illegal;
        fl_push_pdst = c_old_rd_pdst;

        // M6: FP-dest commit — rename the FP arch RAT + push the displaced FP
        // pdst to the FP free-list (rd_pdst/old_rd_pdst hold the FP pdsts).
        fp_rat_commit_en = rob_commit_ack && c_is_fp_dest && !c_illegal && !commit_priv_illegal;
        fp_fl_push_en    = rob_commit_ack && c_is_fp_dest && !c_illegal && !commit_priv_illegal;
        fp_fl_push_pdst  = c_old_rd_pdst;

        // Phase 8 S1: commit slot-1 (simple integer op). It is never illegal /
        // priv-illegal / FP / control (excluded by c2_valid), so the only
        // architectural effects are the integer arch-RAT write and free-list push
        // (ordered AFTER slot-0 in rat/free_list so a same-rd WAW lets the younger
        // slot-1 win). arch_regs slot-1 update is in the arch_regs always_ff.
        rat_commit_en2   = commit2_fire && c2_has_rd;
        rat_commit_arch2 = c2_rd_arch;
        rat_commit_pdst2 = c2_rd_pdst;
        fl_push_en2      = commit2_fire && c2_has_rd;
        fl_push_pdst2    = c2_old_rd_pdst;
    }

    // ============================================================
    // M4 trap entry decisions (commit-time, registered into redirect)
    // ============================================================
    // P9.1 FIX: gate on rob_commit_ack, NOT rob_commit_valid. A satp CSR op is
    // c_serial (P9.0): its RETIRE — and so its arch-RAT / free-list commit
    // (rat_commit_en / fl_push_en, both ack-based) — waits for the store
    // buffer to drain, while the commit_csrw_satp implicit redirect below
    // fired off commit_VALID immediately. The full flush then restored
    // rat_spec / free list from a pre-commit arch state: the CSR op's rename
    // was rolled back even though the op itself retired, so a consumer of its
    // rd re-executed reading the STALE pre-rename preg (observed: asids_init's
    // `csrr a1,satp` re-ran its `or` with a1=0 → satp restored to 0 → kernel
    // silently dropped to Bare translation → VA-addressed stores corrupted
    // DRAM → N=4 boot livelock on a spinlock word). Latent since P9.0 revived
    // c_serial; P9.1's longer store-drain latencies made the non-empty-sb
    // window at a satp-CSR commit routine. Same ack-gating for the FENCE.I /
    // SFENCE pulses below (both c_serial, both with commit-time side effects).
    let commit_csrwr: logic = rob_commit_ack && c_is_csr && !c_illegal && !commit_priv_illegal;
    // M9 (2026-05-25): csrw satp must also act like an implicit sfence +
    // pipeline redirect to match v1's IFU behavior. Linux head.S's trampoline
    // sequence (csrw stvec=high; csrw satp=trampoline_pg; <expect fault>; ...)
    // relies on the next fetch after csrw satp to walk with the new satp and
    // fault — which redirects PC to high-half stvec. v4's narrow IFU + deep
    // prefetch + satp_shadow lazy update misses this fault, so kernel head.S
    // proceeds at low-half PC and panics later. The fix: redirect to next PC
    // and update satp_shadow on csrw satp commit so the re-fetch goes through
    // MMU with the new satp.
    let commit_csrw_satp: logic = commit_csrwr && c_csr_addr == 12'h180;
    // P10: a write to frm (0x002) / fcsr (0x003) changes the dynamic rounding
    // mode; re-fetch the successor so a younger dynamic-rounding FP op captures
    // the new frm (it samples the mode at execute, before this CSR retired).
    let commit_csrw_frm: logic = commit_csrwr && (c_csr_addr == 12'h002 || c_csr_addr == 12'h003);
    // M9 (2026-05-25): on the FIRST csrw satp commit that turns on Sv39
    // (bare→Sv39), inject a fake instruction page fault to match v1's TLB
    // -eviction quirk that Linux head.S's trampoline_pg sequence depends on.
    // v1's IFU happens to take an instruction page fault on the next fetch
    // after csrw satp; v4's narrow + lazy MMU walks PT 0x80a8a successfully
    // (PT maps low-half identity at the time of walk) and misses the fault.
    // Kernel head.S expects the fault to redirect PC to high-half stvec, so
    // we synthesize the fault here. After the first Sv39 enable the kernel
    // sets up SFENCE.VMA and explicit stvec changes — no further fakes.
    var first_satp_done: logic;
    // Use c_csr_wdata (the value being written this cycle), not csr_satp
    // (which is the OLD value at always_comb time — register updates NBA).
    // M9.A.300: only synthesize the fake instruction page fault when the satp
    // write happens in S-mode (or U). The hack mimics v1's IFU faulting on the
    // high-half fetch after Linux head.S enables Sv39 — which only occurs when
    // instruction fetch TRANSLATES (priv != M). An M-mode `csrw satp` (e.g.
    // rv64si-dirty turning on VM to test MPRV load/store translation) keeps
    // fetch in Bare mode, so no real ifault would occur — injecting one there
    // is spurious and derails the test (it took a phantom cause=12 trap before
    // reaching its store-fault subtest). Boot is unaffected: OpenSBI firmware
    // never writes a MODE=8 satp in M-mode; the kernel's first Sv39 enable is
    // in S-mode, so the hack still fires for Linux.
    // Phase 11-H5.2b: a GUEST's `csrw satp` (V=1, aliasing vsatp) needs the SAME
    // narrow-IFU/satp-switch hack as V=0. Linux head.S's relocate_enable_mmu does
    // two back-to-back `csrw satp` (trampoline pgd, then the real swapper pgd) and
    // relies on the fetch right after the FIRST one FAULTING to the high-half stvec
    // (the low-half PC is no longer mapped). Our narrow + lazy MMU does not take
    // that fault on its own, so we synthesize it here for V=1 too — delivered as a
    // VS instruction page-fault (cause 12, hedeleg[12]=1) to the guest's vstvec.
    // The fake trap drops the vsatp REGISTER write (the csr's trap path wins over
    // its write path), but the vsatp_shadow latch below takes c_csr_wdata (the
    // intended value), so the guest's paging still engages. 6bde0f2 gated this off
    // for V=1 and left vsatp_shadow one-behind, which hung the guest in the
    // trampoline (stuck at the 2nd `csrw satp`). V=0 is byte-identical: it already
    // fired for V=0 (csr_virt=0), and removing the gate only adds the V=1 case.
    let inject_fake_ifault: logic = commit_csrw_satp && !first_satp_done && c_csr_wdata[63:60] == 4'd8 && csr_priv
        != csr_pkg::PrivLevel::MACHINE;
    always_ff (clk, rst) {
        if_reset {
            first_satp_done = 1'b0;
        } else if commit_csrw_satp && c_csr_wdata[63:60] == 4'd8 {
            first_satp_done = 1'b1;
        }
    }

    // M9.A.299: store page fault (cause=15) delivery. A STORE translates only
    // at commit (core_dmem_vaddr=c_store_addr, core_dmem_wen=commit_store_fire),
    // so dmem_mmu_fault_s asserts at COMMIT for a faulting store — the ROB never
    // records sfault for commit-translated stores (its CDB-time is_sfault is
    // always 0 for them), so without this the fault is silently dropped: the
    // store's head pops normally (the write itself is suppressed by dmem_mmu's
    // ptw_valid gate) but no trap fires. Confirmed by rv64si-dirty hanging
    // (D-bit demand store fault) and breaks execve demand-paging store faults.
    // Defined from primitives (not commit_store_fire, which is in the dmem
    // section below) to keep declaration order valid. dmem_mmu_fault_s already
    // implies i_wen (= commit_store_fire), so this only fires on a real store.
    // PMP: a commit-translated store can also take a PMP access fault (cause 7).
    // fast_store_acc_fault covers the fast (bare store-drain) path, which does
    // not flow through the dmem_mmu and so is not covered by dmem_mmu_acc_fault_s.
    // P10 Zicbom: cbo.clean/flush/inval fault only on LEAF R-AND-W denial
    // (cbo_m_acc_fault); the dmem_mmu's W-only LEAF store access fault is
    // suppressed for cbo_m (!c_is_cbo_m) so it does not over-fault a W-denied /
    // R-present block. But a PMP-denied PTE READ on the walk (dmem_mmu_pte_acc_fault)
    // ALWAYS faults a cbo_m (independent of the leaf R-or-W rule), and a genuine
    // PAGE fault (dmem_mmu_fault_s) on a cbo_m still traps (cause 15).
    // CP commit-store pre-translate (P5b trap-deferral): for a committing plain VM store
    // on the pre-translate path, the page/access/G-stage fault feeding the commit trap
    // comes from a REGISTERED source instead of the live MMU. A store_xlate_dfr store is
    // either pre-translated (committed in 1 cycle, clean by construction → fault 0), held
    // and not yet at its retire cycle (store_fetched_q=0 → fault DEFERRED to 0), or held
    // at its retire cycle (store_fetched_q=1 → fault = m_spage_q/m_sacc_q/m_gstage_q,
    // registered at the cycle-N translate). In every non-store_fetched_q case the fault is
    // 0, so `store_fetched_q ? m_*_q : 0` captures all three without referencing the late
    // c_pretx_fast. This takes the live MMU fault (dmem_mmu_*_s, the ~5.7 ns TLB+PMP cone)
    // off the commit_excp → n_inflight path. AMO, bare/fast, and cbo stores keep the LIVE
    // fault. At STORE_PRETRANSLATE=0, store_xlate_dfr ≡ 0 → the _eff signals are exactly
    // the live faults = byte-identical. (Uses only ROB-registered / early-available
    // signals; commit_store_fire/c_pretx_fast are defined later in the store-buffer block.)
    let store_xlate_dfr: logic = STORE_PRETRANSLATE && rob_commit_valid && c_is_store && !c_illegal && !c_is_amo && dmem_vm_on_op && !c_is_cbo_zero && !c_is_cbo_m;
    // R3 (retire decouple, cp_retire_decouple_plan.md §7): take the LIVE TLB+PMP
    // cone off rob_commit_ack by sourcing the commit-store fault from the
    // execute-registered translate for EVERY store, not just the plain
    // STORE_PRETRANSLATE class. The current `if !store_xlate_dfr ? live : reg` is a
    // RUNTIME mux (the §6 flaw: a runtime gate cannot prune the live arm — its
    // delay ≥ the live TLB for every store on the wire, and cbo.m/atomic/
    // non-pretranslated stores are excluded from store_xlate_dfr so their fault is
    // UNCONDITIONALLY the live MMU). RETIRE_DECOUPLE replaces it with a CONST gate:
    // at =1 the live arm DCEs and every store reads the registered fault. This is
    // the SMP-ordering heart, so it is staged (§7): S0 = this const-gated skeleton
    // (the sfault_*_eff MMU-fault mux); L2 = register the REMAINING cbo.m fault terms
    // (pte_acc/pma_hole/R-AND-W PMP) at the M3a translate cycle N — a VM cbo.m already
    // rides store_fetched_q (c_is_store + !sb_elig), so no execute translate is needed,
    // just registering its walk-time fault the way m_spage_q registers the page fault;
    // L3 = register the atomic fault (the §13 RMW-re-drive minefield). The =1 arm is
    // only fully correct once L2/L3 land (cbo.m done here, atomic pending); at =0 it
    // const-folds to the exact live/STORE_PRETRANSLATE mux = byte-identical.
    const RETIRE_DECOUPLE: bit = 1;
    let sfault_pg_eff  : logic = if RETIRE_DECOUPLE ? (if store_fetched_q ? m_spage_q  : 1'b0) : if !store_xlate_dfr ? dmem_mmu_fault_s     : if store_fetched_q ? m_spage_q  : 1'b0;
    let sfault_acc_eff : logic = if RETIRE_DECOUPLE ? (if store_fetched_q ? m_sacc_q   : 1'b0) : if !store_xlate_dfr ? dmem_mmu_acc_fault_s : if store_fetched_q ? m_sacc_q   : 1'b0;
    let sfault_gs_eff  : logic = if RETIRE_DECOUPLE ? (if store_fetched_q ? m_gstage_q : 1'b0) : if !store_xlate_dfr ? dmem_mmu_gstage      : if store_fetched_q ? m_gstage_q : 1'b0;
    // R3 L2 (cbo.m): a VM cbo.m rides the M3a store_fetched_q 2-cycle commit (c_is_store
    // + !sb_elig), so its page/access fault is ALREADY registered (m_spage_q/m_sacc_q via
    // the sfault_*_eff above). These two are the REMAINING cbo.m-only commit-fault terms,
    // registered at the same translate cycle N (m_pte_acc_q/m_pma_hole_q) and read at N+1
    // under store_fetched_q. =0 folds to the live MMU-walk fault = byte-identical.
    let pte_acc_eff : logic = if RETIRE_DECOUPLE ? (if store_fetched_q ? m_pte_acc_q  : 1'b0) : dmem_mmu_pte_acc_fault;
    let pma_hole_eff: logic = if RETIRE_DECOUPLE ? (if store_fetched_q ? m_pma_hole_q : 1'b0) : dmem_mmu_pma_hole;
    let commit_store_sacc  : logic = rob_commit_valid && c_is_store && !c_illegal && ((sfault_acc_eff && !sfault_pg_eff && (!c_is_cbo_m || pte_acc_eff || pma_hole_eff)) || fast_store_acc_fault || amo_commit_acc_fault || cbo_m_acc_fault);
    let commit_store_sfault: logic = rob_commit_valid && c_is_store && !c_illegal && (sfault_pg_eff || (sfault_acc_eff && (!c_is_cbo_m || pte_acc_eff || pma_hole_eff)) || fast_store_acc_fault || amo_commit_acc_fault || cbo_m_acc_fault);
    let c_is_sfault_eff    : logic = c_is_sfault || commit_store_sfault;
    let commit_excp        : logic = rob_commit_valid
        && (c_illegal || c_is_ecall || c_is_ebreak || c_is_lfault || c_is_sfault_eff || inject_fake_ifault
            || commit_priv_illegal);
    // M8.C: IRQ trap fires as soon as something is committing AND no
    // synchronous exception is firing (excp takes priority).
    //
    // M9.A.288 fix (2026-05-29): async IRQ must fire ONLY when the
    // pipeline is idle (rob_size == 0) and no redirect is pending.
    // v1 has the same restriction (see comment at trap_pc selector in
    // heliodor_core.veryl line 4358-4376):
    //   "For async IRQ with rob_empty: all in-flight instructions
    //    committed. Use ifid_pc (next-to-execute) rather than stale
    //    ex_pc register to avoid re-executing the just-committed
    //    instruction (which would corrupt state when a post-load
    //    register value gets used as if it were pre-load)."
    // Without this gate, an instr commits AND IRQ fires same cycle
    // with mepc = c_pc → mret returns to that PC → it re-executes.
    // Stack-pointer instructions are particularly poisonous: a single
    // `addi sp,sp,-96` re-executes, dropping sp twice (= 192 bytes).
    let commit_irq : logic = (rob_size == 8'd0) && !redirect_fire_q && !commit_excp && csr_irq_pending;
    let commit_trap: logic = commit_excp || commit_irq;
    let commit_mret: logic = rob_commit_valid && c_is_mret;
    let commit_sret: logic = rob_commit_valid && c_is_sret && !commit_tsr_trap && !commit_vtsr_trap;
    // P9.1 FIX: ack-based (c_serial — see the commit_csrwr note above).
    assign commit_sfence_pulse = rob_commit_ack && c_is_sfence && !commit_tvm_trap && !commit_vtvm_trap && !commit_sfence_u_illegal;

    // M8.A: FENCE.I commit pulse → flush the icache. Fired at commit so all
    // prior stores (self-modifying code) have updated memory before the
    // icache refills. A redundant flush is harmless. Straight-line code after
    // FENCE.I is not itself patched, so no pipeline redirect is needed.
    // P9.1 FIX: ack-based (c_serial — see the commit_csrwr note above).
    assign commit_fence_i_pulse = rob_commit_ack && c_is_fence_i;

    // Phase 12 V1: a non-faulting vector STORE retiring → force a commit-time
    // redirect (squash younger speculative loads). c_vstore is set only for a
    // successful store (a faulting store traps via commit_trap instead).
    let commit_vstore: logic = rob_commit_ack && c_vstore;

    // M9: satp shadow latch (see declaration above). Updated on either
    // SFENCE.VMA commit OR csrw satp commit. The latter is non-standard
    // but kernel head.S requires it (see commit_csrw_satp comment above).
    always_ff (clk, rst) {
        if_reset {
            satp_shadow  = 64'd0;
            vsatp_shadow = 64'd0;
        } else if commit_csrw_satp {
            // satp_shadow keeps csr_satp (the OLD value — the register update is
            // NBA); the V=0 narrow-IFU hack + the following sfence re-sync make this
            // work. Phase 11-H5.2b: vsatp_shadow instead takes c_csr_wdata (the
            // value being WRITTEN this cycle, == what the vsatp register receives),
            // so the guest's two-stage MMU sees the new vsatp immediately after the
            // implicit csrw-satp redirect. relocate_enable_mmu does two back-to-back
            // `csrw satp` with no sfence between, so a one-behind vsatp_shadow walked
            // the trampoline pgd after the swapper switch and hung. The
            // inject_fake_ifault path drops the vsatp REGISTER write (trap wins over
            // write), but c_csr_wdata still carries the intended value here.
            satp_shadow  = csr_satp;
            vsatp_shadow = c_csr_wdata;
        } else if commit_sfence_pulse {
            satp_shadow  = csr_satp;
            vsatp_shadow = csr_vsatp;  // sfence re-syncs to the (now-updated) vsatp
        }
    }

    // Cause encoding (per RISC-V priv spec). ECALL cause depends on
    // current priv: M=11, S=9, U=8. IRQ traps use csr_irq_cause from
    // csr (already MSB-tagged + cause #).
    var excp_cause: logic<64>;
    always_comb {
        if c_is_ifault || inject_fake_ifault {
            // Phase 11-H3d: a fetch fault in the G-stage of a guest (two-stage)
            // walk is an instruction guest-page-fault (cause 20), not a plain
            // instruction page-fault (12). inject_fake_ifault is the V=0 satp-
            // switch hack (never G-stage), so this only upgrades a real V=1 fetch
            // fault. c_fault_gstage is ROB-carried from alloc. Inert at V=0.
            // PMP: an instruction ACCESS fault is cause 1 (priority over the
            // page/guest-page-fault encodings, which never co-occur with it).
            excp_cause = if c_fault_acc ? 64'd1 : if c_is_ifault && c_fault_gstage ? 64'd20 : 64'd12;
        } else if commit_virt_instr {
            // Phase 11-H B: virtual instruction (22) — an HLV/HLVX/HSV in VS/VU, or
            // a VS/VU access to a hypervisor/VS-level CSR. Priority over the access
            // fault: the instruction is illegal for the current mode, so its
            // two-stage access result is irrelevant.
            excp_cause = 64'd22;
        } else if commit_hlv_illegal {
            // Phase 11-H B: HLV/HLVX/HSV in HS-U with hstatus.HU=0 → illegal (2),
            // also priority over the access fault for the same reason.
            excp_cause = 64'd2;
        } else if c_is_lfault {
            // Phase 11-H3c: a load fault that occurred in the G-stage of a guest
            // (two-stage) walk is a load guest-page-fault (cause 21), not a plain
            // load page-fault (13). c_fault_gstage is ROB-carried from the inject.
            // Inert at V=0 (the G-stage never runs → c_fault_gstage is 0).
            // PMP: a load ACCESS fault is cause 5 (else load page/guest-page-fault).
            excp_cause = if c_fault_acc ? 64'd5 : if c_fault_gstage ? 64'd21 : 64'd13;
        } else if c_is_sfault_eff {
            // Phase 11-H3c: a store/AMO fault that occurred in the G-stage of a
            // two-stage (guest) walk is a store guest-page-fault (cause 23), not a
            // plain store page-fault (15). dmem_mmu_gstage is valid alongside the
            // commit-time store fault (dmem_mmu_fault_s). Inert at V=0 (the G-stage
            // never runs, so dmem_mmu_gstage is 0 → cause stays 15).
            // PMP: a store/AMO ACCESS fault is cause 7 (c_fault_acc covers an
            // AMO store fault tracked via the ROB; commit_store_sacc covers a
            // commit-translated plain store).
            excp_cause = if c_fault_acc || commit_store_sacc ? 64'd7 : if commit_store_sfault && sfault_gs_eff ? 64'd23 : 64'd15;
        } else if c_illegal || commit_priv_illegal {
            excp_cause = 64'd2; // illegal instruction (incl. TVM/TSR commit trap)
        } else if c_is_ebreak {
            excp_cause = 64'd3; // breakpoint
        } else if csr_priv_prev == csr_pkg::PrivLevel::MACHINE {
            // M9.A.304: ECALL cause uses the registered priv snapshot, not the
            // live csr_priv, to avoid the cross-module eval-order hazard that
            // misrouted S-mode ECALLs to M-mode (cosim first divergence cy 630K).
            excp_cause = 64'd11; // ECALL from M
        } else if csr_priv_prev == csr_pkg::PrivLevel::SUPERVISOR {
            // Phase 11-H3: ECALL from VS-mode (priv=S with V=1) is cause 10,
            // distinct from ECALL-from-HS (cause 9). It is a hypercall and is
            // never delegated to VS (hedeleg[10] is read-only 0) — it traps to
            // HS/M for the hypervisor to service.
            excp_cause = if csr_virt_prev ? 64'd10 : 64'd9;
        } else {
            excp_cause = 64'd8; // ECALL from U / VU
        }
    }
    let trap_cause: logic<64> = if commit_irq ? csr_irq_cause : excp_cause;

    // M5.D trap delegation: if medeleg[cause]=1 AND current priv ∈ {S,U},
    // the trap is taken in S-mode. For IRQ traps, csr supplies o_irq_to_s.
    // (csr_medeleg_w forward-declared near pc_q.)
    let trap_cause_bit: logic = csr_medeleg_w[excp_cause[5:0]];
    // Phase 11-H3: a synchronous exception in VS/VU (virt_prev) delegated PAST M
    // (medeleg) AND past HS (hedeleg) is taken in VS-mode. Phase 11-H3b extends
    // this to interrupts: csr supplies o_irq_to_vs (a pending virtual interrupt
    // routed to VS), which the csr already gates on V=1 and the guest enables.
    let trap_deleg_s  : logic = trap_cause_bit && (csr_priv_prev != csr_pkg::PrivLevel::MACHINE);
    let trap_to_vs    : logic = if commit_irq ?
        csr_irq_to_vs
    :
        csr_virt_prev && trap_deleg_s && csr_hedeleg[excp_cause[5:0]]
    ;
    // Delivered to an S-level handler (HS or VS). trap_to_vs picks VS; otherwise
    // HS. For IRQs, csr supplies o_irq_to_s (always HS for now).
    let trap_to_s     : logic = if commit_irq ?
        csr_irq_to_s
    :
        trap_deleg_s
    ;
    // Phase 11-H3c: guest-page-fault info for the csr trap entry. htval = the
    // faulting guest PA >> 2; for a store guest-page-fault (cause 23) the GPA is
    // dmem_mmu_gpa, valid at commit alongside the store fault (load/ifetch GPAs
    // are increment 2/3). trap_gva flags that stval/mtval holds a guest VA — set
    // for any memory fault taken out of a guest (csr applies it on HS/M traps).
    // Inert at V=0 (csr_virt_prev is 0, so trap_gva is 0).
    // A load or instruction guest-page-fault carries its GPA in the ROB
    // (c_fault_gpa); a store guest-page-fault reads the live dmem_mmu_gpa at
    // commit. htval = GPA >> 2.
    let trap_htval    : logic<64> = (if c_is_lfault || c_is_ifault ? c_fault_gpa : dmem_mmu_gpa) >> 2;
    // Phase 11-H: an HLV/HSV memory fault is taken in HS-mode (V=0, so virt_prev
    // is 0) but stval still holds a GUEST virtual address → set GVA. c_is_mem_virt
    // marks the committing op as an HLV/HSV (load fault via ROB shadow, store
    // fault commit-time). A guest's own fault uses csr_virt_prev as before.
    let trap_gva      : logic     = (csr_virt_prev || c_is_mem_virt) && (c_is_lfault || c_is_sfault_eff || c_is_ifault);

    // ============================================================
    // CSR file
    // ============================================================
    // P10 Zihpm event bus (driven by an always_comb near the perf counters,
    // where the late pipeline signals it reads are in scope).
    var hpm_events: logic<8>;
    inst u_csr: csr #(
        HART_ID: HART_ID,
    ) (
        clk                         ,
        rst                         ,
        i_rd_addr  : iq_iss_csr_addr,
        o_rd_data  : csr_rd_data    ,
        i_wr_en    : commit_csrwr   ,
        i_wr_addr  : c_csr_addr     ,
        i_wr_data  : c_csr_wdata    ,
        i_mtime    : i_mtime        ,
        i_trap_fire: commit_trap    ,
        // M9: inject_fake_ifault synthesizes a trap as if the post-csrw-satp
        // fetch had taken a page fault. epc/stval = c_pc + 4 (the would-be
        // faulting VA), cause = 12 via excp_cause path.
        // M9.A.288: on commit_irq the ROB is empty (rob_size==0) so c_pc is
        // stale — the epc must be the PC of the next instruction the hart would
        // have executed. That was originally taken from the front end
        // (if_v_q ? if_pc_q : ic_pc, after v1's ifid_pc selector), which is
        // UNSOUND: those are speculative fetch pointers and rob_size==0 drains
        // only the ROB, not the fetch pipeline. It is now the committed
        // architectural next PC — see the arch_next_pc_q block below.
        i_trap_pc: if commit_irq ? arch_next_pc_q : if inject_fake_ifault ? c_pc + 64'd4 : c_pc,
        i_trap_cause: trap_cause,
        // mtval/stval for page faults carry the faulting VA; other
        // exception kinds leave it at 0 for now.
        // M9.A.299: store-fault tval = the faulting store VA (c_store_addr);
        // load-fault tval = c_fault_vaddr (set by the ROB inject port). A
        // commit-translated store never sets sh_fault_vaddr, so use c_store_addr.
        // M9.A.302: a REAL instruction page fault (c_is_ifault, not the
        // inject_fake_ifault hack) must set stval = the faulting instruction's
        // VA = c_pc (RISC-V priv spec). v4 previously fell through to 0, so the
        // kernel's do_page_fault saw fault-address 0, found no VMA, and SIGSEGV'd
        // init on the demand fault of its entry page (PC 0x10070) → "kill init".
        i_trap_tval: if inject_fake_ifault ?
            c_pc + 64'd4
        : if c_is_ifault ?
            c_pc
        : if c_is_lfault ?
            c_fault_vaddr
        : if commit_store_sfault ?
            c_store_addr
        : if c_is_sfault ?
            c_fault_vaddr
        : if (c_illegal || commit_priv_illegal) && !commit_virt_instr ?
            // Illegal-instruction (cause 2): mtval/stval = the faulting
            // instruction encoding (RISC-V priv spec — Sail writes it, and ACT4
            // checks it). commit_virt_instr (cause 22) is excluded; it keeps the
            // legacy tval=0 used by the hypervisor path. For an RVC illegal op
            // c_instr is the expander's 32-bit form; the priv suites use 32-bit
            // privileged instructions, so this matches their golden signature.
            {32'd0, c_instr}
        :
            64'd0
        ,
        i_mret_fire   : commit_mret  ,
        o_mtvec       : csr_mtvec    ,
        o_mepc        : csr_mepc     ,
        o_stvec       : csr_stvec    ,
        o_dbg_stval   : dbg_csr_stval,
        o_dbg_mtval   : dbg_csr_mtval,
        o_sepc        : csr_sepc     ,
        o_medeleg     : csr_medeleg_w,
        o_mideleg     : csr_mideleg_w,
        o_satp        : csr_satp     ,
        o_priv        : csr_priv     ,
        o_priv_prev   : csr_priv_prev,
        o_mstatus_sum : csr_sum      ,
        o_mstatus_mxr : csr_mxr      ,
        o_mstatus_mprv: csr_mprv     ,
        o_mstatus_mpp : csr_mpp      ,
        o_mstatus_tvm : csr_tvm      ,
        o_mstatus_tsr : csr_tsr      ,
        o_mstatus_fs  : csr_fs       ,
        // Phase 12 V0: vector state + config feedback.
        o_mstatus_vs  : csr_vs       ,
        i_vset_wr     : rob_commit_valid && c_vset_wen && !c_illegal && !commit_priv_illegal,
        i_set_vtype   : c_vtype      ,
        i_set_vl      : c_vl         ,
        o_vtype       : csr_vtype    ,
        o_vl          : csr_vl       ,
        // Phase 12 V1: a committing vector mem op writes vstart (fault element,
        // else 0). Gated like i_vset_wr (a VS-disabled / priv-illegal vector op
        // traps before reaching here and must not perturb vstart).
        i_vstart_wr   : rob_commit_valid && c_vstart_wen && !c_illegal && !commit_priv_illegal && !commit_vec_disabled,
        i_vstart_val  : c_vstart     ,
        o_vstart      : csr_vstart   ,
        o_menvcfg_pbmte: csr_pbmte   ,
        o_menvcfg_adue : csr_adue    ,
        o_pmpcfg       : csr_pmpcfg  ,
        o_pmpaddr      : csr_pmpaddr ,
        // Phase 11-H two-stage MMU state.
        o_virt         : csr_virt    ,
        o_mstatus_mpv  : csr_mpv     ,
        o_hgatp        : csr_hgatp   ,
        o_vsatp        : csr_vsatp   ,
        o_vsstatus_sum : csr_vs_sum  ,
        o_vsstatus_mxr : csr_vs_mxr  ,
        o_vsstatus_fs  : csr_vs_fs   , // Phase 11-H A1: guest FP unit state
        o_hstatus_spvp : csr_spvp    , // Phase 11-H HLV/HSV effective priv select
        o_hstatus_hu   : csr_hstatus_hu, // Phase 11-H B: HLV/HSV allowed in HS-U
        o_hstatus_vtvm : csr_hstatus_vtvm, // Phase 11-H B: trap VS satp/sfence
        o_hstatus_vtsr : csr_hstatus_vtsr, // Phase 11-H B: trap VS sret
        // Phase 11-H3 VS trap delegation.
        o_virt_prev    : csr_virt_prev,
        o_hedeleg      : csr_hedeleg ,
        o_hideleg      : csr_hideleg ,
        o_vstvec       : csr_vstvec  ,
        o_vsepc        : csr_vsepc   ,
        o_pmm_m        : csr_pmm_m   ,
        o_pmm_s        : csr_pmm_s   ,
        o_pmm_u        : csr_pmm_u   ,
        i_sret_fire   : commit_sret  ,
        i_trap_to_s   : trap_to_s    ,
        i_trap_to_vs  : trap_to_vs   ,
        i_htval       : trap_htval   ,
        i_trap_gva    : trap_gva     ,
        // M8.C: external IRQ pins from harness (tie low when unused).
        i_irq_timer_m: i_irq_timer_m                   ,
        i_irq_sw_m   : i_irq_sw_m                      ,
        i_irq_ext_m  : i_irq_ext_m                     ,
        i_irq_ext_s  : i_irq_ext_s                     ,
        o_irq_pending: csr_irq_pending                 ,
        o_irq_cause  : csr_irq_cause                   ,
        o_irq_to_s   : csr_irq_to_s                    ,
        o_irq_to_vs  : csr_irq_to_vs                   ,
        i_instret_en : rob_commit_valid && !commit_trap,
        // M6: fcsr — frm to the FPU; accrue fflags from a committing FP op.
        o_frm        : csr_frm                                                          ,
        i_fflags_set : rob_commit_valid && c_fflags_wen && !c_illegal && !commit_priv_illegal,
        i_fflags     : c_fflags                                                         ,
        // Phase 12 V5a: OR vxsat from a committing saturating op that saturated.
        i_vxsat_set  : rob_commit_valid && c_vxsat && !c_illegal && !commit_priv_illegal,
        o_vxrm       : csr_vxrm                                                         ,
        // P10 Zihpm: per-cycle event bus (packed near the perf-counter block).
        i_hpm_events : hpm_events                                                       ,
    );

    // Debug observation of CSR / trap state (for boot debug).
    assign o_dbg_sepc             = csr_sepc;
    assign o_dbg_mepc             = csr_mepc;
    assign o_dbg_priv             = if csr_priv == csr_pkg::PrivLevel::MACHINE ?
        2'b11
    : if csr_priv == csr_pkg::PrivLevel::SUPERVISOR ?
        2'b01
    :
        2'b00
    ;
    assign o_dbg_trap_fire        = commit_trap;
    assign o_dbg_trap_pc          = c_pc;
    assign o_dbg_trap_cause       = trap_cause;
    assign o_dbg_trap_to_s        = trap_to_s;
    assign o_dbg_satp             = csr_satp;
    assign o_dbg_imem_vaddr       = fetch_vaddr;
    assign o_dbg_imem_paddr       = imem_paddr_w;
    assign o_dbg_imem_valid       = imem_valid_w;
    assign o_dbg_imem_fault       = imem_fault_w;
    assign o_dbg_csrwr_v          = commit_csrwr;
    assign o_dbg_csrwr_addr       = c_csr_addr;
    assign o_dbg_csrwr_wdata      = c_csr_wdata;
    assign o_dbg_ptw_req          = imem_ptw_req_w;
    assign o_dbg_ptw_addr         = imem_ptw_addr_w;
    assign o_dbg_ptw_data         = i_dmem_rdata;
    assign o_dbg_redirect_fire    = redirect_fire;
    assign o_dbg_redirect_pc      = redirect_pc;
    assign o_dbg_redirect_src_pc  = c_pc;
    assign o_dbg_alu_pc_out       = dbg_alu_pc;
    assign o_dbg_alu_src_a_out    = dbg_alu_src_a;
    assign o_dbg_alu_src_b_out    = dbg_alu_src_b;
    assign o_dbg_alu_use_pc_a_out = dbg_alu_use_pc_a;
    assign o_dbg_alu_rs1_data_out = dbg_alu_rs1_data;
    assign o_dbg_alu_valid_out    = dbg_alu_valid;
    assign o_dbg_alu_alu_out_out  = dbg_alu_alu_out;
    assign o_dbg_alu_instr_out    = dbg_alu_instr;
    assign o_dbg_alu_imm_out      = dbg_alu_imm;
    assign o_dbg_stval_out        = dbg_csr_stval;
    assign o_dbg_mtval_out        = dbg_csr_mtval;
    assign o_dbg_stvec_out        = csr_stvec;
    assign o_dbg_mtvec_out        = csr_mtvec;

    // ============================================================
    // Redirect (commit-time mispredict / trap / mret)
    // ============================================================
    // M9.A.288: redirect_fire_q declared earlier in module (used by
    // commit_irq gate). Kept var redirect_pc_q here.
    var redirect_pc_q: logic<64>;
    // Trap vector target (M5.D: trap to S → stvec, else mtvec).  Direct mode
    // (tvec[0]=0): all traps → base.  Vectored mode (tvec[0]=1): interrupts →
    // base + 4*cause_number; synchronous exceptions still → base.  (RISC-V
    // priv spec; matches v1 heliodor_core.veryl trap_target.)
    // Phase 11-H3: a trap delegated to VS uses vstvec (the guest's trap vector).
    let trap_tvec_sel : logic<64> = if trap_to_vs ? csr_vstvec : if trap_to_s ? csr_stvec : csr_mtvec;
    let trap_tvec_base: logic<64> = trap_tvec_sel & 64'hffff_ffff_ffff_fffc;
    let trap_target   : logic<64> = if trap_tvec_sel[0] && commit_irq ?
        trap_tvec_base + {48'd0, trap_cause[13:0], 2'b00}
    :
        trap_tvec_base
    ;
    // Phase 8 M1: commit-time mispredict. The architectural next PC of the
    // committing op is its resolved target (carried as c_redirect_pc by
    // execute) for a control op, else the fall-through pc+len. A mismatch with
    // the frontend's chosen next PC (c_pred_next_pc) is a misprediction. This
    // unifies branch/jal/jalr today and (M2+) BTB false-hit / mis-target
    // recovery: a non-control op's arch_next_pc is always pc+len, so a stray
    // prediction self-corrects to the fall-through.
    let c_fall_pc      : logic<64> = c_pc + (if c_is_rvc ? 64'd2 : 64'd4);
    let c_arch_next_pc : logic<64> = if c_is_control ? c_redirect_pc : c_fall_pc;
    // A NON-CONTROL op can mispredict (c_pred_next_pc != fall-through) only under a
    // predictor-override / FTB-follow (F1/F2): the frontend delivered a non-sequential
    // successor after a non-branch (a stale/wrong FTB target). The commit-time redirect
    // then re-steers to the op's fall-through — but if that op is a STORE still waiting to
    // drain (rob_commit_valid=1 yet rob_commit_ack=0: sb_elig / store_fetched_q / dcache
    // gating above), firing the redirect on rob_commit_valid FLUSHES the store before it
    // retires, and the re-steer to fall-through SKIPS it (the store's memory write is lost
    // → corrupted stack, the f2.4 corner-3 `c.swsp` skip). Gate the NON-CONTROL mispredict
    // on rob_commit_ack so the store retires (executes) first, then the redirect flushes
    // the wrong-path successor. Control ops keep rob_commit_valid (they retire as soon as
    // rob_commit_valid, barring a replay that already dominates commit_redirect) — the
    // `c_is_control` escape preserves the exact baseline. DEAD/byte-identical without a
    // predictor-override: a non-control op then always has pred_next == fall-through, so
    // c_bp_mispredict is 0 for it regardless of the added term.
    let c_bp_mispredict: logic     = rob_commit_valid && (c_pred_next_pc != c_arch_next_pc)
        && (c_is_control || rob_commit_ack);
    // ── f2.20 PROBE: is the coremark mispredict doubling actually the RETURNS? ── DEAD at 0 ──
    // f2.20 delivers descriptor returns and coremark's committed mispredicts went 90 -> 183 while
    // dhrystone and the N=1 boot improved. The missing-RAS-pop hypothesis was tested and REFUTED
    // (the added pop was bit-identical). Before guessing again: split the count by kind, and print
    // the offending returns with predicted vs architectural target so the failure names itself.
    const MISP_PROBE: bit = 0;
    var mp_ret : logic<32>;
    var mp_oth : logic<32>;
    always_ff (clk, rst) {
        if_reset {
            mp_ret = 32'd0;
            mp_oth = 32'd0;
        } else if MISP_PROBE {
            if c_bp_mispredict {
                if c_is_ret {
                    mp_ret = mp_ret + 32'd1;
                    if mp_ret <: 32'd24 {
                        $display("MISP-RET n=%d pc=%h pred=%h arch=%h", mp_ret, c_pc, c_pred_next_pc, c_arch_next_pc);
                    }
                } else {
                    mp_oth = mp_oth + 32'd1;
                    if mp_oth <: 32'd8 {
                        $display("MISP-OTH n=%d pc=%h pred=%h arch=%h call=%b cond=%b", mp_oth, c_pc, c_pred_next_pc, c_arch_next_pc, c_is_call, c_is_cond);
                    }
                }
            }
            if c_is_ret && rob_commit_ack {
                // total committed returns, for the rate
                mp_oth = mp_oth;
            }
        }
    }

    // An async interrupt's epc must be the architectural successor of the LAST
    // COMMITTED instruction — a commit-side quantity. It used to be read off the
    // front end (`if_v_q ? if_pc_q : ic_pc`) under a `rob_size == 0` guard, but
    // those are SPECULATIVE fetch pointers: draining the ROB says nothing about the
    // FETCH pipeline, and ic_pc runs ahead of the architectural PC by an amount
    // that varies with front-end depth and timing. Observed on a Linux boot: an
    // interrupt was taken while a `jal` was still inside the fetch pipe with the
    // fetch buffer already empty, so ic_pc pointed at that jal's FALL-THROUGH; epc
    // skipped the jal and sret resumed PAST a taken jump, silently dropping a call
    // and leaving its return register stale (init then SIGSEGV'd on the garbage
    // pointer). Nothing downstream can catch it: sret really does branch to epc, so
    // the committed PC stream stays self-consistent and only a register value is
    // wrong. Rare — one occurrence per ~15 M-cycle boot — and any front-end timing
    // change moves whether it is hit at all.
    //
    // Slot-1 commit is restricted to non-control ops (rob's c2_simple), so its
    // successor is pc+len; slot 0 uses the full c_arch_next_pc. A commit redirect
    // re-points the architectural PC at its target, so track that too (the same
    // value pc_q takes). The EARLY (execute-time) redirect is deliberately NOT
    // tracked: it is speculative, and its branch has not committed.
    let c2_arch_next_pc: logic<64> = c2_pc + (if c2_is_rvc ? 64'd2 : 64'd4);
    always_ff (clk, rst) {
        if_reset {
            arch_next_pc_q = RESET_PC;
        } else if redirect_fire {
            arch_next_pc_q = redirect_pc;
        } else if commit2_fire {
            arch_next_pc_q = c2_arch_next_pc;
        } else if rob_commit_ack {
            arch_next_pc_q = c_arch_next_pc;
        }
    }
    // Phase 8 M2: predictor training at retire. c_taken = a committed control
    // op went taken (its resolved target differs from the fall-through). Train
    // the BTB on every taken control op (allocate/refresh target + conditional
    // flag); train the BHT on every conditional branch toward its real
    // direction. rob_commit_ack (not _valid) so a held store/AMO trains once.
    assign btb_train_en      = rob_commit_ack && c_is_control && (c_redirect_pc != c_fall_pc);
    assign bht_train_en      = rob_commit_ack && c_is_cond;
    assign bp_train_pc       = c_pc;
    // f2.15e: a 32-bit control transfer at halfword offset 3 STRADDLES into the next dword, so it can
    // never be a block exit (see blkpred's i_train_en). The F0 FTB excludes the same shape.
    assign blk_train_straddle = !c_is_rvc && (c_pc[2:1] == 2'b11);
    assign btb_train_target  = c_redirect_pc;
    assign btb_train_is_cond = c_is_cond;
    assign btb_train_is_call = c_is_call;
    assign btb_train_is_ret  = c_is_ret;
    assign bht_train_taken   = c_is_control && (c_redirect_pc != c_fall_pc);
    assign bht_train_index   = c_pred_index;
    // S18: iBTB training — every committed non-return JALR writes its resolved
    // target at its fetch-time index (last-target per (PC, path)). The
    // PRE-update committed_ind_hist read here equals the op's fetch-time
    // spec_ind_hist (see the spec_ind_hist comment), so no carried state is
    // needed. The BTB entry's is_ind kind bit marks the PC so fetch consults
    // the iBTB.
    assign btb_train_is_ind  = rob_commit_entry.is_jalr && !c_is_ret;
    assign ibtb_train_en     = btb_train_en && btb_train_is_ind;
    assign ibtb_train_index  = c_pred_index[8:0] ^ committed_ind_hist;
    // S18 indirect path history (committed twin; fold = shift-2 XOR target).
    always_ff (clk, rst) {
        if_reset {
            committed_ind_hist = 9'd0;
        } else if rob_commit_ack && rob_commit_entry.is_jalr && !c_is_ret {
            committed_ind_hist = {committed_ind_hist[6:0], 2'b00} ^ c_redirect_pc[9:1];
        }
    }
    // M3 RAS architectural update: a committed call pushes its return address
    // (the fall-through PC); a committed return pops. On a redirect the
    // speculative RAS is restored from this architectural stack.
    assign ras_arch_push      = rob_commit_ack && c_is_call;
    assign ras_arch_pop       = rob_commit_ack && c_is_ret;
    assign ras_arch_push_addr = c_fall_pc;
    // M4 gshare global history. committed_ghr shifts in each committed
    // conditional branch's actual direction; spec_ghr shifts in the predicted
    // direction at fetch and is restored from committed_ghr on a flush. Because
    // redirect_fire lags the commit by one cycle, committed_ghr has already
    // absorbed the redirecting branch's outcome by the recovery cycle, so the
    // restore is exact.
    let c_dir_taken: logic = c_redirect_pc != c_fall_pc; // control op went taken
    always_ff (clk, rst) {
        if_reset {
            committed_ghr   = 13'd0;
            committed_ghr_l = '0;
        } else if rob_commit_ack && c_is_cond {
            committed_ghr = {committed_ghr[11:0], c_dir_taken};
            // S22: the long twin folds ONLY instances the speculative side
            // also folded (BTB-hit cond branches; never-taken branches never
            // enter the BTB, commit constantly, and would otherwise make the
            // two history streams diverge — fetch would then look TAGE up at
            // indices training never writes).
            if c_ghr_fold {
                committed_ghr_l = {committed_ghr_l[53:0], c_dir_taken};
            }
        }
    }
    // S22 TAGE training — every committed conditional branch. The tables
    // re-read themselves at indices recomputed from the PRE-update
    // committed_ghr_l (== the op's fetch-time spec_ghr_l, same proof as the
    // S18 iBTB). The mispredict input is the fetch-time DIRECTION error:
    // most direction mispredicts resolve via the S8.E early redirect, whose
    // redir_fix patches sh_pred_next_pc (erasing the mismatch from the
    // commit-time compare) — c_early_fix preserves them (a cond branch's
    // taken target is PC-relative-fixed, so an early redirect on a cond
    // branch IS a direction error). The pred_next_pc compare catches the
    // residue that resolves at commit.
    let c_dir_pred_taken: logic = c_pred_next_pc != c_fall_pc;
    assign tage_train_en      = rob_commit_ack && c_is_cond;
    assign tage_train_taken   = c_dir_taken;
    assign tage_train_mispred = c_early_fix || (c_dir_pred_taken != c_dir_taken);
    // Phase 8 S4a.3: gshare spec history shifts in the predicted direction of
    // each delivered conditional branch — up to two per cycle (slot-0 then
    // slot-1). A slot-0 predicted-taken cond branch kills slot-1, so the
    // both-cond case only arises when slot-0 went not-taken (cond_taken0=0).
    // S22: the shifted bit is the FINAL predicted direction (TAGE over BHT)
    // so the spec history mirrors what committed_ghr will record when the
    // prediction is right; the 55-bit long twin shifts identically.
    // F1 order-item-3 (A): keyed on the Stage-B delivery (deliver0/1) so the spec history shifts in
    // the RESOLVED direction (cond_taken0/1 from the clocked outputs aligned to the drained bundle).
    // Folds to the Stage-A push at PRED_OVERRIDE=0.
    let ghr_upd0: logic = deliver0 && btb_hit && btb_is_cond;
    let ghr_upd1: logic = deliver1 && btb_hit2 && btb_is_cond2;
    always_ff (clk, rst) {
        if_reset {
            spec_ghr   = 13'd0;
            spec_ghr_l = '0;
        } else if any_redirect {
            // Phase 8 S8.E: restore spec history on an early redirect too. Like the
            // RAS restore, this is an approximation (committed_ghr lags the resolved
            // branch by the in-flight conditional branches between it and the commit
            // head) — accuracy-only, not a correctness requirement for gshare.
            spec_ghr   = committed_ghr;
            spec_ghr_l = committed_ghr_l;
        } else if ghr_upd0 && ghr_upd1 {
            spec_ghr   = {spec_ghr[10:0], cond_taken0, cond_taken1};
            spec_ghr_l = {spec_ghr_l[52:0], cond_taken0, cond_taken1};
        } else if ghr_upd0 {
            spec_ghr   = {spec_ghr[11:0], cond_taken0};
            spec_ghr_l = {spec_ghr_l[53:0], cond_taken0};
        } else if ghr_upd1 {
            spec_ghr   = {spec_ghr[11:0], cond_taken1};
            spec_ghr_l = {spec_ghr_l[53:0], cond_taken1};
        }
    }
    // S18 indirect path history (speculative twin): fold each delivered
    // predicted indirect's target; restore on any flush (same approximation
    // as spec_ghr above). A slot-0 indirect is predicted taken, which kills
    // slot-1 delivery, so at most one indirect folds per cycle.
    let ind_upd0: logic = deliver0 && btb_hit && btb_is_ind; // F1 3(A): Stage-B delivery (folds to fb_push0 at 0)
    let ind_upd1: logic = deliver1 && btb_hit2 && btb_is_ind2;
    always_ff (clk, rst) {
        if_reset {
            spec_ind_hist = 9'd0;
        } else if any_redirect {
            spec_ind_hist = committed_ind_hist;
        } else if ind_upd0 {
            spec_ind_hist = {spec_ind_hist[6:0], 2'b00} ^ pred_target[9:1];
        } else if ind_upd1 {
            spec_ind_hist = {spec_ind_hist[6:0], 2'b00} ^ pred_target1[9:1];
        }
    }
    always_ff (clk, rst) {
        if_reset {
            redirect_fire_q = 1'b0;
            redirect_pc_q   = 64'd0;
        } else if commit_trap {
            redirect_fire_q = 1'b1;
            redirect_pc_q   = trap_target;
        } else if commit_mret {
            redirect_fire_q = 1'b1;
            redirect_pc_q   = csr_mepc;
        } else if commit_sret {
            redirect_fire_q = 1'b1;
            // Phase 11-H3b: a VS-mode SRET (V=1) returns to vsepc, not sepc.
            // csr_virt still holds the guest's V=1 here (the SRET's mode update
            // is registered this same cycle). Inert at V=0 (picks sepc).
            redirect_pc_q   = if csr_virt ? csr_vsepc : csr_sepc;
        } else if c_bp_mispredict {
            redirect_fire_q = 1'b1;
            redirect_pc_q   = c_arch_next_pc;
        } else if sc_watch_valid_q && rob_commit_valid && rob_commit_idx == sc_watch_rob_q && sc_poison_q {
            // M9.4 SMP: a poisoned SC (remote write hit its reserved line
            // between execute and commit) — its store was suppressed; re-fetch
            // the SC so it re-evaluates against the (now-cleared) reservation
            // and correctly fails (rd=1). Mirrors the mispredict redirect but
            // targets the SC's own PC. Condition is inlined here (the equivalent
            // `commit_sc_replay` let is defined later, near the SC-watch logic).
            redirect_fire_q = 1'b1;
            redirect_pc_q   = c_pc;
        } else if amo_watch_valid_q && rob_commit_valid && rob_commit_idx == amo_watch_rob_q && amo_poison_q {
            // P9.3: a poisoned in-cache AMO (its line departed between the
            // value capture and the commit write) — store suppressed,
            // re-fetch the AMO so it re-acquires ownership and re-reads.
            // (= commit_amo_replay, inlined like the SC arm above.)
            redirect_fire_q = 1'b1;
            redirect_pc_q   = c_pc;
        } else if rob_commit_valid && c_load_poison {
            // Phase 8 S9: a poisoned LOAD at commit — re-fetch its own PC so it
            // re-executes against the now-committed older store (correct data),
            // full-flushing the wrong-path younger consumers. Mirrors the SC arm
            // above (condition inlined; the `commit_load_replay` let is later).
            redirect_fire_q = 1'b1;
            redirect_pc_q   = c_pc;
        } else if commit_csrw_satp {
            // M9 (2026-05-25): csrw satp implicit redirect (see comment at
            // commit_csrw_satp). Re-fetch the next instruction with the
            // new satp so any low-half PC fetches that should fault, do.
            redirect_fire_q = 1'b1;
            redirect_pc_q   = c_pc + 64'd4;
        } else if commit_csrw_frm {
            // P10: csrw frm/fcsr implicit redirect — re-fetch the successor so a
            // younger dynamic-rounding FP op reads the updated rounding mode.
            redirect_fire_q = 1'b1;
            redirect_pc_q   = c_pc + 64'd4;
        } else if commit_fence_i_pulse {
            // S14 fix (latent bug surfaced by the MSHR early restart speeding
            // up commit): FENCE.I must also RE-FETCH its successors, not just
            // flush the icache. Straight-line code right after the fence can
            // itself be patched by prior stores (riscv-tests fence_i test 2
            // patches fence+8), and stale speculatively-fetched copies of those
            // instructions may already sit in the fetch buffer / ROB when the
            // fence commits. Full flush + refetch through the just-flushed
            // icache, mirroring the csrw-satp implicit redirect. FENCE.I has no
            // RVC form, so the successor is always c_pc+4.
            redirect_fire_q = 1'b1;
            redirect_pc_q   = c_pc + 64'd4;
        } else if commit_vstore {
            // Phase 12 V1: a committing vector STORE overwrote cache lines that
            // younger speculative loads may already have read with stale data.
            // The VU streams stores non-speculatively at the ROB head, so all
            // such loads are younger — squash them and re-fetch from the next PC
            // (Rule B vector-store / younger-load ordering, correctness-first;
            // a precise replay is a later optimization). Vector ops are 4 bytes.
            redirect_fire_q = 1'b1;
            redirect_pc_q   = c_pc + 64'd4;
        } else if cas_q_retire {
            // Zacas amocas.q: it does not rename rd:rd+1 (the loaded old pair is
            // written into their existing physical regs in place at this commit).
            // Younger ops may have read the stale pair before this write, so flush
            // and re-fetch from the successor. amocas.q has no RVC form (c_pc+4).
            redirect_fire_q = 1'b1;
            redirect_pc_q   = c_pc + 64'd4;
        } else {
            redirect_fire_q = 1'b0;
        }
    }
    assign redirect_fire = redirect_fire_q;
    assign redirect_pc   = redirect_pc_q;

    // ============================================================
    // arch_regs shadow (debug/cosim)
    // ============================================================
    var arch_regs: logic<64> [32];
    always_ff (clk, rst) {
        if_reset {
            for r in 0..32 {
                arch_regs[r] = 64'd0;
            }
        } else {
            if rob_commit_valid && c_has_rd && !c_illegal {
                for r in 1..32 {
                    if c_rd_arch == (r as 5) {
                        arch_regs[r] = c_result_data;
                    }
                }
            }
            // Phase 8 S1: commit slot-1 — ordered AFTER slot-0 so a same-rd WAW
            // leaves the younger (slot-1) value. x3 (boot pass/fail) is sourced
            // from here, so slot-1 writes MUST be reflected.
            if commit2_fire && c2_has_rd {
                for r in 1..32 {
                    if c2_rd_arch == (r as 5) {
                        arch_regs[r] = c2_result_data;
                    }
                }
            }
            // Zacas amocas.q: write the loaded old 128-bit value into the rd:rd+1
            // pair (the architectural mirror; the PRF is written in place via
            // ports 3/4). rd=x0 discards the whole pair (x0 and x1 unchanged), so
            // gate on rd!=x0. The compare reads above (cas_q_cmp_*) see the OLD
            // values (NBA).
            if cas_q_retire && c_rd_arch != 5'd0 {
                for r in 1..32 {
                    if c_rd_arch == (r as 5) {
                        arch_regs[r] = c_cas_q_mem_lo;
                    }
                    if (c_rd_arch + 5'd1) == (r as 5) {
                        arch_regs[r] = c_cas_q_mem_hi;
                    }
                }
            }
        }
    }
    assign o_dbg_regs = arch_regs;
    assign o_dbg_x3   = arch_regs[3];

    // P9.5: SFENCE.VMA selective-flush operands. Placed after arch_regs is
    // declared; the values are stable at the (serialized) sfence commit so
    // arch_regs holds the resolved rs1 (VA) / rs2 (ASID). rs*==x0 selects the
    // wildcard (all-addresses / all-ASIDs) variant. Drives the forward-declared
    // vars consumed by the imem/dmem MMU instances.
    assign sfence_vaddr    = arch_regs[c_sfence_rs1];
    assign sfence_asid     = arch_regs[c_sfence_rs2][15:0];
    assign sfence_rs1_zero = c_sfence_rs1 == 5'd0;
    assign sfence_rs2_zero = c_sfence_rs2 == 5'd0;
    assign o_dbg_pc   = c_pc;


    // ============================================================
    // Retire stream (lane A only in M1)
    // ============================================================
    // v1 does not emit a retire-valid pulse for MRET / ECALL / EBREAK
    // (they go through a separate squash path in EX). To keep the
    // cosim FIFO order aligned, gate v4's retire-valid the same way.
    // M9.A.241 (2026-05-26): also suppress when inject_fake_ifault fires.
    // v1 squashes the csrw satp itself (the natural IFU-fault entry of the
    // next instruction replaces it before it can retire), so v1 doesn't
    // count csrw satp as a retire on the trampoline transition. v4's
    // inject_fake_ifault, in contrast, pops the csrw satp ROB entry first
    // (counted) and only THEN traps — creating a 1-retire offset between
    // v1 and v4 retire streams, manifesting as cosim divergence at #76991
    // with v1pc=high-half auipc (= stvec target) and v4pc=low-half csrw satp.
    // M9.A.265: gate on rob_commit_ack (= actual commit), not just
    // rob_commit_valid. M9.A.255-b stalls rob_commit_ack when a store is
    // committing during dmem_mmu_busy (multi-cycle PTW). rob_commit_valid
    // stays 1 across the stall, so retire previously fired multiple times
    // for the same store — corrupting retire-stream observers (cosim,
    // ret_total counter, IPC stats). Found via M9.A.264 cosim: v4 retire
    // ring had duplicate entries for `sw sp, 32(tp)` at PC 0x800010f8.
    // M9.A.305: ECALL/EBREAK ARE emitted to the retire stream to match v1
    // (heliodor_core.veryl:4800 o_dbg_retire_v_a = rob_commit_valid, which is
    // asserted for a committing ecall/ebreak — a synchronous exception that
    // commits at the head before redirecting). Cosim @cy630141 proved v1
    // emits the ecall retire (pc=...39c2, rdv=0) while v4 jumped straight to
    // the trap handler (pc=0xa0) — a benign retire-dbg off-by-one, NOT an
    // execution bug (v4 correctly traps to mtvec=0xa0 and reads mcause=9).
    // mret/sret stay excluded (they redirect/squash in v1 → no commit_valid);
    // illegal/fake_ifault stay excluded pending a proven mid-stream divergence.
    assign o_dbg_retire_v_a    = rob_commit_ack && !c_illegal && !c_is_mret && !c_is_sret && !inject_fake_ifault;
    assign o_dbg_retire_pc_a   = c_pc;
    assign o_dbg_retire_rd_v_a = c_has_rd;
    assign o_dbg_retire_rd_a   = c_rd_arch;
    assign o_dbg_retire_data_a = c_result_data;

    // ============================================================
    // dmem ports (M2: toy memory — combinational read, registered
    // write at commit time)
    // ============================================================
    // LOAD read: drive dmem read address when an issued op is a LOAD.
    // Address comes from rs1 + imm (same as the alu_wrap AGU).
    // M5.A AMO: address = rs1 alone (no immediate). LR / AMO* need a
    // read at issue time; SC is write-only at commit time.
    // Use per-field outputs from iq_int (struct-field READ has sim bug).
    let amo_is_sc_iss : logic     = iq_iss_amo_funct5 == 5'b00011;
    let agu_imm_iss   : logic<64> = if iq_iss_is_amo ? 64'd0 : iq_issue_op.base.imm;
    // P10 Supm/Ssnpm: the actual load/AMO access address sent to the MMU/dcache
    // comes from here (not u_alu's internal agu), so it must get the same pointer
    // masking u_alu applies — otherwise the access and u_alu's data formatting /
    // fault VA would diverge. PMM=0 → agu_addr_iss == agu_raw_iss (no-op).
    // A-EXE E2: the AGU base register needs the SAME lane-0 bypass as the ALU
    // operands — at EX_PIPE=1 a load/store/AMO whose rs1 base was just produced by
    // a lane-0 ALU op reads the registered result from alu_cdb_q, not the stale PRF
    // (prf_rs1_data_b == prf_rs1_data at EX_PIPE=0 → byte-identical).
    let agu_raw_iss   : logic<64> = prf_rs1_data_b + agu_imm_iss;
    // agu_addr_iss declared earlier (forward-ref for u_lsu); assigned here.
    always_comb {
        case pm_mode {
            2'b10  : agu_addr_iss = {(if pm_va ? agu_raw_iss[56] : 1'b0) repeat 7, agu_raw_iss[56:0]};
            2'b11  : agu_addr_iss = {(if pm_va ? agu_raw_iss[47] : 1'b0) repeat 16, agu_raw_iss[47:0]};
            default: agu_addr_iss = agu_raw_iss;
        }
    }
    // R3.2c (§6.5): the ISSUE-side without-return class. It is the decode half of
    // asq_class (`c_rd_arch == 0`, a real RMW funct5, not amocas.q) — deliberately
    // PA-INDEPENDENT, because the read/no-read decision has to be made in the same
    // cycle the MMU produces the PA. The cacheability half of asq_class is handled
    // after the fact by the poison-replay (see amo_fread_q / the amo watch below).
    // amo_fread_q is the replay's own escape: while it is set the atomic reads
    // normally, so the fallback can never loop. Constant 0 at ASQ_NOREAD=0.
    assign asq_nr_iss = ASQ_NOREAD && iq_issue_valid && iq_iss_is_amo && !iq_iss_is_cas_q
        && iq_issue_op.base.rd_arch == 5'd0 && !amo_fread_q
        && iq_iss_amo_funct5 != 5'b00010 && iq_iss_amo_funct5 != 5'b00011 && iq_iss_amo_funct5 != 5'b00101;
    // An AMO/LR at issue: it TRANSLATES (drives the dmem MMU for its PA + fault check)
    // — every atomic still does this, the class included, so fault precision and the
    // ac_*_q capture are untouched by R3.2c. issue_amo_read is the narrower "…and
    // needs the data READ" (the RFO, the fetch/access handshake, the RMW watch): at
    // ASQ_NOREAD=0 the two are identical and every gate below folds to today's.
    let issue_amo_xlat: logic     = iq_issue_valid && iq_iss_is_amo && !amo_is_sc_iss;
    let issue_amo_read: logic     = issue_amo_xlat && !asq_nr_iss;
    let issue_is_load : logic     = (iq_issue_valid && iq_issue_op.base.is_load) || issue_amo_xlat;
    // A misaligned atomic must ACCESS-fault (cause 5 LR / 7 AMO) regardless of
    // the page mapping — Sail checks alignment before translation, so an unmapped
    // VA never page-faults. heliodor still walks (via the AMO read), so when that
    // walk faults we must force the injected fault to an ACCESS fault (mirrors
    // alu_wrap's amo_misalign, which already covers the walk-succeeds path at
    // issue). Width from mem_funct3; low bits survive pointer masking, so
    // agu_addr_iss[3:0] is correct. (B/.B never misaligns.)
    let iss_amo_misalign: logic = iq_iss_is_amo && (
        if iq_issue_op.base.mem_funct3 == 3'b000 ? 1'b0
        : if iq_issue_op.base.mem_funct3 == 3'b001 ? (agu_addr_iss[0] != 1'b0)
        : if iq_issue_op.base.mem_funct3 == 3'b010 ? (agu_addr_iss[1:0] != 2'd0)
        : if iq_issue_op.base.mem_funct3 == 3'b011 ? (agu_addr_iss[2:0] != 3'd0)
        : (agu_addr_iss[3:0] != 4'd0)
    );
    // Phase 8 S5.2: slot-1 (pipe-1) LOAD effective address for the 2nd dcache read
    // port. alu_wrap (u_alu2) re-derives the same agu internally; this drives the
    // dcache i_addr2 and the 2nd forward network. Slot-1 never issues AMO/STORE
    // (pipe1_ok), so the immediate is always the load offset (no AMO-zero case).
    let agu_raw_iss2  : logic<64> = prf_rs1_data2_b + iq_issue_op2.base.imm;
    var agu_addr_iss2 : logic<64>; // P10 pointer masking (matches u_alu2 / slot-0)
    always_comb {
        case pm_mode {
            2'b10  : agu_addr_iss2 = {(if pm_va ? agu_raw_iss2[56] : 1'b0) repeat 7, agu_raw_iss2[56:0]};
            2'b11  : agu_addr_iss2 = {(if pm_va ? agu_raw_iss2[47] : 1'b0) repeat 16, agu_raw_iss2[47:0]};
            default: agu_addr_iss2 = agu_raw_iss2;
        }
    }
    let issue2_is_load: logic     = iq_issue_valid2 && iq_iss_is_load2;

    // PMP (Smpmp) on the bare-mode pipe-1 (slot-1) LOAD. Pipe-1 carries no
    // dmem_mmu, so its load address otherwise never reaches the PMP checker; a
    // load that HITS a cached line whose region was made PMP-inaccessible after a
    // prior allowed load filled it would silently bypass enforcement. A slot-1
    // load only fires in bare mode (ld2_complete requires !dmem_vm_on), so
    // agu_addr_iss2 is the physical address — a plain read (acc=0) PMP check.
    // A PMP-denied slot-1 load is held off slot-1 (ld2_complete &&
    // !slot1_pmp_deny) and re-issued on pipe-0, whose dmem_mmu raises the
    // (lane-0-plumbed) load access fault. (ACT4 PMPSm cfg_napot_all.)
    var slot1_pmp_deny: logic;
    inst u_pmp_slot1: pmp_check (
        i_addr   : agu_addr_iss2,
        i_acc    : 2'd0          , // pipe-1 only executes loads → read
        i_priv   : dmem_eff_priv ,
        i_pmpcfg : csr_pmpcfg    ,
        i_pmpaddr: csr_pmpaddr   ,
        o_fault  : slot1_pmp_deny,
    );
    // PMA: a pipe-1 bare load to an unbacked PA (hole) must also be held off
    // slot-1 and re-issued on pipe-0, whose dmem_mmu raises the load access fault.
    let slot1_pma_hole: logic = PMA_FAULT && !(agu_addr_iss2[31] || agu_addr_iss2[31:24] == 8'h02 || agu_addr_iss2[31:28] == 4'h1 || agu_addr_iss2[31:24] == 8'h0c);
    let slot1_load_deny: logic = slot1_pmp_deny || slot1_pma_hole;

    // ============================================================
    // Phase 8 S5.1: store-to-load forward byte-network (computed in the core so
    // the ROB store shadow + agu_addr_iss are forward-refs/local — a big comb
    // reading a backward-referenced cross-module array hangs the Veryl sim). For
    // each of the 8 bytes [agu_addr_iss, +7] the issuing LOAD consumes, override
    // the dcache byte with the YOUNGEST older forwardable store writing it. Each
    // store's data is aligned into the load frame ONCE (`asd`); the 8 scalar
    // accumulators (manually unrolled — a loop-var WRITE index hangs the sim) read
    // constant slices. stld_fwd_data is in the natural load frame (byte p = addr
    // agu_addr_iss+p, matching alu_wrap's ld_shifted); stld_fwd_mask gates it.
    // ============================================================
    // Phase 1 LSU 2-stage: the store→load forward network (ROB sf* + SB sbf* below)
    // is computed at STAGE B against the LSR's registered VA/PA and age — it is
    // active throughout the load's Stage B (lsr_v_q) and consumed on the completing
    // cycle. Older stores that committed between the load's Stage A and Stage B moved
    // from the ROB shadow into the SB; the combined ROB+SB net still covers them, so
    // the forward stays complete (just evaluated one cycle later than at issue).
    let stld_fwd_age: logic<ROB_IDX_W> = lsr_rob_idx_q - rob_head_idx;
    let stld_fwd_en : logic              = lsr_v_q;
    assign ls_addr = rob_store_addr;
    assign ls_data = rob_store_data;
    assign ls_f3   = rob_store_funct3;
    assign ls_fwd  = rob_store_fwdable;
    assign ls_pa   = rob_store_pa;
    assign ls_pa_v = rob_store_pa_v;
    // ── M2 / Block M lever (d): key this network on PHYSICAL addresses ──────────
    // This net is the UNCOMMITTED half of store->load forwarding and it compares
    // full VAs. The COMMITTED half (sbf*, below) already compares PAs
    // (`sbf_pa = lsr_paddr_q`), so the two halves of one mechanism disagree about
    // what an address is — and the disagreement is measurable: Block M's M1c found
    // 7,378 of the 7,627 record-time self-scan poisons on an N=1 boot are genuine
    // PHYSICAL overlaps whose VAs differ (0 attribution failures on either side).
    // Those are exactly the loads this net cannot serve today, so each one costs a
    // full commit-time replay (10.8 cy measured end to end).
    //
    // The swap is local because Stage B holds BOTH addresses of BOTH sides: the
    // load's `lsr_paddr_q` (this net is already evaluated against the LSR, and
    // lsr_v_q — the gate on the whole loop — is what makes that PA this load's,
    // the same predicate L3.2d's `lq_rec0_pa_v` uses) and the store's `ls_pa[i]`.
    // The choice is PER ENTRY so the two sides are never mixed: an entry with no
    // pre-translated PA keeps comparing VA to VA exactly as today.
    //
    // ⚠️ FLIP-COUPLED with load_queue.veryl's FWD_PA: the self-scan's S16 exemption
    // ("a full-VA overlap was forwarded, so only the alias case still poisons") is
    // the mirror image of this net's key. Flipping one without the other either
    // poisons loads that were served (no gain) or exempts loads that were not
    // (unsound).
    const FWD_PA: bit = 0; // MEASURED WORTH EXACTLY ZERO — see M2b in the plan doc:
    // with the port-1 exemption in place, flipping this to 1 gives a bit-identical
    // boot (same cycles, same 11,145 replays, same 16,556 suppressions). The
    // "genuine VA alias" reading of M1c was wrong: those poisons had overlapping VAs
    // too, they simply had no exemption on that port. Kept as a fold-away arm.
    var sf0_v: logic; var sf0_age: logic<ROB_IDX_W>; var sf0_b: logic<8>;
    var sf1_v: logic; var sf1_age: logic<ROB_IDX_W>; var sf1_b: logic<8>;
    var sf2_v: logic; var sf2_age: logic<ROB_IDX_W>; var sf2_b: logic<8>;
    var sf3_v: logic; var sf3_age: logic<ROB_IDX_W>; var sf3_b: logic<8>;
    var sf4_v: logic; var sf4_age: logic<ROB_IDX_W>; var sf4_b: logic<8>;
    var sf5_v: logic; var sf5_age: logic<ROB_IDX_W>; var sf5_b: logic<8>;
    var sf6_v: logic; var sf6_age: logic<ROB_IDX_W>; var sf6_b: logic<8>;
    var sf7_v: logic; var sf7_age: logic<ROB_IDX_W>; var sf7_b: logic<8>;
    // One always_comb per byte (each a single self-ref accumulator like iq_int's
    // oldest-ready select): 8 accumulators in ONE block made the combinational_loop
    // diagnostic falsely fuse them into a loop. p = byte position; la = agu+p.
    always_comb {
        sf0_v = 1'b0; sf0_age = '0; sf0_b = 8'd0;
        if stld_fwd_en { for i in 0..ROB_DEPTH {
            let age_i: logic<ROB_IDX_W> = (i as ROB_IDX_W) - rob_head_idx;
            let upa: logic = FWD_PA && ls_pa_v[i];
            let sa: logic<64> = if upa ? ls_pa[i] : ls_addr[i];
            let la: logic<64> = (if upa ? lsr_paddr_q : lsr_vaddr_q) + 64'd0;
            let cov: logic = ls_fwd[i] && (age_i <: stld_fwd_age) && (la >= sa) && (la <: sa + ((5'd1 << ls_f3[i][1:0]) as 64));
            let off: logic<64> = la - sa;
            let byt: logic<64> = ls_data[i] >> {off[2:0], 3'b000};
            if cov && (!sf0_v || age_i >: sf0_age) { sf0_v = 1'b1; sf0_age = age_i; sf0_b = byt[7:0]; }
        } }
    }
    always_comb {
        sf1_v = 1'b0; sf1_age = '0; sf1_b = 8'd0;
        if stld_fwd_en { for i in 0..ROB_DEPTH {
            let age_i: logic<ROB_IDX_W> = (i as ROB_IDX_W) - rob_head_idx;
            let upa: logic = FWD_PA && ls_pa_v[i];
            let sa: logic<64> = if upa ? ls_pa[i] : ls_addr[i];
            let la: logic<64> = (if upa ? lsr_paddr_q : lsr_vaddr_q) + 64'd1;
            let cov: logic = ls_fwd[i] && (age_i <: stld_fwd_age) && (la >= sa) && (la <: sa + ((5'd1 << ls_f3[i][1:0]) as 64));
            let off: logic<64> = la - sa;
            let byt: logic<64> = ls_data[i] >> {off[2:0], 3'b000};
            if cov && (!sf1_v || age_i >: sf1_age) { sf1_v = 1'b1; sf1_age = age_i; sf1_b = byt[7:0]; }
        } }
    }
    always_comb {
        sf2_v = 1'b0; sf2_age = '0; sf2_b = 8'd0;
        if stld_fwd_en { for i in 0..ROB_DEPTH {
            let age_i: logic<ROB_IDX_W> = (i as ROB_IDX_W) - rob_head_idx;
            let upa: logic = FWD_PA && ls_pa_v[i];
            let sa: logic<64> = if upa ? ls_pa[i] : ls_addr[i];
            let la: logic<64> = (if upa ? lsr_paddr_q : lsr_vaddr_q) + 64'd2;
            let cov: logic = ls_fwd[i] && (age_i <: stld_fwd_age) && (la >= sa) && (la <: sa + ((5'd1 << ls_f3[i][1:0]) as 64));
            let off: logic<64> = la - sa;
            let byt: logic<64> = ls_data[i] >> {off[2:0], 3'b000};
            if cov && (!sf2_v || age_i >: sf2_age) { sf2_v = 1'b1; sf2_age = age_i; sf2_b = byt[7:0]; }
        } }
    }
    always_comb {
        sf3_v = 1'b0; sf3_age = '0; sf3_b = 8'd0;
        if stld_fwd_en { for i in 0..ROB_DEPTH {
            let age_i: logic<ROB_IDX_W> = (i as ROB_IDX_W) - rob_head_idx;
            let upa: logic = FWD_PA && ls_pa_v[i];
            let sa: logic<64> = if upa ? ls_pa[i] : ls_addr[i];
            let la: logic<64> = (if upa ? lsr_paddr_q : lsr_vaddr_q) + 64'd3;
            let cov: logic = ls_fwd[i] && (age_i <: stld_fwd_age) && (la >= sa) && (la <: sa + ((5'd1 << ls_f3[i][1:0]) as 64));
            let off: logic<64> = la - sa;
            let byt: logic<64> = ls_data[i] >> {off[2:0], 3'b000};
            if cov && (!sf3_v || age_i >: sf3_age) { sf3_v = 1'b1; sf3_age = age_i; sf3_b = byt[7:0]; }
        } }
    }
    always_comb {
        sf4_v = 1'b0; sf4_age = '0; sf4_b = 8'd0;
        if stld_fwd_en { for i in 0..ROB_DEPTH {
            let age_i: logic<ROB_IDX_W> = (i as ROB_IDX_W) - rob_head_idx;
            let upa: logic = FWD_PA && ls_pa_v[i];
            let sa: logic<64> = if upa ? ls_pa[i] : ls_addr[i];
            let la: logic<64> = (if upa ? lsr_paddr_q : lsr_vaddr_q) + 64'd4;
            let cov: logic = ls_fwd[i] && (age_i <: stld_fwd_age) && (la >= sa) && (la <: sa + ((5'd1 << ls_f3[i][1:0]) as 64));
            let off: logic<64> = la - sa;
            let byt: logic<64> = ls_data[i] >> {off[2:0], 3'b000};
            if cov && (!sf4_v || age_i >: sf4_age) { sf4_v = 1'b1; sf4_age = age_i; sf4_b = byt[7:0]; }
        } }
    }
    always_comb {
        sf5_v = 1'b0; sf5_age = '0; sf5_b = 8'd0;
        if stld_fwd_en { for i in 0..ROB_DEPTH {
            let age_i: logic<ROB_IDX_W> = (i as ROB_IDX_W) - rob_head_idx;
            let upa: logic = FWD_PA && ls_pa_v[i];
            let sa: logic<64> = if upa ? ls_pa[i] : ls_addr[i];
            let la: logic<64> = (if upa ? lsr_paddr_q : lsr_vaddr_q) + 64'd5;
            let cov: logic = ls_fwd[i] && (age_i <: stld_fwd_age) && (la >= sa) && (la <: sa + ((5'd1 << ls_f3[i][1:0]) as 64));
            let off: logic<64> = la - sa;
            let byt: logic<64> = ls_data[i] >> {off[2:0], 3'b000};
            if cov && (!sf5_v || age_i >: sf5_age) { sf5_v = 1'b1; sf5_age = age_i; sf5_b = byt[7:0]; }
        } }
    }
    always_comb {
        sf6_v = 1'b0; sf6_age = '0; sf6_b = 8'd0;
        if stld_fwd_en { for i in 0..ROB_DEPTH {
            let age_i: logic<ROB_IDX_W> = (i as ROB_IDX_W) - rob_head_idx;
            let upa: logic = FWD_PA && ls_pa_v[i];
            let sa: logic<64> = if upa ? ls_pa[i] : ls_addr[i];
            let la: logic<64> = (if upa ? lsr_paddr_q : lsr_vaddr_q) + 64'd6;
            let cov: logic = ls_fwd[i] && (age_i <: stld_fwd_age) && (la >= sa) && (la <: sa + ((5'd1 << ls_f3[i][1:0]) as 64));
            let off: logic<64> = la - sa;
            let byt: logic<64> = ls_data[i] >> {off[2:0], 3'b000};
            if cov && (!sf6_v || age_i >: sf6_age) { sf6_v = 1'b1; sf6_age = age_i; sf6_b = byt[7:0]; }
        } }
    }
    always_comb {
        sf7_v = 1'b0; sf7_age = '0; sf7_b = 8'd0;
        if stld_fwd_en { for i in 0..ROB_DEPTH {
            let age_i: logic<ROB_IDX_W> = (i as ROB_IDX_W) - rob_head_idx;
            let upa: logic = FWD_PA && ls_pa_v[i];
            let sa: logic<64> = if upa ? ls_pa[i] : ls_addr[i];
            let la: logic<64> = (if upa ? lsr_paddr_q : lsr_vaddr_q) + 64'd7;
            let cov: logic = ls_fwd[i] && (age_i <: stld_fwd_age) && (la >= sa) && (la <: sa + ((5'd1 << ls_f3[i][1:0]) as 64));
            let off: logic<64> = la - sa;
            let byt: logic<64> = ls_data[i] >> {off[2:0], 3'b000};
            if cov && (!sf7_v || age_i >: sf7_age) { sf7_v = 1'b1; sf7_age = age_i; sf7_b = byt[7:0]; }
        } }
    }
    // S27: stld_fwd_data/mask are now composed AFTER the committed-store-
    // buffer forward layer (near the sb FIFO below): ROB bytes win, sb bytes
    // fill the rest.

    // ============================================================
    // Phase 8 S5.2: 2nd store-to-load forward byte-network for the slot-1
    // (pipe-1) LOAD at agu_addr_iss2. Identical to the slot-0 network above but
    // keyed on the slot-1 load's address/age; reads the SAME ROB store shadow
    // (ls_*). Feeds u_alu2.i_fwd_data/mask. 8 separate always_comb (one per byte)
    // — fusing them re-trips the combinational_loop diagnostic (see slot-0 note).
    // ============================================================
    let stld_fwd_age2: logic<ROB_IDX_W> = iq_iss_rob_idx2 - rob_head_idx;
    let stld_fwd_en2 : logic              = issue2_is_load;
    var sg0_v: logic; var sg0_age: logic<ROB_IDX_W>; var sg0_b: logic<8>;
    var sg1_v: logic; var sg1_age: logic<ROB_IDX_W>; var sg1_b: logic<8>;
    var sg2_v: logic; var sg2_age: logic<ROB_IDX_W>; var sg2_b: logic<8>;
    var sg3_v: logic; var sg3_age: logic<ROB_IDX_W>; var sg3_b: logic<8>;
    var sg4_v: logic; var sg4_age: logic<ROB_IDX_W>; var sg4_b: logic<8>;
    var sg5_v: logic; var sg5_age: logic<ROB_IDX_W>; var sg5_b: logic<8>;
    var sg6_v: logic; var sg6_age: logic<ROB_IDX_W>; var sg6_b: logic<8>;
    var sg7_v: logic; var sg7_age: logic<ROB_IDX_W>; var sg7_b: logic<8>;
    always_comb {
        sg0_v = 1'b0; sg0_age = '0; sg0_b = 8'd0;
        if stld_fwd_en2 { for i in 0..ROB_DEPTH {
            let age_i: logic<ROB_IDX_W> = (i as ROB_IDX_W) - rob_head_idx;
            let sa: logic<64> = ls_addr[i]; let la: logic<64> = agu_addr_iss2 + 64'd0;
            let cov: logic = ls_fwd[i] && (age_i <: stld_fwd_age2) && (la >= sa) && (la <: sa + ((5'd1 << ls_f3[i][1:0]) as 64));
            let off: logic<64> = la - sa;
            let byt: logic<64> = ls_data[i] >> {off[2:0], 3'b000};
            if cov && (!sg0_v || age_i >: sg0_age) { sg0_v = 1'b1; sg0_age = age_i; sg0_b = byt[7:0]; }
        } }
    }
    always_comb {
        sg1_v = 1'b0; sg1_age = '0; sg1_b = 8'd0;
        if stld_fwd_en2 { for i in 0..ROB_DEPTH {
            let age_i: logic<ROB_IDX_W> = (i as ROB_IDX_W) - rob_head_idx;
            let sa: logic<64> = ls_addr[i]; let la: logic<64> = agu_addr_iss2 + 64'd1;
            let cov: logic = ls_fwd[i] && (age_i <: stld_fwd_age2) && (la >= sa) && (la <: sa + ((5'd1 << ls_f3[i][1:0]) as 64));
            let off: logic<64> = la - sa;
            let byt: logic<64> = ls_data[i] >> {off[2:0], 3'b000};
            if cov && (!sg1_v || age_i >: sg1_age) { sg1_v = 1'b1; sg1_age = age_i; sg1_b = byt[7:0]; }
        } }
    }
    always_comb {
        sg2_v = 1'b0; sg2_age = '0; sg2_b = 8'd0;
        if stld_fwd_en2 { for i in 0..ROB_DEPTH {
            let age_i: logic<ROB_IDX_W> = (i as ROB_IDX_W) - rob_head_idx;
            let sa: logic<64> = ls_addr[i]; let la: logic<64> = agu_addr_iss2 + 64'd2;
            let cov: logic = ls_fwd[i] && (age_i <: stld_fwd_age2) && (la >= sa) && (la <: sa + ((5'd1 << ls_f3[i][1:0]) as 64));
            let off: logic<64> = la - sa;
            let byt: logic<64> = ls_data[i] >> {off[2:0], 3'b000};
            if cov && (!sg2_v || age_i >: sg2_age) { sg2_v = 1'b1; sg2_age = age_i; sg2_b = byt[7:0]; }
        } }
    }
    always_comb {
        sg3_v = 1'b0; sg3_age = '0; sg3_b = 8'd0;
        if stld_fwd_en2 { for i in 0..ROB_DEPTH {
            let age_i: logic<ROB_IDX_W> = (i as ROB_IDX_W) - rob_head_idx;
            let sa: logic<64> = ls_addr[i]; let la: logic<64> = agu_addr_iss2 + 64'd3;
            let cov: logic = ls_fwd[i] && (age_i <: stld_fwd_age2) && (la >= sa) && (la <: sa + ((5'd1 << ls_f3[i][1:0]) as 64));
            let off: logic<64> = la - sa;
            let byt: logic<64> = ls_data[i] >> {off[2:0], 3'b000};
            if cov && (!sg3_v || age_i >: sg3_age) { sg3_v = 1'b1; sg3_age = age_i; sg3_b = byt[7:0]; }
        } }
    }
    always_comb {
        sg4_v = 1'b0; sg4_age = '0; sg4_b = 8'd0;
        if stld_fwd_en2 { for i in 0..ROB_DEPTH {
            let age_i: logic<ROB_IDX_W> = (i as ROB_IDX_W) - rob_head_idx;
            let sa: logic<64> = ls_addr[i]; let la: logic<64> = agu_addr_iss2 + 64'd4;
            let cov: logic = ls_fwd[i] && (age_i <: stld_fwd_age2) && (la >= sa) && (la <: sa + ((5'd1 << ls_f3[i][1:0]) as 64));
            let off: logic<64> = la - sa;
            let byt: logic<64> = ls_data[i] >> {off[2:0], 3'b000};
            if cov && (!sg4_v || age_i >: sg4_age) { sg4_v = 1'b1; sg4_age = age_i; sg4_b = byt[7:0]; }
        } }
    }
    always_comb {
        sg5_v = 1'b0; sg5_age = '0; sg5_b = 8'd0;
        if stld_fwd_en2 { for i in 0..ROB_DEPTH {
            let age_i: logic<ROB_IDX_W> = (i as ROB_IDX_W) - rob_head_idx;
            let sa: logic<64> = ls_addr[i]; let la: logic<64> = agu_addr_iss2 + 64'd5;
            let cov: logic = ls_fwd[i] && (age_i <: stld_fwd_age2) && (la >= sa) && (la <: sa + ((5'd1 << ls_f3[i][1:0]) as 64));
            let off: logic<64> = la - sa;
            let byt: logic<64> = ls_data[i] >> {off[2:0], 3'b000};
            if cov && (!sg5_v || age_i >: sg5_age) { sg5_v = 1'b1; sg5_age = age_i; sg5_b = byt[7:0]; }
        } }
    }
    always_comb {
        sg6_v = 1'b0; sg6_age = '0; sg6_b = 8'd0;
        if stld_fwd_en2 { for i in 0..ROB_DEPTH {
            let age_i: logic<ROB_IDX_W> = (i as ROB_IDX_W) - rob_head_idx;
            let sa: logic<64> = ls_addr[i]; let la: logic<64> = agu_addr_iss2 + 64'd6;
            let cov: logic = ls_fwd[i] && (age_i <: stld_fwd_age2) && (la >= sa) && (la <: sa + ((5'd1 << ls_f3[i][1:0]) as 64));
            let off: logic<64> = la - sa;
            let byt: logic<64> = ls_data[i] >> {off[2:0], 3'b000};
            if cov && (!sg6_v || age_i >: sg6_age) { sg6_v = 1'b1; sg6_age = age_i; sg6_b = byt[7:0]; }
        } }
    }
    always_comb {
        sg7_v = 1'b0; sg7_age = '0; sg7_b = 8'd0;
        if stld_fwd_en2 { for i in 0..ROB_DEPTH {
            let age_i: logic<ROB_IDX_W> = (i as ROB_IDX_W) - rob_head_idx;
            let sa: logic<64> = ls_addr[i]; let la: logic<64> = agu_addr_iss2 + 64'd7;
            let cov: logic = ls_fwd[i] && (age_i <: stld_fwd_age2) && (la >= sa) && (la <: sa + ((5'd1 << ls_f3[i][1:0]) as 64));
            let off: logic<64> = la - sa;
            let byt: logic<64> = ls_data[i] >> {off[2:0], 3'b000};
            if cov && (!sg7_v || age_i >: sg7_age) { sg7_v = 1'b1; sg7_age = age_i; sg7_b = byt[7:0]; }
        } }
    }
    // S27: stld_fwd_data2/mask2 composed after the sb forward layer (below).

    // ============================================================
    // M5.A LR/SC reservation (single-hart, simplest).
    // - LR at issue: set valid + addr to agu_addr_iss
    // - SC at issue: clear (whether matched or not, atomicity)
    // - Other STORE / AMO at issue: clear if address matches
    // - Trap / MRET / redirect: clear (Linux assumption)
    // ============================================================
    let issue_is_lr     : logic = iq_issue_valid && iq_iss_is_amo && iq_iss_amo_funct5 == 5'b00010;
    let issue_is_sc     : logic = iq_issue_valid && iq_iss_is_amo && iq_iss_amo_funct5 == 5'b00011;
    let issue_is_amo    : logic = iq_issue_valid && iq_iss_is_amo;
    let issue_is_st     : logic = iq_issue_valid && iq_issue_op.base.is_store;
    let issue_addr_match: logic = rsv_valid_q && rsv_addr_q == agu_addr_iss;
    // ACT4 ExceptionsSvZalrsc: a reservation-INVALID SC must still translate-for-
    // write and ACCESS/PAGE-fault when the translation fails — Sail translates for
    // Write reservation-INDEPENDENTLY, so an SC to a hole / unmapped / W-denied PA
    // faults (cause 7 access / 15 page) regardless of whether the reservation holds.
    // A MATCHED SC already faults via its commit store walk (pmpzalrsc / SvPMP);
    // the gap is the FAILING SC (issue_addr_match=0), which clears its store flag
    // (amo_commit_store=0 → c_is_store=0) so it never drives a commit walk and never
    // fault-checks — it just returns rd=1. FIX: drive a load-style TRANSLATION walk
    // at issue (the well-tested AMO owner path — same as ExceptionsSvZaamo), and
    // route its fault to is_sfault via walk_is_amo_q (cause 7/15). A misaligned
    // failing SC is excluded (alu_wrap's amo_misalign already access-faults it).
    // For an aligned failing SC to a NORMAL PA (a lost reservation in SMP) the walk
    // hits the TLB, raises no fault, and the SC returns rd=1 exactly as before.
    // PAGED-MODE ONLY (dmem_vm_on_op): in BARE mode there is no translation (VA==PA)
    // and a failing SC's PMP/PMA fault is already raised at issue by u_pmp_sc_issue
    // (sc_issue_acc_fault below), so a bare SC must NOT drive a dcache read here —
    // that extra bare-mode port access perturbed the LR/SC reservation timing and
    // wedged the RVWMO litmus battery (bare-metal, no paging). Gating on
    // dmem_vm_on_op makes this complementary to the bare u_pmp_sc_issue check and
    // keeps every bare-mode SC byte-identical (boot's bare phase + all litmus).
    let issue_sc_walk   : logic = issue_is_sc && !issue_addr_match && !iss_amo_misalign && dmem_vm_on_op;
    // M9.4 SMP: an SC may consume (clear) the reservation only if BOTH (a) it is
    // program-order AFTER its owner LR (age = distance from the ROB head), so an
    // OoO-reordered OLDER sc.w cannot wipe a YOUNGER lr.w's reservation, AND (b) its
    // address matches the reservation, so an SC to a different lock cannot clear it.
    //
    // The old `rsv_owner_committed_q ||` escape hatch (allow any SC to clear once the
    // owner LR has committed) was a BUG: in a speculatively-unrolled read_lock spin
    // (lr.w; bltz; addi; sc.w; bnez) the owner LR commits within a few cycles, after
    // which a stale/reordered in-flight sc.w cleared the reservation BEFORE the
    // matching sc.w could check it → every sc.w then saw rsv_valid=0 → the hart spun
    // forever in arch_read_lock. The Veryl sim's evaluation order happened to avoid
    // it, but Verilator (correct SV NBA, ≈ real HW) livelocked N=2/N=4 SMP boot here.
    // The age gate alone is enough; a stale reservation that the wrapped age compare
    // fails to clear is harmless because the sc.w's own match check (rsv_addr == its
    // own addr) still gates success.
    let rsv_age_sc   : logic<ROB_IDX_W> = iq_iss_rob_idx - rob_head_idx;
    let rsv_age_owner: logic<ROB_IDX_W> = rsv_rob_q - rob_head_idx;
    // M9.4 age gate (owner still IN-FLIGHT): the SC may consume the reservation
    // only if it is program-order AFTER the owner LR (its distance from the ROB
    // head exceeds the owner's), so an OoO-reordered OLDER sc.w cannot wipe a
    // YOUNGER lr.w's reservation.
    // Phase 8 M2 (rsv_committed_q escape): once the owner LR has COMMITTED it has
    // left the ROB and rsv_rob_q is stale — the distance compare wraps and would
    // wrongly reject every SC. A committed reservation is architectural, and any
    // in-flight SC is necessarily program-order after the (retired) owner, so a
    // matching SC may consume it. This is what M2's faster front end exposed: the
    // owner lr.w now commits before the paired sc.w even issues (AMOs are
    // bus-serialized, so the sc.w lags), leaving sc_may_clear=0 for every sc.w —
    // the reservation was never consumed, so a later bare sc.w spuriously
    // succeeded (rv64ua-lrsc test 6). The in-flight age gate above is retained, so
    // the M9.4 reorder protection still holds while the owner is in flight.
    let sc_may_clear : logic = (rsv_committed_q || (rsv_age_sc >: rsv_age_owner)) && (rsv_addr_q == agu_addr_iss);
    // Phase 8 M2: track whether the reservation's owner LR has committed. Reset by
    // each new LR (fresh, uncommitted owner); raised when the owner's ROB slot
    // retires. Only meaningful while rsv_valid_q is set.
    always_ff (clk, rst) {
        if_reset {
            rsv_committed_q = 1'b0;
        } else if issue_is_lr && iq_issue_ack {
            rsv_committed_q = 1'b0;
        } else if rob_commit_ack && rob_commit_idx == rsv_rob_q {
            rsv_committed_q = 1'b1;
        }
    }
    // P9.2: arm the presence-based reservation clear only once the reserved
    // line has actually been observed PRESENT (the owning LR's force-miss
    // fill landed). Reset by each new LR.
    always_ff (clk, rst) {
        if_reset {
            rsv_present_seen_q = 1'b0;
        } else if issue_is_lr && iq_issue_ack {
            rsv_present_seen_q = 1'b0;
        } else if rsv_valid_q && dc_rsv_present {
            rsv_present_seen_q = 1'b1;
        }
    }
    always_ff (clk, rst) {
        if_reset {
            rsv_valid_q = 1'b0;
            rsv_addr_q  = 64'd0;
            rsv_pa_q    = 64'd0;
            rsv_rob_q   = '0;
        } else if commit_trap || commit_mret || commit_sret || commit_csrw_satp {
            // M9.4 SMP: clear the LR/SC reservation only on ARCHITECTURAL control
            // events (trap / mret / sret / satp context switch), NOT on a plain
            // branch-mispredict redirect. The old `redirect_fire_q` term cleared the
            // reservation on EVERY redirect, including a speculative branch mispredict.
            // In a tight read_lock spin (lr.w; blt; addi; sc.w; bnez), the blt/bnez
            // mispredict between the (already-committed) lr.w and the sc.w wiped the
            // CORRECT-PATH reservation every iteration, so the sc.w never succeeded —
            // hart spun forever on an UNCONTENDED rwlock (observed: N=4 hart0 stuck in
            // arch_read_lock @0x80025b58 with rsv_valid=0 at the SC, addr correct,
            // poison=0, lock dword written only ~3× in 62M). A branch mispredict is a
            // microarchitectural event and must NOT clear an architectural reservation
            // (RVWMO). v1 (in-order, ~1-cycle LR→SC window) never exposed it. The rare
            // remote-write case is still handled by the dword-granular remote-clear
            // below; a squashed wrong-path lr.w is re-paired with its own sc.w on the
            // correct path so its stale reservation cannot make a bare sc.w succeed.
            // Phase 8 M2: a wrong-path lr.w can no longer set the reservation at all —
            // amo_at_head restricts AMO/LR/SC issue to the non-speculative ROB head.
            rsv_valid_q = 1'b0;
        } else if issue_is_lr && iq_issue_ack {
            // M9 SMP: gate the reservation updates on iq_issue_ack (ACTUAL
            // issue), not bare selection — a selection-time update can fire
            // on a cycle the op does not actually issue (e.g. a dcache-stall
            // hold), desynchronizing it from the SC's sc_match check in
            // alu_wrap. Tying these to iq_issue_ack keeps the clear and the
            // check on the same cycle: sc_match reads the pre-edge
            // reservation, the clear applies the edge. (P9.3: the M9.4
            // bus-lock issue bubble this note used to describe is gone.)
            rsv_valid_q = 1'b1;
            rsv_addr_q  = agu_addr_iss;
            // P9.3: the LR read drives the dmem port this cycle, so
            // dmu_dmem_addr is its TRANSLATED PA (== VA in bare mode).
            rsv_pa_q  = dmu_dmem_addr;
            rsv_rob_q = iq_iss_rob_idx;
        } else if (i_dcache_inv_valid && i_dcache_inv_addr[63:6] == rsv_pa_q[63:6])
            || (i_dcache_inv2_valid && i_dcache_inv2_addr[63:6] == rsv_pa_q[63:6]) {
            // M9 SMP: a remote hart's store hit our reserved line — kill the
            // reservation so a following SC fails (matches RVWMO). Placed
            // after the LR set so a fresh LR this cycle wins over a remote
            // write to the OLD addr. P9.2: port 2 covers a remote misaligned
            // store's hi line. P9.3: PA-compare, LINE-granular (the precise
            // inv pulses are line-aligned — the old [63:3] dword compare
            // only ever matched dword 0; presence covers the rest anyway).
            rsv_valid_q = 1'b0;
        } else if rsv_present_seen_q && !dc_rsv_present {
            // P9.2 (precise invalidation): the reserved LINE left the L1 —
            // evicted locally or invalidated remotely. From here on a remote
            // write to it produces NO pulse on this hart (the directory no
            // longer lists us), so the reservation must die with the line:
            // rsv_valid ⇒ line present ⇒ every remote write is observed.
            // rsv_present_seen_q arms the clear only after the owning LR's
            // own force-miss fill has brought the line in (presence is 0
            // between the force-invalidate and the fill — clearing there
            // would kill every fresh reservation and livelock LR/SC loops).
            rsv_valid_q = 1'b0;
        } else if issue_is_sc && iq_issue_ack {
            // M9.4 SMP: the SC consumes the reservation, but ONLY if it is program-
            // order after the owning LR (sc_may_clear). An OoO-reordered OLDER SC
            // (issuing after a younger LR) must not wipe that younger LR's
            // reservation, or the next SC fails forever on an uncontended lock.
            if sc_may_clear {
                rsv_valid_q = 1'b0;
            }
        } else if (issue_is_st || issue_is_amo) && issue_addr_match && iq_issue_ack {
            rsv_valid_q = 1'b0;
        }
    }

    // ============================================================
    // M9.4 SMP: SC commit-time re-validation (LR/SC atomicity under OoO).
    //
    // alu_wrap evaluates sc_match (reservation valid && addr) at the SC's
    // EXECUTE (issue) and latches the result into the ROB as c_is_store
    // (= amo_commit_store). But the STORE itself fires at COMMIT, several
    // cycles later. In between, a REMOTE hart can write the reserved line;
    // RVWMO then requires THIS SC to FAIL, yet the already-latched success
    // still fires the store at commit. Two harts' SCs to the same line both
    // succeed -> one update is lost. Observed as the N=4 kernel tasklist_lock
    // (PA 0x80a07240) read-lock counter going stuck-NEGATIVE (two read_lock
    // `addi+1; sc.w` both write count+1, a reader increment is lost, later
    // read_unlock `amoadd -1` drives it negative = a phantom write-lock) so
    // every reader spins forever in arch_read_lock @0x80025b58. v1 (in-order,
    // execute==commit in one MEM stage) has NO such window, so it boots N=4.
    //
    // Fix: WATCH the in-flight matched SC's reserved dword. If a remote write
    // (i_dcache_inv, self-filtered = remote only) hits it before the SC
    // commits, POISON the SC. At the watched SC's commit, if poisoned,
    // SUPPRESS its store and REDIRECT to its own PC (commit_sc_replay, handled
    // like a mispredict). The replayed SC re-reads the redirect-cleared
    // reservation -> sc_match fails (rd=1, no store) -> software retries its
    // LR/SC loop. Single watch slot suffices: a hart never has two LR/SC pairs
    // in flight at once. All registered; the watch state never feeds issue
    // select, so no comb loop. (The four sc_*_q registers are declared up near
    // rsv_valid_q so the commit-redirect always_ff can read them.)
    // A matched SC issues this cycle (it will fire a store at commit):
    let sc_exec_match  : logic = issue_is_sc && iq_issue_ack && issue_addr_match;
    // A remote write hits the watched SC's reserved line. P9.2: also poison
    // when the watched LINE leaves the L1 (presence drop) — from then on
    // remote writes to it are invisible here (precise invalidation), so the
    // watch can no longer be trusted; the replayed SC fails cleanly.
    // P9.3: sc_watch_addr_q is the PA (= rsv_pa_q at arm; same location —
    // issue_addr_match held), line-granular like the rsv clear above.
    let sc_remote_hit: logic = sc_watch_valid_q && ((i_dcache_inv_valid && i_dcache_inv_addr[63:6] == sc_watch_addr_q[63:6])
        || (i_dcache_inv2_valid && i_dcache_inv2_addr[63:6] == sc_watch_addr_q[63:6]) || !dc_scw_present);
    // The watched SC is at the ROB head this cycle (the replay trigger):
    let sc_at_head: logic = sc_watch_valid_q && rob_commit_valid && rob_commit_idx == sc_watch_rob_q;
    // Poisoned watched SC at the head -> replay (fail it):
    let commit_sc_replay: logic = sc_at_head && sc_poison_q;
    // P9.3: clear the SC watch only on its actual RETIRE (rob_commit_ack),
    // not on head arrival — same reason as amo_watch_retire (the at-head SC
    // issue makes execute coincide with the head, so a valid-based clear
    // would wipe the watch before the in-cache SC store completes).
    let sc_watch_retire: logic = sc_watch_valid_q && rob_commit_ack && rob_commit_idx == sc_watch_rob_q;
    // ============================================================
    // P9.3: AMO watch — the in-cache RMW atomicity backstop (sc_watch
    // shape). The AMO read captured its value from an OWNED (E/M) line; if
    // that line departs the L1 before the commit write (remote RFO recall,
    // own eviction, …), the captured value may be stale — POISON the AMO,
    // suppress its store at commit and replay from its own PC. The
    // re-executed AMO re-acquires ownership and re-reads. If the watch is
    // clean at commit, ownership was held continuously ⇒ the RMW is atomic.
    // ============================================================
    let issue_is_realamo: logic = issue_is_amo && !issue_is_lr && !issue_is_sc;
    // "The atomic's line is cacheable, so its RMW may be an owned-line merge" —
    // computed on the LIVE translated PA (the same expression ac_wexcl_q registers
    // below; hoisted here so R3.2c can also read it at the capture cycle).
    let iss_wexcl       : logic = (dmu_dmem_addr[63:25] == 39'h40) && !dmu_pbmt_unc
        && !((dmu_dmem_addr[31:14] == 18'h20000) || (dmu_dmem_addr[31:12] == 20'h80008));
    // R3.2c: a no-read class atomic that translated to an UNCACHEABLE PA cannot be
    // performed by the queue (asq_class requires ac_wexcl_q) and has no `old` of its
    // own — the one case the PA-independent issue-side class predicate cannot decide
    // in advance. Take the existing exit: arm the watch already poisoned so
    // commit_amo_replay re-fetches the atomic, and set amo_fread_q so the re-executed
    // one reads normally and lands on today's proven write-through path. Bounded at
    // exactly one replay. Constant 0 at ASQ_NOREAD=0.
    let asq_nr_mmio     : logic = asq_nr_iss && !iss_wexcl;
    // R3.2c: a no-read atomic arms no watch at all (there is no read→write window to
    // protect) — unless it is the uncacheable case above, which arms it poisoned.
    let amo_exec_capture: logic = issue_is_realamo && iq_issue_ack && !(asq_nr_iss && iss_wexcl);
    let amo_remote_hit  : logic = amo_watch_valid_q && ((i_dcache_inv_valid && i_dcache_inv_addr[63:6] == amo_watch_pa_q[63:6])
        || (i_dcache_inv2_valid && i_dcache_inv2_addr[63:6] == amo_watch_pa_q[63:6]) || !dc_amo_present);
    // Poisoned watched AMO at the head -> replay (re-acquire + re-read).
    // commit_amo_replay is defined up near commit_load_replay (so it can gate
    // rob_commit_ack); it is exactly "watched AMO at the ROB head && poisoned".
    // P9.3: the watch CLEARS only on the AMO's actual RETIRE (rob_commit_ack),
    // NOT on mere head arrival. With the at-head AMO-issue restriction the
    // read executes WHILE the AMO is the head, so a rob_commit_valid clear
    // would wipe the watch the cycle after it arms — before the commit write
    // completes — leaving the RMW unprotected if the line departs while the
    // store stalls at the head (observed: N=2 boot per-cpu amoadd.d wedge,
    // dcache_stall stuck, watch already cleared, no poison/replay). An
    // ack-based clear keeps the watch live across the whole stall window.
    let amo_watch_retire : logic = amo_watch_valid_q && rob_commit_ack && rob_commit_idx == amo_watch_rob_q;
    // Phase 8 S1: slot-0 (head) triggers a redirect this cycle? If so the head+1
    // op is wrong-path (will be squashed) and must NOT retire in slot-1. Mirrors
    // every arm of the commit redirect always_ff.
    let commit_redirect: logic = commit_trap || commit_mret || commit_sret || c_bp_mispredict || commit_sc_replay || commit_amo_replay || commit_load_replay || commit_csrw_satp || commit_fence_i_pulse || c_is_cas_q;
    // Slot-1 retires only when slot-0 actually retires (rob_commit_ack), slot-0
    // does not redirect, and head+1 is a simple integer op (c2_valid from ROB).
    // Phase 8 S8.E: suppress the 2-wide commit on an early-squash cycle. c2_valid is
    // computed from the PRE-squash sh_valid[head+1]; if the branch is at the head
    // (squash_age 0) then head+1 is YOUNGER and being squashed this cycle — committing
    // it would advance head by 2 while the squash rewinds tail to head+1, leaving
    // head > tail (catastrophic size wrap). Slot-0 (the branch / an older op) still
    // commits; the extra slot-1 commit just waits one cycle.
    assign commit2_fire = rob_commit_ack && !commit_redirect && c2_valid && !s8_restore_en;

    // ── L4 step-2 differential trace (DIAGNOSIS SCAFFOLD — keep at 0 on master) ──
    // A PC-keyed COMMIT stream. Cycle counts and per-cause census buckets legitimately
    // differ between the =0 and =1 arms, so neither can name a wrong VALUE; the retire
    // stream can, and it is timing-independent. Only usable on a short directed test
    // (rv64mi-ma_addr = seconds) — never on a boot.
    const CMT_TRACE: bit = 0;
    // Separate const from CMT_TRACE: the commit stream is only affordable on a directed
    // test, while the MSHR/ASQ traces are sparse enough for a litmus run. h= is HART_ID
    // (N>1 harts interleave on stdout).
    const MSHR_TRACE: bit = 0;
    const B2B_TRACE   : bit      = 0;
    // Block T follow-on: the census array is per-core and only the SINGLE-hart tb
    // surfaces it, so the SMP arms read the two LSR_B2B_SBQ counters (94/95) off a
    // periodic print instead of new port plumbing through heliodor_soc_smp. h= is
    // HART_ID; the harts interleave on stdout.
    const B2B_SUP_TRACE: bit      = 0;
    const B2B_SUP_EVERY: logic<32> = 32'd5000000;
    const B2B_TRACE_RD: logic<5> = 5'd15; // a5 — the base register in the oops frame
    const B2B_WATCH_PC: logic<64> = 64'hffffffff8001592a; // c.ld a5,104(s0) — the load that returns 0
    const B2B_WATCH_VA: logic<64> = 64'hffffffe000cac1e8; // that load's VA on the failing iteration
    const B2B_WATCH_ROB: logic<5> = 5'd25; // ROB entry of the store that resolved 10 cy earlier
    const B2B_WATCH_PA: logic<64> = 64'h0000000080cac1e8; // the same location, physical
    const B2B_WIN_LO  : logic<32> = 32'd6913584; // cycle window around the failure
    const B2B_WIN_HI  : logic<32> = 32'd6913600;
    // Free-running cycle stamp for the traces. Gated so that with both traces off it is
    // reset-only → DCE, rather than a live 32-bit counter with no readers.
    var trc_cy_q: logic<32>;
    always_ff (clk, rst) {
        if_reset {
            trc_cy_q = '0;
        } else if CMT_TRACE || MSHR_TRACE || B2B_TRACE || B2B_SUP_TRACE {
            trc_cy_q = trc_cy_q + 32'd1;
        }
    }
    // ── Block T diagnosis: NAME the instruction that produced the faulting value ──
    // The LSR_B2B=1 N=2 boot oopses on a NULL store (cause 15, badaddr 0) in kthreadd
    // with a5 = 0. A full CMT_TRACE diff would be ~5 M lines per arm before the fault;
    // this asks the same question for one register instead. Keep a 4-deep shift of the
    // architectural writes to B2B_TRACE_RD (commit PC + value + cycle) and dump it the
    // first time a store/AMO page fault commits. The producing PC is then compared
    // between the arms directly. DEAD at 0: every register here is reset-only → DCE.
    var bt_pc0_q: logic<64>; var bt_d0_q: logic<64>; var bt_cy0_q: logic<32>;
    var bt_pc1_q: logic<64>; var bt_d1_q: logic<64>; var bt_cy1_q: logic<32>;
    var bt_pc2_q: logic<64>; var bt_d2_q: logic<64>; var bt_cy2_q: logic<32>;
    var bt_pc3_q: logic<64>; var bt_d3_q: logic<64>; var bt_cy3_q: logic<32>;
    var bt_shown_q: logic;
    always_ff (clk, rst) {
        if_reset {
            bt_pc0_q = 64'd0; bt_d0_q = 64'd0; bt_cy0_q = 32'd0;
            bt_pc1_q = 64'd0; bt_d1_q = 64'd0; bt_cy1_q = 32'd0;
            bt_pc2_q = 64'd0; bt_d2_q = 64'd0; bt_cy2_q = 32'd0;
            bt_pc3_q = 64'd0; bt_d3_q = 64'd0; bt_cy3_q = 32'd0;
            bt_shown_q = 1'b0;
        } else if B2B_TRACE {
            if rob_commit_ack && c_has_rd && !c_illegal && c_rd_arch == B2B_TRACE_RD {
                bt_pc3_q = bt_pc2_q; bt_d3_q = bt_d2_q; bt_cy3_q = bt_cy2_q;
                bt_pc2_q = bt_pc1_q; bt_d2_q = bt_d1_q; bt_cy2_q = bt_cy1_q;
                bt_pc1_q = bt_pc0_q; bt_d1_q = bt_d0_q; bt_cy1_q = bt_cy0_q;
                bt_pc0_q = c_pc     ; bt_d0_q = c_result_data; bt_cy0_q = trc_cy_q;
            }
            // Commit slot-1, ordered after slot-0 exactly as arch_regs orders them.
            if commit2_fire && c2_has_rd && c2_rd_arch == B2B_TRACE_RD {
                bt_pc3_q = bt_pc2_q; bt_d3_q = bt_d2_q; bt_cy3_q = bt_cy2_q;
                bt_pc2_q = bt_pc1_q; bt_d2_q = bt_d1_q; bt_cy2_q = bt_cy1_q;
                bt_pc1_q = bt_pc0_q; bt_d1_q = bt_d0_q; bt_cy1_q = bt_cy0_q;
                bt_pc0_q = c2_pc    ; bt_d0_q = c2_result_data; bt_cy0_q = trc_cy_q;
            }
            if commit_trap && trap_cause == 64'd15 && !bt_shown_q {
                bt_shown_q = 1'b1;
                $display("B2BFAULT cy=%d pc=%h cause=%h stval=%h", trc_cy_q, c_pc, trap_cause, dbg_csr_stval);
                $display("B2BFAULT  rd-w0 pc=%h d=%h cy=%d", bt_pc0_q, bt_d0_q, bt_cy0_q);
                $display("B2BFAULT  rd-w1 pc=%h d=%h cy=%d", bt_pc1_q, bt_d1_q, bt_cy1_q);
                $display("B2BFAULT  rd-w2 pc=%h d=%h cy=%d", bt_pc2_q, bt_d2_q, bt_cy2_q);
                $display("B2BFAULT  rd-w3 pc=%h d=%h cy=%d", bt_pc3_q, bt_d3_q, bt_cy3_q);
            }
        }
    }
    // rd/data are only printed when the entry HAS an rd: for a branch/store the ROB's
    // result_data slot holds whatever its producer left there, which can differ between
    // arms for benign reasons and would swamp a diff with false divergences.
    always_ff (clk, rst) {
        if_reset {} else if CMT_TRACE {
            if rob_commit_ack && c_has_rd {
                $display("C pc=%h rd=%d d=%h", c_pc, c_rd_arch, c_result_data);
            }
            if rob_commit_ack && !c_has_rd {
                $display("C pc=%h", c_pc);
            }
            if commit2_fire && c2_has_rd {
                $display("C pc=%h rd=%d d=%h", c2_pc, c2_rd_arch, c2_result_data);
            }
            if commit2_fire && !c2_has_rd {
                $display("C pc=%h", c2_pc);
            }
        }
    }

    always_ff (clk, rst) {
        if_reset {
            sc_watch_valid_q = 1'b0;
            sc_watch_addr_q  = 64'd0;
            sc_watch_rob_q   = '0;
            sc_poison_q      = 1'b0;
        } else if redirect_fire_q {
            // Any flush (incl. this fix's own replay) clears the watch.
            sc_watch_valid_q = 1'b0;
            sc_poison_q      = 1'b0;
        } else if sc_exec_match {
            sc_watch_valid_q = 1'b1;
            // P9.3: track the PA — the reservation's PA is this SC's PA
            // (issue_addr_match ⇒ same VA ⇒ same translation; sfence/satp
            // in between are serializing and clear the reservation).
            sc_watch_addr_q = rsv_pa_q;
            sc_watch_rob_q  = iq_iss_rob_idx;
            // Same-cycle remote write to the new SC's line also poisons it.
            // P9.2: + 2nd inv port; + the line already absent at issue (the
            // presence-clear arm races this SC's issue — dc_rsv_present IS
            // the SC line's presence here, since issue_addr_match held).
            sc_poison_q = (i_dcache_inv_valid && i_dcache_inv_addr[63:6] == rsv_pa_q[63:6])
                || (i_dcache_inv2_valid && i_dcache_inv2_addr[63:6] == rsv_pa_q[63:6])
                || (rsv_present_seen_q && !dc_rsv_present);
        } else if sc_watch_retire {
            sc_watch_valid_q = 1'b0;
            sc_poison_q      = 1'b0;
        } else if sc_remote_hit {
            sc_poison_q = 1'b1;
        }
    }

    // P9.3: AMO watch state (see the commit_amo_replay block above).
    always_ff (clk, rst) {
        if_reset {
            amo_watch_valid_q = 1'b0;
            amo_watch_pa_q    = 64'd0;
            amo_watch_rob_q   = '0;
            amo_poison_q      = 1'b0;
        } else if redirect_fire_q {
            // Any flush (incl. this fix's own replay) clears the watch.
            amo_watch_valid_q = 1'b0;
            amo_poison_q      = 1'b0;
        } else if amo_exec_capture {
            amo_watch_valid_q = 1'b1;
            // The AMO read drives the dmem port this cycle — dmu_dmem_addr
            // is its translated PA (the L1/presence tracking is PIPT).
            amo_watch_pa_q  = dmu_dmem_addr;
            amo_watch_rob_q = iq_iss_rob_idx;
            // Same-cycle departure of the captured line poisons immediately
            // (the registered presence port still checks the OLD watch
            // address this cycle): both precise-inv ports + both dcache
            // line-departure event ports, line-granular on the PA.
            // R3.2c: … and a no-read atomic on an uncacheable PA arms POISONED, so the
            // existing commit replay sends it back through today's read path.
            amo_poison_q = (i_dcache_inv_valid && i_dcache_inv_addr[63:6] == dmu_dmem_addr[63:6])
                || (i_dcache_inv2_valid && i_dcache_inv2_addr[63:6] == dmu_dmem_addr[63:6])
                || (dc_evict1_v && dc_evict1_addr[63:6] == dmu_dmem_addr[63:6])
                || (dc_evict2_v && dc_evict2_addr[63:6] == dmu_dmem_addr[63:6])
                || asq_nr_mmio;
        } else if amo_watch_retire {
            amo_watch_valid_q = 1'b0;
            amo_poison_q      = 1'b0;
        } else if amo_remote_hit {
            amo_poison_q = 1'b1;
        }
    }
    // CP M3b/M4: capture the atomic's read-time translation for its commit write (see
    // the ac_*_q decls). A real AMO or SC (issue_is_amo && !issue_is_lr — LR never
    // writes at commit) latches its translated PA, R+W-PMP/translation OK, and
    // cacheable-merge status when it issues (the cycle dmu_dmem_addr / the fault flags
    // hold the atomic's). The atomic is at the ROB head (serialized), so the registers
    // stay valid from issue to commit. Cacheable = DRAM (PA[63:25]==0x40) && !Svpbmt-NC
    // && not a tohost page (mirrors c_store_mmio / st_pa_tohost on the read PA).
    always_ff (clk, rst) {
        if_reset {
            ac_pa_q     = 64'd0;
            ac_wok_q    = 1'b0;
            ac_wexcl_q  = 1'b0;
            ac_noread_q = 1'b0;
        } else if issue_is_amo && !issue_is_lr && iq_issue_ack {
            ac_pa_q     = dmu_dmem_addr;
            ac_wok_q    = !dmem_mmu_acc_fault && !dmem_mmu_fault;
            ac_wexcl_q  = iss_wexcl;
            ac_noread_q = asq_nr_iss;
        }
    }
    // R3.2c: the no-read fallback's sticky bit. Set at the translate cycle of a
    // class atomic whose PA turned out uncacheable (that atomic is being poisoned +
    // replayed by the arms above); cleared when an atomic retires, which is the
    // replayed one landing through today's path. It only ever costs a slower path,
    // so a stale set bit (e.g. the replayed atomic squashed by an interrupt first)
    // is harmless. Constant 0 at ASQ_NOREAD=0.
    always_ff (clk, rst) {
        if_reset {
            amo_fread_q = 1'b0;
        } else if asq_nr_mmio && issue_is_realamo && iq_issue_ack {
            amo_fread_q = 1'b1;
        } else if rob_commit_ack && c_is_amo {
            amo_fread_q = 1'b0;
        }
    }

    // Zacas amocas.q commit-time operands. amocas.q is serializing (issues at the
    // ROB head), so at its commit the architectural register file (arch_regs) is
    // authoritative for the rd:rd+1 compare pair and the rs2:rs2+1 new pair. rs2
    // comes from the entry's instr; the loaded old 128-bit value rode the CDB into
    // c_cas_q_mem_lo/hi. The store fires (both dwords) only on a 128-bit match.
    let cas_q_rs2_arch: logic<5>  = c_instr[24:20];
    // Read the pair operands from arch_regs. When the pair BASE is x0 the WHOLE
    // pair reads as zero (x0 is the zero register pair for amocas.q): rd=x0 ⇒
    // compare against {0,0} and write no register; rs2=x0 ⇒ store {0,0}. So both
    // halves are forced to 0 when the base is x0 — not just the low half.
    let cas_q_cmp_lo  : logic<64> = if c_rd_arch == 5'd0 ? 64'd0 : arch_regs[c_rd_arch];
    let cas_q_cmp_hi  : logic<64> = if c_rd_arch == 5'd0 ? 64'd0 : arch_regs[c_rd_arch + 5'd1];
    let cas_q_new_lo  : logic<64> = if cas_q_rs2_arch == 5'd0 ? 64'd0 : arch_regs[cas_q_rs2_arch];
    let cas_q_new_hi  : logic<64> = if cas_q_rs2_arch == 5'd0 ? 64'd0 : arch_regs[cas_q_rs2_arch + 5'd1];
    let cas_q_match   : logic     = c_is_cas_q && (c_cas_q_mem_lo == cas_q_cmp_lo) && (c_cas_q_mem_hi == cas_q_cmp_hi);

    // STORE write fires at commit when the head entry is a store.
    // M6.B.4: suppress a faulted/FS-disabled FP store's memory write.
    // M9.4: suppress a poisoned SC's store (it is being replayed to fail).
    // P9.3: a poisoned AMO's store is suppressed the same way (replayed).
    // Zacas amocas.q: the store (both dwords) fires only on the 128-bit match.
    let commit_store_fire: logic = rob_commit_valid && c_is_store && !c_illegal && !commit_priv_illegal && !commit_sc_replay && !commit_amo_replay && (!c_is_cas_q || cas_q_match);

    // funct3 → wstrb (size mask) shifted by byte offset (lo 3 bits)
    let st_byte_off : logic<3> = c_store_addr[2:0];
    let st_mask_base: logic<8> = if c_store_funct3 == 3'b000 ?
        8'b0000_0001 // SB
    : if c_store_funct3 == 3'b001 ?
        8'b0000_0011 // SH
    : if c_store_funct3 == 3'b010 ?
        8'b0000_1111 // SW
    : if c_store_funct3 == 3'b011 ?
        8'b1111_1111 // SD
    :
        8'b0000_0000
    ;
    // M8: misalign STORE that spans 2 dwords. Compute 16-byte wstrb /
    // 128-bit wdata then split into lo/hi pieces. Hi pieces go to the
    // next-dword write via o_dmem_wstrb_hi / o_dmem_wdata_hi.
    let st_mask_ext : logic<16>  = ({8'd0, st_mask_base} as 16) << st_byte_off;
    let st_wdata_ext: logic<128> = ({64'd0, c_store_data} as 128) << ({4'd0, st_byte_off, 3'b000} as 7);
    // P10 cbo.clean/flush/inval (cbo_m) is a PMP-check-only NOP: force a zero
    // store-strobe so the committing "store" writes nothing (its only effect is
    // the commit-time R-or-W PMP check below).
    let st_wstrb    : logic<8>   = if c_is_cbo_m ? 8'd0 : st_mask_ext[7:0];
    // P10 cbo.zero acts on the whole line (offset irrelevant) — force the
    // misalign hi-strobe to 0 so it classifies as an SB-eligible line store.
    let st_wstrb_hi : logic<8>   = if c_is_cbo_zero || c_is_cbo_m ? 8'd0 : st_mask_ext[15:8];
    // Zacas amocas.q: the LO store data is rs2 (read from arch_regs at commit),
    // not the captured c_store_data; store_funct3 is SD so st_wstrb is 0xFF and
    // st_byte_off is 0 (16-byte aligned). The HI dword (rs2+1) goes to the dcache
    // 128-bit exclusive-merge extension via cas_q_new_hi / dc_wen_excl_q.
    let st_wdata    : logic<64>  = if c_is_cas_q ? cas_q_new_lo : st_wdata_ext[63:0];
    let st_wdata_hi : logic<64>  = st_wdata_ext[127:64];
    // Zacas amocas.q: drive the dcache's 128-bit exclusive-merge extension. The
    // actual write is still gated by the in-cache merge firing (dc_i_wen +
    // dc_wen_excl + owned line); on a mismatch commit_store_fire is 0, so no
    // write (lo or hi) lands.
    let dc_wen_excl_q: logic = c_is_cas_q;

    // Phase 8 S6: route a committing BARE-mode aligned PLAIN store to the
    // separate dcache store-drain port (i_saddr/i_swen). Excludes AMO/LR/SC
    // (c_is_amo — RMW on the combined port, SMP-critical) and misaligned
    // straddling stores (st_wstrb_hi != 0 — the hi-dword bypass path).
    // Phase 8 S20: also excludes non-DRAM (MMIO) targets — fast stores now
    // retire through the store BUFFER, and only DRAM lines are buffered; a
    // bare MMIO store falls back to the blocking i_wen path (its pre-S6 route).
    // P9.2 (write-back D$): the tohost pages (PA 0x8000_0xxx..0x8000_3xxx —
    // riscv-tests place tohost after .text, so it lands at 0x1000/0x2000/
    // 0x3000 depending on the test's size; litmus uses 0x1000 — and PA
    // 0x8000_8xxx for the benchmarks) are excluded: the harnesses watch the
    // DRAM array, and a buffered store would merge into an owned L1 line
    // without ever reaching it. Those stores keep the write-through i_wen
    // path (correct everywhere, just slower; in the Linux boot this window
    // is OpenSBI text/data, which writes it rarely).
    let st_tohost_page: logic = (c_store_addr[31:14] == 18'h20000) || (c_store_addr[31:12] == 20'h80008);
    // P10 cbo.zero is exempt from the tohost-page exclusion: it is a full-line
    // write (no partial merge that could hide from the harness), and the harness
    // only watches the tohost word — so it may buffer like any DRAM line store.
    // Phase 11-H: an HSV store (c_is_mem_virt) is translated (VA != PA) and must
    // never take the fast (bare-PA) path. Use c_is_mem_virt directly — NOT
    // dmem_vm_on_op — so fast_store→store_drive→dmem_op_hlv stays loop-free.
    assign fast_store = commit_store_fire && !asq_st_block && !c_is_amo && !dmem_vm_on && !c_is_mem_virt && st_wstrb_hi == 8'd0
        && c_store_addr[63:25] == 39'h40 && (!st_tohost_page || c_is_cbo_zero);

    // PMP (Smpmp): a fast store drains via the store-buffer / i_saddr port and
    // never reaches the dmem_mmu's i_wen PMP check, so check its bare PA here.
    // c_store_addr is the physical address (fast_store is bare-mode only). On a
    // deny the store-buffer push is suppressed and a store access fault (cause 7)
    // is raised through the commit store-fault path.
    var fast_store_pmp_deny: logic;
    inst u_pmp_fast_store: pmp_check (
        i_addr   : c_store_addr ,
        i_acc    : 2'd1         , // write
        i_priv   : dmem_mmu_priv,
        i_pmpcfg : csr_pmpcfg   ,
        i_pmpaddr: csr_pmpaddr  ,
        o_fault  : fast_store_pmp_deny,
    );
    // cbo.clean/flush/inval (cbo_m) reach this as a bare zero-strobe fast store,
    // but they fault on R-AND-W denial (not W-only) — handled by cbo_m_acc_fault
    // below, so exclude them from this W-only check.
    // PMA: a bare store to a PA with no backing memory/device (a hole) takes a
    // store access fault (cause 7), same as a PMP-W denial. Map: DRAM pa[31],
    // CLINT 0x02xx_xxxx, UART 0x1xxx_xxxx, PLIC 0x0Cxx_xxxx (ACT4 cfg_A_tor_zero).
    let fast_store_pma_hole: logic = PMA_FAULT && !(c_store_addr[31] || c_store_addr[31:24] == 8'h02 || c_store_addr[31:28] == 4'h1 || c_store_addr[31:24] == 8'h0c);
    assign fast_store_acc_fault = fast_store && (fast_store_pmp_deny || fast_store_pma_hole) && !c_is_cbo_m;

    // CP commit-store pre-translate (P5a, change A — DEAD at STORE_PRETRANSLATE=0):
    // a committing PLAIN VM cacheable store whose PA was already produced at execute
    // by the side-effect-free TLB probe (sh_store_pa[head] = c_store_pa, a ROB FF).
    // When set, the SB push / MMIO classify / commit decision drain this REGISTERED
    // PA instead of re-running the live MMU at commit — taking the MMU off the
    // n_inflight/valid_* front (cp_commit_store_pretranslate_plan §3.6/§9). AMO/SC,
    // misaligned (st_wstrb_hi), and MMIO PAs are excluded (commit-translate stays).
    // The `STORE_PRETRANSLATE &&` prefix const-folds this to 0 in the DEAD build, so
    // every consumer below collapses to its live-MMU form = byte-identical.
    let c_pretx_fast: logic = STORE_PRETRANSLATE && commit_store_fire && c_store_pa_valid
        && !c_is_amo && dmem_vm_on_op && st_wstrb_hi == 8'd0
        && c_store_pa[63:25] == 39'h40
        && !((c_store_pa[31:14] == 18'h20000) || (c_store_pa[31:12] == 20'h80008));
    // CP commit-store pre-translate (P5a, change B — DEAD at STORE_PRETRANSLATE=0):
    // a non-pre-translated VM cacheable store that missed the execute-time probe is
    // held one cycle by the existing M-stage handshake (store_fetched_q) — its PA
    // translates live in cycle N and registers into m_pa_q. In the retire cycle it
    // SB-pushes that REGISTERED m_pa_q instead of doing the M-stage dcache write (which
    // loses a cacheable store — the §4.1 P3 boot corner). sb_2cyc_ok fires only when the
    // registered PA is cacheable DRAM (not tohost) and the translate did not fault
    // (m_fault_q: a faulting held store traps from the registered fault, never pushes).
    let m_pa_cacheable: logic = (m_pa_q[63:25] == 39'h40)
        && !((m_pa_q[31:14] == 18'h20000) || (m_pa_q[31:12] == 20'h80008));
    // A MISALIGNED held store (m_wstrbhi_q != 0) must NOT SB-push — it needs the M-stage
    // 2-line write/invalidate (dc_i_wen path), so exclude it here (else it would both
    // SB-push and M-stage-write the same store). Aligned cacheable held stores have
    // dc_i_wen=0 (sb_vm_live_ok=1) → dc_st_wstrb_hi=0 → m_wstrbhi_q=0.
    // 🚨 …and an ATOMIC must NOT SB-push either. Its siblings both say so explicitly
    // (c_pretx_fast and sb_vm_live_ok each carry `&& !c_is_amo`); this arm leaned on
    // store_fetched_q to imply "plain store", which is FALSE: an AMO held at the head
    // for even one cycle (sb_empty=0, dcache_stall, …) satisfies that latch's
    // `store_drive && !sb_elig && !dmem_mmu_busy` set condition, and the next cycle it
    // becomes sb_elig. That skips the retire gate's `c_is_amo ? !sb_empty` term, so the
    // atomic RETIRES THROUGH THE STORE BUFFER as a plain store — no ownership, no
    // atomic-SQ allocation (asq_alloc needs sb_empty), no in-cache merge. At
    // ASQ_NOREAD=0 it is latent (the buffered data is the correct pre-computed RMW
    // result, so only the atomicity is lost); with R3.2c's execute read gone there IS
    // no pre-computed result and the buffer writes garbage — traced as a lost update on
    // an `amoadd.w x0` that retired with alloc=0 / cwr=0 / sbpush=1 (§7.18).
    let sb_2cyc_ok: logic = STORE_PRETRANSLATE && store_fetched_q && !c_is_amo && m_pa_cacheable && !m_fault_q && (m_wstrbhi_q == 8'd0);
    // R1 (store-queue / decoupled-retire, first CP-moving piece — the §8 "const/physical
    // separation" the runtime-mux atomic-PA decouple could not deliver). SB_PA_REG=1
    // DELETES the last live-TLB consumer on the retire gate: c_store_eff_pa (= sb_pa)'s
    // `dmem_vm_on_op ? dmu_dmem_addr` arm. After RETIRE_DECOUPLE (fault/PMP off ac_pa_q)
    // and STORE_PRETRANSLATE (plain-store PA registered), the residual 13.8 ns wall is the
    // ATOMIC re-driving the live TLB into sb_pa → sb_merge_ok → rob_commit_ack (a FALSE
    // PATH: sb_elig requires !c_is_amo so the atomic never merges — but STA cannot prune a
    // logically-reachable shared live arm; cp_retire_decouple_plan §8). A RUNTIME
    // `if c_is_amo ? ac_pa_q : dmu_dmem_addr` mux was REFUTED (§8: the live arm survives,
    // +level). This is different: the live arm is DELETED (const-gate), replaced by two
    // FLOPS. Every store that reaches the live arm (!c_pretx_fast && !sb_2cyc_ok &&
    // dmem_vm_on_op) is either (a) a VM atomic → ac_pa_q (its read-time PA, held issue→
    // commit); (b) a slow store at its M3a TRANSLATE cycle → HELD by rob_commit_ack (term
    // 3889/dmem_mmu_busy), so sb_pa is don't-care (sb_elig=0 ⇒ no push); or (c) a VM
    // MMIO/slow store at its RETIRE cycle → m_pa_q (the M-stage translate PA, valid because
    // it rode store_fetched_q). So sb_pa's only FUNCTIONAL consumers on the live arm —
    // c_store_mmio (term 3890) for MMIO, masked/held otherwise — read the CORRECT registered
    // PA; sb_merge_ok is masked for every live-arm store (all !sb_elig). Registered-arm
    // stores (c_pretx_fast/sb_2cyc_ok) are untouched. At SB_PA_REG=0 const-folds to
    // dmu_dmem_addr = byte-identical. The =1 flip is the full-SMP-ladder-gated step (retire
    // = memory-ordering heart). See doc/cp_store_queue_plan.md.
    const SB_PA_REG: bit = 1;
    // The effective committing-store PA: the registered probe PA for a pre-translated
    // store, the registered M-stage PA for a 2-cycle held cacheable store, else the live
    // mux (VM → dmu_dmem_addr, bare → c_store_addr). At STORE_PRETRANSLATE=0 (c_pretx_fast
    // ≡ sb_2cyc_ok ≡ 0) this is exactly the old `dmem_vm_on_op ? dmu_dmem_addr :
    // c_store_addr` mux.
    let c_store_eff_pa: logic<64> = if c_pretx_fast ? c_store_pa : if sb_2cyc_ok ? m_pa_q
        : if dmem_vm_on_op ? (if SB_PA_REG ? (if c_is_amo ? ac_pa_q : m_pa_q) : dmu_dmem_addr) : c_store_addr;

    // PMP (Smpmp): commit-time WRITE check for the dcache exclusive-write path
    // (AMO/SC). Bare uses the physical c_store_addr; a VM access uses the
    // translated dmu_dmem_addr (sb_pa's mux). On a deny the exclusive write is
    // suppressed and a store/AMO access fault (cause 7) is raised at commit.
    // R3 L3 (retire decouple, atomic): a VM AMO/SC's commit PMP sits on the LIVE TLB PA
    // (dmu_dmem_addr) — the §7.1 binding requester u_pmp_amo_commit. But the M4 machinery
    // already captured the atomic's read-time translated PA (ac_pa_q, held issue→commit
    // since the atomic is serialized at the head, and = the commit PA — it drives the
    // amo_commit_live write too). RETIRE_DECOUPLE=1 sources the PMP off that REGISTERED
    // PA instead of the live TLB, so the TLB leaves rob_commit_ack. This does NOT touch
    // the atomic's commit WRITE timing (single-cycle, live hit_excl — M3b unchanged); it
    // only registers the FAULT's address. ac_pa_q is only valid for a real AMO/SC (LR is
    // excluded from its capture) but amo_commit_acc_fault is commit_store_fire-gated (LR
    // never writes → gated off), so a stale ac_pa_q for an LR is harmless. =0 folds to
    // the live PA = byte-identical.
    var amo_commit_pmp_deny: logic;
    inst u_pmp_amo_commit: pmp_check (
        i_addr   : if RETIRE_DECOUPLE ? ac_pa_q : if dmem_vm_on_op ? dmu_dmem_addr : c_store_addr,
        i_acc    : 2'd1         , // write
        i_priv   : dmem_mmu_priv,
        i_pmpcfg : csr_pmpcfg   ,
        i_pmpaddr: csr_pmpaddr  ,
        o_fault  : amo_commit_pmp_deny,
    );
    assign amo_commit_acc_fault = commit_store_fire && c_is_amo && amo_commit_pmp_deny;

    // PMP (Smpmp): an SC whose reservation is INVALID clears its store flag at
    // execute (alu_wrap amo_commit_store=0 → c_is_store=0 at commit), so it
    // never reaches the commit-time exclusive-write PMP check (u_pmp_amo_commit,
    // gated by commit_store_fire). Yet an SC to a W-denied region must STILL
    // raise a store access fault (cause 7) regardless of the reservation
    // (Sail / ACT4 PMPZalrsc cfg_wr). Check the SC's WRITE permission at ISSUE
    // on its bare physical address (agu_addr_iss; AMO imm=0 so this is rs1) and
    // route the deny into the SC's CDB store-fault via alu_wrap (i_sc_acc_fault)
    // — the recorded is_sfault/fault_acc trap with cause 7 at commit even though
    // c_is_store is 0. Bare only: a VM SC translates and the commit-time check
    // covers the matched (storing) path; a VA here would mis-check PMP.
    var sc_issue_pmp_deny: logic;
    inst u_pmp_sc_issue: pmp_check (
        i_addr   : agu_addr_iss ,
        i_acc    : 2'd1         , // write
        i_priv   : dmem_mmu_priv,
        i_pmpcfg : csr_pmpcfg   ,
        i_pmpaddr: csr_pmpaddr  ,
        o_fault  : sc_issue_pmp_deny,
    );
    assign sc_issue_acc_fault = issue_is_sc && !dmem_vm_on_op && sc_issue_pmp_deny;

    // PMP (Smpmp): cbo.clean/flush/inval (Zicbom) are cache-maintenance NOPs in
    // this coherent design, but they must take a store/AMO access fault (cause 7)
    // when the block has NEITHER read NOR write permission — the R-or-W rule the
    // Sail reference applies (cbo.zero is W-only and already faults via the store
    // path; clean/flush/inval fault only when BOTH R and W are denied). Two
    // pmp_checks (R, W) on the cbo PA — bare = c_store_addr, paged = the
    // dmem_mmu-translated dmu_dmem_addr — fault iff both deny.
    let cbo_m_addr: logic<64> = if dmem_vm_on_op ? dmu_dmem_addr : c_store_addr;
    var cbo_m_pmp_deny_r: logic;
    var cbo_m_pmp_deny_w: logic;
    inst u_pmp_cbo_m_r: pmp_check (
        i_addr   : cbo_m_addr   ,
        i_acc    : 2'd0         , // read
        i_priv   : dmem_mmu_priv,
        i_pmpcfg : csr_pmpcfg   ,
        i_pmpaddr: csr_pmpaddr  ,
        o_fault  : cbo_m_pmp_deny_r,
    );
    inst u_pmp_cbo_m_w: pmp_check (
        i_addr   : cbo_m_addr   ,
        i_acc    : 2'd1         , // write
        i_priv   : dmem_mmu_priv,
        i_pmpcfg : csr_pmpcfg   ,
        i_pmpaddr: csr_pmpaddr  ,
        o_fault  : cbo_m_pmp_deny_w,
    );
    // R1 (SB_PA_REG): the shared u_pmp_cbo_m_r/w above sit on cbo_m_addr, a runtime mux
    // (dmem_vm_on_op ? dmu_dmem_addr(LIVE TLB) : c_store_addr) — needed LIVE for the VM
    // M-stage capture into m_cbom_pmp_*_q. But cbo_m_acc_fault's BARE arm reads that same
    // shared deny, so STA cannot prune the live-TLB VM arm from the bare path → the cbo.m
    // PMP is a shared-live-TLB FALSE PATH on rob_commit_ack (the residual 13.800 wall once
    // sb_pa is off, measured). These DEDICATED bare checkers sit on c_store_addr ONLY (no
    // TLB): for a bare cbo.m cbo_m_addr==c_store_addr so they are behaviourally identical,
    // but STA-clean. At SB_PA_REG=1 the bare arm reads these; the shared u_pmp_cbo_m then
    // feeds only the M-stage flop capture (path ends) → the live TLB leaves rob_commit_ack.
    // Unread at SB_PA_REG=0 → DCE = byte-identical. See doc/cp_store_queue_plan.md.
    var cbo_m_bare_deny_r: logic;
    var cbo_m_bare_deny_w: logic;
    inst u_pmp_cbo_m_bare_r: pmp_check (
        i_addr   : c_store_addr  ,
        i_acc    : 2'd0          , // read
        i_priv   : dmem_mmu_priv ,
        i_pmpcfg : csr_pmpcfg    ,
        i_pmpaddr: csr_pmpaddr   ,
        o_fault  : cbo_m_bare_deny_r,
    );
    inst u_pmp_cbo_m_bare_w: pmp_check (
        i_addr   : c_store_addr  ,
        i_acc    : 2'd1          , // write
        i_priv   : dmem_mmu_priv ,
        i_pmpcfg : csr_pmpcfg    ,
        i_pmpaddr: csr_pmpaddr   ,
        o_fault  : cbo_m_bare_deny_w,
    );
    // R3 L2 (cbo.m): the R-AND-W PMP deny is on cbo_m_addr (= the live TLB PA dmu_dmem_addr
    // for a VM cbo.m) — the §7.1 binding requester (u_pmp_cbo_m_w on the live TLB). Register
    // it at the M3a translate cycle N (m_cbom_pmp_r/w_q) and read at N+1 under store_fetched_q
    // so RETIRE_DECOUPLE=1 takes it off rob_commit_ack. =0 folds to the live deny = byte-id.
    // R3 L2 fix: only a VM (paged) cbo.m routes its PMP through the LIVE TLB
    // (cbo_m_addr = dmu_dmem_addr) and rides the M3a walk (store_fetched_q), so its
    // deny is read from the walk-cycle-registered m_cbom_pmp_*_q. A BARE (M-mode)
    // cbo.m has cbo_m_addr = c_store_addr (already ROB-registered, NOT the live TLB)
    // and retires in ONE cycle without ever setting store_fetched_q — so its register
    // holds the PREVIOUS op's deny (stale). Use the LIVE deny for the bare case: it is
    // a PMP on a registered address (no live TLB on rob_commit_ack), so it is
    // CP-neutral, and it is the ONLY correct source when store_fetched_q never fires.
    assign cbo_m_acc_fault = rob_commit_valid && c_is_cbo_m && !c_illegal
        && (if RETIRE_DECOUPLE ? (if dmem_vm_on_op ? (if store_fetched_q ? (m_cbom_pmp_r_q && m_cbom_pmp_w_q) : 1'b0) : (if SB_PA_REG ? (cbo_m_bare_deny_r && cbo_m_bare_deny_w) : (cbo_m_pmp_deny_r && cbo_m_pmp_deny_w))) : (cbo_m_pmp_deny_r && cbo_m_pmp_deny_w));

    // Core dmem view (pre-MMU virtual address)
    //
    // M9.A.303: a STORE committing at the ROB head must NOT hijack the dmem
    // MMU port while a younger LOAD's page-table walk is in flight. The store's
    // *retire* is already stalled by rob_commit_ack (it cannot leave the ROB
    // while dmem_mmu_busy), but commit_store_fire still drove core_dmem_vaddr /
    // core_dmem_wen, flipping the MMU's i_vaddr to the store VA and i_store=1
    // mid-walk. That (a) broke walk_va_match so the load's DONE result was
    // suppressed (busy held), and (b) re-evaluated the load's PTE as a STORE
    // permission check (ptw_rwx_ok=pte_w, leaf_valid wants the D bit), which
    // spuriously faults a valid read-only / clean kernel load — observed as the
    // Linux boot load-fault loop at PC 0x800b84a4 / VA 0x80616198 (~5438-cy
    // period). Hold the load's *latched* VA (walk_vaddr_q) and suppress the
    // store drive for the whole load walk. walk_v_q / walk_is_store_q are
    // registers, so this introduces no combinational path into the MMU's
    // busy/req. v1 (in-order, single MEM stage) cannot hit this: a store and a
    // load never co-drive the MMU in the same cycle.
    let load_walk_busy : logic     = walk_v_q && !walk_is_store_q;
    // Phase 8 S6: a fast store drains via the i_saddr port, NOT the i_wen path,
    // so exclude it from store_drive. This also drops load_blocks_on_store for
    // the fast-store cycle (= issue_is_load && store_drive), letting the load
    // read coexist with the store write on the separate ports.
    // R3 §7.2: a queued atomic is older than any committing store, so no store may
    // drive its write while the queue is occupied (see asq_st_block).
    // ── Block L1.a (STORE_NOPORT): a PRE-TRANSLATED store needs NOTHING from the
    // shared dmem port, so it must not take it. ──────────────────────────────────
    // S6 already established the pattern for BARE mode: a `fast_store` drains via
    // i_saddr, so it is excluded from store_drive and a load may issue in the same
    // cycle. Under VM `fast_store` is 0 by construction (it requires !dmem_vm_on), so
    // EVERY kernel store re-drives the shared MMU at commit — even the ones whose PA
    // was already produced at execute by the STORE_PRETRANSLATE probe. Enumerate what
    // such a store still reads off the live port:
    //   - its PA          → c_store_eff_pa takes the c_pretx_fast arm (registered).
    //   - its SB push     → sb_vm_ok = c_pretx_fast (registered classifier).
    //   - its MMIO class  → c_store_mmio from the registered c_store_eff_pa.
    //   - its faults      → RETIRE_DECOUPLE makes sfault_*_eff = store_fetched_q ?
    //                       m_*_q : 0, and a pretx store retires in ONE cycle without
    //                       ever setting store_fetched_q, so they are already 0. The
    //                       probe (dmem_sprobe_ok) checked W&D + U + PMP-W + backing
    //                       at execute; D is already set, so no A/D write-back either.
    //   - its dcache write→ none: sb_elig ⇒ the write-through path is suppressed
    //                       (dc_i_wen's !sb_vm_live_ok term) and it drains through the
    //                       SECOND write port (i_saddr) like a fast store.
    // NOTHING. The port hold is pure fusion, and it is the largest remaining stall
    // bucket: `store_drive` = 641,637 cy = 4.87 % of the N=1 boot, 91.5 % of the
    // `store` sole-blocker bucket (plan doc, Block L1). Dropping it frees the SAME
    // three consumers S6 freed for bare mode — load_blocks_on_store (Stage-A capture),
    // lsr_drive (Stage-B read), replay_drive — plus store_pretx_valid itself, which
    // carries !store_drive, so a freed port also raises the probe's own hit rate.
    // ⚠️ LOOP-FREE PREDICATE, not `c_pretx_fast`. c_pretx_fast reads dmem_vm_on_op =
    // dmem_vm_on || dmem_op_hlv, and dmem_op_hlv reads store_drive (:9360) — the exact
    // edge fast_store's `use c_is_mem_virt, NOT dmem_vm_on_op` comment was written to
    // avoid. This uses the CSR-derived dmem_vm_on (registers) and excludes HSV
    // outright, so it IMPLIES c_pretx_fast (dmem_vm_on ⇒ dmem_vm_on_op) without
    // closing the loop; every other term is c_pretx_fast's own, verbatim.
    // Const-guarded STATEMENT form so DEAD really const-folds (the CONST && sig trap).
    // ✅ MEASURED (2026-08-19): N=1 boot 13,180,000 -> 12,370,000 (-6.15 %), N=2 SMP
    // 18,100,000 -> 17,340,000 (-4.20 %), N=4 SMP 25,650,000 -> 24,780,000 (-3.39 %),
    // together with SB_DRAIN_SHADOW and LSR_B2B_SBQ=0. Bare-mode gates stay
    // instret-identical (this cannot fire without dmem_vm_on). It paid MORE than its
    // 641,637-cy census bucket (790,000 unrestricted) — the store_pretx_valid
    // self-reinforcement noted above.
    // 🚨 SB_DRAIN_SHADOW IS A PREREQUISITE, NOT A FOLLOW-ON. This flip ALONE wedges the
    // N=2 SMP boot (hart1 never leaves firmware, h1_pc=0x51a / trap1=0 — the S20R
    // doorbell signature, :5.1). Freeing the port lets a load capture on cycles the
    // committing store used to idle it, and some of those land in the store-drain window
    // the shadow closes. LSR_B2B_SBQ only ever guarded the b2b door into that SAME
    // window; this opened the ordinary one. See cp_store_queue_plan.md §13.3.
    const STORE_NOPORT: bit = 1;
    // L1.a BISECTION arm (2026-08-19): the unrestricted flip WEDGED the N=2 SMP boot —
    // hart1 never leaves firmware (PC 0x51a, trap1=0), the S20R doorbell signature. Two
    // live hypotheses, and this term separates them from everything else:
    //   (i)  the §9 drain-window visibility skew, now reachable through the ORDINARY
    //        capture path (LSR_B2B_SBQ only guards the b2b one), and
    //   (ii) DRAIN STARVATION: store_drive was an implicit drain priority — every
    //        committing store idled the load stream for a cycle, handing the IDLE-only
    //        drain its slots. S20.2 knew about this coupling and kept only the
    //        `sb_cnt >= 3` watermark when the buffer took over; L1.a removes the rest.
    // Both live in the non-empty-SB window, so restricting the flip to sb_empty tests
    // "is the hazard SB-related at all" in ONE run. sb_empty is a register → loop-free.
    const STORE_NOPORT_SBE: bit = 0;
    var store_noport: logic;
    always_comb {
        store_noport = 1'b0;
        if STORE_NOPORT && STORE_PRETRANSLATE {
            if commit_store_fire && c_store_pa_valid && !c_is_amo && dmem_vm_on && !c_is_mem_virt
                && st_wstrb_hi == 8'd0 && c_store_pa[63:25] == 39'h40
                && !((c_store_pa[31:14] == 18'h20000) || (c_store_pa[31:12] == 20'h80008))
                && (!STORE_NOPORT_SBE || sb_empty) {
                store_noport = 1'b1;
            }
        }
    }
    let store_drive    : logic     = commit_store_fire && !load_walk_busy && !fast_store && !asq_st_block && !store_noport;
    // M9.3: a load walk PHYSICALLY owns the dmem port only while the MMU FSM is
    // NOT idle (LEVEL/DONE/FAULT). walk_v_q is a registered owner tag that, under
    // hart1's SMP bus-contention back-to-back walks, stays set CONTINUOUSLY across
    // walks (busy never drops between them, so the `walk_v_q && !dmem_mmu_busy`
    // clear below never fires) — leaving a STALE window where walk_v_q=1 but the
    // MMU is already back in IDLE about to start the NEXT walk. In that window the
    // old `load_walk_busy ? walk_vaddr_q` pin forced the freshly-issuing load
    // (incl. a squash-reused walk_rob_q "owner" that load_walk_block lets through)
    // to inherit the PREVIOUS walk's VA. When the previous walk was a wrong-path
    // VA~0 load, the new VALID load then walked VA~0, faulted at the root PTE, and
    // lfault_inj delivered stval=0 to it (walk_rob_q==itself, walk_v_q=1) — a
    // spurious load page fault => the N=2 trap storm. Gate the pin (and the ren
    // term) on a real in-flight walk so the fresh load drives its OWN agu_addr_iss
    // and the walk_vaddr_q re-latch at dmem_walk_start captures the correct VA.
    // dmem_mmu_idle is the MMU's `state` register (== IDLE), combinationally
    // independent of i_vaddr/core_dmem_vaddr, so no combinational loop is formed.
    let mmu_walk_inflight: logic   = load_walk_busy && !dmem_mmu_idle;
    // Phase 12 V1: the VU owns the dmem port (highest priority) while it streams
    // a unit-stride vector load/store. vu_mem_active is a registered FSM state
    // and only asserts when the scalar mem path is quiescent (vu_mem_idle gated
    // the start), so it never races store_drive (the vector op is the ROB head =
    // no scalar store committing) or an in-flight walk.
    let core_dmem_vaddr: logic<64> = if vu_mem_active ? vu_mem_vaddr : if store_drive ? c_store_addr : if mmu_walk_inflight ? walk_vaddr_q : if sqrt_drive ? sqrt_vaddr : agu_addr_iss;
    let core_dmem_wdata: logic<64> = if vu_mem_active ? vu_mem_wdata : st_wdata;
    let core_dmem_wen  : logic     = if vu_mem_active ? vu_mem_is_store : store_drive;
    // PMP (Smpmp): the dmem port carries a real AMO's RMW read (agu_addr_iss) only
    // when no store/walk/vector access overrides it — match core_dmem_vaddr's
    // agu_addr_iss arm. Tells dmem_mmu to also require WRITE permission so an AMO
    // to a W-denied region faults (cause 7 via alu_wrap's amo-fault routing).
    // A failing SC's translation walk (issue_sc_walk) is store-semantics too: ask
    // the MMU to check W so a W-denied region faults, matching Sail's translate-for-
    // write. The walk drives agu_addr_iss (the SC's VA) on the same i_ren cycle.
    let core_dmem_is_amo: logic = (issue_is_realamo || issue_sc_walk) && !vu_mem_active && !store_drive && !mmu_walk_inflight;
    // CP commit-store pre-translate (capture): latch the dmem MMU's side-effect-free
    // STORE TLB probe (dmem_sprobe_pa/ok) into the ROB when the lane-0 CDB op is a plain
    // store (not AMO) whose OWN VA is on the dmem port this cycle (core_dmem_vaddr ==
    // agu_addr_iss: no store-commit / PTW-walk / VU override drives the port), the probe
    // is a clean store fast-path hit (dmem_sprobe_ok: V=0 TLB hit, store W&D + U perm,
    // cacheable, PMP-W ok, backed PA, IDLE), and no translation-state change is in flight
    // (rob_has_pending_xlate: a stale-across-satp/SFENCE store falls back to commit). The
    // probe PA equals what the commit-time store_drive translation would produce for this
    // VA. Faults always fall back (sprobe_ok=0 on any deny), so xfault is constant 0.
    // Unread at STORE_PRETRANSLATE=0; the commit drain that uses sh_store_pa is in P3.
    assign store_pretx_pa     = dmem_sprobe_pa;
    assign store_pretx_xfault = 1'b0;
    assign store_pretx_valid  = cdb.valid && cdb.is_store && !iq_iss_is_amo
        && !store_drive && !mmu_walk_inflight && !vu_mem_active
        && dmem_sprobe_ok && !rob_has_pending_xlate;

    // ── Block L1.b: SQ translate retry (DEAD at SQ_RETRY=0) ─────────────────────
    // Oldest-first select over the ROB store shadow. ls_fwd[i] already implies
    // EXECUTED (o_store_fwdable carries sh_rw), so a candidate's VA is real and the CDB
    // cannot be writing that entry this cycle. Self-referencing accumulator, the same
    // shape as iq_int's oldest-ready select; const-guarded STATEMENT form so DEAD folds.
    // 🚨 REFUTED — DO NOT FLIP. Measured 2026-08-19: =1 gives 43-50/252 (litmus violation,
    // N=1 boot dead at instret 121,850), and it breaks BARE-mode rv64ui-add, where the
    // probe cannot even capture (o_sprobe_ok carries vm_enabled). Isolating the two halves
    // proved the ROB write is innocent: the PORT ARM alone breaks it, and tightening
    // sqrt_port_free all the way to `!iq_issue_valid` made it WORSE (202 -> 209 failures).
    //
    // 🎯 ROOT CAUSE, and it is STRUCTURAL, not a missing term: `m_pa_q = dmu_dmem_addr`
    // is latched EVERY CYCLE with NO ENABLE (:11709). The M-stage PA register mirrors
    // whatever sits on the shared MMU output, and its consumers read it under their OWN
    // latched control (m_wen_q / m_ren_q). **There is therefore no such thing as a free
    // cycle on this port** — every cycle's address is captured by the M stage, so any
    // opportunistic re-probe becomes the next cycle's memory address. No predicate can
    // fix that; a tighter one only reads more of the users' state.
    //
    // This is the mirror image of feedback_driver_is_not_owner_sync_read: there the
    // DRIVER was not the OWNER; here EVERY driver is unconditionally the owner.
    //
    // Two ways this could be revived, both touching load-bearing structure and neither
    // justified by L1.b's ~2.8 % ceiling on its own: (a) give `m_pa_q` a real enable —
    // a genuine improvement (it free-runs today, so it also toggles for nothing) but it
    // is the heart of the shipped MEM_PIPE; (b) give the probe its OWN address port, i.e.
    // a second TLB read port — clean, kills the whole hazard class, costs real area.
    // Kept DEAD as the record of the dead end; see cp_store_queue_plan.md §15.
    const SQ_RETRY: bit = 0;
    always_comb {
        sqrt_sel_v = 1'b0;
        sqrt_idx   = '0;
        sqrt_vaddr = 64'd0;
        sqrt_age   = '0;
        if SQ_RETRY {
            for i in 0..ROB_DEPTH {
                let age_i: logic<ROB_IDX_W> = (i as ROB_IDX_W) - rob_head_idx;
                if ls_fwd[i] && !ls_pa_v[i] && (!sqrt_sel_v || age_i <: sqrt_age) {
                    sqrt_sel_v = 1'b1;
                    sqrt_age   = age_i;
                    sqrt_idx   = i as ROB_IDX_W;
                    sqrt_vaddr = ls_addr[i];
                }
            }
        }
    }
    // Zicbom: the dmem port is driving a cbo.clean/flush/inval's commit-time walk
    // (store-routed, so core_dmem_wen is high while it holds the ROB head). Tells
    // the MMU to use the relaxed R-OR-W cbo page permission instead of W.
    let core_dmem_cbo: logic = core_dmem_wen && c_is_cbo_m;
    // M9.A.316: do NOT let a speculative LOAD request the dmem MMU on a
    // redirect cycle. The IQ flush is registered, so on the redirect cycle the
    // IQ still holds wrong-path ops and the issue logic can select one; if that
    // op is a LOAD with a TLB-missing address it starts a PTW walk THIS cycle.
    // The walk_v_q latch gives dmem_walk_start priority over redirect_fire_q
    // (M9.A.312), so the SQUASHED load gets latched as the walk owner; after the
    // redirect the epilogue reuses that rob index, and the wrong-path walk's
    // fault is injected into the now-valid reused entry (load_walk_busy also
    // pins core_dmem_vaddr to the walk VA, keeping walk_va_match=1 so M9.A.313's
    // gate cannot suppress it). Seen as a spurious LOAD page fault at VA 0x30
    // (a `c.lw 48(a0)` with a0=0 on the not-taken side of `beq a0,x0,...`
    // @0x8003ac78) mis-attributed to the epilogue `c.ldsp s0,160(sp)` @0x8003aad4
    // -> "kernel access to user memory ... VA 0x30" init Oops. Gate the LOAD
    // request on !redirect_fire (mirrors imem_mmu's `i_req: !redirect_fire`);
    // no walk starts this cycle, the wrong-path load is flushed, and the walk
    // owner is never a squashed op. load_walk_busy (an already-in-flight walk)
    // is preserved; stores commit in-order (never speculative) so are unaffected.
    // Phase 8 S5.1: suppress the LOAD read request while a STORE drives its
    // commit write (store_drive) — the dcache port + address are the store's this
    // cycle, so a concurrent ren would be a conflicting request that wedges
    // dcache_stall. The load is held in the IQ (iq_issue_ack gated by
    // load_blocks_on_store) and re-issues once the store commits.
    // Phase 8 S6: an AMO/LR read does NOT participate in store-to-load forwarding
    // (stld_fwd_en excludes is_amo), so it must not read the dcache while an older
    // FAST store is committing — the store-drain write only lands at the clock
    // edge, so a same-cycle AMO read would see STALE data and compute the wrong
    // RMW (the rv64ua subtest-5 failures). Plain loads DO forward, so they may
    // coexist with the fast store. The AMO read is held in the IQ until the older
    // fast store commits (its data is then in the dcache). issue_amo_read covers
    // AMO + LR (not SC, which is a store).
    // Phase 8 S20: the buffer does NOT forward — a load whose dword span may
    // overlap a buffered (committed, not yet drained) store is simply HELD in
    // the IQ until the buffer drains those bytes into the dcache (a few
    // cycles). The compare is on the load's translated address (dmu_dmem_addr
    // — only meaningful on a load-driving cycle, and the other arms block the
    // non-load-driving cycles anyway), conservatively covering dword and
    // dword+1 (misaligned spans). AMO/LR reads (no forward network at all)
    // wait for the buffer to be fully empty, including a same-cycle push.
    // The AMO arm uses commit_store_fire (not sb_push — that reaches through
    // the MMU's translated address and would close a comb loop into
    // core_dmem_ren): an AMO/LR read waits out ANY retiring store, which
    // covers the same-cycle buffer push.
    // S20.2 (N4 +13% fix): a full !sb_empty wait for EVERY AMO convoyed the
    // 4-hart lock traffic — an acquiring hart's AMO waited out its own drain
    // (bus-grant bound) on every lock op. RVWMO only requires prior-store
    // visibility for a RELEASE (rl, instr[25]); a plain/acquire AMO needs
    // just its own RMW bytes to be drained, which sb_ld_ovl already enforces
    // (issue_is_load includes AMO reads, compared on the AGU page offset).
    // Linux's unlock is fence+store (the FENCE gate drains), so rl AMOs are
    // rare; LR carries its rl bit the same way.
    // S20.2 watermark back-pressure: pre-S20 a pending store suppressed the
    // whole load stream (store_drive arm) — an implicit but STRONG drain
    // priority. The buffer drops that coupling for its retire win, but at
    // N=4 contention-stretched fills then chain back-to-back and the drain
    // (IDLE-only) starves into a permanent sb_full retire stall. Restore the
    // old priority ONLY under pressure: at the high watermark, hold new
    // loads so the current fill is the last of the chain and the drain gets
    // its slots. At N=1 drains are fast and the watermark is rarely hit.
    // S24.2: the S20R conservative VM hold (issue_is_load && dmem_vm_on &&
    // !sb_empty, which held every VM load while ANY committed store was
    // buffered) is REMOVED. The "4th leak path" it masked was a Veryl-sim
    // comb-scheduling bug (a backward reader interleaved into the sb_ld_ovl
    // write group; fixed upstream in the simulator's stable_topo_sort), not
    // RTL: with the precise gates here plus the MSHR sb-overlap poison, both
    // the fixed native sim and a Verilator cross-check boot N1/N2/N4 Linux
    // with byte-identical commit streams (N2 -4.4% / N1 -1.5% cycles).
    // S27: a plain LOAD no longer blocks on a buffered-store overlap — the
    // sb forward layer (sbf*/sbg*, near the sb FIFO) supplies the pending
    // bytes on the data path instead. The overlap scan still gates:
    //  - an AMO/LR read (issue_amo_read): its RMW value must come from
    //    MEMORY after the drain (AMOs are excluded from the forward nets);
    //  - a VM load whose 8-byte window crosses a page boundary: the forward
    //    layer compares PHYSICAL addresses byte-by-byte as pa+p, which is
    //    wrong past a page edge — hold it the old way until the buffer
    //    empties (page-tail misaligned loads are vanishingly rare).
    let sb_ld_pg_edge: logic = agu_addr_iss[11:3] == 9'h1ff && agu_addr_iss[2:0] != 3'd0;
    assign load_blocks_on_store = (issue_is_load && store_drive) || (issue_amo_read && sb_ld_ovl)
        // R3.1 §6.4: hold any access overlapping a queued atomic (no forward possible).
        || ((issue_is_load || issue_amo_read) && asq_ld_ovl)
        // R3.2b: and hold ALL new load/AMO issue while the drain engine is running, so
        // the shared dcache port quiesces for it (anti-starvation — the engine never
        // preempts an in-flight access). Bounded by the drain, which is a few cycles
        // once it owns the line.
        || ((issue_is_load || issue_amo_read) && asq_dr_busy)
        // R3.2c: the page-edge hold is a plain-LOAD forward-layer restriction, so it
        // keys off "is an atomic at all" (issue_amo_xlat), not "does it read".
        || (issue_is_load && !issue_amo_xlat && dmem_vm_on && sb_ld_pg_edge && !sb_empty_eff)
        || (issue_is_load && sb_cnt >= 4'd3)
        || (issue_amo_read && (commit_store_fire || (!sb_empty_eff && iq_issue_op.base.instr[25])))
        // P9.3: an AMO/LR read must NOT issue while a younger load's PTW walk
        // owns the dmem port (mmu_walk_inflight) — the dcache i_addr is the
        // walk's VA then, so dc_amo_read is 0 (no ownership enforcement) and
        // the AMO would capture the WALK's read instead of upgrading its own
        // S line to E. With force-miss gone (P9.3), an owned-line hit serves
        // instantly and exposed this: the AMO armed its watch on a stale S
        // line, then its commit write wedged (needs E/M) with no poison
        // (the line is present). Hold the read until the walk drains.
        // R3.2c: this one must hold for EVERY atomic (issue_amo_xlat), read or not.
        // While a younger load's walk owns the port, core_dmem_vaddr is pinned to the
        // WALK's VA — a class atomic acking then would latch the walk's address into
        // ac_pa_q and the queue would RMW the wrong line.
        || (issue_amo_xlat && mmu_walk_inflight)
        // Zacas amocas.q: its read returns TWO dwords (lo via i_load_data, hi via
        // i_load_data_next). The AMO read does not forward and the store-overlap
        // gate (sb_ld_ovl) only covers the primary (lo) dword, so a buffered older
        // store to the HIGH dword would be missed (stale hi read). Hold the read
        // until the store buffer is fully drained.
        || (issue_amo_read && iq_iss_is_cas_q && !sb_empty_eff)
        // Phase 12 V1: hold scalar load/AMO issue while the VU owns the dmem port
        // (vu_mem_port_req). Registered, so no combinational loop into issue.
        || ((issue_is_load || issue_amo_read) && vu_mem_port_req);
    // Phase 8 S10.5: !replay_q — no NEW dmem-MMU request while a queued-MSHR
    // replay drives the dcache port. Without this, a TLB-missing load selected
    // on slot-0 starts a PTW walk on a replay cycle (walk_v_q is not set yet,
    // so replay_drive does not defer): the walk's first PTE read goes out with
    // the dcache i_addr OVERRIDDEN to the replay's PA, and on a replay HIT
    // i_dcache_stall=0 lets the MMU consume the replay load's DATA as a PTE —
    // a corrupted translation (observed as a wild jump into the _etext/
    // .init.text padding hole, N=2 trap-loop timeout). An already-in-flight
    // walk (mmu_walk_inflight) still owns the port; replay defers to it.
    // S20R: the decoupled-walk arm BYPASSES load_blocks_on_store (the IQ may
    // have moved to a different op mid-walk, so sb_ld_ovl scans the wrong
    // address) — a store committed into the buffer DURING the walk made the
    // post-walk data read return the pre-store value (the N=2 ra=0 oops).
    // While a buffered store overlaps the walked VA's dwords, drop the
    // walk arm's i_ren: the PTE reads ride the MMU's own ptw_req term (not
    // i_ren), so the walk still completes and fills the TLB; busy then
    // drops, the walk owner clears, and the load re-issues through the
    // normal slot-0 path whose gates scan the RIGHT address. The compare
    // uses only registers (walk_vaddr_q, sb state) — no comb loop.
    var sb_walk_ovl: logic;
    let sb_wk_dw0  : logic<9> = walk_vaddr_q[11:3];
    let sb_wk_dw1  : logic<9> = walk_vaddr_q[11:3] + 9'd1;
    always_comb {
        sb_walk_ovl = 1'b0;
        for i in 0..SB_N {
            if (i as 4) <: sb_cnt {
                if sb_line[i][5:0] == sb_wk_dw0[8:3] && sb_lmap[i][sb_wk_dw0[2:0]] {
                    sb_walk_ovl = 1'b1;
                }
                if sb_line[i][5:0] == sb_wk_dw1[8:3] && sb_lmap[i][sb_wk_dw1[2:0]] {
                    sb_walk_ovl = 1'b1;
                }
            }
        }
    }
    // ACT4 ExceptionsSvZalrsc: a failing SC drives a load-style translation walk at
    // issue (own owner re-latch, like the AMO read) purely to fault-check. It does
    // NOT do dc_amo_read (no RFO) — the read data is discarded (the SC reads nothing),
    // only the walk fault matters, so a stale store-buffer read is harmless and no
    // store-overlap hold is needed. The SC is at the ROB head (amo_at_head), so it
    // is the oldest op: store_drive / mmu_walk_inflight / replay are naturally idle;
    // the gates below are defensive port arbitration only.
    let sc_walk_drive  : logic    = issue_sc_walk && !redirect_fire && !store_drive && !replay_q && !mmu_walk_inflight && !vu_mem_port_req;
    // Phase 1 LSU 2-stage: a plain load drives core_dmem_ren only at Stage A (to run
    // the MMU translate); while it is in Stage B (lsr_v_q) the issue-load term is
    // gated off so the next selected (but not-yet-issued, block-on-issue) load does
    // NOT start a fresh PTW walk that would steal the port from the LSR's Stage-B
    // read (mmu_walk_inflight would drop dmem_mmu_idle → lsr_drive). The actual
    // Stage-B dcache read is driven by lsr_drive at the dcache i_ren mux.
    // Block T: the new load must have its PA on the cycle it latches, so the
    // translate has to be open while the LSR is still occupied. It is opened with
    // lsr_b2b_ok — REGISTERS ONLY, deliberately NOT lsr_b2b_free/lsr_complete: this
    // signal reaches the dmem MMU, and the MMU's live outputs (dmu_dmem_wstrb via
    // acc_deny, dmu_dmem_addr) reach the dcache write path and so o_stall. Making it
    // depend on lsr_complete would close a REAL comb loop, not a foldable one.
    // lsr_b2b_ok is therefore a SUPERSET of the capture condition: the translate may
    // run on cycles the incumbent does not finish. That is side-effect-free for a TLB
    // hit; a TLB MISS starts its walk a little earlier than before (the walk then
    // holds the incumbent through dmem_mmu_idle — the hazard the old !lsr_v_q term
    // was written for, now traded for the turnaround). Faulting and UNCACHED
    // incumbents opt out: an MMIO read must not have its i_ren withdrawn mid-bus
    // transaction, and lsr_unc_q/lsr_fault are registers, so the opt-out is free.
    let core_dmem_ren  : logic    = if vu_mem_active ? vu_mem_is_load : ((issue_is_load && !redirect_fire && !store_drive && !load_blocks_on_store && !replay_q && (!lsr_v_q || lsr_b2b_spec)) || sc_walk_drive || (mmu_walk_inflight && !sb_walk_ovl));
    let core_dmem_wstrb: logic<8> = if vu_mem_active ? vu_mem_wstrb : if store_drive ? st_wstrb : 8'd0;

    // The retry takes the ADDRESS only, and only when no real requester wants it.
    // ⚠️ `!(cdb.valid && cdb.is_store)` is CORRECTNESS, not politeness: store_pretx_valid
    // above assumes the port is showing agu_addr_iss whenever no store-commit / walk / VU
    // overrides it. A retry is a NEW override it does not know about, so without this term
    // an executing store would latch the RETRY's PA as its own. Yielding also gets the
    // priority right — the fresh store is the one whose probe we most want to land.
    // Loop-free: core_dmem_ren / core_dmem_wen / core_dmem_is_amo are all computed from
    // issue + register state, never from the core_dmem_vaddr mux this arm feeds.
    // ⚠️ "no requester" is NOT the same as "nobody samples the MMU output". A request-free
    // cycle still feeds dmu_dmem_addr to consumers that latch it on their OWN enable —
    // above all the Stage-A dcache tag read (i_addr_r: dmu_dmem_addr, i_ren_r:
    // lsr_capture), whose predicate is NOT a subset of core_dmem_ren. Retrying on such a
    // cycle hands the dcache the RETRY's address. Hence the extra terms; dmem_mmu_idle
    // also covers a STORE walk, which mmu_walk_inflight (load walks only) does not.
    let sqrt_port_free: logic = !vu_mem_active && !store_drive && !mmu_walk_inflight
        && !core_dmem_ren && !core_dmem_wen && !core_dmem_is_amo
        && !(cdb.valid && cdb.is_store)
        && dmem_mmu_idle && !lsr_capture && !lsr_drive && !replay_q && !iq_issue_valid;
    always_comb {
        sqrt_drive = 1'b0;
        if SQ_RETRY {
            if sqrt_sel_v && sqrt_port_free {
                sqrt_drive = 1'b1;
            }
        }
    }
    // Capture on a clean probe hit, under the SAME translation-barrier rule the
    // execute-time probe obeys. Staleness is safe by ORDER, not by luck: an SFENCE/satp
    // write younger than this store commits AFTER it, so a PA captured early is still
    // this store's PA at its own commit.
    assign sqrt_cap = sqrt_drive && dmem_sprobe_ok && !rob_has_pending_xlate;
    // P9.3: mark the AMO/LR data read so the dcache serves it only from an
    // OWNED (E/M) line — an S hit or a miss raises an RFO fill first (the
    // in-cache RMW: the commit write then merges locally; a departure in
    // between poisons the AMO watch for a commit replay). Excludes the
    // PTE-walk read (mmu_walk_inflight drives core_dmem_ren for the walk,
    // not the AMO) and redirect/flush cycles. SC is not an issue_amo_read.
    // Phase 8 S6: also suppress while the AMO read is held behind a
    // committing fast store (load_blocks_on_store) so it does not read
    // stale data on a line the fast store is writing.
    let dc_amo_read    : logic    = issue_amo_read && !mmu_walk_inflight && !redirect_fire && !load_blocks_on_store;
    // CP M3b: hold the AMO/LR execute until its ACCESS cycle. The ACCESS cycle is
    // "the AMO drove its read last cycle (amo_fetched_q) AND still drives it now
    // (dc_amo_read) AND its translate is done (!dmem_mmu_busy)" — only then does the
    // dcache read the latched AMO PA and dcache_rdata carry the AMO value. Anything
    // else (the fetch cycle, a stolen port, an unfinished translate) is held.
    // R3.2c: the class atomic drives the dmem port for TRANSLATION ONLY — same port
    // arbitration as dc_amo_read, minus the data read. Its dcache access is suppressed
    // (m_ren_q), so the port carries only the MMU request.
    assign asq_nr_acc = asq_nr_iss && !mmu_walk_inflight && !redirect_fire && !load_blocks_on_store;
    // …and it keeps the SAME 2-cycle fetch/access handshake the read path has. Acking
    // on the first driving cycle is not safe just because !dmem_mmu_busy holds: the
    // whole MEM_PIPE M-stage (m_pa_q and friends) is latched from that cycle and the
    // rest of the machine is built around an atomic occupying the port for its fetch
    // AND access cycle. Dropping the handshake is what broke the N=1 VM boot (a
    // corrupted page->flags → init SIGSEGV → panic) while every bare-mode test passed.
    var asq_nr_fetched_q: logic;
    always_ff (clk, rst) {
        if_reset {
            asq_nr_fetched_q = 1'b0;
        } else if redirect_fire || (asq_nr_iss && iq_issue_ack) || !asq_nr_acc {
            asq_nr_fetched_q = 1'b0;
        } else {
            asq_nr_fetched_q = !dmem_mmu_busy;
        }
    }
    assign amo_fetch_hold = MEM_PIPE && ((issue_amo_read && !(amo_fetched_q && dc_amo_read && !dmem_mmu_busy))
        || (asq_nr_iss && !(asq_nr_fetched_q && asq_nr_acc && !dmem_mmu_busy)));

    // ============================================================
    // M9.A.294 (F2): load-fault attribution fix.
    //
    // Root cause: dmem_mmu drops o_busy the cycle ptw_fault asserts, so a
    // multi-cycle-walk LOAD that faults is de-selected and a younger op
    // issues on the o_fault cycle. alu_wrap tags o_cdb.is_lfault with the
    // CURRENT issue's rob_idx → the fault is mis-attributed to a
    // correct-path op that then commits (spurious load page fault).
    //
    // Fix: latch the walk owner {rob_idx, vaddr} when a LOAD's walk goes
    // busy, and on o_fault deliver the fault to the owner's ROB entry via
    // the rob inject port — independent of the current-issue CDB result.
    // Also suppress the (wrong) is_lfault the CDB would write to the
    // current issue when it is not the walk owner. All registered / ROB
    // writes — never feeds back into issue select, so no comb loop (issue
    // select must NOT depend on any MMU output).
    //
    // Latch: a LOAD read driving a busy walk. Bare mode keeps busy=0 so
    // this never engages.
    //
    // M9.A.296: bind the owner to each ACTUAL PTW start (dmem_walk_start =
    // mmu tlb_miss_start, pulses at every IDLE→walk). The old !walk_v_q-gated
    // latch went STALE across back-to-back walks (busy stays continuous, so
    // walk_v_q never cleared): a wrong-path wild load starting a 2nd walk that
    // faulted got mis-attributed to the 1st walk's correct-path owner. Re-
    // latching on dmem_walk_start captures the requesting load (iq_iss_rob_idx
    // / core_dmem_vaddr) for EACH walk, so the faulting walk's fault is
    // attributed to ITS load (and squashed if wrong-path).
    always_ff (clk, rst) {
        if_reset {
            walk_v_q        = 1'b0;
            walk_rob_q      = 5'd0;
            walk_vaddr_q    = 64'd0;
            walk_is_store_q = 1'b0;
            walk_is_amo_q   = 1'b0;
            walk_is_misalign_q = 1'b0;
            walk_pc_q       = 64'd0;
            walk_hlv_q      = 1'b0;
            walk_hlvx_q     = 1'b0;
        } else if early_redir_fire_q {
            // Phase 8 S8.E: an early redirect's PARTIAL squash rewinds tail to
            // branch_idx+1, so the squashed wrong-path rob_idx is REUSED by the
            // correct-path op on the very next allocation. Unlike the commit full-
            // flush (M9.A.312, where the latched squashed owner is harmless because
            // the empty ROB refills from idx 0), here we must take PRIORITY over
            // dmem_walk_start and clear the owner — even for a walk starting THIS
            // cycle (the wrong-path load that mispredicted-down the fall-through).
            // Otherwise its later PTW fault is injected (lfault_inj_v) into the reused
            // idx = a valid correct-path load → spurious page fault (the BUG5 boot
            // livelock: a fall-through wrong-path load @0x8001b288 walked a garbage VA
            // 0xfffffffffffc.. whose fault landed on the jump-target load @0x8001b8da).
            // The walk becomes an orphan (walk_phys_q=1, walk_v_q=0); its fault drops.
            walk_v_q = 1'b0;
        } else if dmem_walk_start {
            // M9.A.312: dmem_walk_start MUST take priority over redirect_fire_q.
            // When both coincide, a NEW PTW walk is starting THIS cycle (the MMU
            // already latched its VA), so its owner must be captured — even if a
            // redirect fires the same cycle (the starting load is then a
            // wrong-path op being squashed; latching it as the owner sends the
            // walk's eventual fault to the SQUASHED op, where it is harmless,
            // instead of leaking via the !walk_v_q path to a younger VALID load).
            // Bug: a wrong-path NULL load (VA=0) started a walk on a redirect
            // cycle; the old redirect-first order left walk_v_q=0, so the VA=0
            // walk's leaf fault was mis-attributed to a valid kernel load
            // (spurious page fault at VA 0x80616198, ~34663-cy Oops loop).
            walk_v_q     = 1'b1;
            // Phase 12 V1: a VU-driven walk belongs to the vector mem op at the
            // ROB head (the VU does not issue through the IQ). Inert at V=0.
            walk_rob_q   = if vu_mem_active ? rob_head_idx : iq_iss_rob_idx;
            walk_vaddr_q = core_dmem_vaddr;
            // M9.3 inject-linkage probe: PC of the load that starts this walk.
            walk_pc_q    = iq_issue_op.base.pc;
            // Phase 11-H: latch the walk's HLV/HLVX flags so the two-stage walk
            // keeps i_virt/i_priv/i_hlvx stable after the issuing IQ slot is gated
            // off. A store walk (commit_store_fire) takes its flag from the ROB
            // head (c_is_mem_virt); a load walk from the issuing op. HLVX is
            // load-only, so a store walk latches 0.
            walk_hlv_q   = if commit_store_fire ? c_is_mem_virt : iq_issue_op.base.hlv;
            walk_hlvx_q  = if commit_store_fire ? 1'b0 : iq_issue_op.base.hlvx;
            // M9.A.299: a walk driven by a commit-store is a STORE walk. Its
            // fault is delivered via commit_store_sfault (commit-time), NOT the
            // load inject port — and walk_rob_q (= issue idx) is meaningless for
            // it (the IQ is gated off during dmem_mmu_busy). Record store-ness so
            // lfault_inj_v below does not inject a SPURIOUS load fault into that
            // stale rob_idx when the store walk faults.
            walk_is_store_q = commit_store_fire;
            // A real AMO (non-LR/SC) read drives a LOAD walk (walk_is_store_q=0),
            // but its eventual walk fault is a STORE/AMO fault (cause 7/15). Latch
            // AMO-ness so the lfault inject routes it to is_sfault, not is_lfault.
            // A failing SC's translation walk (issue_sc_walk) is store-semantics too:
            // route its fault to is_sfault (cause 7 access / 15 page), matching Sail's
            // store/amo-access-fault on the reservation-independent translate-for-write.
            walk_is_amo_q   = (issue_is_realamo || issue_sc_walk) && !commit_store_fire;
            // A misaligned atomic's walk fault must be reported as an ACCESS fault.
            walk_is_misalign_q = iss_amo_misalign && !commit_store_fire;
        } else if redirect_fire_q {
            walk_v_q = 1'b0;
        } else if walk_v_q && !dmem_mmu_busy {
            // Walk resolved (success or fault). Owner cleared; if it was a
            // fault, lfault_inj_v delivered it this same cycle.
            walk_v_q = 1'b0;
        }
    }
    // M9.3 SMP: track the PHYSICAL walk in the dmem_mmu independently of the
    // owner. Unlike walk_v_q this does NOT clear on a redirect, only when the
    // walk actually finishes (busy drops / faults). So walk_phys_q && !walk_v_q
    // marks a walk whose owner was squashed mid-flight = an ORPHAN walk.
    always_ff (clk, rst) {
        if_reset {
            walk_phys_q = 1'b0;
        } else if dmem_walk_start {
            walk_phys_q = 1'b1;
        } else if walk_phys_q && !dmem_mmu_busy {
            walk_phys_q = 1'b0;
        }
    }
    // An orphan-walk fault: a physical walk is faulting but its owner is gone
    // (walk_v_q cleared by an intervening redirect). Its VA belongs to a
    // squashed wrong-path load, so the fault is spurious and must be dropped.
    let orphan_walk_fault: logic = dmem_mmu_fault && walk_phys_q && !walk_v_q;

    // Phase 11-H HLV/HLVX/HSV: the per-op two-stage flag of the op currently
    // driving the dmem port, mirroring the core_dmem_vaddr priority (store_drive >
    // mmu_walk_inflight > issuing load). A committing HSV store reads c_is_mem_virt
    // (held by store_drive); a walk reads the latched walk_hlv_q (covers load AND
    // store walks); the issuing-load cycle reads iq_issue_op.base.hlv. Loop-free
    // because dmem_vm_on no longer includes dmem_op_hlv, so store_drive (→
    // fast_store → dmem_vm_on) does not feed back here. 0 unless an HLV/HSV drives
    // the port, so every ordinary V=0 access is byte-identical.
    assign dmem_op_hlv = if store_drive ?
        c_is_mem_virt
    : if mmu_walk_inflight ?
        walk_hlv_q
    :
        iq_issue_op.base.hlv
    ;
    // HLVX is load-only (stores never check X). Latched walk_hlvx_q across a load
    // walk; iq_issue_op.base.hlvx on the issuing cycle; a store is never HLVX.
    assign dmem_op_hlvx = if store_drive ?
        1'b0
    : if mmu_walk_inflight ?
        walk_hlvx_q
    :
        iq_issue_op.base.hlvx
    ;
    // Deliver the load fault to the walk owner when a LOAD walk faults. Store
    // walk faults (walk_is_store_q) are handled at commit (commit_store_sfault).
    // Phase 12 V1: a VU-driven access's fault is delivered by the VU on its own
    // vu_cdb (is_lfault/is_sfault → the vector op's ROB entry); suppress the
    // walk-owner inject path for it to avoid a double delivery. Inert at V=0.
    assign lfault_inj_v = (dmem_mmu_fault || dmem_mmu_acc_fault) && walk_v_q && !walk_is_store_q && !vu_mem_active;
    // PMP: when the walk-owner fault is a PMP access fault (and not a page fault),
    // tag the injected fault so commit raises a load access fault (cause 5).
    // A misaligned atomic forces an ACCESS fault even when the walk page-faults
    // (Sail checks alignment pre-translation, so an unmapped misaligned atomic
    // takes cause 5/7, not 13/15).
    assign lfault_inj_acc = (dmem_mmu_acc_fault && !dmem_mmu_fault) || walk_is_misalign_q;
    // Suppress the CDB's is_lfault when it would mis-attribute the owner's
    // fault to a different (current-issue) rob_idx. If the current issue IS
    // the owner, or there is no tracked walk (e.g. a direct TLB-permission
    // fault on the current issue), the CDB tag stands.
    // NOTE (M9.3): orphan_walk_fault is kept as a DEBUG-ONLY observable. The
    // N=2 storm does NOT leak via this CDB path (orphan suppression had no
    // effect); it leaks via the lfault_inj ROB-inject port with walk_v_q=1 and
    // a STALE walk_vaddr_q (back-to-back-walk VA inheritance). So we leave the
    // committed behaviour at baseline here.
    assign rob_cdb_is_lfault = cdb.is_lfault && (!walk_v_q || cdb.rob_idx == walk_rob_q);

    // ============================================================
    // M9.3 inject→commit linkage probe (debug-only). Captures the FIRST
    // committed load page-fault whose stval (fault_vaddr) is a GARBAGE VA
    // (< 0x1000 — no real kernel/user VA is that low during secondary
    // bringup). This is the trap that deadlocks hart1's secondary. We record:
    //   dlk_inj     — was the committed fault delivered via the lfault inject
    //                 port (vs a direct CDB permission fault on the op itself)?
    //   dlk_genuine — does the committing op's PC equal the walk-start PC that
    //                 the inject recorded? equal ⇒ the op that STARTED the
    //                 garbage-VA walk is itself the trapping op (a genuine load
    //                 with a garbage base register → value/control bug);
    //                 different ⇒ the fault was injected into a reused/innocent
    //                 entry (mis-attribution → a fault-inject GATE is the fix).
    // All reads are commit-stage signals; the writes touch only debug regs, so
    // no path feeds back into issue/select (comb-loop-free).
    var dlk_seen_q   : logic    ;
    var dlk_genuine_q: logic    ;
    var dlk_inj_q    : logic    ;
    var dlk_stval_q  : logic<64>;
    var dlk_pc_q     : logic<64>;
    var dlk_walkpc_q : logic<64>;
    let commit_lfault_garbage: logic = rob_commit_valid && c_is_lfault && c_fault_vaddr <: 64'h1000;
    always_ff (clk, rst) {
        if_reset {
            dlk_seen_q    = 1'b0;
            dlk_genuine_q = 1'b0;
            dlk_inj_q     = 1'b0;
            dlk_stval_q   = 64'd0;
            dlk_pc_q      = 64'd0;
            dlk_walkpc_q  = 64'd0;
        } else if commit_lfault_garbage && !dlk_seen_q {
            dlk_seen_q    = 1'b1;
            dlk_inj_q     = commit_dbg_inj;
            dlk_genuine_q = commit_dbg_inj && (commit_dbg_walk_pc == c_pc);
            dlk_stval_q   = c_fault_vaddr;
            dlk_pc_q      = c_pc;
            dlk_walkpc_q  = commit_dbg_walk_pc;
        }
    }

    // ============================================================
    // M5.C: dmem_mmu wrapper. Bare mode (M-mode or satp.MODE=0) is
    // pure passthrough; o_busy stays 0 and o_dmem_addr == i_vaddr.
    // PTW shared with imem in M5.D.
    // ============================================================
    var dmem_mmu_rdata: logic<64>;
    // dmem_mmu_busy / dmem_mmu_fault / dmem_mmu_fault_s declared up front
    // for forward use by iq_int gate and alu_wrap fault inputs.
    var dmem_mmu_rdv: logic;
    // Internal dmem signals from dmem_mmu, muxed below with imem PTW.
    // (dmu_dmem_addr is declared up near the presence-check vars — the
    // P9.3 rsv/AMO-watch PA latches read it from earlier always_ff blocks.)
    var dmu_dmem_wdata: logic<64>;
    var dmu_dmem_wen  : logic    ;
    var dmu_dmem_ren  : logic    ;
    var dmu_dmem_wstrb: logic<8> ;

    // ============================================================
    // Phase 8 S20: committed-store buffer (declarations up front near
    // fast_store; design note at rob_commit_ack).
    // ============================================================
    // VM arm of the classifier: a committing aligned plain store whose
    // translation is ready THIS cycle (TLB hit: store_drive presents the VA
    // to dmem_mmu and o_busy is low) and whose PA is in DRAM. A TLB-missing
    // store stays a slow store — its walk runs via the normal commit path,
    // the PTE gets cached, and the retry cycle lands here.
    // Phase 11-H: dmem_vm_on_op folds an HSV store into the VM store-buffer path
    // (translated PA = dmu_dmem_addr).
    // CP commit-store pre-translate (P5a change A+B): the LIVE cacheable-VM TLB-hit
    // condition. It still gates dc_i_wen below (so a cacheable store is never routed to
    // the M-stage dcache write path), but the SB-push ELIGIBILITY (sb_vm_ok) is now a
    // REGISTERED-PA classifier: a pre-translated store (c_pretx_fast, 1-cycle) or a held
    // store's retire cycle (sb_2cyc_ok, the registered m_pa_q). At STORE_PRETRANSLATE=0
    // sb_vm_ok ≡ sb_vm_live_ok (the original expression) = byte-identical.
    let sb_vm_live_ok: logic = commit_store_fire && !c_is_amo && dmem_vm_on_op && st_wstrb_hi == 8'd0
        && !load_walk_busy && !dmem_mmu_busy && !dmem_mmu_fault && !dmem_mmu_acc_fault_s && dmu_dmem_addr[63:25] == 39'h40
        && !((dmu_dmem_addr[31:14] == 18'h20000) || (dmu_dmem_addr[31:12] == 20'h80008)); // P9.2: tohost pages stay write-through
    assign sb_vm_ok = if STORE_PRETRANSLATE ? (c_pretx_fast || sb_2cyc_ok) : sb_vm_live_ok;
    // PMP (Smpmp): a fast store that fails its PA check must NOT be absorbed by
    // the store buffer (its write is suppressed; it traps instead, like a page-
    // faulting store whose sb_vm_ok is 0).
    assign sb_elig = (fast_store || sb_vm_ok) && !fast_store_acc_fault;
    // CP commit-store pre-translate (P5a): classify from the EFFECTIVE PA (registered
    // probe PA for a pre-translated store, else the live mux). A c_pretx_fast store is
    // cacheable DRAM by probe construction, so its Svpbmt-NC arm is masked. At
    // STORE_PRETRANSLATE=0 (c_pretx_fast≡0, c_store_eff_pa≡the live mux) this is the
    // original expression byte-for-byte.
    assign c_store_mmio = (c_store_eff_pa[63:25] != 39'h40)
        || (dmem_vm_on_op && !c_pretx_fast && dmu_pbmt_unc); // P10 Svpbmt: NC/IO store is uncached
    // R1 (SB_PA_REG) FIX: c_store_mmio above is computed from the REGISTERED c_store_eff_pa at
    // =1 — correct AT THE RETIRE cycle (m_pa_q valid) and off the live TLB, which is what the
    // term-3890 retire gate wants (CP). But the DCACHE WRITE ENABLES dc_i_wen/dc_wen_excl are
    // sampled at the store's TRANSLATE cycle N (registered into m_wen_q for the N+1 write), when
    // the registered c_store_eff_pa (= m_pa_q from N-1) is STALE. A stale MMIO classification
    // there lets a VM MMIO store take the wrong drain-order path → the store leaks past older
    // buffered stores → the SMP-boot CLINT doorbell passes its mailbox → the woken hart parks
    // (the S20R wedge, :3872). c_store_mmio_x classifies from the LIVE translate-cycle PA (as the
    // =0 build's live c_store_mmio did); it reaches rob_commit_ack only through the multi-cycle
    // dcache state/stall (not combinationally this cycle). At =0 identical to c_store_mmio →
    // byte-identical. See doc/cp_store_queue_plan.md §5.
    let c_store_pa_x  : logic<64> = if dmem_vm_on_op ? dmu_dmem_addr : c_store_addr; // LIVE translate-cycle PA
    let c_store_mmio_x: logic     = if SB_PA_REG
        ? (c_store_pa_x[63:25] != 39'h40) || (dmem_vm_on_op && !c_pretx_fast && dmu_pbmt_unc)
        : c_store_mmio;
    assign sb_pa   = c_store_eff_pa;
    // P10 Svadu: the instruction-side A-bit write-back borrows the store-drain
    // port, but ONLY while the store buffer is empty (SB drain has priority). The
    // PTE dword sits at lane imem_ptw_addr_w[5:3] of its 64B line.
    let imem_aw_grant: logic    = imem_ptw_wen_w && sb_empty;
    let imem_aw_lane : logic<3> = imem_ptw_addr_w[5:3];
    // S25 drain: the HEAD entry leaves as ONE line-wide transaction through
    // the dcache drain port (all 8 lanes + strobes); the ack pops the entry.
    // Gate the pop with !imem_aw_grant so an A-bit-write ack (which fires while
    // sb_empty) never underflows sb_cnt.
    let sb_pop: logic = dc_sdrain_ack && !imem_aw_grant;
    // S25: line-match the pushing store against live entries. The head entry
    // is not a merge target on its pop cycle (its lanes are leaving the
    // buffer this edge); the store allocates a fresh entry instead. A merging
    // store is accepted even when the buffer is FULL — no new entry needed.
    var sb_match_v  : logic   ;
    var sb_match_idx: logic<2>;
    always_comb {
        sb_match_v   = 1'b0;
        sb_match_idx = 2'd0;
        for i in 0..SB_N {
            if (i as 4) <: sb_cnt && sb_line[i] == sb_pa[63:6] {
                sb_match_v   = 1'b1;
                sb_match_idx = i as 2;
            }
        }
    }
    // P10 cbo.zero always allocates a fresh full-line entry (never merges into a
    // partial entry); in-order drain makes the younger zero entry win.
    assign sb_merge_ok = sb_match_v && !(sb_match_idx == 2'd0 && sb_pop) && !c_is_cbo_zero;
    assign sb_push     = sb_elig && (sb_merge_ok || !sb_full);
    let sb_alloc: logic = sb_push && !sb_merge_ok;
    // The issuing AMO/LR read's dword span vs the buffered entries (S27:
    // plain loads now FORWARD from the buffer instead — this scan only gates
    // AMO reads, whose RMW value must come from memory after the drain).
    // Compared by 4KB page offset ([11:3], translation-invariant — the S15
    // trick) on the AGU VA, NOT the translated PA: dmu_dmem_addr is
    // combinationally entangled with i_ren and this term feeds
    // core_dmem_ren (a PA compare closes a comb loop through the MMU). A
    // page-offset match is a superset of a true PA overlap, so a false
    // match only HOLDS the AMO a few cycles (the entry drains and it
    // re-issues).
    // dword+1 is checked only when the load actually spans into it
    // (byte offset + size > 8) — an unconditional +1 check doubled the
    // false-hold rate on adjacent-dword store/load pairs.
    let sb_ld_sz   : logic<4> = 4'd1 << iq_issue_op.base.mem_funct3[1:0];
    let sb_ld_spans: logic    = ({1'b0, agu_addr_iss[2:0]} + sb_ld_sz) >: 4'd8;
    let sb_ld_dw0  : logic<9> = agu_addr_iss[11:3];
    let sb_ld_dw1  : logic<9> = agu_addr_iss[11:3] + 9'd1;
    // R3.1 §6.4: the atomic-SQ entry CANNOT forward — its value does not exist until
    // the drain computes it — so an overlapping younger access must WAIT instead
    // (the opposite of S27's plain-load forward from the store buffer). Same
    // page-offset compare as sb_ld_ovl above (VA[11:3] == PA[11:3], loop-free), and
    // the same conservative dword+1 span rule. This also covers the `.aq` ordering
    // requirement: a class atomic's read happens at drain, so younger loads must not
    // pass it. Constant 0 at ATOMIC_SQ=0 (asq_valid_q never sets).
    assign asq_ld_ovl = ATOMIC_SQ && asq_valid_q[0]
        && ((asq_pa_q[0][11:3] == sb_ld_dw0) || (sb_ld_spans && asq_pa_q[0][11:3] == sb_ld_dw1));
    always_comb {
        sb_ld_ovl = 1'b0;
        for i in 0..SB_N {
            if (i as 4) <: sb_cnt {
                if sb_line[i][5:0] == sb_ld_dw0[8:3] && sb_lmap[i][sb_ld_dw0[2:0]] {
                    sb_ld_ovl = 1'b1;
                }
                if sb_ld_spans && sb_line[i][5:0] == sb_ld_dw1[8:3] && sb_lmap[i][sb_ld_dw1[2:0]] {
                    sb_ld_ovl = 1'b1;
                }
            }
        }
    }
    // The committing SLOW store's dword span vs the buffered entries (same
    // page-offset trick, on the pre-translation c_store_addr — loop-free).
    // dword+1 always checked (covers the misaligned hi-dword bypass).
    let sb_st_dw0: logic<9> = c_store_addr[11:3];
    let sb_st_dw1: logic<9> = c_store_addr[11:3] + 9'd1;
    always_comb {
        sb_st_ovl = 1'b0;
        for i in 0..SB_N {
            if (i as 4) <: sb_cnt {
                if sb_line[i][5:0] == sb_st_dw0[8:3] && sb_lmap[i][sb_st_dw0[2:0]] {
                    sb_st_ovl = 1'b1;
                }
                if sb_line[i][5:0] == sb_st_dw1[8:3] && sb_lmap[i][sb_st_dw1[2:0]] {
                    sb_st_ovl = 1'b1;
                }
            }
        }
    }
    // 4-line shift FIFO of committed stores (S25 write-combining), drained
    // oldest-first through the dcache store-drain port (i_saddr) whenever the
    // fill engine is idle and the bus grants. Entries are COMMITTED state —
    // never flushed by a redirect/trap.
    //
    // Merge helpers — all read PRE-EDGE register state; the FF block applies
    // them at the post-shift slot. sb_merge_ok excludes the head's POP cycle,
    // so a merge never targets an entry whose lanes are leaving this edge.
    let sb_mlane   : logic<3>  = sb_pa[5:3];
    let sb_midx_pre: logic<5>  = {sb_match_idx, sb_mlane};
    let sb_mold    : logic<64> = sb_data[sb_midx_pre];
    let sb_mnew    : logic<64> = {
        if st_wstrb[7] ? st_wdata[63:56] : sb_mold[63:56], if st_wstrb[6] ? st_wdata[55:48] : sb_mold[55:48],
        if st_wstrb[5] ? st_wdata[47:40] : sb_mold[47:40], if st_wstrb[4] ? st_wdata[39:32] : sb_mold[39:32],
        if st_wstrb[3] ? st_wdata[31:24] : sb_mold[31:24], if st_wstrb[2] ? st_wdata[23:16] : sb_mold[23:16],
        if st_wstrb[1] ? st_wdata[15:8] : sb_mold[15:8], if st_wstrb[0] ? st_wdata[7:0] : sb_mold[7:0]
    };
    let sb_mstrb: logic<8> = sb_strb[sb_midx_pre] | st_wstrb;
    let sb_mlmap: logic<8> = sb_lmap[sb_match_idx] | (8'd1 << sb_mlane);
    always_ff (clk, rst) {
        if_reset {
            sb_cnt = 4'd0;
            for i in 0..SB_N {
                sb_line[i] = 58'd0;
                sb_lmap[i] = 8'd0;
                for l in 0..8 {
                    sb_data[i * 8 + l] = 64'd0;
                    sb_strb[i * 8 + l] = 8'd0;
                }
            }
        } else {
            if sb_pop {
                for i in 0..3 {
                    sb_line[i] = sb_line[i + 1];
                    sb_lmap[i] = sb_lmap[i + 1];
                    for l in 0..8 {
                        sb_data[i * 8 + l] = sb_data[(i + 1) * 8 + l];
                        sb_strb[i * 8 + l] = sb_strb[(i + 1) * 8 + l];
                    }
                }
            }
            if sb_push {
                if sb_merge_ok {
                    let midx: logic<2> = sb_match_idx - (if sb_pop ? 2'd1 : 2'd0);
                    sb_data[{midx, sb_mlane}] = sb_mnew;
                    sb_strb[{midx, sb_mlane}] = sb_mstrb;
                    sb_lmap[midx]             = sb_mlmap;
                } else {
                    let widx: logic<4> = sb_cnt - (if sb_pop ? 4'd1 : 4'd0);
                    for i in 0..SB_N {
                        if widx == (i as 4) {
                            sb_line[i] = sb_pa[63:6];
                            if c_is_cbo_zero {
                                // P10 Zicboz: fill the whole 64B line with zero.
                                sb_lmap[i] = 8'hFF;
                                for l in 0..8 {
                                    sb_data[i * 8 + l] = 64'd0;
                                    sb_strb[i * 8 + l] = 8'hFF;
                                }
                            } else {
                                sb_lmap[i] = 8'd1 << sb_mlane;
                                for l in 0..8 {
                                    sb_strb[i * 8 + l] = 8'd0;
                                }
                                sb_data[{(i as 2), sb_mlane}] = st_wdata;
                                sb_strb[{(i as 2), sb_mlane}] = st_wstrb;
                            }
                        }
                    }
                }
            }
            sb_cnt = sb_cnt + (if sb_alloc ? 4'd1 : 4'd0) - (if sb_pop ? 4'd1 : 4'd0);
        }
    }
    // S25: head-entry lanes, wired to the dcache line-drain port.
    var sb_head_data: logic<64> [8];
    var sb_head_strb: logic<8>  [8];
    always_comb {
        for l in 0..8 {
            sb_head_data[l] = sb_data[l];
            sb_head_strb[l] = sb_strb[l];
        }
    }

    // ============================================================
    // Block L1.c — THE DRAIN SHADOW (the visibility contract, plan Part II §9).
    // ============================================================
    // The hole Block T papered over with LSR_B2B_SBQ is a SNAPSHOT SKEW, not an early
    // pop. A 2-stage load samples the two halves of its result on DIFFERENT cycles:
    //
    //   cycle N                                  cycle N+1
    //   Stage A: i_ren_r/i_addr_r presented;     Stage B: the sbf* forward net is
    //            DCACHE_SYNC_READ reads the               evaluated (stld_fwd_en =
    //            array COMBINATIONALLY and                lsr_v_q) — against a buffer
    //            REGISTERS the result                     that no longer holds the entry
    //   drain:   store_can_drain → o_sdrain_ack
    //            ...the merge is applied AT THE N→N+1 EDGE, and sb_pop drops sb_cnt
    //            on that SAME edge.
    //
    // So the DATA READ snapshots the array pre-merge and the FORWARD NET snapshots the
    // buffer post-pop: a store drained on that edge is in NEITHER. The entry's lifetime
    // does not cover both halves of any load that straddles the edge.
    //
    // The contract (Part II §10 Q2): an entry stays in the forward net until every read
    // that could have snapshotted the array BEFORE its write has completed. For a
    // 2-stage load that is exactly ONE cycle past the drain ack. This register is that
    // cycle — the departing head entry's {line PA, 8 lanes, strobes}, held for one
    // cycle and ORed into sbf* as the OLDEST writer (checked BEFORE the sb_cnt loop, so
    // any live SB entry and the same-cycle sb_push both override it per byte).
    //
    // Address-exact by construction, which is why it is preferred over sharpening
    // LSR_B2B_SBQ: Block T measured a same-LINE restriction INSUFFICIENT and concluded
    // the window is wider than the head line — a conclusion Part II §9 flags for
    // re-checking, since a correct compare should have sufficed. The shadow sidesteps
    // the question entirely.
    // Registers only → no comb loop into the sbf nets. Const-guarded STATEMENT form at
    // the read sites so DEAD really const-folds.
    // ✅ MEASURED (2026-08-19): with STORE_NOPORT=1 this is what carries the N=2 SMP boot
    // at FULL width. The bisection arm (STORE_NOPORT_SBE, restrict the flip to sb_empty)
    // also passes but leaves 3/4 of the win on the table (N=1 -1.52 % vs -5.99 %), and it
    // REFUTED the competing hypothesis — drain starvation, i.e. store_drive acting as an
    // implicit drain priority (S20.2's coupling, of which only the sb_cnt>=3 watermark
    // survived). It is the WINDOW, not the door. Full Veryl ladder + Verilator NBA 4/4
    // green; see cp_store_queue_plan.md §13.
    const SB_DRAIN_SHADOW: bit = 1;
    var sbs_v_q   : logic         ;
    var sbs_line_q: logic<58>     ;
    var sbs_data_q: logic<64> [8] ;
    var sbs_strb_q: logic<8>  [8] ;
    always_ff {
        if_reset {
            sbs_v_q    = 1'b0;
            sbs_line_q = 58'd0;
            for l in 0..8 {
                sbs_data_q[l] = 64'd0;
                sbs_strb_q[l] = 8'd0;
            }
        } else if SB_DRAIN_SHADOW {
            sbs_v_q = sb_pop;
            if sb_pop {
                sbs_line_q = sb_line[0];
                for l in 0..8 {
                    sbs_data_q[l] = sb_head_data[l];
                    sbs_strb_q[l] = sb_head_strb[l];
                }
            }
        }
    }
    // Const-guarded STATEMENT form so DEAD const-folds to plain sb_empty (byte-identical).
    const SB_EMPTY_EFF: bit = 1;
    always_comb {
        sb_empty_eff = sb_empty;
        if SB_EMPTY_EFF {
            if sbs_v_q {
                sb_empty_eff = 1'b0;
            }
        }
    }

    // ============================================================
    // S27: committed-store-buffer FORWARD layer. sb bytes are committed —
    // older than every ROB-resident store — so a ROB-forward byte (sf*/sg*)
    // wins per byte, an sb byte fills the rest, and the dcache supplies the
    // remainder (merged in alu_wrap). The compare uses the load's PHYSICAL
    // address (sb entries hold PAs): bare PA==VA; under VM the slot-0 load's
    // TLB-hit translation (dmu_dmem_addr) is combinational on the issue
    // cycle and feeds ONLY this data path (alu i_fwd), never the issue/ren
    // gates — no comb loop. On a TLB-miss cycle dmu_dmem_addr is
    // meaningless, but the load is not acked then (dmem_mmu_busy) and a
    // polluted mask only suppresses an MSHR capture (conservative). A store
    // committing THIS cycle (sb_push) is folded in LAST: it is the newest
    // committed writer of its bytes and may not be in the registered arrays
    // yet (the ROB net usually still covers it that cycle, but not a VM
    // alias — the ROB compares VAs, this layer compares PAs).
    // One always_comb per byte, mirroring the S5.1 ROB nets (fused
    // accumulators falsely trip the combinational_loop diagnostic).
    // ============================================================
    // Phase 1 LSU 2-stage: the SB forward layer compares PHYSICAL addresses, so it
    // uses the LSR's registered PA (lsr_paddr_q = the Stage-A translated PA in both
    // bare and VM modes), keyed by lsr_v_q (stld_fwd_en) at Stage B.
    let sbf_pa: logic<64> = lsr_paddr_q;
    var sbf0_v: logic; var sbf0_b: logic<8>;
    var sbf1_v: logic; var sbf1_b: logic<8>;
    var sbf2_v: logic; var sbf2_b: logic<8>;
    var sbf3_v: logic; var sbf3_b: logic<8>;
    var sbf4_v: logic; var sbf4_b: logic<8>;
    var sbf5_v: logic; var sbf5_b: logic<8>;
    var sbf6_v: logic; var sbf6_b: logic<8>;
    var sbf7_v: logic; var sbf7_b: logic<8>;
    always_comb {
        sbf0_v = 1'b0; sbf0_b = 8'd0;
        if stld_fwd_en {
            let ba: logic<64> = sbf_pa + 64'd0;
            if SB_DRAIN_SHADOW {
                if sbs_v_q && sbs_line_q == ba[63:6] && sbs_strb_q[ba[5:3]][ba[2:0]] {
                    let d: logic<64> = sbs_data_q[ba[5:3]] >> {ba[2:0], 3'b000};
                    sbf0_v = 1'b1; sbf0_b = d[7:0];
                }
            }
            for i in 0..SB_N {
                if (i as 4) <: sb_cnt && sb_line[i] == ba[63:6] && sb_strb[{(i as 2), ba[5:3]}][ba[2:0]] {
                    let d: logic<64> = sb_data[{(i as 2), ba[5:3]}] >> {ba[2:0], 3'b000};
                    sbf0_v = 1'b1; sbf0_b = d[7:0];
                }
            }
            if sb_push && sb_pa[63:3] == ba[63:3] && st_wstrb[ba[2:0]] {
                let d: logic<64> = st_wdata >> {ba[2:0], 3'b000};
                sbf0_v = 1'b1; sbf0_b = d[7:0];
            }
        }
    }
    always_comb {
        sbf1_v = 1'b0; sbf1_b = 8'd0;
        if stld_fwd_en {
            let ba: logic<64> = sbf_pa + 64'd1;
            if SB_DRAIN_SHADOW {
                if sbs_v_q && sbs_line_q == ba[63:6] && sbs_strb_q[ba[5:3]][ba[2:0]] {
                    let d: logic<64> = sbs_data_q[ba[5:3]] >> {ba[2:0], 3'b000};
                    sbf1_v = 1'b1; sbf1_b = d[7:0];
                }
            }
            for i in 0..SB_N {
                if (i as 4) <: sb_cnt && sb_line[i] == ba[63:6] && sb_strb[{(i as 2), ba[5:3]}][ba[2:0]] {
                    let d: logic<64> = sb_data[{(i as 2), ba[5:3]}] >> {ba[2:0], 3'b000};
                    sbf1_v = 1'b1; sbf1_b = d[7:0];
                }
            }
            if sb_push && sb_pa[63:3] == ba[63:3] && st_wstrb[ba[2:0]] {
                let d: logic<64> = st_wdata >> {ba[2:0], 3'b000};
                sbf1_v = 1'b1; sbf1_b = d[7:0];
            }
        }
    }
    always_comb {
        sbf2_v = 1'b0; sbf2_b = 8'd0;
        if stld_fwd_en {
            let ba: logic<64> = sbf_pa + 64'd2;
            if SB_DRAIN_SHADOW {
                if sbs_v_q && sbs_line_q == ba[63:6] && sbs_strb_q[ba[5:3]][ba[2:0]] {
                    let d: logic<64> = sbs_data_q[ba[5:3]] >> {ba[2:0], 3'b000};
                    sbf2_v = 1'b1; sbf2_b = d[7:0];
                }
            }
            for i in 0..SB_N {
                if (i as 4) <: sb_cnt && sb_line[i] == ba[63:6] && sb_strb[{(i as 2), ba[5:3]}][ba[2:0]] {
                    let d: logic<64> = sb_data[{(i as 2), ba[5:3]}] >> {ba[2:0], 3'b000};
                    sbf2_v = 1'b1; sbf2_b = d[7:0];
                }
            }
            if sb_push && sb_pa[63:3] == ba[63:3] && st_wstrb[ba[2:0]] {
                let d: logic<64> = st_wdata >> {ba[2:0], 3'b000};
                sbf2_v = 1'b1; sbf2_b = d[7:0];
            }
        }
    }
    always_comb {
        sbf3_v = 1'b0; sbf3_b = 8'd0;
        if stld_fwd_en {
            let ba: logic<64> = sbf_pa + 64'd3;
            if SB_DRAIN_SHADOW {
                if sbs_v_q && sbs_line_q == ba[63:6] && sbs_strb_q[ba[5:3]][ba[2:0]] {
                    let d: logic<64> = sbs_data_q[ba[5:3]] >> {ba[2:0], 3'b000};
                    sbf3_v = 1'b1; sbf3_b = d[7:0];
                }
            }
            for i in 0..SB_N {
                if (i as 4) <: sb_cnt && sb_line[i] == ba[63:6] && sb_strb[{(i as 2), ba[5:3]}][ba[2:0]] {
                    let d: logic<64> = sb_data[{(i as 2), ba[5:3]}] >> {ba[2:0], 3'b000};
                    sbf3_v = 1'b1; sbf3_b = d[7:0];
                }
            }
            if sb_push && sb_pa[63:3] == ba[63:3] && st_wstrb[ba[2:0]] {
                let d: logic<64> = st_wdata >> {ba[2:0], 3'b000};
                sbf3_v = 1'b1; sbf3_b = d[7:0];
            }
        }
    }
    always_comb {
        sbf4_v = 1'b0; sbf4_b = 8'd0;
        if stld_fwd_en {
            let ba: logic<64> = sbf_pa + 64'd4;
            if SB_DRAIN_SHADOW {
                if sbs_v_q && sbs_line_q == ba[63:6] && sbs_strb_q[ba[5:3]][ba[2:0]] {
                    let d: logic<64> = sbs_data_q[ba[5:3]] >> {ba[2:0], 3'b000};
                    sbf4_v = 1'b1; sbf4_b = d[7:0];
                }
            }
            for i in 0..SB_N {
                if (i as 4) <: sb_cnt && sb_line[i] == ba[63:6] && sb_strb[{(i as 2), ba[5:3]}][ba[2:0]] {
                    let d: logic<64> = sb_data[{(i as 2), ba[5:3]}] >> {ba[2:0], 3'b000};
                    sbf4_v = 1'b1; sbf4_b = d[7:0];
                }
            }
            if sb_push && sb_pa[63:3] == ba[63:3] && st_wstrb[ba[2:0]] {
                let d: logic<64> = st_wdata >> {ba[2:0], 3'b000};
                sbf4_v = 1'b1; sbf4_b = d[7:0];
            }
        }
    }
    always_comb {
        sbf5_v = 1'b0; sbf5_b = 8'd0;
        if stld_fwd_en {
            let ba: logic<64> = sbf_pa + 64'd5;
            if SB_DRAIN_SHADOW {
                if sbs_v_q && sbs_line_q == ba[63:6] && sbs_strb_q[ba[5:3]][ba[2:0]] {
                    let d: logic<64> = sbs_data_q[ba[5:3]] >> {ba[2:0], 3'b000};
                    sbf5_v = 1'b1; sbf5_b = d[7:0];
                }
            }
            for i in 0..SB_N {
                if (i as 4) <: sb_cnt && sb_line[i] == ba[63:6] && sb_strb[{(i as 2), ba[5:3]}][ba[2:0]] {
                    let d: logic<64> = sb_data[{(i as 2), ba[5:3]}] >> {ba[2:0], 3'b000};
                    sbf5_v = 1'b1; sbf5_b = d[7:0];
                }
            }
            if sb_push && sb_pa[63:3] == ba[63:3] && st_wstrb[ba[2:0]] {
                let d: logic<64> = st_wdata >> {ba[2:0], 3'b000};
                sbf5_v = 1'b1; sbf5_b = d[7:0];
            }
        }
    }
    always_comb {
        sbf6_v = 1'b0; sbf6_b = 8'd0;
        if stld_fwd_en {
            let ba: logic<64> = sbf_pa + 64'd6;
            if SB_DRAIN_SHADOW {
                if sbs_v_q && sbs_line_q == ba[63:6] && sbs_strb_q[ba[5:3]][ba[2:0]] {
                    let d: logic<64> = sbs_data_q[ba[5:3]] >> {ba[2:0], 3'b000};
                    sbf6_v = 1'b1; sbf6_b = d[7:0];
                }
            }
            for i in 0..SB_N {
                if (i as 4) <: sb_cnt && sb_line[i] == ba[63:6] && sb_strb[{(i as 2), ba[5:3]}][ba[2:0]] {
                    let d: logic<64> = sb_data[{(i as 2), ba[5:3]}] >> {ba[2:0], 3'b000};
                    sbf6_v = 1'b1; sbf6_b = d[7:0];
                }
            }
            if sb_push && sb_pa[63:3] == ba[63:3] && st_wstrb[ba[2:0]] {
                let d: logic<64> = st_wdata >> {ba[2:0], 3'b000};
                sbf6_v = 1'b1; sbf6_b = d[7:0];
            }
        }
    }
    always_comb {
        sbf7_v = 1'b0; sbf7_b = 8'd0;
        if stld_fwd_en {
            let ba: logic<64> = sbf_pa + 64'd7;
            if SB_DRAIN_SHADOW {
                if sbs_v_q && sbs_line_q == ba[63:6] && sbs_strb_q[ba[5:3]][ba[2:0]] {
                    let d: logic<64> = sbs_data_q[ba[5:3]] >> {ba[2:0], 3'b000};
                    sbf7_v = 1'b1; sbf7_b = d[7:0];
                }
            }
            for i in 0..SB_N {
                if (i as 4) <: sb_cnt && sb_line[i] == ba[63:6] && sb_strb[{(i as 2), ba[5:3]}][ba[2:0]] {
                    let d: logic<64> = sb_data[{(i as 2), ba[5:3]}] >> {ba[2:0], 3'b000};
                    sbf7_v = 1'b1; sbf7_b = d[7:0];
                }
            }
            if sb_push && sb_pa[63:3] == ba[63:3] && st_wstrb[ba[2:0]] {
                let d: logic<64> = st_wdata >> {ba[2:0], 3'b000};
                sbf7_v = 1'b1; sbf7_b = d[7:0];
            }
        }
    }
    assign stld_fwd_data = {
        if sf7_v ? sf7_b : sbf7_b, if sf6_v ? sf6_b : sbf6_b, if sf5_v ? sf5_b : sbf5_b,
        if sf4_v ? sf4_b : sbf4_b, if sf3_v ? sf3_b : sbf3_b, if sf2_v ? sf2_b : sbf2_b,
        if sf1_v ? sf1_b : sbf1_b, if sf0_v ? sf0_b : sbf0_b
    };
    assign sf_rob_mask = {sf7_v, sf6_v, sf5_v, sf4_v, sf3_v, sf2_v, sf1_v, sf0_v};
    // Block T diagnosis: the committed-store-buffer half, so a probe can say WHICH
    // net should have covered a load (stld_fwd_mask is the OR of the two).
    let sbf_fwd_mask: logic<8> = {sbf7_v, sbf6_v, sbf5_v, sbf4_v, sbf3_v, sbf2_v, sbf1_v, sbf0_v};
    assign stld_fwd_mask = {
        sf7_v || sbf7_v, sf6_v || sbf6_v, sf5_v || sbf5_v, sf4_v || sbf4_v,
        sf3_v || sbf3_v, sf2_v || sbf2_v, sf1_v || sbf1_v, sf0_v || sbf0_v
    };
    // Slot-1 twin (bare mode only — ld2_complete requires !dmem_vm_on, so the
    // PA is the AGU VA and no translation is involved).
    var sbg0_v: logic; var sbg0_b: logic<8>;
    var sbg1_v: logic; var sbg1_b: logic<8>;
    var sbg2_v: logic; var sbg2_b: logic<8>;
    var sbg3_v: logic; var sbg3_b: logic<8>;
    var sbg4_v: logic; var sbg4_b: logic<8>;
    var sbg5_v: logic; var sbg5_b: logic<8>;
    var sbg6_v: logic; var sbg6_b: logic<8>;
    var sbg7_v: logic; var sbg7_b: logic<8>;
    always_comb {
        sbg0_v = 1'b0; sbg0_b = 8'd0;
        if stld_fwd_en2 {
            let ba: logic<64> = agu_addr_iss2 + 64'd0;
            for i in 0..SB_N {
                if (i as 4) <: sb_cnt && sb_line[i] == ba[63:6] && sb_strb[{(i as 2), ba[5:3]}][ba[2:0]] {
                    let d: logic<64> = sb_data[{(i as 2), ba[5:3]}] >> {ba[2:0], 3'b000};
                    sbg0_v = 1'b1; sbg0_b = d[7:0];
                }
            }
            if sb_push && sb_pa[63:3] == ba[63:3] && st_wstrb[ba[2:0]] {
                let d: logic<64> = st_wdata >> {ba[2:0], 3'b000};
                sbg0_v = 1'b1; sbg0_b = d[7:0];
            }
        }
    }
    always_comb {
        sbg1_v = 1'b0; sbg1_b = 8'd0;
        if stld_fwd_en2 {
            let ba: logic<64> = agu_addr_iss2 + 64'd1;
            for i in 0..SB_N {
                if (i as 4) <: sb_cnt && sb_line[i] == ba[63:6] && sb_strb[{(i as 2), ba[5:3]}][ba[2:0]] {
                    let d: logic<64> = sb_data[{(i as 2), ba[5:3]}] >> {ba[2:0], 3'b000};
                    sbg1_v = 1'b1; sbg1_b = d[7:0];
                }
            }
            if sb_push && sb_pa[63:3] == ba[63:3] && st_wstrb[ba[2:0]] {
                let d: logic<64> = st_wdata >> {ba[2:0], 3'b000};
                sbg1_v = 1'b1; sbg1_b = d[7:0];
            }
        }
    }
    always_comb {
        sbg2_v = 1'b0; sbg2_b = 8'd0;
        if stld_fwd_en2 {
            let ba: logic<64> = agu_addr_iss2 + 64'd2;
            for i in 0..SB_N {
                if (i as 4) <: sb_cnt && sb_line[i] == ba[63:6] && sb_strb[{(i as 2), ba[5:3]}][ba[2:0]] {
                    let d: logic<64> = sb_data[{(i as 2), ba[5:3]}] >> {ba[2:0], 3'b000};
                    sbg2_v = 1'b1; sbg2_b = d[7:0];
                }
            }
            if sb_push && sb_pa[63:3] == ba[63:3] && st_wstrb[ba[2:0]] {
                let d: logic<64> = st_wdata >> {ba[2:0], 3'b000};
                sbg2_v = 1'b1; sbg2_b = d[7:0];
            }
        }
    }
    always_comb {
        sbg3_v = 1'b0; sbg3_b = 8'd0;
        if stld_fwd_en2 {
            let ba: logic<64> = agu_addr_iss2 + 64'd3;
            for i in 0..SB_N {
                if (i as 4) <: sb_cnt && sb_line[i] == ba[63:6] && sb_strb[{(i as 2), ba[5:3]}][ba[2:0]] {
                    let d: logic<64> = sb_data[{(i as 2), ba[5:3]}] >> {ba[2:0], 3'b000};
                    sbg3_v = 1'b1; sbg3_b = d[7:0];
                }
            }
            if sb_push && sb_pa[63:3] == ba[63:3] && st_wstrb[ba[2:0]] {
                let d: logic<64> = st_wdata >> {ba[2:0], 3'b000};
                sbg3_v = 1'b1; sbg3_b = d[7:0];
            }
        }
    }
    always_comb {
        sbg4_v = 1'b0; sbg4_b = 8'd0;
        if stld_fwd_en2 {
            let ba: logic<64> = agu_addr_iss2 + 64'd4;
            for i in 0..SB_N {
                if (i as 4) <: sb_cnt && sb_line[i] == ba[63:6] && sb_strb[{(i as 2), ba[5:3]}][ba[2:0]] {
                    let d: logic<64> = sb_data[{(i as 2), ba[5:3]}] >> {ba[2:0], 3'b000};
                    sbg4_v = 1'b1; sbg4_b = d[7:0];
                }
            }
            if sb_push && sb_pa[63:3] == ba[63:3] && st_wstrb[ba[2:0]] {
                let d: logic<64> = st_wdata >> {ba[2:0], 3'b000};
                sbg4_v = 1'b1; sbg4_b = d[7:0];
            }
        }
    }
    always_comb {
        sbg5_v = 1'b0; sbg5_b = 8'd0;
        if stld_fwd_en2 {
            let ba: logic<64> = agu_addr_iss2 + 64'd5;
            for i in 0..SB_N {
                if (i as 4) <: sb_cnt && sb_line[i] == ba[63:6] && sb_strb[{(i as 2), ba[5:3]}][ba[2:0]] {
                    let d: logic<64> = sb_data[{(i as 2), ba[5:3]}] >> {ba[2:0], 3'b000};
                    sbg5_v = 1'b1; sbg5_b = d[7:0];
                }
            }
            if sb_push && sb_pa[63:3] == ba[63:3] && st_wstrb[ba[2:0]] {
                let d: logic<64> = st_wdata >> {ba[2:0], 3'b000};
                sbg5_v = 1'b1; sbg5_b = d[7:0];
            }
        }
    }
    always_comb {
        sbg6_v = 1'b0; sbg6_b = 8'd0;
        if stld_fwd_en2 {
            let ba: logic<64> = agu_addr_iss2 + 64'd6;
            for i in 0..SB_N {
                if (i as 4) <: sb_cnt && sb_line[i] == ba[63:6] && sb_strb[{(i as 2), ba[5:3]}][ba[2:0]] {
                    let d: logic<64> = sb_data[{(i as 2), ba[5:3]}] >> {ba[2:0], 3'b000};
                    sbg6_v = 1'b1; sbg6_b = d[7:0];
                }
            }
            if sb_push && sb_pa[63:3] == ba[63:3] && st_wstrb[ba[2:0]] {
                let d: logic<64> = st_wdata >> {ba[2:0], 3'b000};
                sbg6_v = 1'b1; sbg6_b = d[7:0];
            }
        }
    }
    always_comb {
        sbg7_v = 1'b0; sbg7_b = 8'd0;
        if stld_fwd_en2 {
            let ba: logic<64> = agu_addr_iss2 + 64'd7;
            for i in 0..SB_N {
                if (i as 4) <: sb_cnt && sb_line[i] == ba[63:6] && sb_strb[{(i as 2), ba[5:3]}][ba[2:0]] {
                    let d: logic<64> = sb_data[{(i as 2), ba[5:3]}] >> {ba[2:0], 3'b000};
                    sbg7_v = 1'b1; sbg7_b = d[7:0];
                }
            }
            if sb_push && sb_pa[63:3] == ba[63:3] && st_wstrb[ba[2:0]] {
                let d: logic<64> = st_wdata >> {ba[2:0], 3'b000};
                sbg7_v = 1'b1; sbg7_b = d[7:0];
            }
        }
    }
    assign stld_fwd_data2 = {
        if sg7_v ? sg7_b : sbg7_b, if sg6_v ? sg6_b : sbg6_b, if sg5_v ? sg5_b : sbg5_b,
        if sg4_v ? sg4_b : sbg4_b, if sg3_v ? sg3_b : sbg3_b, if sg2_v ? sg2_b : sbg2_b,
        if sg1_v ? sg1_b : sbg1_b, if sg0_v ? sg0_b : sbg0_b
    };
    assign stld_fwd_mask2 = {
        sg7_v || sbg7_v, sg6_v || sbg6_v, sg5_v || sbg5_v, sg4_v || sbg4_v,
        sg3_v || sbg3_v, sg2_v || sbg2_v, sg1_v || sbg1_v, sg0_v || sbg0_v
    };

    inst u_dmem_mmu: dmem_mmu #(
        PMA_FAULT: PMA_FAULT,
    ) (
        clk                          ,
        rst                          ,
        i_vaddr     : core_dmem_vaddr,
        i_wdata     : core_dmem_wdata,
        i_wen       : core_dmem_wen  ,
        i_ren       : core_dmem_ren  ,
        // Block T: the extra Stage-A translate opened over an occupied LSR is
        // SPECULATIVE — translate off the TLB, never start a walk (see mmu.veryl's
        // i_no_walk; a walk started here owns the dmem port and holds the very
        // incumbent whose slot was about to free). Registers only → loop-free.
        i_no_walk   : lsr_b2b_spec   ,
        i_wstrb     : core_dmem_wstrb,
        o_rdata     : dmem_mmu_rdata ,
        o_dmem_addr : dmu_dmem_addr  ,
        o_dmem_wdata: dmu_dmem_wdata ,
        // M8.B: PTW PTE reads now come from the dcache (PTE is data). On a PTE
        // miss the dcache fills and dcache_stall holds the walk via i_dcache_stall
        // below. In Bare mode no walk runs so this input is unused.
        i_dmem_rdata: dcache_rdata   ,
        o_dmem_wen  : dmu_dmem_wen   ,
        o_dmem_ren  : dmu_dmem_ren   ,
        o_dmem_wstrb: dmu_dmem_wstrb ,
        i_satp      : satp_shadow    ,
        // Effective priv for dmem accesses: when mstatus.MPRV is set,
        // loads/stores use mstatus.MPP's priv level for translation
        // (RISC-V priv spec). Used by rv64si-dirty etc. Phase 11-H: an HLV/HSV
        // overrides this to the hstatus.SPVP-selected VS/VU priv (dmem_mmu_priv).
        i_priv       : dmem_mmu_priv   ,
        i_sum        : dmem_sum         ,
        i_mxr        : dmem_mxr         ,
        i_pbmte      : csr_pbmte       ,
        i_adue       : csr_adue        ,
        i_pmpcfg     : csr_pmpcfg      ,
        i_pmpaddr    : csr_pmpaddr     ,
        i_is_amo     : core_dmem_is_amo,
        i_cbo        : core_dmem_cbo   ,
        // Phase 11-H two-stage data translation. dmem_virt2 = MPRV+MPV-effective V
        // OR an explicit HLV/HSV (dmem_op_hlv), so a hypervisor virtual-memory
        // access translates two-stage even while the core itself runs at V=0/HS.
        i_virt        : dmem_virt2     ,
        i_vsatp       : vsatp_shadow  ,
        i_hgatp       : csr_hgatp      ,
        i_hlvx        : dmem_op_hlvx   , // HLVX.HU/.WU: read checks execute (X)
        o_gstage_fault: dmem_mmu_gstage,
        o_fault_gpa   : dmem_mmu_gpa   ,
        o_uncached   : dmu_pbmt_unc    ,
        o_ad_writeback: dmu_ad_wb      , // P10 Svadu: A/D write-back this cycle
        o_busy       : dmem_mmu_busy   ,
        o_fault      : dmem_mmu_fault  ,
        o_fault_store: dmem_mmu_fault_s,
        o_acc_fault      : dmem_mmu_acc_fault  ,
        o_acc_fault_store: dmem_mmu_acc_fault_s,
        o_pte_acc_fault  : dmem_mmu_pte_acc_fault,
        o_pma_hole       : dmem_mmu_pma_hole     ,
        o_rdata_valid: dmem_mmu_rdv    ,
        o_walk_start : dmem_walk_start , // M9.A.296: PTW-start pulse for F2 owner re-latch
        o_idle       : dmem_mmu_idle   , // M9.3: gate the load-walk VA pin on a REAL in-flight walk
        o_sprobe_pa  : dmem_sprobe_pa  , // CP commit-store pre-translate: STORE TLB probe PA
        o_sprobe_ok  : dmem_sprobe_ok  , // CP commit-store pre-translate: clean store fast-path hit

        // M8.B: stall the dmem MMU walk while the dcache is filling a PTE-read
        // miss — the walk must not advance (i_ptw_valid) until the PTE is cached.
        // M8.C: the old imem_ptw_req_w term is gone — imem PTW now has its own
        // o_iptw bus and no longer contends for the dmem bus.
        i_dcache_stall: dcache_stall,
        i_sfence      : commit_sfence_pulse,
        i_sfence_vaddr   : sfence_vaddr   , // P9.5: selective flush operands
        i_sfence_asid    : sfence_asid    ,
        i_sfence_rs1_zero: sfence_rs1_zero,
        i_sfence_rs2_zero: sfence_rs2_zero,
        // CP M2.5: clean walk-dcache bundle (live PTW access under MEM_PIPE)
        o_ptw_dc_active: ptw_dc_active,
        o_ptw_dc_ren   : ptw_dc_ren   ,
        o_ptw_dc_addr  : ptw_dc_addr  ,
        o_ptw_dc_wdata : ptw_dc_wdata ,
        // M9.A.303 debug
        o_dbg_ptw_req : dmem_dptw_req ,
        o_dbg_ptw_addr: dmem_dptw_addr,
        o_dbg_pte     : dmem_dpte     ,
        o_dbg_tlb_hit : dmem_dtlb_hit ,
        o_dbg_tlb_ppn : dmem_dtlb_ppn ,
        o_dbg_tlb_perm: dmem_dtlb_perm,
    );
    let _unused_dmem_fault: logic     = dmem_mmu_fault;
    let _unused_dmem_fs   : logic     = dmem_mmu_fault_s;
    let _unused_dmem_rdv  : logic     = dmem_mmu_rdv;
    let _unused_dmem_rdata: logic<64> = dmem_mmu_rdata; // alu_wrap reads dcache_rdata; dmem_mmu.o_rdata stays unused

    // ============================================================
    // M8.B: L1 data cache, inserted between dmem_mmu (dmu_dmem_*) and the
    // external dmem port (o_dmem_*). BLOCKING: o_stall (dcache_stall) folds
    // into the issue/ack/commit gates and dmem_mmu's i_dcache_stall above, so
    // a miss holds the pipeline until the 8-dword line fill completes; the hit
    // data (dcache_rdata) then feeds alu_wrap (LOAD) and dmem_mmu (PTE read).
    // CPU side = the dmem MMU output, gated off during an imem PTW so the imem
    // walk bypasses the dcache on the shared dmem bus. Mem side + the imem PTW
    // addr mux drive o_dmem_*. Single-hart: invalidate port tied off, grant
    // tied high by the SoC. Misaligned STORE: tb hi-side via o_dmem_wdata_hi/
    // wstrb_hi bypass + dcache invalidates the touched lines (B.3, i_wstrb_hi).
    // Misaligned cross-line LOAD: dcache fills the next line too (B.3, i_load_next).
    // ============================================================
    // B.3 dcache hints. dc_st_wstrb_hi: hi strobe for a committing misaligned
    // STORE (drives BOTH the dcache line-invalidation and the tb bypass below).
    // S20R: the hi strobe must pair with ITS OWN i_wen write — the SoC keys
    // the +8 hi-side DRAM/L2 bypass on "this hart holds the W grant", and
    // with the store buffer a DRAIN can hold that grant while a misaligned
    // store sits at commit with its i_wen still suppressed (VM walk /
    // translation pending). The unpaired strobe then writes the pending
    // store's hi bytes at DRAIN_ADDR+8 — random committed-memory corruption
    // (observed: N=2 kernel wedged walking a corrupted hash chain). Gate the
    // strobe on the dcache's EFFECTIVE i_wen, so it is nonzero only on
    // cycles the lo write itself can own the W channel.
    // P10 Svadu: a PTW A/D write-back (dmu_ad_wb) forces the dcache i_wen — the
    // MMU owns the port for it, so the committing-store gates (sb_vm_ok / AMO /
    // MMIO overlap) do not apply. It is an aligned single-dword write-through
    // (dmu_dmem_wstrb=0xFF), so the misaligned hi-strobe and the in-cache AMO
    // excl-merge must both be suppressed for it (a concurrently-committing
    // misaligned store or AMO at the ROB head would otherwise leak its
    // st_wstrb_hi / c_is_amo into the PTE write and corrupt it / hang the walk).
    // CP commit-store pre-translate (P5a change B): gate on the LIVE cacheable condition
    // (sb_vm_live_ok), NOT the registered-PA push-elig sb_vm_ok — so a non-pre-translated
    // cacheable VM store still suppresses the M-stage dcache write at its live-translate
    // cycle and is instead SB-pushed (from the registered m_pa_q) on its retire cycle.
    // At STORE_PRETRANSLATE=0 sb_vm_live_ok ≡ sb_vm_ok = byte-identical.
    let dc_i_wen      : logic    = (dmu_dmem_wen && !sb_vm_live_ok && !(if c_is_amo || c_store_mmio_x ? !sb_empty_eff : sb_st_ovl)) || dmu_ad_wb;
    // Phase 12 V1: a VU unit-stride store element is single-dword (no hi-strobe).
    let dc_st_wstrb_hi: logic<8> = if vu_mem_active ? 8'd0 : if dmu_ad_wb ? 8'd0 : if dc_i_wen ? st_wstrb_hi : 8'd0;
    // P9.3: in-cache AMO/SC commit write — eligible when the committing
    // store is an AMO/SC to a cacheable DRAM PA outside the tohost pages
    // (mirrors the fast-store / sb_vm_ok exclusions: the harnesses watch
    // the DRAM array, and MMIO is uncacheable). The dcache merges it into
    // the owned line locally (no write channel); ineligible AMO/SC writes
    // keep the write-through path.
    let st_pa_w      : logic<64> = if dmem_vm_on_op ? dmu_dmem_addr : c_store_addr; // Phase 11-H HSV → translated PA
    let st_pa_tohost : logic     = (st_pa_w[31:14] == 18'h20000) || (st_pa_w[31:12] == 20'h80008);
    let dc_wen_excl  : logic     = c_is_amo && !c_store_mmio_x && !st_pa_tohost && !dmu_ad_wb && !amo_commit_acc_fault;
    // (P9.3: the ownership pin is dcache-internal — it self-arms at the
    // AMO/LR read's data arrival, which closes the issue→pin arming gap a
    // core-driven pin had: remote recalls landing in that 2-3 cycle window
    // stole the reservation every spin iteration — LR/SC livelock.)
    // dc_load_next: the issuing LOAD's data spans into the next dword
    // (byte_off + size > 8); the dcache fills the next line when it crosses one.
    let dc_byte_off: logic<3> = dmu_dmem_addr[2:0];
    let dc_ld_bytes: logic<5> = if iq_issue_op.base.mem_funct3[1:0] == 2'b00 ?
        5'd1
    : if iq_issue_op.base.mem_funct3[1:0] == 2'b01 ?
        5'd2
    : if iq_issue_op.base.mem_funct3[1:0] == 2'b10 ?
        5'd4
    :
        5'd8
    ;
    let dc_span_sum : logic<6> = ({3'b0, dc_byte_off} as 6) + ({1'b0, dc_ld_bytes} as 6);
    let dc_load_next: logic    = issue_is_load && (dc_span_sum >: 6'd8);
    // Phase 8 S5.2: drive the 2nd hit-only read port from the slot-1 LOAD AGU.
    // BARE mode only (PA==VA); under Sv39/VM the slot-1 load is not admitted
    // (S5.1 conservative) so the port stays off. dc_ren2 is independent of the
    // 2nd-port hit (no comb loop). The completion gate (ld2_complete / issue2_fire,
    // after the dcache inst) adds !dcache_stall / !redirect / !inv.
    let dc_byte_off2: logic<3> = agu_addr_iss2[2:0];
    let dc_ld_bytes2: logic<5> = if iq_issue_op2.base.mem_funct3[1:0] == 2'b00 ?
        5'd1
    : if iq_issue_op2.base.mem_funct3[1:0] == 2'b01 ?
        5'd2
    : if iq_issue_op2.base.mem_funct3[1:0] == 2'b10 ?
        5'd4
    :
        5'd8
    ;
    let dc_span_sum2: logic<6> = ({3'b0, dc_byte_off2} as 6) + ({1'b0, dc_ld_bytes2} as 6);
    assign dc_addr2      = agu_addr_iss2;
    assign dc_ren2       = issue2_is_load && !dmem_vm_on;
    assign dc_load_next2 = issue2_is_load && (dc_span_sum2 >: 6'd8);
    // Phase 8 S10.4b: replay injection. A QUEUED MSHR (captured while the
    // dcache was busy) re-executes its read by driving its address onto the
    // dcache CPU port once armed (replay_q). The drive defers to a committing
    // store's write (store_drive owns i_addr for the write-through) and to a
    // PTW PTE read (mmu_walk_inflight owns the port for the walk) — both are
    // bounded, so the replay always eventually gets the port. Outcomes:
    //   HIT  (dc_hit_safe — the line arrived via an earlier fill, possibly
    //         still mid-another-fill): complete from o_rdata (replay_hit_fire).
    //   MISS (dc_miss_valid while driving): the fill starts and the entry
    //         becomes its owner (replay_claim).
    // The target select (replay_is_a) is combinational; it is consistent with
    // the address being driven on the same cycle by construction.
    let mshra_queued: logic     = mshra_v_q && !mshra_done_q && !mshra_own_q;
    let mshrb_queued: logic     = mshrb_v_q && !mshrb_done_q && !mshrb_own_q;
    let replay_is_a : logic     = mshra_queued;
    let replay_addr : logic<64> = if mshra_queued ? mshra_addr_q : mshrb_addr_q;
    // S10.5: defer to the MMU being fully IDLE, not merely !mmu_walk_inflight.
    // mmu_walk_inflight is walk_v_q-based and so misses (1) STORE-commit walks
    // (excluded from load_walk_busy; !store_drive happens to cover them) and
    // (2) ORPHAN walks — a walk whose owner was squashed by a redirect
    // (walk_phys_q && !walk_v_q, the M9.3 class) keeps issuing PTE reads; a
    // replay overriding i_addr during one of them feeds the REPLAY LOAD's
    // data to the MMU as a PTE, installing a garbage TLB entry → spurious
    // load page faults on valid kernel VAs (the N=2 post-SMP-bringup Oops,
    // badaddr == a live kernel pointer). dmem_mmu_idle is the MMU's state
    // register — no walk of any kind can consume the port while it is IDLE,
    // and the !replay_q term in core_dmem_ren keeps a NEW walk from starting
    // mid-replay.
    // CP MEM_PIPE: at MEM_PIPE=1 a slow store's dcache write is REGISTERED into the
    // M-stage (m_wen_q / m_pa_q), so it lands the cycle AFTER store_drive. A read-port
    // override (lsr_drive / replay_drive) that fires that next cycle hijacks i_addr (to
    // lsr_paddr_q / replay_addr) while the registered write is still enabled
    // (dmem_wen_m = m_wen_q) — misdirecting the store write to the load/replay address
    // AND never landing it at m_pa_q (a double bug: it corrupted an unrelated line to 0
    // and dropped the real store). The live !store_drive term in both drives only yields
    // to the SAME-cycle (MEM_PIPE=0) write; yield to the registered write too so it lands
    // at m_pa_q and the load/replay simply defers one cycle. Dead at MEM_PIPE=0 (m_wen_q
    // unread there), restoring the MEM_PIPE=0 invariant "no read-override during a store
    // write". ptw/amo_commit_live writes can't coincide (they need a walk / store_drive,
    // both excluded by the drives), so gating on m_wen_q alone is sufficient.
    let m_store_wr_busy: logic = MEM_PIPE && m_wen_q;
    // L4 step-2: the ASQ yield terms replay_drive never got. R3 (ATOMIC_SQ, 2026-07)
    // added `asq_dr_busy` and `asq_ld_ovl` to load_blocks_on_store so that (a) the
    // drain engine owns the shared dcache port uncontested while it runs and (b) no
    // younger access reads a line whose value a queued atomic has not computed yet.
    // Both were added to the ISSUE path only — replay_drive has been dead since
    // 88b7735 (2026-06-26), so it was never in scope and drives the port with
    // neither check. A replay is exactly the case (b) is about: it was cleared
    // against the ASQ at lsr_capture, then sat in an MSHR entry for arbitrarily
    // many cycles, during which an atomic can enter the queue. Reading stale bytes
    // there loses the atomic's update — which is the litmus test-7 symptom.
    // asq_ld_ovl is built from the ISSUING address, so the replay needs its own
    // compare against replay_addr; single-dword only, since cross-dword spans are
    // excluded from capture (!lsr_dc_load_next). Bounded: the ASQ entry drains.
    let asq_replay_ovl: logic = ATOMIC_SQ && asq_valid_q[0] && asq_pa_q[0][11:3] == replay_addr[11:3];
    // L4 step-2: the READ counterpart of m_store_wr_busy. At MEM_PIPE=1 a NON-capturing
    // memory read (AMO/LR fetch, an uncached load whose lsr_capture was blocked, …) is
    // REGISTERED into the M-stage and reaches the dcache the cycle after translate. A
    // replay firing on that cycle hijacks i_addr and hands the M-stage access the
    // REPLAY's data. The ASQ drain engine already yields to exactly this
    // (asq_dr_port_ok: `!m_ren_q && !m_wen_q && !ptw_dc_active`); replay_drive yields to
    // the write half only. lsr_drive needs no such term — a plain load and a
    // non-capturing read cannot both be in flight (the issue gates keep an AMO out while
    // lsr_v_q), and a probe over a whole N=1 boot confirms lsr_drive NEVER collides
    // while replay_drive does. Bounded: the M-stage access completes or retries.
    let m_load_rd_busy: logic = MEM_PIPE && m_ren_q;
    let replay_drive: logic = replay_q && !store_drive && dmem_mmu_idle && !m_store_wr_busy
        && !m_load_rd_busy && !asq_dr_busy && !asq_replay_ovl;

    // ============================================================
    // Phase 1 LSU 2-stage: Load Stage Register control (assigned here so
    // store_drive / dmem_mmu_idle / redirect_fire are in scope; the signals are
    // forward-declared near the LSR regs and read by the EARLY issue gates / dcache
    // muxes). A plain load is cut into Stage A (capture) and Stage B (drive+complete).
    // ============================================================
    let lsr_fault : logic = lsr_fault_pg_q || lsr_fault_acc_q;
    // Stage A: a plain load that has finished translate+PMP (!dmem_mmu_busy) and is
    // otherwise free to issue latches the LSR and acks OUT of the IQ — the SAME gate
    // the old single-cycle u_lsu.i_valid used, MINUS iss_dc_ok (the Stage-A dcache
    // read is suppressed, so there is no miss to wait on, and including dcache_stall
    // here would close a comb loop: i_ren depends on lsr_capture). Requires the LSR
    // free (!lsr_v_q) — block-on-issue.
    // Split out the LSR-free test so the census below can count the cycles on which
    // EVERYTHING BUT the free slot was ready — that population is the Block T prize.
    let lsr_cap_terms: logic = iq_issue_valid && !iss_is_div && !dmem_mmu_busy && !load_walk_block
        && !fpu_cdb.valid && !mshr_cdb.valid && !load_blocks_on_store && iss_is_plain_load
        && !replay_q && !redirect_fire && !early_redir_fire_q;
    assign lsr_capture = lsr_cap_terms && (!lsr_v_q || lsr_b2b_free);
    // Stage B: own the dcache read port. Mirror replay_drive's port arbitration
    // (yield to a committing store's write and to any in-flight MMU walk); a faulting
    // load needs no read (it completes from the latched fault).
    assign lsr_drive = lsr_v_q && !lsr_fault && !store_drive && dmem_mmu_idle && !replay_q && !m_store_wr_busy;
    // Stage B misaligned cross-line span, from the latched funct3 + PA byte offset.
    let lsr_ld_bytes: logic<5> = if lsr_funct3_q[1:0] == 2'b00 ? 5'd1
        : if lsr_funct3_q[1:0] == 2'b01 ? 5'd2
        : if lsr_funct3_q[1:0] == 2'b10 ? 5'd4 : 5'd8;
    let lsr_span_sum: logic<6> = ({3'b0, lsr_paddr_q[2:0]} as 6) + ({1'b0, lsr_ld_bytes} as 6);
    assign lsr_dc_load_next = lsr_v_q && (lsr_span_sum >: 6'd8) && !lsr_unc_q;

    var dc_mem_addr : logic<64>    ;
    var dc_mem_wdata: logic<64> [8]; // S25: write-channel line lanes
    var dc_mem_wen  : logic        ;
    var dc_mem_ren  : logic        ;
    var dc_mem_wstrb: logic<8>  [8];
    var dc_mem_req  : logic        ;
    var dc_mem_rfo  : logic        ; // P9.6: dcache RFO (muxed into o_dmem_rfo)
    var dc_grant    : logic        ; // P9.6: read-port grant demuxed to the dcache
    var dc_memw_addr: logic<64>; // S23: write-channel address
    var dc_memw_req : logic    ;
    // Phase 8 S10.1: non-blocking miss (MSHR) interface, consumed by the MSHR
    // block after the instance. dc_miss_valid = fill-start pulse, dc_fill_complete
    // = non-aborted DONE, dc_fill_rdata = filled dword at the original miss offset.
    var dc_miss_valid   : logic    ;
    var dc_mshr_alloc   : logic    ; // N2.2b: a D-cache MSHR entry HOLDS a line, waiting for its grant
    var dc_stall_why    : logic<8> ; // N2.2b census: which class of reason o_stall is high (see dcache.veryl)
    var dc_miss_offset  : logic<3> ; // L4 step-2: demanded dword of the starting fill
    var dc_fill_complete: logic    ;
    var dc_fill_rdata   : logic<64>;
    var dc_fill_aborted : logic    ;
    var dc_fill_ready   : logic    ; // S14.2: demanded dword landed (critical-word-first)
    // P9.5: an uncached MMIO load — a plain (non-AMO, non-replay) load whose PA
    // is outside the cacheable DRAM window (PA[63:25] != 0x40, the same window
    // c_store_mmio uses). The dcache then does a single exact-address bus read
    // instead of a line fill, so a device register read (e.g. a PLIC claim at a
    // 0x..4 offset, with its side effect) works correctly. dmu_dmem_addr is the
    // post-MMU PA in both bare and Sv39 modes.
    // P10 Svpbmt: a translated NC/IO page (dmu_pbmt_unc) is uncached even when
    // its PA falls inside the cacheable DRAM window.
    let dc_uncached: logic = dmu_dmem_ren && !replay_drive && !dc_amo_read
        && ((dmu_dmem_addr[63:25] != 39'h40) || (dmem_vm_on_op && dmu_pbmt_unc)); // Phase 11-H: HLV NC page
    // P10 Svadu: build the store-drain port inputs — the instruction-side A-bit
    // write-back (imem_aw_grant) takes the port when the store buffer is empty,
    // else the normal committed-store-buffer drain. The A-write puts the updated
    // PTE on its single dword lane (imem_aw_lane) with a 0xFF strobe, all other
    // lanes idle, so the d-cache merges just the PTE into the owned line.
    var sdrain_swdata: logic<64> [8];
    var sdrain_swstrb: logic<8>  [8];
    always_comb {
        for l in 0..8 {
            sdrain_swdata[l] = sb_head_data[l];
            sdrain_swstrb[l] = sb_head_strb[l];
        }
        if imem_aw_grant {
            for l in 0..8 {
                sdrain_swdata[l] = 64'd0;
                sdrain_swstrb[l] = 8'd0;
            }
            sdrain_swdata[imem_aw_lane] = imem_ptw_wdata_w;
            sdrain_swstrb[imem_aw_lane] = 8'hFF;
        }
    }
    let sdrain_saddr  : logic<64> = if imem_aw_grant ? {imem_ptw_addr_w[63:6], 6'd0} : {sb_line[0], 6'd0};
    let sdrain_swen   : logic     = imem_aw_grant || !sb_empty;
    let sdrain_urgent : logic     = imem_aw_grant || (sb_cnt >= 4'd3);
    // CP MMU->dcache pipeline (M1): the dcache stage-M inputs. At MEM_PIPE=0 these
    // are the LIVE MMU+PMP outputs (today, byte-identical); at 1 they are the
    // registered M-stage values (the dcache accesses the cycle after translate).
    // The LSR/replay drives keep their own registered addresses in both arms (the
    // M-stage coexists with the LSR for plain loads in M1; folding is M4 work).
    // CP M2.5: at MEM_PIPE=1, a PTW walk (ptw_dc_active) drives the dcache LIVE off
    // the short-path ptw_dc_* bundle (the walk keeps MEM_PIPE=0 timing — only the
    // post-translate DATA access is registered into the M-stage). Non-walk cycles
    // read the M-stage. The walk PTE read is plain (no uncached/load-next/amo/excl/
    // hi-strobe); the A/D write-back is the only walk write (dmu_ad_wb, 0xFF strobe).
    // CP M3b: the AMO/SC COMMIT WRITE must stay SINGLE-CYCLE (live), like MEM_PIPE=0.
    // Registering it through the M-stage (M3a, the +1-cycle translate→write slip)
    // breaks the in-cache RMW atomicity: a remote recall landing on the registered
    // write cycle still merges the stale value (the live hit_excl gate vs the M-staged
    // input skew) while the poison only registers a cycle later — the watch is already
    // cleared, no replay, increment lost (litmus N=2 amoadd wedge). A real AMO / SC
    // commit (store_drive && c_is_amo; LR never store_drives) therefore drives the
    // dcache write LIVE off the commit store path — the write, its hit_excl ownership
    // gate, the poison check (commit_store_fire excludes the registered replay) and
    // the retire all coincide in one cycle, exactly the byte-identical MEM_PIPE=0
    // behavior. Plain slow stores keep the M3a 2-cycle path (no atomicity). The AMO
    // commit write address is the same line the AMO read+pinned, so the dcache pin
    // still protects the read→write window. The READ-side M-stage (amo_fetched_q) is
    // unaffected (the commit cycle is not a read cycle: amo_fetched_q / m_ren are 0).
    let amo_commit_live: logic = store_drive && c_is_amo;
    // CP M4: the AMO/SC commit write drives the dcache off the READ-TIME registers
    // (ac_*_q), not the live MMU/PMP — cutting the megacone while staying single-cycle
    // (live hit_excl) atomic. Address = ac_pa_q; write-enable = "committing & buffer
    // drained & permitted" (store_drive && sb_empty && ac_wok_q, all MMU-independent;
    // sb_empty is the AMO release-order gate that dc_i_wen folds in via !sb_empty);
    // in-cache-merge mode = ac_wexcl_q (cacheable). A faulting atomic never reaches
    // here (ac_wok_q=0 also belts it). For MMIO (ac_wexcl_q=0) the write is a plain
    // write-through (i_wen, !i_wen_excl), as at MEM_PIPE=0.
    // A-EXE (EX_PIPE=1): the AMO commit write must not land unless the AMO still
    // OWNS its watched line THIS cycle (dc_amo_present). The +1 CDB latency shifts
    // the AMO commit so its write can fire the cycle a remote RFO recalls the line
    // (dc_amo_present=0, amo_poison_q not yet set) — the store leaks into a line it
    // no longer owns, then the AMO replays a cycle too late (traced: litmus N2, a
    // contended barrier amoadd wrote count<=1 with present=0 → the leaked store
    // desynced the two harts' sense-reversing barrier into a permanent wedge).
    // Gate the write-enable on presence so a same-cycle departure suppresses it;
    // the registered poison then replays cleanly (re-acquire + re-read). At
    // EX_PIPE=0 the write never coincides with the recall, so the term folds to 1
    // → byte-identical. dc_amo_present is derived from the (registered) tag state,
    // not the bus invalidate, so it does not form a combinational loop.
    let amo_cwr_en   : logic     = store_drive && sb_empty_eff && ac_wok_q && (dc_amo_present || !EX_PIPE);
    // ── R3.1: atomic store-queue — entry + alloc/drain — DEAD at ATOMIC_SQ=0 ──
    // Block R (doc/cp_r3_atomic_reorder_plan.md §6, which supersedes §2's scheme A).
    // An ATOMIC-WITHOUT-RETURN (AMO with rd == x0, cacheable, fault-free) retires into
    // this queue like a store; its RMW is then performed at the memory system by the
    // R3.2 drain (RFO -> read -> `new = old OP src` -> write, one owned-line
    // transaction). Because rd is architecturally dead, NOTHING committed depends on
    // the execute-time `old`, so a line stolen mid-drain costs cycles, never
    // correctness — the drain simply retries. That is why this class needs no
    // cross-retire pin, no watch and no poison, and why "a retired atomic that cannot
    // drain" (the question that blocked R3) does not arise. Every result-returning
    // AMO, LR/SC, amocas and MMIO atomic keeps today's proven single-cycle path.
    //
    // Hence the entry carries the OPERANDS, not a pre-computed value: {pa, op, src,
    // size, aq/rl}. `src` is read from arch_regs at commit — the atomic is at the head
    // and retires in order, so the architectural rs2 is authoritative there (the same
    // idiom amocas.q's commit operands use). R3.0 shipped the scheme-A field set
    // (data/strb/wpa/pin); §6 replaced it with this one.
    //
    // The class predicate, the queue state and the entry array are declared with the
    // store-buffer forward declarations (they gate retire/fence/issue up there); this
    // block holds the entry's D-cone. Alloc is the cycle the in-cache write would have
    // fired; drain is R3.2's (still a placeholder: the real engine re-reads under
    // ownership). Both const-gated, so at ATOMIC_SQ=0 every field holds its reset value.
    // ── R3.2a: drain engine — datapath + FSM (DEAD at ATOMIC_SQ=0) ────────────
    // §6.2's compute-at-drain: the queued atomic's RMW is performed HERE, at the
    // memory system, not at execute. IDLE -> RD (an ownership read, i.e. the same
    // RFO the execute-side AMO read raises) -> WR (the in-cache exclusive merge of
    // `new = old OP src`) -> IDLE. Because rd is architecturally dead for this class,
    // losing the line at any point is not a correctness event: asq_dr_poison simply
    // sends the engine back to RD and it re-reads. That retry is the whole answer to
    // "a retired atomic that cannot drain" — there is no fallback machinery, and no
    // pin has to be held across retire.
    //
    // Poison sources are the ones the execute-side watch already uses (remote/precise
    // invalidate + local eviction), compared against the entry's line. A stale `old`
    // can therefore never reach the write: any departure between RD and WR restarts
    // the read.
    //
    // ⚠️ R3.2a builds the engine only — its requests are NOT yet wired into the dcache
    // port muxes (that is R3.2b), so at ATOMIC_SQ=1 the RD state would consume
    // whatever the port happens to return. =1 stays non-functional by construction
    // until R3.2b lands; at =0 the whole engine is const-gated and unreachable.
    var asq_dr_old_q: logic<64>; // the dword read back at asq_pa (dword frame)
    // R3.2b port arbitration: the engine is an OPPORTUNISTIC requester — it drives the
    // shared dcache port only on cycles nobody else owns it, so no in-flight
    // transaction can be preempted (the M-stage request is registered; stealing its
    // cycle would drop it, and stealing an LSR/replay/PTW cycle would make the engine
    // capture someone else's data). Starvation is prevented from the other side: while
    // the engine is busy, load/AMO issue is held (load_blocks_on_store), so the port
    // quiesces as the in-flight accesses retire and the drain gets its cycles.
    // NOTE the !asq_class qualifier on the amo_commit_live term. A CLASS atomic's
    // commit drives no dcache write (amo_cwr_eff masks it) and no read (the M-stage
    // read arm is already gated off by amo_commit_live), so it does NOT own the port —
    // and treating it as an owner deadlocks: with the queue full the class atomic waits
    // at the head on asq_stall, holding amo_commit_live=1 for as long as it waits, which
    // would keep the drain from ever getting the port that would free the entry.
    let asq_dr_port_ok: logic = ATOMIC_SQ && !ptw_dc_active && !(amo_commit_live && !asq_class)
        && !m_ren_q && !m_wen_q && !lsr_drive && !replay_drive;
    let asq_dr_start : logic = ATOMIC_SQ && asq_valid_q[0] && sb_empty_eff && asq_dr_st_q == 2'd0;
    let asq_dr_ren   : logic = ATOMIC_SQ && asq_dr_st_q == 2'd1;
    let asq_dr_wen   : logic = ATOMIC_SQ && asq_dr_st_q == 2'd2;
    let asq_dr_go_r  : logic = asq_dr_ren && asq_dr_port_ok; // drives the port this cycle
    let asq_dr_go_w  : logic = asq_dr_wen && asq_dr_port_ok;
    // R3.2c: the drain's read needs the same FETCH/ACCESS handshake the execute-side
    // AMO read has (amo_fetched_q / amo_fetch_hold). The dcache data array is a
    // SYNCHRONOUS read (dcache.veryl DCACHE_SYNC_READ=1): the PA must be presented one
    // cycle before its data is on dcache_rdata, and the hit/miss the stall is built
    // from is itself registered (miss = miss_q). Capturing on the FIRST driving cycle
    // therefore latches whatever the previous access left behind. Until R3.2c the
    // execute-side AMO read had already walked this line through that pipeline and
    // left it owned, so the drain's read was always a warm re-presentation and the
    // missing handshake never showed; with the execute read gone the drain is the
    // first — and only — access to the line, and a stale `old` goes straight into the
    // RMW. asq_dr_rfetch_q is that fetch cycle. Const-gated: at ASQ_NOREAD=0 the drain
    // keeps its proven single-cycle capture, so the =0 arm stays byte-identical.
    var asq_dr_rfetch_q: logic;
    let asq_dr_rdone : logic = asq_dr_go_r && !dcache_stall && (!ASQ_NOREAD || asq_dr_rfetch_q);
    always_ff (clk, rst) {
        if_reset {
            asq_dr_rfetch_q = 1'b0;
        } else {
            asq_dr_rfetch_q = asq_dr_go_r && !dcache_stall;
        }
    }
    let asq_dr_wdone : logic = asq_dr_go_w && !dcache_stall;
    let asq_dr_poison: logic = ATOMIC_SQ && (
        // WR: the line must still be OWNED here. A remote RFO recall can take it away
        // without an i_dcache_inv pulse, so presence (registered tag state, as
        // amo_remote_hit uses it) is the authoritative departure signal. In RD the line
        // may legitimately be absent — acquiring it is what that state is for.
        (asq_dr_st_q == 2'd2 && !dc_amo_present) ||
        asq_dr_st_q != 2'd0
        && ((i_dcache_inv_valid && i_dcache_inv_addr[63:6] == asq_pa_q[0][63:6])
        || (i_dcache_inv2_valid && i_dcache_inv2_addr[63:6] == asq_pa_q[0][63:6])
        || (dc_evict1_v && dc_evict1_addr[63:6] == asq_pa_q[0][63:6])
        || (dc_evict2_v && dc_evict2_addr[63:6] == asq_pa_q[0][63:6])));
    // WR watchdog. The exclusive merge only lands while the line is owned; if it is
    // not, the dcache holds (o_stall). Departures normally announce themselves through
    // asq_dr_poison, but a bounded timeout keeps a missed announcement from wedging the
    // engine forever. It re-enters RD — never "write anyway" — so the `old` behind the
    // value is always freshly read. 128 cycles is twice the dcache pin's own bound.
    var asq_dr_cnt_q  : logic<7>;
    // R3 §7.12: BACKOFF (state 3). A poison sends the engine back to acquire, and with
    // every hart retrying immediately and symmetrically that is a textbook livelock —
    // litmus N=4 ping-pongs the line forever while N=2 squeaks through on the pin's
    // 64-cy defer. Stagger the retry: wait a hart-dependent, doubling interval before
    // re-acquiring, which desynchronises the harts and lets one of them win the line.
    // Purely a forward-progress device — correctness never depends on it (the re-read
    // still happens; only its timing changes).
    var asq_dr_bo_q   : logic<8>;
    let asq_dr_bo_seed: logic<8> = ({6'd0, HART_ID[1:0]} + 8'd1) << 3;
    let asq_dr_wtimeout: logic = ATOMIC_SQ && asq_dr_wen && asq_dr_cnt_q == 7'h7f;
    always_ff (clk, rst) {
        if_reset {
            asq_dr_st_q  = 2'd0;
            asq_dr_old_q = 64'd0;
            asq_dr_cnt_q = 7'd0;
            asq_dr_bo_q  = 8'd0;
        } else if asq_dr_wdone {
            asq_dr_bo_q = 8'd0; // fresh entry starts with no accumulated backoff
            // 🚨 The completed WRITE outranks a same-cycle poison. Once the exclusive
            // merge has landed, the RMW is DONE — it happened atomically under ownership,
            // and a departure signal arriving in that same cycle refers to the line
            // AFTER the write. Letting poison win here sent the FSM back to RD while the
            // entry was already being freed by asq_drain, so it re-read the (now updated)
            // value and applied the operation A SECOND TIME. Under two harts hammering
            // one counter that fires on essentially every write, which is exactly the
            // observed factor of two: litmus test 7's x reached 3999 instead of 2000
            // (§7.6 — max value 2000 at ATOMIC_SQ=0 vs 3999 at =1, one continuous run).
            asq_dr_st_q  = 2'd0;
            asq_dr_cnt_q = 7'd0;
        } else if asq_dr_poison {
            asq_dr_st_q  = 2'd3; // back off, then re-acquire; never write a stale `old`
            asq_dr_cnt_q = 7'd0;
            asq_dr_bo_q  = if asq_dr_bo_q == 8'd0 ? asq_dr_bo_seed : (if asq_dr_bo_q[7] ? asq_dr_bo_q : asq_dr_bo_q << 1);
        } else if asq_dr_st_q == 2'd3 {
            if asq_dr_bo_q == 8'd0 {
                asq_dr_st_q = 2'd1;
            } else {
                asq_dr_bo_q = asq_dr_bo_q - 8'd1;
            }
        } else if asq_dr_start {
            asq_dr_st_q  = 2'd1;
            asq_dr_cnt_q = 7'd0;
        } else if asq_dr_rdone {
            asq_dr_old_q = dcache_rdata;
            asq_dr_st_q  = 2'd2;
            asq_dr_cnt_q = 7'd0;
        } else if asq_dr_wtimeout {
            asq_dr_st_q  = 2'd1;
            asq_dr_cnt_q = 7'd0;
        } else if asq_dr_wen {
            asq_dr_cnt_q = asq_dr_cnt_q + 7'd1;
        }
    }
    // The RMW itself, replicating alu_wrap's M5.A compute on the queued operands:
    // the target sub-word is right-aligned out of the dword by the byte offset, both
    // operands are extended at the access width, and the result is re-shifted into
    // the dword lane with a funct3-derived strobe (atomics are naturally aligned, so
    // there is never a hi-dword span). LR/SC/amocas are not in the class, so only the
    // nine RMW ops appear here.
    let asq_boff  : logic<3>  = asq_pa_q[0][2:0];
    let asq_f3    : logic<3>  = asq_sz_q[0];
    let asq_old_al: logic<64> = asq_dr_old_q >> {asq_boff, 3'b000};
    let asq_old_ze: logic<64> = if asq_f3 == 3'b000 ? {56'd0, asq_old_al[7:0]} : if asq_f3 == 3'b001 ? {48'd0, asq_old_al[15:0]} : if asq_f3 == 3'b010 ? {32'd0, asq_old_al[31:0]} : asq_old_al;
    let asq_old_se: logic<64> = if asq_f3 == 3'b000 ? {asq_old_al[7] repeat 56, asq_old_al[7:0]} : if asq_f3 == 3'b001 ? {asq_old_al[15] repeat 48, asq_old_al[15:0]} : if asq_f3 == 3'b010 ? {asq_old_al[31] repeat 32, asq_old_al[31:0]} : asq_old_al;
    let asq_b_ze  : logic<64> = if asq_f3 == 3'b000 ? {56'd0, asq_src_q[0][7:0]} : if asq_f3 == 3'b001 ? {48'd0, asq_src_q[0][15:0]} : if asq_f3 == 3'b010 ? {32'd0, asq_src_q[0][31:0]} : asq_src_q[0];
    let asq_b_se  : logic<64> = if asq_f3 == 3'b000 ? {asq_src_q[0][7] repeat 56, asq_src_q[0][7:0]} : if asq_f3 == 3'b001 ? {asq_src_q[0][15] repeat 48, asq_src_q[0][15:0]} : if asq_f3 == 3'b010 ? {asq_src_q[0][31] repeat 32, asq_src_q[0][31:0]} : asq_src_q[0];
    let asq_lt    : logic     = $signed(asq_old_se) <: $signed(asq_b_se);
    let asq_ltu   : logic     = asq_old_ze <: asq_b_ze;
    var asq_new_64: logic<64>;
    always_comb {
        case asq_op_q[0] {
            5'b00001: asq_new_64 = asq_b_ze;                          // SWAP
            5'b00000: asq_new_64 = asq_old_ze + asq_b_ze;             // ADD
            5'b00100: asq_new_64 = asq_old_ze ^ asq_b_ze;             // XOR
            5'b01100: asq_new_64 = asq_old_ze & asq_b_ze;             // AND
            5'b01000: asq_new_64 = asq_old_ze | asq_b_ze;             // OR
            5'b10000: asq_new_64 = if asq_lt ? asq_old_se : asq_b_se; // MIN
            5'b10100: asq_new_64 = if asq_lt ? asq_b_se : asq_old_se; // MAX
            5'b11000: asq_new_64 = if asq_ltu ? asq_old_ze : asq_b_ze; // MINU
            5'b11100: asq_new_64 = if asq_ltu ? asq_b_ze : asq_old_ze; // MAXU
            default : asq_new_64 = asq_b_ze;
        }
    }
    let asq_mask_base: logic<8>  = if asq_f3 == 3'b000 ? 8'b0000_0001 : if asq_f3 == 3'b001 ? 8'b0000_0011 : if asq_f3 == 3'b010 ? 8'b0000_1111 : 8'b1111_1111;
    let asq_mask_ext : logic<16> = ({8'd0, asq_mask_base} as 16) << asq_boff;
    let asq_dr_wstrb : logic<8>  = asq_mask_ext[7:0];
    let asq_dr_wdata : logic<64> = asq_new_64 << {asq_boff, 3'b000};

    // rs2 read from the architectural regfile at commit: the atomic is serialized at
    // the ROB head and retires in order, so arch_regs is authoritative for its rs2
    // (exactly the amocas.q commit-operand argument). x0 reads as zero.
    let asq_src_rs2 : logic<5>  = c_instr[24:20];
    let asq_src_arch: logic<64> = if asq_src_rs2 == 5'd0 ? 64'd0 : arch_regs[asq_src_rs2];
    // sb_empty at ALLOC (not just at drain) is the ordering anchor: the entry only
    // enters the queue once every OLDER store is visible, and §7.2's block then keeps
    // every YOUNGER store out until it drains. Together that pins the queued RMW to its
    // program-order position without the drain having to reason about the buffer.
    let asq_alloc: logic = ATOMIC_SQ && amo_commit_live && asq_class && !asq_full && sb_empty_eff;
    let asq_drain: logic = ATOMIC_SQ && asq_dr_wdone;
    // L4 step-2 litmus diagnosis: ASQ drain trace, filtered to ONE line so the volume
    // stays readable in a 3.1M-cycle 2-hart run. TRC_LINE is the line of litmus test 7's
    // shared counter x (PA 0x80007000; 0x80007000 >> 6 = 0x20001C0). MSHR_TRACE-gated.
    let asq_trc_hit: logic = asq_pa_q[0][31:6] == 26'h20001C0;
    always_ff (clk, rst) {
        if_reset {} else if MSHR_TRACE {
            if asq_alloc && ac_pa_q[31:6] == 26'h20001C0 {
                $display("A h=%d [%d] alloc pa=%h", HART_ID, trc_cy_q, ac_pa_q);
            }
            if asq_dr_rdone && asq_trc_hit {
                $display("A h=%d [%d] rd  pa=%h old=%h", HART_ID, trc_cy_q, asq_pa_q[0], dcache_rdata);
            }
            if asq_dr_wdone && asq_trc_hit {
                $display("A h=%d [%d] wr  pa=%h new=%h", HART_ID, trc_cy_q, asq_pa_q[0], asq_dr_wdata);
            }
            if asq_dr_poison && asq_trc_hit {
                $display("A h=%d [%d] POIS pa=%h", HART_ID, trc_cy_q, asq_pa_q[0]);
            }
        }
    }
    always_ff (clk, rst) {
        if_reset {
            for i in 0..ASQ_N {
                asq_valid_q[i] = 1'b0;
                asq_pa_q[i]    = 64'd0;
                asq_src_q[i]   = 64'd0;
                asq_op_q[i]    = 5'd0;
                asq_sz_q[i]    = 3'd0;
                asq_aq_q[i]    = 1'b0;
                asq_rl_q[i]    = 1'b0;
            }
        } else if asq_alloc {
            asq_valid_q[0] = 1'b1;
            asq_pa_q[0]    = ac_pa_q;
            asq_src_q[0]   = asq_src_arch;
            asq_op_q[0]    = asq_amo_f5;
            asq_sz_q[0]    = c_instr[14:12];
            asq_aq_q[0]    = c_instr[26];
            asq_rl_q[0]    = c_instr[25];
        } else if asq_drain {
            asq_valid_q[0] = 1'b0;
        }
    }
    // Dual-path commit write-enable. amo_cwr_en itself is left UNTOUCHED so the =0 arm
    // is the proven single-cycle expression; _eff is what the dcache write port reads
    // (the alu_cdb_eff / c_store_eff_pa idiom). At ATOMIC_SQ=0 amo_cwr_eff ≡ amo_cwr_en
    // (constant selector, synth folds). At 1 the in-cache write still fires for every
    // atomic OUTSIDE the class (!asq_class — LR/SC, result-returning AMOs, amocas,
    // MMIO); the class's write is instead performed by the queue drain.
    // This mux only ever selects during a COMMIT (its consumers sit under the
    // amo_commit_live arm), so the drain does not belong here — R3.2b gives the drain
    // its own arms in the port muxes below, on cycles no commit is happening.
    // (Note for any future edit: a drain term here must be the REQUEST asq_dr_wen, a
    // pure function of the FSM register — routing the completion asq_dr_wdone, which
    // reads dcache_stall, closes write-enable -> dcache_stall -> wdone -> write-enable.
    // Veryl's loop detector is structural and does NOT fold the ATOMIC_SQ=0 constant,
    // so such a loop is a hard build error even while DEAD.)
    // 🚨 The mask MUST be asq_alloc, not asq_class. asq_alloc carries extra conditions
    // (!asq_full, sb_empty); masking on mere class membership meant a class-eligible
    // atomic that could NOT allocate had its in-cache write suppressed and then retired
    // through the normal path with its write nowhere — a silently lost atomic (litmus
    // test 7 slot 1, R3 §7.2). Diverting the write and booking the entry are one
    // decision, so they must be one predicate. When the entry cannot be booked the
    // atomic simply takes today's proven path.
    // ...and !(asq_class && !asq_empty) is the second half of the same rule, found by the
    // §7.3 trace: !asq_alloc alone only holds for the ALLOC CYCLE. A class atomic that has
    // just booked its entry is still at the head the next cycle (its own retire is held by
    // asq_st_block, since the queue it just filled is now non-empty), so amo_commit_live is
    // still 1 while asq_full has become 1 — making asq_alloc 0 again and letting the
    // in-cache write fire for an atomic whose RMW the queue is already going to perform.
    // That is a DOUBLE APPLY, and it is what failed litmus test 7: the trace showed 4000
    // commits for 2000 amoadds, x climbing to 3999 instead of 2000, with the drains
    // themselves perfectly atomic (2000 increments, 1000 per hart, zero duplicate `old`).
    // While an entry is queued, a class atomic at the head must never write in-cache.
    // asq_divert_q is deliberately NOT part of this gate. It is a single latch, not
    // per-instruction: if it is still set when an unrelated atomic reaches the head it
    // silently kills that atomic's write. That is what wedged litmus N=4 — all four harts
    // spinning in barrier_fn's sense loop because a barrier `amoadd.w.aqrl t1` (rd = t1,
    // so NOT in the class, in-cache path) lost its increment. The real double-write is
    // fixed at its source in the M-stage capture (§7.11), so the per-commit `!asq_alloc`
    // is sufficient and safe here.
    // R3.2c adds the matching POSITIVE invariant: an atomic that performed no execute
    // read has no `old` and therefore no valid pre-computed `new` — it must NEVER take
    // the in-cache write path, whatever the reason its allocation did not fire. With
    // that term, "no read" and "the queue performs it" are inseparable, so no path can
    // leak a garbage RMW into the line. (Reachability: alloc's other conditions —
    // !asq_full / sb_empty — already block rob_commit_ack and store_drive, so today
    // this is redundant; it is here so it stays redundant.) Constant 1 at ASQ_NOREAD=0.
    let amo_cwr_eff: logic = if ATOMIC_SQ ? (amo_cwr_en && !asq_alloc && !(ASQ_NOREAD && ac_noread_q)) : amo_cwr_en;
    // ── R3.2b: the drain engine's port arms ───────────────────────────────────
    // asq_dr_go_r/_w are already qualified by asq_dr_port_ok (nobody else owns the
    // port this cycle), so these outermost arms are mutually exclusive with every
    // existing one by construction — at ATOMIC_SQ=0 they are constant 0 and each mux
    // folds to today's expression. The read is an RFO (dmem_amord_m) because the
    // engine needs OWNERSHIP, exactly like the execute-side AMO read; the write is the
    // in-cache exclusive merge (dmem_wexcl_m) of `new` with the funct3 strobe. The
    // entry is only allocated for cacheable atomics (ac_wexcl_q in asq_class), so the
    // merge arm is always the right one — no MMIO write-through case reaches here.
    let dmem_pa_m    : logic<64> = if asq_dr_go_r || asq_dr_go_w ? asq_pa_q[0] : if MEM_PIPE ? (if ptw_dc_active ? ptw_dc_addr : (if amo_commit_live ? ac_pa_q : m_pa_q)) : dmu_dmem_addr;
    // CP M3b: the AMO read must be a SINGLE RFO pulse at its ACCESS cycle, not a
    // sustained access. The AMO is held at the issue port for both its fetch and
    // access cycles, so dc_amo_read (and thus m_ren_q / m_amo_read_q) stays asserted
    // through the access cycle — the unconditional M-stage capture would then re-drive
    // the dcache the cycle AFTER the AMO completes (amo_fetched_q already cleared by
    // the ack), a spurious tail RFO that RE-ACQUIRES the just-departed line and masks
    // a remote recall from the AMO watch (the litmus N=2 amoadd lost-update wedge).
    // Gate the M-stage AMO access off in that tail cycle: m_amo_tail = a registered
    // AMO read that is no longer in its access window (amo_fetched_q dropped). The
    // genuine access cycle (and a sustained miss-fill) keeps amo_fetched_q=1.
    let m_amo_tail   : logic     = m_amo_read_q && !amo_fetched_q;
    // ⚠️ Const-guarded STATEMENT blocks, not `if MEM_PIPE ? … : …` lets. The three
    // MEM_PIPE=0 arms below MENTION lsr_capture, and a ternary keeps that syntactic
    // edge even though MEM_PIPE is 1 — which is enough to close a comb loop once
    // Block T makes lsr_capture depend on lsr_complete: lsr_capture → (dead arm) →
    // i_ren → dcache → o_stall → lsr_read_done → lsr_complete. Only the statement
    // form drops the dead arm (dcache.veryl §13.7 uses the same trick to DCE a read
    // port). At MEM_PIPE=1 these are the identical expressions.
    var dmem_ren_m   : logic;
    var dmem_unc_m   : logic;
    var dmem_lnext_m : logic;
    always_comb {
        if MEM_PIPE {
            dmem_ren_m   = if asq_dr_go_r ? 1'b1 : (if ptw_dc_active ? ptw_dc_ren : (m_ren_q && !m_amo_tail && !amo_commit_live));
            dmem_unc_m   = if ptw_dc_active ? 1'b0 : m_unc_q;
            dmem_lnext_m = if ptw_dc_active ? 1'b0 : m_lnext_q;
        } else {
            dmem_ren_m   = if asq_dr_go_r ? 1'b1 : (dmu_dmem_ren && !lsr_capture);
            dmem_unc_m   = dc_uncached && !lsr_capture;
            dmem_lnext_m = dc_load_next && !dc_uncached && !lsr_capture;
        }
    }
    let dmem_wen_m   : logic     = if asq_dr_go_w ? 1'b1 : if MEM_PIPE ? (if ptw_dc_active ? dmu_ad_wb : (if amo_commit_live ? amo_cwr_eff : m_wen_q)) : dc_i_wen;
    let dmem_wstrb_m : logic<8>  = if asq_dr_go_w ? asq_dr_wstrb : if MEM_PIPE ? (if ptw_dc_active ? (if dmu_ad_wb ? 8'hFF : 8'd0) : (if amo_commit_live ? dmu_dmem_wstrb : m_wstrb_q)) : dmu_dmem_wstrb;
    // CP wall-cut (W2 keystone-unmask): an AMO/SC commit is ALWAYS naturally aligned
    // (a misaligned AMO faults at issue, never reaching amo_commit_live), and amocas.q's
    // hi dword sits in the SAME 64B line as the lo dword (16B-aligned), so a committing
    // atomic NEVER needs the misaligned cross-line hi-dword INVALIDATE strobe. The old
    // `amo_commit_live ? dc_st_wstrb_hi` arm therefore always evaluated to 0 functionally,
    // yet routed the LIVE dc_st_wstrb_hi (= dc_i_wen ? st_wstrb_hi : 0, and dc_i_wen pulls
    // the live MMU acc_fault through sb_vm_ok) into u_dcache.i_wstrb_hi -> the dcache stall
    // cone -> rob_commit_ack -> n_inflight AND the dcache fill -> valid_*. That single live
    // signal WAS the entire 15.300/14.870 commit-store/AMO wall. Tie the atomic arm to a
    // constant 0 (byte-identical: dc_st_wstrb_hi is provably 0 for an aligned atomic) and
    // the wall drops to the rs1_rdy keystone floor (15.300 -> 14.565 ns).
    let dmem_wstrbhi_m: logic<8> = if MEM_PIPE ? (if ptw_dc_active ? 8'd0 : (if amo_commit_live ? 8'd0 : m_wstrbhi_q)) : dc_st_wstrb_hi;
    let dmem_wdata_m : logic<64> = if asq_dr_go_w ? asq_dr_wdata : if MEM_PIPE ? (if ptw_dc_active ? ptw_dc_wdata : (if amo_commit_live ? dmu_dmem_wdata : m_wdata_q)) : dmu_dmem_wdata;
    let dmem_amord_m : logic     = if asq_dr_go_r ? 1'b1 : if MEM_PIPE ? (if ptw_dc_active ? 1'b0 : (m_amo_read_q && amo_fetched_q)) : dc_amo_read;
    let dmem_wexcl_m : logic     = if asq_dr_go_w ? 1'b1 : if MEM_PIPE ? (if ptw_dc_active ? 1'b0 : (if amo_commit_live ? (amo_cwr_eff && ac_wexcl_q) : m_wen_excl_q)) : dc_wen_excl;
    let dmem_addr2_m : logic<64> = if MEM_PIPE ? m_addr2_q    : dc_addr2;
    let dmem_ren2_m  : logic     = if MEM_PIPE ? (if ptw_dc_active ? 1'b0 : m_ren2_q) : dc_ren2;
    // L4 step-2 diagnosis probes: does a replay/Stage-B drive HIJACK the port from an
    // access that is already in flight? asq_dr_port_ok yields to `!m_ren_q && !m_wen_q`
    // and `!ptw_dc_active`; replay_drive/lsr_drive yield to neither. One-shot so the
    // cost is a line each. MSHR_TRACE-gated.
    var pr1_q: logic; var pr2_q: logic; var pr3_q: logic; var pr4_q: logic;
    always_ff (clk, rst) {
        if_reset {
            pr1_q = 1'b0; pr2_q = 1'b0; pr3_q = 1'b0; pr4_q = 1'b0;
        } else if MSHR_TRACE {
            if replay_drive && m_ren_q && !pr1_q {
                pr1_q = 1'b1;
                $display("P1 [%d] replay_drive over registered M-stage READ (m_pa=%h replay_a=%h)", trc_cy_q, m_pa_q, replay_addr);
            }
            if replay_drive && ptw_dc_active && !pr2_q {
                pr2_q = 1'b1;
                $display("P2 [%d] replay_drive during ptw_dc_active", trc_cy_q);
            }
            if lsr_drive && m_ren_q && !pr3_q {
                pr3_q = 1'b1;
                $display("P3 [%d] lsr_drive over registered M-stage READ (m_pa=%h lsr_pa=%h)", trc_cy_q, m_pa_q, lsr_paddr_q);
            }
            if replay_drive && dmem_wen_m && !pr4_q {
                pr4_q = 1'b1;
                $display("P4 [%d] replay_drive during a dcache WRITE", trc_cy_q);
            }
        }
    }
    let dmem_lnext2_m: logic     = if MEM_PIPE ? m_lnext2_q   : dc_load_next2;
    inst u_dcache: dcache (
        clk                                              ,
        rst                                              ,
        // S10.4b: a replay drive overrides the READ address (the write path is
        // unaffected — replay_drive excludes store_drive, so i_wen=0 then).
        // Phase 1 LSU 2-stage: a Stage-B load drive (lsr_drive) overrides the READ
        // address with the LSR's registered PA (the write path is unaffected —
        // lsr_drive excludes store_drive, so i_wen=0 then). lsr_drive and replay_drive
        // are mutually exclusive (the MSHR is disabled for plain loads in step-1).
        i_addr           : if lsr_drive ? lsr_paddr_q : if replay_drive ? replay_addr : dmem_pa_m,
        i_wdata          : dmem_wdata_m                  ,
        // S20: a buffered (sb_vm_ok) store must not ALSO write through i_wen,
        // and a slow store's write may not pass an older buffered store to
        // the SAME dwords (overlap; AMO additionally needs full-empty — its
        // retire ack holds with the same condition, see rob_commit_ack).
        i_wen            : dmem_wen_m                    ,
        i_wen_excl       : dmem_wexcl_m                  , // P9.3: in-cache AMO/SC local merge
        i_wen_excl_q     : dc_wen_excl_q                 , // Zacas amocas.q: also write hi dword
        i_wdata_hi       : cas_q_new_hi                  , // Zacas amocas.q: hi dword (rs2+1)
        // Phase 1 LSU 2-stage: the plain load's Stage-A data read is SUPPRESSED
        // (!lsr_capture) so the dcache stays OUT of the Stage-A cone (cut after
        // translate+PMP); the Stage-B read is driven by lsr_drive instead. The MMU
        // still translates (core_dmem_ren), and PTW PTE reads (dmem_mmu_busy, so
        // lsr_capture=0) pass through unaffected.
        i_ren            : dmem_ren_m || replay_drive || lsr_drive, // execute term (incl. !lsr_capture) folded into dmem_ren_m
        // L4 step-2: the replay drive must present its OWN uncached flag, and a
        // captured load is never uncached (!lsr_unc_q at capture) → tie 0. dc_uncached
        // carries an explicit !replay_drive term (the pre-step-1 design knew the replay
        // must not look uncached), but MEM_PIPE=1 sources this from the REGISTERED
        // m_unc_q, which latched that decision a cycle earlier — when replay_drive was
        // still 0. So the guard misses, and a replay landing one cycle after a
        // non-capturing uncached read (an MMIO load whose lsr_capture was blocked)
        // presents i_uncached=1: the dcache runs uncached_active on the replay address
        // (a spurious bus read) AND rd1_req_nf drops → nf_reroute=0 → the replay leaves
        // the +1 registered read path and delivers off live_hit_rdata, which DCEs to 0
        // at DCACHE_R1_DCE=1. Dead at MEM_PIPE=0 (the live !replay_drive already covers).
        i_uncached       : if lsr_drive ? lsr_unc_q : (dmem_unc_m && !replay_drive), // P9.5: MMIO single-beat read (Stage B uses the latched flag)
        i_wstrb          : dmem_wstrb_m                  ,
        i_wstrb_hi       : dmem_wstrbhi_m                , // B.3: misaligned store → invalidate
        i_load_next      : if lsr_drive ? lsr_dc_load_next : (dmem_lnext_m && !replay_drive), // B.3: misaligned cross-line load fill (Stage B uses the latched span)
        i_amo_read       : dmem_amord_m && !replay_drive , // P9.3: AMO/LR read → ownership (RFO)
        // Phase 8 S5.2: 2nd hit-only read port (dual-issue loads). Tied off in
        // step 1; wired to the slot-1 load AGU/result in steps 2-3.
        i_addr2          : dmem_addr2_m                   ,
        i_ren2           : dmem_ren2_m                    ,
        i_load_next2     : dmem_lnext2_m                  ,
        // Phase C delta-5 (cp_dcache_sync_read_plan §11.2): Stage-A demand-load
        // tag-read. Present the load's translated PA one cycle early (at
        // lsr_capture, the Stage-A latch) so DCACHE_SYNC_READ registers the hit
        // into Stage-B. DCACHE_SYNC_READ=0 → the dcache DCEs this port (byte-id).
        i_addr_r         : dmu_dmem_addr                  ,
        i_ren_r          : lsr_capture                    ,
        i_ren_folded     : lsr_drive                      , // Stage-B folded-load delivery strobe

        // Phase 8 S6/S20: 2nd write port (store-drain), now fed by the
        // committed-store buffer head (oldest entry) instead of the live
        // committing store. o_sdrain_ack pops the entry.
        i_saddr          : sdrain_saddr                   ,
        i_swen           : sdrain_swen                    ,
        // S20.2: near-full buffer (or a head store already blocked on room)
        // escalates the drain over new fill starts.
        i_sdrain_urgent  : sdrain_urgent                  ,
        i_swdata         : sdrain_swdata                  ,
        i_swstrb         : sdrain_swstrb                  ,
        o_sdrain_ack     : dc_sdrain_ack                  ,
        o_rdata2         : dcache_rdata2                  ,
        o_rdata2_next    : dcache_rdata2_next            ,
        o_hit2           : dcache_hit2                    ,
        o_rdata          : dcache_rdata                  ,
        o_rdata_next     : dcache_rdata_next             ,
        o_rdata_next_miss: _                             , // hi_miss path stalls cross-line loads
        o_stall          : dcache_stall                  ,
        o_data_valid     : _                             , // single-hart
        o_miss_valid     : dc_miss_valid                 , // S10.1: MSHR capture trigger
        o_mshr_alloc     : dc_mshr_alloc                 , // N2.2b: an MSHR entry holds a line (State::ALLOC)
        o_stall_why      : dc_stall_why                  , // N2.2b census: the stall's reason classes
        o_miss_offset    : dc_miss_offset                , // L4 step-2: that fill's demanded dword
        o_fill_complete  : dc_fill_complete              ,
        o_fill_rdata     : dc_fill_rdata                 ,
        o_fill_aborted   : dc_fill_aborted               , // S10.3: stale fill → poison+replay
        o_fill_data_ready: dc_fill_ready                 , // S14.2: owner early restart
        o_hit_safe       : dc_hit_safe                   , // S10.4a: pipe-0 hit-under-miss

        o_memr_addr      : dc_mem_addr                   ,
        o_memr_ren       : dc_mem_ren                    ,
        o_memr_rfo       : dc_mem_rfo                    , // P9.2: store fill = RFO (P9.6: muxed below)
        i_fill_excl      : i_dmem_fill_excl              , // P9.2: home grant state
        i_mem_rdata      : i_dmem_rdata                  ,
        o_memw_addr      : dc_memw_addr                  , // S23: write channel
        o_memw_wdata     : dc_mem_wdata                  ,
        o_memw_wstrb     : dc_mem_wstrb                  ,
        o_memw_wen       : dc_mem_wen                    ,
        o_memw_wb        : o_dmemw_wb                    , // P9.2: writeback flag
        i_probe_v        : i_dcache_probe_v              , // P9.2: recall probe
        i_probe_addr     : i_dcache_probe_addr           ,
        i_probe_self     : i_dcache_probe_self           ,
        o_probe_ack      : o_dcache_probe_ack            ,
        i_flush_req      : dc_flush_req                  , // P9.2: fence.i/sfence/satp sweep
        o_flush_done     : dc_flush_done                 ,
        i_inv_valid      : i_dcache_inv_valid            , // M9 SMP: remote-write coherence
        i_inv_addr       : i_dcache_inv_addr             ,
        i_inv2_valid     : i_dcache_inv2_valid           , // P9.2: precise-inv 2nd port
        i_inv2_addr      : i_dcache_inv2_addr            ,
        // P9.2: line-presence checks — LR/SC reservation + SC watch. The core
        // clears/poisons them the moment the line leaves the L1 (under
        // precise invalidation an uncached line gets no remote-write pulse).
        i_chk_addr       : rsv_pa_q                      , // P9.3: PA-based (PIPT)
        o_chk_present    : dc_rsv_present                ,
        i_chk2_addr      : sc_watch_addr_q               , // (holds the PA since P9.3)
        o_chk2_present   : dc_scw_present                ,
        // R3 §7.2: while the atomic-SQ drain is busy it BORROWS this presence port for
        // its own line (see asq_dr_poison — a remote recall can take the line without
        // ever pulsing i_dcache_inv at the core, so inv/evict alone is not a sufficient
        // departure signal; that is exactly how the execute-side watch uses it via
        // amo_remote_hit's !dc_amo_present term). Safe to borrow: while asq_dr_busy no
        // load/AMO may issue and no store may retire, so any other live watch cannot
        // commit a write in that window. Folds to amo_watch_pa_q at ATOMIC_SQ=0.
        i_chk3_addr      : if ATOMIC_SQ && asq_dr_busy ? asq_pa_q[0] : amo_watch_pa_q, // P9.3: AMO watch
        o_chk3_present   : dc_amo_present                ,
        o_evict1_v       : dc_evict1_v                   , // P9.2: line-departure events
        o_evict1_addr    : dc_evict1_addr                , //       (ROB CoRR poison scan)
        o_evict2_v       : dc_evict2_v                   ,
        o_evict2_addr    : dc_evict2_addr                ,
        o_memr_req       : dc_mem_req                    ,
        i_memr_grant     : dc_grant                      , // P9.6: demuxed read-port grant
        o_memw_req       : dc_memw_req                   ,
        i_memw_grant     : i_dmemw_grant                 ,
    );

    // P10 Svadu: the instruction-side A-bit write-back is accepted the cycle the
    // store-drain port acks while the i-side owns it. This pulses imem_mmu's
    // i_ptw_write_done so its WRITE_AD state advances to DONE and the fetch resumes.
    assign imem_aw_ack = imem_aw_grant && dc_sdrain_ack;

    // ---- Phase 12 V1: VU memory-port arbitration (placed here so all the
    // dmem_mmu / dcache / MSHR / store-buffer sources it reads are defined) ----
    // vu_mem_idle: the scalar mem path is quiescent (store buffer drained → a
    // vector load sees current memory; no PTW walk; MMU idle; no queued MSHR
    // replay or outstanding scalar miss; dcache not stalling). The VU then owns
    // the port exclusively and streams elements with blocking accesses (it never
    // uses the MSHR for its own misses). All but dcache_stall are registered;
    // dcache_stall only gates the VU's registered FSM transition → no comb loop.
    assign vu_mem_idle     = sb_empty_eff && !walk_v_q && dmem_mmu_idle && !replay_q && !mshra_v_q && !mshrb_v_q && !dcache_stall;
    assign vu_mem_ready    = !dcache_stall && !dmem_mmu_busy;
    assign vu_mem_fault    = dmem_mmu_fault;
    assign vu_mem_fault_st = dmem_mmu_fault_s;


    // Phase 8 S5.2: slot-1 LOAD completion. A bare-mode slot-1 load completes on
    // pipe-1 only when the 2nd port HITS, not on a redirect (wrong-path), and
    // not during a same-cycle remote invalidate (SMP race). Otherwise the load
    // is held in the IQ (issue2_fire=0 for it → ack2=0) and re-issues later.
    // Non-load slot-1 ops fire unconditionally (= the old issue2_valid).
    // issue2_fire drives BOTH u_alu2.i_issue_valid and iq.i_issue_ack2
    // (forward-ref var). Store ordering is enforced by the slot-1 select's block
    // term + the 2nd forward network (older overlapping stores).
    // Phase 8 S10.2 (hit-under-miss): the !dcache_stall term is gone — a slot-1
    // load that HITS now completes while a slot-0 miss fills. The mid-FILL
    // hazard that term guarded (victim way: old tag, partially-overwritten data)
    // is excluded inside the dcache per-way (fill_busy2), so o_hit2 is
    // fill-safe. Same-address load-load order is naturally kept (if the older
    // load missed this line, the younger can't hit it), and stores never write
    // the arrays mid-fill (IDLE-only write-through + store drain).
    // S27: the S20 buffered-store overlap hold is gone — the slot-1 sb
    // forward layer (sbg*, merged into stld_fwd_*2) overrides the hit data
    // with any pending sb bytes, so an overlapping slot-1 load completes
    // with the correct value (bare mode, PA == agu_addr_iss2).
    let ld2_complete: logic = issue2_is_load && !dmem_vm_on && dcache_hit2 && !redirect_fire && !i_dcache_inv_valid && !i_dcache_inv2_valid && !slot1_load_deny;
    // step-1.5: pipe-1 yields lane 1 to a plain load completing there (lsr_lane1_fire).
    // The slot-1 op is held in the IQ (i_issue_ack2=0) and re-issues next cycle. The
    // load is the older op (issued before any slot-1 op now in flight), so giving it
    // the secondary lane is the cheap displacement (vs blocking primary slot-0).
    assign issue2_fire = iq_issue_valid2 && (!issue2_is_load || ld2_complete) && !lsr_lane1_fire;

    // ============================================================
    // Phase 8 S10: non-blocking load-miss MSHRs. S10.4b: TWO entries (a/b) =
    // miss-under-miss. A plain bare-mode int load that misses is captured and
    // acked OUT of the IQ in one of two ways:
    //   - OWNER capture (mshr_capture_own): the fill starting THIS cycle
    //     (dc_miss_valid) is this load's; the entry owns it (own_q=1) and
    //     latches dc_fill_rdata at DONE.
    //   - QUEUED capture (mshr_capture_que): the load misses (fill-safe
    //     verdict !dc_hit_safe) while the dcache is busy — mid-fill, or its
    //     own miss is still waiting for the bus grant. No fill starts now;
    //     the replay machinery (replay_q / replay_drive at the dcache
    //     instance) injects the address once the dcache is idle: a HIT
    //     completes from o_rdata, a MISS starts its fill (entry claims it).
    // Completion is a DEFERRED writeback (mshr_cdb) on lane 0 at the first
    // FPU-free cycle: PRF write + ROB result + IQ wakeup, like an in-pipe
    // load. Excluded from capture (blocking path): AMO/LR (force-miss
    // protocol), FP loads, Sv39 (PTE reads share the port), cross-dword
    // misaligned loads, loads with forwarded store bytes.
    // Squash safety (the S8.E BUG5 idx-reuse class): each entry clears on
    // redirect_fire (registered, covers every full flush incl. S9 load
    // replay) and on an early redirect when the load is YOUNGER than the
    // branch (modular age compare vs rob_head_idx) — a stale writeback can
    // never land on a re-allocated rob_idx. A same-cycle squash+writeback is
    // mooted inside the ROB (squash runs later in its block); a same-cycle
    // squash+replay_claim is voided (squash branch has priority, the fill
    // goes ownerless and harmlessly caches the line).
    // SMP aborted fill: completes the OWNER with stale data + poisons its ROB
    // entry (mshr_abort_poison) → S9.3 commit replay re-reads fresh data.
    let s10_flip_en: logic = 1'b1;
    // Capturable plain load issuing on slot-0 (shared qualifier).
    // S10.5 (Sv39 extension): !dmem_vm_on is GONE — a TLB-hit Sv39 load
    // captures like a bare one. By that point dmu_dmem_addr is the translated
    // PA (ptw_valid), so the MSHR/fill/replay all carry a PA and are immune to
    // later satp/sfence changes (translation happens at issue, as it always
    // did; an OLDER captured load also always completes before a younger
    // csrw-satp/sfence can commit, by in-order commit). TLB-miss loads walk
    // first (dmem_mmu_busy gates this term; PTE-read misses can't capture for
    // the same reason). !dmem_mmu_fault: a faulting translation never reads
    // the dcache (the MMU drops o_dmem_ren), so it must trap via the normal
    // CDB path, not capture. Store ordering under VM is STRICTER than bare:
    // the S9 conservative block holds every load while ANY older store is
    // in the ROB, so a captured VM load has no older in-flight stores at all
    // (this is also why the LQ-record PA-vs-VA unit mismatch is benign — the
    // violation scan structurally cannot fire under VM, and fwd_mask is
    // always 0 there).
    // PMP (Smpmp): exclude a PMP-denied load (dmem_mmu_acc_fault), like a page-
    // faulting load (dmem_mmu_fault) — it commits its fault and must never be
    // captured for replay (its replay would drive the protected line into cache).
    // Phase 1 LSU 2-stage step-1: every plain load now flows through the LSR, which
    // BLOCKS on a Stage-B miss (lsr_drive re-reads each cycle, completing when the
    // fill lands). So the non-blocking MSHR capture for plain loads is disabled —
    // the whole MSHR/replay path (mshr_cdb, replay_q) goes dead. Non-blocking
    // MSHR-from-Stage-B is step-2. (AMO/LR never used mshr_plain_load.)
    let mshr_plain_load: logic = 1'b0;
    let _unused_mshr_pl: logic = iq_iss_is_load && dc_load_next && (stld_fwd_mask == 8'd0); // keep deps referenced
    let mshr_free_ok    : logic = !mshra_v_q || !mshrb_v_q;
    let mshr_alloc_a    : logic = !mshra_v_q;
    // !replay_q on both: on a replay cycle the dcache port (and so
    // dc_miss_valid / dc_hit_safe) belongs to the replayed entry, not to an
    // issuing load (which iss_dc_ok holds anyway).
    let mshr_capture_own: logic = s10_flip_en && !replay_q && dc_miss_valid && mshr_plain_load && mshr_free_ok;
    let mshr_capture_que: logic = s10_flip_en && !replay_q && !dc_miss_valid && dcache_stall && !dc_hit_safe && !i_dcache_inv_valid && !i_dcache_inv2_valid && mshr_plain_load && mshr_free_ok;
    assign mshr_capture = mshr_capture_own || mshr_capture_que;

    // ------------------------------------------------------------------
    // Phase 1 LSU 2-stage STEP-2 (L4): non-blocking MSHR-from-Stage-B.
    //
    // step-1 (88b7735) routed every plain load through the LSR, which BLOCKS on a
    // Stage-B miss, and disabled the issue-side MSHR capture (mshr_plain_load=0)
    // with "non-blocking MSHR-from-Stage-B is step-2". It was never built. The L4
    // census prices it: the incumbent load sits in the single LSR slot driving a
    // stalling dcache for 1,043,579 cy = 7.14 % of the N=1 boot, and every younger
    // load is behind it.
    //
    // This hands the missing load off to the (fully built, currently inert) 2-entry
    // MSHR and frees the LSR the same cycle, so the next load can capture. The
    // receiving machinery is unchanged: owner/queued capture, the replay engine,
    // the deferred mshr_cdb writeback, age-based squash and the SMP aborted-fill
    // poison all already exist and were live before step-1.
    //
    // Eligibility mirrors the original issue-side qualifier, re-expressed against
    // the LSR's LATCHED state (every field the entry write needs has an lsr_*_q
    // equivalent): not faulting (a fault completes from the LSR, never reads),
    // not an FP load (mshr_cdb is lane-0 int), not uncached (side effects must not
    // be replayed), not a cross-dword misaligned span (the entry holds one dword),
    // and no forwarded store bytes (stld_fwd_mask is the Stage-B mask — the fill
    // data would predate the store).
    //
    // Kept SEPARATE from mshr_capture on purpose: mshr_capture also drives
    // iq_issue_ack, and a Stage-B handoff must not ack whatever unrelated op is
    // sitting at the IQ head. It DOES drive the ROB LQ-record port — the load
    // leaves the pipe without a normal CDB writeback, so its address has to be
    // recorded for the disambiguation scan exactly like an issue-side capture.
    //
    // DEAD at 0: mshr_cap_b folds away, every _eff selector collapses to today's
    // term, and the LSR clear arm disappears → bit-identical.
    // ------------------------------------------------------------------
    const LSR_MSHR_B: bit = 1;
    // Entry-write feeds: issue-side capture keeps its live sources, a Stage-B
    // handoff supplies the latched LSR ones.
    assign mshr_alloc_fire = mshr_capture || mshr_cap_b;
    assign mshr_alloc_rob  = if mshr_cap_b ? lsr_rob_idx_q : iq_iss_rob_idx;
    assign mshr_alloc_f3   = if mshr_cap_b ? lsr_funct3_q : iq_issue_op.base.mem_funct3;
    let mshr_alloc_own  : logic            = mshr_capture_own || mshr_cap_b_own;
    let mshr_alloc_pdst : logic<PRF_INT_W> = if mshr_cap_b ? lsr_pdst_q : iq_iss_rd_pdst;
    let mshr_alloc_hasrd: logic            = if mshr_cap_b ? lsr_has_rd_q : iq_issue_op.base.has_rd;
    let mshr_alloc_addr : logic<64>        = if mshr_cap_b ? lsr_paddr_q : dmu_dmem_addr;
    // rob LQ-record / abort-poison port feeds (vars declared near mshr_cdb).
    assign mshr_rec_addr     = if mshr_cap_b ? lsr_paddr_q : dmu_dmem_addr;
    // S20R: a committed store buffered DURING the fill (or before a queued
    // replay's hit) overlaps the captured load — the fill/dcache data
    // predates the store and the issue-time sb scan can no longer help, so
    // poison the completion like an aborted fill (S9.3 commit replay
    // re-executes the load through the normal, sb-checked path).
    var sb_mshra_ovl: logic;
    var sb_mshrb_ovl: logic;
    let sb_ma_dw: logic<9> = mshra_addr_q[11:3];
    let sb_mb_dw: logic<9> = mshrb_addr_q[11:3];
    always_comb {
        sb_mshra_ovl = 1'b0;
        sb_mshrb_ovl = 1'b0;
        for i in 0..SB_N {
            if (i as 4) <: sb_cnt {
                if sb_line[i][5:0] == sb_ma_dw[8:3] && sb_lmap[i][sb_ma_dw[2:0]] {
                    sb_mshra_ovl = 1'b1;
                }
                if sb_line[i][5:0] == sb_mb_dw[8:3] && sb_lmap[i][sb_mb_dw[2:0]] {
                    sb_mshrb_ovl = 1'b1;
                }
            }
        }
        // S24.1: a store entering the buffer THIS cycle (sb_push) is not in the
        // registered sb_addr scan yet — an MSHR writeback (or replay hit) firing
        // this same cycle would return pre-store data unpoisoned (observed on
        // a Verilator N2 boot: an LD completed 0 from a fill while the committed
        // store of the same dword pushed into the sb). Fold the pushing entry
        // in. sb_push fans in from the MMU translate (sb_vm_ok), but every
        // consumer of these ovl signals is edge-triggered or completion-side,
        // never the dcache i_ren fan-in, so this closes no comb loop.
        if sb_push && sb_pa[11:3] == mshra_addr_q[11:3] {
            sb_mshra_ovl = 1'b1;
        }
        if sb_push && sb_pa[11:3] == mshrb_addr_q[11:3] {
            sb_mshrb_ovl = 1'b1;
        }
    }
    // S24.1: the sb-overlap arm also poisons a DONE entry (fill data latched,
    // waiting for a CDB writeback slot). The old form required own_q &&
    // !done_q, but fill_done clears own_q, so a store buffered during the
    // done-wait (or pushing the same cycle the writeback fires) retired the
    // pre-store fill data unpoisoned. A QUEUED (not own, not done) entry needs
    // no overlap poison: it has no data yet, its replay-hit completion is held
    // by replay_sb_ovl until the store drains, and a later own-fill goes
    // through the filling-window arm. Per-entry poison ports: one entry's fill
    // abort and the other's writeback-cycle overlap can coincide.
    assign mshr_abort_poison  = mshra_v_q && ((mshra_own_q && !mshra_done_q && (dc_fill_aborted || sb_mshra_ovl)) || (mshra_done_q && sb_mshra_ovl));
    assign mshr_abort_poison2 = mshrb_v_q && ((mshrb_own_q && !mshrb_done_q && (dc_fill_aborted || sb_mshrb_ovl)) || (mshrb_done_q && sb_mshrb_ovl));
    assign mshr_poison_idx    = mshra_rob_idx_q;
    assign mshr_poison_idx2   = mshrb_rob_idx_q;
    // Phase 8 S10.4a: pipe-0 hit-under-miss qualifier (see iss_dc_ok). The
    // forwarded-bytes merge (stld_fwd_*) works on a hit completion exactly as
    // it does outside a fill, so fwd_mask!=0 loads are NOT excluded here (only
    // the MSHR capture excludes them — a fill alone is not their result).
    // !i_dcache_inv_valid mirrors ld2_complete (same-cycle remote-inv race).
    // S10.5: !dmem_vm_on gone here too — a TLB-hit Sv39 load (busy=0, i_addr
    // already the PA) completes from a fill-safe dcache hit mid-fill exactly
    // like a bare one; the alu CDB fault side-band still applies if the
    // translation hit a permission fault (then the MMU drops o_dmem_ren, so
    // dc_hit_safe=0 and this term cannot fire anyway — !dmem_mmu_fault makes
    // it explicit).
    assign ld0_hum_ok = iq_iss_is_load && !iq_iss_is_amo && !iq_iss_fp_ld && !dmem_mmu_fault && !dc_load_next && dc_hit_safe && !redirect_fire && !i_dcache_inv_valid && !i_dcache_inv2_valid;
    // Per-entry squash (see header comment).
    let mshra_age    : logic<ROB_IDX_W> = mshra_rob_idx_q - rob_head_idx;
    let mshrb_age    : logic<ROB_IDX_W> = mshrb_rob_idx_q - rob_head_idx;
    let s10_early_age: logic<ROB_IDX_W> = early_redir_idx_q - rob_head_idx;
    let mshra_squashed: logic = mshra_v_q && (redirect_fire || (early_redir_fire_q && (mshra_age >: s10_early_age)));
    let mshrb_squashed: logic = mshrb_v_q && (redirect_fire || (early_redir_fire_q && (mshrb_age >: s10_early_age)));

    // ============================================================
    // Phase 1 LSU 2-stage: LSR completion + squash + state.
    // ============================================================
    // Stage-B read landed: a cached hit, an uncached MMIO bus-read return, or a
    // misaligned cross-line fill — all signalled by dcache_stall dropping while the
    // LSR drives the port (mirrors the single-cycle iss_dc_ok = !dcache_stall path,
    // minus the now-moot hit-under-miss / acc-fault terms: block-on-issue means the
    // LSR is the only in-flight plain load, so dcache_stall is THIS read's verdict).
    let lsr_read_done: logic = lsr_drive && !dcache_stall;
    let lsr_age      : logic<ROB_IDX_W> = lsr_rob_idx_q - rob_head_idx;
    // Wrong-path squash (mirror the MSHR): a full precise redirect flushes every
    // in-flight op; an early partial redirect squashes only ops YOUNGER than the
    // resolved branch (age > the branch's age) — so a correct-path older load that a
    // younger pipe-1 branch mispredicts is NOT squashed.
    let lsr_squashed : logic = lsr_v_q && (redirect_fire || (early_redir_fire_q && (lsr_age >: s10_early_age)));
    // step-2 (L4) Stage-B MSHR handoff — see the LSR_MSHR_B block by the MSHR.
    // Placed here because it needs lsr_squashed: a wrong-path load must never be
    // captured, or its deferred writeback lands on a re-allocated rob_idx (the
    // S8.E BUG5 class the MSHR's own squash arms guard against).
    // S27 (added AFTER the MSHR path went dead) stopped blocking a plain load on a
    // committed-store overlap and instead has the sb FORWARD LAYER (sbf*/sbg*)
    // patch the pending bytes in on the Stage-B data path. A captured load never
    // takes that path — it completes from raw dcache_rdata / dc_fill_rdata via
    // mshr_cdb — so those bytes would be silently lost. stld_fwd_mask covers only
    // the ROB-scan (uncommitted-store) forward, a different layer. sb_ld_ovl is
    // built from the ISSUE address (agu_addr_iss), so Stage B needs its own compare
    // against the LSR's VA; single-dword, since cross-dword spans cannot capture.
    let lsr_sb_dw0: logic<9> = lsr_vaddr_q[11:3];
    var lsr_sb_ovl: logic;
    always_comb {
        lsr_sb_ovl = 1'b0;
        for i in 0..SB_N {
            if (i as 4) <: sb_cnt {
                if sb_line[i][5:0] == lsr_sb_dw0[8:3] && sb_lmap[i][lsr_sb_dw0[2:0]] {
                    lsr_sb_ovl = 1'b1;
                }
            }
        }
    }
    // Split in two (logic-identical) so the Block N census can see a handoff declined
    // ONLY because the 2-entry queue was full — the population an N-deep queue serves.
    let lsr_mshr_elig: logic = LSR_MSHR_B && lsr_v_q && !lsr_squashed && !lsr_fault
        && !lsr_fp_ld_q && !lsr_unc_q && !lsr_dc_load_next && stld_fwd_mask == 8'd0
        && !lsr_sb_ovl;
    let lsr_mshr_ok : logic = lsr_mshr_elig && mshr_free_ok;
    // Bisect arm (L4 step-2 diagnosis). The two capture arms wake different amounts
    // of machinery: _own only needs the entry to latch dc_fill_rdata at DONE, while
    // _que is the one that brings the REPLAY ENGINE back to life (a queued entry
    // has own_q=0, which is exactly what drives mshra_queued → replay_q →
    // replay_drive). Turning _que off leaves the replay path dead, so a pass at
    // QUE=0 pins the bug on the replay engine and a fail pins it on the handoff.
    const LSR_MSHR_B_QUE: bit = 1;
    // `dcache_stall && !dc_miss_valid && !dc_hit_safe` covers TWO different situations
    // and only one of them is safe to hand off:
    //   (a) the dcache is filling SOMEONE ELSE's line (fill_busy_q). Our load has no
    //       bus request outstanding — lo_miss carries `state == IDLE`, so load_sel_raw
    //       is 0 throughout — and nothing is lost by freeing the LSR.
    //   (b) our OWN miss is waiting for the bus grant. Here load_sel_raw IS 1 and
    //       o_memr_req is asserted; the FSM stays IDLE and, as the o_miss_valid comment
    //       in dcache.veryl spells out, "needs i_ren held to keep requesting the bus, so
    //       a core that captured the load into an MSHR on the raw miss and dropped i_ren
    //       would strand the fill". The Stage-B handoff frees the LSR, i_ren drops, and
    //       load_sel_q follows it down one cycle later — withdrawing a request mid
    //       arbitration.
    // QUE_SCOPE names WHICH of those `dcache_stall` cycles may hand off:
    //   0 = FILL only — case (a). The original L4 step-2 arm.
    //   1 = FILL, or an MSHR entry holding OUR line (State::ALLOC) — case (a) + the
    //       precise case (b). This is what N2.2a's ALLOC state was built to enable:
    //       the entry keeps requesting the bus after i_ren drops, so nothing is lost.
    //   2 = any stall. The blanket arm; it also hands off on stall cycles where the
    //       load's miss has NOT been recorded ANYWHERE (dhit_miss / nf_gap_stall — the
    //       load's first Stage-B cycle, before the D-cache has even evaluated its live
    //       miss — plus write_wait_grant, DONE, inv_*, uncached_active).
    // Observed at 2 (Block N, cp_mshr_mlp_plan.md §14.9): litmus N=2 test 7 — the failure
    // this const was introduced for — PASSES (cy=003037c0) where it used to retire 0 from a
    // fill, which is direct evidence that ALLOC closes case (b). rv64ui-ma_data then fails
    // at subtest 126 (`sw 62(s0)` then `lbu 64(s0)`, both crossing a line), a DIFFERENT bug
    // that lives in the rest of scope 2 — the dhit/inv/gap cycles, where the load's miss has
    // not been recorded anywhere yet.
    // Observed at 1 (§14.10): the suite passes 252/0, so the precise case-(b) handoff IS safe
    // — and the N=1 boot is BIT-IDENTICAL (cy=00ba9d70, instret=10421567), because the
    // D-cache enters State::ALLOC for **14 cycles** in the whole boot. A load's fill request
    // is granted the cycle it is made, so case (b) is an empty population and this whole
    // restriction was guarding nothing. Left at 0 = the shipped arm; 1 and 2 are kept as
    // measured arms, not candidates.
    const LSR_MSHR_B_QUE_SCOPE: u32 = 0;
    // The D-cache has RECORDED this load's miss in an MSHR entry. `dc_mem_addr` is the
    // entry's line whenever dc_mshr_alloc is high (ALLOC drives the read channel from the
    // entry and excludes `filling` / `uncached_active`), so this is an attribution check of
    // the same shape as mshr_cap_b_own's, one level coarser (line, not dword: any load on
    // that line is served by that entry's fill).
    let dc_alloc_ours: logic = dc_mshr_alloc && lsr_paddr_q[63:6] == dc_mem_addr[63:6];
    let que_scope_ok : logic = fill_busy_q || (LSR_MSHR_B_QUE_SCOPE >= 1 && dc_alloc_ours)
        || (LSR_MSHR_B_QUE_SCOPE >= 2);
    let mshr_cap_b_que_raw: logic = LSR_MSHR_B_QUE && lsr_mshr_ok && lsr_drive && !dc_miss_valid && dcache_stall
        && !dc_hit_safe && !i_dcache_inv_valid && !i_dcache_inv2_valid
        && que_scope_ok;
    // ── L4 step-2 budget bisection (DIAGNOSIS SCAFFOLD, not a ship candidate) ──
    // Allow only the first CAPB_BUDGET queued handoffs, then hold the arm off. Runs
    // with budget >= N take events 0..N-1 identically (the trajectory only diverges at
    // the first suppressed event), so a PASS at N and a FAIL at N+1 names event #N as
    // the culprit AND gives a perfectly matched control pair. Set to all-ones for the
    // unrestricted arm.
    // CAPB_BISECT is the DEAD gate: at 0 capb_ok const-folds to 1 and the two registers
    // are reset-only → DCE, so none of this reaches the shipped netlist. (Leaving the
    // comparator live would put a real 32-bit counter in the ship path — `capb_cnt_q <:
    // 32'hffff_ffff` is not constant-foldable even though it is always true in practice.)
    const CAPB_BISECT: bit         = 0;
    const CAPB_BUDGET: logic<32>   = 32'hffffffff;
    var capb_cnt_q  : logic<32>;
    var capb_shown_q: logic    ;
    let capb_ok    : logic = !CAPB_BISECT || capb_cnt_q <: CAPB_BUDGET;
    let capb_reject: logic = CAPB_BISECT && mshr_cap_b_que_raw && !capb_ok && !capb_shown_q;
    always_ff (clk, rst) {
        if_reset {
            capb_cnt_q   = '0;
            capb_shown_q = 1'b0;
        } else if CAPB_BISECT {
            if mshr_cap_b_que_raw && capb_ok {
                capb_cnt_q = capb_cnt_q + 32'd1;
            }
            if capb_reject {
                capb_shown_q = 1'b1;
                $display("capb REJECT #%d pc=%h va=%h pa=%h f3=%d rob=%d replayq=%d", capb_cnt_q, lsr_pc_q, lsr_vaddr_q, lsr_paddr_q, lsr_funct3_q, lsr_rob_idx_q, replay_q);
            }
        }
    }
    let mshr_cap_b_que: logic = mshr_cap_b_que_raw && capb_ok;
    // Same fill-attribution check as replay_claim (see dc_fill_line there): a Stage-B
    // drive is continuous, so the deciding cycle is normally its own — but the LSR can
    // be handed the port back mid-sequence, so verify rather than infer. A mismatch
    // declines the handoff and the load simply stays in the LSR (= the =0 behaviour).
    assign mshr_cap_b_own = lsr_mshr_ok && lsr_drive && dc_miss_valid && lsr_paddr_q[63:3] == {dc_mem_addr[63:6], dc_miss_offset};
    assign mshr_cap_b     = mshr_cap_b_own || mshr_cap_b_que;
    // step-1.5 lane select. A non-fault, non-FP load goes to LANE 1 (pipe-1 yields,
    // so it is always available → no yield term). A faulting / FP load stays on
    // LANE 0 (only lane 0 carries fault side-bands + the FP-regfile route) and must
    // yield to the lane-0 occupants above lsu_cdb in the mux (fpu/mshr/int_div/alu).
    // Reads only registers (lsr_fault_*/lsr_fp_ld_q) → no comb loop with pipe-1.
    assign lsr_to_lane1 = !lsr_fault_pg_q && !lsr_fault_acc_q && !lsr_fp_ld_q;
    let lsr_lane0_free: logic = !fpu_cdb.valid && !mshr_cdb.valid && !int_div_cdb.valid && !alu_cdb_eff.valid;
    // Complete: a faulting load needs no read (delivers the latched fault); else the
    // Stage-B read landed. Suppressed on a squash (the writeback would hit a flushed
    // ROB entry). The read keeps driving continuously while waiting for the lane, so
    // an uncached read does not re-trigger its side effect on the re-drive.
    assign lsr_complete = lsr_v_q && (lsr_fault || lsr_read_done) && !lsr_squashed && (if lsr_to_lane1 ? 1'b1 : lsr_lane0_free);
    assign lsr_lane1_fire = lsr_complete && lsr_to_lane1;
    // Block T diagnosis: the forwardable-store bitmap as a packed word, so one
    // $display shows whether the resolving store's ROB entry is even a candidate.
    var ls_fwd_pack: logic<32>;
    always_comb {
        for i in 0..32 {
            ls_fwd_pack[i] = ls_fwd[i];
        }
    }
    // ── Block T diagnosis: attribute the value a watched load completes with ──────
    // Placed here (not with B2B_TRACE up at the commit traces) so the committed-SB
    // state is in scope: sbf_fwd_mask / sb_cnt / lsr_sb_ovl are all defined above
    // this point. The matched pair for pc=8001592a showed the =0 arm completing off
    // fwdmask=ff while the dcache dword is 0 — so the question is which of the two
    // nets goes silent at =1. Print-only, DEAD at B2B_TRACE=0.
    always_ff (clk, rst) {
        if_reset {} else if B2B_TRACE {
            if lsr_complete && lsr_pc_q == B2B_WATCH_PC {
                $display("B2BLOAD cy=%d pa=%h fwd=%h rob=%h sb=%h dc=%h sbcnt=%d rob_idx=%d head=%d ldage=%d fwdpack=%h", trc_cy_q, lsr_paddr_q, stld_fwd_mask, sf_rob_mask, sbf_fwd_mask, dcache_rdata, sb_cnt, lsr_rob_idx_q, rob_head_idx, stld_fwd_age, ls_fwd_pack);
                $display("B2BLOAD  ent[%d] fwd=%b addr=%h f3=%d data=%h", B2B_WATCH_ROB, ls_fwd[B2B_WATCH_ROB], ls_addr[B2B_WATCH_ROB], ls_f3[B2B_WATCH_ROB], ls_data[B2B_WATCH_ROB]);
            }
            // The other half of the timeline: every STORE that resolves its address
            // into the watched dword. Ordering the two prints answers the question
            // outright — a store resolving AFTER the load executed must poison it
            // (so a silent scan is the bug), while one resolving BEFORE must have
            // been in the sf* forward net (so a silent net is the bug).
            if cdb.valid && cdb.is_store && cdb.store_addr[63:3] == B2B_WATCH_VA[63:3] {
                $display("B2BSTORE cy=%d va=%h rob=%d f3=%d data=%h", trc_cy_q, cdb.store_addr, cdb.rob_idx, cdb.store_funct3, cdb.store_data);
            }
            // …and the COMMIT side: when does a store to the watched dword actually
            // leave the machine, and by which path? Under VM `fast_store` is 0, so a
            // kernel store never enters the committed store buffer — it drains
            // through the M-stage write instead, and the window between commit and
            // that write is invisible to every forward net.
            // Cycle-by-cycle window across the failure, so the SB drain and the
            // load's Stage-A read can be lined up against each other.
            if trc_cy_q >= B2B_WIN_LO && trc_cy_q <= B2B_WIN_HI {
                $display("B2BWIN cy=%d sbcnt=%d swen=%b saddr=%h sack=%b wen=%b wpa=%h cap=%b drv=%b v=%b lsrpa=%h stall=%b", trc_cy_q, sb_cnt, sdrain_swen, sdrain_saddr, dc_sdrain_ack, dmem_wen_m, dmem_pa_m, lsr_capture, lsr_drive, lsr_v_q, lsr_paddr_q, dcache_stall);
            }
            if commit_store_fire && c_store_eff_pa[63:3] == B2B_WATCH_PA[63:3] {
                $display("B2BCMT cy=%d pa=%h fast=%b sbpush=%b stdrive=%b dcstall=%b ack=%b mwr=%b", trc_cy_q, c_store_eff_pa, fast_store, sb_push, store_drive, dcache_stall, rob_commit_ack, m_store_wr_busy);
            }
            if lq_rec1_valid && alu_cdb2.store_addr[63:3] == B2B_WATCH_VA[63:3] {
                $display("B2BREC cy=%d va=%h rob=%d pav=%b", trc_cy_q, alu_cdb2.store_addr, alu_cdb2.rob_idx, lq_rec1_pa_v);
            }
        }
    }
    // ── Block T: back-to-back LSR capture (2026-08-17) ──────────────────────────
    // The LSR is a SINGLE entry and lsr_capture required !lsr_v_q, so the next load
    // could only latch the cycle AFTER the incumbent left — one load every TWO
    // cycles even when every load hits in the L1D. The post-Block-W re-census reads
    // that bubble as 705,559 cy = 5.2 % of the N=1 boot, under a bucket labelled
    // "waiting for writeback lane 0". That label went stale at L4 step-1.5: with
    // lsr_to_lane1 a non-fault non-FP load takes lane 1 UNCONDITIONALLY (the lane
    // term is a literal 1), so those cycles are not port contention at all — they
    // are the turnaround of a block-on-issue slot.
    //
    // The datapath is already pipelined for the fix. At DCACHE_SYNC_READ the SRAM
    // read happens at STAGE A (i_ren_r → rd1_index → rd1_data_*/rt1_*) and Stage B
    // only DELIVERS off the registered dhit_*_q, so the incumbent needs no dcache
    // resource on its completing cycle: a same-cycle Stage-A read for the NEW load
    // and the incumbent's Stage-B delivery are disjoint. Nothing tested that
    // combination before, because lsr_capture (!lsr_v_q) and lsr_drive (lsr_v_q)
    // were mutually exclusive by construction.
    //
    // The completion condition is self-guarding: lsr_b2b_free is lsr_complete, i.e.
    // "the incumbent is done THIS cycle". Any reason it would still need the port
    // (an nf read that has not won, a fill, a cross-line phase) holds dcache_stall,
    // which clears lsr_read_done → lsr_complete → the bypass simply does not fire.
    //
    // No comb loop: lsr_b2b_free reaches the dcache only through i_ren_r/i_addr_r
    // (Stage-A tag+data read), and every consumer of those lands in a flop
    // (dhit_*_q, rt1_*, rd1_data_*, nf_won_q) — o_stall has no path back.
    // The always_ff above already ranks lsr_capture ABOVE mshr_cap_b/lsr_complete,
    // so the entry is simply overwritten and no free-then-refill sequencing is
    // needed. DEAD at 0: lsr_b2b_free const-folds to 0 → lsr_capture and
    // core_dmem_ren revert to their !lsr_v_q form, byte-identical.
    const LSR_B2B     : bit = 1; // capture in the cycle the incumbent completes
    // The MSHR Stage-B handoff (L4 step-2) frees the slot the same way and pays the
    // same turnaround. Separate arm: it hands the load to an MSHR entry mid-miss, a
    // narrower and rarer path than the completion above.
    const LSR_B2B_MSHR: bit = 0;
    // ⚠️ Written as a const-guarded STATEMENT block, not `LSR_B2B && lsr_complete`.
    // A ternary/`&&` form keeps the syntactic edge to lsr_complete even at 0, and
    // that edge alone closes a comb loop the simulator reports at DEAD: this signal
    // reaches core_dmem_ren -> dmem_mmu's ptw_req -> dmu_dmem_addr, which the
    // MEM_PIPE=0 / SB_PA_REG=0 arms of dmem_pa_m and c_store_eff_pa still MENTION,
    // and those reach store_drive -> lsr_drive -> lsr_complete. Only the statement
    // form drops the dead arm (the same trick dcache.veryl §13.7 uses to DCE a read
    // port). 230/252 failed with `involved in loop` before this was written this way.
    always_comb {
        lsr_b2b_ok = 1'b0;
        if LSR_B2B {
            if lsr_v_q && !lsr_fault && !lsr_unc_q {
                lsr_b2b_ok = 1'b1;
            }
        }
        // The dmem port is SHARED. lsr_b2b_ok says the incumbent is eligible; it does
        // NOT say the request on the port this cycle is the speculative load. Both the
        // extra translate and (critically) i_no_walk must be qualified by the requester,
        // or i_no_walk holds off a COMMITTING STORE's walk — and the store cannot
        // retire, the LSR cannot drain, and the machine wedges (measured: LSR residency
        // 42,115,934 of a 45 M-cycle run, instret 3.5 M, boot never finishes).
        lsr_b2b_spec = 1'b0;
        if LSR_B2B {
            if lsr_b2b_ok && iq_issue_valid && iss_is_plain_load && !core_dmem_wen
                && !mmu_walk_inflight && !sc_walk_drive && !vu_mem_active {
                lsr_b2b_spec = 1'b1;
            }
        }
        // ⚠️ LSR_B2B_SBQ is CORRECTNESS, not tuning. A committed store drains out of
        // the store buffer through the dcache's SECOND write port, and the drain ack
        // pops the entry — from that cycle the store is in NO forward net (sb_cnt has
        // dropped) while the array write is only just landing. The load's Stage-A read
        // is where DCACHE_SYNC_READ actually reads the data, and b2b moves it one
        // cycle earlier, straight into that collision. Measured: the drain of line
        // 80cac1c0 is acked on the exact cycle the load to 80cac1e8 captures, and the
        // load completes with the pre-drain 0 -> a NULL-pointer kernel oops.
        // The old turnaround bubble was the accidental protection.
        // Holding b2b off for the whole non-empty-SB window restores the healthy
        // trajectory exactly (hart1 reaches the kernel; trap0/trap1 match the baseline
        // at the same cycle). ⚠️ Restricting it to the COLLIDING LINE is NOT enough —
        // measured: the same oops returns 8,590 cycles later. The window is wider than
        // the head entry's line, so the conservative form is what this arm ships.
        // Loop-free: sdrain_swen is register-derived (imem_aw_grant || !sb_empty).
        // 🏁 SUBSUMED, AND NOW 0 (Block L1.c, 2026-08-19). Everything above describes the
        // WINDOW correctly and the DOOR wrongly: this guard closed the b2b capture path
        // into the store-drain window, but the window is reachable from the ordinary
        // capture path too (L1.a's STORE_NOPORT walked straight through it and wedged the
        // N=2 boot). SB_DRAIN_SHADOW closes the window itself — the drained entry stays in
        // the sbf* forward net for the one cycle a 2-stage load needs, address-exact — so
        // this gate has nothing left to protect. Dropping it is worth +0.16 pp at N=1
        // (12,390,000 -> 12,370,000) and +0.28 pp at N=2, consistent with the 0.23 pp
        // yardstick Block T measured for it. Kept as a fold-away arm, not deleted, so the
        // revert path survives if the shadow ever needs to be turned off.
        // ⚠️ This also retires Block T's "the window is wider than the head entry's line"
        // conclusion: the shadow needs no width estimate at all. Do not propagate the wide
        // -window reading — the likely explanation is that the same-LINE test compared the
        // incumbent's lsr_paddr_q, not the capturing load's address (plan Part II §9).
        const LSR_B2B_SBQ: bit = 0;
        lsr_b2b_free = 1'b0;
        if LSR_B2B {
            if lsr_b2b_spec && lsr_complete && (!LSR_B2B_SBQ || !sdrain_swen) {
                lsr_b2b_free = 1'b1;
            }
        }
        if LSR_B2B_MSHR {
            if lsr_b2b_spec && mshr_cap_b {
                lsr_b2b_free = 1'b1;
            }
        }
    }
    always_ff (clk, rst) {
        if_reset {
            lsr_v_q         = 1'b0;
            lsr_vaddr_q     = 64'd0;
            lsr_paddr_q     = 64'd0;
            lsr_pdst_q      = '0;
            lsr_rob_idx_q   = '0;
            lsr_funct3_q    = 3'd0;
            lsr_has_rd_q    = 1'b0;
            lsr_fp_ld_q     = 1'b0;
            lsr_pc_q        = 64'd0;
            lsr_rs2_q       = 64'd0;
            lsr_fault_pg_q  = 1'b0;
            lsr_fault_acc_q = 1'b0;
            lsr_unc_q       = 1'b0;
            lsr_gstage_q    = 1'b0;
            lsr_gpa_q       = 64'd0;
        } else {
            if lsr_squashed {
                lsr_v_q = 1'b0;
            } else if lsr_capture {
                lsr_v_q         = 1'b1;
                lsr_vaddr_q     = agu_addr_iss;          // VA: byte offset + forward + LQ-record
                lsr_paddr_q     = dmu_dmem_addr;         // PA: dcache read only
                lsr_pdst_q      = iq_iss_rd_pdst;
                lsr_rob_idx_q   = iq_iss_rob_idx;
                lsr_funct3_q    = iq_issue_op.base.mem_funct3;
                lsr_has_rd_q    = iq_issue_op.base.has_rd;
                lsr_fp_ld_q     = iq_iss_fp_ld;
                lsr_pc_q        = iq_issue_op.base.pc;
                lsr_rs2_q       = alu_rs2_data;
                lsr_fault_pg_q  = dmem_mmu_fault;
                lsr_fault_acc_q = dmem_mmu_acc_fault;
                lsr_unc_q       = dc_uncached;
                lsr_gstage_q    = dmem_mmu_gstage; // Phase 11-H: two-stage fault attribution (htval)
                lsr_gpa_q       = dmem_mmu_gpa;
            } else if mshr_cap_b {
                // step-2: the missing load has been handed to an MSHR entry — free
                // the slot NOW so the next load can capture instead of waiting out
                // the fill. Mutually exclusive with lsr_complete (the handoff only
                // fires while dcache_stall holds, so lsr_read_done is 0). It was also
                // mutually exclusive with lsr_capture (which needed !lsr_v_q) until
                // Block T: at LSR_B2B_MSHR=1 a capture may land on the SAME cycle, and
                // the branch order above is what makes that correct — the handoff has
                // already read the LSR's registered fields into the MSHR entry, so
                // overwriting them with the new load loses nothing.
                lsr_v_q = 1'b0;
            } else if lsr_complete {
                lsr_v_q = 1'b0;
            }
        }
    }
    // CP MMU->dcache pipeline (M1): capture the MMU+PMP output each cycle. At
    // MEM_PIPE=1 the dcache reads these the next cycle (dmem_*_m above). M1
    // registers unconditionally (the registered = live, delayed one cycle); the
    // capture-enable gating that holds the value across a dcache stall is M2/M3
    // handshake work. At MEM_PIPE=0 these feed nothing (synth DCEs them).
    always_ff (clk, rst) {
        if_reset {
            m_pa_q       = 64'd0;
            m_fault_q    = 1'b0;
            m_spage_q    = 1'b0;
            m_sacc_q     = 1'b0;
            m_gstage_q   = 1'b0;
            m_pte_acc_q  = 1'b0;
            m_pma_hole_q = 1'b0;
            m_cbom_pmp_r_q = 1'b0;
            m_cbom_pmp_w_q = 1'b0;
            m_ren_q      = 1'b0;
            m_unc_q      = 1'b0;
            m_lnext_q    = 1'b0;
            m_wen_q      = 1'b0;
            m_wstrb_q    = 8'd0;
            m_wstrbhi_q  = 8'd0;
            m_wdata_q    = 64'd0;
            m_amo_read_q = 1'b0;
            m_wen_excl_q = 1'b0;
            m_addr2_q    = 64'd0;
            m_ren2_q     = 1'b0;
            m_lnext2_q   = 1'b0;
        } else {
            m_pa_q       = dmu_dmem_addr;
            m_spage_q    = dmem_mmu_fault_s;
            m_sacc_q     = dmem_mmu_acc_fault_s;
            m_gstage_q   = dmem_mmu_gstage;
            m_pte_acc_q  = dmem_mmu_pte_acc_fault;
            m_pma_hole_q = dmem_mmu_pma_hole;
            m_cbom_pmp_r_q = cbo_m_pmp_deny_r;
            m_cbom_pmp_w_q = cbo_m_pmp_deny_w;
            m_fault_q    = dmem_mmu_fault_s || dmem_mmu_acc_fault_s;
            // R3.2c: a class atomic still drives core_dmem_ren so the MMU translates and
            // fault-checks it, but it must not turn into a dcache ACCESS — the M-stage
            // would otherwise do a plain (shared) read/fill of the line the drain is
            // about to RFO. Gated on the ack cycle so a PTW/other owner of dmu_dmem_ren
            // is never suppressed. Constant 0 at ASQ_NOREAD=0.
            // Block T: lsr_b2b_spec is the extra suppression for a Stage-A plain load
            // that does not capture (see its always_comb). Const-folds to 0 at
            // LSR_B2B=0 → bit-identical there.
            m_ren_q      = dmu_dmem_ren && !lsr_capture && !lsr_b2b_spec && !asq_nr_acc;
            m_unc_q      = dc_uncached && !lsr_capture && !lsr_b2b_spec;
            m_lnext_q    = dc_load_next && !dc_uncached && !lsr_capture && !lsr_b2b_spec;
            // R3 §7.11: an atomic whose LIVE in-cache write was suppressed because it
            // was diverted into the atomic-SQ must not leave an M-stage write behind
            // either. dc_i_wen still latches here from the same store_drive, so without
            // this the diverted write lands one cycle later through the M-stage arm and
            // the atomic is applied TWICE — once by the queue drain and once from the
            // M-stage. That is the whole ATOMIC_SQ=1 failure: the control run shows 15
            // M-stage writes on litmus test 7's line at =0 versus 3521 at =1.
            m_wen_q      = dc_i_wen && !(ATOMIC_SQ && amo_commit_live && !amo_cwr_eff);
            m_wstrb_q    = dmu_dmem_wstrb;
            m_wstrbhi_q  = dc_st_wstrb_hi;
            m_wdata_q    = dmu_dmem_wdata;
            m_amo_read_q = dc_amo_read;
            m_wen_excl_q = dc_wen_excl;
            m_addr2_q    = dc_addr2;
            m_ren2_q     = dc_ren2;
            m_lnext2_q   = dc_load_next2;
        }
    }
    // CP M3a: slow-store commit 2-cycle handshake. Set store_fetched_q when the
    // slow store has translated (drives the dcache write path + MMU not walking);
    // the M3a gate in rob_commit_ack then holds retire for that translate cycle and
    // lets it retire the next (write) cycle. Clear on retire / redirect so the next
    // slow store starts with its own translate cycle. Dead at MEM_PIPE=0 (unread).
    always_ff (clk, rst) {
        if_reset {
            store_fetched_q = 1'b0;
        } else {
            if redirect_fire || rob_commit_ack {
                store_fetched_q = 1'b0;
            } else if store_drive && !sb_elig && !dmem_mmu_busy {
                store_fetched_q = 1'b1;
            }
        }
    }
    // CP M3b: AMO/LR fetch-cycle marker. Set the cycle the AMO/LR drives its read
    // with the translate done (dc_amo_read && !dmem_mmu_busy: the M-stage latched the
    // AMO's PA + amo_read this cycle, so next cycle the dcache reads it). Clear on the
    // AMO's actual ack (it completed), on a redirect, OR whenever it stops driving its
    // read (!dc_amo_read: port lost to a VU op / committing store, or blocked) — then
    // a fresh fetch cycle re-latches the right PA before the access. Dead at
    // MEM_PIPE=0 (amo_fetch_hold, the only reader, is MEM_PIPE-gated).
    always_ff (clk, rst) {
        if_reset {
            amo_fetched_q = 1'b0;
        } else if redirect_fire || (issue_amo_read && iq_issue_ack) || !dc_amo_read {
            amo_fetched_q = 1'b0;
        } else {
            amo_fetched_q = !dmem_mmu_busy;
        }
    }
    // Replay outcomes (replay_drive/replay_is_a defined at the dcache inst).
    // L4 step-2: WHOSE fill is this? `dc_miss_valid` says "a load fill starts now", and
    // the pre-step-1 design read that as "…for whoever is driving the port this cycle".
    // That equivalence is false under DCACHE_SYNC_READ=1: the fill TARGET is
    // {f_tag_q, f_index_q}, registered from the PREVIOUS cycle's live address, exactly
    // like load_sel_q. A blocking LSR drive holds i_addr every cycle so previous ==
    // current and the shortcut happens to hold; a REPLAY drive is intermittent, so the
    // deciding cycle can belong to a different requester and the replay then claims a
    // fill for someone else's line — latching that line's critical word as its own data.
    // Observed at LSR_MSHR_B=1 on test_arch_hvtmr: `ld t6,80(sp)` (the guest's SBI a0 =
    // the DBCN length, must be 1) retired 0x140111735450a001, the dword of an unrelated
    // line that was filling around it, and the hypervisor's byte-copy loop then ran
    // ~forever. Check the fill's own line instead of inferring it from the drive:
    // o_memr_addr at a fill start is {f_tag, f_index, 6'd0}, so the comparison is exact.
    // A mismatch simply declines ownership — the entry stays queued and replays again
    // (dc_miss_valid still clears replay_q and sets fill_busy_q), so it is bounded.
    let dc_fill_dw     : logic<61> = {dc_mem_addr[63:6], dc_miss_offset};
    let dc_fill_line_ok_r: logic = replay_addr[63:3] == dc_fill_dw;
    let replay_sb_ovl  : logic = if replay_is_a ? sb_mshra_ovl : sb_mshrb_ovl;
    let replay_hit_fire: logic = replay_drive && dc_hit_safe && !i_dcache_inv_valid && !i_dcache_inv2_valid && !replay_sb_ovl;
    let replay_claim   : logic = replay_drive && dc_miss_valid && dc_fill_line_ok_r;
    // Fill completion routes to the OWNING entry.
    // S14.2: dc_fill_ready fires the owner's completion EARLY — critical-word-
    // first lands the demanded dword on the first transfer, so the writeback no
    // longer waits out the whole burst. The early arm marks the entry done
    // (own_q drops with it), after which the fill drains ownerless: a late
    // abort (remote inv) cannot poison the already-completed load — its value
    // was read before the invalidate, which is a legal ordering — and
    // dc_fill_ready itself is gated off on the abort/same-cycle-inv races
    // inside the dcache.
    let mshra_fill_done: logic = mshra_v_q && mshra_own_q && !mshra_done_q && (dc_fill_complete || dc_fill_aborted || dc_fill_ready);
    let mshrb_fill_done: logic = mshrb_v_q && mshrb_own_q && !mshrb_done_q && (dc_fill_complete || dc_fill_aborted || dc_fill_ready);
    // Deferred writeback arbitration: lane 0, priority FPU > MSHR(a>b) > ALU.
    let mshra_wb_rdy : logic = mshra_v_q && mshra_done_q;
    let mshrb_wb_rdy : logic = mshrb_v_q && mshrb_done_q;
    let mshr_wb_sel_a: logic = mshra_wb_rdy;
    let mshr_wb_fire : logic = (mshra_wb_rdy || mshrb_wb_rdy) && !fpu_cdb.valid;

    // Core-tracked dcache fill-FSM busy (fill start → DONE) — arms the replay.
    // (declared next to replay_q: the L4 step-2 QUE_FILLONLY qualifier reads it above.)
    always_ff (clk, rst) {
        if_reset {
            fill_busy_q = 1'b0;
            replay_q    = 1'b0;
        } else {
            if dc_miss_valid {
                fill_busy_q = 1'b1;
            } else if dc_fill_complete || dc_fill_aborted {
                fill_busy_q = 1'b0;
            }
            // Replay arming / retirement. Any fill start clears it (either the
            // replay's own claim, or a PTW/blocking read won the port — the
            // queued entry stays and re-arms after that fill). It also clears
            // when the replay hits, or when no live queued entry remains
            // (squash). Otherwise it arms (and holds) while a queued entry
            // exists and the fill FSM is idle.
            if dc_miss_valid {
                replay_q = 1'b0;
            } else if replay_hit_fire {
                replay_q = 1'b0;
            } else if !((mshra_queued && !mshra_squashed) || (mshrb_queued && !mshrb_squashed)) {
                replay_q = 1'b0;
            } else if !fill_busy_q {
                replay_q = 1'b1;
            }
        }
    }
    always_ff (clk, rst) {
        if_reset {
            mshra_v_q       = 1'b0;
            mshra_done_q    = 1'b0;
            mshra_own_q     = 1'b0;
            mshra_rob_idx_q = '0;
            mshra_pdst_q    = '0;
            mshra_has_rd_q  = 1'b0;
            mshra_addr_q    = '0;
            mshra_funct3_q  = '0;
            mshra_data_q    = '0;
            mshrb_v_q       = 1'b0;
            mshrb_done_q    = 1'b0;
            mshrb_own_q     = 1'b0;
            mshrb_rob_idx_q = '0;
            mshrb_pdst_q    = '0;
            mshrb_has_rd_q  = 1'b0;
            mshrb_addr_q    = '0;
            mshrb_funct3_q  = '0;
            mshrb_data_q    = '0;
        } else {
            // entry A
            if mshra_squashed {
                mshra_v_q    = 1'b0;
                mshra_done_q = 1'b0;
                mshra_own_q  = 1'b0;
            } else if mshr_alloc_fire && mshr_alloc_a {
                mshra_v_q       = 1'b1;
                mshra_done_q    = 1'b0;
                mshra_own_q     = mshr_alloc_own;
                mshra_rob_idx_q = mshr_alloc_rob;
                mshra_pdst_q    = mshr_alloc_pdst;
                mshra_has_rd_q  = mshr_alloc_hasrd;
                mshra_addr_q    = mshr_alloc_addr;
                mshra_funct3_q  = mshr_alloc_f3;
            } else if replay_claim && replay_is_a {
                mshra_own_q = 1'b1;
            } else if replay_hit_fire && replay_is_a {
                mshra_data_q = dcache_rdata;
                mshra_done_q = 1'b1;
            } else if mshra_fill_done {
                mshra_data_q = dc_fill_rdata;
                mshra_done_q = 1'b1;
                mshra_own_q  = 1'b0;
            } else if mshr_wb_fire && mshr_wb_sel_a {
                mshra_v_q    = 1'b0;
                mshra_done_q = 1'b0;
            }
            // entry B
            if mshrb_squashed {
                mshrb_v_q    = 1'b0;
                mshrb_done_q = 1'b0;
                mshrb_own_q  = 1'b0;
            } else if mshr_alloc_fire && !mshr_alloc_a {
                mshrb_v_q       = 1'b1;
                mshrb_done_q    = 1'b0;
                mshrb_own_q     = mshr_alloc_own;
                mshrb_rob_idx_q = mshr_alloc_rob;
                mshrb_pdst_q    = mshr_alloc_pdst;
                mshrb_has_rd_q  = mshr_alloc_hasrd;
                mshrb_addr_q    = mshr_alloc_addr;
                mshrb_funct3_q  = mshr_alloc_f3;
            } else if replay_claim && !replay_is_a {
                mshrb_own_q = 1'b1;
            } else if replay_hit_fire && !replay_is_a {
                mshrb_data_q = dcache_rdata;
                mshrb_done_q = 1'b1;
            } else if mshrb_fill_done {
                mshrb_data_q = dc_fill_rdata;
                mshrb_done_q = 1'b1;
                mshrb_own_q  = 1'b0;
            } else if mshr_wb_fire && !mshr_wb_sel_a {
                mshrb_v_q    = 1'b0;
                mshrb_done_q = 1'b0;
            }
        }
    }
    // Deferred load-data extension on the SELECTED writeback entry: the
    // captured load is within-dword (cross-dword excluded at capture) with no
    // forwarded bytes, so this is the single-dword slice of alu_wrap's ld_*
    // select on the latched fill/hit dword.
    let mshr_wb_addr  : logic<64>        = if mshr_wb_sel_a ? mshra_addr_q : mshrb_addr_q;
    let mshr_wb_funct3: logic<3>         = if mshr_wb_sel_a ? mshra_funct3_q : mshrb_funct3_q;
    let mshr_wb_data64: logic<64>        = if mshr_wb_sel_a ? mshra_data_q : mshrb_data_q;
    let mshr_wb_pdst  : logic<PRF_INT_W> = if mshr_wb_sel_a ? mshra_pdst_q : mshrb_pdst_q;
    let mshr_wb_rob   : logic<ROB_IDX_W> = if mshr_wb_sel_a ? mshra_rob_idx_q : mshrb_rob_idx_q;
    let mshr_wb_has_rd: logic            = if mshr_wb_sel_a ? mshra_has_rd_q : mshrb_has_rd_q;
    let mshr_shift  : logic<6>  = {mshr_wb_addr[2:0], 3'b000};
    let mshr_shifted: logic<64> = mshr_wb_data64 >> mshr_shift;
    var mshr_ld_data: logic<64>;
    always_comb {
        case mshr_wb_funct3 {
            3'b000 : mshr_ld_data = {if mshr_shifted[7] ? 56'hff_ffff_ffff_ffff : 56'd0, mshr_shifted[7:0]}; // LB
            3'b001 : mshr_ld_data = {if mshr_shifted[15] ? 48'hffff_ffff_ffff : 48'd0, mshr_shifted[15:0]}; // LH
            3'b010 : mshr_ld_data = {if mshr_shifted[31] ? 32'hffff_ffff : 32'd0, mshr_shifted[31:0]}; // LW
            3'b011 : mshr_ld_data = mshr_shifted; // LD
            3'b100 : mshr_ld_data = {56'd0, mshr_shifted[7:0]}; // LBU
            3'b101 : mshr_ld_data = {48'd0, mshr_shifted[15:0]}; // LHU
            3'b110 : mshr_ld_data = {32'd0, mshr_shifted[31:0]}; // LWU
            default: mshr_ld_data = mshr_shifted;
        }
    }
    always_comb {
        mshr_cdb.valid       = mshr_wb_fire;
        mshr_cdb.has_rd      = mshr_wb_fire && mshr_wb_has_rd;
        mshr_cdb.pdst        = mshr_wb_pdst;
        mshr_cdb.data        = mshr_ld_data;
        mshr_cdb.rob_idx     = mshr_wb_rob;
        mshr_cdb.mispredict  = 1'b0;
        mshr_cdb.redirect_pc = '0;
        mshr_cdb.is_store    = 1'b0;
        // S10.3: is_load=0 — the S9 Load Queue shadow is recorded at CAPTURE
        // (rob i_lq_rec_*, address known at the AGU), NOT at this deferred
        // writeback, so an older store resolving DURING the fill window sees
        // the load in the violation scan. A second record here would be
        // redundant at best.
        mshr_cdb.is_load      = 1'b0;
        mshr_cdb.store_addr   = mshr_wb_addr;
        mshr_cdb.store_data   = '0;
        mshr_cdb.store_funct3 = mshr_wb_funct3;
        mshr_cdb.is_csr       = 1'b0;
        mshr_cdb.csr_addr     = '0;
        mshr_cdb.csr_wdata    = '0;
        mshr_cdb.csr_illegal  = 1'b0;
        mshr_cdb.cas_q_mem_lo = '0; // Zacas amocas.q: MSHR loads carry no CAS payload
        mshr_cdb.cas_q_mem_hi = '0;
        mshr_cdb.is_lfault    = 1'b0;
        mshr_cdb.is_sfault    = 1'b0;
        mshr_cdb.fault_acc    = 1'b0;
        mshr_cdb.fault_vaddr  = '0;
    }
    // L4 step-2 diagnosis: MSHR life-cycle trace, correlated with CMT_TRACE by rob_idx
    // (MSHR_TRACE / trc_cy_q are declared next to CMT_TRACE, above the ASQ engine).
    always_ff (clk, rst) {
        if_reset {} else if MSHR_TRACE {
            if dc_miss_valid {
                $display("M h=%d [%d] MISS rq=%d ld=%d av=%d ao=%d bv=%d bo=%d", HART_ID, trc_cy_q, replay_q, lsr_drive, mshra_v_q, mshra_own_q, mshrb_v_q, mshrb_own_q);
            }
            if replay_claim {
                $display("M h=%d [%d] claim isa=%d a=%h", HART_ID, trc_cy_q, replay_is_a, replay_addr);
            }
            if mshr_cap_b {
                $display("M h=%d [%d] cap own=%d pc=%h pa=%h f3=%d rob=%d", HART_ID, trc_cy_q, mshr_cap_b_own, lsr_pc_q, mshr_alloc_addr, mshr_alloc_f3, mshr_alloc_rob);
            }
            if replay_hit_fire {
                $display("M h=%d [%d] rhit a=%h isa=%d d=%h", HART_ID, trc_cy_q, replay_addr, replay_is_a, dcache_rdata);
            }
            if mshra_fill_done {
                $display("M h=%d [%d] fillA a=%h d=%h rdy=%d cmp=%d", HART_ID, trc_cy_q, mshra_addr_q, dc_fill_rdata, dc_fill_ready, dc_fill_complete);
            }
            if mshrb_fill_done {
                $display("M h=%d [%d] fillB a=%h d=%h rdy=%d cmp=%d", HART_ID, trc_cy_q, mshrb_addr_q, dc_fill_rdata, dc_fill_ready, dc_fill_complete);
            }
            if mshr_abort_poison {
                $display("M h=%d [%d] poisA rob=%d a=%h", HART_ID, trc_cy_q, mshra_rob_idx_q, mshra_addr_q);
            }
            if mshr_abort_poison2 {
                $display("M h=%d [%d] poisB rob=%d a=%h", HART_ID, trc_cy_q, mshrb_rob_idx_q, mshrb_addr_q);
            }
            if mshr_wb_fire {
                $display("M h=%d [%d] wb rob=%d a=%h f3=%d raw=%h out=%h", HART_ID, trc_cy_q, mshr_wb_rob, mshr_wb_addr, mshr_wb_funct3, mshr_wb_data64, mshr_ld_data);
            }
        }
    }

    // ============================================================
    // P9.6: D / instruction-side (IS) read-port arbiter. The IS = the I-cache
    // fill OR the I-PTW PTE read (phase 2) — both UNCOUNTED coherent reads
    // (recall-on-owned) through this hart's single mem_ctrl L2 read transaction
    // port. The D-cache (loads / store-RFO / uncached MMIO) has strict priority;
    // the IS sneaks in only when the D-cache is not requesting. ic_owns LATCHES
    // the port for the whole transaction (accept → 8 STREAM beats); is_ptw_q
    // latches WHICH IS consumer owns it. IS sub-arbiter = I-PTW > I-fill (a fetch
    // translates then fetches, so they are sequential; priority just orders a
    // rare overlap). A mid-transaction D request waits — mem_ctrl has one slot
    // per hart, and switching the port mid-stream would strand the read.
    // ============================================================
    // I-PTW request: the imem MMU wants a PTE and we have not delivered it yet.
    let iptw_off    : logic<3>  = imem_ptw_addr_w[5:3];
    let iptw_mem_req: logic     = imem_ptw_req_w && !iptw_busy && !iptw_done_q;
    // Active IS consumer this cycle: the latched one during a txn, else the
    // priority pick (I-PTW first).
    let is_ptw      : logic     = if ic_owns ? is_ptw_q : iptw_mem_req;
    let is_req      : logic     = iptw_mem_req || ic_mem_req;
    // The I-PTW read holds addr[5:3]=iptw_off so every STREAM beat carries the
    // PTE dword (mem_ctrl serves buf[addr[5:3]]); the I-fill drives its own addr.
    let iptw_rd_addr: logic<64> = {imem_ptw_addr_w[63:6], iptw_off, 3'b000};
    // During the read use the LATCHED addr (a mid-read redirect changes
    // imem_ptw_addr_w → iptw_off, which would re-point mem_ctrl's beat to the
    // wrong dword of the latched line and corrupt the captured PTE).
    let is_mem_addr : logic<64> = if is_ptw ? (if iptw_busy ? iptw_addr_q : iptw_rd_addr) : ic_mem_addr;
    // Block N step 3: with its own slot the I side never routes onto the D port, so
    // ic_route folds to 0 and the D side owns o_dmem_* unconditionally. ic_owns and
    // is_ptw_q stay — they still pick I-PTW vs I-fill and track the 8-beat STREAM;
    // what disappears is only the arbitration AGAINST the D side.
    assign ic_route = if ID_SPLIT ? 1'b0 : (ic_owns || (is_req && !dc_mem_req));
    assign o_imemr_req  = ID_SPLIT && is_req;
    assign o_imemr_addr = is_mem_addr;
    // NOTE: no `is_req` term on the split arm. mem_ctrl's STREAM beats do not depend on
    // i_hreq (stream_ok is purely `slot in STREAM && i_haddr line == line_q`), and is_req
    // CAN drop mid-transaction (an I-fill that aborts on a redirect). The old shared path
    // kept receiving beats through ic_route's `ic_owns` term for exactly this reason;
    // gating on is_req here loses beats and strands the fill.
    let is_grant    : logic     = if ID_SPLIT ? i_imemr_grant : (i_dmem_grant && ic_route);
    let iptw_grant  : logic     = is_grant && is_ptw;  // STREAM beat for the I-PTW
    assign ic_grant = is_grant && !is_ptw;             // STREAM beat for the I-fill
    assign dc_grant = i_dmem_grant && !ic_route;
    let iptw_fill_done: logic   = iptw_busy && iptw_grant && iptw_cnt == 3'd7;
    let is_done       : logic   = if is_ptw_q ? iptw_fill_done : ic_fill_done;
    always_ff (clk, rst) {
        if_reset {
            ic_owns  = 1'b0;
            is_ptw_q = 1'b0;
        } else {
            if ic_owns {
                if is_done {
                    ic_owns = 1'b0;
                }
            } else if is_req && is_grant {
                ic_owns  = 1'b1;
                is_ptw_q = is_ptw;
            }
        }
    }

    // I-PTW PTE read FSM: capture the addressed dword across the 8-beat stream
    // (every beat carries buf[iptw_off] since the addr is held), then hold
    // iptw_done_q (= the MMU's i_ptw_valid) until the MMU advances to a new walk
    // step (a different PTE dword) or finishes the walk.
    always_ff (clk, rst) {
        if_reset {
            iptw_busy   = 1'b0;
            iptw_cnt    = 3'd0;
            iptw_data   = 64'd0;
            iptw_done_q = 1'b0;
            iptw_done_a = '0;
            iptw_addr_q = 64'd0;
        } else {
            if iptw_busy {
                if iptw_grant {
                    iptw_data = is_rdata;
                    if iptw_cnt == 3'd7 {
                        iptw_busy   = 1'b0;
                        iptw_done_q = 1'b1;
                        iptw_done_a = iptw_addr_q[63:3]; // the read's latched addr
                    } else {
                        iptw_cnt = iptw_cnt + 3'd1;
                    }
                }
            } else {
                // Accept for the I-PTW (the IS port granted while I-PTW is the pick).
                if !ic_owns && is_ptw && is_req && is_grant {
                    iptw_busy   = 1'b1;
                    iptw_cnt    = 3'd0;
                    iptw_addr_q = iptw_rd_addr; // latch the read addr for the txn
                }
                // Release the delivered PTE once the MMU moves to a new step.
                if iptw_done_q && (!imem_ptw_req_w || imem_ptw_addr_w[63:3] != iptw_done_a) {
                    iptw_done_q = 1'b0;
                }
            }
        }
    }

    // S23: read channel on o_dmem_addr/ren, write channel on o_dmemw_addr +
    // wen/wdata/wstrb. P9.6: the read channel is muxed (instruction side when ic_route).
    assign o_dmem_addr   = if ic_route ? is_mem_addr : dc_mem_addr;
    assign o_dmem_ren    = if ic_route ? 1'b0 : dc_mem_ren; // IS read is DRAM (no MMIO ren)
    assign o_dmem_req    = if ic_route ? is_req : dc_mem_req;
    assign o_dmem_rfo    = if ic_route ? 1'b0 : dc_mem_rfo; // IS read is never RFO
    assign o_dmem_iread  = ic_route;
    for l in 0..8 :gen_dmemw_lane {
        assign o_dmem_wdata[l] = dc_mem_wdata[l];
        assign o_dmem_wstrb[l] = dc_mem_wstrb[l];
    }
    assign o_dmem_wen = dc_mem_wen;
    assign o_dmemw_addr  = dc_memw_addr;
    assign o_dmemw_req   = dc_memw_req;
    // M8: hi-side carry for a misaligned STORE that spans into the next dword.
    // The hi dword can't be held in the dcache, so it bypasses straight to DRAM
    // (the SoC writes o_dmem_addr+8 wherever this strobe is set). The bypass
    // rides whatever DRAM write fires this cycle, so it MUST be suppressed while
    // the dcache is draining a WRITEBACK (o_dmemw_wb / wb_v): a WB wins the
    // dcache write-channel address mux (wb_line > i_addr), preempting the
    // misaligned store's own i_wen write — but dc_st_wstrb_hi stays asserted, so
    // the hi strobe would leak onto the WB and clobber the WB line's next dword.
    // P9.2/9.3 SMP: a c2c recall WB coinciding with a misaligned commit silently
    // corrupted memory (e.g. __num_online_cpus → 0, stop_machine never converges
    // → the 6.6 N=2 boot livelock). The strobe re-fires with the store's own
    // i_wen write once the WB drains (!o_dmemw_wb), targeting the right line.
    assign o_dmem_wdata_hi = st_wdata_hi;
    assign o_dmem_wstrb_hi = if o_dmemw_wb ? 8'd0 : dc_st_wstrb_hi;

    // i_dmem_rdata_next (top-level next-dword) is superseded by the dcache's
    // own o_rdata_next; keep the port for tb compatibility.
    let _unused_dmem_rdata_next: logic<64> = i_dmem_rdata_next;

    // M1 debug counters
    var rename_cnt: logic<32>;
    var cdb_cnt   : logic<32>;
    always_ff (clk, rst) {
        if_reset {
            rename_cnt = 32'd0;
            cdb_cnt    = 32'd0;
        } else {
            if rename_fire {
                rename_cnt = rename_cnt + 32'd1;
            }
            if cdb.valid {
                cdb_cnt = cdb_cnt + 32'd1;
            }
        }
    }
    assign o_dbg_rename_cnt     = rename_cnt;
    assign o_dbg_cdb_cnt        = cdb_cnt;

    // Phase 8 perf counters (M0). Pure observability — no datapath effect.
    //  - mispredict_cnt: a control transfer committed taken. Today (static
    //    not-taken) every taken branch/jal/jalr is a mispredict, so this also
    //    equals the count of taken transfers a predictor could save. Counted on
    //    the same condition the commit-redirect mispredict arm uses (line ~1597);
    //    a mispredicting branch is never a store, so rob_commit_valid is high for
    //    exactly one cycle per event.
    //  - redirect_cnt: every cycle redirect_fire is asserted (1 cycle/event).
    //  - front_idle_cnt: fetch slot empty while not stalled by the back-end and
    //    not the redirect cycle itself — i.e. an i-fetch bubble (icache/MMU fill
    //    or the refill gap after a redirect).
    // Phase 8 S8.A: early (execute-time) branch-misprediction detection. The
    // resolved architectural next-PC is already on the CDB — alu_wrap's
    // resolved_target (= o_cdb.redirect_pc) encodes taken→target / not-taken→
    // fall-through. Compare it against the fetch-time prediction recorded in the
    // ROB entry that just resolved (indexed by the CDB rob_idx, exposed via
    // rob_pred_next_pc / rob_is_control). A mismatch on a CONTROL op is an early
    // mispredict, available the cycle the branch executes — many cycles before it
    // reaches the commit head. Restricted to control ops; a stray BTB hit on a
    // non-control op still self-corrects at commit (rare). NOTE: o_cdb.mispredict
    // is the STALE M1 "any taken = mispredict" flag (alu_wrap predates the BTB/BHT)
    // and is deliberately NOT used here.
    //
    // S8.A is OBSERVATION-ONLY: redirect still fires at commit (zero behavior
    // change); S8.E steers the front-end on these signals. The early count is >=
    // the committed mispredict count because wrong-path control ops execute (and
    // are counted) but are flushed before they commit.
    // S8.E LIVENESS gate: a wrong-path op whose ROB entry was already committed/
    // squashed can still be sitting in the IQ and issue, producing a CDB with a
    // rob_idx that is BEHIND the head (age, head-relative, >= the live size). Acting
    // on its (stale) mispredict would register an early redirect for a non-live idx,
    // and the partial squash would rewind tail to head+(huge age)+1 = a full ROB
    // (deadlock). Restrict early-mispredict to genuinely live entries: age < size.
    // (5-bit age intermediate + zero-extended compare — the inline subtraction form
    // mis-evaluates under the Veryl cc sim; see the rob.veryl squash note.)
    let em0_age: logic<ROB_IDX_W> = alu_cdb_eff.rob_idx - rob_head_idx;
    let em1_age: logic<ROB_IDX_W> = alu_cdb2.rob_idx - rob_head_idx;
    let em0_live: logic = {3'b000, em0_age} <: rob_size;
    let em1_live: logic = {3'b000, em1_age} <: rob_size;
    let early_mispredict0: logic = alu_cdb_eff.valid && em0_live && rob_is_control[alu_cdb_eff.rob_idx]
        && (alu_cdb_eff.redirect_pc != rob_pred_next_pc[alu_cdb_eff.rob_idx]);
    let early_mispredict1: logic = alu_cdb2.valid && em1_live && rob_is_control[alu_cdb2.rob_idx]
        && (alu_cdb2.redirect_pc != rob_pred_next_pc[alu_cdb2.rob_idx]);
    let early_mispred_inc: logic<32> =
        (if early_mispredict0 ? 32'd1 : 32'd0) + (if early_mispredict1 ? 32'd1 : 32'd0);

    // Phase 8 S8.E: the flip. Steer the front-end on an execute-time mispredict
    // instead of waiting for the branch to reach the ROB head and commit-redirect.
    // SELECT: the two ALU lanes can both resolve a mispredicting control op in the
    // same cycle; recover on the OLDER one (smallest age relative to the ROB head)
    // — it dominates the younger one's path, and its single-cycle checkpoint
    // restore + younger-squash subsumes the younger redirect (the younger branch's
    // own ROB/IQ entries are squashed, so it cannot later fire a stale redirect).
    let early_redir_pick1: logic = early_mispredict1 && (!early_mispredict0 || (em1_age <: em0_age));
    // REGISTER (+1 cy, mirrors redirect_fire_q). Gate so it never fires when:
    //  - a commit redirect is recovering this cycle (!redirect_fire): commit is
    //    precise and does a full flush — let it win and don't double-recover; the
    //    branch (if mispredicted) is re-detectable next cycle if still in flight.
    //  - we are ALREADY in an early-recovery cycle (!early_redir_fire_q): the ALU
    //    may issue a YOUNGER wrong-path branch this cycle (issue reads pre-squash
    //    IQ state) whose execute-time redirect must NOT steer the just-recovered
    //    front-end. Such a branch is squashed at the edge; if a genuinely OLDER
    //    branch mispredicts here it still commit-redirects (its pred_next_pc was
    //    not rewritten by the guard), so no mispredict is ever lost.
    // Phase 8 S8.E flip ENABLE. The early-redirect datapath below steers the front-
    // end at execute instead of at commit. Validated: arch 152/0, N=1 Linux boot to
    // SBI shutdown (x3=0xAA @15.1M cy, -6% vs the commit-redirect S8.D 16.1M), and a
    // committed-stream byte-diff vs the gated-off baseline (identical → the early
    // recovery is architecturally transparent). BUG5 (a boot trap-redirect livelock)
    // was a wrong-path PTW whose page fault mis-attributed to a reused rob_idx; fixed
    // by clearing the decoupled walk owner (walk_v_q) on early_redir_fire_q with
    // priority over dmem_walk_start (see the walk-owner always_ff). Set 1'b0 to revert
    // to S8.D (commit-time redirect) exactly — early_redir_fire_q then never fires.
    let s8e_flip_en: logic = 1'b1;
    let early_redir_trigger: logic = s8e_flip_en && (early_mispredict0 || early_mispredict1)
        && !redirect_fire && !early_redir_fire_q;
    // A-EXE: the lane-0 select must read alu_cdb_EFF (the same registered bus the
    // detection em0/early_mispredict0 uses), NOT the live alu_cdb. At EX_PIPE=1 the
    // live alu_cdb is a DIFFERENT op than the registered alu_cdb_q that resolved the
    // mispredict, so taking the redirect idx/PC from live alu_cdb steered the front
    // end with the wrong op's target (observed: a `j` fell through instead of
    // jumping). alu_cdb_eff == alu_cdb at EX_PIPE=0 → byte-identical.
    let early_redir_sel_idx: logic<ROB_IDX_W> = if early_redir_pick1 ? alu_cdb2.rob_idx : alu_cdb_eff.rob_idx;
    let early_redir_sel_pc : logic<64>        = if early_redir_pick1 ? alu_cdb2.redirect_pc : alu_cdb_eff.redirect_pc;
    // S8.E re-redirect guard drive (this cycle = the resolving op's CDB writeback;
    // see the ROB i_cdb_redir_fix port). When the early redirect triggers, rewrite the
    // committed prediction of EVERY mispredicting lane: the selected (older) op survives
    // and must not re-redirect at commit; a non-selected younger op is squashed anyway.
    assign early_redir_fix0 = early_redir_trigger && early_mispredict0;
    assign early_redir_fix1 = early_redir_trigger && early_mispredict1;
    always_ff (clk, rst) {
        if_reset {
            early_redir_fire_q = 1'b0;
            early_redir_idx_q  = 5'd0;
            early_redir_pc_q   = 64'd0;
        } else if early_redir_trigger {
            early_redir_fire_q = 1'b1;
            early_redir_idx_q  = early_redir_sel_idx;
            early_redir_pc_q   = early_redir_sel_pc;
        } else {
            early_redir_fire_q = 1'b0;
        }
    }

    var mispredict_cnt    : logic<32>;
    var redirect_cnt      : logic<32>;
    var front_idle_cnt    : logic<32>;
    var early_mispred_cnt : logic<32>;
    // Back-end profiling counters (companions to front_idle): characterize where a
    // post-S8.E run loses 2-wide throughput — rename back-pressure (disp_stall),
    // single-memory-port occupancy (mem_busy), ROB-head retire stalls (commit0), and
    // load issue serialization (load_wait). Used to pick perf levers from data.
    var disp_stall_cnt    : logic<32>;
    var mem_busy_cnt      : logic<32>;
    var commit0_cnt       : logic<32>;
    var load_wait_cnt     : logic<32>;
    // L3 census: the commit-time load replay ITSELF — a full redirect, refetch of
    // the poisoned load and everything younger. rob's load_viol_cnt counts only
    // one of the three poison sources, so this is the event to price L3 against.
    var load_replay_cnt   : logic<32>;

    // ------------------------------------------------------------------
    // L4 census: WHY does a selected load fail to issue? (2026-08-09)
    //
    // load_wait_cnt is 20.5 % of N=1 boot cycles but is an aggregate rate, and
    // every increment this campaign built from an aggregate rate failed. Decompose
    // it per cause. For a PLAIN load iq_issue_ack is exactly
    // `lsr_capture || mshr_capture`, so the blockers are the negated terms of
    // lsr_capture — an enumerable, mutually-known set.
    //
    // The actionable question is not "was cause X present" (they overlap heavily)
    // but "would removing X alone have let the load through". So each cause is
    // counted ONLY when it is the SOLE blocker; cycles with two or more live
    // causes go to a separate multi bucket. A big multi bucket is itself a
    // finding: it means no single lever moves those cycles.
    // ------------------------------------------------------------------
    let lw_stall  : logic = issue_is_load && !iq_issue_ack;
    let lw_plain  : logic = lw_stall && iss_is_plain_load && !mshr_capture;
    // The eight lsr_capture terms, as blockers.
    let lwc_lsr   : logic = lsr_v_q;                                  // LSR occupied — the previous load is still in Stage B
    let lwc_mmu   : logic = dmem_mmu_busy;                            // translate / PTW busy
    let lwc_walk  : logic = load_walk_block;                          // a load walk owns the port, this load is not the owner
    let lwc_store : logic = load_blocks_on_store;                     // store-ordering / drain hold
    let lwc_fpu   : logic = fpu_cdb.valid;                            // FPU owns lane 0
    let lwc_mshr  : logic = mshr_cdb.valid;                           // MSHR owns lane 0 (deferred fill writeback)
    let lwc_replay: logic = replay_q;
    let lwc_redir : logic = redirect_fire || early_redir_fire_q;      // squash cycle, not a real stall
    let lw_n_causes: logic<4> =
        ({3'b0, lwc_lsr} as 4) + ({3'b0, lwc_mmu} as 4) + ({3'b0, lwc_walk} as 4) + ({3'b0, lwc_store} as 4)
      + ({3'b0, lwc_fpu} as 4) + ({3'b0, lwc_mshr} as 4) + ({3'b0, lwc_replay} as 4) + ({3'b0, lwc_redir} as 4);
    let lw_sole   : logic = lw_plain && lw_n_causes == 4'd1;
    // Drill-down on the lsr bucket: the LSR is a SINGLE entry, so while the
    // incumbent load sits in Stage B no other plain load can even latch. Ask why
    // the incumbent is not completing. lsr_complete needs (fault || read_done)
    // and, on the lane-0 path, a free lane-0; read_done needs lsr_drive (which
    // yields the dcache port to a committing store / an MMU walk / a replay /
    // an in-flight store write) and !dcache_stall. Priority-encoded so the
    // sub-buckets partition the lsr bucket exactly.
    let lwl       : logic = lw_sole && lwc_lsr;
    let lwl_drive : logic = lwl && lsr_drive;
    // Block T terms. Bucket 13 above ("waiting for writeback lane 0") is measured at
    // 705,559 cy, but its label predates L4 step-1.5 — for a non-FP load the lane
    // term in lsr_complete is a literal 1, so the incumbent is COMPLETING on those
    // cycles and the waiter is held by nothing but the single-entry slot. Split it:
    // lwt_b2b is the population LSR_B2B converts into a capture, lwt_lane0 is what
    // is genuinely waiting for lane 0 (an FP load, the only lane-0 completer left).
    let lwt_free  : logic = lsr_v_q && lsr_complete;
    let lwt_b2b   : logic = lwt_free && lsr_cap_terms;
    let lwt_mshr  : logic = lsr_v_q && !lsr_complete && mshr_cap_b && lsr_cap_terms;
    let lwt_idle  : logic = lsr_v_q && (lsr_complete || mshr_cap_b) && !lsr_cap_terms;
    let lwt_busy  : logic = lsr_v_q && !lsr_complete && !mshr_cap_b && lsr_cap_terms;
    let lwt_lane0 : logic = lwl_drive && !dcache_stall && !lsr_complete;
    // W1 rename-width census terms. rw_have2 / rw_res2 mirror rename_fire2's own
    // conditions exactly, so the three blockers partition the 1-wide cycles.
    let rw_have2   : logic    = fb_count >= 4'd2 || fb_bypass2 || fb_fall;
    let rw_res2    : logic    = iq_alloc_rdy2 && free_avail2 && rob_size <= 8'd30;
    let rw_blk_no2 : logic    = !rw_have2;
    let rw_blk_elig: logic    = !dec_op2_eligible;
    let rw_blk_res : logic    = !rw_res2;
    let rw_n       : logic<2> = ({1'b0, rw_blk_no2} as 2) + ({1'b0, rw_blk_elig} as 2) + ({1'b0, rw_blk_res} as 2);
    let rw_1wide   : logic    = rename_fire && !rename_fire2;
    let rw_sole    : logic    = rw_1wide && rw_n == 2'd1;
    var lw_cause_cnt: logic<32> [128];
    // ------------------------------------------------------------------
    // M0 census: what does a commit-time load replay actually COST? (2026-08-16)
    //
    // The recovery model is pre-OoO — a poisoned load redirects and refetches
    // itself and everything younger. Block M's two levers (a dependence
    // predictor that avoids the speculation, a selective replay that cheapens
    // the recovery) are both worth exactly the cycles this event burns, and
    // that number has never been measured: the published figures are EVENT
    // COUNTS, and this campaign has been wrong 3x about converting a count
    // into cycles. So measure the cycles directly.
    //
    // Method: open a window at the replay redirect, latch the load's PC, and
    // close it when that PC commits again. The elapsed cycles ARE the recovery
    // cost of one event (refetch + re-rename + re-issue + re-execute + the
    // re-do of everything younger that was squashed with it). A trap inside
    // the window would charge the handler to the load, so a trap closes the
    // window into its own bucket; a runaway window is capped.
    //
    // The 256-entry 1-bit table is a LOAD WAIT TABLE (Alpha 21264) built as an
    // observer: index by load PC, set on replay, and report on the next replay
    // whether the PC was already known. That hit rate is the coverage ceiling
    // of the cheapest possible dependence predictor — measured before building
    // it, per the L3.2d "run the new policy without authority" rule.
    // ------------------------------------------------------------------
    const MRP_CAP: logic<32> = 32'd2048; // runaway-window bound (cycles)
    var mrp_open_q: logic     ; // a replay window is open
    var mrp_pc_q  : logic<64> ; // the replayed load's PC
    var mrp_len_q : logic<32> ; // cycles this window has been open
    var mrp_prev_q: logic<64> ; // PC of the PREVIOUS replay (consecutive-repeat test)
    // M0b: split the window into the half a SELECTIVE replay would delete (the
    // refetch: redirect → the same PC arrives at rename again) and the half it
    // would still pay (re-issue → re-execute → commit). Only the first half is
    // the lever's prize, so measure it instead of assuming it.
    var mrp_seen_q: logic     ; // the replayed load has been re-renamed
    var mrp_tab_q : logic     [256]; // the observer load-wait table
    let mrp_idx   : logic<8>  = c_pc[9:2];
    let mrp_hit   : logic     = mrp_tab_q[mrp_idx]; // dynamic index: comb read only, never in always_ff
    let mrp_refetch: logic    = (rename_fire && dec_op.pc == mrp_pc_q) || (rename_fire2 && dec_op2.pc == mrp_pc_q);
    let mrp_open  : logic     = commit_load_replay && !mrp_open_q;
    let mrp_close : logic     = mrp_open_q && rob_commit_ack && c_pc == mrp_pc_q;
    let mrp_trap  : logic     = mrp_open_q && !mrp_close && commit_trap;
    let mrp_cap   : logic     = mrp_open_q && !mrp_close && !mrp_trap && mrp_len_q >= MRP_CAP;
    // DBG_CENSUS: master gate for this whole diagnostic-counter block (the Phase-8 M0
    // perf counters + the L3 replay counter + the 28-bucket L4 census). Every one of
    // them drives an o_dbg_* port that reaches the heliodor_soc / heliodor_soc_smp TOP
    // LEVEL, so ungated they are REAL shipped hardware — 38 × 32 FF per hart plus the
    // increment cones, which hang off hot signals (lw_sole fans in from eight blocker
    // terms). At 0 the else-arm disappears, every register here is reset-only → DCE.
    // Flip to 1 (with rob.veryl's DBG_CENSUS) to re-measure; the counters are what the
    // L3/L4 censuses and the F2 front-end work were read off, so they stay in-tree.
    // rob_commit_cnt is deliberately NOT here — it is the `instret` figure every
    // regression gate quotes.
    const DBG_CENSUS: bit = 0;
    always_ff (clk, rst) {
        if_reset {
            mispredict_cnt    = 32'd0;
            redirect_cnt      = 32'd0;
            front_idle_cnt    = 32'd0;
            early_mispred_cnt = 32'd0;
            disp_stall_cnt    = 32'd0;
            mem_busy_cnt      = 32'd0;
            commit0_cnt       = 32'd0;
            load_wait_cnt     = 32'd0;
            load_replay_cnt   = 32'd0;
            for c in 0..128 {
                lw_cause_cnt[c] = 32'd0;
            }
            mrp_open_q        = 1'b0;
            mrp_pc_q          = 64'd0;
            mrp_len_q         = 32'd0;
            mrp_prev_q        = 64'd0;
            mrp_seen_q        = 1'b0;
            for t in 0..256 {
                mrp_tab_q[t] = 1'b0;
            }
        } else if DBG_CENSUS {
            if commit_load_replay {
                load_replay_cnt = load_replay_cnt + 32'd1;
            }
            // L4 census: sole-blocker attribution (see the declarations above).
            if lw_sole && lwc_lsr {
                lw_cause_cnt[0] = lw_cause_cnt[0] + 32'd1;
            }
            if lw_sole && lwc_mmu {
                lw_cause_cnt[1] = lw_cause_cnt[1] + 32'd1;
            }
            if lw_sole && lwc_walk {
                lw_cause_cnt[2] = lw_cause_cnt[2] + 32'd1;
            }
            if lw_sole && lwc_store {
                lw_cause_cnt[3] = lw_cause_cnt[3] + 32'd1;
            }
            if lw_sole && lwc_fpu {
                lw_cause_cnt[4] = lw_cause_cnt[4] + 32'd1;
            }
            if lw_sole && lwc_mshr {
                lw_cause_cnt[5] = lw_cause_cnt[5] + 32'd1;
            }
            if lw_sole && lwc_replay {
                lw_cause_cnt[6] = lw_cause_cnt[6] + 32'd1;
            }
            if lw_sole && lwc_redir {
                lw_cause_cnt[7] = lw_cause_cnt[7] + 32'd1;
            }
            if lw_plain && lw_n_causes >: 4'd1 {
                lw_cause_cnt[8] = lw_cause_cnt[8] + 32'd1; // two or more causes live
            }
            if lw_plain && lw_n_causes == 4'd0 {
                lw_cause_cnt[9] = lw_cause_cnt[9] + 32'd1; // sanity: should stay 0
            }
            if lw_stall && !iss_is_plain_load {
                lw_cause_cnt[10] = lw_cause_cnt[10] + 32'd1; // the AMO/LR/SC issue path
            }
            if lw_stall && iss_is_plain_load && mshr_capture {
                lw_cause_cnt[11] = lw_cause_cnt[11] + 32'd1; // acked via MSHR capture, not a stall
            }
            // Sub-partition of bucket 0 (lsr): why is the incumbent not completing?
            if lwl_drive && dcache_stall {
                lw_cause_cnt[12] = lw_cause_cnt[12] + 32'd1; // driving, waiting on the dcache (miss / fill)
            } else if lwl_drive {
                lw_cause_cnt[13] = lw_cause_cnt[13] + 32'd1; // read done, waiting for writeback lane 0
            } else if lwl && lsr_fault {
                lw_cause_cnt[14] = lw_cause_cnt[14] + 32'd1; // faulted, waiting for lane 0
            } else if lwl && store_drive {
                lw_cause_cnt[15] = lw_cause_cnt[15] + 32'd1; // port yielded to a committing store
            } else if lwl && !dmem_mmu_idle {
                lw_cause_cnt[16] = lw_cause_cnt[16] + 32'd1; // port yielded to an MMU walk
            } else if lwl && m_store_wr_busy {
                lw_cause_cnt[17] = lw_cause_cnt[17] + 32'd1; // port yielded to an in-flight store write
            } else if lwl && replay_q {
                lw_cause_cnt[18] = lw_cause_cnt[18] + 32'd1;
            } else if lwl {
                lw_cause_cnt[19] = lw_cause_cnt[19] + 32'd1; // sanity: should stay 0
            }
            // L4 step-2 diagnosis: replay_q RESIDENCY and why the armed replay is
            // not driving. Both lsr_capture and lsr_drive carry !replay_q, so every
            // cycle counted in [20] is a cycle in which no plain load may capture
            // and none may drive Stage B — an armed-but-starved replay holds the
            // whole load path hostage. [21..25]+[27] partition [20]-minus-[26].
            if replay_q {
                lw_cause_cnt[20] = lw_cause_cnt[20] + 32'd1;
            }
            if replay_q && replay_drive {
                lw_cause_cnt[26] = lw_cause_cnt[26] + 32'd1;
            } else if replay_q && store_drive {
                lw_cause_cnt[21] = lw_cause_cnt[21] + 32'd1;
            } else if replay_q && !dmem_mmu_idle {
                lw_cause_cnt[22] = lw_cause_cnt[22] + 32'd1;
            } else if replay_q && m_store_wr_busy {
                lw_cause_cnt[23] = lw_cause_cnt[23] + 32'd1;
            } else if replay_q && asq_dr_busy {
                lw_cause_cnt[24] = lw_cause_cnt[24] + 32'd1;
            } else if replay_q && asq_replay_ovl {
                lw_cause_cnt[25] = lw_cause_cnt[25] + 32'd1;
            } else if replay_q {
                lw_cause_cnt[27] = lw_cause_cnt[27] + 32'd1; // sanity: should stay 0
            }
            if c_bp_mispredict {
                mispredict_cnt = mispredict_cnt + 32'd1;
            }
            if redirect_fire {
                redirect_cnt = redirect_cnt + 32'd1;
            }
            if !redirect_fire && !if_v_q && !stall_dr {
                front_idle_cnt = front_idle_cnt + 32'd1;
            }
            if early_mispred_inc != 32'd0 {
                early_mispred_cnt = early_mispred_cnt + early_mispred_inc;
            }
            if stall_dr && !any_redirect {
                disp_stall_cnt = disp_stall_cnt + 32'd1;
            }
            if core_dmem_ren || core_dmem_wen || dcache_stall {
                mem_busy_cnt = mem_busy_cnt + 32'd1;
            }
            // ── W1 rename-width census (buckets 28-39) ──
            // The machine is 2-wide at rename on paper, but slot-1 takes only a simple
            // integer ALU op (dec_op2_eligible), so a bundle whose younger op is a
            // load / store / branch drops to 1-wide. Measured IPC sits at ~1.0
            // (dhrystone 264,834 instret / 263,395 cy), which is what a 1-wide rename
            // caps at. This census ROUTES the widening work: it says whether the second
            // slot is lost to the ELIGIBILITY restriction (→ widen slot-1's datapath) or
            // to RESOURCES (→ deepen ROB/PRF/IQ) or to the front end not delivering a
            // second instruction at all (→ fetch/decode width).
            // ⚠️ Sole-blocker attribution again bounds the OPPORTUNITY, not the PRIZE —
            // that is exactly what L4 step-2 proved. Use it to choose WHERE to build,
            // never to predict what the build is worth (build DEAD, flip, read cycles).
            if rw_1wide {
                lw_cause_cnt[28] = lw_cause_cnt[28] + 32'd1;
            }
            if rw_sole && rw_blk_no2 {
                lw_cause_cnt[29] = lw_cause_cnt[29] + 32'd1;
            }
            if rw_sole && rw_blk_elig {
                lw_cause_cnt[30] = lw_cause_cnt[30] + 32'd1;
            }
            if rw_sole && rw_blk_res {
                lw_cause_cnt[31] = lw_cause_cnt[31] + 32'd1;
            }
            if rw_1wide && rw_n >= 2'd2 {
                lw_cause_cnt[32] = lw_cause_cnt[32] + 32'd1;
            }
            if rename_fire2 {
                lw_cause_cnt[33] = lw_cause_cnt[33] + 32'd1;
            }
            if !rename_fire && if_v_q {
                lw_cause_cnt[34] = lw_cause_cnt[34] + 32'd1;
            }
            if !if_v_q {
                lw_cause_cnt[35] = lw_cause_cnt[35] + 32'd1;
            }
            // Why the second op was ineligible (only when one was actually there).
            if rw_1wide && rw_have2 && rw_blk_elig && dec_op2.is_load {
                lw_cause_cnt[36] = lw_cause_cnt[36] + 32'd1;
            }
            if rw_1wide && rw_have2 && rw_blk_elig && (dec_op2.is_store || dec_op2.is_amo) {
                lw_cause_cnt[37] = lw_cause_cnt[37] + 32'd1;
            }
            if rw_1wide && rw_have2 && rw_blk_elig && (dec_op2.is_branch || dec_op2.is_jal || dec_op2.is_jalr) {
                lw_cause_cnt[38] = lw_cause_cnt[38] + 32'd1;
            }
            if rw_1wide && rw_have2 && rw_blk_elig && !dec_op2.is_load && !dec_op2.is_store && !dec_op2.is_amo
                && !dec_op2.is_branch && !dec_op2.is_jal && !dec_op2.is_jalr {
                lw_cause_cnt[39] = lw_cause_cnt[39] + 32'd1;
            }
            // ── W2 front-end delivery census (buckets 40-51) ──
            // The W1a flip proved the front end is the binding constraint: renaming 26 %
            // wider only drained the FIFO faster, and `front end empty` + `no 2nd in
            // FIFO` grew by +958k to 5,260,480 cy = 36 % of the boot. Split BOTH halves.
            // 40-45: why is the fetch FIFO EMPTY at rename? 46-51: why was slot-1 not
            // PRODUCED on a cycle the front end did produce slot-0?
            if !if_v_q && !any_redirect && !fetch_ready {
                lw_cause_cnt[40] = lw_cause_cnt[40] + 32'd1;
            }
            if !if_v_q && any_redirect {
                lw_cause_cnt[41] = lw_cause_cnt[41] + 32'd1;
            }
            if !if_v_q && !any_redirect && fetch_ready {
                lw_cause_cnt[42] = lw_cause_cnt[42] + 32'd1;
            }
            // …and when fetch is not ready, whose fault is it: the fetch-ahead FIFO
            // (icache miss / I-PTW / the run-ahead not keeping up) or a straddle?
            if !if_v_q && !any_redirect && !fetch_ready && !ext_head_avail {
                lw_cause_cnt[43] = lw_cause_cnt[43] + 32'd1;
            }
            if !if_v_q && !any_redirect && !fetch_ready && ext_head_avail && needs_straddle_slow {
                lw_cause_cnt[44] = lw_cause_cnt[44] + 32'd1;
            }
            if !if_v_q && !any_redirect && !fetch_ready && ext_head_avail && !needs_straddle_slow {
                lw_cause_cnt[45] = lw_cause_cnt[45] + 32'd1;
            }
            // Produce side. slot1_pred_ok is `!predicted_taken`, so a predicted-taken
            // slot-0 STRUCTURALLY ends the bundle — that is the fetch-block shape, not a
            // stall, and it is the term a wider fetch block would attack.
            if fb_push0 && !slot1_valid && !slot1_pred_ok {
                lw_cause_cnt[46] = lw_cause_cnt[46] + 32'd1;
            }
            if fb_push0 && !slot1_valid && slot1_pred_ok && (straddle_q || straddle_oneshot) {
                lw_cause_cnt[47] = lw_cause_cnt[47] + 32'd1;
            }
            if fb_push0 && !slot1_valid && slot1_pred_ok && !straddle_q && !straddle_oneshot && s1_needs_next {
                lw_cause_cnt[48] = lw_cause_cnt[48] + 32'd1;
            }
            if fb_push0 && !slot1_valid && slot1_pred_ok && !straddle_q && !straddle_oneshot && !s1_needs_next {
                lw_cause_cnt[49] = lw_cause_cnt[49] + 32'd1;
            }
            if fb_push0 && slot1_valid && fb_free <: 4'd2 {
                lw_cause_cnt[50] = lw_cause_cnt[50] + 32'd1;
            }
            if fb_push1 {
                lw_cause_cnt[51] = lw_cause_cnt[51] + 32'd1;
            }
            // ── W2b producer census (buckets 52-59) ──
            // Population = the W2 bucket-43 cycles: the extract side wants a dword and
            // ext_head_avail is false. That has TWO causes needing OPPOSITE fixes, and
            // ext_head_match = (wf_count >= 1) && (wf_pc[wf_head] == ext_head_dw)
            // separates them. (wf_pc[wf_head] is a dynamic array index and must not be
            // read in an always_ff — the Veryl sim hangs — so split on wf_count alone,
            // which is exact: count>=1 with !avail IS the address mismatch.)
            if !if_v_q && !any_redirect && !fetch_ready && !ext_head_avail && wf_count == 4'd0 {
                lw_cause_cnt[52] = lw_cause_cnt[52] + 32'd1;
            }
            if !if_v_q && !any_redirect && !fetch_ready && !ext_head_avail && wf_count != 4'd0 {
                lw_cause_cnt[53] = lw_cause_cnt[53] + 32'd1;
            }
            // …and on those cycles, why is the PRODUCER not presenting a fetch?
            // f0_present's own terms, priority-ordered so they partition.
            if !if_v_q && !any_redirect && !fetch_ready && !ext_head_avail && !f0_present && icache_stall_comb {
                lw_cause_cnt[54] = lw_cause_cnt[54] + 32'd1;
            }
            if !if_v_q && !any_redirect && !fetch_ready && !ext_head_avail && !f0_present && !icache_stall_comb
                && !(imem_valid_w || imem_fault_w || imem_acc_fault_w) {
                lw_cause_cnt[55] = lw_cause_cnt[55] + 32'd1;
            }
            if !if_v_q && !any_redirect && !fetch_ready && !ext_head_avail && !f0_present && !icache_stall_comb
                && (imem_valid_w || imem_fault_w || imem_acc_fault_w) && wf_full {
                lw_cause_cnt[56] = lw_cause_cnt[56] + 32'd1;
            }
            if !if_v_q && !any_redirect && !fetch_ready && !ext_head_avail && !f0_present && !icache_stall_comb
                && (imem_valid_w || imem_fault_w || imem_acc_fault_w) && !wf_full {
                lw_cause_cnt[57] = lw_cause_cnt[57] + 32'd1;
            }
            if !if_v_q && !any_redirect && !fetch_ready && !ext_head_avail && f0_present {
                lw_cause_cnt[58] = lw_cause_cnt[58] + 32'd1;
            }
            if wf_do_push {
                lw_cause_cnt[59] = lw_cause_cnt[59] + 32'd1;
            }
            // ── M0 replay-cost census (buckets 60-71) ──
            if mrp_open {
                mrp_open_q      = 1'b1;
                mrp_pc_q        = c_pc;
                mrp_len_q       = 32'd0;
                mrp_prev_q      = c_pc;
                mrp_seen_q      = 1'b0;
                lw_cause_cnt[61] = lw_cause_cnt[61] + 32'd1;                        // events (deduped)
                lw_cause_cnt[62] = lw_cause_cnt[62] + ({24'd0, rob_size} as 32);    // squash volume proxy
                mrp_tab_q[mrp_idx] = 1'b1;
                if mrp_hit {
                    lw_cause_cnt[63] = lw_cause_cnt[63] + 32'd1;                    // load-wait-table hit = predictable
                }
                if c_pc == mrp_prev_q {
                    lw_cause_cnt[69] = lw_cause_cnt[69] + 32'd1;                    // same PC as the previous replay
                }
            } else if mrp_open_q {
                mrp_len_q        = mrp_len_q + 32'd1;
                lw_cause_cnt[60] = lw_cause_cnt[60] + 32'd1;                        // total recovery cycles
                if commit_load_replay {
                    lw_cause_cnt[70] = lw_cause_cnt[70] + 32'd1;                    // re-poisoned inside the window
                }
                if !mrp_seen_q && mrp_refetch {
                    mrp_seen_q       = 1'b1;
                    lw_cause_cnt[72] = lw_cause_cnt[72] + mrp_len_q;                // REFETCH half (selective replay deletes this)
                    lw_cause_cnt[73] = lw_cause_cnt[73] + 32'd1;                    // windows where the refetch was observed
                }
                if mrp_close {
                    mrp_open_q       = 1'b0;
                    lw_cause_cnt[64] = lw_cause_cnt[64] + 32'd1;                    // closed by the load re-committing
                    lw_cause_cnt[71] = lw_cause_cnt[71] + mrp_len_q;                // cycles from CLEAN windows only
                    if mrp_len_q >: lw_cause_cnt[67] {
                        lw_cause_cnt[67] = mrp_len_q;                               // worst clean window
                    }
                } else if mrp_trap {
                    mrp_open_q       = 1'b0;
                    lw_cause_cnt[65] = lw_cause_cnt[65] + 32'd1;                    // a trap intervened
                } else if mrp_cap {
                    mrp_open_q       = 1'b0;
                    lw_cause_cnt[66] = lw_cause_cnt[66] + 32'd1;                    // runaway, abandoned
                }
            }
            if commit_amo_replay {
                lw_cause_cnt[68] = lw_cause_cnt[68] + 32'd1;                        // the AMO sibling, for context
            }
            // M1: is there a SOUND version of the 0.88 % the self-scan costs?
            if lq_self_fire {
                lw_cause_cnt[74] = lw_cause_cnt[74] + 32'd1;                        // self-scan poisons
            }
            if lq_self_nopa {
                lw_cause_cnt[75] = lw_cause_cnt[75] + 32'd1;                        // ...raised WITHOUT a PA pair (approximation only)
            }
            if lq_p1_nomask {
                lw_cause_cnt[76] = lw_cause_cnt[76] + 32'd1;                        // M2a: the same question, asked inside the LQ
            }
            if lq_self_spamis {
                lw_cause_cnt[77] = lw_cause_cnt[77] + 32'd1;                        // ...decided with a store PA that is not the store's
            }
            // M2a soundness: every suppression must coincide with the byte network
            // actually delivering bytes. A suppression on a cycle where the net's own
            // mask is EMPTY would mean the guard was load-bearing and the exemption
            // is unsound — bucket 75 must stay 0.
            if lq_p1_exempt {
                lw_cause_cnt[74] = lw_cause_cnt[74] + 32'd1;                        // M2a: poisons suppressed
            }
            if lq_p1_exempt && sf_rob_mask == 8'd0 {
                lw_cause_cnt[75] = lw_cause_cnt[75] + 32'd1;                        // M2a: ...with NOTHING forwarded (must be 0)
            }
            if lq_self_p0 {
                lw_cause_cnt[78] = lw_cause_cnt[78] + 32'd1;                        // M2: port 0 = the Stage-B record the byte net covers
            }
            if lq_self_p2 {
                lw_cause_cnt[79] = lw_cause_cnt[79] + 32'd1;                        // M2: port 2 = an MSHR fill, which the byte net never sees
            }
            // ── Block T LSR-turnaround census (buckets 80-87) ──
            if lwt_b2b {
                lw_cause_cnt[80] = lw_cause_cnt[80] + 32'd1;                        // LSR_B2B prize: slot frees + a load is ready
            }
            if lwt_mshr {
                lw_cause_cnt[81] = lw_cause_cnt[81] + 32'd1;                        // ...the same, on the MSHR Stage-B handoff
            }
            if lwt_idle {
                lw_cause_cnt[82] = lw_cause_cnt[82] + 32'd1;                        // slot frees, nothing ready to take it
            }
            if lwt_busy {
                lw_cause_cnt[83] = lw_cause_cnt[83] + 32'd1;                        // a load is ready, incumbent genuinely busy (not Block T's)
            }
            if lwt_lane0 {
                lw_cause_cnt[84] = lw_cause_cnt[84] + 32'd1;                        // bucket 13 minus the turnaround = the REAL lane-0 wait (FP)
            }
            if lsr_capture {
                lw_cause_cnt[85] = lw_cause_cnt[85] + 32'd1;                        // loads captured (denominator)
            }
            if lwt_free {
                lw_cause_cnt[86] = lw_cause_cnt[86] + 32'd1;                        // loads completed (denominator)
            }
            if lsr_v_q {
                lw_cause_cnt[87] = lw_cause_cnt[87] + 32'd1;                        // LSR residency
            }
            // ── Block T follow-on census (buckets 88-95) ──
            // 88-93 decompose the `store` sole-blocker bucket, which Block T left as the
            // LARGEST one in loadwait (711,676 cy = 5.4 % of the boot, vs `lsr` 732,911
            // that is now 100 % dcache miss). load_blocks_on_store ORs eight terms and
            // several of them are the SAME committed-store-drain policy LSR_B2B_SBQ
            // enforces at the capture gate, so this split prices both candidates at
            // once. Priority-encoded so they partition bucket 3 exactly.
            // 94-95 price LSR_B2B_SBQ itself: 94 is the b2b capture it SUPPRESSES (the
            // exact population its 0.23 pp on the N=1 boot comes from), 95 the ones that
            // fire. The open question is whether 94/95 grows with hart count the way
            // Block T's gain did — read them at N=1/N=2/N=4.
            if lw_sole && lwc_store && store_drive {
                lw_cause_cnt[88] = lw_cause_cnt[88] + 32'd1;
            } else if lw_sole && lwc_store && sb_cnt >= 4'd3 {
                lw_cause_cnt[89] = lw_cause_cnt[89] + 32'd1;
            }
            // ── Block L1.b routing census (buckets 90-93, REPURPOSED 2026-08-19) ──
            // These four were Block T's tail split of the `store` sole-blocker bucket
            // (asq_dr_busy 9,997 / asq_ld_ovl 0 / page-edge 9 / other 0 = 10,006 cy total,
            // recorded in cp_store_queue_plan.md §12 — negligible, and reclaimed here).
            // L1.a took the shared dmem port off every PRE-TRANSLATED store. What is left
            // holding it? 90 is the denominator (committing stores), 91 the port-hold
            // residency, and 92/93 split that residency into the half L1.b can attack (a
            // plain store still translating at commit — the sb_2cyc_ok population, which
            // an SQ translate retry would move to execute) and the half it cannot (an
            // atomic, which is R3's territory and must serialize at the head anyway).
            // ⚠️ Bucket 88 (`store_drive` as the SOLE blocker of a waiting load) is kept
            // unchanged as the yardstick — it is what L1.a was priced against.
            // ── Pass 2: WHY does the execute-time store probe miss? ──
            // Pass 1 said L1.b's IPC ceiling is 6,348 cy (store_drive as a waiting load's
            // SOLE blocker), so L1.b is a STRUCTURAL step, not an IPC one. This pass sizes
            // the BUILD instead: a store whose probe missed because the PORT was busy is
            // fixed by a cheap retry in an idle cycle; one that missed because the TLB
            // missed needs a SPECULATIVE STORE WALK, an order of magnitude more machine.
            // Priority-encoded so 91/92/93 partition 90 exactly.
            let l1b_ev  : logic = cdb.valid && cdb.is_store && !iq_iss_is_amo;
            let l1b_port: logic = store_drive || mmu_walk_inflight || vu_mem_active;
            if l1b_ev {
                lw_cause_cnt[90] = lw_cause_cnt[90] + 32'd1;                         // store execute events (denominator)
            }
            if l1b_ev && store_pretx_valid {
                lw_cause_cnt[91] = lw_cause_cnt[91] + 32'd1;                         // probe FIRED — PA registered at execute
            } else if l1b_ev && l1b_port {
                lw_cause_cnt[92] = lw_cause_cnt[92] + 32'd1;                         // missed: the shared port was busy -> a RETRY fixes it
            } else if l1b_ev && !dmem_sprobe_ok {
                lw_cause_cnt[93] = lw_cause_cnt[93] + 32'd1;                         // missed: TLB/perm/cacheability -> needs a store WALK
            }
            if lsr_b2b_spec && lsr_complete && sdrain_swen {
                lw_cause_cnt[94] = lw_cause_cnt[94] + 32'd1;                        // b2b SUPPRESSED by LSR_B2B_SBQ
            }
            if lsr_b2b_free {
                lw_cause_cnt[95] = lw_cause_cnt[95] + 32'd1;                        // b2b captures that fired
            }
            // ── Block N census (buckets 96-107): memory-level parallelism ──
            // The read path is ONE deep at four consecutive levels (cp_mshr_mlp_plan.md §2):
            // the 2-entry core queue, the dcache's single fill FSM, the core's single DRAM
            // read channel (shared with the instruction side), and mem_ctrl's one slot per
            // hart. These buckets say WHERE the cycles are; the O1 latency oracle already
            // says HOW MANY there are to win (DRAM_WAIT/HIT_WAIT=1 -> 11,480,000 vs
            // 12,370,000 = 890,000 cy = 7.20 % of the N=1 boot), so they must add to less.
            // 96-98 size the D-side serialization: a fill in flight, and whether a SECOND
            // miss is already known while it runs (97 = the MLP>=2 ceiling — those are the
            // cycles a second fill context could overlap).
            // 99/100 are the two reasons a Stage-B handoff is DECLINED: a full queue (what
            // sizing alone would fix) vs QUE_FILLONLY (case (b) — our own miss waiting for
            // the bus grant, which needs the dcache to hold the request itself).
            // 101-105 size the I/D channel split; 101 is its direct ceiling.
            let nx_miss_wait: logic = lsr_v_q && lsr_drive && dcache_stall && !dc_hit_safe && !dc_miss_valid;
            let nx_full_rej : logic = lsr_mshr_elig && !mshr_free_ok && nx_miss_wait;
            let nx_fo_rej   : logic = lsr_mshr_ok && lsr_drive && !dc_miss_valid && dcache_stall
                && !dc_hit_safe && !i_dcache_inv_valid && !i_dcache_inv2_valid && !fill_busy_q;
            if fill_busy_q {
                lw_cause_cnt[96] = lw_cause_cnt[96] + 32'd1;                        // a dcache fill is in flight
            }
            if fill_busy_q && (mshra_queued || mshrb_queued) {
                lw_cause_cnt[97] = lw_cause_cnt[97] + 32'd1;                        // ... and a SECOND miss is queued (MLP>=2 ceiling)
            }
            if fill_busy_q && nx_miss_wait {
                lw_cause_cnt[98] = lw_cause_cnt[98] + 32'd1;                        // ... and the LSR also holds a missing load
            }
            if nx_full_rej {
                lw_cause_cnt[99] = lw_cause_cnt[99] + 32'd1;                        // handoff declined: the queue was FULL
            }
            if nx_fo_rej {
                lw_cause_cnt[100] = lw_cause_cnt[100] + 32'd1;                      // handoff declined: not FILL
            }
            // N2.2b: SPLIT bucket 100 by the D-cache's reason for stalling. Bucket 100 is
            // the whole population QUE_SCOPE=2 hands off and QUE_SCOPE=0 declines; only
            // the ALLOC slice (121) is the case (b) the ALLOC state was built to serve,
            // and only that slice is safe (QUE_SCOPE=1). The rest are cycles where the
            // load's miss has not been recorded anywhere yet. 127 is the denominator that
            // says whether ALLOC is ever entered at all.
            if nx_fo_rej && dc_stall_why[0] {
                lw_cause_cnt[120] = lw_cause_cnt[120] + 32'd1;                      // ... a fill is RUNNING (skew vs fill_busy_q)
            }
            if nx_fo_rej && dc_stall_why[1] {
                lw_cause_cnt[121] = lw_cause_cnt[121] + 32'd1;                      // ... an entry HOLDS a line = case (b)
            }
            if nx_fo_rej && dc_stall_why[2] {
                lw_cause_cnt[122] = lw_cause_cnt[122] + 32'd1;                      // ... a miss, not yet allocated
            }
            if dc_stall_why[0] {
                lw_cause_cnt[123] = lw_cause_cnt[123] + 32'd1;                      // D-cache FILL cycles, ANY requester
            }
            if nx_fo_rej && (dc_stall_why[5] || dc_stall_why[7]) {
                lw_cause_cnt[125] = lw_cause_cnt[125] + 32'd1;                      // ... an inv race / sync-read gap / MMIO
            }
            if nx_fo_rej && dc_stall_why[6] {
                lw_cause_cnt[126] = lw_cause_cnt[126] + 32'd1;                      // ... the registered Stage-A hit path
            }
            if dc_mshr_alloc {
                lw_cause_cnt[127] = lw_cause_cnt[127] + 32'd1;                      // ALLOC cycles, ANY requester (denominator)
            }
            if ic_owns && dc_mem_req {
                lw_cause_cnt[101] = lw_cause_cnt[101] + 32'd1;                      // I-side owns the channel, D-side waiting
            }
            if is_req && dc_mem_req && !ic_owns {
                lw_cause_cnt[102] = lw_cause_cnt[102] + 32'd1;                      // I-side yields to the D-side
            }
            if dc_mem_req && !i_dmem_grant {
                lw_cause_cnt[103] = lw_cause_cnt[103] + 32'd1;                      // D request not granted
            }
            if ic_route {
                lw_cause_cnt[104] = lw_cause_cnt[104] + 32'd1;                      // I-side using the channel
            }
            if dc_mem_req {
                lw_cause_cnt[105] = lw_cause_cnt[105] + 32'd1;                      // D request cycles (denominator)
            }
            if dc_miss_valid {
                lw_cause_cnt[106] = lw_cause_cnt[106] + 32'd1;                      // fill starts (events)
            }
            if !fill_busy_q && !ic_route && !dc_mem_req {
                lw_cause_cnt[107] = lw_cause_cnt[107] + 32'd1;                      // the memory system is idle
            }
            // ── Block N census PASS 2 (buckets 108-115) ──
            // Pass 1's surprise: bucket 103 (a D-side read request the bus does not grant) is
            // 1,612,034 cy = 13.03 % of the N=1 boot, while the fill FSM is only busy for
            // 740,402 (bucket 96) and the I-side conflict explains just 146,647 (bucket 101).
            // So most of the ungranted time is spent BEFORE the fill starts. Split it: 108 is
            // the part inside a running fill (its DWAIT/HWAIT/gather latency, which is what O1
            // deleted), 109 the part before one starts, and 110-112 partition 109 into the
            // I-side conflict, an uncached/MMIO single-beat read (never a fill at all), and
            // the remainder = mem_ctrl declining to ACCEPT.
            // 113/114 re-ask pass 1's MLP question without the fill_busy_q qualifier: a queued
            // entry waits through the accept delay too, so bucket 97 UNDERSTATES the population
            // by exactly the amount 109 turns out to be.
            let nx_unc_eff: logic = if lsr_drive ? lsr_unc_q : (dmem_unc_m && !replay_drive);
            let nx_ngrant : logic = dc_mem_req && !i_dmem_grant;
            let nx_pre    : logic = nx_ngrant && !fill_busy_q;
            if nx_ngrant && fill_busy_q {
                lw_cause_cnt[108] = lw_cause_cnt[108] + 32'd1;                      // ungranted INSIDE a running fill
            }
            if nx_pre {
                lw_cause_cnt[109] = lw_cause_cnt[109] + 32'd1;                      // ungranted BEFORE a fill starts
            }
            // N2.2b: fill_busy_q is set by dc_miss_valid, which o_miss_valid qualifies with
            // m_ld_q (a LOAD demanded the fill) — so a store-RFO fill is INVISIBLE to it, and
            // every bucket here that reads !fill_busy_q calls an RFO fill's own burst beats
            // "before a fill starts". 124 measures that blind spot directly: how much of
            // nx_pre is really INSIDE a D-cache fill. (123 is the matching denominator.)
            if nx_pre && dc_stall_why[0] {
                lw_cause_cnt[124] = lw_cause_cnt[124] + 32'd1;                      // "pre-fill" ungranted while the D-cache IS filling
            }
            if nx_pre && ic_owns {
                lw_cause_cnt[110] = lw_cause_cnt[110] + 32'd1;                      // ... the I-side holds the channel
            } else if nx_pre && nx_unc_eff {
                lw_cause_cnt[111] = lw_cause_cnt[111] + 32'd1;                      // ... an uncached/MMIO read (no fill)
            } else if nx_pre {
                lw_cause_cnt[112] = lw_cause_cnt[112] + 32'd1;                      // ... mem_ctrl declines to ACCEPT
            }
            if mshra_queued || mshrb_queued {
                lw_cause_cnt[113] = lw_cause_cnt[113] + 32'd1;                      // a queued entry is waiting (any reason)
            }
            if (mshra_queued || mshrb_queued) && !fill_busy_q {
                lw_cause_cnt[114] = lw_cause_cnt[114] + 32'd1;                      // ... with no fill in flight at all
            }
            if dcache_stall {
                lw_cause_cnt[115] = lw_cause_cnt[115] + 32'd1;                      // dcache holding the core (denominator)
            }
            // ── Block N census PASS 3 (buckets 116-119) ──
            // Pass 2 put 1,056,043 cy (8.54 %) in "mem_ctrl declines to ACCEPT", which is
            // larger than the whole fill-busy bucket and cannot be the I-side (that is 110)
            // or MMIO (111 = 0). The suspect is a definitional hole rather than a new
            // stall: `fill_busy_q` is SET from `dc_miss_valid`, and dcache.veryl's
            // o_miss_valid comment says "store-RFO fills never pulse it (no load to
            // capture)". So a store's read-for-ownership fill occupies the mem_ctrl slot
            // and holds `o_memr_req` for its whole 12-40 cycle transaction while
            // fill_busy_q reads 0 — landing in 112 by construction. Split 112 by
            // `dc_mem_rfo` to confirm, and count the RFO traffic itself (118/119).
            if nx_pre && !ic_owns && dc_mem_rfo {
                lw_cause_cnt[116] = lw_cause_cnt[116] + 32'd1;                      // ... an RFO (store ownership) fill is running
            } else if nx_pre && !ic_owns && !nx_unc_eff {
                lw_cause_cnt[117] = lw_cause_cnt[117] + 32'd1;                      // ... genuinely waiting for an ACCEPT
            }
            if dc_mem_rfo {
                lw_cause_cnt[118] = lw_cause_cnt[118] + 32'd1;                      // RFO request cycles
            }
            if dc_mem_rfo && !i_dmem_grant {
                lw_cause_cnt[119] = lw_cause_cnt[119] + 32'd1;                      // RFO cycles not granted
            }
            if !rob_commit_ack {
                commit0_cnt = commit0_cnt + 32'd1;
            }
            if issue_is_load && !iq_issue_ack {
                load_wait_cnt = load_wait_cnt + 32'd1;
            }
        }
    }
    // P10 Zihpm: pack the per-cycle perf events for the CSR's mhpmcounters. The
    // conditions mirror the debug counters above (event N selected by mhpmevent
    // = N): 1 mispredict, 2 redirect, 3 front-idle, 4 dispatch-stall,
    // 5 mem-port-busy, 6 retire-stall, 7 load-issue-wait, 8 reserved.
    // (`hpm_events` is declared up by the u_csr instance; driven here so the late
    // pipeline signals it reads are already in scope.)
    always_comb {
        hpm_events = {
            1'b0, // bit 7: reserved
            issue_is_load && !iq_issue_ack, // bit 6: load-issue wait
            !rob_commit_ack, // bit 5: retire stall (no commit)
            core_dmem_ren || core_dmem_wen || dcache_stall, // bit 4: mem-port busy
            stall_dr && !any_redirect, // bit 3: dispatch stall
            !redirect_fire && !if_v_q && !stall_dr, // bit 2: front-end idle
            redirect_fire, // bit 1: redirect
            c_bp_mispredict // bit 0: branch mispredict
        };
    }

    assign o_dbg_mispredict_cnt       = mispredict_cnt;
    assign o_dbg_redirect_cnt         = redirect_cnt;
    assign o_dbg_front_idle_cnt       = front_idle_cnt;
    assign o_dbg_early_mispredict_cnt = early_mispred_cnt;
    assign o_dbg_disp_stall_cnt       = disp_stall_cnt;
    assign o_dbg_mem_busy_cnt         = mem_busy_cnt;
    assign o_dbg_commit0_cnt          = commit0_cnt;
    assign o_dbg_load_wait_cnt        = load_wait_cnt;
    assign o_dbg_load_viol_cnt        = rob_load_viol_cnt_w;
    assign o_dbg_load_replay_cnt      = load_replay_cnt;
    assign o_dbg_inv_viol_cnt         = rob_inv_viol_cnt_w;
    assign o_dbg_mshr_pois_cnt        = rob_mshr_pois_cnt_w;
    assign o_dbg_viol_exact_cnt       = rob_viol_exact_cnt_w;
    assign o_dbg_viol_pgx_cnt         = rob_viol_pgx_cnt_w;
    assign o_dbg_st_resolve_cnt       = rob_st_resolve_cnt_w;
    always_ff (clk, rst) {
        if_reset {} else if B2B_SUP_TRACE {
            if trc_cy_q % B2B_SUP_EVERY == 32'd0 && trc_cy_q != 32'd0 {
                $display("B2BSUP h=%d cy=%d suppressed=%d fired=%d", HART_ID, trc_cy_q, lw_cause_cnt[94], lw_cause_cnt[95]);
            }
        }
    }
    assign o_dbg_lw_cause             = lw_cause_cnt;
    assign o_dbg_viol_store_cnt       = rob_viol_store_cnt_w;
    assign o_dbg_viol_self_cnt        = rob_viol_self_cnt_w;
    assign o_dbg_rob_size       = rob_size;
    assign o_dbg_if_v           = if_v_q;
    assign o_dbg_if_instr       = if_instr_q;
    assign o_dbg_stall_dr       = stall_dr;
    assign o_dbg_head_valid     = rob_head_valid;
    assign o_dbg_head_rw        = rob_head_rw;
    assign o_dbg_head_illegal   = rob_head_illegal;
    assign o_dbg_rob_alloc_cnt  = rob_alloc_cnt_w;
    assign o_dbg_rob_cdb_cnt    = rob_cdb_cnt_w;
    assign o_dbg_rob_commit_cnt = rob_commit_cnt_w;
    assign o_dbg_rob_head       = rob_head_w;
    assign o_dbg_rob_tail       = rob_tail_w;
    // M9 LSU diag
    assign o_dbg_dmem_mmu_busy     = dmem_mmu_busy;
    assign o_dbg_core_dmem_vaddr   = core_dmem_vaddr;
    assign o_dbg_core_dmem_wen     = core_dmem_wen;
    assign o_dbg_core_dmem_ren     = core_dmem_ren;
    assign o_dbg_imem_ptw_req      = imem_ptw_req_w;
    assign o_dbg_commit_store_fire = commit_store_fire;
    // M9.A.292: AGU snoop assignments
    assign o_dbg_agu_issue_v   = iq_issue_valid;
    assign o_dbg_agu_rs1_arch  = iq_iss_rs1_arch;
    assign o_dbg_agu_rs1_pdst  = iq_iss_rs1_pdst;
    assign o_dbg_agu_rs1_data  = prf_rs1_data;
    assign o_dbg_agu_imm       = agu_imm_iss;
    assign o_dbg_agu_addr      = agu_addr_iss;
    assign o_dbg_agu_is_load   = issue_is_load;
    assign o_dbg_agu_is_store  = issue_is_st;
    assign o_dbg_agu_rob_idx   = iq_iss_rob_idx;
    assign o_dbg_walk_v        = walk_v_q;
    assign o_dbg_walk_rob      = walk_rob_q;
    assign o_dbg_walk_vaddr    = walk_vaddr_q;
    assign o_dbg_lfault_inj    = lfault_inj_v;
    assign o_dbg_orphan_walk   = orphan_walk_fault;
    assign o_dbg_walk_phys     = walk_phys_q;
    assign o_dbg_walk_start    = dmem_walk_start;
    assign o_dbg_dmem_idle     = dmem_mmu_idle;
    assign o_dbg_dlk_seen      = dlk_seen_q;
    assign o_dbg_dlk_genuine   = dlk_genuine_q;
    assign o_dbg_dlk_inj       = dlk_inj_q;
    assign o_dbg_dlk_stval     = dlk_stval_q;
    assign o_dbg_dlk_pc        = dlk_pc_q;
    assign o_dbg_dlk_walkpc    = dlk_walkpc_q;
    assign o_dbg_csr_sum       = csr_sum;
    assign o_dbg_csr_mxr       = csr_mxr;
    assign o_dbg_csr_dmem_priv = if dmem_eff_priv == csr_pkg::PrivLevel::MACHINE ?
        2'b11
    : if dmem_eff_priv == csr_pkg::PrivLevel::SUPERVISOR ?
        2'b01
    :
        2'b00
    ;
    // M9.A.303 debug
    assign o_dbg_dmem_fault = dmem_mmu_fault;
    assign o_dbg_dmem_vaddr = core_dmem_vaddr;
    assign o_dbg_fl_push_en    = fl_push_en;
    assign o_dbg_commit_rd     = c_rd_arch;
    assign o_dbg_commit_pdst   = c_rd_pdst;
    assign o_dbg_dptw_req   = dmem_dptw_req;
    assign o_dbg_dptw_addr  = dmem_dptw_addr;
    assign o_dbg_dpte       = dmem_dpte;
    assign o_dbg_dtlb_hit   = dmem_dtlb_hit;
    assign o_dbg_dtlb_ppn   = dmem_dtlb_ppn;
    assign o_dbg_dtlb_perm  = dmem_dtlb_perm;

}
