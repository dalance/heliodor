        sf7_v || sbf7_v, sf6_v || sbf6_v, sf5_v || sbf5_v, sf4_v || sbf4_v,
        sf3_v || sbf3_v, sf2_v || sbf2_v, sf1_v || sbf1_v, sf0_v || sbf0_v
    };
    // Slot-1 twin (bare mode only — ld2_complete requires !dmem_vm_on, so the
    // PA is the AGU VA and no translation is involved).
    var sbg0_v: logic; var sbg0_b: logic<8>;
    var sbg1_v: logic; var sbg1_b: logic<8>;
    var sbg2_v: logic; var sbg2_b: logic<8>;
    var sbg3_v: logic; var sbg3_b: logic<8>;
    var sbg4_v: logic; var sbg4_b: logic<8>;
    var sbg5_v: logic; var sbg5_b: logic<8>;
    var sbg6_v: logic; var sbg6_b: logic<8>;
    var sbg7_v: logic; var sbg7_b: logic<8>;
    always_comb {
        sbg0_v = 1'b0; sbg0_b = 8'd0;
        if stld_fwd_en2 {
            let ba: logic<64> = agu_addr_iss2 + 64'd0;
            for i in 0..SB_N {
                if (i as 4) <: sb_cnt && sb_line[i] == ba[63:6] && sb_strb[{(i as 2), ba[5:3]}][ba[2:0]] {
                    let d: logic<64> = sb_data[{(i as 2), ba[5:3]}] >> {ba[2:0], 3'b000};
                    sbg0_v = 1'b1; sbg0_b = d[7:0];
                }
            }
            if sb_push && sb_pa[63:3] == ba[63:3] && st_wstrb[ba[2:0]] {
                let d: logic<64> = st_wdata >> {ba[2:0], 3'b000};
                sbg0_v = 1'b1; sbg0_b = d[7:0];
            }
        }
    }
    always_comb {
        sbg1_v = 1'b0; sbg1_b = 8'd0;
        if stld_fwd_en2 {
            let ba: logic<64> = agu_addr_iss2 + 64'd1;
            for i in 0..SB_N {
                if (i as 4) <: sb_cnt && sb_line[i] == ba[63:6] && sb_strb[{(i as 2), ba[5:3]}][ba[2:0]] {
                    let d: logic<64> = sb_data[{(i as 2), ba[5:3]}] >> {ba[2:0], 3'b000};
                    sbg1_v = 1'b1; sbg1_b = d[7:0];
                }
            }
            if sb_push && sb_pa[63:3] == ba[63:3] && st_wstrb[ba[2:0]] {
                let d: logic<64> = st_wdata >> {ba[2:0], 3'b000};
                sbg1_v = 1'b1; sbg1_b = d[7:0];
            }
        }
    }
    always_comb {
        sbg2_v = 1'b0; sbg2_b = 8'd0;
        if stld_fwd_en2 {
            let ba: logic<64> = agu_addr_iss2 + 64'd2;
            for i in 0..SB_N {
                if (i as 4) <: sb_cnt && sb_line[i] == ba[63:6] && sb_strb[{(i as 2), ba[5:3]}][ba[2:0]] {
                    let d: logic<64> = sb_data[{(i as 2), ba[5:3]}] >> {ba[2:0], 3'b000};
                    sbg2_v = 1'b1; sbg2_b = d[7:0];
                }
            }
            if sb_push && sb_pa[63:3] == ba[63:3] && st_wstrb[ba[2:0]] {
                let d: logic<64> = st_wdata >> {ba[2:0], 3'b000};
                sbg2_v = 1'b1; sbg2_b = d[7:0];
            }
        }
    }
    always_comb {
        sbg3_v = 1'b0; sbg3_b = 8'd0;
        if stld_fwd_en2 {
            let ba: logic<64> = agu_addr_iss2 + 64'd3;
            for i in 0..SB_N {
                if (i as 4) <: sb_cnt && sb_line[i] == ba[63:6] && sb_strb[{(i as 2), ba[5:3]}][ba[2:0]] {
                    let d: logic<64> = sb_data[{(i as 2), ba[5:3]}] >> {ba[2:0], 3'b000};
                    sbg3_v = 1'b1; sbg3_b = d[7:0];
                }
            }
            if sb_push && sb_pa[63:3] == ba[63:3] && st_wstrb[ba[2:0]] {
                let d: logic<64> = st_wdata >> {ba[2:0], 3'b000};
                sbg3_v = 1'b1; sbg3_b = d[7:0];
            }
        }
    }
    always_comb {
        sbg4_v = 1'b0; sbg4_b = 8'd0;
        if stld_fwd_en2 {
            let ba: logic<64> = agu_addr_iss2 + 64'd4;
            for i in 0..SB_N {
                if (i as 4) <: sb_cnt && sb_line[i] == ba[63:6] && sb_strb[{(i as 2), ba[5:3]}][ba[2:0]] {
                    let d: logic<64> = sb_data[{(i as 2), ba[5:3]}] >> {ba[2:0], 3'b000};
                    sbg4_v = 1'b1; sbg4_b = d[7:0];
                }
            }
            if sb_push && sb_pa[63:3] == ba[63:3] && st_wstrb[ba[2:0]] {
                let d: logic<64> = st_wdata >> {ba[2:0], 3'b000};
                sbg4_v = 1'b1; sbg4_b = d[7:0];
            }
        }
    }
    always_comb {
        sbg5_v = 1'b0; sbg5_b = 8'd0;
        if stld_fwd_en2 {
            let ba: logic<64> = agu_addr_iss2 + 64'd5;
            for i in 0..SB_N {
                if (i as 4) <: sb_cnt && sb_line[i] == ba[63:6] && sb_strb[{(i as 2), ba[5:3]}][ba[2:0]] {
                    let d: logic<64> = sb_data[{(i as 2), ba[5:3]}] >> {ba[2:0], 3'b000};
                    sbg5_v = 1'b1; sbg5_b = d[7:0];
                }
            }
            if sb_push && sb_pa[63:3] == ba[63:3] && st_wstrb[ba[2:0]] {
                let d: logic<64> = st_wdata >> {ba[2:0], 3'b000};
                sbg5_v = 1'b1; sbg5_b = d[7:0];
            }
        }
    }
    always_comb {
        sbg6_v = 1'b0; sbg6_b = 8'd0;
        if stld_fwd_en2 {
            let ba: logic<64> = agu_addr_iss2 + 64'd6;
            for i in 0..SB_N {
                if (i as 4) <: sb_cnt && sb_line[i] == ba[63:6] && sb_strb[{(i as 2), ba[5:3]}][ba[2:0]] {
                    let d: logic<64> = sb_data[{(i as 2), ba[5:3]}] >> {ba[2:0], 3'b000};
                    sbg6_v = 1'b1; sbg6_b = d[7:0];
                }
            }
            if sb_push && sb_pa[63:3] == ba[63:3] && st_wstrb[ba[2:0]] {
                let d: logic<64> = st_wdata >> {ba[2:0], 3'b000};
                sbg6_v = 1'b1; sbg6_b = d[7:0];
            }
        }
    }
    always_comb {
        sbg7_v = 1'b0; sbg7_b = 8'd0;
        if stld_fwd_en2 {
            let ba: logic<64> = agu_addr_iss2 + 64'd7;
            for i in 0..SB_N {
                if (i as 4) <: sb_cnt && sb_line[i] == ba[63:6] && sb_strb[{(i as 2), ba[5:3]}][ba[2:0]] {
                    let d: logic<64> = sb_data[{(i as 2), ba[5:3]}] >> {ba[2:0], 3'b000};
                    sbg7_v = 1'b1; sbg7_b = d[7:0];
                }
            }
            if sb_push && sb_pa[63:3] == ba[63:3] && st_wstrb[ba[2:0]] {
                let d: logic<64> = st_wdata >> {ba[2:0], 3'b000};
                sbg7_v = 1'b1; sbg7_b = d[7:0];
            }
        }
    }
    assign stld_fwd_data2 = {
        if sg7_v ? sg7_b : sbg7_b, if sg6_v ? sg6_b : sbg6_b, if sg5_v ? sg5_b : sbg5_b,
        if sg4_v ? sg4_b : sbg4_b, if sg3_v ? sg3_b : sbg3_b, if sg2_v ? sg2_b : sbg2_b,
        if sg1_v ? sg1_b : sbg1_b, if sg0_v ? sg0_b : sbg0_b
    };
    assign stld_fwd_mask2 = {
        sg7_v || sbg7_v, sg6_v || sbg6_v, sg5_v || sbg5_v, sg4_v || sbg4_v,
        sg3_v || sbg3_v, sg2_v || sbg2_v, sg1_v || sbg1_v, sg0_v || sbg0_v
    };

    inst u_dmem_mmu: dmem_mmu (
        clk                          ,
        rst                          ,
        i_vaddr     : core_dmem_vaddr,
        i_wdata     : core_dmem_wdata,
        i_wen       : core_dmem_wen  ,
        i_ren       : core_dmem_ren  ,
        i_wstrb     : core_dmem_wstrb,
        o_rdata     : dmem_mmu_rdata ,
        o_dmem_addr : dmu_dmem_addr  ,
        o_dmem_wdata: dmu_dmem_wdata ,
        // M8.B: PTW PTE reads now come from the dcache (PTE is data). On a PTE
        // miss the dcache fills and dcache_stall holds the walk via i_dcache_stall
        // below. In Bare mode no walk runs so this input is unused.
        i_dmem_rdata: dcache_rdata   ,
        o_dmem_wen  : dmu_dmem_wen   ,
        o_dmem_ren  : dmu_dmem_ren   ,
        o_dmem_wstrb: dmu_dmem_wstrb ,
        i_satp      : satp_shadow    ,
        // Effective priv for dmem accesses: when mstatus.MPRV is set,
        // loads/stores use mstatus.MPP's priv level for translation
        // (RISC-V priv spec). Used by rv64si-dirty etc. Phase 11-H: an HLV/HSV
        // overrides this to the hstatus.SPVP-selected VS/VU priv (dmem_mmu_priv).
        i_priv       : dmem_mmu_priv   ,
        i_sum        : dmem_sum         ,
        i_mxr        : dmem_mxr         ,
        i_pbmte      : csr_pbmte       ,
        i_adue       : csr_adue        ,
        // Phase 11-H two-stage data translation. dmem_virt2 = MPRV+MPV-effective V
        // OR an explicit HLV/HSV (dmem_op_hlv), so a hypervisor virtual-memory
        // access translates two-stage even while the core itself runs at V=0/HS.
        i_virt        : dmem_virt2     ,
        i_vsatp       : vsatp_shadow  ,
        i_hgatp       : csr_hgatp      ,
        i_hlvx        : dmem_op_hlvx   , // HLVX.HU/.WU: read checks execute (X)
        o_gstage_fault: dmem_mmu_gstage,
        o_fault_gpa   : dmem_mmu_gpa   ,
        o_uncached   : dmu_pbmt_unc    ,
        o_ad_writeback: dmu_ad_wb      , // P10 Svadu: A/D write-back this cycle
        o_busy       : dmem_mmu_busy   ,
        o_fault      : dmem_mmu_fault  ,
        o_fault_store: dmem_mmu_fault_s,
        o_rdata_valid: dmem_mmu_rdv    ,
        o_walk_start : dmem_walk_start , // M9.A.296: PTW-start pulse for F2 owner re-latch
        o_idle       : dmem_mmu_idle   , // M9.3: gate the load-walk VA pin on a REAL in-flight walk

        // M8.B: stall the dmem MMU walk while the dcache is filling a PTE-read
        // miss — the walk must not advance (i_ptw_valid) until the PTE is cached.
        // M8.C: the old imem_ptw_req_w term is gone — imem PTW now has its own
        // o_iptw bus and no longer contends for the dmem bus.
        i_dcache_stall: dcache_stall,
        i_sfence      : commit_sfence_pulse,
        i_sfence_vaddr   : sfence_vaddr   , // P9.5: selective flush operands
        i_sfence_asid    : sfence_asid    ,
        i_sfence_rs1_zero: sfence_rs1_zero,
        i_sfence_rs2_zero: sfence_rs2_zero,
        // M9.A.303 debug
        o_dbg_ptw_req : dmem_dptw_req ,
        o_dbg_ptw_addr: dmem_dptw_addr,
        o_dbg_pte     : dmem_dpte     ,
        o_dbg_tlb_hit : dmem_dtlb_hit ,
        o_dbg_tlb_ppn : dmem_dtlb_ppn ,
        o_dbg_tlb_perm: dmem_dtlb_perm,
    );
    let _unused_dmem_fault: logic     = dmem_mmu_fault;
    let _unused_dmem_fs   : logic     = dmem_mmu_fault_s;
    let _unused_dmem_rdv  : logic     = dmem_mmu_rdv;
    let _unused_dmem_rdata: logic<64> = dmem_mmu_rdata; // alu_wrap reads dcache_rdata; dmem_mmu.o_rdata stays unused

    // ============================================================
    // M8.B: L1 data cache, inserted between dmem_mmu (dmu_dmem_*) and the
    // external dmem port (o_dmem_*). BLOCKING: o_stall (dcache_stall) folds
    // into the issue/ack/commit gates and dmem_mmu's i_dcache_stall above, so
    // a miss holds the pipeline until the 8-dword line fill completes; the hit
    // data (dcache_rdata) then feeds alu_wrap (LOAD) and dmem_mmu (PTE read).
    // CPU side = the dmem MMU output, gated off during an imem PTW so the imem
    // walk bypasses the dcache on the shared dmem bus. Mem side + the imem PTW
    // addr mux drive o_dmem_*. Single-hart: invalidate port tied off, grant
    // tied high by the SoC. Misaligned STORE: tb hi-side via o_dmem_wdata_hi/
    // wstrb_hi bypass + dcache invalidates the touched lines (B.3, i_wstrb_hi).
    // Misaligned cross-line LOAD: dcache fills the next line too (B.3, i_load_next).
    // ============================================================
    // B.3 dcache hints. dc_st_wstrb_hi: hi strobe for a committing misaligned
    // STORE (drives BOTH the dcache line-invalidation and the tb bypass below).
    // S20R: the hi strobe must pair with ITS OWN i_wen write — the SoC keys
    // the +8 hi-side DRAM/L2 bypass on "this hart holds the W grant", and
    // with the store buffer a DRAIN can hold that grant while a misaligned
    // store sits at commit with its i_wen still suppressed (VM walk /
    // translation pending). The unpaired strobe then writes the pending
    // store's hi bytes at DRAIN_ADDR+8 — random committed-memory corruption
    // (observed: N=2 kernel wedged walking a corrupted hash chain). Gate the
    // strobe on the dcache's EFFECTIVE i_wen, so it is nonzero only on
    // cycles the lo write itself can own the W channel.
    // P10 Svadu: a PTW A/D write-back (dmu_ad_wb) forces the dcache i_wen — the
    // MMU owns the port for it, so the committing-store gates (sb_vm_ok / AMO /
    // MMIO overlap) do not apply. It is an aligned single-dword write-through
    // (dmu_dmem_wstrb=0xFF), so the misaligned hi-strobe and the in-cache AMO
    // excl-merge must both be suppressed for it (a concurrently-committing
    // misaligned store or AMO at the ROB head would otherwise leak its
    // st_wstrb_hi / c_is_amo into the PTE write and corrupt it / hang the walk).
    let dc_i_wen      : logic    = (dmu_dmem_wen && !sb_vm_ok && !(if c_is_amo || c_store_mmio ? !sb_empty : sb_st_ovl)) || dmu_ad_wb;
    let dc_st_wstrb_hi: logic<8> = if dmu_ad_wb ? 8'd0 : if dc_i_wen ? st_wstrb_hi : 8'd0;
    // P9.3: in-cache AMO/SC commit write — eligible when the committing
    // store is an AMO/SC to a cacheable DRAM PA outside the tohost pages
    // (mirrors the fast-store / sb_vm_ok exclusions: the harnesses watch
    // the DRAM array, and MMIO is uncacheable). The dcache merges it into
    // the owned line locally (no write channel); ineligible AMO/SC writes
    // keep the write-through path.
    let st_pa_w      : logic<64> = if dmem_vm_on_op ? dmu_dmem_addr : c_store_addr; // Phase 11-H HSV → translated PA
    let st_pa_tohost : logic     = (st_pa_w[31:14] == 18'h20000) || (st_pa_w[31:12] == 20'h80008);
    let dc_wen_excl  : logic     = c_is_amo && !c_store_mmio && !st_pa_tohost && !dmu_ad_wb;
    // (P9.3: the ownership pin is dcache-internal — it self-arms at the
    // AMO/LR read's data arrival, which closes the issue→pin arming gap a
    // core-driven pin had: remote recalls landing in that 2-3 cycle window
    // stole the reservation every spin iteration — LR/SC livelock.)
    // dc_load_next: the issuing LOAD's data spans into the next dword
    // (byte_off + size > 8); the dcache fills the next line when it crosses one.
    let dc_byte_off: logic<3> = dmu_dmem_addr[2:0];
    let dc_ld_bytes: logic<5> = if iq_issue_op.base.mem_funct3[1:0] == 2'b00 ?
        5'd1
    : if iq_issue_op.base.mem_funct3[1:0] == 2'b01 ?
        5'd2
    : if iq_issue_op.base.mem_funct3[1:0] == 2'b10 ?
        5'd4
    :
        5'd8
    ;
    let dc_span_sum : logic<6> = ({3'b0, dc_byte_off} as 6) + ({1'b0, dc_ld_bytes} as 6);
    let dc_load_next: logic    = issue_is_load && (dc_span_sum >: 6'd8);
    // Phase 8 S5.2: drive the 2nd hit-only read port from the slot-1 LOAD AGU.
    // BARE mode only (PA==VA); under Sv39/VM the slot-1 load is not admitted
    // (S5.1 conservative) so the port stays off. dc_ren2 is independent of the
    // 2nd-port hit (no comb loop). The completion gate (ld2_complete / issue2_fire,
    // after the dcache inst) adds !dcache_stall / !redirect / !inv.
    let dc_byte_off2: logic<3> = agu_addr_iss2[2:0];
    let dc_ld_bytes2: logic<5> = if iq_issue_op2.base.mem_funct3[1:0] == 2'b00 ?
        5'd1
    : if iq_issue_op2.base.mem_funct3[1:0] == 2'b01 ?
        5'd2
    : if iq_issue_op2.base.mem_funct3[1:0] == 2'b10 ?
        5'd4
    :
        5'd8
    ;
    let dc_span_sum2: logic<6> = ({3'b0, dc_byte_off2} as 6) + ({1'b0, dc_ld_bytes2} as 6);
    assign dc_addr2      = agu_addr_iss2;
    assign dc_ren2       = issue2_is_load && !dmem_vm_on;
    assign dc_load_next2 = issue2_is_load && (dc_span_sum2 >: 6'd8);
    // Phase 8 S10.4b: replay injection. A QUEUED MSHR (captured while the
    // dcache was busy) re-executes its read by driving its address onto the
    // dcache CPU port once armed (replay_q). The drive defers to a committing
    // store's write (store_drive owns i_addr for the write-through) and to a
    // PTW PTE read (mmu_walk_inflight owns the port for the walk) — both are
    // bounded, so the replay always eventually gets the port. Outcomes:
    //   HIT  (dc_hit_safe — the line arrived via an earlier fill, possibly
    //         still mid-another-fill): complete from o_rdata (replay_hit_fire).
    //   MISS (dc_miss_valid while driving): the fill starts and the entry
    //         becomes its owner (replay_claim).
    // The target select (replay_is_a) is combinational; it is consistent with
    // the address being driven on the same cycle by construction.
    let mshra_queued: logic     = mshra_v_q && !mshra_done_q && !mshra_own_q;
    let mshrb_queued: logic     = mshrb_v_q && !mshrb_done_q && !mshrb_own_q;
    let replay_is_a : logic     = mshra_queued;
    let replay_addr : logic<64> = if mshra_queued ? mshra_addr_q : mshrb_addr_q;
    // S10.5: defer to the MMU being fully IDLE, not merely !mmu_walk_inflight.
    // mmu_walk_inflight is walk_v_q-based and so misses (1) STORE-commit walks
    // (excluded from load_walk_busy; !store_drive happens to cover them) and
    // (2) ORPHAN walks — a walk whose owner was squashed by a redirect
    // (walk_phys_q && !walk_v_q, the M9.3 class) keeps issuing PTE reads; a
    // replay overriding i_addr during one of them feeds the REPLAY LOAD's
    // data to the MMU as a PTE, installing a garbage TLB entry → spurious
    // load page faults on valid kernel VAs (the N=2 post-SMP-bringup Oops,
    // badaddr == a live kernel pointer). dmem_mmu_idle is the MMU's state
    // register — no walk of any kind can consume the port while it is IDLE,
    // and the !replay_q term in core_dmem_ren keeps a NEW walk from starting
    // mid-replay.
    let replay_drive: logic = replay_q && !store_drive && dmem_mmu_idle;
    var dc_mem_addr : logic<64>    ;
    var dc_mem_wdata: logic<64> [8]; // S25: write-channel line lanes
    var dc_mem_wen  : logic        ;
    var dc_mem_ren  : logic        ;
    var dc_mem_wstrb: logic<8>  [8];
    var dc_mem_req  : logic        ;
    var dc_mem_rfo  : logic        ; // P9.6: dcache RFO (muxed into o_dmem_rfo)
    var dc_grant    : logic        ; // P9.6: read-port grant demuxed to the dcache
    var dc_memw_addr: logic<64>; // S23: write-channel address
    var dc_memw_req : logic    ;
    // Phase 8 S10.1: non-blocking miss (MSHR) interface, consumed by the MSHR
    // block after the instance. dc_miss_valid = fill-start pulse, dc_fill_complete
    // = non-aborted DONE, dc_fill_rdata = filled dword at the original miss offset.
    var dc_miss_valid   : logic    ;
    var dc_fill_complete: logic    ;
    var dc_fill_rdata   : logic<64>;
    var dc_fill_aborted : logic    ;
    var dc_fill_ready   : logic    ; // S14.2: demanded dword landed (critical-word-first)
    // P9.5: an uncached MMIO load — a plain (non-AMO, non-replay) load whose PA
    // is outside the cacheable DRAM window (PA[63:25] != 0x40, the same window
    // c_store_mmio uses). The dcache then does a single exact-address bus read
    // instead of a line fill, so a device register read (e.g. a PLIC claim at a
    // 0x..4 offset, with its side effect) works correctly. dmu_dmem_addr is the
    // post-MMU PA in both bare and Sv39 modes.
    // P10 Svpbmt: a translated NC/IO page (dmu_pbmt_unc) is uncached even when
    // its PA falls inside the cacheable DRAM window.
    let dc_uncached: logic = dmu_dmem_ren && !replay_drive && !dc_amo_read
        && ((dmu_dmem_addr[63:25] != 39'h40) || (dmem_vm_on_op && dmu_pbmt_unc)); // Phase 11-H: HLV NC page
    inst u_dcache: dcache (
        clk                                              ,
        rst                                              ,
        // S10.4b: a replay drive overrides the READ address (the write path is
        // unaffected — replay_drive excludes store_drive, so i_wen=0 then).
        i_addr           : if replay_drive ? replay_addr : dmu_dmem_addr,
        i_wdata          : dmu_dmem_wdata                ,
        // S20: a buffered (sb_vm_ok) store must not ALSO write through i_wen,
        // and a slow store's write may not pass an older buffered store to
        // the SAME dwords (overlap; AMO additionally needs full-empty — its
        // retire ack holds with the same condition, see rob_commit_ack).
        i_wen            : dc_i_wen                      ,
        i_wen_excl       : dc_wen_excl                   , // P9.3: in-cache AMO/SC local merge
        i_ren            : dmu_dmem_ren || replay_drive  ,
        i_uncached       : dc_uncached                   , // P9.5: MMIO single-beat read
        i_wstrb          : dmu_dmem_wstrb                ,
        i_wstrb_hi       : dc_st_wstrb_hi                , // B.3: misaligned store → invalidate
        i_load_next      : dc_load_next && !replay_drive && !dc_uncached, // B.3: misaligned cross-line load fill
        i_amo_read       : dc_amo_read && !replay_drive  , // P9.3: AMO/LR read → ownership (RFO)
        // Phase 8 S5.2: 2nd hit-only read port (dual-issue loads). Tied off in
        // step 1; wired to the slot-1 load AGU/result in steps 2-3.
        i_addr2          : dc_addr2                       ,
        i_ren2           : dc_ren2                        ,
        i_load_next2     : dc_load_next2                  ,
        // Phase 8 S6/S20: 2nd write port (store-drain), now fed by the
        // committed-store buffer head (oldest entry) instead of the live
        // committing store. o_sdrain_ack pops the entry.
        i_saddr          : {sb_line[0], 6'd0}             ,
        i_swen           : !sb_empty                      ,
        // S20.2: near-full buffer (or a head store already blocked on room)
        // escalates the drain over new fill starts.
        i_sdrain_urgent  : sb_cnt >= 4'd3                 ,
        i_swdata         : sb_head_data                   ,
        i_swstrb         : sb_head_strb                   ,
        o_sdrain_ack     : dc_sdrain_ack                  ,
        o_rdata2         : dcache_rdata2                  ,
        o_rdata2_next    : dcache_rdata2_next            ,
        o_hit2           : dcache_hit2                    ,
        o_rdata          : dcache_rdata                  ,
        o_rdata_next     : dcache_rdata_next             ,
        o_rdata_next_miss: _                             , // hi_miss path stalls cross-line loads
        o_stall          : dcache_stall                  ,
        o_data_valid     : _                             , // single-hart
        o_miss_valid     : dc_miss_valid                 , // S10.1: MSHR capture trigger
        o_fill_complete  : dc_fill_complete              ,
        o_fill_rdata     : dc_fill_rdata                 ,
        o_fill_aborted   : dc_fill_aborted               , // S10.3: stale fill → poison+replay
        o_fill_data_ready: dc_fill_ready                 , // S14.2: owner early restart
        o_hit_safe       : dc_hit_safe                   , // S10.4a: pipe-0 hit-under-miss

        o_memr_addr      : dc_mem_addr                   ,
        o_memr_ren       : dc_mem_ren                    ,
        o_memr_rfo       : dc_mem_rfo                    , // P9.2: store fill = RFO (P9.6: muxed below)
        i_fill_excl      : i_dmem_fill_excl              , // P9.2: home grant state
        i_mem_rdata      : i_dmem_rdata                  ,
        o_memw_addr      : dc_memw_addr                  , // S23: write channel
        o_memw_wdata     : dc_mem_wdata                  ,
        o_memw_wstrb     : dc_mem_wstrb                  ,
        o_memw_wen       : dc_mem_wen                    ,
        o_memw_wb        : o_dmemw_wb                    , // P9.2: writeback flag
        i_probe_v        : i_dcache_probe_v              , // P9.2: recall probe
        i_probe_addr     : i_dcache_probe_addr           ,
        i_probe_self     : i_dcache_probe_self           ,
        o_probe_ack      : o_dcache_probe_ack            ,
        i_flush_req      : dc_flush_req                  , // P9.2: fence.i/sfence/satp sweep
        o_flush_done     : dc_flush_done                 ,
        i_inv_valid      : i_dcache_inv_valid            , // M9 SMP: remote-write coherence
        i_inv_addr       : i_dcache_inv_addr             ,
        i_inv2_valid     : i_dcache_inv2_valid           , // P9.2: precise-inv 2nd port
        i_inv2_addr      : i_dcache_inv2_addr            ,
        // P9.2: line-presence checks — LR/SC reservation + SC watch. The core
        // clears/poisons them the moment the line leaves the L1 (under
        // precise invalidation an uncached line gets no remote-write pulse).
        i_chk_addr       : rsv_pa_q                      , // P9.3: PA-based (PIPT)
        o_chk_present    : dc_rsv_present                ,
        i_chk2_addr      : sc_watch_addr_q               , // (holds the PA since P9.3)
        o_chk2_present   : dc_scw_present                ,
        i_chk3_addr      : amo_watch_pa_q                , // P9.3: AMO watch
        o_chk3_present   : dc_amo_present                ,
        o_evict1_v       : dc_evict1_v                   , // P9.2: line-departure events
        o_evict1_addr    : dc_evict1_addr                , //       (ROB CoRR poison scan)
        o_evict2_v       : dc_evict2_v                   ,
        o_evict2_addr    : dc_evict2_addr                ,
        o_memr_req       : dc_mem_req                    ,
        i_memr_grant     : dc_grant                      , // P9.6: demuxed read-port grant
        o_memw_req       : dc_memw_req                   ,
        i_memw_grant     : i_dmemw_grant                 ,
    );

    // Phase 8 S5.2: slot-1 LOAD completion. A bare-mode slot-1 load completes on
    // pipe-1 only when the 2nd port HITS, not on a redirect (wrong-path), and
    // not during a same-cycle remote invalidate (SMP race). Otherwise the load
    // is held in the IQ (issue2_fire=0 for it → ack2=0) and re-issues later.
    // Non-load slot-1 ops fire unconditionally (= the old issue2_valid).
    // issue2_fire drives BOTH u_alu2.i_issue_valid and iq.i_issue_ack2
    // (forward-ref var). Store ordering is enforced by the slot-1 select's block
    // term + the 2nd forward network (older overlapping stores).
    // Phase 8 S10.2 (hit-under-miss): the !dcache_stall term is gone — a slot-1
    // load that HITS now completes while a slot-0 miss fills. The mid-FILL
    // hazard that term guarded (victim way: old tag, partially-overwritten data)
    // is excluded inside the dcache per-way (fill_busy2), so o_hit2 is
    // fill-safe. Same-address load-load order is naturally kept (if the older
    // load missed this line, the younger can't hit it), and stores never write
    // the arrays mid-fill (IDLE-only write-through + store drain).
    // S27: the S20 buffered-store overlap hold is gone — the slot-1 sb
    // forward layer (sbg*, merged into stld_fwd_*2) overrides the hit data
    // with any pending sb bytes, so an overlapping slot-1 load completes
    // with the correct value (bare mode, PA == agu_addr_iss2).
    let ld2_complete: logic = issue2_is_load && !dmem_vm_on && dcache_hit2 && !redirect_fire && !i_dcache_inv_valid && !i_dcache_inv2_valid;
    assign issue2_fire = iq_issue_valid2 && (!issue2_is_load || ld2_complete);

    // ============================================================
    // Phase 8 S10: non-blocking load-miss MSHRs. S10.4b: TWO entries (a/b) =
    // miss-under-miss. A plain bare-mode int load that misses is captured and
    // acked OUT of the IQ in one of two ways:
    //   - OWNER capture (mshr_capture_own): the fill starting THIS cycle
    //     (dc_miss_valid) is this load's; the entry owns it (own_q=1) and
    //     latches dc_fill_rdata at DONE.
    //   - QUEUED capture (mshr_capture_que): the load misses (fill-safe
    //     verdict !dc_hit_safe) while the dcache is busy — mid-fill, or its
    //     own miss is still waiting for the bus grant. No fill starts now;
    //     the replay machinery (replay_q / replay_drive at the dcache
    //     instance) injects the address once the dcache is idle: a HIT
    //     completes from o_rdata, a MISS starts its fill (entry claims it).
    // Completion is a DEFERRED writeback (mshr_cdb) on lane 0 at the first
    // FPU-free cycle: PRF write + ROB result + IQ wakeup, like an in-pipe
    // load. Excluded from capture (blocking path): AMO/LR (force-miss
    // protocol), FP loads, Sv39 (PTE reads share the port), cross-dword
    // misaligned loads, loads with forwarded store bytes.
    // Squash safety (the S8.E BUG5 idx-reuse class): each entry clears on
    // redirect_fire (registered, covers every full flush incl. S9 load
    // replay) and on an early redirect when the load is YOUNGER than the
    // branch (modular age compare vs rob_head_idx) — a stale writeback can
    // never land on a re-allocated rob_idx. A same-cycle squash+writeback is
    // mooted inside the ROB (squash runs later in its block); a same-cycle
    // squash+replay_claim is voided (squash branch has priority, the fill
    // goes ownerless and harmlessly caches the line).
    // SMP aborted fill: completes the OWNER with stale data + poisons its ROB
    // entry (mshr_abort_poison) → S9.3 commit replay re-reads fresh data.
    let s10_flip_en: logic = 1'b1;
    // Capturable plain load issuing on slot-0 (shared qualifier).
    // S10.5 (Sv39 extension): !dmem_vm_on is GONE — a TLB-hit Sv39 load
    // captures like a bare one. By that point dmu_dmem_addr is the translated
    // PA (ptw_valid), so the MSHR/fill/replay all carry a PA and are immune to
    // later satp/sfence changes (translation happens at issue, as it always
    // did; an OLDER captured load also always completes before a younger
    // csrw-satp/sfence can commit, by in-order commit). TLB-miss loads walk
    // first (dmem_mmu_busy gates this term; PTE-read misses can't capture for
    // the same reason). !dmem_mmu_fault: a faulting translation never reads
    // the dcache (the MMU drops o_dmem_ren), so it must trap via the normal
    // CDB path, not capture. Store ordering under VM is STRICTER than bare:
    // the S9 conservative block holds every load while ANY older store is
    // in the ROB, so a captured VM load has no older in-flight stores at all
    // (this is also why the LQ-record PA-vs-VA unit mismatch is benign — the
    // violation scan structurally cannot fire under VM, and fwd_mask is
    // always 0 there).
    let mshr_plain_load: logic = iq_issue_valid && iq_iss_is_load && !iq_iss_is_amo && !iq_iss_fp_ld && !dmem_mmu_fault && !dc_load_next && stld_fwd_mask == 8'd0 && !dmem_mmu_busy && !load_walk_block && !load_blocks_on_store && !redirect_fire && !early_redir_fire_q;
    let mshr_free_ok    : logic = !mshra_v_q || !mshrb_v_q;
    let mshr_alloc_a    : logic = !mshra_v_q;
    // !replay_q on both: on a replay cycle the dcache port (and so
    // dc_miss_valid / dc_hit_safe) belongs to the replayed entry, not to an
    // issuing load (which iss_dc_ok holds anyway).
    let mshr_capture_own: logic = s10_flip_en && !replay_q && dc_miss_valid && mshr_plain_load && mshr_free_ok;
    let mshr_capture_que: logic = s10_flip_en && !replay_q && !dc_miss_valid && dcache_stall && !dc_hit_safe && !i_dcache_inv_valid && !i_dcache_inv2_valid && mshr_plain_load && mshr_free_ok;
    assign mshr_capture = mshr_capture_own || mshr_capture_que;
    // rob LQ-record / abort-poison port feeds (vars declared near mshr_cdb).
    assign mshr_rec_addr     = dmu_dmem_addr;
    // S20R: a committed store buffered DURING the fill (or before a queued
    // replay's hit) overlaps the captured load — the fill/dcache data
    // predates the store and the issue-time sb scan can no longer help, so
    // poison the completion like an aborted fill (S9.3 commit replay
    // re-executes the load through the normal, sb-checked path).
    var sb_mshra_ovl: logic;
    var sb_mshrb_ovl: logic;
    let sb_ma_dw: logic<9> = mshra_addr_q[11:3];
    let sb_mb_dw: logic<9> = mshrb_addr_q[11:3];
    always_comb {
        sb_mshra_ovl = 1'b0;
        sb_mshrb_ovl = 1'b0;
        for i in 0..SB_N {
            if (i as 4) <: sb_cnt {
                if sb_line[i][5:0] == sb_ma_dw[8:3] && sb_lmap[i][sb_ma_dw[2:0]] {
                    sb_mshra_ovl = 1'b1;
                }
                if sb_line[i][5:0] == sb_mb_dw[8:3] && sb_lmap[i][sb_mb_dw[2:0]] {
                    sb_mshrb_ovl = 1'b1;
                }
            }
        }
        // S24.1: a store entering the buffer THIS cycle (sb_push) is not in the
        // registered sb_addr scan yet — an MSHR writeback (or replay hit) firing
        // this same cycle would return pre-store data unpoisoned (observed on
        // a Verilator N2 boot: an LD completed 0 from a fill while the committed
        // store of the same dword pushed into the sb). Fold the pushing entry
        // in. sb_push fans in from the MMU translate (sb_vm_ok), but every
        // consumer of these ovl signals is edge-triggered or completion-side,
        // never the dcache i_ren fan-in, so this closes no comb loop.
        if sb_push && sb_pa[11:3] == mshra_addr_q[11:3] {
            sb_mshra_ovl = 1'b1;
        }
        if sb_push && sb_pa[11:3] == mshrb_addr_q[11:3] {
            sb_mshrb_ovl = 1'b1;
        }
    }
    // S24.1: the sb-overlap arm also poisons a DONE entry (fill data latched,
    // waiting for a CDB writeback slot). The old form required own_q &&
    // !done_q, but fill_done clears own_q, so a store buffered during the
    // done-wait (or pushing the same cycle the writeback fires) retired the
    // pre-store fill data unpoisoned. A QUEUED (not own, not done) entry needs
    // no overlap poison: it has no data yet, its replay-hit completion is held
    // by replay_sb_ovl until the store drains, and a later own-fill goes
    // through the filling-window arm. Per-entry poison ports: one entry's fill
    // abort and the other's writeback-cycle overlap can coincide.
    assign mshr_abort_poison  = mshra_v_q && ((mshra_own_q && !mshra_done_q && (dc_fill_aborted || sb_mshra_ovl)) || (mshra_done_q && sb_mshra_ovl));
    assign mshr_abort_poison2 = mshrb_v_q && ((mshrb_own_q && !mshrb_done_q && (dc_fill_aborted || sb_mshrb_ovl)) || (mshrb_done_q && sb_mshrb_ovl));
    assign mshr_poison_idx    = mshra_rob_idx_q;
    assign mshr_poison_idx2   = mshrb_rob_idx_q;
    // Phase 8 S10.4a: pipe-0 hit-under-miss qualifier (see iss_dc_ok). The
    // forwarded-bytes merge (stld_fwd_*) works on a hit completion exactly as
    // it does outside a fill, so fwd_mask!=0 loads are NOT excluded here (only
    // the MSHR capture excludes them — a fill alone is not their result).
    // !i_dcache_inv_valid mirrors ld2_complete (same-cycle remote-inv race).
    // S10.5: !dmem_vm_on gone here too — a TLB-hit Sv39 load (busy=0, i_addr
    // already the PA) completes from a fill-safe dcache hit mid-fill exactly
    // like a bare one; the alu CDB fault side-band still applies if the
    // translation hit a permission fault (then the MMU drops o_dmem_ren, so
    // dc_hit_safe=0 and this term cannot fire anyway — !dmem_mmu_fault makes
    // it explicit).
    assign ld0_hum_ok = iq_iss_is_load && !iq_iss_is_amo && !iq_iss_fp_ld && !dmem_mmu_fault && !dc_load_next && dc_hit_safe && !redirect_fire && !i_dcache_inv_valid && !i_dcache_inv2_valid;
    // Per-entry squash (see header comment).
    let mshra_age    : logic<ROB_IDX_W> = mshra_rob_idx_q - rob_head_idx;
    let mshrb_age    : logic<ROB_IDX_W> = mshrb_rob_idx_q - rob_head_idx;
    let s10_early_age: logic<ROB_IDX_W> = early_redir_idx_q - rob_head_idx;
    let mshra_squashed: logic = mshra_v_q && (redirect_fire || (early_redir_fire_q && (mshra_age >: s10_early_age)));
    let mshrb_squashed: logic = mshrb_v_q && (redirect_fire || (early_redir_fire_q && (mshrb_age >: s10_early_age)));
    // Replay outcomes (replay_drive/replay_is_a defined at the dcache inst).
    let replay_sb_ovl  : logic = if replay_is_a ? sb_mshra_ovl : sb_mshrb_ovl;
    let replay_hit_fire: logic = replay_drive && dc_hit_safe && !i_dcache_inv_valid && !i_dcache_inv2_valid && !replay_sb_ovl;
    let replay_claim   : logic = replay_drive && dc_miss_valid;
    // Fill completion routes to the OWNING entry.
    // S14.2: dc_fill_ready fires the owner's completion EARLY — critical-word-
    // first lands the demanded dword on the first transfer, so the writeback no
    // longer waits out the whole burst. The early arm marks the entry done
    // (own_q drops with it), after which the fill drains ownerless: a late
    // abort (remote inv) cannot poison the already-completed load — its value
    // was read before the invalidate, which is a legal ordering — and
    // dc_fill_ready itself is gated off on the abort/same-cycle-inv races
    // inside the dcache.
    let mshra_fill_done: logic = mshra_v_q && mshra_own_q && !mshra_done_q && (dc_fill_complete || dc_fill_aborted || dc_fill_ready);
    let mshrb_fill_done: logic = mshrb_v_q && mshrb_own_q && !mshrb_done_q && (dc_fill_complete || dc_fill_aborted || dc_fill_ready);
    // Deferred writeback arbitration: lane 0, priority FPU > MSHR(a>b) > ALU.
    let mshra_wb_rdy : logic = mshra_v_q && mshra_done_q;
    let mshrb_wb_rdy : logic = mshrb_v_q && mshrb_done_q;
    let mshr_wb_sel_a: logic = mshra_wb_rdy;
    let mshr_wb_fire : logic = (mshra_wb_rdy || mshrb_wb_rdy) && !fpu_cdb.valid;

    // Core-tracked dcache fill-FSM busy (fill start → DONE) — arms the replay.
    var fill_busy_q: logic;
    always_ff (clk, rst) {
        if_reset {
            fill_busy_q = 1'b0;
            replay_q    = 1'b0;
        } else {
            if dc_miss_valid {
                fill_busy_q = 1'b1;
            } else if dc_fill_complete || dc_fill_aborted {
                fill_busy_q = 1'b0;
            }
            // Replay arming / retirement. Any fill start clears it (either the
            // replay's own claim, or a PTW/blocking read won the port — the
            // queued entry stays and re-arms after that fill). It also clears
            // when the replay hits, or when no live queued entry remains
            // (squash). Otherwise it arms (and holds) while a queued entry
            // exists and the fill FSM is idle.
            if dc_miss_valid {
                replay_q = 1'b0;
            } else if replay_hit_fire {
                replay_q = 1'b0;
            } else if !((mshra_queued && !mshra_squashed) || (mshrb_queued && !mshrb_squashed)) {
                replay_q = 1'b0;
            } else if !fill_busy_q {
                replay_q = 1'b1;
            }
        }
    }
    always_ff (clk, rst) {
        if_reset {
            mshra_v_q       = 1'b0;
            mshra_done_q    = 1'b0;
            mshra_own_q     = 1'b0;
            mshra_rob_idx_q = '0;
            mshra_pdst_q    = '0;
            mshra_has_rd_q  = 1'b0;
            mshra_addr_q    = '0;
            mshra_funct3_q  = '0;
            mshra_data_q    = '0;
            mshrb_v_q       = 1'b0;
            mshrb_done_q    = 1'b0;
            mshrb_own_q     = 1'b0;
            mshrb_rob_idx_q = '0;
            mshrb_pdst_q    = '0;
            mshrb_has_rd_q  = 1'b0;
            mshrb_addr_q    = '0;
            mshrb_funct3_q  = '0;
            mshrb_data_q    = '0;
        } else {
            // entry A
            if mshra_squashed {
                mshra_v_q    = 1'b0;
                mshra_done_q = 1'b0;
                mshra_own_q  = 1'b0;
            } else if mshr_capture && mshr_alloc_a {
                mshra_v_q       = 1'b1;
                mshra_done_q    = 1'b0;
                mshra_own_q     = mshr_capture_own;
                mshra_rob_idx_q = iq_iss_rob_idx;
                mshra_pdst_q    = iq_iss_rd_pdst;
                mshra_has_rd_q  = iq_issue_op.base.has_rd;
                mshra_addr_q    = dmu_dmem_addr;
                mshra_funct3_q  = iq_issue_op.base.mem_funct3;
            } else if replay_claim && replay_is_a {
                mshra_own_q = 1'b1;
            } else if replay_hit_fire && replay_is_a {
                mshra_data_q = dcache_rdata;
                mshra_done_q = 1'b1;
            } else if mshra_fill_done {
                mshra_data_q = dc_fill_rdata;
                mshra_done_q = 1'b1;
                mshra_own_q  = 1'b0;
            } else if mshr_wb_fire && mshr_wb_sel_a {
                mshra_v_q    = 1'b0;
                mshra_done_q = 1'b0;
            }
            // entry B
            if mshrb_squashed {
                mshrb_v_q    = 1'b0;
                mshrb_done_q = 1'b0;
                mshrb_own_q  = 1'b0;
            } else if mshr_capture && !mshr_alloc_a {
                mshrb_v_q       = 1'b1;
                mshrb_done_q    = 1'b0;
                mshrb_own_q     = mshr_capture_own;
                mshrb_rob_idx_q = iq_iss_rob_idx;
                mshrb_pdst_q    = iq_iss_rd_pdst;
                mshrb_has_rd_q  = iq_issue_op.base.has_rd;
                mshrb_addr_q    = dmu_dmem_addr;
                mshrb_funct3_q  = iq_issue_op.base.mem_funct3;
            } else if replay_claim && !replay_is_a {
                mshrb_own_q = 1'b1;
            } else if replay_hit_fire && !replay_is_a {
                mshrb_data_q = dcache_rdata;
                mshrb_done_q = 1'b1;
            } else if mshrb_fill_done {
                mshrb_data_q = dc_fill_rdata;
                mshrb_done_q = 1'b1;
                mshrb_own_q  = 1'b0;
            } else if mshr_wb_fire && !mshr_wb_sel_a {
                mshrb_v_q    = 1'b0;
                mshrb_done_q = 1'b0;
            }
        }
    }
    // Deferred load-data extension on the SELECTED writeback entry: the
    // captured load is within-dword (cross-dword excluded at capture) with no
    // forwarded bytes, so this is the single-dword slice of alu_wrap's ld_*
    // select on the latched fill/hit dword.
    let mshr_wb_addr  : logic<64>        = if mshr_wb_sel_a ? mshra_addr_q : mshrb_addr_q;
    let mshr_wb_funct3: logic<3>         = if mshr_wb_sel_a ? mshra_funct3_q : mshrb_funct3_q;
    let mshr_wb_data64: logic<64>        = if mshr_wb_sel_a ? mshra_data_q : mshrb_data_q;
    let mshr_wb_pdst  : logic<PRF_INT_W> = if mshr_wb_sel_a ? mshra_pdst_q : mshrb_pdst_q;
    let mshr_wb_rob   : logic<ROB_IDX_W> = if mshr_wb_sel_a ? mshra_rob_idx_q : mshrb_rob_idx_q;
    let mshr_wb_has_rd: logic            = if mshr_wb_sel_a ? mshra_has_rd_q : mshrb_has_rd_q;
    let mshr_shift  : logic<6>  = {mshr_wb_addr[2:0], 3'b000};
    let mshr_shifted: logic<64> = mshr_wb_data64 >> mshr_shift;
    var mshr_ld_data: logic<64>;
    always_comb {
        case mshr_wb_funct3 {
            3'b000 : mshr_ld_data = {if mshr_shifted[7] ? 56'hff_ffff_ffff_ffff : 56'd0, mshr_shifted[7:0]}; // LB
            3'b001 : mshr_ld_data = {if mshr_shifted[15] ? 48'hffff_ffff_ffff : 48'd0, mshr_shifted[15:0]}; // LH
            3'b010 : mshr_ld_data = {if mshr_shifted[31] ? 32'hffff_ffff : 32'd0, mshr_shifted[31:0]}; // LW
            3'b011 : mshr_ld_data = mshr_shifted; // LD
            3'b100 : mshr_ld_data = {56'd0, mshr_shifted[7:0]}; // LBU
            3'b101 : mshr_ld_data = {48'd0, mshr_shifted[15:0]}; // LHU
            3'b110 : mshr_ld_data = {32'd0, mshr_shifted[31:0]}; // LWU
            default: mshr_ld_data = mshr_shifted;
        }
    }
    always_comb {
        mshr_cdb.valid       = mshr_wb_fire;
        mshr_cdb.has_rd      = mshr_wb_fire && mshr_wb_has_rd;
        mshr_cdb.pdst        = mshr_wb_pdst;
        mshr_cdb.data        = mshr_ld_data;
        mshr_cdb.rob_idx     = mshr_wb_rob;
        mshr_cdb.mispredict  = 1'b0;
        mshr_cdb.redirect_pc = '0;
        mshr_cdb.is_store    = 1'b0;
        // S10.3: is_load=0 — the S9 Load Queue shadow is recorded at CAPTURE
        // (rob i_lq_rec_*, address known at the AGU), NOT at this deferred
        // writeback, so an older store resolving DURING the fill window sees
        // the load in the violation scan. A second record here would be
        // redundant at best.
        mshr_cdb.is_load      = 1'b0;
        mshr_cdb.store_addr   = mshr_wb_addr;
        mshr_cdb.store_data   = '0;
        mshr_cdb.store_funct3 = mshr_wb_funct3;
        mshr_cdb.is_csr       = 1'b0;
        mshr_cdb.csr_addr     = '0;
        mshr_cdb.csr_wdata    = '0;
        mshr_cdb.csr_illegal  = 1'b0;
        mshr_cdb.is_lfault    = 1'b0;
        mshr_cdb.is_sfault    = 1'b0;
        mshr_cdb.fault_vaddr  = '0;
    }

    // ============================================================
    // P9.6: D / instruction-side (IS) read-port arbiter. The IS = the I-cache
    // fill OR the I-PTW PTE read (phase 2) — both UNCOUNTED coherent reads
    // (recall-on-owned) through this hart's single mem_ctrl L2 read transaction
    // port. The D-cache (loads / store-RFO / uncached MMIO) has strict priority;
    // the IS sneaks in only when the D-cache is not requesting. ic_owns LATCHES
    // the port for the whole transaction (accept → 8 STREAM beats); is_ptw_q
    // latches WHICH IS consumer owns it. IS sub-arbiter = I-PTW > I-fill (a fetch
    // translates then fetches, so they are sequential; priority just orders a
    // rare overlap). A mid-transaction D request waits — mem_ctrl has one slot
    // per hart, and switching the port mid-stream would strand the read.
    // ============================================================
    // I-PTW request: the imem MMU wants a PTE and we have not delivered it yet.
    let iptw_off    : logic<3>  = imem_ptw_addr_w[5:3];
    let iptw_mem_req: logic     = imem_ptw_req_w && !iptw_busy && !iptw_done_q;
    // Active IS consumer this cycle: the latched one during a txn, else the
    // priority pick (I-PTW first).
    let is_ptw      : logic     = if ic_owns ? is_ptw_q : iptw_mem_req;
    let is_req      : logic     = iptw_mem_req || ic_mem_req;
    // The I-PTW read holds addr[5:3]=iptw_off so every STREAM beat carries the
    // PTE dword (mem_ctrl serves buf[addr[5:3]]); the I-fill drives its own addr.
    let iptw_rd_addr: logic<64> = {imem_ptw_addr_w[63:6], iptw_off, 3'b000};
    // During the read use the LATCHED addr (a mid-read redirect changes
    // imem_ptw_addr_w → iptw_off, which would re-point mem_ctrl's beat to the
    // wrong dword of the latched line and corrupt the captured PTE).
    let is_mem_addr : logic<64> = if is_ptw ? (if iptw_busy ? iptw_addr_q : iptw_rd_addr) : ic_mem_addr;
    assign ic_route = ic_owns || (is_req && !dc_mem_req);
    let is_grant    : logic     = i_dmem_grant && ic_route;
    let iptw_grant  : logic     = is_grant && is_ptw;  // STREAM beat for the I-PTW
    assign ic_grant = is_grant && !is_ptw;             // STREAM beat for the I-fill
    assign dc_grant = i_dmem_grant && !ic_route;
    let iptw_fill_done: logic   = iptw_busy && iptw_grant && iptw_cnt == 3'd7;
    let is_done       : logic   = if is_ptw_q ? iptw_fill_done : ic_fill_done;
    always_ff (clk, rst) {
        if_reset {
            ic_owns  = 1'b0;
            is_ptw_q = 1'b0;
        } else {
            if ic_owns {
                if is_done {
                    ic_owns = 1'b0;
                }
            } else if is_req && !dc_mem_req && i_dmem_grant {
                ic_owns  = 1'b1;
                is_ptw_q = is_ptw;
            }
        }
    }

    // I-PTW PTE read FSM: capture the addressed dword across the 8-beat stream
    // (every beat carries buf[iptw_off] since the addr is held), then hold
    // iptw_done_q (= the MMU's i_ptw_valid) until the MMU advances to a new walk
    // step (a different PTE dword) or finishes the walk.
    always_ff (clk, rst) {
        if_reset {
            iptw_busy   = 1'b0;
            iptw_cnt    = 3'd0;
            iptw_data   = 64'd0;
            iptw_done_q = 1'b0;
            iptw_done_a = '0;
            iptw_addr_q = 64'd0;
        } else {
            if iptw_busy {
                if iptw_grant {
                    iptw_data = i_dmem_rdata;
                    if iptw_cnt == 3'd7 {
                        iptw_busy   = 1'b0;
                        iptw_done_q = 1'b1;
                        iptw_done_a = iptw_addr_q[63:3]; // the read's latched addr
                    } else {
                        iptw_cnt = iptw_cnt + 3'd1;
                    }
                }
            } else {
                // Accept for the I-PTW (the IS port granted while I-PTW is the pick).
                if !ic_owns && is_ptw && is_req && !dc_mem_req && i_dmem_grant {
                    iptw_busy   = 1'b1;
                    iptw_cnt    = 3'd0;
                    iptw_addr_q = iptw_rd_addr; // latch the read addr for the txn
                }
                // Release the delivered PTE once the MMU moves to a new step.
                if iptw_done_q && (!imem_ptw_req_w || imem_ptw_addr_w[63:3] != iptw_done_a) {
                    iptw_done_q = 1'b0;
                }
            }
        }
    }

    // S23: read channel on o_dmem_addr/ren, write channel on o_dmemw_addr +
    // wen/wdata/wstrb. P9.6: the read channel is muxed (instruction side when ic_route).
    assign o_dmem_addr   = if ic_route ? is_mem_addr : dc_mem_addr;
    assign o_dmem_ren    = if ic_route ? 1'b0 : dc_mem_ren; // IS read is DRAM (no MMIO ren)
    assign o_dmem_req    = if ic_route ? is_req : dc_mem_req;
    assign o_dmem_rfo    = if ic_route ? 1'b0 : dc_mem_rfo; // IS read is never RFO
    assign o_dmem_iread  = ic_route;
    for l in 0..8 :gen_dmemw_lane {
        assign o_dmem_wdata[l] = dc_mem_wdata[l];
        assign o_dmem_wstrb[l] = dc_mem_wstrb[l];
    }
    assign o_dmem_wen = dc_mem_wen;
    assign o_dmemw_addr  = dc_memw_addr;
    assign o_dmemw_req   = dc_memw_req;
    // M8: hi-side carry for a misaligned STORE that spans into the next dword.
    // The hi dword can't be held in the dcache, so it bypasses straight to DRAM
    // (the SoC writes o_dmem_addr+8 wherever this strobe is set). The bypass
    // rides whatever DRAM write fires this cycle, so it MUST be suppressed while
    // the dcache is draining a WRITEBACK (o_dmemw_wb / wb_v): a WB wins the
    // dcache write-channel address mux (wb_line > i_addr), preempting the
    // misaligned store's own i_wen write — but dc_st_wstrb_hi stays asserted, so
    // the hi strobe would leak onto the WB and clobber the WB line's next dword.
    // P9.2/9.3 SMP: a c2c recall WB coinciding with a misaligned commit silently
    // corrupted memory (e.g. __num_online_cpus → 0, stop_machine never converges
    // → the 6.6 N=2 boot livelock). The strobe re-fires with the store's own
    // i_wen write once the WB drains (!o_dmemw_wb), targeting the right line.
    assign o_dmem_wdata_hi = st_wdata_hi;
    assign o_dmem_wstrb_hi = if o_dmemw_wb ? 8'd0 : dc_st_wstrb_hi;

    // i_dmem_rdata_next (top-level next-dword) is superseded by the dcache's
    // own o_rdata_next; keep the port for tb compatibility.
    let _unused_dmem_rdata_next: logic<64> = i_dmem_rdata_next;

    // M1 debug counters
    var rename_cnt: logic<32>;
    var cdb_cnt   : logic<32>;
    always_ff (clk, rst) {
        if_reset {
            rename_cnt = 32'd0;
            cdb_cnt    = 32'd0;
        } else {
            if rename_fire {
                rename_cnt = rename_cnt + 32'd1;
            }
            if cdb.valid {
                cdb_cnt = cdb_cnt + 32'd1;
            }
        }
    }
    assign o_dbg_rename_cnt     = rename_cnt;
    assign o_dbg_cdb_cnt        = cdb_cnt;

    // Phase 8 perf counters (M0). Pure observability — no datapath effect.
    //  - mispredict_cnt: a control transfer committed taken. Today (static
    //    not-taken) every taken branch/jal/jalr is a mispredict, so this also
    //    equals the count of taken transfers a predictor could save. Counted on
    //    the same condition the commit-redirect mispredict arm uses (line ~1597);
    //    a mispredicting branch is never a store, so rob_commit_valid is high for
    //    exactly one cycle per event.
    //  - redirect_cnt: every cycle redirect_fire is asserted (1 cycle/event).
    //  - front_idle_cnt: fetch slot empty while not stalled by the back-end and
    //    not the redirect cycle itself — i.e. an i-fetch bubble (icache/MMU fill
    //    or the refill gap after a redirect).
    // Phase 8 S8.A: early (execute-time) branch-misprediction detection. The
    // resolved architectural next-PC is already on the CDB — alu_wrap's
    // resolved_target (= o_cdb.redirect_pc) encodes taken→target / not-taken→
    // fall-through. Compare it against the fetch-time prediction recorded in the
    // ROB entry that just resolved (indexed by the CDB rob_idx, exposed via
    // rob_pred_next_pc / rob_is_control). A mismatch on a CONTROL op is an early
    // mispredict, available the cycle the branch executes — many cycles before it
    // reaches the commit head. Restricted to control ops; a stray BTB hit on a
    // non-control op still self-corrects at commit (rare). NOTE: o_cdb.mispredict
    // is the STALE M1 "any taken = mispredict" flag (alu_wrap predates the BTB/BHT)
    // and is deliberately NOT used here.
    //
    // S8.A is OBSERVATION-ONLY: redirect still fires at commit (zero behavior
    // change); S8.E steers the front-end on these signals. The early count is >=
    // the committed mispredict count because wrong-path control ops execute (and
    // are counted) but are flushed before they commit.
    // S8.E LIVENESS gate: a wrong-path op whose ROB entry was already committed/
    // squashed can still be sitting in the IQ and issue, producing a CDB with a
    // rob_idx that is BEHIND the head (age, head-relative, >= the live size). Acting
    // on its (stale) mispredict would register an early redirect for a non-live idx,
    // and the partial squash would rewind tail to head+(huge age)+1 = a full ROB
    // (deadlock). Restrict early-mispredict to genuinely live entries: age < size.
    // (5-bit age intermediate + zero-extended compare — the inline subtraction form
    // mis-evaluates under the Veryl cc sim; see the rob.veryl squash note.)
    let em0_age: logic<ROB_IDX_W> = alu_cdb.rob_idx - rob_head_idx;
    let em1_age: logic<ROB_IDX_W> = alu_cdb2.rob_idx - rob_head_idx;
    let em0_live: logic = {3'b000, em0_age} <: rob_size;
    let em1_live: logic = {3'b000, em1_age} <: rob_size;
    let early_mispredict0: logic = alu_cdb.valid && em0_live && rob_is_control[alu_cdb.rob_idx]
        && (alu_cdb.redirect_pc != rob_pred_next_pc[alu_cdb.rob_idx]);
    let early_mispredict1: logic = alu_cdb2.valid && em1_live && rob_is_control[alu_cdb2.rob_idx]
        && (alu_cdb2.redirect_pc != rob_pred_next_pc[alu_cdb2.rob_idx]);
    let early_mispred_inc: logic<32> =
        (if early_mispredict0 ? 32'd1 : 32'd0) + (if early_mispredict1 ? 32'd1 : 32'd0);

    // Phase 8 S8.E: the flip. Steer the front-end on an execute-time mispredict
    // instead of waiting for the branch to reach the ROB head and commit-redirect.
    // SELECT: the two ALU lanes can both resolve a mispredicting control op in the
    // same cycle; recover on the OLDER one (smallest age relative to the ROB head)
    // — it dominates the younger one's path, and its single-cycle checkpoint
    // restore + younger-squash subsumes the younger redirect (the younger branch's
    // own ROB/IQ entries are squashed, so it cannot later fire a stale redirect).
    let early_redir_pick1: logic = early_mispredict1 && (!early_mispredict0 || (em1_age <: em0_age));
    // REGISTER (+1 cy, mirrors redirect_fire_q). Gate so it never fires when:
    //  - a commit redirect is recovering this cycle (!redirect_fire): commit is
    //    precise and does a full flush — let it win and don't double-recover; the
    //    branch (if mispredicted) is re-detectable next cycle if still in flight.
    //  - we are ALREADY in an early-recovery cycle (!early_redir_fire_q): the ALU
    //    may issue a YOUNGER wrong-path branch this cycle (issue reads pre-squash
    //    IQ state) whose execute-time redirect must NOT steer the just-recovered
    //    front-end. Such a branch is squashed at the edge; if a genuinely OLDER
    //    branch mispredicts here it still commit-redirects (its pred_next_pc was
    //    not rewritten by the guard), so no mispredict is ever lost.
    // Phase 8 S8.E flip ENABLE. The early-redirect datapath below steers the front-
    // end at execute instead of at commit. Validated: arch 152/0, N=1 Linux boot to
    // SBI shutdown (x3=0xAA @15.1M cy, -6% vs the commit-redirect S8.D 16.1M), and a
    // committed-stream byte-diff vs the gated-off baseline (identical → the early
    // recovery is architecturally transparent). BUG5 (a boot trap-redirect livelock)
    // was a wrong-path PTW whose page fault mis-attributed to a reused rob_idx; fixed
    // by clearing the decoupled walk owner (walk_v_q) on early_redir_fire_q with
    // priority over dmem_walk_start (see the walk-owner always_ff). Set 1'b0 to revert
    // to S8.D (commit-time redirect) exactly — early_redir_fire_q then never fires.
    let s8e_flip_en: logic = 1'b1;
    let early_redir_trigger: logic = s8e_flip_en && (early_mispredict0 || early_mispredict1)
        && !redirect_fire && !early_redir_fire_q;
    let early_redir_sel_idx: logic<ROB_IDX_W> = if early_redir_pick1 ? alu_cdb2.rob_idx : alu_cdb.rob_idx;
    let early_redir_sel_pc : logic<64>        = if early_redir_pick1 ? alu_cdb2.redirect_pc : alu_cdb.redirect_pc;
    // S8.E re-redirect guard drive (this cycle = the resolving op's CDB writeback;
    // see the ROB i_cdb_redir_fix port). When the early redirect triggers, rewrite the
    // committed prediction of EVERY mispredicting lane: the selected (older) op survives
    // and must not re-redirect at commit; a non-selected younger op is squashed anyway.
    assign early_redir_fix0 = early_redir_trigger && early_mispredict0;
    assign early_redir_fix1 = early_redir_trigger && early_mispredict1;
    always_ff (clk, rst) {
        if_reset {
            early_redir_fire_q = 1'b0;
            early_redir_idx_q  = 5'd0;
            early_redir_pc_q   = 64'd0;
        } else if early_redir_trigger {
            early_redir_fire_q = 1'b1;
            early_redir_idx_q  = early_redir_sel_idx;
            early_redir_pc_q   = early_redir_sel_pc;
        } else {
            early_redir_fire_q = 1'b0;
        }
    }

    var mispredict_cnt    : logic<32>;
    var redirect_cnt      : logic<32>;
    var front_idle_cnt    : logic<32>;
    var early_mispred_cnt : logic<32>;
    // Back-end profiling counters (companions to front_idle): characterize where a
    // post-S8.E run loses 2-wide throughput — rename back-pressure (disp_stall),
    // single-memory-port occupancy (mem_busy), ROB-head retire stalls (commit0), and
    // load issue serialization (load_wait). Used to pick perf levers from data.
    var disp_stall_cnt    : logic<32>;
    var mem_busy_cnt      : logic<32>;
    var commit0_cnt       : logic<32>;
    var load_wait_cnt     : logic<32>;
    always_ff (clk, rst) {
        if_reset {
            mispredict_cnt    = 32'd0;
            redirect_cnt      = 32'd0;
            front_idle_cnt    = 32'd0;
            early_mispred_cnt = 32'd0;
            disp_stall_cnt    = 32'd0;
            mem_busy_cnt      = 32'd0;
            commit0_cnt       = 32'd0;
            load_wait_cnt     = 32'd0;
        } else {
            if c_bp_mispredict {
                mispredict_cnt = mispredict_cnt + 32'd1;
            }
            if redirect_fire {
                redirect_cnt = redirect_cnt + 32'd1;
            }
            if !redirect_fire && !if_v_q && !stall_dr {
                front_idle_cnt = front_idle_cnt + 32'd1;
            }
            if early_mispred_inc != 32'd0 {
                early_mispred_cnt = early_mispred_cnt + early_mispred_inc;
            }
            if stall_dr && !any_redirect {
                disp_stall_cnt = disp_stall_cnt + 32'd1;
            }
            if core_dmem_ren || core_dmem_wen || dcache_stall {
                mem_busy_cnt = mem_busy_cnt + 32'd1;
            }
            if !rob_commit_ack {
                commit0_cnt = commit0_cnt + 32'd1;
            }
            if issue_is_load && !iq_issue_ack {
                load_wait_cnt = load_wait_cnt + 32'd1;
            }
        }
    }
    // P10 Zihpm: pack the per-cycle perf events for the CSR's mhpmcounters. The
    // conditions mirror the debug counters above (event N selected by mhpmevent
    // = N): 1 mispredict, 2 redirect, 3 front-idle, 4 dispatch-stall,
    // 5 mem-port-busy, 6 retire-stall, 7 load-issue-wait, 8 reserved.
    // (`hpm_events` is declared up by the u_csr instance; driven here so the late
    // pipeline signals it reads are already in scope.)
    always_comb {
        hpm_events = {
            1'b0, // bit 7: reserved
            issue_is_load && !iq_issue_ack, // bit 6: load-issue wait
            !rob_commit_ack, // bit 5: retire stall (no commit)
            core_dmem_ren || core_dmem_wen || dcache_stall, // bit 4: mem-port busy
            stall_dr && !any_redirect, // bit 3: dispatch stall
            !redirect_fire && !if_v_q && !stall_dr, // bit 2: front-end idle
            redirect_fire, // bit 1: redirect
            c_bp_mispredict // bit 0: branch mispredict
        };
    }

    assign o_dbg_mispredict_cnt       = mispredict_cnt;
    assign o_dbg_redirect_cnt         = redirect_cnt;
    assign o_dbg_front_idle_cnt       = front_idle_cnt;
    assign o_dbg_early_mispredict_cnt = early_mispred_cnt;
    assign o_dbg_disp_stall_cnt       = disp_stall_cnt;
    assign o_dbg_mem_busy_cnt         = mem_busy_cnt;
    assign o_dbg_commit0_cnt          = commit0_cnt;
    assign o_dbg_load_wait_cnt        = load_wait_cnt;
    assign o_dbg_load_viol_cnt        = rob_load_viol_cnt_w;
    assign o_dbg_rob_size       = rob_size;
    assign o_dbg_if_v           = if_v_q;
    assign o_dbg_if_instr       = if_instr_q;
    assign o_dbg_stall_dr       = stall_dr;
    assign o_dbg_head_valid     = rob_head_valid;
    assign o_dbg_head_rw        = rob_head_rw;
    assign o_dbg_head_illegal   = rob_head_illegal;
    assign o_dbg_rob_alloc_cnt  = rob_alloc_cnt_w;
    assign o_dbg_rob_cdb_cnt    = rob_cdb_cnt_w;
    assign o_dbg_rob_commit_cnt = rob_commit_cnt_w;
    assign o_dbg_rob_head       = rob_head_w;
    assign o_dbg_rob_tail       = rob_tail_w;
    // M9 LSU diag
    assign o_dbg_dmem_mmu_busy     = dmem_mmu_busy;
    assign o_dbg_core_dmem_vaddr   = core_dmem_vaddr;
    assign o_dbg_core_dmem_wen     = core_dmem_wen;
    assign o_dbg_core_dmem_ren     = core_dmem_ren;
    assign o_dbg_imem_ptw_req      = imem_ptw_req_w;
    assign o_dbg_commit_store_fire = commit_store_fire;
    // M9.A.292: AGU snoop assignments
    assign o_dbg_agu_issue_v   = iq_issue_valid;
    assign o_dbg_agu_rs1_arch  = iq_iss_rs1_arch;
    assign o_dbg_agu_rs1_pdst  = iq_iss_rs1_pdst;
    assign o_dbg_agu_rs1_data  = prf_rs1_data;
    assign o_dbg_agu_imm       = agu_imm_iss;
    assign o_dbg_agu_addr      = agu_addr_iss;
    assign o_dbg_agu_is_load   = issue_is_load;
    assign o_dbg_agu_is_store  = issue_is_st;
    assign o_dbg_agu_rob_idx   = iq_iss_rob_idx;
    assign o_dbg_walk_v        = walk_v_q;
    assign o_dbg_walk_rob      = walk_rob_q;
    assign o_dbg_walk_vaddr    = walk_vaddr_q;
    assign o_dbg_lfault_inj    = lfault_inj_v;
    assign o_dbg_orphan_walk   = orphan_walk_fault;
    assign o_dbg_walk_phys     = walk_phys_q;
    assign o_dbg_walk_start    = dmem_walk_start;
    assign o_dbg_dmem_idle     = dmem_mmu_idle;
    assign o_dbg_dlk_seen      = dlk_seen_q;
    assign o_dbg_dlk_genuine   = dlk_genuine_q;
    assign o_dbg_dlk_inj       = dlk_inj_q;
    assign o_dbg_dlk_stval     = dlk_stval_q;
    assign o_dbg_dlk_pc        = dlk_pc_q;
    assign o_dbg_dlk_walkpc    = dlk_walkpc_q;
    assign o_dbg_csr_sum       = csr_sum;
    assign o_dbg_csr_mxr       = csr_mxr;
    assign o_dbg_csr_dmem_priv = if dmem_eff_priv == csr_pkg::PrivLevel::MACHINE ?
        2'b11
    : if dmem_eff_priv == csr_pkg::PrivLevel::SUPERVISOR ?
        2'b01
    :
        2'b00
    ;
    // M9.A.303 debug
    assign o_dbg_dmem_fault = dmem_mmu_fault;
    assign o_dbg_dmem_vaddr = core_dmem_vaddr;
    assign o_dbg_fl_push_en    = fl_push_en;
    assign o_dbg_commit_rd     = c_rd_arch;
    assign o_dbg_commit_pdst   = c_rd_pdst;
    assign o_dbg_dptw_req   = dmem_dptw_req;
    assign o_dbg_dptw_addr  = dmem_dptw_addr;
    assign o_dbg_dpte       = dmem_dpte;
    assign o_dbg_dtlb_hit   = dmem_dtlb_hit;
    assign o_dbg_dtlb_ppn   = dmem_dtlb_ppn;
    assign o_dbg_dtlb_perm  = dmem_dtlb_perm;
}
