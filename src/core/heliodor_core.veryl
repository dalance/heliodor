// Phase 7 v4: Heliodor OoO core (M1 wiring).
//
// 1-wide pure Tomasulo: F → D+R → IQ → ALU → C. Backing modules:
//   prf_int       : 64-entry physical register file (2R/1W)
//   free_list     : 32-entry PRF tag pool (1 pop + 1 push / cycle)
//   rat        : speculative + architectural rename map
//   rob        : 32-entry reorder buffer (in-order commit gate)
//   iq_int     : 8-entry integer issue queue
//   alu_wrap   : v1 alu + branch evaluator → CDB
//   decode    : v1 decoder + imm_gen → DecodedOp
//
// Pipeline:
//   F  : fetch instr from imem at pc_q → IF/ID reg
//   DR : decode + rename + ROB.alloc + IQ.alloc (combinational from
//        IF/ID reg; back-pressure stalls F when full)
//   IE : iq_int.issue → alu_wrap → CDB (same cycle).
//        CDB writes prf_int, snoops IQ wakeup, marks ROB.result_written.
//   C  : ROB.commit when head.result_written → arch RAT update + free
//        list push + retire stream output. Mispredict triggers redirect
//        next cycle (flush ROB+IQ, recover RAT, set pc_q to redirect_pc).
//
// M1 only supports RV64I ALU/branch/JAL/JALR/LUI/AUIPC; illegal ops
// raise a precise trap stub (redirect to RESET_PC) — M4 replaces this
// with the csr trap path. LOAD/STORE/CSR/AMO/FP are deferred.
pub module heliodor_core #(
    param RESET_PC: u64 = 64'h80000000,
    param HART_ID : u8  = 0           , // M9: mhartid (for SMP); 0 for single-hart
    // P9.2: SET TO 1 IN MULTI-HART SoCs. Feeds the dcache's local
    // line-departure events into the ROB's CoRR poison scan — required for
    // RVWMO read coherence under PRECISE invalidation (a remote write to a
    // line that already left this L1 is invisible here). Single-hart
    // configurations leave it 0: no remote writers exist, and the poison
    // replays would only cost cycles.
    param SMP_COHERENT: u8 = 0,
    // P9.6: SET TO 1 IN SoCs WITH THE mem_ctrl/L2 MEMORY SYSTEM (both N=1 and
    // SMP). The instruction side (I-cache fill + I-PTW PTE read) is then
    // COHERENT — it reads through L2 with recall-on-owned, so a modified D-cache
    // line is pulled home before the fetch/walk reads it. The FENCE.I /
    // SFENCE.VMA / satp D$ flush SWEEP is then unnecessary and is dropped (the
    // I-cache i_flush + the coherent refill handle visibility on demand).
    // Leave 0 for the bare-core test harnesses, which serve o_dmem from a flat
    // combinational memory with NO recall — there the flush is what makes a
    // self-modified code page / page-table update visible to the next fetch.
    param COHERENT_IFETCH: u8 = 0,
) (
    clk: input clock,
    rst: input reset,

    // Instruction memory (read-only, 32-bit fetch granule)
    o_imem_addr : output logic<64>,
    i_imem_rdata: input  logic<32>,
    o_imem_ren  : output logic    ,

    // Instruction PTW memory (64-bit PTE reads for the IMMU page-table walk).
    // M8.C: a dedicated bus, split out of the dmem port (was muxed onto o_dmem).
    // Single combinational tb: i_iptw_rdata = dram[o_iptw_addr] dword. The SoC's
    // memory_bus arbitrates this as a separate per-hart port (mirrors v1).
    o_iptw_addr : output logic<64>,
    o_iptw_req  : output logic    ,
    i_iptw_rdata: input  logic<64>,

    // Data memory (M5+; M1 holds these inactive)
    // S25: the write channel carries a 64B LINE (8 dword lanes + per-lane
    // byte strobes) per transaction; a slow/MMIO store is a one-lane line
    // write at o_dmemw_addr[5:3] (the address keeps its byte offset).
    o_dmem_addr : output logic<64>    ,
    o_dmem_wdata: output logic<64> [8],
    i_dmem_rdata: input  logic<64>    ,
    // M8: combinational read of the NEXT dword (addr+8 aligned) — used
    // by alu_wrap for misaligned LD/LW/LH that span 2 dwords. Toy
    // memories drive it from the next dram slot; real caches will
    // synthesize via 2 fetches.
    i_dmem_rdata_next: input  logic<64>,
    o_dmem_wen       : output logic        ,
    o_dmem_ren       : output logic        ,
    o_dmem_wstrb     : output logic<8>  [8],
    // M8: hi-side write for misaligned STOREs that span 2 dwords.
    // Tests use this to write the carryover bytes into addr+8.
    o_dmem_wdata_hi: output logic<64>,
    o_dmem_wstrb_hi: output logic<8> ,

    // M9 SMP: dmem bus back-pressure. o_dmem_req = this hart wants the shared
    // DRAM/MMIO bus this cycle (= o_dmem_ren || o_dmem_wen). i_dmem_grant = the
    // SoC's memory_bus granted it. A LOAD/AMO-read completes (CDB + IQ ack) and
    // a STORE commits (rob_commit_ack) only when granted; otherwise the op is
    // held and re-requests. Single-hart SoCs tie i_dmem_grant high → no-op
    // (the request is asserted ungated, so the gate only affects completion).
    o_dmem_req   : output logic,
    i_dmem_grant : input  logic,

    // S23: the dcache mem side is split into a READ channel (o_dmem_addr/
    // o_dmem_ren/i_dmem_rdata + o_dmem_req/i_dmem_grant above, fills and miss
    // reads) and this WRITE channel (write-through + store drain). The write
    // data/strobe/enable keep their o_dmem_w* names; their address is now
    // o_dmemw_addr (it can differ from the read address in the same cycle).
    o_dmemw_addr : output logic<64>,
    o_dmemw_req  : output logic    ,
    i_dmemw_grant: input  logic    ,
    // P9.2: write-channel WRITEBACK flag (dirty-line writeback from the
    // dcache's buffer — the home merges it without invalidates) + the read
    // channel's READ-FOR-OWNERSHIP flag and the home's grant state.
    // Single-hart harnesses: tie i_dmem_fill_excl=1, discard the outputs.
    o_dmemw_wb      : output logic,
    o_dmem_rfo      : output logic,
    // P9.6: the read-channel request is an I-cache fill (UNCOUNTED coherent
    // read — recall-on-owned, no directory add/install). The I-cache fill
    // shares this hart's mem_ctrl read port with the D-cache (D has priority).
    o_dmem_iread    : output logic,
    i_dmem_fill_excl: input  logic,
    // P9.2: PROBE (recall) port from the home + clean ack. Tie 0 / discard
    // in single-hart harnesses.
    i_dcache_probe_v   : input  logic    ,
    i_dcache_probe_addr: input  logic<64>,
    i_dcache_probe_self: input  logic    ,
    o_dcache_probe_ack : output logic    ,

    // M9 SMP coherence: the SoC broadcasts every remote hart's granted DRAM
    // write here (filtered to exclude this hart's own write). It invalidates a
    // matching L1 dcache line AND clears this hart's LR/SC reservation if the
    // remote write hit the reserved address. Single-hart SoCs tie these to 0.
    i_dcache_inv_valid: input logic    ,
    i_dcache_inv_addr : input logic<64>,
    // P9.2: second invalidate port. Under PRECISE invalidation (L2 directory)
    // a granted remote misaligned store invalidates its lo and hi lines in
    // the same cycle — two different line addresses. Applied to the dcache
    // and all the same core-side consumers as port 1. Tie to 0 where unused.
    i_dcache_inv2_valid: input logic    ,
    i_dcache_inv2_addr : input logic<64>,
    // (P9.3: the M9.4 o_amo_inflight / i_amo_locked bus-lock ports are gone —
    // RMW atomicity is in-cache: L1 ownership + the AMO-watch commit replay.)

    // M8.C: external IRQ pins (CLINT / PLIC). Drive low if no SoC.
    i_irq_timer_m: input logic,
    // External CLINT mtime, exposed via CSR_TIME (0xC01)
    i_mtime    : input logic<64>,
    i_irq_sw_m : input logic    ,
    i_irq_ext_m: input logic    ,
    i_irq_ext_s: input logic    , // P9.5: S-mode external (SEIP) from PLIC

    // Debug / cosim observation
    o_dbg_pc            : output logic<64>     ,
    o_dbg_regs          : output logic<64> [32],
    // M9 SMP: architectural x3 exposed as a scalar so an SMP SoC can collect a
    // per-hart pass flag (hart0 x3==0xAA) without a 2D regfile array port.
    o_dbg_x3            : output logic<64>     ,
    o_dbg_retire_v_a    : output logic         ,
    o_dbg_retire_pc_a   : output logic<64>     ,
    o_dbg_retire_rd_v_a : output logic         ,
    o_dbg_retire_rd_a   : output logic<5>      ,
    o_dbg_retire_data_a : output logic<64>     ,
    o_dbg_rename_cnt    : output logic<32>     ,
    o_dbg_cdb_cnt       : output logic<32>     ,
    o_dbg_rob_size      : output logic<8>      ,
    o_dbg_if_v          : output logic         ,
    o_dbg_if_instr      : output logic<32>     ,
    o_dbg_stall_dr      : output logic         ,
    o_dbg_head_valid    : output logic         ,
    o_dbg_head_rw       : output logic         ,
    o_dbg_head_illegal  : output logic         ,
    o_dbg_rob_alloc_cnt : output logic<32>     ,
    o_dbg_rob_cdb_cnt   : output logic<32>     ,
    o_dbg_rob_commit_cnt: output logic<32>     ,
    o_dbg_rob_head      : output logic<6>      ,
    o_dbg_rob_tail      : output logic<6>      ,
    o_dbg_sepc          : output logic<64>     ,
    o_dbg_mepc          : output logic<64>     ,
    o_dbg_priv          : output logic<2>      ,
    o_dbg_trap_fire     : output logic         ,
    o_dbg_trap_pc       : output logic<64>     ,
    o_dbg_trap_cause    : output logic<64>     ,
    o_dbg_trap_to_s     : output logic         ,
    o_dbg_satp          : output logic<64>     ,
    o_dbg_imem_vaddr    : output logic<64>     ,
    o_dbg_imem_paddr    : output logic<64>     ,
    o_dbg_imem_valid    : output logic         ,
    o_dbg_imem_fault    : output logic         ,
    o_dbg_csrwr_v       : output logic         ,
    o_dbg_csrwr_addr    : output logic<12>     ,
    o_dbg_csrwr_wdata   : output logic<64>     ,
    // M9 diag: redirect observation (where does the pipeline jump to?)
    o_dbg_redirect_fire  : output logic    ,
    o_dbg_redirect_pc    : output logic<64>,
    o_dbg_redirect_src_pc: output logic<64>, // PC of the instr that caused the redirect (= c_pc at commit time)
    // Phase 8 perf counters (M0): branch mispredict / redirect / front-end idle.
    o_dbg_mispredict_cnt : output logic<32>, // committed branch mispredicts (= taken control transfers, static not-taken)
    o_dbg_redirect_cnt   : output logic<32>, // total redirect events (mispredict + trap + mret/sret + sc/satp)
    o_dbg_front_idle_cnt : output logic<32>, // cycles fetch could not deliver (icache/MMU stall or post-redirect refill bubble)
    o_dbg_early_mispredict_cnt: output logic<32>, // S8.A: execute-time control mispredicts (>= committed; wrong-path included)
    o_dbg_disp_stall_cnt : output logic<32>, // back-end back-pressure: a ready front-end instr can't rename (ROB/IQ/free-list full)
    o_dbg_mem_busy_cnt   : output logic<32>, // single memory-port occupancy (load issue / PTW walk / store drain / dcache fill)
    o_dbg_commit0_cnt    : output logic<32>, // ROB-head retire stall: cycles nothing commits (head op not finished)
    o_dbg_load_wait_cnt  : output logic<32>, // a selected load can't issue (store-ordering / dcache / PTW serialization)
    o_dbg_load_viol_cnt  : output logic<32>, // Phase 8 S9: memory-order violation events (store-resolve poisons a younger aliasing load)
    // M9 diag: ALU operand observation (verify base.pc passthrough)
    o_dbg_alu_pc_out      : output logic<64>,
    o_dbg_alu_src_a_out   : output logic<64>,
    o_dbg_alu_src_b_out   : output logic<64>,
    o_dbg_alu_use_pc_a_out: output logic    ,
    o_dbg_alu_rs1_data_out: output logic<64>,
    o_dbg_alu_valid_out   : output logic    ,
    o_dbg_alu_alu_out_out : output logic<64>,
    o_dbg_alu_instr_out   : output logic<32>,
    o_dbg_alu_imm_out     : output logic<64>,
    o_dbg_stval_out       : output logic<64>,
    o_dbg_mtval_out       : output logic<64>,
    o_dbg_stvec_out       : output logic<64>, // M9 SMP debug: stvec at trap
    o_dbg_mtvec_out       : output logic<64>, // M9 SMP debug: mtvec at trap
    o_dbg_ptw_req         : output logic    ,
    o_dbg_ptw_addr        : output logic<64>,
    o_dbg_ptw_data        : output logic<64>,
    // M9 diag: LSU / dmem_mmu state for hang localization
    o_dbg_dmem_mmu_busy    : output logic    ,
    o_dbg_core_dmem_vaddr  : output logic<64>,
    o_dbg_core_dmem_wen    : output logic    ,
    o_dbg_core_dmem_ren    : output logic    ,
    o_dbg_imem_ptw_req     : output logic    ,
    o_dbg_commit_store_fire: output logic    ,
    // M9.A.292: AGU input snoop (rs1 read at IQ issue → AGU). Used to
    // localize PRF/RAT race bugs where AGU sees wrong rs1 (e.g. sp=0x1058
    // instead of architectural 0xccbd90 at c.ldsp s0,32(sp)).
    o_dbg_agu_issue_v : output logic    ,
    o_dbg_agu_rs1_arch: output logic<5> ,
    o_dbg_agu_rs1_pdst: output logic<6> ,
    o_dbg_agu_rs1_data: output logic<64>,
    o_dbg_agu_imm     : output logic<64>,
    o_dbg_agu_addr    : output logic<64>,
    o_dbg_agu_is_load : output logic    ,
    o_dbg_agu_is_store: output logic    ,
    // M9.A.293: decisive test for IQ-select-flip-vs-RAT-mismap. rob_idx of
    // the currently-selected issue entry + dmem_mmu_busy. If at the bad cy
    // the issued rob_idx != the faulting c.ldsp ROB entry while busy was high
    // the prior cycle, the select-flip mechanism (A) is confirmed.
    o_dbg_agu_rob_idx: output logic<5>,
    // M9.A.295: F2 walk-owner / fault-inject internal state, to see which
    // load owns the faulting walk and what fault_vaddr is delivered.
    o_dbg_walk_v    : output logic    ,
    o_dbg_walk_rob  : output logic<5> ,
    o_dbg_walk_vaddr: output logic<64>,
    o_dbg_lfault_inj: output logic    ,
    o_dbg_orphan_walk: output logic   ,
    // M9.3 walk-FSM ring enrichment: physical-walk-in-flight, PTW-start pulse,
    // and dmem MMU IDLE, so the ring can disambiguate a fresh re-latch from a
    // stale/orphan walk leaking its fault.
    o_dbg_walk_phys : output logic    ,
    o_dbg_walk_start: output logic    ,
    o_dbg_dmem_idle : output logic    ,
    // M9.3 inject→commit linkage result (first committed garbage-VA load fault).
    o_dbg_dlk_seen   : output logic    ,
    o_dbg_dlk_genuine: output logic    ,
    o_dbg_dlk_inj    : output logic    ,
    o_dbg_dlk_stval  : output logic<64>,
    o_dbg_dlk_pc     : output logic<64>,
    o_dbg_dlk_walkpc : output logic<64>,
    // M9.A.298: CSR translation-state snoop. The MMU's permission check for a
    // U=1 page load in S-mode reduces to tlb_u_ok = i_sum. A TLB-hit load
    // page-fault therefore implies csr_sum==0 at translate time. Exposing the
    // SUM/priv/MXR the dmem MMU sees lets us confirm the OoO CSR-write-vs-load
    // ordering hazard (load translates before an older `csrs sstatus,SUM`
    // commits → MMU sees stale SUM=0 → spurious fault).
    o_dbg_csr_sum      : output logic   ,
    o_dbg_csr_mxr      : output logic   ,
    o_dbg_csr_dmem_priv: output logic<2>,
    // M9.A.303: dmem PTW / faulting-PTE / TLB-hit context for the kernel
    // load-fault loop (VA 0x80616198 spurious fault) characterization.
    o_dbg_dmem_fault: output logic    ,
    o_dbg_dptw_req  : output logic    ,
    o_dbg_dptw_addr : output logic<64>,
    o_dbg_dpte      : output logic<64>,
    o_dbg_dtlb_hit  : output logic    ,
    o_dbg_dtlb_ppn  : output logic<44>,
    o_dbg_dtlb_perm : output logic<4> ,
    // M9.3 SMP: the effective dmem access VA (pre-MMU, = AGU rs1+imm). At a
    // spurious fault this tells operand-garbage (VA==0 ⇒ load read sp≈-40) apart
    // from an MMU mis-fault (VA==the real, mapped address).
    o_dbg_dmem_vaddr: output logic<64>,
    // M9.3 SMP free_list/rat recovery hypothesis: redirect_fire (recovery, already
    // exposed above) and fl_push_en (an rd-bearing commit) in the SAME cycle ⇒ the
    // committing op's pop is still in n_inflight, so the recovery head-rewind
    // RECLAIMS its just-architectural new_pdst → double-alloc → register corruption.
    o_dbg_fl_push_en   : output logic         ,
    o_dbg_commit_rd    : output logic<5>      ,
    o_dbg_commit_pdst  : output logic<6>      ,
) {
    import pipeline_pkg::*;

    // ============================================================
    // Fetch (Stage F)
    // ============================================================
    var pc_q       : logic<64>;
    // Phase 8 S4a: the IF/ID hand-off is now a decoupled fetch buffer (FIFO),
    // not a single registered latch. The if_*_q names below are kept (every
    // consumer — decode, rename, rob alloc, IRQ trap-PC, debug — reads them) but
    // are now COMBINATIONAL reads of the FIFO head (see the fetch_buffer block
    // after the fetch always_ff). Decoupling lets the fetch engine run ahead of
    // rename during back-end stalls and (in S4b) drain 2/cycle for 2-wide rename.
    var if_v_q     : logic    ; // FIFO non-empty (head valid)
    var if_pc_q    : logic<64>;
    var if_instr_q : logic<32>;
    var if_is_rvc_q: logic    ; // M7: was the fetched instr a 2-byte RVC
    var if_pred_next_pc_q: logic<64>; // Phase 8 M1: next PC fetched after the delivered instr (= predicted)
    var if_pred_index_q  : logic<13>; // Phase 8 M4: gshare BHT index used for the delivered instr

    // Phase 8 S4a: fetch buffer (decode queue). Depth-8 FIFO of clean fetched
    // records. Per-field plain arrays (NOT an array of structs) so the
    // combinational head read is not subject to the Veryl-sim dynamic-index
    // struct-field-read staleness bug. Filled by the fetch engine (<=1/cycle in
    // S4a.2, <=2/cycle from S4a.3), drained by rename (<=1/cycle until S4b).
    const FB_DEPTH: u32 = 8;
    var fb_pc          : logic<64> [FB_DEPTH];
    var fb_instr       : logic<32> [FB_DEPTH];
    var fb_is_rvc      : logic     [FB_DEPTH];
    var fb_pred_next_pc: logic<64> [FB_DEPTH];
    var fb_pred_index  : logic<13> [FB_DEPTH];
    var fb_ghr_fold    : logic     [FB_DEPTH]; // S22: spec_ghr_l folded this instance at delivery
    var fb_ifault      : logic     [FB_DEPTH];
    // Phase 11-H3d: per-entry G-stage-fault flag + faulting guest PA for an
    // instruction guest-page-fault. Latched with fb_ifault at push.
    var fb_ifault_gstage: logic    [FB_DEPTH];
    var fb_ifault_gpa   : logic<64>[FB_DEPTH];
    var fb_head : logic<3>; // read pointer (oldest, = IF/ID head)
    var fb_tail : logic<3>; // write pointer (next push slot)
    var fb_count: logic<4>; // occupancy 0..8

    // Forward-declared CSR outputs consumed by imem_mmu/dmem_mmu insts
    // below; driven by csr inst further down.
    var csr_satp: logic             <64>;
    var csr_priv: csr_pkg::PrivLevel    ;
    // M9.A.304: registered previous-cycle priv snapshot from csr, used for
    // sync-exception trap delegation to dodge the cross-module eval-order hazard.
    var csr_priv_prev: csr_pkg::PrivLevel   ;
    var csr_sum      : logic                ;
    var csr_mxr      : logic                ;
    var csr_mprv     : logic                ;
    var csr_pbmte    : logic                ; // P10 Svpbmt: menvcfg.PBMTE
    var dmu_pbmt_unc : logic                ; // P10 Svpbmt: data MMU NC/IO translation
    var csr_adue     : logic                ; // P10 Svadu: menvcfg.ADUE (HW A/D update)
    var dmu_ad_wb    : logic                ; // P10 Svadu: data MMU A/D write-back active
    var csr_pmm_m    : logic             <2>; // P10 Supm: mseccfg.PMM (M-mode pointer mask)
    var csr_pmm_s    : logic             <2>; // P10 Supm: menvcfg.PMM (S-mode)
    var csr_pmm_u    : logic             <2>; // P10 Ssnpm: senvcfg.PMM (U-mode)
    var csr_mpp      : logic             <2>;
    var csr_tvm      : logic                ;
    var csr_tsr      : logic                ;
    var csr_fs       : logic             <2>; // mstatus.FS (00=Off → FP illegal)
    // Phase 11-H: virtualization state for two-stage MMU translation.
    var csr_virt     : logic                ; // current V bit
    var csr_mpv      : logic                ; // mstatus.MPV (MPRV-effective V)
    var csr_hgatp    : logic             <64>;
    var csr_vsatp    : logic             <64>;
    var csr_vs_sum   : logic                ; // vsstatus.SUM (VS-stage)
    var csr_vs_mxr   : logic                ; // vsstatus.MXR (VS-stage)
    var csr_spvp     : logic                ; // hstatus.SPVP (HLV/HSV priv: 1=VS,0=VU)
    // Phase 11-H3: VS trap delegation.
    var csr_virt_prev: logic                ; // registered V snapshot (eval-order safe)
    var csr_hedeleg  : logic             <64>;
    var csr_hideleg  : logic             <64>;
    var csr_vstvec   : logic             <64>;
    // Phase 11-H3b: VS trap-return PC (used by a VS-mode SRET) + the IRQ→VS
    // routing flag (a pending virtual interrupt to be taken in VS-mode).
    var csr_vsepc    : logic             <64>;
    var csr_irq_to_vs: logic                ;
    // M9: satp shadow latched on sfence.vma. Linux head.S sets satp without
    // a preceding sfence, expecting the previous TLB/satp to remain effective
    // until the next sfence (QEMU-compatible behavior). v4's narrow IFU
    // cannot speculate past trampoline→early_pg_dir switch in 6 cycles, so
    // we honor the QEMU model: imem/dmem MMU see satp_shadow, not csr_satp.
    // always_ff for satp_shadow lives after commit_sfence_pulse assignment.
    var satp_shadow: logic<64>;
    // Phase 11-H5: the VS-stage (guest) satp shadow, latched atomically at the
    // guest's `csrw satp` / sfence commit just like satp_shadow, so the two-stage
    // MMU never sees a half-changed vsatp during the guest kernel's enable-MMU
    // trampoline. Inert at V=0 (i_vsatp is only read on the two-stage V=1 path).
    var vsatp_shadow: logic<64>;
    // Effective priv for dmem accesses (MPRV-aware). M-mode loads/stores
    // with MPRV=1 use mstatus.MPP as the priv level for translation.
    let dmem_eff_priv: csr_pkg::PrivLevel = if csr_mprv && csr_priv == csr_pkg::PrivLevel::MACHINE ?
        (if csr_mpp == 2'b11 ?
            csr_pkg::PrivLevel::MACHINE
        : if csr_mpp == 2'b01 ?
            csr_pkg::PrivLevel::SUPERVISOR
        :
            csr_pkg::PrivLevel::USER
        )
    :
        csr_priv
    ;
    // Phase 11-H: effective V for data accesses. MPRV brings M-mode + MPV into a
    // virtualized data access (the access translates as if in VS/VU). Fetch uses
    // csr_virt directly (M-mode fetch is never virtualized). VS-stage permission
    // bits come from the guest sstatus (vsstatus) when the access is virtualized.
    let dmem_eff_virt: logic = if csr_mprv && csr_priv == csr_pkg::PrivLevel::MACHINE ? csr_mpv : csr_virt;
    // Phase 11-H HLV/HSV: the op currently driving the dmem port is a hypervisor
    // virtual-memory access (per-op two-stage translation, even at V=0). Driven
    // (var + assign) near the dmem MMU where the issue/commit/walk sources are in
    // scope. dmem_op_hlvx flags the HLVX execute-permission read. Both 0 unless an
    // HLV/HSV is the driving op, so V=0 / ordinary behaviour is byte-identical.
    var dmem_op_hlv  : logic                ;
    var dmem_op_hlvx : logic                ;
    // A data access is virtualized (two-stage) when V/MPV says so OR it is an
    // HLV/HSV. SUM/MXR then come from the guest sstatus (vsstatus).
    let dmem_virt2   : logic = dmem_eff_virt || dmem_op_hlv;
    let dmem_sum     : logic = if dmem_virt2 ? csr_vs_sum : csr_sum;
    let dmem_mxr     : logic = if dmem_virt2 ? csr_vs_mxr : csr_mxr;
    // HLV/HSV run with the privilege selected by hstatus.SPVP (1=VS supervisor,
    // 0=VU user); ordinary accesses keep the MPRV-effective priv.
    let dmem_mmu_priv: csr_pkg::PrivLevel = if dmem_op_hlv ?
        (if csr_spvp ? csr_pkg::PrivLevel::SUPERVISOR : csr_pkg::PrivLevel::USER)
    :
        dmem_eff_priv
    ;
    let imem_sum     : logic = if csr_virt ? csr_vs_sum : csr_sum;
    let imem_mxr     : logic = if csr_virt ? csr_vs_mxr : csr_mxr;

    // Phase 8 S5.1: Sv39 dmem translation active (mirrors dmem_mmu vm_enabled =
    // satp.MODE==Sv39 && eff_priv != M). Drives rob i_conservative: VA-based
    // store-to-load forwarding/disambiguation is only sound when VA==PA (bare
    // mode); under an MMU the same PA aliases across VAs and MMIO would be
    // wrongly forwarded, so loads fall back to baseline store-ordering there.
    // Phase 11-H: a virtualized data access (dmem_eff_virt) is always translated
    // (two-stage), so it too must be conservative — OR it in (safe; V=0 inert).
    let dmem_vm_on: logic = (satp_shadow[63:60] == 4'd8 && dmem_eff_priv != csr_pkg::PrivLevel::MACHINE)
        || dmem_eff_virt;
    // Phase 11-H: an HLV/HSV is also a translated VA access (VA != PA), so the
    // store/load address-selection + fast-store gates must treat it as VM. This is
    // kept SEPARATE from dmem_vm_on because dmem_vm_on feeds the ROB's
    // i_conservative; folding the per-op flag there closes a combinational loop
    // (dmem_op_hlv → i_conservative → ROB block scan → commit → dmem_op_hlv). The
    // op-aware form below is used only by leaf store/forward gates that never feed
    // back into dmem_op_hlv. 0 unless an HLV/HSV drives the port.
    let dmem_vm_on_op: logic = dmem_vm_on || dmem_op_hlv;

    // P10 Supm/Ssnpm: select the pointer-masking mode by the data access's
    // effective privilege (M→mseccfg, S→menvcfg, U→senvcfg). The masked bits are
    // sign-extended when the address is a translated VA (dmem_vm_on), else zeroed
    // (bare PA). Fed to both ALU AGUs; PMM=0 at reset makes it a no-op.
    let pm_mode: logic<2> = if dmem_eff_priv == csr_pkg::PrivLevel::MACHINE ?
        csr_pmm_m
    : if dmem_eff_priv == csr_pkg::PrivLevel::SUPERVISOR ?
        csr_pmm_s
    :
        csr_pmm_u
    ;
    let pm_va: logic = dmem_vm_on;

    // M5.D.2: forward declaration for IQ-issue/CDB stall gate; driven
    // by the dmem_mmu inst near end of file. Bare mode keeps this at 0.
    var dmem_mmu_busy   : logic;
    var dmem_mmu_fault  : logic;
    var dmem_mmu_fault_s: logic;
    // Phase 11-H3c: the current dmem fault is a G-stage (guest-physical) fault,
    // and the faulting guest PA (for htval). Valid alongside dmem_mmu_fault(_s)
    // — used at commit for a store guest-page-fault (cause 23). 0 while V=0.
    var dmem_mmu_gstage : logic;
    var dmem_mmu_gpa    : logic<64>;
    var dmem_walk_start : logic; // M9.A.296: PTW-start pulse (1 cy at IDLE→walk)
    var dmem_mmu_idle   : logic; // M9.3: dmem MMU FSM is IDLE (no walk owns port)
    // M9.A.303 debug: dmem PTW / faulting-PTE / TLB-hit snoop
    var dmem_dptw_req : logic    ;
    var dmem_dptw_addr: logic<64>;
    var dmem_dpte     : logic<64>;
    var dmem_dtlb_hit : logic    ;
    var dmem_dtlb_ppn : logic<44>;
    var dmem_dtlb_perm: logic<4> ;
    // M9.A.294 (F2): walk-owner tracking for correct load-fault attribution.
    // Latched when a LOAD's MMU walk goes busy; used to deliver the fault to
    // the owner's ROB entry (not the current issue) when o_fault asserts.
    // Declared here (forward) because the rob inst above references the
    // derived inject/suppress signals.
    var walk_v_q         : logic    ;
    var walk_rob_q       : logic<5> ;
    var walk_vaddr_q     : logic<64>;
    var walk_is_store_q  : logic    ; // M9.A.299: walk started by a commit-store
    var walk_pc_q        : logic<64>; // M9.3 inject-linkage probe: PC of the load that started the walk
    // Phase 11-H HLV/HLVX: a LOAD walk's per-op virt flags, latched at walk start
    // so they stay stable across the multi-cycle two-stage walk (the issuing IQ
    // slot is gated off during dmem_mmu_busy). Store walks read c_is_mem_virt
    // directly (store_drive holds it), so these only matter for load walks.
    var walk_hlv_q       : logic    ;
    var walk_hlvx_q      : logic    ;
    // M9.3 SMP: physical PTW-walk-in-progress, tracked INDEPENDENTLY of the owner
    // (walk_v_q clears on a redirect; walk_phys_q does not). walk_phys_q && !walk_v_q
    // at a fault ⇒ an ORPHAN walk (its owner was squashed mid-walk) — its fault must
    // not leak to the current valid issue via the CDB. SMP exposes this because
    // hart1's bus contention stretches walks long enough to outlive a redirect.
    var walk_phys_q      : logic    ;
    var lfault_inj_v     : logic    ; // fault delivery to walk owner this cycle
    var rob_cdb_is_lfault: logic    ; // cdb.is_lfault with mis-attribution removed
    // M5.D: medeleg needed by trap_to_s computation in commit stage.
    var csr_medeleg_w: logic<64>;
    // M5.D: SFENCE.VMA commit pulse (1-cycle), drives mmu i_sfence inputs.
    var commit_sfence_pulse: logic;
    // P9.5: SFENCE.VMA selective-flush operands (forward-declared; assigned at
    // the commit stage, consumed by the imem/dmem MMU instances above).
    var sfence_vaddr   : logic<64>;
    var sfence_asid    : logic<16>;
    var sfence_rs1_zero: logic    ;
    var sfence_rs2_zero: logic    ;
    // M8.A: FENCE.I commit pulse (forward-declared; assigned in commit stage).
    var commit_fence_i_pulse: logic;

    // M9.A.288: forward-declared so commit_irq gate can reference it
    // (the always_ff that assigns redirect_fire_q lives near line 935).
    var redirect_fire_q: logic;

    var redirect_fire: logic    ;
    var redirect_pc  : logic<64>;
    // Phase 8 S8.E: early (execute-time) branch redirect. Forward-declared so the
    // fetch engine / fetch buffer / rename gates below can reference the registered
    // pulse, while the registration always_ff (which needs the late-defined
    // early_mispredict* signals + alu_cdb) lives near the bottom of the module.
    // early_redir_fire_q is a 1-cycle pulse (mirrors redirect_fire_q): the cycle
    // AFTER a control op resolves mispredicted at execute. _idx_q is the resolved
    // branch's rob_idx (drives the partial squash + checkpoint restore); _pc_q is
    // its resolved architectural next-PC (front-end steer target).
    var early_redir_fire_q: logic            ;
    var early_redir_idx_q : logic<ROB_IDX_W> ;
    var early_redir_pc_q  : logic<64>        ;
    // S8.E re-redirect guard: asserted (per CDB lane) the cycle a control op resolves
    // an acted-on execute-time mispredict, so the ROB rewrites that op's predicted
    // next-PC to the resolved target in the CDB writeback (forward-declared; assigned
    // beside early_redir_trigger near the bottom of the module).
    var early_redir_fix0: logic;
    var early_redir_fix1: logic;
    // Unified "a redirect recovery is in flight this cycle" gate. The commit-time
    // redirect (redirect_fire = trap/mret/sret/mispredict/SC-replay/satp) is precise
    // and OUTRANKS the early redirect everywhere; early_redir_fire_q is the
    // execute-time partial recovery. Front-end steering/draining keys on either.
    let any_redirect: logic = redirect_fire || early_redir_fire_q;
    // Phase 8 S4a: forward-declared (assigned by the csr inst's o_irq_pending
    // far below) so the fetch-buffer drain gate in fb_pop / rename_fire can
    // reference it. High when an enabled+pending interrupt should be taken.
    var csr_irq_pending: logic;
    var stall_dr     : logic    ; // back-pressure from D/R
    // Phase 8 S4b: declared early so fb_pop2 (FIFO drain) can reference them
    // before their drivers in the rename stage / ROB instance below.
    var rename_fire2 : logic    ; // 2-wide rename enable (assigned at rename)
    var rob_size     : logic<8> ; // ROB occupancy (driven by the ROB o_size port)

    // M7: RVC fetch path with straddle handling.
    // Normal: pc_q is the logical PC (2-byte aligned), imem fetches the
    // word containing pc_q. The half-word at pc_q[1] is decoded as RVC
    // (bits[1:0]!=11) or 32-bit (bits[1:0]==11).
    // Straddle: when pc[1]=1 and high half is 32-bit, we need bytes from
    // the NEXT word too. We enter STRADDLE state:
    //   cycle T   : detect straddle, save high half (= low 16 bits of
    //               the 32-bit instr) into straddle_low_q, set
    //               straddle_q=1, do NOT fire if_v_q this cycle.
    //   cycle T+1 : imem now fetches pc_q+2 (next word). The instr is
    //               {rdata[15:0], straddle_low_q}. Fire if_v_q, advance
    //               pc_q by 4, clear straddle_q.
    var straddle_q    : logic    ;
    var straddle_low_q: logic<16>;
    var if_ifault_q   : logic    ; // instruction page fault latched at fetch
    // imem_mmu outputs forward-declared so the fetch latch can sample
    // them. Actual assignment happens at the imem_mmu inst below.
    var imem_fault_w: logic;
    // Phase 11-H3d: the fetch fault was a G-stage (guest-physical) fault, and the
    // faulting guest PA — for an instruction guest-page-fault (cause 20, htval).
    var imem_gstage_w: logic;
    var imem_gpa_w   : logic<64>;
    var imem_valid_w: logic;
    var imem_paddr_w: logic<64>; // translated fetch PA (S4a.3 slot-1 same-line check)
    // M8.A: I-cache outputs (instance after imem_mmu). icache_rdata replaces
    // the combinational i_imem_rdata in the fetch path; icache_stall folds
    // into fetch_ready and the imem_mmu i_icache_stall hook. icache_rdata_next
    // is unused — v4 resolves straddles via the explicit 2-cycle re-fetch.
    var icache_rdata     : logic<32>;
    var icache_rdata_next: logic<32>;
    var icache_rdata_next_valid: logic; // Phase 8 S4: next-word present this cycle
    var icache_stall     : logic    ;

    // M8.B: D-cache outputs (instance after dmem_mmu, near end of file).
    // dcache_rdata replaces the combinational i_dmem_rdata for LOAD results
    // (alu_wrap) and PTW PTE reads (dmem_mmu). dcache_stall (combinational
    // on miss/fill/done) folds into the issue/ack/commit gates BLOCKING-style
    // and into dmem_mmu's i_dcache_stall so a PTE read mid-fill holds the walk.
    // Forward-declared because alu_wrap (issue) and the gates use them before
    // the dcache inst. dcache_rdata_next feeds misaligned LOADs (B.3).
    var dcache_rdata     : logic<64>;
    var dcache_rdata_next: logic<64>;
    var dcache_stall     : logic    ;
    // Phase 8 S5.2: 2nd hit-only dcache read port (slot-1 / pipe-1 LOAD). Driver
    // signals (dc_addr2/dc_ren2/dc_load_next2) and result (dcache_rdata2 / _next /
    // dcache_hit2). Forward-declared; the dcache inst is near end of file.
    var dc_addr2          : logic<64>;
    var dc_ren2           : logic    ;
    var dc_load_next2     : logic    ;
    var dcache_rdata2     : logic<64>;
    var dcache_rdata2_next: logic<64>;
    var dcache_hit2       : logic    ;
    // Phase 8 S5.1: a LOAD issue must NOT drive the single dcache port while an
    // older STORE is firing its commit write (store_drive). Without the M2 global
    // load-block, the relaxed store-to-load gate lets a load (even one forwarding
    // from that very store) issue concurrently with the store's commit. The core
    // would then assert BOTH core_dmem_ren (load) and core_dmem_wen (store) with
    // the address pinned to the store → a conflicting dcache request that wedges
    // dcache_stall high forever (the store never completes its write, so it never
    // commits, so store_drive never drops). Declared early (assigned after
    // store_drive); gates issue ack / alu valid / core_dmem_ren below.
    var load_blocks_on_store: logic;

    // Phase 8 S6: a committing BARE-mode aligned PLAIN store (not AMO/SC, not
    // misaligned) takes the SEPARATE dcache store-drain port (i_saddr/i_swen)
    // instead of the combined i_wen path, so it coexists with a load read in
    // the same cycle. fast_store is forward-declared (assigned after the store
    // data / commit_store_fire below); rob_commit_ack reads it here and gates a
    // fast store's retire on dc_sdrain_ack (the store drained) rather than
    // dcache_stall. dc_sdrain_ack is the dcache's o_sdrain_ack (instance below).
    var fast_store   : logic;
    var dc_sdrain_ack: logic;
    // P9.2: dcache presence checks + line-departure events (forward-declared;
    // assigned at the dcache instance, consumed by the LR/SC reservation /
    // SC-watch logic and the ROB CoRR poison ports above the instance).
    var dc_rsv_present: logic    ;
    var dc_scw_present: logic    ;
    var dc_amo_present: logic    ; // P9.3: AMO-watch line presence (chk3)
    // P9.3: declared early — the rsv / AMO-watch PA latches (always_ff
    // blocks well above the dmem_mmu inst) read the translated address.
    var dmu_dmem_addr : logic<64>;
    var dc_evict1_v   : logic    ;
    var dc_evict1_addr: logic<64>;
    var dc_evict2_v   : logic    ;
    var dc_evict2_addr: logic<64>;
    // P9.2 Phase B: dcache flush sweep handshake (FENCE.I / SFENCE.VMA /
    // satp commit — write dirty lines back so the tb-direct instruction
    // fetch / I-PTW see current DRAM). dc_flush_req is assigned at the
    // commit-gate section; dc_flush_done gates the op's retire ack.
    var dc_flush_req : logic;
    var dc_flush_done: logic;
    // Phase 8 S20: committed-store buffer. A retiring aligned plain DRAM
    // store (bare, or VM with a same-cycle TLB-hit translation) is absorbed
    // into a small FIFO and retires IMMEDIATELY — even while a dcache fill or
    // a missing bus grant would have held it at the ROB head (the probe put
    // that head-block at 156K cycles ≈ 1.8% of the N=1 boot, virtually all of
    // it stores). The buffer drains in order through the S6 store-drain port
    // in the background. sb_elig/sb_full/sb_empty are forward-declared for
    // rob_commit_ack; the buffer itself lives next to the commit store path.
    var sb_elig : logic; // head store can be absorbed (classifier)
    var sb_full : logic;
    var sb_empty: logic;
    var sb_push : logic;
    var sb_vm_ok: logic; // VM arm of the classifier (TLB-hit translate ready)
    var sb_pa   : logic<64>;
    // S25 write-combining: entries are cache LINES (64B), not dwords. A push
    // whose PA matches a live entry's line MERGES into that entry's dword lane
    // (byte-granular strobe OR) instead of allocating — a streaming store
    // sequence collapses to one entry per line, and a full buffer still
    // accepts merging stores. sb_lmap is the per-entry lane-occupancy bitmap
    // (bit l = lane l has any byte pending); all overlap scans test
    // line-match + lane bit, which is exactly the old dword granularity.
    const SB_N: u32 = 4;
    var sb_line : logic<58> [SB_N]    ; // PA[63:6] per entry
    var sb_data : logic<64> [SB_N * 8]; // entry i lane l = [i*8+l]
    var sb_strb : logic<8>  [SB_N * 8];
    var sb_lmap : logic<8>  [SB_N]    ;
    var sb_cnt  : logic<4>            ;
    var sb_merge_ok: logic; // this cycle's push can merge (rob_commit_ack reads it)
    var sb_ld_ovl: logic            ; // issuing load's dword span may hit the buffer
    var sb_st_ovl: logic            ; // slow store's dword span may hit the buffer
    assign sb_full  = sb_cnt == 4'd4;
    assign sb_empty = sb_cnt == 4'd0;

    var c_inst_w    : logic<16>;
    var c_expanded_w: logic<32>;
    var c_illegal_w : logic    ;
    inst u_cexp: c_expander ( i_cinstr: c_inst_w, o_instr: c_expanded_w, o_illegal: c_illegal_w );
    // Phase 8 S4a.3: slot-1 RVC expander (2-wide fetch bundle, younger op).
    var c_inst_w1    : logic<16>;
    var c_expanded_w1: logic<32>;
    var c_illegal_w1 : logic    ;
    inst u_cexp1: c_expander ( i_cinstr: c_inst_w1, o_instr: c_expanded_w1, o_illegal: c_illegal_w1 );

    // Halfword pick for the non-straddle cases.
    let curr_hw       : logic<16> = if pc_q[1] ? icache_rdata[31:16] : icache_rdata[15:0];
    let curr_is_rvc   : logic     = curr_hw[1:0] != 2'b11;
    let needs_straddle: logic     = !straddle_q && pc_q[1] && !curr_is_rvc;
    // Phase 8 S7: single-cycle straddle resolution. A 32-bit instr at a halfword
    // boundary (pc_q[1], non-RVC) normally takes a 2-cycle re-fetch (straddle_q),
    // costing a fetch bubble (fetch_ready=0 the prep cycle). When the NEXT 32-bit
    // word is already present in the icache window this cycle (icache_rdata_next_valid)
    // AND in the same 4KB page (so the PA+4 word IS the virtual successor under
    // Sv39 — a cross-page straddle keeps the 2-cycle path, which re-translates
    // pc_q+2), assemble the instr in ONE cycle from {next_lo, curr_hi} and deliver
    // now (no bubble). This is the same {icache_rdata_next, icache_rdata} window the
    // slot-1 path already reads. RVC-mixed code with misaligned 32-bit instrs (e.g.
    // memcpy: 3 of 5 loop ops straddle → 37% i-fetch idle) is the big win.
    let straddle_same_page : logic     = pc_q[11:2] != 10'h3ff;
    let straddle_oneshot   : logic     = needs_straddle && icache_rdata_next_valid && straddle_same_page;
    let needs_straddle_slow: logic     = needs_straddle && !straddle_oneshot;
    let straddle1_instr    : logic<32> = {icache_rdata_next[15:0], icache_rdata[31:16]};
    assign c_inst_w = curr_hw;

    // Straddled 32-bit: low half saved last cycle + new fetch's low half.
    let straddled_instr: logic<32> = {icache_rdata[15:0], straddle_low_q};

    // Choose final 32-bit instr fed to decode.
    let fetched_instr: logic<32> = if straddle_q ?
        straddled_instr
    : if straddle_oneshot ?
        straddle1_instr
    : if curr_is_rvc && c_illegal_w ?
        32'h0000_0000
    : if curr_is_rvc ?
        c_expanded_w
    :
        icache_rdata
    ; // pc[1]=0 + 32b (or 1-cycle straddle)
    let pc_advance   : logic<64> = if straddle_q ? 64'd4 : if curr_is_rvc ? 64'd2 : 64'd4;

    // Fetch ready to deliver an instr to IF/ID this cycle. Under Sv39 the
    // imem_mmu only asserts valid (or fault) once the PT walk completes;
    // gate the latch on it so we don't advance with garbage. In Bare mode
    // imem_valid_w == i_req == 1, so no slowdown.
    // M8.A: also hold delivery while the icache is filling a miss. On a fault
    // i_ren=0 (no lookup) so icache_stall=0 — the fault still delivers.
    let fetch_ready: logic = !needs_straddle_slow && (imem_valid_w || imem_fault_w) && !icache_stall;

    // ============================================================
    // Phase 8 M2: branch prediction (BTB + bimodal BHT) — frontend redirect.
    // Looked up combinationally on pc_q (= the instr delivered this cycle).
    // predicted_taken steers the next fetch to btb_target with no bubble; a
    // wrong prediction is caught at commit (c_bp_mispredict) and flushed. The
    // tables are trained only by committed ops (signals near the commit stage),
    // so wrong-path fetches never pollute them. Prediction is applied only in
    // the delivery arm of the fetch latch below (never during straddle-prep).
    // ============================================================
    var btb_hit    : logic    ;
    var btb_target : logic<64>;
    var btb_is_cond: logic    ;
    var btb_is_call: logic    ;
    var btb_is_ret : logic    ;
    var btb_is_ind : logic    ; // S18: non-return JALR kind
    var bht_taken  : logic    ;
    // M4 gshare: speculative + committed global history. The lookup index folds
    // the speculative history into the low PC index bits. The committed history
    // tracks actual conditional-branch outcomes; on a flush spec <- committed.
    var spec_ghr     : logic<13>; // S13.3: widened to the full gshare index
    var committed_ghr: logic<13>;
    let bht_lk_index : logic<13> = pc_q[13:1] ^ spec_ghr;
    // S22 TAGE-lite: tagged tables over geometrically longer history folds
    // override the base BHT direction when one hits (see tage.veryl). The
    // long history twins mirror spec_ghr/committed_ghr exactly (same shift
    // events, same flush restore) at TAGE's longest fold width.
    var spec_ghr_l     : logic<55>;
    var committed_ghr_l: logic<55>;
    var tage_hit    : logic;
    var tage_taken  : logic;
    var tage_hit2   : logic;
    var tage_taken2 : logic;
    let s22_tage_en : logic = 1'b1;
    // Final direction prediction (slot-0): TAGE provider, else base gshare.
    let cond_taken0: logic = if s22_tage_en && tage_hit ? tage_taken : bht_taken;
    // M3 RAS speculative top (combinational).
    var ras_spec_top  : logic<64>;
    var ras_spec_valid: logic    ;
    // S18 iBTB lookup: history-hashed indirect targets. The index folds the
    // gshare index slice with the indirect PATH history (recent indirect
    // TARGETS) — a state-machine dispatch (`jr` through a jump table) keys
    // its next target on the current state, which IS the previous indirect
    // target; cond-branch GHR alone barely discriminates those (S18 probe:
    // −12% only). spec_ind_hist folds each predicted indirect target at
    // fetch and restores from committed_ind_hist on any flush (same
    // approximation as spec_ghr); the committed twin folds actual targets at
    // commit, so a committing op's PRE-update committed_ind_hist equals its
    // fetch-time spec_ind_hist (older indirects all committed; a mispredicted
    // one squashes this op) — training needs no extra ROB-carried state.
    var spec_ind_hist     : logic<9>;
    var committed_ind_hist: logic<9>;
    var ibtb_hit    : logic    ;
    var ibtb_target : logic<64>;
    var ibtb_hit2   : logic    ;
    var ibtb_target2: logic<64>;
    // A conditional branch is predicted taken per the direction predictor
    // (TAGE over base BHT); JAL/JALR/call/ret (is_cond=0) are predicted
    // taken on any BTB hit.
    let predicted_taken: logic = btb_hit && (!btb_is_cond || cond_taken0);
    // M3: a return's target comes from the RAS (the BTB stores the previous
    // caller's return addr, usually wrong); fall back to the BTB target when the
    // RAS is empty. A wrong target is caught at commit (c_bp_mispredict).
    // S18: a non-return JALR (jump table / ops-table call) takes its target
    // from the iBTB when the (PC, history) entry hits; the BTB's last-target
    // is the fallback. Returns keep the RAS.
    let pred_use_ras   : logic     = btb_hit && btb_is_ret && ras_spec_valid;
    let pred_use_ibtb  : logic     = btb_hit && btb_is_ind && !pred_use_ras && ibtb_hit;
    let pred_target    : logic<64> = if pred_use_ras ? ras_spec_top : if pred_use_ibtb ? ibtb_target : btb_target;
    let pred_next_pc_bp: logic<64> = if predicted_taken ? pred_target : pc_q + pc_advance;

    // ============================================================
    // Phase 8 S4a.3: slot-1 (younger op of a 2-wide fetch bundle). Extracted
    // from the 64-bit window {icache_rdata_next, icache_rdata} when slot-0 is a
    // CLEAN non-straddle delivery (Option B: the proven straddle_q path is left
    // 100% intact — a straddling/faulting/taken slot-0 delivers alone). slot-1
    // is built here but its delivery is gated off in S4a.3-a (slot1_valid_gate=0)
    // and flipped on in S4a.3-b. The 64-bit window has 4 halfwords; with slot-0
    // non-straddling the slot-1 start index b1 is 1 or 2 (never crosses out of
    // the window or into a different page — slot-1 using the next word is
    // restricted to same-line, hence same page as slot-0).
    let fw_hw1: logic<16> = icache_rdata[31:16];     // window halfword 1
    let fw_hw2: logic<16> = icache_rdata_next[15:0]; // window halfword 2
    let fw_hw3: logic<16> = icache_rdata_next[31:16];// window halfword 3
    // b1 = halfword index where slot-1 starts (clean case: curr_is_rvc == slot-0
    // is RVC). pc[1]=0,rvc→1 / pc[1]=0,32b→2 / pc[1]=1,rvc→2 (pc[1]=1,32b is a
    // straddle, excluded by slot1_eligible).
    let s1_b1: logic<2> = (if pc_q[1] ? 2'd1 : 2'd0) + (if curr_is_rvc ? 2'd1 : 2'd2);
    let s1_hw     : logic<16> = if s1_b1 == 2'd1 ? fw_hw1 : fw_hw2; // b1∈{1,2}
    let s1_hw_next: logic<16> = if s1_b1 == 2'd1 ? fw_hw2 : fw_hw3; // halfword b1+1
    let s1_is_rvc : logic     = s1_hw[1:0] != 2'b11;
    assign c_inst_w1 = s1_hw;
    let s1_raw32: logic<32> = {s1_hw_next, s1_hw};
    let s1_instr: logic<32> = if s1_is_rvc && c_illegal_w1 ?
        32'h0000_0000
    : if s1_is_rvc ?
        c_expanded_w1
    :
        s1_raw32
    ;
    let s1_pc: logic<64> = pc_q + pc_advance; // = pc_q + slot-0 length (clean case)
    let s1_len: logic<64> = if s1_is_rvc ? 64'd2 : 64'd4;
    // slot-1 prediction via the BTB/BHT 2nd read ports (lookup on s1_pc).
    var btb_hit2    : logic    ;
    var btb_target2 : logic<64>;
    var btb_is_cond2: logic    ;
    var btb_is_call2: logic    ;
    var btb_is_ret2 : logic    ;
    var btb_is_ind2 : logic    ; // S18
    var bht_taken2  : logic    ;
    let bht_lk_index1   : logic<13> = s1_pc[13:1] ^ spec_ghr;
    // S22: slot-1 final direction (TAGE 2nd port over base BHT 2nd port).
    let cond_taken1     : logic     = if s22_tage_en && tage_hit2 ? tage_taken2 : bht_taken2;
    let predicted_taken1: logic     = btb_hit2 && (!btb_is_cond2 || cond_taken1);
    let pred_use_ras1   : logic     = btb_hit2 && btb_is_ret2 && ras_spec_valid;
    let pred_use_ibtb1  : logic     = btb_hit2 && btb_is_ind2 && !pred_use_ras1 && ibtb_hit2;
    let pred_target1    : logic<64> = if pred_use_ras1 ? ras_spec_top : if pred_use_ibtb1 ? ibtb_target2 : btb_target2;
    let pred_next_pc1   : logic<64> = if predicted_taken1 ? pred_target1 : s1_pc + s1_len;
    // slot-1 delivery eligibility. slot-0 must be a clean (non-straddle, non-
    // fault) delivery that was NOT predicted taken (else slot-1 is wrong-path).
    let slot1_eligible: logic = fetch_ready && !straddle_q && !straddle_oneshot && !imem_fault_w && !predicted_taken;
    // slot-1 needs the next word (rdata_next) unless it is an RVC sitting in the
    // slot-0 word (b1==1 && rvc). Using the next word requires it be in the SAME
    // cache line (→ same page as slot-0, so slot-1's fetch can't fault separately).
    let s1_needs_next: logic = (s1_b1 == 2'd2) || (s1_b1 == 2'd1 && !s1_is_rvc);
    let s1_same_line : logic = imem_paddr_w[5:2] != 4'hf;
    // S4a.3-b: slot-1 delivery is LIVE. The slot-1 datapath (extraction, dual
    // BTB/BHT lookup, 2-push FIFO, 2-bit gshare, dual RAS) feeds the FIFO so the
    // back-end (2-issue since S3.b) drains 2 ops/cycle when operands allow.
    //
    // Enabling it surfaced a pre-existing lost-wakeup bug that S3.a/b had only
    // narrowly avoided: iq_fp's integer-source wakeup (for int→fp ops — FCVT.d.w,
    // FMV.d.x, …) snooped only CDB lane 0. With slot-1 live the IQ fills denser so
    // pipe-1 (lane 1, alu_cdb2) issues far more often, and an int→fp op whose
    // integer source landed on lane 1 never woke → it stalled at the ROB head
    // forever. Symptom: rv64u{f,d}-{fcvt,recoding} (int→fp-dense) ran out their
    // cycle budget with tohost=0; fcvt_w (fp→int, no integer source) passed. Fix:
    // iq_fp now snoops BOTH int CDB lanes (i_int_cdb / i_int_cdb2 = alu_cdb2),
    // mirroring iq_int. (The earlier hypothesis — gate pipe-1 ack on fpu_cdb —
    // was wrong: it would not have closed the lost wakeup.) 152/0 with slot-1 on.
    let slot1_valid_gate: logic = 1'b1;
    let slot1_valid: logic = slot1_valid_gate && slot1_eligible
        && (!s1_needs_next || (s1_same_line && icache_rdata_next_valid));

    // Phase 8 S4a: fetch buffer push/pop/full control.
    //   fb_pop   = rename drains the head this cycle (== rename_fire below;
    //              MUST stay identical or a popped record is never renamed).
    //   fb_full  = no room for a push (full and not simultaneously draining).
    //   fb_push  = the fetch engine delivers a record into the FIFO this cycle.
    // fb_pop depends only on registered state (if_v_q/fb_count) + external
    // resource readiness, so fb_full→fb_push has no combinational cycle.
    // !csr_irq_pending: see the interrupt-drain note at rename_fire — a pending
    // interrupt halts rename so the ROB drains to empty and commit_irq can fire.
    let fb_pop : logic = if_v_q && !stall_dr && !any_redirect && !csr_irq_pending;
    // Phase 8 S4b: slot-1 drain == rename_fire2 (defined below). rename_fire2
    // implies rename_fire (which is identical to fb_pop), so fb_pop2 is only ever
    // set when fb_pop is — the FIFO never drains slot-1 without slot-0.
    let fb_pop2: logic = rename_fire2;
    let fb_full: logic = fb_count == 4'd8 && !fb_pop;
    // Free slots available for a push this cycle (accounts for a simultaneous
    // drain freeing slots). fb_count 0..8, fb_pop/fb_pop2 0..1, so fb_free 0..8.
    let fb_free : logic<4> = (4'd8 - fb_count) + (if fb_pop ? 4'd1 : 4'd0) + (if fb_pop2 ? 4'd1 : 4'd0);
    let fb_tail1: logic<3> = fb_tail + 3'd1; // slot-1 write index (wraps mod 8)
    // Phase 8 S4a.3: 2-wide push. fb_push0 = the slot-0 delivery (== the S4a.2
    // single push); fb_push1 = the slot-1 delivery (needs slot1_valid + room for
    // a 2nd record). slot-0 pushes to fb_tail, slot-1 to fb_tail+1.
    let fb_push0: logic = !any_redirect && !fb_full && fetch_ready;
    let fb_push1: logic = fb_push0 && slot1_valid && fb_free >= 4'd2;
    // M3: an instruction is delivered (its prediction applied) this cycle when
    // the fetch engine pushes it into the FIFO. RAS speculative push/pop and the
    // gshare spec-history update are gated on this so a stalled / squashed /
    // straddle-prep cycle does not perturb them (straddle-prep has fetch_ready=0).
    let fetch_deliver : logic     = fb_push0;
    // RAS speculative update: at most one per cycle. A slot-0 call/ret is always
    // predicted taken (BTB hit, is_cond=0) → slot1_valid=0, so slot-0's RAS update
    // and slot-1's are mutually exclusive. ras_push_addr is the return address of
    // whichever slot is the call (slot-0's pc+len, or slot-1's pc+len).
    let s0_ras_push: logic = fb_push0 && btb_hit && btb_is_call;
    let s0_ras_pop : logic = fb_push0 && btb_hit && btb_is_ret;
    let s1_ras_push: logic = fb_push1 && btb_hit2 && btb_is_call2;
    let s1_ras_pop : logic = fb_push1 && btb_hit2 && btb_is_ret2;
    let ras_push_addr : logic<64> = if s1_ras_push ? s1_pc + s1_len : pc_q + pc_advance;
    let ras_spec_push : logic     = s0_ras_push || s1_ras_push;
    let ras_spec_pop  : logic     = s0_ras_pop || s1_ras_pop;

    // Training signals (driven from the commit stage; forward-referenced here).
    var btb_train_en     : logic    ;
    var bht_train_en     : logic    ;
    var bp_train_pc      : logic<64>;
    var btb_train_target : logic<64>;
    var btb_train_is_cond: logic    ;
    var btb_train_is_call: logic    ;
    var btb_train_is_ret : logic    ;
    var btb_train_is_ind : logic    ; // S18: non-return JALR kind
    var ibtb_train_en    : logic    ; // S18
    var ibtb_train_index : logic<9> ; // S18: fetch-time gshare index slice
    var bht_train_taken  : logic    ;
    var bht_train_index  : logic<13>; // M4 gshare: carried fetch-time index
    // S22 TAGE train (commit; forward-referenced). The index/tag are
    // recomputed inside tage from committed_ghr_l — no carried state.
    var tage_train_en     : logic;
    var tage_train_taken  : logic;
    var tage_train_mispred: logic; // fetch-time DIRECTION mispredict
    var bht_base_pred_c   : logic; // BHT read at the committing op's index
    // M3 RAS architectural push/pop (commit; forward-referenced).
    var ras_arch_push     : logic    ;
    var ras_arch_pop      : logic    ;
    var ras_arch_push_addr: logic<64>;

    inst u_btb: btb (
        clk                               ,
        rst                               ,
        i_pc           : pc_q             ,
        o_hit          : btb_hit          ,
        o_target       : btb_target       ,
        o_is_cond      : btb_is_cond      ,
        o_is_call      : btb_is_call      ,
        o_is_ret       : btb_is_ret       ,
        o_is_ind       : btb_is_ind       , // S18
        // Phase 8 S4a.3: 2nd read port on the slot-1 PC.
        i_pc2          : s1_pc            ,
        o_hit2         : btb_hit2         ,
        o_target2      : btb_target2      ,
        o_is_cond2     : btb_is_cond2     ,
        o_is_call2     : btb_is_call2     ,
        o_is_ret2      : btb_is_ret2      ,
        o_is_ind2      : btb_is_ind2      , // S18
        i_train_en     : btb_train_en     ,
        i_train_pc     : bp_train_pc      ,
        i_train_target : btb_train_target ,
        i_train_is_cond: btb_train_is_cond,
        i_train_is_call: btb_train_is_call,
        i_train_is_ret : btb_train_is_ret ,
        i_train_is_ind : btb_train_is_ind , // S18
    );
    // S18: indirect-target buffer. The lookup index is the gshare index
    // slice XOR the indirect path history (see the spec_ind_hist comment).
    // Trained at commit on non-return JALRs.
    let ibtb_lk_idx0: logic<9> = bht_lk_index[8:0] ^ spec_ind_hist;
    let ibtb_lk_idx1: logic<9> = bht_lk_index1[8:0] ^ spec_ind_hist;
    inst u_ibtb: ibtb (
        clk                             ,
        rst                             ,
        i_index       : ibtb_lk_idx0    ,
        i_pc          : pc_q            ,
        o_hit         : ibtb_hit        ,
        o_target      : ibtb_target     ,
        i_index2      : ibtb_lk_idx1    ,
        i_pc2         : s1_pc           ,
        o_hit2        : ibtb_hit2       ,
        o_target2     : ibtb_target2    ,
        i_train_en    : ibtb_train_en   ,
        i_train_index : ibtb_train_index,
        i_train_pc    : bp_train_pc     ,
        i_train_target: btb_train_target,
    );
    inst u_bht: bht (
        clk                            ,
        rst                            ,
        i_index      : bht_lk_index    ,
        o_taken      : bht_taken       ,
        // Phase 8 S4a.3: 2nd read port on the slot-1 gshare index.
        i_index2     : bht_lk_index1   ,
        o_taken2     : bht_taken2      ,
        // S22: commit-side read at the committing branch's carried index
        // (TAGE altpred fallback; bht_train_index == c_pred_index).
        i_index3     : bht_train_index ,
        o_taken3     : bht_base_pred_c ,
        i_train_en   : bht_train_en    ,
        i_train_index: bht_train_index ,
        i_train_taken: bht_train_taken ,
    );
    // S22 TAGE-lite: tagged direction tables (see tage.veryl). Lookup on the
    // speculative long history; trained at commit from the committed twin.
    inst u_tage: tage (
        clk                                  ,
        rst                                  ,
        i_pc             : pc_q              ,
        i_hist           : spec_ghr_l        ,
        o_hit            : tage_hit          ,
        o_taken          : tage_taken        ,
        i_pc2            : s1_pc             ,
        o_hit2           : tage_hit2         ,
        o_taken2         : tage_taken2       ,
        i_train_en       : tage_train_en     ,
        i_train_pc       : bp_train_pc       ,
        i_train_hist     : committed_ghr_l   ,
        i_train_taken    : tage_train_taken  ,
        i_train_mispred  : tage_train_mispred,
        i_train_base_pred: bht_base_pred_c   ,
    );
    inst u_ras: ras (
        clk                                 ,
        rst                                 ,
        i_spec_push     : ras_spec_push     ,
        i_spec_pop      : ras_spec_pop      ,
        i_spec_push_addr: ras_push_addr     ,
        o_spec_top      : ras_spec_top      ,
        o_spec_valid    : ras_spec_valid    ,
        i_arch_push     : ras_arch_push     ,
        i_arch_pop      : ras_arch_pop      ,
        i_arch_push_addr: ras_arch_push_addr,
        // Phase 8 S8.E: restore the speculative RAS from the architectural stack on
        // an early redirect too (accuracy-only approximation — loses in-flight
        // call/ret nesting between the commit head and the resolved branch).
        i_recovery_fire : any_redirect      ,
    );

    // o_imem_addr / o_imem_ren driven below (after imem_mmu inst). The
    // imem_mmu's i_vaddr is the fetch address — advances ahead of pc_q
    // by 2 during straddle so the next-word fetch lands cycle T+1.

    // ============================================================
    // Phase 8 S4a: fetch engine. Owns pc_q + the straddle state. Decoupled from
    // rename: it advances whenever the fetch buffer has room (fb_full=0), no
    // longer gated on rename back-pressure (was !stall_dr). The delivered record
    // is pushed into the fetch buffer (FIFO) below, not written into a single
    // latch. On a flush pc_q resets here and the FIFO is emptied in its own
    // always_ff. While the FIFO is full the engine freezes (pc_q/straddle held).
    // ============================================================
    always_ff (clk, rst) {
        if_reset {
            pc_q           = RESET_PC;
            straddle_q     = 1'b0;
            straddle_low_q = 16'd0;
        } else if redirect_fire {
            pc_q           = redirect_pc;
            straddle_q     = 1'b0;
            straddle_low_q = 16'd0;
        } else if early_redir_fire_q {
            // Phase 8 S8.E: execute-time redirect steers here a cycle after the
            // branch resolves (commit redirect, above, has priority when both fire).
            pc_q           = early_redir_pc_q;
            straddle_q     = 1'b0;
            straddle_low_q = 16'd0;
        } else if !fb_full {
            if needs_straddle_slow && (imem_valid_w || imem_fault_w) && !icache_stall {
                // Straddle prep (cycle 1 of 2): latch the high half, advance the
                // fetch addr (fetch_vaddr = pc_q+2) next cycle, hold pc_q. Does
                // NOT push — the straddled 32-bit instr delivers on cycle 2.
                // M9.A.255: gate on imem_valid_w. During Sv39 PTW walks mmu's
                // o_paddr returns a stale `pa` derived from the previous walk's
                // leaf_pte_ppn — if this fired before imem_valid_w=1,
                // straddle_low_q would capture garbage from the wrong PA's word,
                // producing a corrupted 32-bit straddled instruction (boot
                // blocker, project_phase7_v4_m9_blocker.md M9.A.254). The old
                // !stall_dr gate (M9.A.315) is gone: with the FIFO decoupling,
                // back-end stalls hold the renamed instr in the FIFO, never in
                // the fetch engine, so straddle-prep can never drop it.
                straddle_q     = 1'b1;
                straddle_low_q = curr_hw;
            } else if fetch_ready {
                // Deliver: push handled in the fetch_buffer always_ff (fb_push0/
                // fb_push1). Steer the next fetch past the delivered bundle — to
                // slot-1's predicted next PC when slot-1 was also pushed, else
                // slot-0's (pred_next_pc_bp). Commit validates it (c_bp_mispredict).
                pc_q        = if fb_push1 ? pred_next_pc1 : pred_next_pc_bp;
                straddle_q  = 1'b0;
            }
            // else: icache filling a miss / Sv39 PTW still walking → hold pc_q +
            // straddle_q so fetch resumes at the same point once the stall clears.
        }
        // else fb_full → freeze the fetch engine (no push possible this cycle).
    }

    // ============================================================
    // Phase 8 S4a: fetch buffer (decode queue). The fetch engine pushes a clean
    // record (fb_push) and rename drains the head (fb_pop). The head is exposed
    // combinationally on the if_*_q names every downstream stage already reads.
    // On a flush the FIFO is emptied (head=tail, count=0). Per-field plain
    // arrays avoid the dynamic-index struct-field-read sim bug.
    // ============================================================
    always_ff (clk, rst) {
        if_reset {
            fb_head  = 3'd0;
            fb_tail  = 3'd0;
            fb_count = 4'd0;
        } else if any_redirect {
            // Phase 8 S8.E: drain the fetch buffer on an early redirect too (it
            // holds wrong-path records younger than the resolved branch).
            fb_head  = 3'd0;
            fb_tail  = 3'd0;
            fb_count = 4'd0;
        } else {
            if fb_push0 {
                fb_pc[fb_tail]           = pc_q;
                fb_instr[fb_tail]        = fetched_instr;
                // M7: track RVC-origin for the link register (pc+2 vs pc+4). A
                // straddle resolves a 32-bit instr, so is_rvc=0 in that case.
                fb_is_rvc[fb_tail]       = !straddle_q && curr_is_rvc;
                fb_ifault[fb_tail]       = imem_fault_w;
                fb_ifault_gstage[fb_tail] = imem_gstage_w;
                fb_ifault_gpa[fb_tail]   = imem_gpa_w;
                fb_pred_next_pc[fb_tail] = pred_next_pc_bp;
                fb_pred_index[fb_tail]   = bht_lk_index;
                fb_ghr_fold[fb_tail]     = btb_hit && btb_is_cond;
            }
            // Phase 8 S4a.3: slot-1 record into fb_tail+1. slot-1 is delivered
            // only on a clean, non-faulting, not-predicted-taken slot-0, so its
            // ifault is 0. Dead until S4a.3-b (fb_push1 needs slot1_valid_gate).
            if fb_push1 {
                fb_pc[fb_tail1]           = s1_pc;
                fb_instr[fb_tail1]        = s1_instr;
                fb_is_rvc[fb_tail1]       = s1_is_rvc;
                fb_ifault[fb_tail1]       = 1'b0;
                fb_ifault_gstage[fb_tail1] = 1'b0; // slot-1 never faults (same page as slot-0)
                fb_ifault_gpa[fb_tail1]   = 64'd0;
                fb_pred_next_pc[fb_tail1] = pred_next_pc1;
                fb_pred_index[fb_tail1]   = bht_lk_index1;
                fb_ghr_fold[fb_tail1]     = btb_hit2 && btb_is_cond2;
            }
            fb_tail = fb_tail + (if fb_push0 ? (if fb_push1 ? 3'd2 : 3'd1) : 3'd0);
            // Phase 8 S4b: 2-wide drain. fb_pop2 (== rename_fire2) drains the
            // head+1 record too, so head advances by 2 and count drops by 2.
            if fb_pop {
                fb_head = fb_head + (if fb_pop2 ? 3'd2 : 3'd1);
            }
            fb_count = fb_count + (if fb_push0 ? (if fb_push1 ? 4'd2 : 4'd1) : 4'd0) - (if fb_pop ? (if fb_pop2 ? 4'd2 : 4'd1) : 4'd0);
        }
    }

    // FIFO head → IF/ID hand-off (combinational reads; latency identical to the
    // old single registered latch since the record was pushed >=1 cycle earlier).
    // Phase 8 S17: fetch-buffer bypass. When the FIFO is EMPTY and the fetch
    // engine delivers this cycle, expose the live delivery directly as the
    // head so rename consumes it the SAME cycle instead of eating a 1-cycle
    // FIFO-traversal bubble (every post-redirect refill and icache-miss
    // return used to pay it). fb_bypass equals fb_push0 at count==0 (the
    // fb_full term is vacuous there) but is written WITHOUT fb_full, cutting
    // the would-be comb loop fb_pop → if_v_q → fb_push0 → fb_full → fb_pop.
    // The record is still physically pushed at the edge; a same-cycle fb_pop
    // just advances head past it (count 0+push−pop stays consistent). If
    // rename stalls or an IRQ is pending, fb_pop=0 and the pushed record is
    // consumed from the FIFO next cycle exactly as before.
    let s17_fb_bypass_en: logic = 1'b1;
    let fb_bypass : logic = s17_fb_bypass_en && (fb_count == 4'd0) && fetch_ready && !any_redirect;
    // Slot-1 bypass: the slot-1 delivery (fb_push1) is also live this cycle.
    // At count==0 fb_free >= 8, so fb_push1 reduces to fb_push0 && slot1_valid.
    let fb_bypass2: logic = fb_bypass && slot1_valid;
    // S17.2 fall-through: with ONE record queued and a live delivery this
    // cycle, the live slot-0 delivery serves as the bundle's SECOND op (the
    // FIFO head is the first; fetch order == predicted program order, so the
    // pairing is correct even across a predicted-taken head). The record is
    // still pushed at the edge; fb_pop2 advances head past it (count
    // 1+push−2 = 0). fb_full is vacuous at count==1, same loop-cut as above.
    let fb_fall: logic = s17_fb_bypass_en && (fb_count == 4'd1) && fetch_ready && !any_redirect;
    assign if_v_q          = (fb_count != 4'd0) || fb_bypass;
    assign if_pc_q         = if fb_count != 4'd0 ? fb_pc[fb_head] : pc_q;
    assign if_instr_q      = if fb_count != 4'd0 ? fb_instr[fb_head] : fetched_instr;
    assign if_is_rvc_q     = if fb_count != 4'd0 ? fb_is_rvc[fb_head] : (!straddle_q && curr_is_rvc);
    assign if_pred_next_pc_q = if fb_count != 4'd0 ? fb_pred_next_pc[fb_head] : pred_next_pc_bp;
    assign if_pred_index_q = if fb_count != 4'd0 ? fb_pred_index[fb_head] : bht_lk_index;
    let if_ghr_fold_q: logic     = if fb_count != 4'd0 ? fb_ghr_fold[fb_head] : (btb_hit && btb_is_cond);
    assign if_ifault_q     = if fb_count != 4'd0 ? fb_ifault[fb_head] : imem_fault_w;
    // Phase 11-H3d: the gstage/gpa travelling with if_ifault_q (same mux).
    let if_ifault_gstage_q: logic     = if fb_count != 4'd0 ? fb_ifault_gstage[fb_head] : imem_gstage_w;
    let if_ifault_gpa_q   : logic<64> = if fb_count != 4'd0 ? fb_ifault_gpa[fb_head] : imem_gpa_w;

    // Phase 8 S4b: slot-1 (head+1) FIFO read for the 2nd decode/rename lane.
    // Combinational reads at fb_head+1 (wraps mod 8). Only meaningful when the
    // FIFO holds >=2 records (rename_fire2 checks fb_count below); harmless to
    // read a stale slot otherwise since every slot-1 consumer is rename_fire2-
    // gated.
    // S17: at count==0 the slot-1 head+1 read muxes to the live slot-1
    // delivery (rename_fire2 admits it via fb_bypass2). S17.2: at count==1
    // it muxes to the live SLOT-0 delivery (fall-through; admitted via
    // fb_fall) — the next record in fetch order after the lone queued head.
    let fb_head_p1: logic<3> = fb_head + 3'd1;
    let if_pc_q1          : logic<64> = if fb_count >= 4'd2 ? fb_pc[fb_head_p1] : if fb_count == 4'd1 ? pc_q : s1_pc;
    let if_instr_q1       : logic<32> = if fb_count >= 4'd2 ? fb_instr[fb_head_p1] : if fb_count == 4'd1 ? fetched_instr : s1_instr;
    let if_is_rvc_q1      : logic     = if fb_count >= 4'd2 ? fb_is_rvc[fb_head_p1] : if fb_count == 4'd1 ? (!straddle_q && curr_is_rvc) : s1_is_rvc;
    let if_pred_next_pc_q1: logic<64> = if fb_count >= 4'd2 ? fb_pred_next_pc[fb_head_p1] : if fb_count == 4'd1 ? pred_next_pc_bp : pred_next_pc1;
    let if_pred_index_q1  : logic<13> = if fb_count >= 4'd2 ? fb_pred_index[fb_head_p1] : if fb_count == 4'd1 ? bht_lk_index : bht_lk_index1;
    let if_ghr_fold_q1    : logic     = if fb_count >= 4'd2 ? fb_ghr_fold[fb_head_p1] : if fb_count == 4'd1 ? (btb_hit && btb_is_cond) : (btb_hit2 && btb_is_cond2);
    let if_ifault_q1      : logic     = if fb_count >= 4'd2 ? fb_ifault[fb_head_p1] : if fb_count == 4'd1 ? imem_fault_w : 1'b0;

    // ============================================================
    // M5.C: imem_mmu wrapper. Bare mode (M-mode or satp.MODE=0) is
    // pure passthrough; o_busy stays 0 and o_paddr == i_vaddr. PTW
    // port tied off for M5.C; M5.D adds Sv39 + dmem-shared PTW
    // arbitration.
    // ============================================================
    // imem_paddr_w forward-declared early (the S4a.3 slot-1 same-line check reads
    // imem_paddr_w[5:2] before this point); assigned by the imem_mmu inst below.
    // imem_valid_w forward-declared with the fetch latch above.
    var imem_busy_w: logic;
    // imem_fault_w forward-declared with the fetch latch above.
    var imem_ptw_addr_w: logic<64>;
    var imem_ptw_req_w : logic    ;
    // Fetch addr advances by 2 during straddle so the next word lands
    // on the next cycle; in normal cycles it tracks pc_q.
    let fetch_vaddr: logic<64> = if straddle_q ? pc_q + 64'd2 : pc_q;
    // M9 (2026-05-25): gate i_req with !redirect_fire. On the redirect cycle,
    // pc_q still holds the OLD value (NBA — update at clock edge), so
    // fetch_vaddr presents the old VA to MMU. Without this gate, MMU at IDLE
    // sees i_req=1 + TLB miss for the old VA and starts a PT walk with
    // old VPN[2] (often = 0 for firmware low-PA returning via mret). That
    // walk reads the wrong L2 PTE (= 0/invalid for VPN[2]=0 in kernel PT)
    // and FAULTs. Next cycle, the imem_fault_w is latched against the NEW
    // PC (post-redirect) as a spurious instr page fault. Cause: ~290K cy
    // wasted per char emission as the S-mode handler "fixes" the non-fault.
    // P9.6 phase 2: the I-PTW PTE reads are now COHERENT — routed through the
    // same mem_ctrl uncounted read as the I-cache fill (recall-on-owned brings a
    // modified PTE home), NOT the old non-coherent o_iptw bus. The FSM + arbiter
    // live after the dcache inst (where i_dmem_rdata/the grant are in scope);
    // iptw_data / iptw_done_q are forward-referenced here.
    var iptw_data  : logic<64>;
    var iptw_done_q: logic    ;
    var iptw_done_a: logic<61>; // dword of the captured PTE (matches o_ptw_addr while valid)
    // The captured PTE is valid ONLY while it matches the MMU's current request
    // dword — the moment the walk advances (o_ptw_addr changes) the still-set
    // iptw_done_q must NOT re-validate the stale PTE for the new level.
    let iptw_pte_valid: logic = iptw_done_q && imem_ptw_addr_w[63:3] == iptw_done_a;
    inst u_imem_mmu: imem_mmu (
        clk                        ,
        rst                        ,
        i_vaddr   : fetch_vaddr    ,
        i_req     : !any_redirect  ,
        o_paddr   : imem_paddr_w   ,
        o_valid   : imem_valid_w   ,
        o_fault   : imem_fault_w   ,
        o_busy    : imem_busy_w    ,
        i_satp    : satp_shadow    ,
        i_priv    : csr_priv       ,
        i_sum     : imem_sum       ,
        i_mxr     : imem_mxr       ,
        i_pbmte   : csr_pbmte      ,
        i_adue    : csr_adue       ,
        // Phase 11-H two-stage fetch translation. csr_virt is the fetch's V
        // (M-mode fetch is never virtualized). G-stage cause is H3 → discard.
        i_virt        : csr_virt   ,
        i_vsatp       : vsatp_shadow,
        i_hgatp       : csr_hgatp  ,
        o_gstage_fault: imem_gstage_w, // Phase 11-H3d: instruction guest-page-fault
        o_fault_gpa   : imem_gpa_w   ,
        o_ptw_addr: imem_ptw_addr_w,
        o_ptw_req : imem_ptw_req_w ,
        // P9.6 phase 2: PTE comes back from the coherent IS read FSM below.
        i_ptw_data    : iptw_data          ,
        i_ptw_valid   : iptw_pte_valid     ,
        i_icache_stall: icache_stall       , // M8.A: hold MMU/TLB during icache fill
        i_sfence      : commit_sfence_pulse,
        i_sfence_vaddr   : sfence_vaddr   , // P9.5: selective flush operands
        i_sfence_asid    : sfence_asid    ,
        i_sfence_rs1_zero: sfence_rs1_zero,
        i_sfence_rs2_zero: sfence_rs2_zero,
        i_redirect    : any_redirect       ,
    );
    let _unused_imem_fault: logic = imem_fault_w;
    let _unused_imem_valid: logic = imem_valid_w;
    let _unused_imem_busy : logic = imem_busy_w;

    // P9.6 phase 2: the dedicated o_iptw bus is retired — PTE reads go through
    // mem_ctrl/L2 (coherent). Tie it off; the tb's combinational iptw serving
    // is dead (the SoC fetches only DRAM PTEs through the shared read port).
    assign o_iptw_addr = 64'd0;
    assign o_iptw_req  = 1'b0;
    let _unused_iptw_rdata: logic<64> = i_iptw_rdata;

    // ============================================================
    // M8.A: L1 instruction cache, inserted between imem_mmu (imem_paddr_w)
    // and the external 32-bit instruction memory port (o_imem_addr /
    // i_imem_rdata). BLOCKING: o_stall (icache_stall) holds the fetch latch
    // and the imem_mmu on a miss until the 16-word line fill completes; the
    // pipeline then reads the combinational hit data (icache_rdata). Mem-side
    // goes DIRECT to the per-hart imem port (NOT through memory_bus); the tb's
    // combinational dram drives i_imem_rdata word-by-word during fill.
    //   - i_ren = imem_valid_w: only look up once the MMU has a valid paddr.
    //     On a page fault imem_valid_w=0 so no lookup/fill occurs (the fault
    //     delivers via if_ifault_q).
    //   - i_flush = commit_fence_i_pulse: FENCE.I invalidates all lines.
    //   - o_rdata_next is unused: v4 resolves halfword-straddled 32-bit instrs
    //     via the explicit 2-cycle re-fetch (fetch_vaddr+2), not a combo probe.
    // ============================================================
    // P9.6: the I-cache fill now rides this hart's mem_ctrl L2 read transaction
    // (coherent — recall-on-owned). It SHARES the D-cache read port through the
    // arbiter below (assigned after the dcache inst, where dc_mem_req is in
    // scope). ic_grant is forward-referenced; ic_mem_*/ic_fill_done are driven
    // by this inst and consumed by the arbiter.
    var ic_mem_addr : logic<64>;
    var ic_mem_req  : logic    ;
    var ic_grant    : logic    ;
    var ic_fill_done: logic    ;
    var ic_owns     : logic    ; // arbiter: instruction side owns the read port (txn in flight)
    var ic_route    : logic    ; // arbiter: route the shared read port to the instruction side
    // P9.6 phase 2: the instruction side has TWO consumers of the shared read
    // port — the I-cache fill and the I-PTW PTE read. is_ptw_q latches which one
    // owns the in-flight transaction; the I-PTW FSM state (busy/cnt) is below.
    var is_ptw_q    : logic    ; // in-flight IS txn is the I-PTW's (vs the I-fill's)
    var iptw_busy   : logic    ; // I-PTW PTE read accepted, streaming
    var iptw_cnt    : logic<3> ; // I-PTW stream beat counter
    var iptw_addr_q : logic<64>; // LATCHED PTE addr for the in-flight read (a
    //                              redirect can change imem_ptw_addr_w mid-read;
    //                              the captured dword must track the read's addr)
    // P9.6: the fetch PA is cacheable iff inside the DRAM window (PA[63:25]==0x40,
    // the same boundary as dc_uncached). A non-DRAM fetch (firmware/boot-ROM)
    // bypasses the cache and is served from the legacy o_imem passthrough.
    let ic_dram: logic = imem_paddr_w[63:25] == 39'h40;
    inst u_icache: icache (
        clk                              ,
        rst                              ,
        i_addr      : imem_paddr_w       ,
        i_ren       : imem_valid_w       ,
        i_flush     : commit_fence_i_pulse,
        i_dram      : ic_dram            ,
        o_rdata     : icache_rdata       ,
        o_rdata_next: icache_rdata_next  ,
        o_rdata_next_valid: icache_rdata_next_valid,
        o_stall     : icache_stall       ,
        o_mem_addr  : ic_mem_addr        ,
        i_mem_rdata : i_dmem_rdata        , // P9.6: 64-bit dword stream (shared D port)
        o_mem_req   : ic_mem_req         ,
        i_mem_grant : ic_grant           ,
        o_fill_done : ic_fill_done       ,
        o_imem_addr : o_imem_addr        , // P9.6: non-DRAM passthrough
        i_imem_rdata: i_imem_rdata       ,
        o_imem_ren  : o_imem_ren         ,
    );
    let _unused_icache_rdata_next: logic<32> = icache_rdata_next;
    let _unused_icache_rdata_next_valid: logic = icache_rdata_next_valid;

    // ============================================================
    // Decode (Stage D)
    // ============================================================
    var dec_op: DecodedOp;
    inst u_dec: decode ( i_pc: if_pc_q, i_instr: if_instr_q, i_is_rvc: if_is_rvc_q, o_op: dec_op );
    // Phase 8 S4b: 2nd decode lane — the younger op (head+1) of a 2-wide rename
    // bundle. Dead until rename_fire2 flips on: dec_op2 feeds only rename_fire2-
    // gated slot-1 ports (RAT reads, free_list pop2, ROB alloc2, IQ alloc2).
    var dec_op2: DecodedOp;
    inst u_dec2: decode ( i_pc: if_pc_q1, i_instr: if_instr_q1, i_is_rvc: if_is_rvc_q1, o_op: dec_op2 );

    // ============================================================
    // Rename (Stage R)
    // ============================================================
    var rs1_pdst   : logic<PRF_INT_W>;
    var rs2_pdst   : logic<PRF_INT_W>;
    var old_rd_pdst: logic<PRF_INT_W>;
    var new_rd_pdst: logic<PRF_INT_W>;
    var free_empty : logic           ;
    var free_avail2: logic           ; // Phase 8 S4b: free-list has >=2 free pdsts
    var iq_alloc_rdy2: logic         ; // Phase 8 S4b: iq_int has a 2nd free slot

    // M6: FP rename / dual datapath (declared early; wired to rat_fp /
    // fp free_list / prf_fp / iq_fp / fpu_wrap instances below).
    var fp_rs1_pdst    : logic<PRF_FP_W>;
    var fp_rs2_pdst    : logic<PRF_FP_W>;
    var fp_rs3_pdst    : logic<PRF_FP_W>;
    var fp_old_rd_pdst : logic<PRF_FP_W>;
    var new_fp_rd_pdst : logic<PRF_FP_W>;
    var fp_free_empty  : logic          ;
    var csr_frm        : logic<3>       ;
    // Dest pdst actually allocated (FP free-list for FP-dest ops, else int).
    let ren_dst_is_fp  : logic          = dec_op.fp_writes_fp;
    let ren_rd_pdst    : logic<PRF_FP_W> = if ren_dst_is_fp ? new_fp_rd_pdst : new_rd_pdst;
    let ren_old_rd_pdst: logic<PRF_FP_W> = if ren_dst_is_fp ? fp_old_rd_pdst : old_rd_pdst;
    // Merged CDB (ALU and FPU are mutually exclusive: at most one valid/cycle).
    var alu_cdb: CdbBus;
    var fpu_cdb: CdbBus;
    // Phase 8 S10.1: deferred MSHR writeback (non-blocking load-miss fill
    // completion). Assigned in the MSHR block after the dcache instance;
    // muxed onto lane 0 below FPU priority.
    var mshr_cdb: CdbBus;
    // Phase 8 S10.3: MSHR capture pulse (forward-ref var, assigned in the MSHR
    // block) — the issuing load misses, the fill starts, and the load is acked
    // OUT of the IQ with its writeback deferred to fill completion.
    var mshr_capture: logic;
    // S10.3/S10.4b MSHR state + rob-port feeds (declared here so the rob
    // instance and the issue gates can consume them; assigned in the MSHR
    // block after the dcache instance). S10.4b: TWO entries (a/b) = one fill
    // OWNER + one QUEUED miss (miss-under-miss); own_q marks which entry the
    // in-flight dcache fill belongs to.
    var mshra_v_q      : logic           ;
    var mshra_done_q   : logic           ;
    var mshra_own_q    : logic           ;
    var mshra_rob_idx_q: logic<ROB_IDX_W>;
    var mshra_pdst_q   : logic<PRF_INT_W>;
    var mshra_has_rd_q : logic           ;
    var mshra_addr_q   : logic<64>       ;
    var mshra_funct3_q : logic<3>        ;
    var mshra_data_q   : logic<64>       ;
    var mshrb_v_q      : logic           ;
    var mshrb_done_q   : logic           ;
    var mshrb_own_q    : logic           ;
    var mshrb_rob_idx_q: logic<ROB_IDX_W>;
    var mshrb_pdst_q   : logic<PRF_INT_W>;
    var mshrb_has_rd_q : logic           ;
    var mshrb_addr_q   : logic<64>       ;
    var mshrb_funct3_q : logic<3>        ;
    var mshrb_data_q   : logic<64>       ;
    var mshr_rec_addr  : logic<64>       ; // = the capturing load's PA/VA (bare)
    var mshr_abort_poison: logic         ; // entry-A poison pulse → rob poison port
    var mshr_poison_idx: logic<ROB_IDX_W>; // entry A's rob idx
    var mshr_abort_poison2: logic         ; // entry-B poison pulse (S24.1 2nd port)
    var mshr_poison_idx2: logic<ROB_IDX_W>; // entry B's rob idx
    // S10.4b: replay injection active — a QUEUED entry's address is driven
    // onto the dcache CPU port (no fill in flight). While high, slot-0 dmem
    // readers yield the port (iss_dc_ok), so dc_hit_safe is the REPLAY
    // address's verdict, not an issuing load's.
    var replay_q: logic;
    // Phase 8 S10.4a: pipe-0 hit-under-miss. dc_hit_safe = the dcache's
    // fill-safe hit on i_addr; ld0_hum_ok (forward-ref, assigned in the MSHR
    // block) lets a plain bare-mode slot-0 load that HITS complete in-pipe
    // while a fill is in flight (dcache_stall high).
    var dc_hit_safe: logic;
    var ld0_hum_ok : logic;
    // Phase 8 S3: CDB lane 1 = pipe-1 (2nd integer ALU/branch). Independent of
    // the lane-0 FPU/ALU interlock; pipe-1 never executes FP.
    var alu_cdb2: CdbBus;
    // iq_fp issue outputs
    var iqf_issue_valid : logic          ;
    var iqf_iss_fpu_op  : fpu_pkg::FpuOp ;
    var iqf_iss_rm      : logic<3>       ;
    var iqf_iss_fli_idx : logic<5>       ;
    var iqf_iss_rd_pdst : logic<PRF_FP_W>;
    var iqf_iss_rob_idx : logic<ROB_IDX_W>;
    var iqf_iss_has_rd  : logic          ;
    var iqf_iss_wr_int  : logic          ;
    var iqf_iss_s1_pdst : logic<PRF_FP_W>;
    var iqf_iss_s2_pdst : logic<PRF_FP_W>;
    var iqf_iss_s3_pdst : logic<PRF_FP_W>;
    var iqf_iss_int_pdst: logic<PRF_FP_W>;
    var iqf_alloc_rdy   : logic          ;
    // prf_fp read data + prf_int 3rd-port (FPU int source) read data
    var prf_fp_rs1_data : logic<64>;
    var prf_fp_rs2_data : logic<64>;
    var prf_fp_rs3_data : logic<64>;
    var prf_int_rs3_data: logic<64>;
    // FPU side-band
    var fpu_fflags    : logic<5>;
    var fpu_fflags_wen: logic   ;
    var fpu_busy      : logic   ;
    // iq_int → iq_fp int-source ready query result
    var iq_int_fp_query_rdy: logic;
    // M6.B.3: FP load/store
    var iq_iss_fp_ld     : logic    ; // issued op is an FP load (FLW/FLD)
    var iq_iss_fp_st     : logic    ; // issued op is an FP store (FSW/FSD)
    var prf_fp_store_data: logic<64>; // prf_fp rs2 read (FP store data)
    var iqf_fp_query_rdy : logic    ; // iq_fp → iq_int FP-store rs2 readiness
    // rs2 pdst routed to iq_int: FP rs2 for an FP store, else the int rs2.
    let ren_rs2_pdst: logic<PRF_FP_W> = if dec_op.fp_st ? fp_rs2_pdst : rs2_pdst;
    // alu_rs2_data (FP store data mux) is defined near u_alu where prf_rs2_data
    // is in scope.

    var rob_alloc_idx: logic<ROB_IDX_W>;
    var rob_head_idx : logic<ROB_IDX_W>; // declared early so iq instance can use it
    var rob_full     : logic           ;
    var iq_alloc_rdy : logic           ;

    // M6: route IQ-readiness to iq_fp for FPU ops, iq_int otherwise; require
    // the int free-list for an int dest and the FP free-list for an FP dest.
    let resources_avail: logic = !rob_full
        && (if dec_op.is_fpu_op ? iqf_alloc_rdy : iq_alloc_rdy)
        && (!dec_op.has_rd || !free_empty)
        && (!dec_op.fp_writes_fp || !fp_free_empty);
    assign stall_dr = if_v_q && !resources_avail;

    // Phase 8 S4a: interrupt-drain gate (!csr_irq_pending). An interrupt is taken
    // only at commit when the ROB is empty (commit_irq = rob_size==0 && ... &&
    // csr_irq_pending). With the 1-deep IF/ID latch the front end naturally left
    // the ROB empty often enough; the decoupled fetch buffer keeps rename fed
    // every cycle, so a hart in a WFI/idle busy-loop (WFI is a NOP in v4) keeps
    // the ROB non-empty and would NEVER reach rob_size==0 → the pending timer/IPI
    // interrupt is never taken → SMP boot livelocks past the normal finish and
    // eventually panics ("Fatal exception in interrupt"). Halting rename while an
    // interrupt is pending drains the in-flight ops so commit_irq can fire. This
    // is the standard precise-interrupt drain; it cannot deadlock (commit is not
    // gated, the ROB empties, and commit_irq keys on the SAME csr_irq_pending, so
    // the trap is taken and clears MIE/SIE → csr_irq_pending drops → rename
    // resumes). fb_pop carries the same gate so no FIFO record is dropped.
    let rename_fire: logic = if_v_q && !stall_dr && !any_redirect && !csr_irq_pending;

    // ROB alloc entry
    var rob_alloc_entry: RobEntry;
    always_comb {
        rob_alloc_entry.valid          = 1'b1;
        rob_alloc_entry.pc             = if_pc_q;
        rob_alloc_entry.rd_arch        = dec_op.rd_arch;
        // M6: dest pdst is the FP pdst for FP-dest ops, else the int pdst
        // (rd_pdst/old_rd_pdst are reused; is_fp_dest routes commit).
        rob_alloc_entry.rd_pdst        = ren_rd_pdst;
        rob_alloc_entry.old_rd_pdst    = ren_old_rd_pdst;
        rob_alloc_entry.has_rd         = dec_op.has_rd;
        rob_alloc_entry.is_fp_dest     = dec_op.fp_writes_fp;
        rob_alloc_entry.is_fp          = dec_op.is_fp;
        rob_alloc_entry.fflags         = 5'd0;
        rob_alloc_entry.fflags_wen     = 1'b0;
        rob_alloc_entry.result_written = 1'b0;
        rob_alloc_entry.is_branch      = dec_op.is_branch;
        rob_alloc_entry.is_jal         = dec_op.is_jal;
        rob_alloc_entry.is_jalr        = dec_op.is_jalr;
        rob_alloc_entry.mispredict     = 1'b0;
        rob_alloc_entry.redirect_pc    = 64'd0;
        // Phase 8 M1: carry the frontend's chosen next PC + control/length so
        // commit can decide mispredict (= pred_next_pc != arch_next_pc).
        rob_alloc_entry.pred_next_pc   = if_pred_next_pc_q;
        rob_alloc_entry.is_rvc         = if_is_rvc_q;
        rob_alloc_entry.is_control     = dec_op.is_branch || dec_op.is_jal || dec_op.is_jalr;
        // M3 RAS: call = jal/jalr writing a link reg (x1/x5); ret = jalr reading
        // a link reg with no link write (RISC-V return-address-stack hints).
        rob_alloc_entry.is_call        = (dec_op.is_jal || dec_op.is_jalr) && (dec_op.rd_arch == 5'd1 || dec_op.rd_arch == 5'd5);
        rob_alloc_entry.is_ret         = dec_op.is_jalr && (dec_op.rs1_arch == 5'd1 || dec_op.rs1_arch == 5'd5) && !(dec_op.rd_arch == 5'd1 || dec_op.rd_arch == 5'd5);
        // M4 gshare: carry the fetch-time BHT index (the speculative-history one
        // actually used for this op's prediction) so commit trains that entry.
        rob_alloc_entry.pred_index     = if_pred_index_q;
        rob_alloc_entry.ghr_fold       = if_ghr_fold_q;
        rob_alloc_entry.illegal        = dec_op.illegal || if_ifault_q;
        rob_alloc_entry.is_ifault      = if_ifault_q;
        // Phase 11-H3d: carry the fetch G-stage-fault flag + guest PA for an
        // instruction guest-page-fault (cause 20 + htval). 0 unless V=1 fetch.
        rob_alloc_entry.ifault_gstage  = if_ifault_gstage_q;
        rob_alloc_entry.ifault_gpa     = if_ifault_gpa_q;
        rob_alloc_entry.result_data    = 64'd0;
        // M5.B: mark stores (and AMO*/SC which commit-store) at alloc so
        // pending-store check sees them BEFORE they CDB. Without this the
        // alloc→CDB window allows younger LOADs to issue past older STOREs.
        rob_alloc_entry.is_store     = dec_op.is_store || dec_op.is_amo;
        rob_alloc_entry.store_addr   = 64'd0;
        rob_alloc_entry.store_data   = 64'd0;
        rob_alloc_entry.store_funct3 = 3'd0;
        // M4 fields captured at alloc (decode)
        // M9.A.298: capture is_csr/csr_addr at alloc (was deferred to CDB) so
        // the ROB translation-barrier (o_has_pending_xlate) sees a pending CSR
        // write to sstatus/mstatus/satp from dispatch and blocks younger LOADs
        // from translating with stale SUM/MXR/satp. csr_wdata still filled at CDB.
        rob_alloc_entry.is_csr    = dec_op.is_csr;
        rob_alloc_entry.csr_addr  = dec_op.csr_addr;
        rob_alloc_entry.csr_wdata = 64'd0;
        rob_alloc_entry.is_ecall  = dec_op.is_ecall;
        rob_alloc_entry.is_ebreak = dec_op.is_ebreak;
        rob_alloc_entry.is_mret   = dec_op.is_mret;
        rob_alloc_entry.is_sret   = dec_op.is_sret;
        rob_alloc_entry.is_sfence = dec_op.is_sfence;
        rob_alloc_entry.sfence_rs1 = dec_op.rs1_arch; // P9.5: SFENCE.VMA VA/ASID regs
        rob_alloc_entry.sfence_rs2 = dec_op.rs2_arch;
        rob_alloc_entry.is_fence_i = dec_op.is_fence_i;
        rob_alloc_entry.is_fence  = dec_op.is_fence;
        rob_alloc_entry.is_cbo_zero = dec_op.is_cbo_zero;
        rob_alloc_entry.is_amo    = dec_op.is_amo;
        // Phase 11-H HLV/HSV: carry the two-stage marker so a committing HSV store
        // drives the dmem MMU in two-stage mode + any HLV/HSV fault sets GVA.
        rob_alloc_entry.is_mem_virt = dec_op.hlv;
    }

    // RenamedOp
    var ren_op: RenamedOp;
    always_comb {
        ren_op.base        = dec_op;
        ren_op.rd_pdst     = ren_rd_pdst;
        ren_op.rs1_pdst    = rs1_pdst;
        ren_op.rs2_pdst    = ren_rs2_pdst;
        ren_op.old_rd_pdst = ren_old_rd_pdst;
        ren_op.rob_idx     = rob_alloc_idx;
    }

    // ============================================================
    // Phase 8 S2: slot-1 rename datapath (2-wide alloc/rename, built dead).
    // ============================================================
    // The slot-1 (younger) op of the rename bundle. The front end is still
    // 1-wide in S2/S3, so there is no second decode yet — slot-1 is sourced from
    // slot-0 as a placeholder and gated entirely off (rename_fire2 = 0). S4
    // repoints the dec_op2_* lets to the real second decode lane and flips
    // rename_fire2 on. With rename_fire2 = 0, every slot-1 module enable is 0, so
    // the pipeline behaves exactly as 1-wide (cycle-exact). This milestone only
    // builds and wires the ports + the intra-bundle rename bypass.
    // Phase 8 S4b: slot-1 eligibility. The slot-1 rename/alloc datapath is
    // integer-only — there is no FP slot-1 port (rat_fp / fp free_list / iq_fp
    // are 1-wide), and pipe-1 has no LOAD/STORE/AMO/CSR side-bands. Restrict
    // slot-1 to a simple register-writing integer ALU op (matches the ROB's
    // c2_simple 2-wide-commit eligibility), so a 2-wide-renamed bundle can also
    // 2-wide-commit. Control transfers are excluded for now (conservative first
    // flip); a later milestone can admit them. has_rd && !fp covers the dest.
    let dec_op2_eligible: logic = dec_op2.has_rd && !dec_op2.fp_writes_fp
        && !dec_op2.is_fpu_op && !dec_op2.fp_ld && !dec_op2.fp_st
        && !dec_op2.is_load && !dec_op2.is_store && !dec_op2.is_amo
        && !dec_op2.is_csr && !dec_op2.is_branch && !dec_op2.is_jal && !dec_op2.is_jalr
        && !dec_op2.is_ecall && !dec_op2.is_ebreak && !dec_op2.is_mret && !dec_op2.is_sret
        && !dec_op2.is_sfence && !dec_op2.is_fence_i && !dec_op2.illegal;
    // S4b.2: 2-wide rename LIVE. slot-1 renames alongside slot-0 when: slot-0
    // fires (rename_fire), the slot-1 op is a simple int ALU op (dec_op2_eligible),
    // the FIFO holds the 2nd record (fb_count >= 2), and there is room for a 2nd
    // op in the int IQ (iq_alloc_rdy2), free-list (free_avail2), and ROB
    // (rob_size <= 30 = room for 2). rename_fire is itself gated on !redirect /
    // !csr_irq / !stall_dr, which rename_fire2 inherits.
    // S17: a 2-wide bundle is also available when BOTH slots are live
    // bypasses of an empty FIFO (fb_bypass2).
    assign rename_fire2 = rename_fire && dec_op2_eligible && (fb_count >= 4'd2 || fb_bypass2 || fb_fall)
        && iq_alloc_rdy2 && free_avail2 && rob_size <= 8'd30;
    // Slot-1 decoded arch fields (real 2nd decode lane). Slot-1 is integer-only,
    // so no FP-dest fields here.
    let dec_op2_rs1_arch : logic<5> = dec_op2.rs1_arch;
    let dec_op2_rs2_arch : logic<5> = dec_op2.rs2_arch;
    let dec_op2_rd_arch  : logic<5> = dec_op2.rd_arch;
    let dec_op2_has_rd   : logic    = dec_op2.has_rd;

    // slot-1 free-list pop (int dest only).
    var new_rd_pdst2: logic<PRF_INT_W>;
    let fl_pop_en2  : logic = rename_fire2 && dec_op2_has_rd;

    // slot-1 RAT raw reads (intra-bundle bypass applied below).
    var rat_rs1_pdst2   : logic<PRF_INT_W>;
    var rat_rs2_pdst2   : logic<PRF_INT_W>;
    var rat_rd_old_pdst2: logic<PRF_INT_W>;
    // o_alloc_idx2 from the ROB; consumed by ren_op2.rob_idx below.
    var rob_alloc_idx2: logic<ROB_IDX_W>;

    // Intra-bundle RAW/WAW bypass: slot-0 renames its int dest to new_rd_pdst
    // this same cycle. slot-1 (younger) must see that mapping for any source or
    // old-dest that names slot-0's rd, because the RAT write lands at the clock
    // edge (slot-1's combinational RAT read would otherwise see the stale value).
    // new_rd_pdst is the free-list registered read, combinationally available →
    // no comb loop. FP-dest slot-0 renames do not touch the int RAT, so the
    // bypass is int-dest-only.
    let s0_int_rename : logic = rename_fire && dec_op.has_rd && !ren_dst_is_fp && dec_op.rd_arch != 5'd0;
    let s1_rs1_pdst   : logic<PRF_INT_W> = if s0_int_rename && dec_op2_rs1_arch == dec_op.rd_arch ? new_rd_pdst : rat_rs1_pdst2;
    let s1_rs2_pdst   : logic<PRF_INT_W> = if s0_int_rename && dec_op2_rs2_arch == dec_op.rd_arch ? new_rd_pdst : rat_rs2_pdst2;
    let s1_old_rd_pdst: logic<PRF_INT_W> = if s0_int_rename && dec_op2_rd_arch == dec_op.rd_arch ? new_rd_pdst : rat_rd_old_pdst2;

    // slot-1 RenamedOp (consumes the bypass + slot-1 pdsts; fed to iq_int's
    // slot-1 alloc port, which is enable-gated off in S2).
    var ren_op2: RenamedOp;
    always_comb {
        ren_op2.base        = dec_op2; // S4b: real 2nd decode lane
        ren_op2.rd_pdst     = new_rd_pdst2;
        ren_op2.rs1_pdst    = s1_rs1_pdst;
        ren_op2.rs2_pdst    = s1_rs2_pdst;
        ren_op2.old_rd_pdst = s1_old_rd_pdst;
        ren_op2.rob_idx     = rob_alloc_idx2;
    }

    // Phase 8 S4b: slot-1 ROB entry (real 2nd-decode lane). Mirrors the slot-0
    // rob_alloc_entry but sourced from dec_op2 + the slot-1 head+1 fetch fields
    // and the slot-1 int pdsts. Slot-1 is integer-only, so is_fp_dest=0; for an
    // eligible op (dec_op2_eligible) the control/mem/csr/fp flags are all 0, but
    // every field is built faithfully so the entry stays correct if eligibility
    // is relaxed later. Consumed by the ROB i_alloc_entry2 port (gated by
    // rename_fire2; dead until S4b.2).
    var rob_alloc_entry2: RobEntry;
    always_comb {
        rob_alloc_entry2.valid          = 1'b1;
        rob_alloc_entry2.pc             = if_pc_q1;
        rob_alloc_entry2.rd_arch        = dec_op2.rd_arch;
        rob_alloc_entry2.rd_pdst        = new_rd_pdst2;
        rob_alloc_entry2.old_rd_pdst    = s1_old_rd_pdst;
        rob_alloc_entry2.has_rd         = dec_op2.has_rd;
        rob_alloc_entry2.is_fp_dest     = dec_op2.fp_writes_fp;
        rob_alloc_entry2.is_fp          = dec_op2.is_fp;
        rob_alloc_entry2.fflags         = 5'd0;
        rob_alloc_entry2.fflags_wen     = 1'b0;
        rob_alloc_entry2.result_written = 1'b0;
        rob_alloc_entry2.is_branch      = dec_op2.is_branch;
        rob_alloc_entry2.is_jal         = dec_op2.is_jal;
        rob_alloc_entry2.is_jalr        = dec_op2.is_jalr;
        rob_alloc_entry2.mispredict     = 1'b0;
        rob_alloc_entry2.redirect_pc    = 64'd0;
        rob_alloc_entry2.pred_next_pc   = if_pred_next_pc_q1;
        rob_alloc_entry2.is_rvc         = if_is_rvc_q1;
        rob_alloc_entry2.is_control     = dec_op2.is_branch || dec_op2.is_jal || dec_op2.is_jalr;
        rob_alloc_entry2.is_call        = (dec_op2.is_jal || dec_op2.is_jalr) && (dec_op2.rd_arch == 5'd1 || dec_op2.rd_arch == 5'd5);
        rob_alloc_entry2.is_ret         = dec_op2.is_jalr && (dec_op2.rs1_arch == 5'd1 || dec_op2.rs1_arch == 5'd5) && !(dec_op2.rd_arch == 5'd1 || dec_op2.rd_arch == 5'd5);
        rob_alloc_entry2.pred_index     = if_pred_index_q1;
        rob_alloc_entry2.ghr_fold       = if_ghr_fold_q1;
        rob_alloc_entry2.illegal        = dec_op2.illegal || if_ifault_q1;
        rob_alloc_entry2.is_ifault      = if_ifault_q1;
        // Phase 11-H3d: slot-1 shares slot-0's fetch line/page, so it never takes
        // a separate fetch fault — its instruction guest-page-fault info is 0.
        rob_alloc_entry2.ifault_gstage  = 1'b0;
        rob_alloc_entry2.ifault_gpa     = 64'd0;
        rob_alloc_entry2.result_data    = 64'd0;
        rob_alloc_entry2.is_store       = dec_op2.is_store || dec_op2.is_amo;
        rob_alloc_entry2.store_addr     = 64'd0;
        rob_alloc_entry2.store_data     = 64'd0;
        rob_alloc_entry2.store_funct3   = 3'd0;
        rob_alloc_entry2.is_csr         = dec_op2.is_csr;
        rob_alloc_entry2.csr_addr       = dec_op2.csr_addr;
        rob_alloc_entry2.csr_wdata      = 64'd0;
        rob_alloc_entry2.is_ecall       = dec_op2.is_ecall;
        rob_alloc_entry2.is_ebreak      = dec_op2.is_ebreak;
        rob_alloc_entry2.is_mret        = dec_op2.is_mret;
        rob_alloc_entry2.is_sret        = dec_op2.is_sret;
        rob_alloc_entry2.is_sfence      = dec_op2.is_sfence;
        rob_alloc_entry2.sfence_rs1     = dec_op2.rs1_arch; // P9.5
        rob_alloc_entry2.sfence_rs2     = dec_op2.rs2_arch;
        rob_alloc_entry2.is_fence_i     = dec_op2.is_fence_i;
        rob_alloc_entry2.is_fence       = dec_op2.is_fence;
        rob_alloc_entry2.is_cbo_zero    = dec_op2.is_cbo_zero;
        rob_alloc_entry2.is_amo         = dec_op2.is_amo;
        // Phase 11-H: slot-1 is ALU-only (no LOAD/STORE), so this is always 0;
        // assigned for struct completeness.
        rob_alloc_entry2.is_mem_virt    = dec_op2.hlv;
    }

    // ============================================================
    // Issue / Execute (Stage IE)
    // ============================================================
    var iq_issue_valid: logic    ;
    var iq_issue_op   : RenamedOp;
    // Per-field issue outputs (sim-bug workaround for cross-module
    // struct-port; mirror of iq_issue_op).
    var iq_iss_rs1_pdst      : logic         <PRF_INT_W>;
    var iq_iss_rs2_pdst      : logic         <PRF_INT_W>;
    var iq_iss_rd_pdst       : logic         <PRF_INT_W>;
    var iq_iss_rob_idx       : logic         <ROB_IDX_W>;
    var iq_iss_is_load       : logic                    ;
    var iq_iss_is_amo        : logic                    ;
    var iq_iss_amo_funct5    : logic         <5>        ;
    var iq_iss_is_csr        : logic                    ;
    var iq_iss_csr_addr      : logic         <12>       ;
    var iq_iss_csr_op        : csr_pkg::CsrOp           ;
    var iq_iss_csr_imm       : logic                    ;
    var iq_iss_rs1_arch      : logic         <5>        ;
    // Phase 8 S3.b: 2nd issue port (pipe-1). slot-1 op + per-field pdsts/rob_idx.
    // pipe-1 is integer ALU/branch only, so no is_load/amo/csr/fp per-field
    // outputs are needed (u_alu2 ties those off).
    var iq_issue_valid2      : logic                    ;
    var iq_issue_op2         : RenamedOp                 ;
    var iq_iss_rs1_pdst2     : logic         <PRF_INT_W>;
    var iq_iss_rs2_pdst2     : logic         <PRF_INT_W>;
    var iq_iss_rd_pdst2      : logic         <PRF_INT_W>;
    var iq_iss_rob_idx2      : logic         <ROB_IDX_W>;
    // Phase 8 S5.2: slot-1 op is a LOAD (per-field) + the slot-1 fire signal
    // (= valid2 for ALU; = a completed bare-mode LOAD hit for a slot-1 load).
    // issue2_fire is forward-ref (drives u_alu2.i_issue_valid + iq.i_issue_ack2)
    // and assigned after the dcache 2nd-port hit is known.
    var iq_iss_is_load2      : logic                    ;
    var issue2_fire          : logic                    ;
    var rob_has_pending_store: logic                    ;
    var rob_has_pending_xlate: logic                    ; // M9.A.298 translation-barrier
    // Phase 8 S5.1 store-to-load: age-relative gate (from u_rob) + the ROB's
    // per-entry store shadow (FF-derived). The byte-granular forward is computed
    // HERE in the core (below, after agu_addr_iss) — the ROB store arrays and
    // agu_addr_iss are forward-refs/local so the (large) byte-network reads only
    // settled values, avoiding the Veryl-sim comb-settle hang that a
    // backward-referenced cross-module array read in a big comb block triggers.
    // The merged result is delivered to alu_wrap as fwd_data[64]/fwd_mask[8].
    var rob_block_store_exists: logic                    ;
    var rob_block_store_age   : logic<ROB_IDX_W>         ;
    var rob_store_addr        : logic<64>     [ROB_DEPTH];
    var rob_store_data        : logic<64>     [ROB_DEPTH];
    var rob_store_funct3      : logic<3>      [ROB_DEPTH];
    var rob_store_fwdable     : logic         [ROB_DEPTH];
    // Phase 8 S8: per-entry prediction shadow for early-mispredict detection.
    var rob_pred_next_pc      : logic<64>     [ROB_DEPTH];
    var rob_is_control        : logic         [ROB_DEPTH];
    var stld_fwd_data         : logic<64>                ;
    var stld_fwd_mask         : logic<8>                 ;
    // Phase 8 S5.2: 2nd store-to-load forward network (slot-1 / pipe-1 LOAD at
    // agu_addr_iss2). Mirror of the slot-0 network below; feeds u_alu2.i_fwd_*.
    var stld_fwd_data2        : logic<64>                ;
    var stld_fwd_mask2        : logic<8>                 ;
    // Local copies of the ROB store shadow: the forward byte-network reads these
    // (same-module) instead of the cross-module rob_store_* arrays 8×32 times —
    // many cross-module array reads in a big comb block hang the Veryl sim.
    var ls_addr               : logic<64>     [ROB_DEPTH];
    var ls_data               : logic<64>     [ROB_DEPTH];
    var ls_f3                 : logic<3>      [ROB_DEPTH];
    var ls_fwd                : logic         [ROB_DEPTH];

    var prf_rs1_data: logic<64>;
    var prf_rs2_data: logic<64>;
    // Phase 8 S3: pipe-1 PRF read data (5R total: rs1_0/rs2_0/fp-int/rs1_1/rs2_1).
    var prf_rs1_data2: logic<64>;
    var prf_rs2_data2: logic<64>;

    var cdb: CdbBus;

    var csr_rd_data    : logic<64>;
    var csr_mtvec      : logic<64>;
    var csr_mepc       : logic<64>;
    var csr_stvec      : logic<64>;
    var dbg_csr_stval  : logic<64>;
    var dbg_csr_mtval  : logic<64>;
    var csr_sepc       : logic<64>;
    var csr_mideleg_w  : logic<64>;
    // csr_irq_pending forward-declared early (interrupt-drain gate in fb_pop /
    // rename_fire references it before this point).
    var csr_irq_cause  : logic<64>;
    var csr_irq_to_s   : logic    ;
    // csr_satp / csr_priv / csr_sum / csr_mxr / csr_medeleg_w declared
    // earlier (M5.C/M5.D forward declarations for inst use sites).

    var rsv_valid_q: logic    ;
    var rsv_addr_q : logic<64>;
    // P9.3: the reservation's PHYSICAL address, latched from the LR read's
    // translated dmem address. The dcache presence check and the precise-inv
    // compares are PA-based (the L1 is PIPT) — under Sv39 the old VA-based
    // compares could never match, leaving VM reservations effectively
    // unclearable by remote writes. rsv_addr_q (VA) stays for the SC's own
    // program-order address match (sc_match / issue_addr_match).
    var rsv_pa_q: logic<64>;
    // M9.4 SMP: the rob_idx of the LR that set the reservation. Used by the age gate
    // in sc_may_clear so an OoO-reordered OLDER sc.w (issuing after a YOUNGER lr.w,
    // e.g. when its result op was delayed by a force-miss fill under N=4 bus
    // contention) cannot wipe the younger lr.w's reservation — the read_lock livelock.
    var rsv_rob_q  : logic<ROB_IDX_W>;
    // Phase 8 M2: high once the reservation's owner LR has committed (the
    // reservation is then architectural; rsv_rob_q is stale). Gates sc_may_clear's
    // owner-committed escape — see the comment there.
    var rsv_committed_q: logic;
    // P9.2: the reserved line has been seen present in the L1 since the
    // owning LR (arms the presence-based clear — see the reservation FF).
    var rsv_present_seen_q: logic;

    // M9.4 SMP: SC commit-time re-validation state (declared early so the
    // commit-redirect always_ff can read it; logic + comment near the
    // reservation always_ff below). P9.3: sc_watch_addr_q holds the PA
    // (= rsv_pa_q at arm) — presence/inv tracking is PA-based.
    var sc_watch_valid_q: logic           ;
    var sc_watch_addr_q : logic<64>       ;
    var sc_watch_rob_q  : logic<ROB_IDX_W>;
    var sc_poison_q     : logic           ;
    // P9.3: AMO watch — the in-cache RMW window [value capture → commit
    // write]. Armed at the AMO read's issue ack with the translated PA;
    // poisoned when the line departs the L1 (presence / precise-inv /
    // departure events); a poisoned AMO at commit suppresses its store and
    // replays from its own PC (commit_amo_replay — the sc_watch shape).
    // While clean it also drives the dcache's bounded ownership PIN.
    var amo_watch_valid_q: logic           ;
    var amo_watch_pa_q   : logic<64>       ;
    var amo_watch_rob_q  : logic<ROB_IDX_W>;
    var amo_poison_q     : logic           ;

    // M5.D.2: dmem_mmu busy stall — issue is held while MMU is in PTW
    // / dcache-stall. In Bare mode busy stays 0 so behavior is
    // unchanged. The IQ's `lowest-idx ready` pick keeps the in-flight
    // LOAD selected every cycle until busy drops and the CDB fires.
    var dbg_alu_pc      : logic<64>;
    var dbg_alu_src_a   : logic<64>;
    var dbg_alu_src_b   : logic<64>;
    var dbg_alu_use_pc_a: logic    ;
    var dbg_alu_rs1_data: logic<64>;
    var dbg_alu_valid   : logic    ;
    var dbg_alu_alu_out : logic<64>;
    var dbg_alu_instr   : logic<32>;
    var dbg_alu_imm     : logic<64>;
    // M9.A.309: block a NON-OWNER load from issuing/acking while a load walk
    // is in flight (walk_v_q). In the 1 stale cycle after the walk owner
    // completes (walk_v_q still set but dmem_mmu_busy already 0) the IQ can
    // select a younger TLB-hit load; without this block it would issue+CDB
    // while core_dmem_vaddr is still pinned to the owner's walk_vaddr_q and so
    // read the OWNER's data (load-load aliasing — `c.ldsp s1,40(sp)` returned
    // [sp+56]=ra's value, broke the Linux boot, cosim diverged @cy7.9M). The
    // owner (iq_iss_rob_idx == walk_rob_q) is NOT blocked; a non-owner waits
    // <=1-2 cy until walk_v_q clears, then issues reading its OWN address.
    // walk_v_q clears on MMU completion regardless of issue, so no deadlock.
    // Loop-free: uses only registers (walk_v_q/walk_is_store_q/walk_rob_q) +
    // the IQ select (iq_issue_op/iq_iss_rob_idx), never core_dmem_vaddr.
    let load_walk_block: logic = walk_v_q && !walk_is_store_q && iq_issue_op.base.is_load && iq_iss_rob_idx
        != walk_rob_q;
    // M9 SMP: bus back-pressure (i_dmem_grant) is owned ENTIRELY by the dcache
    // (since M8.B). The dcache asserts o_dmem_req ungated, waits for i_dmem_grant
    // before filling a miss / writing through, and holds dcache_stall meanwhile;
    // dcache_stall already gates issue / ack / commit below. The earlier M9.1
    // core-level grant gate (`dmem_issue_grant_ok` on every LOAD/AMO issue) is
    // therefore redundant AND deadlocks under a LIVE arbiter grant: a load that
    // HITS makes no bus request, so grant(==req)=0 would block its issue forever
    // (no req → no grant → no issue → no req). Removed — the dcache is the
    // single grant authority. i_dmem_grant now flows only to u_dcache.i_mem_grant.
    // M6: FPU owns the single CDB / PRF-write slot whenever it writes back —
    // a single-cycle FP op this cycle, or an FDIV.D/FSQRT.D completion. The
    // ALU yields issue that cycle. While an FDIV is in flight (busy) the FPU
    // CDB is silent (fpu_cdb.valid=0), so int ops keep issuing — no deadlock
    // for an older int op stuck behind the FDIV in the ROB. fpu_cdb.valid
    // derives only from registered iq_fp / fpu_wrap state, so this is loop-free.
    // M6.B.3: on the ALU branch the dest is FP for an FP load (FLW/FLD).
    // FP-SMP fix: cdb_dest_is_fp MUST mirror the lane-0 mux priority below
    // (fpu_cdb > mshr_cdb > alu_cdb). The original form lumped the MSHR and ALU
    // tiers together as `iq_iss_fp_ld`, but an MSHR completion is a DEFERRED
    // writeback of an EARLIER load — its FP-ness has nothing to do with the op
    // the IQ is presenting THIS cycle (iq_iss_fp_ld). MSHR captures exclude FP
    // loads (mshr_plain_load requires !iq_iss_fp_ld), so every mshr_cdb is an
    // INT load. When mshr_cdb wins the mux while the IQ happens to present an FP
    // load (iq_iss_fp_ld=1, issue blocked by mshr_cdb.valid), cdb_dest_is_fp went
    // HIGH → the int PRF write (line ~1940) and the int IQ wakeup (i_cdb_has_rd,
    // line ~2228) were suppressed, AND the int load's data was wrongly written
    // to the FP PRF (line ~2118). The consumer of that load never woke → it sat
    // at the ROB head forever (observed: __schedule FP context switch wedge at
    // 0x800df482, FP-on N=2 boot). FP-off never triggers it (iq_iss_fp_ld==0).
    let cdb_dest_is_fp: logic = if fpu_cdb.valid ? !iqf_iss_wr_int : if mshr_cdb.valid ? 1'b0 : iq_iss_fp_ld;
    // rs2 operand fed to the ALU: FP store data from prf_fp, else int rs2.
    let alu_rs2_data: logic<64> = if iq_iss_fp_st ? prf_fp_store_data : prf_rs2_data;
    // P9.3 in-cache AMO: the M9.4 bus-atomic AMO lock (amo_read_pending_q /
    // amo_issue_lock_ok / o_amo_inflight) is GONE. The AMO/LR read acquires
    // the line E/M in the L1 (RFO), the commit write merges locally, and a
    // line departure inside the RMW window poisons the AMO watch (below) for
    // a commit-time replay — no bus-wide serialization, no issue bubble.
    // Phase 8 S10.3: dcache_stall now gates ONLY ops that read the dcache at
    // issue (loads incl. FP loads, and AMO/LR/SC value-capture reads). Stores
    // (AGU-only at issue; their write drains at commit, separately gated),
    // CSR, MUL/DIV and plain ALU ops issue freely while a miss fills — the
    // memory pipe is non-blocking for independent work. Loads/AMOs that miss
    // while the fill is busy simply wait in the IQ (blocking fallback;
    // miss-under-miss is S10.4).
    // Phase 8 S10.4a: ld0_hum_ok additionally lets a plain bare-mode slot-0
    // load complete in-pipe while a fill is in flight, when the fill-safe
    // dcache hit (dc_hit_safe) says its data is consistent (the filling way
    // is excluded inside the dcache).
    // S10.4b: dmem readers also yield while a queued-MSHR replay is driving
    // the dcache port (!replay_q) — during a replay cycle i_addr is the
    // replayed entry's, so dc_hit_safe is not the issuing load's verdict.
    let iss_reads_dmem: logic = iq_issue_op.base.is_load || iq_iss_is_amo;
    let iss_dc_ok     : logic = !iss_reads_dmem || (!replay_q && (!dcache_stall || ld0_hum_ok));
    // Phase 8 S10.1: lane-0 priority FPU > MSHR (deferred load fill) > ALU.
    // The MSHR holds its completion (mshr_done_q) until the FPU lane is free,
    // and the ALU yields issue/ack the cycle the MSHR writes back (gates below).
    always_comb {
        cdb = if fpu_cdb.valid ? fpu_cdb : if mshr_cdb.valid ? mshr_cdb : alu_cdb;
    }
    inst u_alu: alu_wrap (
        i_issue_valid     : iq_issue_valid && !dmem_mmu_busy && !load_walk_block && !fpu_cdb.valid && !mshr_cdb.valid && iss_dc_ok && !load_blocks_on_store,
        i_issue_op        : iq_issue_op                                         ,
        i_issue_rd_pdst   : iq_iss_rd_pdst                                      ,
        i_issue_rob_idx   : iq_iss_rob_idx                                      ,
        i_rs1_data        : prf_rs1_data                                        ,
        i_rs2_data        : alu_rs2_data                                        ,
        i_pm_mode         : pm_mode                                            ,
        i_pm_va           : pm_va                                              ,
        // M8.B: LOAD result + next-dword come from the dcache (combinational
        // hit data). On a miss dcache_stall=1 gates i_issue_valid above so the
        // CDB write is suppressed until the fill lands; the IQ keeps the op
        // (iq_issue_ack also gated) and re-issues it once the line is cached.
        i_load_data       : dcache_rdata                                        ,
        i_load_data_next  : dcache_rdata_next                                   ,
        // Phase 8 S5.1: core-computed store-to-load forward bytes + mask.
        i_fwd_data        : stld_fwd_data                                       ,
        i_fwd_mask        : stld_fwd_mask                                       ,
        i_dmem_fault      : dmem_mmu_fault                                      ,
        i_dmem_fault_s    : dmem_mmu_fault_s                                    ,
        i_csr_data        : csr_rd_data                                         ,
        i_rsv_valid       : rsv_valid_q                                         ,
        i_rsv_addr        : rsv_addr_q                                          ,
        i_is_amo          : iq_iss_is_amo                                       ,
        i_amo_funct5      : iq_iss_amo_funct5                                   ,
        i_is_csr          : iq_iss_is_csr                                       ,
        i_csr_addr        : iq_iss_csr_addr                                     ,
        i_csr_op          : iq_iss_csr_op                                       ,
        i_csr_imm         : iq_iss_csr_imm                                      ,
        i_rs1_arch        : iq_iss_rs1_arch                                     ,
        i_priv            : csr_priv                                            ,
        i_fp_ld           : iq_iss_fp_ld                                        ,
        o_cdb             : alu_cdb                                             ,
        o_dbg_alu_pc      : dbg_alu_pc                                          ,
        o_dbg_alu_src_a   : dbg_alu_src_a                                       ,
        o_dbg_alu_src_b   : dbg_alu_src_b                                       ,
        o_dbg_alu_use_pc_a: dbg_alu_use_pc_a                                    ,
        o_dbg_alu_rs1_data: dbg_alu_rs1_data                                    ,
        o_dbg_alu_valid   : dbg_alu_valid                                       ,
        o_dbg_alu_alu_out : dbg_alu_alu_out                                     ,
        o_dbg_alu_instr   : dbg_alu_instr                                       ,
        o_dbg_alu_imm     : dbg_alu_imm                                         ,
    );

    // ============================================================
    // Phase 8 S3: pipe-1 — 2nd integer execute pipe (ALU/branch/JAL/JALR/LUI/
    // AUIPC only). Built DEAD in S3.a: issue2_valid=0, so alu_cdb2 is silent and
    // the 2nd PRF write / ROB writeback / IQ snoop never fire (cycle-exact vs
    // 1-wide issue). S3.b drives issue2_valid + the slot-1 issue op from the IQ's
    // 2nd issue port. mem/csr/amo/fp inputs are tied off — pipe-1 never executes
    // a LOAD/STORE/AMO/CSR/FP op (those stay slot-0 only).
    // S3.b: pipe-1 issues whenever the IQ's 2nd port presents an op. No extra
    // gating — pipe-1 has no LOAD/STORE/AMO/CSR/FP, so it is independent of the
    // pipe-0 hazards (dcache_stall / dmem_mmu_busy / load_walk_block /
    // fpu_cdb.valid / amo lock); its CDB lane 1, PRF write port 1 and ROB
    // writeback port 1 are all separate from lane 0.
    // Phase 8 S5.2: pipe-1 now also executes bare-mode LOADs. alu_wrap re-derives
    // the AGU (i_rs1_data2 + imm == agu_addr_iss2) and the load merge from the 2nd
    // dcache read (dcache_rdata2 / _next) + the 2nd forward network. i_issue_valid
    // = issue2_fire (an ALU op always fires; a slot-1 load fires only when it hits
    // the 2nd port — else it is held in the IQ). A slot-1 LOAD is bare-mode, so
    // i_dmem_fault stays 0; FP loads stay slot-0 (i_fp_ld=0).
    inst u_alu2: alu_wrap (
        i_issue_valid     : issue2_fire      ,
        i_issue_op        : iq_issue_op2    , // S3.b: slot-1 issue op
        i_issue_rd_pdst   : iq_iss_rd_pdst2 , // S3.b: slot-1 rd pdst
        i_issue_rob_idx   : iq_iss_rob_idx2 , // S3.b: slot-1 rob idx
        i_rs1_data        : prf_rs1_data2   ,
        i_rs2_data        : prf_rs2_data2   ,
        i_pm_mode         : pm_mode         , // P10 pointer masking (slot-1 bare loads)
        i_pm_va           : pm_va           ,
        i_load_data       : dcache_rdata2   , // S5.2: 2nd dcache read
        i_load_data_next  : dcache_rdata2_next,
        i_fwd_data        : stld_fwd_data2  , // S5.2: 2nd forward network
        i_fwd_mask        : stld_fwd_mask2  ,
        i_dmem_fault      : 1'b0            ,
        i_dmem_fault_s    : 1'b0            ,
        i_csr_data        : 64'd0           , // pipe-1: no CSR
        i_rsv_valid       : 1'b0            ,
        i_rsv_addr        : 64'd0           ,
        i_is_amo          : 1'b0            , // pipe-1: no AMO
        i_amo_funct5      : 5'd0            ,
        i_is_csr          : 1'b0            ,
        i_csr_addr        : 12'd0           ,
        i_csr_op          : csr_pkg::CsrOp::RW,
        i_csr_imm         : 1'b0            ,
        i_rs1_arch        : 5'd0            ,
        i_priv            : csr_priv        ,
        i_fp_ld           : 1'b0            , // pipe-1: no FP
        o_cdb             : alu_cdb2        ,
        o_dbg_alu_pc      : _               ,
        o_dbg_alu_src_a   : _               ,
        o_dbg_alu_src_b   : _               ,
        o_dbg_alu_use_pc_a: _               ,
        o_dbg_alu_rs1_data: _               ,
        o_dbg_alu_valid   : _               ,
        o_dbg_alu_alu_out : _               ,
        o_dbg_alu_instr   : _               ,
        o_dbg_alu_imm     : _               ,
    );

    // M5.D.2: gate ack on MMU busy. While busy the IQ holds the op.
    // M9.A.309: also hold a non-owner load while a load walk is in flight
    // (load_walk_block) so it cannot ack/leave the IQ without issuing.
    // M6: also yield the ack when the FPU owns the CDB this cycle, else the
    // ALU op would leave iq_int without writing back (lost op → ROB stuck).
    // M8.B: also hold the op in the IQ while the dcache stalls (load miss /
    // fill / write-during-fill). The op re-issues each cycle (core_dmem_ren
    // stays asserted, driving the fill) but does not ack/leave until the data
    // is cached and dcache_stall drops.
    // Phase 8 S10.1: also yield the ack when the MSHR owns the CDB (deferred
    // load-fill writeback), mirroring the FPU-yield term.
    // Phase 8 S10.3: a CAPTURED missing load acks OUT of the IQ on the
    // fill-start cycle (mshr_capture) even though dcache_stall holds — its
    // writeback is deferred to the MSHR; u_alu.i_issue_valid stays suppressed
    // that cycle (iss_dc_ok=0 for a load under stall), so no CDB write happens.
    let iq_issue_ack: logic = (iq_issue_valid && !dmem_mmu_busy && !load_walk_block && !fpu_cdb.valid && !mshr_cdb.valid && iss_dc_ok && !load_blocks_on_store) || mshr_capture;

    // ============================================================
    // PRF
    // ============================================================
    inst u_prf: prf_int (
        clk                                                  ,
        rst                                                  ,
        i_rd1_pdst: iq_iss_rs1_pdst                          ,
        o_rd1_data: prf_rs1_data                             ,
        i_rd2_pdst: iq_iss_rs2_pdst                          ,
        o_rd2_data: prf_rs2_data                             ,
        i_rd3_pdst: iqf_iss_int_pdst                         , // M6: FPU int source
        o_rd3_data: prf_int_rs3_data                         ,
        // Phase 8 S3.b: pipe-1 read pair — the slot-1 issue rs1/rs2 pdsts.
        i_rd4_pdst: iq_iss_rs1_pdst2                         ,
        o_rd4_data: prf_rs1_data2                            ,
        i_rd5_pdst: iq_iss_rs2_pdst2                         ,
        o_rd5_data: prf_rs2_data2                            ,
        i_wr_en   : cdb.valid && cdb.has_rd && !cdb_dest_is_fp,
        i_wr_pdst : cdb.pdst                                 ,
        i_wr_data : cdb.data                                 ,
        // Phase 8 S3: CDB lane 1 (pipe-1) write — always integer (no FP on pipe-1).
        i_wr_en2  : alu_cdb2.valid && alu_cdb2.has_rd        ,
        i_wr_pdst2: alu_cdb2.pdst                            ,
        i_wr_data2: alu_cdb2.data                            ,
    );

    // ============================================================
    // free_list
    // ============================================================
    var fl_push_en  : logic           ;
    var fl_push_pdst: logic<PRF_INT_W>;
    // Phase 8 S1: 2-wide commit slot-1 integer free-list push.
    var fl_push_en2  : logic           ;
    var fl_push_pdst2: logic<PRF_INT_W>;

    // Phase 8 S8: branch-checkpoint capture controls, shared by the int/fp RAT and
    // both free lists. At a CONTROL op's rename, each module snapshots its rename
    // state (rat_spec map / free_list head) AS OF that op, keyed by its rob_idx, so
    // an execute-time mispredict (S8.A early_mispredict) can be recovered in one
    // cycle without a ROB walk. Restore is gated OFF here (s8_restore_en = 0) — the
    // checkpoints are captured but never applied — until S8.E wires the trigger.
    let s8_ckpt0_en   : logic            = rename_fire && rob_alloc_entry.is_control;
    let s8_ckpt0_idx  : logic<ROB_IDX_W> = rob_alloc_idx;
    let s8_ckpt1_en   : logic            = rename_fire2 && rob_alloc_entry2.is_control;
    let s8_ckpt1_idx  : logic<ROB_IDX_W> = rob_alloc_idx2;
    // Phase 8 S8.E: the flip. Restore the int/fp RAT + both free lists from the
    // resolved branch's checkpoint, and partial-squash the ROB + both IQs of every
    // entry younger than it, the cycle after the mispredict is detected at execute.
    // Gated by !redirect_fire so a same-cycle commit redirect (full flush) wins;
    // when it does, the ROB/RAT/free-list recover via i_redirect_fire/i_recovery_fire
    // instead. The restore index = the squash index = the resolved branch's rob_idx.
    let s8_restore_en : logic            = early_redir_fire_q && !redirect_fire;
    let s8_restore_idx: logic<ROB_IDX_W> = early_redir_idx_q;

    let fl_pop_en: logic = rename_fire && dec_op.has_rd;
    inst u_fl: free_list (
        clk                           ,
        rst                           ,
        i_pop_en       : fl_pop_en    ,
        o_pop_pdst     : new_rd_pdst  ,
        i_pop_en2      : fl_pop_en2   ,
        o_pop_pdst2    : new_rd_pdst2 ,
        o_empty        : free_empty   ,
        o_avail2       : free_avail2  ,
        i_push_en      : fl_push_en   ,
        i_push_pdst    : fl_push_pdst ,
        i_push_en2     : fl_push_en2  ,
        i_push_pdst2   : fl_push_pdst2,
        i_recovery_fire: redirect_fire,
        i_ckpt0_en     : s8_ckpt0_en  ,
        i_ckpt0_idx    : s8_ckpt0_idx ,
        i_ckpt1_en     : s8_ckpt1_en  ,
        i_ckpt1_idx    : s8_ckpt1_idx ,
        i_restore_en   : s8_restore_en,
        i_restore_idx  : s8_restore_idx,
    );

    // ============================================================
    // RAT
    // ============================================================
    var rat_commit_en  : logic           ;
    var rat_commit_arch: logic<5>        ;
    var rat_commit_pdst: logic<PRF_INT_W>;
    // Phase 8 S1: 2-wide commit slot-1 arch-RAT write.
    var rat_commit_en2  : logic           ;
    var rat_commit_arch2: logic<5>        ;
    var rat_commit_pdst2: logic<PRF_INT_W>;

    inst u_rat: rat (
        clk                                          ,
        rst                                          ,
        i_rs1_arch     : dec_op.rs1_arch             ,
        o_rs1_pdst     : rs1_pdst                    ,
        i_rs2_arch     : dec_op.rs2_arch             ,
        o_rs2_pdst     : rs2_pdst                    ,
        i_rd_arch      : dec_op.rd_arch              ,
        o_rd_old_pdst  : old_rd_pdst                 ,
        // Phase 8 S2: slot-1 raw reads (core applies the intra-bundle bypass).
        i_rs1_arch2    : dec_op2_rs1_arch            ,
        o_rs1_pdst2    : rat_rs1_pdst2               ,
        i_rs2_arch2    : dec_op2_rs2_arch            ,
        o_rs2_pdst2    : rat_rs2_pdst2               ,
        i_rd_arch2     : dec_op2_rd_arch             ,
        o_rd_old_pdst2 : rat_rd_old_pdst2            ,
        i_rename_en    : rename_fire && dec_op.has_rd,
        i_rename_arch  : dec_op.rd_arch              ,
        i_rename_pdst  : new_rd_pdst                 ,
        // Phase 8 S2: slot-1 rename write (int dest), gated off until S4.
        i_rename_en2   : rename_fire2 && dec_op2_has_rd,
        i_rename_arch2 : dec_op2_rd_arch             ,
        i_rename_pdst2 : new_rd_pdst2                ,
        i_commit_en    : rat_commit_en               ,
        i_commit_arch  : rat_commit_arch             ,
        i_commit_pdst  : rat_commit_pdst             ,
        i_commit_en2   : rat_commit_en2              ,
        i_commit_arch2 : rat_commit_arch2            ,
        i_commit_pdst2 : rat_commit_pdst2            ,
        i_recovery_fire: redirect_fire               ,
        i_ckpt0_en     : s8_ckpt0_en                 ,
        i_ckpt0_idx    : s8_ckpt0_idx                ,
        i_ckpt1_en     : s8_ckpt1_en                 ,
        i_ckpt1_idx    : s8_ckpt1_idx                ,
        i_restore_en   : s8_restore_en               ,
        i_restore_idx  : s8_restore_idx              ,
    );

    // ============================================================
    // M6: FP datapath — rat_fp + fp free_list + prf_fp + iq_fp + fpu_wrap
    // ============================================================
    var fp_rat_commit_en: logic          ;
    var fp_fl_push_en   : logic          ;
    var fp_fl_push_pdst : logic<PRF_FP_W>;

    inst u_rat_fp: rat_fp (
        clk                                                ,
        rst                                                ,
        i_rs1_arch     : dec_op.rs1_arch                   ,
        o_rs1_pdst     : fp_rs1_pdst                       ,
        i_rs2_arch     : dec_op.rs2_arch                   ,
        o_rs2_pdst     : fp_rs2_pdst                       ,
        i_rs3_arch     : dec_op.rs3_arch                   ,
        o_rs3_pdst     : fp_rs3_pdst                       ,
        i_rd_arch      : dec_op.rd_arch                    ,
        o_rd_old_pdst  : fp_old_rd_pdst                    ,
        i_rename_en    : rename_fire && dec_op.fp_writes_fp,
        i_rename_arch  : dec_op.rd_arch                    ,
        i_rename_pdst  : new_fp_rd_pdst                    ,
        i_commit_en    : fp_rat_commit_en                  ,
        i_commit_arch  : rat_commit_arch                   , // = c_rd_arch (shared)
        i_commit_pdst  : rat_commit_pdst                   , // = c_rd_pdst (shared)
        i_recovery_fire: redirect_fire                     ,
        i_ckpt0_en     : s8_ckpt0_en                       ,
        i_ckpt0_idx    : s8_ckpt0_idx                      ,
        i_ckpt1_en     : s8_ckpt1_en                       ,
        i_ckpt1_idx    : s8_ckpt1_idx                      ,
        i_restore_en   : s8_restore_en                     ,
        i_restore_idx  : s8_restore_idx                    ,
    );

    inst u_fl_fp: free_list (
        clk                                                 ,
        rst                                                 ,
        i_pop_en       : rename_fire && dec_op.fp_writes_fp ,
        o_pop_pdst     : new_fp_rd_pdst                     ,
        // FP free list stays 1-wide (FP is rare, pipe-0 only): slot-1 pop/push
        // ports tied off.
        i_pop_en2      : 1'b0                               ,
        o_pop_pdst2    : _                                  ,
        o_empty        : fp_free_empty                      ,
        o_avail2       : _                                  , // FP free-list 1-wide

        i_push_en      : fp_fl_push_en                      ,
        i_push_pdst    : fp_fl_push_pdst                    ,
        i_push_en2     : 1'b0                               ,
        i_push_pdst2   : 6'd0                               ,
        i_recovery_fire: redirect_fire                      ,
        i_ckpt0_en     : s8_ckpt0_en                        ,
        i_ckpt0_idx    : s8_ckpt0_idx                       ,
        i_ckpt1_en     : s8_ckpt1_en                        ,
        i_ckpt1_idx    : s8_ckpt1_idx                       ,
        i_restore_en   : s8_restore_en                      ,
        i_restore_idx  : s8_restore_idx                     ,
    );

    inst u_prf_fp: prf_fp (
        clk                                                  ,
        rst                                                  ,
        i_rd1_pdst: iqf_iss_s1_pdst                          ,
        o_rd1_data: prf_fp_rs1_data                          ,
        i_rd2_pdst: iqf_iss_s2_pdst                          ,
        o_rd2_data: prf_fp_rs2_data                          ,
        i_rd3_pdst: iqf_iss_s3_pdst                          ,
        o_rd3_data: prf_fp_rs3_data                          ,
        i_rd4_pdst: iq_iss_rs2_pdst                          , // M6.B.3: FP store data
        o_rd4_data: prf_fp_store_data                        ,
        i_wr_en   : cdb.valid && cdb.has_rd && cdb_dest_is_fp,
        i_wr_pdst : cdb.pdst                                 ,
        i_wr_data : cdb.data                                 ,
    );

    let iqf_issue_ack: logic = iqf_issue_valid && !fpu_busy && !redirect_fire;
    inst u_iq_fp: iq_fp (
        clk                                                       ,
        rst                                                       ,
        i_alloc_en          : rename_fire && dec_op.is_fpu_op     ,
        i_alloc_fpu_op      : dec_op.fpu_op                       ,
        i_alloc_rm          : dec_op.fp_rm                        ,
        i_alloc_fli_idx     : dec_op.rs1_arch                     , // P10 Zfa FLI index = rs1 field

        i_alloc_rd_pdst     : ren_rd_pdst                         , // FP pdst (writes_fp) or INT pdst (writes_int)
        i_alloc_rob_idx     : rob_alloc_idx                       ,
        i_alloc_has_rd      : dec_op.fp_writes_fp || dec_op.fp_writes_int,
        i_alloc_writes_int  : dec_op.fp_writes_int               ,
        i_alloc_s1_pdst     : fp_rs1_pdst                         ,
        i_alloc_s2_pdst     : fp_rs2_pdst                         ,
        i_alloc_s3_pdst     : fp_rs3_pdst                         ,
        i_alloc_has_s1      : dec_op.fp_rs1_is_fp                 ,
        i_alloc_has_s2      : dec_op.fp_rs2_is_fp                 ,
        i_alloc_has_s3      : dec_op.fp_uses_rs3                  ,
        i_alloc_int_pdst    : rs1_pdst                            , // INT source (int→fp)
        i_alloc_has_int     : dec_op.fp_int_src                   ,
        i_alloc_int_ready   : iq_int_fp_query_rdy                 ,
        o_alloc_rdy         : iqf_alloc_rdy                       ,
        i_rename_set_pending: rename_fire && dec_op.fp_writes_fp  ,
        i_rename_pdst       : new_fp_rd_pdst                      ,
        i_fp_cdb_valid      : cdb.valid && cdb_dest_is_fp         ,
        i_fp_cdb_has_rd     : cdb.has_rd                          ,
        i_fp_cdb_pdst       : cdb.pdst                            ,
        i_int_cdb_valid     : cdb.valid && !cdb_dest_is_fp        ,
        i_int_cdb_has_rd    : cdb.has_rd                          ,
        i_int_cdb_pdst      : cdb.pdst                            ,
        // Phase 8 S4a.3: 2nd INT CDB snoop (pipe-1 / lane 1). alu_cdb2 is always
        // integer, so it feeds the int-source wakeup of int→fp ops unfiltered.
        i_int_cdb2_valid    : alu_cdb2.valid                     ,
        i_int_cdb2_has_rd   : alu_cdb2.has_rd                    ,
        i_int_cdb2_pdst     : alu_cdb2.pdst                      ,
        i_fp_query_pdst     : fp_rs2_pdst                         , // M6.B.3: FP-store rs2 readiness
        o_fp_query_rdy      : iqf_fp_query_rdy                    ,
        o_issue_valid       : iqf_issue_valid                    ,
        o_issue_fpu_op      : iqf_iss_fpu_op                     ,
        o_issue_rm          : iqf_iss_rm                         ,
        o_issue_fli_idx     : iqf_iss_fli_idx                    ,

        o_issue_rd_pdst     : iqf_iss_rd_pdst                    ,
        o_issue_rob_idx     : iqf_iss_rob_idx                    ,
        o_issue_has_rd      : iqf_iss_has_rd                     ,
        o_issue_writes_int  : iqf_iss_wr_int                     ,
        o_issue_s1_pdst     : iqf_iss_s1_pdst                    ,
        o_issue_s2_pdst     : iqf_iss_s2_pdst                    ,
        o_issue_s3_pdst     : iqf_iss_s3_pdst                    ,
        o_issue_int_pdst    : iqf_iss_int_pdst                   ,
        i_issue_ack         : iqf_issue_ack                      ,
        i_flush             : redirect_fire                      ,
        // Phase 8 S8.E: early partial squash (flip). Drop iq_fp entries younger
        // than the resolved branch; survivors keep their CDB wakeups.
        i_rob_head_idx      : rob_head_idx                       ,
        i_squash_en         : s8_restore_en                      ,
        i_squash_idx        : s8_restore_idx                     ,
    );

    inst u_fpu: fpu_wrap (
        clk                                ,
        rst                                ,
        i_issue_valid     : iqf_issue_valid,
        i_fpu_op          : iqf_iss_fpu_op ,
        i_fp_rm           : iqf_iss_rm     ,
        i_fli_idx         : iqf_iss_fli_idx,
        i_frm             : csr_frm        ,
        i_issue_rd_pdst   : iqf_iss_rd_pdst,
        i_issue_rob_idx   : iqf_iss_rob_idx,
        i_issue_has_rd    : iqf_iss_has_rd ,
        i_issue_writes_int: iqf_iss_wr_int ,
        i_s1_data         : prf_fp_rs1_data,
        i_s2_data         : prf_fp_rs2_data,
        i_s3_data         : prf_fp_rs3_data,
        i_int_rs1_data    : prf_int_rs3_data,
        i_flush           : redirect_fire  ,
        o_fpu_busy        : fpu_busy       ,
        o_cdb             : fpu_cdb        ,
        o_fflags          : fpu_fflags     ,
        o_fflags_wen      : fpu_fflags_wen ,
    );

    // ============================================================
    // IQ
    // ============================================================
    inst u_iq: iq_int (
        clk                                               ,
        rst                                               ,
        i_alloc_en          : rename_fire && !dec_op.is_fpu_op    ,
        i_alloc_op          : ren_op                      ,
        o_alloc_rdy         : iq_alloc_rdy                ,
        // Phase 8 S2: slot-1 alloc (integer-only; gated off via rename_fire2=0
        // until S4). Phase 8 S4b: o_alloc_rdy2 now gates rename_fire2.
        i_alloc_en2         : rename_fire2                ,
        i_alloc_op2         : ren_op2                     ,
        o_alloc_rdy2        : iq_alloc_rdy2               ,
        // M6: clear int prf-ready only on an INT dest rename (has_rd covers
        // int ops + FP→INT). FP-dest renames clear the FP bitmap in iq_fp.
        i_rename_set_pending: rename_fire && dec_op.has_rd,
        i_rename_pdst       : new_rd_pdst                 ,
        // Phase 8 S2: slot-1 rename clear (int dest), gated off until S4.
        i_rename_set_pending2: rename_fire2 && dec_op2_has_rd,
        i_rename_pdst2       : new_rd_pdst2               ,
        i_cdb_valid         : cdb.valid                   ,
        i_cdb_has_rd        : cdb.has_rd && !cdb_dest_is_fp,
        i_cdb_pdst          : cdb.pdst                    ,
        // Phase 8 S3: 2nd int CDB snoop (pipe-1 lane). Silent in S3.a.
        i_cdb2_valid        : alu_cdb2.valid              ,
        i_cdb2_has_rd       : alu_cdb2.has_rd             ,
        i_cdb2_pdst         : alu_cdb2.pdst               ,
        i_fp_int_query_pdst : rs1_pdst                    , // M6: iq_fp int-source ready
        o_fp_int_query_rdy  : iq_int_fp_query_rdy         ,
        // M6.B.3: FP CDB snoop + FP-store rs2 initial readiness (from iq_fp).
        i_fp_cdb_valid      : cdb.valid && cdb_dest_is_fp ,
        i_fp_cdb_has_rd     : cdb.has_rd                  ,
        i_fp_cdb_pdst       : cdb.pdst                    ,
        i_alloc_rs2_fp_ready: iqf_fp_query_rdy            ,
        o_issue_valid       : iq_issue_valid              ,
        o_issue_op          : iq_issue_op                 ,
        o_issue_rs1_pdst    : iq_iss_rs1_pdst             ,
        o_issue_rs2_pdst    : iq_iss_rs2_pdst             ,
        o_issue_rd_pdst     : iq_iss_rd_pdst              ,
        o_issue_rob_idx     : iq_iss_rob_idx              ,
        o_issue_is_load     : iq_iss_is_load              ,
        o_issue_is_amo      : iq_iss_is_amo               ,
        o_issue_amo_funct5  : iq_iss_amo_funct5           ,
        o_issue_is_csr      : iq_iss_is_csr               ,
        o_issue_csr_addr    : iq_iss_csr_addr             ,
        o_issue_csr_op      : iq_iss_csr_op               ,
        o_issue_csr_imm     : iq_iss_csr_imm              ,
        o_issue_rs1_arch    : iq_iss_rs1_arch             ,
        o_issue_fp_ld       : iq_iss_fp_ld               , // M6.B.3
        o_issue_fp_st       : iq_iss_fp_st               ,
        i_issue_ack         : iq_issue_ack                ,
        // Phase 8 S3.b: 2nd issue port (pipe-1). ack2 == valid2 (pipe-1 has no
        // back-pressure), so an op that the IQ presents on slot-1 always leaves.
        o_issue_valid2      : iq_issue_valid2             ,
        o_issue_op2         : iq_issue_op2                ,
        o_issue_rs1_pdst2   : iq_iss_rs1_pdst2            ,
        o_issue_rs2_pdst2   : iq_iss_rs2_pdst2            ,
        o_issue_rd_pdst2    : iq_iss_rd_pdst2             ,
        o_issue_rob_idx2    : iq_iss_rob_idx2             ,
        o_issue_is_load2    : iq_iss_is_load2            , // Phase 8 S5.2
        i_issue_ack2        : issue2_fire                 ,
        i_flush             : redirect_fire               ,
        // Phase 8 S5.1 age-relative store-to-load gate (was global i_block_loads).
        i_block_store_exists: rob_block_store_exists      ,
        i_block_store_age   : rob_block_store_age         ,
        i_block_mem_xlate   : rob_has_pending_xlate       , // M9.A.298 xlate barrier
        i_rob_head_idx      : rob_head_idx                ,
        // Phase 8 S8.E: early partial squash (flip). Drop iq_int entries younger
        // than the resolved branch (age via the shared S4c head-relative metric).
        i_squash_en         : s8_restore_en               ,
        i_squash_idx        : s8_restore_idx              ,
    );

    // ============================================================
    // ROB
    // ============================================================
    var rob_commit_valid: logic              ;
    var rob_commit_entry: RobEntry           ;
    var rob_commit_idx  : logic   <ROB_IDX_W>;
    // rob_size declared early (near stall_dr) for the S4b rename_fire2 gate.

    // Per-field commit signals (sim-bug workaround for cross-module
    // struct-port; mirror of rob_commit_entry.X).
    var c_pc          : logic<64>       ;
    var c_rd_arch     : logic<5>        ;
    var c_rd_pdst     : logic<PRF_INT_W>;
    var c_old_rd_pdst : logic<PRF_INT_W>;
    // Phase 8 S1: 2-wide commit slot-1 (head+1, simple integer ops only).
    var c2_valid      : logic           ;
    var c2_pc         : logic<64>       ;
    var c2_rd_arch    : logic<5>        ;
    var c2_rd_pdst    : logic<PRF_INT_W>;
    var c2_old_rd_pdst: logic<PRF_INT_W>;
    var c2_has_rd     : logic           ;
    var c2_result_data: logic<64>       ;
    var c_has_rd      : logic           ;
    var c_illegal     : logic           ;
    var c_redirect_pc : logic<64>       ;
    // Phase 8 M1: carried fields for the commit-time mispredict decision.
    var c_pred_next_pc: logic<64>       ;
    var c_early_fix   : logic           ; // S22: op was early-redirected at execute
    var c_is_rvc      : logic           ;
    var c_is_control  : logic           ;
    var c_is_cond     : logic           ; // M2: conditional branch (BHT train)
    var c_is_call     : logic           ; // M3: call (RAS push + BTB kind)
    var c_is_ret      : logic           ; // M3: return (RAS pop + BTB kind)
    var c_pred_index  : logic<13>       ; // M4: carried gshare BHT index
    var c_ghr_fold    : logic           ; // S22: instance folded spec_ghr_l at fetch
    var c_result_data : logic<64>       ;
    var c_is_store    : logic           ;
    var c_is_amo      : logic           ; // Phase 8 S6: head is AMO/LR/SC (vs plain store)
    var c_is_mem_virt : logic           ; // Phase 11-H HLV/HSV: committing head is a 2-stage access
    var c_store_addr  : logic<64>       ;
    var c_store_data  : logic<64>       ;
    var c_store_funct3: logic<3>        ;
    var c_is_csr      : logic           ;
    var c_csr_addr    : logic<12>       ;
    var c_csr_wdata   : logic<64>       ;
    var c_is_ecall    : logic           ;
    var c_is_ebreak   : logic           ;
    var c_is_mret     : logic           ;
    var c_is_sret     : logic           ;
    var c_is_sfence   : logic           ;
    var c_sfence_rs1  : logic<5>        ; // P9.5: SFENCE.VMA rs1 (VA reg) at head
    var c_sfence_rs2  : logic<5>        ; // P9.5: SFENCE.VMA rs2 (ASID reg) at head
    var c_is_fence_i  : logic           ; // M8.A FENCE.I → icache flush
    var c_is_fence    : logic           ; // P9.0: plain FENCE (drain-wait gate)
    var c_is_cbo_zero : logic           ; // P10 Zicboz cbo.zero at commit
    var c_is_ifault   : logic           ;
    var c_is_lfault   : logic           ;
    var c_is_sfault   : logic           ;
    var c_fault_vaddr : logic<64>       ;
    // Phase 11-H3c: committing load fault's G-stage flag + faulting guest PA.
    var c_fault_gstage: logic           ;
    var c_fault_gpa   : logic<64>       ;
    // M9.3 inject-linkage probe (debug): head entry's recorded walk-start PC
    // and inject-delivered flag.
    var commit_dbg_walk_pc: logic<64>   ;
    var commit_dbg_inj    : logic       ;
    // M6: FP commit
    var c_is_fp_dest  : logic           ;
    var c_is_fp       : logic           ;
    var c_fflags      : logic<5>        ;
    var c_fflags_wen  : logic           ;
    // Phase 8 S9: the head load was poisoned (memory-order violation) → replay.
    var c_load_poison : logic           ;

    // M9.A.255: gate ROB commit_ack on dmem_mmu_busy when committing a
    // store. commit_store_fire is a single-cycle pulse derived from
    // rob_commit_valid; if dmem_mmu starts a TLB-miss PT walk on this
    // pulse, the walk takes multiple cycles. Without this gate, the
    // pulse drops before the walk completes, dmem_mmu's o_dmem_wen
    // remains 0 (gated on ptw_valid), and the store is silently
    // dropped. Manifested as the 2nd __set_fixmap call's `sd a2, 0(a4)`
    // (PC 0x80003e0e) populating entry 510 of fixmap_pte never reaching
    // dmem — vmemmap later loads via that PT entry and faults forever.
    // Pre-condition: SFENCE.VMA between the two __set_fixmap calls
    // wipes the entire TLB (v4 mmu flushes on any sfence regardless of
    // rs1), forcing a walk on the 2nd call's store.
    // M8.B / M9 SMP: also hold a committing STORE while the dcache stalls. A
    // write hit is single-cycle (dcache_stall=0), but if the dcache is mid-FILL
    // for a younger load (write_during_fill) OR still waiting for the bus grant
    // on the write-through (write_wait_grant), the store's write-through would be
    // lost — hold commit_store_fire/pop until dcache_stall drops and the write
    // lands. This subsumes the old M9.1 `!(c_is_store && !i_dmem_grant)` gate:
    // the dcache (not the core) now owns bus back-pressure (see dmem_issue note).
    // Phase 8 S6: a fast (bare aligned plain) store does NOT use the i_wen path,
    // so its retire is gated on the store-drain ack (dc_sdrain_ack = it wrote the
    // dcache this cycle) instead of dcache_stall/dmem_mmu_busy. The dmem_mmu_busy
    // / dcache_stall gates apply only to NON-fast stores (AMO/Sv39/misaligned on
    // the i_wen path). A waiting fast store does not raise dcache_stall, so a load
    // read is never blocked by it.
    // Phase 8 S9: a poisoned LOAD at the head is REPLAYED (re-executed), not
    // retired. It must NOT architecturally commit — committing its stale rd would
    // corrupt any register the re-execution depends on (e.g. a `lb t1,0(t1)` whose
    // base == dest: writing the stale value into t1 destroys the base, so the
    // re-fetch computes a garbage address). Suppressing rob_commit_ack gates every
    // commit-time mutation (arch_regs / rat_commit / free-list push / head
    // advance / retire), leaving the load to be re-fetched fresh by the replay
    // redirect with the pre-load register state intact (the redirect's RAT/
    // free-list recovery rolls back the load's rename).
    let commit_load_replay: logic = rob_commit_valid && c_load_poison;
    // P9.3/SMP: a poisoned in-cache AMO at the head REPLAYS (re-fetched from its
    // own PC, see the commit-redirect priority chain) instead of retiring. Like
    // the poisoned LOAD above it must NOT architecturally commit: a real AMO with
    // rd == rs1 (e.g. the kernel's `amoadd a5,s7,(a5)` in multi_cpu_stop) would
    // write its result into the base register and free the base's pdst on commit,
    // so the replay re-fetch then computes its address from the destroyed base —
    // observed under 7.1 N>=2 as a NULL deref at VA == the captured AMO result
    // (the old thread_ack value). Suppressing rob_commit_ack leaves the pre-AMO
    // register state intact for the replay (the redirect rolls back its rename).
    // amo_watch_valid_q / amo_watch_rob_q / amo_poison_q are forward-declared vars
    // (the equivalent `amo_at_head && amo_poison_q` let is defined later).
    let commit_amo_replay: logic = amo_watch_valid_q && rob_commit_valid
        && rob_commit_idx == amo_watch_rob_q && amo_poison_q;
    // S15: the slow-store retire must also wait out an in-flight LOAD walk
    // (walk_v_q && !walk_is_store_q == load_walk_busy, declared later). The
    // M9.A.303 gate suppresses store_drive for the whole load walk, but
    // dmem_mmu_busy drops one cycle BEFORE walk_v_q clears (the walk's DONE
    // cycle): in that window the old ack condition fired and the store retired
    // WITHOUT EVER DRIVING ITS WRITE — a committed store silently lost. Only
    // reachable once S15 lets a speculative load start a PTW while an older
    // store is committing (pre-S15 VM blocked every load behind every store).
    // Phase 8 S20: stores split three ways at retire.
    //  - sb_elig (aligned plain DRAM store, translation ready): retires the
    //    moment the store buffer has room (sb_push fires the same cycle) —
    //    no dcache_stall / bus-grant wait.
    //  - slow store (!sb_elig: AMO/SC, misaligned, MMIO, VM TLB-miss): the
    //    pre-S20 gates, PLUS !sb_empty — its i_wen write must not reach the
    //    bus before the OLDER buffered stores drain (write-order inversion).
    //  - serializing ops also wait for the buffer to drain: FENCE orders our
    //    stores for other harts, FENCE.I against our own re-fetch,
    //    SFENCE/satp against the page-table walker.
    // S20.2: ONLY those — the original "all CSR/MRET/SRET" superset made
    // every interrupt-path CSR op at N=4 pay a contention-bound drain wait
    // (part of the boot +13%); plain CSRs have no store-ordering semantics.
    // P9.0 FIX: read the DEDICATED shadow-sourced commit outputs, NOT
    // rob_commit_entry fields — is_fence/is_fence_i/is_sfence/is_csr were
    // never assembled into o_commit_entry (constant 0), so this whole
    // serializing drain-wait was dead: a FENCE retired with its older stores
    // still in the store buffer, and the post-fence load read the world
    // before they were globally visible (the litmus SB+fence (0,0) outcome).
    let c_serial: logic = c_is_fence || c_is_fence_i || c_is_sfence || (c_is_csr && c_csr_addr == 12'h180);
    // P9.2 (write-back D$): FENCE.I / SFENCE.VMA / satp writes additionally
    // FLUSH the dcache (write back + invalidate every dirty line) before
    // retiring — instruction fetch and the I-PTW read DRAM directly (tb
    // ports), so dirty data must reach it at these architectural sync
    // points. Plain FENCE needs no flush: store visibility between harts is
    // carried by the coherence protocol itself. The sweep starts once the
    // store buffer has drained (its drains create dirty lines) and the
    // retire ack below waits for dc_flush_done.
    let c_flush_op: logic = rob_commit_valid && (c_is_fence_i || c_is_sfence || (c_is_csr && c_csr_addr == 12'h180));
    // P9.6 phase 3: with a coherent instruction side the sweep is gone — the
    // I-cache i_flush + the coherent (recall-on-owned) refill make stores visible
    // to fetch on demand. The serializing op still waits for the store buffer to
    // drain (c_serial && sb_empty below), so the stores are merged into the
    // D-cache before the I-cache refill recalls them.
    assign dc_flush_req = c_flush_op && sb_empty && (COHERENT_IFETCH == 0);
    // S20R: an MMIO (non-DRAM) store is a DOORBELL — firmware writes a DRAM
    // mailbox then rings CLINT msip with no fence between (legal on the old
    // never-reordering pipeline). If the doorbell passes the buffered
    // mailbox store, the woken hart reads a stale mailbox and parks forever
    // (the N=2 wedge: hart1 stuck in the FW wait loop, trap1=0). Treat every
    // MMIO store like an AMO release: wait for the buffer to fully drain.
    var c_store_mmio: logic; // assigned at the store-buffer block (needs dmu_dmem_addr)
    // The slow-store order gate is OVERLAP-only for plain stores (RVWMO lets
    // different-address stores become visible out of order without a fence);
    // an AMO/SC keeps the full-empty wait (release semantics: all prior
    // stores must be visible before it).
    let rob_commit_ack: logic = rob_commit_valid && !commit_load_replay && !commit_amo_replay
        && !(c_is_store && !sb_elig && (dmem_mmu_busy || (walk_v_q && !walk_is_store_q)))
        && !(c_is_store && !sb_elig && (dcache_stall || (if c_is_amo || c_store_mmio ? !sb_empty : sb_st_ovl)))
        && !(c_is_store && sb_elig && sb_full && !sb_merge_ok)
        && !(c_serial && !sb_empty)
        && !(c_flush_op && !dc_flush_done && (COHERENT_IFETCH == 0)); // P9.2 sweep (P9.6: gone when coherent)
    // Phase 8 S1: 2-wide commit. commit2_fire is a var assigned LATE (after all
    // the slot-0 redirect conditions: trap/mret/sret/satp/mispredict/sc-replay)
    // so it can also require that slot-0 does NOT redirect — otherwise the head+1
    // op is wrong-path (squashed by slot-0's redirect) and must not retire.
    // Declared here (var) so the rob i_commit_ack2 connection and the slot-1
    // commit always_comb may reference it before the assign.
    var commit2_fire: logic;

    var rob_head_valid  : logic    ;
    var rob_head_rw     : logic    ;
    var rob_head_illegal: logic    ;
    var rob_alloc_cnt_w   : logic<32>;
    var rob_cdb_cnt_w     : logic<32>;
    var rob_commit_cnt_w  : logic<32>;
    var rob_head_w        : logic<6> ;
    var rob_tail_w        : logic<6> ;
    var rob_load_viol_cnt_w: logic<32>; // Phase 8 S9: memory-order violation events

    inst u_rob: rob (
        clk                                         ,
        rst                                         ,
        i_alloc_en           : rename_fire          ,
        i_alloc_entry        : rob_alloc_entry      ,
        o_alloc_idx          : rob_alloc_idx        ,
        o_full               : rob_full             ,
        // Phase 8 S4b: slot-1 alloc port (gated by rename_fire2; dead until
        // S4b.2). i_alloc_entry2 is now the real 2nd-decode entry. o_alloc_idx2
        // feeds ren_op2.rob_idx.
        i_alloc_en2          : rename_fire2         ,
        i_alloc_entry2       : rob_alloc_entry2     ,
        o_alloc_idx2         : rob_alloc_idx2       ,
        i_cdb_valid          : cdb.valid            ,
        i_cdb_rob_idx        : cdb.rob_idx          ,
        i_cdb_result_data    : cdb.data             ,
        i_cdb_mispredict     : cdb.mispredict       ,
        i_cdb_redirect_pc    : cdb.redirect_pc      ,
        i_cdb_is_store       : cdb.is_store         ,
        i_cdb_store_addr     : cdb.store_addr       ,
        i_cdb_store_data     : cdb.store_data       ,
        i_cdb_store_funct3   : cdb.store_funct3     ,
        i_cdb_is_load        : cdb.is_load          , // Phase 8 S9 LQ record (lane 0)
        i_cdb_is_csr         : cdb.is_csr           ,
        i_cdb_csr_addr       : cdb.csr_addr         ,
        i_cdb_csr_wdata      : cdb.csr_wdata        ,
        i_cdb_csr_illegal    : cdb.csr_illegal      ,
        i_cdb_is_lfault      : rob_cdb_is_lfault    ,
        i_cdb_is_sfault      : cdb.is_sfault        ,
        i_cdb_fault_vaddr    : cdb.fault_vaddr      ,
        i_cdb_fflags         : fpu_fflags           , // M6: from FPU (only valid when FP wrote back)
        i_cdb_fflags_wen     : fpu_fflags_wen       ,
        // Phase 8 S3: 2nd CDB writeback (pipe-1 = ALU/branch). Silent in S3.a.
        i_cdb2_valid         : alu_cdb2.valid       ,
        i_cdb2_rob_idx       : alu_cdb2.rob_idx     ,
        i_cdb2_result_data   : alu_cdb2.data        ,
        i_cdb2_mispredict    : alu_cdb2.mispredict  ,
        i_cdb2_redirect_pc   : alu_cdb2.redirect_pc ,
        // Phase 8 S9 LQ record (lane 1 = S5.2 bare-mode slot-1 load).
        i_cdb2_is_load       : alu_cdb2.is_load     ,
        i_cdb2_store_addr    : alu_cdb2.store_addr  ,
        i_cdb2_store_funct3  : alu_cdb2.store_funct3,
        // Phase 8 S10.3: MSHR capture-time LQ record + aborted-fill poison.
        i_lq_rec_valid       : mshr_capture         ,
        i_lq_rec_idx         : iq_iss_rob_idx       ,
        i_lq_rec_addr        : mshr_rec_addr        ,
        i_lq_rec_funct3      : iq_issue_op.base.mem_funct3,
        // P9.0 CoRR: remote-invalidate poison (same pulses the dcache gets).
        i_inv_valid          : i_dcache_inv_valid   ,
        i_inv_addr           : i_dcache_inv_addr    ,
        // P9.2: 2nd precise-inv port + local line-departure events — every
        // way a line leaves the L1 poisons executed loads on it (CoRR).
        i_inv2_valid         : i_dcache_inv2_valid  ,
        i_inv2_addr          : i_dcache_inv2_addr   ,
        i_evict1_valid       : dc_evict1_v && (SMP_COHERENT != 0),
        i_evict1_addr        : dc_evict1_addr       ,
        i_evict2_valid       : dc_evict2_v && (SMP_COHERENT != 0),
        i_evict2_addr        : dc_evict2_addr       ,
        i_load_poison_v      : mshr_abort_poison    ,
        i_load_poison_idx    : mshr_poison_idx      ,
        i_load_poison_v2     : mshr_abort_poison2   ,
        i_load_poison_idx2   : mshr_poison_idx2     ,
        i_lfault_inj_v       : lfault_inj_v         ,
        i_lfault_inj_rob     : walk_rob_q           ,
        i_lfault_inj_vaddr   : walk_vaddr_q         ,
        // Phase 11-H3c: the MMU is in TS_FAULT this cycle (lfault_inj_v implies
        // dmem_mmu_fault), so its gstage/gpa outputs correspond to this walk.
        i_lfault_inj_gstage  : dmem_mmu_gstage      ,
        i_lfault_inj_gpa     : dmem_mmu_gpa         ,
        i_lfault_inj_pc      : walk_pc_q            ,
        o_commit_valid       : rob_commit_valid     ,
        o_commit_entry       : rob_commit_entry     ,
        o_commit_pc          : c_pc                 ,
        o_commit_rd_arch     : c_rd_arch            ,
        o_commit_rd_pdst     : c_rd_pdst            ,
        o_commit_old_rd_pdst : c_old_rd_pdst        ,
        o_commit_has_rd      : c_has_rd             ,
        o_commit_illegal     : c_illegal            ,
        o_commit_mispredict  : _                    , // Phase 8 M1: superseded by commit-time check
        o_commit_redirect_pc : c_redirect_pc        ,
        o_commit_pred_next_pc: c_pred_next_pc       ,
        o_commit_early_fix   : c_early_fix          ,
        o_commit_is_rvc      : c_is_rvc             ,
        o_commit_is_control  : c_is_control         ,
        o_commit_is_cond     : c_is_cond            ,
        o_commit_is_call     : c_is_call            ,
        o_commit_is_ret      : c_is_ret             ,
        o_commit_pred_index  : c_pred_index         ,
        o_commit_ghr_fold    : c_ghr_fold           ,
        o_commit_result_data : c_result_data        ,
        o_commit_is_store    : c_is_store           ,
        o_commit_is_amo      : c_is_amo             ,
        o_commit_mem_virt    : c_is_mem_virt        , // Phase 11-H HLV/HSV
        o_commit_store_addr  : c_store_addr         ,
        o_commit_store_data  : c_store_data         ,
        o_commit_store_funct3: c_store_funct3       ,
        o_has_pending_store  : rob_has_pending_store,
        o_has_pending_xlate  : rob_has_pending_xlate,
        // Phase 8 S5.1 store-to-load gate + per-entry store shadow (forwarded to
        // alu_wrap for the local byte-network).
        o_block_store_exists : rob_block_store_exists,
        o_block_store_age    : rob_block_store_age   ,
        i_conservative       : dmem_vm_on            ,
        o_store_addr         : rob_store_addr        ,
        o_store_data         : rob_store_data        ,
        o_store_funct3       : rob_store_funct3      ,
        o_store_fwdable      : rob_store_fwdable     ,
        o_pred_next_pc       : rob_pred_next_pc      ,
        o_is_control         : rob_is_control        ,
        o_commit_is_csr      : c_is_csr             ,
        o_commit_csr_addr    : c_csr_addr           ,
        o_commit_csr_wdata   : c_csr_wdata          ,
        o_commit_is_ecall    : c_is_ecall           ,
        o_commit_is_ebreak   : c_is_ebreak          ,
        o_commit_is_mret     : c_is_mret            ,
        o_commit_is_sret     : c_is_sret            ,
        o_commit_is_sfence   : c_is_sfence          ,
        o_commit_sfence_rs1  : c_sfence_rs1         , // P9.5
        o_commit_sfence_rs2  : c_sfence_rs2         ,
        o_commit_is_fence_i  : c_is_fence_i         ,
        o_commit_is_fence    : c_is_fence           ,
        o_commit_is_cbo_zero : c_is_cbo_zero        ,
        o_commit_is_ifault   : c_is_ifault          ,
        o_commit_is_lfault   : c_is_lfault          ,
        o_commit_is_sfault   : c_is_sfault          ,
        o_commit_fault_vaddr : c_fault_vaddr        ,
        o_commit_fault_gstage: c_fault_gstage       ,
        o_commit_fault_gpa   : c_fault_gpa          ,
        o_commit_dbg_walk_pc : commit_dbg_walk_pc   ,
        o_commit_dbg_inj     : commit_dbg_inj       ,
        o_commit_is_fp_dest  : c_is_fp_dest         ,
        o_commit_is_fp       : c_is_fp              ,
        o_commit_fflags      : c_fflags             ,
        o_commit_fflags_wen  : c_fflags_wen         ,
        o_commit_idx         : rob_commit_idx       ,
        o_commit_load_poison : c_load_poison        , // Phase 8 S9
        i_commit_ack         : rob_commit_ack       ,
        o_commit2_valid      : c2_valid             ,
        o_commit2_pc         : c2_pc                ,
        o_commit2_rd_arch    : c2_rd_arch           ,
        o_commit2_rd_pdst    : c2_rd_pdst           ,
        o_commit2_old_rd_pdst: c2_old_rd_pdst       ,
        o_commit2_has_rd     : c2_has_rd            ,
        o_commit2_result_data: c2_result_data       ,
        i_commit_ack2        : commit2_fire         ,
        i_redirect_fire      : redirect_fire        ,
        // Phase 8 S8.E: early partial squash (flip). Rewind tail to one past the
        // resolved branch and clear younger entries; coexists with CDB writeback
        // and head commit on the same cycle.
        i_squash_en          : s8_restore_en        ,
        i_squash_idx         : s8_restore_idx       ,
        // Phase 8 S8.E re-redirect guard (CDB-writeback pred rewrite).
        i_cdb_redir_fix      : early_redir_fix0     ,
        i_cdb2_redir_fix     : early_redir_fix1     ,
        o_head_idx           : rob_head_idx         ,
        o_size               : rob_size             ,
        o_dbg_head_valid     : rob_head_valid       ,
        o_dbg_head_rw        : rob_head_rw          ,
        o_dbg_head_illegal   : rob_head_illegal     ,
        o_dbg_alloc_cnt      : rob_alloc_cnt_w      ,
        o_dbg_cdb_cnt        : rob_cdb_cnt_w        ,
        o_dbg_commit_cnt     : rob_commit_cnt_w     ,
        o_dbg_head           : rob_head_w           ,
        o_dbg_tail           : rob_tail_w           ,
        o_dbg_load_viol_cnt  : rob_load_viol_cnt_w  , // Phase 8 S9
    );

    // ============================================================
    // Commit stage
    // ============================================================
    // TVM (mstatus.TVM) traps satp access / sfence.vma in S-mode; TSR
    // (mstatus.TSR) traps sret in S-mode. Commit-time priv + mstatus dependent,
    // so they raise an illegal-instruction trap (cause 2) at commit, not at
    // decode, and suppress the instruction's side effects (rd / csr write /
    // sfence pulse / sret). Matches v1 (heliodor_core.veryl:4442).
    // Phase 11-H3b: in VS-mode (V=1) the mstatus.TVM/TSR controls do not apply —
    // the guest is governed by hstatus.VTVM/VTSR (not yet implemented), so these
    // traps are gated off with !csr_virt. Inert at V=0 (byte-identical).
    let commit_tvm_trap    : logic = rob_commit_valid && csr_tvm && !csr_virt && csr_priv == csr_pkg::PrivLevel::SUPERVISOR
        && (c_is_sfence || (c_is_csr && c_csr_addr == 12'h180));
    let commit_tsr_trap    : logic = rob_commit_valid && csr_tsr && !csr_virt && csr_priv == csr_pkg::PrivLevel::SUPERVISOR
        && c_is_sret;
    // M6.B.4: an FP instruction committing while mstatus.FS == Off (FP unit
    // disabled) raises an illegal-instruction trap (cause 2) and has its side
    // effects suppressed — same machinery as the TVM/TSR commit traps.
    let commit_fp_disabled : logic = rob_commit_valid && c_is_fp && csr_fs == 2'b00;
    let commit_priv_illegal: logic = commit_tvm_trap || commit_tsr_trap || commit_fp_disabled;
    // M9.3 SMP FIX (cosim-pinned free-list double-alloc): gate the commit-side
    // architectural mutations on the actual RETIRE (rob_commit_ack), NOT on
    // rob_commit_valid. A store-class op held at the ROB head keeps
    // rob_commit_valid HIGH for every cycle it waits (rob_commit_ack low while
    // dmem_mmu_busy / dcache_stall). For an AMO (is_store AND has_rd — the
    // SMP-spinlock case, held by the bus-atomic lock + bus contention),
    // fl_push_en = rob_commit_valid && c_has_rd then PUSHES the displaced
    // old_rd_pdst to the free-list EVERY held cycle → the same pdst is enqueued
    // K times → it is later popped by K different renames → a DOUBLE-ALLOCATION.
    // The SMP cosim caught the symptom: `c.slli a3,0x3` @0x800df85e read a3 as
    // a4's value because the `lw a3` and the `addi a4` were both handed pdst 12.
    // rob_commit_ack == rob_commit_valid for every non-held op (so the common
    // path is unchanged); only a held AMO now pushes/commits exactly once, at
    // retire. (Gating rat_commit_en too keeps RAT-arch atomic with the push and
    // avoids committing a held AMO's rd before it actually retires / if it
    // faults.) v4 N=1 never hit this (AMOs rarely held without bus contention).
    always_comb {
        rat_commit_en   = rob_commit_ack && c_has_rd && !c_illegal && !commit_priv_illegal;
        rat_commit_arch = c_rd_arch;
        rat_commit_pdst = c_rd_pdst;

        fl_push_en   = rob_commit_ack && c_has_rd && !c_illegal && !commit_priv_illegal;
        fl_push_pdst = c_old_rd_pdst;

        // M6: FP-dest commit — rename the FP arch RAT + push the displaced FP
        // pdst to the FP free-list (rd_pdst/old_rd_pdst hold the FP pdsts).
        fp_rat_commit_en = rob_commit_ack && c_is_fp_dest && !c_illegal && !commit_priv_illegal;
        fp_fl_push_en    = rob_commit_ack && c_is_fp_dest && !c_illegal && !commit_priv_illegal;
        fp_fl_push_pdst  = c_old_rd_pdst;

        // Phase 8 S1: commit slot-1 (simple integer op). It is never illegal /
        // priv-illegal / FP / control (excluded by c2_valid), so the only
        // architectural effects are the integer arch-RAT write and free-list push
        // (ordered AFTER slot-0 in rat/free_list so a same-rd WAW lets the younger
        // slot-1 win). arch_regs slot-1 update is in the arch_regs always_ff.
        rat_commit_en2   = commit2_fire && c2_has_rd;
        rat_commit_arch2 = c2_rd_arch;
        rat_commit_pdst2 = c2_rd_pdst;
        fl_push_en2      = commit2_fire && c2_has_rd;
        fl_push_pdst2    = c2_old_rd_pdst;
    }

    // ============================================================
    // M4 trap entry decisions (commit-time, registered into redirect)
    // ============================================================
    // P9.1 FIX: gate on rob_commit_ack, NOT rob_commit_valid. A satp CSR op is
    // c_serial (P9.0): its RETIRE — and so its arch-RAT / free-list commit
    // (rat_commit_en / fl_push_en, both ack-based) — waits for the store
    // buffer to drain, while the commit_csrw_satp implicit redirect below
    // fired off commit_VALID immediately. The full flush then restored
    // rat_spec / free list from a pre-commit arch state: the CSR op's rename
    // was rolled back even though the op itself retired, so a consumer of its
    // rd re-executed reading the STALE pre-rename preg (observed: asids_init's
    // `csrr a1,satp` re-ran its `or` with a1=0 → satp restored to 0 → kernel
    // silently dropped to Bare translation → VA-addressed stores corrupted
    // DRAM → N=4 boot livelock on a spinlock word). Latent since P9.0 revived
    // c_serial; P9.1's longer store-drain latencies made the non-empty-sb
    // window at a satp-CSR commit routine. Same ack-gating for the FENCE.I /
    // SFENCE pulses below (both c_serial, both with commit-time side effects).
    let commit_csrwr: logic = rob_commit_ack && c_is_csr && !c_illegal && !commit_priv_illegal;
    // M9 (2026-05-25): csrw satp must also act like an implicit sfence +
    // pipeline redirect to match v1's IFU behavior. Linux head.S's trampoline
    // sequence (csrw stvec=high; csrw satp=trampoline_pg; <expect fault>; ...)
    // relies on the next fetch after csrw satp to walk with the new satp and
    // fault — which redirects PC to high-half stvec. v4's narrow IFU + deep
    // prefetch + satp_shadow lazy update misses this fault, so kernel head.S
    // proceeds at low-half PC and panics later. The fix: redirect to next PC
    // and update satp_shadow on csrw satp commit so the re-fetch goes through
    // MMU with the new satp.
    let commit_csrw_satp: logic = commit_csrwr && c_csr_addr == 12'h180;
    // P10: a write to frm (0x002) / fcsr (0x003) changes the dynamic rounding
    // mode; re-fetch the successor so a younger dynamic-rounding FP op captures
    // the new frm (it samples the mode at execute, before this CSR retired).
    let commit_csrw_frm: logic = commit_csrwr && (c_csr_addr == 12'h002 || c_csr_addr == 12'h003);
    // M9 (2026-05-25): on the FIRST csrw satp commit that turns on Sv39
    // (bare→Sv39), inject a fake instruction page fault to match v1's TLB
    // -eviction quirk that Linux head.S's trampoline_pg sequence depends on.
    // v1's IFU happens to take an instruction page fault on the next fetch
    // after csrw satp; v4's narrow + lazy MMU walks PT 0x80a8a successfully
    // (PT maps low-half identity at the time of walk) and misses the fault.
    // Kernel head.S expects the fault to redirect PC to high-half stvec, so
    // we synthesize the fault here. After the first Sv39 enable the kernel
    // sets up SFENCE.VMA and explicit stvec changes — no further fakes.
    var first_satp_done: logic;
    // Use c_csr_wdata (the value being written this cycle), not csr_satp
    // (which is the OLD value at always_comb time — register updates NBA).
    // M9.A.300: only synthesize the fake instruction page fault when the satp
    // write happens in S-mode (or U). The hack mimics v1's IFU faulting on the
    // high-half fetch after Linux head.S enables Sv39 — which only occurs when
    // instruction fetch TRANSLATES (priv != M). An M-mode `csrw satp` (e.g.
    // rv64si-dirty turning on VM to test MPRV load/store translation) keeps
    // fetch in Bare mode, so no real ifault would occur — injecting one there
    // is spurious and derails the test (it took a phantom cause=12 trap before
    // reaching its store-fault subtest). Boot is unaffected: OpenSBI firmware
    // never writes a MODE=8 satp in M-mode; the kernel's first Sv39 enable is
    // in S-mode, so the hack still fires for Linux.
    // Phase 11-H5: a GUEST's `csrw satp` (V=1, aliasing vsatp) must NOT take this
    // V=0-only narrow-IFU/QEMU-satp hack — the fake trap drops the vsatp write
    // (the csr's trap path wins over its write path), so the guest's paging never
    // engages. A guest writes vsatp directly and engages normally (the two-stage
    // MMU reads vsatp_shadow, latched atomically at this commit). Gated on
    // !csr_virt, so the V=0 boot path is byte-identical.
    let inject_fake_ifault: logic = commit_csrw_satp && !first_satp_done && c_csr_wdata[63:60] == 4'd8 && csr_priv
        != csr_pkg::PrivLevel::MACHINE && !csr_virt;
    always_ff (clk, rst) {
        if_reset {
            first_satp_done = 1'b0;
        } else if commit_csrw_satp && c_csr_wdata[63:60] == 4'd8 {
            first_satp_done = 1'b1;
        }
    }

    // M9.A.299: store page fault (cause=15) delivery. A STORE translates only
    // at commit (core_dmem_vaddr=c_store_addr, core_dmem_wen=commit_store_fire),
    // so dmem_mmu_fault_s asserts at COMMIT for a faulting store — the ROB never
    // records sfault for commit-translated stores (its CDB-time is_sfault is
    // always 0 for them), so without this the fault is silently dropped: the
    // store's head pops normally (the write itself is suppressed by dmem_mmu's
    // ptw_valid gate) but no trap fires. Confirmed by rv64si-dirty hanging
    // (D-bit demand store fault) and breaks execve demand-paging store faults.
    // Defined from primitives (not commit_store_fire, which is in the dmem
    // section below) to keep declaration order valid. dmem_mmu_fault_s already
    // implies i_wen (= commit_store_fire), so this only fires on a real store.
    let commit_store_sfault: logic = rob_commit_valid && c_is_store && !c_illegal && dmem_mmu_fault_s;
    let c_is_sfault_eff    : logic = c_is_sfault || commit_store_sfault;
    let commit_excp        : logic = rob_commit_valid
        && (c_illegal || c_is_ecall || c_is_ebreak || c_is_lfault || c_is_sfault_eff || inject_fake_ifault
            || commit_priv_illegal);
    // M8.C: IRQ trap fires as soon as something is committing AND no
    // synchronous exception is firing (excp takes priority).
    //
    // M9.A.288 fix (2026-05-29): async IRQ must fire ONLY when the
    // pipeline is idle (rob_size == 0) and no redirect is pending.
    // v1 has the same restriction (see comment at trap_pc selector in
    // heliodor_core.veryl line 4358-4376):
    //   "For async IRQ with rob_empty: all in-flight instructions
    //    committed. Use ifid_pc (next-to-execute) rather than stale
    //    ex_pc register to avoid re-executing the just-committed
    //    instruction (which would corrupt state when a post-load
    //    register value gets used as if it were pre-load)."
    // Without this gate, an instr commits AND IRQ fires same cycle
    // with mepc = c_pc → mret returns to that PC → it re-executes.
    // Stack-pointer instructions are particularly poisonous: a single
    // `addi sp,sp,-96` re-executes, dropping sp twice (= 192 bytes).
    let commit_irq : logic = (rob_size == 8'd0) && !redirect_fire_q && !commit_excp && csr_irq_pending;
    let commit_trap: logic = commit_excp || commit_irq;
    let commit_mret: logic = rob_commit_valid && c_is_mret;
    let commit_sret: logic = rob_commit_valid && c_is_sret && !commit_tsr_trap;
    // P9.1 FIX: ack-based (c_serial — see the commit_csrwr note above).
    assign commit_sfence_pulse = rob_commit_ack && c_is_sfence && !commit_tvm_trap;

    // M8.A: FENCE.I commit pulse → flush the icache. Fired at commit so all
    // prior stores (self-modifying code) have updated memory before the
    // icache refills. A redundant flush is harmless. Straight-line code after
    // FENCE.I is not itself patched, so no pipeline redirect is needed.
    // P9.1 FIX: ack-based (c_serial — see the commit_csrwr note above).
    assign commit_fence_i_pulse = rob_commit_ack && c_is_fence_i;

    // M9: satp shadow latch (see declaration above). Updated on either
    // SFENCE.VMA commit OR csrw satp commit. The latter is non-standard
    // but kernel head.S requires it (see commit_csrw_satp comment above).
    always_ff (clk, rst) {
        if_reset {
            satp_shadow  = 64'd0;
            vsatp_shadow = 64'd0;
        } else if commit_sfence_pulse || commit_csrw_satp {
            satp_shadow  = csr_satp;
            vsatp_shadow = csr_vsatp;  // Phase 11-H5: VS-stage shadow (V=1 guest paging)
        }
    }

    // Cause encoding (per RISC-V priv spec). ECALL cause depends on
    // current priv: M=11, S=9, U=8. IRQ traps use csr_irq_cause from
    // csr (already MSB-tagged + cause #).
    var excp_cause: logic<64>;
    always_comb {
        if c_is_ifault || inject_fake_ifault {
            // Phase 11-H3d: a fetch fault in the G-stage of a guest (two-stage)
            // walk is an instruction guest-page-fault (cause 20), not a plain
            // instruction page-fault (12). inject_fake_ifault is the V=0 satp-
            // switch hack (never G-stage), so this only upgrades a real V=1 fetch
            // fault. c_fault_gstage is ROB-carried from alloc. Inert at V=0.
            excp_cause = if c_is_ifault && c_fault_gstage ? 64'd20 : 64'd12;
        } else if c_is_lfault {
            // Phase 11-H3c: a load fault that occurred in the G-stage of a guest
            // (two-stage) walk is a load guest-page-fault (cause 21), not a plain
            // load page-fault (13). c_fault_gstage is ROB-carried from the inject.
            // Inert at V=0 (the G-stage never runs → c_fault_gstage is 0).
            excp_cause = if c_fault_gstage ? 64'd21 : 64'd13;
        } else if c_is_sfault_eff {
            // Phase 11-H3c: a store/AMO fault that occurred in the G-stage of a
            // two-stage (guest) walk is a store guest-page-fault (cause 23), not a
            // plain store page-fault (15). dmem_mmu_gstage is valid alongside the
            // commit-time store fault (dmem_mmu_fault_s). Inert at V=0 (the G-stage
            // never runs, so dmem_mmu_gstage is 0 → cause stays 15).
            excp_cause = if commit_store_sfault && dmem_mmu_gstage ? 64'd23 : 64'd15;
        } else if c_illegal || commit_priv_illegal {
            excp_cause = 64'd2; // illegal instruction (incl. TVM/TSR commit trap)
        } else if c_is_ebreak {
            excp_cause = 64'd3; // breakpoint
        } else if csr_priv_prev == csr_pkg::PrivLevel::MACHINE {
            // M9.A.304: ECALL cause uses the registered priv snapshot, not the
            // live csr_priv, to avoid the cross-module eval-order hazard that
            // misrouted S-mode ECALLs to M-mode (cosim first divergence cy 630K).
            excp_cause = 64'd11; // ECALL from M
        } else if csr_priv_prev == csr_pkg::PrivLevel::SUPERVISOR {
            // Phase 11-H3: ECALL from VS-mode (priv=S with V=1) is cause 10,
            // distinct from ECALL-from-HS (cause 9). It is a hypercall and is
            // never delegated to VS (hedeleg[10] is read-only 0) — it traps to
            // HS/M for the hypervisor to service.
            excp_cause = if csr_virt_prev ? 64'd10 : 64'd9;
        } else {
            excp_cause = 64'd8; // ECALL from U / VU
        }
    }
    let trap_cause: logic<64> = if commit_irq ? csr_irq_cause : excp_cause;

    // M5.D trap delegation: if medeleg[cause]=1 AND current priv ∈ {S,U},
    // the trap is taken in S-mode. For IRQ traps, csr supplies o_irq_to_s.
    // (csr_medeleg_w forward-declared near pc_q.)
    let trap_cause_bit: logic = csr_medeleg_w[excp_cause[5:0]];
    // Phase 11-H3: a synchronous exception in VS/VU (virt_prev) delegated PAST M
    // (medeleg) AND past HS (hedeleg) is taken in VS-mode. Phase 11-H3b extends
    // this to interrupts: csr supplies o_irq_to_vs (a pending virtual interrupt
    // routed to VS), which the csr already gates on V=1 and the guest enables.
    let trap_deleg_s  : logic = trap_cause_bit && (csr_priv_prev != csr_pkg::PrivLevel::MACHINE);
    let trap_to_vs    : logic = if commit_irq ?
        csr_irq_to_vs
    :
        csr_virt_prev && trap_deleg_s && csr_hedeleg[excp_cause[5:0]]
    ;
    // Delivered to an S-level handler (HS or VS). trap_to_vs picks VS; otherwise
    // HS. For IRQs, csr supplies o_irq_to_s (always HS for now).
    let trap_to_s     : logic = if commit_irq ?
        csr_irq_to_s
    :
        trap_deleg_s
    ;
    // Phase 11-H3c: guest-page-fault info for the csr trap entry. htval = the
    // faulting guest PA >> 2; for a store guest-page-fault (cause 23) the GPA is
    // dmem_mmu_gpa, valid at commit alongside the store fault (load/ifetch GPAs
    // are increment 2/3). trap_gva flags that stval/mtval holds a guest VA — set
    // for any memory fault taken out of a guest (csr applies it on HS/M traps).
    // Inert at V=0 (csr_virt_prev is 0, so trap_gva is 0).
    // A load or instruction guest-page-fault carries its GPA in the ROB
    // (c_fault_gpa); a store guest-page-fault reads the live dmem_mmu_gpa at
    // commit. htval = GPA >> 2.
    let trap_htval    : logic<64> = (if c_is_lfault || c_is_ifault ? c_fault_gpa : dmem_mmu_gpa) >> 2;
    // Phase 11-H: an HLV/HSV memory fault is taken in HS-mode (V=0, so virt_prev
    // is 0) but stval still holds a GUEST virtual address → set GVA. c_is_mem_virt
    // marks the committing op as an HLV/HSV (load fault via ROB shadow, store
    // fault commit-time). A guest's own fault uses csr_virt_prev as before.
    let trap_gva      : logic     = (csr_virt_prev || c_is_mem_virt) && (c_is_lfault || c_is_sfault_eff || c_is_ifault);

    // ============================================================
    // CSR file
    // ============================================================
    // P10 Zihpm event bus (driven by an always_comb near the perf counters,
    // where the late pipeline signals it reads are in scope).
    var hpm_events: logic<8>;
    inst u_csr: csr #(
        HART_ID: HART_ID,
    ) (
        clk                         ,
        rst                         ,
        i_rd_addr  : iq_iss_csr_addr,
        o_rd_data  : csr_rd_data    ,
        i_wr_en    : commit_csrwr   ,
        i_wr_addr  : c_csr_addr     ,
        i_wr_data  : c_csr_wdata    ,
        i_mtime    : i_mtime        ,
        i_trap_fire: commit_trap    ,
        // M9: inject_fake_ifault synthesizes a trap as if the post-csrw-satp
        // fetch had taken a page fault. epc/stval = c_pc + 4 (the would-be
        // faulting VA), cause = 12 via excp_cause path.
        // M9.A.288: on commit_irq the ROB is empty (rob_size==0) so c_pc
        // is stale. Use the PC of the next instruction the hart would
        // have executed: if a fetched-but-not-dispatched instr exists
        // (if_v_q=1), that PC is if_pc_q; otherwise pc_q (= next to
        // fetch). Same approach as v1's ifid_pc selector at
        // heliodor_core.veryl:4366.
        i_trap_pc: if commit_irq ? (if if_v_q ? if_pc_q : pc_q) : if inject_fake_ifault ? c_pc + 64'd4 : c_pc,
        i_trap_cause: trap_cause,
        // mtval/stval for page faults carry the faulting VA; other
        // exception kinds leave it at 0 for now.
        // M9.A.299: store-fault tval = the faulting store VA (c_store_addr);
        // load-fault tval = c_fault_vaddr (set by the ROB inject port). A
        // commit-translated store never sets sh_fault_vaddr, so use c_store_addr.
        // M9.A.302: a REAL instruction page fault (c_is_ifault, not the
        // inject_fake_ifault hack) must set stval = the faulting instruction's
        // VA = c_pc (RISC-V priv spec). v4 previously fell through to 0, so the
        // kernel's do_page_fault saw fault-address 0, found no VMA, and SIGSEGV'd
        // init on the demand fault of its entry page (PC 0x10070) → "kill init".
        i_trap_tval: if inject_fake_ifault ?
            c_pc + 64'd4
        : if c_is_ifault ?
            c_pc
        : if c_is_lfault ?
            c_fault_vaddr
        : if commit_store_sfault ?
            c_store_addr
        : if c_is_sfault ?
            c_fault_vaddr
        :
            64'd0
        ,
        i_mret_fire   : commit_mret  ,
        o_mtvec       : csr_mtvec    ,
        o_mepc        : csr_mepc     ,
        o_stvec       : csr_stvec    ,
        o_dbg_stval   : dbg_csr_stval,
        o_dbg_mtval   : dbg_csr_mtval,
        o_sepc        : csr_sepc     ,
        o_medeleg     : csr_medeleg_w,
        o_mideleg     : csr_mideleg_w,
        o_satp        : csr_satp     ,
        o_priv        : csr_priv     ,
        o_priv_prev   : csr_priv_prev,
        o_mstatus_sum : csr_sum      ,
        o_mstatus_mxr : csr_mxr      ,
        o_mstatus_mprv: csr_mprv     ,
        o_mstatus_mpp : csr_mpp      ,
        o_mstatus_tvm : csr_tvm      ,
        o_mstatus_tsr : csr_tsr      ,
        o_mstatus_fs  : csr_fs       ,
        o_menvcfg_pbmte: csr_pbmte   ,
        o_menvcfg_adue : csr_adue    ,
        // Phase 11-H two-stage MMU state.
        o_virt         : csr_virt    ,
        o_mstatus_mpv  : csr_mpv     ,
        o_hgatp        : csr_hgatp   ,
        o_vsatp        : csr_vsatp   ,
        o_vsstatus_sum : csr_vs_sum  ,
        o_vsstatus_mxr : csr_vs_mxr  ,
        o_hstatus_spvp : csr_spvp    , // Phase 11-H HLV/HSV effective priv select
        // Phase 11-H3 VS trap delegation.
        o_virt_prev    : csr_virt_prev,
        o_hedeleg      : csr_hedeleg ,
        o_hideleg      : csr_hideleg ,
        o_vstvec       : csr_vstvec  ,
        o_vsepc        : csr_vsepc   ,
        o_pmm_m        : csr_pmm_m   ,
        o_pmm_s        : csr_pmm_s   ,
        o_pmm_u        : csr_pmm_u   ,
        i_sret_fire   : commit_sret  ,
        i_trap_to_s   : trap_to_s    ,
        i_trap_to_vs  : trap_to_vs   ,
        i_htval       : trap_htval   ,
        i_trap_gva    : trap_gva     ,
        // M8.C: external IRQ pins from harness (tie low when unused).
        i_irq_timer_m: i_irq_timer_m                   ,
        i_irq_sw_m   : i_irq_sw_m                      ,
        i_irq_ext_m  : i_irq_ext_m                     ,
        i_irq_ext_s  : i_irq_ext_s                     ,
        o_irq_pending: csr_irq_pending                 ,
        o_irq_cause  : csr_irq_cause                   ,
        o_irq_to_s   : csr_irq_to_s                    ,
        o_irq_to_vs  : csr_irq_to_vs                   ,
        i_instret_en : rob_commit_valid && !commit_trap,
        // M6: fcsr — frm to the FPU; accrue fflags from a committing FP op.
        o_frm        : csr_frm                                                          ,
        i_fflags_set : rob_commit_valid && c_fflags_wen && !c_illegal && !commit_priv_illegal,
        i_fflags     : c_fflags                                                         ,
        // P10 Zihpm: per-cycle event bus (packed near the perf-counter block).
        i_hpm_events : hpm_events                                                       ,
    );

    // Debug observation of CSR / trap state (for boot debug).
    assign o_dbg_sepc             = csr_sepc;
    assign o_dbg_mepc             = csr_mepc;
    assign o_dbg_priv             = if csr_priv == csr_pkg::PrivLevel::MACHINE ?
        2'b11
    : if csr_priv == csr_pkg::PrivLevel::SUPERVISOR ?
        2'b01
    :
        2'b00
    ;
    assign o_dbg_trap_fire        = commit_trap;
    assign o_dbg_trap_pc          = c_pc;
    assign o_dbg_trap_cause       = trap_cause;
    assign o_dbg_trap_to_s        = trap_to_s;
    assign o_dbg_satp             = csr_satp;
    assign o_dbg_imem_vaddr       = fetch_vaddr;
    assign o_dbg_imem_paddr       = imem_paddr_w;
    assign o_dbg_imem_valid       = imem_valid_w;
    assign o_dbg_imem_fault       = imem_fault_w;
    assign o_dbg_csrwr_v          = commit_csrwr;
    assign o_dbg_csrwr_addr       = c_csr_addr;
    assign o_dbg_csrwr_wdata      = c_csr_wdata;
    assign o_dbg_ptw_req          = imem_ptw_req_w;
    assign o_dbg_ptw_addr         = imem_ptw_addr_w;
    assign o_dbg_ptw_data         = i_dmem_rdata;
    assign o_dbg_redirect_fire    = redirect_fire;
    assign o_dbg_redirect_pc      = redirect_pc;
    assign o_dbg_redirect_src_pc  = c_pc;
    assign o_dbg_alu_pc_out       = dbg_alu_pc;
    assign o_dbg_alu_src_a_out    = dbg_alu_src_a;
    assign o_dbg_alu_src_b_out    = dbg_alu_src_b;
    assign o_dbg_alu_use_pc_a_out = dbg_alu_use_pc_a;
    assign o_dbg_alu_rs1_data_out = dbg_alu_rs1_data;
    assign o_dbg_alu_valid_out    = dbg_alu_valid;
    assign o_dbg_alu_alu_out_out  = dbg_alu_alu_out;
    assign o_dbg_alu_instr_out    = dbg_alu_instr;
    assign o_dbg_alu_imm_out      = dbg_alu_imm;
    assign o_dbg_stval_out        = dbg_csr_stval;
    assign o_dbg_mtval_out        = dbg_csr_mtval;
    assign o_dbg_stvec_out        = csr_stvec;
    assign o_dbg_mtvec_out        = csr_mtvec;

    // ============================================================
    // Redirect (commit-time mispredict / trap / mret)
    // ============================================================
    // M9.A.288: redirect_fire_q declared earlier in module (used by
    // commit_irq gate). Kept var redirect_pc_q here.
    var redirect_pc_q: logic<64>;
    // Trap vector target (M5.D: trap to S → stvec, else mtvec).  Direct mode
    // (tvec[0]=0): all traps → base.  Vectored mode (tvec[0]=1): interrupts →
    // base + 4*cause_number; synchronous exceptions still → base.  (RISC-V
    // priv spec; matches v1 heliodor_core.veryl trap_target.)
    // Phase 11-H3: a trap delegated to VS uses vstvec (the guest's trap vector).
    let trap_tvec_sel : logic<64> = if trap_to_vs ? csr_vstvec : if trap_to_s ? csr_stvec : csr_mtvec;
    let trap_tvec_base: logic<64> = trap_tvec_sel & 64'hffff_ffff_ffff_fffc;
    let trap_target   : logic<64> = if trap_tvec_sel[0] && commit_irq ?
        trap_tvec_base + {48'd0, trap_cause[13:0], 2'b00}
    :
        trap_tvec_base
    ;
    // Phase 8 M1: commit-time mispredict. The architectural next PC of the
    // committing op is its resolved target (carried as c_redirect_pc by
    // execute) for a control op, else the fall-through pc+len. A mismatch with
    // the frontend's chosen next PC (c_pred_next_pc) is a misprediction. This
    // unifies branch/jal/jalr today and (M2+) BTB false-hit / mis-target
    // recovery: a non-control op's arch_next_pc is always pc+len, so a stray
    // prediction self-corrects to the fall-through.
    let c_fall_pc      : logic<64> = c_pc + (if c_is_rvc ? 64'd2 : 64'd4);
    let c_arch_next_pc : logic<64> = if c_is_control ? c_redirect_pc : c_fall_pc;
    let c_bp_mispredict: logic     = rob_commit_valid && (c_pred_next_pc != c_arch_next_pc);
    // Phase 8 M2: predictor training at retire. c_taken = a committed control
    // op went taken (its resolved target differs from the fall-through). Train
    // the BTB on every taken control op (allocate/refresh target + conditional
    // flag); train the BHT on every conditional branch toward its real
    // direction. rob_commit_ack (not _valid) so a held store/AMO trains once.
    assign btb_train_en      = rob_commit_ack && c_is_control && (c_redirect_pc != c_fall_pc);
    assign bht_train_en      = rob_commit_ack && c_is_cond;
    assign bp_train_pc       = c_pc;
    assign btb_train_target  = c_redirect_pc;
    assign btb_train_is_cond = c_is_cond;
    assign btb_train_is_call = c_is_call;
    assign btb_train_is_ret  = c_is_ret;
    assign bht_train_taken   = c_is_control && (c_redirect_pc != c_fall_pc);
    assign bht_train_index   = c_pred_index;
    // S18: iBTB training — every committed non-return JALR writes its resolved
    // target at its fetch-time index (last-target per (PC, path)). The
    // PRE-update committed_ind_hist read here equals the op's fetch-time
    // spec_ind_hist (see the spec_ind_hist comment), so no carried state is
    // needed. The BTB entry's is_ind kind bit marks the PC so fetch consults
    // the iBTB.
    assign btb_train_is_ind  = rob_commit_entry.is_jalr && !c_is_ret;
    assign ibtb_train_en     = btb_train_en && btb_train_is_ind;
    assign ibtb_train_index  = c_pred_index[8:0] ^ committed_ind_hist;
    // S18 indirect path history (committed twin; fold = shift-2 XOR target).
    always_ff (clk, rst) {
        if_reset {
            committed_ind_hist = 9'd0;
        } else if rob_commit_ack && rob_commit_entry.is_jalr && !c_is_ret {
            committed_ind_hist = {committed_ind_hist[6:0], 2'b00} ^ c_redirect_pc[9:1];
        }
    }
    // M3 RAS architectural update: a committed call pushes its return address
    // (the fall-through PC); a committed return pops. On a redirect the
    // speculative RAS is restored from this architectural stack.
    assign ras_arch_push      = rob_commit_ack && c_is_call;
    assign ras_arch_pop       = rob_commit_ack && c_is_ret;
    assign ras_arch_push_addr = c_fall_pc;
    // M4 gshare global history. committed_ghr shifts in each committed
    // conditional branch's actual direction; spec_ghr shifts in the predicted
    // direction at fetch and is restored from committed_ghr on a flush. Because
    // redirect_fire lags the commit by one cycle, committed_ghr has already
    // absorbed the redirecting branch's outcome by the recovery cycle, so the
    // restore is exact.
    let c_dir_taken: logic = c_redirect_pc != c_fall_pc; // control op went taken
    always_ff (clk, rst) {
        if_reset {
            committed_ghr   = 13'd0;
            committed_ghr_l = '0;
        } else if rob_commit_ack && c_is_cond {
            committed_ghr = {committed_ghr[11:0], c_dir_taken};
            // S22: the long twin folds ONLY instances the speculative side
            // also folded (BTB-hit cond branches; never-taken branches never
            // enter the BTB, commit constantly, and would otherwise make the
            // two history streams diverge — fetch would then look TAGE up at
            // indices training never writes).
            if c_ghr_fold {
                committed_ghr_l = {committed_ghr_l[53:0], c_dir_taken};
            }
        }
    }
    // S22 TAGE training — every committed conditional branch. The tables
    // re-read themselves at indices recomputed from the PRE-update
    // committed_ghr_l (== the op's fetch-time spec_ghr_l, same proof as the
    // S18 iBTB). The mispredict input is the fetch-time DIRECTION error:
    // most direction mispredicts resolve via the S8.E early redirect, whose
    // redir_fix patches sh_pred_next_pc (erasing the mismatch from the
    // commit-time compare) — c_early_fix preserves them (a cond branch's
    // taken target is PC-relative-fixed, so an early redirect on a cond
    // branch IS a direction error). The pred_next_pc compare catches the
    // residue that resolves at commit.
    let c_dir_pred_taken: logic = c_pred_next_pc != c_fall_pc;
    assign tage_train_en      = rob_commit_ack && c_is_cond;
    assign tage_train_taken   = c_dir_taken;
    assign tage_train_mispred = c_early_fix || (c_dir_pred_taken != c_dir_taken);
    // Phase 8 S4a.3: gshare spec history shifts in the predicted direction of
    // each delivered conditional branch — up to two per cycle (slot-0 then
    // slot-1). A slot-0 predicted-taken cond branch kills slot-1, so the
    // both-cond case only arises when slot-0 went not-taken (cond_taken0=0).
    // S22: the shifted bit is the FINAL predicted direction (TAGE over BHT)
    // so the spec history mirrors what committed_ghr will record when the
    // prediction is right; the 55-bit long twin shifts identically.
    let ghr_upd0: logic = fb_push0 && btb_hit && btb_is_cond;
    let ghr_upd1: logic = fb_push1 && btb_hit2 && btb_is_cond2;
    always_ff (clk, rst) {
        if_reset {
            spec_ghr   = 13'd0;
            spec_ghr_l = '0;
        } else if any_redirect {
            // Phase 8 S8.E: restore spec history on an early redirect too. Like the
            // RAS restore, this is an approximation (committed_ghr lags the resolved
            // branch by the in-flight conditional branches between it and the commit
            // head) — accuracy-only, not a correctness requirement for gshare.
            spec_ghr   = committed_ghr;
            spec_ghr_l = committed_ghr_l;
        } else if ghr_upd0 && ghr_upd1 {
            spec_ghr   = {spec_ghr[10:0], cond_taken0, cond_taken1};
            spec_ghr_l = {spec_ghr_l[52:0], cond_taken0, cond_taken1};
        } else if ghr_upd0 {
            spec_ghr   = {spec_ghr[11:0], cond_taken0};
            spec_ghr_l = {spec_ghr_l[53:0], cond_taken0};
        } else if ghr_upd1 {
            spec_ghr   = {spec_ghr[11:0], cond_taken1};
            spec_ghr_l = {spec_ghr_l[53:0], cond_taken1};
        }
    }
    // S18 indirect path history (speculative twin): fold each delivered
    // predicted indirect's target; restore on any flush (same approximation
    // as spec_ghr above). A slot-0 indirect is predicted taken, which kills
    // slot-1 delivery, so at most one indirect folds per cycle.
    let ind_upd0: logic = fb_push0 && btb_hit && btb_is_ind;
    let ind_upd1: logic = fb_push1 && btb_hit2 && btb_is_ind2;
    always_ff (clk, rst) {
        if_reset {
            spec_ind_hist = 9'd0;
        } else if any_redirect {
            spec_ind_hist = committed_ind_hist;
        } else if ind_upd0 {
            spec_ind_hist = {spec_ind_hist[6:0], 2'b00} ^ pred_target[9:1];
        } else if ind_upd1 {
            spec_ind_hist = {spec_ind_hist[6:0], 2'b00} ^ pred_target1[9:1];
        }
    }
    always_ff (clk, rst) {
        if_reset {
            redirect_fire_q = 1'b0;
            redirect_pc_q   = 64'd0;
        } else if commit_trap {
            redirect_fire_q = 1'b1;
            redirect_pc_q   = trap_target;
        } else if commit_mret {
            redirect_fire_q = 1'b1;
            redirect_pc_q   = csr_mepc;
        } else if commit_sret {
            redirect_fire_q = 1'b1;
            // Phase 11-H3b: a VS-mode SRET (V=1) returns to vsepc, not sepc.
            // csr_virt still holds the guest's V=1 here (the SRET's mode update
            // is registered this same cycle). Inert at V=0 (picks sepc).
            redirect_pc_q   = if csr_virt ? csr_vsepc : csr_sepc;
        } else if c_bp_mispredict {
            redirect_fire_q = 1'b1;
            redirect_pc_q   = c_arch_next_pc;
        } else if sc_watch_valid_q && rob_commit_valid && rob_commit_idx == sc_watch_rob_q && sc_poison_q {
            // M9.4 SMP: a poisoned SC (remote write hit its reserved line
            // between execute and commit) — its store was suppressed; re-fetch
            // the SC so it re-evaluates against the (now-cleared) reservation
            // and correctly fails (rd=1). Mirrors the mispredict redirect but
            // targets the SC's own PC. Condition is inlined here (the equivalent
            // `commit_sc_replay` let is defined later, near the SC-watch logic).
            redirect_fire_q = 1'b1;
            redirect_pc_q   = c_pc;
        } else if amo_watch_valid_q && rob_commit_valid && rob_commit_idx == amo_watch_rob_q && amo_poison_q {
            // P9.3: a poisoned in-cache AMO (its line departed between the
            // value capture and the commit write) — store suppressed,
            // re-fetch the AMO so it re-acquires ownership and re-reads.
            // (= commit_amo_replay, inlined like the SC arm above.)
            redirect_fire_q = 1'b1;
            redirect_pc_q   = c_pc;
        } else if rob_commit_valid && c_load_poison {
            // Phase 8 S9: a poisoned LOAD at commit — re-fetch its own PC so it
            // re-executes against the now-committed older store (correct data),
            // full-flushing the wrong-path younger consumers. Mirrors the SC arm
            // above (condition inlined; the `commit_load_replay` let is later).
            redirect_fire_q = 1'b1;
            redirect_pc_q   = c_pc;
        } else if commit_csrw_satp {
            // M9 (2026-05-25): csrw satp implicit redirect (see comment at
            // commit_csrw_satp). Re-fetch the next instruction with the
            // new satp so any low-half PC fetches that should fault, do.
            redirect_fire_q = 1'b1;
            redirect_pc_q   = c_pc + 64'd4;
        } else if commit_csrw_frm {
            // P10: csrw frm/fcsr implicit redirect — re-fetch the successor so a
            // younger dynamic-rounding FP op reads the updated rounding mode.
            redirect_fire_q = 1'b1;
            redirect_pc_q   = c_pc + 64'd4;
        } else if commit_fence_i_pulse {
            // S14 fix (latent bug surfaced by the MSHR early restart speeding
            // up commit): FENCE.I must also RE-FETCH its successors, not just
            // flush the icache. Straight-line code right after the fence can
            // itself be patched by prior stores (riscv-tests fence_i test 2
            // patches fence+8), and stale speculatively-fetched copies of those
            // instructions may already sit in the fetch buffer / ROB when the
            // fence commits. Full flush + refetch through the just-flushed
            // icache, mirroring the csrw-satp implicit redirect. FENCE.I has no
            // RVC form, so the successor is always c_pc+4.
            redirect_fire_q = 1'b1;
            redirect_pc_q   = c_pc + 64'd4;
        } else {
            redirect_fire_q = 1'b0;
        }
    }
    assign redirect_fire = redirect_fire_q;
    assign redirect_pc   = redirect_pc_q;

    // ============================================================
    // arch_regs shadow (debug/cosim)
    // ============================================================
    var arch_regs: logic<64> [32];
    always_ff (clk, rst) {
        if_reset {
            for r in 0..32 {
                arch_regs[r] = 64'd0;
            }
        } else {
            if rob_commit_valid && c_has_rd && !c_illegal {
                for r in 1..32 {
                    if c_rd_arch == (r as 5) {
                        arch_regs[r] = c_result_data;
                    }
                }
            }
            // Phase 8 S1: commit slot-1 — ordered AFTER slot-0 so a same-rd WAW
            // leaves the younger (slot-1) value. x3 (boot pass/fail) is sourced
            // from here, so slot-1 writes MUST be reflected.
            if commit2_fire && c2_has_rd {
                for r in 1..32 {
                    if c2_rd_arch == (r as 5) {
                        arch_regs[r] = c2_result_data;
                    }
                }
            }
        }
    }
    assign o_dbg_regs = arch_regs;
    assign o_dbg_x3   = arch_regs[3];

    // P9.5: SFENCE.VMA selective-flush operands. Placed after arch_regs is
    // declared; the values are stable at the (serialized) sfence commit so
    // arch_regs holds the resolved rs1 (VA) / rs2 (ASID). rs*==x0 selects the
    // wildcard (all-addresses / all-ASIDs) variant. Drives the forward-declared
    // vars consumed by the imem/dmem MMU instances.
    assign sfence_vaddr    = arch_regs[c_sfence_rs1];
    assign sfence_asid     = arch_regs[c_sfence_rs2][15:0];
    assign sfence_rs1_zero = c_sfence_rs1 == 5'd0;
    assign sfence_rs2_zero = c_sfence_rs2 == 5'd0;
    assign o_dbg_pc   = c_pc;


    // ============================================================
    // Retire stream (lane A only in M1)
    // ============================================================
    // v1 does not emit a retire-valid pulse for MRET / ECALL / EBREAK
    // (they go through a separate squash path in EX). To keep the
    // cosim FIFO order aligned, gate v4's retire-valid the same way.
    // M9.A.241 (2026-05-26): also suppress when inject_fake_ifault fires.
    // v1 squashes the csrw satp itself (the natural IFU-fault entry of the
    // next instruction replaces it before it can retire), so v1 doesn't
    // count csrw satp as a retire on the trampoline transition. v4's
    // inject_fake_ifault, in contrast, pops the csrw satp ROB entry first
    // (counted) and only THEN traps — creating a 1-retire offset between
    // v1 and v4 retire streams, manifesting as cosim divergence at #76991
    // with v1pc=high-half auipc (= stvec target) and v4pc=low-half csrw satp.
    // M9.A.265: gate on rob_commit_ack (= actual commit), not just
    // rob_commit_valid. M9.A.255-b stalls rob_commit_ack when a store is
    // committing during dmem_mmu_busy (multi-cycle PTW). rob_commit_valid
    // stays 1 across the stall, so retire previously fired multiple times
    // for the same store — corrupting retire-stream observers (cosim,
    // ret_total counter, IPC stats). Found via M9.A.264 cosim: v4 retire
    // ring had duplicate entries for `sw sp, 32(tp)` at PC 0x800010f8.
    // M9.A.305: ECALL/EBREAK ARE emitted to the retire stream to match v1
    // (heliodor_core.veryl:4800 o_dbg_retire_v_a = rob_commit_valid, which is
    // asserted for a committing ecall/ebreak — a synchronous exception that
    // commits at the head before redirecting). Cosim @cy630141 proved v1
    // emits the ecall retire (pc=...39c2, rdv=0) while v4 jumped straight to
    // the trap handler (pc=0xa0) — a benign retire-dbg off-by-one, NOT an
    // execution bug (v4 correctly traps to mtvec=0xa0 and reads mcause=9).
    // mret/sret stay excluded (they redirect/squash in v1 → no commit_valid);
    // illegal/fake_ifault stay excluded pending a proven mid-stream divergence.
    assign o_dbg_retire_v_a    = rob_commit_ack && !c_illegal && !c_is_mret && !c_is_sret && !inject_fake_ifault;
    assign o_dbg_retire_pc_a   = c_pc;
    assign o_dbg_retire_rd_v_a = c_has_rd;
    assign o_dbg_retire_rd_a   = c_rd_arch;
    assign o_dbg_retire_data_a = c_result_data;

    // ============================================================
    // dmem ports (M2: toy memory — combinational read, registered
    // write at commit time)
    // ============================================================
    // LOAD read: drive dmem read address when an issued op is a LOAD.
    // Address comes from rs1 + imm (same as the alu_wrap AGU).
    // M5.A AMO: address = rs1 alone (no immediate). LR / AMO* need a
    // read at issue time; SC is write-only at commit time.
    // Use per-field outputs from iq_int (struct-field READ has sim bug).
    let amo_is_sc_iss : logic     = iq_iss_amo_funct5 == 5'b00011;
    let agu_imm_iss   : logic<64> = if iq_iss_is_amo ? 64'd0 : iq_issue_op.base.imm;
    // P10 Supm/Ssnpm: the actual load/AMO access address sent to the MMU/dcache
    // comes from here (not u_alu's internal agu), so it must get the same pointer
    // masking u_alu applies — otherwise the access and u_alu's data formatting /
    // fault VA would diverge. PMM=0 → agu_addr_iss == agu_raw_iss (no-op).
    let agu_raw_iss   : logic<64> = prf_rs1_data + agu_imm_iss;
    var agu_addr_iss  : logic<64>;
    always_comb {
        case pm_mode {
            2'b10  : agu_addr_iss = {(if pm_va ? agu_raw_iss[56] : 1'b0) repeat 7, agu_raw_iss[56:0]};
            2'b11  : agu_addr_iss = {(if pm_va ? agu_raw_iss[47] : 1'b0) repeat 16, agu_raw_iss[47:0]};
            default: agu_addr_iss = agu_raw_iss;
        }
    }
    let issue_amo_read: logic     = iq_issue_valid && iq_iss_is_amo && !amo_is_sc_iss;
    let issue_is_load : logic     = (iq_issue_valid && iq_issue_op.base.is_load) || issue_amo_read;
    // Phase 8 S5.2: slot-1 (pipe-1) LOAD effective address for the 2nd dcache read
    // port. alu_wrap (u_alu2) re-derives the same agu internally; this drives the
    // dcache i_addr2 and the 2nd forward network. Slot-1 never issues AMO/STORE
    // (pipe1_ok), so the immediate is always the load offset (no AMO-zero case).
    let agu_raw_iss2  : logic<64> = prf_rs1_data2 + iq_issue_op2.base.imm;
    var agu_addr_iss2 : logic<64>; // P10 pointer masking (matches u_alu2 / slot-0)
    always_comb {
        case pm_mode {
            2'b10  : agu_addr_iss2 = {(if pm_va ? agu_raw_iss2[56] : 1'b0) repeat 7, agu_raw_iss2[56:0]};
            2'b11  : agu_addr_iss2 = {(if pm_va ? agu_raw_iss2[47] : 1'b0) repeat 16, agu_raw_iss2[47:0]};
            default: agu_addr_iss2 = agu_raw_iss2;
        }
    }
    let issue2_is_load: logic     = iq_issue_valid2 && iq_iss_is_load2;

    // ============================================================
    // Phase 8 S5.1: store-to-load forward byte-network (computed in the core so
    // the ROB store shadow + agu_addr_iss are forward-refs/local — a big comb
    // reading a backward-referenced cross-module array hangs the Veryl sim). For
    // each of the 8 bytes [agu_addr_iss, +7] the issuing LOAD consumes, override
    // the dcache byte with the YOUNGEST older forwardable store writing it. Each
    // store's data is aligned into the load frame ONCE (`asd`); the 8 scalar
    // accumulators (manually unrolled — a loop-var WRITE index hangs the sim) read
    // constant slices. stld_fwd_data is in the natural load frame (byte p = addr
    // agu_addr_iss+p, matching alu_wrap's ld_shifted); stld_fwd_mask gates it.
    // ============================================================
    let stld_fwd_age: logic<ROB_IDX_W> = iq_iss_rob_idx - rob_head_idx;
    let stld_fwd_en : logic              = iq_issue_valid && iq_iss_is_load && !iq_iss_is_amo;
    assign ls_addr = rob_store_addr;
    assign ls_data = rob_store_data;
    assign ls_f3   = rob_store_funct3;
    assign ls_fwd  = rob_store_fwdable;
    var sf0_v: logic; var sf0_age: logic<ROB_IDX_W>; var sf0_b: logic<8>;
    var sf1_v: logic; var sf1_age: logic<ROB_IDX_W>; var sf1_b: logic<8>;
    var sf2_v: logic; var sf2_age: logic<ROB_IDX_W>; var sf2_b: logic<8>;
    var sf3_v: logic; var sf3_age: logic<ROB_IDX_W>; var sf3_b: logic<8>;
    var sf4_v: logic; var sf4_age: logic<ROB_IDX_W>; var sf4_b: logic<8>;
    var sf5_v: logic; var sf5_age: logic<ROB_IDX_W>; var sf5_b: logic<8>;
    var sf6_v: logic; var sf6_age: logic<ROB_IDX_W>; var sf6_b: logic<8>;
    var sf7_v: logic; var sf7_age: logic<ROB_IDX_W>; var sf7_b: logic<8>;
    // One always_comb per byte (each a single self-ref accumulator like iq_int's
    // oldest-ready select): 8 accumulators in ONE block made the combinational_loop
    // diagnostic falsely fuse them into a loop. p = byte position; la = agu+p.
    always_comb {
        sf0_v = 1'b0; sf0_age = '0; sf0_b = 8'd0;
        if stld_fwd_en { for i in 0..ROB_DEPTH {
            let age_i: logic<ROB_IDX_W> = (i as ROB_IDX_W) - rob_head_idx;
            let sa: logic<64> = ls_addr[i]; let la: logic<64> = agu_addr_iss + 64'd0;
            let cov: logic = ls_fwd[i] && (age_i <: stld_fwd_age) && (la >= sa) && (la <: sa + ((5'd1 << ls_f3[i][1:0]) as 64));
            let off: logic<64> = la - sa;
            let byt: logic<64> = ls_data[i] >> {off[2:0], 3'b000};
            if cov && (!sf0_v || age_i >: sf0_age) { sf0_v = 1'b1; sf0_age = age_i; sf0_b = byt[7:0]; }
        } }
    }
    always_comb {
        sf1_v = 1'b0; sf1_age = '0; sf1_b = 8'd0;
        if stld_fwd_en { for i in 0..ROB_DEPTH {
            let age_i: logic<ROB_IDX_W> = (i as ROB_IDX_W) - rob_head_idx;
            let sa: logic<64> = ls_addr[i]; let la: logic<64> = agu_addr_iss + 64'd1;
            let cov: logic = ls_fwd[i] && (age_i <: stld_fwd_age) && (la >= sa) && (la <: sa + ((5'd1 << ls_f3[i][1:0]) as 64));
            let off: logic<64> = la - sa;
            let byt: logic<64> = ls_data[i] >> {off[2:0], 3'b000};
            if cov && (!sf1_v || age_i >: sf1_age) { sf1_v = 1'b1; sf1_age = age_i; sf1_b = byt[7:0]; }
        } }
    }
    always_comb {
        sf2_v = 1'b0; sf2_age = '0; sf2_b = 8'd0;
        if stld_fwd_en { for i in 0..ROB_DEPTH {
            let age_i: logic<ROB_IDX_W> = (i as ROB_IDX_W) - rob_head_idx;
            let sa: logic<64> = ls_addr[i]; let la: logic<64> = agu_addr_iss + 64'd2;
            let cov: logic = ls_fwd[i] && (age_i <: stld_fwd_age) && (la >= sa) && (la <: sa + ((5'd1 << ls_f3[i][1:0]) as 64));
            let off: logic<64> = la - sa;
            let byt: logic<64> = ls_data[i] >> {off[2:0], 3'b000};
            if cov && (!sf2_v || age_i >: sf2_age) { sf2_v = 1'b1; sf2_age = age_i; sf2_b = byt[7:0]; }
        } }
    }
    always_comb {
        sf3_v = 1'b0; sf3_age = '0; sf3_b = 8'd0;
        if stld_fwd_en { for i in 0..ROB_DEPTH {
            let age_i: logic<ROB_IDX_W> = (i as ROB_IDX_W) - rob_head_idx;
            let sa: logic<64> = ls_addr[i]; let la: logic<64> = agu_addr_iss + 64'd3;
            let cov: logic = ls_fwd[i] && (age_i <: stld_fwd_age) && (la >= sa) && (la <: sa + ((5'd1 << ls_f3[i][1:0]) as 64));
            let off: logic<64> = la - sa;
            let byt: logic<64> = ls_data[i] >> {off[2:0], 3'b000};
            if cov && (!sf3_v || age_i >: sf3_age) { sf3_v = 1'b1; sf3_age = age_i; sf3_b = byt[7:0]; }
        } }
    }
    always_comb {
        sf4_v = 1'b0; sf4_age = '0; sf4_b = 8'd0;
        if stld_fwd_en { for i in 0..ROB_DEPTH {
            let age_i: logic<ROB_IDX_W> = (i as ROB_IDX_W) - rob_head_idx;
            let sa: logic<64> = ls_addr[i]; let la: logic<64> = agu_addr_iss + 64'd4;
            let cov: logic = ls_fwd[i] && (age_i <: stld_fwd_age) && (la >= sa) && (la <: sa + ((5'd1 << ls_f3[i][1:0]) as 64));
            let off: logic<64> = la - sa;
            let byt: logic<64> = ls_data[i] >> {off[2:0], 3'b000};
            if cov && (!sf4_v || age_i >: sf4_age) { sf4_v = 1'b1; sf4_age = age_i; sf4_b = byt[7:0]; }
        } }
    }
    always_comb {
        sf5_v = 1'b0; sf5_age = '0; sf5_b = 8'd0;
        if stld_fwd_en { for i in 0..ROB_DEPTH {
            let age_i: logic<ROB_IDX_W> = (i as ROB_IDX_W) - rob_head_idx;
            let sa: logic<64> = ls_addr[i]; let la: logic<64> = agu_addr_iss + 64'd5;
            let cov: logic = ls_fwd[i] && (age_i <: stld_fwd_age) && (la >= sa) && (la <: sa + ((5'd1 << ls_f3[i][1:0]) as 64));
            let off: logic<64> = la - sa;
            let byt: logic<64> = ls_data[i] >> {off[2:0], 3'b000};
            if cov && (!sf5_v || age_i >: sf5_age) { sf5_v = 1'b1; sf5_age = age_i; sf5_b = byt[7:0]; }
        } }
    }
    always_comb {
        sf6_v = 1'b0; sf6_age = '0; sf6_b = 8'd0;
        if stld_fwd_en { for i in 0..ROB_DEPTH {
            let age_i: logic<ROB_IDX_W> = (i as ROB_IDX_W) - rob_head_idx;
            let sa: logic<64> = ls_addr[i]; let la: logic<64> = agu_addr_iss + 64'd6;
            let cov: logic = ls_fwd[i] && (age_i <: stld_fwd_age) && (la >= sa) && (la <: sa + ((5'd1 << ls_f3[i][1:0]) as 64));
            let off: logic<64> = la - sa;
            let byt: logic<64> = ls_data[i] >> {off[2:0], 3'b000};
            if cov && (!sf6_v || age_i >: sf6_age) { sf6_v = 1'b1; sf6_age = age_i; sf6_b = byt[7:0]; }
        } }
    }
    always_comb {
        sf7_v = 1'b0; sf7_age = '0; sf7_b = 8'd0;
        if stld_fwd_en { for i in 0..ROB_DEPTH {
            let age_i: logic<ROB_IDX_W> = (i as ROB_IDX_W) - rob_head_idx;
            let sa: logic<64> = ls_addr[i]; let la: logic<64> = agu_addr_iss + 64'd7;
            let cov: logic = ls_fwd[i] && (age_i <: stld_fwd_age) && (la >= sa) && (la <: sa + ((5'd1 << ls_f3[i][1:0]) as 64));
            let off: logic<64> = la - sa;
            let byt: logic<64> = ls_data[i] >> {off[2:0], 3'b000};
            if cov && (!sf7_v || age_i >: sf7_age) { sf7_v = 1'b1; sf7_age = age_i; sf7_b = byt[7:0]; }
        } }
    }
    // S27: stld_fwd_data/mask are now composed AFTER the committed-store-
    // buffer forward layer (near the sb FIFO below): ROB bytes win, sb bytes
    // fill the rest.

    // ============================================================
    // Phase 8 S5.2: 2nd store-to-load forward byte-network for the slot-1
    // (pipe-1) LOAD at agu_addr_iss2. Identical to the slot-0 network above but
    // keyed on the slot-1 load's address/age; reads the SAME ROB store shadow
    // (ls_*). Feeds u_alu2.i_fwd_data/mask. 8 separate always_comb (one per byte)
    // — fusing them re-trips the combinational_loop diagnostic (see slot-0 note).
    // ============================================================
    let stld_fwd_age2: logic<ROB_IDX_W> = iq_iss_rob_idx2 - rob_head_idx;
    let stld_fwd_en2 : logic              = issue2_is_load;
    var sg0_v: logic; var sg0_age: logic<ROB_IDX_W>; var sg0_b: logic<8>;
    var sg1_v: logic; var sg1_age: logic<ROB_IDX_W>; var sg1_b: logic<8>;
    var sg2_v: logic; var sg2_age: logic<ROB_IDX_W>; var sg2_b: logic<8>;
    var sg3_v: logic; var sg3_age: logic<ROB_IDX_W>; var sg3_b: logic<8>;
    var sg4_v: logic; var sg4_age: logic<ROB_IDX_W>; var sg4_b: logic<8>;
    var sg5_v: logic; var sg5_age: logic<ROB_IDX_W>; var sg5_b: logic<8>;
    var sg6_v: logic; var sg6_age: logic<ROB_IDX_W>; var sg6_b: logic<8>;
    var sg7_v: logic; var sg7_age: logic<ROB_IDX_W>; var sg7_b: logic<8>;
    always_comb {
        sg0_v = 1'b0; sg0_age = '0; sg0_b = 8'd0;
        if stld_fwd_en2 { for i in 0..ROB_DEPTH {
            let age_i: logic<ROB_IDX_W> = (i as ROB_IDX_W) - rob_head_idx;
            let sa: logic<64> = ls_addr[i]; let la: logic<64> = agu_addr_iss2 + 64'd0;
            let cov: logic = ls_fwd[i] && (age_i <: stld_fwd_age2) && (la >= sa) && (la <: sa + ((5'd1 << ls_f3[i][1:0]) as 64));
            let off: logic<64> = la - sa;
            let byt: logic<64> = ls_data[i] >> {off[2:0], 3'b000};
            if cov && (!sg0_v || age_i >: sg0_age) { sg0_v = 1'b1; sg0_age = age_i; sg0_b = byt[7:0]; }
        } }
    }
    always_comb {
        sg1_v = 1'b0; sg1_age = '0; sg1_b = 8'd0;
        if stld_fwd_en2 { for i in 0..ROB_DEPTH {
            let age_i: logic<ROB_IDX_W> = (i as ROB_IDX_W) - rob_head_idx;
            let sa: logic<64> = ls_addr[i]; let la: logic<64> = agu_addr_iss2 + 64'd1;
            let cov: logic = ls_fwd[i] && (age_i <: stld_fwd_age2) && (la >= sa) && (la <: sa + ((5'd1 << ls_f3[i][1:0]) as 64));
            let off: logic<64> = la - sa;
            let byt: logic<64> = ls_data[i] >> {off[2:0], 3'b000};
            if cov && (!sg1_v || age_i >: sg1_age) { sg1_v = 1'b1; sg1_age = age_i; sg1_b = byt[7:0]; }
        } }
    }
    always_comb {
        sg2_v = 1'b0; sg2_age = '0; sg2_b = 8'd0;
        if stld_fwd_en2 { for i in 0..ROB_DEPTH {
            let age_i: logic<ROB_IDX_W> = (i as ROB_IDX_W) - rob_head_idx;
            let sa: logic<64> = ls_addr[i]; let la: logic<64> = agu_addr_iss2 + 64'd2;
            let cov: logic = ls_fwd[i] && (age_i <: stld_fwd_age2) && (la >= sa) && (la <: sa + ((5'd1 << ls_f3[i][1:0]) as 64));
            let off: logic<64> = la - sa;
            let byt: logic<64> = ls_data[i] >> {off[2:0], 3'b000};
            if cov && (!sg2_v || age_i >: sg2_age) { sg2_v = 1'b1; sg2_age = age_i; sg2_b = byt[7:0]; }
        } }
    }
    always_comb {
        sg3_v = 1'b0; sg3_age = '0; sg3_b = 8'd0;
        if stld_fwd_en2 { for i in 0..ROB_DEPTH {
            let age_i: logic<ROB_IDX_W> = (i as ROB_IDX_W) - rob_head_idx;
            let sa: logic<64> = ls_addr[i]; let la: logic<64> = agu_addr_iss2 + 64'd3;
            let cov: logic = ls_fwd[i] && (age_i <: stld_fwd_age2) && (la >= sa) && (la <: sa + ((5'd1 << ls_f3[i][1:0]) as 64));
            let off: logic<64> = la - sa;
            let byt: logic<64> = ls_data[i] >> {off[2:0], 3'b000};
            if cov && (!sg3_v || age_i >: sg3_age) { sg3_v = 1'b1; sg3_age = age_i; sg3_b = byt[7:0]; }
        } }
    }
    always_comb {
        sg4_v = 1'b0; sg4_age = '0; sg4_b = 8'd0;
        if stld_fwd_en2 { for i in 0..ROB_DEPTH {
            let age_i: logic<ROB_IDX_W> = (i as ROB_IDX_W) - rob_head_idx;
            let sa: logic<64> = ls_addr[i]; let la: logic<64> = agu_addr_iss2 + 64'd4;
            let cov: logic = ls_fwd[i] && (age_i <: stld_fwd_age2) && (la >= sa) && (la <: sa + ((5'd1 << ls_f3[i][1:0]) as 64));
            let off: logic<64> = la - sa;
            let byt: logic<64> = ls_data[i] >> {off[2:0], 3'b000};
            if cov && (!sg4_v || age_i >: sg4_age) { sg4_v = 1'b1; sg4_age = age_i; sg4_b = byt[7:0]; }
        } }
    }
    always_comb {
        sg5_v = 1'b0; sg5_age = '0; sg5_b = 8'd0;
        if stld_fwd_en2 { for i in 0..ROB_DEPTH {
            let age_i: logic<ROB_IDX_W> = (i as ROB_IDX_W) - rob_head_idx;
            let sa: logic<64> = ls_addr[i]; let la: logic<64> = agu_addr_iss2 + 64'd5;
            let cov: logic = ls_fwd[i] && (age_i <: stld_fwd_age2) && (la >= sa) && (la <: sa + ((5'd1 << ls_f3[i][1:0]) as 64));
            let off: logic<64> = la - sa;
            let byt: logic<64> = ls_data[i] >> {off[2:0], 3'b000};
            if cov && (!sg5_v || age_i >: sg5_age) { sg5_v = 1'b1; sg5_age = age_i; sg5_b = byt[7:0]; }
        } }
    }
    always_comb {
        sg6_v = 1'b0; sg6_age = '0; sg6_b = 8'd0;
        if stld_fwd_en2 { for i in 0..ROB_DEPTH {
            let age_i: logic<ROB_IDX_W> = (i as ROB_IDX_W) - rob_head_idx;
            let sa: logic<64> = ls_addr[i]; let la: logic<64> = agu_addr_iss2 + 64'd6;
            let cov: logic = ls_fwd[i] && (age_i <: stld_fwd_age2) && (la >= sa) && (la <: sa + ((5'd1 << ls_f3[i][1:0]) as 64));
            let off: logic<64> = la - sa;
            let byt: logic<64> = ls_data[i] >> {off[2:0], 3'b000};
            if cov && (!sg6_v || age_i >: sg6_age) { sg6_v = 1'b1; sg6_age = age_i; sg6_b = byt[7:0]; }
        } }
    }
    always_comb {
        sg7_v = 1'b0; sg7_age = '0; sg7_b = 8'd0;
        if stld_fwd_en2 { for i in 0..ROB_DEPTH {
            let age_i: logic<ROB_IDX_W> = (i as ROB_IDX_W) - rob_head_idx;
            let sa: logic<64> = ls_addr[i]; let la: logic<64> = agu_addr_iss2 + 64'd7;
            let cov: logic = ls_fwd[i] && (age_i <: stld_fwd_age2) && (la >= sa) && (la <: sa + ((5'd1 << ls_f3[i][1:0]) as 64));
            let off: logic<64> = la - sa;
            let byt: logic<64> = ls_data[i] >> {off[2:0], 3'b000};
            if cov && (!sg7_v || age_i >: sg7_age) { sg7_v = 1'b1; sg7_age = age_i; sg7_b = byt[7:0]; }
        } }
    }
    // S27: stld_fwd_data2/mask2 composed after the sb forward layer (below).

    // ============================================================
    // M5.A LR/SC reservation (single-hart, simplest).
    // - LR at issue: set valid + addr to agu_addr_iss
    // - SC at issue: clear (whether matched or not, atomicity)
    // - Other STORE / AMO at issue: clear if address matches
    // - Trap / MRET / redirect: clear (Linux assumption)
    // ============================================================
    let issue_is_lr     : logic = iq_issue_valid && iq_iss_is_amo && iq_iss_amo_funct5 == 5'b00010;
    let issue_is_sc     : logic = iq_issue_valid && iq_iss_is_amo && iq_iss_amo_funct5 == 5'b00011;
    let issue_is_amo    : logic = iq_issue_valid && iq_iss_is_amo;
    let issue_is_st     : logic = iq_issue_valid && iq_issue_op.base.is_store;
    let issue_addr_match: logic = rsv_valid_q && rsv_addr_q == agu_addr_iss;
    // M9.4 SMP: an SC may consume (clear) the reservation only if BOTH (a) it is
    // program-order AFTER its owner LR (age = distance from the ROB head), so an
    // OoO-reordered OLDER sc.w cannot wipe a YOUNGER lr.w's reservation, AND (b) its
    // address matches the reservation, so an SC to a different lock cannot clear it.
    //
    // The old `rsv_owner_committed_q ||` escape hatch (allow any SC to clear once the
    // owner LR has committed) was a BUG: in a speculatively-unrolled read_lock spin
    // (lr.w; bltz; addi; sc.w; bnez) the owner LR commits within a few cycles, after
    // which a stale/reordered in-flight sc.w cleared the reservation BEFORE the
    // matching sc.w could check it → every sc.w then saw rsv_valid=0 → the hart spun
    // forever in arch_read_lock. The Veryl sim's evaluation order happened to avoid
    // it, but Verilator (correct SV NBA, ≈ real HW) livelocked N=2/N=4 SMP boot here.
    // The age gate alone is enough; a stale reservation that the wrapped age compare
    // fails to clear is harmless because the sc.w's own match check (rsv_addr == its
    // own addr) still gates success.
    let rsv_age_sc   : logic<ROB_IDX_W> = iq_iss_rob_idx - rob_head_idx;
    let rsv_age_owner: logic<ROB_IDX_W> = rsv_rob_q - rob_head_idx;
    // M9.4 age gate (owner still IN-FLIGHT): the SC may consume the reservation
    // only if it is program-order AFTER the owner LR (its distance from the ROB
    // head exceeds the owner's), so an OoO-reordered OLDER sc.w cannot wipe a
    // YOUNGER lr.w's reservation.
    // Phase 8 M2 (rsv_committed_q escape): once the owner LR has COMMITTED it has
    // left the ROB and rsv_rob_q is stale — the distance compare wraps and would
    // wrongly reject every SC. A committed reservation is architectural, and any
    // in-flight SC is necessarily program-order after the (retired) owner, so a
    // matching SC may consume it. This is what M2's faster front end exposed: the
    // owner lr.w now commits before the paired sc.w even issues (AMOs are
    // bus-serialized, so the sc.w lags), leaving sc_may_clear=0 for every sc.w —
    // the reservation was never consumed, so a later bare sc.w spuriously
    // succeeded (rv64ua-lrsc test 6). The in-flight age gate above is retained, so
    // the M9.4 reorder protection still holds while the owner is in flight.
    let sc_may_clear : logic = (rsv_committed_q || (rsv_age_sc >: rsv_age_owner)) && (rsv_addr_q == agu_addr_iss);
    // Phase 8 M2: track whether the reservation's owner LR has committed. Reset by
    // each new LR (fresh, uncommitted owner); raised when the owner's ROB slot
    // retires. Only meaningful while rsv_valid_q is set.
    always_ff (clk, rst) {
        if_reset {
            rsv_committed_q = 1'b0;
        } else if issue_is_lr && iq_issue_ack {
            rsv_committed_q = 1'b0;
        } else if rob_commit_ack && rob_commit_idx == rsv_rob_q {
            rsv_committed_q = 1'b1;
        }
    }
    // P9.2: arm the presence-based reservation clear only once the reserved
    // line has actually been observed PRESENT (the owning LR's force-miss
    // fill landed). Reset by each new LR.
    always_ff (clk, rst) {
        if_reset {
            rsv_present_seen_q = 1'b0;
        } else if issue_is_lr && iq_issue_ack {
            rsv_present_seen_q = 1'b0;
        } else if rsv_valid_q && dc_rsv_present {
            rsv_present_seen_q = 1'b1;
        }
    }
    always_ff (clk, rst) {
        if_reset {
            rsv_valid_q = 1'b0;
            rsv_addr_q  = 64'd0;
            rsv_pa_q    = 64'd0;
            rsv_rob_q   = '0;
        } else if commit_trap || commit_mret || commit_sret || commit_csrw_satp {
            // M9.4 SMP: clear the LR/SC reservation only on ARCHITECTURAL control
            // events (trap / mret / sret / satp context switch), NOT on a plain
            // branch-mispredict redirect. The old `redirect_fire_q` term cleared the
            // reservation on EVERY redirect, including a speculative branch mispredict.
            // In a tight read_lock spin (lr.w; blt; addi; sc.w; bnez), the blt/bnez
            // mispredict between the (already-committed) lr.w and the sc.w wiped the
            // CORRECT-PATH reservation every iteration, so the sc.w never succeeded —
            // hart spun forever on an UNCONTENDED rwlock (observed: N=4 hart0 stuck in
            // arch_read_lock @0x80025b58 with rsv_valid=0 at the SC, addr correct,
            // poison=0, lock dword written only ~3× in 62M). A branch mispredict is a
            // microarchitectural event and must NOT clear an architectural reservation
            // (RVWMO). v1 (in-order, ~1-cycle LR→SC window) never exposed it. The rare
            // remote-write case is still handled by the dword-granular remote-clear
            // below; a squashed wrong-path lr.w is re-paired with its own sc.w on the
            // correct path so its stale reservation cannot make a bare sc.w succeed.
            // Phase 8 M2: a wrong-path lr.w can no longer set the reservation at all —
            // amo_at_head restricts AMO/LR/SC issue to the non-speculative ROB head.
            rsv_valid_q = 1'b0;
        } else if issue_is_lr && iq_issue_ack {
            // M9 SMP: gate the reservation updates on iq_issue_ack (ACTUAL
            // issue), not bare selection — a selection-time update can fire
            // on a cycle the op does not actually issue (e.g. a dcache-stall
            // hold), desynchronizing it from the SC's sc_match check in
            // alu_wrap. Tying these to iq_issue_ack keeps the clear and the
            // check on the same cycle: sc_match reads the pre-edge
            // reservation, the clear applies the edge. (P9.3: the M9.4
            // bus-lock issue bubble this note used to describe is gone.)
            rsv_valid_q = 1'b1;
            rsv_addr_q  = agu_addr_iss;
            // P9.3: the LR read drives the dmem port this cycle, so
            // dmu_dmem_addr is its TRANSLATED PA (== VA in bare mode).
            rsv_pa_q  = dmu_dmem_addr;
            rsv_rob_q = iq_iss_rob_idx;
        } else if (i_dcache_inv_valid && i_dcache_inv_addr[63:6] == rsv_pa_q[63:6])
            || (i_dcache_inv2_valid && i_dcache_inv2_addr[63:6] == rsv_pa_q[63:6]) {
            // M9 SMP: a remote hart's store hit our reserved line — kill the
            // reservation so a following SC fails (matches RVWMO). Placed
            // after the LR set so a fresh LR this cycle wins over a remote
            // write to the OLD addr. P9.2: port 2 covers a remote misaligned
            // store's hi line. P9.3: PA-compare, LINE-granular (the precise
            // inv pulses are line-aligned — the old [63:3] dword compare
            // only ever matched dword 0; presence covers the rest anyway).
            rsv_valid_q = 1'b0;
        } else if rsv_present_seen_q && !dc_rsv_present {
            // P9.2 (precise invalidation): the reserved LINE left the L1 —
            // evicted locally or invalidated remotely. From here on a remote
            // write to it produces NO pulse on this hart (the directory no
            // longer lists us), so the reservation must die with the line:
            // rsv_valid ⇒ line present ⇒ every remote write is observed.
            // rsv_present_seen_q arms the clear only after the owning LR's
            // own force-miss fill has brought the line in (presence is 0
            // between the force-invalidate and the fill — clearing there
            // would kill every fresh reservation and livelock LR/SC loops).
            rsv_valid_q = 1'b0;
        } else if issue_is_sc && iq_issue_ack {
            // M9.4 SMP: the SC consumes the reservation, but ONLY if it is program-
            // order after the owning LR (sc_may_clear). An OoO-reordered OLDER SC
            // (issuing after a younger LR) must not wipe that younger LR's
            // reservation, or the next SC fails forever on an uncontended lock.
            if sc_may_clear {
                rsv_valid_q = 1'b0;
            }
        } else if (issue_is_st || issue_is_amo) && issue_addr_match && iq_issue_ack {
            rsv_valid_q = 1'b0;
        }
    }

    // ============================================================
    // M9.4 SMP: SC commit-time re-validation (LR/SC atomicity under OoO).
    //
    // alu_wrap evaluates sc_match (reservation valid && addr) at the SC's
    // EXECUTE (issue) and latches the result into the ROB as c_is_store
    // (= amo_commit_store). But the STORE itself fires at COMMIT, several
    // cycles later. In between, a REMOTE hart can write the reserved line;
    // RVWMO then requires THIS SC to FAIL, yet the already-latched success
    // still fires the store at commit. Two harts' SCs to the same line both
    // succeed -> one update is lost. Observed as the N=4 kernel tasklist_lock
    // (PA 0x80a07240) read-lock counter going stuck-NEGATIVE (two read_lock
    // `addi+1; sc.w` both write count+1, a reader increment is lost, later
    // read_unlock `amoadd -1` drives it negative = a phantom write-lock) so
    // every reader spins forever in arch_read_lock @0x80025b58. v1 (in-order,
    // execute==commit in one MEM stage) has NO such window, so it boots N=4.
    //
    // Fix: WATCH the in-flight matched SC's reserved dword. If a remote write
    // (i_dcache_inv, self-filtered = remote only) hits it before the SC
    // commits, POISON the SC. At the watched SC's commit, if poisoned,
    // SUPPRESS its store and REDIRECT to its own PC (commit_sc_replay, handled
    // like a mispredict). The replayed SC re-reads the redirect-cleared
    // reservation -> sc_match fails (rd=1, no store) -> software retries its
    // LR/SC loop. Single watch slot suffices: a hart never has two LR/SC pairs
    // in flight at once. All registered; the watch state never feeds issue
    // select, so no comb loop. (The four sc_*_q registers are declared up near
    // rsv_valid_q so the commit-redirect always_ff can read them.)
    // A matched SC issues this cycle (it will fire a store at commit):
    let sc_exec_match  : logic = issue_is_sc && iq_issue_ack && issue_addr_match;
    // A remote write hits the watched SC's reserved line. P9.2: also poison
    // when the watched LINE leaves the L1 (presence drop) — from then on
    // remote writes to it are invisible here (precise invalidation), so the
    // watch can no longer be trusted; the replayed SC fails cleanly.
    // P9.3: sc_watch_addr_q is the PA (= rsv_pa_q at arm; same location —
    // issue_addr_match held), line-granular like the rsv clear above.
    let sc_remote_hit: logic = sc_watch_valid_q && ((i_dcache_inv_valid && i_dcache_inv_addr[63:6] == sc_watch_addr_q[63:6])
        || (i_dcache_inv2_valid && i_dcache_inv2_addr[63:6] == sc_watch_addr_q[63:6]) || !dc_scw_present);
    // The watched SC is at the ROB head this cycle (the replay trigger):
    let sc_at_head: logic = sc_watch_valid_q && rob_commit_valid && rob_commit_idx == sc_watch_rob_q;
    // Poisoned watched SC at the head -> replay (fail it):
    let commit_sc_replay: logic = sc_at_head && sc_poison_q;
    // P9.3: clear the SC watch only on its actual RETIRE (rob_commit_ack),
    // not on head arrival — same reason as amo_watch_retire (the at-head SC
    // issue makes execute coincide with the head, so a valid-based clear
    // would wipe the watch before the in-cache SC store completes).
    let sc_watch_retire: logic = sc_watch_valid_q && rob_commit_ack && rob_commit_idx == sc_watch_rob_q;
    // ============================================================
    // P9.3: AMO watch — the in-cache RMW atomicity backstop (sc_watch
    // shape). The AMO read captured its value from an OWNED (E/M) line; if
    // that line departs the L1 before the commit write (remote RFO recall,
    // own eviction, …), the captured value may be stale — POISON the AMO,
    // suppress its store at commit and replay from its own PC. The
    // re-executed AMO re-acquires ownership and re-reads. If the watch is
    // clean at commit, ownership was held continuously ⇒ the RMW is atomic.
    // ============================================================
    let issue_is_realamo: logic = issue_is_amo && !issue_is_lr && !issue_is_sc;
    let amo_exec_capture: logic = issue_is_realamo && iq_issue_ack;
    let amo_remote_hit  : logic = amo_watch_valid_q && ((i_dcache_inv_valid && i_dcache_inv_addr[63:6] == amo_watch_pa_q[63:6])
        || (i_dcache_inv2_valid && i_dcache_inv2_addr[63:6] == amo_watch_pa_q[63:6]) || !dc_amo_present);
    // Poisoned watched AMO at the head -> replay (re-acquire + re-read).
    // commit_amo_replay is defined up near commit_load_replay (so it can gate
    // rob_commit_ack); it is exactly "watched AMO at the ROB head && poisoned".
    // P9.3: the watch CLEARS only on the AMO's actual RETIRE (rob_commit_ack),
    // NOT on mere head arrival. With the at-head AMO-issue restriction the
    // read executes WHILE the AMO is the head, so a rob_commit_valid clear
    // would wipe the watch the cycle after it arms — before the commit write
    // completes — leaving the RMW unprotected if the line departs while the
    // store stalls at the head (observed: N=2 boot per-cpu amoadd.d wedge,
    // dcache_stall stuck, watch already cleared, no poison/replay). An
    // ack-based clear keeps the watch live across the whole stall window.
    let amo_watch_retire : logic = amo_watch_valid_q && rob_commit_ack && rob_commit_idx == amo_watch_rob_q;
    // Phase 8 S1: slot-0 (head) triggers a redirect this cycle? If so the head+1
    // op is wrong-path (will be squashed) and must NOT retire in slot-1. Mirrors
    // every arm of the commit redirect always_ff.
    let commit_redirect: logic = commit_trap || commit_mret || commit_sret || c_bp_mispredict || commit_sc_replay || commit_amo_replay || commit_load_replay || commit_csrw_satp || commit_fence_i_pulse;
    // Slot-1 retires only when slot-0 actually retires (rob_commit_ack), slot-0
    // does not redirect, and head+1 is a simple integer op (c2_valid from ROB).
    // Phase 8 S8.E: suppress the 2-wide commit on an early-squash cycle. c2_valid is
    // computed from the PRE-squash sh_valid[head+1]; if the branch is at the head
    // (squash_age 0) then head+1 is YOUNGER and being squashed this cycle — committing
    // it would advance head by 2 while the squash rewinds tail to head+1, leaving
    // head > tail (catastrophic size wrap). Slot-0 (the branch / an older op) still
    // commits; the extra slot-1 commit just waits one cycle.
    assign commit2_fire = rob_commit_ack && !commit_redirect && c2_valid && !s8_restore_en;

    always_ff (clk, rst) {
        if_reset {
            sc_watch_valid_q = 1'b0;
            sc_watch_addr_q  = 64'd0;
            sc_watch_rob_q   = '0;
            sc_poison_q      = 1'b0;
        } else if redirect_fire_q {
            // Any flush (incl. this fix's own replay) clears the watch.
            sc_watch_valid_q = 1'b0;
            sc_poison_q      = 1'b0;
        } else if sc_exec_match {
            sc_watch_valid_q = 1'b1;
            // P9.3: track the PA — the reservation's PA is this SC's PA
            // (issue_addr_match ⇒ same VA ⇒ same translation; sfence/satp
            // in between are serializing and clear the reservation).
            sc_watch_addr_q = rsv_pa_q;
            sc_watch_rob_q  = iq_iss_rob_idx;
            // Same-cycle remote write to the new SC's line also poisons it.
            // P9.2: + 2nd inv port; + the line already absent at issue (the
            // presence-clear arm races this SC's issue — dc_rsv_present IS
            // the SC line's presence here, since issue_addr_match held).
            sc_poison_q = (i_dcache_inv_valid && i_dcache_inv_addr[63:6] == rsv_pa_q[63:6])
                || (i_dcache_inv2_valid && i_dcache_inv2_addr[63:6] == rsv_pa_q[63:6])
                || (rsv_present_seen_q && !dc_rsv_present);
        } else if sc_watch_retire {
            sc_watch_valid_q = 1'b0;
            sc_poison_q      = 1'b0;
        } else if sc_remote_hit {
            sc_poison_q = 1'b1;
        }
    }

    // P9.3: AMO watch state (see the commit_amo_replay block above).
    always_ff (clk, rst) {
        if_reset {
            amo_watch_valid_q = 1'b0;
            amo_watch_pa_q    = 64'd0;
            amo_watch_rob_q   = '0;
            amo_poison_q      = 1'b0;
        } else if redirect_fire_q {
            // Any flush (incl. this fix's own replay) clears the watch.
            amo_watch_valid_q = 1'b0;
            amo_poison_q      = 1'b0;
        } else if amo_exec_capture {
            amo_watch_valid_q = 1'b1;
            // The AMO read drives the dmem port this cycle — dmu_dmem_addr
            // is its translated PA (the L1/presence tracking is PIPT).
            amo_watch_pa_q  = dmu_dmem_addr;
            amo_watch_rob_q = iq_iss_rob_idx;
            // Same-cycle departure of the captured line poisons immediately
            // (the registered presence port still checks the OLD watch
            // address this cycle): both precise-inv ports + both dcache
            // line-departure event ports, line-granular on the PA.
            amo_poison_q = (i_dcache_inv_valid && i_dcache_inv_addr[63:6] == dmu_dmem_addr[63:6])
                || (i_dcache_inv2_valid && i_dcache_inv2_addr[63:6] == dmu_dmem_addr[63:6])
                || (dc_evict1_v && dc_evict1_addr[63:6] == dmu_dmem_addr[63:6])
                || (dc_evict2_v && dc_evict2_addr[63:6] == dmu_dmem_addr[63:6]);
        } else if amo_watch_retire {
            amo_watch_valid_q = 1'b0;
            amo_poison_q      = 1'b0;
        } else if amo_remote_hit {
            amo_poison_q = 1'b1;
        }
    }

    // STORE write fires at commit when the head entry is a store.
    // M6.B.4: suppress a faulted/FS-disabled FP store's memory write.
    // M9.4: suppress a poisoned SC's store (it is being replayed to fail).
    // P9.3: a poisoned AMO's store is suppressed the same way (replayed).
    let commit_store_fire: logic = rob_commit_valid && c_is_store && !c_illegal && !commit_priv_illegal && !commit_sc_replay && !commit_amo_replay;

    // funct3 → wstrb (size mask) shifted by byte offset (lo 3 bits)
    let st_byte_off : logic<3> = c_store_addr[2:0];
    let st_mask_base: logic<8> = if c_store_funct3 == 3'b000 ?
        8'b0000_0001 // SB
    : if c_store_funct3 == 3'b001 ?
        8'b0000_0011 // SH
    : if c_store_funct3 == 3'b010 ?
        8'b0000_1111 // SW
    : if c_store_funct3 == 3'b011 ?
        8'b1111_1111 // SD
    :
        8'b0000_0000
    ;
    // M8: misalign STORE that spans 2 dwords. Compute 16-byte wstrb /
    // 128-bit wdata then split into lo/hi pieces. Hi pieces go to the
    // next-dword write via o_dmem_wstrb_hi / o_dmem_wdata_hi.
    let st_mask_ext : logic<16>  = ({8'd0, st_mask_base} as 16) << st_byte_off;
    let st_wdata_ext: logic<128> = ({64'd0, c_store_data} as 128) << ({4'd0, st_byte_off, 3'b000} as 7);
    let st_wstrb    : logic<8>   = st_mask_ext[7:0];
    // P10 cbo.zero acts on the whole line (offset irrelevant) — force the
    // misalign hi-strobe to 0 so it classifies as an SB-eligible line store.
    let st_wstrb_hi : logic<8>   = if c_is_cbo_zero ? 8'd0 : st_mask_ext[15:8];
    let st_wdata    : logic<64>  = st_wdata_ext[63:0];
    let st_wdata_hi : logic<64>  = st_wdata_ext[127:64];

    // Phase 8 S6: route a committing BARE-mode aligned PLAIN store to the
    // separate dcache store-drain port (i_saddr/i_swen). Excludes AMO/LR/SC
    // (c_is_amo — RMW on the combined port, SMP-critical) and misaligned
    // straddling stores (st_wstrb_hi != 0 — the hi-dword bypass path).
    // Phase 8 S20: also excludes non-DRAM (MMIO) targets — fast stores now
    // retire through the store BUFFER, and only DRAM lines are buffered; a
    // bare MMIO store falls back to the blocking i_wen path (its pre-S6 route).
    // P9.2 (write-back D$): the tohost pages (PA 0x8000_0xxx..0x8000_3xxx —
    // riscv-tests place tohost after .text, so it lands at 0x1000/0x2000/
    // 0x3000 depending on the test's size; litmus uses 0x1000 — and PA
    // 0x8000_8xxx for the benchmarks) are excluded: the harnesses watch the
    // DRAM array, and a buffered store would merge into an owned L1 line
    // without ever reaching it. Those stores keep the write-through i_wen
    // path (correct everywhere, just slower; in the Linux boot this window
    // is OpenSBI text/data, which writes it rarely).
    let st_tohost_page: logic = (c_store_addr[31:14] == 18'h20000) || (c_store_addr[31:12] == 20'h80008);
    // P10 cbo.zero is exempt from the tohost-page exclusion: it is a full-line
    // write (no partial merge that could hide from the harness), and the harness
    // only watches the tohost word — so it may buffer like any DRAM line store.
    // Phase 11-H: an HSV store (c_is_mem_virt) is translated (VA != PA) and must
    // never take the fast (bare-PA) path. Use c_is_mem_virt directly — NOT
    // dmem_vm_on_op — so fast_store→store_drive→dmem_op_hlv stays loop-free.
    assign fast_store = commit_store_fire && !c_is_amo && !dmem_vm_on && !c_is_mem_virt && st_wstrb_hi == 8'd0
        && c_store_addr[63:25] == 39'h40 && (!st_tohost_page || c_is_cbo_zero);

    // Core dmem view (pre-MMU virtual address)
    //
    // M9.A.303: a STORE committing at the ROB head must NOT hijack the dmem
    // MMU port while a younger LOAD's page-table walk is in flight. The store's
    // *retire* is already stalled by rob_commit_ack (it cannot leave the ROB
    // while dmem_mmu_busy), but commit_store_fire still drove core_dmem_vaddr /
    // core_dmem_wen, flipping the MMU's i_vaddr to the store VA and i_store=1
    // mid-walk. That (a) broke walk_va_match so the load's DONE result was
    // suppressed (busy held), and (b) re-evaluated the load's PTE as a STORE
    // permission check (ptw_rwx_ok=pte_w, leaf_valid wants the D bit), which
    // spuriously faults a valid read-only / clean kernel load — observed as the
    // Linux boot load-fault loop at PC 0x800b84a4 / VA 0x80616198 (~5438-cy
    // period). Hold the load's *latched* VA (walk_vaddr_q) and suppress the
    // store drive for the whole load walk. walk_v_q / walk_is_store_q are
    // registers, so this introduces no combinational path into the MMU's
    // busy/req. v1 (in-order, single MEM stage) cannot hit this: a store and a
    // load never co-drive the MMU in the same cycle.
    let load_walk_busy : logic     = walk_v_q && !walk_is_store_q;
    // Phase 8 S6: a fast store drains via the i_saddr port, NOT the i_wen path,
    // so exclude it from store_drive. This also drops load_blocks_on_store for
    // the fast-store cycle (= issue_is_load && store_drive), letting the load
    // read coexist with the store write on the separate ports.
    let store_drive    : logic     = commit_store_fire && !load_walk_busy && !fast_store;
    // M9.3: a load walk PHYSICALLY owns the dmem port only while the MMU FSM is
    // NOT idle (LEVEL/DONE/FAULT). walk_v_q is a registered owner tag that, under
    // hart1's SMP bus-contention back-to-back walks, stays set CONTINUOUSLY across
    // walks (busy never drops between them, so the `walk_v_q && !dmem_mmu_busy`
    // clear below never fires) — leaving a STALE window where walk_v_q=1 but the
    // MMU is already back in IDLE about to start the NEXT walk. In that window the
    // old `load_walk_busy ? walk_vaddr_q` pin forced the freshly-issuing load
    // (incl. a squash-reused walk_rob_q "owner" that load_walk_block lets through)
    // to inherit the PREVIOUS walk's VA. When the previous walk was a wrong-path
    // VA~0 load, the new VALID load then walked VA~0, faulted at the root PTE, and
    // lfault_inj delivered stval=0 to it (walk_rob_q==itself, walk_v_q=1) — a
    // spurious load page fault => the N=2 trap storm. Gate the pin (and the ren
    // term) on a real in-flight walk so the fresh load drives its OWN agu_addr_iss
    // and the walk_vaddr_q re-latch at dmem_walk_start captures the correct VA.
    // dmem_mmu_idle is the MMU's `state` register (== IDLE), combinationally
    // independent of i_vaddr/core_dmem_vaddr, so no combinational loop is formed.
    let mmu_walk_inflight: logic   = load_walk_busy && !dmem_mmu_idle;
    let core_dmem_vaddr: logic<64> = if store_drive ? c_store_addr : if mmu_walk_inflight ? walk_vaddr_q : agu_addr_iss;
    let core_dmem_wdata: logic<64> = st_wdata;
    let core_dmem_wen  : logic     = store_drive;
    // M9.A.316: do NOT let a speculative LOAD request the dmem MMU on a
    // redirect cycle. The IQ flush is registered, so on the redirect cycle the
    // IQ still holds wrong-path ops and the issue logic can select one; if that
    // op is a LOAD with a TLB-missing address it starts a PTW walk THIS cycle.
    // The walk_v_q latch gives dmem_walk_start priority over redirect_fire_q
    // (M9.A.312), so the SQUASHED load gets latched as the walk owner; after the
    // redirect the epilogue reuses that rob index, and the wrong-path walk's
    // fault is injected into the now-valid reused entry (load_walk_busy also
    // pins core_dmem_vaddr to the walk VA, keeping walk_va_match=1 so M9.A.313's
    // gate cannot suppress it). Seen as a spurious LOAD page fault at VA 0x30
    // (a `c.lw 48(a0)` with a0=0 on the not-taken side of `beq a0,x0,...`
    // @0x8003ac78) mis-attributed to the epilogue `c.ldsp s0,160(sp)` @0x8003aad4
    // -> "kernel access to user memory ... VA 0x30" init Oops. Gate the LOAD
    // request on !redirect_fire (mirrors imem_mmu's `i_req: !redirect_fire`);
    // no walk starts this cycle, the wrong-path load is flushed, and the walk
    // owner is never a squashed op. load_walk_busy (an already-in-flight walk)
    // is preserved; stores commit in-order (never speculative) so are unaffected.
    // Phase 8 S5.1: suppress the LOAD read request while a STORE drives its
    // commit write (store_drive) — the dcache port + address are the store's this
    // cycle, so a concurrent ren would be a conflicting request that wedges
    // dcache_stall. The load is held in the IQ (iq_issue_ack gated by
    // load_blocks_on_store) and re-issues once the store commits.
    // Phase 8 S6: an AMO/LR read does NOT participate in store-to-load forwarding
    // (stld_fwd_en excludes is_amo), so it must not read the dcache while an older
    // FAST store is committing — the store-drain write only lands at the clock
    // edge, so a same-cycle AMO read would see STALE data and compute the wrong
    // RMW (the rv64ua subtest-5 failures). Plain loads DO forward, so they may
    // coexist with the fast store. The AMO read is held in the IQ until the older
    // fast store commits (its data is then in the dcache). issue_amo_read covers
    // AMO + LR (not SC, which is a store).
    // Phase 8 S20: the buffer does NOT forward — a load whose dword span may
    // overlap a buffered (committed, not yet drained) store is simply HELD in
    // the IQ until the buffer drains those bytes into the dcache (a few
    // cycles). The compare is on the load's translated address (dmu_dmem_addr
    // — only meaningful on a load-driving cycle, and the other arms block the
    // non-load-driving cycles anyway), conservatively covering dword and
    // dword+1 (misaligned spans). AMO/LR reads (no forward network at all)
    // wait for the buffer to be fully empty, including a same-cycle push.
    // The AMO arm uses commit_store_fire (not sb_push — that reaches through
    // the MMU's translated address and would close a comb loop into
    // core_dmem_ren): an AMO/LR read waits out ANY retiring store, which
    // covers the same-cycle buffer push.
    // S20.2 (N4 +13% fix): a full !sb_empty wait for EVERY AMO convoyed the
    // 4-hart lock traffic — an acquiring hart's AMO waited out its own drain
    // (bus-grant bound) on every lock op. RVWMO only requires prior-store
    // visibility for a RELEASE (rl, instr[25]); a plain/acquire AMO needs
    // just its own RMW bytes to be drained, which sb_ld_ovl already enforces
    // (issue_is_load includes AMO reads, compared on the AGU page offset).
    // Linux's unlock is fence+store (the FENCE gate drains), so rl AMOs are
    // rare; LR carries its rl bit the same way.
    // S20.2 watermark back-pressure: pre-S20 a pending store suppressed the
    // whole load stream (store_drive arm) — an implicit but STRONG drain
    // priority. The buffer drops that coupling for its retire win, but at
    // N=4 contention-stretched fills then chain back-to-back and the drain
    // (IDLE-only) starves into a permanent sb_full retire stall. Restore the
    // old priority ONLY under pressure: at the high watermark, hold new
    // loads so the current fill is the last of the chain and the drain gets
    // its slots. At N=1 drains are fast and the watermark is rarely hit.
    // S24.2: the S20R conservative VM hold (issue_is_load && dmem_vm_on &&
    // !sb_empty, which held every VM load while ANY committed store was
    // buffered) is REMOVED. The "4th leak path" it masked was a Veryl-sim
    // comb-scheduling bug (a backward reader interleaved into the sb_ld_ovl
    // write group; fixed upstream in the simulator's stable_topo_sort), not
    // RTL: with the precise gates here plus the MSHR sb-overlap poison, both
    // the fixed native sim and a Verilator cross-check boot N1/N2/N4 Linux
    // with byte-identical commit streams (N2 -4.4% / N1 -1.5% cycles).
    // S27: a plain LOAD no longer blocks on a buffered-store overlap — the
    // sb forward layer (sbf*/sbg*, near the sb FIFO) supplies the pending
    // bytes on the data path instead. The overlap scan still gates:
    //  - an AMO/LR read (issue_amo_read): its RMW value must come from
    //    MEMORY after the drain (AMOs are excluded from the forward nets);
    //  - a VM load whose 8-byte window crosses a page boundary: the forward
    //    layer compares PHYSICAL addresses byte-by-byte as pa+p, which is
    //    wrong past a page edge — hold it the old way until the buffer
    //    empties (page-tail misaligned loads are vanishingly rare).
    let sb_ld_pg_edge: logic = agu_addr_iss[11:3] == 9'h1ff && agu_addr_iss[2:0] != 3'd0;
    assign load_blocks_on_store = (issue_is_load && store_drive) || (issue_amo_read && sb_ld_ovl)
        || (issue_is_load && !issue_amo_read && dmem_vm_on && sb_ld_pg_edge && !sb_empty)
        || (issue_is_load && sb_cnt >= 4'd3)
        || (issue_amo_read && (commit_store_fire || (!sb_empty && iq_issue_op.base.instr[25])))
        // P9.3: an AMO/LR read must NOT issue while a younger load's PTW walk
        // owns the dmem port (mmu_walk_inflight) — the dcache i_addr is the
        // walk's VA then, so dc_amo_read is 0 (no ownership enforcement) and
        // the AMO would capture the WALK's read instead of upgrading its own
        // S line to E. With force-miss gone (P9.3), an owned-line hit serves
        // instantly and exposed this: the AMO armed its watch on a stale S
        // line, then its commit write wedged (needs E/M) with no poison
        // (the line is present). Hold the read until the walk drains.
        || (issue_amo_read && mmu_walk_inflight);
    // Phase 8 S10.5: !replay_q — no NEW dmem-MMU request while a queued-MSHR
    // replay drives the dcache port. Without this, a TLB-missing load selected
    // on slot-0 starts a PTW walk on a replay cycle (walk_v_q is not set yet,
    // so replay_drive does not defer): the walk's first PTE read goes out with
    // the dcache i_addr OVERRIDDEN to the replay's PA, and on a replay HIT
    // i_dcache_stall=0 lets the MMU consume the replay load's DATA as a PTE —
    // a corrupted translation (observed as a wild jump into the _etext/
    // .init.text padding hole, N=2 trap-loop timeout). An already-in-flight
    // walk (mmu_walk_inflight) still owns the port; replay defers to it.
    // S20R: the decoupled-walk arm BYPASSES load_blocks_on_store (the IQ may
    // have moved to a different op mid-walk, so sb_ld_ovl scans the wrong
    // address) — a store committed into the buffer DURING the walk made the
    // post-walk data read return the pre-store value (the N=2 ra=0 oops).
    // While a buffered store overlaps the walked VA's dwords, drop the
    // walk arm's i_ren: the PTE reads ride the MMU's own ptw_req term (not
    // i_ren), so the walk still completes and fills the TLB; busy then
    // drops, the walk owner clears, and the load re-issues through the
    // normal slot-0 path whose gates scan the RIGHT address. The compare
    // uses only registers (walk_vaddr_q, sb state) — no comb loop.
    var sb_walk_ovl: logic;
    let sb_wk_dw0  : logic<9> = walk_vaddr_q[11:3];
    let sb_wk_dw1  : logic<9> = walk_vaddr_q[11:3] + 9'd1;
    always_comb {
        sb_walk_ovl = 1'b0;
        for i in 0..SB_N {
            if (i as 4) <: sb_cnt {
                if sb_line[i][5:0] == sb_wk_dw0[8:3] && sb_lmap[i][sb_wk_dw0[2:0]] {
                    sb_walk_ovl = 1'b1;
                }
                if sb_line[i][5:0] == sb_wk_dw1[8:3] && sb_lmap[i][sb_wk_dw1[2:0]] {
                    sb_walk_ovl = 1'b1;
                }
            }
        }
    }
    let core_dmem_ren  : logic    = (issue_is_load && !redirect_fire && !store_drive && !load_blocks_on_store && !replay_q) || (mmu_walk_inflight && !sb_walk_ovl);
    let core_dmem_wstrb: logic<8> = if store_drive ? st_wstrb : 8'd0;
    // P9.3: mark the AMO/LR data read so the dcache serves it only from an
    // OWNED (E/M) line — an S hit or a miss raises an RFO fill first (the
    // in-cache RMW: the commit write then merges locally; a departure in
    // between poisons the AMO watch for a commit replay). Excludes the
    // PTE-walk read (mmu_walk_inflight drives core_dmem_ren for the walk,
    // not the AMO) and redirect/flush cycles. SC is not an issue_amo_read.
    // Phase 8 S6: also suppress while the AMO read is held behind a
    // committing fast store (load_blocks_on_store) so it does not read
    // stale data on a line the fast store is writing.
    let dc_amo_read    : logic    = issue_amo_read && !mmu_walk_inflight && !redirect_fire && !load_blocks_on_store;

    // ============================================================
    // M9.A.294 (F2): load-fault attribution fix.
    //
    // Root cause: dmem_mmu drops o_busy the cycle ptw_fault asserts, so a
    // multi-cycle-walk LOAD that faults is de-selected and a younger op
    // issues on the o_fault cycle. alu_wrap tags o_cdb.is_lfault with the
    // CURRENT issue's rob_idx → the fault is mis-attributed to a
    // correct-path op that then commits (spurious load page fault).
    //
    // Fix: latch the walk owner {rob_idx, vaddr} when a LOAD's walk goes
    // busy, and on o_fault deliver the fault to the owner's ROB entry via
    // the rob inject port — independent of the current-issue CDB result.
    // Also suppress the (wrong) is_lfault the CDB would write to the
    // current issue when it is not the walk owner. All registered / ROB
    // writes — never feeds back into issue select, so no comb loop (issue
    // select must NOT depend on any MMU output).
    //
    // Latch: a LOAD read driving a busy walk. Bare mode keeps busy=0 so
    // this never engages.
    //
    // M9.A.296: bind the owner to each ACTUAL PTW start (dmem_walk_start =
    // mmu tlb_miss_start, pulses at every IDLE→walk). The old !walk_v_q-gated
    // latch went STALE across back-to-back walks (busy stays continuous, so
    // walk_v_q never cleared): a wrong-path wild load starting a 2nd walk that
    // faulted got mis-attributed to the 1st walk's correct-path owner. Re-
    // latching on dmem_walk_start captures the requesting load (iq_iss_rob_idx
    // / core_dmem_vaddr) for EACH walk, so the faulting walk's fault is
    // attributed to ITS load (and squashed if wrong-path).
    always_ff (clk, rst) {
        if_reset {
            walk_v_q        = 1'b0;
            walk_rob_q      = 5'd0;
            walk_vaddr_q    = 64'd0;
            walk_is_store_q = 1'b0;
            walk_pc_q       = 64'd0;
            walk_hlv_q      = 1'b0;
            walk_hlvx_q     = 1'b0;
        } else if early_redir_fire_q {
            // Phase 8 S8.E: an early redirect's PARTIAL squash rewinds tail to
            // branch_idx+1, so the squashed wrong-path rob_idx is REUSED by the
            // correct-path op on the very next allocation. Unlike the commit full-
            // flush (M9.A.312, where the latched squashed owner is harmless because
            // the empty ROB refills from idx 0), here we must take PRIORITY over
            // dmem_walk_start and clear the owner — even for a walk starting THIS
            // cycle (the wrong-path load that mispredicted-down the fall-through).
            // Otherwise its later PTW fault is injected (lfault_inj_v) into the reused
            // idx = a valid correct-path load → spurious page fault (the BUG5 boot
            // livelock: a fall-through wrong-path load @0x8001b288 walked a garbage VA
            // 0xfffffffffffc.. whose fault landed on the jump-target load @0x8001b8da).
            // The walk becomes an orphan (walk_phys_q=1, walk_v_q=0); its fault drops.
            walk_v_q = 1'b0;
        } else if dmem_walk_start {
            // M9.A.312: dmem_walk_start MUST take priority over redirect_fire_q.
            // When both coincide, a NEW PTW walk is starting THIS cycle (the MMU
            // already latched its VA), so its owner must be captured — even if a
            // redirect fires the same cycle (the starting load is then a
            // wrong-path op being squashed; latching it as the owner sends the
            // walk's eventual fault to the SQUASHED op, where it is harmless,
            // instead of leaking via the !walk_v_q path to a younger VALID load).
            // Bug: a wrong-path NULL load (VA=0) started a walk on a redirect
            // cycle; the old redirect-first order left walk_v_q=0, so the VA=0
            // walk's leaf fault was mis-attributed to a valid kernel load
            // (spurious page fault at VA 0x80616198, ~34663-cy Oops loop).
            walk_v_q     = 1'b1;
            walk_rob_q   = iq_iss_rob_idx;
            walk_vaddr_q = core_dmem_vaddr;
            // M9.3 inject-linkage probe: PC of the load that starts this walk.
            walk_pc_q    = iq_issue_op.base.pc;
            // Phase 11-H: latch the walk's HLV/HLVX flags so the two-stage walk
            // keeps i_virt/i_priv/i_hlvx stable after the issuing IQ slot is gated
            // off. A store walk (commit_store_fire) takes its flag from the ROB
            // head (c_is_mem_virt); a load walk from the issuing op. HLVX is
            // load-only, so a store walk latches 0.
            walk_hlv_q   = if commit_store_fire ? c_is_mem_virt : iq_issue_op.base.hlv;
            walk_hlvx_q  = if commit_store_fire ? 1'b0 : iq_issue_op.base.hlvx;
            // M9.A.299: a walk driven by a commit-store is a STORE walk. Its
            // fault is delivered via commit_store_sfault (commit-time), NOT the
            // load inject port — and walk_rob_q (= issue idx) is meaningless for
            // it (the IQ is gated off during dmem_mmu_busy). Record store-ness so
            // lfault_inj_v below does not inject a SPURIOUS load fault into that
            // stale rob_idx when the store walk faults.
            walk_is_store_q = commit_store_fire;
        } else if redirect_fire_q {
            walk_v_q = 1'b0;
        } else if walk_v_q && !dmem_mmu_busy {
            // Walk resolved (success or fault). Owner cleared; if it was a
            // fault, lfault_inj_v delivered it this same cycle.
            walk_v_q = 1'b0;
        }
    }
    // M9.3 SMP: track the PHYSICAL walk in the dmem_mmu independently of the
    // owner. Unlike walk_v_q this does NOT clear on a redirect, only when the
    // walk actually finishes (busy drops / faults). So walk_phys_q && !walk_v_q
    // marks a walk whose owner was squashed mid-flight = an ORPHAN walk.
    always_ff (clk, rst) {
        if_reset {
            walk_phys_q = 1'b0;
        } else if dmem_walk_start {
            walk_phys_q = 1'b1;
        } else if walk_phys_q && !dmem_mmu_busy {
            walk_phys_q = 1'b0;
        }
    }
    // An orphan-walk fault: a physical walk is faulting but its owner is gone
    // (walk_v_q cleared by an intervening redirect). Its VA belongs to a
    // squashed wrong-path load, so the fault is spurious and must be dropped.
    let orphan_walk_fault: logic = dmem_mmu_fault && walk_phys_q && !walk_v_q;

    // Phase 11-H HLV/HLVX/HSV: the per-op two-stage flag of the op currently
    // driving the dmem port, mirroring the core_dmem_vaddr priority (store_drive >
    // mmu_walk_inflight > issuing load). A committing HSV store reads c_is_mem_virt
    // (held by store_drive); a walk reads the latched walk_hlv_q (covers load AND
    // store walks); the issuing-load cycle reads iq_issue_op.base.hlv. Loop-free
    // because dmem_vm_on no longer includes dmem_op_hlv, so store_drive (→
    // fast_store → dmem_vm_on) does not feed back here. 0 unless an HLV/HSV drives
    // the port, so every ordinary V=0 access is byte-identical.
    assign dmem_op_hlv = if store_drive ?
        c_is_mem_virt
    : if mmu_walk_inflight ?
        walk_hlv_q
    :
        iq_issue_op.base.hlv
    ;
    // HLVX is load-only (stores never check X). Latched walk_hlvx_q across a load
    // walk; iq_issue_op.base.hlvx on the issuing cycle; a store is never HLVX.
    assign dmem_op_hlvx = if store_drive ?
        1'b0
    : if mmu_walk_inflight ?
        walk_hlvx_q
    :
        iq_issue_op.base.hlvx
    ;
    // Deliver the load fault to the walk owner when a LOAD walk faults. Store
    // walk faults (walk_is_store_q) are handled at commit (commit_store_sfault).
    assign lfault_inj_v = dmem_mmu_fault && walk_v_q && !walk_is_store_q;
    // Suppress the CDB's is_lfault when it would mis-attribute the owner's
    // fault to a different (current-issue) rob_idx. If the current issue IS
    // the owner, or there is no tracked walk (e.g. a direct TLB-permission
    // fault on the current issue), the CDB tag stands.
    // NOTE (M9.3): orphan_walk_fault is kept as a DEBUG-ONLY observable. The
    // N=2 storm does NOT leak via this CDB path (orphan suppression had no
    // effect); it leaks via the lfault_inj ROB-inject port with walk_v_q=1 and
    // a STALE walk_vaddr_q (back-to-back-walk VA inheritance). So we leave the
    // committed behaviour at baseline here.
    assign rob_cdb_is_lfault = cdb.is_lfault && (!walk_v_q || cdb.rob_idx == walk_rob_q);

    // ============================================================
    // M9.3 inject→commit linkage probe (debug-only). Captures the FIRST
    // committed load page-fault whose stval (fault_vaddr) is a GARBAGE VA
    // (< 0x1000 — no real kernel/user VA is that low during secondary
    // bringup). This is the trap that deadlocks hart1's secondary. We record:
    //   dlk_inj     — was the committed fault delivered via the lfault inject
    //                 port (vs a direct CDB permission fault on the op itself)?
    //   dlk_genuine — does the committing op's PC equal the walk-start PC that
    //                 the inject recorded? equal ⇒ the op that STARTED the
    //                 garbage-VA walk is itself the trapping op (a genuine load
    //                 with a garbage base register → value/control bug);
    //                 different ⇒ the fault was injected into a reused/innocent
    //                 entry (mis-attribution → a fault-inject GATE is the fix).
    // All reads are commit-stage signals; the writes touch only debug regs, so
    // no path feeds back into issue/select (comb-loop-free).
    var dlk_seen_q   : logic    ;
    var dlk_genuine_q: logic    ;
    var dlk_inj_q    : logic    ;
    var dlk_stval_q  : logic<64>;
    var dlk_pc_q     : logic<64>;
    var dlk_walkpc_q : logic<64>;
    let commit_lfault_garbage: logic = rob_commit_valid && c_is_lfault && c_fault_vaddr <: 64'h1000;
    always_ff (clk, rst) {
        if_reset {
            dlk_seen_q    = 1'b0;
            dlk_genuine_q = 1'b0;
            dlk_inj_q     = 1'b0;
            dlk_stval_q   = 64'd0;
            dlk_pc_q      = 64'd0;
            dlk_walkpc_q  = 64'd0;
        } else if commit_lfault_garbage && !dlk_seen_q {
            dlk_seen_q    = 1'b1;
            dlk_inj_q     = commit_dbg_inj;
            dlk_genuine_q = commit_dbg_inj && (commit_dbg_walk_pc == c_pc);
            dlk_stval_q   = c_fault_vaddr;
            dlk_pc_q      = c_pc;
            dlk_walkpc_q  = commit_dbg_walk_pc;
        }
    }

    // ============================================================
    // M5.C: dmem_mmu wrapper. Bare mode (M-mode or satp.MODE=0) is
    // pure passthrough; o_busy stays 0 and o_dmem_addr == i_vaddr.
    // PTW shared with imem in M5.D.
    // ============================================================
    var dmem_mmu_rdata: logic<64>;
    // dmem_mmu_busy / dmem_mmu_fault / dmem_mmu_fault_s declared up front
    // for forward use by iq_int gate and alu_wrap fault inputs.
    var dmem_mmu_rdv: logic;
    // Internal dmem signals from dmem_mmu, muxed below with imem PTW.
    // (dmu_dmem_addr is declared up near the presence-check vars — the
    // P9.3 rsv/AMO-watch PA latches read it from earlier always_ff blocks.)
    var dmu_dmem_wdata: logic<64>;
    var dmu_dmem_wen  : logic    ;
    var dmu_dmem_ren  : logic    ;
    var dmu_dmem_wstrb: logic<8> ;

    // ============================================================
    // Phase 8 S20: committed-store buffer (declarations up front near
    // fast_store; design note at rob_commit_ack).
    // ============================================================
    // VM arm of the classifier: a committing aligned plain store whose
    // translation is ready THIS cycle (TLB hit: store_drive presents the VA
    // to dmem_mmu and o_busy is low) and whose PA is in DRAM. A TLB-missing
    // store stays a slow store — its walk runs via the normal commit path,
    // the PTE gets cached, and the retry cycle lands here.
    // Phase 11-H: dmem_vm_on_op folds an HSV store into the VM store-buffer path
    // (translated PA = dmu_dmem_addr).
    assign sb_vm_ok = commit_store_fire && !c_is_amo && dmem_vm_on_op && st_wstrb_hi == 8'd0
        && !load_walk_busy && !dmem_mmu_busy && !dmem_mmu_fault && dmu_dmem_addr[63:25] == 39'h40
        && !((dmu_dmem_addr[31:14] == 18'h20000) || (dmu_dmem_addr[31:12] == 20'h80008)); // P9.2: tohost pages stay write-through
    assign sb_elig = fast_store || sb_vm_ok;
    assign c_store_mmio = ((if dmem_vm_on_op ? dmu_dmem_addr[63:25] : c_store_addr[63:25]) != 39'h40)
        || (dmem_vm_on_op && dmu_pbmt_unc); // P10 Svpbmt: NC/IO store is uncached
    assign sb_pa   = if dmem_vm_on_op ? dmu_dmem_addr : c_store_addr;
    // S25 drain: the HEAD entry leaves as ONE line-wide transaction through
    // the dcache drain port (all 8 lanes + strobes); the ack pops the entry.
    let sb_pop: logic = dc_sdrain_ack;
    // S25: line-match the pushing store against live entries. The head entry
    // is not a merge target on its pop cycle (its lanes are leaving the
    // buffer this edge); the store allocates a fresh entry instead. A merging
    // store is accepted even when the buffer is FULL — no new entry needed.
    var sb_match_v  : logic   ;
    var sb_match_idx: logic<2>;
    always_comb {
        sb_match_v   = 1'b0;
        sb_match_idx = 2'd0;
        for i in 0..SB_N {
            if (i as 4) <: sb_cnt && sb_line[i] == sb_pa[63:6] {
                sb_match_v   = 1'b1;
                sb_match_idx = i as 2;
            }
        }
    }
    // P10 cbo.zero always allocates a fresh full-line entry (never merges into a
    // partial entry); in-order drain makes the younger zero entry win.
    assign sb_merge_ok = sb_match_v && !(sb_match_idx == 2'd0 && sb_pop) && !c_is_cbo_zero;
    assign sb_push     = sb_elig && (sb_merge_ok || !sb_full);
    let sb_alloc: logic = sb_push && !sb_merge_ok;
    // The issuing AMO/LR read's dword span vs the buffered entries (S27:
    // plain loads now FORWARD from the buffer instead — this scan only gates
    // AMO reads, whose RMW value must come from memory after the drain).
    // Compared by 4KB page offset ([11:3], translation-invariant — the S15
    // trick) on the AGU VA, NOT the translated PA: dmu_dmem_addr is
    // combinationally entangled with i_ren and this term feeds
    // core_dmem_ren (a PA compare closes a comb loop through the MMU). A
    // page-offset match is a superset of a true PA overlap, so a false
    // match only HOLDS the AMO a few cycles (the entry drains and it
    // re-issues).
    // dword+1 is checked only when the load actually spans into it
    // (byte offset + size > 8) — an unconditional +1 check doubled the
    // false-hold rate on adjacent-dword store/load pairs.
    let sb_ld_sz   : logic<4> = 4'd1 << iq_issue_op.base.mem_funct3[1:0];
    let sb_ld_spans: logic    = ({1'b0, agu_addr_iss[2:0]} + sb_ld_sz) >: 4'd8;
    let sb_ld_dw0  : logic<9> = agu_addr_iss[11:3];
    let sb_ld_dw1  : logic<9> = agu_addr_iss[11:3] + 9'd1;
    always_comb {
        sb_ld_ovl = 1'b0;
        for i in 0..SB_N {
            if (i as 4) <: sb_cnt {
                if sb_line[i][5:0] == sb_ld_dw0[8:3] && sb_lmap[i][sb_ld_dw0[2:0]] {
                    sb_ld_ovl = 1'b1;
                }
                if sb_ld_spans && sb_line[i][5:0] == sb_ld_dw1[8:3] && sb_lmap[i][sb_ld_dw1[2:0]] {
                    sb_ld_ovl = 1'b1;
                }
            }
        }
    }
    // The committing SLOW store's dword span vs the buffered entries (same
    // page-offset trick, on the pre-translation c_store_addr — loop-free).
    // dword+1 always checked (covers the misaligned hi-dword bypass).
    let sb_st_dw0: logic<9> = c_store_addr[11:3];
    let sb_st_dw1: logic<9> = c_store_addr[11:3] + 9'd1;
    always_comb {
        sb_st_ovl = 1'b0;
        for i in 0..SB_N {
            if (i as 4) <: sb_cnt {
                if sb_line[i][5:0] == sb_st_dw0[8:3] && sb_lmap[i][sb_st_dw0[2:0]] {
                    sb_st_ovl = 1'b1;
                }
                if sb_line[i][5:0] == sb_st_dw1[8:3] && sb_lmap[i][sb_st_dw1[2:0]] {
                    sb_st_ovl = 1'b1;
                }
            }
        }
    }
    // 4-line shift FIFO of committed stores (S25 write-combining), drained
    // oldest-first through the dcache store-drain port (i_saddr) whenever the
    // fill engine is idle and the bus grants. Entries are COMMITTED state —
    // never flushed by a redirect/trap.
    //
    // Merge helpers — all read PRE-EDGE register state; the FF block applies
    // them at the post-shift slot. sb_merge_ok excludes the head's POP cycle,
    // so a merge never targets an entry whose lanes are leaving this edge.
    let sb_mlane   : logic<3>  = sb_pa[5:3];
    let sb_midx_pre: logic<5>  = {sb_match_idx, sb_mlane};
    let sb_mold    : logic<64> = sb_data[sb_midx_pre];
    let sb_mnew    : logic<64> = {
        if st_wstrb[7] ? st_wdata[63:56] : sb_mold[63:56], if st_wstrb[6] ? st_wdata[55:48] : sb_mold[55:48],
        if st_wstrb[5] ? st_wdata[47:40] : sb_mold[47:40], if st_wstrb[4] ? st_wdata[39:32] : sb_mold[39:32],
        if st_wstrb[3] ? st_wdata[31:24] : sb_mold[31:24], if st_wstrb[2] ? st_wdata[23:16] : sb_mold[23:16],
        if st_wstrb[1] ? st_wdata[15:8] : sb_mold[15:8], if st_wstrb[0] ? st_wdata[7:0] : sb_mold[7:0]
    };
    let sb_mstrb: logic<8> = sb_strb[sb_midx_pre] | st_wstrb;
    let sb_mlmap: logic<8> = sb_lmap[sb_match_idx] | (8'd1 << sb_mlane);
    always_ff (clk, rst) {
        if_reset {
            sb_cnt = 4'd0;
            for i in 0..SB_N {
                sb_line[i] = 58'd0;
                sb_lmap[i] = 8'd0;
                for l in 0..8 {
                    sb_data[i * 8 + l] = 64'd0;
                    sb_strb[i * 8 + l] = 8'd0;
                }
            }
        } else {
            if sb_pop {
                for i in 0..3 {
                    sb_line[i] = sb_line[i + 1];
                    sb_lmap[i] = sb_lmap[i + 1];
                    for l in 0..8 {
                        sb_data[i * 8 + l] = sb_data[(i + 1) * 8 + l];
                        sb_strb[i * 8 + l] = sb_strb[(i + 1) * 8 + l];
                    }
                }
            }
            if sb_push {
                if sb_merge_ok {
                    let midx: logic<2> = sb_match_idx - (if sb_pop ? 2'd1 : 2'd0);
                    sb_data[{midx, sb_mlane}] = sb_mnew;
                    sb_strb[{midx, sb_mlane}] = sb_mstrb;
                    sb_lmap[midx]             = sb_mlmap;
                } else {
                    let widx: logic<4> = sb_cnt - (if sb_pop ? 4'd1 : 4'd0);
                    for i in 0..SB_N {
                        if widx == (i as 4) {
                            sb_line[i] = sb_pa[63:6];
                            if c_is_cbo_zero {
                                // P10 Zicboz: fill the whole 64B line with zero.
                                sb_lmap[i] = 8'hFF;
                                for l in 0..8 {
                                    sb_data[i * 8 + l] = 64'd0;
                                    sb_strb[i * 8 + l] = 8'hFF;
                                }
                            } else {
                                sb_lmap[i] = 8'd1 << sb_mlane;
                                for l in 0..8 {
                                    sb_strb[i * 8 + l] = 8'd0;
                                }
                                sb_data[{(i as 2), sb_mlane}] = st_wdata;
                                sb_strb[{(i as 2), sb_mlane}] = st_wstrb;
                            }
                        }
                    }
                }
            }
            sb_cnt = sb_cnt + (if sb_alloc ? 4'd1 : 4'd0) - (if sb_pop ? 4'd1 : 4'd0);
        }
    }
    // S25: head-entry lanes, wired to the dcache line-drain port.
    var sb_head_data: logic<64> [8];
    var sb_head_strb: logic<8>  [8];
    always_comb {
        for l in 0..8 {
            sb_head_data[l] = sb_data[l];
            sb_head_strb[l] = sb_strb[l];
        }
    }

    // ============================================================
    // S27: committed-store-buffer FORWARD layer. sb bytes are committed —
    // older than every ROB-resident store — so a ROB-forward byte (sf*/sg*)
    // wins per byte, an sb byte fills the rest, and the dcache supplies the
    // remainder (merged in alu_wrap). The compare uses the load's PHYSICAL
    // address (sb entries hold PAs): bare PA==VA; under VM the slot-0 load's
    // TLB-hit translation (dmu_dmem_addr) is combinational on the issue
    // cycle and feeds ONLY this data path (alu i_fwd), never the issue/ren
    // gates — no comb loop. On a TLB-miss cycle dmu_dmem_addr is
    // meaningless, but the load is not acked then (dmem_mmu_busy) and a
    // polluted mask only suppresses an MSHR capture (conservative). A store
    // committing THIS cycle (sb_push) is folded in LAST: it is the newest
    // committed writer of its bytes and may not be in the registered arrays
    // yet (the ROB net usually still covers it that cycle, but not a VM
    // alias — the ROB compares VAs, this layer compares PAs).
    // One always_comb per byte, mirroring the S5.1 ROB nets (fused
    // accumulators falsely trip the combinational_loop diagnostic).
    // ============================================================
    let sbf_pa: logic<64> = if dmem_vm_on_op ? dmu_dmem_addr : agu_addr_iss; // Phase 11-H: HLV load → translated PA
    var sbf0_v: logic; var sbf0_b: logic<8>;
    var sbf1_v: logic; var sbf1_b: logic<8>;
    var sbf2_v: logic; var sbf2_b: logic<8>;
    var sbf3_v: logic; var sbf3_b: logic<8>;
    var sbf4_v: logic; var sbf4_b: logic<8>;
    var sbf5_v: logic; var sbf5_b: logic<8>;
    var sbf6_v: logic; var sbf6_b: logic<8>;
    var sbf7_v: logic; var sbf7_b: logic<8>;
    always_comb {
        sbf0_v = 1'b0; sbf0_b = 8'd0;
        if stld_fwd_en {
            let ba: logic<64> = sbf_pa + 64'd0;
            for i in 0..SB_N {
                if (i as 4) <: sb_cnt && sb_line[i] == ba[63:6] && sb_strb[{(i as 2), ba[5:3]}][ba[2:0]] {
                    let d: logic<64> = sb_data[{(i as 2), ba[5:3]}] >> {ba[2:0], 3'b000};
                    sbf0_v = 1'b1; sbf0_b = d[7:0];
                }
            }
            if sb_push && sb_pa[63:3] == ba[63:3] && st_wstrb[ba[2:0]] {
                let d: logic<64> = st_wdata >> {ba[2:0], 3'b000};
                sbf0_v = 1'b1; sbf0_b = d[7:0];
            }
        }
    }
    always_comb {
        sbf1_v = 1'b0; sbf1_b = 8'd0;
        if stld_fwd_en {
            let ba: logic<64> = sbf_pa + 64'd1;
            for i in 0..SB_N {
                if (i as 4) <: sb_cnt && sb_line[i] == ba[63:6] && sb_strb[{(i as 2), ba[5:3]}][ba[2:0]] {
                    let d: logic<64> = sb_data[{(i as 2), ba[5:3]}] >> {ba[2:0], 3'b000};
                    sbf1_v = 1'b1; sbf1_b = d[7:0];
                }
            }
            if sb_push && sb_pa[63:3] == ba[63:3] && st_wstrb[ba[2:0]] {
                let d: logic<64> = st_wdata >> {ba[2:0], 3'b000};
                sbf1_v = 1'b1; sbf1_b = d[7:0];
            }
        }
    }
    always_comb {
        sbf2_v = 1'b0; sbf2_b = 8'd0;
        if stld_fwd_en {
            let ba: logic<64> = sbf_pa + 64'd2;
            for i in 0..SB_N {
                if (i as 4) <: sb_cnt && sb_line[i] == ba[63:6] && sb_strb[{(i as 2), ba[5:3]}][ba[2:0]] {
                    let d: logic<64> = sb_data[{(i as 2), ba[5:3]}] >> {ba[2:0], 3'b000};
                    sbf2_v = 1'b1; sbf2_b = d[7:0];
                }
            }
            if sb_push && sb_pa[63:3] == ba[63:3] && st_wstrb[ba[2:0]] {
                let d: logic<64> = st_wdata >> {ba[2:0], 3'b000};
                sbf2_v = 1'b1; sbf2_b = d[7:0];
            }
        }
    }
    always_comb {
        sbf3_v = 1'b0; sbf3_b = 8'd0;
        if stld_fwd_en {
            let ba: logic<64> = sbf_pa + 64'd3;
            for i in 0..SB_N {
                if (i as 4) <: sb_cnt && sb_line[i] == ba[63:6] && sb_strb[{(i as 2), ba[5:3]}][ba[2:0]] {
                    let d: logic<64> = sb_data[{(i as 2), ba[5:3]}] >> {ba[2:0], 3'b000};
                    sbf3_v = 1'b1; sbf3_b = d[7:0];
                }
            }
            if sb_push && sb_pa[63:3] == ba[63:3] && st_wstrb[ba[2:0]] {
                let d: logic<64> = st_wdata >> {ba[2:0], 3'b000};
                sbf3_v = 1'b1; sbf3_b = d[7:0];
            }
        }
    }
    always_comb {
        sbf4_v = 1'b0; sbf4_b = 8'd0;
        if stld_fwd_en {
            let ba: logic<64> = sbf_pa + 64'd4;
            for i in 0..SB_N {
                if (i as 4) <: sb_cnt && sb_line[i] == ba[63:6] && sb_strb[{(i as 2), ba[5:3]}][ba[2:0]] {
                    let d: logic<64> = sb_data[{(i as 2), ba[5:3]}] >> {ba[2:0], 3'b000};
                    sbf4_v = 1'b1; sbf4_b = d[7:0];
                }
            }
            if sb_push && sb_pa[63:3] == ba[63:3] && st_wstrb[ba[2:0]] {
                let d: logic<64> = st_wdata >> {ba[2:0], 3'b000};
                sbf4_v = 1'b1; sbf4_b = d[7:0];
            }
        }
    }
    always_comb {
        sbf5_v = 1'b0; sbf5_b = 8'd0;
        if stld_fwd_en {
            let ba: logic<64> = sbf_pa + 64'd5;
            for i in 0..SB_N {
                if (i as 4) <: sb_cnt && sb_line[i] == ba[63:6] && sb_strb[{(i as 2), ba[5:3]}][ba[2:0]] {
                    let d: logic<64> = sb_data[{(i as 2), ba[5:3]}] >> {ba[2:0], 3'b000};
                    sbf5_v = 1'b1; sbf5_b = d[7:0];
                }
            }
            if sb_push && sb_pa[63:3] == ba[63:3] && st_wstrb[ba[2:0]] {
                let d: logic<64> = st_wdata >> {ba[2:0], 3'b000};
                sbf5_v = 1'b1; sbf5_b = d[7:0];
            }
        }
    }
    always_comb {
        sbf6_v = 1'b0; sbf6_b = 8'd0;
        if stld_fwd_en {
            let ba: logic<64> = sbf_pa + 64'd6;
            for i in 0..SB_N {
                if (i as 4) <: sb_cnt && sb_line[i] == ba[63:6] && sb_strb[{(i as 2), ba[5:3]}][ba[2:0]] {
                    let d: logic<64> = sb_data[{(i as 2), ba[5:3]}] >> {ba[2:0], 3'b000};
                    sbf6_v = 1'b1; sbf6_b = d[7:0];
                }
            }
            if sb_push && sb_pa[63:3] == ba[63:3] && st_wstrb[ba[2:0]] {
                let d: logic<64> = st_wdata >> {ba[2:0], 3'b000};
                sbf6_v = 1'b1; sbf6_b = d[7:0];
            }
        }
    }
    always_comb {
        sbf7_v = 1'b0; sbf7_b = 8'd0;
        if stld_fwd_en {
            let ba: logic<64> = sbf_pa + 64'd7;
            for i in 0..SB_N {
                if (i as 4) <: sb_cnt && sb_line[i] == ba[63:6] && sb_strb[{(i as 2), ba[5:3]}][ba[2:0]] {
                    let d: logic<64> = sb_data[{(i as 2), ba[5:3]}] >> {ba[2:0], 3'b000};
                    sbf7_v = 1'b1; sbf7_b = d[7:0];
                }
            }
            if sb_push && sb_pa[63:3] == ba[63:3] && st_wstrb[ba[2:0]] {
                let d: logic<64> = st_wdata >> {ba[2:0], 3'b000};
                sbf7_v = 1'b1; sbf7_b = d[7:0];
            }
        }
    }
    assign stld_fwd_data = {
        if sf7_v ? sf7_b : sbf7_b, if sf6_v ? sf6_b : sbf6_b, if sf5_v ? sf5_b : sbf5_b,
        if sf4_v ? sf4_b : sbf4_b, if sf3_v ? sf3_b : sbf3_b, if sf2_v ? sf2_b : sbf2_b,
        if sf1_v ? sf1_b : sbf1_b, if sf0_v ? sf0_b : sbf0_b
