// Heliodor core: CPU pipeline + private icache/dcache + per-hart MMU.
// CLINT/PLIC/UART live in heliodor_top (the SoC layer). The core exports
// MMIO selects (clint/plic/uart) and consumes their rdata + interrupts via
// the i_*_rdata / i_*_irq ports below.
pub module heliodor_core #(
    param DEBUG   : bit = 1,
    param RESET_PC: u64 = 0,
    param HART_ID : u8  = 0, // multi-core: forwarded to mhartid CSR
) (
    clk: input clock,
    rst: input reset,
    // Instruction memory interface (read-only, 32-bit for icache fill)
    o_imem_addr : output logic<64>,
    i_imem_rdata: input  logic<32>,
    o_imem_ren  : output logic    ,
    // Instruction PTW memory interface (64-bit, for page table walks)
    o_iptw_addr : output logic<64>,
    o_iptw_req  : output logic    ,
    i_iptw_rdata: input  logic<64>,
    // Data memory interface (DRAM only — MMIO is split out via i_*_rdata)
    o_dmem_addr : output logic<64>,
    o_dmem_wdata: output logic<64>,
    i_dmem_rdata: input  logic<64>,
    o_dmem_wen  : output logic    ,
    o_dmem_ren  : output logic    ,
    o_dmem_wstrb: output logic<8> ,
    // Phase 5: dcache bus arbitration. The SoC's memory_bus arbiter takes
    // o_dmem_req from each hart and asserts i_dmem_grant for the granted
    // hart while a transaction is in flight (held for the full 8-cycle
    // FILL burst). With AMO inflight the grant is locked to that hart so
    // its read-modify-write window cannot be interleaved.
    o_dmem_req  : output logic    ,
    i_dmem_grant: input  logic    ,
    // MMIO peripheral interface (driven by the core's MMU output; the SoC
    // layer routes these to CLINT/PLIC/UART based on the *_sel signals).
    o_mmio_paddr: output logic<32>, // mmu_paddr[31:0] for peripheral decode
    o_mmio_wdata: output logic<64>,
    o_mmio_wstrb: output logic<8> ,
    o_mmio_wen  : output logic    ,
    o_mmio_ren  : output logic    ,
    o_stall_mem : output logic    , // gate writes/reads to peripherals
    o_clint_sel : output logic    ,
    o_plic_sel  : output logic    ,
    o_uart_sel  : output logic    ,
    i_clint_rdata: input logic<64>,
    i_plic_rdata : input logic<64>,
    i_uart_rdata : input logic<8> ,
    // Per-hart interrupt inputs from the SoC peripherals
    i_timer_irq : input logic    , // CLINT MTIP
    i_sw_irq    : input logic    , // CLINT MSIP
    i_plic_irq_m: input logic    , // PLIC MEIP
    i_plic_irq_s: input logic    , // PLIC SEIP
    i_mtime     : input logic<64>, // CLINT mtime (for TIME CSR)
    // dcache invalidate broadcast (driven by memory_bus when another hart
    // writes to a line that may be cached here)
    i_dcache_inv_valid: input logic    ,
    i_dcache_inv_addr : input logic<64>,
    // This hart's AMO inflight, exposed to the SoC for cross-hart bus
    // arbitration (Step C: protect AMO RMW window from remote invalidates
    // and remote-write store flushes).
    o_amo_inflight: output logic,
    // LR-SC reservation valid — used by the SoC to gate remote invalidates
    // so a long LR→retry→SC window is not flushed by every other-hart store.
    o_reserv_valid: output logic,
    // UART IRQ source (UART peripheral asserts when RX has data); core
    // forwards this to the SoC PLIC. Without this hop the UART would have
    // to be inside the core.
    o_uart_irq_req: output logic, // (currently unused — PLIC source mux is in SoC)
    // Debug port
    o_dbg_regs: output logic<64> [32],
    o_dbg_pc  : output logic<64>     ,
    o_dbg_pass: output logic         ,
    o_dbg_r1  : output logic<64>     ,
    o_dbg_r2  : output logic<64>     ,
    o_dbg_r3  : output logic<64>     ,
    // (UART/PLIC ext-IRQ ports moved to heliodor_top SoC layer)
    // Debug: internal stall signals
    o_dbg_stall: output logic<8>,
    // Debug: instruction retirement (high for one cycle per retired insn)
    o_dbg_instret: output logic,
    // Debug: branch prediction trace
    o_dbg_bp_predict: output logic    , // IF predicted taken
    o_dbg_bp_mispred: output logic    , // EX misprediction
    o_dbg_bp_taken  : output logic    , // EX actual taken
    o_dbg_bp_ex_pc  : output logic<64>, // EX stage PC (branch/jump PC)
    o_dbg_bp_target : output logic<64>, // EX actual target
    // Debug: trap trace
    o_dbg_trap_taken: output logic    ,
    o_dbg_trap_cause: output logic<64>,
    o_dbg_trap_pc   : output logic<64>, // mepc/sepc value
    // Debug: LQ-4.4-b observation
    o_dbg_lq_issue_cnt: output logic<32>, // cycles lq_issue_valid
    o_dbg_lq_alloc_cnt: output logic<32>, // total LQ allocs
    o_dbg_lq_mshr_cnt : output logic<32>, // MSHR-absorbed LQ allocs
    // Debug: SRS-2 observation
    o_dbg_srs_disp_cnt : output logic<32>, // SRS dispatches accepted
    o_dbg_srs_issue_cnt: output logic<32>, // cycles SRS issue fired
    o_dbg_srs_drop_cnt : output logic<32>, // dispatches dropped (SRS full)
    // Debug: P3.3-b SB forwarding shadow validation
    o_dbg_sb_fwd_hit_cnt     : output logic<32>, // cycles SB forward fully covered the load
    o_dbg_sb_fwd_partial_cnt : output logic<32>, // cycles SB partially aliased (must stall to dcache)
    o_dbg_sb_fwd_mismatch_cnt: output logic<32>, // SB masked data diverged from dcache (guarded away)
    // P3.4 speculation opportunity: cycles a direct-path load is drained
    // because an SRS entry has unresolved base (addr unknown). A load
    // that would otherwise pass the alias probe is conservatively held.
    o_dbg_srs_load_drain_unresolved_cnt: output logic<32>,
    // P3.4 detection: cycles the SRS wake event hit an LQ entry younger
    // than the store. With speculation disabled this stays 0 (no load
    // issues past an unresolved store). When speculation enables, this
    // counts cycles that would have triggered a replay.
    o_dbg_p34_spec_violation_cnt: output logic<32>,
    // F0: dual issue rate observation. dual_fetch_cnt = cycles where fetch
    // could pair slot0+slot1 (icache OK, same line, aligned, not control,
    // etc.); dual_issue_cnt = cycles where slot1 actually issued (subset).
    // Ratio shows how often dispatch-side gates (slot1_is_alu, intra_pair,
    // cross_pair_waw, s1_pipe_busy) block the otherwise-paired fetch.
    o_dbg_dual_fetch_cnt: output logic<32>,
    o_dbg_dual_issue_cnt: output logic<32>,
    // Debug: per-cause stall breakdown (active when stall_id fires)
    o_dbg_stall_cause_load_use: output logic,
    o_dbg_stall_cause_mmu     : output logic,
    o_dbg_stall_cause_cache   : output logic,
    o_dbg_stall_cause_rs      : output logic, // combined: all i_rs_stall causes
    o_dbg_stall_cause_rob_full: output logic,
    // Sub-breakdown of i_rs_stall (the 4 OR terms in heliodor_top)
    o_dbg_stall_cause_rs_full_int : output logic, // int RS full
    o_dbg_stall_cause_rs_full_fp  : output logic, // FP RS full
    o_dbg_stall_cause_direct_stall: output logic, // non-RS ID waiting for direct path
    o_dbg_stall_cause_irq_wait    : output logic, // pending IRQ, ROB non-empty
    // Sub-sub-breakdown of direct_stall (each a reason direct_path_v=0 for
    // a non-RS-eligible instruction in ID)
    o_dbg_stall_ds_operand : output logic, // int or FP RAW operand dep
    o_dbg_stall_ds_op_load : output logic, // subset: ds_operand on load
    o_dbg_stall_ds_op_store: output logic, // subset: ds_operand on store
    o_dbg_stall_ds_op_bj   : output logic, // subset: ds_operand on branch/jalr
    o_dbg_stall_ds_rs_yield: output logic, // RS took EX this cycle
    o_dbg_stall_ds_rob_full: output logic, // ROB full w/o entry
    o_dbg_stall_ds_drain   : output logic, // rob_drain_needed (ecall/ebreak/trap)
    // flush_id sub-cause breakdown
    o_dbg_mispred_branch: output logic, // cond branch mispredict (direction)
    o_dbg_mispred_jalr  : output logic, // JALR target mispredict
    o_dbg_mispred_jal   : output logic, // JAL mispredict (should be rare)
    o_dbg_flush_trap    : output logic, // flush due to trap/mret (not mispredict)
    // JALR mispredict split by return vs. indirect (function pointer / switch)
    o_dbg_mispred_jalr_return  : output logic,
    o_dbg_mispred_jalr_indirect: output logic,
    o_dbg_if_return_count      : output logic,
    o_dbg_ras_used             : output logic,
    o_dbg_ras_push             : output logic,
    o_dbg_ras_pop              : output logic,
) {
    // ============================================================
    // Inter-stage signal declarations (all declared before use)
    // ============================================================

    // Hazard unit outputs
    var stall_if : logic;
    var stall_id : logic;
    var stall_ex : logic;
    var stall_mem: logic;
    var flush_id : logic;
    var flush_ex : logic;
    var raw_load_use: logic; // raw load-use signal from hazard_unit
    var dbg_stall_load_use: logic;
    var dbg_stall_mmu     : logic;
    var dbg_stall_cache   : logic;
    var dbg_stall_rs      : logic;
    var dbg_stall_rob_full: logic;

    // RS (Reservation Station) signals
    var rs_dispatch_ready: logic    ;
    var rs_issue_valid   : logic    ;
    var rs_issue_pc      : logic<64>;
    var rs_issue_alu_op  : alu_pkg::AluOp;
    var rs_issue_src_a   : pipeline_pkg::AluSrcA;
    var rs_issue_src_b   : pipeline_pkg::AluSrcB;
    var rs_issue_imm     : logic<64>;
    var rs_issue_rd      : logic<5> ;
    var rs_issue_rs1     : logic<5> ;
    var rs_issue_rs2     : logic<5> ;
    var rs_issue_s1_data : logic<64>;
    var rs_issue_s2_data : logic<64>;
    var rs_issue_wen     : logic    ;
    var rs_issue_rob     : logic<5> ;
    var rs_issue_epoch   : logic<2> ;
    // RS-routed branch/JALR fields (slot0 only — slot1 is ALU-only)
    var rs_issue_is_branch     : logic    ;
    var rs_issue_is_jalr       : logic    ;
    var rs_issue_funct3        : logic<3> ;
    var rs_issue_predict_taken : logic    ;
    var rs_issue_predict_target: logic<64>;
    var rs_issue_is_compressed : logic    ;
    // RS secondary issue port (for dual-issue via slot1)
    var rs_issue2_valid   : logic    ;
    var rs_issue2_pc      : logic<64>;
    var rs_issue2_alu_op  : alu_pkg::AluOp;
    var rs_issue2_src_a   : pipeline_pkg::AluSrcA;
    var rs_issue2_src_b   : pipeline_pkg::AluSrcB;
    var rs_issue2_imm     : logic<64>;
    var rs_issue2_rd      : logic<5> ;
    var rs_issue2_rs1     : logic<5> ;
    var rs_issue2_rs2     : logic<5> ;
    var rs_issue2_s1_data : logic<64>;
    var rs_issue2_s2_data : logic<64>;
    var rs_issue2_wen     : logic    ;
    var rs_issue2_rob     : logic<5> ;
    var rs_issue2_epoch   : logic<2> ;
    // DIV async completion signals (from execute module)
    var ex_div_complete_valid  : logic    ;
    var ex_div_complete_data   : logic<64>;
    var ex_div_complete_rob_idx: logic<5> ;
    var ex_div_complete_epoch  : logic<2> ;
    // is_div pipeline flag
    var ex_is_div : logic;
    var mem_is_div: logic;
    // RS dispatched tracking (prevents double-dispatch when ID stalls)
    var rs_dispatched_q: logic;
    // P3.2 Stage 2: latch when a load was LQ-dispatched at ID — prevents
    // re-dispatching the same instruction on subsequent cycles while ID
    // still holds it (e.g. waiting for stall_ex to clear).
    var lq_id_dispatched_q: logic;
    // Direct-path dispatched tracking: set when a direct-path instruction
    // enters EX, cleared when ID advances / flushes. Prevents re-firing of
    // direct_path_v when ID stalls across multiple cycles — without this,
    // execute + memory re-process the same instruction each cycle, causing
    // AMO to re-read dcache (now holding its own post-write value) and
    // corrupt both wb_data and the final dcache state.
    var direct_path_dispatched_q: logic;

    // Direct-path operand capture: at the cycle the EX/MEM pipeline reg
    // latches a direct-path instruction (direct_path_v && !stall_ex), freeze
    // the final forwarded operand values. On subsequent re-fires (when the
    // instruction stays at ID after dispatch — e.g., redirect deferred by
    // stall_ex on a later cache miss), feed the frozen values back to
    // execute with fwd_a/fwd_b=NONE so the combinational re-evaluation is
    // stable against forwarding-source drift. Fixes the pmpaddr-class bug
    // where a branch's rs1 flips as producer ROB entries commit/release
    // across stall cycles.
    var direct_path_operand_captured_q: logic;
    var direct_path_rs1_q             : logic<64>;
    var direct_path_rs2_q             : logic<64>;

    // Execute's final forwarded operand debug outputs (promoted from
    // unused `_` to real wires so heliodor_top can capture them).
    var ex_dbg_fwd_rs1: logic<64>;
    var ex_dbg_fwd_rs2: logic<64>;
    // SRS (Store RS) observation signals — SRS-2: dispatch only; issue output
    // is not yet wired to the pipeline, so stores also proceed on direct path.
    var srs_dispatch_ready: logic    ;
    var srs_dispatched_q  : logic    ;
    var srs_issue_valid   : logic    ;
    var srs_count         : logic<3> ;
    var srs_full          : logic    ;
    var srs_empty         : logic    ;
    var srs_oldest_rob    : logic<5> ;
    // Bug-b: head candidate (comb, pre-FF) for alias probe
    var srs_cand_valid    : logic    ;
    var srs_cand_addr     : logic<64>;
    var srs_cand_rob      : logic<5> ;
    var srs_cand_epoch    : logic<2> ;
    var srs_cand_s1_ready : logic    ;
    var srs_cand_s1_tag   : logic<5> ;
    var srs_cand_s1_epoch : logic<2> ;
    var srs_cand_funct3   : logic<3> ;
    // SRS issue outputs (driven by the SRS, but currently i_issue_stall=1
    // pins them dead). Needed as var declarations for EX-mux scaffolding.
    var srs_issue_rob     : logic<5> ;
    var srs_issue_epoch   : logic<2> ;
    var srs_issue_pc      : logic<64>;
    var srs_issue_imm     : logic<64>;
    var srs_issue_funct3  : logic<3> ;
    var srs_issue_rs1     : logic<5> ;
    var srs_issue_rs2     : logic<5> ;
    var srs_issue_s1_data : logic<64>;
    var srs_issue_s2_data : logic<64>;
    // SRS-3 scaffolding: set when an SRS-issued store is in EX/MEM. Stays 0
    // in SRS-2 observational mode (no SRS→EX wiring yet).
    var ex_from_srs_q     : logic    ;
    // Effective VA of the SRS-issued store sitting in MEM this cycle.
    // Latched at the EX→MEM transition; read by the direct-path load
    // drain check so loads that don't alias can skip the stall.
    var ex_from_srs_q_addr: logic<64>;
    // P3.2 Stage 2b: registered flag + LQ idx for an LQ-reinjected load
    // travelling through EX→MEM. MEM uses these to suppress duplicate
    // lq_alloc and route lq_complete to the existing entry.
    var ex_from_lq_q      : logic    ;
    var lq_reinject_idx_q : logic<3> ;
    var mem_from_lq       : logic    ;
    var mem_reinject_idx  : logic<3> ;
    // WB-stage flag: load was re-injected from LQ. Used to gate the
    // normal regfile write so the LQ retire path is the only writer.
    var wb_from_lq        : logic    ;
    // SRS alias probe result — see srs_drain_needed.
    var srs_probe_alias           : logic;
    // Subset of srs_probe_alias: set when the alias=1 is driven solely by
    // an SRS entry whose base operand isn't resolved yet. Used by the
    // diag counter that quantifies P3.4 speculation opportunity.
    var srs_probe_alias_unresolved: logic;
    // SRS wake event: s1 of a pending entry just resolved via CDB.
    // Resolved VA + rob/epoch feeds the LQ squash CAM in step (c).
    var srs_wake_valid: logic    ;
    var srs_wake_rob  : logic<5> ;
    var srs_wake_epoch: logic<2> ;
    var srs_wake_addr : logic<64>;
    // LQ probe result for SRS wake (step c).
    var lq_probe_hit      : logic    ;
    var lq_probe_hit_rob  : logic<5> ;
    var lq_probe_hit_epoch: logic<2> ;
    // P3.4 (d).1: PC of the probe-hit LQ entry; used as the redirect target
    // when speculation replay fires.
    var lq_probe_hit_pc   : logic<64>;
    // CDB signals (must be declared before RS instantiation which reads them)
    var cdb0_valid: logic    ;
    var cdb0_rob  : logic<5> ;
    var cdb0_epoch: logic<2> ;
    var cdb0_data : logic<64>;
    var cdb1_valid: logic    ;
    var cdb1_rob  : logic<5> ;
    var cdb1_epoch: logic<2> ;
    var cdb1_data : logic<64>;
    // CDB port 2: slot1 EX result (dual-issue from RS)
    var cdb2_valid: logic    ;
    var cdb2_rob  : logic<5> ;
    var cdb2_epoch: logic<2> ;
    var cdb2_data : logic<64>;

    // (Scoreboard removed — replaced by RAT + ROB lookup in B2+C0)

    // MSHR (Miss Status Holding Register): holds load metadata during dcache fill.
    // Non-blocking: pipeline continues while fill completes in background.
    var mshr_valid     : logic    ;
    var mshr_rd_addr   : logic<5> ;
    var mshr_funct3    : logic<3> ;
    var mshr_byte_off  : logic<3> ;
    var mshr_is_fp     : logic    ;
    var mshr_fp_reg_wen: logic    ;
    var mshr_rob_idx   : logic<5> ; // ROB index of MSHR-absorbed load
    var mshr_epoch     : logic<2> ; // ROB epoch of MSHR-absorbed load
    var mshr_pc        : logic<64>; // PC of MSHR-absorbed load (for ROB stale-write guard)
    // LQ-4.4-c1: track the LQ slot corresponding to an MSHR-absorbed
    // load so MSHR fill can route into that LQ entry's complete port.
    // Unused in c1 (field captured but not consumed); c2/c3 wire it up.
    var mshr_lq_idx    : logic<3> ; // LQ index of MSHR-absorbed load
    var mshr_was_lq    : logic    ; // this MSHR miss maps to an LQ entry
    var _mshr_count    : logic<16>; // debug: MSHR absorb counter (unused prefix)
    // MSHR combinational signals (forward-declared, assigned after dcache)
    var mshr_absorb     : logic    ;
    var mshr_wb_valid   : logic    ;
    var mshr_wb_conflict: logic    ;
    var mshr_wb_data    : logic<64>;
    var mshr_int_wb     : logic    ; // MSHR writes integer regfile
    var mshr_fp_wb      : logic    ; // MSHR writes FP regfile
    var actual_wb_rd    : logic<5> ;
    var actual_wb_data  : logic<64>;
    var actual_wb_wen   : logic    ;
    var actual_fp_wb_wen: logic    ;
    var dcache_stall_pipeline: logic; // dcache stall for pipeline (suppressed by MSHR)

    // ROB (shadow mode): tracks in-order commit, output ignored.
    // Pipeline continues to use WB-driven regfile writes.
    var rob_alloc_idx    : logic<5> ;
    var rob_alloc_epoch  : logic<2> ;
    var rob_alloc_ready  : logic    ;
    var rob_commit_valid : logic    ;
    var rob_commit_pc    : logic<64>;
    var rob_commit_rd    : logic<5> ;
    var rob_commit_data  : logic<64>;
    var rob_commit_wen   : logic    ;
    var rob_commit_is_fp : logic    ;
    var rob_commit_fp_wen: logic    ;
    var rob_commit_compr : logic    ;
    var rob_commit_exc   : logic    ;
    var rob_commit_cause : logic<64>;
    var rob_commit_epoch : logic<2> ;
    var rob_empty        : logic    ;
    var rob_full         : logic    ;
    var rob_commit_idx   : logic<5> ;
    // RAT (Register Alias Table) lookup outputs
    var rat_rs1_valid  : logic    ;
    var rat_rs1_rob_idx: logic<5> ;
    var rat_rs2_valid  : logic    ;
    var rat_rs2_rob_idx: logic<5> ;
    var rat_fill_rs1_valid: logic; // bubble fill rs1 pending check
    var rat_fill_rs2_valid: logic; // bubble fill rs2 pending check
    // RAT ID-stage lookup outputs (for RS operand resolution using ID addresses)
    // Raw outputs from RAT — post-processed below to handle self-reference
    // (when RAT entry points to the instruction's own rob_idx because the
    // same instruction renamed RAT in a prior cycle — e.g. direct-path JALR
    // with rs=rd stalled at ID keeps re-renaming each cycle direct_path_v
    // fires, and next-cycle reads see self).
    var _raw_rat_id_rs1_valid    : logic    ;
    var _raw_rat_id_rs1_rob_idx  : logic<5> ;
    var _raw_rat_id_rs1_rob_epoch: logic<2> ;
    var _raw_rat_id_rs2_valid    : logic    ;
    var _raw_rat_id_rs2_rob_idx  : logic<5> ;
    var _raw_rat_id_rs2_rob_epoch: logic<2> ;
    // Effective ID-stage RAT values — substitute undo buffer (prior writer)
    // when raw lookup returns self-reference. Downstream logic (direct-path
    // stall check, EX operand mux, forwarding stale check) uses these.
    var rat_id_rs1_valid     : logic    ;
    var rat_id_rs1_rob_idx   : logic<5> ;
    var rat_id_rs1_rob_epoch : logic<2> ;
    var rat_id_rs2_valid     : logic    ;
    var rat_id_rs2_rob_idx   : logic<5> ;
    var rat_id_rs2_rob_epoch : logic<2> ;
    // ROB lookup outputs (completed check for RAT stall)
    var rob_lookup1_completed: logic;
    var rob_lookup1_valid    : logic;
    var rob_lookup2_completed: logic;
    var rob_lookup2_valid    : logic;
    var rob_squash_mask     : logic [32];
    // RAT undo buffer outputs (for self-reference resolution)
    var rat_undo_valid   : logic;
    var rat_undo_rd      : logic<5>;
    var rat_undo_rob_idx : logic<5>;
    var rat_undo_rob_epoch: logic<2>;
    // Store buffer shadow-mode outputs (E1-b1: instantiate but not yet wired
    // to the store path). Kept for future E1-b2/b3 integration.
    var sb_enq_ready  : logic    ;
    var sb_drain_valid: logic    ;
    var sb_drain_addr : logic<64>;
    var sb_drain_data : logic<64>;
    var sb_drain_wstrb: logic<8> ;
    var sb_drain_size : logic<2> ;
    var sb_drain_is_sc: logic    ;
    var sb_drain_is_amo: logic   ;
    var sb_drain_rob  : logic<5> ;
    var sb_fwd_hit    : logic    ;
    var sb_fwd_data   : logic<64>;
    var sb_fwd_partial: logic    ;
    var sb_fwd_match   : logic   ;
    var sb_fwd_mismatch: logic   ;
    var sb_count      : logic<4> ;
    var sb_full       : logic    ;
    var sb_empty      : logic    ;
    var sb_match_older: logic    ; // SB has older entry at MEM-stage line
    var lq_alias_srs_hit: logic  ; // LQ has older pending entry at SRS issue line
    // Load queue shadow-mode outputs (LQ-1: instantiate and observe only;
    // the dcache load path continues to be driven inline by EX/MEM).
    var lq_alloc_ready : logic   ;
    var lq_alloc_idx   : logic<3>;
    var lq_issue_valid : logic   ;
    var lq_issue_addr  : logic<64>;
    var lq_issue_funct3: logic<3>;
    var lq_issue_is_fp : logic   ;
    var lq_issue_rob   : logic<5>;
    var lq_issue_idx   : logic<3>;
    var lq_retire_valid: logic   ;
    var lq_retire_rob  : logic<5>;
    var lq_retire_epoch: logic<2>;
    var lq_retire_rd   : logic<5>;
    var lq_retire_data : logic<64>;
    var lq_retire_is_fp: logic   ;
    var lq_retire_pc   : logic<64>;
    var lq_count       : logic<4>;
    var lq_full        : logic   ;
    var lq_empty       : logic   ;
    // P3.2 Stage 2: ID-stage pending-rs1 alloc + LQ re-inject signals.
    var lq_id_alloc_fire : logic    ;
    var lq_id_s1_ready   : logic    ;
    var lq_id_s1_tag     : logic<5> ;
    var lq_id_s1_epoch   : logic<2> ;
    var lq_id_s1_data    : logic<64>;
    var lq_reinject_valid : logic    ;
    var lq_reinject_pc    : logic<64>;
    var lq_reinject_rob   : logic<5> ;
    var lq_reinject_epoch : logic<2> ;
    var lq_reinject_rd    : logic<5> ;
    var lq_reinject_funct3: logic<3> ;
    var lq_reinject_is_fp : logic    ;
    var lq_reinject_s1    : logic<64>;
    var lq_reinject_imm   : logic<64>;
    var lq_reinject_idx   : logic<3> ;
    var lq_reinject_fire  : logic    ; // = ex_from_lq — EX accepts reinject this cycle
    // ROB read port outputs (for RS operand resolution at dispatch)
    var rob_read1_data     : logic<64>;
    var rob_read1_completed: logic    ;
    var rob_read1_valid    : logic    ;
    var rob_read1_epoch    : logic<2> ;
    var rob_read2_data     : logic<64>;
    var rob_read2_completed: logic    ;
    var rob_read2_valid    : logic    ;
    var rob_read2_epoch    : logic<2> ;
    // ROB index pipeline registers (shadow pipeline, managed in heliodor_top)
    var id_rob_idx  : logic<5>;
    var id_epoch    : logic<2>; // ROB epoch at allocation time
    var ex_rob_idx  : logic<5>;
    var ex_epoch    : logic<2>;
    var _ex_rob_idx_q : logic<5>; // 1-cycle shadow for cross-module FF safety
    var mem_rob_idx : logic<5>;
    var mem_epoch   : logic<2>;
    var mem_from_rs : logic   ; // instruction in MEM/WB came from RS path
    var ex_from_rs_q: logic   ; // registered: instruction in EX came from RS
    // Registered commit bypass: captures ROB commit from previous cycle
    // (needed because same-cycle commit+regfile-read race in Verilog NBA semantics)
    var commit_bypass_valid: logic    ;
    var commit_bypass_rd   : logic<5> ;
    var commit_bypass_data : logic<64>;
    // Forwarding unit outputs
    var fwd_a     : pipeline_pkg::FwdSel;
    var fwd_b     : pipeline_pkg::FwdSel;
    var fp_fwd_a  : pipeline_pkg::FwdSel;
    var fp_fwd_b  : pipeline_pkg::FwdSel;
    var fp_fwd_c  : pipeline_pkg::FwdSel;

    // IF stage signals
    var if_pc: logic<64>;

    // IF/ID pipeline register (slot0)
    var ifid_valid        : logic    ;
    var ifid_pc           : logic<64>;
    var ifid_instr        : logic<32>;
    var ifid_compressed   : logic    ;
    var ifid_c_illegal    : logic    ;
    var ifid_predict_taken: logic    ;
    // IF/ID pipeline register (slot1 — valid only during dual issue)
    var s1_ifid_valid : logic    ;
    var s1_ifid_pc    : logic<64>;
    var s1_ifid_instr : logic<32>;

    // Pre-Decode Buffer (PDB): holds 2nd instruction from dual fetch
    var pdb_valid     : logic    ;
    var pdb_pc        : logic<64>;
    var pdb_instr     : logic<32>;
    var pdb_compressed: logic    ;
    var pdb_c_illegal : logic    ;

    // ID stage output signals
    var id_pc           : logic                <64>;
    var id_rs1_data     : logic                <64>;
    var id_rs2_data     : logic                <64>;
    var id_imm          : logic                <64>;
    var id_rd_addr      : logic                <5> ;
    var id_rs1_addr     : logic                <5> ;
    var id_rs2_addr     : logic                <5> ;
    var id_rs3_addr     : logic                <5> ;
    var id_alu_op       : alu_pkg::AluOp           ;
    var id_alu_src_a    : pipeline_pkg::AluSrcA    ;
    var id_alu_src_b    : pipeline_pkg::AluSrcB    ;
    var id_wb_sel       : pipeline_pkg::WbSel      ;
    var id_reg_wen      : logic                    ;
    var id_mem_ren      : logic                    ;
    var id_mem_wen      : logic                    ;
    var id_mem_funct3   : logic                <3> ;
    var id_is_branch    : logic                    ;
    var id_is_jal       : logic                    ;
    var id_is_jalr      : logic                    ;
    var id_funct3       : logic                <3> ;
    var id_is_ecall     : logic                    ;
    var id_is_ebreak    : logic                    ;
    var id_is_mret      : logic                    ;
    var id_is_wfi       : logic                    ;
    var id_illegal      : logic                    ;
    var id_amo_funct5   : logic                <5> ;
    var id_is_amo       : logic                    ;
    var id_is_compressed: logic                    ;
    var id_is_sfence    : logic                    ;
    var id_is_fence_i   : logic                    ;
    var id_is_fence     : logic                    ;
    var id_is_fp        : logic                    ;
    var id_fp_reg_wen   : logic                    ;
    var id_fpu_op       : fpu_pkg::FpuOp           ;
    var id_fp_rm        : logic                <3> ;
    var id_fp_rs1_data  : logic                <64>;
    var id_fp_rs2_data  : logic                <64>;
    var id_fp_rs3_data  : logic                <64>;
    var id_is_csr       : logic                    ;
    var id_csr_op       : csr_pkg::CsrOp           ;
    var id_csr_imm      : logic                    ;
    var id_csr_addr     : logic                <12>;
    var id_valid        : logic                    ;

    // Instruction tracking for trap_val (illegal instruction encoding)
    var id_instr_shadow: logic<32>;
    var ex_instr_shadow: logic<32>;
    // CSR access fault (registered to avoid comb DAG instability)
    var id_csr_fault_q: logic;

    // EX stage output signals
    var ex_valid        : logic                  ;
    var ex_pc           : logic              <64>;
    var ex_alu_out      : logic              <64>;
    var ex_rs2_data     : logic              <64>;
    var ex_rd_addr      : logic              <5> ;
    var ex_wb_sel       : pipeline_pkg::WbSel    ;
    var ex_reg_wen      : logic                  ;
    var ex_mem_ren      : logic                  ;
    var ex_mem_wen      : logic                  ;
    var ex_mem_funct3   : logic              <3> ;
    var ex_is_ecall     : logic                  ;
    var ex_is_ebreak    : logic                  ;
    var ex_illegal      : logic                  ;
    var ex_amo_funct5   : logic              <5> ;
    var ex_is_amo       : logic                  ;
    var ex_is_compressed: logic                  ;
    var ex_is_fp        : logic                  ;
    var ex_fp_reg_wen   : logic                  ;
    var ex_fp_rs2_data  : logic              <64>;
    var ex_fp_fflags    : logic              <5> ;
    var ex_fp_fflags_wen: logic                  ;
    var fp_fflags_ex    : logic              <5> ;
    var fp_fflags_ex_wen: logic                  ;
    var ex_branch_taken : logic                  ;
    var ex_branch_target: logic              <64>;
    var ex_jump_target  : logic              <64>;
    var ex_misprediction: logic                  ;
    var ex_mispred_dir   : logic                 ;
    var ex_mispred_target: logic                 ;
    var ex_div_busy     : logic                  ;
    var ex_fp_busy      : logic                  ;

    // P3.4 (d).2: replay-latch registers (driven by always_ff later in the
    // file) and the unified pipeline_squash fabric. Declared/assigned here
    // up-front so downstream `let` bindings (hazard_unit, IMMU redirect,
    // fetch redirect, ROB squash) can reference them without forward-ref
    // errors.
    var p34_replay_valid_q   : logic    ;
    var p34_replay_idx_q     : logic<5> ;
    var p34_replay_epoch_q   : logic<2> ;
    var p34_replay_pc_q      : logic<64>;
    var pipeline_squash      : logic    ;
    var pipeline_branch_target: logic<64>;
    var pipeline_is_jalr     : logic    ;
    assign pipeline_squash       = ex_misprediction || p34_replay_valid_q;
    assign pipeline_branch_target = if p34_replay_valid_q ? p34_replay_pc_q
                                                          : ex_branch_target;
    // pipeline_is_jalr assigned after `ex_inst_is_jalr` is defined.

    // EX-stage instruction fields. Combine direct-path (id_*) and RS-routed
    // (rs_issue_*) so RAS / BHT / BP / counters / fetch redirect (pipeline_is_jalr)
    // all see the same view. Declared early because users span IF and EX
    // stages.
    var ex_rd              : logic<5> ;
    var ex_rs1             : logic<5> ;
    var ex_inst_pc         : logic<64>;
    var ex_inst_compressed : logic    ;
    var ex_inst_is_jal     : logic    ;
    var ex_inst_is_jalr    : logic    ;
    var ex_inst_is_branch  : logic    ;
    // Forward-declared dispatch sources. Early users: BP update / RAS / BHT /
    // pipeline_is_jalr.
    var ex_from_rs   : logic;
    var ex_from_srs  : logic;
    var ex_from_fp_rs: logic;
    var ex_from_lq   : logic;
    var ex_in_valid  : logic;

    // FP RS / FP RAT signals (E2-c2)
    var fp_rat_id_rs1_valid    : logic    ;
    var fp_rat_id_rs1_rob_idx  : logic<5> ;
    var fp_rat_id_rs1_rob_epoch: logic<2> ;
    var fp_rat_id_rs2_valid    : logic    ;
    var fp_rat_id_rs2_rob_idx  : logic<5> ;
    var fp_rat_id_rs2_rob_epoch: logic<2> ;
    var fp_rat_id_rs3_valid    : logic    ;
    var fp_rat_id_rs3_rob_idx  : logic<5> ;
    var fp_rat_id_rs3_rob_epoch: logic<2> ;
    var fp_rs_dispatch_ready   : logic    ;
    var fp_rs_dispatched_q     : logic    ;
    var fp_rs_issue_valid      : logic    ;
    var fp_rs_issue_pc         : logic<64>;
    var fp_rs_issue_fpu_op     : fpu_pkg::FpuOp;
    var fp_rs_issue_rm         : logic<3> ;
    var fp_rs_issue_rd         : logic<5> ;
    var fp_rs_issue_rs1        : logic<5> ;
    var fp_rs_issue_rs2        : logic<5> ;
    var fp_rs_issue_rs3        : logic<5> ;
    var fp_rs_issue_s1_data    : logic<64>;
    var fp_rs_issue_s2_data    : logic<64>;
    var fp_rs_issue_s3_data    : logic<64>;
    var fp_rs_issue_fp_wen     : logic    ;
    var fp_rs_issue_reg_wen    : logic    ;
    var fp_rs_issue_fflags_valid: logic   ;
    var fp_rs_issue_rob        : logic<5> ;
    var fp_rs_issue_epoch      : logic<2> ;
    var fp_rs_sel_valid        : logic    ;
    var fp_cdb0_valid          : logic    ;
    var fp_cdb0_rob            : logic<5> ;
    var fp_cdb0_epoch          : logic<2> ;
    var fp_cdb0_data           : logic<64>;
    var fp_cdb1_valid          : logic    ;
    var fp_cdb1_rob            : logic<5> ;
    var fp_cdb1_epoch          : logic<2> ;
    var fp_cdb1_data           : logic<64>;
    // FP ROB read ports (for FP RS dispatch operand resolution)
    var fp_rob_read1_data      : logic<64>;
    var fp_rob_read1_completed : logic    ;
    var fp_rob_read1_valid     : logic    ;
    var fp_rob_read1_epoch     : logic<2> ;
    var fp_rob_read2_data      : logic<64>;
    var fp_rob_read2_completed : logic    ;
    var fp_rob_read2_valid     : logic    ;
    var fp_rob_read2_epoch     : logic<2> ;
    var fp_rob_read3_data      : logic<64>;
    var fp_rob_read3_completed : logic    ;
    var fp_rob_read3_valid     : logic    ;
    var fp_rob_read3_epoch     : logic<2> ;

    // Forward-declared vars for RS/direct-path interaction (computed after RAT)
    var id_direct_stall: logic;
    var direct_path_v  : logic;
    var rs_yield        : logic; // RS starvation prevention: yield EX to RS
    var rs_sel_valid    : logic; // RS has a ready entry to issue
    var srs_yield       : logic; // SRS starvation prevention: yield EX to SRS
    var lq_yield        : logic; // LQ starvation prevention: yield EX to LQ reinject
    var id_has_rob      : logic; // true when current ID instruction has a valid ROB entry

    // RS-eligible check on ID stage (decode output): pure integer ALU/MUL/DIV.
    // Exclude illegal instructions — they must stay on the direct path so
    // execute sees i_illegal=1 and raises the exception (RS-issued instructions
    // have i_illegal hardwired to 0). tvm_trap / tsr_trap / mret_priv_fault /
    // sret_priv_fault / sfence_priv_fault / id_csr_fault_q only apply to their
    // respective non-RS-eligible instruction types (mret/sret/sfence/csr),
    // which are already excluded above by !id_is_csr etc., so no extra guard
    // is needed for them here.
    // DIV/REM excluded from RS: multi-cycle divider doesn't preserve instruction
    // identity across the divider pipeline — new instructions entering EX during
    // DIV computation overwrite the EX/MEM register with their own alu_result,
    // causing the DIV result to be lost. Direct-path DIV works because the
    // instruction stays in ID while the divider computes.
    let id_is_div_op: logic = id_alu_op == alu_pkg::AluOp::DIV
                           || id_alu_op == alu_pkg::AluOp::DIVU
                           || id_alu_op == alu_pkg::AluOp::REM
                           || id_alu_op == alu_pkg::AluOp::REMU
                           || id_alu_op == alu_pkg::AluOp::DIVW
                           || id_alu_op == alu_pkg::AluOp::DIVUW
                           || id_alu_op == alu_pkg::AluOp::REMW
                           || id_alu_op == alu_pkg::AluOp::REMUW;
    // D2 step 2: DIV now RS-eligible. Decouples DIV from direct-path
    // EX_MEM forwarding (which sourced `ex_alu_out` = ALU comb DIV).
    // RS-dispatched ops set ex_from_rs, which zeros forwarding selects
    // into execute; dependents wake via CDB1's div_async branch.
    // ALU-class RS eligibility: ordinary R/I-type that writes rd via ALU result.
    let id_is_rs_eligible_alu: logic = id_valid && id_reg_wen
        && id_wb_sel == pipeline_pkg::WbSel::ALU
        && !id_mem_ren && !id_mem_wen
        && !id_is_branch && !id_is_jal && !id_is_jalr
        && !id_is_csr && !id_is_fp && !id_is_amo
        && !id_is_ecall && !id_is_ebreak
        && !id_illegal;
    // Control-flow RS eligibility: branch + JALR. Both have operand
    // dependencies that benefit from RS waiting (direct path stalls
    // ds_op_bj cycles when rs1/rs2 are not ready). JAL has no operand
    // deps and stays direct.
    // Branch/JALR RS routing infrastructure exists (RS extended with branch
    // fields, dispatch/issue plumbing, ex_inst_* fabric for BHT/RAS/BP/
    // counters/redirect). Currently DISABLED because it exposes a pre-
    // existing ROB squash-mask issue:
    //   pipeline_squash_idx = BNE+1, but `sq_di != 0` excludes squash_idx
    //   from the mask, leaving the first speculative entry at ROB[BNE+1]
    //   valid+completed. With RS-routed branches, speculation runs many
    //   cycles (waiting for operands) and the speculative entry can complete
    //   before the squash. After squash, head reaches BNE+1 and commits
    //   stale data before the right-path instruction's alloc overwrites.
    // Fix needs: epoch-aware mask + inclusive squash_idx + reliable alloc-
    //   ordering vs commit. Direct-path branches resolve too fast to expose
    //   this. Deferred — see project_branch_rs_routing.md for status.
    const CTL_RS_ENABLE_JALR  : bit = 1'b0;
    const CTL_RS_ENABLE_BRANCH: bit = 1'b0;
    let id_is_rs_eligible_ctl: logic = id_valid
        && ((CTL_RS_ENABLE_JALR && id_is_jalr) || (CTL_RS_ENABLE_BRANCH && id_is_branch))
        && !id_is_csr && !id_is_fp && !id_is_amo
        && !id_is_ecall && !id_is_ebreak
        && !id_illegal;
    let id_is_rs_eligible: logic = id_is_rs_eligible_alu || id_is_rs_eligible_ctl;

    // RS dispatch valid: instruction is RS-eligible AND not flushed/stalled/already dispatched
    let rs_dispatch_valid: logic = id_is_rs_eligible && !flush_id && !stall_ex && !rs_dispatched_q && !rob_full;

    // SRS (store RS) eligibility: plain stores (not AMO, not FP).
    // LR/SC and AMO need direct-path serialization. FP stores (FSW/FSD)
    // route through direct path for now since they share the integer
    // store MEM path but read FP regs for data.
    //
    // Gate on id_valid/id_mem_wen/!id_is_amo/!id_is_fp only. Notably,
    // do NOT reference flush_id here — a syntactic path from
    // flush_id → id_is_srs_eligible → srs_drain_needed → id_direct_stall
    // → direct_path_v → flush_id forms a comb cycle that JIT-on
    // silently converges to a wrong fixed point (observed as a BGEU
    // hang at 0xffffffff80046d1e during Linux boot). srs_dispatch_valid
    // already checks flush_id downstream, so the redundant gate here
    // is unnecessary. JIT-off also flags the cycle.
    let id_is_srs_eligible: logic = id_valid && id_mem_wen && !id_is_amo && !id_is_fp;
    // AMO-RMW detection: distinguishes RMW (mem_ren && mem_wen) from LR/SC
    // (pure load or store). Used as the direct-path re-evaluation gate scope.
    let id_is_amo_rmw: logic = id_is_amo && id_mem_ren && id_mem_wen;
    // Direct-path re-evaluation gate scope: instructions whose result
    // depends on mutable state (RMW semantics). Re-firing these corrupts
    // the captured result:
    //   - AMO-RMW: re-reads dcache post-write, corrupts amo_old
    //   - SC: re-evaluates after reservation clear, flips success 1→0
    //   - CSR-RMW: re-reads CSR post-write, returns new (wrong) old value
    // LR is idempotent on re-fire (just re-asserts reservation).
    let id_is_sc: logic = id_is_amo && id_amo_funct5 == 5'b00011;
    let id_direct_oneshot_scope: logic = id_is_amo_rmw || id_is_sc || id_is_csr;
    // SRS-2 observational mode: dispatch only; issue output is not wired into
    // the pipeline. Stores still proceed via direct path, so SRS populates in
    // parallel and retires when operands arrive.
    let srs_dispatch_valid: logic = id_is_srs_eligible && (!rob_full || id_has_rob)
                                 && !flush_id && !stall_ex && !srs_dispatched_q && srs_dispatch_ready;

    // FP RS eligibility: 2/1/3-operand FP→FP ops for both single and double
    // precision. Covers FADD/FSUB/FMUL/FDIV/FMIN/FMAX/FSGNJ(N/X)/FSQRT/FMADD
    // family. Cross-domain (FMV/FCMP/FCLASS/FCVT int-FP, FCVT.S.D/D.S) stays
    // on direct path (fflags plumbing for in-flight RS ops pending).
    let id_fpu_2op_fp: logic = id_fpu_op == fpu_pkg::FpuOp::FADD_D
                            || id_fpu_op == fpu_pkg::FpuOp::FSUB_D
                            || id_fpu_op == fpu_pkg::FpuOp::FMUL_D
                            || id_fpu_op == fpu_pkg::FpuOp::FDIV_D
                            || id_fpu_op == fpu_pkg::FpuOp::FMIN_D
                            || id_fpu_op == fpu_pkg::FpuOp::FMAX_D
                            || id_fpu_op == fpu_pkg::FpuOp::FSGNJ_D
                            || id_fpu_op == fpu_pkg::FpuOp::FSGNJN_D
                            || id_fpu_op == fpu_pkg::FpuOp::FSGNJX_D
                            || id_fpu_op == fpu_pkg::FpuOp::FADD_S
                            || id_fpu_op == fpu_pkg::FpuOp::FSUB_S
                            || id_fpu_op == fpu_pkg::FpuOp::FMUL_S
                            || id_fpu_op == fpu_pkg::FpuOp::FDIV_S
                            || id_fpu_op == fpu_pkg::FpuOp::FMIN_S
                            || id_fpu_op == fpu_pkg::FpuOp::FMAX_S
                            || id_fpu_op == fpu_pkg::FpuOp::FSGNJ_S
                            || id_fpu_op == fpu_pkg::FpuOp::FSGNJN_S
                            || id_fpu_op == fpu_pkg::FpuOp::FSGNJX_S;
    // 1-operand FP→FP ops: rs2 field is architecturally unused (encoded 0);
    // dispatch must force s2_ready=1 so we don't wait on stale fp_rat[f0].
    let id_fpu_1op_fp: logic = id_fpu_op == fpu_pkg::FpuOp::FSQRT_D
                            || id_fpu_op == fpu_pkg::FpuOp::FSQRT_S
                            || id_fpu_op == fpu_pkg::FpuOp::FCVT_S_D
                            || id_fpu_op == fpu_pkg::FpuOp::FCVT_D_S;
    // 3-operand FP→FP ops: FMADD family reads rs1, rs2, rs3.
    let id_fpu_3op_fp: logic = id_fpu_op == fpu_pkg::FpuOp::FMADD_D
                            || id_fpu_op == fpu_pkg::FpuOp::FMSUB_D
                            || id_fpu_op == fpu_pkg::FpuOp::FNMSUB_D
                            || id_fpu_op == fpu_pkg::FpuOp::FNMADD_D
                            || id_fpu_op == fpu_pkg::FpuOp::FMADD_S
                            || id_fpu_op == fpu_pkg::FpuOp::FMSUB_S
                            || id_fpu_op == fpu_pkg::FpuOp::FNMSUB_S
                            || id_fpu_op == fpu_pkg::FpuOp::FNMADD_S;
    // Int-writing FP ops: read FP reg(s), write integer reg. Covers FMV.X,
    // FCLASS (no fflags), FCMP and FCVT.int (emit fflags). Fflags-producing
    // ops rely on the rob_drain_needed gate on CSR fflags/frm/fcsr reads
    // to guarantee ordering between RS-issued fflags and CSR reads.
    let id_fpu_fp2int: logic = id_fpu_op == fpu_pkg::FpuOp::FMV_X_D
                            || id_fpu_op == fpu_pkg::FpuOp::FMV_X_W
                            || id_fpu_op == fpu_pkg::FpuOp::FCLASS_D
                            || id_fpu_op == fpu_pkg::FpuOp::FCLASS_S
                            || id_fpu_op == fpu_pkg::FpuOp::FEQ_D
                            || id_fpu_op == fpu_pkg::FpuOp::FLT_D
                            || id_fpu_op == fpu_pkg::FpuOp::FLE_D
                            || id_fpu_op == fpu_pkg::FpuOp::FEQ_S
                            || id_fpu_op == fpu_pkg::FpuOp::FLT_S
                            || id_fpu_op == fpu_pkg::FpuOp::FLE_S
                            || id_fpu_op == fpu_pkg::FpuOp::FCVT_W_D
                            || id_fpu_op == fpu_pkg::FpuOp::FCVT_WU_D
                            || id_fpu_op == fpu_pkg::FpuOp::FCVT_L_D
                            || id_fpu_op == fpu_pkg::FpuOp::FCVT_LU_D
                            || id_fpu_op == fpu_pkg::FpuOp::FCVT_W_S
                            || id_fpu_op == fpu_pkg::FpuOp::FCVT_WU_S
                            || id_fpu_op == fpu_pkg::FpuOp::FCVT_L_S
                            || id_fpu_op == fpu_pkg::FpuOp::FCVT_LU_S;
    let id_is_fp_rs_eligible: logic = id_valid && id_is_fp
        && ((id_fp_reg_wen && (id_fpu_2op_fp || id_fpu_1op_fp || id_fpu_3op_fp))
            || (id_reg_wen && id_fpu_fp2int))
        && !id_mem_ren && !id_mem_wen;
    let fp_rs_dispatch_valid: logic = id_is_fp_rs_eligible && !flush_id && !stall_ex
        && !fp_rs_dispatched_q && !rob_full;

    // RS issue stall: EX can't accept (cache/MMU stall, or DIV structural hazard)
    let rs_issue_is_div: logic = rs_issue_alu_op == alu_pkg::AluOp::DIV || rs_issue_alu_op == alu_pkg::AluOp::DIVU
                              || rs_issue_alu_op == alu_pkg::AluOp::REM || rs_issue_alu_op == alu_pkg::AluOp::REMU
                              || rs_issue_alu_op == alu_pkg::AluOp::DIVW || rs_issue_alu_op == alu_pkg::AluOp::DIVUW
                              || rs_issue_alu_op == alu_pkg::AluOp::REMW || rs_issue_alu_op == alu_pkg::AluOp::REMUW;
    // RS issue stall: EX taken by direct-path instruction that is actually proceeding.
    // A stalled direct-path instruction (id_direct_stall) does NOT block RS issue —
    // otherwise RS-dispatched dependencies can never resolve (deadlock).
    let rs_issue_stall: logic = stall_ex || (rs_issue_valid && rs_issue_is_div && ex_div_busy)
                             || direct_path_v; // only blocks RS when direct-path is actually going to EX

    // Branch prediction signals (raw combinational from branch_predictor)
    var bp_predict_taken   : logic    ;
    var bp_predict_target  : logic<64>;
    // Registered copies (1-cycle latched to cut cross-module comb chain)
    var bp_predict_taken_q : logic    ;
    var bp_predict_target_q: logic<64>;
    // Local BHT for conditional branch prediction (avoids cross-module comb)
    var local_bht: logic<2> [256];
    // Return Address Stack (RAS) for JALR return prediction
    var ras_stack: logic<64> [8]; // 8-entry circular stack
    var ras_ptr  : logic<3>    ; // top-of-stack pointer
    var if_predict_taken   : logic    ;
    // 1-cycle delayed prediction flag: true when IF is on a speculative path
    // (fetch was redirected by prediction in the previous cycle).
    var speculative_if     : logic    ;
    var id_predict_taken   : logic    ;
    var id_predict_target  : logic<64>;
    var ifid_predict_target: logic<64>;

    // MEM stage output signals
    var mem_valid        : logic                  ;
    var mem_pc           : logic              <64>;
    var mem_alu_out      : logic              <64>;
    var mem_data         : logic              <64>;
    var mem_load_data    : logic              <64>;
    var mem_sc_result    : logic              <64>;
    var mem_is_sc_out    : logic                  ;
    var mem_rd_addr      : logic              <5> ;
    var mem_wb_sel       : pipeline_pkg::WbSel    ;
    var mem_reg_wen      : logic                  ;
    var mem_is_compressed: logic                  ;
    var mem_is_fp        : logic                  ;
    var mem_was_lq       : logic                  ;
    var mem_lq_idx       : logic<3>               ;
    var lq_alloc_gate    : logic                  ; // forward-declared: assigned near LQ instance
    var mem_fp_reg_wen   : logic                  ;
    var mem_dmem_ren     : logic                  ; // Forward-declared for hazard unit
    var mem_misaligned   : logic                  ;
    var mem_misalign_st  : logic                  ;
    var mem_split_stall  : logic                  ;
    var mem_crosses_dw   : logic                  ;
    var mem_split_phase2 : logic                  ;
    var mem_mshr_absorbed: logic                  ;
    var mem_amo_inflight : logic                  ; // AMO RMW occupying MEM stage (multi-hart bus lock signal)
    var mem_reserv_valid : logic                  ; // LR-SC reservation valid (multi-hart bus lock signal)

    // CSR signals
    var csr_rdata       : logic             <64>;
    var csr_mtvec       : logic             <64>;
    var csr_stvec       : logic             <64>;
    var csr_mret_pc     : logic             <64>;
    var csr_sret_pc     : logic             <64>;
    var csr_priv        : csr_pkg::PrivLevel    ;
    var csr_satp        : logic             <64>;
    var csr_access_fault: logic                 ;
    var csr_frm         : logic             <3> ;
    var csr_trap_to_s   : logic                 ;
    var csr_sum         : logic                 ;
    var csr_mxr         : logic                 ;
    var csr_tvm         : logic                 ;
    var csr_tsr         : logic                 ;
    var csr_mprv        : logic                 ;
    var csr_mpp         : logic             <2> ;
    var csr_fs          : logic             <2> ;
    // Trap and privilege checks (forward-declared for execute module)
    var tvm_trap         : logic    ;
    var tsr_trap         : logic    ;
    var mret_priv_fault  : logic    ;
    var sret_priv_fault  : logic    ;
    var sfence_priv_fault: logic    ;
    var mret_raw         : logic    ;
    var sret_raw         : logic    ;
    var trap_taken       : logic    ;
    var trap_cause       : logic<64>;
    var trap_pc          : logic<64>;
    var trap_val         : logic<64>;
    var trap_target      : logic<64>;
    var mret_taken       : logic    ;
    var sret_taken       : logic    ;
    var irq_pending      : logic    ;
    var irq_taken        : logic    ;
    // 1-cycle delayed mret/sret signal to suppress interrupt for one cycle
    // after mret/sret pipeline flush (prevents race with NBA privilege update)
    var xret_taken_q: logic;
    // WFI halt was attempted to reduce hart 1 idle bus consumption but
    // disabled — see csr o_irq_any output and notes; hart 1 wouldn't wake.
    // Reverted to keep boot path stable; investigate later.
    var wfi_halt: logic;
    var irq_any : logic;

    // ============================================================
    // Commit-time trap: pending trap register
    // ============================================================
    // When EX/MEM detects a synchronous exception on a ROB-tracked
    // instruction, save the trap info here and defer firing until
    // the excepted ROB entry reaches the commit head.
    var pend_trap_valid: logic    ;
    var pend_trap_cause: logic<64>;
    var pend_trap_pc   : logic<64>;
    var pend_trap_val  : logic<64>;
    var pend_trap_rob  : logic<5> ;
    var pend_trap_epoch: logic<2> ;

    // CLINT/PLIC interrupt inputs (driven by SoC peripherals)
    let timer_irq : logic    = i_timer_irq;
    let sw_irq    : logic    = i_sw_irq;
    let mtime_val : logic<64> = i_mtime;
    let plic_irq_m: logic    = i_plic_irq_m;
    let plic_irq_s: logic    = i_plic_irq_s;
    var irq_cause : logic<64>;

    // MMU signals (declared early for hazard unit)
    // MMU not yet active — stall always false in Bare mode
    var mmu_stall: logic;

    // Cache/MMU stall signals
    var icache_stall: logic;
    var dcache_stall: logic;
    var immu_busy   : logic;

    // WB stage signals
    var wb_data   : logic<64>;
    var wb_rd_addr: logic<5> ;
    var wb_wen    : logic    ;

    // Slot0 ALU combinational result (for same-cycle slot0→slot1 forwarding)
    var slot0_alu_comb: logic<64>;

    // Slot1 regfile read data (from decode module's regfile ports 3/4)
    var s1_rs1_raw: logic<64>;
    var s1_rs2_raw: logic<64>;

    // Slot1 EX/WB pipeline signals (from execute_s1)
    var s1_ex_valid    : logic    ;
    var s1_ex_pc       : logic<64>;
    var s1_ex_alu_out  : logic<64>;
    var s1_ex_rd_addr  : logic<5> ;
    var s1_ex_reg_wen  : logic    ;
    var s1_ex_rob_idx  : logic<5> ;
    var s1_ex_rob_epoch: logic<2> ;
    // Slot1 WB: once-only write. s1_wb_done tracks whether this slot1
    // instruction has already been committed, preventing re-write during
    // stalls and ensuring trap_taken cancels uncommitted writes.
    var s1_wb_done   : logic    ;
    // F0: dual-issue enabled. Slot1 RS commits via ROB (not direct WB).
    let s1_normal_wb_wen: logic = 1'b0;
    // ROB commit overflow: MSHR has priority on slot0, so route ROB commit to slot1.
    // This prevents ROB commit regfile writes from being silently dropped.
    let rob_commit_overflow: logic = mshr_int_wb && rob_commit_valid && rob_commit_wen;
    let s1_wb_data   : logic<64> = if rob_commit_overflow ? rob_commit_data : s1_ex_alu_out;
    let s1_wb_rd_addr: logic<5>  = if rob_commit_overflow ? rob_commit_rd : s1_ex_rd_addr;
    let s1_wb_wen    : logic     = s1_normal_wb_wen || rob_commit_overflow;

    // Slot1 ID/EX pipeline signals
    var s1_id_valid    : logic                    ;
    var s1_id_pc       : logic                <64>;
    var s1_id_rs1_data : logic                <64>;
    var s1_id_rs2_data : logic                <64>;
    var s1_id_imm      : logic                <64>;
    var s1_id_rd_addr  : logic                <5> ;
    var s1_id_rs1_addr : logic                <5> ;
    var s1_id_rs2_addr : logic                <5> ;
    var s1_id_alu_op   : alu_pkg::AluOp           ;
    var s1_id_alu_src_a: pipeline_pkg::AluSrcA    ;
    var s1_id_alu_src_b: pipeline_pkg::AluSrcB    ;
    var s1_id_reg_wen  : logic                    ;

    // Slot1 forwarding selects
    var s1_fwd_a: pipeline_pkg::FwdSel;
    var s1_fwd_b: pipeline_pkg::FwdSel;

    // ============================================================
    // Hazard unit (declared first since others depend on it)
    // ============================================================
    // FP register read detection for IF/ID instruction:
    // OP-FP(1010011), FMADD(1000011), FMSUB(1000111), FNMSUB(1001011), FNMADD(1001111),
    // FP-LOAD(0000111), FP-STORE(0100111) all read FP registers via rs1/rs2.
    let ifid_opcode : logic<7> = ifid_instr[6:0];
    let ifid_fp_read: logic    = ifid_opcode == 7'b1010011 // OP-FP
     || ifid_opcode == 7'b1000011 // FMADD
     || ifid_opcode == 7'b1000111 // FMSUB
     || ifid_opcode == 7'b1001011 // FNMSUB
     || ifid_opcode == 7'b1001111 // FNMADD
     || ifid_opcode == 7'b0100111; // FP-STORE (reads FP rs2)

    // ============================================================
    // Scoreboard-based stall (forward-declared; computed after dcache)
    // ============================================================
    let ifid_rs1_addr: logic<5> = ifid_instr[19:15];
    let ifid_rs2_addr: logic<5> = ifid_instr[24:20];
    // EX-stage: direct load-use check (load/SC in EX, consumer in ID)
    // Exclude FP loads (flw/fld): FP rd shares encoding with int rd but writes a
    // different register file. Comparing id_rd_addr (FP-encoded) to ifid_rs1/rs2
    // (int-encoded) would spuriously match and cause flw to be flushed from ID
    // (consumer's stall path asserts flush_id=1). fp_load_use handles FP correctly
    // via ifid_fp_read gating.
    let ex_has_pending: logic = ((id_mem_ren && !id_is_fp) || (id_is_amo && id_amo_funct5 == 5'b00011)) && id_rd_addr != 5'd0;
    // Once direct_path_dispatched_q fires, the instruction is latched in the
    // EX/MEM pipeline register — the result is in-flight and available via
    // forwarding. ID's view is stale; don't stall new decoded instructions
    // on the now-dispatched load.
    let ex_load_use   : logic = ex_has_pending && !direct_path_dispatched_q && (id_rd_addr == ifid_rs1_addr || id_rd_addr == ifid_rs2_addr);
    // RAT-based stall (forward-declared; computed after dcache)
    var sb_stall: logic;

    inst u_hazard: hazard_unit (
        // SC result is computed in MEM stage (like a load), needs load-use stall.
        // Use id_is_amo && funct5==SC instead of mem_ren to avoid dcache read.
        i_idex_mem_ren    : id_mem_ren || (id_is_amo && id_amo_funct5 == 5'b00011),
        i_idex_rd         : id_rd_addr                                            , // ID/EX: entering EX, destination
        // Gate with ex_valid: registered ex_fp_reg_wen can be stale when EX is
        // empty, causing fp_load_use to fire spuriously and flush ID (destroying
        // the FP producer that's supposed to enter EX next cycle).
        i_idex_fp_reg_wen : ex_valid && ex_fp_reg_wen                             , // EX stage: FP register write?
        i_id_fp_reg_wen   : id_fp_reg_wen                                         , // ID stage: FP register write?
        i_id_rd           : id_rd_addr                                            , // ID stage: destination
        i_mem_fp_reg_wen  : ex_fp_reg_wen                                         , // MEM stage: FP write
        i_mem_fp_rd       : ex_rd_addr                                            , // MEM stage: destination
        i_exmem_mem_ren   : mem_dmem_ren                                          , // MEM stage: is it a load?
        i_exmem_rd        : mem_rd_addr                                           , // MEM stage: destination register
        i_exmem_fp_reg_wen: mem_fp_reg_wen                                        , // MEM stage: FP register write?
        i_ifid_rs1        : ifid_instr[19:15]                                     ,
        i_ifid_rs2        : ifid_instr[24:20]                                     ,
        // Gate ifid_fp_read with ifid_pc != id_pc: when IFID holds the same
        // instruction that's in ID (due to stall_if without IF advance), the
        // fp_id_hazard would spuriously re-fire for self-referencing FP ops
        // (e.g. fmul ft1, ft1, ft0 reads and writes ft1). ifid_pc==id_pc means
        // IFID's content was already consumed by ID; no new consumer exists.
        i_ifid_fp_read    : ifid_fp_read && (ifid_pc != id_pc)                    , // IF/ID reads FP registers?
        i_s1_ifid_rs1     : s1_ifid_instr[19:15]                                  ,
        i_s1_ifid_rs2     : s1_ifid_instr[24:20]                                  ,
        i_s1_ifid_valid   : s1_ifid_valid                                         ,
        i_sb_stall        : sb_stall                                              ,
        i_branch_taken    : ex_branch_taken                                       ,
        i_misprediction   : pipeline_squash                                       ,
        i_is_jal          : id_is_jal                                             ,
        i_is_jalr         : id_is_jalr                                            ,
        i_trap_taken      : trap_taken                                            ,
        i_mret_taken      : mret_taken || sret_taken                              ,
        i_mmu_stall       : mmu_stall                                             ,
        i_icache_stall    : icache_stall || immu_busy                             ,
        i_dcache_stall    : dcache_stall_pipeline                                 ,
        i_mshr_wb_stall   : mshr_wb_conflict                                     ,
        i_div_busy        : ex_div_busy                                            ,
        i_fp_busy         : ex_fp_busy                                             ,
        i_rob_full        : rob_full || pend_trap_valid                            ,
        // Stall when RS-eligible instruction can't dispatch (RS full).
        // id_is_rs_eligible: decoded instruction in ID is RS-eligible.
        // !rs_dispatch_ready: RS can't accept dispatch.
        // RS full stall OR direct-path can't proceed.
        // When a non-RS instruction is in decode but can't enter EX (due to
        // operand stall, RS yield, ROB full), stall IF/ID to prevent the
        // decode module from being overwritten.
        i_rs_stall        : (id_is_rs_eligible && !rs_dispatch_ready)
                          || (id_is_fp_rs_eligible && !fp_rs_dispatch_ready)
                          || (id_is_srs_eligible && !srs_dispatched_q && !srs_dispatch_valid)
                          // Direct-path can't proceed (operand not ready etc.).
                          // Exclude the AMO-RMW gate case — direct_path_v=0 there means
                          // the instruction already dispatched and is in-flight; ID
                          // should wait for drain, not stall as a dispatch failure.
                          || (id_valid && !id_is_rs_eligible && !id_is_fp_rs_eligible && !id_is_srs_eligible && !direct_path_v && !lq_id_alloc_fire && !lq_id_dispatched_q && !(direct_path_dispatched_q && id_direct_oneshot_scope))
                          || (irq_pending && !rob_empty)
                          // WFI halt: stall ID on WFI until any IRQ becomes
                          // pending (mie & mip != 0, ignoring xIE). The trap
                          // machinery flushes ID when it fires, so this just
                          // freezes the front end while hart waits, avoiding
                          // tight WFI/JMP busy-spin during multi-hart idle.
                          || (id_valid && id_is_wfi && !irq_any && rob_empty)
                          // FENCE (RVWMO memory ordering): stall ID until all
                          // outstanding memory ops have drained — ROB empty
                          // (no in-flight loads/stores) AND store buffer empty
                          // (no pending writes to dcache/DRAM). Required for
                          // Linux SMP smp_store_release / smp_load_acquire so
                          // a writer's "completion signal" actually follows
                          // its struct initialization in time, and so a reader
                          // sees same-cycle remote invalidates from the bus
                          // before re-loading after the fence.
                          || (id_valid && id_is_fence && (!rob_empty || !sb_empty)),
        // AMO×LQ and CSR×LQ ordering: stall AMO/CSR at ID until LQ drains.
        // Holding at EX would deadlock — LQ re-injection also routes through
        // EX. ID-stage hold keeps EX free so older LQ entries can drain
        // through the re-inject mux.
        // CSR is narrowly scoped to memory-translation-affecting CSRs
        // (sstatus, mstatus, satp). Linux uses `csrrs SUM; ld user; csrrc SUM`
        // for uaccess; if the LD is LQ-pending and re-injects after the
        // csrrc clears SUM, the LD page-faults. Wider scopes (all CSRs)
        // stall rdtime in delay loops; narrower write-effective filters
        // unmask a separate t0=0 NULL-deref bug. Stick with the address
        // scope that's known to keep gate-on Linux PASSing.
        i_amo_lq_stall    : id_valid && !lq_empty &&
                            (id_is_amo
                             || (id_is_csr && (id_csr_addr == csr_pkg::CSR_SSTATUS
                                            || id_csr_addr == csr_pkg::CSR_MSTATUS
                                            || id_csr_addr == csr_pkg::CSR_SATP)))                                              ,
        o_stall_if        : stall_if                                              ,
        o_stall_id        : stall_id                                              ,
        o_stall_ex        : stall_ex                                              ,
        o_stall_mem       : stall_mem                                             ,
        i_direct_path_v   : direct_path_v                                          ,
        i_id_rs_eligible  : id_is_rs_eligible                                      ,
        o_flush_id        : flush_id                                              ,
        o_flush_ex        : flush_ex                                              ,
        o_load_use        : raw_load_use                                          ,
        o_dbg_stall_load_use: dbg_stall_load_use ,
        o_dbg_stall_mmu     : dbg_stall_mmu      ,
        o_dbg_stall_cache   : dbg_stall_cache    ,
        o_dbg_stall_rs      : dbg_stall_rs       ,
        o_dbg_stall_rob_full: dbg_stall_rob_full ,
    );

    // ============================================================
    // Forwarding unit
    // ============================================================
    inst u_fwd: forwarding_unit (
        i_rs1_addr     : id_rs1_addr                    ,
        i_rs2_addr     : id_rs2_addr                    ,
        i_exmem_rd     : ex_rd_addr                     ,
        // Suppress EX/MEM forwarding when dcache data is unreliable:
        // - MSHR absorbed load (dcache filling, rdata is stale)
        // - dcache stall (rdata not valid yet)
        // Also gate on ex_valid: registered ex_reg_wen/ex_rd_addr can carry
        // stale values from a previous instruction when ex is empty (e.g.
        // RS-eligible ID with no RS issue yet — execute latches i_reg_wen from
        // ID-stage combinational signals even though i_valid was 0).
        i_exmem_wen    : ex_valid && ex_reg_wen && !mshr_absorb && !dcache_stall,
        i_s1exwb_rd    : s1_ex_rd_addr                     ,
        // Disable slot1 forwarding: with RS-based OoO, slot1 results from
        // load_use_fill can be stale (wrong producer). The stale forwarding
        // detection only checks EX_MEM and MEM_WB, not S1_EX_WB.
        i_s1exwb_wen   : 1'b0                               ,
        i_memwb_rd     : mem_rd_addr                    ,
        // Gate MEM/WB forwarding on mem_valid for the same reason as above.
        i_memwb_wen    : mem_valid && mem_reg_wen       ,
        o_fwd_a        : fwd_a                          ,
        o_fwd_b        : fwd_b                          ,
        i_s1_rs1_addr  : s1_id_rs1_addr                 ,
        i_s1_rs2_addr  : s1_id_rs2_addr                 ,
        o_s1_fwd_a     : s1_fwd_a                       ,
        o_s1_fwd_b     : s1_fwd_b                       ,
        // FP forwarding (rs1/rs2/rs3 addresses from ID/EX pipeline register)
        i_fp_rs1_addr  : id_rs1_addr                    , // same field as integer
        i_fp_rs2_addr  : id_rs2_addr                    , // same field as integer
        i_fp_rs3_addr  : id_instr_shadow[31:27]         , // rs3 = instr[31:27]
        // Same gating rationale as integer i_exmem_wen/i_memwb_wen:
        // ex_fp_reg_wen / mem_fp_reg_wen are registered and can be stale
        // when ex/mem is empty (e.g., RS-eligible ID with no RS issue yet).
        i_exmem_fp_wen : ex_valid && ex_fp_reg_wen      ,
        i_memwb_fp_wen : mem_valid && mem_fp_reg_wen    ,
        o_fp_fwd_a     : fp_fwd_a                       ,
        o_fp_fwd_b     : fp_fwd_b                       ,
        o_fp_fwd_c     : fp_fwd_c                       ,
    );

    // ============================================================
    // IF stage
    // ============================================================
    // Combinational: is the instruction in EX a JALR? Must include RS-routed
    // path via ex_inst_is_jalr (covers both direct_path && id_is_jalr and
    // ex_from_rs && rs_issue_is_jalr). Without this, fetch redirect after a
    // RS-routed JALR misprediction goes to ex_branch_target (PC + imm) instead
    // of ex_jump_target (rs1 + imm), looping back to the JALR itself.
    // P3.4 (d).2: pipeline_is_jalr routes p34 replay through the branch_target
    // path (not jump_target).
    assign pipeline_is_jalr = if p34_replay_valid_q ? 1'b0 : ex_inst_is_jalr;

    // Instruction fetch MMU (Sv39 virtual-to-physical translation)
    var immu_paddr   : logic<64>;
    var immu_valid   : logic    ;
    var immu_fault   : logic    ;
    var immu_ptw_addr: logic<64>;
    var immu_ptw_req : logic    ;

    assign o_iptw_addr = immu_ptw_addr;
    assign o_iptw_req  = immu_ptw_req;

    inst u_immu: imem_mmu (
        clk                          ,
        rst                          ,
        i_vaddr       : if_pc        ,
        i_req         : 1'b1         ,
        o_paddr       : immu_paddr   ,
        o_valid       : immu_valid   ,
        o_fault       : immu_fault   ,
        o_busy        : immu_busy    ,
        i_satp        : csr_satp     ,
        i_priv        : csr_priv     ,
        i_sum         : csr_sum      ,
        i_mxr         : csr_mxr      ,
        o_ptw_addr    : immu_ptw_addr,
        o_ptw_req     : immu_ptw_req ,
        i_ptw_data    : i_iptw_rdata ,
        i_ptw_valid   : immu_ptw_req ,
        i_icache_stall: icache_stall ,
        // SFENCE.VMA must not fire while pipeline is stalled: if the preceding
        // instruction's PTW is in progress, sfence held in ID would reset the
        // MMU state machine every cycle, preventing the PTW from completing.
        i_sfence  : id_valid && id_is_sfence && !stall_id,
        i_redirect: pipeline_squash || trap_taken || mret_taken || sret_taken,
    );

    // I-Cache between fetch MMU and external instruction memory (32-bit)
    var icache_rdata     : logic<32>;
    var icache_rdata_next: logic<32>;

    inst u_icache: icache (
        clk                                                 ,
        rst                                                 ,
        i_addr      : immu_paddr                            ,
        i_ren       : immu_valid                            ,
        i_flush     : id_valid && id_is_fence_i && !stall_id,
        o_rdata     : icache_rdata                          ,
        o_rdata_next: icache_rdata_next                     ,
        o_stall     : icache_stall                          ,
        o_mem_addr  : o_imem_addr                           ,
        i_mem_rdata : i_imem_rdata                          ,
        o_mem_ren   : o_imem_ren                            ,
    );

    // Halfword selection for compressed instruction support
    let curr_halfword: logic<16> = if if_pc[1] ? icache_rdata[31:16] : icache_rdata[15:0];

    // Compressed instruction detection and expansion
    let is_compressed : logic     = curr_halfword[1:0] != 2'b11;
    var expanded_instr: logic<32>;
    var c_illegal     : logic    ;

    inst u_c_expander: c_expander (
        i_cinstr : curr_halfword ,
        o_instr  : expanded_instr,
        o_illegal: c_illegal     ,
    );

    // Select expanded or original instruction
    // Straddled case: 4-byte instruction at halfword boundary (PC[1]=1)
    // needs upper 16 bits from current word + lower 16 bits from next word
    let straddled_instr: logic<32> = {icache_rdata_next[15:0], icache_rdata[31:16]};
    let if_instr       : logic<32> = if is_compressed ? expanded_instr : if if_pc[1] ? straddled_instr : icache_rdata;

    // IF stage: detect branch/jal/jalr from fetched instruction opcode
    let if_opcode   : logic<7> = if_instr[6:0];
    let if_is_branch: logic    = if_opcode == 7'b1100011;
    let if_is_jal   : logic    = if_opcode == 7'b1101111;
    let if_is_jalr  : logic    = if_opcode == 7'b1100111;
    // JAL immediate decode (for prediction target)
    let if_jal_imm   : logic<64> = {if_instr[31] repeat 44, if_instr[19:12], if_instr[20], if_instr[30:21], 1'b0};
    let if_jal_target: logic<64> = if_pc + if_jal_imm;
    // B-type immediate decode (for conditional branch prediction target)
    let if_branch_imm   : logic<64> = {if_instr[31] repeat 52, if_instr[7], if_instr[30:25], if_instr[11:8], 1'b0};
    let if_branch_target: logic<64> = if_pc + if_branch_imm;
    // Local BHT prediction read
    let local_bht_idx  : logic<8> = if_pc[9:2];
    let local_bht_taken: logic    = local_bht[local_bht_idx][1]; // MSB = predict taken
    // BHT update index uses ex_inst_pc, which is defined later; declared here
    // as var and assigned in the EX-stage section.
    var bht_upd_idx: logic<8>;

    // RAS: RISC-V call/return detection from IF instruction
    // Call: JAL/JALR with rd = x1 or x5 (link registers)
    // Return: JALR with rd = x0, rs1 = x1 or x5
    let if_rd : logic<5> = if_instr[11:7];
    let if_rs1: logic<5> = if_instr[19:15];
    let if_rd_is_link : logic = if_rd == 5'd1 || if_rd == 5'd5;
    let if_rs1_is_link: logic = if_rs1 == 5'd1 || if_rs1 == 5'd5;
    let if_is_call  : logic = (if_is_jal || if_is_jalr) && if_rd_is_link;
    // Return detection: JALR with rs1=link && rd!=link. imm value not
    // constrained — the return target is the top-of-RAS regardless of imm
    // (some returns use non-zero imm for tail-call-like patterns; RAS still
    // predicts the correct callee return site).
    let if_jalr_imm  : logic<12> = if_instr[31:20];
    let _if_jalr_imm_unused: logic<12> = if_jalr_imm;
    let if_is_return : logic     = if_is_jalr && !if_rd_is_link && if_rs1_is_link;
    let if_link_addr: logic<64> = if is_compressed ? if_pc + 64'd2 : if_pc + 64'd4;
    // RAS prediction: return target from top of stack (only if stack non-empty)
    var ras_count: logic<5>; // number of valid entries (0..8)
    let ras_predict_target: logic<64> = ras_stack[ras_ptr - 3'd1];
    let ras_predict_valid : logic     = if_is_return && ras_count != 5'd0;

    // ============================================================
    // Dual fetch: second instruction (slot1) detection
    // ============================================================
    let slot0_size  : logic<3>  = if is_compressed ? 3'd2 : 3'd4;
    let slot1_pc    : logic<64> = if_pc + {61'd0, slot0_size};
    // slot1 raw halfword from icache
    let slot1_halfword: logic<16> = if is_compressed ?
        (if if_pc[1] ? icache_rdata_next[15:0] : icache_rdata[31:16])
    :
        (if if_pc[1] ? icache_rdata_next[31:16] : icache_rdata_next[15:0])
    ;
    let slot1_is_compressed: logic = slot1_halfword[1:0] != 2'b11;
    var slot1_expanded: logic<32>;
    var slot1_c_illegal: logic;
    inst u_c_expander_s1: c_expander (
        i_cinstr : slot1_halfword,
        o_instr  : slot1_expanded,
        o_illegal: slot1_c_illegal,
    );
    let slot1_word : logic<32> = icache_rdata_next;
    let slot1_instr: logic<32> = if slot1_is_compressed ? slot1_expanded : slot1_word;
    // Dual fetch valid: slot1 is valid when slot0 is not control-flow
    let slot0_is_control: logic = if_is_jal || if_is_jalr || if_is_branch ||
        (if_instr[6:0] == 7'b1110011) || (if_instr[6:0] == 7'b0001111) || (if_instr[6:0] == 7'b0101111);
    // slot1 must be in the same icache line as slot0 (64B line, bits[5:0] = byte offset within line)
    let slot1_same_line: logic = if_pc[63:6] == slot1_pc[63:6];
    // Suppress dual fetch when slot0 is halfword-aligned (PC[1]=1):
    // slot1 data extraction from icache_rdata_next is only correct when
    // both slot0 and slot1 are word-aligned.  Halfword-aligned PCs arise
    // from compressed instructions and make slot1 straddle word boundaries,
    // which icache_rdata_next alone cannot satisfy.
    // Dual fetch requires both slot0 and slot1 to be word-aligned.
    // slot1_pc[1]=1 means slot1 straddles word boundaries, and
    // icache_rdata_next alone cannot provide the full 32-bit encoding.
    let slot1_word_aligned: logic = !slot1_pc[1];
    // Dual fetch: slot1 is available when slot0 is not control-flow, both
    // slots are word-aligned and in the same cache line.
    // Suppress dual fetch when slot1 is compressed-illegal (e.g., .word 0
    // in riscv-tests) to avoid PDB storing a misidentified instruction.
    let slot1_c_ill: logic = slot1_is_compressed && slot1_c_illegal;
    let dual_fetch_valid: logic = !slot0_is_control && !icache_stall && !immu_busy && !pdb_valid && !if_predict_taken && slot1_same_line && !if_pc[1] && slot1_word_aligned && !slot1_c_ill;

    // ============================================================
    // Slot1 decode (combinational): decoder + imm_gen for dual-issue
    // ============================================================
    var s1_dec_alu_op   : alu_pkg::AluOp       ;
    var s1_dec_alu_src_a: pipeline_pkg::AluSrcA ;
    var s1_dec_alu_src_b: pipeline_pkg::AluSrcB ;
    var s1_dec_imm_type : riscv_pkg::ImmType    ;
    var s1_dec_wb_sel   : pipeline_pkg::WbSel   ;
    var s1_dec_reg_wen  : logic                 ;
    var s1_dec_mem_ren  : logic                 ;
    var s1_dec_mem_wen  : logic                 ;
    var s1_dec_is_branch: logic                 ;
    var s1_dec_is_jal   : logic                 ;
    var s1_dec_is_jalr  : logic                 ;
    var s1_dec_is_ecall : logic                 ;
    var s1_dec_is_ebreak: logic                 ;
    var s1_dec_is_mret  : logic                 ;
    var s1_dec_is_wfi   : logic                 ;
    var s1_dec_is_csr   : logic                 ;
    var s1_dec_illegal  : logic                 ;
    var s1_dec_is_amo   : logic                 ;
    var s1_dec_is_fp    : logic                 ;
    var s1_dec_is_sfence: logic                 ;
    var s1_dec_is_fence_i: logic                ;
    var s1_dec_is_fence : logic                 ;

    inst u_decoder_s1: decoder (
        i_instr     : s1_ifid_instr    ,
        o_alu_op    : s1_dec_alu_op    ,
        o_alu_src_a : s1_dec_alu_src_a ,
        o_alu_src_b : s1_dec_alu_src_b ,
        o_imm_type  : s1_dec_imm_type  ,
        o_wb_sel    : s1_dec_wb_sel    ,
        o_reg_wen   : s1_dec_reg_wen   ,
        o_mem_ren   : s1_dec_mem_ren   ,
        o_mem_wen   : s1_dec_mem_wen   ,
        o_is_branch : s1_dec_is_branch ,
        o_is_jal    : s1_dec_is_jal    ,
        o_is_jalr   : s1_dec_is_jalr   ,
        o_is_ecall  : s1_dec_is_ecall  ,
        o_is_ebreak : s1_dec_is_ebreak ,
        o_is_mret   : s1_dec_is_mret   ,
        o_is_wfi    : s1_dec_is_wfi    ,
        o_csr_op    : _                ,
        o_is_csr    : s1_dec_is_csr    ,
        o_csr_imm   : _                ,
        o_illegal   : s1_dec_illegal   ,
        o_is_amo    : s1_dec_is_amo    ,
        o_amo_funct5: _                ,
        o_is_fp     : s1_dec_is_fp     ,
        o_fp_reg_wen: _                ,
        o_fp_int_wen: _                ,
        o_fpu_op    : _                ,
        o_fp_rm     : _                ,
        o_fp_rs3_addr: _               ,
        o_is_sfence : s1_dec_is_sfence ,
        o_is_fence_i: s1_dec_is_fence_i,
        o_is_fence  : s1_dec_is_fence  ,
    );

    var s1_dec_imm: logic<64>;
    inst u_imm_gen_s1: imm_gen (
        i_instr   : s1_ifid_instr   ,
        i_imm_type: s1_dec_imm_type ,
        o_imm     : s1_dec_imm      ,
    );

    // Slot1 is a simple ALU instruction (eligible for dual-issue)
    let slot1_opcode: logic<7> = slot1_instr[6:0];
    let slot1_is_alu: logic = slot1_opcode == 7'b0110011 // OP (ADD/SUB/MUL/...)
                           || slot1_opcode == 7'b0111011 // OP-32 (ADDW/SUBW/...)
                           || slot1_opcode == 7'b0010011 // OP-IMM (ADDI/SLTI/...)
                           || slot1_opcode == 7'b0011011 // OP-IMM-32 (ADDIW/...)
                           || slot1_opcode == 7'b0110111 // LUI
                           || slot1_opcode == 7'b0010111 // AUIPC
                           ;

    // Intra-pair RAW hazard: slot0 writes rd that slot1 reads
    let slot1_rs1: logic<5> = slot1_instr[19:15];
    let slot1_rs2: logic<5> = slot1_instr[24:20];
    let slot0_rd : logic<5> = if_instr[11:7];
    let slot1_rd : logic<5> = slot1_instr[11:7];
    // Intra-pair RAW: only suppress when slot0 is a load (data not available
    // in EX stage). For ALU slot0, same-cycle forwarding (SLOT0_EX) resolves it.
    // Intra-pair RAW: only block when slot0 is a LOAD (data not available
    // in EX stage). For ALU slot0, same-cycle SLOT0_EX forwarding resolves it.
    let slot0_is_load: logic = if_instr[6:0] == 7'b0000011;
    let intra_pair_raw: logic = slot0_is_load && slot0_rd != 5'd0 &&
        (slot0_rd == slot1_rs1 || slot0_rd == slot1_rs2);
    // Intra-pair WAW: both write the same register
    let intra_pair_waw: logic = slot0_rd != 5'd0 && slot0_rd == slot1_rd;
    // Cross-pair WAW: slot1's rd matches an in-flight slot0 instruction
    // that hasn't retired yet. Slot0@WB writes AFTER slot1@WB1, so
    // slot0 would incorrectly overwrite slot1's newer value.
    // Check all in-flight stages for WAW with slot1 (including IF/ID)
    let ifid_rd: logic<5> = ifid_instr[11:7];
    let cross_pair_waw: logic = slot1_rd != 5'd0 &&
        ((ifid_valid && ifid_rd == slot1_rd) ||
         (id_reg_wen && id_rd_addr == slot1_rd) ||
         (ex_reg_wen && ex_rd_addr == slot1_rd) ||
         (mem_reg_wen && mem_rd_addr == slot1_rd));

    // slot0 is also a simple ALU instruction (no load/store/branch/CSR/FP)
    let slot0_opcode: logic<7> = if_instr[6:0];
    let slot0_is_alu: logic = slot0_opcode == 7'b0110011 // OP
                           || slot0_opcode == 7'b0111011 // OP-32
                           || slot0_opcode == 7'b0010011 // OP-IMM
                           || slot0_opcode == 7'b0011011 // OP-IMM-32
                           || slot0_opcode == 7'b0110111 // LUI
                           || slot0_opcode == 7'b0010111 // AUIPC
                           ;
    // Dual-issue decision: both slot0 and slot1 must be simple ALU
    // Suppress dual issue when slot1 IF/ID or ID/EX still holds a valid
    // instruction from a previous dual-issue (e.g. after icache stall).
    let s1_pipe_busy: logic = s1_ifid_valid || s1_id_valid;
    // Also suppress dual issue when a slot1 result is still in the EX/WB
    // pipeline, to avoid cross-pair ordering issues during trap/mret sequences.
    // Also suppress when s1_wb_wen active (slot1 result being committed)
    let s1_all_clear: logic = !s1_ifid_valid && !s1_id_valid && !s1_ex_valid && !s1_wb_wen;
    let dual_issue  : logic = dual_fetch_valid && slot0_is_alu && slot1_is_alu && !intra_pair_raw && !intra_pair_waw && !cross_pair_waw && s1_all_clear && !stall_if && !flush_id;

    // ============================================================
    // Load-use bubble fill: issue IF instruction to slot1 during
    // load-use stall to fill the 1-cycle bubble with useful work.
    // ============================================================
    // IF instruction (C) field extraction (if_instr is already expanded)
    let fill_rs1   : logic<5> = if_instr[19:15];
    let fill_rs2   : logic<5> = if_instr[24:20];
    let fill_rd    : logic<5> = if_instr[11:7];
    let fill_opcode: logic<7> = if_instr[6:0];
    // C is a simple ALU instruction (same criteria as slot1_is_alu)
    let fill_is_alu: logic = fill_opcode == 7'b0110011 // OP
                          || fill_opcode == 7'b0111011 // OP-32
                          || fill_opcode == 7'b0010011 // OP-IMM
                          || fill_opcode == 7'b0011011 // OP-IMM-32
                          || fill_opcode == 7'b0110111 // LUI
                          || fill_opcode == 7'b0010111 // AUIPC
                          ;
    // C is independent of ALL pending writes (RAT-based):
    // no pending ROB entry for either source register
    let fill_independent: logic = !rat_fill_rs1_valid && !rat_fill_rs2_valid;
    // C is independent of B (stalled in IF/ID): C's sources don't read B's rd
    let b_rd             : logic<5> = ifid_instr[11:7];
    let fill_b_independent: logic = b_rd == 5'd0
                                 || (b_rd != fill_rs1 && b_rd != fill_rs2);
    // No WAW: C's rd doesn't conflict with any in-flight instruction
    let fill_no_waw: logic = fill_rd == 5'd0
                          || (fill_rd != b_rd
                           && fill_rd != id_rd_addr
                           && fill_rd != ex_rd_addr
                           && fill_rd != mem_rd_addr);
    // Pipeline redirect: trap, mret, sret, misprediction
    // Misprediction gated by dcache/mmu stall (can't redirect until memory op completes)
    let redirect_active: logic = trap_taken || mret_taken || sret_taken
                              || (pipeline_squash && !dcache_stall && !mmu_stall);
    // Bubble fill: only when both load_use AND ex_load_use agree.
    // raw_load_use (= sb_stall) includes rat_mem_stall, but ex_load_use
    // is pure 1-cycle load-use. When rat_mem_stall fires without ex_load_use,
    // the fill is suppressed to prevent multi-cycle PC advance (instruction skip).
    // Bubble fill: use ex_load_use (not raw_load_use) to prevent PC advance
    // during multi-cycle rat_mem_stall (which is included in sb_stall/raw_load_use).
    // Slot 1 bubble-fill disabled: races with RS dispatch. Slot 1 writes directly
    // to regfile without allocating a ROB entry, so RS-dispatched instructions
    // that depend on a slot-1 writer capture stale operand values (slot 1 is
    // 1-2 cycles behind in the pipeline, its write hasn't landed yet).
    let load_use_fill: logic = 1'b0 && ex_load_use && fill_is_alu
                            && fill_independent && fill_b_independent && fill_no_waw
                            && s1_all_clear && !redirect_active
                            && !icache_stall && !immu_busy && !pdb_valid;

    inst u_bp: branch_predictor (
        clk                                ,
        rst                                ,
        i_pc            : if_pc            ,
        i_is_branch     : if_is_branch     ,
        i_is_jal        : if_is_jal        ,
        i_is_jalr       : if_is_jalr       ,
        o_predict_taken : bp_predict_taken ,
        o_predict_target: bp_predict_target,
        // Flush BTB/BHT on SFENCE.VMA, FENCE.I, or SATP write (virtual
        // address mapping change invalidates cached branch targets).
        i_flush: (id_valid && (id_is_sfence || id_is_fence_i || (id_is_csr && id_csr_addr == csr_pkg::CSR_SATP)) && !stall_id),
        // ex_* describe the instruction at EX (direct-path id_* OR RS-routed
        // rs_issue_*). ex_branch_taken/target are combinational EX-stage outputs.
        i_update_valid    : ex_in_valid && !stall_ex                                ,
        i_update_pc       : ex_inst_pc                                              ,
        i_update_taken    : ex_branch_taken                                         ,
        i_update_target   : if ex_inst_is_jalr ? ex_jump_target : ex_branch_target  ,
        i_update_is_branch: ex_inst_is_branch                                       ,
    );

    var fetch_imem_addr: logic<64>; // unused, icache drives o_imem_addr

    inst u_fetch: fetch #(
        RESET_PC  ,
    ) (
        clk                                                        ,
        rst                                                        ,
        i_stall         : stall_if                                 ,
        i_branch_taken  : pipeline_squash                          ,
        i_branch_target : pipeline_branch_target                   ,
        i_jump_target   : ex_jump_target                           ,
        i_is_jalr       : pipeline_is_jalr                         ,
        i_trap_taken    : trap_taken                               ,
        i_trap_target   : trap_target                              ,
        i_mret_taken    : mret_taken || sret_taken                 ,
        i_mret_target   : if sret_taken ? csr_sret_pc : csr_mret_pc,
        i_is_compressed : is_compressed                            ,
        // Branch prediction: JAL (always taken) + BHT (conditional) + RAS (return)
        i_predict_taken : (if_is_jal || (if_is_branch && local_bht_taken) || ras_predict_valid) && !icache_stall && !immu_busy ,
        i_predict_target: if ras_predict_valid ? ras_predict_target : if if_is_jal ? if_jal_target : if_branch_target          ,
        i_pdb_valid     : pdb_valid                                                                        ,
        i_dual_fetch    : dual_fetch_valid                                                                 ,
        i_slot1_size    : if slot1_is_compressed ? 3'd2 : 3'd4                                             ,
        i_load_use_fill : load_use_fill                                                                    ,
        o_pc            : if_pc                                    ,
        o_imem_addr     : fetch_imem_addr                          ,
        o_predict_taken : if_predict_taken                         ,
    );

    // IF/ID pipeline register
    // Latches validity and PC of the instruction entering ID stage.
    // ifid_pc holds the fetch PC so that AUIPC and JAL/JALR link
    // computations in later stages use the correct instruction address.
    always_ff (clk, rst) {
        if_reset {
            ifid_valid         = 1'b1;
            ifid_pc            = '0;
            ifid_instr         = 32'h00000013; // NOP
            ifid_compressed    = 1'b0;
            ifid_c_illegal     = 1'b0;
            ifid_predict_taken  = 1'b0;
            s1_ifid_valid       = 1'b0;
            s1_ifid_pc          = '0;
            s1_ifid_instr       = 32'h00000013;
            s1_id_valid         = 1'b0;
            s1_id_pc            = '0;
            s1_id_rs1_data      = '0;
            s1_id_rs2_data      = '0;
            s1_id_imm           = '0;
            s1_id_rd_addr       = 5'd0;
            s1_id_rs1_addr      = 5'd0;
            s1_id_rs2_addr      = 5'd0;
            s1_id_alu_op        = alu_pkg::AluOp::ADD;
            s1_id_alu_src_a     = pipeline_pkg::AluSrcA::REG;
            s1_id_alu_src_b     = pipeline_pkg::AluSrcB::REG;
            s1_id_reg_wen       = 1'b0;
            pdb_valid           = 1'b0;
            pdb_pc              = '0;
            pdb_instr           = 32'h00000013;
            pdb_compressed      = 1'b0;
            pdb_c_illegal       = 1'b0;

            _mshr_count         = 16'd0;
            mshr_valid          = 1'b0;
            mshr_rd_addr        = 5'd0;
            mshr_funct3         = 3'd0;
            mshr_byte_off       = 3'd0;
            mshr_is_fp          = 1'b0;
            mshr_fp_reg_wen     = 1'b0;
            mshr_rob_idx        = 5'd0;
            mshr_epoch          = 2'b0;
            mshr_pc             = 64'd0;
            mshr_lq_idx         = 3'd0;
            mshr_was_lq         = 1'b0;
            speculative_if      = 1'b0;
            bp_predict_taken_q  = 1'b0;
            bp_predict_target_q = '0;
            // Shadow pipeline for trap_val (instruction encoding)
            id_instr_shadow = 32'h00000013;
            ex_instr_shadow = 32'h00000013;
            id_csr_fault_q  = 1'b0;
            xret_taken_q    = 1'b0;
            wfi_halt        = 1'b0;
            id_rob_idx      = 5'd0;
            id_epoch        = 2'b0;
            ex_rob_idx      = 5'd0;
            ex_epoch        = 2'b0;
            ex_from_rs_q    = 1'b0;
            mem_from_rs     = 1'b0;
            commit_bypass_valid = 1'b0;
            rs_yield        = 1'b0;
            srs_yield       = 1'b0;
            lq_yield        = 1'b0;
            id_has_rob      = 1'b0;
            _ex_rob_idx_q   = 5'd0;
            rs_dispatched_q = 1'b0;
            srs_dispatched_q = 1'b0;
            lq_id_dispatched_q = 1'b0;
            direct_path_dispatched_q = 1'b0;
            direct_path_operand_captured_q = 1'b0;
            direct_path_rs1_q = 64'd0;
            direct_path_rs2_q = 64'd0;
            ex_from_srs_q   = 1'b0;
            ex_from_srs_q_addr = 64'd0;
            ex_from_lq_q    = 1'b0;
            lq_reinject_idx_q = 3'd0;
            mem_from_lq     = 1'b0;
            mem_reinject_idx = 3'd0;
            wb_from_lq      = 1'b0;
        } else {
            // Track mret/sret for 1-cycle interrupt suppression
            xret_taken_q = mret_taken || sret_taken;

            // WFI halt disabled (see declaration comment).
            wfi_halt = 1'b0;

            // (pend_trap register updated in separate always_ff below trap signals)
            // Capture ROB commit for next-cycle bypass (handles same-cycle
            // commit+regfile-read race where NBA invalidates rob_commit_valid).
            commit_bypass_valid = rob_commit_valid && rob_commit_wen;
            commit_bypass_rd    = rob_commit_rd;
            commit_bypass_data  = rob_commit_data;
            // Track speculative IF: true when IF is on a predicted path
            // that hasn't been verified. Stays true during stalls (e.g., IMMU
            // PTW for the speculative address). Cleared when the stall ends
            // (instruction enters IF/ID) or on pipeline flush.
            // Speculative IF: set when prediction steers PC, cleared when:
            // - Pipeline flush (misprediction/trap)
            // - IMMU fault on speculative path: the prediction was correct but
            //   the target page is not mapped. Clear speculative_if so the fault
            //   is raised as a real page fault on the next cycle, letting the
            //   kernel's page fault handler map the page.
            let speculative_fault: logic = speculative_if && immu_fault;
            speculative_if = (if_predict_taken || (speculative_if && stall_if)) && !flush_id && !trap_taken && !speculative_fault;
            // Latch prediction signals to cut cross-module comb chain
            bp_predict_taken_q  = bp_predict_taken;
            bp_predict_target_q = bp_predict_target;
            // IF/ID pipeline register
            if flush_id && !stall_if {
                ifid_valid          = 1'b0;
                ifid_pc             = if_pc;
                ifid_instr          = 32'h00000013;
                ifid_compressed     = 1'b0;
                ifid_c_illegal      = 1'b0;
                ifid_predict_taken  = 1'b0;
                ifid_predict_target = '0;
            } else if !stall_if && pdb_valid {
                // PDB drain: feed buffered instruction to IF/ID
                ifid_valid          = 1'b1;
                ifid_pc             = pdb_pc;
                ifid_instr          = pdb_instr;
                ifid_compressed     = pdb_compressed;
                ifid_c_illegal      = pdb_c_illegal;
                ifid_predict_taken  = 1'b0; // PDB instructions have no prediction
                ifid_predict_target = '0;
            } else if !stall_if {
                ifid_valid          = 1'b1;
                ifid_pc             = if_pc;
                ifid_instr          = if_instr;
                ifid_compressed     = is_compressed;
                ifid_c_illegal      = is_compressed && c_illegal;
                ifid_predict_taken  = if_predict_taken;
                ifid_predict_target = if ras_predict_valid ? ras_predict_target
                                    : if if_is_jal ? if_jal_target
                                    : if_branch_target;
            } else if !stall_id {
                // stall_if=1 && stall_id=0: IFID is being consumed by ID but IF
                // can't advance. Mark IFID as consumed (valid=0) to prevent ROB
                // double-allocation on subsequent cycles where decode re-latches
                // the held IFID content. Keep PC/instruction for diagnostics.
                ifid_valid = 1'b0;
            }

            // PDB management: flush on redirect or trap, but NOT on load-use
            // hazard stall (flush_id with stall_if means load-use bubble;
            // the PDB instruction hasn't entered IF/ID yet and must be kept).
            if (flush_id && !stall_if) || trap_taken {
                pdb_valid = 1'b0;
            } else if !stall_if && dual_fetch_valid && !pdb_valid {
                // Dual fetch but no dual issue: store slot1 in PDB
                pdb_valid      = 1'b1;
                pdb_pc         = slot1_pc;
                pdb_instr      = slot1_instr;
                pdb_compressed = slot1_is_compressed;
                pdb_c_illegal  = slot1_is_compressed && slot1_c_illegal;
            } else if !stall_if && pdb_valid && !flush_id {
                // PDB drain: consumed into IF/ID above
                pdb_valid = 1'b0;
            }

            // Slot1 IF/ID pipeline register: flush on redirect (not load-use),
            // fill on load_use_fill, hold during stall.
            // Separate redirect flush from hazard flush: load-use hazard flush
            // must NOT clear s1_ifid when we're filling the bubble.
            if redirect_active {
                s1_ifid_valid = 1'b0;
            } else if load_use_fill {
                // Fill bubble: latch IF instruction (C) into slot1
                s1_ifid_valid = 1'b1;
                s1_ifid_pc    = if_pc;
                s1_ifid_instr = if_instr;
            } else if !stall_if && dual_issue {
                s1_ifid_valid = 1'b1;
                s1_ifid_pc    = slot1_pc;
                s1_ifid_instr = slot1_instr;
            } else if !stall_if {
                s1_ifid_valid = 1'b0;
            }
            // (stall_if: s1_ifid holds its current value)

            // Slot1 ID/EX pipeline register: flush on redirect (not load-use stall),
            // hold during stall_id.
            if (flush_id && !stall_id) || flush_ex {
                s1_id_valid = 1'b0;
                s1_id_reg_wen = 1'b0;
            } else if !stall_id {
                s1_id_valid     = s1_ifid_valid;
                s1_id_pc        = s1_ifid_pc;
                s1_id_rs1_data  = s1_rs1_raw;
                s1_id_rs2_data  = s1_rs2_raw;
                s1_id_imm       = s1_dec_imm;
                s1_id_rd_addr   = s1_ifid_instr[11:7];
                s1_id_rs1_addr  = s1_ifid_instr[19:15];
                s1_id_rs2_addr  = s1_ifid_instr[24:20];
                s1_id_alu_op    = s1_dec_alu_op;
                s1_id_alu_src_a = s1_dec_alu_src_a;
                s1_id_alu_src_b = s1_dec_alu_src_b;
                s1_id_reg_wen   = s1_ifid_valid && s1_dec_reg_wen;
            }

            // Shadow pipeline: ID stage (synced with decode pipeline register)
            if flush_id {
                id_instr_shadow = 32'h00000013;
            } else if !stall_id {
                id_instr_shadow = ifid_instr;
            }
            // Shadow pipeline: EX stage (synced with execute pipeline register)
            if flush_ex {
                ex_instr_shadow = 32'h00000013;
            } else if !stall_ex {
                ex_instr_shadow = id_instr_shadow;
            }
            // CSR access fault: registered in sync with decode output.
            // Captures the combinational fault for the instruction currently
            // in the decode output (ID/EX register) so it reaches execute
            // without adding CSR FF variables to the comb path.
            if flush_id {
                id_csr_fault_q = 1'b0;
            } else if !stall_id {
                id_csr_fault_q = id_is_csr && csr_access_fault;
            }

            // RS dispatched tracking: set when dispatch succeeds, clear when
            // new instruction enters ID or on flush/redirect.
            if flush_id || !stall_id {
                rs_dispatched_q = 1'b0;
            } else if rs_dispatch_valid && rs_dispatch_ready {
                rs_dispatched_q = 1'b1;
            }

            // SRS dispatched tracking: mirror rs_dispatched_q for stores.
            if flush_id || !stall_id {
                srs_dispatched_q = 1'b0;
            } else if srs_dispatch_valid {
                srs_dispatched_q = 1'b1;
            }

            // LQ-ID dispatched tracking: load was alloc'd to LQ at ID — do
            // not re-dispatch while ID still holds the same instruction.
            if flush_id || !stall_id {
                lq_id_dispatched_q = 1'b0;
            } else if lq_id_alloc_fire {
                lq_id_dispatched_q = 1'b1;
            }

            // Direct-path dispatched tracking: set when direct_path_v fires
            // and the pipeline accepts the instruction into EX (!stall_ex).
            // Clears when ID advances so the next instruction can dispatch.
            if flush_id || !stall_id {
                direct_path_dispatched_q = 1'b0;
            } else if direct_path_v && !stall_ex {
                direct_path_dispatched_q = 1'b1;
            }

            // Direct-path operand capture: latch at the same cycle the
            // pipeline reg latches (direct_path_v && !stall_ex), freezing
            // the authoritative forwarded operand. Clears when instruction
            // leaves ID, matching dispatched_q's lifetime.
            if flush_id || !stall_id {
                direct_path_operand_captured_q = 1'b0;
                direct_path_rs1_q              = 64'd0;
                direct_path_rs2_q              = 64'd0;
            } else if direct_path_v && !stall_ex && !direct_path_operand_captured_q {
                direct_path_operand_captured_q = 1'b1;
                direct_path_rs1_q              = ex_dbg_fwd_rs1;
                direct_path_rs2_q              = ex_dbg_fwd_rs2;
            }

            // RS starvation prevention: yield EX to RS after 1 cycle of blocking.
            // Use rs_sel_valid (RS has ready entry) instead of rs_issue_valid
            // (latched output) — otherwise when RS has a ready entry but
            // i_issue_stall=1 (due to direct_path_v), rs_issue_valid stays 0
            // and rs_yield never fires → deadlock.
            rs_yield = (rs_issue_valid || rs_sel_valid) && direct_path_v;
            // SRS starvation prevention (bug-b): yield EX to SRS when an SRS
            // store is ready but blocked by direct_path_v. Without this, a
            // direct-path command held by stall_id (e.g. IRQ wait while ROB
            // drains) keeps direct_path_v=1, starves SRS issue, and SRS-head
            // stores never complete → ROB drain deadlock.
            srs_yield = (srs_issue_valid || srs_cand_valid) && direct_path_v;
            // LQ starvation prevention (bug-b residual): yield EX to LQ
            // reinject when an LQ entry is ready (data resolved) but blocked
            // by direct_path_v. Same deadlock pattern as srs_yield: held ID
            // command keeps direct_path_v=1 forever, LQ-head load can't
            // re-inject, never completes, ROB drain stuck.
            lq_yield = lq_reinject_valid && direct_path_v;

            // ROB index pipeline registers (synced with decode/execute/memory)
            // Process later stages first: within always_ff, assignments are
            // sequential (blocking). Reading before writing ensures each stage
            // captures the OLD value from the previous stage.
            // Pipeline stage registers: process later stages FIRST (sequential semantics).
            // MEM reads ex_rob_idx BEFORE EX writes it — correct within same always_ff.

            // mem_rob_idx and mem_epoch are now driven by the memory module's
            // registered output (o_rob_idx, o_rob_epoch) — no shadow needed.
            // Only mem_from_rs remains as a shadow pipeline register.
            if trap_taken {
                mem_from_rs = 1'b0;
                mem_from_lq = 1'b0;
            } else if !stall_mem {
                mem_from_rs = ex_from_rs_q;
                mem_from_lq = ex_from_lq_q;
                mem_reinject_idx = lq_reinject_idx_q;
            }
            // WB-stage shadow of mem_from_lq, advanced at MEM→WB edge.
            // Used to gate the normal regfile write so the LQ retire is
            // the sole writer for re-injected loads.
            if trap_taken {
                wb_from_lq = 1'b0;
            } else if !stall_mem {
                wb_from_lq = mem_from_lq;
            }
            if flush_ex {
                ex_rob_idx       = 5'd0;
                ex_epoch         = 2'b0;
                ex_from_rs_q     = 1'b0;
                ex_from_srs_q    = 1'b0;
                ex_from_lq_q     = 1'b0;
                lq_reinject_idx_q = 3'd0;
            } else if !stall_ex {
                if direct_path_v {
                    ex_rob_idx    = id_rob_idx;
                    ex_epoch      = id_epoch;
                    ex_from_rs_q  = 1'b0;
                    ex_from_srs_q = 1'b0;
                    ex_from_lq_q  = 1'b0;
                } else if rs_issue_valid && !rs_issue_stall {
                    ex_rob_idx    = rs_issue_rob;
                    ex_epoch      = rs_issue_epoch;
                    ex_from_rs_q  = 1'b1;
                    ex_from_srs_q = 1'b0;
                    ex_from_lq_q  = 1'b0;
                // SRS-3b: SRS is issue-stalled (i_issue_stall=1'b1), so
                // srs_issue_valid=0 and this branch stays dead during step 3b.
                // Flipped live with i_issue_stall in 3c.
                } else if srs_issue_valid {
                    ex_rob_idx    = srs_issue_rob;
                    ex_epoch      = srs_issue_epoch;
                    ex_from_rs_q  = 1'b0;
                    ex_from_srs_q = 1'b1;
                    ex_from_lq_q  = 1'b0;
                    // Effective VA = base + immediate. Used by the direct-
                    // path load drain probe so subsequent loads can skip
                    // the stall when they don't alias this in-flight store.
                    ex_from_srs_q_addr = srs_issue_s1_data + srs_issue_imm;
                } else if fp_rs_issue_valid {
                    ex_rob_idx    = fp_rs_issue_rob;
                    ex_epoch      = fp_rs_issue_epoch;
                    ex_from_rs_q  = 1'b0; // shadowed RS flag used by MEM forwarding — FP RS not tracked
                    ex_from_srs_q = 1'b0;
                    ex_from_lq_q  = 1'b0;
                } else if lq_reinject_valid {
                    ex_rob_idx    = lq_reinject_rob;
                    ex_epoch      = lq_reinject_epoch;
                    ex_from_rs_q  = 1'b0;
                    ex_from_srs_q = 1'b0;
                    ex_from_lq_q  = 1'b1;
                    lq_reinject_idx_q = lq_reinject_idx;
                } else {
                    ex_rob_idx    = 5'd0;
                    ex_epoch      = 2'b0;
                    ex_from_rs_q  = 1'b0;
                    ex_from_srs_q = 1'b0;
                    ex_from_lq_q  = 1'b0;
                }
            }
            if flush_id {
                id_rob_idx = 5'd0;
                id_epoch   = 2'b0;
                id_has_rob = 1'b0;
            } else if !stall_id {
                id_rob_idx = rob_alloc_idx;
                id_epoch   = rob_alloc_epoch;
                // ROB alloc succeeds when rob_alloc_ready and ifid_valid
                id_has_rob = rob_alloc_ready && ifid_valid;
            } else if direct_path_v && !stall_ex {
                // Instruction entered EX while ID is stalled (ROB full) —
                // clear id_has_rob to prevent double-issue on the next cycle.
                id_has_rob = 1'b0;
            }

            if mshr_absorb {
                _mshr_count = _mshr_count + 16'd1;
            }
            // MSHR lifecycle
            if trap_taken || mret_taken || sret_taken {
                // Invalidate on trap: fill continues (populates cache), result discarded
                mshr_valid = 1'b0;
            } else if pipeline_squash && rob_squash_mask[mshr_rob_idx] {
                // P3.2 Stage 2d: squash invalidates MSHR if its captured load
                // is in the squash range. Without this, the OLD MSHR fill
                // would silently drop on arrival (LQ entry gone) and the
                // re-fetched load can't enter MSHR (full) → deadlock.
                mshr_valid = 1'b0;
            } else if mshr_absorb {
                // Capture load metadata from EX/MEM pipeline register
                mshr_valid      = 1'b1;
                mshr_rd_addr    = ex_rd_addr;
                mshr_funct3     = ex_mem_funct3;
                mshr_byte_off   = ex_alu_out[2:0];
                mshr_is_fp      = ex_is_fp;
                mshr_fp_reg_wen = ex_fp_reg_wen;
                mshr_rob_idx    = ex_rob_idx;
                mshr_epoch      = ex_epoch;
                mshr_pc         = ex_pc;
                // P3.2 Stage 2c: re-injected load already has an LQ entry.
                // Route MSHR fill to that existing entry (lq_reinject_idx_q)
                // so its data_ready can be set, instead of taking the normal
                // mshr_int_wb completion path.
                mshr_lq_idx     = if ex_from_lq_q ? lq_reinject_idx_q : lq_alloc_idx;
                mshr_was_lq     = lq_alloc_gate || ex_from_lq_q;
            } else if mshr_wb_valid {
                // Fill complete, regfile write done
                mshr_valid = 1'b0;
            }
        }
    }

    // RAS update: non-speculative, from EX stage. The instruction at EX may
    // be direct-path (id_*) or RS-routed (rs_issue_*); pick fields accordingly.
    // Push on committed call (JAL/JALR with rd=x1/x5).
    // Pop on committed return (JALR with rd!=link, rs1=link).
    // JAL stays direct (no operand deps); JALR may be RS-routed.
    assign ex_rd               = if ex_from_rs ? rs_issue_rd            : id_rd_addr;
    assign ex_rs1              = if ex_from_rs ? rs_issue_rs1           : id_rs1_addr;
    assign ex_inst_pc          = if ex_from_rs ? rs_issue_pc            : id_pc;
    assign ex_inst_compressed  = if ex_from_rs ? rs_issue_is_compressed : id_is_compressed;
    // is_branch / is_jal / is_jalr must fire only when the corresponding
    // instruction is actually at EX. Direct-path: gated by direct_path_v
    // (which clears when ID is RS-eligible and waiting for dispatch). RS path:
    // gated by rs_issue_valid via ex_from_rs. Without these gates, an RS-eligible
    // branch sitting in ID would falsely drive ex_inst_is_branch and trigger
    // BHT/RAS/mispred updates with no actual EX activity.
    assign ex_inst_is_jal      = direct_path_v && id_is_jal;
    assign ex_inst_is_jalr     = (ex_from_rs && rs_issue_is_jalr  ) || (direct_path_v && id_is_jalr  );
    assign ex_inst_is_branch   = (ex_from_rs && rs_issue_is_branch) || (direct_path_v && id_is_branch);
    let ex_rd_is_link : logic = ex_rd == 5'd1 || ex_rd == 5'd5;
    let ex_rs1_is_link: logic = ex_rs1 == 5'd1 || ex_rs1 == 5'd5;
    let ex_is_call_q  : logic = (ex_inst_is_jal || ex_inst_is_jalr) && ex_rd_is_link;
    let ex_is_return_q: logic = ex_inst_is_jalr && !ex_rd_is_link && ex_rs1_is_link;
    let ex_link_addr_ras: logic<64> = if ex_inst_compressed ? ex_inst_pc + 64'd2 : ex_inst_pc + 64'd4;
    assign bht_upd_idx = ex_inst_pc[9:2];
    // IF-stage observability signals (push/pop counters are driven from a
    // HYPOTHETICAL IF-stage RAS; actual RAS state is still maintained at EX)
    let if_valid_gate: logic = !icache_stall && !immu_busy && !stall_if;
    let if_is_call_push  : logic = if_is_call   && if_valid_gate;
    let if_is_return_pop : logic = if_is_return && if_valid_gate && ras_count != 5'd0;
    always_ff (clk, rst) {
        if_reset {
            ras_ptr   = 3'd0;
            ras_count = 5'd0;
        } else if trap_taken || mret_taken || sret_taken {
            // Flush RAS on context switch — trap/mret/sret break
            // the call/return pairing, so the stale stack would
            // cause mispredictions.
            ras_ptr   = 3'd0;
            ras_count = 5'd0;
        } else if !stall_ex {
            if ex_is_call_q && ex_is_return_q {
                // Simultaneous call+return: replace TOS (count unchanged)
                ras_stack[ras_ptr - 3'd1] = ex_link_addr_ras;
            } else if ex_is_call_q {
                ras_stack[ras_ptr] = ex_link_addr_ras;
                ras_ptr            = ras_ptr + 3'd1;
                if ras_count != 5'd8 {
                    ras_count = ras_count + 5'd1;
                }
            } else if ex_is_return_q {
                ras_ptr = ras_ptr - 3'd1;
                if ras_count != 5'd0 {
                    ras_count = ras_count - 5'd1;
                }
            }
        }
    }

    // Local BHT update (from EX stage) and flush
    let bht_flush: logic = id_valid && (id_is_sfence || id_is_fence_i || (id_is_csr && id_csr_addr == csr_pkg::CSR_SATP)) && !stall_id;
    always_ff (clk, rst) {
        if_reset {
            for i in 0..256 {
                local_bht[i] = 2'b01; // weakly not-taken
            }
        } else if bht_flush {
            for i in 0..256 {
                local_bht[i] = 2'b01;
            }
        } else if ex_inst_is_branch && !stall_ex {
            if ex_branch_taken {
                if local_bht[bht_upd_idx] != 2'b11 {
                    local_bht[bht_upd_idx] = local_bht[bht_upd_idx] + 2'd1;
                }
            } else {
                if local_bht[bht_upd_idx] != 2'b00 {
                    local_bht[bht_upd_idx] = local_bht[bht_upd_idx] - 2'd1;
                }
            }
        }
    }

    // ============================================================
    assign wb_rd_addr = mem_rd_addr;
    assign wb_wen     = mem_valid && mem_reg_wen;

    // EX/MEM forwarding: select the correct data source based on wb_sel.
    // PC4 (link address for JAL/JALR) must forward the computed link addr,
    // not the ALU result — otherwise predicted JALs corrupt the link register.
    let ex_link_addr   : logic<64> = if ex_is_compressed ? ex_pc + 64'd2 : ex_pc + 64'd4;
    // EX/MEM forwarding data: select correct data for the instruction in MEM.
    // SC.W: use sc_result from memory module (ex_alu_out has AMO address, not result).
    // Loads: use mem_load_data (dcache output).
    // For other instructions, ex_alu_out/ex_link_addr from execute module are used.
    // NOTE: ex_wb_sel reflects the instruction in MEM (execute module's registered output
    // from the previous cycle, captured before the current cycle's update in later-stage-first
    // simulator ordering).
    let _fwd_exmem_data: logic<64> = if mem_is_sc_out ?
        mem_sc_result
    : if ex_wb_sel == pipeline_pkg::WbSel::MEM ?
        mem_load_data
    : if ex_wb_sel == pipeline_pkg::WbSel::PC4 ?
        ex_link_addr
    :
        ex_alu_out
    ;

    inst u_decode: decode (
        clk                                          ,
        rst                                          ,
        i_pc            : ifid_pc                    ,
        i_instr         : ifid_instr                 ,
        i_valid         : ifid_valid                 ,
        i_stall         : stall_id                   ,
        i_flush         : flush_id                   ,
        i_wb_rd         : actual_wb_rd               ,
        i_wb_data       : actual_wb_data             ,
        i_wb_wen        : actual_wb_wen              ,
        o_pc            : id_pc                      ,
        o_rs1_data      : id_rs1_data                ,
        o_rs2_data      : id_rs2_data                ,
        o_imm           : id_imm                     ,
        o_rd_addr       : id_rd_addr                 ,
        o_rs1_addr      : id_rs1_addr                ,
        o_rs2_addr      : id_rs2_addr                ,
        o_rs3_addr      : id_rs3_addr                ,
        o_alu_op        : id_alu_op                  ,
        o_alu_src_a     : id_alu_src_a               ,
        o_alu_src_b     : id_alu_src_b               ,
        o_wb_sel        : id_wb_sel                  ,
        o_reg_wen       : id_reg_wen                 ,
        o_mem_ren       : id_mem_ren                 ,
        o_mem_wen       : id_mem_wen                 ,
        o_mem_funct3    : id_mem_funct3              ,
        o_is_branch     : id_is_branch               ,
        o_is_jal        : id_is_jal                  ,
        o_is_jalr       : id_is_jalr                 ,
        o_funct3        : id_funct3                  ,
        o_is_ecall      : id_is_ecall                ,
        o_is_ebreak     : id_is_ebreak               ,
        o_is_mret       : id_is_mret                 ,
        o_is_wfi        : id_is_wfi                  ,
        o_is_csr        : id_is_csr                  ,
        o_csr_op        : id_csr_op                  ,
        o_csr_imm       : id_csr_imm                 ,
        o_csr_addr      : id_csr_addr                ,
        o_illegal       : id_illegal                 ,
        o_amo_funct5    : id_amo_funct5              ,
        o_is_amo        : id_is_amo                  ,
        i_is_compressed : ifid_compressed            ,
        i_c_illegal     : ifid_c_illegal             ,
        o_is_compressed : id_is_compressed           ,
        o_is_sfence     : id_is_sfence               ,
        o_is_fence_i    : id_is_fence_i              ,
        o_is_fence      : id_is_fence                ,
        o_is_fp         : id_is_fp                   ,
        o_fp_reg_wen    : id_fp_reg_wen              ,
        o_fpu_op        : id_fpu_op                  ,
        o_fp_rm         : id_fp_rm                   ,
        o_fp_rs1_data   : id_fp_rs1_data             ,
        o_fp_rs2_data   : id_fp_rs2_data             ,
        o_fp_rs3_data   : id_fp_rs3_data             ,
        i_fp_wb_rd      : if mshr_fp_wb ? mshr_rd_addr : mem_rd_addr ,
        i_fp_wb_data    : if mshr_fp_wb ? mshr_wb_data : wb_data    ,
        i_fp_wb_wen     : actual_fp_wb_wen           ,
        o_valid         : id_valid                   ,
        i_predict_taken : ifid_predict_taken         ,
        o_predict_taken : id_predict_taken           ,
        i_predict_target: ifid_predict_target        ,
        o_predict_target: id_predict_target          ,
        // Slot1 register file access
        i_s1_rs1_addr   : s1_ifid_instr[19:15]        ,
        i_s1_rs2_addr   : s1_ifid_instr[24:20]        ,
        o_s1_rs1_data   : s1_rs1_raw                   ,
        o_s1_rs2_data   : s1_rs2_raw                   ,
        i_s1_wb_rd      : s1_wb_rd_addr                ,
        i_s1_wb_data    : s1_wb_data                   ,
        i_s1_wb_wen     : s1_wb_wen                    ,
        o_dbg_regs                                   ,
        o_dbg_pass                                   ,
        o_dbg_r1                                     ,
        o_dbg_r2                                     ,
        o_dbg_r3                                     ,
    );

    // ============================================================
    // EX stage
    // ============================================================
    // EX input mux: direct path (non-RS instructions) vs RS issue (registered)
    // RS issue output is registered (1-cycle delayed) so no comb loop.
    // direct_path_v is set by always_comb after id_direct_stall is computed (below RAT).
    // direct_path_v = id_valid && !id_is_rs_eligible && !id_direct_stall
    // Forward-declared as var so that BP/RAS/BHT update wiring earlier in the
    // file can reference them.
    assign ex_from_rs     = !direct_path_v && rs_issue_valid;
    // Priority: direct > int RS > SRS > FP RS > LQ-reinject. LQ-reinject
    // sits at the lowest priority so it fills pipeline bubbles only when
    // ID/RS/SRS/FP-RS have nothing to dispatch this cycle.
    assign ex_from_srs    = !direct_path_v && !rs_issue_valid && srs_issue_valid;
    assign ex_from_fp_rs  = !direct_path_v && !rs_issue_valid && !srs_issue_valid && fp_rs_issue_valid;
    // P3.2 bug (c) fix: LQ re-inject must not bypass an older in-flight store.
    // If SRS has an older store, letting LQ probe SB before that store
    // enqueues returns stale dcache data (rv64ui-sd subtest 11). ROB-age
    // compare: each entry's age relative to ROB head = (rob_idx - commit_idx)
    // mod 32. LQ re-inject is safe iff srs_empty OR LQ load is older than
    // SRS oldest. (Coarse `srs_empty` gates deadlocked fence_i — SRS store
    // can be YOUNGER and waiting on the LQ load's CDB; we must let LQ
    // re-inject in that case.)
    let lq_reinject_age : logic<5> = lq_reinject_rob - rob_commit_idx;
    let srs_oldest_age  : logic<5> = srs_oldest_rob  - rob_commit_idx;
    let lq_no_older_srs : logic    = srs_empty || (lq_reinject_age <= srs_oldest_age);
    assign ex_from_lq     = !direct_path_v && !rs_issue_valid && !srs_issue_valid && !fp_rs_issue_valid && lq_reinject_valid && lq_no_older_srs;
    assign ex_in_valid    = direct_path_v || rs_issue_valid || srs_issue_valid || fp_rs_issue_valid || ex_from_lq;
    let ex_in_rob_idx  : logic<5> = if ex_from_fp_rs ? fp_rs_issue_rob
                                  : if ex_from_srs   ? srs_issue_rob
                                  : if ex_from_rs ? rs_issue_rob
                                  : if ex_from_lq ? lq_reinject_rob
                                  : id_rob_idx;
    let ex_in_epoch    : logic<2> = if ex_from_fp_rs ? fp_rs_issue_epoch
                                  : if ex_from_srs   ? srs_issue_epoch
                                  : if ex_from_rs ? rs_issue_epoch
                                  : if ex_from_lq ? lq_reinject_epoch
                                  : id_epoch;

    // P3.4 (d).2: ROB squash index. ex_misprediction squashes from the EX
    // instruction +1 (right-path); p34 replay squashes from the offending
    // LOAD itself (inclusive) so it re-fetches and re-issues from PC.
    let pipeline_squash_idx: logic<7> = if p34_replay_valid_q
                                       ? {p34_replay_epoch_q, p34_replay_idx_q}
                                       : {ex_in_epoch, ex_in_rob_idx} + 7'd1;

    inst u_execute: execute (
        clk                                                                                                                             ,
        rst                                                                                                                             ,
        // EX input mux: RS issue overrides decode output for RS-eligible instructions.
        // When ex_from_rs: operands pre-resolved (fwd=NONE), non-ALU fields zeroed.
        // Direct-path ROB forwarding: when a source register has a completed-but-uncommitted
        // ROB entry, use the ROB data instead of the stale regfile value. The standard
        // EX/MEM forwarding inside execute will override if a more recent writer is in the
        // pipeline stages.
        i_valid        : ex_in_valid                                                                                                    ,
        i_pc           : if ex_from_fp_rs ? fp_rs_issue_pc : if ex_from_srs ? srs_issue_pc : if ex_from_rs ? rs_issue_pc : if ex_from_lq ? lq_reinject_pc : id_pc,
        // Direct-path ROB forwarding: when a source register has a completed ROB entry
        // (renamed but not yet committed), use the ROB data instead of stale regfile.
        // ROB data override + ROB commit bypass.
        // Priority: RS issue > ROB read (epoch-matched) > ROB commit bypass > regfile
        // The commit bypass handles the case where the ROB commits a register write
        // in the same cycle as the decode module reads from regfile — the regfile
        // value is stale (from the previous cycle), so use the commit data directly.
        // Data path: RS > ROB (epoch-matched, data survives commit) > regfile.
        // ROB rd_data is only cleared on NEW allocation, not on commit. So even
        // after an entry commits (valid=0, completed=0), the data remains valid
        // as long as the epoch matches (no reallocation has overwritten it).
        // This eliminates the commit-to-regfile timing gap.
        // Data path: RS > ROB (epoch-matched) > regfile (always-latest).
        // id_rs1_regfile/id_rs2_regfile are combinational reads from the regfile
        // using the decode output address, with same-cycle write bypass.
        // This avoids the stale-regfile problem where id_rs1_data was latched
        // in the decode module before the ROB commit updated the regfile.
        i_rs1_data     : if ex_from_fp_rs ? 64'd0
                       : if ex_from_srs  ? srs_issue_s1_data
                       : if ex_from_rs ? rs_issue_s1_data
                       : if ex_from_lq ? lq_reinject_s1
                       : if direct_path_operand_captured_q ? direct_path_rs1_q
                       : if rat_id_rs1_valid && rob_read1_epoch == rat_id_rs1_rob_epoch ? rob_read1_data
                       : id_rs1_data                                                                                                    ,
        i_rs2_data     : if ex_from_fp_rs ? 64'd0
                       : if ex_from_srs  ? srs_issue_s2_data
                       : if ex_from_rs ? rs_issue_s2_data
                       : if ex_from_lq ? 64'd0
                       : if direct_path_operand_captured_q ? direct_path_rs2_q
                       : if rat_id_rs2_valid && rob_read2_epoch == rat_id_rs2_rob_epoch ? rob_read2_data
                       : id_rs2_data                                                                                                    ,
        i_imm          : if ex_from_fp_rs ? 64'd0 : if ex_from_srs ? srs_issue_imm : if ex_from_rs ? rs_issue_imm : if ex_from_lq ? lq_reinject_imm : id_imm,
        i_rd_addr      : if ex_from_fp_rs ? fp_rs_issue_rd  : if ex_from_srs ? 5'd0 : if ex_from_rs ? rs_issue_rd : if ex_from_lq ? lq_reinject_rd : id_rd_addr,
        i_rs1_addr     : if ex_from_fp_rs ? fp_rs_issue_rs1 : if ex_from_srs ? srs_issue_rs1 : if ex_from_rs ? rs_issue_rs1 : if ex_from_lq ? 5'd0 : id_rs1_addr,
        i_rs2_addr     : if ex_from_fp_rs ? fp_rs_issue_rs2 : if ex_from_srs ? srs_issue_rs2 : if ex_from_rs ? rs_issue_rs2 : if ex_from_lq ? 5'd0 : id_rs2_addr,
        i_alu_op       : if ex_from_srs ? alu_pkg::AluOp::ADD : if ex_from_rs ? rs_issue_alu_op : if ex_from_lq ? alu_pkg::AluOp::ADD : id_alu_op,
        i_alu_src_a    : if ex_from_srs ? pipeline_pkg::AluSrcA::REG : if ex_from_rs ? rs_issue_src_a : if ex_from_lq ? pipeline_pkg::AluSrcA::REG : id_alu_src_a,
        i_alu_src_b    : if ex_from_srs ? pipeline_pkg::AluSrcB::IMM : if ex_from_rs ? rs_issue_src_b : if ex_from_lq ? pipeline_pkg::AluSrcB::IMM : id_alu_src_b,
        i_wb_sel       : if ex_from_rs ? (if rs_issue_is_jalr ? pipeline_pkg::WbSel::PC4 : pipeline_pkg::WbSel::ALU) : if ex_from_fp_rs || ex_from_srs ? pipeline_pkg::WbSel::ALU : if ex_from_lq ? pipeline_pkg::WbSel::MEM : id_wb_sel,
        i_reg_wen      : if ex_from_fp_rs ? fp_rs_issue_reg_wen : if ex_from_srs ? 1'b0 : if ex_from_rs ? rs_issue_wen : if ex_from_lq ? (lq_reinject_rd != 5'd0) : id_reg_wen,
        i_mem_ren      : if ex_from_rs || ex_from_fp_rs ? 1'b0 : if ex_from_srs ? 1'b0 : if ex_from_lq ? 1'b1 : id_mem_ren              ,
        i_mem_wen      : if ex_from_rs || ex_from_fp_rs ? 1'b0 : if ex_from_srs ? 1'b1 : if ex_from_lq ? 1'b0 : id_mem_wen              ,
        i_mem_funct3   : if ex_from_rs || ex_from_fp_rs ? 3'd0 : if ex_from_srs ? srs_issue_funct3 : if ex_from_lq ? lq_reinject_funct3 : id_mem_funct3,
        i_is_branch    : if ex_from_rs ? rs_issue_is_branch : if ex_from_fp_rs || ex_from_srs || ex_from_lq ? 1'b0 : id_is_branch       ,
        i_is_jal       : if ex_from_rs || ex_from_fp_rs || ex_from_srs || ex_from_lq ? 1'b0 : id_is_jal                                 ,
        i_is_jalr      : if ex_from_rs ? rs_issue_is_jalr   : if ex_from_fp_rs || ex_from_srs || ex_from_lq ? 1'b0 : id_is_jalr         ,
        i_funct3       : if ex_from_rs ? rs_issue_funct3    : if ex_from_fp_rs || ex_from_srs ? 3'd0 : if ex_from_lq ? lq_reinject_funct3 : id_funct3,
        i_is_ecall     : if ex_from_rs || ex_from_fp_rs || ex_from_srs || ex_from_lq ? 1'b0 : id_is_ecall                               ,
        i_is_ebreak    : if ex_from_rs || ex_from_fp_rs || ex_from_srs || ex_from_lq ? 1'b0 : id_is_ebreak                              ,
        i_illegal      : if ex_from_rs || ex_from_fp_rs || ex_from_srs || ex_from_lq ? 1'b0 : (id_illegal || id_csr_fault_q || tvm_trap || tsr_trap || mret_priv_fault || sret_priv_fault || sfence_priv_fault),
        i_amo_funct5   : if ex_from_rs || ex_from_fp_rs || ex_from_srs || ex_from_lq ? 5'd0 : id_amo_funct5                             ,
        i_is_amo       : if ex_from_rs || ex_from_fp_rs || ex_from_srs || ex_from_lq ? 1'b0 : id_is_amo                                 ,
        i_is_compressed: if ex_from_rs ? rs_issue_is_compressed : if ex_from_fp_rs || ex_from_srs || ex_from_lq ? 1'b0 : id_is_compressed,
        i_is_fp        : if ex_from_fp_rs ? 1'b1 : if ex_from_rs || ex_from_srs ? 1'b0 : if ex_from_lq ? lq_reinject_is_fp : id_is_fp   ,
        i_fp_reg_wen   : if ex_from_fp_rs ? fp_rs_issue_fp_wen : if ex_from_rs || ex_from_srs ? 1'b0 : if ex_from_lq ? lq_reinject_is_fp : id_fp_reg_wen,
        i_fpu_op       : if ex_from_fp_rs ? fp_rs_issue_fpu_op : if ex_from_rs || ex_from_srs || ex_from_lq ? 6'd0 : id_fpu_op          ,
        i_fp_rm        : if ex_from_fp_rs ? fp_rs_issue_rm : if ex_from_rs || ex_from_srs || ex_from_lq ? 3'd0 : id_fp_rm               ,
        // Direct-path FP ops also read through fp_rat → FP ROB to avoid
        // stale-regfile reads when a producer is still in flight via the
        // FP RS. Pattern parallels integer i_rs1_data's rat→rob read mux.
        i_fp_rs1_data  : if ex_from_fp_rs ? fp_rs_issue_s1_data
                       : if ex_from_rs || ex_from_srs || ex_from_lq ? 64'd0
                       : if fp_rat_id_rs1_valid && fp_rob_read1_epoch == fp_rat_id_rs1_rob_epoch
                           ? fp_rob_read1_data
                       : id_fp_rs1_data                                                                                                ,
        i_fp_rs2_data  : if ex_from_fp_rs ? fp_rs_issue_s2_data
                       : if ex_from_rs || ex_from_srs || ex_from_lq ? 64'd0
                       : if fp_rat_id_rs2_valid && fp_rob_read2_epoch == fp_rat_id_rs2_rob_epoch
                           ? fp_rob_read2_data
                       : id_fp_rs2_data                                                                                                ,
        i_fp_rs3_data  : if ex_from_fp_rs ? fp_rs_issue_s3_data : if ex_from_rs || ex_from_srs || ex_from_lq ? 64'd0 : id_fp_rs3_data  ,
        i_frm          : csr_frm                                                                                                        ,
        i_fs           : csr_fs                                                                                                         ,
        i_is_csr       : if ex_from_rs || ex_from_fp_rs || ex_from_srs || ex_from_lq ? 1'b0 : id_is_csr                                ,
        i_csr_addr     : if ex_from_rs || ex_from_fp_rs || ex_from_srs || ex_from_lq ? 12'd0 : id_csr_addr                             ,
        i_csr_rdata    : csr_rdata                                                                                                      ,
        // Forwarding: disabled for RS issue (operands pre-resolved).
        // For direct path: detect stale forwarding by comparing the forwarding
        // source's ROB index against the RAT's latest writer. If they differ,
        // the forwarding is from an older (wrong) writer — override to NONE
        // so execute uses i_rs1_data (ROB data) instead.
        i_fwd_exmem       : _fwd_exmem_data                                           ,
        i_fwd_memwb       : wb_data                                                   ,
        i_fwd_s1exwb      : s1_ex_alu_out                                             ,
        // Stale forwarding detection: when the RAT's latest writer doesn't match
        // the pipeline stage's ROB index, forwarding is from an older (wrong) writer.
        // Override to NONE so execute uses i_rs1_data (ROB data) instead.
        // Forwarding override:
        // 1. RS issue: operands pre-resolved, no forwarding needed
        // 2. RAT valid + ROB completed: value available via ROB read port, use that
        //    instead of pipeline forwarding (prevents ROB index aliasing from wrap-around)
        // 3. Stale detection: ROB index mismatch → pipeline has wrong instruction
        // Forwarding override with epoch-based aliasing detection:
        // 1. RS issue: operands pre-resolved, no forwarding needed
        // 2. RAT valid + ROB completed: use ROB data (prevents aliasing)
        // 3. Epoch+index mismatch: pipeline has wrong instruction's result
        // Forwarding override:
        // 1. RS issue: operands pre-resolved, no forwarding
        // 2. Pipeline epoch mismatch: suppress forwarding (wrong instruction)
        // Note: removed rob_completed → NONE override — the standard forwarding
        // from MEM_WB handles the WB data correctly and avoids the stale-regfile
        // race condition that occurs when ROB commit clears the RAT.
        i_fwd_a           : if ex_from_rs || ex_from_fp_rs || ex_from_srs || ex_from_lq ? pipeline_pkg::FwdSel::NONE
                          : if direct_path_operand_captured_q ? pipeline_pkg::FwdSel::NONE
                          : if rat_id_rs1_valid && fwd_a != pipeline_pkg::FwdSel::NONE
                            && ((fwd_a == pipeline_pkg::FwdSel::EX_MEM && (ex_rob_idx != rat_id_rs1_rob_idx || ex_epoch != rat_id_rs1_rob_epoch))
                             || (fwd_a == pipeline_pkg::FwdSel::MEM_WB && (mem_rob_idx != rat_id_rs1_rob_idx || mem_epoch != rat_id_rs1_rob_epoch || mem_was_lq)))
                            ? pipeline_pkg::FwdSel::NONE
                          : fwd_a                                                      ,
        i_fwd_b           : if ex_from_rs || ex_from_fp_rs || ex_from_srs || ex_from_lq ? pipeline_pkg::FwdSel::NONE
                          : if direct_path_operand_captured_q ? pipeline_pkg::FwdSel::NONE
                          : if rat_id_rs2_valid && fwd_b != pipeline_pkg::FwdSel::NONE
                            && ((fwd_b == pipeline_pkg::FwdSel::EX_MEM && (ex_rob_idx != rat_id_rs2_rob_idx || ex_epoch != rat_id_rs2_rob_epoch))
                             || (fwd_b == pipeline_pkg::FwdSel::MEM_WB && (mem_rob_idx != rat_id_rs2_rob_idx || mem_epoch != rat_id_rs2_rob_epoch || mem_was_lq)))
                            ? pipeline_pkg::FwdSel::NONE
                          : fwd_b                                                      ,
        i_fp_fwd_exmem    : _fwd_exmem_data                                           ,
        i_fp_fwd_memwb    : wb_data                                                   ,
        i_fp_fwd_a        : if ex_from_rs || ex_from_fp_rs || ex_from_srs || ex_from_lq ? pipeline_pkg::FwdSel::NONE : fp_fwd_a,
        i_fp_fwd_b        : if ex_from_rs || ex_from_fp_rs || ex_from_srs || ex_from_lq ? pipeline_pkg::FwdSel::NONE : fp_fwd_b,
        i_fp_fwd_c        : if ex_from_rs || ex_from_fp_rs || ex_from_srs || ex_from_lq ? pipeline_pkg::FwdSel::NONE : fp_fwd_c,
        i_stall           : stall_ex                                                   ,
        i_flush           : flush_ex                                                   ,
        o_valid           : ex_valid         ,
        o_pc              : ex_pc            ,
        o_alu_out         : ex_alu_out       ,
        o_alu_result_comb : slot0_alu_comb   ,
        o_rs2_data        : ex_rs2_data      ,
        o_rd_addr         : ex_rd_addr       ,
        o_wb_sel          : ex_wb_sel        ,
        o_reg_wen         : ex_reg_wen       ,
        o_mem_ren         : ex_mem_ren       ,
        o_mem_wen         : ex_mem_wen       ,
        o_mem_funct3      : ex_mem_funct3    ,
        o_is_ecall        : ex_is_ecall      ,
        o_is_ebreak       : ex_is_ebreak     ,
        o_illegal         : ex_illegal       ,
        o_amo_funct5      : ex_amo_funct5    ,
        o_is_amo          : ex_is_amo        ,
        o_is_compressed   : ex_is_compressed ,
        o_is_fp           : ex_is_fp         ,
        o_fp_reg_wen      : ex_fp_reg_wen    ,
        o_fp_rs2_data     : ex_fp_rs2_data   ,
        o_fp_fflags       : ex_fp_fflags     ,
        o_fp_fflags_wen   : ex_fp_fflags_wen ,
        o_fp_fflags_ex    : fp_fflags_ex     ,
        o_fp_fflags_ex_wen: fp_fflags_ex_wen ,
        i_predict_taken   : if ex_from_rs ? rs_issue_predict_taken  : if ex_from_fp_rs || ex_from_srs || ex_from_lq ? 1'b0  : id_predict_taken ,
        i_predict_target  : if ex_from_rs ? rs_issue_predict_target : if ex_from_fp_rs || ex_from_srs || ex_from_lq ? 64'd0 : id_predict_target,
        o_branch_taken    : ex_branch_taken  ,
        o_dbg_fwd_rs1     : ex_dbg_fwd_rs1   ,
        o_dbg_fwd_rs2     : ex_dbg_fwd_rs2   ,
        o_branch_target   : ex_branch_target ,
        o_jump_target     : ex_jump_target   ,
        o_misprediction   : ex_misprediction ,
        o_mispred_dir     : ex_mispred_dir    ,
        o_mispred_target  : ex_mispred_target ,
        o_div_busy        : ex_div_busy      ,
        o_fp_busy         : ex_fp_busy       ,
        i_rob_idx              : ex_in_rob_idx         ,
        i_rob_epoch            : ex_in_epoch           ,
        o_rob_idx              : _                     , // unused: ex_rob_idx managed manually
        o_is_div               : ex_is_div             ,
        o_div_complete_valid   : ex_div_complete_valid  ,
        o_div_complete_data    : ex_div_complete_data   ,
        o_div_complete_rob_idx : ex_div_complete_rob_idx,
        o_div_complete_epoch   : ex_div_complete_epoch  ,
    );

    // (debug traces after id_direct_stall definitions)

    // ============================================================
    // MEM stage
    // ============================================================
    // Intermediate vars for var-redirect pattern (needed for MMU integration)
    var mem_dmem_addr : logic<64>;
    var mem_dmem_wdata: logic<64>;
    var mem_dmem_wen  : logic    ;
    // mem_dmem_ren declared at top for hazard_unit forward reference
    var mem_dmem_wstrb : logic<8> ;
    var mmu_rdata      : logic<64>;
    var mmu_rdata_valid: logic    ;
    // SB-forwarding mux has moved inside memory.veryl (see its
    // `i_dmem_rdata` internal let). Here we just forward mmu_rdata and
    // the SB signals as separate ports.
    let mem_dmem_rdata_in: logic<64> = mmu_rdata;

    inst u_memory: memory (
        clk                               ,
        rst                               ,
        i_valid        : ex_valid         ,
        i_pc           : ex_pc            ,
        i_alu_out      : ex_alu_out       ,
        i_rs2_data     : ex_rs2_data      ,
        i_rd_addr      : ex_rd_addr       ,
        i_wb_sel       : ex_wb_sel        ,
        i_reg_wen      : ex_reg_wen       ,
        i_mem_ren      : ex_mem_ren       ,
        i_mem_wen      : ex_mem_wen       ,
        i_mem_funct3   : ex_mem_funct3    ,
        i_amo_funct5   : ex_amo_funct5    ,
        i_is_compressed: ex_is_compressed ,
        i_rob_idx      : ex_rob_idx       ,
        i_rob_epoch    : ex_epoch         ,
        i_is_div       : ex_is_div        ,
        i_is_fp        : ex_is_fp         ,
        i_fp_reg_wen   : ex_fp_reg_wen    ,
        i_fp_rs2_data  : ex_fp_rs2_data   ,
        i_was_lq       : lq_alloc_gate    ,
        i_lq_idx       : lq_alloc_idx     ,
        i_stall        : stall_mem        ,
        i_flush        : trap_taken       ,
        i_rdata_valid  : mmu_rdata_valid  ,
        o_dmem_addr    : mem_dmem_addr    ,
        o_dmem_wdata   : mem_dmem_wdata   ,
        i_dmem_rdata_raw: mem_dmem_rdata_in,
        i_sb_fwd_hit     : sb_fwd_hit       ,
        i_sb_fwd_data    : sb_fwd_data      ,
        o_sb_fwd_match   : sb_fwd_match     ,
        o_sb_fwd_mismatch: sb_fwd_mismatch  ,
        o_dmem_wen     : mem_dmem_wen     ,
        o_dmem_ren     : mem_dmem_ren     ,
        o_dmem_wstrb   : mem_dmem_wstrb   ,
        o_valid        : mem_valid        ,
        o_pc           : mem_pc           ,
        o_alu_out      : mem_alu_out      ,
        o_mem_data     : mem_data         ,
        o_rd_addr      : mem_rd_addr      ,
        o_wb_sel       : mem_wb_sel       ,
        o_reg_wen      : mem_reg_wen      ,
        o_is_compressed: mem_is_compressed,
        o_rob_idx      : mem_rob_idx      , // use memory module's pipeline register (in sync with mem_valid)
        o_rob_epoch    : mem_epoch        , // use memory module's pipeline register
        o_is_div       : mem_is_div       ,
        o_is_fp        : mem_is_fp        ,
        o_fp_reg_wen   : mem_fp_reg_wen   ,
        o_was_lq       : mem_was_lq       ,
        o_lq_idx       : mem_lq_idx       ,
        o_load_data    : mem_load_data    ,
        o_sc_result    : mem_sc_result    ,
        o_is_sc        : mem_is_sc_out   ,
        o_misaligned   : mem_misaligned   ,
        o_misalign_st  : mem_misalign_st  ,
        o_split_stall  : mem_split_stall  ,
        i_mshr_absorb   : mshr_absorb      ,
        o_crosses_dw    : mem_crosses_dw  ,
        o_split_phase2  : mem_split_phase2,
        o_mshr_absorbed : mem_mshr_absorbed,
        i_remote_inv_valid: i_dcache_inv_valid,
        i_remote_inv_addr : i_dcache_inv_addr ,
        o_amo_inflight    : mem_amo_inflight  ,
        o_reserv_valid    : mem_reserv_valid  ,
    );

    // Expose AMO/reservation status to the SoC for cross-hart bus
    // arbitration (Step C).
    assign o_amo_inflight = mem_amo_inflight;
    assign o_reserv_valid = mem_reserv_valid;

    // ============================================================
    // Data MMU (passthrough in Bare mode, Sv39 PTW when enabled)
    // ============================================================
    // dmem is routed through dmem_mmu (passthrough in Bare mode, Sv39 PTW when enabled).
    var mmu_fault      : logic    ;
    var mmu_fault_store: logic    ;
    var mmu_paddr      : logic<64>;
    var mmu_wdata_out  : logic<64>;
    var mmu_wen_out    : logic    ;
    var mmu_ren_out    : logic    ;
    var mmu_wstrb_out  : logic<8> ;
    var mmu_rdata_in   : logic<64>;

    inst u_dmmu: dmem_mmu (
        clk                         ,
        rst                         ,
        i_vaddr     : mem_dmem_addr ,
        i_wdata     : mem_dmem_wdata,
        i_wen       : mem_dmem_wen  ,
        i_ren       : mem_dmem_ren  ,
        i_wstrb     : mem_dmem_wstrb,
        o_rdata     : mmu_rdata     ,
        o_dmem_addr : mmu_paddr     ,
        o_dmem_wdata: mmu_wdata_out ,
        i_dmem_rdata: mmu_rdata_in  ,
        o_dmem_wen  : mmu_wen_out   ,
        o_dmem_ren  : mmu_ren_out   ,
        o_dmem_wstrb: mmu_wstrb_out ,
        i_satp      : csr_satp      ,
        // MPRV: data access uses MPP privilege level when set in M-mode
        i_priv        : if csr_mprv && csr_priv == csr_pkg::PrivLevel::MACHINE ? csr_mpp : csr_priv,
        i_sum         : csr_sum                                                                    ,
        i_mxr         : csr_mxr                                                                    ,
        o_busy        : mmu_stall                                                                  ,
        o_fault       : mmu_fault                                                                  ,
        o_fault_store : mmu_fault_store                                                            ,
        o_rdata_valid : mmu_rdata_valid                                                            ,
        i_dcache_stall: dcache_stall                                                               ,
        i_sfence      : id_valid && id_is_sfence && !stall_id                                      ,
    );

    // D-Cache (between MMU and external data memory)
    // MMIO reads bypass dcache. The peripheral rdata lines come from the
    // SoC layer (i_clint_rdata / i_plic_rdata / i_uart_rdata).
    let clint_rdata: logic<64> = i_clint_rdata;
    let plic_rdata : logic<64> = i_plic_rdata;
    let uart_rdata : logic<8>  = i_uart_rdata;
    // MMIO regions: CLINT at 0x02xxxxxx, PLIC at 0x0Cxxxxxx, UART at 0x10xxxxxx
    let clint_sel       : logic     = mmu_paddr[31:24] == 8'h02;
    let plic_sel        : logic     = mmu_paddr[31:24] == 8'h0C;
    let uart_sel        : logic     = mmu_paddr[31:24] == 8'h10;
    let is_mmio         : logic     = clint_sel || plic_sel || uart_sel;
    assign o_clint_sel = clint_sel;
    assign o_plic_sel  = plic_sel;
    assign o_uart_sel  = uart_sel;
    // o_uart_irq_req is currently unused — the SoC PLIC mux owns the UART src.
    assign o_uart_irq_req = 1'b0;
    var dcache_rdata        : logic<64>;
    var dcache_stall_raw   : logic    ;
    var dcache_miss_valid  : logic    ;
    var dcache_fill_complete: logic   ;
    var dcache_fill_rdata  : logic<64>;

    // Dcache input arbitration: MMU (EX→MEM path) vs LQ issue.
    // LQ-4.2 infrastructure only — `dcache_sel_lq` is tied to 0 here,
    // so dcache inputs continue to come from MMU unchanged. LQ-4.3
    // flips the selector on when LQ issue takes over the read path.
    let dcache_sel_lq: logic = 1'b0;
    let dcache_addr  : logic<64> = if dcache_sel_lq ? lq_issue_addr : mmu_paddr;
    let dcache_ren   : logic     = if dcache_sel_lq ? lq_issue_valid
                                                     : mmu_ren_out && !is_mmio;
    let dcache_wen   : logic     = !dcache_sel_lq && mmu_wen_out && !is_mmio;

    inst u_dcache: dcache (
        clk                                 ,
        rst                                 ,
        i_addr          : dcache_addr            ,
        i_wdata         : mmu_wdata_out          ,
        i_wen           : dcache_wen             ,
        i_ren           : dcache_ren             ,
        i_wstrb         : mmu_wstrb_out          ,
        o_rdata         : dcache_rdata           ,
        o_stall         : dcache_stall_raw       ,
        o_miss_valid    : dcache_miss_valid       ,
        o_fill_complete : dcache_fill_complete    ,
        o_fill_rdata    : dcache_fill_rdata       ,
        o_mem_addr      : o_dmem_addr            ,
        o_mem_wdata     : o_dmem_wdata           ,
        i_mem_rdata     : i_dmem_rdata           ,
        o_mem_wen       : o_dmem_wen             ,
        o_mem_ren       : o_dmem_ren             ,
        o_mem_wstrb     : o_dmem_wstrb           ,
        i_inv_valid     : i_dcache_inv_valid     ,
        i_inv_addr      : i_dcache_inv_addr      ,
        o_mem_req       : o_dmem_req             ,
        i_mem_grant     : i_dmem_grant           ,
    );

    // MMIO reads bypass dcache
    assign mmu_rdata_in = if clint_sel ? clint_rdata : if plic_sel ? plic_rdata : if uart_sel ? {56'd0, uart_rdata} : dcache_rdata;
    // dcache_stall: full stall (used by DMM for PTW coordination — never suppressed)
    assign dcache_stall = (dcache_stall_raw && !is_mmio) || mem_split_stall;
    // dcache_stall_pipeline: suppressed by MSHR absorb (pipeline continues during fill)
    // DMM still sees the full stall, maintaining PTW coordination.
    assign dcache_stall_pipeline = dcache_stall && !mshr_absorb;

    // ============================================================
    // MSHR (non-blocking dcache miss handling)
    // ============================================================
    // MSHR absorb: load miss in MEM, MSHR available, not AMO/MMIO/split
    // MSHR absorb: load miss in MEM, MSHR available, not AMO/FP/MMIO/split.
    // Exclude PTW misses: mmu_rdata_valid=0 means dcache serves PTW, not user load.
    assign mshr_absorb = dcache_miss_valid && !mshr_valid && !is_mmio
                      && ex_valid && ex_mem_ren && !ex_is_amo && !ex_is_fp
                      && !mem_crosses_dw && mmu_rdata_valid;

    // MSHR writeback: fill complete and MSHR valid
    assign mshr_wb_valid = dcache_fill_complete && mshr_valid;

    // MSHR WB data extraction: shift by byte offset, sign/zero extend
    let mshr_shifted: logic<64> = dcache_fill_rdata >> {mshr_byte_off, 3'b000};
    assign mshr_wb_data = case mshr_funct3[1:0] {
        2'd0: if mshr_funct3[2] ?
                  {56'd0, mshr_shifted[7:0]}
              : {mshr_shifted[7] repeat 56, mshr_shifted[7:0]},
        2'd1: if mshr_funct3[2] ?
                  {48'd0, mshr_shifted[15:0]}
              : {mshr_shifted[15] repeat 48, mshr_shifted[15:0]},
        2'd2: if mshr_fp_reg_wen ?
                  {32'hFFFFFFFF, mshr_shifted[31:0]} // FP NaN-boxing
              : if mshr_funct3[2] ?
                  {32'd0, mshr_shifted[31:0]}
              : {mshr_shifted[31] repeat 32, mshr_shifted[31:0]},
        2'd3: mshr_shifted,
        default: mshr_shifted,
    };

    // MSHR WB signals (kept for FP path and ROB complete mux)
    // LQ-4.4-c4: LQ-captured misses are completed via LQ's mshr_fill port
    // and retire through port 3 + CDB1's `lq_wb_complete` branch, so the
    // mshr_int_wb → port 1 / regfile / CDB1 path must stay idle for them.
    // AMO / cross-DW / MMIO misses still pass through mshr_int_wb because
    // they bypass LQ (`lq_alloc_gate` excludes them → `mshr_was_lq`=0).
    assign mshr_int_wb = mshr_wb_valid && !mshr_fp_reg_wen && !mshr_was_lq;
    assign mshr_fp_wb  = mshr_wb_valid && mshr_fp_reg_wen;

    // Complete port conflict: MSHR, DIV async, and normal WB share
    // the single i_complete port. Priority: MSHR > DIV > normal WB.
    // Stall when multiple sources fire simultaneously.
    // With blanket DIV stall restored, DIV instructions complete normally via WB.
    // mem_is_div suppression is only needed for non-blocking DIV (RS-enabled mode).
    // Normal WB completion. Stale epoch handling is done inside the ROB's
    // always_ff (epoch check on i_complete_*) — not here, to avoid rejecting
    // valid completions when the entry was commit+reallocated during pipeline latency.
    // Direct (non-LQ) WB completion — drives ROB port 1 and CDB1's
    // normal source. LQ-captured loads (mem_was_lq) complete via port 3
    // (lq_retire) and use the CDB1 LQ source below.
    let normal_wb_complete: logic = mem_valid && !mem_mshr_absorbed && !mem_was_lq && !mem_from_lq;
    // LQ retire is already MEM-sync gated (head.rob == mem_rob_idx when
    // it fires), so it's functionally equivalent to normal_wb_complete
    // for captured loads — just a different data source.
    let lq_wb_complete    : logic = lq_retire_valid;
    // D2 async DIV completion infrastructure is wired (ex_div_complete_*
    // tracked through execute.veryl, epoch mux extended). Leaving
    // div_async_valid disabled until the Linux-boot-specific failure mode
    // observed on full enablement is isolated. Switch to
    // `ex_div_complete_valid` to enable.
    // D2: div_async writes ROB via dedicated port 4 (no conflict with
    // port 1 normal WB path). DIV still blocks the pipeline via i_div_busy
    // so there's no RS-dispatch / async completion race yet.
    let div_async_valid: logic = ex_div_complete_valid;
    // Div-async CDB1 pending latch: DIV completion is a 1-cycle pulse
    // from the divider FSM. When it collides with mshr_int_wb /
    // normal_wb_complete / lq_wb_complete, the CDB1 priority mux drops
    // lower-priority sources and the DIV broadcast is lost forever —
    // RS dependents never see the wakeup. ROB port 4 still captures
    // completion, but RS has no way to observe ROB.completed without a
    // CDB. One-entry buffer rescues the dropped pulse and re-drives CDB1
    // on the next free cycle (DIV takes >=32 cycles, so a single-entry
    // buffer never overflows before draining).
    var div_pending_valid: logic    ;
    var div_pending_rob  : logic<5> ;
    var div_pending_epoch: logic<2> ;
    var div_pending_data : logic<64>;
    let cdb1_other_src   : logic    = mshr_int_wb || normal_wb_complete || lq_wb_complete;
    let div_conflict     : logic    = div_async_valid && cdb1_other_src;
    let div_drain_now    : logic    = div_pending_valid && !cdb1_other_src;
    always_ff (clk, rst) {
        if_reset {
            div_pending_valid = 1'b0;
            div_pending_rob   = 5'd0;
            div_pending_epoch = 2'd0;
            div_pending_data  = 64'd0;
        } else {
            if div_drain_now {
                div_pending_valid = 1'b0;
            }
            if div_conflict && !div_pending_valid {
                div_pending_valid = 1'b1;
                div_pending_rob   = ex_div_complete_rob_idx;
                div_pending_epoch = ex_div_complete_epoch;
                div_pending_data  = ex_div_complete_data;
            }
        }
    }
    let div_broadcast_valid: logic     = (div_async_valid && !div_conflict) || div_drain_now;
    let div_broadcast_rob  : logic<5>  = if div_drain_now ? div_pending_rob   : ex_div_complete_rob_idx;
    let div_broadcast_epoch: logic<2>  = if div_drain_now ? div_pending_epoch : ex_div_complete_epoch;
    let div_broadcast_data : logic<64> = if div_drain_now ? div_pending_data  : ex_div_complete_data;

    assign mshr_wb_conflict = (mshr_int_wb && (normal_wb_complete || lq_wb_complete))
                           || (normal_wb_complete && lq_wb_complete)
                           || (mshr_fp_wb && mem_valid && mem_fp_reg_wen);

    // Integer regfile write port mux:
    // Priority: MSHR WB > ROB commit > direct WB (non-RS instructions only).
    // RS-issued instructions must NOT write via the normal WB path because
    // RS causes out-of-order completion; only ROB in-order commit writes
    // their results. Non-RS (direct-path) instructions use normal WB as before.
    assign actual_wb_rd   = if mshr_int_wb ? mshr_rd_addr
                          : if rob_commit_valid ? rob_commit_rd
                          : wb_rd_addr;
    assign actual_wb_data = if mshr_int_wb ? mshr_wb_data
                          : if rob_commit_valid ? rob_commit_data
                          : wb_data;
    // FIX (P3.x JALR routing): regfile writes only via ROB commit.
    // Wrong-path direct-path / MSHR retire can pollute regfile under long
    // RS-routed JALR speculation. EX-stage operand mux already falls back
    // to rob_read*_data when RAT/ROB indicate the producer is in ROB.
    assign actual_wb_wen  = rob_commit_valid && rob_commit_wen;

    // FP regfile write port mux (MSHR FP loads not supported, mshr_fp_wb dead)
    assign actual_fp_wb_wen = if mshr_fp_wb ? 1'b1
                            : mem_valid && mem_fp_reg_wen;

    // ============================================================
    // CDB (Common Data Bus) wiring for RS wakeup
    // ============================================================
    // CDB var declarations moved to top (before RS instantiation).
    // CDB port 0: EX-stage ALU/link results (early wakeup)
    // CDB port 0: EX-stage ALU/link results (early wakeup)
    let _cdb0_valid_w: logic     = ex_valid && ex_reg_wen && !ex_mem_ren && !ex_is_div && !stall_ex;
    let _cdb0_rob_w  : logic<5>  = ex_rob_idx;
    let _cdb0_epoch_w: logic<2>  = ex_epoch;
    let _cdb0_data_w : logic<64> = if ex_wb_sel == pipeline_pkg::WbSel::PC4 ? ex_link_addr : ex_alu_out;
    // CDB port 1: WB/MSHR/DIV async results + LQ retire (late wakeup).
    // LQ retire drives CDB1 for captured loads so RS dependents wake up
    // on the same cycle they would have via the normal WB path.
    // CDB1 uses div_broadcast_* (live pulse or pending-latch drain) so a
    // div completion colliding with mshr/normal_wb/lq is never lost.
    let _cdb1_valid_w: logic     = mshr_int_wb || div_broadcast_valid || normal_wb_complete || lq_wb_complete;
    let _cdb1_rob_w  : logic<5>  = if mshr_int_wb ? mshr_rob_idx
                                  : if div_broadcast_valid ? div_broadcast_rob
                                  : if lq_wb_complete ? lq_retire_rob
                                  : mem_rob_idx;
    let _cdb1_epoch_w: logic<2>  = if mshr_int_wb ? mshr_epoch
                                  : if div_broadcast_valid ? div_broadcast_epoch
                                  : if lq_wb_complete ? lq_retire_epoch
                                  : mem_epoch;
    let _cdb1_data_w : logic<64> = if mshr_int_wb ? mshr_wb_data
                                  : if div_broadcast_valid ? div_broadcast_data
                                  : if lq_wb_complete ? lq_retire_data
                                  : wb_data;
    // CDB port 2: slot1 EX result (dual-issue from RS)
    let _cdb2_valid_w: logic     = s1_ex_valid && s1_ex_reg_wen;
    let _cdb2_rob_w  : logic<5>  = s1_ex_rob_idx;
    let _cdb2_epoch_w: logic<2>  = s1_ex_rob_epoch;
    let _cdb2_data_w : logic<64> = s1_ex_alu_out;
    always_comb {
        cdb0_valid = _cdb0_valid_w;
        cdb0_rob   = _cdb0_rob_w;
        cdb0_epoch = _cdb0_epoch_w;
        cdb0_data  = _cdb0_data_w;
        cdb1_valid = _cdb1_valid_w;
        cdb1_rob   = _cdb1_rob_w;
        cdb1_epoch = _cdb1_epoch_w;
        cdb1_data  = _cdb1_data_w;
        cdb2_valid = _cdb2_valid_w;
        cdb2_rob   = _cdb2_rob_w;
        cdb2_epoch = _cdb2_epoch_w;
        cdb2_data  = _cdb2_data_w;
    }


    // ============================================================
    // Scoreboard stall computation (after dcache, uses mshr_absorb)
    // ============================================================
    // Result will be in MEM_WB (forwarding available) when load is in MEM
    // stage (ex_*) and advancing to WB (no dcache/mmu stall, not MSHR miss).
    let sb_avail_rs1: logic = ex_reg_wen && ex_rd_addr != 5'd0 && ex_rd_addr == ifid_rs1_addr
                           && !dcache_stall && !mmu_stall && !mshr_absorb;
    let sb_avail_rs2: logic = ex_reg_wen && ex_rd_addr != 5'd0 && ex_rd_addr == ifid_rs2_addr
                           && !dcache_stall && !mmu_stall && !mshr_absorb;
    // Result already in WB (mem_*): forwarding or regfile write-first resolves
    let sb_wb_rs1: logic = mem_reg_wen && mem_rd_addr != 5'd0 && mem_rd_addr == ifid_rs1_addr;
    let sb_wb_rs2: logic = mem_reg_wen && mem_rd_addr != 5'd0 && mem_rd_addr == ifid_rs2_addr;
    // EX-stage ALU forwarding: instruction in ID writes rs and is NOT a load/SC.
    // RS-eligible instructions also match: they go through RS with 1-cycle latency,
    // but enter EX in time for EX_MEM forwarding when the consumer reaches EX.
    let ex_alu_fwd_rs1: logic = id_reg_wen && id_rd_addr != 5'd0 && id_rd_addr == ifid_rs1_addr
                             && !id_mem_ren && !(id_is_amo && id_amo_funct5 == 5'b00011);
    let ex_alu_fwd_rs2: logic = id_reg_wen && id_rd_addr != 5'd0 && id_rd_addr == ifid_rs2_addr
                             && !id_mem_ren && !(id_is_amo && id_amo_funct5 == 5'b00011);
    // RAT-based stall: pending value not available via forwarding or ROB completion.
    // MSHR loads stay uncompleted in ROB until fill finishes (C0), so RAT correctly
    // stalls dependents. ALU results are forwarded (ex_alu_fwd) — no false stall.
    let rat_stall_rs1: logic = rat_rs1_valid && !rob_lookup1_completed
                            && !sb_avail_rs1 && !sb_wb_rs1 && !ex_alu_fwd_rs1;
    let rat_stall_rs2: logic = rat_rs2_valid && !rob_lookup2_completed
                            && !sb_avail_rs2 && !sb_wb_rs2 && !ex_alu_fwd_rs2;
    let rat_mem_stall: logic = !ex_load_use && (rat_stall_rs1 || rat_stall_rs2);
    // RS-eligible pre-decode (from IF/ID instruction): determines stall behavior.
    // Uses opcode directly (ifid_alloc_op may not be defined yet at this point).
    let ifid_op_for_rs: logic<7> = ifid_instr[6:0];
    let ifid_is_rs_eligible: logic =
        ifid_op_for_rs == 7'b0110011 || // OP (R-type, includes MUL/DIV)
        ifid_op_for_rs == 7'b0111011 || // OP-32
        ifid_op_for_rs == 7'b0010011 || // OP-IMM
        ifid_op_for_rs == 7'b0011011 || // OP-IMM-32
        ifid_op_for_rs == 7'b0110111 || // LUI
        ifid_op_for_rs == 7'b0010111 || // AUIPC
        ifid_op_for_rs == 7'b1100011 || // BRANCH (BEQ/BNE/BLT/BGE/BLTU/BGEU)
        ifid_op_for_rs == 7'b1100111;   // JALR

    // For RS-eligible IF/ID instructions, disable RAT/load-use stall.
    // RS handles operand tracking and dependency resolution via CDB.
    // RS full stall is handled separately via i_rs_stall (no flush, pure stall).
    // ID-stage RAT stall for direct-path instructions: if a non-RS instruction
    // in ID depends on a value that's still in the pipeline (RAT valid, ROB not
    // completed) and forwarding can't resolve it, stall until the value is available.
    // Uses i_rs_stall path (pure stall, no flush) to keep BNE alive in ID.
    // ID-stage RAT stall for direct-path instructions: stall until the source
    // register is available (ROB completed or forwarding). With ROB squash on
    // misprediction, completed entries are preserved and their values are correct.
    // Forwarding is "stale" when the forwarding source (EX/MEM or MEM/WB) has
    // a different ROB index than the RAT mapping for the same register address.
    // This means the value in the forwarding path is from a different (older/younger)
    // instruction, not the one the consumer actually needs.
    // Forwarding is stale when:
    // - ROB index mismatch (different instruction than RAT expects), OR
    // - Pipeline stage has RS-origin instruction — RS instructions can cause ROB
    //   index aliasing (wrap-around reuse) where the pipeline stage has the same
    //   ROB index as the RAT mapping but from a PREVIOUS allocation.
    //   Direct-path consumers must wait for ROB completion instead.
    // Forwarding stale detection: ROB index mismatch means the pipeline stage
    // has a different instruction than the RAT expects.
    // Forwarding stale detection: compare {epoch, rob_idx} to detect ROB index aliasing.
    // Without epoch, wrap-around reuse of 3-bit indices causes false forwarding matches.
    // LQ-4.4-a: When the instruction at MEM is a LQ-captured load, MEM_WB
    // forwarding's `wb_data` is not the authoritative load result — LQ's
    // port 3 retire path is. Suppress MEM_WB forwarding for captured loads
    // so consumers fall through to ROB/regfile reads (which reflect LQ
    // retire). Today this fires in a narrow window (ROB completed by port
    // 3 + RAT still pending commit) but the guard is structurally needed
    // before 4.4-c decouples alloc from complete and makes wb_data garbage
    // for captured loads.
    // Stale-forwarding detection: combined into var + always_comb to force
    // single-block evaluation (works around a simulator JIT ordering issue
    // where the `let` form of fwd_a_stale occasionally evaluated to 0 when
    // a valid mismatch case existed, letting direct-path branches fire with
    // stale forwarding — observed on rv64mi-pmpaddr beqz 0x1bc).
    var fwd_a_stale: logic;
    var fwd_b_stale: logic;
    always_comb {
        fwd_a_stale = (fwd_a != pipeline_pkg::FwdSel::NONE) && rat_id_rs1_valid
            && ((fwd_a == pipeline_pkg::FwdSel::EX_MEM && (ex_rob_idx != rat_id_rs1_rob_idx || ex_epoch != rat_id_rs1_rob_epoch))
             || (fwd_a == pipeline_pkg::FwdSel::MEM_WB && (mem_rob_idx != rat_id_rs1_rob_idx || mem_epoch != rat_id_rs1_rob_epoch || mem_was_lq)));
        fwd_b_stale = (fwd_b != pipeline_pkg::FwdSel::NONE) && rat_id_rs2_valid
            && ((fwd_b == pipeline_pkg::FwdSel::EX_MEM && (ex_rob_idx != rat_id_rs2_rob_idx || ex_epoch != rat_id_rs2_rob_epoch))
             || (fwd_b == pipeline_pkg::FwdSel::MEM_WB && (mem_rob_idx != rat_id_rs2_rob_idx || mem_epoch != rat_id_rs2_rob_epoch || mem_was_lq)));
    }
    // Direct-path stall: source register not available (in RAT, not completed,
    // and no valid forwarding — either no forwarding at all or stale forwarding).
    // Use rob_read*_completed (indexed by rat_id_rs*_rob_idx from decode output)
    // instead of rob_lookup*_completed (indexed by ifid_rs*_addr from IF/ID register)
    // to match the decode module's timing.
    // Epoch-aware stale: if ROB entry was reallocated (different epoch), the value
    // is already in the regfile — don't stall. Same logic as RS dispatch stale check.
    let id_rob_stale_rs1: logic = !rob_read1_valid || rob_read1_epoch != rat_id_rs1_rob_epoch;
    let id_rob_stale_rs2: logic = !rob_read2_valid || rob_read2_epoch != rat_id_rs2_rob_epoch;
    let id_direct_stall_rs1: logic = id_rs1_addr != 5'd0 && rat_id_rs1_valid && !id_rob_stale_rs1
        && !rob_read1_completed && (fwd_a == pipeline_pkg::FwdSel::NONE || fwd_a_stale);
    let id_direct_stall_rs2: logic = id_rs2_addr != 5'd0 && rat_id_rs2_valid && !id_rob_stale_rs2
        && !rob_read2_completed && (fwd_b == pipeline_pkg::FwdSel::NONE || fwd_b_stale);

    // FP direct-path stall: an FP op on the direct path reads a renamed FP
    // source that hasn't completed in ROB yet, and no FP forwarding path
    // provides the value. Covers FMV.X.D / FCVT.W.D / FCMP / FCLASS / FSD
    // that read an FP register whose producer is still in flight via FP RS.
    let fp_id_rob_stale_rs1: logic = !fp_rob_read1_valid
        || fp_rob_read1_epoch != fp_rat_id_rs1_rob_epoch;
    let fp_id_rob_stale_rs2: logic = !fp_rob_read2_valid
        || fp_rob_read2_epoch != fp_rat_id_rs2_rob_epoch;
    let fp_fwd_a_hit: logic = fp_fwd_a == pipeline_pkg::FwdSel::EX_MEM
                           || fp_fwd_a == pipeline_pkg::FwdSel::MEM_WB;
    let fp_fwd_b_hit: logic = fp_fwd_b == pipeline_pkg::FwdSel::EX_MEM
                           || fp_fwd_b == pipeline_pkg::FwdSel::MEM_WB;
    // FP forwarding is stale when the bypass stage's rob_idx/epoch do not
    // match the RAT's pending writer — the bypass is an older version of the
    // same arch reg, and the newer writer is still in FP RS / ROB. Analogous
    // to the integer `fwd_a_stale` check.
    let fp_fwd_a_stale: logic = fp_fwd_a != pipeline_pkg::FwdSel::NONE && fp_rat_id_rs1_valid
        && ((fp_fwd_a == pipeline_pkg::FwdSel::EX_MEM && (ex_rob_idx != fp_rat_id_rs1_rob_idx || ex_epoch != fp_rat_id_rs1_rob_epoch))
         || (fp_fwd_a == pipeline_pkg::FwdSel::MEM_WB && (mem_rob_idx != fp_rat_id_rs1_rob_idx || mem_epoch != fp_rat_id_rs1_rob_epoch || mem_was_lq)));
    let fp_fwd_b_stale: logic = fp_fwd_b != pipeline_pkg::FwdSel::NONE && fp_rat_id_rs2_valid
        && ((fp_fwd_b == pipeline_pkg::FwdSel::EX_MEM && (ex_rob_idx != fp_rat_id_rs2_rob_idx || ex_epoch != fp_rat_id_rs2_rob_epoch))
         || (fp_fwd_b == pipeline_pkg::FwdSel::MEM_WB && (mem_rob_idx != fp_rat_id_rs2_rob_idx || mem_epoch != fp_rat_id_rs2_rob_epoch || mem_was_lq)));
    // Any direct-path FP op that reads FP registers — i.e., id_is_fp without
    // being an FP load (FP loads read integer rs1 for the address).
    let id_fp_reads_fp: logic = id_is_fp && !id_mem_ren;
    let fp_id_direct_stall_rs1: logic = id_fp_reads_fp
        && fp_rat_id_rs1_valid && !fp_id_rob_stale_rs1
        && !fp_rob_read1_completed && (!fp_fwd_a_hit || fp_fwd_a_stale);
    let fp_id_direct_stall_rs2: logic = id_fp_reads_fp
        && fp_rat_id_rs2_valid && !fp_id_rob_stale_rs2
        && !fp_rob_read2_completed && (!fp_fwd_b_hit || fp_fwd_b_stale);

    // Exception-causing / pipeline-flushing instructions must not enter EX
    // until all previous instructions have committed from ROB (pipeline drain).
    // Without this, the flush (for the trap, or for mret/sret PC redirect)
    // fires while previous RS instructions are still in-flight, and their
    // results are lost when the ROB flushes.
    // Covers: ecall/ebreak, raw illegal, CSR privilege fault, mret/sret
    // (which flush the pipeline on return), mret/sret privilege fault,
    // sfence privilege fault, TVM/TSR traps, FP with FS=Off.
    let id_fp_fs_off: logic = id_is_fp && csr_fs == 2'b00;
    // CSR ops that touch fflags/frm/fcsr must drain the ROB first so any
    // in-flight FP RS-dispatched fflags-producing op has committed before
    // the read/modify returns. Otherwise csrr fflags could return a stale
    // value while a pending FCMP/FCVT.int in FP RS hasn't written fflags yet.
    let id_csr_fflags: logic = id_is_csr
        && (id_csr_addr == csr_pkg::CSR_FFLAGS
         || id_csr_addr == csr_pkg::CSR_FRM
         || id_csr_addr == csr_pkg::CSR_FCSR);
    // sfence.vma needs the ROB to drain so prior PTE writes land in dcache
    // before the TLB flush takes effect; without this, MMU's next PTW can
    // read the pre-store PTE from dcache and cache a stale translation.
    // Observed on rv64si-dirty TESTNUM 4 where the misaligned-superpage
    // trap was missed because PTW happened before the preceding sw committed.
    let rob_drain_needed: logic = (id_is_ecall || id_is_ebreak || id_illegal
                                || id_is_mret
                                || id_csr_fault_q
                                || mret_priv_fault || sret_priv_fault
                                || sfence_priv_fault || tvm_trap || tsr_trap
                                || id_fp_fs_off || id_csr_fflags
                                || id_is_sfence)
                                && rob_commit_idx != id_rob_idx;

    // SRS memory-ordering gate: direct-path loads / AMOs / FP stores wait
    // until SRS-queued stores have drained through MEM so dcache writes
    // land in program order.
    //   - !srs_empty: queue non-empty
    //   - srs_issue_valid: registered output asserted (store about to
    //     enter EX or has just entered) — queue may already show empty
    //     but the store hasn't reached MEM
    //   - ex_from_srs_q: store is in MEM this cycle; dcache write latches
    //     at end of cycle, so hold the load one more cycle
    // CSR writes (csrs/csrc to sstatus SUM/MXR bits, etc) may change MMU /
    // privilege state that gates the SRS-queued stores' own permission
    // check. If a csrc clearing SUM issues before the SRS-queued byte store
    // drains, the store hits MMU with SUM=0 and faults — observed as a
    // spurious kernel store page fault during /init uaccess under SRS-3c.
    // Drain SRS before any CSR op to preserve permission ordering.
    //
    // Direct-path LOAD relaxation: drain only when the load's effective VA
    // may overlap a pending store's bytes (±1 8B line compare, handling
    // misaligned ops). Covers two of the three stages of a pending store:
    //   - Queued in SRS — checked by srs_probe_alias
    //   - In MEM stage — ex_from_srs_q_alias using the latched addr
    // The intermediate srs_issue_valid case (store at EX comb) keeps an
    // unconditional drain: relaxing it allows direct_path_v=1 while SRS
    // asserts o_issue_valid, which the SRS protocol treats as "downstream
    // held" — SRS would either overwrite its own output with the next
    // entry or starve the store forever, depending on the next entry's
    // readiness. Safe to relax once SRS grows an ack/commit handshake.
    // Stores whose base isn't resolved inside SRS are conservatively
    // flagged as aliases by the probe. AMO / CSR / non-SRS stores keep
    // blanket drain whenever any stage is in flight.
    let id_load_probe_addr: logic<64> = (
        if rat_id_rs1_valid && rob_read1_epoch == rat_id_rs1_rob_epoch && rob_read1_completed ? rob_read1_data
        : if fwd_a == pipeline_pkg::FwdSel::EX_MEM ? ex_alu_out
        : if fwd_a == pipeline_pkg::FwdSel::MEM_WB ? wb_data
        : id_rs1_data
    ) + id_imm;
    let id_load_line       : logic<61> = id_load_probe_addr[63:3];
    let ex_srs_q_line      : logic<61> = ex_from_srs_q_addr[63:3];
    let ex_from_srs_q_alias: logic = ex_from_srs_q && (
        ex_srs_q_line == id_load_line
     || ex_srs_q_line + 61'd1 == id_load_line
     || id_load_line + 61'd1 == ex_srs_q_line);
    let srs_inflight   : logic = !srs_empty || srs_issue_valid || ex_from_srs_q;
    // P3.4 (d).3: distinguish KNOWN aliases (resolved store base + line
    // match — must drain regardless of load route) from UNRESOLVED aliases
    // (store base pending — only direct-path loads must drain). LQ-routed
    // loads can speculate past unresolved stores; the P3.4 squash machinery
    // (LQ retire stall + SRS-wake CAM + p34_replay latch) recovers if the
    // resolved address turns out to alias.
    // id_load_via_lq mirrors the gate that selects LQ alloc at ID for
    // pending-rs1 integer loads. Keep it inline (defined later: ~2936).
    let id_load_via_lq: logic = id_valid && id_mem_ren && !id_mem_wen
                              && !id_is_amo && !id_is_fp
                              && !id_is_csr && !id_is_ecall && !id_is_ebreak && !id_illegal
                              && id_direct_stall_rs1
                              && !id_direct_stall_rs2;
    let srs_known_alias: logic = srs_probe_alias && !srs_probe_alias_unresolved;
    let srs_load_drain_known    : logic = id_mem_ren
                                       && (srs_known_alias || srs_issue_valid || ex_from_srs_q_alias);
    let srs_load_drain_unresolved: logic = id_mem_ren
                                        && srs_probe_alias_unresolved
                                        && !id_load_via_lq;
    let srs_load_drain : logic = srs_load_drain_known || srs_load_drain_unresolved;
    let srs_other_drain: logic = (id_is_amo || id_is_csr
                                || (id_mem_wen && !id_is_srs_eligible)) && srs_inflight;
    let srs_drain_needed: logic = srs_load_drain || srs_other_drain;

    // ============================================================
    // P3.4 step (c): detection path
    // ============================================================
    // When an SRS entry's base operand just resolved, its effective VA
    // becomes knowable. If an LQ entry younger than this store has a
    // matching address, it read stale dcache under speculation and must
    // be replayed. This wiring only detects the condition; the actual
    // squash is gated by p34_spec_enable (still 0 in step (c)) and will
    // be enabled once the replay path lands (step (d)).
    //
    // Age: distance from rob_commit_idx (ROB head). In-flight entries are
    // in the range (head, tail], so a 5-bit subtract is wrap-safe and
    // distance comparison captures "younger".
    let p34_store_dist : logic<5> = srs_wake_rob     - rob_commit_idx;
    let p34_load_dist  : logic<5> = lq_probe_hit_rob - rob_commit_idx;
    let p34_load_younger: logic   = p34_load_dist >: p34_store_dist;
    let p34_spec_violation: logic = srs_wake_valid && lq_probe_hit && p34_load_younger;

    // P3.4 (d).2: replay latch (1-cycle delay).
    // Latching p34_spec_violation into a register avoids new combinational
    // paths through the squash fabric (ex_misprediction is already comb
    // from EX inputs, while srs_wake/lq_probe path would create a parallel
    // comb chain). The 1-cycle latency is safe because ROB in-order commit
    // guarantees the offending LOAD cannot commit before the older STORE
    // that woke it — the latched p34 still catches the LOAD before it
    // architecturally retires.
    always_ff (clk, rst) {
        if_reset {
            p34_replay_valid_q   = 1'b0;
            p34_replay_idx_q     = 5'd0;
            p34_replay_epoch_q   = 2'd0;
            p34_replay_pc_q      = 64'd0;
        } else {
            // Suppress new latch when another redirect already fired this
            // cycle: ex_misprediction has its own squash, and trap/xret will
            // flush regardless. Lets the higher-priority redirect win and
            // keeps p34_replay from stomping it next cycle.
            if p34_spec_violation && !ex_misprediction
                                  && !trap_taken && !mret_taken && !sret_taken {
                p34_replay_valid_q = 1'b1;
                p34_replay_idx_q   = lq_probe_hit_rob;
                p34_replay_epoch_q = lq_probe_hit_epoch;
                p34_replay_pc_q    = lq_probe_hit_pc;
            } else {
                p34_replay_valid_q = 1'b0;
            }
        }
    }

    // P3.2 Stage 2: integer loads with pending rs1 can side-step direct-path
    // stall by allocating an LQ entry that waits for CDB wake, then
    // re-injects into EX once s1 resolves. AMO/FP/cross-DW stay on the
    // direct path (cross-DW is unknowable at ID — tolerated because
    // direct_stall_rs1 gates on resolvable rs1 only).
    let id_is_lq_pending_eligible: logic = id_valid && id_mem_ren && !id_mem_wen
        && !id_is_amo && !id_is_fp
        && !id_is_csr && !id_is_ecall && !id_is_ebreak && !id_illegal;
    let id_load_rs1_pending: logic = id_is_lq_pending_eligible && id_direct_stall_rs1
        && !id_direct_stall_rs2 && !fp_id_direct_stall_rs1 && !fp_id_direct_stall_rs2;
    // Fire LQ-ID alloc when: load has pending rs1, LQ has room, ROB is not
    // full (or already allocated), not already dispatched via LQ.
    // Note: !flush_id is intentionally NOT in this expression — gating on it
    // closes a comb loop (flush_id ← ex_misprediction ← execute.i_valid ←
    // ex_in_valid ← direct_path_v ← !id_direct_stall ← !lq_id_alloc_fire).
    // flush_id squashes any wrong-path LQ entry via the squash mask anyway,
    // so we land the gate at the LQ instance instead.
    // satp=0 gate: only enable LQ when MMU is disabled. With LQ on through
    // S-mode + Sv39, several distinct correctness bugs surface (rv64ui-sd
    // store-load ordering, hello_str UART MMIO, smode_* tests). Linux boot
    // and Dhrystone (bare-metal) work with LQ on. The remaining bugs are
    // tracked separately and gated until fixed.
    // bug-b: SRS pre-fire alias probe handles memory ordering on Verilator,
    // and srs_yield + lq_yield handle priority inversion under IRQ wait
    // (direct_path_v starvation of SRS/LQ during ROB drain). With satp gate
    // dropped, Verilator passes Linux boot but the Veryl simulator hangs at
    // PC 0x800b3744 due to a known cross-module comb-mux bug in the Veryl
    // simulator (see project_sim_sb_fwd_mux_bug). Keep the satp=0 gate so
    // the default Veryl simulator passes; revisit when the simulator bug
    // is fixed.
    let _lq_id_alloc_fire_eligible: logic = id_load_rs1_pending
                           && lq_alloc_ready
                           && (csr_satp == 64'd0)
                           && (!rob_full || id_has_rob)
                           && !lq_id_dispatched_q
                           && !rob_drain_needed
                           && !srs_drain_needed;
    assign lq_id_alloc_fire = _lq_id_alloc_fire_eligible;
    assign lq_id_s1_ready = 1'b0;
    assign lq_id_s1_tag   = rat_id_rs1_rob_idx;
    assign lq_id_s1_epoch = rat_id_rs1_rob_epoch;
    assign lq_id_s1_data  = 64'd0;
    // Re-inject is consumed by EX whenever the mux selects ex_from_lq and
    // EX isn't stalled (stall_ex would re-fire next cycle anyway).
    assign lq_reinject_fire = ex_from_lq && !stall_ex;

    // rs_yield is set in heliodor_top main always_ff (reset block)
    always_comb {
        // Direct-path stall: operand depends on in-flight RS instruction whose
        // result isn't available yet (not completed in ROB, not in forwarding path).
        // Also drain ROB before exception-causing instructions.
        // SRS-eligible stores bypass direct-path and are not evaluated here.
        // LQ-pending-eligible loads also bypass direct-path once we commit
        // them to the LQ re-inject queue; until then they remain a stall.
        id_direct_stall = !id_is_rs_eligible && !id_is_fp_rs_eligible && !id_is_srs_eligible
                       && !lq_id_alloc_fire
                       && (id_direct_stall_rs1 || id_direct_stall_rs2
                                                || fp_id_direct_stall_rs1 || fp_id_direct_stall_rs2
                                               || rob_drain_needed
                                               || srs_drain_needed);
        // Normal: direct-path takes EX. RS yield: RS takes EX for one cycle.
        // Allow EX entry when instruction already has a ROB entry (id_has_rob),
        // even if ROB is full — the entry was allocated before ROB filled.
        // Block only if ROB is full AND no entry allocated (would use stale rob_idx).
        // Re-evaluation gate applied only to AMO-RMW (re-reads dcache and
        // corrupts amo_old with its own post-write value). Other direct-path
        // ops tolerate re-evaluation; LR/SC are idempotent.
        // SRS-eligible stores are excluded — they flow through SRS instead.
        // Also gate on !rs_issue_valid / !srs_issue_valid / !fp_rs_issue_valid /
        // !lq_reinject_valid: when any of these issue paths has a registered
        // output high (= already issued this cycle, slot freed), EX must
        // consume it before direct path proceeds. Without this gate,
        // direct_path_v=1 takes EX-register priority and the previously-issued
        // instruction is silently dropped — its ROB entry waits forever for
        // a complete that never fires. Observed under JALR routing as a
        // sequence of stalls (PC=0x80202250 → 0x80047dda → ...).
        direct_path_v = id_valid && !id_is_rs_eligible && !id_is_fp_rs_eligible && !id_is_srs_eligible && !rs_yield && !srs_yield && !lq_yield
                      && (!rob_full || id_has_rob) && !id_direct_stall
                      && !lq_id_alloc_fire && !lq_id_dispatched_q
                      && !(direct_path_dispatched_q && id_direct_oneshot_scope)
                      && !rs_issue_valid && !srs_issue_valid && !fp_rs_issue_valid && !lq_reinject_valid;
    }

    // sb_stall: load-use hazard + RAT dependency stall.
    // Suppress when id_is_rs_eligible (RS handles via CDB) or id_direct_stall
    // (instruction can't enter EX yet — premature flush would destroy it).
    // P3.2 bug (d) fix: also suppress when the load went to LQ. LQ-dispatched
    // loads complete via CDB1/port-3 asynchronously; the dependent in IFID
    // resolves through RAT/ROB.completed at its own dispatch. ex_load_use
    // here would freeze ID at the load forever — load_use hazard logic was
    // written for direct-path loads only.
    assign sb_stall = if id_is_rs_eligible || id_direct_stall || lq_id_alloc_fire || lq_id_dispatched_q ? 1'b0
                    : (ex_load_use || rat_mem_stall);

    // ============================================================
    // RS operand resolution at dispatch time
    // ============================================================
    // src1: depends on alu_src_a (REG needs tracking, PC/ZERO always ready)
    let rs_s1_from_reg: logic = id_alu_src_a == pipeline_pkg::AluSrcA::REG;
    // With rename at dispatch time (not IF/ID→ID), the RAT lookup sees the
    // PREVIOUS mapping, not the instruction's own rename. No self-reference issue.
    // Stale mapping: RAT points to squashed ROB entry (after misprediction).
    // Use ROB read port completion/validity (ID-stage index) for RS dispatch.
    // Stale: ROB entry invalid (squashed/committed) OR reallocated (epoch mismatch).
    // In both cases, the value is in the regfile (already committed).
    let rs_stale_s1: logic = rs_s1_from_reg && rat_id_rs1_valid
        && (!rob_read1_valid || rob_read1_epoch != rat_id_rs1_rob_epoch);
    let rs_s1_ready: logic = !rs_s1_from_reg || rs_stale_s1 || !rat_id_rs1_valid || rob_read1_completed;
    let rs_s1_tag  : logic<5> = rat_id_rs1_rob_idx;
    let rs_s1_data : logic<64> = if !rs_s1_from_reg ? 64'd0
                                : if rs_stale_s1 ? id_rs1_data
                                : if !rat_id_rs1_valid ? id_rs1_data
                                : rob_read1_data;
    // src2
    let rs_s2_from_reg: logic = id_alu_src_b == pipeline_pkg::AluSrcB::REG;
    let rs_stale_s2: logic = rs_s2_from_reg && rat_id_rs2_valid
        && (!rob_read2_valid || rob_read2_epoch != rat_id_rs2_rob_epoch);
    let rs_s2_ready: logic = !rs_s2_from_reg || rs_stale_s2 || !rat_id_rs2_valid || rob_read2_completed;
    let rs_s2_tag  : logic<5> = rat_id_rs2_rob_idx;
    let rs_s2_data : logic<64> = if !rs_s2_from_reg ? 64'd0
                                : if rs_stale_s2 ? id_rs2_data
                                : if !rat_id_rs2_valid ? id_rs2_data
                                : rob_read2_data;

    // ============================================================
    // SRS operand resolution at dispatch time
    // Stores use rs1 (base) and rs2 (data) directly — no AluSrcA/B gating.
    // ============================================================
    let srs_stale_s1: logic = rat_id_rs1_valid
        && (!rob_read1_valid || rob_read1_epoch != rat_id_rs1_rob_epoch);
    let srs_s1_ready: logic    = srs_stale_s1 || !rat_id_rs1_valid || rob_read1_completed;
    let srs_s1_tag  : logic<5> = rat_id_rs1_rob_idx;
    let srs_s1_data : logic<64> = if srs_stale_s1 ? id_rs1_data
                                 : if !rat_id_rs1_valid ? id_rs1_data
                                 : rob_read1_data;
    let srs_stale_s2: logic = rat_id_rs2_valid
        && (!rob_read2_valid || rob_read2_epoch != rat_id_rs2_rob_epoch);
    let srs_s2_ready: logic    = srs_stale_s2 || !rat_id_rs2_valid || rob_read2_completed;
    let srs_s2_tag  : logic<5> = rat_id_rs2_rob_idx;
    let srs_s2_data : logic<64> = if srs_stale_s2 ? id_rs2_data
                                 : if !rat_id_rs2_valid ? id_rs2_data
                                 : rob_read2_data;

    // RS instantiation
    inst u_rs: reservation_station (
        clk                                            ,
        rst                                            ,
        i_dispatch_valid : rs_dispatch_valid            ,
        i_dispatch_pc    : id_pc                       ,
        i_dispatch_alu_op: id_alu_op                   ,
        i_dispatch_src_a : id_alu_src_a                ,
        i_dispatch_src_b : id_alu_src_b                ,
        i_dispatch_imm   : id_imm                      ,
        i_dispatch_rd    : id_rd_addr                  ,
        i_dispatch_rs1   : id_rs1_addr                 ,
        i_dispatch_rs2   : id_rs2_addr                 ,
        i_dispatch_wen   : id_reg_wen                  ,
        i_dispatch_rob   : id_rob_idx                  ,
        i_dispatch_epoch : id_epoch                    ,
        i_dispatch_s1_ready: rs_s1_ready               ,
        i_dispatch_s1_tag  : rs_s1_tag                 ,
        i_dispatch_s1_epoch: rat_id_rs1_rob_epoch      ,
        i_dispatch_s1_data : rs_s1_data                ,
        i_dispatch_s2_ready: rs_s2_ready               ,
        i_dispatch_s2_tag  : rs_s2_tag                 ,
        i_dispatch_s2_epoch: rat_id_rs2_rob_epoch      ,
        i_dispatch_s2_data : rs_s2_data                ,
        // Branch/JALR fields (zero for ALU-class entries)
        i_dispatch_is_branch     : id_is_branch         ,
        i_dispatch_is_jalr       : id_is_jalr           ,
        i_dispatch_funct3        : id_funct3            ,
        i_dispatch_predict_taken : id_predict_taken     ,
        i_dispatch_predict_target: id_predict_target    ,
        i_dispatch_is_compressed : id_is_compressed     ,
        o_dispatch_ready   : rs_dispatch_ready         ,
        o_issue_valid  : rs_issue_valid                ,
        o_issue_pc     : rs_issue_pc                   ,
        o_issue_alu_op : rs_issue_alu_op               ,
        o_issue_src_a  : rs_issue_src_a                ,
        o_issue_src_b  : rs_issue_src_b                ,
        o_issue_imm    : rs_issue_imm                  ,
        o_issue_rd     : rs_issue_rd                   ,
        o_issue_rs1    : rs_issue_rs1                  ,
        o_issue_rs2    : rs_issue_rs2                  ,
        o_issue_s1_data: rs_issue_s1_data              ,
        o_issue_s2_data: rs_issue_s2_data              ,
        o_issue_wen    : rs_issue_wen                  ,
        o_issue_rob    : rs_issue_rob                  ,
        o_issue_epoch  : rs_issue_epoch                ,
        o_issue_is_branch     : rs_issue_is_branch     ,
        o_issue_is_jalr       : rs_issue_is_jalr       ,
        o_issue_funct3        : rs_issue_funct3        ,
        o_issue_predict_taken : rs_issue_predict_taken ,
        o_issue_predict_target: rs_issue_predict_target,
        o_issue_is_compressed : rs_issue_is_compressed ,
        i_issue_stall  : rs_issue_stall                ,
        // Secondary issue port (slot1)
        o_issue2_valid  : rs_issue2_valid              ,
        o_issue2_pc     : rs_issue2_pc                 ,
        o_issue2_alu_op : rs_issue2_alu_op             ,
        o_issue2_src_a  : rs_issue2_src_a              ,
        o_issue2_src_b  : rs_issue2_src_b              ,
        o_issue2_imm    : rs_issue2_imm                ,
        o_issue2_rd     : rs_issue2_rd                 ,
        o_issue2_rs1    : rs_issue2_rs1                ,
        o_issue2_rs2    : rs_issue2_rs2                ,
        o_issue2_s1_data: rs_issue2_s1_data            ,
        o_issue2_s2_data: rs_issue2_s2_data            ,
        o_issue2_wen    : rs_issue2_wen                ,
        o_issue2_rob    : rs_issue2_rob                ,
        o_issue2_epoch  : rs_issue2_epoch              ,
        i_issue2_stall  : stall_ex                     , // F0: full dual-issue
        i_cdb0_valid   : cdb0_valid                    ,
        i_cdb0_rob     : cdb0_rob                      ,
        i_cdb0_epoch   : cdb0_epoch                    ,
        i_cdb0_data    : cdb0_data                     ,
        i_cdb1_valid   : cdb1_valid                    ,
        i_cdb1_rob     : cdb1_rob                      ,
        i_cdb1_epoch   : cdb1_epoch                    ,
        i_cdb1_data    : cdb1_data                     ,
        i_cdb2_valid   : cdb2_valid                    ,
        i_cdb2_rob     : cdb2_rob                      ,
        i_cdb2_epoch   : cdb2_epoch                    ,
        i_cdb2_data    : cdb2_data                     ,
        i_flush: trap_taken || mret_taken || sret_taken,
        i_squash_valid: pipeline_squash               ,
        i_squash_mask : rob_squash_mask                 ,
        o_sel_valid   : rs_sel_valid                    ,
    );

    // ============================================================
    // SRS instantiation (SRS-2 observational: dispatch only, no issue wiring)
    // Stores dispatch here AND proceed on the direct path. The SRS issue
    // output drains entries once operands resolve, but goes nowhere — the
    // store's actual MEM/dcache write happens on the direct-path side.
    // This lets us measure wakeup/issue rate before committing to a real
    // pipeline cutover (SRS-3).
    // ============================================================
    // Phase 4 / bug-b: SRS issue effective VA = base + sign-extended imm.
    // Used to probe LQ for older pending loads at the same line.
    let srs_issue_va: logic<64> = srs_issue_s1_data + srs_issue_imm;

    inst u_srs: store_reservation_station (
        clk                                               ,
        rst                                               ,
        i_dispatch_valid   : srs_dispatch_valid           ,
        i_dispatch_pc      : id_pc                        ,
        i_dispatch_imm     : id_imm                       ,
        i_dispatch_funct3  : id_mem_funct3                ,
        i_dispatch_rs1     : id_rs1_addr                  ,
        i_dispatch_rs2     : id_rs2_addr                  ,
        i_dispatch_rob     : id_rob_idx                   ,
        i_dispatch_epoch   : id_epoch                     ,
        i_dispatch_s1_ready: srs_s1_ready                 ,
        i_dispatch_s1_tag  : srs_s1_tag                   ,
        i_dispatch_s1_epoch: rat_id_rs1_rob_epoch         ,
        i_dispatch_s1_data : srs_s1_data                  ,
        i_dispatch_s2_ready: srs_s2_ready                 ,
        i_dispatch_s2_tag  : srs_s2_tag                   ,
        i_dispatch_s2_epoch: rat_id_rs2_rob_epoch         ,
        i_dispatch_s2_data : srs_s2_data                  ,
        o_dispatch_ready   : srs_dispatch_ready           ,
        o_issue_valid      : srs_issue_valid              ,
        o_issue_pc         : srs_issue_pc                 ,
        o_issue_imm        : srs_issue_imm                ,
        o_issue_funct3     : srs_issue_funct3             ,
        o_issue_rs1        : srs_issue_rs1                ,
        o_issue_rs2        : srs_issue_rs2                ,
        o_issue_s1_data    : srs_issue_s1_data            ,
        o_issue_s2_data    : srs_issue_s2_data            ,
        o_issue_rob        : srs_issue_rob                ,
        o_issue_epoch      : srs_issue_epoch              ,
        // SRS-3c: live issue arbitration. SRS fires when slot0 isn't claimed
        // by direct path or int RS. FP RS is below SRS in priority.
        // Phase 4 / bug-b: also stall when an older LQ-pending load shares
        // the SRS line. Without this, the SRS store reaches MEM and writes
        // dcache before the LQ load re-injects, violating memory order.
        // alias gate goes via i_issue_inhibit (forces valid=0); other
        // stalls go via i_issue_stall (holds FF, ok because mux/stall_ex
        // already gates EX consumption).
        i_issue_stall      : stall_ex || direct_path_v || rs_issue_valid,
        i_issue_inhibit    : lq_alias_srs_hit                ,
        i_cdb0_valid       : cdb0_valid                   ,
        i_cdb0_rob         : cdb0_rob                     ,
        i_cdb0_epoch       : cdb0_epoch                   ,
        i_cdb0_data        : cdb0_data                    ,
        i_cdb1_valid       : cdb1_valid                   ,
        i_cdb1_rob         : cdb1_rob                     ,
        i_cdb1_epoch       : cdb1_epoch                   ,
        i_cdb1_data        : cdb1_data                    ,
        i_cdb2_valid       : cdb2_valid                   ,
        i_cdb2_rob         : cdb2_rob                     ,
        i_cdb2_epoch       : cdb2_epoch                   ,
        i_cdb2_data        : cdb2_data                    ,
        i_flush            : trap_taken || mret_taken || sret_taken,
        i_squash_valid     : pipeline_squash             ,
        i_squash_mask      : rob_squash_mask              ,
        // Load alias probe: effective VA = forwarded rs1 + id_imm.
        i_probe_addr            : id_load_probe_addr       ,
        o_probe_alias           : srs_probe_alias          ,
        o_probe_alias_unresolved: srs_probe_alias_unresolved,
        // Wake event: when an SRS entry's base resolves via CDB.
        // Consumed by step (c) to CAM the LQ for speculative loads.
        o_wake_valid       : srs_wake_valid               ,
        o_wake_rob         : srs_wake_rob                 ,
        o_wake_epoch       : srs_wake_epoch               ,
        o_wake_addr        : srs_wake_addr                ,
        o_count            : srs_count                    ,
        o_full             : srs_full                     ,
        o_empty            : srs_empty                    ,
        o_oldest_rob       : srs_oldest_rob               ,
        o_cand_valid       : srs_cand_valid               ,
        o_cand_addr        : srs_cand_addr                ,
        o_cand_rob         : srs_cand_rob                 ,
        o_cand_epoch       : srs_cand_epoch               ,
        o_cand_s1_ready    : srs_cand_s1_ready            ,
        o_cand_s1_tag      : srs_cand_s1_tag              ,
        o_cand_s1_epoch    : srs_cand_s1_epoch            ,
        o_cand_funct3      : srs_cand_funct3              ,
    );

    // ============================================================
    // ROB: in-order commit drives integer regfile write.
    // Same-cycle complete+commit bypass preserves WB timing.
    // ============================================================
    // Pre-decode: does this instruction write an integer register?
    let ifid_alloc_op: logic<7> = ifid_instr[6:0];
    let ifid_alloc_f5: logic<5> = ifid_instr[31:27];
    // OP-FP instructions that write integer rd (not FP rd)
    let ifid_fp_writes_int: logic = ifid_alloc_op == 7'b1010011 && (
        ifid_alloc_f5 == 5'b11100 || // FMV.X.W/D, FCLASS
        ifid_alloc_f5 == 5'b11000 || // FCVT.W.S/D
        ifid_alloc_f5 == 5'b10100 || // FEQ, FLT, FLE
        ifid_alloc_f5 == 5'b11010    // FCVT.L.S/D (RV64)
    );
    // Match decoder behavior: wen=1 even for rd=x0 (regfile ignores x0 writes)
    let ifid_alloc_wen: logic =
        ifid_alloc_op == 7'b0110011 || // OP (R-type)
        ifid_alloc_op == 7'b0111011 || // OP-32
        ifid_alloc_op == 7'b0010011 || // OP-IMM
        ifid_alloc_op == 7'b0011011 || // OP-IMM-32
        ifid_alloc_op == 7'b0000011 || // LOAD
        ifid_alloc_op == 7'b1100111 || // JALR
        ifid_alloc_op == 7'b1101111 || // JAL
        ifid_alloc_op == 7'b0110111 || // LUI
        ifid_alloc_op == 7'b0010111 || // AUIPC
        ifid_alloc_op == 7'b0101111 || // AMO
        (ifid_alloc_op == 7'b1110011 && ifid_instr[14:12] != 3'd0) || // CSR
        ifid_fp_writes_int; // OP-FP int-writing variants

    // FP alloc predicates for ROB (matches decode's is_fp / fp_reg_wen semantics).
    let ifid_fp_load  : logic = ifid_alloc_op == 7'b0000111;
    let ifid_fp_store : logic = ifid_alloc_op == 7'b0100111;
    let ifid_fp_arith : logic = ifid_alloc_op == 7'b1010011 && !ifid_fp_writes_int;
    let ifid_fmadd    : logic = ifid_alloc_op == 7'b1000011 || ifid_alloc_op == 7'b1000111
                             || ifid_alloc_op == 7'b1001011 || ifid_alloc_op == 7'b1001111;
    let ifid_alloc_fp_wen: logic = ifid_fp_load || ifid_fp_arith || ifid_fmadd;
    let ifid_is_fp       : logic = ifid_fp_load || ifid_fp_store
                                || ifid_alloc_op == 7'b1010011 || ifid_fmadd;

    // ROB exception recording (forward-declared; computed after trap detection)
    var exc_rob_valid: logic    ;
    var exc_rob_cause: logic<64>;

    inst u_rob: rob (
        clk                                                        ,
        rst                                                        ,
        i_alloc_valid : !stall_id && !flush_id && ifid_valid       ,
        i_alloc_pc    : ifid_pc                                    ,
        i_alloc_rd    : ifid_instr[11:7]                           ,
        i_alloc_wen   : ifid_alloc_wen                             ,
        i_alloc_is_fp : ifid_is_fp                                ,
        i_alloc_fp_wen: ifid_alloc_fp_wen                         ,
        i_alloc_compr : ifid_compressed                            ,
        o_alloc_idx   : rob_alloc_idx                              ,
        o_alloc_epoch : rob_alloc_epoch                            ,
        o_alloc_ready : rob_alloc_ready                            ,
        // Complete port 1: MSHR > normal WB. D2 async DIV moved to port 4.
        // normal_wb_complete excludes mem_was_lq so captured loads go
        // through ROB port 3 (LQ retire) instead.
        i_complete_valid: if mshr_int_wb ? 1'b1
                        : normal_wb_complete,
        i_complete_idx  : if mshr_int_wb ? mshr_rob_idx
                        : mem_rob_idx,
        i_complete_data : if mshr_int_wb ? mshr_wb_data
                        : wb_data,
        i_complete_epoch: if mshr_int_wb ? mshr_epoch
                        : mem_epoch,
        i_complete_pc   : if mshr_int_wb ? mshr_pc
                        : mem_pc,
        // Complete port 2: slot1 EX result (dual-issue from RS)
        i_complete2_valid: cdb2_valid                              ,
        i_complete2_idx  : cdb2_rob                                ,
        i_complete2_epoch: cdb2_epoch                              ,
        i_complete2_data : cdb2_data                               ,
        i_complete2_pc   : s1_ex_pc                                ,
        // Complete port 3: LQ retire. MEM-sync now enforced inside the LQ
        // module (output gate on o_retire_valid), so no external gate here
        // — lq_retire_valid only fires on cycles where head's rob/epoch
        // matches MEM.
        i_complete3_valid: lq_retire_valid                         ,
        i_complete3_idx  : lq_retire_rob                           ,
        i_complete3_epoch: lq_retire_epoch                         ,
        i_complete3_data : lq_retire_data                          ,
        i_complete3_pc   : lq_retire_pc                            ,
        // Port 4: D2 async DIV completion (dedicated, no conflict gating).
        i_complete4_valid: div_async_valid                         ,
        i_complete4_idx  : ex_div_complete_rob_idx                 ,
        i_complete4_epoch: ex_div_complete_epoch                   ,
        i_complete4_data : ex_div_complete_data                    ,
        i_exc_valid   : exc_rob_valid                               ,
        i_exc_idx     : ex_rob_idx                                 ,
        i_exc_cause   : exc_rob_cause                              ,
        i_suppress_wen_valid: 1'b0                                   , // not needed: mshr_int_wb overwrites
        i_suppress_wen_idx  : 5'd0                                  ,
        // Cancel flushed RS-eligible instructions: when flush_id destroys
        // an RS-eligible instruction that was allocated a ROB entry but not
        // yet dispatched to RS, mark the entry as completed (wen=0) so it
        // can commit harmlessly and free the ROB slot + RAT mapping.
        // Cancel flushed instructions: when flush_id destroys an instruction
        // that has a ROB entry but won't complete normally.
        // Cancel orphaned ROB entries: instruction flushed from ID but has ROB entry.
        // Skip if entering EX (direct_path_v) or dispatched to RS (rs_dispatched_q).
        i_cancel_valid: flush_id && id_valid && id_has_rob
                      && !direct_path_v && !rs_dispatched_q,
        i_cancel_idx  : id_rob_idx                                  ,
        o_commit_valid : rob_commit_valid                           ,
        o_commit_pc    : rob_commit_pc                              ,
        o_commit_rd    : rob_commit_rd                              ,
        o_commit_data  : rob_commit_data                            ,
        o_commit_wen   : rob_commit_wen                             ,
        o_commit_is_fp : rob_commit_is_fp                           ,
        o_commit_fp_wen: rob_commit_fp_wen                          ,
        o_commit_compr : rob_commit_compr                           ,
        o_commit_exc   : rob_commit_exc                             ,
        o_commit_cause : rob_commit_cause                           ,
        o_commit_epoch : rob_commit_epoch                           ,
        i_commit_ack  : 1'b1                                       , // auto-commit
        i_flush       : trap_taken || mret_taken || sret_taken,
        i_squash_valid: pipeline_squash                             ,
        // ex_misprediction fires combinationally for the instruction ENTERING EX
        // (same as execute module's i_valid = ex_in_valid). Use ex_in_rob_idx
        // which is the ROB index of that instruction, not ex_rob_idx (previous cycle).
        // P3.4 (d).2: when p34_replay_valid_q fires, squash from the offending
        // LOAD itself (inclusive) so it re-fetches and re-issues from PC.
        i_squash_idx  : pipeline_squash_idx                             ,
        // Lookup: IF/ID-stage index for scoreboard stall.
        // RS operand resolution uses read ports instead.
        i_lookup1_idx      : rat_rs1_rob_idx                          ,
        o_lookup1_completed: rob_lookup1_completed                  ,
        o_lookup1_valid    : rob_lookup1_valid                      ,
        i_lookup2_idx      : rat_rs2_rob_idx                         ,
        o_lookup2_completed: rob_lookup2_completed                  ,
        o_lookup2_valid    : rob_lookup2_valid                      ,
        i_read1_idx        : rat_id_rs1_rob_idx                      ,
        o_read1_data       : rob_read1_data                         ,
        o_read1_completed  : rob_read1_completed                    ,
        o_read1_valid      : rob_read1_valid                        ,
        o_read1_epoch      : rob_read1_epoch                        ,
        i_read2_idx        : rat_id_rs2_rob_idx                     ,
        o_read2_data       : rob_read2_data                         ,
        o_read2_completed  : rob_read2_completed                    ,
        o_read2_valid      : rob_read2_valid                        ,
        o_read2_epoch      : rob_read2_epoch                        ,
        i_read3_idx        : fp_rat_id_rs1_rob_idx                  ,
        o_read3_data       : fp_rob_read1_data                      ,
        o_read3_completed  : fp_rob_read1_completed                 ,
        o_read3_valid      : fp_rob_read1_valid                     ,
        o_read3_epoch      : fp_rob_read1_epoch                     ,
        i_read4_idx        : fp_rat_id_rs2_rob_idx                  ,
        o_read4_data       : fp_rob_read2_data                      ,
        o_read4_completed  : fp_rob_read2_completed                 ,
        o_read4_valid      : fp_rob_read2_valid                     ,
        o_read4_epoch      : fp_rob_read2_epoch                     ,
        i_read5_idx        : fp_rat_id_rs3_rob_idx                  ,
        o_read5_data       : fp_rob_read3_data                      ,
        o_read5_completed  : fp_rob_read3_completed                 ,
        o_read5_valid      : fp_rob_read3_valid                     ,
        o_read5_epoch      : fp_rob_read3_epoch                     ,
        o_squash_mask      : rob_squash_mask                          ,
        o_empty            : rob_empty                               ,
        o_full             : rob_full                                ,
        o_commit_idx       : rob_commit_idx                          ,
    );

    // ============================================================
    // RAT (shadow mode: tracks register→ROB mappings, not yet used for stall)
    // Rename on allocation, commit on ROB commit, flush on pipeline flush.
    // ============================================================
    inst u_rat: rat (
        clk                                                        ,
        rst                                                        ,
        // Rename at dispatch/EX-entry time to avoid self-reference.
        // P3.2 Stage 2b: LQ-pending alloc also renames the load's rd so
        // dependents see rob_idx in RAT (instead of stale regfile/older idx).
        i_rename_valid: (rs_dispatch_valid && rs_dispatch_ready)
                     || (direct_path_v && !stall_ex && id_reg_wen)
                     || (fp_rs_dispatch_valid && fp_rs_dispatch_ready && id_reg_wen)
                     || (lq_id_alloc_fire && id_reg_wen),
        i_rename_rd   : id_rd_addr                                 ,
        i_rename_idx  : id_rob_idx                                 ,
        i_rename_epoch: id_epoch                                   ,
        i_commit_valid: rob_commit_valid                            ,
        i_commit_rd   : rob_commit_rd                               ,
        i_commit_idx  : rob_commit_idx                              ,
        i_commit_epoch: rob_commit_epoch                             ,
        i_rs1_addr    : ifid_rs1_addr                               ,
        o_rs1_valid   : rat_rs1_valid                               ,
        o_rs1_rob_idx   : rat_rs1_rob_idx                             ,
        o_rs1_rob_epoch : _                                          ,
        i_rs2_addr      : ifid_rs2_addr                               ,
        o_rs2_valid     : rat_rs2_valid                               ,
        o_rs2_rob_idx   : rat_rs2_rob_idx                             ,
        o_rs2_rob_epoch : _                                          ,
        i_rs3_addr    : if_instr[19:15]                             , // bubble fill rs1
        o_rs3_valid   : rat_fill_rs1_valid                          ,
        i_rs4_addr    : if_instr[24:20]                             , // bubble fill rs2
        o_rs4_valid   : rat_fill_rs2_valid                          ,
        // ID-stage lookup ports (for RS operand resolution)
        i_id_rs1_addr    : id_rs1_addr                                ,
        o_id_rs1_valid     : _raw_rat_id_rs1_valid                    ,
        o_id_rs1_rob_idx   : _raw_rat_id_rs1_rob_idx                  ,
        o_id_rs1_rob_epoch : _raw_rat_id_rs1_rob_epoch                ,
        i_id_rs2_addr      : id_rs2_addr                              ,
        o_id_rs2_valid     : _raw_rat_id_rs2_valid                    ,
        o_id_rs2_rob_idx   : _raw_rat_id_rs2_rob_idx                  ,
        o_id_rs2_rob_epoch : _raw_rat_id_rs2_rob_epoch                ,
        i_id_rs3_addr      : 5'd0                                     , // integer RS has no rs3
        o_id_rs3_valid     : _                                        ,
        o_id_rs3_rob_idx   : _                                        ,
        o_id_rs3_rob_epoch : _                                        ,
        // Misprediction: use squash (selective) instead of flush (full).
        // Full flush on misprediction discards PRE-branch renames that are
        // still in-flight (e.g. li ra, 1 before beqz), causing subsequent
        // instructions to read stale regfile values.
        // Do NOT use i_undo: the undo buffer only tracks the last rename,
        // which could be a pre-branch right-path rename. Squash_mask covers
        // all wrong-path entries (ROB indices after the branch).
        i_flush       : trap_taken || mret_taken || sret_taken,
        i_undo        : 1'b0,
        i_squash_valid: pipeline_squash,
        i_squash_mask : rob_squash_mask,
        o_undo_valid   : rat_undo_valid,
        o_undo_rd      : rat_undo_rd,
        o_undo_rob_idx : rat_undo_rob_idx,
        o_undo_rob_epoch: rat_undo_rob_epoch,
    );

    // Self-reference resolution for ID-stage integer RAT lookup.
    //
    // Problem: direct-path instructions that write the same reg they read
    // (e.g. JALR with rs1 == rd, or CSR read-modify-write) rename the RAT at
    // end of cycle N. When the instruction stalls at ID for N+1 (icache
    // miss on speculative fetch, MMU PTW, etc.), the next-cycle RAT read for
    // its own rs returns its OWN rob_idx. Forwarding then sees rob match at
    // EX_MEM (which holds the SAME instruction's in-flight result) and
    // forwards self-garbage as rs data — concretely, JALR rs=rd at ID+1
    // forwards its own ex_link_addr (PC+4) as rs1, so jalr_target becomes
    // PC+4 instead of target_3.
    //
    // Fix: detect self-reference (rat rob == id rob AND undo_rd == rs_addr)
    // and substitute the undo buffer's saved mapping (the prior writer). The
    // undo buffer was designed for exactly this case.
    let _rs1_is_self: logic = _raw_rat_id_rs1_valid && _raw_rat_id_rs1_rob_idx == id_rob_idx
                           && rat_undo_valid && rat_undo_rd == id_rs1_addr;
    let _rs2_is_self: logic = _raw_rat_id_rs2_valid && _raw_rat_id_rs2_rob_idx == id_rob_idx
                           && rat_undo_valid && rat_undo_rd == id_rs2_addr;
    always_comb {
        rat_id_rs1_valid     = if _rs1_is_self ? rat_undo_valid     : _raw_rat_id_rs1_valid;
        rat_id_rs1_rob_idx   = if _rs1_is_self ? rat_undo_rob_idx   : _raw_rat_id_rs1_rob_idx;
        rat_id_rs1_rob_epoch = if _rs1_is_self ? rat_undo_rob_epoch : _raw_rat_id_rs1_rob_epoch;
        rat_id_rs2_valid     = if _rs2_is_self ? rat_undo_valid     : _raw_rat_id_rs2_valid;
        rat_id_rs2_rob_idx   = if _rs2_is_self ? rat_undo_rob_idx   : _raw_rat_id_rs2_rob_idx;
        rat_id_rs2_rob_epoch = if _rs2_is_self ? rat_undo_rob_epoch : _raw_rat_id_rs2_rob_epoch;
    }

    // ============================================================
    // FP RAT (E2-c1 shadow mode).
    // Tracks FP register → ROB index renames for all in-flight FP
    // writers. No consumers yet — subsequent E2-c steps wire the FP
    // RS and execute-stage FP operand resolution against this RAT.
    //
    // Rename fires for any direct-path FP-writing instruction entering
    // EX. When the FP RS is added in E2-c2, its dispatch path will
    // also fire rename. Commit fires when ROB commits an FP write.
    // ============================================================
    inst u_fp_rat: rat #(
        HAS_ZERO_REG: 0,
    ) (
        clk                                                          ,
        rst                                                          ,
        i_rename_valid: (fp_rs_dispatch_valid && fp_rs_dispatch_ready && id_fp_reg_wen)
                      || (direct_path_v && !stall_ex && id_fp_reg_wen),
        i_rename_rd   : id_rd_addr                                   ,
        i_rename_idx  : id_rob_idx                                   ,
        i_rename_epoch: id_epoch                                     ,
        i_commit_valid: rob_commit_valid && rob_commit_fp_wen        ,
        i_commit_rd   : rob_commit_rd                                ,
        i_commit_idx  : rob_commit_idx                               ,
        i_commit_epoch: rob_commit_epoch                             ,
        i_rs1_addr      : 5'd0                                       ,
        o_rs1_valid     : _                                          ,
        o_rs1_rob_idx   : _                                          ,
        o_rs1_rob_epoch : _                                          ,
        i_rs2_addr      : 5'd0                                       ,
        o_rs2_valid     : _                                          ,
        o_rs2_rob_idx   : _                                          ,
        o_rs2_rob_epoch : _                                          ,
        i_rs3_addr      : 5'd0                                       ,
        o_rs3_valid     : _                                          ,
        i_rs4_addr      : 5'd0                                       ,
        o_rs4_valid     : _                                          ,
        i_id_rs1_addr      : id_rs1_addr                             ,
        o_id_rs1_valid     : fp_rat_id_rs1_valid                     ,
        o_id_rs1_rob_idx   : fp_rat_id_rs1_rob_idx                   ,
        o_id_rs1_rob_epoch : fp_rat_id_rs1_rob_epoch                 ,
        i_id_rs2_addr      : id_rs2_addr                             ,
        o_id_rs2_valid     : fp_rat_id_rs2_valid                     ,
        o_id_rs2_rob_idx   : fp_rat_id_rs2_rob_idx                   ,
        o_id_rs2_rob_epoch : fp_rat_id_rs2_rob_epoch                 ,
        i_id_rs3_addr      : id_rs3_addr                             ,
        o_id_rs3_valid     : fp_rat_id_rs3_valid                     ,
        o_id_rs3_rob_idx   : fp_rat_id_rs3_rob_idx                   ,
        o_id_rs3_rob_epoch : fp_rat_id_rs3_rob_epoch                 ,
        i_flush       : trap_taken || mret_taken || sret_taken       ,
        i_undo        : 1'b0                                         ,
        i_squash_valid: pipeline_squash                             ,
        i_squash_mask : rob_squash_mask                              ,
        o_undo_valid   : _                                            ,
        o_undo_rd      : _                                            ,
        o_undo_rob_idx : _                                            ,
        o_undo_rob_epoch: _                                           ,
    );

    // FP RS dispatched_q: prevents re-dispatch while IFID holds.
    always_ff (clk, rst) {
        if_reset {
            fp_rs_dispatched_q = 1'b0;
        } else if flush_id {
            fp_rs_dispatched_q = 1'b0;
        } else if !stall_id {
            fp_rs_dispatched_q = 1'b0;
        } else if fp_rs_dispatch_valid && fp_rs_dispatch_ready {
            fp_rs_dispatched_q = 1'b1;
        }
    }

    // FP RS operand resolution (mirrors integer RS pattern):
    //  - If RAT says "not renamed" → value is in fp_regfile (id_fp_rs*_data).
    //  - If RAT says "renamed" but ROB entry is squashed/reallocated (epoch
    //    mismatch or !valid) → stale; fall back to fp_regfile.
    //  - Else if ROB says "completed" → use ROB data, entry is ready now.
    //  - Else → wait for CDB wakeup; s*_data is don't-care until then.
    let fp_rs_stale_s1: logic = fp_rat_id_rs1_valid
        && (!fp_rob_read1_valid || fp_rob_read1_epoch != fp_rat_id_rs1_rob_epoch);
    let fp_rs_s1_ready: logic = !fp_rat_id_rs1_valid || fp_rs_stale_s1 || fp_rob_read1_completed;
    let fp_rs_s1_data : logic<64> = if fp_rs_stale_s1 ? id_fp_rs1_data
                                  : if !fp_rat_id_rs1_valid ? id_fp_rs1_data
                                  : fp_rob_read1_data;
    let fp_rs_stale_s2: logic = fp_rat_id_rs2_valid
        && (!fp_rob_read2_valid || fp_rob_read2_epoch != fp_rat_id_rs2_rob_epoch);
    // For 1-operand FP ops (FSQRT), rs2 is architecturally unused — force ready.
    let fp_rs_s2_ready: logic = id_fpu_1op_fp
                              || !fp_rat_id_rs2_valid || fp_rs_stale_s2 || fp_rob_read2_completed;
    let fp_rs_s2_data : logic<64> = if fp_rs_stale_s2 ? id_fp_rs2_data
                                  : if !fp_rat_id_rs2_valid ? id_fp_rs2_data
                                  : fp_rob_read2_data;
    // rs3 resolution (for FMADD family). Non-FMADD ops: force ready with
    // don't-care data so the RS treats the slot as idle.
    let fp_rs_stale_s3: logic = fp_rat_id_rs3_valid
        && (!fp_rob_read3_valid || fp_rob_read3_epoch != fp_rat_id_rs3_rob_epoch);
    let fp_rs_s3_ready: logic = !id_fpu_3op_fp
                              || !fp_rat_id_rs3_valid || fp_rs_stale_s3 || fp_rob_read3_completed;
    let fp_rs_s3_data : logic<64> = if !id_fpu_3op_fp ? 64'd0
                                  : if fp_rs_stale_s3 ? id_fp_rs3_data
                                  : if !fp_rat_id_rs3_valid ? id_fp_rs3_data
                                  : fp_rob_read3_data;

    inst u_fp_rs: fp_reservation_station (
        clk                                                          ,
        rst                                                          ,
        i_dispatch_valid       : fp_rs_dispatch_valid                ,
        i_dispatch_pc          : id_pc                               ,
        i_dispatch_fpu_op      : id_fpu_op                           ,
        i_dispatch_rm          : id_fp_rm                            ,
        i_dispatch_rd          : id_rd_addr                          ,
        i_dispatch_rs1         : id_rs1_addr                         ,
        i_dispatch_rs2         : id_rs2_addr                         ,
        i_dispatch_rs3         : id_rs3_addr                         ,
        i_dispatch_fp_wen      : id_fp_reg_wen                        ,
        i_dispatch_reg_wen     : id_reg_wen                           ,
        i_dispatch_fflags_valid: 1'b1                                ,
        i_dispatch_rob         : id_rob_idx                          ,
        i_dispatch_epoch       : id_epoch                            ,
        i_dispatch_s1_ready    : fp_rs_s1_ready                      ,
        i_dispatch_s1_tag      : fp_rat_id_rs1_rob_idx               ,
        i_dispatch_s1_epoch    : fp_rat_id_rs1_rob_epoch             ,
        i_dispatch_s1_data     : fp_rs_s1_data                       ,
        i_dispatch_s2_ready    : fp_rs_s2_ready                      ,
        i_dispatch_s2_tag      : fp_rat_id_rs2_rob_idx               ,
        i_dispatch_s2_epoch    : fp_rat_id_rs2_rob_epoch             ,
        i_dispatch_s2_data     : fp_rs_s2_data                       ,
        i_dispatch_s3_ready    : fp_rs_s3_ready                      ,
        i_dispatch_s3_tag      : fp_rat_id_rs3_rob_idx               ,
        i_dispatch_s3_epoch    : fp_rat_id_rs3_rob_epoch             ,
        i_dispatch_s3_data     : fp_rs_s3_data                       ,
        o_dispatch_ready       : fp_rs_dispatch_ready                ,
        o_issue_valid          : fp_rs_issue_valid                   ,
        o_issue_pc             : fp_rs_issue_pc                      ,
        o_issue_fpu_op         : fp_rs_issue_fpu_op                  ,
        o_issue_rm             : fp_rs_issue_rm                      ,
        o_issue_rd             : fp_rs_issue_rd                      ,
        o_issue_rs1            : fp_rs_issue_rs1                     ,
        o_issue_rs2            : fp_rs_issue_rs2                     ,
        o_issue_rs3            : fp_rs_issue_rs3                     ,
        o_issue_s1_data        : fp_rs_issue_s1_data                 ,
        o_issue_s2_data        : fp_rs_issue_s2_data                 ,
        o_issue_s3_data        : fp_rs_issue_s3_data                 ,
        o_issue_fp_wen         : fp_rs_issue_fp_wen                  ,
        o_issue_reg_wen        : fp_rs_issue_reg_wen                 ,
        o_issue_fflags_valid   : fp_rs_issue_fflags_valid            ,
        o_issue_rob            : fp_rs_issue_rob                     ,
        o_issue_epoch          : fp_rs_issue_epoch                   ,
        // FP RS must yield to direct-path and int RS for EX slot0.
        i_issue_stall          : stall_ex || direct_path_v || rs_issue_valid,
        i_fp_cdb0_valid        : fp_cdb0_valid                       ,
        i_fp_cdb0_rob          : fp_cdb0_rob                         ,
        i_fp_cdb0_epoch        : fp_cdb0_epoch                       ,
        i_fp_cdb0_data         : fp_cdb0_data                        ,
        i_fp_cdb1_valid        : fp_cdb1_valid                       ,
        i_fp_cdb1_rob          : fp_cdb1_rob                         ,
        i_fp_cdb1_epoch        : fp_cdb1_epoch                       ,
        i_fp_cdb1_data         : fp_cdb1_data                        ,
        i_flush                : trap_taken || mret_taken || sret_taken,
        i_squash_valid         : pipeline_squash                    ,
        i_squash_mask          : rob_squash_mask                     ,
        o_sel_valid            : fp_rs_sel_valid                     ,
    );

    // FP CDB port 0: EX-stage FP arithmetic result (early wakeup).
    // Excludes FP loads (ex_mem_ren) — load results arrive later via fp_cdb1,
    // with ex_alu_out holding the load address at this point rather than data.
    let _fp_cdb0_valid_w: logic     = ex_valid && ex_fp_reg_wen && !ex_mem_ren && !stall_ex;
    let _fp_cdb0_rob_w  : logic<5>  = ex_rob_idx;
    let _fp_cdb0_epoch_w: logic<2>  = ex_epoch;
    let _fp_cdb0_data_w : logic<64> = ex_alu_out;
    // FP CDB port 1: FP load completion (MSHR-absorbed or normal WB).
    // fp_normal_wb_complete fires when an FP load reaches MEM without being
    // absorbed into the MSHR. mshr_fp_wb covers late-arriving MSHR returns.
    let _fp_normal_wb_complete: logic = mem_valid && mem_fp_reg_wen && !mem_mshr_absorbed;
    let _fp_cdb1_valid_w: logic     = _fp_normal_wb_complete || mshr_fp_wb;
    let _fp_cdb1_rob_w  : logic<5>  = if mshr_fp_wb ? mshr_rob_idx : mem_rob_idx;
    let _fp_cdb1_epoch_w: logic<2>  = if mshr_fp_wb ? mshr_epoch   : mem_epoch;
    let _fp_cdb1_data_w : logic<64> = if mshr_fp_wb ? mshr_wb_data : wb_data;

    always_comb {
        fp_cdb0_valid = _fp_cdb0_valid_w;
        fp_cdb0_rob   = _fp_cdb0_rob_w;
        fp_cdb0_epoch = _fp_cdb0_epoch_w;
        fp_cdb0_data  = _fp_cdb0_data_w;
        fp_cdb1_valid = _fp_cdb1_valid_w;
        fp_cdb1_rob   = _fp_cdb1_rob_w;
        fp_cdb1_epoch = _fp_cdb1_epoch_w;
        fp_cdb1_data  = _fp_cdb1_data_w;
    }

    // ============================================================
    // Store Buffer (E1-b2 shadow mode)
    // Plain stores from the MEM stage are enqueued into the SB in parallel
    // with the existing direct-dcache write. The drain output is consumed
    // internally (i_drain_ready=1) so the SB doesn't fill up. No store path
    // actually flows through the SB yet — this is observation-only to
    // verify commit/squash/flush timing before E1-b3 flips the direction.
    //
    // AMO/LR/SC and cross-DW splits stay on the direct path.
    // A store enqueues exactly once per instruction: the !stall_mem gate
    // prevents multi-enqueue while the EX/MEM register holds during
    // dcache/MMU stalls.
    // ============================================================
    var _sb_zero_mask: logic [32]; // unused
    // Enqueue on cycles where the dcache is actually committing the write:
    // mmu_wen_out asserted and dcache not stalling. That way a store held
    // in MEM across a multi-cycle dcache miss enqueues exactly on the
    // release cycle (when dcache latches), matching back-to-back stores
    // too (edge-detect would have dropped the second).
    // Use !stall_mem (not just !dcache_stall_raw) so a store held at MEM by
    // mshr_wb_conflict / mmu_stall / div_busy doesn't enqueue every cycle.
    // Without this, mmu_wen_out stays 1 across the stall, the SB enqueues
    // duplicate copies of the same store, and the FIFO fills with stale
    // entries that block real stores from enqueueing.
    let sb_shadow_enq: logic = mmu_wen_out && !stall_mem
                            && !ex_is_amo && !mem_crosses_dw && !is_mmio;
    let sb_size_in: logic<2> = ex_mem_funct3[1:0];

    // Per-phase byte mask for SB forwarding probe.
    // Compute the load's byte mask in 16-bit space (size_mask shifted left
    // by the original byte_off), then take the lower 8 bits in phase 1
    // (current DW = addr_lo) and the upper 8 bits in phase 2
    // (next DW = addr_hi). For non-cross-DW loads only phase 1 fires and
    // the upper 8 bits are zero by construction.
    let sb_size_base_mask: logic<8> =
        if sb_size_in == 2'd0 ? 8'b0000_0001
        : if sb_size_in == 2'd1 ? 8'b0000_0011
        : if sb_size_in == 2'd2 ? 8'b0000_1111
        : 8'b1111_1111;
    let sb_orig_byte_off: logic<3>  = ex_alu_out[2:0];
    let sb_full_mask16  : logic<16> = {8'd0, sb_size_base_mask} <<< sb_orig_byte_off;
    let sb_byte_mask    : logic<8>  = if mem_split_phase2 ? sb_full_mask16[15:8]
                                                          : sb_full_mask16[7:0];

    // Load forwarding probe (PA-indexed, gated on non-MMIO loads).
    // mmu_rdata_valid ensures we only probe when the MMU has completed
    // translation (ptw_valid in VM mode). Cross-DW loads probe SB too —
    // sb_byte_mask selects the lower or upper half of the 16-bit shifted
    // mask depending on which phase the memory module is driving.
    let sb_fwd_probe: logic = mmu_ren_out && mmu_rdata_valid && !is_mmio;

    inst u_store_buffer: store_buffer (
        clk                                                   ,
        rst                                                   ,
        i_enq_valid   : sb_shadow_enq                         ,
        i_enq_rob     : ex_rob_idx                            ,
        i_enq_epoch   : ex_epoch                              ,
        i_enq_addr    : mmu_paddr                             ,
        i_enq_data    : mmu_wdata_out                         ,
        i_enq_wstrb   : mmu_wstrb_out                         ,
        i_enq_size    : sb_size_in                            ,
        i_enq_is_sc   : 1'b0                                  ,
        i_enq_is_amo  : 1'b0                                  ,
        o_enq_ready   : sb_enq_ready                          ,
        i_commit_valid: rob_commit_valid                      ,
        i_commit_rob  : rob_commit_idx                        ,
        i_commit_epoch: rob_commit_epoch                      ,
        o_drain_valid : sb_drain_valid                        ,
        o_drain_addr  : sb_drain_addr                         ,
        o_drain_data  : sb_drain_data                         ,
        o_drain_wstrb : sb_drain_wstrb                        ,
        o_drain_size  : sb_drain_size                         ,
        o_drain_is_sc : sb_drain_is_sc                        ,
        o_drain_is_amo: sb_drain_is_amo                       ,
        o_drain_rob   : sb_drain_rob                          ,
        i_drain_ready : 1'b1                                  ,
        i_fwd_valid    : sb_fwd_probe                          ,
        i_fwd_addr     : mmu_paddr                             ,
        i_fwd_byte_mask: sb_byte_mask                          ,
        i_fwd_rob      : ex_rob_idx                            ,
        i_fwd_epoch    : ex_epoch                              ,
        o_fwd_hit      : sb_fwd_hit                            ,
        o_fwd_data     : sb_fwd_data                           ,
        o_fwd_partial  : sb_fwd_partial                        ,
        i_squash_valid: pipeline_squash                      ,
        i_squash_mask : rob_squash_mask                       ,
        i_flush       : trap_taken || mret_taken || sret_taken,
        // AMO / cross-DW writes bypass the SB enqueue path and write
        // the dcache directly, so any SB entry aliasing the same 8B
        // base becomes stale. Invalidate matching entries to keep the
        // SB consistent with dcache for forwarding.
        i_inval_valid : mmu_wen_out && !stall_mem && (ex_is_amo || mem_crosses_dw) && !is_mmio,
        i_inval_addr  : mmu_paddr                                                              ,
        i_match_addr  : mmu_paddr                             ,
        i_match_rob   : ex_rob_idx                            ,
        i_match_epoch : ex_epoch                              ,
        o_match_older : sb_match_older                        ,
        o_count       : sb_count                              ,
        o_full        : sb_full                               ,
        o_empty       : sb_empty                              ,
    );

    // ============================================================
    // Load Queue (LQ-1 shadow mode)
    // Allocate an LQ entry every cycle a plain load completes its
    // dcache access (mmu_ren_out && !dcache_stall_raw && rdata_valid).
    // Record the physical address and the load data at alloc time, so
    // data_ready is asserted immediately and head_retire can fire on
    // the next cycle. This is observation-only — the actual load result
    // is still forwarded through the existing MEM→WB path and retire's
    // CDB broadcast is unused in this phase.
    // ============================================================
    // `!stall_ex` ensures the gate fires exactly once per load — EX must
    // actually advance to MEM this cycle. Without it, a load whose EX stage
    // holds for multiple cycles (icache/mshr_wb/div-busy stall while dcache
    // is already returning data) would re-allocate LQ entries every cycle.
    // LQ alloc gate (LQ-4.4-c2): fire on hit-case AND mshr_absorb.
    // Miss-case LQ entries have data_ready=0 until MSHR fill → LQ MSHR
    // fill port (c3). Hit-case entries alloc+complete same cycle as
    // before via the primary complete path.
    // `lq_alloc_ready` gate: if LQ is full, drop back to the original
    // non-LQ path (port 1 normal WB or mshr_int_wb). Without this guard,
    // the load would silently lose its data — LQ drops the alloc but
    // `mem_was_lq=1` still suppresses port 1, orphaning the completion.
    // Not observed in practice (LQ fills to 8 would require 8 hits
    // stacked behind a single pending miss) but structurally required.
    // P3.2 Stage 2b: a re-injected load already has an LQ entry, so suppress
    // the EX/MEM-stage alloc gate. Use ex_from_lq_q (the EX-stage FF that's
    // 1 during the load's MEM cycle) — `mem_from_lq` is one cycle late and
    // sits at WB-stage timing.
    // P3.2 bug (a) fix: when ID-stage alloc fires this cycle, it consumes the
    // single LQ alloc port at tail_idx. The MEM-stage shadow alloc loses its
    // entry — mem_was_lq=1 but the LQ slot holds ID's data. Result: shadow
    // load's completion never fires (port 1 suppressed by mem_was_lq, port 3
    // never fires because no LQ entry tracks it). Suppress shadow alloc when
    // ID-alloc fires; the shadow load completes via normal_wb_complete or
    // mshr_int_wb instead (mem_was_lq=0 lets port 1 fire normally).
    let lq_load_common_gate: logic = mmu_ren_out && !ex_is_amo && !mem_crosses_dw && !is_mmio && !stall_ex && lq_alloc_ready && !ex_from_lq_q && !lq_id_alloc_fire;
    let lq_hit_case        : logic = lq_load_common_gate && mmu_rdata_valid && !dcache_stall_raw;
    assign lq_alloc_gate = lq_hit_case || (lq_load_common_gate && mshr_absorb);
    // LQ complete gate (hit-case only): data arrives same cycle as alloc.
    let lq_complete_gate: logic = lq_hit_case;
    // Re-injected load: dcache hit returns data this cycle. Fire complete
    // for the existing LQ idx so the entry transitions to data_ready.
    // Note: cross_dw is intentionally NOT excluded — the memory module
    // already serializes the split internally and only signals
    // mmu_rdata_valid when the full 8B is assembled.
    // Drop !is_mmio: a MMIO load that arrived via ID-stage LQ alloc has
    // already reached MEM and produced mmu_rdata; refusing to complete
    // the LQ entry leaves it stuck forever (data_ready=0). MMIO reads
    // are idempotent on register state once the data has been latched,
    // so completing the LQ entry once mmu_rdata is valid is correct.
    let lq_reinject_complete_gate: logic = ex_from_lq_q && mmu_ren_out && mmu_rdata_valid
                                        && !dcache_stall_raw && !ex_is_amo
                                        && !stall_ex;

    // LQ-4.3: dcache-hit response → LQ complete path. Infrastructure
    // only — `lq_dc_hit_ok` is tied to 0 today (dcache_sel_lq is 0 in
    // LQ-4.2, so LQ never issues). The mux below therefore always
    // selects the existing EX/MEM shadow path. LQ-4.4 enables issue
    // and flips the selector.
    let lq_dc_byte_off: logic<3>  = lq_issue_addr[2:0];
    let lq_dc_shifted : logic<64> = dcache_rdata >> {lq_dc_byte_off, 3'b000};
    let lq_dc_unsigned: logic     = lq_issue_funct3[2];
    var lq_dc_extended: logic<64>;
    always_comb {
        lq_dc_extended = lq_dc_shifted;
        case lq_issue_funct3[1:0] {
            2'd0: lq_dc_extended = if lq_dc_unsigned ?
                  {56'd0, lq_dc_shifted[7:0]}
                : {lq_dc_shifted[7] repeat 56, lq_dc_shifted[7:0]};
            2'd1: lq_dc_extended = if lq_dc_unsigned ?
                  {48'd0, lq_dc_shifted[15:0]}
                : {lq_dc_shifted[15] repeat 48, lq_dc_shifted[15:0]};
            2'd2: lq_dc_extended = if lq_issue_is_fp ?
                  {32'hFFFFFFFF, lq_dc_shifted[31:0]} // FLW NaN-box
                  : if lq_dc_unsigned ?
                      {32'd0, lq_dc_shifted[31:0]}
                    : {lq_dc_shifted[31] repeat 32, lq_dc_shifted[31:0]};
            2'd3   : lq_dc_extended = lq_dc_shifted;
            default: lq_dc_extended = lq_dc_shifted;
        }
    }
    let lq_dc_hit_ok  : logic     = 1'b0; // LQ-4.4 will enable
    // Complete-source priority: re-injected load (existing entry, idx from
    // pipeline reg) > LQ→dcache issue (LQ-4.4 path, idx from issue mux) >
    // EX/MEM hit-case (idx = freshly alloc'd tail).
    let lq_cp_valid_mux: logic     = lq_complete_gate || lq_dc_hit_ok || lq_reinject_complete_gate;
    let lq_cp_idx_mux  : logic<3>  = if lq_reinject_complete_gate ? lq_reinject_idx_q
                                    : if lq_dc_hit_ok ? lq_issue_idx
                                    : lq_alloc_idx;
    let lq_cp_data_mux : logic<64> = if lq_dc_hit_ok ? lq_dc_extended : mem_load_data;

    inst u_load_queue: load_queue (
        clk                                                      ,
        rst                                                      ,
        i_alloc_valid   : lq_alloc_gate || (lq_id_alloc_fire && !flush_id),
        i_alloc_rob     : if lq_id_alloc_fire ? id_rob_idx : ex_rob_idx,
        i_alloc_epoch   : if lq_id_alloc_fire ? id_epoch   : ex_epoch  ,
        i_alloc_rd      : if lq_id_alloc_fire ? id_rd_addr : ex_rd_addr,
        i_alloc_funct3  : if lq_id_alloc_fire ? id_mem_funct3 : ex_mem_funct3,
        i_alloc_is_fp   : if lq_id_alloc_fire ? id_is_fp   : ex_is_fp ,
        i_alloc_pc      : if lq_id_alloc_fire ? id_pc      : ex_pc    ,
        // EX/MEM-stage alloc has addr pre-resolved (via mmu_paddr); ID-stage
        // pending alloc captures s1_tag/epoch and waits for CDB wake.
        i_alloc_s1_ready: if lq_id_alloc_fire ? lq_id_s1_ready : 1'b1 ,
        i_alloc_s1_tag  : if lq_id_alloc_fire ? lq_id_s1_tag   : 5'd0 ,
        i_alloc_s1_epoch: if lq_id_alloc_fire ? lq_id_s1_epoch : 2'd0 ,
        i_alloc_s1_data : if lq_id_alloc_fire ? lq_id_s1_data  : mmu_paddr,
        i_alloc_imm     : if lq_id_alloc_fire ? id_imm         : 64'd0,
        i_alloc_pending : lq_id_alloc_fire                            ,
        o_alloc_ready   : lq_alloc_ready                         ,
        o_alloc_idx     : lq_alloc_idx                           ,
        i_addr_valid    : lq_alloc_gate                          ,
        i_addr_idx      : lq_alloc_idx                           ,
        i_addr_addr     : mmu_paddr                              ,
        i_cdb0_valid    : cdb0_valid                             ,
        i_cdb0_rob      : cdb0_rob                               ,
        i_cdb0_epoch    : cdb0_epoch                             ,
        i_cdb0_data     : cdb0_data                              ,
        i_cdb1_valid    : cdb1_valid                             ,
        i_cdb1_rob      : cdb1_rob                               ,
        i_cdb1_epoch    : cdb1_epoch                             ,
        i_cdb1_data     : cdb1_data                              ,
        i_cdb2_valid    : cdb2_valid                             ,
        i_cdb2_rob      : cdb2_rob                               ,
        i_cdb2_epoch    : cdb2_epoch                             ,
        i_cdb2_data     : cdb2_data                              ,
        o_issue_valid   : lq_issue_valid                         ,
        o_issue_addr    : lq_issue_addr                          ,
        o_issue_funct3  : lq_issue_funct3                        ,
        o_issue_is_fp   : lq_issue_is_fp                         ,
        o_issue_rob     : lq_issue_rob                           ,
        o_issue_idx     : lq_issue_idx                           ,
        i_issue_ready   : 1'b1                                   , // always accept issue (LQ module does not gate on this; issue consumer decides)
        i_complete_valid: lq_cp_valid_mux                        ,
        i_complete_idx  : lq_cp_idx_mux                          ,
        i_complete_data : lq_cp_data_mux                         ,
        i_mshr_fill_valid: mshr_wb_valid && mshr_was_lq          ,
        i_mshr_fill_idx  : mshr_lq_idx                           ,
        i_mshr_fill_data : mshr_wb_data                          ,
        o_retire_valid  : lq_retire_valid                        ,
        o_retire_rob    : lq_retire_rob                          ,
        o_retire_epoch  : lq_retire_epoch                        ,
        o_retire_rd     : lq_retire_rd                           ,
        o_retire_data   : lq_retire_data                         ,
        o_retire_is_fp  : lq_retire_is_fp                        ,
        o_retire_pc     : lq_retire_pc                           ,
        i_squash_valid  : pipeline_squash                       ,
        i_squash_mask   : rob_squash_mask                        ,
        i_flush         : trap_taken || mret_taken || sret_taken ,
        // P3.4 step (c): SRS wake triggers LQ alias probe. The hit output
        // is filtered by age (load must be younger than the store) to
        // produce p34_spec_violation below. Still detection-only — no
        // squash is issued yet.
        i_probe_valid   : srs_wake_valid                         ,
        i_probe_addr    : srs_wake_addr                          ,
        o_probe_hit     : lq_probe_hit                           ,
        o_probe_hit_rob : lq_probe_hit_rob                       ,
        o_probe_hit_epoch: lq_probe_hit_epoch                    ,
        o_probe_hit_pc  : lq_probe_hit_pc                        ,
        // Phase 4 / bug-b: probe LQ against the SRS HEAD CANDIDATE (comb,
        // pre-FF). The probe result feeds back into SRS i_issue_stall, so
        // an aliasing store never enters o_issue_valid. Using the post-FF
        // (srs_issue_valid) inputs would be too late — the store is already
        // visible to EX by the time the alias is detected.
        i_alias_valid    : srs_cand_valid                        ,
        i_alias_addr     : srs_cand_addr                         ,
        i_alias_rob      : srs_cand_rob                          ,
        i_alias_epoch    : srs_cand_epoch                        ,
        i_alias_s1_ready : srs_cand_s1_ready                     ,
        i_alias_s1_tag   : srs_cand_s1_tag                       ,
        i_alias_s1_epoch : srs_cand_s1_epoch                     ,
        i_alias_funct3   : srs_cand_funct3                       ,
        o_alias_hit      : lq_alias_srs_hit                      ,
        // P3.2 Stage 2: re-inject path for ID-stage pending-rs1 loads.
        o_reinject_valid : lq_reinject_valid                     ,
        o_reinject_pc    : lq_reinject_pc                        ,
        o_reinject_rob   : lq_reinject_rob                       ,
        o_reinject_epoch : lq_reinject_epoch                     ,
        o_reinject_rd    : lq_reinject_rd                        ,
        o_reinject_funct3: lq_reinject_funct3                    ,
        o_reinject_is_fp : lq_reinject_is_fp                     ,
        o_reinject_s1    : lq_reinject_s1                        ,
        o_reinject_imm   : lq_reinject_imm                       ,
        o_reinject_idx   : lq_reinject_idx                       ,
        i_reinject_fire  : lq_reinject_fire                      ,
        o_count         : lq_count                               ,
        o_full          : lq_full                                ,
        o_empty         : lq_empty                               ,
    );

    // ============================================================
    // CSR unit (operates in EX stage timing)
    // ============================================================
    // CSR write data: rs1 value (with forwarding) or zero-extended immediate
    // RS-issued producers (slot1 or slot0-RS) aren't visible via EX_MEM/MEM_WB
    // forwarding, so check ROB read (renamed-and-completed) first.
    let csr_rs1_from_rob: logic = rat_id_rs1_valid && rob_read1_epoch == rat_id_rs1_rob_epoch && rob_read1_completed;
    let csr_rs1_fwd: logic<64> = if csr_rs1_from_rob ? rob_read1_data
                               : case fwd_a {
                                     pipeline_pkg::FwdSel::EX_MEM: ex_alu_out,
                                     pipeline_pkg::FwdSel::MEM_WB: wb_data,
                                     default                     : id_rs1_data,
                                 };
    let csr_wdata: logic<64> = if id_csr_imm ? {59'b0, id_rs1_addr} : csr_rs1_fwd;

    // Synchronous trap detection: ECALL/EBREAK/illegal instruction/CSR access fault in EX stage
    // CSR access fault is combined with decoder's illegal flag in execute's input,
    // so ex_illegal covers both decoder-detected and CSR privilege violations.
    // FP FS=Off check is now detected inside the execute module (fed
    // via i_fs) and folded into ex_illegal, so that any FP load / store
    // is suppressed in the same cycle the trap is signalled.
    let ex_trap: logic = ex_valid && (ex_is_ecall || ex_is_ebreak || ex_illegal);

    // Page fault detection from MMU (MEM stage)
    let mem_page_fault: logic = mmu_fault;

    // Instruction page fault (IF stage).
    // Suppress when IF is on a speculative path (prediction not yet verified).
    // The speculative fetch may access an unmapped address; the misprediction
    // flush will correct the PC before the next fetch.
    let if_page_fault: logic = immu_fault && !speculative_if;

    // Misaligned access exception (MEM stage)
    let mem_misalign_trap: logic = mem_misaligned;

    // ============================================================
    // Commit-time trap: deferred synchronous exception handling
    // ============================================================
    // EX/MEM detected exceptions are recorded in the ROB (exc bit) AND
    // saved in the pend_trap register.  The actual trap fires only when
    // the excepted ROB entry reaches the commit head.  This allows older
    // in-flight RS-dispatched instructions to commit first, preventing
    // the flush from destroying their results.
    //
    // IF page fault (no ROB entry) and IRQ (no ROB entry) stay immediate.

    // Detect: a ROB-tracked exception fires this cycle
    let rob_tracked_exc: logic = ex_trap || mem_page_fault || mem_misalign_trap;

    // Capture into pending register (first detection only).
    // Suppress during misprediction squash: a wrong-path instruction in EX
    // might decode as ecall/illegal, but its ROB entry will be squashed.
    // Capturing would leave pend_trap_valid stuck (no commit-time exc to clear it).
    let pend_trap_capture: logic = rob_tracked_exc && !pend_trap_valid && !pipeline_squash;

    // Commit-time firing: ROB head has exception AND we have saved info
    let rob_exc_trap: logic = rob_commit_valid && rob_commit_exc && pend_trap_valid;

    // Combined synchronous trap — only IF page fault is immediate;
    // EX/MEM exceptions fire via rob_exc_trap at commit time.
    let sync_trap: logic = if_page_fault || rob_exc_trap;

    // ROB exception recording (unchanged — marks the entry for commit-time detection)
    assign exc_rob_valid = rob_tracked_exc;
    assign exc_rob_cause = if mem_misalign_trap ?
        (if mem_misalign_st ? csr_pkg::CAUSE_MISALIGNED_STORE : csr_pkg::CAUSE_MISALIGNED_LOAD)
    : if mem_page_fault ?
        (if mmu_fault_store ? csr_pkg::CAUSE_STORE_PAGE_FAULT : csr_pkg::CAUSE_LOAD_PAGE_FAULT)
    : if ex_is_ecall ?
        (if csr_priv == csr_pkg::PrivLevel::USER ?
            csr_pkg::CAUSE_ECALL_U
        : if csr_priv == csr_pkg::PrivLevel::SUPERVISOR ?
            csr_pkg::CAUSE_ECALL_S
        :
            csr_pkg::CAUSE_ECALL_M
        )
    : if ex_is_ebreak ?
        csr_pkg::CAUSE_BREAKPOINT
    :
        csr_pkg::CAUSE_ILLEGAL_INST
    ;

    // Vectored interrupt target: BASE + 4*cause when mode=1 and interrupt
    let tvec_sel : logic<64> = if csr_trap_to_s ? csr_stvec : csr_mtvec;
    let tvec_base: logic<64> = {tvec_sel[63:2], 2'b00};
    let tvec_mode: logic     = tvec_sel[0];
    // Vectored mode: interrupts jump to BASE + 4*cause_number
    assign trap_target = if tvec_mode && irq_taken ? tvec_base + {48'd0, trap_cause[13:0], 2'b00} : tvec_base;

    // Asynchronous interrupt detection.
    // With branch prediction, suppress only on misprediction (not every taken
    // branch/jump). A correctly predicted branch/jump has the RIGHT instruction
    // in ID, so mepc is correct. Without this, predicted self-loops (j .)
    // permanently suppress interrupts — EX always has a taken JAL.
    // xret_taken_q suppresses interrupts for 1 cycle after mret/sret so that
    // the NBA privilege/MIE update completes before interrupt eligibility is
    // re-evaluated — prevents mepc corruption from a same-cycle interrupt.
    // Suppress IRQ while a synchronous exception is pending commit
    // IRQ requires ROB drain: RS-issued instructions only write regfile via ROB
    // commit. Flushing in-flight completed entries would lose their results,
    // corrupting post-trap register state.
    assign irq_taken = irq_pending && rob_empty && !sync_trap && !pend_trap_valid && !ex_misprediction && !mret_taken && !sret_taken && !xret_taken_q;

    // Combined trap: sync exception or async interrupt
    assign trap_taken = sync_trap || irq_taken;

    // Trap cause: for commit-time exceptions, use the saved register
    assign trap_cause = if rob_exc_trap ?
        pend_trap_cause
    : if if_page_fault ?
        csr_pkg::CAUSE_INST_PAGE_FAULT
    :
        irq_cause
    ;
    // mepc: for sync exceptions = PC of faulting instruction,
    //        for interrupts = PC of instruction in ID/EX (flushed by interrupt)
    // Page faults use the MEM stage PC (instruction that caused the fault)
    // Page faults and misaligned exceptions: the faulting instruction is
    // Trap PC selection (becomes mepc/sepc):
    // - Page fault/misalign in MEM: ex_pc (faulting instruction)
    // - Trap in EX (ecall, illegal instr): ex_pc
    // - Page fault in IF: if_pc (faulting fetch address)
    // - Interrupt: oldest un-committed instruction's PC
    //   The pipeline flushes MEM/EX/ID/IF on interrupt. WB commits on this edge.
    //   The oldest flushed instruction is in MEM (PC = ex_pc), then EX (id_pc).
    //   Previously used id_pc which skipped the MEM instruction, causing loads
    //   in MEM to be lost (register never written). Fixed to use ex_pc when
    //   MEM has a valid instruction.
    // Trap PC: PC of the oldest un-committed instruction (becomes mepc/sepc).
    // For interrupts, the MEM stage store may be flushed by flush_q without
    // the store being committed to the register file. However, the store
    // WAS written to DRAM (write-through). Non-store MEM instructions
    // (loads, ALU) have their register write suppressed by flush and must
    // be re-executed. The issue is that ex_pc already points to the NEXT
    // instruction (after the one in MEM), so using ex_pc would skip the
    // MEM instruction. Use mem_pc for the MEM store to prevent skip.
    // Note: mem_valid && mem_wen (store in MEM that wrote to DRAM) needs
    // special handling — the store completed but the pipeline thinks it
    // didn't. Using mem_pc causes re-execution of the store (idempotent
    // for memory but may double-execute CSR side effects).
    // TODO: This is a fundamental pipeline flush issue that needs
    // proper resolution. For now, use the original chain without mem_valid.
    // Trap PC: commit-time exceptions use saved register, others as before
    // For async IRQ with rob_empty: all in-flight instructions committed.
    // Use ifid_pc (next-to-execute) rather than stale ex_pc register to avoid
    // re-executing the just-committed instruction (which would corrupt state
    // when a post-load register value gets used as if it were pre-load).
    assign trap_pc = if rob_exc_trap ?
        pend_trap_pc
    : if if_page_fault ?
        if_pc
    : if irq_taken && rob_empty && ifid_valid ?
        ifid_pc
    : if ex_valid ?
        ex_pc
    : if id_valid ?
        id_pc
    : if ifid_valid ?
        ifid_pc
    :
        if_pc
    ;

    // trap_val: commit-time exceptions use saved register, others as before
    assign trap_val = if rob_exc_trap ?
        pend_trap_val
    : if if_page_fault ?
        if_pc
    :
        64'd0
    ;

    // MRET/SRET detection: in ID stage
    // Raw detection (for privilege fault check)
    assign mret_raw = id_valid && id_is_mret;
    assign sret_raw = id_valid && id_is_mret && id_csr_addr == 12'h102;
    // Gated by privilege check (for actual MRET/SRET action).
    // Suppress while id_direct_stall (rob_drain_needed) blocks the
    // instruction — otherwise mret/sret fire combinationally at ID
    // while older RS-dispatched instructions are still in flight, and
    // the resulting pipeline flush destroys their ROB entries.
    assign mret_taken = mret_raw && csr_priv == csr_pkg::PrivLevel::MACHINE && !id_direct_stall;
    assign sret_taken = sret_raw && csr_priv != csr_pkg::PrivLevel::USER && !(csr_tsr && csr_priv == csr_pkg::PrivLevel::SUPERVISOR) && !id_direct_stall;

    // Pending trap register: capture on first MEM/EX fault, clear on trap fire.
    // Also clear on pipeline_squash if the captured entry is in the squash range
    // — under JALR/branch RS routing, a wrong-path tracked exc could be captured
    // (rob_tracked_exc fires on EX-stage signals like ex_trap), but its ROB
    // entry then gets invalidated by the squash and never commits. Without this
    // clear, pend_trap_valid stays high forever, blocking IF/ID via the
    // i_rob_full route in hazard_unit and freezing the pipeline.
    let pend_trap_squashed: logic = pipeline_squash && pend_trap_valid && rob_squash_mask[pend_trap_rob];
    always_ff (clk, rst) {
        if_reset {
            pend_trap_valid = 1'b0;
            pend_trap_rob   = 5'd0;
            pend_trap_epoch = 2'd0;
        } else if trap_taken {
            pend_trap_valid = 1'b0;
        } else if pend_trap_squashed {
            pend_trap_valid = 1'b0;
        } else if pend_trap_capture {
            pend_trap_valid = 1'b1;
            pend_trap_cause = exc_rob_cause;
            pend_trap_pc    = ex_pc;
            pend_trap_rob   = ex_rob_idx;
            pend_trap_epoch = ex_epoch;
            pend_trap_val   = if mem_misalign_trap ? ex_alu_out
                            : if mem_page_fault ? mem_dmem_addr
                            : 64'd0;
        }
    }

    // Privilege checks for privileged instructions
    // MRET: only in M-mode
    assign mret_priv_fault = mret_raw && !sret_raw && csr_priv != csr_pkg::PrivLevel::MACHINE;
    // SRET: only in M or S mode (not U-mode)
    assign sret_priv_fault = sret_raw && csr_priv == csr_pkg::PrivLevel::USER;
    // SFENCE.VMA: requires at least S-mode privilege (U-mode → illegal)
    assign sfence_priv_fault = id_is_sfence && csr_priv == csr_pkg::PrivLevel::USER;
    // TVM: S-mode satp write or sfence.vma → illegal instruction
    assign tvm_trap = csr_tvm && csr_priv == csr_pkg::PrivLevel::SUPERVISOR && (id_is_sfence || (id_is_csr && id_csr_addr == csr_pkg::CSR_SATP));
    // TSR: S-mode SRET → illegal instruction
    assign tsr_trap = csr_tsr && csr_priv == csr_pkg::PrivLevel::SUPERVISOR && sret_raw;

    inst u_csr: csr (
        clk                                                            ,
        rst                                                            ,
        i_addr        : id_csr_addr                                    ,
        o_rdata       : csr_rdata                                      ,
        i_wen         : id_valid && id_is_csr && !flush_ex && !stall_id,
        i_op          : id_csr_op                                      ,
        i_wdata       : csr_wdata                                      ,
        i_trap        : trap_taken                                     ,
        i_trap_cause  : trap_cause                                     ,
        i_trap_pc     : trap_pc                                        ,
        i_trap_val    : trap_val                                       ,
        i_mret        : mret_taken && !sret_taken                      ,
        i_sret        : sret_taken                                     ,
        o_mret_pc     : csr_mret_pc                                    ,
        o_sret_pc     : csr_sret_pc                                    ,
        o_mtvec       : csr_mtvec                                      ,
        o_stvec       : csr_stvec                                      ,
        o_priv        : csr_priv                                       ,
        o_irq_pending : irq_pending                                    ,
        o_irq_cause   : irq_cause                                      ,
        o_irq_any     : irq_any                                        ,
        i_timer_irq   : timer_irq                                      ,
        i_ext_irq_m   : plic_irq_m                                     ,
        i_ext_irq_s   : plic_irq_s                                     ,
        i_sw_irq      : sw_irq                                         ,
        i_hart_id     : HART_ID as 8                                   ,
        i_instret     : mem_valid                                      ,
        i_mtime       : mtime_val                                      ,
        i_is_ecall    : ex_is_ecall                                    ,
        o_satp        : csr_satp                                       ,
        o_sum         : csr_sum                                        ,
        o_mxr         : csr_mxr                                        ,
        o_access_fault: csr_access_fault                               ,
        o_frm         : csr_frm                                        ,
        // Drive fp_dirty from the ID stage (earliest possible), not
        // from MEM/WB.  Driving from a later stage races with a csrc
        // mstatus clear: csrc's CSR write lands in cycle N, but an FP
        // producer still sitting in MEM/WB re-dirties FS at cycle N+1
        // before fsw reaches EX.  Dirtying at ID ensures that by the
        // time csrc executes, any in-flight FP writer has already
        // dirtied FS, so csrc's clear is the final word.
        i_fp_dirty     : ifid_valid && id_fp_reg_wen,
        i_fp_fflags    : ex_fp_fflags               ,
        i_fp_fflags_wen: ex_fp_fflags_wen           ,
        // Forwarding from EX (combinational) and MEM (ex_fp_fflags is
        // the MEM-stage latched value) into CSR fflags/fcsr reads.
        i_fp_fflags_fwd_ex     : fp_fflags_ex    ,
        i_fp_fflags_fwd_ex_wen : fp_fflags_ex_wen,
        i_fp_fflags_fwd_mem    : ex_fp_fflags    ,
        i_fp_fflags_fwd_mem_wen: ex_fp_fflags_wen,
        o_trap_to_s            : csr_trap_to_s   ,
        o_tvm                  : csr_tvm         ,
        o_tsr                  : csr_tsr         ,
        o_mprv                 : csr_mprv        ,
        o_mpp                  : csr_mpp         ,
        o_fs                   : csr_fs          ,
    );

    // CLINT / PLIC / UART are instantiated in heliodor_top (SoC layer).
    // Expose the core's MMU outputs so the SoC can drive each peripheral.
    assign o_mmio_paddr = mmu_paddr[31:0];
    assign o_mmio_wdata = mmu_wdata_out;
    assign o_mmio_wstrb = mmu_wstrb_out;
    assign o_mmio_wen   = mmu_wen_out;
    assign o_mmio_ren   = mmu_ren_out;
    assign o_stall_mem  = stall_mem;

    // ============================================================
    // WB stage
    // ============================================================
    inst u_writeback: writeback (
        i_pc           : mem_pc           ,
        i_alu_out      : mem_alu_out      ,
        i_mem_data     : mem_data         ,
        i_wb_sel       : mem_wb_sel       ,
        i_is_compressed: mem_is_compressed,
        o_wb_data      : wb_data          ,
    );

    // ============================================================
    // Slot1 execute path (ALU only)
    // ============================================================
    // Slot1 is driven by RS issue2 (RS-issued second ALU instruction).
    // RS pre-resolves operands, so no forwarding is needed (FwdSel::NONE).
    inst u_execute_s1: execute_s1 (
        clk                                  ,
        rst                                  ,
        i_valid     : rs_issue2_valid         ,
        i_pc        : rs_issue2_pc            ,
        i_rs1_data  : rs_issue2_s1_data       ,
        i_rs2_data  : rs_issue2_s2_data       ,
        i_imm       : rs_issue2_imm           ,
        i_rd_addr   : rs_issue2_rd            ,
        i_rs1_addr  : rs_issue2_rs1           ,
        i_rs2_addr  : rs_issue2_rs2           ,
        i_alu_op    : rs_issue2_alu_op        ,
        i_alu_src_a : rs_issue2_src_a         ,
        i_alu_src_b : rs_issue2_src_b         ,
        i_reg_wen   : rs_issue2_wen           ,
        i_rob_idx   : rs_issue2_rob           ,
        i_rob_epoch : rs_issue2_epoch         ,
        i_fwd_exmem : _fwd_exmem_data        ,
        i_fwd_s1exwb: s1_ex_alu_out          ,
        i_fwd_memwb : wb_data                ,
        i_fwd_a     : pipeline_pkg::FwdSel::NONE ,
        i_fwd_b     : pipeline_pkg::FwdSel::NONE ,
        // RS pre-resolved operands, no same-cycle slot0 forwarding needed
        i_slot0_alu_result: 64'd0             ,
        i_slot0_rd       : 5'd0               ,
        i_slot0_wen      : 1'b0               ,
        i_stall     : stall_ex               ,
        // Slot1 is RS-issued (operands pre-resolved at RS), so flush_id from
        // ID-stage load-use hazard must NOT clear slot1 — it destroys in-flight
        // RS-issued instructions that were freed from RS. Only flush on
        // trap/return (flush_ex).
        i_flush     : flush_ex               ,
        o_valid     : s1_ex_valid            ,
        o_pc        : s1_ex_pc               ,
        o_alu_out   : s1_ex_alu_out          ,
        o_rd_addr   : s1_ex_rd_addr          ,
        o_reg_wen   : s1_ex_reg_wen          ,
        o_rob_idx   : s1_ex_rob_idx          ,
        o_rob_epoch : s1_ex_rob_epoch        ,
    );

    // Track whether slot1 WB has already committed (once-only write)
    always_ff (clk, rst) {
        if_reset {
            s1_wb_done = 1'b0;
        } else if !stall_ex {
            // New slot1 entering EX1 → clear done flag
            s1_wb_done = 1'b0;
        } else if s1_wb_wen {
            // Committed this cycle → set done to prevent re-commit
            s1_wb_done = 1'b1;
        }
    }

    // Debug PC output
    assign o_dbg_pc = ex_pc; // MEM stage PC


    // Debug: instruction retirement (count both slot0 and slot1)
    assign o_dbg_instret = mem_valid || (s1_ex_valid && !s1_wb_done && !stall_ex);









    // Debug stall signals
    assign o_dbg_stall = {
        icache_stall, // [7] icache stall
        immu_busy, // [6] IMMU busy (page table walk)
        stall_if, // [5]
        stall_id, // [4]
        stall_ex, // [3]
        stall_mem, // [2]
        flush_id, // [1]
        flush_ex // [0]
    };

    // Debug: branch prediction trace
    assign o_dbg_bp_predict = id_predict_taken; // prediction made (now in EX)
    assign o_dbg_bp_mispred = ex_misprediction;
    assign o_dbg_bp_taken   = ex_branch_taken;
    assign o_dbg_bp_ex_pc   = id_pc; // EX stage PC
    assign o_dbg_bp_target  = if ex_inst_is_jalr ? ex_jump_target : ex_branch_target;

    // Debug: trap trace
    assign o_dbg_trap_taken = trap_taken;
    assign o_dbg_trap_cause = trap_cause;
    assign o_dbg_trap_pc    = trap_pc;

    // Debug: LQ issue observation (LQ-4.4-b groundwork)
    // Counts cycles where an LQ entry is addr_ready && !data_ready (issue-eligible).
    // Today nothing consumes `lq_issue_valid` downstream (dcache_sel_lq = 0), so this
    // is purely observational and confirms whether the LQ ever holds entries that
    // could be routed through a dedicated dcache-issue path in future B-2..B-4 steps.
    // `dbg_lq_alloc_cnt` captures total LQ allocations for a ratio baseline —
    // issue-eligibility % = issue / alloc.
    var dbg_lq_issue_cnt: logic<32>;
    var dbg_lq_alloc_cnt: logic<32>;
    var dbg_lq_mshr_cnt : logic<32>; // MSHR-absorbed LQ alloc subset
    always_ff (clk, rst) {
        if_reset {
            dbg_lq_issue_cnt = 32'd0;
            dbg_lq_alloc_cnt = 32'd0;
            dbg_lq_mshr_cnt  = 32'd0;
        } else {
            if lq_issue_valid {
                dbg_lq_issue_cnt = dbg_lq_issue_cnt + 32'd1;
            }
            if lq_alloc_gate {
                dbg_lq_alloc_cnt = dbg_lq_alloc_cnt + 32'd1;
            }
            if lq_alloc_gate && mshr_absorb {
                dbg_lq_mshr_cnt = dbg_lq_mshr_cnt + 32'd1;
            }
        }
    }
    assign o_dbg_lq_issue_cnt = dbg_lq_issue_cnt;
    assign o_dbg_lq_alloc_cnt = dbg_lq_alloc_cnt;
    assign o_dbg_lq_mshr_cnt  = dbg_lq_mshr_cnt;

    // ============================================================
    // SRS-2 debug counters: dispatch / issue / drop rates.
    // ============================================================
    var dbg_srs_disp_cnt : logic<32>;
    var dbg_srs_issue_cnt: logic<32>;
    var dbg_srs_drop_cnt : logic<32>;
    always_ff (clk, rst) {
        if_reset {
            dbg_srs_disp_cnt  = 32'd0;
            dbg_srs_issue_cnt = 32'd0;
            dbg_srs_drop_cnt  = 32'd0;
        } else {
            // Accepted dispatch: SRS had space and the store was eligible.
            if srs_dispatch_valid {
                dbg_srs_disp_cnt = dbg_srs_disp_cnt + 32'd1;
            }
            // Dropped: eligible store but SRS full (observation gap).
            if id_is_srs_eligible && !flush_id && !stall_ex && !srs_dispatched_q && !srs_dispatch_ready {
                dbg_srs_drop_cnt = dbg_srs_drop_cnt + 32'd1;
            }
            // Issue cycles.
            if srs_issue_valid {
                dbg_srs_issue_cnt = dbg_srs_issue_cnt + 32'd1;
            }
        }
    }
    assign o_dbg_srs_disp_cnt  = dbg_srs_disp_cnt;
    assign o_dbg_srs_issue_cnt = dbg_srs_issue_cnt;
    assign o_dbg_srs_drop_cnt  = dbg_srs_drop_cnt;

    // ============================================================
    // P3.3-b shadow validation counters for byte-granular SB forward.
    // ============================================================
    var dbg_sb_fwd_hit_cnt     : logic<32>;
    var dbg_sb_fwd_partial_cnt : logic<32>;
    var dbg_sb_fwd_mismatch_cnt: logic<32>;
    var dbg_srs_load_drain_unresolved_cnt: logic<32>;
    var dbg_p34_spec_violation_cnt       : logic<32>;
    var dbg_dual_fetch_cnt               : logic<32>;
    var dbg_dual_issue_cnt               : logic<32>;
    always_ff (clk, rst) {
        if_reset {
            dbg_sb_fwd_hit_cnt      = 32'd0;
            dbg_sb_fwd_partial_cnt  = 32'd0;
            dbg_sb_fwd_mismatch_cnt = 32'd0;
            dbg_srs_load_drain_unresolved_cnt = 32'd0;
            dbg_p34_spec_violation_cnt        = 32'd0;
            dbg_dual_fetch_cnt                = 32'd0;
            dbg_dual_issue_cnt                = 32'd0;
        } else {
            if sb_fwd_hit {
                dbg_sb_fwd_hit_cnt = dbg_sb_fwd_hit_cnt + 32'd1;
            }
            if sb_fwd_partial {
                dbg_sb_fwd_partial_cnt = dbg_sb_fwd_partial_cnt + 32'd1;
            }
            // Exclude dcache-stalled and MSHR-absorbed cycles: in those
            // windows the dcache read doesn't reflect the cached value
            // and the load result flows through MSHR rather than this
            // mux, so a byte-masked mismatch vs SB is expected.
            if sb_fwd_mismatch && !dcache_stall_raw {
                dbg_sb_fwd_mismatch_cnt = dbg_sb_fwd_mismatch_cnt + 32'd1;
            }
            // P3.4 opportunity: load at ID drained solely because an SRS
            // entry has unresolved base (no real address match detected).
            if id_mem_ren && srs_drain_needed && srs_probe_alias_unresolved {
                dbg_srs_load_drain_unresolved_cnt = dbg_srs_load_drain_unresolved_cnt + 32'd1;
            }
            // P3.4 detection: store wake aliased a younger in-flight load.
            if p34_spec_violation {
                dbg_p34_spec_violation_cnt = dbg_p34_spec_violation_cnt + 32'd1;
            }
            // F0 dual fetch / issue rate: dual_fetch_valid = front-end can
            // pair, dual_issue = dispatch fired both slots.
            if dual_fetch_valid {
                dbg_dual_fetch_cnt = dbg_dual_fetch_cnt + 32'd1;
            }
            if dual_issue {
                dbg_dual_issue_cnt = dbg_dual_issue_cnt + 32'd1;
            }
        }
    }
    assign o_dbg_sb_fwd_hit_cnt      = dbg_sb_fwd_hit_cnt;
    assign o_dbg_sb_fwd_partial_cnt  = dbg_sb_fwd_partial_cnt;
    assign o_dbg_sb_fwd_mismatch_cnt = dbg_sb_fwd_mismatch_cnt;
    assign o_dbg_srs_load_drain_unresolved_cnt = dbg_srs_load_drain_unresolved_cnt;
    assign o_dbg_p34_spec_violation_cnt        = dbg_p34_spec_violation_cnt;
    assign o_dbg_dual_fetch_cnt                = dbg_dual_fetch_cnt;
    assign o_dbg_dual_issue_cnt                = dbg_dual_issue_cnt;

    assign o_dbg_stall_cause_load_use = dbg_stall_load_use;
    assign o_dbg_stall_cause_mmu      = dbg_stall_mmu;
    assign o_dbg_stall_cause_cache    = dbg_stall_cache;
    assign o_dbg_stall_cause_rs       = dbg_stall_rs;
    assign o_dbg_stall_cause_rob_full = dbg_stall_rob_full;

    // Fine-grained i_rs_stall sub-cause signals (same 4 OR terms as the
    // i_rs_stall input to hazard_unit). Gated with stall_id_gate below so
    // they only assert when stall_id actually fires. Useful to distinguish
    // real RS-capacity pressure from direct-path blocking etc.
    let _rs_gate: logic = !(flush_id || flush_ex); // approximate stall_id_gate
    let _rs_full_int_raw : logic = id_is_rs_eligible && !rs_dispatch_ready;
    let _rs_full_fp_raw  : logic = id_is_fp_rs_eligible && !fp_rs_dispatch_ready;
    let _direct_stall_raw: logic = id_valid && !id_is_rs_eligible && !id_is_fp_rs_eligible && !direct_path_v;
    let _irq_wait_raw    : logic = irq_pending && !rob_empty;
    assign o_dbg_stall_cause_rs_full_int  = _rs_full_int_raw  && _rs_gate;
    assign o_dbg_stall_cause_rs_full_fp   = _rs_full_fp_raw   && _rs_gate;
    assign o_dbg_stall_cause_direct_stall = _direct_stall_raw && _rs_gate;
    assign o_dbg_stall_cause_irq_wait     = _irq_wait_raw     && _rs_gate;

    // direct_stall sub-sub-causes (when _direct_stall_raw is 1). Independent
    // sub-causes may overlap on the same cycle; count each one that fires.
    let _ds_operand_raw: logic = (id_direct_stall_rs1 || id_direct_stall_rs2
                               || fp_id_direct_stall_rs1 || fp_id_direct_stall_rs2);
    let _ds_drain_raw  : logic = rob_drain_needed;
    let _ds_rob_full_raw: logic = rob_full && !id_has_rob;
    let _ds_rs_yield_raw: logic = rs_yield;
    assign o_dbg_stall_ds_operand  = _direct_stall_raw && _ds_operand_raw   && _rs_gate;
    assign o_dbg_stall_ds_op_load  = _direct_stall_raw && _ds_operand_raw && id_mem_ren                              && _rs_gate;
    assign o_dbg_stall_ds_op_store = _direct_stall_raw && _ds_operand_raw && id_mem_wen                              && _rs_gate;
    assign o_dbg_stall_ds_op_bj    = _direct_stall_raw && _ds_operand_raw && (id_is_branch || id_is_jalr)             && _rs_gate;
    assign o_dbg_stall_ds_rs_yield = _direct_stall_raw && _ds_rs_yield_raw  && _rs_gate;
    assign o_dbg_stall_ds_rob_full = _direct_stall_raw && _ds_rob_full_raw  && _rs_gate;
    assign o_dbg_stall_ds_drain    = _direct_stall_raw && _ds_drain_raw     && _rs_gate;

    // flush_id sub-cause: classify mispredicts by branch type (id_is_* at
    // same cycle tracks the instruction in EX via execute's i_* inputs).
    assign o_dbg_mispred_branch = ex_misprediction && ex_inst_is_branch;
    assign o_dbg_mispred_jalr   = ex_misprediction && ex_inst_is_jalr;
    assign o_dbg_mispred_jal    = ex_misprediction && ex_inst_is_jal;
    assign o_dbg_flush_trap     = (trap_taken || mret_taken || sret_taken) && !ex_misprediction;
    assign o_dbg_mispred_jalr_return   = ex_misprediction && ex_inst_is_jalr && ex_is_return_q;
    assign o_dbg_mispred_jalr_indirect = ex_misprediction && ex_inst_is_jalr && !ex_is_return_q;

    // RAS diagnostics: IF-stage return detection rate + RAS-valid hit rate
    assign o_dbg_if_return_count = if_is_return && !icache_stall && !immu_busy;
    assign o_dbg_ras_used        = ras_predict_valid;
    assign o_dbg_ras_push        = if_is_call_push;
    assign o_dbg_ras_pop         = if_is_return_pop;

}
