// Phase 12 V0: Vector Register File (VRF).
//
// 32 architectural vector registers, VLEN(128) bits each. Owned by the in-order
// vector unit (vector_unit.veryl), which is the sole reader/writer — the VRF is
// NOT renamed (ReOVE: vector-vector reordering barely helps, so in-order
// execution lets us skip vector renaming entirely).
//
// Two combinational read ports (vs1 / vs2) and one registered write port (vd),
// modelled exactly like prf_fp: a registered (clock-edge) write with a
// combinational read, so a back-to-back dependent vector op reads the value the
// previous op wrote one cycle earlier. Reset value 0 (all elements +0 / zero).
pub module vrf #(
    param VRF_N: u32 = 32 ,
    param VRF_W: u32 = 5  ,
    param VLEN : u32 = 128,
) (
    clk: input clock,
    rst: input reset,

    // Read ports (combinational): vs1 / vs2 / mask(v0) / old-vd.
    // V1 added the memory path; V2 adds the mask (port 3, always v0) and the
    // old-destination read (port 4) needed for vta/vma tail/mask merging.
    i_rd1_addr: input  logic<VRF_W>,
    o_rd1_data: output logic<VLEN> ,
    i_rd2_addr: input  logic<VRF_W>,
    o_rd2_data: output logic<VLEN> ,
    i_rd3_addr: input  logic<VRF_W>,
    o_rd3_data: output logic<VLEN> ,
    i_rd4_addr: input  logic<VRF_W>,
    o_rd4_data: output logic<VLEN> ,

    // Write port (registered): vd.
    i_wr_en  : input logic       ,
    i_wr_addr: input logic<VRF_W>,
    i_wr_data: input logic<VLEN> ,
) {
    var vrf: logic<VLEN> [VRF_N];

    always_ff (clk, rst) {
        if_reset {
            for i in 0..VRF_N {
                vrf[i] = 0;
            }
        } else if i_wr_en {
            vrf[i_wr_addr] = i_wr_data;
        }
    }

    assign o_rd1_data = vrf[i_rd1_addr];
    assign o_rd2_data = vrf[i_rd2_addr];
    assign o_rd3_data = vrf[i_rd3_addr];
    assign o_rd4_data = vrf[i_rd4_addr];
}
