// decode: per-lane instruction decode, op classification and decode-time
// legality, between the decode queue (DQ) and the rename queue (rq).
//
// Ports (timing contract):
//   i_valid/i_xop : DQ output lanes, contiguous from lane 0, registered
//   i_rq_ready    : rq.o_ready (registered); the whole group moves or none
//   o_valid/o_dec : to rq.i_valid/i_data, combinational from the inputs
//   o_dq_take     : to DQ.i_take: every valid lane when rq is ready, else 0
//   i_priv, i_virt, i_mstatus_tsr, i_mstatus_tvm, i_csr, i_frm : live csr
//                   outputs, read combinationally
//   o_perf        : registered event wires
//   o_chk         : sticky invariant flags (HELIODOR_CHK builds only, else 0)
//   Kill is applied by the two queues (both flush on kill.valid); decode
//   holds no op state.
// Owns:
//   - an op that carries any exception (fetch fault, illegal, ECALL, EBREAK)
//     has class fu NONE and no destination
//   - an illegal op reports cause 2 with tval = the RVC parcel for an RVC op,
//     else the 32-bit instruction
//   - no op of a class this build does not serve leaves decode except as an
//     illegal-instruction fault (legality below is the only place deciding it)
//   - pred_taken is set only on branches and jumps (checked, not used)
// Legality (function `illegal`): an instruction is illegal when
//   - the reused decoder flags it (this includes every vector encoding the
//     vector unit does not implement)
//   - a vector instruction or a vector CSR access with mstatus.VS = Off, or
//     with vsstatus.VS = Off when V = 1; a vector FP instruction (OPFVV,
//     OPFVF) with mstatus.FS = Off; a reserved vector encoding the decoder
//     lets through (vrsub.vv, vmsgt{u}.vv, vsub.vi, vmin{u}.vi, vmax{u}.vi,
//     vmslt{u}.vi, vssub{u}.vi; vmv.v.* and vfmv.v.f with vs2 != 0,
//     vmv.x.s, vfmv.f.s, vcompress and the mask logical ops with vm = 0,
//     vfmv.s.f with vm = 0 or vs2 != 0, vid.v with vs2 != 0, a mask or
//     whole-register load or store with vm = 0, vlm.v and vsm.v with EEW
//     other than 8, a whole-register store with EEW other than 8)
//   - it is a load or store of a reserved width (LOAD funct3 111, STORE
//     funct3 1xx, a 16-byte FP access: no Q), or an FP op that rounds with a
//     reserved rm (101, 110) or with rm DYN while frm holds a reserved value
//     (101-111), or a vector FP op (OPFVV, OPFVF) while frm holds one
//   - an AMO encoding outside A, Zabha and Zacas: an unknown funct5, LR/SC
//     below W, LR with rs2 != 0, a width above D except amocas.q, or
//     amocas.q with an odd rd or rs2
//   - a CSR access names a CSR that does not exist, needs more privilege, or
//     writes a read-only CSR; or accesses satp in HS-mode with mstatus.TVM;
//     or names dcsr, dpc or dscratch0/1 outside Debug Mode; or, below M,
//     names hstateenN or sstateenN with mstateenN.SE clear, senvcfg or
//     henvcfg with mstateen0.ENVCFG clear, siselect, sireg*, vsiselect or
//     vsireg* with mstateen0.CSRIND clear, or srmcfg with mstateen0.SRMCFG
//     clear
//   - sireg* with V = 0 unless menvcfg.CDE, siselect is 0x40 + i for a
//     counter i that mcounteren delegates, and it is sireg for cycle,
//     instret or hpmcounter i or sireg2 for hpmevent i (Smcdeleg); sireg*
//     from VS with hstateen0.CSRIND set unless vsiselect is in 0x40-0x5F and
//     menvcfg.CDE is set; vsireg* with V = 0; scountinhibit without
//     menvcfg.CDE
//   - a counter (cycle, time, instret, hpmcounterN) below M whose mcounteren
//     bit is clear, or in U whose scounteren bit is clear; stimecmp or
//     vstimecmp below M without mcounteren.TM and menvcfg.STCE
//   - an F, D, Zfa or Zfhmin instruction (compute, load, store) or
//     fflags/frm/fcsr with mstatus.FS = Off
//   - a CBO below M that menvcfg disables (CBIE = 0 for inval, CBCFE for
//     clean and flush, CBZE for zero), or in U that senvcfg disables
//   - MRET below M, SRET in U or in HS-mode with mstatus.TSR, SFENCE.VMA or
//     SINVAL.VMA in HS-mode with mstatus.TVM, any SFENCE or SINVAL form in
//     U (HFENCE.GVMA also in HS-mode with mstatus.TVM), HLV/HSV in U without
//     hstatus.HU, WFI in U or below M with mstatus.TW, DRET outside Debug
//     Mode, or an undefined SYSTEM function
// Virtual instruction (cause 22, only when none of the above holds), with V
// = 1: HLV/HSV and HFENCE/HINVAL; an HS-legal access (mstatus.TVM aside) to
// a hypervisor or VS CSR, or from VU to a supervisor CSR; a counter that
// mcounteren allows but hcounteren (in VU also scounteren) does not;
// stimecmp in VS without hcounteren.TM and henvcfg.STCE; a CSR whose
// mstateen bit (above) is set and whose hstateen bit is clear; srmcfg and
// every sireg*; scountinhibit, and scountovf with menvcfg.CDE; a CBO that
// menvcfg allows but henvcfg (in VU also senvcfg) does not; in VU SRET, any SFENCE
// or SINVAL form and WFI; in VS SRET with hstatus.VTSR, SFENCE.VMA,
// SINVAL.VMA and satp with hstatus.VTVM, and WFI with hstatus.VTW. With V =
// 1, FS = Off also covers vsstatus.FS = Off.
// Debug Mode: an EBREAK carries ExcRec.dm (an entry into Debug Mode, not a
// breakpoint trap) when the dcsr.ebreakm/s/u/vs/vu bit of the current mode is
// set, and always in Debug Mode; dcsr is committed state like the rest.
// Rationale:
//   - legality reads the committed CSR state live with no shadow: every CSR
//     change retires with a flush, which empties DQ, decode and rq, so the
//     state a surviving op saw equals its state at commit
//   - a fetch fault outranks every decode-time exception, so the fetch
//     record is taken as is and the decoder output is discarded
//   - frm is committed state like the rest (a write to it retires with a
//     flush), so the DYN rounding check reads it live as well
//   - a legal WFI is a no-op (fu NONE): it completes at once, which the
//     privileged spec allows; the WFI that traps follows the reference model
//   - WRS.STO, and WRS.NTO outside the timeout rule, are no-ops (fu NONE):
//     Zawrs allows them to complete at once. Below M with mstatus.TW, or with
//     V = 1 and hstatus.VTW, a WRS.NTO is a SYS op: fu_sys times it out at
//     once into an illegal (TW) or virtual (VTW) instruction exception while
//     the reservation is valid, the only case in which it would wait
module decode::<CFG: core_cfg> (
    clk          : input  clock                                                                      ,
    rst          : input  reset                                                                      ,
    i_valid      : input  logic                                                        [CFG::FETCH_W],
    i_xop        : input  core_types::<CFG>::XOp                                       [CFG::FETCH_W],
    i_rq_ready   : input  logic                                                                      ,
    o_valid      : output logic                                                        [CFG::FETCH_W],
    o_dec        : output core_types::<CFG>::DecOp                                     [CFG::FETCH_W],
    o_dq_take    : output logic                     <tag_pkg::idx_w(CFG::FETCH_W + 1)>               ,
    i_priv       : input  csr_pkg::PrivLevel                                                         ,
    i_virt       : input  logic                                                                      ,
    i_mstatus_tsr: input  logic                                                                      ,
    i_mstatus_tvm: input  logic                                                                      ,
    i_csr        : input  csr_pkg::DecCsr                                                            ,
    i_frm        : input  logic                     <3>                                              ,
    o_perf       : output core_types::<CFG>::DecPerf                                                 ,
    o_chk        : output logic                                                                      ,
) {
    import core_types::<CFG>::*;
    import opclass_pkg::*;

    const W   : u32 = CFG::FETCH_W;
    const DT_W: u32 = tag_pkg::idx_w(W + 1);

    var alu_op    : alu_pkg::AluOp          [W];
    var alu_src_a : decode_pkg::AluSrcA     [W];
    var alu_src_b : decode_pkg::AluSrcB     [W];
    var imm_type  : riscv_pkg::ImmType      [W];
    var reg_wen   : logic                   [W];
    var mem_ren   : logic                   [W];
    var mem_wen   : logic                   [W];
    var is_branch : logic                   [W];
    var is_jal    : logic                   [W];
    var is_jalr   : logic                   [W];
    var is_ecall  : logic                   [W];
    var is_ebreak : logic                   [W];
    var is_mret   : logic                   [W];
    var is_wfi    : logic                   [W];
    var csr_op    : csr_pkg::CsrOp          [W];
    var is_csr    : logic                   [W];
    var csr_imm   : logic                   [W];
    var dec_ill   : logic                   [W];
    var is_amo    : logic                   [W];
    var amo_f5    : logic              <5>  [W];
    var is_fp     : logic                   [W];
    var fp_reg_wen: logic                   [W];
    var fpu_op    : fpu_pkg::FpuOp          [W];
    var is_sfence : logic                   [W];
    var is_sinval : logic                   [W];
    var is_fence_i: logic                   [W];
    var is_fence  : logic                   [W];
    var is_cbo_z  : logic                   [W];
    var is_cbo_m  : logic                   [W];
    var hlv       : logic                   [W];
    var hlvx      : logic                   [W];
    var is_vec    : logic                   [W];
    var vec_op    : vector_pkg::VecOp       [W];
    var imm64     : logic              <64> [W];

    for l in 0..W :g_dec {
        inst u_dec: decoder (
            i_instr           : i_xop[l].insn,
            o_alu_op          : alu_op[l]    ,
            o_alu_src_a       : alu_src_a[l] ,
            o_alu_src_b       : alu_src_b[l] ,
            o_imm_type        : imm_type[l]  ,
            o_wb_sel          : _            ,
            o_reg_wen         : reg_wen[l]   ,
            o_mem_ren         : mem_ren[l]   ,
            o_mem_wen         : mem_wen[l]   ,
            o_is_branch       : is_branch[l] ,
            o_is_jal          : is_jal[l]    ,
            o_is_jalr         : is_jalr[l]   ,
            o_is_ecall        : is_ecall[l]  ,
            o_is_ebreak       : is_ebreak[l] ,
            o_is_mret         : is_mret[l]   ,
            o_is_wfi          : is_wfi[l]    ,
            o_csr_op          : csr_op[l]    ,
            o_is_csr          : is_csr[l]    ,
            o_csr_imm         : csr_imm[l]   ,
            o_illegal         : dec_ill[l]   ,
            o_is_amo          : is_amo[l]    ,
            o_amo_funct5      : amo_f5[l]    ,
            o_is_fp           : is_fp[l]     ,
            o_fp_reg_wen      : fp_reg_wen[l],
            o_fp_int_wen      : _            ,
            o_fpu_op          : fpu_op[l]    ,
            o_fp_rm           : _            ,
            o_fp_rs3_addr     : _            ,
            o_is_sfence       : is_sfence[l] ,
            o_is_svinval_fence: is_sinval[l] ,
            o_is_fence_i      : is_fence_i[l],
            o_is_fence        : is_fence[l]  ,
            o_is_cbo_zero     : is_cbo_z[l]  ,
            o_is_cbo_m        : is_cbo_m[l]  ,
            o_hlv             : hlv[l]       ,
            o_hlvx            : hlvx[l]      ,
            o_is_vec          : is_vec[l]    ,
            o_vec_op          : vec_op[l]    ,
            o_vec_uses_scalar : _            ,
            o_vec_writes_int  : _            ,
        );
        inst u_imm: imm_gen (
            i_instr   : i_xop[l].insn,
            i_imm_type: imm_type[l]  ,
            o_imm     : imm64[l]     ,
        );
    }

    // FP ops reading an integer rs1 (moves and conversions from int).
    function fp_int_src (
        op: input fpu_pkg::FpuOp,
    ) -> logic {
        case op {
            fpu_pkg::FpuOp::FMV_W_X, fpu_pkg::FpuOp::FMV_D_X, fpu_pkg::FpuOp::FMV_H_X, fpu_pkg::FpuOp::FCVT_S_W,
            fpu_pkg::FpuOp::FCVT_S_WU, fpu_pkg::FpuOp::FCVT_S_L, fpu_pkg::FpuOp::FCVT_S_LU, fpu_pkg::FpuOp::FCVT_D_W,
            fpu_pkg::FpuOp::FCVT_D_WU, fpu_pkg::FpuOp::FCVT_D_L, fpu_pkg::FpuOp::FCVT_D_LU: return 1'b1;
            default: return 1'b0;
        }
    }

    // FP ops with an FP rs2 (the rs2 field of the others is a sub-opcode).
    function fp_rs2 (
        op: input fpu_pkg::FpuOp,
    ) -> logic {
        case op {
            fpu_pkg::FpuOp::FADD_S, fpu_pkg::FpuOp::FADD_D, fpu_pkg::FpuOp::FSUB_S, fpu_pkg::FpuOp::FSUB_D,
            fpu_pkg::FpuOp::FMUL_S, fpu_pkg::FpuOp::FMUL_D, fpu_pkg::FpuOp::FDIV_S, fpu_pkg::FpuOp::FDIV_D,
            fpu_pkg::FpuOp::FSGNJ_S, fpu_pkg::FpuOp::FSGNJN_S, fpu_pkg::FpuOp::FSGNJX_S, fpu_pkg::FpuOp::FSGNJ_D,
            fpu_pkg::FpuOp::FSGNJN_D, fpu_pkg::FpuOp::FSGNJX_D, fpu_pkg::FpuOp::FMIN_S, fpu_pkg::FpuOp::FMAX_S,
            fpu_pkg::FpuOp::FMIN_D, fpu_pkg::FpuOp::FMAX_D, fpu_pkg::FpuOp::FEQ_S, fpu_pkg::FpuOp::FLT_S,
            fpu_pkg::FpuOp::FLE_S, fpu_pkg::FpuOp::FEQ_D, fpu_pkg::FpuOp::FLT_D, fpu_pkg::FpuOp::FLE_D,
            fpu_pkg::FpuOp::FMADD_S, fpu_pkg::FpuOp::FMSUB_S, fpu_pkg::FpuOp::FNMADD_S, fpu_pkg::FpuOp::FNMSUB_S,
            fpu_pkg::FpuOp::FMADD_D, fpu_pkg::FpuOp::FMSUB_D, fpu_pkg::FpuOp::FNMADD_D, fpu_pkg::FpuOp::FNMSUB_D,
            fpu_pkg::FpuOp::FMINM_S, fpu_pkg::FpuOp::FMAXM_S, fpu_pkg::FpuOp::FMINM_D, fpu_pkg::FpuOp::FMAXM_D,
            fpu_pkg::FpuOp::FLEQ_S, fpu_pkg::FpuOp::FLTQ_S, fpu_pkg::FpuOp::FLEQ_D, fpu_pkg::FpuOp::FLTQ_D: return 1'b1;
            default: return 1'b0;
        }
    }

    function fp_rs3 (
        op: input fpu_pkg::FpuOp,
    ) -> logic {
        case op {
            fpu_pkg::FpuOp::FMADD_S, fpu_pkg::FpuOp::FMSUB_S, fpu_pkg::FpuOp::FNMADD_S, fpu_pkg::FpuOp::FNMSUB_S,
            fpu_pkg::FpuOp::FMADD_D, fpu_pkg::FpuOp::FMSUB_D, fpu_pkg::FpuOp::FNMADD_D,
            fpu_pkg::FpuOp::FNMSUB_D: return 1'b1;
            default: return 1'b0;
        }
    }

    function bru_op (
        jal  : input logic   ,
        jalr : input logic   ,
        auipc: input logic   ,
        f3   : input logic<3>,
    ) -> BruOp {
        if jal {
            return BruOp::JAL;
        } else if jalr {
            return BruOp::JALR;
        } else if auipc {
            return BruOp::AUIPC;
        }
        case f3 {
            3'b001 : return BruOp::BNE;
            3'b100 : return BruOp::BLT;
            3'b101 : return BruOp::BGE;
            3'b110 : return BruOp::BLTU;
            3'b111 : return BruOp::BGEU;
            default: return BruOp::BEQ;
        }
    }

    function amo_op (
        f5: input logic<5>,
    ) -> AmoOp {
        case f5 {
            5'b00010: return AmoOp::LR;
            5'b00011: return AmoOp::SC;
            5'b00001: return AmoOp::SWAP;
            5'b00100: return AmoOp::XOR;
            5'b01100: return AmoOp::AND;
            5'b01000: return AmoOp::OR;
            5'b10000: return AmoOp::MIN;
            5'b10100: return AmoOp::MAX;
            5'b11000: return AmoOp::MINU;
            5'b11100: return AmoOp::MAXU;
            5'b00101: return AmoOp::CAS;
            default : return AmoOp::ADD;
        }
    }

    // An AMO encoding of A, Zabha or Zacas (see the header).
    function amo_legal (
        insn: input logic<32>,
    ) -> logic {
        let f5 : logic<5> = insn[31:27];
        let f3 : logic<3> = insn[14:12];
        let lrsc: logic   = f5 == 5'b00010 || f5 == 5'b00011;
        let cas: logic    = f5 == 5'b00101;
        let known: logic  = lrsc || cas || f5 == 5'b00000 || f5 == 5'b00001 || f5 == 5'b00100 || f5 == 5'b01100
            || f5 == 5'b01000 || f5 == 5'b10000 || f5 == 5'b10100 || f5 == 5'b11000 || f5 == 5'b11100;
        let width: logic  = if lrsc ? (f3 == 3'd2 || f3 == 3'd3) : if cas ? (f3 <= 3'd4) : (f3 <= 3'd3);
        let pair : logic  = !(cas && f3 == 3'd4) || (!insn[7] && !insn[20]);
        let lr_rs2: logic = f5 != 5'b00010 || insn[24:20] == 5'd0;
        return known && width && pair && lr_rs2;
    }

    function sys_op (
        csr : input logic         ,
        cop : input csr_pkg::CsrOp,
        cimm: input logic         ,
    ) -> SysOp {
        if !csr {
            return SysOp::SFENCE_VMA;
        }
        case cop {
            csr_pkg::CsrOp::RS: return if cimm ? SysOp::CSRRSI : SysOp::CSRRS;
            csr_pkg::CsrOp::RC: return if cimm ? SysOp::CSRRCI : SysOp::CSRRC;
            default           : return if cimm ? SysOp::CSRRWI : SysOp::CSRRW;
        }
    }

    function csr_vec (
        a: input logic<12>,
    ) -> logic {
        return (a >= 12'h008 && a <= 12'h00a) || a == 12'h00f || (a >= 12'hc20 && a <= 12'hc22);
    }

    // Encodings RVV 1.0 reserves among those the decoder maps to an op: OPIVV
    // and OPIVI funct6 values, and operand fields an op requires (vm = 1 or
    // vs2 = 0 of the moves, vid.v and the mask ops, EEW 8 of vlm.v, vsm.v
    // and the whole-register stores).
    function vec_rsv (
        insn: input logic<32>,
    ) -> logic {
        let f6    : logic<6> = insn[31:26];
        let vm    : logic    = insn[25];
        let vs2   : logic<5> = insn[24:20];
        let vs1   : logic<5> = insn[19:15];
        let opv   : logic    = insn[6:0] == riscv_pkg::Opcode::OP_V;
        let ivv   : logic    = opv && insn[14:12] == 3'b000;
        let fvv   : logic    = opv && insn[14:12] == 3'b001;
        let mvv   : logic    = opv && insn[14:12] == 3'b010;
        let ivi   : logic    = opv && insn[14:12] == 3'b011;
        let ivx   : logic    = opv && insn[14:12] == 3'b100;
        let fvf   : logic    = opv && insn[14:12] == 3'b101;
        let ld    : logic    = insn[6:0] == riscv_pkg::Opcode::LOAD_FP;
        let st    : logic    = insn[6:0] == riscv_pkg::Opcode::STORE_FP;
        let rsv_f6: logic    = (ivv && (f6 == 6'b000011 || f6 == 6'b011110 || f6 == 6'b011111)) || (ivi && (f6 == 6'b000010
            || f6[5:2] == 4'b0001 || f6 == 6'b011010 || f6 == 6'b011011 || f6 == 6'b100010 || f6 == 6'b100011));
        let vmv_v : logic    = (ivv || ivx || ivi || fvf) && f6 == 6'b010111 && vm && vs2 != 5'd0;
        let mv_s  : logic    = ((mvv || fvv) && f6 == 6'b010000 && vs1 == 5'd0 && !vm) || (fvf && f6 == 6'b010000 && (!vm
            || vs2 != 5'd0));
        let vid   : logic    = mvv && f6 == 6'b010100 && vs1 == 5'b10001 && vs2 != 5'd0;
        let mask  : logic    = mvv && (f6 == 6'b010111 || f6[5:3] == 3'b011) && !vm;
        let whole : logic    = (ld || st) && insn[27:26] == 2'b00 && (vs2 == 5'b01011 || vs2 == 5'b01000);
        let rsv_ls: logic    = whole && (!vm || ((vs2 == 5'b01011 || st) && insn[14:12] != 3'b000));
        return rsv_f6 || vmv_v || mv_s || vid || mask || rsv_ls;
    }

    // The envcfg field that enables a CBO kind.
    function cbo_on (
        env : input logic<64>,
        kind: input logic<5> ,
    ) -> logic {
        return case kind {
            5'd0   : env[5:4] != 2'b00,
            5'd4   : env[7],
            default: env[6],
        };
    }

    // Decode-time legality of one instruction (see the header): bit 0 is an
    // illegal instruction (cause 2), bit 1 a virtual instruction (cause 22);
    // bit 0 wins when both hold.
    function illegal (
        insn  : input logic             <32>,
        dill  : input logic                 ,
        vec   : input logic                 ,
        vfp   : input logic                 , // a vector FP instruction
        fp    : input logic                 , // any F or D instruction
        enc   : input logic                 , // reserved width or rm (see the header)
        amo   : input logic                 ,
        cbo   : input logic                 ,
        hlv   : input logic                 , // HLV, HLVX or HSV
        csr   : input logic                 ,
        csr_wr: input logic                 ,
        sfence: input logic                 , // SFENCE.VMA, SINVAL.VMA, HFENCE, HINVAL
        sinval: input logic                 ,
        ecall : input logic                 ,
        ebreak: input logic                 ,
        xret  : input logic                 ,
        wfi   : input logic                 ,
        dret  : input logic                 ,
        priv  : input csr_pkg::PrivLevel    ,
        virt  : input logic                 ,
        tsr   : input logic                 ,
        tvm   : input logic                 ,
        cs    : input csr_pkg::DecCsr       ,
    ) -> logic<2> {
        let f3    : logic<3>  = insn[14:12];
        let f7    : logic<7>  = insn[31:25];
        let f12   : logic<12> = insn[31:20];
        let rp    : logic<2>  = if f12[9:8] == 2'b10 ? 2'b01 : f12[9:8];
        let hfen  : logic     = sfence && (f7 == 7'b0010001 || f7 == 7'b0110001 || f7 == 7'b0010011 || f7 == 7'b0110011);
        let gvma  : logic     = hfen && f7[5];
        let hs    : logic     = priv == csr_pkg::PrivLevel::SUPERVISOR && !virt;
        let vs    : logic     = priv == csr_pkg::PrivLevel::SUPERVISOR && virt;
        let vu    : logic     = priv == csr_pkg::PrivLevel::USER && virt;
        let wrs   : logic     = f12 == 12'h00d || f12 == 12'h01d;
        let mret  : logic     = xret && f12 == 12'h302;
        let sret  : logic     = xret && f12 == 12'h102;
        let is_sys: logic     = insn[6:0] == riscv_pkg::Opcode::SYSTEM;
        let umode : logic     = priv == csr_pkg::PrivLevel::USER;
        let u0    : logic     = umode && !virt; // U-mode with V = 0
        let below : logic     = priv != csr_pkg::PrivLevel::MACHINE;
        // CSR access: what HS-mode would allow (mstatus.TVM aside), then the
        // V = 1 rules that turn an HS-legal access into a virtual instruction.
        let csr_base: logic = csr_pkg::csr_exists(f12) && !(f12[11:10] == 2'b11 && csr_wr) && !(csr_pkg::csr_dm_only(f12)
            && !cs.dm);
        let ctr     : logic = f12[11:5] == 7'b1100000; // cycle, time, instret, hpmcounterN
        let ctr_m   : logic = ctr && below && !cs.mcounteren[f12[4:0]];
        let ctr_ill : logic = csr && (ctr_m || (u0 && ctr && !cs.scounteren[f12[4:0]]));
        let ctr_vill: logic = csr && ctr && !ctr_m && virt && (!cs.hcounteren[f12[4:0]] || (umode && !cs.scounteren[f12[4:0]]));
        let stce_m  : logic = cs.mcounteren[1] && cs.menvcfg[63];
        let stc_ill : logic = csr && (f12 == 12'h14d || f12 == 12'h24d) && below && !stce_m;
        let stc_vill: logic = csr && f12 == 12'h14d && vs && !(cs.hcounteren[1] && cs.henvcfg[63]);
        let h_csr   : logic = f12[9:8] == 2'b10; // hypervisor and VS CSRs
        let csr_vhs : logic = virt && (h_csr || (umode && f12[9:8] == 2'b01)); // HS-level from VS/VU
        let csr_ill : logic = csr && (!csr_base || (if csr_vhs ? 1'b0 : rp >: priv) || (hs && tvm && (f12 == 12'h180
            || f12 == 12'h680)));
        // Indirect access: sireg and sireg2 reach the delegated counters with
        // siselect 0x40-0x5F; vsireg* never has an implemented value.
        let sisel   : logic    = f12 == 12'h150;
        let sireg   : logic    = csr_pkg::csr_ireg(f12, 2'd1);
        let vsireg  : logic    = csr_pkg::csr_ireg(f12, 2'd2);
        let ind     : logic    = sisel || sireg || f12 == 12'h250 || vsireg;
        let cde     : logic    = cs.menvcfg[60];
        let ci      : logic<5> = cs.siselect[4:0];
        let s_win   : logic    = cs.siselect[11:5] == 7'd2;
        let v_win   : logic    = cs.vsiselect[11:5] == 7'd2;
        let s_ok    : logic    = s_win && cde && cs.mcounteren[ci] && ((f12 == 12'h151 && ci != 5'd1) || (f12 == 12'h152
            && ci >= 5'd3));
        let ind_ill : logic    = csr && ((sireg && (if virt ? !umode && cs.hstateen[5] && !(v_win && cde) : !s_ok))
            || (vsireg && !virt));
        let cin     : logic    = f12 == 12'h120; // scountinhibit
        let cdel_ill: logic    = csr && cin && !cde;
        let cdel_v  : logic    = virt && (sireg || cin || (f12 == 12'hda0 && cde) || f12 == 12'h181);
        // The xstateen bit that gates the CSR: SE of hstateenN and sstateenN,
        // ENVCFG of senvcfg and henvcfg, CSRIND of the indirect registers
        // (hstateen0 only for siselect and sireg*), SRMCFG of srmcfg.
        let st_se   : logic = f12[11:2] == 10'b0110_0000_11 || f12[11:2] == 10'b0001_0000_11;
        let st_env  : logic = f12 == 12'h10a || f12 == 12'h60a;
        let st_m    : logic = !(st_se && !cs.mstateen[f12[1:0]]) && !(st_env && !cs.mstateen[4]) && !(ind && !cs.mstateen[5])
            && !(f12 == 12'h181 && !cs.mstateen[6]);
        let st_h    : logic = !(st_se && !cs.hstateen[f12[1:0]]) && !(st_env && !cs.hstateen[4]) && !((sisel || sireg)
            && !cs.hstateen[5]);
        let st_ill  : logic = csr && below && !st_m;
        let csr_vill: logic = csr && csr_base && (csr_vhs || (vs && cs.vtvm && f12 == 12'h180) || (virt && !st_h) || cdel_v);
        let fs_ill  : logic = (cs.fs == 2'b00 || (virt && cs.vsfs == 2'b00)) && (fp || vfp || (csr && f12 >= 12'h001
            && f12 <= 12'h003));
        let vs_off  : logic = cs.vs == 2'b00 || (virt && cs.vsvs == 2'b00);
        let vs_ill  : logic = (vec && (vs_off || vec_rsv(insn))) || (csr && csr_vec(f12) && vs_off);
        let cbo_k   : logic<5> = insn[24:20]; // 0 inval, 1 clean, 2 flush, 4 zero
        let cbo_ill : logic = cbo && ((below && !cbo_on(cs.menvcfg, cbo_k)) || (u0 && !cbo_on(cs.senvcfg, cbo_k)));
        let cbo_vill: logic = cbo && virt && (!cbo_on(cs.henvcfg, cbo_k) || (umode && !cbo_on(cs.senvcfg, cbo_k)));
        let unsrv   : logic = amo && !amo_legal(insn);
        let vmsfen  : logic = sfence && !hfen; // SFENCE.VMA, SINVAL.VMA
        let sys_ill : logic = (mret && below) || (sret && (u0 || (hs && tsr))) || (vmsfen && (u0 || (hs && tvm))) || (sinval
            && u0) || (hfen && (u0 || (gvma && hs && tvm))) || (wfi && (u0 || (below && cs.tw))) || (hlv && u0 && !cs.hu)
            || (dret && !cs.dm) || (is_sys && f3 == 3'b000 && !(ecall || ebreak || xret || wfi || sfence || sinval || wrs
            || dret));
        let sys_vill: logic = (sret && (vu || (vs && cs.vtsr))) || (vmsfen && (vu || (vs && cs.vtvm))) || (sinval && vu)
            || ((hfen || hlv) && virt) || (wfi && !cs.tw && (vu || (vs && cs.vtw)));
        let ill: logic = dill || enc || unsrv || csr_ill || st_ill || ind_ill || cdel_ill || ctr_ill || stc_ill || fs_ill
            || vs_ill || cbo_ill || sys_ill;
        return {!ill && (csr_vill || ctr_vill || stc_vill || cbo_vill || sys_vill), ill};
    }

    var lane_ill: logic [W];
    var lane_exc: logic [W];

    always_comb {
        for l in 0..W {
            let insn  : logic<32> = i_xop[l].insn;
            let f3    : logic<3>  = insn[14:12];
            let f12   : logic<12> = insn[31:20];
            let csr_wr: logic     = csr_op[l] == csr_pkg::CsrOp::RW || insn[19:15] != 0;
            let sret  : logic     = is_mret[l] && f12 == 12'h102;
            let dret  : logic     = insn == 32'h7b20_0073;
            let eb_dm : logic     = i_csr.dm || case i_priv {
                csr_pkg::PrivLevel::MACHINE   : i_csr.ebreak[2],
                csr_pkg::PrivLevel::SUPERVISOR: if i_virt ? i_csr.ebreakv[1] : i_csr.ebreak[1],
                default                       : if i_virt ? i_csr.ebreakv[0] : i_csr.ebreak[0],
            };
            // HINVAL.VVMA/GVMA: the decoder leaves them to the SYSTEM catch-all.
            let hinval: logic     = insn[6:0] == riscv_pkg::Opcode::SYSTEM && f3 == 3'b000 && insn[11:7] == 5'd0
                && (insn[31:25] == 7'b0010011 || insn[31:25] == 7'b0110011);
            let sfen  : logic     = is_sfence[l] || hinval;
            let wrs_to: logic     = insn == 32'h00d0_0073 && ((i_priv != csr_pkg::PrivLevel::MACHINE && i_csr.tw) || (i_virt
                && i_csr.vtw));
            let hf_k  : xlate_pkg::InvKind = if insn[31:25] == 7'b0110001 || insn[31:25] == 7'b0110011 ?
                xlate_pkg::InvKind::HFENCE_GVMA
            : if i_virt || insn[31:25] == 7'b0010001 || insn[31:25] == 7'b0010011 ?
                xlate_pkg::InvKind::HFENCE_VVMA
            :
                xlate_pkg::InvKind::SFENCE
            ;
            let hlv_m : logic     = hlv[l] || hlvx[l];
            let fpc   : logic     = is_fp[l] && !mem_ren[l] && !mem_wen[l];
            let opv   : logic     = insn[6:0] == riscv_pkg::Opcode::OP_V;
            let vfp   : logic     = is_vec[l] && opv && (f3 == 3'b001 || f3 == 3'b101);
            let fpcsr : logic     = is_csr[l] && f12 >= 12'h001 && f12 <= 12'h003;
            let rm_ill: logic     = (fpc && fp_rounds(fpu_op[l]) && (f3 == 3'b101 || f3 == 3'b110 || (f3 == 3'b111
                && i_frm >= 3'b101))) || (vfp && i_frm >= 3'b101);
            let opc   : logic<7>  = insn[6:0];
            let w_rsv : logic     = (opc == riscv_pkg::Opcode::LOAD && f3 == 3'b111) || (opc == riscv_pkg::Opcode::STORE
                && f3[2]) || (is_fp[l] && !fpc && f3 == 3'b100);

            let ill: logic<2> = illegal(insn, dec_ill[l], is_vec[l], vfp, is_fp[l] && !is_vec[l], w_rsv || rm_ill, is_amo[l],
                is_cbo_z[l] || is_cbo_m[l], hlv_m, is_csr[l], csr_wr, sfen, is_sinval[l], is_ecall[l], is_ebreak[l], is_mret[l],
                is_wfi[l], dret, i_priv, i_virt, i_mstatus_tsr, i_mstatus_tvm, i_csr);

            var exc: exc_pkg::ExcRec;
            exc = 0 as exc_pkg::ExcRec;
            if i_xop[l].exc.valid {
                exc = i_xop[l].exc;
            } else if ill != 2'b00 {
                exc.valid = 1'b1;
                exc.cause = if ill[0] ? 6'd2 : 6'd22;
                exc.tval  = if i_xop[l].is_rvc ? {48'd0, i_xop[l].cinsn} : {32'd0, insn};
            } else if is_ecall[l] {
                exc.valid = 1'b1;
                case i_priv {
                    csr_pkg::PrivLevel::USER      : exc.cause = 6'd8;
                    csr_pkg::PrivLevel::SUPERVISOR: exc.cause = if i_virt ? 6'd10 : 6'd9;
                    default                       : exc.cause = 6'd11;
                }
            } else if is_ebreak[l] {
                exc.valid = 1'b1;
                exc.cause = 6'd3;
                exc.dm    = eb_dm;
            }
            lane_ill[l] = !i_xop[l].exc.valid && ill != 2'b00;
            lane_exc[l] = exc.valid;

            var di           : DecInfo;
            di.rd_nz      = insn[11:7] != 0;
            di.writes_int = reg_wen[l] && !fp_reg_wen[l];
            di.writes_fp  = fp_reg_wen[l];
            di.is_branch  = is_branch[l];
            di.is_jal     = is_jal[l];
            di.is_jalr    = is_jalr[l];
            di.is_auipc   = insn[6:0] == riscv_pkg::Opcode::AUIPC;
            di.mem_ren    = mem_ren[l];
            di.mem_wen    = mem_wen[l];
            di.is_amo     = is_amo[l];
            di.amo_lr     = amo_f5[l] == 5'b00010;
            di.amo_aq     = insn[26];
            di.amo_pair   = is_amo[l] && amo_f5[l] == 5'b00101 && f3 == 3'd4;
            di.is_csr     = is_csr[l];
            di.csr_wr     = csr_wr;
            di.csr_fp     = fpcsr;
            di.csr_vec    = is_csr[l] && csr_vec(f12);
            di.is_xret    = is_mret[l] || dret;
            di.is_sfence  = sfen;
            di.is_sinval  = is_sinval[l];
            di.is_wrs     = wrs_to;
            di.is_fence   = is_fence[l];
            di.is_fence_i = is_fence_i[l];
            di.is_fp      = fpc && !is_vec[l];
            di.is_vec     = is_vec[l];
            di.vec_st     = is_vec[l] && opc == riscv_pkg::Opcode::STORE_FP;
            di.vec_fp     = vfp;
            di.alu_op     = alu_op[l];
            di.fpu_op     = fpu_op[l];

            var c: OpClass;
            c = op_class(di, exc.valid);

            var d           : DecOp;
            d            = 0 as DecOp;
            d.insn       = insn;
            d.is_rvc     = i_xop[l].is_rvc;
            d.ftq        = i_xop[l].ftq;
            d.foff       = i_xop[l].foff;
            d.pred_taken = i_xop[l].pred_taken;
            d.xret       = if dret ? XretKind::DRET : if sret ? XretKind::SRET : XretKind::MRET;
            d.fence_i    = is_fence_i[l] && !exc.valid;
            d.cls        = c;
            d.exc        = exc;
            d.imm        = imm64[l][31:0];
            d.rs1.arch   = insn[19:15];
            d.rs2.arch   = insn[24:20];
            d.rs3.arch   = insn[31:27];
            d.dst.arch   = insn[11:7];
            d.dst.has_rd = c.budget.int_rd || c.budget.fp_rd;
            d.dst.rcls   = if c.budget.fp_rd ? RegClass::FP : RegClass::INT;

            case c.fu {
                FuKind::ALU, FuKind::MUL, FuKind::DIV: {
                    d.uop      = alu_op[l] as UOP_W;
                    d.rs1.used = alu_src_a[l] == decode_pkg::AluSrcA::REG;
                    d.rs2.used = alu_src_b[l] == decode_pkg::AluSrcB::REG;
                }
                FuKind::BRU: {
                    d.uop      = bru_op(is_jal[l], is_jalr[l], di.is_auipc, f3) as UOP_W;
                    d.rs1.used = is_branch[l] || is_jalr[l];
                    d.rs2.used = is_branch[l];
                }
                FuKind::SYS: {
                    d.uop      = if wrs_to ? SysOp::WRS_NTO as UOP_W : sys_op(is_csr[l], csr_op[l], csr_imm[l]) as UOP_W;
                    d.rs1.used = !wrs_to && (!is_csr[l] || !csr_imm[l]);
                    d.rs2.used = !wrs_to && !is_csr[l];
                    d.imm      = if wrs_to ?
                        {31'd0, !i_csr.tw}
                    : if is_csr[l] ?
                        {15'd0, insn[19:15], f12}
                    :
                        {28'd0, hf_k as 2, insn[24:20] == 0, insn[19:15] == 0}
                    ;
                }
                // An HLV/HSV has no offset; its size is funct7[2:1] and rs2[0]
                // makes an HLV load unsigned.
                FuKind::LOAD, FuKind::STORE: {
                    let cbo: logic = is_cbo_z[l] || is_cbo_m[l];
                    d.uop      = if hlv_m ?
                        {hlvx[l], 1'b1, 2'b00, c.fu == FuKind::LOAD && insn[20], insn[27:26]} as UOP_W
                    :
                        {cbo, is_fp[l], if cbo ? f12[2:0] : f3} as UOP_W
                    ;
                    d.rs1.used = 1'b1;
                    d.rs2.used = c.fu == FuKind::STORE && !cbo;
                    d.rs2.rcls = if is_fp[l] ? RegClass::FP : RegClass::INT;
                    if cbo || hlv_m {
                        d.imm = 32'd0;
                    }
                }
                FuKind::FMA, FuKind::FMISC, FuKind::FDIV: {
                    let fli: logic = fpu_op[l] == fpu_pkg::FpuOp::FLI_S || fpu_op[l] == fpu_pkg::FpuOp::FLI_D;
                    d.uop      = fpu_op[l] as UOP_W;
                    d.rm       = f3;
                    d.imm      = {27'd0, insn[19:15]}; // FLI: the constant index
                    d.rs1.used = !fli;
                    d.rs1.rcls = if fp_int_src(fpu_op[l]) ? RegClass::INT : RegClass::FP;
                    d.rs2.used = fp_rs2(fpu_op[l]);
                    d.rs2.rcls = RegClass::FP;
                    d.rs3.used = fp_rs3(fpu_op[l]);
                    d.rs3.rcls = RegClass::FP;
                }
                // The sources are the rename-time mappings of x[rs1], x[rs2]
                // and f[rs1]; vu_adapter checks all three done.
                FuKind::VEC: {
                    d.uop      = vec_op[l] as UOP_W;
                    d.rs1.used = 1'b1;
                    d.rs2.used = 1'b1;
                    d.rs3.used = 1'b1;
                    d.rs3.rcls = RegClass::FP;
                    d.rs3.arch = insn[19:15];
                }
                // imm carries rd and rs2 for atomic_unit; the AGU adds 0.
                FuKind::ATOMIC: {
                    var au: AmoUop;
                    au.op      = amo_op(amo_f5[l]);
                    au.f3      = f3;
                    d.uop      = au as UOP_W;
                    d.imm      = {22'd0, insn[24:20], insn[11:7]};
                    d.rs1.used = 1'b1;
                    d.rs2.used = au.op != AmoOp::LR;
                }
                default: {}
            }
            o_dec[l]   = d;
            o_valid[l] = i_valid[l];
        }
    }

    var vmask: logic<W>;
    always_comb {
        for l in 0..W {
            vmask[l] = i_valid[l];
        }
    }
    assign o_dq_take = if i_rq_ready ? tree_popcount::<W, DT_W>(vmask) : 0;

    var ill_any : logic   ;
    var taken_ok: logic<W>;
    always_comb {
        var m: logic<W>;
        for l in 0..W {
            m[l]        = i_valid[l] && lane_ill[l];
            taken_ok[l] = !i_valid[l] || !i_xop[l].pred_taken || is_branch[l] || is_jal[l] || is_jalr[l] || lane_exc[l];
        }
        ill_any = |m;
    }

    var perf_q: DecPerf;
    always_ff {
        if_reset {
            perf_q = 0 as DecPerf;
        } else {
            perf_q.illegal = ill_any;
            perf_q.rq_full = i_valid[0] && !i_rq_ready;
        }
    }
    assign o_perf = perf_q;

    #[ifdef(HELIODOR_CHK)]
    {
        inst u_chk: chk_decode #(
            W: W,
        ) (
            clk                 ,
            rst                 ,
            i_taken_ok: taken_ok,
            o_chk               ,
        );
    }
    #[ifndef(HELIODOR_CHK)]
    {
        assign o_chk = 1'b0;
        let _unused_taken_ok: logic<W> = taken_ok;
    }
}
