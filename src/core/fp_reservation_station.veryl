// FP Reservation Station: 8-entry issue queue for FP arithmetic ops.
// Mirrors the integer reservation_station pattern with FP-specific fields:
//   - FpuOp (instead of AluOp)
//   - 3 operands (rs1, rs2, rs3) to support FMADD/FMSUB/FNMADD/FNMSUB
//   - rounding mode (rm)
//   - fp_wen / fflags_valid passthrough
//
// CDB wakeup is from the FP CDB only — E2-a skeleton covers pure FP→FP
// ops (FADD/FSUB/FMUL/FDIV/FSQRT/FMADD family/FMIN/FMAX/FSGNJ/FCVT.S.D).
// Cross-domain ops (FMV.D.X, FCVT.D.W, FCMP→int, FCLASS→int) stay on
// the direct EX path and are added later in E2-c integration.
//
// Issue output is REGISTERED (1-cycle latency from dispatch to issue)
// to avoid combinational loops through module boundaries.
pub module fp_reservation_station (
    clk: input clock,
    rst: input reset,

    // Dispatch interface (from ID stage)
    i_dispatch_valid       : input logic            ,
    i_dispatch_pc          : input logic        <64>,
    i_dispatch_fpu_op      : input fpu_pkg::FpuOp   ,
    i_dispatch_rm          : input logic        <3> ,
    i_dispatch_rd          : input logic        <5> ,
    i_dispatch_rs1         : input logic        <5> ,
    i_dispatch_rs2         : input logic        <5> ,
    i_dispatch_rs3         : input logic        <5> ,
    i_dispatch_fp_wen      : input logic            ,
    i_dispatch_reg_wen     : input logic            , // int-writing FP (FMV.X, FCVT.int, FCMP, FCLASS)
    i_dispatch_fflags_valid: input logic            , // op emits fflags
    i_dispatch_rob         : input logic        <5> ,
    i_dispatch_epoch       : input logic        <2> ,
    // Operand status at dispatch (FP operands tracked by ROB index tags)
    i_dispatch_s1_ready: input logic     ,
    i_dispatch_s1_tag  : input logic <5> ,
    i_dispatch_s1_epoch: input logic <2> ,
    i_dispatch_s1_data : input logic <64>,
    i_dispatch_s2_ready: input logic     ,
    i_dispatch_s2_tag  : input logic <5> ,
    i_dispatch_s2_epoch: input logic <2> ,
    i_dispatch_s2_data : input logic <64>,
    i_dispatch_s3_ready: input logic     ,
    i_dispatch_s3_tag  : input logic <5> ,
    i_dispatch_s3_epoch: input logic <2> ,
    i_dispatch_s3_data : input logic <64>,
    o_dispatch_ready   : output logic    , // RS has a free slot

    // Issue interface (registered output)
    o_issue_valid       : output logic            ,
    o_issue_pc          : output logic        <64>,
    o_issue_fpu_op      : output fpu_pkg::FpuOp   ,
    o_issue_rm          : output logic        <3> ,
    o_issue_rd          : output logic        <5> ,
    o_issue_rs1         : output logic        <5> ,
    o_issue_rs2         : output logic        <5> ,
    o_issue_rs3         : output logic        <5> ,
    o_issue_s1_data     : output logic        <64>,
    o_issue_s2_data     : output logic        <64>,
    o_issue_s3_data     : output logic        <64>,
    o_issue_fp_wen      : output logic            ,
    o_issue_reg_wen     : output logic            , // int-writing FP
    o_issue_fflags_valid: output logic            ,
    o_issue_rob         : output logic        <5> ,
    o_issue_epoch       : output logic        <2> ,
    i_issue_stall       : input  logic            , // FPU cannot accept

    // FP CDB port 0 (primary FPU result — FADD/FMUL/etc. completion)
    i_fp_cdb0_valid: input logic    ,
    i_fp_cdb0_rob  : input logic<5> ,
    i_fp_cdb0_epoch: input logic<2> ,
    i_fp_cdb0_data : input logic<64>,

    // FP CDB port 1 (secondary — e.g. FDIV/FSQRT async completion in D2)
    i_fp_cdb1_valid: input logic     ,
    i_fp_cdb1_rob  : input logic<5> ,
    i_fp_cdb1_epoch: input logic<2> ,
    i_fp_cdb1_data : input logic<64>,

    // Flush (trap) — full invalidation
    i_flush: input logic,

    // Squash (branch misprediction) — selective invalidation by ROB idx
    i_squash_valid: input logic     ,
    i_squash_mask : input logic [32],

    // Debug: sel_valid exposed for starvation detection
    o_sel_valid: output logic,
) {
    // ============================================================
    // Entry storage (8 entries)
    // ============================================================
    const RS_DEPTH: u32 = 16;

    var valid         : logic             [16];
    var e_pc          : logic         <64>[16];
    var e_fpu_op      : logic         <6> [16]; // FpuOp as raw logic (width matches FpuOp enum)
    var e_rm          : logic         <3> [16];
    var e_rd          : logic         <5> [16];
    var e_rs1         : logic         <5> [16];
    var e_rs2         : logic         <5> [16];
    var e_rs3         : logic         <5> [16];
    var e_fp_wen      : logic             [16];
    var e_reg_wen     : logic             [16]; // int-writing FP
    var e_fflags_valid: logic             [16];
    var e_rob         : logic         <5> [16];
    var e_epoch       : logic         <2> [16];
    var s1_ready      : logic             [16];
    var s1_tag        : logic         <5> [16];
    var s1_epoch      : logic         <2> [16];
    var s1_data       : logic         <64>[16];
    var s2_ready      : logic             [16];
    var s2_tag        : logic         <5> [16];
    var s2_epoch      : logic         <2> [16];
    var s2_data       : logic         <64>[16];
    var s3_ready      : logic             [16];
    var s3_tag        : logic         <5> [16];
    var s3_epoch      : logic         <2> [16];
    var s3_data       : logic         <64>[16];

    // ============================================================
    // Combinational: free slot, ready detection, issue select
    // ============================================================
    var free_idx  : logic<4>;
    var free_found: logic   ;
    var ready     : logic [16];
    var sel_idx   : logic<4>;
    var sel_valid : logic   ;

    always_comb {
        free_found = 1'b0;
        free_idx   = 4'd0;
        for i in 0..16{
            if !valid[i] && !free_found {
                free_found = 1'b1;
                free_idx   = i[3:0];
            }
        }
        // Ready mask with same-cycle FP CDB bypass (epoch-checked).
        // An entry is ready when all three operands (s1, s2, s3) are
        // either already latched or being delivered on CDB this cycle.
        for i in 0..16{
            ready[i] = valid[i]
                && (s1_ready[i]
                    || (i_fp_cdb0_valid && s1_tag[i] == i_fp_cdb0_rob && s1_epoch[i] == i_fp_cdb0_epoch)
                    || (i_fp_cdb1_valid && s1_tag[i] == i_fp_cdb1_rob && s1_epoch[i] == i_fp_cdb1_epoch))
                && (s2_ready[i]
                    || (i_fp_cdb0_valid && s2_tag[i] == i_fp_cdb0_rob && s2_epoch[i] == i_fp_cdb0_epoch)
                    || (i_fp_cdb1_valid && s2_tag[i] == i_fp_cdb1_rob && s2_epoch[i] == i_fp_cdb1_epoch))
                && (s3_ready[i]
                    || (i_fp_cdb0_valid && s3_tag[i] == i_fp_cdb0_rob && s3_epoch[i] == i_fp_cdb0_epoch)
                    || (i_fp_cdb1_valid && s3_tag[i] == i_fp_cdb1_rob && s3_epoch[i] == i_fp_cdb1_epoch));
        }
        // Issue select: first ready entry (lowest index = simple priority)
        sel_valid = 1'b0;
        sel_idx   = 4'd0;
        for i in 0..16{
            if ready[i] && !sel_valid {
                sel_valid = 1'b1;
                sel_idx   = i[3:0];
            }
        }
    }

    assign o_dispatch_ready = free_found || !i_dispatch_valid;
    assign o_sel_valid      = sel_valid;

    // ============================================================
    // Sequential: dispatch, CDB wakeup, issue (registered), flush
    // ============================================================
    always_ff (clk, rst) {
        if_reset {
            o_issue_valid = 1'b0;
            for i in 0..16{
                valid[i] = 1'b0;
            }
        } else if i_flush {
            o_issue_valid = 1'b0;
            for i in 0..16{
                valid[i] = 1'b0;
            }
        } else {
            // CDB wakeup: update operand data and ready flags (epoch-checked)
            for i in 0..16{
                if valid[i] {
                    if !s1_ready[i] {
                        if i_fp_cdb0_valid && s1_tag[i] == i_fp_cdb0_rob && s1_epoch[i] == i_fp_cdb0_epoch {
                            s1_ready[i] = 1'b1;
                            s1_data[i]  = i_fp_cdb0_data;
                        } else if i_fp_cdb1_valid && s1_tag[i] == i_fp_cdb1_rob && s1_epoch[i] == i_fp_cdb1_epoch {
                            s1_ready[i] = 1'b1;
                            s1_data[i]  = i_fp_cdb1_data;
                        }
                    }
                    if !s2_ready[i] {
                        if i_fp_cdb0_valid && s2_tag[i] == i_fp_cdb0_rob && s2_epoch[i] == i_fp_cdb0_epoch {
                            s2_ready[i] = 1'b1;
                            s2_data[i]  = i_fp_cdb0_data;
                        } else if i_fp_cdb1_valid && s2_tag[i] == i_fp_cdb1_rob && s2_epoch[i] == i_fp_cdb1_epoch {
                            s2_ready[i] = 1'b1;
                            s2_data[i]  = i_fp_cdb1_data;
                        }
                    }
                    if !s3_ready[i] {
                        if i_fp_cdb0_valid && s3_tag[i] == i_fp_cdb0_rob && s3_epoch[i] == i_fp_cdb0_epoch {
                            s3_ready[i] = 1'b1;
                            s3_data[i]  = i_fp_cdb0_data;
                        } else if i_fp_cdb1_valid && s3_tag[i] == i_fp_cdb1_rob && s3_epoch[i] == i_fp_cdb1_epoch {
                            s3_ready[i] = 1'b1;
                            s3_data[i]  = i_fp_cdb1_data;
                        }
                    }
                }
            }

            // Issue output: registered. Select ready entry and latch to output.
            if !i_issue_stall {
                if sel_valid {
                    o_issue_valid        = 1'b1;
                    o_issue_pc           = e_pc[sel_idx];
                    o_issue_fpu_op       = e_fpu_op[sel_idx];
                    o_issue_rm           = e_rm[sel_idx];
                    o_issue_rd           = e_rd[sel_idx];
                    o_issue_rs1          = e_rs1[sel_idx];
                    o_issue_rs2          = e_rs2[sel_idx];
                    o_issue_rs3          = e_rs3[sel_idx];
                    // Operand data with same-cycle CDB bypass
                    o_issue_s1_data = if !s1_ready[sel_idx] && i_fp_cdb0_valid && s1_tag[sel_idx] == i_fp_cdb0_rob && s1_epoch[sel_idx] == i_fp_cdb0_epoch ?
                        i_fp_cdb0_data : if !s1_ready[sel_idx] && i_fp_cdb1_valid && s1_tag[sel_idx] == i_fp_cdb1_rob && s1_epoch[sel_idx] == i_fp_cdb1_epoch ?
                        i_fp_cdb1_data : s1_data[sel_idx];
                    o_issue_s2_data = if !s2_ready[sel_idx] && i_fp_cdb0_valid && s2_tag[sel_idx] == i_fp_cdb0_rob && s2_epoch[sel_idx] == i_fp_cdb0_epoch ?
                        i_fp_cdb0_data : if !s2_ready[sel_idx] && i_fp_cdb1_valid && s2_tag[sel_idx] == i_fp_cdb1_rob && s2_epoch[sel_idx] == i_fp_cdb1_epoch ?
                        i_fp_cdb1_data : s2_data[sel_idx];
                    o_issue_s3_data = if !s3_ready[sel_idx] && i_fp_cdb0_valid && s3_tag[sel_idx] == i_fp_cdb0_rob && s3_epoch[sel_idx] == i_fp_cdb0_epoch ?
                        i_fp_cdb0_data : if !s3_ready[sel_idx] && i_fp_cdb1_valid && s3_tag[sel_idx] == i_fp_cdb1_rob && s3_epoch[sel_idx] == i_fp_cdb1_epoch ?
                        i_fp_cdb1_data : s3_data[sel_idx];
                    o_issue_fp_wen       = e_fp_wen[sel_idx];
                    o_issue_reg_wen      = e_reg_wen[sel_idx];
                    o_issue_fflags_valid = e_fflags_valid[sel_idx];
                    o_issue_rob          = e_rob[sel_idx];
                    o_issue_epoch        = e_epoch[sel_idx];
                    valid[sel_idx]       = 1'b0;
                } else {
                    o_issue_valid = 1'b0;
                }
            }

            // Dispatch: allocate new entry. Capture same-cycle CDB hits so
            // operands broadcast THIS cycle don't miss the wakeup pass above.
            if i_dispatch_valid && free_found {
                valid[free_idx]           = 1'b1;
                e_pc[free_idx]            = i_dispatch_pc;
                e_fpu_op[free_idx]        = i_dispatch_fpu_op;
                e_rm[free_idx]            = i_dispatch_rm;
                e_rd[free_idx]            = i_dispatch_rd;
                e_rs1[free_idx]           = i_dispatch_rs1;
                e_rs2[free_idx]           = i_dispatch_rs2;
                e_rs3[free_idx]           = i_dispatch_rs3;
                e_fp_wen[free_idx]        = i_dispatch_fp_wen;
                e_reg_wen[free_idx]       = i_dispatch_reg_wen;
                e_fflags_valid[free_idx]  = i_dispatch_fflags_valid;
                e_rob[free_idx]           = i_dispatch_rob;
                e_epoch[free_idx]         = i_dispatch_epoch;

                let s1_cdb0_hit: logic = !i_dispatch_s1_ready && i_fp_cdb0_valid
                    && i_dispatch_s1_tag == i_fp_cdb0_rob && i_dispatch_s1_epoch == i_fp_cdb0_epoch;
                let s1_cdb1_hit: logic = !i_dispatch_s1_ready && i_fp_cdb1_valid
                    && i_dispatch_s1_tag == i_fp_cdb1_rob && i_dispatch_s1_epoch == i_fp_cdb1_epoch;
                s1_ready[free_idx] = i_dispatch_s1_ready || s1_cdb0_hit || s1_cdb1_hit;
                s1_tag[free_idx]   = i_dispatch_s1_tag;
                s1_epoch[free_idx] = i_dispatch_s1_epoch;
                s1_data[free_idx]  = if s1_cdb0_hit ? i_fp_cdb0_data
                                   : if s1_cdb1_hit ? i_fp_cdb1_data
                                   : i_dispatch_s1_data;

                let s2_cdb0_hit: logic = !i_dispatch_s2_ready && i_fp_cdb0_valid
                    && i_dispatch_s2_tag == i_fp_cdb0_rob && i_dispatch_s2_epoch == i_fp_cdb0_epoch;
                let s2_cdb1_hit: logic = !i_dispatch_s2_ready && i_fp_cdb1_valid
                    && i_dispatch_s2_tag == i_fp_cdb1_rob && i_dispatch_s2_epoch == i_fp_cdb1_epoch;
                s2_ready[free_idx] = i_dispatch_s2_ready || s2_cdb0_hit || s2_cdb1_hit;
                s2_tag[free_idx]   = i_dispatch_s2_tag;
                s2_epoch[free_idx] = i_dispatch_s2_epoch;
                s2_data[free_idx]  = if s2_cdb0_hit ? i_fp_cdb0_data
                                   : if s2_cdb1_hit ? i_fp_cdb1_data
                                   : i_dispatch_s2_data;

                let s3_cdb0_hit: logic = !i_dispatch_s3_ready && i_fp_cdb0_valid
                    && i_dispatch_s3_tag == i_fp_cdb0_rob && i_dispatch_s3_epoch == i_fp_cdb0_epoch;
                let s3_cdb1_hit: logic = !i_dispatch_s3_ready && i_fp_cdb1_valid
                    && i_dispatch_s3_tag == i_fp_cdb1_rob && i_dispatch_s3_epoch == i_fp_cdb1_epoch;
                s3_ready[free_idx] = i_dispatch_s3_ready || s3_cdb0_hit || s3_cdb1_hit;
                s3_tag[free_idx]   = i_dispatch_s3_tag;
                s3_epoch[free_idx] = i_dispatch_s3_epoch;
                s3_data[free_idx]  = if s3_cdb0_hit ? i_fp_cdb0_data
                                   : if s3_cdb1_hit ? i_fp_cdb1_data
                                   : i_dispatch_s3_data;
            }

            // Squash overlay: invalidate entries whose ROB idx matches mask.
            if i_squash_valid {
                for i in 0..16{
                    if valid[i] && i_squash_mask[e_rob[i]] {
                        valid[i] = 1'b0;
                    }
                }
                // Suppress the just-issued entry if squashed.
                if sel_valid && i_squash_mask[e_rob[sel_idx]] {
                    o_issue_valid = 1'b0;
                }
            }
        }
    }
}
