// Phase 7 v4: Physical Register File (integer).
//
// 64 entries, 2 read ports, 1 write port (CDB). Reads return the
// registered value; same-cycle write-then-read forwarding is not
// needed in M1 because wakeup→issue→read is at least one cycle deep:
// a producer that writes on cycle N cannot be source-read until N+1.
//
// Reset state: PRF[0..31] = 0. The initial RAT maps arch r0..r31 to
// PRF[0..31]; rename never allocates a new pdst for rd=0 (so PRF[0]
// stays 0).
pub module prf_int #(
    param PRF_N: u32 = 64,
    param PRF_W: u32 = 6 ,
) (
    clk: input clock,
    rst: input reset,

    // Read ports
    i_rd1_pdst: input  logic<PRF_W>,
    o_rd1_data: output logic<64>   ,
    i_rd2_pdst: input  logic<PRF_W>,
    o_rd2_data: output logic<64>   ,
    // M6: 3rd read port — the integer source operand of an INT→FP op
    // (FMV.W.X / FMV.D.X / FCVT.{S,D}.{W,WU,L,LU}) issued from iq_fp.
    i_rd3_pdst: input  logic<PRF_W>,
    o_rd3_data: output logic<64>   ,
    // Phase 8 S3: pipe-1 (2nd integer issue) read ports — 5R total.
    i_rd4_pdst: input  logic<PRF_W>,
    o_rd4_data: output logic<64>   ,
    i_rd5_pdst: input  logic<PRF_W>,
    o_rd5_data: output logic<64>   ,
    // Phase 12 V0: 6th read port — the integer scalar operand of a vector op
    // (vadd.vx / vset*vl AVL) read by the vector unit at execute.
    i_rd6_pdst: input  logic<PRF_W>,
    o_rd6_data: output logic<64>   ,
    // Phase 12 V5h: 7th read port — the SECOND integer scalar of a vector op
    // (strided stride x[rs2]). Read combinationally at the ROB head, where the
    // producer has already committed (no wakeup needed, like the FP .vf scalar).
    i_rd7_pdst: input  logic<PRF_W>,
    o_rd7_data: output logic<64>   ,
    // Zacas: 8th read port — the OLD pdst of an amocas's rd (its compare/expected
    // value). Read combinationally at the ROB head, where the producer has
    // committed (like rd6/rd7), so no wakeup tracking is needed.
    i_rd8_pdst: input  logic<PRF_W>,
    o_rd8_data: output logic<64>   ,

    // Write port (CDB lane 0)
    i_wr_en  : input logic       ,
    i_wr_pdst: input logic<PRF_W>,
    i_wr_data: input logic<64>   ,
    // Phase 8 S3: CDB lane 1 (pipe-1) write port — 2W total. Each pdst has a
    // single producer so the two writes never target the same entry.
    i_wr_en2  : input logic       ,
    i_wr_pdst2: input logic<PRF_W>,
    i_wr_data2: input logic<64>   ,
    // Zacas amocas.q: two COMMIT-time write ports for the destination pair. At
    // amocas.q retire the loaded old 128-bit value is written into the (un-renamed)
    // pdsts of rd (lo) and rd+1 (hi) in place; a commit flush then makes them
    // visible to re-fetched readers. These target the OLD mappings (no in-flight
    // op produces them), so they never collide with the CDB write ports.
    i_wr_en3  : input logic       ,
    i_wr_pdst3: input logic<PRF_W>,
    i_wr_data3: input logic<64>   ,
    i_wr_en4  : input logic       ,
    i_wr_pdst4: input logic<PRF_W>,
    i_wr_data4: input logic<64>   ,
) {
    var prf: logic<64> [PRF_N];

    always_ff (clk, rst) {
        if_reset {
            for i in 0..PRF_N {
                prf[i] = 64'd0;
            }
        } else {
            // Dynamic-index writes (one write port per CDB/commit lane). PRF[0]
            // is the arch-zero hard tie; rename never allocates a write to it.
            // Each pdst has a single producer, so the four ports never collide.
            if i_wr_en {
                prf[i_wr_pdst] = i_wr_data;
            }
            // Phase 8 S3: CDB lane 1 write (pipe-1).
            if i_wr_en2 {
                prf[i_wr_pdst2] = i_wr_data2;
            }
            // Zacas amocas.q commit-time pair writeback (lo then hi). These target
            // the OLD mappings (rd / rd+1), disjoint from the CDB write ports.
            if i_wr_en3 {
                prf[i_wr_pdst3] = i_wr_data3;
            }
            if i_wr_en4 {
                prf[i_wr_pdst4] = i_wr_data4;
            }
        }
    }

    assign o_rd1_data = prf[i_rd1_pdst];
    assign o_rd2_data = prf[i_rd2_pdst];
    assign o_rd3_data = prf[i_rd3_pdst];
    assign o_rd4_data = prf[i_rd4_pdst];
    assign o_rd5_data = prf[i_rd5_pdst];
    assign o_rd6_data = prf[i_rd6_pdst];
    assign o_rd7_data = prf[i_rd7_pdst];
    assign o_rd8_data = prf[i_rd8_pdst];
}
