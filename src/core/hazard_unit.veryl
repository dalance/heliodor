// Hazard detection unit: scoreboard stall, FP RAW stall, branch/jump flush, trap/mret flush
pub module hazard_unit (
    // ID/EX stage (for FP load-use detection)
    i_idex_mem_ren   : input logic   ,
    i_idex_rd        : input logic<5>,
    i_idex_fp_reg_wen: input logic   , // FP register write in EX
    // Decode output (ID stage) — for FP RAW detection at the cycle boundary
    i_id_fp_reg_wen: input logic   , // decode output: FP register write
    i_id_rd        : input logic<5>, // decode output: destination register
    // EX/MEM stage (kept for FP MEM-stage detection)
    i_exmem_mem_ren   : input logic   ,
    i_exmem_rd        : input logic<5>,
    i_exmem_fp_reg_wen: input logic   , // FP register write in MEM
    // Separate MEM-stage FP write for FP RAW detection (fp regfile has
    // no EX/MEM bypass; must stall until the write reaches WB).
    i_mem_fp_reg_wen: input logic   ,
    i_mem_fp_rd     : input logic<5>,
    // IF/ID instruction fields (for FP hazard detection)
    i_ifid_rs1    : input logic<5>,
    i_ifid_rs2    : input logic<5>,
    i_ifid_fp_read: input logic   , // IF/ID instruction reads FP registers
    // Slot1 IF/ID fields (for dual-issue load-use detection)
    i_s1_ifid_rs1  : input logic<5>,
    i_s1_ifid_rs2  : input logic<5>,
    i_s1_ifid_valid: input logic   ,
    // Scoreboard-based stall (computed in heliodor_top with forwarding awareness)
    i_sb_stall: input logic,
    // Branch/jump resolved in EX
    i_branch_taken : input logic,
    i_misprediction: input logic,
    i_is_jal       : input logic,
    i_is_jalr      : input logic,
    // Trap/MRET
    i_trap_taken: input logic,
    i_mret_taken: input logic,
    // MMU stall
    i_mmu_stall: input logic,
    // Cache stalls
    i_icache_stall  : input logic,
    i_dcache_stall  : input logic,
    i_mshr_wb_stall : input logic, // MSHR writeback conflicts with normal WB
    // Control outputs
    o_stall_if : output logic,
    o_stall_id : output logic,
    o_stall_ex : output logic,
    o_stall_mem: output logic,
    o_flush_id : output logic,
    o_flush_ex : output logic,
    // Raw scoreboard stall (for bubble fill eligibility in top)
    o_load_use : output logic,
) {
    // Scoreboard stall replaces point-to-point load-use and mem_load_use checks.
    // The scoreboard tracks pending register writes (set on load issue, cleared
    // at WB) with forwarding-aware release (result in MEM advancing to WB).
    // This naturally handles both EX-stage and MEM-stage (dcache stall) cases.
    let load_use: logic = i_sb_stall;

    // FP RAW hazard: with EX/MEM and MEM/WB forwarding, only the ID-stage
    // producer (1 cycle ahead, not yet in EX) and FP load-use (EX has load,
    // data not available until MEM) still require stalls.
    let fp_id_hazard : logic = i_id_fp_reg_wen && i_ifid_fp_read && (i_id_rd == i_ifid_rs1 || i_id_rd == i_ifid_rs2);
    // FP load-use: EX has FP load (mem_ren + fp_reg_wen), consumer in IF/ID
    let fp_load_use  : logic = i_idex_fp_reg_wen && i_idex_mem_ren && i_ifid_fp_read && (i_idex_rd == i_ifid_rs1 || i_idex_rd == i_ifid_rs2);
    let fp_hazard    : logic = fp_id_hazard || fp_load_use;

    // Flush on misprediction only (not on every taken branch).
    // With branch prediction, a correctly predicted taken branch does
    // NOT need a flush — the pipeline already fetched the target.
    let branch_flush: logic = i_misprediction;

    // Trap/MRET override stalls: when redirecting PC, must not stall
    let redirect: logic = branch_flush || i_trap_taken || i_mret_taken;

    // Cache stall: I-cache, D-cache, or MSHR WB conflict
    let cache_stall: logic = i_icache_stall || i_dcache_stall || i_mshr_wb_stall;

    // D-cache / MMU stall must hold EX and MEM regardless of redirect.
    // A branch/jump in EX must wait for the dcache/MMU to complete
    // before the pipeline can flush and redirect.
    let redirect_ok: logic = redirect && !i_dcache_stall && !i_mmu_stall;

    // Traps can always redirect IF, even when DMMU/dcache is busy.
    // Without this, an IMMU page fault deadlocks: the trap can't redirect
    // the PC because DMMU stall blocks redirect_ok, but DMMU can't complete
    // because the pipeline is stuck waiting for the trap to resolve.
    // The trap redirects IF and flushes ID; EX/MEM stay stalled until the
    // DMMU operation completes and drains normally.
    let trap_redirect: logic = i_trap_taken || i_mret_taken;

    // Combined stall: scoreboard stall OR fp_hazard
    let any_load_use: logic = load_use || fp_hazard;

    // Expose scoreboard stall for bubble fill eligibility check in top
    assign o_load_use = load_use;

    // Stall IF: traps can always override (even during DMMU/dcache busy)
    assign o_stall_if = (any_load_use || i_mmu_stall || cache_stall) && !redirect_ok && !trap_redirect;
    // Stall ID: same as IF — trap clears stall so IF/ID register can accept the flush
    assign o_stall_id = (any_load_use || i_mmu_stall || cache_stall) && !redirect_ok && !trap_redirect;
    // MMU stall must also hold EX and MEM: memory module's dmem port is
    // combinational from EX/MEM pipeline register, so if EX advances
    // during PTW, the store/load request disappears.
    // Traps do NOT override EX/MEM stall — the pending memory operation
    // must complete before the pipeline can drain.
    assign o_stall_ex  = (cache_stall || i_mmu_stall) && !redirect_ok;
    assign o_stall_mem = (cache_stall || i_mmu_stall) && !redirect_ok;

    // Flush decode (ID/EX gets bubble): on redirect, trap, scoreboard stall, or fp_hazard.
    // Only flush when EX is NOT stalled — otherwise the instruction in
    // ID/EX cannot advance to EX/MEM and flushing would destroy it.
    let ex_stall       : logic = (cache_stall || i_mmu_stall) && !redirect_ok;
    let ex_hazard_flush: logic = any_load_use && !ex_stall;
    assign o_flush_id      = redirect_ok || trap_redirect || ex_hazard_flush;
    // Flush EX (EX/MEM gets bubble): on trap/mret unconditionally.
    // Must NOT gate on dcache_stall: if a trap fires during a dcache miss,
    // the stale instruction in EX/MEM would survive the trap, advance to WB
    // after the stall releases, and get committed — causing double-execution
    // with corrupted register values (mepc re-executes the same instruction).
    assign o_flush_ex = i_trap_taken || i_mret_taken;
}
