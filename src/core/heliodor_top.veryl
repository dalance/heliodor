// Heliodor top-level SoC wrapper.
//
// Wraps a single heliodor_core (CPU + private icache/dcache + per-hart MMU)
// together with one CLINT, one PLIC and one UART. The pre-Phase-4 build had
// these peripherals inside heliodor_top itself; the Phase 4 split moves them
// up to this SoC layer so a future multi-hart variant (heliodor_soc) can
// share the same set of peripherals across multiple cores.
//
// External I/O (memory + UART + ext-IRQ + debug) is identical to the prior
// heliodor_top so existing testbenches keep working unchanged.
pub module heliodor_top #(
    param DEBUG   : bit = 1,
    param RESET_PC: u64 = 0,
    param HART_ID : u8  = 0,
) (
    clk: input clock,
    rst: input reset,
    // Instruction memory interface (read-only, 32-bit for icache fill)
    o_imem_addr : output logic<64>,
    i_imem_rdata: input  logic<32>,
    o_imem_ren  : output logic    ,
    // Instruction PTW memory interface (64-bit, for page table walks)
    o_iptw_addr : output logic<64>,
    o_iptw_req  : output logic    ,
    i_iptw_rdata: input  logic<64>,
    // Data memory interface
    o_dmem_addr : output logic<64>,
    o_dmem_wdata: output logic<64>,
    i_dmem_rdata: input  logic<64>,
    o_dmem_wen  : output logic    ,
    o_dmem_ren  : output logic    ,
    o_dmem_wstrb: output logic<8> ,
    // Debug port
    o_dbg_regs: output logic<64> [32],
    o_dbg_pc  : output logic<64>     ,
    o_dbg_pass: output logic         ,
    o_dbg_r1  : output logic<64>     ,
    o_dbg_r2  : output logic<64>     ,
    o_dbg_r3  : output logic<64>     ,
    // External interrupt sources (directly from peripherals to PLIC)
    i_ext_irq: input logic<32>,
    // UART TX output
    o_uart_tx  : output logic   ,
    o_uart_data: output logic<8>,
    // UART RX input
    i_uart_rx_data : input logic<8>,
    i_uart_rx_valid: input logic   ,
    // Debug: internal stall signals
    o_dbg_stall: output logic<8>,
    // Debug: instruction retirement (high for one cycle per retired insn)
    o_dbg_instret: output logic,
    // Debug: branch prediction trace
    o_dbg_bp_predict: output logic    , // IF predicted taken
    o_dbg_bp_mispred: output logic    , // EX misprediction
    o_dbg_bp_taken  : output logic    , // EX actual taken
    o_dbg_bp_ex_pc  : output logic<64>, // EX stage PC (branch/jump PC)
    o_dbg_bp_target : output logic<64>, // EX actual target
    // Debug: trap trace
    o_dbg_trap_taken: output logic    ,
    o_dbg_trap_cause: output logic<64>,
    o_dbg_trap_pc   : output logic<64>, // mepc/sepc value
    // Debug: LQ-4.4-b observation
    o_dbg_lq_issue_cnt: output logic<32>,
    o_dbg_lq_alloc_cnt: output logic<32>,
    o_dbg_lq_mshr_cnt : output logic<32>,
    // Debug: SRS-2 observation
    o_dbg_srs_disp_cnt : output logic<32>,
    o_dbg_srs_issue_cnt: output logic<32>,
    o_dbg_srs_drop_cnt : output logic<32>,
    // Debug: P3.3-b SB forwarding shadow validation
    o_dbg_sb_fwd_hit_cnt               : output logic<32>,
    o_dbg_sb_fwd_partial_cnt           : output logic<32>,
    o_dbg_sb_fwd_mismatch_cnt          : output logic<32>,
    o_dbg_srs_load_drain_unresolved_cnt: output logic<32>,
    o_dbg_p34_spec_violation_cnt       : output logic<32>,
    // F0: dual issue rate observation
    o_dbg_dual_fetch_cnt: output logic<32>,
    o_dbg_dual_issue_cnt: output logic<32>,
    // Debug: per-cause stall breakdown (active when stall_id fires)
    o_dbg_stall_cause_load_use    : output logic,
    o_dbg_stall_cause_mmu         : output logic,
    o_dbg_stall_cause_cache       : output logic,
    o_dbg_stall_cause_rs          : output logic,
    o_dbg_stall_cause_rob_full    : output logic,
    o_dbg_stall_cause_rs_full_int : output logic,
    o_dbg_stall_cause_rs_full_fp  : output logic,
    o_dbg_stall_cause_direct_stall: output logic,
    o_dbg_stall_cause_irq_wait    : output logic,
    o_dbg_stall_ds_operand        : output logic,
    o_dbg_stall_ds_op_load        : output logic,
    o_dbg_stall_ds_op_store       : output logic,
    o_dbg_stall_ds_op_bj          : output logic,
    o_dbg_stall_ds_rs_yield       : output logic,
    o_dbg_stall_ds_rob_full       : output logic,
    o_dbg_stall_ds_drain          : output logic,
    o_dbg_mispred_branch          : output logic,
    o_dbg_mispred_jalr            : output logic,
    o_dbg_mispred_jal             : output logic,
    o_dbg_flush_trap              : output logic,
    o_dbg_mispred_jalr_return     : output logic,
    o_dbg_mispred_jalr_indirect   : output logic,
    o_dbg_if_return_count         : output logic,
    o_dbg_ras_used                : output logic,
    o_dbg_ras_push                : output logic,
    o_dbg_ras_pop                 : output logic,
    // Phase 7 v4 cosim: retire-PC stream (passthrough from core).
    o_dbg_retire_v_a   : output logic    ,
    o_dbg_retire_pc_a  : output logic<64>,
    o_dbg_retire_rd_v_a: output logic    ,
    o_dbg_retire_rd_a  : output logic<5> ,
    o_dbg_retire_data_a: output logic<64>,
) {
    // ============================================================
    // Internal SoC-side wires
    // ============================================================
    // Per-hart interrupt arrays from peripherals (single hart here → [1]).
    var timer_irq_arr : logic     [1];
    var sw_irq_arr    : logic     [1];
    var plic_irq_m_arr: logic     [1];
    var plic_irq_s_arr: logic     [1];
    var mtime_val     : logic<64>    ;
    var uart_irq      : logic        ;

    // Peripheral rdata
    var clint_rdata: logic<64>;
    var plic_rdata : logic<64>;
    var uart_rdata : logic<8> ;

    // MMIO bus driven by the core
    var core_mmio_paddr  : logic<32>;
    var core_mmio_wdata  : logic<64>;
    var core_mmio_wstrb  : logic<8> ;
    var core_mmio_wen    : logic    ;
    var core_mmio_ren    : logic    ;
    var core_stall_mem   : logic    ;
    var core_clint_sel   : logic    ;
    var core_plic_sel    : logic    ;
    var core_uart_sel    : logic    ;
    var core_uart_irq_req: logic    ; // currently unused

    // ============================================================
    // Heliodor core (CPU + caches + MMU)
    // ============================================================
    inst u_core: heliodor_core #(
        DEBUG   : DEBUG   ,
        RESET_PC: RESET_PC,
        HART_ID : HART_ID ,
    ) (
        clk                                  ,
        rst                                  ,
        o_imem_addr       : o_imem_addr      ,
        i_imem_rdata      : i_imem_rdata     ,
        o_imem_ren        : o_imem_ren       ,
        o_iptw_addr       : o_iptw_addr      ,
        o_iptw_req        : o_iptw_req       ,
        i_iptw_rdata      : i_iptw_rdata     ,
        o_dmem_addr       : o_dmem_addr      ,
        o_dmem_wdata      : o_dmem_wdata     ,
        i_dmem_rdata      : i_dmem_rdata     ,
        o_dmem_wen        : o_dmem_wen       ,
        o_dmem_ren        : o_dmem_ren       ,
        o_dmem_wstrb      : o_dmem_wstrb     ,
        o_mmio_paddr      : core_mmio_paddr  ,
        o_mmio_wdata      : core_mmio_wdata  ,
        o_mmio_wstrb      : core_mmio_wstrb  ,
        o_mmio_wen        : core_mmio_wen    ,
        o_mmio_ren        : core_mmio_ren    ,
        o_stall_mem       : core_stall_mem   ,
        o_clint_sel       : core_clint_sel   ,
        o_plic_sel        : core_plic_sel    ,
        o_uart_sel        : core_uart_sel    ,
        i_clint_rdata     : clint_rdata      ,
        i_plic_rdata      : plic_rdata       ,
        i_uart_rdata      : uart_rdata       ,
        i_timer_irq       : timer_irq_arr[0] ,
        i_sw_irq          : sw_irq_arr[0]    ,
        i_plic_irq_m      : plic_irq_m_arr[0],
        i_plic_irq_s      : plic_irq_s_arr[0],
        i_mtime           : mtime_val        ,
        i_dcache_inv_valid: 1'b0             ,
        i_dcache_inv_addr : 64'd0            ,
        // Phase 5: 1-hart configuration always wins the bus.
        i_dmem_grant                       : 1'b1                               ,
        i_mmio_grant                       : 1'b1                               ,
        o_uart_irq_req                     : core_uart_irq_req                  ,
        o_dbg_regs                         : o_dbg_regs                         ,
        o_dbg_pc                           : o_dbg_pc                           ,
        o_dbg_pass                         : o_dbg_pass                         ,
        o_dbg_r1                           : o_dbg_r1                           ,
        o_dbg_r2                           : o_dbg_r2                           ,
        o_dbg_r3                           : o_dbg_r3                           ,
        o_dbg_stall                        : o_dbg_stall                        ,
        o_dbg_instret                      : o_dbg_instret                      ,
        o_dbg_bp_predict                   : o_dbg_bp_predict                   ,
        o_dbg_bp_mispred                   : o_dbg_bp_mispred                   ,
        o_dbg_bp_taken                     : o_dbg_bp_taken                     ,
        o_dbg_bp_ex_pc                     : o_dbg_bp_ex_pc                     ,
        o_dbg_bp_target                    : o_dbg_bp_target                    ,
        o_dbg_trap_taken                   : o_dbg_trap_taken                   ,
        o_dbg_trap_cause                   : o_dbg_trap_cause                   ,
        o_dbg_trap_pc                      : o_dbg_trap_pc                      ,
        o_dbg_lq_issue_cnt                 : o_dbg_lq_issue_cnt                 ,
        o_dbg_lq_alloc_cnt                 : o_dbg_lq_alloc_cnt                 ,
        o_dbg_lq_mshr_cnt                  : o_dbg_lq_mshr_cnt                  ,
        o_dbg_srs_disp_cnt                 : o_dbg_srs_disp_cnt                 ,
        o_dbg_srs_issue_cnt                : o_dbg_srs_issue_cnt                ,
        o_dbg_srs_drop_cnt                 : o_dbg_srs_drop_cnt                 ,
        o_dbg_sb_fwd_hit_cnt               : o_dbg_sb_fwd_hit_cnt               ,
        o_dbg_sb_fwd_partial_cnt           : o_dbg_sb_fwd_partial_cnt           ,
        o_dbg_sb_fwd_mismatch_cnt          : o_dbg_sb_fwd_mismatch_cnt          ,
        o_dbg_srs_load_drain_unresolved_cnt: o_dbg_srs_load_drain_unresolved_cnt,
        o_dbg_p34_spec_violation_cnt       : o_dbg_p34_spec_violation_cnt       ,
        o_dbg_dual_fetch_cnt               : o_dbg_dual_fetch_cnt               ,
        o_dbg_dual_issue_cnt               : o_dbg_dual_issue_cnt               ,
        o_dbg_stall_cause_load_use         : o_dbg_stall_cause_load_use         ,
        o_dbg_stall_cause_mmu              : o_dbg_stall_cause_mmu              ,
        o_dbg_stall_cause_cache            : o_dbg_stall_cause_cache            ,
        o_dbg_stall_cause_rs               : o_dbg_stall_cause_rs               ,
        o_dbg_stall_cause_rob_full         : o_dbg_stall_cause_rob_full         ,
        o_dbg_stall_cause_rs_full_int      : o_dbg_stall_cause_rs_full_int      ,
        o_dbg_stall_cause_rs_full_fp       : o_dbg_stall_cause_rs_full_fp       ,
        o_dbg_stall_cause_direct_stall     : o_dbg_stall_cause_direct_stall     ,
        o_dbg_stall_cause_irq_wait         : o_dbg_stall_cause_irq_wait         ,
        o_dbg_stall_ds_operand             : o_dbg_stall_ds_operand             ,
        o_dbg_stall_ds_op_load             : o_dbg_stall_ds_op_load             ,
        o_dbg_stall_ds_op_store            : o_dbg_stall_ds_op_store            ,
        o_dbg_stall_ds_op_bj               : o_dbg_stall_ds_op_bj               ,
        o_dbg_stall_ds_rs_yield            : o_dbg_stall_ds_rs_yield            ,
        o_dbg_stall_ds_rob_full            : o_dbg_stall_ds_rob_full            ,
        o_dbg_stall_ds_drain               : o_dbg_stall_ds_drain               ,
        o_dbg_mispred_branch               : o_dbg_mispred_branch               ,
        o_dbg_mispred_jalr                 : o_dbg_mispred_jalr                 ,
        o_dbg_mispred_jal                  : o_dbg_mispred_jal                  ,
        o_dbg_flush_trap                   : o_dbg_flush_trap                   ,
        o_dbg_mispred_jalr_return          : o_dbg_mispred_jalr_return          ,
        o_dbg_mispred_jalr_indirect        : o_dbg_mispred_jalr_indirect        ,
        o_dbg_if_return_count              : o_dbg_if_return_count              ,
        o_dbg_ras_used                     : o_dbg_ras_used                     ,
        o_dbg_ras_push                     : o_dbg_ras_push                     ,
        o_dbg_ras_pop                      : o_dbg_ras_pop                      ,
        o_dbg_retire_v_a                   : o_dbg_retire_v_a                   ,
        o_dbg_retire_pc_a                  : o_dbg_retire_pc_a                  ,
        o_dbg_retire_rd_v_a                : o_dbg_retire_rd_v_a                ,
        o_dbg_retire_rd_a                  : o_dbg_retire_rd_a                  ,
        o_dbg_retire_data_a                : o_dbg_retire_data_a                ,
    );

    // ============================================================
    // CLINT (single shared instance, addr 0x02000000)
    // ============================================================
    inst u_clint: clint #(
        N_HARTS: 1,
    ) (
        clk                                                            ,
        rst                                                            ,
        i_addr     : core_mmio_paddr[15:0]                             ,
        i_wdata    : core_mmio_wdata                                   ,
        i_wen      : core_mmio_wen && core_clint_sel && !core_stall_mem,
        i_ren      : core_mmio_ren && core_clint_sel,
        o_rdata    : clint_rdata                                       ,
        o_timer_irq: timer_irq_arr                                     ,
        o_sw_irq   : sw_irq_arr                                        ,
        o_mtime    : mtime_val                                         ,
    );

    // ============================================================
    // PLIC (single shared instance, addr 0x0C000000)
    // ============================================================
    inst u_plic: plic #(
        N_HARTS: 1,
    ) (
        clk                                                       ,
        rst                                                       ,
        i_src  : i_ext_irq | {21'd0, uart_irq, 10'd0},
        i_addr : core_mmio_paddr[23:0]                            ,
        i_wdata: core_mmio_wdata                                  ,
        i_wen  : core_mmio_wen && core_plic_sel && !core_stall_mem,
        i_ren  : core_mmio_ren && core_plic_sel,
        o_rdata: plic_rdata                                       ,
        o_irq_m: plic_irq_m_arr                                   ,
        o_irq_s: plic_irq_s_arr                                   ,
    );

    // ============================================================
    // UART (single shared instance, addr 0x10000000)
    // ============================================================
    inst u_uart: uart (
        clk                                                          ,
        rst                                                          ,
        i_addr    : core_mmio_paddr[2:0]                             ,
        i_wdata   : core_mmio_wdata[7:0]                             ,
        i_wen     : core_mmio_wen && core_uart_sel && !core_stall_mem,
        i_ren     : core_mmio_ren && core_uart_sel && !core_stall_mem,
        o_rdata   : uart_rdata                                       ,
        o_tx_valid: o_uart_tx                                        ,
        o_tx_data : o_uart_data                                      ,
        i_rx_data : i_uart_rx_data                                   ,
        i_rx_valid: i_uart_rx_valid                                  ,
        o_irq     : uart_irq                                         ,
    );
}
