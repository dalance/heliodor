// fu_bru: conditional branches, JAL, JALR and AUIPC; the resolve record of
// every op it runs.
//
// Ports (timing contract):
//   i_valid/i_op/i_tag/i_src : the op accepted in cycle A (rs1, rs2)
//   i_imm                    : sign-extended immediate
//   i_pc                     : the op's PC, read from the FTQ by its (ftq, foff)
//   i_pred_target            : the predicted target of the op's fetch block
//   i_pred_taken             : this op is its block's predicted taken exit
//   i_rvc/i_ftq/i_foff       : length and fetch position of the op
//   i_kill                   : applied when the result is captured
//   o_ready                  : constant 1 (pipelined)
//   o_wb                     : registered, valid in A + LAT_BRU; data is the
//                              link (pc + 2 or 4) or AUIPC's pc + imm; br is
//                              always valid, with next_pc = pc + len when not
//                              taken (AUIPC is never taken)
// Owns:
//   - br.mispred is "predicted next PC != resolved next PC":
//     taken != pred_taken || (taken && target != pred_target)
// Rationale:
//   - commit derives the next PC of every BRU op from its resolve record, so
//     AUIPC writes one too
//   - AUIPC and JAL run here because only BRU ports read the PC; a JAL is
//     resolved like a branch, since one straddling a fetch block can be
//     mispredicted
//   - no target-misaligned exception exists with the C extension
pub module fu_bru::<CFG: core_cfg> (
    clk          : input  clock                                                     ,
    rst          : input  reset                                                     ,
    i_valid      : input  logic                                                     ,
    i_op         : input  opclass_pkg::BruOp                                        ,
    i_tag        : input  core_types::<CFG>::ExTag                                  ,
    i_src        : input  logic                      <64>                        [2],
    i_imm        : input  logic                      <64>                           ,
    i_pc         : input  logic                      <64>                           ,
    i_pred_target: input  logic                      <64>                           ,
    i_pred_taken : input  logic                                                     ,
    i_rvc        : input  logic                                                     ,
    i_ftq        : input  core_types::<CFG>::FtqTag                                 ,
    i_foff       : input  logic                      <core_types::<CFG>::FOFF_W>    ,
    i_kill       : input  core_types::<CFG>::Kill                                   ,
    o_ready      : output logic                                                     ,
    o_wb         : output core_types::<CFG>::WbPacket                               ,
) {
    import core_types::<CFG>::*;
    import opclass_pkg::BruOp;

    let a: logic<64> = i_src[0];
    let b: logic<64> = i_src[1];

    let eq : logic = a == b;
    let lt : logic = $signed(a) <: $signed(b);
    let ltu: logic = a <: b;

    let is_ctrl: logic = i_op != BruOp::AUIPC;
    let cond   : logic = case i_op {
        BruOp::BEQ : eq,
        BruOp::BNE : !eq,
        BruOp::BLT : lt,
        BruOp::BGE : !lt,
        BruOp::BLTU: ltu,
        BruOp::BGEU: !ltu,
        default    : 1'b1, // JAL, JALR
    };

    let pc_imm : logic<64> = i_pc + i_imm;
    let next_sq: logic<64> = i_pc + (if i_rvc ? 64'd2 : 64'd4);
    let target : logic<64> = if i_op == BruOp::JALR ? ((a + i_imm) & ~64'd1) : pc_imm;
    let taken  : logic     = is_ctrl && cond;

    var pkt: WbPacket;
    always_comb {
        pkt            = 0 as WbPacket;
        pkt.valid      = 1'b1;
        pkt.tag        = i_tag;
        pkt.data       = if is_ctrl ? next_sq : pc_imm;
        pkt.br.valid   = 1'b1;
        pkt.br.taken   = taken;
        pkt.br.next_pc = if taken ? target : next_sq;
        pkt.br.mispred = taken != i_pred_taken || (taken && target != i_pred_target);
        pkt.br.ftq     = i_ftq;
        pkt.br.foff    = i_foff;
    }

    var wb_v: logic   ;
    var wb_d: WbPacket;
    inst u_out: stage_reg::<CFG> #(
        T: WbPacket,
    ) (
        clk               ,
        rst               ,
        i_valid: i_valid  ,
        i_data : pkt      ,
        i_tag  : i_tag.rob,
        i_kill            ,
        o_valid: wb_v     ,
        o_data : wb_d     ,
    );

    always_comb {
        o_wb       = wb_d;
        o_wb.valid = wb_v;
    }
    assign o_ready = 1'b1;
}
