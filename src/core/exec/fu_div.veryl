/// Integer divide and remainder (DIV[U][W], REM[U][W]), blocking.
///
/// # Owns
///
/// - the result goes to the tag latched at accept and at most one divide is
///   in flight (fu_blocking_shell); the leaf is aborted by the kill that
///   drops the latched op
pub module fu_div::<CFG: core_cfg> (
    clk       : input  clock                              ,
    rst       : input  reset                              ,
    /// The op accepted in cycle A (rs1, rs2); issued
    /// only while o_ready
    i_valid   : input  logic                              ,
    /// See i_valid.
    i_op      : input  alu_pkg::AluOp                     ,
    /// See i_valid.
    i_tag     : input  core_types::<CFG>::ExTag           ,
    /// See i_valid.
    i_src     : input  logic                      <64> [2],
    /// Drops the op in any cycle up to its WB
    i_kill    : input  core_types::<CFG>::Kill            ,
    /// Registered, fu_blocking_shell
    o_ready   : output logic                              ,
    /// The result is ready, at the earliest in
    /// A + LAT_DIV - WAKE_LEAD (the hole-fill grant is
    /// at least WAKE_LEAD cycles ahead)
    o_hf_req  : output logic                              ,
    /// See o_hf_req.
    o_hf_tag  : output core_types::<CFG>::ExTag           ,
    /// The hole-fill grant of o_hf_req
    i_wb_grant: input  fu_pkg::WbSlot                     ,
    /// Registered, in the granted slot; LAT_DIV is the
    /// minimum A to WB distance
    o_wb      : output core_types::<CFG>::WbPacket        ,
) {
    var start     : logic    ;
    var flush     : logic    ;
    var leaf_valid: logic    ;
    var leaf_data : logic<64>;

    inst u_shell: fu_blocking_shell::<CFG> (
        clk                      ,
        rst                      ,
        i_valid                  ,
        i_tag                    ,
        i_kill                   ,
        o_ready                  ,
        o_start      : start     ,
        o_flush      : flush     ,
        i_leaf_valid : leaf_valid,
        i_leaf_data  : leaf_data ,
        i_leaf_fflags: 5'b0      ,
        o_hf_req                 ,
        o_hf_tag                 ,
        i_wb_grant               ,
        o_wb                     ,
        o_wake       : _         ,
    );

    inst u_leaf: int_divider (
        clk                 ,
        rst                 ,
        i_valid : start     ,
        i_alu_op: i_op      ,
        i_a     : i_src[0]  ,
        i_b     : i_src[1]  ,
        i_flush : flush     ,
        o_result: leaf_data ,
        o_valid : leaf_valid,
        o_busy  : _         ,
    );
}
