// fu_div: integer divide and remainder (DIV[U][W], REM[U][W]), blocking.
//
// Ports (timing contract):
//   i_valid/i_op/i_tag/i_src : the op accepted in cycle A (rs1, rs2); issued
//                              only while o_ready
//   o_ready                  : registered, fu_blocking_shell
//   o_hf_req/o_hf_tag        : the result is ready, A + 34 at the earliest
//   i_wb_grant               : the hole-fill grant of o_hf_req
//   i_kill                   : drops the op in any cycle up to its WB
//   o_wb                     : registered, in the granted slot; LAT_DIV is the
//                              minimum A to WB distance
// Owns:
//   - see fu_blocking_shell
pub module fu_div::<CFG: core_cfg> (
    clk       : input  clock                              ,
    rst       : input  reset                              ,
    i_valid   : input  logic                              ,
    i_op      : input  alu_pkg::AluOp                     ,
    i_tag     : input  core_types::<CFG>::ExTag           ,
    i_src     : input  logic                      <64> [2],
    i_kill    : input  core_types::<CFG>::Kill            ,
    o_ready   : output logic                              ,
    o_hf_req  : output logic                              ,
    o_hf_tag  : output core_types::<CFG>::ExTag           ,
    i_wb_grant: input  fu_pkg::WbSlot                     ,
    o_wb      : output core_types::<CFG>::WbPacket        ,
) {
    var start     : logic    ;
    var flush     : logic    ;
    var leaf_valid: logic    ;
    var leaf_data : logic<64>;

    inst u_shell: fu_blocking_shell::<CFG> (
        clk                      ,
        rst                      ,
        i_valid                  ,
        i_tag                    ,
        i_kill                   ,
        o_ready                  ,
        o_start      : start     ,
        o_flush      : flush     ,
        i_leaf_valid : leaf_valid,
        i_leaf_data  : leaf_data ,
        i_leaf_fflags: 5'b0      ,
        o_hf_req                 ,
        o_hf_tag                 ,
        i_wb_grant               ,
        o_wb                     ,
    );

    inst u_leaf: int_divider (
        clk                 ,
        rst                 ,
        i_valid : start     ,
        i_alu_op: i_op      ,
        i_a     : i_src[0]  ,
        i_b     : i_src[1]  ,
        i_flush : flush     ,
        o_result: leaf_data ,
        o_valid : leaf_valid,
        o_busy  : _         ,
    );
}
