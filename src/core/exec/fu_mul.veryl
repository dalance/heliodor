// fu_mul: integer multiplier (MUL, MULH, MULHSU, MULHU, MULW), two stages.
//
// Ports (timing contract):
//   i_valid/i_op/i_tag/i_src : the op accepted in cycle A (rs1, rs2)
//   i_kill                   : applied at the capture edge of both stages
//   o_ready                  : constant 1 (pipelined)
//   o_wb                     : registered, valid in A + LAT_MUL
// Owns:
//   - o_wb.tag is i_tag of the same op
// Rationale:
//   - stage 1 forms the four 32x32 partial products, stage 2 sums them and
//     applies the high-half sign corrections and the W extension
pub module fu_mul::<CFG: core_cfg> (
    clk    : input  clock                              ,
    rst    : input  reset                              ,
    i_valid: input  logic                              ,
    i_op   : input  alu_pkg::AluOp                     ,
    i_tag  : input  core_types::<CFG>::ExTag           ,
    i_src  : input  logic                      <64> [2],
    i_kill : input  core_types::<CFG>::Kill            ,
    o_ready: output logic                              ,
    o_wb   : output core_types::<CFG>::WbPacket        ,
) {
    import core_types::<CFG>::*;
    import alu_pkg::AluOp;

    struct Partial {
        tag  : ExTag    ,
        op   : AluOp    ,
        pp_ll: logic<64>,
        pp_lh: logic<64>,
        pp_hl: logic<64>,
        pp_hh: logic<64>,
        adj_a: logic<64>, // rs1 negative: subtract rs2 from the high half
        adj_b: logic<64>, // rs2 negative: subtract rs1 from the high half
    }

    let a: logic<64> = i_src[0];
    let b: logic<64> = i_src[1];

    var s1_in: Partial;
    always_comb {
        s1_in.tag   = i_tag;
        s1_in.op    = i_op;
        s1_in.pp_ll = {32'b0, a[31:0]} * {32'b0, b[31:0]};
        s1_in.pp_lh = {32'b0, a[31:0]} * {32'b0, b[63:32]};
        s1_in.pp_hl = {32'b0, a[63:32]} * {32'b0, b[31:0]};
        s1_in.pp_hh = {32'b0, a[63:32]} * {32'b0, b[63:32]};
        s1_in.adj_a = {a[63] repeat 64} & b;
        s1_in.adj_b = {b[63] repeat 64} & a;
    }

    var s1_v: logic  ;
    var s1  : Partial;
    inst u_s1: stage_reg::<CFG> #(
        T: Partial,
    ) (
        clk               ,
        rst               ,
        i_valid: i_valid  ,
        i_data : s1_in    ,
        i_tag  : i_tag.rob,
        i_kill            ,
        o_valid: s1_v     ,
        o_data : s1       ,
    );

    let mid_v : logic<64> = s1.pp_lh + s1.pp_hl;
    let mid_of: logic<64> = if mid_v <: s1.pp_lh ? 64'h0000_0001_0000_0000 : 64'd0;
    let lo_v  : logic<64> = s1.pp_ll + (mid_v << 32);
    let lo_of : logic<64> = if lo_v <: s1.pp_ll ? 64'd1 : 64'd0;
    let hi_u  : logic<64> = s1.pp_hh + (mid_v >> 32) + mid_of + lo_of;

    var pkt: WbPacket;
    always_comb {
        pkt       = 0 as WbPacket;
        pkt.valid = 1'b1;
        pkt.tag   = s1.tag;
        case s1.op {
            AluOp::MULH  : pkt.data = hi_u - s1.adj_a - s1.adj_b;
            AluOp::MULHSU: pkt.data = hi_u - s1.adj_a;
            AluOp::MULHU : pkt.data = hi_u;
            AluOp::MULW  : pkt.data = {s1.pp_ll[31] repeat 32, s1.pp_ll[31:0]};
            default      : pkt.data = lo_v;
        }
    }

    var wb_v: logic   ;
    var wb_d: WbPacket;
    inst u_out: stage_reg::<CFG> #(
        T: WbPacket,
    ) (
        clk                ,
        rst                ,
        i_valid: s1_v      ,
        i_data : pkt       ,
        i_tag  : s1.tag.rob,
        i_kill             ,
        o_valid: wb_v      ,
        o_data : wb_d      ,
    );

    always_comb {
        o_wb       = wb_d;
        o_wb.valid = wb_v;
    }
    assign o_ready = 1'b1;
}
