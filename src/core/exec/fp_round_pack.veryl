// fp_round_pack: rounds a nonzero finite magnitude to a binary format with
// EW exponent bits and MW fraction bits, combinational.
//
// Ports (timing contract):
//   i_sign/i_exp/i_sig : the value (-1)^sign * i_sig * 2^(i_exp - 63);
//                        i_sig[63] is set, i_exp is two's complement
//   i_rm               : resolved rounding mode
//   o_bits             : {sign, exponent, fraction} of the rounded result,
//                        overflowing to infinity or the largest finite value
//                        as the rounding mode directs
//   o_of/o_uf/o_nx     : overflow, underflow, inexact
// Owns:
//   - tininess is detected after rounding: a value below the smallest
//     normal that rounds to it at full precision does not raise UF
pub module fp_round_pack #(
    param EW: u32 = 8 ,
    param MW: u32 = 23,
) (
    i_sign: input  logic             ,
    i_exp : input  logic<14>         ,
    i_sig : input  logic<64>         ,
    i_rm  : input  logic<3>          ,
    o_bits: output logic<1 + EW + MW>,
    o_of  : output logic             ,
    o_uf  : output logic             ,
    o_nx  : output logic             ,
) {
    import fpu_pkg::round_up;

    const BIAS  : u32 = (1 << (EW - 1)) - 1;
    const EALL  : u32 = (1 << EW) - 1;
    const MANT_W: u32 = MW + 2;

    // Biased exponent; zero or negative selects the subnormal range.
    let te  : logic<14> = i_exp + BIAS;
    let tiny: logic     = te[13] || te == 0;

    // Subnormals shift right until the exponent reaches the minimum; 64 or
    // more leaves only sticky bits.
    let ts   : logic<14>     = 14'd1 - te;
    let sh   : logic<7>      = if !tiny ? 7'd0 : if ts >: 14'd64 ? 7'd64 : ts[6:0];
    let wide : logic<128>    = {i_sig, 64'd0} >> sh;
    let s    : logic<64>     = wide[127:64];
    let lost : logic         = wide[63:0] != 64'd0;
    let kept : logic<MW + 1> = s[63:63 - MW];
    let g    : logic         = s[62 - MW];
    let st   : logic         = s[61 - MW:0] != 0 || lost;
    let ru   : logic         = round_up(i_rm, i_sign, g, st, kept[0]);
    let mant : logic<MANT_W> = {1'b0, kept} + (ru as MANT_W);
    let carry: logic         = mant[MW + 1];

    // The same value rounded with an unbounded exponent range: only a carry
    // out of the top of a full-width significand reaches the next binade.
    let kept0: logic<MW + 1> = i_sig[63:63 - MW];
    let ru0  : logic         = round_up(i_rm, i_sign, i_sig[62 - MW], i_sig[61 - MW:0] != 0, kept0[0]);
    let reach: logic         = te == 0 && kept0 == '1 && ru0;

    let e_n: logic<14> = te + {13'd0, carry};
    let ovf: logic     = !tiny && e_n >= EALL;

    let to_inf: logic = case i_rm {
        3'b001 : 1'b0,
        3'b010 : i_sign,
        3'b011 : !i_sign,
        default: 1'b1,
    };

    let e_inf : logic<EW> = EALL as EW;
    let e_max : logic<EW> = (EALL - 1) as EW;
    let f_zero: logic<MW> = 0;
    let f_max : logic<MW> = '1;
    let e_sub : logic<EW> = mant[MW] as EW;

    always_comb {
        if ovf {
            o_bits = if to_inf ? {i_sign, e_inf, f_zero} : {i_sign, e_max, f_max};
        } else if tiny {
            o_bits = {i_sign, e_sub, mant[MW - 1:0]};
        } else if carry {
            o_bits = {i_sign, e_n[EW - 1:0], f_zero};
        } else {
            o_bits = {i_sign, te[EW - 1:0], mant[MW - 1:0]};
        }
    }

    assign o_nx = g || st || ovf;
    assign o_of = ovf;
    assign o_uf = tiny && !reach && (g || st);
}
