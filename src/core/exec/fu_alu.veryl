// fu_alu: integer ALU, RV64I without AUIPC and the branches, Zba, Zbb, Zbs,
// Zicond.
//
// Ports (timing contract):
//   i_valid/i_op/i_tag/i_src : the op accepted in cycle A; i_src[0]/[1] are
//                              the formed operands (rs1 or 0, rs2 or imm)
//   i_kill                   : applied when the result is captured
//   o_ready                  : constant 1 (pipelined)
//   o_wb                     : registered, valid in A + LAT_ALU
// Owns:
//   - o_wb.tag is i_tag of the same op
// Rationale:
//   - the bit counts use log-depth trees instead of per-bit loops
pub module fu_alu::<CFG: core_cfg> (
    clk    : input  clock                              ,
    rst    : input  reset                              ,
    i_valid: input  logic                              ,
    i_op   : input  alu_pkg::AluOp                     ,
    i_tag  : input  core_types::<CFG>::ExTag           ,
    i_src  : input  logic                      <64> [2],
    i_kill : input  core_types::<CFG>::Kill            ,
    o_ready: output logic                              ,
    o_wb   : output core_types::<CFG>::WbPacket        ,
) {
    import core_types::<CFG>::*;
    import alu_pkg::AluOp;

    let a: logic<64> = i_src[0];
    let b: logic<64> = i_src[1];

    let a32    : logic<32> = a[31:0];
    let b32    : logic<32> = b[31:0];
    let shamt  : logic<6>  = b[5:0];
    let shamt32: logic<5>  = b[4:0];

    let r32_add: logic<32> = a32 + b32;
    let r32_sub: logic<32> = a32 - b32;
    let r32_sll: logic<32> = a32 << shamt32;
    let r32_srl: logic<32> = a32 >> shamt32;
    let r32_sra: logic<32> = $signed(a32) >>> shamt32;

    let uw_a: logic<64> = {32'b0, a32};

    // inv_sh = (64 - shamt) mod 64, so shamt 0 leaves both halves equal.
    let inv_sh  : logic<6>  = 6'd0 - shamt;
    let inv_sh32: logic<5>  = 5'd0 - shamt32;
    let rol64   : logic<64> = (a << shamt) | (a >> inv_sh);
    let ror64   : logic<64> = (a >> shamt) | (a << inv_sh);
    let rolw32  : logic<32> = (a32 << shamt32) | (a32 >> inv_sh32);
    let rorw32  : logic<32> = (a32 >> shamt32) | (a32 << inv_sh32);

    let bit_mask: logic<64> = 64'd1 << shamt;

    let rev8: logic<64> = {a[7:0], a[15:8], a[23:16], a[31:24], a[39:32], a[47:40], a[55:48], a[63:56]};

    // clz/ctz/cpop return the operand width for a zero input. ctz is clz of
    // the bit-reversed operand.
    var a_rev: logic<64>;
    var orc_b: logic<64>;
    always_comb {
        for i in 0..64 {
            a_rev[i] = a[63 - i];
        }
        for i in 0..8 {
            orc_b[i * 8+:8] = {(a[i * 8+:8] != 8'd0) repeat 8};
        }
    }
    let clz64 : logic<9> = fpu_pkg::clz::<64>(a);
    let clz32 : logic<9> = fpu_pkg::clz::<32>(a32);
    let ctz64 : logic<9> = fpu_pkg::clz::<64>(a_rev);
    let ctz32 : logic<9> = fpu_pkg::clz::<32>(a_rev[63:32]);
    let cpop64: logic<7> = fpu_pkg::popcount64(a);
    let cpop32: logic<7> = fpu_pkg::popcount64(uw_a);

    var res: logic<64>;
    always_comb {
        case i_op {
            AluOp::ADD      : res = a + b;
            AluOp::SUB      : res = a - b;
            AluOp::SLL      : res = a << shamt;
            AluOp::SLT      : res = {63'b0, $signed(a) <: $signed(b)};
            AluOp::SLTU     : res = {63'b0, a <: b};
            AluOp::XOR      : res = a ^ b;
            AluOp::SRL      : res = a >> shamt;
            AluOp::SRA      : res = $signed(a) >>> shamt;
            AluOp::OR       : res = a | b;
            AluOp::AND      : res = a & b;
            AluOp::ADDW     : res = {r32_add[31] repeat 32, r32_add};
            AluOp::SUBW     : res = {r32_sub[31] repeat 32, r32_sub};
            AluOp::SLLW     : res = {r32_sll[31] repeat 32, r32_sll};
            AluOp::SRLW     : res = {r32_srl[31] repeat 32, r32_srl};
            AluOp::SRAW     : res = {r32_sra[31] repeat 32, r32_sra};
            AluOp::SH1ADD   : res = (a << 1) + b;
            AluOp::SH2ADD   : res = (a << 2) + b;
            AluOp::SH3ADD   : res = (a << 3) + b;
            AluOp::ADD_UW   : res = uw_a + b;
            AluOp::SH1ADD_UW: res = (uw_a << 1) + b;
            AluOp::SH2ADD_UW: res = (uw_a << 2) + b;
            AluOp::SH3ADD_UW: res = (uw_a << 3) + b;
            AluOp::SLLI_UW  : res = uw_a << shamt;
            AluOp::ANDN     : res = a & ~b;
            AluOp::ORN      : res = a | ~b;
            AluOp::XNOR     : res = ~(a ^ b);
            AluOp::CLZ      : res = {55'b0, clz64};
            AluOp::CTZ      : res = {55'b0, ctz64};
            AluOp::CPOP     : res = {57'b0, cpop64};
            AluOp::CLZW     : res = {55'b0, clz32};
            AluOp::CTZW     : res = {55'b0, ctz32};
            AluOp::CPOPW    : res = {57'b0, cpop32};
            AluOp::MIN      : res = if $signed(a) <: $signed(b) ? a : b;
            AluOp::MINU     : res = if a <: b ? a : b;
            AluOp::MAX      : res = if $signed(a) <: $signed(b) ? b : a;
            AluOp::MAXU     : res = if a <: b ? b : a;
            AluOp::SEXT_B   : res = {a[7] repeat 56, a[7:0]};
            AluOp::SEXT_H   : res = {a[15] repeat 48, a[15:0]};
            AluOp::ZEXT_H   : res = {48'b0, a[15:0]};
            AluOp::ROL      : res = rol64;
            AluOp::ROR      : res = ror64;
            AluOp::ROLW     : res = {rolw32[31] repeat 32, rolw32};
            AluOp::RORW     : res = {rorw32[31] repeat 32, rorw32};
            AluOp::ORC_B    : res = orc_b;
            AluOp::REV8     : res = rev8;
            AluOp::BCLR     : res = a & ~bit_mask;
            AluOp::BSET     : res = a | bit_mask;
            AluOp::BINV     : res = a ^ bit_mask;
            AluOp::BEXT     : res = (a >> shamt) & 64'd1;
            AluOp::CZERO_EQZ: res = if b == 64'd0 ? 64'd0 : a;
            AluOp::CZERO_NEZ: res = if b != 64'd0 ? 64'd0 : a;
            default         : res = 0;
        }
    }

    var pkt: WbPacket;
    always_comb {
        pkt       = 0 as WbPacket;
        pkt.valid = 1'b1;
        pkt.tag   = i_tag;
        pkt.data  = res;
    }

    var wb_v: logic   ;
    var wb_d: WbPacket;
    inst u_out: stage_reg::<CFG> #(
        T: WbPacket,
    ) (
        clk               ,
        rst               ,
        i_valid: i_valid  ,
        i_data : pkt      ,
        i_tag  : i_tag.rob,
        i_kill            ,
        o_valid: wb_v     ,
        o_data : wb_d     ,
    );

    always_comb {
        o_wb       = wb_d;
        o_wb.valid = wb_v;
    }
    assign o_ready = 1'b1;
}
