/// The single-cycle scalar FP unit (fp_misc), one stage.
///
/// # Owns
///
/// - o_wb.tag is i_tag of the same op
pub module fu_fmisc::<CFG: core_cfg> (
    clk    : input  clock                              ,
    rst    : input  reset                              ,
    /// The op accepted in cycle A (rs1, rs2)
    i_valid: input  logic                              ,
    /// See i_valid.
    i_op   : input  fpu_pkg::FpuOp                     ,
    /// See i_valid.
    i_tag  : input  core_types::<CFG>::ExTag           ,
    /// See i_valid.
    i_src  : input  logic                      <64> [2],
    /// FLI: the constant index in [4:0]
    i_imm  : input  logic                      <32>    ,
    /// The instruction's rm field and fcsr.frm, A
    i_rm   : input  logic                      <3>     ,
    /// See i_rm.
    i_frm  : input  logic                      <3>     ,
    /// Applied at the capture edge
    i_kill : input  core_types::<CFG>::Kill            ,
    /// Constant 1 (pipelined)
    o_ready: output logic                              ,
    /// Registered, valid in A + LAT_FMISC; fflags in
    /// the packet, exc always clear
    o_wb   : output core_types::<CFG>::WbPacket        ,
) {
    import core_types::<CFG>::*;

    var res: logic<64>;
    var ffl: logic<5> ;
    inst u_misc: fp_misc (
        i_op                                      ,
        i_a     : i_src[0]                        ,
        i_b     : i_src[1]                        ,
        i_rm    : fpu_pkg::resolve_rm(i_rm, i_frm),
        i_fli   : i_imm[4:0]                      ,
        o_result: res                             ,
        o_fflags: ffl                             ,
    );

    var pkt: WbPacket;
    always_comb {
        pkt        = 0 as WbPacket;
        pkt.valid  = 1'b1;
        pkt.tag    = i_tag;
        pkt.data   = res;
        pkt.fflags = ffl;
    }

    var wb_v: logic   ;
    var wb_d: WbPacket;
    inst u_out: stage_reg::<CFG> #(
        T: WbPacket,
    ) (
        clk               ,
        rst               ,
        i_valid           ,
        i_data : pkt      ,
        i_tag  : i_tag.rob,
        i_kill            ,
        o_valid: wb_v     ,
        o_data : wb_d     ,
    );

    always_comb {
        o_wb       = wb_d;
        o_wb.valid = wb_v;
    }
    assign o_ready = 1'b1;
}
