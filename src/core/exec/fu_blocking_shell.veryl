// fu_blocking_shell: occupancy, tag latch, kill abort and WB hole-fill of a
// blocking (iterative) FU; the leaf computes beside it.
//
// Ports (timing contract):
//   i_valid/i_tag   : the op accepted in cycle A; issued only while o_ready
//   o_ready         : registered: 0 from the cycle after accept until the
//                     result's WB cycle (or the kill that drops it)
//   o_start         : combinational pulse to the leaf in A, unless the kill
//                     of A selects the op
//   o_flush         : combinational, aborts the leaf when the kill selects
//                     the latched op
//   i_leaf_valid/i_leaf_data/i_leaf_fflags : the leaf's one-cycle result
//   o_hf_req        : same cycle as i_leaf_valid when the op is still live
//   o_hf_tag        : the latched tag, for the wake of the granted slot
//   i_wb_grant      : the hole-fill grant {valid, off} of o_hf_req, same cycle
//   i_kill          : drops the latched op in any cycle up to its WB
//   o_wb            : registered, valid off cycles after the grant
// Owns:
//   - the result is attributed to the tag latched at accept, never to the
//     op presented at the input
//   - at most one op is in the shell between accept and WB
// Rationale:
//   - one occupancy state replaces separate started/done/owner flags; the
//     leaf's busy output is not used because reused iterative leaves drop it
//     in the accept and result cycles
pub module fu_blocking_shell::<CFG: core_cfg> (
    clk          : input  clock                          ,
    rst          : input  reset                          ,
    i_valid      : input  logic                          ,
    i_tag        : input  core_types::<CFG>::ExTag       ,
    i_kill       : input  core_types::<CFG>::Kill        ,
    o_ready      : output logic                          ,
    o_start      : output logic                          ,
    o_flush      : output logic                          ,
    i_leaf_valid : input  logic                          ,
    i_leaf_data  : input  logic                      <64>,
    i_leaf_fflags: input  logic                      <5> ,
    o_hf_req     : output logic                          ,
    o_hf_tag     : output core_types::<CFG>::ExTag       ,
    i_wb_grant   : input  fu_pkg::WbSlot                 ,
    o_wb         : output core_types::<CFG>::WbPacket    ,
) {
    import core_types::<CFG>::*;
    import fu_pkg::*;

    var occ_q : logic       ; // accept to WB
    var hold_q: logic       ; // result captured, WB slot granted
    var tag_q : ExTag       ;
    var res_q : logic   <64>;
    var ff_q  : logic   <5> ;
    var cnt_q : WbOff       ; // cycles left until the WB slot
    var wb_q  : WbPacket    ;

    let dead : logic = occ_q && killed(i_kill, tag_q.rob);
    let start: logic = i_valid && !killed(i_kill, i_tag.rob);

    assign o_ready  = !occ_q;
    assign o_start  = start;
    assign o_flush  = dead;
    assign o_hf_req = occ_q && !hold_q && i_leaf_valid && !dead;
    assign o_hf_tag = tag_q;

    // The packet is registered in the cycle before the granted slot.
    let fire: logic = hold_q && cnt_q == 1 && !dead;

    always_ff {
        if_reset {
            occ_q  = 1'b0;
            hold_q = 1'b0;
            cnt_q  = 0;
            wb_q   = 0 as WbPacket;
        } else {
            wb_q.valid = fire;
            if fire {
                wb_q.tag    = tag_q;
                wb_q.data   = res_q;
                wb_q.fflags = ff_q;
            }
            if start {
                occ_q = 1'b1;
            } else if dead || fire {
                occ_q  = 1'b0;
                hold_q = 1'b0;
            } else if o_hf_req && i_wb_grant.valid {
                hold_q = 1'b1;
                cnt_q  = i_wb_grant.off - 1;
            } else if hold_q {
                cnt_q = cnt_q - 1;
            }
        }
    }

    always_ff {
        if start {
            tag_q = i_tag;
        }
        if o_hf_req {
            res_q = i_leaf_data;
            ff_q  = i_leaf_fflags;
        }
    }

    assign o_wb = wb_q;
}
