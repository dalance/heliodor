// Phase 8 M2: Branch Target Buffer.
//
// Direct-mapped, tagged. Indexed by the fetch PC; a hit means a control
// transfer (branch / JAL / JALR) was previously committed *taken* at this PC.
// It supplies the last resolved target and whether the op is a conditional
// branch, so the fetch stage knows to consult the BHT (conditional) or predict
// taken unconditionally (JAL / JALR).
//
// Trained at commit on taken control transfers only — wrong-path ops never
// reach commit, so the table is never polluted. A stale or aliased entry is
// not a correctness problem: the commit stage recomputes the architectural
// next PC and redirects on any mismatch (see heliodor_core c_bp_mispredict).
//
// Geometry is parameterized (Phase 8 S13.1): 2^IDX_W entries, index =
// pc[IDX_W:1] (RVC 2-byte granularity), tag = pc[63:IDX_W+1]. The S13.0 probe
// showed 31% of retired control ops early-redirect at 64 entries — a taken
// branch absent from the BTB is always a mispredict, and the Linux boot's
// branch footprint dwarfs 64 sites.
pub module btb #(
    param IDX_W: u32 = 12, // log2(#entries): 6 -> 64, 10 -> 1024 (default)
) (
    clk: input clock,
    rst: input reset,

    // Lookup (combinational, on the fetch PC).
    i_pc     : input  logic<64>,
    o_hit    : output logic    ,
    o_target : output logic<64>,
    o_is_cond: output logic    ,
    o_is_call: output logic    , // M3: jal/jalr writing a link reg → push RAS
    o_is_ret : output logic    , // M3: jalr reading a link reg → pop RAS, use RAS top
    o_is_ind : output logic    , // S18: non-return JALR → consult the iBTB for the target

    // Phase 8 S4a: 2nd lookup port (slot-1 PC of a 2-wide fetch bundle). A
    // separate combinational read of the same tables; tie i_pc2 to slot-1's PC.
    i_pc2     : input  logic<64>,
    o_hit2    : output logic    ,
    o_target2 : output logic<64>,
    o_is_cond2: output logic    ,
    o_is_call2: output logic    ,
    o_is_ret2 : output logic    ,
    o_is_ind2 : output logic    ,

    // Train (commit): a taken control op retired at i_train_pc.
    i_train_en     : input logic    ,
    i_train_pc     : input logic<64>,
    i_train_target : input logic<64>,
    i_train_is_cond: input logic    ,
    i_train_is_call: input logic    ,
    i_train_is_ret : input logic    ,
    i_train_is_ind: input logic    , // S18: non-return JALR kind
) {
    const ENTRIES: u32 = 1 << IDX_W;
    const TAG_W  : u32 = 63 - IDX_W;

    // Realistic-SRAM migration (doc/sram_inventory.md, doc/deep_pipeline_sram_plan.md
    // "predictor"): the tag/target/flags were one 2R1W SRAM each (slot-0 + slot-1
    // reads). A real compiler memory has at most 1R1W, so the two read ports are
    // resolved by REPLICATION — port-0 reads copy `d0`, port-1 reads copy `d1`, and
    // the commit train writes BOTH copies identically. That folds the 6 SRAM arrays
    // into ONE packed word per copy ({is_ind,is_ret,is_call,is_cond,target,tag}), so
    // each copy infers as a single 1R1W macro. Byte-identical (both copies hold the
    // same data; reads are unchanged) — only the port count and macro shape change.
    // `valid` stays a reset flop array (it gates every lookup and is tiny; a flop
    // multi-read is free, no SRAM). The read stays combinational — the synchronous
    // (registered) SRAM read is the fetch-decouple bundle, deferred.
    const DATA_W: u32 = TAG_W + 68; // {is_ind, is_ret, is_call, is_cond, target[64], tag[TAG_W]}
    var valid: logic         [ENTRIES];
    var d0   : logic<DATA_W> [ENTRIES]; // 1R1W copy — slot-0 read port
    var d1   : logic<DATA_W> [ENTRIES]; // 1R1W copy — slot-1 read port

    let lk_idx : logic<IDX_W>  = i_pc[IDX_W:1];
    let lk_tag : logic<TAG_W>  = i_pc[63:IDX_W + 1];
    let r0     : logic<DATA_W> = d0[lk_idx];
    // Phase 8 S4a: 2nd read port (slot-1) — served from the replicated copy d1.
    let lk_idx2: logic<IDX_W>  = i_pc2[IDX_W:1];
    let lk_tag2: logic<TAG_W>  = i_pc2[63:IDX_W + 1];
    let r1     : logic<DATA_W> = d1[lk_idx2];

    // ── Predictor sync-read scaffold (goal-(b) SRAM realism, sram_inventory.md "predictor") ──
    // A real 1R1W SRAM returns the entry ONE cycle after the index. Register the read result (r0/r1)
    // + the compare operands (valid[lk_idx], lk_tag) and compare on the registered copies at =1. DEAD
    // at BTB_SYNC_READ=0: *_eff == the combinational value → byte-identical, and every *_q is reset-
    // only → DCE (the ICACHE/DCACHE/L2_SYNC_READ idiom). At =1 the read is a flop = FF-insertion CP
    // measurement only: the prediction is a cycle late, so it is FUNCTIONAL only under the decoupled
    // fetch (shape-W / ICACHE_SYNC_READ) — the fetch-decouple bundle the header defers to. Flip
    // together with bht/ibtb + shape-W when that bundle moves.
    const BTB_SYNC_READ: bit = 0;
    var r0_q  : logic<DATA_W>;
    var v0_q  : logic        ;
    var tag0_q: logic<TAG_W> ;
    var r1_q  : logic<DATA_W>;
    var v1_q  : logic        ;
    var tag1_q: logic<TAG_W> ;
    always_ff (clk, rst) {
        if_reset {
            r0_q   = '0;
            v0_q   = 1'b0;
            tag0_q = '0;
            r1_q   = '0;
            v1_q   = 1'b0;
            tag1_q = '0;
        } else if BTB_SYNC_READ {
            r0_q   = r0;
            v0_q   = valid[lk_idx];
            tag0_q = lk_tag;
            r1_q   = r1;
            v1_q   = valid[lk_idx2];
            tag1_q = lk_tag2;
        }
    }
    let r0_e  : logic<DATA_W> = if BTB_SYNC_READ ? r0_q   : r0;
    let v0_e  : logic         = if BTB_SYNC_READ ? v0_q   : valid[lk_idx];
    let tag0_e: logic<TAG_W>  = if BTB_SYNC_READ ? tag0_q : lk_tag;
    assign o_hit     = v0_e && r0_e[0 +: TAG_W] == tag0_e;
    assign o_target  = r0_e[TAG_W +: 64];
    assign o_is_cond = r0_e[TAG_W + 64];
    assign o_is_call = r0_e[TAG_W + 65];
    assign o_is_ret  = r0_e[TAG_W + 66];
    assign o_is_ind  = r0_e[TAG_W + 67];

    let r1_e  : logic<DATA_W> = if BTB_SYNC_READ ? r1_q   : r1;
    let v1_e  : logic         = if BTB_SYNC_READ ? v1_q   : valid[lk_idx2];
    let tag1_e: logic<TAG_W>  = if BTB_SYNC_READ ? tag1_q : lk_tag2;
    assign o_hit2     = v1_e && r1_e[0 +: TAG_W] == tag1_e;
    assign o_target2  = r1_e[TAG_W +: 64];
    assign o_is_cond2 = r1_e[TAG_W + 64];
    assign o_is_call2 = r1_e[TAG_W + 65];
    assign o_is_ret2  = r1_e[TAG_W + 66];
    assign o_is_ind2  = r1_e[TAG_W + 67];

    let tr_idx : logic<IDX_W> = i_train_pc[IDX_W:1];
    let tr_tag : logic<TAG_W> = i_train_pc[63:IDX_W + 1];
    let tr_word: logic<DATA_W> = {i_train_is_ind, i_train_is_ret, i_train_is_call, i_train_is_cond, i_train_target, tr_tag};
    always_ff (clk, rst) {
        if_reset {
            // Only the valid bits need a reset (they gate every lookup —
            // `o_hit = valid && tag==`). The packed data copies are left un-reset
            // so they infer as SRAM; an unwritten entry's garbage is masked by
            // valid=0. Behavior is identical to a fully-cleared table.
            for i in 0..ENTRIES {
                valid[i] = 1'b0;
            }
        } else if i_train_en {
            valid[tr_idx] = 1'b1;
            d0[tr_idx]    = tr_word; // both copies written identically (replication)
            d1[tr_idx]    = tr_word;
        }
    }
}
