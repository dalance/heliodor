// 64-bit ALU supporting RV64I and RV64M operations
pub module alu (
    i_op : input  alu_pkg::AluOp    ,
    i_a  : input  logic         <64>,
    i_b  : input  logic         <64>,
    o_out: output logic         <64>,
) {
    import alu_pkg::AluOp;

    // 32-bit operands for W-type instructions
    let a32: logic<32> = i_a[31:0];
    let b32: logic<32> = i_b[31:0];

    // Shift amounts
    let shamt  : logic<6> = i_b[5:0];
    let shamt32: logic<5> = i_b[4:0];

    var result: logic<64>;

    // 32-bit intermediate results for W-type ops
    let r32_add: logic<32> = a32 + b32;
    let r32_sub: logic<32> = a32 - b32;
    let r32_sll: logic<32> = a32 << shamt32;
    let r32_srl: logic<32> = a32 >> shamt32;
    let r32_sra: logic<32> = $signed(a32) >>> shamt32;

    // RV64M: intermediate results (kept as vars for a few that
    // depend on wide computations below).
    var mul_lo  : logic<64>;
    var mul32_lo: logic<32>;
    // DIV/REM (the `/` and `%` operators) moved to the multi-cycle `int_divider`
    // FU — they synthesized to the longest combinational path in the core. The
    // DIV*/REM* AluOp arms below are unreachable here (the core routes those ops
    // to int_divider and gates this ALU off for them); kept out of the case.

    // MULH helper: 64x64→128 bit multiply using 32-bit partials.
    // a = a_hi*2^32 + a_lo, b = b_hi*2^32 + b_lo
    // product = a_hi*b_hi*2^64 + (a_hi*b_lo + a_lo*b_hi)*2^32 + a_lo*b_lo
    let a_lo: logic<64> = {32'b0, i_a[31:0]};
    let a_hi: logic<64> = {32'b0, i_a[63:32]};
    let b_lo: logic<64> = {32'b0, i_b[31:0]};
    let b_hi: logic<64> = {32'b0, i_b[63:32]};

    // Partial products (each fits in 64 bits since inputs are 32-bit zero-extended)
    let pp_ll: logic<64> = a_lo * b_lo;
    let pp_lh: logic<64> = a_lo * b_hi;
    let pp_hl: logic<64> = a_hi * b_lo;
    let pp_hh: logic<64> = a_hi * b_hi;

    // Upper 64 bits of the 128-bit unsigned product.
    let mid_v    : logic<64> = pp_lh + pp_hl;
    let mid_of   : logic<64> = if mid_v <: pp_lh ? 64'h0000_0001_0000_0000 : 64'd0;
    let mid_hi   : logic<64> = mid_v >> 32;
    let lo_v     : logic<64> = pp_ll + (mid_v << 32);
    let lo_of    : logic<64> = if lo_v <: pp_ll ? 64'd1 : 64'd0;
    let hi_result: logic<64> = pp_hh + mid_hi + mid_of + lo_of;

    // MULH sign-corrections computed as expressions to avoid relying on
    // sequential conditional assignment inside always_comb.
    let adj_a    : logic<64> = {i_a[63] repeat 64} & i_b;
    let adj_b    : logic<64> = {i_b[63] repeat 64} & i_a;
    let mulh_s_e : logic<64> = hi_result - adj_a - adj_b;
    let mulh_su_e: logic<64> = hi_result - adj_a;

    // ---- Phase 10: B extension (Zba/Zbb/Zbs) helpers ----

    // Zba: zero-extended low 32 bits of operand a (the ".uw" forms).
    let uw_a: logic<64> = {32'b0, i_a[31:0]};

    // Zbb rotates. inv_sh = (64 - shamt) mod 64 via 6-bit modular negate, so
    // shamt==0 leaves both halves equal to the source (no out-of-range shift).
    let inv_sh  : logic<6>  = 6'd0 - shamt;
    let inv_sh32: logic<5>  = 5'd0 - shamt32;
    let rol64   : logic<64> = (i_a << shamt) | (i_a >> inv_sh);
    let ror64   : logic<64> = (i_a >> shamt) | (i_a << inv_sh);
    let rolw32  : logic<32> = (a32 << shamt32) | (a32 >> inv_sh32);
    let rorw32  : logic<32> = (a32 >> shamt32) | (a32 << inv_sh32);

    // Zbs single-bit mask (bit index = shamt, masked to 6 bits).
    let bit_mask: logic<64> = 64'd1 << shamt;

    // Zbb rev8: byte-reverse the 64-bit value.
    let rev8_r: logic<64> = {
        i_a[7:0], i_a[15:8], i_a[23:16], i_a[31:24], i_a[39:32], i_a[47:40], i_a[55:48], i_a[63:56]
    };

    // Zbb bit-count helpers (combinational accumulation).
    //   clz/ctz return XLEN when the input is zero.
    var clz64 : logic<7>;
    var ctz64 : logic<7>;
    var cpop64: logic<7>;
    var clz32 : logic<6>;
    var ctz32 : logic<6>;
    var cpop32: logic<6>;
    var orcb_r: logic<64>;
    always_comb {
        cpop64 = 7'd0;
        for i in 0..64 {
            cpop64 = cpop64 + {6'b0, i_a[i]};
        }
        cpop32 = 6'd0;
        for i in 0..32 {
            cpop32 = cpop32 + {5'b0, i_a[i]};
        }
        // clz: highest set bit wins (ascending loop, last write).
        clz64 = 7'd64;
        for i in 0..64 {
            if i_a[i] {
                clz64 = 7'd63 - (i as 7);
            }
        }
        clz32 = 6'd32;
        for i in 0..32 {
            if i_a[i] {
                clz32 = 6'd31 - (i as 6);
            }
        }
        // ctz: lowest set bit wins (descending probe via 63-i, last write).
        ctz64 = 7'd64;
        for i in 0..64 {
            if i_a[63 - i] {
                ctz64 = (63 - i) as 7;
            }
        }
        ctz32 = 6'd32;
        for i in 0..32 {
            if i_a[31 - i] {
                ctz32 = (31 - i) as 6;
            }
        }
        // orc.b: set each byte to 0xFF if any of its bits is set.
        for i in 0..8 {
            orcb_r[i*8+:8] = if i_a[i*8+:8] != 8'd0 ? 8'hFF : 8'h00;
        }
    }

    always_comb {
        // Compute M extension intermediates
        mul_lo = i_a * i_b;

        mul32_lo = a32 * b32;

        case i_op {
            // RV64I
            AluOp::ADD   : result = i_a + i_b;
            AluOp::SUB   : result = i_a - i_b;
            AluOp::SLL   : result = i_a << shamt;
            AluOp::SLT   : result = {63'b0, $signed(i_a) <: $signed(i_b)};
            AluOp::SLTU  : result = {63'b0, i_a <: i_b};
            AluOp::XOR   : result = i_a ^ i_b;
            AluOp::SRL   : result = i_a >> shamt;
            AluOp::SRA   : result = $signed(i_a) >>> shamt;
            AluOp::OR    : result = i_a | i_b;
            AluOp::AND   : result = i_a & i_b;
            AluOp::ADDW  : result = {r32_add[31] repeat 32, r32_add};
            AluOp::SUBW  : result = {r32_sub[31] repeat 32, r32_sub};
            AluOp::SLLW  : result = {r32_sll[31] repeat 32, r32_sll};
            AluOp::SRLW  : result = {r32_srl[31] repeat 32, r32_srl};
            AluOp::SRAW  : result = {r32_sra[31] repeat 32, r32_sra};
            // RV64M
            AluOp::MUL   : result = mul_lo;
            AluOp::MULH  : result = mulh_s_e;
            AluOp::MULHSU: result = mulh_su_e;
            AluOp::MULHU : result = hi_result;
            AluOp::MULW  : result = {mul32_lo[31] repeat 32, mul32_lo};
            // Zba (address generation)
            AluOp::SH1ADD   : result = (i_a << 1) + i_b;
            AluOp::SH2ADD   : result = (i_a << 2) + i_b;
            AluOp::SH3ADD   : result = (i_a << 3) + i_b;
            AluOp::ADD_UW   : result = uw_a + i_b;
            AluOp::SH1ADD_UW: result = (uw_a << 1) + i_b;
            AluOp::SH2ADD_UW: result = (uw_a << 2) + i_b;
            AluOp::SH3ADD_UW: result = (uw_a << 3) + i_b;
            AluOp::SLLI_UW  : result = uw_a << shamt;
            // Zbb (basic bit manipulation)
            AluOp::ANDN  : result = i_a & ~i_b;
            AluOp::ORN   : result = i_a | ~i_b;
            AluOp::XNOR  : result = ~(i_a ^ i_b);
            AluOp::CLZ   : result = {57'b0, clz64};
            AluOp::CTZ   : result = {57'b0, ctz64};
            AluOp::CPOP  : result = {57'b0, cpop64};
            AluOp::CLZW  : result = {58'b0, clz32};
            AluOp::CTZW  : result = {58'b0, ctz32};
            AluOp::CPOPW : result = {58'b0, cpop32};
            AluOp::MIN   : result = if $signed(i_a) <: $signed(i_b) ? i_a : i_b;
            AluOp::MINU  : result = if i_a <: i_b ? i_a : i_b;
            AluOp::MAX   : result = if $signed(i_a) <: $signed(i_b) ? i_b : i_a;
            AluOp::MAXU  : result = if i_a <: i_b ? i_b : i_a;
            AluOp::SEXT_B: result = {i_a[7] repeat 56, i_a[7:0]};
            AluOp::SEXT_H: result = {i_a[15] repeat 48, i_a[15:0]};
            AluOp::ZEXT_H: result = {48'b0, i_a[15:0]};
            AluOp::ROL   : result = rol64;
            AluOp::ROR   : result = ror64;
            AluOp::ROLW  : result = {rolw32[31] repeat 32, rolw32};
            AluOp::RORW  : result = {rorw32[31] repeat 32, rorw32};
            AluOp::ORC_B : result = orcb_r;
            AluOp::REV8  : result = rev8_r;
            // Zbs (single-bit)
            AluOp::BCLR  : result = i_a & ~bit_mask;
            AluOp::BSET  : result = i_a | bit_mask;
            AluOp::BINV  : result = i_a ^ bit_mask;
            AluOp::BEXT  : result = (i_a >> shamt) & 64'd1;
            // Zicond (conditional zero): condition is rs2 (= i_b).
            AluOp::CZERO_EQZ: result = if i_b == 64'd0 ? 64'd0 : i_a;
            AluOp::CZERO_NEZ: result = if i_b != 64'd0 ? 64'd0 : i_a;
            default      : result = '0;
        }
    }

    assign o_out = result;
}
