// bp_btb: block target buffer, the table part of the predictor.
//
// Ports (timing contract):
//   i_lk_valid/i_lk_pc : lookup of the block entered at i_lk_pc, every cycle
//   o_pred/o_meta/...  : result of the lookup of the previous cycle
//                        (bpu_pkg::BTB_LAT = 1); a cycle with no lookup
//                        leaves them stale
//   i_upd              : training of one committed block per cycle, written
//                        at the edge
// Owns:
//   - the prediction is a function of the table and the looked-up start_pc
//     only; the table holds no speculative state (no recover port)
//   - update writes only the fields its metadata and outcome determine and
//     never reads the table. If the entry was reallocated between lookup and
//     update, the update writes its slot fields into the new owner; that
//     costs prediction accuracy only, never correctness (extract checks every
//     prediction)
//   - the table is BP_BTB_N rows with a registered read and one write, no
//     reset. A lookup and an update of the same row in one cycle read the
//     row as it was before the update (read-old)
//   - for BP_BTB_N cycles after reset the write port clears one row per
//     cycle, every lookup misses and training is dropped
// Rationale:
//   - indexed and tagged by start_pc in halfwords, and slot offsets are
//     relative to the aligned block, so a prediction is used only from the
//     entry point it was learned at
//   - an entry has BP_SLOTS conditional slots (2-bit counter and target) and
//     one tail slot for the unconditional jump that ends the block; the exit
//     is the earliest predicted-taken slot
//   - targets keep only their low bits (bit 0 is always 0); the bits above
//     come from the lookup pc, so a far target mispredicts and is redirected
//     like any wrong target
//   - the valid bits live in the row and are cleared by the sweep, so no
//     part of the table needs a reset; a generation scheme would still need
//     the sweep, since rows hold arbitrary values at power-on
//   - the row is split into one array per group of fields that an update
//     writes together, so each array takes a plain whole-word write; a
//     bit-masked read-modify-write needs a second read port and does not map
//     to block RAM
pub module bp_btb::<CFG: core_cfg> (
    clk       : input  clock                           ,
    rst       : input  reset                           ,
    i_lk_valid: input  logic                           ,
    i_lk_pc   : input  logic                       <64>,
    o_pred    : output core_types::<CFG>::BlockPred    ,
    o_exit_rvc: output logic                           , // the predicted exit is a 16-bit instruction
    o_meta    : output bpu_pkg::<CFG>::BtbMeta         ,
    i_upd     : input  core_types::<CFG>::BpUpdate     ,
    o_ev      : output core_types::<CFG>::BtbPerf      , // registered training events
) {
    import core_types::<CFG>::*;
    import bpu_pkg::<CFG>::*;

    const N_CAND: u32 = BP_SLOTS + 1; // conditional slots, then the tail slot

    function idx_of (
        pc: input logic<64>,
    ) -> logic<BTB_IDX_W> {
        return pc[BTB_IDX_W:1] ^ pc[2 * BTB_IDX_W:BTB_IDX_W + 1];
    }
    function tag_of (
        pc: input logic<64>,
    ) -> logic<BTB_TAG_W> {
        return pc[BTB_IDX_W + BTB_TAG_W:BTB_IDX_W + 1];
    }
    // Bits of a target taken from the lookup pc instead of the table.
    function hi_mask (
        w: input u32,
    ) -> logic<64> {
        var m: logic<64>;
        for i in 0..64 {
            m[i] = i >= w;
        }
        return m;
    }
    const S_HI: logic<64> = hi_mask(BTB_STGT_W);
    const T_HI: logic<64> = hi_mask(BTB_TTGT_W);

    function foff_of (
        pc: input logic<64>,
    ) -> logic<FOFF_W> {
        return pc[FOFF_W:1];
    }

    // ---- Table ----

    var swp_q: logic           ; // reset sweep in progress
    var swi_q: logic<BTB_IDX_W>;
    var w_idx: logic<BTB_IDX_W>;
    var w_row: BtbRow          ;
    var w_vt : logic           ; // vld, tag
    var w_sv : logic<BP_SLOTS> ;
    var w_so : logic<BP_SLOTS> ;
    var w_sc : logic<BP_SLOTS> ;
    var w_st : logic<BP_SLOTS> ;
    var w_tv : logic           ;
    var w_tx : logic           ; // t_off, t_knd, t_rvc, t_tgt

    always_ff {
        if_reset {
            swp_q = 1'b1;
            swi_q = 0;
        } else if swp_q {
            swi_q = swi_q + 1;
            if swi_q == BP_BTB_N - 1 {
                swp_q = 1'b0;
            }
        }
    }

    let r_idx: logic<BTB_IDX_W> = idx_of(i_lk_pc);

    var vt_q : logic<1 + BTB_TAG_W>                       [BP_BTB_N];
    var tv_q : logic                                      [BP_BTB_N];
    var tx_q : logic<FOFF_W + 3 + 1 + BTB_TTGT_W - 1>     [BP_BTB_N];
    var rd_vt: logic<1 + BTB_TAG_W>                                 ;
    var rd_tv: logic                                                ;
    var rd_tx: logic<FOFF_W + 3 + 1 + BTB_TTGT_W - 1>               ;
    always_ff {
        if i_lk_valid {
            rd_vt = vt_q[r_idx];
            rd_tv = tv_q[r_idx];
            rd_tx = tx_q[r_idx];
        }
        if w_vt {
            vt_q[w_idx] = {w_row.vld, w_row.tag};
        }
        if w_tv {
            tv_q[w_idx] = w_row.t_v;
        }
        if w_tx {
            tx_q[w_idx] = {w_row.t_off, w_row.t_knd, w_row.t_rvc, w_row.t_tgt};
        }
    }

    var rd_sv: logic                     [BP_SLOTS];
    var rd_so: logic<FOFF_W>             [BP_SLOTS];
    var rd_sc: logic<2>                  [BP_SLOTS];
    var rd_st: logic<BTB_STGT_W - 1>     [BP_SLOTS];
    for k in 0..BP_SLOTS :g_slot {
        var sv_q: logic                     [BP_BTB_N];
        var so_q: logic<FOFF_W>             [BP_BTB_N];
        var sc_q: logic<2>                  [BP_BTB_N];
        var st_q: logic<BTB_STGT_W - 1>     [BP_BTB_N];
        always_ff {
            if i_lk_valid {
                rd_sv[k] = sv_q[r_idx];
                rd_so[k] = so_q[r_idx];
                rd_sc[k] = sc_q[r_idx];
                rd_st[k] = st_q[r_idx];
            }
            if w_sv[k] {
                sv_q[w_idx] = w_row.s_v[k];
            }
            if w_so[k] {
                so_q[w_idx] = w_row.s_off[k];
            }
            if w_sc[k] {
                sc_q[w_idx] = w_row.s_ctr[k];
            }
            if w_st[k] {
                st_q[w_idx] = w_row.s_tgt[k];
            }
        }
    }

    var row: BtbRow;
    always_comb {
        row = 0 as BtbRow;
        {row.vld, row.tag}                           = rd_vt;
        row.t_v                                      = rd_tv;
        {row.t_off, row.t_knd, row.t_rvc, row.t_tgt} = rd_tx;
        for k in 0..BP_SLOTS {
            row.s_v[k]   = rd_sv[k];
            row.s_off[k] = rd_so[k];
            row.s_ctr[k] = rd_sc[k];
            row.s_tgt[k] = rd_st[k];
        }
    }

    // ---- Lookup ----

    var lk_v_q : logic    ;
    var lk_pc_q: logic<64>;
    always_ff {
        if_reset {
            lk_v_q  = 1'b0;
            lk_pc_q = 64'd0;
        } else if i_lk_valid {
            lk_v_q  = !swp_q;
            lk_pc_q = i_lk_pc;
        } else {
            lk_v_q = 1'b0;
        }
    }

    let r_hit: logic          = lk_v_q && row.vld && row.tag == tag_of(lk_pc_q);
    let r_s0 : logic <FOFF_W> = foff_of(lk_pc_q);

    var c_v  : logic  <N_CAND>         ;
    var c_off: logic  <FOFF_W> [N_CAND];
    var c_knd: logic  <3>      [N_CAND];
    var c_tgt: logic  <64>     [N_CAND];
    var c_rvc: logic  <1>      [N_CAND];
    var meta : BtbMeta                 ;
    always_comb {
        meta           = 0 as BtbMeta;
        meta.hit       = r_hit;
        meta.tail_v    = r_hit && row.t_v;
        meta.tail_foff = row.t_off;
        for k in 0..BP_SLOTS {
            var sm           : SlotMeta;
            sm.v          = r_hit && row.s_v[k];
            sm.foff       = row.s_off[k];
            sm.ctr        = row.s_ctr[k];
            meta.slots[k] = sm;
            c_v[k]        = sm.v && sm.ctr[1] && sm.foff >= r_s0;
            c_off[k]      = sm.foff;
            c_knd[k]      = CfiKind::BR;
            c_tgt[k]      = (lk_pc_q & S_HI) | ({row.s_tgt[k], 1'b0} as 64);
            c_rvc[k]      = 1'b0;
        }
        c_v[BP_SLOTS]   = meta.tail_v && row.t_off >= r_s0;
        c_off[BP_SLOTS] = row.t_off;
        c_knd[BP_SLOTS] = row.t_knd;
        c_tgt[BP_SLOTS] = (lk_pc_q & T_HI) | ({row.t_tgt, 1'b0} as 64);
        c_rvc[BP_SLOTS] = row.t_rvc;
    }

    // The earliest taken candidate wins (lower index on equal offsets);
    // pairwise compares, no chain.
    var win: logic<N_CAND>;
    always_comb {
        for c in 0..N_CAND {
            win[c] = c_v[c];
            for d in 0..N_CAND {
                if d != c && c_v[d] && (c_off[d] <: c_off[c] || (c_off[d] == c_off[c] && d <: c)) {
                    win[c] = 1'b0;
                }
            }
        }
    }

    assign o_meta           = meta;
    assign o_pred.exit_v    = |win;
    assign o_pred.exit_foff = tree_onehot_mux::<N_CAND, FOFF_W>(win, c_off);
    assign o_pred.exit_kind = tree_onehot_mux::<N_CAND, 3>(win, c_knd) as CfiKind;
    assign o_pred.target    = tree_onehot_mux::<N_CAND, 64>(win, c_tgt);
    assign o_exit_rvc       = tree_onehot_mux::<N_CAND, 1>(win, c_rvc);

    // ---- Update ----

    let u    : BpUpdate            = i_upd;
    let um   : BtbMeta             = u.meta as BtbMeta;
    let u_idx: logic   <BTB_IDX_W> = idx_of(u.start_pc);
    let x_br : logic               = u.res.exit_kind == CfiKind::BR;
    let x_jmp: logic               = u.valid && u.res.exit_v && !x_br;
    let alloc: logic               = u.valid && !um.hit && u.res.exit_v;
    let x_rvc: logic               = u.res.exit_foff == NH - 1 || u.pd.start[u.res.exit_foff + 1];

    var ctr_we: logic<BP_SLOTS>           ;
    var tgt_we: logic<BP_SLOTS>           ;
    var inv   : logic<BP_SLOTS>           ;
    var new_c : logic<2>        [BP_SLOTS];
    var match : logic<BP_SLOTS>           ;
    var freev : logic<BP_SLOTS>           ;
    var ntk   : logic<BP_SLOTS>           ;
    always_comb {
        for k in 0..BP_SLOTS {
            var sm       : SlotMeta;
            var reached  : logic   ;
            var isbr     : logic   ;
            var tk       : logic   ;
            sm        = um.slots[k] as SlotMeta;
            reached   = sm.v && sm.foff <= u.last;
            isbr      = u.pd.start[sm.foff] && u.pd.cfi[sm.foff] == CfiKind::BR;
            tk        = u.res.exit_v && u.res.exit_foff == sm.foff;
            ctr_we[k] = u.valid && um.hit && reached && isbr;
            tgt_we[k] = ctr_we[k] && tk;
            inv[k]    = u.valid && um.hit && reached && !isbr;
            new_c[k]  = if tk ? (if sm.ctr == 2'd3 ? 2'd3 : sm.ctr + 2'd1) : (if sm.ctr == 2'd0 ? 2'd0 : sm.ctr - 2'd1);
            match[k]  = sm.v && sm.foff == u.res.exit_foff;
            freev[k]  = !sm.v;
            ntk[k]    = !sm.ctr[1];
        }
    }

    // A taken branch with no slot takes a free slot, else a not-taken one,
    // else the last slot.
    let need_slot: logic           = u.valid && um.hit && u.res.exit_v && x_br && match == 0;
    let victim   : logic<BP_SLOTS> = if freev != 0 ?
        tree_first::<BP_SLOTS>(freev)
    : if ntk != 0 ?
        tree_first::<BP_SLOTS>(ntk)
    :
        (1 as BP_SLOTS) << (BP_SLOTS - 1)
    ;
    let t_inv    : logic           = u.valid && um.hit && um.tail_v && um.tail_foff <= u.last
        && !(u.res.exit_v && u.res.exit_foff == um.tail_foff);

    // The fields this update writes (wm) and their values (wd).
    var wd: BtbRow;
    var wm: BtbRow;
    always_comb {
        wd = 0 as BtbRow;
        wm = 0 as BtbRow;
        if alloc {
            wd.vld = 1'b1;
            wd.tag = tag_of(u.start_pc);
            wm.vld = 1'b1;
            wm.tag = '1;
        }
        for k in 0..BP_SLOTS {
            if (alloc && k == 0 && x_br) || (need_slot && victim[k]) {
                wd.s_v[k]   = 1'b1;
                wd.s_off[k] = u.res.exit_foff;
                wd.s_ctr[k] = 2'd2;
                wd.s_tgt[k] = u.res.target[BTB_STGT_W - 1:1];
                wm.s_v[k]   = 1'b1;
                wm.s_off[k] = '1;
                wm.s_ctr[k] = '1;
                wm.s_tgt[k] = '1;
            } else if alloc || inv[k] {
                wm.s_v[k] = 1'b1;
            } else {
                if ctr_we[k] {
                    wd.s_ctr[k] = new_c[k];
                    wm.s_ctr[k] = '1;
                }
                if tgt_we[k] {
                    wd.s_tgt[k] = u.res.target[BTB_STGT_W - 1:1];
                    wm.s_tgt[k] = '1;
                }
            }
        }
        if alloc && x_br {
            wm.t_v = 1'b1;
        } else if x_jmp {
            wd.t_v   = 1'b1;
            wd.t_off = u.res.exit_foff;
            wd.t_knd = u.res.exit_kind;
            wd.t_tgt = u.res.target[BTB_TTGT_W - 1:1];
            wd.t_rvc = x_rvc;
            wm.t_v   = 1'b1;
            wm.t_off = '1;
            wm.t_knd = 3'b111 as CfiKind;
            wm.t_tgt = '1;
            wm.t_rvc = 1'b1;
        } else if t_inv {
            wm.t_v = 1'b1;
        }
    }

    // Every field of wm is all ones or all zeros, and a group is written
    // whole. The sweep writes every group with zeros.
    assign w_idx = if swp_q ? swi_q : u_idx;
    assign w_row = if swp_q ? 0 as BtbRow : wd;
    assign w_vt  = swp_q || wm.vld;
    assign w_tv  = swp_q || wm.t_v;
    assign w_tx  = swp_q || wm.t_off[0];
    always_comb {
        for k in 0..BP_SLOTS {
            w_sv[k] = swp_q || wm.s_v[k];
            w_so[k] = swp_q || wm.s_off[k][0];
            w_sc[k] = swp_q || wm.s_ctr[k][0];
            w_st[k] = swp_q || wm.s_tgt[k][0];
        }
    }

    // ---- Events ----

    let ev_x: logic       = u.valid && u.res.exit_v;
    let ev_d: logic  <64> = u.res.target ^ u.start_pc;
    let ev_j: logic       = ev_x && !x_br && !is_pop(u.res.exit_kind);
    var ev_q: BtbPerf    ;
    always_ff {
        if_reset {
            ev_q = 0 as BtbPerf;
        } else {
            ev_q.upd    = ev_x;
            ev_q.hit    = ev_x && um.hit;
            ev_q.x_br   = ev_x && x_br;
            ev_q.x_j    = ev_j;
            ev_q.far_br = {ev_d[63:20] != 0, ev_d[63:16] != 0, ev_d[63:14] != 0, ev_d[63:13] != 0, ev_d[63:12] != 0}
                & {ev_x && x_br repeat 5};
            ev_q.far_j  = {ev_d[63:32] != 0, ev_d[63:24] != 0, ev_d[63:20] != 0, ev_d[63:16] != 0, ev_d[63:13] != 0}
                & {ev_j repeat 5};
        }
    }
    assign o_ev = ev_q;
}
