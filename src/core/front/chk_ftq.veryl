// chk_ftq: observation-only invariant checker of the ftq pointers.
//
// Ports (timing contract):
//   i_*   : registered ftq pointers and the kill of the cycle
//   o_chk : sticky, set the cycle after a violation; never feeds the design
// Owns (checked):
//   - upd <= cm <= fetch <= tail in ring order (cm only once valid)
//   - a commit-backstop kill carries the commit entry as its keep entry
pub module chk_ftq::<CFG: core_cfg> (
    clk       : input  clock                      ,
    rst       : input  reset                      ,
    i_upd     : input  core_types::<CFG>::FtqTag  ,
    i_cm      : input  core_types::<CFG>::FtqTag  ,
    i_cm_v    : input  logic                      ,
    i_fetch   : input  core_types::<CFG>::FtqTag  ,
    i_tail    : input  core_types::<CFG>::FtqTag  ,
    i_kill    : input  core_types::<CFG>::Kill    ,
    i_redirect: input  core_types::<CFG>::Redirect,
    o_chk     : output logic                      ,
) {
    import core_types::<CFG>::*;

    // a <= b in ring order; b may be a full ring ahead (same index, wrap
    // flipped).
    function oe (
        a: input FtqTag,
        b: input FtqTag,
    ) -> logic {
        return tag_older_eq::<FTQ_TAG_W>(a, b) || (a.idx == b.idx && a.wrap != b.wrap);
    }

    let bad_order: logic = !oe(i_upd, i_tail) || !oe(i_fetch, i_tail)
        || (i_cm_v && (!oe(i_upd, i_cm) || !oe(i_cm, i_fetch)));
    let bad_cm   : logic = i_kill.valid && i_kill.full && i_redirect.kind == RedirKind::BR_CM
        && (!i_cm_v || i_redirect.ftq_keep != i_cm);

    var chk_q: logic;
    always_ff {
        if_reset {
            chk_q = 1'b0;
        } else if bad_order || bad_cm {
            chk_q = 1'b1;
        }
    }
    assign o_chk = chk_q;
}
