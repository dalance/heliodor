// bp_ras: speculative return address stack, the only speculative state of
// the M1 predictor.
//
// Ports (timing contract):
//   o_top/o_ckpt : combinational from registered state; o_ckpt is the state
//                  to restore for a block predicted with the current stack
//   i_op_*       : one predicted push/pop per cycle, applied at the edge;
//                  pop-then-push when both are set
//   i_rst_valid  : restore i_rst_ckpt, then apply i_rst_* the same way, at
//                  the edge; overrides i_op_* of the same cycle
// Owns:
//   - after a restore, the stack below and at the restored top equals what it
//     was when the checkpoint was taken, provided no more than BP_RAS_N - 1
//     pushes overwrote it in between
// Rationale:
//   - circular, one speculative copy, overflow overwrites the oldest entry;
//     the checkpoint is {tos, top value}, which repairs the one entry a
//     wrong-path push is likely to have clobbered
pub module bp_ras::<CFG: core_cfg> (
    clk        : input  clock                      ,
    rst        : input  reset                      ,
    o_top      : output logic                  <64>,
    o_ckpt     : output bpu_pkg::<CFG>::RasCkpt    ,
    i_op_push  : input  logic                      ,
    i_op_pop   : input  logic                      ,
    i_op_val   : input  logic                  <64>,
    i_rst_valid: input  logic                      ,
    i_rst_ckpt : input  bpu_pkg::<CFG>::RasCkpt    ,
    i_rst_push : input  logic                      ,
    i_rst_pop  : input  logic                      ,
    i_rst_val  : input  logic                  <64>,
) {
    import bpu_pkg::<CFG>::*;

    var stk_q: logic<64>        [BP_RAS_N];
    var tos_q: logic<RAS_IDX_W>           ;

    function inc (
        t: input logic<RAS_IDX_W>,
    ) -> logic<RAS_IDX_W> {
        return if t == BP_RAS_N - 1 ? 0 : t + 1;
    }
    function dec (
        t: input logic<RAS_IDX_W>,
    ) -> logic<RAS_IDX_W> {
        return if t == 0 ? BP_RAS_N - 1 : t - 1;
    }

    assign o_top      = stk_q[tos_q];
    assign o_ckpt.tos = tos_q;
    assign o_ckpt.top = stk_q[tos_q];

    // Base pointer, then the pointer after pop and after push.
    let base  : logic<RAS_IDX_W> = if i_rst_valid ? i_rst_ckpt.tos : tos_q;
    let push  : logic            = if i_rst_valid ? i_rst_push : i_op_push;
    let pop   : logic            = if i_rst_valid ? i_rst_pop : i_op_pop;
    let val   : logic<64>        = if i_rst_valid ? i_rst_val : i_op_val;
    let popped: logic<RAS_IDX_W> = if pop ? dec(base) : base;
    let pushed: logic<RAS_IDX_W> = if push ? inc(popped) : popped;

    // At most two writes: the restored top, and the pushed value.
    always_ff {
        if_reset {
            tos_q = 0;
        } else {
            tos_q = pushed;
        }
    }
    always_ff {
        for e in 0..BP_RAS_N {
            if push && pushed == e {
                stk_q[e] = val;
            } else if i_rst_valid && i_rst_ckpt.tos == e {
                stk_q[e] = i_rst_ckpt.top;
            }
        }
    }
}
