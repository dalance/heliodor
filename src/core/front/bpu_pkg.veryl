// bpu_pkg: sizes, latencies and the metadata layout of the predictor parts.
//
// Read only by bpu and its parts. Outside bpu the metadata and checkpoint are
// the opaque PredMeta/PredCkpt of the configured widths; LAYOUT_ERR is
// nonzero when the layouts below do not fill them exactly.
pub package bpu_pkg::<CFG: core_cfg> {
    import core_types::<CFG>::*;

    // bp_btb: block-indexed table with BP_SLOTS conditional slots and one
    // unconditional (tail) slot per entry. The sizes are untuned starting
    // values: 4096 entries, and a 16-bit tag for a false hit rate of about
    // 2^-16 per lookup. A false hit costs accuracy only (extract checks
    // every prediction).
    const BP_BTB_N : u32 = 4096;
    const BP_SLOTS : u32 = CFG::FETCH_W / 2 + 1; // 2 at 16-byte blocks, 3 at 32-byte blocks
    const BTB_LAT  : u32 = 1; // lookup at t, registered result at t + BTB_LAT
    const BTB_IDX_W: u32 = tag_pkg::idx_w(BP_BTB_N);
    const BTB_TAG_W: u32 = 16;

    // bp_ras: circular speculative return address stack.
    const BP_RAS_N : u32 = 8 * CFG::FETCH_W;
    const RAS_IDX_W: u32 = tag_pkg::idx_w(BP_RAS_N);

    // Per-slot state carried in the metadata.
    const SLOT_W: u32 = 1 + FOFF_W + 2;
    struct SlotMeta {
        v   : logic        ,
        foff: logic<FOFF_W>,
        ctr : logic<2>     , // 2-bit counter, taken when ctr[1]
    }

    // What the lookup saw, so that update rewrites only the fields it has to
    // and never reads the table again.
    struct BtbMeta {
        hit      : logic                  ,
        tail_v   : logic                  ,
        tail_foff: logic<FOFF_W>          ,
        slots    : logic<BP_SLOTS, SLOT_W>, // SlotMeta per conditional slot
    }
    const META_W: u32 = 2 + FOFF_W + BP_SLOTS * SLOT_W;

    // RAS state at block start.
    struct RasCkpt {
        tos: logic<RAS_IDX_W>,
        top: logic<64>       ,
    }
    const CKPT_W: u32 = RAS_IDX_W + 64;

    const LAYOUT_ERR: u32 = (if META_W != CFG::PRED_META_W ? 1 : 0) | (if CKPT_W != CFG::PRED_CKPT_W ? 2 : 0);

    // Return-address-stack action of an exit kind.
    function is_push (
        k: input CfiKind,
    ) -> logic {
        return k == CfiKind::JAL_CALL || k == CfiKind::JALR_CALL || k == CfiKind::JALR_RETCALL;
    }
    function is_pop (
        k: input CfiKind,
    ) -> logic {
        return k == CfiKind::JALR_RET || k == CfiKind::JALR_RETCALL;
    }
}
