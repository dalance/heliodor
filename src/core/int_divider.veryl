// Multi-cycle integer divider for RV64M DIV/DIVU/REM/REMU and W variants.
// Radix-2 restoring division: 64 cycles for 64-bit, 32 cycles for 32-bit W.
// Handles division by zero and signed overflow per RISC-V spec.
pub module int_divider (
    clk: input clock,
    rst: input reset,

    // Request interface
    i_valid : input logic    , // start new division
    i_a     : input logic<64>, // dividend
    i_b     : input logic<64>, // divisor
    i_signed: input logic    , // signed division (DIV/REM vs DIVU/REMU)
    i_rem   : input logic    , // 1 = remainder, 0 = quotient
    i_word  : input logic    , // 1 = 32-bit W variant
    i_flush : input logic    , // abort current operation

    // Result interface
    o_result: output logic<64>,
    o_valid : output logic    , // result ready (1-cycle pulse)
    o_busy  : output logic    , // divider occupied
) {
    enum State: logic<2> {
        IDLE = 2'd0,
        RUN = 2'd1,
        DONE = 2'd2,
    }

    var state   : State    ;
    var count   : logic<6> ; // iteration counter (0..63)
    var negate_q: logic    ; // negate quotient at end
    var negate_r: logic    ; // negate remainder at end
    var is_rem  : logic    ; // latched i_rem
    var is_word : logic    ; // latched i_word
    var dividend: logic<64>; // absolute dividend (shifted out during iteration)
    var divisor : logic<64>; // absolute divisor
    var quotient: logic<64>; // quotient built bit-by-bit
    var accum   : logic<64>; // accumulator (partial remainder)

    // Total iterations: 64 for doubleword, 32 for word
    var max_iter: logic<6>;

    // Busy only during RUN (not DONE — result is available during DONE)
    assign o_busy = state == State::RUN;

    always_ff (clk, rst) {
        if_reset {
            state    = State::IDLE;
            o_valid  = 1'b0;
            o_result = '0;
        } else if i_flush {
            state   = State::IDLE;
            o_valid = 1'b0;
        } else {
            o_valid = 1'b0; // default: pulse

            case state {
                State::IDLE: {
                    if i_valid {
                        // Operand preparation
                        let a64: logic<64> = if i_word ? {i_a[31] repeat 32, i_a[31:0]} : i_a;
                        let b64: logic<64> = if i_word ? {i_b[31] repeat 32, i_b[31:0]} : i_b;

                        // Division by zero: spec-defined result
                        if (i_word && i_b[31:0] == 32'd0) || (!i_word && i_b == 64'd0) {
                            o_valid  = 1'b1;
                            o_result = if i_rem ?
                                (if i_word ? {a64[31] repeat 32, a64[31:0]} : a64)
                            :
                                64'hFFFFFFFF_FFFFFFFF
                            ;
                            state    = State::IDLE;
                        }
                        // Signed overflow: -2^63 / -1 (or -2^31 / -1 for W)
                         else if i_signed
                            && ((!i_word && a64 == 64'h80000000_00000000 && b64 == 64'hFFFFFFFF_FFFFFFFF)
                                || (i_word && a64[31:0] == 32'h80000000 && b64[31:0] == 32'hFFFFFFFF)) {
                            o_valid  = 1'b1;
                            o_result = if i_rem ?
                                64'd0
                            : if i_word ?
                                {
                                    32'hFFFFFFFF, 32'h80000000
                                } // sign-extended -2^31
                            :
                                64'h80000000_00000000 // -2^63
                            ;
                            state    = State::IDLE;
                        } else {
                            // Compute absolute values for signed division
                            let a_neg: logic     = i_signed && a64[63];
                            let b_neg: logic     = i_signed && b64[63];
                            let abs_a: logic<64> = if a_neg ? (~a64 + 64'd1) : a64;
                            let abs_b: logic<64> = if b_neg ? (~b64 + 64'd1) : b64;

                            dividend = abs_a;
                            divisor  = abs_b;
                            quotient = '0;
                            accum    = '0;
                            negate_q = a_neg ^ b_neg;
                            negate_r = a_neg; // remainder sign = dividend sign
                            is_rem   = i_rem;
                            is_word  = i_word;
                            max_iter = if i_word ? 6'd31 : 6'd63;
                            count    = '0;
                            state    = State::RUN;
                        }
                    }
                }
                State::RUN: {
                    // Radix-2 restoring division: shift-subtract
                    // Shift accumulator left, bring in MSB of dividend
                    let bit_idx   : logic<6>  = max_iter - count;
                    let next_accum: logic<64> = {accum[62:0], dividend[bit_idx]};
                    if next_accum >: divisor || next_accum == divisor {
                        accum             = next_accum - divisor;
                        quotient[bit_idx] = 1'b1;
                    } else {
                        accum = next_accum;
                    }

                    if count == max_iter {
                        state = State::DONE;
                    } else {
                        count = count + 6'd1;
                    }
                }
                State::DONE: {
                    let raw_q   : logic<64> = if negate_q ? (~quotient + 64'd1) : quotient;
                    let raw_r   : logic<64> = if negate_r ? (~accum + 64'd1) : accum;
                    let raw     : logic<64> = if is_rem ? raw_r : raw_q;
                    o_result = if is_word ? {raw[31] repeat 32, raw[31:0]} : raw;
                    o_valid  = 1'b1;
                    state    = State::IDLE;
                }
                default: {
                    state = State::IDLE;
                }
            }
        }
    }
}
