// RV64I instruction decoder
// Decodes instruction into control signals for pipeline
pub module decoder (
    i_instr     : input  logic                <32>,
    o_alu_op    : output alu_pkg::AluOp           ,
    o_alu_src_a : output decode_pkg::AluSrcA    ,
    o_alu_src_b : output decode_pkg::AluSrcB    ,
    o_imm_type  : output riscv_pkg::ImmType       ,
    o_wb_sel    : output decode_pkg::WbSel      ,
    o_reg_wen   : output logic                    ,
    o_mem_ren   : output logic                    ,
    o_mem_wen   : output logic                    ,
    o_is_branch : output logic                    ,
    o_is_jal    : output logic                    ,
    o_is_jalr   : output logic                    ,
    o_is_ecall  : output logic                    ,
    o_is_ebreak : output logic                    ,
    o_is_mret   : output logic                    ,
    o_is_wfi    : output logic                    ,
    o_csr_op    : output csr_pkg::CsrOp           ,
    o_is_csr    : output logic                    ,
    o_csr_imm   : output logic                    ,
    o_illegal   : output logic                    ,
    o_is_amo    : output logic                    ,
    o_amo_funct5: output logic                <5> ,
    // FP extension outputs
    o_is_fp      : output logic            , // instruction uses FP register file
    o_fp_reg_wen : output logic            , // write result to FP register file
    o_fp_int_wen : output logic            , // FP op that writes to integer rd (FCMP, FMV.X, FCLASS)
    o_fpu_op     : output fpu_pkg::FpuOp   ,
    o_fp_rm      : output logic         <3>, // rounding mode from instruction
    o_fp_rs3_addr: output logic         <5>, // rs3 for FMADD family
    o_is_sfence  : output logic            , // SFENCE.VMA instruction
    o_is_fence_i : output logic            , // FENCE.I instruction
    o_is_fence   : output logic            , // FENCE (memory ordering) instruction
    o_is_cbo_zero: output logic            , // P10 Zicboz cbo.zero
    o_hlv        : output logic            , // Phase 11-H HLV/HLVX/HSV (guest 2-stage access)
    o_hlvx       : output logic            , // Phase 11-H HLVX.HU/.WU (execute-perm read)
    // Phase 12 V0: Vector extension (OP-V) decode outputs.
    o_is_vec         : output logic              , // any vector instruction
    o_vec_op         : output vector_pkg::VecOp  , // decoded vector operation
    o_vec_uses_scalar: output logic              , // reads int rs1 (vadd.vx, vset*vl AVL)
    o_vec_writes_int : output logic              , // writes int rd (vmv.x.s, vset*vl vl)
) {
    import riscv_pkg::*;
    import alu_pkg::AluOp;
    import decode_pkg::*;

    let opcode: logic<7> = i_instr[6:0];
    let funct3: logic<3> = i_instr[14:12];
    let funct7: logic<7> = i_instr[31:25];

    var alu_op    : AluOp            ;
    var alu_src_a : AluSrcA          ;
    var alu_src_b : AluSrcB          ;
    var imm_type  : ImmType          ;
    var wb_sel    : WbSel            ;
    var reg_wen   : logic            ;
    var mem_ren   : logic            ;
    var mem_wen   : logic            ;
    var is_branch : logic            ;
    var is_jal    : logic            ;
    var is_jalr   : logic            ;
    var is_ecall  : logic            ;
    var is_ebreak : logic            ;
    var is_mret   : logic            ;
    var is_wfi    : logic            ;
    var csr_op    : csr_pkg::CsrOp   ;
    var is_csr    : logic            ;
    var csr_imm   : logic            ;
    var illegal   : logic            ;
    var is_amo    : logic            ;
    var amo_funct5: logic         <5>;
    var is_fp     : logic            ;
    var is_sfence : logic            ;
    var is_fence_i: logic            ;
    var is_fence  : logic            ;
    var is_cbo_zero: logic           ;
    var hlv       : logic            ;
    var hlvx      : logic            ;
    var fp_reg_wen: logic            ;
    var fp_int_wen: logic            ;
    var fpu_op    : fpu_pkg::FpuOp   ;
    var fp_rm     : logic         <3>;
    // Phase 12 V0: Vector (OP-V) decode state.
    var is_vec         : logic            ;
    var vec_op         : vector_pkg::VecOp;
    var vec_uses_scalar: logic            ;
    var vec_writes_int : logic            ;

    let funct5: logic<5> = i_instr[31:27];
    let fmt   : logic<2> = i_instr[26:25]; // FP format: 00=S, 01=D
    let rs3   : logic<5> = i_instr[31:27]; // rs3 for FMADD family

    // Phase 10 (B extension): the shift-immediate / single-bit-immediate ops use
    // a 6-bit funct (inst[31:26]) since RV64 shamt is 6 bits; the unary ops
    // (clz/ctz/cpop/sext/orc.b/rev8) are tagged by the rs2 field (inst[24:20]).
    let funct6: logic<6> = i_instr[31:26];
    let rs2_f : logic<5> = i_instr[24:20];

    // Phase 12 V2a/V2b: supported integer funct6 set for OPIVV/VX/VI. The VU
    // sub-decodes the exact op from funct6:
    //   V2a arithmetic: add(000000)/sub(000010)/rsub(000011), minu(000100)/
    //   min(000101)/maxu(000110)/max(000111), and(001001)/or(001010)/xor(001011),
    //   sll(100101)/srl(101000)/sra(101001).
    //   V2b: merge/vmv.v (010111), integer compares (011xxx: vmseq/vmsne/vmsltu/
    //   vmslt/vmsleu/vmsle/vmsgtu/vmsgt) which write a mask register.
    // Widening/narrowing, fixed-point, … stay illegal until a later V2 sub-phase.
    let vec_ialu_ok: logic = funct6 == 6'b000000 || funct6 == 6'b000010 || funct6 == 6'b000011
        || funct6 == 6'b000100 || funct6 == 6'b000101 || funct6 == 6'b000110 || funct6 == 6'b000111
        || funct6 == 6'b001001 || funct6 == 6'b001010 || funct6 == 6'b001011
        || funct6 == 6'b100101 || funct6 == 6'b101000 || funct6 == 6'b101001
        || funct6 == 6'b010111 || funct6[5:3] == 3'b011;
    // V2c: OPMVV/OPMVX integer multiply/divide funct6 (contiguous 100xxx):
    //   vdivu(100000)/vdiv(100001)/vremu(100010)/vrem(100011),
    //   vmulhu(100100)/vmul(100101)/vmulhsu(100110)/vmulh(100111).
    let vec_imuldiv_ok: logic = funct6[5:3] == 3'b100;
    // V4b: OPMVV integer reductions (.vs, funct6 0000xx): vredsum/vredand/vredor/
    // vredxor/vredminu/vredmin/vredmaxu/vredmax. Routed to VFALU, which reuses the
    // element-serial reduction accumulator (folded combinationally for integers).
    let vec_ired_ok   : logic = funct6[5:3] == 3'b000;
    // V4c: OPMVV mask-register logical ops (.mm, funct6 011xxx): vmandn (011000) /
    // vmand (011001) / vmor (011010) / vmxor (011011) / vmorn (011100) / vmnand
    // (011101) / vmnor (011110) / vmxnor (011111).
    let vec_mlogic_ok : logic = funct6[5:3] == 3'b011;
    // V4e-1: OPMVV mask set-prefix ops (VMUNARY0, funct6 010100): vmsbf.m
    // (vs1=00001) / vmsof.m (vs1=00010) / vmsif.m (vs1=00011). A whole-register
    // mask→mask op (1 vreg, single-cycle) deriving a prefix mask from the first
    // active set bit. viota.m / vid.v (vs1=10000/10001) come in V4e-2.
    let vec_msetp_ok  : logic = funct6 == 6'b010100
        && (i_instr[19:15] == 5'b00001 || i_instr[19:15] == 5'b00010 || i_instr[19:15] == 5'b00011);
    // V4e-2: OPMVV viota.m (vs1=10000) / vid.v (vs1=10001), VMUNARY0 funct6
    // 010100. These write SEW elements across EMUL registers (register-serial).
    let vec_viota_ok  : logic = funct6 == 6'b010100
        && (i_instr[19:15] == 5'b10000 || i_instr[19:15] == 5'b10001);
    // V4f-1: OPIVX/OPIVI vector slide (funct6 001110 vslideup / 001111
    // vslidedown). The offset is x[rs1] (.vx) or uimm5 (.vi).
    let vec_slide_ok  : logic = funct6 == 6'b001110 || funct6 == 6'b001111;
    // V4f-3: vrgather (OPIVV/OPIVX/OPIVI funct6 001100). The index is vs1[i]
    // (.vv), x[rs1] (.vx), or uimm5 (.vi).
    let vec_rgather_ok: logic = funct6 == 6'b001100;
    // V4i-4: vrgatherei16.vv (OPIVV funct6 001110). Same as vrgather.vv but the
    // index vs1[i] is read as a 16-bit element regardless of SEW (the VU picks
    // the 16-bit index geometry from funct6). Only the .vv form exists — OPIVX/
    // OPIVI funct6 001110 is vslideup, routed separately by funct3.
    let vec_rgatherei16_ok: logic = funct6 == 6'b001110;
    // V4f-4: vcompress.vm (OPMVV funct6 010111). vs1 is the compress mask.
    let vec_compress_ok: logic = funct6 == 6'b010111;
    // V4g-1: OPIVV integer widening reduction vwredsumu (110000) / vwredsum
    // (110001). vd[0] (2*SEW) = vs1[0] + sum of (zero/sign-extended) vs2 elems.
    let vec_iwred_ok  : logic = funct6 == 6'b110000 || funct6 == 6'b110001;
    // V4g-2: OPFVV FP widening reduction vfwredusum (110001) / vfwredosum
    // (110011). vd[0] (2*SEW double) = vs1[0] + sum of s2d-widened vs2 elems.
    let vec_fwred_ok  : logic = funct6 == 6'b110001 || funct6 == 6'b110011;
    // V2d-4/V2d-6: OPMVV/OPMVX widening add/sub/mul + .w add/sub (result 2*SEW):
    //   vwaddu(110000)/vwadd(110001)/vwsubu(110010)/vwsub(110011),
    //   vwaddu.w(110100)/vwadd.w(110101)/vwsubu.w(110110)/vwsub.w(110111),
    //   vwmulu(111000)/vwmulsu(111010)/vwmul(111011). Widening multiply-
    //   accumulate (1111xx) stays illegal for now.
    let vec_iwiden_ok: logic = funct6 == 6'b110000 || funct6 == 6'b110001 || funct6 == 6'b110010 || funct6 == 6'b110011
        || funct6 == 6'b110100 || funct6 == 6'b110101 || funct6 == 6'b110110 || funct6 == 6'b110111
        || funct6 == 6'b111000 || funct6 == 6'b111010 || funct6 == 6'b111011;
    // V2d-5: OPIVV/VX/VI narrowing shifts (source 2*SEW → SEW result):
    //   vnsrl(101100)/vnsra(101101). vnclip{,u} (10111x) are fixed-point (V5).
    let vec_inarrow_ok: logic = funct6 == 6'b101100 || funct6 == 6'b101101;
    // V5a: OPIVV/VX/VI fixed-point saturating add/sub (funct6 1000xx):
    //   vsaddu(100000)/vsadd(100001)/vssubu(100010)/vssub(100011). The VU
    //   computes a saturated result (and the vxsat flag). funct6 1000xx is
    //   mul/div for OPMVV/OPMVX, so this only routes from the OPIV* paths.
    let vec_satadd_ok: logic = funct6[5:2] == 4'b1000;
    // V5b: OPMVV/OPMVX fixed-point averaging add/sub (funct6 0010xx):
    //   vaaddu(001000)/vaadd(001001)/vasubu(001010)/vasub(001011). The VU rounds
    //   the 1-bit right shift per vxrm. Only routes from the OPMV* paths.
    let vec_vaavg_ok: logic = funct6[5:2] == 4'b0010;
    // V5c: OPIVV/VX/VI scaling (rounding) right shift (funct6 10101x):
    //   vssrl(101010)/vssra(101011). The shift amount is vs1[i]/x[rs1]/uimm5;
    //   the VU rounds per vxrm. funct6[0] = arithmetic (vssra).
    let vec_vssh_ok: logic = funct6[5:1] == 5'b10101;
    // V5d: OPIVV/VX/VI narrowing clip (funct6 10111x = vnclipu/vnclip): rounds
    //   (vxrm) + saturates (vxsat) the 2*SEW source to SEW. funct6[0] = signed.
    let vec_vnclip_ok: logic = funct6[5:1] == 5'b10111;
    // V5e: OPIVV/OPIVX vsmul (funct6 100111): fractional saturating multiply.
    //   Only .vv/.vx (OPIVI 100111 is vmvr.v; OPMV* 100111 is vmulh).
    let vec_vsmul_ok: logic = funct6 == 6'b100111;
    // V3a: OPFVV vector FP arithmetic funct6 (vector-vector forms):
    //   vfadd(000000)/vfsub(000010), vfmin(000100)/vfmax(000110),
    //   vfsgnj(001000)/vfsgnjn(001001)/vfsgnjx(001010), vfmul(100100).
    //   FP compares, FMA, div/sqrt, conversions and the .vf forms are later V3 subs.
    // V3c adds vfdiv (100000), valid in both .vv and .vf.
    let vec_falu_ok: logic = funct6 == 6'b000000 || funct6 == 6'b000010
        || funct6 == 6'b000100 || funct6 == 6'b000110
        || funct6 == 6'b001000 || funct6 == 6'b001001 || funct6 == 6'b001010
        || funct6 == 6'b100100 || funct6 == 6'b100000;
    // V3b/V3c: OPFVF (.vf) adds vfrsub.vf (100111 = f[rs1] - vs2) and vfrdiv.vf
    // (100001 = f[rs1] / vs2); the rest share vec_falu_ok. The second operand is
    // the FP scalar f[rs1] (read from prf_fp).
    let vec_falu_vf_ok: logic = vec_falu_ok || funct6 == 6'b100111 || funct6 == 6'b100001;
    // V4a: FP reductions (OPFVV .vs only) — vfredusum (000001) / vfredosum (000011)
    // / vfredmin (000101) / vfredmax (000111). vd[0] = vs1[0] OP reduce(vs2[*]).
    let vec_fred_ok   : logic = funct6 == 6'b000001 || funct6 == 6'b000011
        || funct6 == 6'b000101 || funct6 == 6'b000111;
    // V3c: vfsqrt.v (OPFVV only) = VFUNARY1 (funct6 010011) with the vs1 field
    // (inst[19:15]) = 00000. Other VFUNARY1 sub-ops (vfrsqrt7/vfrec7/vfclass)
    // and the VFUNARY0 conversions are later V3 sub-phases.
    let vec_fsqrt_ok: logic = funct6 == 6'b010011 && i_instr[19:15] == 5'b00000;
    // V3d: FP compares (funct6 011xxx) → mask register. vmfeq(011000)/vmfle
    // (011001)/vmflt(011011)/vmfne(011100) are in both .vv and .vf; vmfgt(011101)
    // /vmfge(011111) are .vf-only (computed as f[rs1] </<= vs2, operands swapped).
    let vec_fcmp_ok   : logic = funct6 == 6'b011000 || funct6 == 6'b011001
        || funct6 == 6'b011011 || funct6 == 6'b011100;
    let vec_fcmp_vf_ok: logic = vec_fcmp_ok || funct6 == 6'b011101 || funct6 == 6'b011111;
    // V3e: vfmerge.vfm / vfmv.v.f (OPFVF funct6 010111) — per-element select of
    // the FP scalar f[rs1] vs vs2 (merge, vm=0) or f[rs1] broadcast (vmv.v.f,
    // vm=1). No FPU compute; the second operand is the FP scalar.
    let vec_fmerge_ok : logic = funct6 == 6'b010111;
    // V3g: vfcvt.* (OPFVV VFUNARY0 funct6 010010, same-width int<->FP). The vs1
    // field selects: 00000 xu.f / 00001 x.f / 00010 f.xu / 00011 f.x / 00110
    // rtz.xu.f / 00111 rtz.x.f. vfclass.v (VFUNARY1 010011, vs1=10000) returns
    // the 10-bit class mask. (vfsqrt.v is 010011 vs1=00000, handled above.)
    let vec_fcvt_ok   : logic = funct6 == 6'b010010 && (i_instr[19:15] == 5'b00000
        || i_instr[19:15] == 5'b00001 || i_instr[19:15] == 5'b00010 || i_instr[19:15] == 5'b00011
        || i_instr[19:15] == 5'b00110 || i_instr[19:15] == 5'b00111);
    // V3j: widening vfwcvt.* (VFUNARY0 010010, vs1[4:3]==01, SEW->2*SEW): 01000
    // xu.f / 01001 x.f / 01010 f.xu / 01011 f.x / 01100 f.f / 01110 rtz.xu.f /
    // 01111 rtz.x.f (01101 reserved).
    let vec_fwcvt_ok  : logic = funct6 == 6'b010010 && i_instr[19:18] == 2'b01
        && i_instr[17:15] != 3'b101;
    // V4h: narrowing convert vfncvt.* (VFUNARY0 010010, vs1[4:3]==10): xu.f (10000)
    // / x.f (10001) / f.xu (10010) / f.x (10011) / f.f (10100) / rod.f.f (10101) /
    // rtz.xu.f (10110) / rtz.x.f (10111). 2*SEW source -> SEW dest.
    let vec_fncvt_ok  : logic = funct6 == 6'b010010 && i_instr[19:18] == 2'b10;
    let vec_fclass_ok : logic = funct6 == 6'b010011 && i_instr[19:15] == 5'b10000;
    // V3j-4: vfrsqrt7.v (VFUNARY1 010011, vs1=00100) / vfrec7.v (vs1=00101) — the
    // 7-bit reciprocal-square-root / reciprocal estimates (OPFVV unary, same-width).
    let vec_fest_ok   : logic = funct6 == 6'b010011 && (i_instr[19:15] == 5'b00100 || i_instr[19:15] == 5'b00101);
    // V3h: FP fused multiply-add (funct6 101xxx), both .vv and .vf. funct6[2]
    // selects the multiplicand pairing (madd: vs1*vd / macc: vs1*vs2); funct6[1:0]
    // selects FMADD / FNMADD / FMSUB / FNMSUB. The accumulator reads the old vd.
    let vec_ffma_ok   : logic = funct6[5:3] == 3'b101;
    // V3i: widening FP add/sub/mul (.vv/.vf), result 2*SEW (single -> double):
    //   vfwadd (110000) / vfwsub (110010) / vfwmul (111000).
    // V3j: the .w forms vfwadd.w (110100) / vfwsub.w (110110) — vs2 is already
    //   2*SEW, only vs1 / f[rs1] is widened; and the widening FMAs vfwmacc/
    //   vfwnmacc/vfwmsac/vfwnmsac (1111xx). (Widening cvt is still later.)
    let vec_fwiden_ok : logic = funct6 == 6'b110000 || funct6 == 6'b110010 || funct6 == 6'b111000
        || funct6 == 6'b110100 || funct6 == 6'b110110 || funct6[5:2] == 4'b1111;

    always_comb {
        // Defaults
        alu_op     = AluOp::ADD;
        alu_src_a  = AluSrcA::REG;
        alu_src_b  = AluSrcB::IMM;
        imm_type   = ImmType::I_TYPE;
        wb_sel     = WbSel::ALU;
        reg_wen    = 1'b0;
        mem_ren    = 1'b0;
        mem_wen    = 1'b0;
        is_branch  = 1'b0;
        is_jal     = 1'b0;
        is_jalr    = 1'b0;
        is_ecall   = 1'b0;
        is_ebreak  = 1'b0;
        is_mret    = 1'b0;
        is_wfi     = 1'b0;
        csr_op     = csr_pkg::CsrOp::RW;
        is_csr     = 1'b0;
        csr_imm    = 1'b0;
        illegal    = 1'b0;
        is_amo     = 1'b0;
        amo_funct5 = 5'd0;
        is_fp      = 1'b0;
        is_sfence  = 1'b0;
        is_fence_i = 1'b0;
        is_fence   = 1'b0;
        is_cbo_zero = 1'b0;
        hlv        = 1'b0;
        hlvx       = 1'b0;
        fp_reg_wen = 1'b0;
        fp_int_wen = 1'b0;
        fpu_op     = fpu_pkg::FpuOp::NONE;
        fp_rm      = i_instr[14:12];
        is_vec          = 1'b0;
        vec_op          = vector_pkg::VecOp::NONE;
        vec_uses_scalar = 1'b0;
        vec_writes_int  = 1'b0;

        case opcode as Opcode {
            // LUI: rd = imm << 12
            Opcode::LUI: {
                alu_op    = AluOp::ADD;
                alu_src_a = AluSrcA::ZERO;
                alu_src_b = AluSrcB::IMM;
                imm_type  = ImmType::U_TYPE;
                reg_wen   = 1'b1;
            }
            // AUIPC: rd = PC + (imm << 12)
            Opcode::AUIPC: {
                alu_op    = AluOp::ADD;
                alu_src_a = AluSrcA::PC;
                alu_src_b = AluSrcB::IMM;
                imm_type  = ImmType::U_TYPE;
                reg_wen   = 1'b1;
            }
            // JAL: rd = PC+4, PC = PC + imm
            Opcode::JAL: {
                is_jal   = 1'b1;
                wb_sel   = WbSel::PC4;
                reg_wen  = 1'b1;
                imm_type = ImmType::J_TYPE;
            }
            // JALR: rd = PC+4, PC = (rs1 + imm) & ~1
            Opcode::JALR: {
                is_jalr   = 1'b1;
                alu_src_a = AluSrcA::REG;
                alu_src_b = AluSrcB::IMM;
                alu_op    = AluOp::ADD;
                wb_sel    = WbSel::PC4;
                reg_wen   = 1'b1;
                imm_type  = ImmType::I_TYPE;
            }
            // BRANCH: BEQ/BNE/BLT/BGE/BLTU/BGEU
            Opcode::BRANCH: {
                is_branch = 1'b1;
                alu_src_a = AluSrcA::REG;
                alu_src_b = AluSrcB::REG;
                imm_type  = ImmType::B_TYPE;
            }
            // LOAD: LB/LH/LW/LD/LBU/LHU/LWU
            Opcode::LOAD: {
                alu_op    = AluOp::ADD;
                alu_src_a = AluSrcA::REG;
                alu_src_b = AluSrcB::IMM;
                imm_type  = ImmType::I_TYPE;
                wb_sel    = WbSel::MEM;
                reg_wen   = 1'b1;
                mem_ren   = 1'b1;
            }
            // STORE: SB/SH/SW/SD
            Opcode::STORE: {
                alu_op    = AluOp::ADD;
                alu_src_a = AluSrcA::REG;
                alu_src_b = AluSrcB::IMM;
                imm_type  = ImmType::S_TYPE;
                mem_wen   = 1'b1;
            }
            // OP_IMM: ADDI/SLTI/SLTIU/XORI/ORI/ANDI/SLLI/SRLI/SRAI
            //   + B extension Zbb unary (clz/ctz/cpop/sext.b/sext.h/orc.b/rev8),
            //     rori, and Zbs immediate (bclri/bexti/binvi/bseti).
            Opcode::OP_IMM: {
                alu_src_a = AluSrcA::REG;
                alu_src_b = AluSrcB::IMM;
                imm_type  = ImmType::I_TYPE;
                reg_wen   = 1'b1;
                case funct3 as AluFunct3 {
                    AluFunct3::ADD_SUB: alu_op = AluOp::ADD;
                    AluFunct3::SLT    : alu_op = AluOp::SLT;
                    AluFunct3::SLTU   : alu_op = AluOp::SLTU;
                    AluFunct3::XOR    : alu_op = AluOp::XOR;
                    AluFunct3::OR     : alu_op = AluOp::OR;
                    AluFunct3::AND    : alu_op = AluOp::AND;
                    AluFunct3::SLL    : {
                        if funct6 == 6'b000000 {
                            alu_op = AluOp::SLL; // SLLI
                        } else if i_instr[31:25] == 7'b0110000 {
                            // Zbb unary: clz / ctz / cpop / sext.b / sext.h
                            case rs2_f {
                                5'b00000: alu_op  = AluOp::CLZ;
                                5'b00001: alu_op  = AluOp::CTZ;
                                5'b00010: alu_op  = AluOp::CPOP;
                                5'b00100: alu_op  = AluOp::SEXT_B;
                                5'b00101: alu_op  = AluOp::SEXT_H;
                                default : illegal = 1'b1;
                            }
                        } else if funct6 == 6'b010010 {
                            alu_op = AluOp::BCLR; // BCLRI
                        } else if funct6 == 6'b011010 {
                            alu_op = AluOp::BINV; // BINVI
                        } else if funct6 == 6'b001010 {
                            alu_op = AluOp::BSET; // BSETI
                        } else {
                            illegal = 1'b1;
                        }
                    }
                    AluFunct3::SRL_SRA: {
                        if funct6 == 6'b000000 {
                            alu_op = AluOp::SRL; // SRLI
                        } else if funct6 == 6'b010000 {
                            alu_op = AluOp::SRA; // SRAI
                        } else if funct6 == 6'b011000 {
                            alu_op = AluOp::ROR; // RORI
                        } else if funct6 == 6'b010010 {
                            alu_op = AluOp::BEXT; // BEXTI
                        } else if i_instr[31:20] == 12'b0010100_00111 {
                            alu_op = AluOp::ORC_B;
                        } else if i_instr[31:20] == 12'b0110101_11000 {
                            alu_op = AluOp::REV8;
                        } else {
                            illegal = 1'b1;
                        }
                    }
                    default: alu_op = AluOp::ADD;
                }
            }
            // OP: ADD/SUB/SLL/SLT/SLTU/XOR/SRL/SRA/OR/AND + M extension
            //     + B extension Zba (sh{1,2,3}add) / Zbb (andn/orn/xnor,
            //       min/max, rol/ror) / Zbs (bclr/bext/binv/bset).
            Opcode::OP: {
                alu_src_a = AluSrcA::REG;
                alu_src_b = AluSrcB::REG;
                reg_wen   = 1'b1;
                case funct7 {
                    7'b0000000: {
                        case funct3 {
                            3'b000 : alu_op = AluOp::ADD;
                            3'b001 : alu_op = AluOp::SLL;
                            3'b010 : alu_op = AluOp::SLT;
                            3'b011 : alu_op = AluOp::SLTU;
                            3'b100 : alu_op = AluOp::XOR;
                            3'b101 : alu_op = AluOp::SRL;
                            3'b110 : alu_op = AluOp::OR;
                            3'b111 : alu_op = AluOp::AND;
                            default: alu_op = AluOp::ADD;
                        }
                    }
                    7'b0100000: {
                        case funct3 {
                            3'b000 : alu_op  = AluOp::SUB;
                            3'b101 : alu_op  = AluOp::SRA;
                            3'b100 : alu_op  = AluOp::XNOR; // Zbb
                            3'b110 : alu_op  = AluOp::ORN; // Zbb
                            3'b111 : alu_op  = AluOp::ANDN; // Zbb
                            default: illegal = 1'b1;
                        }
                    }
                    7'b0000001: {
                        // M extension: MUL/MULH/MULHSU/MULHU/DIV/DIVU/REM/REMU
                        case funct3 {
                            3'b000 : alu_op = AluOp::MUL;
                            3'b001 : alu_op = AluOp::MULH;
                            3'b010 : alu_op = AluOp::MULHSU;
                            3'b011 : alu_op = AluOp::MULHU;
                            3'b100 : alu_op = AluOp::DIV;
                            3'b101 : alu_op = AluOp::DIVU;
                            3'b110 : alu_op = AluOp::REM;
                            3'b111 : alu_op = AluOp::REMU;
                            default: alu_op = AluOp::ADD;
                        }
                    }
                    7'b0010000: {
                        // Zba: sh1add / sh2add / sh3add
                        case funct3 {
                            3'b010 : alu_op  = AluOp::SH1ADD;
                            3'b100 : alu_op  = AluOp::SH2ADD;
                            3'b110 : alu_op  = AluOp::SH3ADD;
                            default: illegal = 1'b1;
                        }
                    }
                    7'b0000101: {
                        // Zbb: min / minu / max / maxu
                        case funct3 {
                            3'b100 : alu_op  = AluOp::MIN;
                            3'b101 : alu_op  = AluOp::MINU;
                            3'b110 : alu_op  = AluOp::MAX;
                            3'b111 : alu_op  = AluOp::MAXU;
                            default: illegal = 1'b1;
                        }
                    }
                    7'b0110000: {
                        // Zbb: rol / ror
                        case funct3 {
                            3'b001 : alu_op  = AluOp::ROL;
                            3'b101 : alu_op  = AluOp::ROR;
                            default: illegal = 1'b1;
                        }
                    }
                    7'b0100100: {
                        // Zbs: bclr / bext
                        case funct3 {
                            3'b001 : alu_op  = AluOp::BCLR;
                            3'b101 : alu_op  = AluOp::BEXT;
                            default: illegal = 1'b1;
                        }
                    }
                    7'b0110100: {
                        // Zbs: binv
                        case funct3 {
                            3'b001 : alu_op  = AluOp::BINV;
                            default: illegal = 1'b1;
                        }
                    }
                    7'b0010100: {
                        // Zbs: bset
                        case funct3 {
                            3'b001 : alu_op  = AluOp::BSET;
                            default: illegal = 1'b1;
                        }
                    }
                    7'b0000111: {
                        // Zicond: czero.eqz / czero.nez
                        case funct3 {
                            3'b101 : alu_op  = AluOp::CZERO_EQZ;
                            3'b111 : alu_op  = AluOp::CZERO_NEZ;
                            default: illegal = 1'b1;
                        }
                    }
                    default: illegal = 1'b1;
                }
            }
            // OP_IMM_32: ADDIW/SLLIW/SRLIW/SRAIW
            //   + B extension Zba slli.uw, Zbb clzw/ctzw/cpopw, roriw.
            Opcode::OP_IMM_32: {
                alu_src_a = AluSrcA::REG;
                alu_src_b = AluSrcB::IMM;
                imm_type  = ImmType::I_TYPE;
                reg_wen   = 1'b1;
                case funct3 as AluFunct3 {
                    AluFunct3::ADD_SUB: alu_op = AluOp::ADDW;
                    AluFunct3::SLL    : {
                        if funct6 == 6'b000010 {
                            alu_op = AluOp::SLLI_UW; // Zba slli.uw (6-bit shamt)
                        } else if i_instr[31:25] == 7'b0110000 {
                            // Zbb word unary: clzw / ctzw / cpopw
                            case rs2_f {
                                5'b00000: alu_op  = AluOp::CLZW;
                                5'b00001: alu_op  = AluOp::CTZW;
                                5'b00010: alu_op  = AluOp::CPOPW;
                                default : illegal = 1'b1;
                            }
                        } else {
                            alu_op = AluOp::SLLW; // SLLIW
                        }
                    }
                    AluFunct3::SRL_SRA: {
                        if funct6 == 6'b011000 {
                            alu_op = AluOp::RORW; // RORIW
                        } else if funct7[5] {
                            alu_op = AluOp::SRAW; // SRAIW
                        } else {
                            alu_op = AluOp::SRLW; // SRLIW
                        }
                    }
                    default: alu_op = AluOp::ADDW;
                }
            }
            // OP_32: ADDW/SUBW/SLLW/SRLW/SRAW + M extension W-variants
            //   + B extension Zba (add.uw / sh{1,2,3}add.uw), Zbb (zext.h,
            //     rolw/rorw).
            Opcode::OP_32: {
                alu_src_a = AluSrcA::REG;
                alu_src_b = AluSrcB::REG;
                reg_wen   = 1'b1;
                case funct7 {
                    7'b0000001: {
                        // M extension W: MULW/DIVW/DIVUW/REMW/REMUW
                        case funct3 {
                            3'b000 : alu_op = AluOp::MULW;
                            3'b100 : alu_op = AluOp::DIVW;
                            3'b101 : alu_op = AluOp::DIVUW;
                            3'b110 : alu_op = AluOp::REMW;
                            3'b111 : alu_op = AluOp::REMUW;
                            default: alu_op = AluOp::ADDW;
                        }
                    }
                    7'b0000100: {
                        // Zba add.uw / Zbb zext.h
                        case funct3 {
                            3'b000 : alu_op  = AluOp::ADD_UW;
                            3'b100 : alu_op  = AluOp::ZEXT_H;
                            default: illegal = 1'b1;
                        }
                    }
                    7'b0010000: {
                        // Zba sh1add.uw / sh2add.uw / sh3add.uw
                        case funct3 {
                            3'b010 : alu_op  = AluOp::SH1ADD_UW;
                            3'b100 : alu_op  = AluOp::SH2ADD_UW;
                            3'b110 : alu_op  = AluOp::SH3ADD_UW;
                            default: illegal = 1'b1;
                        }
                    }
                    7'b0110000: {
                        // Zbb rolw / rorw
                        case funct3 {
                            3'b001 : alu_op  = AluOp::ROLW;
                            3'b101 : alu_op  = AluOp::RORW;
                            default: illegal = 1'b1;
                        }
                    }
                    default: {
                        // base: addw/subw/sllw/srlw/sraw
                        case funct3 as AluFunct3 {
                            AluFunct3::ADD_SUB: alu_op = if funct7[5] ? AluOp::SUBW : AluOp::ADDW;
                            AluFunct3::SLL    : alu_op = AluOp::SLLW;
                            AluFunct3::SRL_SRA: alu_op = if funct7[5] ? AluOp::SRAW : AluOp::SRLW;
                            default           : alu_op = AluOp::ADDW;
                        }
                    }
                }
            }
            // AMO: LR/SC/AMO{SWAP,ADD,XOR,AND,OR,MIN,MAX,MINU,MAXU}
            // AMO address = rs1, rs2 = data operand
            // alu_out is overridden in execute stage to use rs1 directly
            Opcode::AMO: {
                alu_src_a  = AluSrcA::REG;
                alu_src_b  = AluSrcB::REG;
                reg_wen    = 1'b1;
                is_amo     = 1'b1;
                amo_funct5 = funct5;
                if funct5 == 5'b00010 {
                    // LR.W / LR.D: load-reserved
                    mem_ren = 1'b1;
                    wb_sel  = WbSel::MEM;
                } else if funct5 == 5'b00011 {
                    // SC.W / SC.D: store-conditional
                    mem_wen = 1'b1;
                    wb_sel  = WbSel::ALU; // SC result (0=success, 1=fail) via alu_out
                } else {
                    // AMO: read-modify-write
                    mem_ren = 1'b1;
                    mem_wen = 1'b1;
                    wb_sel  = WbSel::MEM; // old memory value to rd
                }
            }
            // MISC_MEM (FENCE/FENCE.I/CMO)
            Opcode::MISC_MEM: {
                if funct3 == 3'b001 {
                    // FENCE.I: instruction cache flush
                    is_fence_i = 1'b1;
                } else if funct3 == 3'b000 {
                    if i_instr == 32'h0100000F {
                        // PAUSE (Zihintpause): a HINT encoded as a FENCE with
                        // pred=W, succ=(empty). Its empty successor set orders
                        // nothing, so treat it as a plain NOP rather than as
                        // heliodor's load-ordering barrier — avoids a needless
                        // pipeline drain in spin-wait loops.
                    } else {
                        // FENCE: memory ordering — required for SMP RVWMO
                        // (smp_store_release / smp_load_acquire / smp_mb).
                        // Pipeline drains store buffer + waits for ROB empty
                        // before retiring (gated in heliodor_core).
                        is_fence = 1'b1;
                    }
                } else if funct3 == 3'b010 {
                    // P10 Zicbom/Zicboz: cbo.* — funct12 in inst[31:20].
                    //   0x004 cbo.zero  → zero the block (store-class, rs1 = addr)
                    //   0x000/1/2 cbo.inval/clean/flush → legal no-ops: in this
                    //     coherent write-back design the L1 is kept consistent
                    //     with the L2/memory by hardware, so these hints need no
                    //     action (no observable effect without a non-coherent agent).
                    case i_instr[31:20] {
                        12'h004: {
                            is_cbo_zero = 1'b1;
                            alu_op      = AluOp::ADD; // address = rs1 + 0
                            alu_src_a   = AluSrcA::REG;
                            alu_src_b   = AluSrcB::IMM;
                            mem_wen     = 1'b1; // route through the store AGU/MMU
                        }
                        12'h000, 12'h001, 12'h002: {} // cbo.inval/clean/flush: no-op
                        default : illegal = 1'b1;
                    }
                }
            }
            // SYSTEM: ECALL/EBREAK/MRET/CSR
            Opcode::SYSTEM: {
                if funct3 == 3'b000 {
                    // ECALL/EBREAK/MRET (funct3=000)
                    if i_instr[31:20] == 12'h000 {
                        is_ecall = 1'b1;
                    } else if i_instr[31:20] == 12'h001 {
                        is_ebreak = 1'b1;
                    } else if i_instr[31:20] == 12'h302 {
                        // MRET
                        is_mret = 1'b1;
                    } else if i_instr[31:20] == 12'h102 {
                        // SRET (reuses is_mret flag, distinguished by csr_addr in top)
                        is_mret = 1'b1;
                    } else if i_instr[31:20] == 12'h105 {
                        // WFI: halt fetch until IRQ pending (handled in core)
                        is_wfi = 1'b1;
                    } else if i_instr[31:25] == 7'b0001001 {
                        // SFENCE.VMA: flush TLB
                        is_sfence = 1'b1;
                    } else if i_instr[31:25] == 7'b0001011 {
                        // P10 Svinval SINVAL.VMA: a fine-grained TLB invalidate.
                        // heliodor flushes the whole TLB on SFENCE.VMA, so the
                        // same path is a correct (conservative) implementation —
                        // rs1 (VA) / rs2 (ASID) carry the same operands.
                        is_sfence = 1'b1;
                    } else if i_instr[31:20] == 12'h180 || i_instr[31:20] == 12'h181 {
                        // P10 Svinval SFENCE.W.INVAL (0x180) / SFENCE.INVAL.IR
                        // (0x181): ordering fences that bracket a SINVAL.VMA
                        // batch. Since SINVAL.VMA here is a full flush, the batch
                        // ordering is irrelevant → accept as NOPs.
                    } else if i_instr[31:20] == 12'h00d || i_instr[31:20] == 12'h01d {
                        // P10 Zawrs WRS.NTO (0x00d) / WRS.STO (0x01d): wait-on-
                        // reservation-set. The spec permits terminating the wait
                        // for any reason (incl. immediately), so a NOP is a
                        // compliant implementation; the software re-checks its
                        // condition in the surrounding loop.
                    } else if i_instr[31:25] == 7'b0010001 || i_instr[31:25] == 7'b0110001 {
                        // Phase 11-H HFENCE.VVMA (funct7=0010001) / HFENCE.GVMA
                        // (funct7=0110001): flush a guest's VS-stage / G-stage TLB
                        // entries. The V=1 two-stage TLB (mmu.veryl) now caches
                        // guest GVA->HPA translations, so HFENCE must flush it.
                        // Route through is_sfence: at the MMU, any i_sfence does a
                        // full V=1 flush (plus the existing selective V=0 flush — a
                        // harmless over-flush of the host TLB on a rare HFENCE).
                        // (mstatus.TVM does not trap HFENCE per spec; the commit-
                        // time TVM trap keys off is_sfence too, but it is gated on
                        // csr_tvm — which our M-mode firmware never sets — so this
                        // shared path is inert in practice.)
                        is_sfence = 1'b1;
                    }
                } else if funct3 == 3'b100 {
                    // Phase 11-H HLV / HLVX / HSV — hypervisor virtual-memory
                    // accesses (SYSTEM, funct3=100, funct7=0110xxx → inst[31:28]=
                    // 0110). They behave as a load/store whose effective address
                    // is rs1 (no immediate offset) and whose translation runs
                    // through the guest's two-stage MMU (driven by the hlv flag in
                    // the core). inst[25]=funct7[0] selects store(1)/load(0); the
                    // size (B/H/W/D) is funct7[2:1]=inst[27:26], decoded into
                    // mem_funct3 in decode.veryl. HLVX (load, rs2 field = 00011)
                    // checks execute permission on the read. These do not collide
                    // with Zimop below: every MOP has inst[31]=1.
                    if i_instr[31:28] == 4'b0110 {
                        hlv       = 1'b1;
                        alu_op    = AluOp::ADD;
                        alu_src_a = AluSrcA::REG;
                        alu_src_b = AluSrcB::IMM;
                        if i_instr[25] == 1'b0 {
                            // HLV / HLVX: load (writes rd, reads rs1 base).
                            mem_ren = 1'b1;
                            reg_wen = 1'b1;
                            wb_sel  = WbSel::MEM;
                            hlvx    = i_instr[24:20] == 5'b00011;
                        } else {
                            // HSV: store (reads rs1 base + rs2 data, no rd).
                            mem_wen  = 1'b1;
                            imm_type = ImmType::S_TYPE;
                        }
                    // Zimop: MOP.R.n / MOP.RR.n — "may be operations". When no
                    // extension claims them, they simply write 0 to rd (reading
                    // no source). Patterns (SYSTEM, funct3=100):
                    //   MOP.R.n : inst[31]=1, inst[29:28]=00, inst[25:22]=0111
                    //   MOP.RR.n: inst[31]=1, inst[29:28]=00, inst[25]=1
                    // The n index bits (30/27/26[/21/20]) are don't-care here —
                    // every MOP has the same default behaviour.
                    } else if i_instr[31] == 1'b1 && i_instr[29:28] == 2'b00 && (i_instr[25:22] == 4'b0111 || i_instr[25] == 1'b1) {
                        // rd = 0 & imm = 0; src A forced to zero, no register read.
                        alu_op    = AluOp::AND;
                        alu_src_a = AluSrcA::ZERO;
                        alu_src_b = AluSrcB::IMM;
                        reg_wen   = 1'b1;
                    } else {
                        illegal = 1'b1;
                    }
                } else {
                    // CSR instructions (funct3 in {001,010,011,101,110,111})
                    is_csr  = 1'b1;
                    reg_wen = 1'b1; // CSR reads write to rd
                    wb_sel  = WbSel::ALU; // CSR read goes through ALU result path
                    case funct3[1:0] {
                        2'b01  : csr_op = csr_pkg::CsrOp::RW;
                        2'b10  : csr_op = csr_pkg::CsrOp::RS;
                        2'b11  : csr_op = csr_pkg::CsrOp::RC;
                        default: {}
                    }
                    // funct3[2] selects immediate vs register source
                    csr_imm = funct3[2];
                }
            }
            // FP Load: FLW (funct3=010) / FLD (funct3=011) — and, sharing this
            // major opcode, the Phase 12 V1 unit-stride VECTOR loads. The width
            // field (funct3) disambiguates: scalar FP uses 001/010/011/100
            // (FLH/FLW/FLD/FLQ), while a vector EEW is 000/101/110/111 (8/16/32/64).
            Opcode::LOAD_FP: {
                if funct3 == 3'b000 || (funct3[2] && funct3[1:0] != 2'b00) {
                    // Vector load. Unit-stride family (mop = inst[27:26] = 00,
                    // mew = inst[28] = 0); the lumop field (inst[24:20]) selects the
                    // variant, which the VU re-decodes:
                    //   00000 (nf=0)       = unit-stride    (vle<eew>.v)
                    //   01011 (nf=0)       = mask           (vlm.v, EEW=8)
                    //   01000 (nf=0/1/3/7) = whole-register (vl<nreg>re<eew>.v)
                    // Strided / indexed / segment / fault-only-first are deferred
                    // and decode illegal until implemented.
                    is_vec = 1'b1;
                    if i_instr[27:26] == 2'b00 && i_instr[28] == 1'b0 && ((i_instr[24:20] == 5'b00000 && i_instr[31:29] == 3'b000) || (i_instr[24:20] == 5'b01011 && i_instr[31:29] == 3'b000) || (i_instr[24:20] == 5'b01000 && (i_instr[31:29] == 3'b000 || i_instr[31:29] == 3'b001 || i_instr[31:29] == 3'b011 || i_instr[31:29] == 3'b111))) {
                        vec_op          = vector_pkg::VecOp::VLE;
                        vec_uses_scalar = 1'b1; // base = x[rs1]
                    } else {
                        illegal = 1'b1;
                    }
                } else {
                    is_fp      = 1'b1;
                    alu_op     = AluOp::ADD;
                    alu_src_a  = AluSrcA::REG;
                    alu_src_b  = AluSrcB::IMM;
                    imm_type   = ImmType::I_TYPE;
                    wb_sel     = WbSel::MEM;
                    fp_reg_wen = 1'b1;
                    mem_ren    = 1'b1;
                }
            }
            // FP Store: FSW (funct3=010) / FSD (funct3=011) — and the Phase 12 V1
            // unit-stride VECTOR stores (width field disambiguates, as for loads).
            Opcode::STORE_FP: {
                if funct3 == 3'b000 || (funct3[2] && funct3[1:0] != 2'b00) {
                    // Vector store. The store-data vector vs3 is in the rd field
                    // (inst[11:7]); the base is x[rs1]. Unit-stride family, with the
                    // sumop field (inst[24:20]) selecting the variant the VU
                    // re-decodes: 00000 = unit-stride (vse), 01011 = mask (vsm.v,
                    // EEW=8), 01000 (nf=0/1/3/7) = whole-register (vs<nreg>r.v).
                    is_vec = 1'b1;
                    if i_instr[27:26] == 2'b00 && i_instr[28] == 1'b0 && ((i_instr[24:20] == 5'b00000 && i_instr[31:29] == 3'b000) || (i_instr[24:20] == 5'b01011 && i_instr[31:29] == 3'b000) || (i_instr[24:20] == 5'b01000 && (i_instr[31:29] == 3'b000 || i_instr[31:29] == 3'b001 || i_instr[31:29] == 3'b011 || i_instr[31:29] == 3'b111))) {
                        vec_op          = vector_pkg::VecOp::VSE;
                        vec_uses_scalar = 1'b1; // base = x[rs1]
                    } else {
                        illegal = 1'b1;
                    }
                } else {
                    is_fp     = 1'b1;
                    alu_op    = AluOp::ADD;
                    alu_src_a = AluSrcA::REG;
                    alu_src_b = AluSrcB::IMM;
                    imm_type  = ImmType::S_TYPE;
                    mem_wen   = 1'b1;
                }
            }
            // OP-FP: arithmetic, comparison, conversion, move
            Opcode::OP_FP: {
                is_fp = 1'b1;
                case funct7 {
                    // FADD.S / FADD.D
                    7'b0000000: {
                        fp_reg_wen = 1'b1;
                        fpu_op     = fpu_pkg::FpuOp::FADD_S;
                    }
                    7'b0000001: {
                        fp_reg_wen = 1'b1;
                        fpu_op     = fpu_pkg::FpuOp::FADD_D;
                    }
                    // FSUB.S / FSUB.D
                    7'b0000100: {
                        fp_reg_wen = 1'b1;
                        fpu_op     = fpu_pkg::FpuOp::FSUB_S;
                    }
                    7'b0000101: {
                        fp_reg_wen = 1'b1;
                        fpu_op     = fpu_pkg::FpuOp::FSUB_D;
                    }
                    // FMUL.S / FMUL.D
                    7'b0001000: {
                        fp_reg_wen = 1'b1;
                        fpu_op     = fpu_pkg::FpuOp::FMUL_S;
                    }
                    7'b0001001: {
                        fp_reg_wen = 1'b1;
                        fpu_op     = fpu_pkg::FpuOp::FMUL_D;
                    }
                    // FDIV.S / FDIV.D
                    7'b0001100: {
                        fp_reg_wen = 1'b1;
                        fpu_op     = fpu_pkg::FpuOp::FDIV_S;
                    }
                    7'b0001101: {
                        fp_reg_wen = 1'b1;
                        fpu_op     = fpu_pkg::FpuOp::FDIV_D;
                    }
                    // FSQRT.S / FSQRT.D
                    7'b0101100: {
                        fp_reg_wen = 1'b1;
                        fpu_op     = fpu_pkg::FpuOp::FSQRT_S;
                    }
                    7'b0101101: {
                        fp_reg_wen = 1'b1;
                        fpu_op     = fpu_pkg::FpuOp::FSQRT_D;
                    }
                    // FSGNJ / FSGNJN / FSGNJX (.S and .D)
                    7'b0010000: {
                        fp_reg_wen = 1'b1;
                        case funct3 {
                            3'b000 : fpu_op  = fpu_pkg::FpuOp::FSGNJ_S;
                            3'b001 : fpu_op  = fpu_pkg::FpuOp::FSGNJN_S;
                            3'b010 : fpu_op  = fpu_pkg::FpuOp::FSGNJX_S;
                            default: illegal = 1'b1;
                        }
                    }
                    7'b0010001: {
                        fp_reg_wen = 1'b1;
                        case funct3 {
                            3'b000 : fpu_op  = fpu_pkg::FpuOp::FSGNJ_D;
                            3'b001 : fpu_op  = fpu_pkg::FpuOp::FSGNJN_D;
                            3'b010 : fpu_op  = fpu_pkg::FpuOp::FSGNJX_D;
                            default: illegal = 1'b1;
                        }
                    }
                    // FMIN / FMAX (.S and .D) + P10 Zfa FMINM / FMAXM (funct3 010/011)
                    7'b0010100: {
                        fp_reg_wen = 1'b1;
                        case funct3 {
                            3'b000 : fpu_op  = fpu_pkg::FpuOp::FMIN_S;
                            3'b001 : fpu_op  = fpu_pkg::FpuOp::FMAX_S;
                            3'b010 : fpu_op  = fpu_pkg::FpuOp::FMINM_S; // Zfa
                            3'b011 : fpu_op  = fpu_pkg::FpuOp::FMAXM_S; // Zfa
                            default: illegal = 1'b1;
                        }
                    }
                    7'b0010101: {
                        fp_reg_wen = 1'b1;
                        case funct3 {
                            3'b000 : fpu_op  = fpu_pkg::FpuOp::FMIN_D;
                            3'b001 : fpu_op  = fpu_pkg::FpuOp::FMAX_D;
                            3'b010 : fpu_op  = fpu_pkg::FpuOp::FMINM_D; // Zfa
                            3'b011 : fpu_op  = fpu_pkg::FpuOp::FMAXM_D; // Zfa
                            default: illegal = 1'b1;
                        }
                    }
                    // FCVT.S.D / FCVT.D.S + P10 Zfa FROUND/FROUNDNX (by rs2 field)
                    7'b0100000: {
                        fp_reg_wen = 1'b1;
                        case i_instr[24:20] {
                            5'b00001: fpu_op  = fpu_pkg::FpuOp::FCVT_S_D;
                            5'b00010: fpu_op  = fpu_pkg::FpuOp::FCVT_S_H; // Zfhmin
                            5'b00100: fpu_op  = fpu_pkg::FpuOp::FROUND_S; // Zfa
                            5'b00101: fpu_op  = fpu_pkg::FpuOp::FROUNDNX_S; // Zfa
                            default : illegal = 1'b1;
                        }
                    }
                    7'b0100001: {
                        fp_reg_wen = 1'b1;
                        case i_instr[24:20] {
                            5'b00000: fpu_op  = fpu_pkg::FpuOp::FCVT_D_S;
                            5'b00010: fpu_op  = fpu_pkg::FpuOp::FCVT_D_H; // Zfhmin
                            5'b00100: fpu_op  = fpu_pkg::FpuOp::FROUND_D; // Zfa
                            5'b00101: fpu_op  = fpu_pkg::FpuOp::FROUNDNX_D; // Zfa
                            default : illegal = 1'b1;
                        }
                    }
                    // P10 Zfhmin: FCVT.H.S / FCVT.H.D (narrowing to half, by rs2)
                    7'b0100010: {
                        fp_reg_wen = 1'b1;
                        case i_instr[24:20] {
                            5'b00000: fpu_op  = fpu_pkg::FpuOp::FCVT_H_S;
                            5'b00001: fpu_op  = fpu_pkg::FpuOp::FCVT_H_D;
                            default : illegal = 1'b1;
                        }
                    }
                    // FCMP.S: FEQ/FLT/FLE (write to integer rd) + P10 Zfa FLEQ/FLTQ
                    7'b1010000: {
                        fp_int_wen = 1'b1;
                        reg_wen    = 1'b1;
                        case funct3 {
                            3'b010 : fpu_op  = fpu_pkg::FpuOp::FEQ_S;
                            3'b001 : fpu_op  = fpu_pkg::FpuOp::FLT_S;
                            3'b000 : fpu_op  = fpu_pkg::FpuOp::FLE_S;
                            3'b100 : fpu_op  = fpu_pkg::FpuOp::FLEQ_S; // Zfa
                            3'b101 : fpu_op  = fpu_pkg::FpuOp::FLTQ_S; // Zfa
                            default: illegal = 1'b1;
                        }
                    }
                    // FCMP.D
                    7'b1010001: {
                        fp_int_wen = 1'b1;
                        reg_wen    = 1'b1;
                        case funct3 {
                            3'b010 : fpu_op  = fpu_pkg::FpuOp::FEQ_D;
                            3'b001 : fpu_op  = fpu_pkg::FpuOp::FLT_D;
                            3'b000 : fpu_op  = fpu_pkg::FpuOp::FLE_D;
                            3'b100 : fpu_op  = fpu_pkg::FpuOp::FLEQ_D; // Zfa
                            3'b101 : fpu_op  = fpu_pkg::FpuOp::FLTQ_D; // Zfa
                            default: illegal = 1'b1;
                        }
                    }
                    // FCVT.W.S / FCVT.WU.S / FCVT.L.S / FCVT.LU.S (FP→int)
                    7'b1100000: {
                        fp_int_wen = 1'b1;
                        reg_wen    = 1'b1;
                        case i_instr[24:20] {
                            5'b00000: fpu_op  = fpu_pkg::FpuOp::FCVT_W_S;
                            5'b00001: fpu_op  = fpu_pkg::FpuOp::FCVT_WU_S;
                            5'b00010: fpu_op  = fpu_pkg::FpuOp::FCVT_L_S;
                            5'b00011: fpu_op  = fpu_pkg::FpuOp::FCVT_LU_S;
                            default : illegal = 1'b1;
                        }
                    }
                    // FCVT.W.D / FCVT.WU.D / FCVT.L.D / FCVT.LU.D
                    // + P10 Zfa FCVTMOD.W.D (rs2=01000, rm=rtz): double → signed
                    // int32, truncate-modulo-2^32 (no saturation).
                    7'b1100001: {
                        fp_int_wen = 1'b1;
                        reg_wen    = 1'b1;
                        case i_instr[24:20] {
                            5'b00000: fpu_op  = fpu_pkg::FpuOp::FCVT_W_D;
                            5'b00001: fpu_op  = fpu_pkg::FpuOp::FCVT_WU_D;
                            5'b00010: fpu_op  = fpu_pkg::FpuOp::FCVT_L_D;
                            5'b00011: fpu_op  = fpu_pkg::FpuOp::FCVT_LU_D;
                            5'b01000: fpu_op  = fpu_pkg::FpuOp::FCVTMOD_W_D; // Zfa
                            default : illegal = 1'b1;
                        }
                    }
                    // FCVT.S.W / FCVT.S.WU / FCVT.S.L / FCVT.S.LU (int→FP)
                    7'b1101000: {
                        fp_reg_wen = 1'b1;
                        case i_instr[24:20] {
                            5'b00000: fpu_op  = fpu_pkg::FpuOp::FCVT_S_W;
                            5'b00001: fpu_op  = fpu_pkg::FpuOp::FCVT_S_WU;
                            5'b00010: fpu_op  = fpu_pkg::FpuOp::FCVT_S_L;
                            5'b00011: fpu_op  = fpu_pkg::FpuOp::FCVT_S_LU;
                            default : illegal = 1'b1;
                        }
                    }
                    // FCVT.D.W / FCVT.D.WU / FCVT.D.L / FCVT.D.LU
                    7'b1101001: {
                        fp_reg_wen = 1'b1;
                        case i_instr[24:20] {
                            5'b00000: fpu_op  = fpu_pkg::FpuOp::FCVT_D_W;
                            5'b00001: fpu_op  = fpu_pkg::FpuOp::FCVT_D_WU;
                            5'b00010: fpu_op  = fpu_pkg::FpuOp::FCVT_D_L;
                            5'b00011: fpu_op  = fpu_pkg::FpuOp::FCVT_D_LU;
                            default : illegal = 1'b1;
                        }
                    }
                    // FMV.X.W / FCLASS.S (FP→int bits)
                    7'b1110000: {
                        fp_int_wen = 1'b1;
                        reg_wen    = 1'b1;
                        fpu_op     = if funct3 == 3'b001 ? fpu_pkg::FpuOp::FCLASS_S : fpu_pkg::FpuOp::FMV_X_W;
                    }
                    // FMV.X.D / FCLASS.D
                    7'b1110001: {
                        fp_int_wen = 1'b1;
                        reg_wen    = 1'b1;
                        fpu_op     = if funct3 == 3'b001 ? fpu_pkg::FpuOp::FCLASS_D : fpu_pkg::FpuOp::FMV_X_D;
                    }
                    // P10 Zfhmin: FMV.X.H (half bits → int, sign-extended). funct3=000.
                    7'b1110010: {
                        fp_int_wen = 1'b1;
                        reg_wen    = 1'b1;
                        if funct3 == 3'b000 && i_instr[24:20] == 5'b00000 {
                            fpu_op = fpu_pkg::FpuOp::FMV_X_H;
                        } else {
                            illegal = 1'b1;
                        }
                    }
                    // FMV.W.X (int→FP bits) + P10 Zfa FLI.S (rs2=00001): load FP
                    // constant indexed by the rs1 field (no register read).
                    7'b1111000: {
                        fp_reg_wen = 1'b1;
                        case i_instr[24:20] {
                            5'b00000: fpu_op  = fpu_pkg::FpuOp::FMV_W_X;
                            5'b00001: fpu_op  = fpu_pkg::FpuOp::FLI_S; // Zfa
                            default : illegal = 1'b1;
                        }
                    }
                    // FMV.D.X + P10 Zfa FLI.D (rs2=00001)
                    7'b1111001: {
                        fp_reg_wen = 1'b1;
                        case i_instr[24:20] {
                            5'b00000: fpu_op  = fpu_pkg::FpuOp::FMV_D_X;
                            5'b00001: fpu_op  = fpu_pkg::FpuOp::FLI_D; // Zfa
                            default : illegal = 1'b1;
                        }
                    }
                    // P10 Zfhmin: FMV.H.X (int low 16 → half, NaN-boxed). funct3=000.
                    7'b1111010: {
                        fp_reg_wen = 1'b1;
                        if funct3 == 3'b000 && i_instr[24:20] == 5'b00000 {
                            fpu_op = fpu_pkg::FpuOp::FMV_H_X;
                        } else {
                            illegal = 1'b1;
                        }
                    }
                    default: illegal = 1'b1;
                }
            }
            // FMADD.S / FMADD.D
            Opcode::FMADD: {
                is_fp      = 1'b1;
                fp_reg_wen = 1'b1;
                fpu_op     = if fmt[0] ? fpu_pkg::FpuOp::FMADD_D : fpu_pkg::FpuOp::FMADD_S;
            }
            // FMSUB.S / FMSUB.D
            Opcode::FMSUB: {
                is_fp      = 1'b1;
                fp_reg_wen = 1'b1;
                fpu_op     = if fmt[0] ? fpu_pkg::FpuOp::FMSUB_D : fpu_pkg::FpuOp::FMSUB_S;
            }
            // FNMSUB.S / FNMSUB.D
            Opcode::FNMSUB: {
                is_fp      = 1'b1;
                fp_reg_wen = 1'b1;
                fpu_op     = if fmt[0] ? fpu_pkg::FpuOp::FNMSUB_D : fpu_pkg::FpuOp::FNMSUB_S;
            }
            // FNMADD.S / FNMADD.D
            Opcode::FNMADD: {
                is_fp      = 1'b1;
                fp_reg_wen = 1'b1;
                fpu_op     = if fmt[0] ? fpu_pkg::FpuOp::FNMADD_D : fpu_pkg::FpuOp::FNMADD_S;
            }
            // Phase 12 V0: Vector extension (OP-V). Only the V0 subset is decoded
            // — vset{i}vl{i}, vadd.{vv,vx,vi}, vmv.x.s. Any other OP-V encoding is
            // illegal until the later sub-phases land it. Vector source/dest
            // registers reuse the rd/rs1/rs2 instruction fields.
            Opcode::OP_V: {
                is_vec = 1'b1;
                case funct3 {
                    3'b111: {
                        // OPCFG: vset{i}vl{i}. Writes the granted vl to integer rd.
                        reg_wen        = 1'b1;
                        vec_writes_int = 1'b1;
                        if i_instr[31] == 1'b0 {
                            vec_op          = vector_pkg::VecOp::VSETVLI;
                            vec_uses_scalar = 1'b1; // AVL = x[rs1]
                        } else if i_instr[30] == 1'b1 {
                            vec_op = vector_pkg::VecOp::VSETIVLI; // AVL = uimm[19:15]
                        } else {
                            // vsetvl register form (vtype = x[rs2]) needs a 2nd
                            // integer source read; deferred past V0.
                            illegal = 1'b1;
                        }
                    }
                    3'b000: {
                        // OPIVV: integer ALU, vector-vector. The VU reads vs1[i]
                        // as the second operand and funct6 as the op.
                        if vec_ialu_ok || vec_inarrow_ok || vec_satadd_ok || vec_vssh_ok || vec_vnclip_ok || vec_vsmul_ok {
                            vec_op = vector_pkg::VecOp::VALU;
                        } else if vec_rgather_ok || vec_rgatherei16_ok {
                            vec_op = vector_pkg::VecOp::VRGATHER; // V4f-3 (idx=vs1[i]) / V4i-4 ei16
                        } else if vec_iwred_ok {
                            vec_op = vector_pkg::VecOp::VFALU; // V4g-1 widening reduction
                        } else {
                            illegal = 1'b1;
                        }
                    }
                    3'b100: {
                        // OPIVX: integer ALU, vector-scalar (second operand x[rs1]).
                        if vec_ialu_ok || vec_inarrow_ok || vec_satadd_ok || vec_vssh_ok || vec_vnclip_ok || vec_vsmul_ok {
                            vec_op          = vector_pkg::VecOp::VALU;
                            vec_uses_scalar = 1'b1; // scalar = x[rs1]
                        } else if vec_slide_ok {
                            vec_op          = vector_pkg::VecOp::VSLIDE; // V4f-1
                            vec_uses_scalar = 1'b1; // offset = x[rs1]
                        } else if vec_rgather_ok {
                            vec_op          = vector_pkg::VecOp::VRGATHER; // V4f-3
                            vec_uses_scalar = 1'b1; // idx = x[rs1] (broadcast)
                        } else {
                            illegal = 1'b1;
                        }
                    }
                    3'b011: {
                        // OPIVI: integer ALU, vector-immediate (sign-extended imm5).
                        // vsaddu.vi/vsadd.vi exist (vssub*.vi are reserved, but the
                        // VU just computes vs2-imm — harmless for unused encodings).
                        if vec_ialu_ok || vec_inarrow_ok || vec_satadd_ok || vec_vssh_ok || vec_vnclip_ok {
                            vec_op = vector_pkg::VecOp::VALU;
                        } else if vec_slide_ok {
                            vec_op = vector_pkg::VecOp::VSLIDE; // V4f-1 (offset = uimm5)
                        } else if vec_rgather_ok {
                            vec_op = vector_pkg::VecOp::VRGATHER; // V4f-3 (idx = uimm5)
                        } else {
                            illegal = 1'b1;
                        }
                    }
                    3'b001: {
                        // OPFVV: FP ALU, vector-vector (V3a/V3c/V3d). vs1[i] is the
                        // second operand; funct6 + SEW select the FP op. vfsqrt.v
                        // (V3c) is the unary VFUNARY1/vs1=0 form; funct6 011xxx are
                        // the FP compares (V3d) which write a mask register.
                        if funct6 == 6'b010000 && i_instr[19:15] == 5'b00000 {
                            // V3f: vfmv.f.s — f[rd] <- vs2[0]. Writes the scalar FP
                            // register file (the FP analogue of vmv.x.s), so it
                            // renames an FP dest and the VU drives the FP CDB.
                            vec_op     = vector_pkg::VecOp::VFMV_F_S;
                            fp_reg_wen = 1'b1;
                        } else if vec_falu_ok || vec_fsqrt_ok || vec_fcmp_ok || vec_fcvt_ok || vec_fclass_ok || vec_ffma_ok || vec_fwiden_ok || vec_fwcvt_ok || vec_fncvt_ok || vec_fest_ok || vec_fred_ok || vec_fwred_ok {
                            vec_op = vector_pkg::VecOp::VFALU;
                        } else {
                            illegal = 1'b1;
                        }
                    }
                    3'b010: {
                        // OPMVV: vmv.x.s (funct6=010000, vs1 field=00000), V2c
                        // integer mul/div (100xxx), V2d-4 widening (11xxxx).
                        if funct6 == 6'b010000 && i_instr[19:15] == 5'b00000 {
                            vec_op         = vector_pkg::VecOp::VMV_X_S;
                            reg_wen        = 1'b1;
                            vec_writes_int = 1'b1;
                        } else if funct6 == 6'b010000 && (i_instr[19:15] == 5'b10000 || i_instr[19:15] == 5'b10001) {
                            // V4d: vcpop.m (vs1=10000) / vfirst.m (vs1=10001).
                            // Mask-register reductions writing a scalar int rd.
                            vec_op         = vector_pkg::VecOp::VCPOP;
                            reg_wen        = 1'b1;
                            vec_writes_int = 1'b1;
                        } else if vec_msetp_ok {
                            vec_op = vector_pkg::VecOp::VMSPRE; // V4e-1 vmsbf/vmsof/vmsif
                        } else if vec_viota_ok {
                            vec_op = vector_pkg::VecOp::VIOTA;  // V4e-2 viota.m / vid.v
                        } else if vec_compress_ok {
                            vec_op = vector_pkg::VecOp::VCOMPRESS; // V4f-4 vcompress.vm
                        } else if vec_ired_ok {
                            vec_op = vector_pkg::VecOp::VFALU; // V4b integer reduction
                        } else if vec_mlogic_ok {
                            vec_op = vector_pkg::VecOp::VMLOGIC; // V4c mask logical
                        } else if vec_imuldiv_ok || vec_iwiden_ok || vec_vaavg_ok {
                            vec_op = vector_pkg::VecOp::VALU; // vmul*/vdiv*/vrem*/vw* / vaadd*
                        } else {
                            illegal = 1'b1;
                        }
                    }
                    3'b110: {
                        // OPMVX: V2c integer mul/div + V2d-4 widening, vector-scalar.
                        if vec_imuldiv_ok || vec_iwiden_ok || vec_vaavg_ok {
                            vec_op          = vector_pkg::VecOp::VALU;
                            vec_uses_scalar = 1'b1; // scalar = x[rs1]
                        } else if vec_slide_ok {
                            // V4f-2: vslide1up.vx / vslide1down.vx — slide by one,
                            // injecting x[rs1] at the vacated end.
                            vec_op          = vector_pkg::VecOp::VSLIDE;
                            vec_uses_scalar = 1'b1; // fill = x[rs1]
                        } else {
                            illegal = 1'b1;
                        }
                    }
                    3'b101: {
                        // OPFVF: FP ALU, vector-scalar (V3b/V3d). The second operand
                        // is the FP scalar f[rs1] (read from prf_fp by the VU at the
                        // ROB head). This is NOT an int scalar, so vec_uses_scalar
                        // stays 0. funct6 011xxx are the .vf FP compares (→ mask);
                        // 010111 is vfmerge.vfm / vfmv.v.f (V3e); 010000 is
                        // vfmv.s.f (V3f, vd[0] <- f[rs1], a VRF write); 101xxx are
                        // the .vf FP FMAs (V3h).
                        if funct6 == 6'b010000 {
                            vec_op = vector_pkg::VecOp::VFMV_S_F;
                        } else if vec_falu_vf_ok || vec_fcmp_vf_ok || vec_fmerge_ok || vec_ffma_ok || vec_fwiden_ok {
                            vec_op = vector_pkg::VecOp::VFALU;
                        } else if vec_slide_ok {
                            // V4f-2: vfslide1up.vf / vfslide1down.vf — slide by one,
                            // injecting the FP scalar f[rs1] at the vacated end.
                            // vec_uses_scalar stays 0 (FP scalar, read via prf_fp).
                            vec_op = vector_pkg::VecOp::VSLIDE;
                        } else {
                            illegal = 1'b1;
                        }
                    }
                    default: illegal = 1'b1; // all 8 funct3 covered above; catch-all
                }
            }
            default: {
                // Unknown opcode: illegal instruction
                illegal = 1'b1;
            }
        }
    }

    assign o_alu_op      = alu_op;
    assign o_alu_src_a   = alu_src_a;
    assign o_alu_src_b   = alu_src_b;
    assign o_imm_type    = imm_type;
    assign o_wb_sel      = wb_sel;
    assign o_reg_wen     = reg_wen;
    assign o_mem_ren     = mem_ren;
    assign o_mem_wen     = mem_wen;
    assign o_is_branch   = is_branch;
    assign o_is_jal      = is_jal;
    assign o_is_jalr     = is_jalr;
    assign o_is_ecall    = is_ecall;
    assign o_is_ebreak   = is_ebreak;
    assign o_is_mret     = is_mret;
    assign o_is_wfi      = is_wfi;
    assign o_csr_op      = csr_op;
    assign o_is_csr      = is_csr;
    assign o_csr_imm     = csr_imm;
    assign o_illegal     = illegal;
    assign o_is_amo      = is_amo;
    assign o_amo_funct5  = amo_funct5;
    assign o_is_fp       = is_fp;
    assign o_fp_reg_wen  = fp_reg_wen;
    assign o_fp_int_wen  = fp_int_wen;
    assign o_fpu_op      = fpu_op;
    assign o_fp_rm       = fp_rm;
    assign o_fp_rs3_addr = rs3;
    assign o_is_sfence   = is_sfence;
    assign o_is_fence_i  = is_fence_i;
    assign o_is_fence    = is_fence;
    assign o_is_cbo_zero = is_cbo_zero;
    assign o_hlv         = hlv;
    assign o_hlvx        = hlvx;
    assign o_is_vec          = is_vec;
    assign o_vec_op          = vec_op;
    assign o_vec_uses_scalar = vec_uses_scalar;
    assign o_vec_writes_int  = vec_writes_int;
}
