// Multi-hart heliodor SoC (Phase 4 / 6).
//
// N heliodor_core copies (HART_ID = 0..N-1) + a single shared CLINT/PLIC/UART.
// MMIO requests are arbitrated by memory_bus; imem/iptw/dmem stay per-hart and
// are exported as N-wide arrays so the test harness attaches a multi-port DRAM.
//
// All heliodor_core o_dbg_* ports are intentionally left unconnected — the
// Veryl analyzer raises warnings, not errors.
//
// N_HARTS supports 2 (default, for existing tb compat) and 4 (Phase 6.A).
// N_HARTS=1 should use heliodor_top instead — that path is untested here.
// Per-hart debug ports (o_dbg_h0_*/h1_*) are left wired for tb compat;
// when N_HARTS >= 4 the higher harts are observable through the shared
// memory_bus and CLINT debug paths only (no o_dbg_h2_*/h3_* ports yet).
pub module heliodor_soc #(
    param N_HARTS : u32 = 2,
    param RESET_PC: u64 = 0,
) (
    clk: input clock,
    rst: input reset,
    // Per-hart instruction memory
    o_imem_addr : output logic<64> [N_HARTS],
    i_imem_rdata: input  logic<32> [N_HARTS],
    o_imem_ren  : output logic     [N_HARTS],
    o_iptw_addr : output logic<64> [N_HARTS],
    o_iptw_req  : output logic     [N_HARTS],
    i_iptw_rdata: input  logic<64> [N_HARTS],
    // Single-port DRAM bus (Phase 5). The SoC arbitrates per-hart
    // dcache requests through memory_bus and emits a single shared
    // DRAM transaction stream. The same i_dmem_rdata is broadcast to
    // every hart; only the granted hart consumes it.
    o_dmem_addr : output logic<64>,
    o_dmem_wdata: output logic<64>,
    i_dmem_rdata: input  logic<64>,
    o_dmem_wen  : output logic    ,
    o_dmem_ren  : output logic    ,
    o_dmem_wstrb: output logic<8> ,
    // External interrupt sources (shared PLIC)
    i_ext_irq: input logic<32>,
    // UART (single shared instance)
    o_uart_tx      : output logic   ,
    o_uart_data    : output logic<8>,
    i_uart_rx_data : input  logic<8>,
    i_uart_rx_valid: input  logic   ,
    // Debug — hart 0 x3 (SBI shutdown pass criterion) + secondary observability.
    o_dbg_h0_x3: output logic<64>,
    // Per-hart PC for secondary online verification (hart 1 entering kernel
    // address space ≥ 0x80000000 indicates SBI HSM HART_START handoff worked).
    // Hart 0 is also exposed for symmetric debug.
    o_dbg_h0_pc: output logic<64>,
    o_dbg_h1_pc: output logic<64>,
    // Phase 7 v4 SMP cosim: hart1 committed (retire) stream — golden reference to
    // diff against v4's hart1 stream and pin the first divergence.
    o_dbg_h1_retire_v   : output logic    ,
    o_dbg_h1_retire_pc  : output logic<64>,
    o_dbg_h1_retire_rdv : output logic    ,
    o_dbg_h1_retire_rd  : output logic<5> ,
    o_dbg_h1_retire_data: output logic<64>,
    // Per-hart instruction retirement counter (any non-zero on hart 1 means
    // secondary actually executed instructions in kernel mode).
    o_dbg_h1_instret: output logic,
    // Per-hart SW IRQ (CLINT MSIP) line into the core. Used by tb to
    // confirm whether sbi_ipi's `sw msip[1]=1` actually reaches the
    // CLINT and asserts hart 1's MSIP wire.
    o_dbg_h1_sw_irq: output logic,
    o_dbg_h0_sw_irq: output logic,
    // CLINT MMIO write probes — bus_wen_clint pulses high on any cycle a
    // hart's MMIO write hits the CLINT range, with bus_paddr the lower 16
    // bits of the address. Used by tb to confirm whether sbi_ipi's
    // sw msip[1]=1 actually reaches the CLINT input.
    o_dbg_clint_wen  : output logic    ,
    o_dbg_clint_addr : output logic<16>,
    o_dbg_clint_wdata: output logic<64>,
    // Per-hart bus invalidate-receive probes. Pulses high on any cycle
    // a remote-hart write generates a cache-line invalidate to this hart.
    // Used by tb to confirm cache coherence broadcasts actually reach
    // both harts.
    o_dbg_h0_inv_valid: output logic,
    o_dbg_h1_inv_valid: output logic,
    // Per-hart trap probe. Pulses high on cycles a trap fires; cause is
    // the mcause/scause value (interrupt cause if MSB=1). Used by tb to
    // count SSIP traps (cause=0x8000000000000001) per hart.
    o_dbg_h0_trap_taken: output logic    ,
    o_dbg_h0_trap_cause: output logic<64>,
    o_dbg_h1_trap_taken: output logic    ,
    o_dbg_h1_trap_cause: output logic<64>,
    // Per-hart MMIO request probes — what each hart is asking to do
    // BEFORE memory_bus arbitration drops/grants it. Used by tb to
    // detect when a hart's msip[N] write request is silently dropped.
    o_dbg_h0_mmio_wen  : output logic    ,
    o_dbg_h0_mmio_paddr: output logic<32>,
    o_dbg_h0_clint_sel : output logic    ,
    o_dbg_h1_mmio_wen  : output logic    ,
    o_dbg_h1_mmio_paddr: output logic<32>,
    o_dbg_h1_clint_sel : output logic    ,
    // Per-hart MMIO grant signal observed by tb so we can confirm
    // round-robin arbitration and back-pressure are functioning.
    o_dbg_h0_mmio_grant: output logic,
    o_dbg_h1_mmio_grant: output logic,
    // Per-hart dmem (DRAM) request signals — for sim-bug investigation.
    // These are the CPU-side requests, valid whether or not granted.
    o_dbg_h0_dmem_addr : output logic<64>,
    o_dbg_h0_dmem_wen  : output logic    ,
    o_dbg_h0_dmem_ren  : output logic    ,
    o_dbg_h0_dmem_wdata: output logic<64>,
    o_dbg_h1_dmem_addr : output logic<64>,
    o_dbg_h1_dmem_wen  : output logic    ,
    o_dbg_h1_dmem_ren  : output logic    ,
    o_dbg_h1_dmem_wdata: output logic<64>,
    // Phase 6.A: minimal probes for hart 2/3 (N_HARTS >= 4 path).
    // Wired to 0 when N_HARTS < 3 / 4 so existing N=2 tb compat is intact.
    o_dbg_h2_pc     : output logic<64>,
    o_dbg_h2_instret: output logic    ,
    o_dbg_h3_pc     : output logic<64>,
    o_dbg_h3_instret: output logic    ,
) {
    // ============================================================
    // Per-hart wires (core ↔ memory_bus / peripherals)
    // ============================================================
    var core_mmio_paddr: logic<32> [N_HARTS];
    var core_mmio_wdata: logic<64> [N_HARTS];
    var core_mmio_wstrb: logic<8>  [N_HARTS];
    var core_mmio_wen  : logic     [N_HARTS];
    var core_mmio_ren  : logic     [N_HARTS];
    var core_stall_mem : logic     [N_HARTS];
    var core_clint_sel : logic     [N_HARTS];
    var core_plic_sel  : logic     [N_HARTS];
    var core_uart_sel  : logic     [N_HARTS];

    // Granted MMIO bundle (memory_bus → CLINT/PLIC/UART)
    var bus_paddr    : logic<32>;
    var bus_wdata    : logic<64>;
    var bus_wstrb    : logic<8> ;
    var bus_wen_clint: logic    ;
    var bus_ren_clint: logic    ;
    var bus_wen_plic : logic    ;
    var bus_ren_plic : logic    ;
    var bus_wen_uart : logic    ;
    var bus_ren_uart : logic    ;

    // dcache invalidate broadcast (memory_bus → each core)
    var bus_inv_valid: logic     [N_HARTS];
    var bus_inv_addr : logic<64> [N_HARTS];

    // Phase 5: invalidate pulse from memory_bus on the granted write.
    // Broadcast to both harts (each hart sees its own write reflected,
    // which is harmless since the line is being written by that hart and
    // its dcache state matches).
    var bus_dmem_inv_valid: logic    ;
    var bus_dmem_inv_addr : logic<64>;

    // Phase 6.E.1: L2 shell sits between memory_bus's granted-DRAM
    // request and the SoC-level DRAM port. memory_bus drives bus_dram_*;
    // l2cache passes them through to o_dmem_* (and back for rdata).
    var bus_dram_addr : logic<64>;
    var bus_dram_wdata: logic<64>;
    var bus_dram_wstrb: logic<8> ;
    var bus_dram_wen  : logic    ;
    var bus_dram_ren  : logic    ;
    var l2_l1_rdata   : logic<64>;

    // Peripheral rdata (broadcast to all cores). Combinational reads —
    // the rdata path goes through the MMIO mux into core.i_*_rdata, then
    // through MEM/WB pipeline registers before reaching anything that
    // could feed back to core.o_mmio_paddr. No comb cycle exists.
    var clint_rdata: logic<64>;
    var plic_rdata : logic<64>;
    var uart_rdata : logic<8> ;
    var uart_irq   : logic    ;

    // Per-hart interrupt arrays from CLINT / PLIC
    var timer_irq_arr : logic     [N_HARTS];
    var sw_irq_arr    : logic     [N_HARTS];
    var plic_irq_m_arr: logic     [N_HARTS];
    var plic_irq_s_arr: logic     [N_HARTS];
    var mtime_val     : logic<64>          ;

    // ============================================================
    // Heliodor cores (generate-for)
    // Most debug outputs are unconnected; per-hart x3 is forwarded so
    // tb harnesses can observe SBI shutdown convention (hart 0 writes
    // 0xAA on success).
    // ============================================================
    var dbg_r3_arr        : logic<64> [N_HARTS];
    var dbg_pc_arr        : logic<64> [N_HARTS];
    var dbg_ret_v_arr     : logic     [N_HARTS]; // cosim: per-hart retire stream
    var dbg_ret_pc_arr    : logic<64> [N_HARTS];
    var dbg_ret_rdv_arr   : logic     [N_HARTS];
    var dbg_ret_rd_arr    : logic<5>  [N_HARTS];
    var dbg_ret_data_arr  : logic<64> [N_HARTS];
    var dbg_instret_arr   : logic     [N_HARTS];
    var dbg_trap_taken_arr: logic     [N_HARTS];
    var dbg_trap_cause_arr: logic<64> [N_HARTS];
    var core_amo_inflight : logic     [N_HARTS];
    var core_reserv_valid : logic     [N_HARTS];
    // Phase 5: per-hart dcache request bundles, fed into memory_bus DRAM
    // arbiter. Single shared o_dmem_* output is driven by memory_bus.
    var core_dmem_addr : logic<64> [N_HARTS];
    var core_dmem_wdata: logic<64> [N_HARTS];
    var core_dmem_wstrb: logic<8>  [N_HARTS];
    var core_dmem_wen  : logic     [N_HARTS];
    var core_dmem_ren  : logic     [N_HARTS];
    var core_dmem_req  : logic     [N_HARTS];
    var core_dmem_grant: logic     [N_HARTS];
    var core_mmio_grant: logic     [N_HARTS];
    for h in 0..N_HARTS :gen_core {
        inst u_core: heliodor_core #(
            DEBUG   : 1       ,
            RESET_PC: RESET_PC,
            HART_ID : h as 8  ,
        ) (
            clk                             ,
            rst                             ,
            o_imem_addr : o_imem_addr[h]    ,
            i_imem_rdata: i_imem_rdata[h]   ,
            o_imem_ren  : o_imem_ren[h]     ,
            o_iptw_addr : o_iptw_addr[h]    ,
            o_iptw_req  : o_iptw_req[h]     ,
            i_iptw_rdata: i_iptw_rdata[h]   ,
            o_dmem_addr : core_dmem_addr[h] ,
            o_dmem_wdata: core_dmem_wdata[h],
            // Phase 6.E.1: rdata now comes from l2cache (passthrough
            // for now — future phases will absorb hits without DRAM).
            i_dmem_rdata      : l2_l1_rdata         ,
            o_dmem_wen        : core_dmem_wen[h]    ,
            o_dmem_ren        : core_dmem_ren[h]    ,
            o_dmem_wstrb      : core_dmem_wstrb[h]  ,
            o_dmem_req        : core_dmem_req[h]    ,
            o_mmio_paddr      : core_mmio_paddr[h]  ,
            o_mmio_wdata      : core_mmio_wdata[h]  ,
            o_mmio_wstrb      : core_mmio_wstrb[h]  ,
            o_mmio_wen        : core_mmio_wen[h]    ,
            o_mmio_ren        : core_mmio_ren[h]    ,
            o_stall_mem       : core_stall_mem[h]   ,
            o_clint_sel       : core_clint_sel[h]   ,
            o_plic_sel        : core_plic_sel[h]    ,
            o_uart_sel        : core_uart_sel[h]    ,
            i_clint_rdata     : clint_rdata         ,
            i_plic_rdata      : plic_rdata          ,
            i_uart_rdata      : uart_rdata          ,
            i_timer_irq       : timer_irq_arr[h]    ,
            i_sw_irq          : sw_irq_arr[h]       ,
            i_plic_irq_m      : plic_irq_m_arr[h]   ,
            i_plic_irq_s      : plic_irq_s_arr[h]   ,
            i_mtime           : mtime_val           ,
            i_dcache_inv_valid: bus_inv_valid[h]    ,
            i_dcache_inv_addr : bus_inv_addr[h]     ,
            o_amo_inflight    : core_amo_inflight[h],
            o_reserv_valid    : core_reserv_valid[h],
            // Phase 5: dcache bus arbitration through memory_bus. memory_bus
            // tracks per-hart i_dmem_req + i_amo_inflight and grants one hart
            // per cycle. AMO inflight gives the holder an exclusive lock so
            // the RMW window is bus-atomic (kernel hart_lottery now works).
            i_dmem_grant    : core_dmem_grant[h]   ,
            i_mmio_grant    : core_mmio_grant[h]   ,
            o_dbg_r3        : dbg_r3_arr[h]        ,
            o_dbg_pc        : dbg_pc_arr[h]        ,
            o_dbg_retire_v_a   : dbg_ret_v_arr[h]   ,
            o_dbg_retire_pc_a  : dbg_ret_pc_arr[h]  ,
            o_dbg_retire_rd_v_a: dbg_ret_rdv_arr[h] ,
            o_dbg_retire_rd_a  : dbg_ret_rd_arr[h]  ,
            o_dbg_retire_data_a: dbg_ret_data_arr[h],
            o_dbg_instret   : dbg_instret_arr[h]   ,
            o_dbg_trap_taken: dbg_trap_taken_arr[h],
            o_dbg_trap_cause: dbg_trap_cause_arr[h],
        );
    }
    assign o_dbg_h0_x3         = dbg_r3_arr[0];
    assign o_dbg_h0_pc         = dbg_pc_arr[0];
    assign o_dbg_h1_pc         = if N_HARTS >= 2 ? dbg_pc_arr[1] : 64'd0;
    assign o_dbg_h1_retire_v   = if N_HARTS >= 2 ? dbg_ret_v_arr[1] : 1'b0;
    assign o_dbg_h1_retire_pc  = if N_HARTS >= 2 ? dbg_ret_pc_arr[1] : 64'd0;
    assign o_dbg_h1_retire_rdv = if N_HARTS >= 2 ? dbg_ret_rdv_arr[1] : 1'b0;
    assign o_dbg_h1_retire_rd  = if N_HARTS >= 2 ? dbg_ret_rd_arr[1] : 5'd0;
    assign o_dbg_h1_retire_data= if N_HARTS >= 2 ? dbg_ret_data_arr[1] : 64'd0;
    assign o_dbg_h1_instret    = if N_HARTS >= 2 ? dbg_instret_arr[1] : 1'b0;
    assign o_dbg_h1_sw_irq     = if N_HARTS >= 2 ? sw_irq_arr[1] : 1'b0;
    assign o_dbg_h0_sw_irq     = sw_irq_arr[0];
    assign o_dbg_clint_wen     = bus_wen_clint;
    assign o_dbg_clint_addr    = bus_paddr[15:0];
    assign o_dbg_clint_wdata   = bus_wdata;
    assign o_dbg_h0_inv_valid  = bus_inv_valid[0];
    assign o_dbg_h1_inv_valid  = if N_HARTS >= 2 ? bus_inv_valid[1] : 1'b0;
    assign o_dbg_h0_trap_taken = dbg_trap_taken_arr[0];
    assign o_dbg_h0_trap_cause = dbg_trap_cause_arr[0];
    assign o_dbg_h1_trap_taken = if N_HARTS >= 2 ? dbg_trap_taken_arr[1] : 1'b0;
    assign o_dbg_h1_trap_cause = if N_HARTS >= 2 ? dbg_trap_cause_arr[1] : 64'd0;
    assign o_dbg_h0_mmio_wen   = core_mmio_wen[0];
    assign o_dbg_h0_mmio_paddr = core_mmio_paddr[0];
    assign o_dbg_h0_clint_sel  = core_clint_sel[0];
    assign o_dbg_h1_mmio_wen   = if N_HARTS >= 2 ? core_mmio_wen[1] : 1'b0;
    assign o_dbg_h1_mmio_paddr = if N_HARTS >= 2 ? core_mmio_paddr[1] : 32'd0;
    assign o_dbg_h1_clint_sel  = if N_HARTS >= 2 ? core_clint_sel[1] : 1'b0;
    assign o_dbg_h0_mmio_grant = core_mmio_grant[0];
    assign o_dbg_h1_mmio_grant = if N_HARTS >= 2 ? core_mmio_grant[1] : 1'b0;
    assign o_dbg_h0_dmem_addr  = core_dmem_addr[0];
    assign o_dbg_h0_dmem_wen   = core_dmem_wen[0];
    assign o_dbg_h0_dmem_ren   = core_dmem_ren[0];
    assign o_dbg_h0_dmem_wdata = core_dmem_wdata[0];
    assign o_dbg_h1_dmem_addr  = if N_HARTS >= 2 ? core_dmem_addr[1] : 64'd0;
    assign o_dbg_h1_dmem_wen   = if N_HARTS >= 2 ? core_dmem_wen[1] : 1'b0;
    assign o_dbg_h1_dmem_ren   = if N_HARTS >= 2 ? core_dmem_ren[1] : 1'b0;
    assign o_dbg_h1_dmem_wdata = if N_HARTS >= 2 ? core_dmem_wdata[1] : 64'd0;
    // Use generate-if (not ternary) so dbg_pc_arr[2]/[3] is only
    // elaborated when N_HARTS is large enough; otherwise the analyzer
    // OOBs on the index even when the ternary is statically false.
    if N_HARTS >= 3 :gen_dbg_h2 {
        assign o_dbg_h2_pc      = dbg_pc_arr[2];
        assign o_dbg_h2_instret = dbg_instret_arr[2];
    } else :gen_dbg_h2_tie {
        assign o_dbg_h2_pc      = 64'd0;
        assign o_dbg_h2_instret = 1'b0;
    }
    if N_HARTS >= 4 :gen_dbg_h3 {
        assign o_dbg_h3_pc      = dbg_pc_arr[3];
        assign o_dbg_h3_instret = dbg_instret_arr[3];
    } else :gen_dbg_h3_tie {
        assign o_dbg_h3_pc      = 64'd0;
        assign o_dbg_h3_instret = 1'b0;
    }

    // ============================================================
    // memory_bus
    // ============================================================
    inst u_mmio_bus: memory_bus #(
        N_HARTS: N_HARTS,
    ) (
        clk                              ,
        rst                              ,
        i_mmio_paddr    : core_mmio_paddr,
        i_mmio_wdata    : core_mmio_wdata,
        i_mmio_wstrb    : core_mmio_wstrb,
        i_mmio_wen      : core_mmio_wen  ,
        i_mmio_ren      : core_mmio_ren  ,
        i_clint_sel     : core_clint_sel ,
        i_plic_sel      : core_plic_sel  ,
        i_uart_sel      : core_uart_sel  ,
        i_stall_mem     : core_stall_mem ,
        o_mmio_paddr    : bus_paddr      ,
        o_mmio_wdata    : bus_wdata      ,
        o_mmio_wstrb    : bus_wstrb      ,
        o_mmio_wen_clint: bus_wen_clint  ,
        o_mmio_ren_clint: bus_ren_clint  ,
        o_mmio_wen_plic : bus_wen_plic   ,
        o_mmio_ren_plic : bus_ren_plic   ,
        o_mmio_wen_uart : bus_wen_uart   ,
        o_mmio_ren_uart : bus_ren_uart   ,
        // Phase 5 DRAM single-port arbitration
        i_dmem_addr   : core_dmem_addr   ,
        i_dmem_wdata  : core_dmem_wdata  ,
        i_dmem_wstrb  : core_dmem_wstrb  ,
        i_dmem_wen    : core_dmem_wen    ,
        i_dmem_ren    : core_dmem_ren    ,
        i_dmem_req    : core_dmem_req    ,
        i_amo_inflight: core_amo_inflight,
        o_dmem_grant  : core_dmem_grant  ,
        o_mmio_grant  : core_mmio_grant  ,
        // Phase 6.E.1: route DRAM bus through l2cache shell instead of
        // straight to o_dmem_*. The shell is a passthrough today.
        o_dmem_addr : bus_dram_addr ,
        o_dmem_wdata: bus_dram_wdata,
        o_dmem_wstrb: bus_dram_wstrb,
        o_dmem_wen  : bus_dram_wen  ,
        o_dmem_ren  : bus_dram_ren  ,
        // memory_bus emits inv pulse on the granted write — fed into both
        // harts' dcache invalidate ports below (broadcast).
        o_dmem_inv_valid: bus_dmem_inv_valid,
        o_dmem_inv_addr : bus_dmem_inv_addr ,
    );

    // ============================================================
    // dcache invalidate broadcast (Phase 5).
    // memory_bus emits one inv pulse per granted DRAM write. Forward
    // combinationally (same cycle as the write commit) to every OTHER
    // hart's dcache invalidate input. The writer hart sees its own
    // write as a no-op (line was just updated by it).
    //
    // Same-cycle delivery is required for Linux SMP memory ordering:
    // a 1-cycle flop here lets the receiver's same-cycle read return a
    // stale value, which corrupts kthread structs during secondary CPU
    // bring-up (Oops at PC 0x207ff400 from a broken function pointer).
    //
    // No comb loop forms because every signal in the path is sourced
    // from a flop on either end (core_dmem_wen/grant come out of dcache
    // always_ff, and i_inv_valid feeds dcache always_ff on the receiver).
    // ============================================================
    // Forward invalidates to non-writer harts. memory_bus issues exactly
    // one granted DRAM write per cycle; for hart h we suppress its inv
    // pulse only when h itself was the writer. The receiver's amo_inflight
    // is intentionally NOT gated here: memory_bus already prevents the
    // writer hart from being granted while a remote AMO holds the lock,
    // so dropping invalidates on the receiver only dropped legitimate
    // cross-line writes when both harts were doing independent AMOs
    // simultaneously (scheduler run-queue cmpxchg pattern). LR-SC
    // reservation flush is handled by memory.veryl's i_remote_inv_valid
    // path.
    let inv_v: logic = bus_dmem_inv_valid && bus_dmem_inv_addr[31];
    for h in 0..N_HARTS :gen_inv {
        let self_wrote: logic = core_dmem_grant[h] && core_dmem_wen[h];
        assign bus_inv_valid[h] = inv_v && !self_wrote;
        assign bus_inv_addr[h]  = bus_dmem_inv_addr;
    }

    // ============================================================
    // L2 cache shell (Phase 6.E.1).
    // Currently a pure passthrough between memory_bus's granted DRAM
    // request and the SoC-level DRAM port. Drops in here so a future
    // 6.E.2 cache implementation does not require re-wiring above.
    // ============================================================
    inst u_l2: l2cache (
        clk                        ,
        rst                        ,
        i_addr     : bus_dram_addr ,
        i_wdata    : bus_dram_wdata,
        i_wstrb    : bus_dram_wstrb,
        i_wstrb_hi : 8'd0          , // M8.D.2: v1 has no misaligned hi-side bypass
        i_wen      : bus_dram_wen  ,
        i_ren      : bus_dram_ren  ,
        o_rdata    : l2_l1_rdata   ,
        o_mem_addr : o_dmem_addr   ,
        o_mem_wdata: o_dmem_wdata  ,
        o_mem_wstrb: o_dmem_wstrb  ,
        o_mem_wen  : o_dmem_wen    ,
        o_mem_ren  : o_dmem_ren    ,
        i_mem_rdata: i_dmem_rdata  ,
    );

    // ============================================================
    // CLINT
    // ============================================================
    inst u_clint: clint #(
        N_HARTS: N_HARTS,
    ) (
        clk                         ,
        rst                         ,
        i_addr     : bus_paddr[15:0],
        i_wdata    : bus_wdata      ,
        i_wen      : bus_wen_clint  ,
        i_ren      : bus_ren_clint  ,
        o_rdata    : clint_rdata    ,
        o_timer_irq: timer_irq_arr  ,
        o_sw_irq   : sw_irq_arr     ,
        o_mtime    : mtime_val      ,
    );

    // ============================================================
    // PLIC
    // ============================================================
    inst u_plic: plic #(
        N_HARTS: N_HARTS,
    ) (
        clk                                          ,
        rst                                          ,
        i_src  : i_ext_irq | {21'd0, uart_irq, 10'd0},
        i_addr : bus_paddr[23:0]                     ,
        i_wdata: bus_wdata                           ,
        i_wen  : bus_wen_plic                        ,
        i_ren  : bus_ren_plic                        ,
        o_rdata: plic_rdata                          ,
        o_irq_m: plic_irq_m_arr                      ,
        o_irq_s: plic_irq_s_arr                      ,
    );

    // ============================================================
    // UART
    // ============================================================
    inst u_uart: uart (
        clk                        ,
        rst                        ,
        i_addr    : bus_paddr[2:0] ,
        i_wdata   : bus_wdata[7:0] ,
        i_wen     : bus_wen_uart   ,
        i_ren     : bus_ren_uart   ,
        o_rdata   : uart_rdata     ,
        o_tx_valid: o_uart_tx      ,
        o_tx_data : o_uart_data    ,
        i_rx_data : i_uart_rx_data ,
        i_rx_valid: i_uart_rx_valid,
        o_irq     : uart_irq       ,
    );
}
