// Phase 7 v4 M8.D: single-hart SoC wrapping heliodor_core with CLINT + UART.
//
// The v4 core emits DRAM and MMIO mixed on its flat o_dmem port (it has no MMIO
// select ports, unlike the v1 core). This SoC address-decodes o_dmem into:
//   - DRAM  (paddr[31] == 1, i.e. >= 0x8000_0000): exposed on o_dmem_* to the tb
//            (M8.D.1 is direct passthrough; M8.D.2/.3 insert l2cache + memory_bus
//            on this path).
//   - CLINT (paddr[31:24] == 0x02): internal clint — drives the timer/sw IRQ and
//            mtime back into the core.
//   - UART  (paddr[31:28] == 0x1): internal uart — TX observable on o_uart_tx_*.
// Load data returns to the core muxed by the same decode. IRQ is wired directly
// (CLINT -> core). Instruction fetch / PTW stay per-hart and are served by the
// tb (o_imem_* / o_iptw_*).
//
// N=1 today (HART_ID parameter present for the SMP foundation); M9 extends this
// to N harts via memory_bus + a CLINT with N_HARTS + a second core.
pub module heliodor_soc #(
    param RESET_PC: u64 = 64'h8000_0000,
    param HART_ID : u8  = 0            ,
) (
    clk: input clock,
    rst: input reset,
    // Instruction fetch (per-hart, tb-served)
    o_imem_addr : output logic<64>,
    i_imem_rdata: input  logic<32>,
    o_imem_ren  : output logic    ,
    // Instruction PTW (per-hart, tb-served)
    o_iptw_addr : output logic<64>,
    o_iptw_req  : output logic    ,
    i_iptw_rdata: input  logic<64>,
    // Data DRAM (MMIO stripped out internally; tb serves DRAM)
    // S25: DRAM writes are LINE transactions — 8 dword lanes + per-lane byte
    // strobes at the line-aligned part of o_dmem_addr (lanes with wstrb==0
    // are dont-care). The misaligned hi-side bypass stays dword-wide.
    o_dmem_addr    : output logic<64>    ,
    o_dmem_wdata   : output logic<64> [8],
    i_dmem_rdata   : input  logic<64>    ,
    o_dmem_wen     : output logic        ,
    o_dmem_ren     : output logic        ,
    o_dmem_wstrb   : output logic<8>  [8],
    o_dmem_wdata_hi: output logic<64>    ,
    o_dmem_wstrb_hi: output logic<8>     ,
    // UART TX observation
    o_uart_tx_valid: output logic   ,
    o_uart_tx_data : output logic<8>,
    // Debug: architectural x3 (boot pass = 0xAA)
    o_dbg_r3: output logic<64>,
) {
    // Core <-> SoC dmem wires (pre-decode).
    var c_dmem_addr    : logic<64>     ;
    var c_dmem_wdata   : logic<64> [8] ; // S25: write-channel line lanes
    var c_dmem_wen     : logic         ;
    var c_dmem_ren     : logic         ;
    var c_dmem_wstrb   : logic<8>  [8] ;
    var c_dmem_wdata_hi: logic<64>     ;
    var c_dmem_wstrb_hi: logic<8>      ;
    var c_dmem_req     : logic         ; // core DRAM/bus request (M8.D.3)
    var c_dmem_grant   : logic         ; // bus -> core grant (M8.D.3)
    var c_dbg_regs     : logic<64> [32];

    // MMIO decode (mirrors the standalone tb): DRAM bit31, CLINT 0x02xx_xxxx,
    // UART 0x1xxx_xxxx.
    let in_dram : logic = c_dmem_addr[31];
    let in_clint: logic = c_dmem_addr[31:24] == 8'h02;
    let in_uart : logic = c_dmem_addr[31:28] == 4'h1;
    let in_plic : logic = c_dmem_addr[31:24] == 8'h0c; // P9.5: PLIC 0x0C00_0000
    // S23: the write channel carries its own address.
    var c_dmemw_addr : logic<64>;
    var c_dmemw_req  : logic    ;
    var c_dmemw_grant: logic    ;
    let in_dram_w : logic = c_dmemw_addr[31];
    let in_clint_w: logic = c_dmemw_addr[31:24] == 8'h02;
    let in_uart_w : logic = c_dmemw_addr[31:28] == 4'h1;
    let in_plic_w : logic = c_dmemw_addr[31:24] == 8'h0c;
    // S25: an MMIO/slow store is a one-lane line write; pick its dword.
    let c_dmemw_lane_data: logic<64> = c_dmem_wdata[c_dmemw_addr[5:3]];

    // CLINT (1 hart): msip / mtimecmp / mtime + timer/sw IRQ.
    var clint_rdata: logic<64>    ;
    var clint_t_irq: logic     [1];
    var clint_s_irq: logic     [1];
    var clint_mtime: logic<64>    ;
    inst u_clint: clint #(
        N_HARTS: 1,
    ) (
        clk                                ,
        rst                                ,
        i_addr     : if c_dmem_wen && in_clint_w ? c_dmemw_addr[15:0] : c_dmem_addr[15:0],
        i_wdata    : c_dmemw_lane_data       ,
        i_wen      : c_dmem_wen && in_clint_w,
        i_ren      : c_dmem_ren && in_clint  ,
        o_rdata    : clint_rdata           ,
        o_timer_irq: clint_t_irq           ,
        o_sw_irq   : clint_s_irq           ,
        o_mtime    : clint_mtime           ,
    );

    // UART: byte-wide register file; TX pulse observable externally.
    var uart_rdata: logic<8>;
    var uart_irq  : logic   ;
    inst u_uart: uart (
        clk                              ,
        rst                              ,
        i_addr    : if c_dmem_wen && in_uart_w ? c_dmemw_addr[2:0] : c_dmem_addr[2:0],
        i_wdata   : c_dmemw_lane_data[7:0] ,
        i_wen     : c_dmem_wen && in_uart_w,
        i_ren     : c_dmem_ren && in_uart  ,
        o_rdata   : uart_rdata           ,
        o_tx_valid: o_uart_tx_valid      ,
        o_tx_data : o_uart_tx_data       ,
        i_rx_data : 8'd0                 ,
        i_rx_valid: 1'b0                 ,
        o_irq     : uart_irq             ,
    );

    // P9.5: PLIC — platform external interrupt controller (base 0x0C00_0000).
    // The UART is PLIC source 10 (per the device tree's serial@10000000
    // interrupts=<10>). PLIC context 2h = M-ext (MEIP), 2h+1 = S-ext (SEIP);
    // Linux services device interrupts from S-mode, so o_irq_s drives SEIP.
    var plic_rdata: logic<64> ;
    var plic_irq_m: logic  [1];
    var plic_irq_s: logic  [1];
    let plic_src  : logic<32> = {21'd0, uart_irq, 10'd0}; // bit 10 = UART
    inst u_plic: plic #(
        N_HARTS: 1,
    ) (
        clk                             ,
        rst                             ,
        i_src  : plic_src               ,
        i_addr : if c_dmem_wen && in_plic_w ? c_dmemw_addr[23:0] : c_dmem_addr[23:0],
        i_wdata: c_dmemw_lane_data      ,
        i_wen  : c_dmem_wen && in_plic_w,
        i_ren  : c_dmem_ren && in_plic  ,
        o_rdata: plic_rdata             ,
        o_irq_m: plic_irq_m             ,
        o_irq_s: plic_irq_s             ,
    );

    // Shared L2 cache on the DRAM path (M8.D.2). The L2 sits between the SoC's
    // DRAM decode and the external DRAM port (o_dmem_*). P9.1: DRAM reads are
    // split transactions owned by mem_ctrl (L2 line hit after HIT_WAIT, DRAM
    // gather after DRAM_WAIT); only writes pass through the L2 combinationally.

    // M8.D.3: single-hart memory_bus DRAM arbiter between the core and L2. The
    // arbiter mux carries the core's DRAM request to the L2; it exists to
    // establish the wiring M9 SMP extends to N harts (bump N_HARTS + add a
    // second core). MMIO is still decoded directly in this SoC, so the bus MMIO
    // ports are tied off and its MMIO outputs left open.
    //
    // GRANT (N=1): the bus's o_dmem_grant (== i_dmem_req at N=1, the sole hart
    // always wins) is now fed LIVE into the core's i_dmem_grant. M9.0: this used
    // to hang the boot at x3=0x80a85b60 because of a latent back-pressure bug —
    // the M9.1 core-level grant gate (`dmem_issue_grant_ok`) blocked EVERY
    // LOAD/AMO issue on grant, so a load that HIT the dcache (no bus request →
    // grant==req==0) could never issue (no req → no grant → no issue → no req).
    // Fixed by removing the redundant core-level gate: bus back-pressure is owned
    // solely by the dcache, which asserts o_dmem_req ungated and holds dcache_stall
    // until granted (see heliodor_core dmem_issue note). At N=1 grant tracks
    // req combinationally so this is behaviourally identical to the old grant=1,
    // but the wiring is now the real arbiter feedback that N>=2 SMP requires.
    var bus_dramr_addr: logic<64>    ; // arbiter -> L2 (granted read request)
    var bus_dramw_addr: logic<64>    ;
    var bus_dram_wdata: logic<64> [8];
    var bus_dram_wstrb: logic<8>  [8];
    var bus_dram_wen  : logic        ;
    // S23: write-grant qualification — single downstream DRAM port, reads
    // keep priority. P9.1: a write is held while mem_ctrl gathers a line from
    // DRAM (ctrl_mem_busy) and while a legacy (firmware-ROM) read owns the
    // external port this cycle; CLINT/UART read/write address-port conflicts
    // keep their original terms.
    var bus_dramr_ren: logic;
    var ctrl_mem_busy: logic;
    let r_in_clint    : logic = bus_dramr_addr[31:24] == 8'h02;
    let r_in_uart     : logic = bus_dramr_addr[31:28] == 4'h1;
    let r_in_plic     : logic = bus_dramr_addr[31:24] == 8'h0c; // P9.5: internal MMIO
    // P9.5: PLIC reads are internal MMIO (served by plic_rdata), so they must
    // not be treated as legacy firmware-ROM reads that drive the external port.
    let legacy_ext_read: logic = bus_dramr_ren && !r_in_clint && !r_in_uart && !r_in_plic;
    // P3.b L2 1R1W: hold the grant until l2cache spec-reads the write-hit old line
    // so the merge write is atomic on a single read port. Formed from raw l2 pieces
    // (o_w_hit = partial-hit-needs-merge, gated; o_w_spec_ready = old line ready),
    // driven by the l2 inst below. 0 unless L2_READ_1R1W. No comb loop (comb on
    // pre-grant selection + registered spec, like w_veto).
    var l2_w_hit      : logic;
    var l2_w_spec_ready: logic;
    let l2_w_spec_hold: logic = c_dmemw_req && in_dram_w && l2_w_hit && !l2_w_spec_ready;
    let wgrant_ok: logic = !ctrl_mem_busy && !legacy_ext_read
        && !(c_dmem_ren && in_clint && in_clint_w) && !(c_dmem_ren && in_uart && in_uart_w)
        && !(c_dmem_ren && in_plic && in_plic_w) && !l2_w_spec_hold;
    // Per-hart (N=1) DRAM request bundles into the arbiter (per channel).
    var bus_in_raddr: logic<64> [1];
    var bus_in_ren  : logic     [1];
    var bus_in_rreq : logic     [1];
    var bus_in_waddr: logic<64> [1];
    var bus_in_wdata: logic<64> [8]; // S25: 1 hart x 8 line lanes
    var bus_in_wstrb: logic<8>  [8];
    var bus_in_wen  : logic     [1];
    var bus_in_wreq : logic     [1];
    var bus_dgrant  : logic     [1]; // arbiter -> per-hart READ grant
    var bus_wgrant  : logic     [1]; // arbiter -> per-hart WRITE grant
    // mem_ctrl <-> SoC wires (P9.1 split-transaction DRAM reads).
    var ctrl_bus_rreq : logic     [1];
    var ctrl_hgrant   : logic     [1];
    var ctrl_hrdata   : logic<64> [1];
    var ctrl_hreq     : logic     [1];
    var ctrl_haddr    : logic<64> [1];
    var ctrl_hdram    : logic     [1];
    var ctrl_mem_addr : logic<64>    ;
    var ctrl_mem_ren  : logic        ;
    var l2_caddr      : logic<64>    ;
    var l2_cren       : logic        ;
    var l2_chit       : logic        ;
    var l2_cdata      : logic<64> [8];
    var l2_inst_v     : logic        ;
    var l2_inst_addr  : logic<64>    ;
    var l2_inst_data  : logic<64> [8];
    var l2_mem_addr   : logic<64>    ;
    // P9.2: directory wires (maintained at N=1 too; the invalidate outputs
    // are discarded — no remote L1 exists and the L1 write paths stay
    // self-consistent, see the SMP SoC for the multi-hart wiring).
    var l2_cadd_v     : logic         ;
    var l2_cadd_hart  : logic<3>      ;
    var l2_c_sharers  : logic<1>      ;
    var l2_inst_hart  : logic<3>      ;
    var l2_iv_valid   : logic         ;
    var l2_iv_addr    : logic<64>     ;
    var l2_iv_sharers : logic<1>      ;
    var l2_iv_blocked : logic         ;
    var l2_inst_port_busy: logic      ; // P3.a L2 1R1W: install-yields-to-write hold
    var ctrl_busy_line: logic<58> [1] ;
    var ctrl_busy_v   : logic     [1] ;
    var l2_w_sharers   : logic<1>     ;
    var l2_w_sharers_hi: logic<1>     ;
    var ctrl_inv1_v   : logic     [1] ;
    var ctrl_inv2_v   : logic     [1] ;
    // P9.2 Phase B wires (N=1: the recall engine still serves SELF-recalls —
    // a silently dropped E line leaves a stale owner entry; the write-veto
    // can never fire with a single hart but is wired uniformly).
    var l2_cadd_own   : logic         ;
    var l2_c_owned    : logic         ;
    var l2_inst_oldshr: logic<1>      ;
    var l2_iv_owned   : logic         ;
    var l2_w_owned    : logic         ;
    var l2_w_owned_hi : logic         ;
    var c_dmemw_wb    : logic     [1] ;
    var c_dmem_rfo    : logic     [1] ;
    var c_dmem_iread  : logic     [1] ; // P9.6: read req is an I-cache fill (uncounted)
    var ctrl_hexcl    : logic     [1] ;
    var ctrl_probe_v  : logic     [1] ;
    var ctrl_probe_addr: logic<64>    ;
    var ctrl_probe_self: logic        ;
    var core_probe_ack: logic     [1] ;
    var ctrl_eclr_v   : logic         ;
    var ctrl_eclr_addr: logic<64>     ;
    var ctrl_eclr_hart: logic<3>      ;
    var bus_dramw_wb  : logic         ;
    // P9.3 c2c (dead at N=1: the WB writer is always hart 0 itself).
    var l2_wcadd_v   : logic   ;
    var l2_wcadd_hart: logic<3>;
    var l2_wcadd_own : logic   ;
    assign ctrl_hreq[0]  = c_dmem_req;
    assign ctrl_haddr[0] = c_dmem_addr;
    assign ctrl_hdram[0] = in_dram;
    assign c_dmem_grant  = ctrl_hgrant[0]; // P9.1: grant now comes from mem_ctrl
    assign bus_in_raddr[0] = c_dmem_addr;
    // P9.1: the bus read channel now arbitrates LEGACY (non-DRAM: MMIO /
    // firmware-ROM) combinational reads plus mem_ctrl's DRAM gather beats;
    // DRAM read transactions themselves are accepted/streamed by mem_ctrl.
    assign bus_in_ren[0]   = c_dmem_ren && !in_dram;
    assign bus_in_rreq[0]  = ctrl_bus_rreq[0];
    assign bus_in_waddr[0] = c_dmemw_addr;
    for l in 0..8 :gen_busw_lane {
        assign bus_in_wdata[l] = c_dmem_wdata[l];
        assign bus_in_wstrb[l] = if in_dram_w ? c_dmem_wstrb[l] : 8'd0;
    }
    assign bus_in_wen[0] = c_dmem_wen && in_dram_w;
    assign bus_in_wreq[0]  = c_dmemw_req;
    // P9.1: the READ grant to the core comes from mem_ctrl (accept pulse +
    // stream beats + legacy passthrough); bus_dgrant feeds mem_ctrl instead.
    assign c_dmemw_grant   = bus_wgrant[0];
    // Tied-off MMIO request bundle (MMIO is SoC-decoded, not bus-arbitrated).
    var bus_mmio_paddr: logic<32> [1];
    var bus_mmio_wdata: logic<64> [1];
    var bus_mmio_wstrb: logic<8>  [1];
    var bus_mmio_wen  : logic     [1];
    var bus_mmio_ren  : logic     [1];
    var bus_clint_sel : logic     [1];
    var bus_plic_sel  : logic     [1];
    var bus_uart_sel  : logic     [1];
    var bus_stall_mem : logic     [1];
    assign bus_mmio_paddr[0] = 32'd0;
    assign bus_mmio_wdata[0] = 64'd0;
    assign bus_mmio_wstrb[0] = 8'd0;
    assign bus_mmio_wen[0]   = 1'b0;
    assign bus_mmio_ren[0]   = 1'b0;
    assign bus_clint_sel[0]  = 1'b0;
    assign bus_plic_sel[0]   = 1'b0;
    assign bus_uart_sel[0]   = 1'b0;
    assign bus_stall_mem[0]  = 1'b0;

    // Load data back to the core: CLINT / UART / DRAM (mem_ctrl stream beat) /
    // firmware-ROM (external comb port, legacy path).
    let core_dmem_rdata: logic<64> = if in_clint ?
        clint_rdata
    : if in_uart ?
        {56'd0, uart_rdata}
    : if in_plic ?
        plic_rdata
    : if in_dram ?
        ctrl_hrdata[0]
    :
        i_dmem_rdata
    ;

    inst u_core: heliodor_core #(
        RESET_PC: RESET_PC,
        HART_ID : HART_ID ,
        COHERENT_IFETCH: 1, // P9.6: coherent I-side (mem_ctrl/L2 recall) — no flush sweep
    ) (
        clk                               ,
        rst                               ,
        o_imem_addr      : o_imem_addr    ,
        i_imem_rdata     : i_imem_rdata   ,
        o_imem_ren       : o_imem_ren     ,
        o_iptw_addr      : o_iptw_addr    ,
        o_iptw_req       : o_iptw_req     ,
        i_iptw_rdata     : i_iptw_rdata   ,
        o_dmem_addr      : c_dmem_addr    ,
        o_dmem_wdata     : c_dmem_wdata   ,
        i_dmem_rdata     : core_dmem_rdata,
        i_dmem_rdata_next: 64'd0          , // dead since M8.B (dcache makes its own)
        o_dmem_wen       : c_dmem_wen     ,
        o_dmem_ren       : c_dmem_ren     ,
        o_dmem_wstrb     : c_dmem_wstrb   ,
        o_dmem_wdata_hi  : c_dmem_wdata_hi,
        o_dmem_wstrb_hi  : c_dmem_wstrb_hi,
        o_dmem_req       : c_dmem_req     , // M8.D.3: into the memory_bus arbiter
        i_dmem_grant     : c_dmem_grant   , // M8.D.3: from the memory_bus arbiter
        o_dmemw_addr     : c_dmemw_addr   , // S23: write channel
        o_dmemw_req      : c_dmemw_req    ,
        i_dmemw_grant    : c_dmemw_grant  ,
        o_dmemw_wb       : c_dmemw_wb[0]  , // P9.2: writeback flag
        o_dmem_rfo       : c_dmem_rfo[0]  , // P9.2: store fill = RFO
        o_dmem_iread     : c_dmem_iread[0], // P9.6: I-cache fill (uncounted read)
        i_dmem_fill_excl : ctrl_hexcl[0]  , // P9.2: home grant state
        i_dcache_probe_v   : ctrl_probe_v[0], // P9.2: self-recall probes
        i_dcache_probe_addr: ctrl_probe_addr,
        i_dcache_probe_self: ctrl_probe_self,
        o_dcache_probe_ack : core_probe_ack[0],
        i_dcache_inv_valid: 1'b0          , // M9.0: N=1, no remote coherence
        i_dcache_inv_addr : 64'd0         ,
        i_dcache_inv2_valid: 1'b0         , // P9.2: precise inv unused at N=1
        i_dcache_inv2_addr : 64'd0        ,
        i_irq_timer_m    : clint_t_irq[0] ,
        i_mtime          : clint_mtime    ,
        i_irq_sw_m       : clint_s_irq[0] ,
        i_irq_ext_m      : plic_irq_m[0]  , // P9.5: PLIC M-ext
        i_irq_ext_s      : plic_irq_s[0]  , // P9.5: PLIC S-ext
        o_dbg_regs       : c_dbg_regs     ,
    );

    // Single-hart DRAM arbiter (M8.D.3). MMIO ports tied off / left open; only
    // the DRAM arbiter is used. The granted request drives the L2 below.
    inst u_bus: memory_bus #(
        N_HARTS: 1,
    ) (
        clk                             ,
        rst                             ,
        i_mmio_paddr    : bus_mmio_paddr,
        i_mmio_wdata    : bus_mmio_wdata,
        i_mmio_wstrb    : bus_mmio_wstrb,
        i_mmio_wen      : bus_mmio_wen  ,
        i_mmio_ren      : bus_mmio_ren  ,
        i_clint_sel     : bus_clint_sel ,
        i_plic_sel      : bus_plic_sel  ,
        i_uart_sel      : bus_uart_sel  ,
        i_stall_mem     : bus_stall_mem ,
        o_mmio_paddr    : _             ,
        o_mmio_wdata    : _             ,
        o_mmio_wstrb    : _             ,
        o_mmio_wen_clint: _             ,
        o_mmio_ren_clint: _             ,
        o_mmio_wen_plic : _             ,
        o_mmio_ren_plic : _             ,
        o_mmio_wen_uart : _             ,
        o_mmio_ren_uart : _             ,
        o_mmio_grant    : _             ,
        i_dmemr_addr    : bus_in_raddr  ,
        i_dmemr_ren     : bus_in_ren    ,
        i_dmemr_req     : bus_in_rreq   ,
        i_dmemw_addr    : bus_in_waddr  ,
        i_dmemw_wdata   : bus_in_wdata  ,
        i_dmemw_wstrb   : bus_in_wstrb  ,
        i_dmemw_wen     : bus_in_wen    ,
        i_dmemw_req     : bus_in_wreq   ,
        i_dmemw_wb      : c_dmemw_wb    , // P9.2: writeback flag
        i_wgrant_ok     : wgrant_ok     ,
        o_dmemr_grant   : bus_dgrant    , // M9.0: live grant fed back to the core
        o_dmemw_grant   : bus_wgrant    ,
        o_dmemr_addr    : bus_dramr_addr,
        o_dmemr_ren     : bus_dramr_ren ,
        o_dmemw_addr    : bus_dramw_addr,
        o_dmemw_wdata   : bus_dram_wdata,
        o_dmemw_wstrb   : bus_dram_wstrb,
        o_dmemw_wen     : bus_dram_wen  ,
        o_dmemw_wb      : bus_dramw_wb  , // P9.2
        o_dmemw_sel     : _             , // N=1: write-veto never fires
        o_dmem_inv_valid: _             , // N=1: no coherence broadcast
        o_dmem_inv_addr : _             ,
    );

    // P9.1: split-transaction DRAM read controller. Accepts the core's DRAM
    // read request (fill start), looks the line up in the L2, and serves the
    // 8 beats after the modeled latency (HIT_WAIT for an L2 hit, DRAM_WAIT +
    // an 8-cycle gather for a miss, the gathered line installing into the
    // L2). Legacy (MMIO / firmware-ROM) reads pass through combinationally
    // on the bus's read-channel grant, exactly as pre-P9.1.
    inst u_mctrl: mem_ctrl #(
        N_HARTS: 1,
    ) (
        clk                            ,
        rst                            ,
        i_hreq        : ctrl_hreq      ,
        i_haddr       : ctrl_haddr     ,
        i_hdram       : ctrl_hdram     ,
        o_hgrant      : ctrl_hgrant    ,
        o_hrdata      : ctrl_hrdata    ,
        i_hrfo        : c_dmem_rfo     , // P9.2: store fill = RFO
        i_iread       : c_dmem_iread   , // P9.6: I-cache fill (uncounted read)
        o_hexcl       : ctrl_hexcl     ,
        o_bus_rreq    : ctrl_bus_rreq  ,
        i_bus_rgrant  : bus_dgrant     ,
        o_l2_caddr    : l2_caddr       ,
        o_l2_cren     : l2_cren        ,
        i_l2_chit     : l2_chit        ,
        i_l2_cdata    : l2_cdata       ,
        o_cadd_v      : l2_cadd_v      , // P9.2: directory (single sharer at N=1)
        o_cadd_hart   : l2_cadd_hart   ,
        o_cadd_own    : l2_cadd_own    ,
        i_l2_c_shr    : l2_c_sharers   ,
        i_l2_c_owned  : l2_c_owned     ,
        o_l2_inst_v   : l2_inst_v      ,
        o_l2_inst_addr: l2_inst_addr   ,
        o_l2_inst_data: l2_inst_data   ,
        o_inst_hart   : l2_inst_hart   ,
        i_iv_valid    : l2_iv_valid    ,
        i_iv_addr     : l2_iv_addr     ,
        i_iv_sharers  : l2_iv_sharers  ,
        i_iv_owned    : l2_iv_owned    ,
        i_iv_blocked  : l2_iv_blocked  ,
        i_inst_port_busy: l2_inst_port_busy,
        i_inst_oldshr : l2_inst_oldshr ,
        o_busy_line   : ctrl_busy_line ,
        o_busy_v      : ctrl_busy_v    ,
        i_w_hart      : 3'd0           ,
        i_w_wb        : bus_dramw_wb   ,
        i_w_shr       : l2_w_sharers   ,
        i_w_shr_hi    : l2_w_sharers_hi,
        o_probe_v     : ctrl_probe_v   , // P9.2: self-recall probes
        o_probe_addr  : ctrl_probe_addr,
        o_probe_self  : ctrl_probe_self,
        i_probe_ack   : core_probe_ack ,
        o_eclr_v      : ctrl_eclr_v    ,
        o_eclr_addr   : ctrl_eclr_addr ,
        o_eclr_hart   : ctrl_eclr_hart ,
        i_wv_req      : 1'b0           , // N=1: no foreign owner to recall
        i_wv_line     : '0             ,
        i_wv_hart     : 3'd0           ,
        o_inv1_v      : ctrl_inv1_v    , // N=1: discarded (the writer keeps its
        o_inv1_addr   : _              , // own copy; no remote L1 to invalidate)
        o_inv2_v      : ctrl_inv2_v    ,
        o_inv2_addr   : _              ,
        o_mem_addr    : ctrl_mem_addr  ,
        o_mem_ren     : ctrl_mem_ren   ,
        i_mem_rdata   : i_dmem_rdata   ,
        o_mem_busy    : ctrl_mem_busy  ,
        i_w_valid     : bus_dram_wen   ,
        i_w_addr      : bus_dramw_addr ,
        i_w_hi        : if in_dram_w ? c_dmem_wstrb_hi != 8'd0 : 1'b0,
        i_w_lanes     : bus_dram_wdata , // P9.3: c2c (never fires at N=1 —
        o_w_cadd_v    : l2_wcadd_v     , // the writer is always hart 0)
        o_w_cadd_hart : l2_wcadd_hart  ,
        o_w_cadd_own  : l2_wcadd_own   ,
    );

    // Shared L2 (M8.D.2, P9.1 line-granular). Lookup/copy + line install are
    // driven by mem_ctrl; the write side keeps the bus write channel and its
    // lower interface is now write-passthrough only. i_wstrb_hi (direct from
    // the core — the bus does not carry the hi-side) tells the L2 about a
    // misaligned store whose hi dword bypasses it (below), so it can
    // invalidate the stale line(s).
    inst u_l2: l2cache #(
        N_HARTS: 1,
    ) (
        clk                                               ,
        rst                                               ,
        i_caddr    : l2_caddr                             ,
        i_cren     : l2_cren                              ,
        o_chit     : l2_chit                              ,
        o_cdata    : l2_cdata                             ,
        i_cadd_v   : l2_cadd_v                            , // P9.2: directory
        i_cadd_hart: l2_cadd_hart                         ,
        i_cadd_own : l2_cadd_own                          ,
        o_c_sharers: l2_c_sharers                         ,
        o_c_owned  : l2_c_owned                           ,
        i_inst_v   : l2_inst_v                            ,
        i_inst_addr: l2_inst_addr                         ,
        i_inst_data: l2_inst_data                         ,
        i_inst_hart : l2_inst_hart                        ,
        o_iv_valid  : l2_iv_valid                         ,
        o_iv_addr   : l2_iv_addr                          ,
        o_iv_sharers: l2_iv_sharers                       ,
        o_iv_owned  : l2_iv_owned                         ,
        o_iv_blocked: l2_iv_blocked                       ,
        o_inst_port_busy: l2_inst_port_busy               ,
        o_inst_oldshr: l2_inst_oldshr                     ,
        i_busy_line : ctrl_busy_line                      ,
        i_busy_v    : ctrl_busy_v                         ,
        i_w_hart      : 3'd0                              ,
        i_w_wb        : bus_dramw_wb                      ,
        i_w_cadd_v   : l2_wcadd_v   , // P9.3: c2c requester add
        i_w_cadd_hart: l2_wcadd_hart,
        i_w_cadd_own : l2_wcadd_own ,
        o_w_sharers   : l2_w_sharers                      ,
        o_w_sharers_hi: l2_w_sharers_hi                   ,
        o_w_owned     : l2_w_owned                        ,
        o_w_owned_hi  : l2_w_owned_hi                     ,
        i_eclr_v   : ctrl_eclr_v                          ,
        i_eclr_addr: ctrl_eclr_addr                       ,
        i_eclr_hart: ctrl_eclr_hart                       ,
        i_waddr    : bus_dramw_addr                       ,
        i_wdata    : bus_dram_wdata                       ,
        i_wstrb    : bus_dram_wstrb                       ,
        i_wstrb_hi : if in_dram_w ? c_dmem_wstrb_hi : 8'd0,
        i_wen      : bus_dram_wen                         ,
        i_w_req      : c_dmemw_req && in_dram_w           , // P3.b: DRAM write requested (pre-grant)
        o_w_hit       : l2_w_hit                          , // P3.b: raw hold pieces (combined at SoC)
        o_w_spec_ready: l2_w_spec_ready                   ,
        o_mem_addr : l2_mem_addr                          ,
        o_mem_wdata: o_dmem_wdata                         ,
        o_mem_wstrb: o_dmem_wstrb                         ,
        o_mem_wen  : o_dmem_wen                           ,
    );

    // P9.2: directory-side outputs unused at N=1 (no remote L1 / no veto).
    let _unused_dir: logic = ctrl_inv1_v[0] | ctrl_inv2_v[0] | l2_w_owned | l2_w_owned_hi;

    // External DRAM port muxing. The three users are mutually exclusive by
    // construction: a gather beat (ctrl_mem_busy) blocks writes through
    // wgrant_ok and excludes a same-cycle legacy read (single read grant);
    // wgrant_ok also blocks writes on legacy firmware-ROM read cycles.
    assign o_dmem_addr = if ctrl_mem_busy ?
        ctrl_mem_addr
    : if o_dmem_wen ?
        l2_mem_addr
    :
        bus_dramr_addr
    ;
    assign o_dmem_ren = ctrl_mem_ren || legacy_ext_read;

    // Misaligned-store hi-side carry (addr+8) bypasses L2 straight to DRAM; the
    // L2 invalidate (driven by i_wstrb_hi) keeps its cached copy from going
    // stale. DRAM-only, so gate the strobe on in_dram.
    assign o_dmem_wdata_hi = c_dmem_wdata_hi;
    assign o_dmem_wstrb_hi = if in_dram_w ? c_dmem_wstrb_hi : 8'd0;

    assign o_dbg_r3 = c_dbg_regs[3];
}
