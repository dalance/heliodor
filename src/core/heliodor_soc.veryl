// Multi-hart heliodor SoC (Phase 4).
//
// N heliodor_core copies (HART_ID = 0..N-1) + a single shared CLINT/PLIC/UART.
// MMIO requests are arbitrated by memory_bus; imem/iptw/dmem stay per-hart and
// are exported as N-wide arrays so the test harness attaches a multi-port DRAM.
//
// All heliodor_core o_dbg_* ports are intentionally left unconnected — the
// Veryl analyzer raises warnings, not errors.
// Hardcoded 2=2 to keep the simulator's analyze_dependency happy with
// dynamic-index patterns. 2=1 should use heliodor_top instead.
pub module heliodor_soc #(
    param RESET_PC: u64 = 0,
) (
    // 2 is fixed to 2 for now. To support 4 we'd unroll
    // bus_inv_* manually like the N=2 path below.
    clk: input clock,
    rst: input reset,
    // Per-hart instruction memory
    o_imem_addr : output logic<64> [2],
    i_imem_rdata: input  logic<32> [2],
    o_imem_ren  : output logic     [2],
    o_iptw_addr : output logic<64> [2],
    o_iptw_req  : output logic     [2],
    i_iptw_rdata: input  logic<64> [2],
    // Single-port DRAM bus (Phase 5). The SoC arbitrates per-hart
    // dcache requests through memory_bus and emits a single shared
    // DRAM transaction stream. The same i_dmem_rdata is broadcast to
    // every hart; only the granted hart consumes it.
    o_dmem_addr : output logic<64>,
    o_dmem_wdata: output logic<64>,
    i_dmem_rdata: input  logic<64>,
    o_dmem_wen  : output logic    ,
    o_dmem_ren  : output logic    ,
    o_dmem_wstrb: output logic<8> ,
    // External interrupt sources (shared PLIC)
    i_ext_irq: input logic<32>,
    // UART (single shared instance)
    o_uart_tx      : output logic   ,
    o_uart_data    : output logic<8>,
    i_uart_rx_data : input  logic<8>,
    i_uart_rx_valid: input  logic   ,
    // Debug — hart 0 x3 (SBI shutdown pass criterion) + secondary observability.
    o_dbg_h0_x3      : output logic<64>,
    // Per-hart PC for secondary online verification (hart 1 entering kernel
    // address space ≥ 0x80000000 indicates SBI HSM HART_START handoff worked).
    // Hart 0 is also exposed for symmetric debug.
    o_dbg_h0_pc      : output logic<64>,
    o_dbg_h1_pc      : output logic<64>,
    // Per-hart instruction retirement counter (any non-zero on hart 1 means
    // secondary actually executed instructions in kernel mode).
    o_dbg_h1_instret : output logic    ,
    // Per-hart SW IRQ (CLINT MSIP) line into the core. Used by tb to
    // confirm whether sbi_ipi's `sw msip[1]=1` actually reaches the
    // CLINT and asserts hart 1's MSIP wire.
    o_dbg_h1_sw_irq  : output logic    ,
    o_dbg_h0_sw_irq  : output logic    ,
    // CLINT MMIO write probes — bus_wen_clint pulses high on any cycle a
    // hart's MMIO write hits the CLINT range, with bus_paddr the lower 16
    // bits of the address. Used by tb to confirm whether sbi_ipi's
    // sw msip[1]=1 actually reaches the CLINT input.
    o_dbg_clint_wen  : output logic     ,
    o_dbg_clint_addr : output logic<16>,
    o_dbg_clint_wdata: output logic<64>,
    // Per-hart bus invalidate-receive probes. Pulses high on any cycle
    // a remote-hart write generates a cache-line invalidate to this hart.
    // Used by tb to confirm cache coherence broadcasts actually reach
    // both harts.
    o_dbg_h0_inv_valid: output logic   ,
    o_dbg_h1_inv_valid: output logic   ,
) {
    // ============================================================
    // Per-hart wires (core ↔ memory_bus / peripherals)
    // ============================================================
    var core_mmio_paddr : logic<32> [2];
    var core_mmio_wdata : logic<64> [2];
    var core_mmio_wstrb : logic<8>  [2];
    var core_mmio_wen   : logic     [2];
    var core_mmio_ren   : logic     [2];
    var core_stall_mem  : logic     [2];
    var core_clint_sel  : logic     [2];
    var core_plic_sel   : logic     [2];
    var core_uart_sel   : logic     [2];

    // Granted MMIO bundle (memory_bus → CLINT/PLIC/UART)
    var bus_paddr      : logic<32>;
    var bus_wdata      : logic<64>;
    var bus_wstrb      : logic<8> ;
    var bus_wen_clint  : logic    ;
    var bus_ren_clint  : logic    ;
    var bus_wen_plic   : logic    ;
    var bus_ren_plic   : logic    ;
    var bus_wen_uart   : logic    ;
    var bus_ren_uart   : logic    ;

    // dcache invalidate broadcast (memory_bus → each core)
    var bus_inv_valid: logic     [2];
    var bus_inv_addr : logic<64> [2];

    // Phase 5: invalidate pulse from memory_bus on the granted write.
    // Broadcast to both harts (each hart sees its own write reflected,
    // which is harmless since the line is being written by that hart and
    // its dcache state matches).
    var bus_dmem_inv_valid: logic    ;
    var bus_dmem_inv_addr : logic<64>;

    // Peripheral rdata (broadcast to all cores).
    // 1-cycle delayed copies are fed to the core's i_*_rdata ports so the
    // cross-module comb path  core.o_mmio_paddr → bus → peripheral.rdata →
    // core.i_clint_rdata → core internal → core.o_mmio_paddr  is broken by
    // a flop. The peripherals themselves are still combinational reads;
    // the delay only adds a one-cycle pipeline lag to MMIO loads, which
    // Linux tolerates (mtime/MIP/PLIC reads are not edge-sensitive).
    var clint_rdata    : logic<64>;
    var plic_rdata     : logic<64>;
    var uart_rdata     : logic<8> ;
    var uart_irq       : logic    ;
    var clint_rdata_q  : logic<64>;
    var plic_rdata_q   : logic<64>;
    var uart_rdata_q   : logic<8> ;
    always_ff (clk, rst) {
        if_reset {
            clint_rdata_q = 64'd0;
            plic_rdata_q  = 64'd0;
            uart_rdata_q  = 8'd0;
        } else {
            clint_rdata_q = clint_rdata;
            plic_rdata_q  = plic_rdata;
            uart_rdata_q  = uart_rdata;
        }
    }

    // Per-hart interrupt arrays from CLINT / PLIC
    var timer_irq_arr : logic [2];
    var sw_irq_arr    : logic [2];
    var plic_irq_m_arr: logic [2];
    var plic_irq_s_arr: logic [2];
    var mtime_val     : logic<64>;

    // ============================================================
    // Heliodor cores (generate-for)
    // Most debug outputs are unconnected; per-hart x3 is forwarded so
    // tb harnesses can observe SBI shutdown convention (hart 0 writes
    // 0xAA on success).
    // ============================================================
    var dbg_r3_arr      : logic<64> [2];
    var dbg_pc_arr      : logic<64> [2];
    var dbg_instret_arr : logic     [2];
    var core_amo_inflight: logic    [2];
    var core_reserv_valid: logic    [2];
    // Phase 5: per-hart dcache request bundles, fed into memory_bus DRAM
    // arbiter. Single shared o_dmem_* output is driven by memory_bus.
    var core_dmem_addr  : logic<64> [2];
    var core_dmem_wdata : logic<64> [2];
    var core_dmem_wstrb : logic<8>  [2];
    var core_dmem_wen   : logic     [2];
    var core_dmem_ren   : logic     [2];
    var core_dmem_req   : logic     [2];
    var core_dmem_grant : logic     [2];
    for h in 0..2: gen_core {
        inst u_core: heliodor_core #(
            DEBUG   : 1                    ,
            RESET_PC: RESET_PC             ,
            HART_ID : h as 8               ,
        ) (
            clk                                 ,
            rst                                 ,
            o_imem_addr  : o_imem_addr[h]       ,
            i_imem_rdata : i_imem_rdata[h]      ,
            o_imem_ren   : o_imem_ren[h]        ,
            o_iptw_addr  : o_iptw_addr[h]       ,
            o_iptw_req   : o_iptw_req[h]        ,
            i_iptw_rdata : i_iptw_rdata[h]      ,
            o_dmem_addr  : core_dmem_addr[h]    ,
            o_dmem_wdata : core_dmem_wdata[h]   ,
            i_dmem_rdata : i_dmem_rdata         ,
            o_dmem_wen   : core_dmem_wen[h]     ,
            o_dmem_ren   : core_dmem_ren[h]     ,
            o_dmem_wstrb : core_dmem_wstrb[h]   ,
            o_dmem_req   : core_dmem_req[h]     ,
            o_mmio_paddr : core_mmio_paddr[h]   ,
            o_mmio_wdata : core_mmio_wdata[h]   ,
            o_mmio_wstrb : core_mmio_wstrb[h]   ,
            o_mmio_wen   : core_mmio_wen[h]     ,
            o_mmio_ren   : core_mmio_ren[h]     ,
            o_stall_mem  : core_stall_mem[h]    ,
            o_clint_sel  : core_clint_sel[h]    ,
            o_plic_sel   : core_plic_sel[h]     ,
            o_uart_sel   : core_uart_sel[h]     ,
            i_clint_rdata: clint_rdata_q        ,
            i_plic_rdata : plic_rdata_q         ,
            i_uart_rdata : uart_rdata_q         ,
            i_timer_irq  : timer_irq_arr[h]     ,
            i_sw_irq     : sw_irq_arr[h]        ,
            i_plic_irq_m : plic_irq_m_arr[h]    ,
            i_plic_irq_s : plic_irq_s_arr[h]    ,
            i_mtime      : mtime_val            ,
            i_dcache_inv_valid: bus_inv_valid[h],
            i_dcache_inv_addr : bus_inv_addr [h],
            o_amo_inflight    : core_amo_inflight[h],
            o_reserv_valid    : core_reserv_valid[h],
            // Phase 5: dcache bus arbitration through memory_bus. memory_bus
            // tracks per-hart i_dmem_req + i_amo_inflight and grants one hart
            // per cycle. AMO inflight gives the holder an exclusive lock so
            // the RMW window is bus-atomic (kernel hart_lottery now works).
            i_dmem_grant      : core_dmem_grant[h],
            o_dbg_r3     : dbg_r3_arr[h]        ,
            o_dbg_pc     : dbg_pc_arr[h]        ,
            o_dbg_instret: dbg_instret_arr[h]   ,
        );
    }
    assign o_dbg_h0_x3      = dbg_r3_arr[0];
    assign o_dbg_h0_pc      = dbg_pc_arr[0];
    assign o_dbg_h1_pc      = if 2 >= 2 ? dbg_pc_arr[1]      : 64'd0;
    assign o_dbg_h1_instret = if 2 >= 2 ? dbg_instret_arr[1] : 1'b0;
    assign o_dbg_h1_sw_irq  = if 2 >= 2 ? sw_irq_arr[1]      : 1'b0;
    assign o_dbg_h0_sw_irq  = sw_irq_arr[0];
    assign o_dbg_clint_wen  = bus_wen_clint;
    assign o_dbg_clint_addr = bus_paddr[15:0];
    assign o_dbg_clint_wdata = bus_wdata;
    assign o_dbg_h0_inv_valid = bus_inv_valid[0];
    assign o_dbg_h1_inv_valid = bus_inv_valid[1];

    // ============================================================
    // memory_bus
    // ============================================================
    inst u_mmio_bus: memory_bus #(
        N_HARTS: 2,
    ) (
        clk             ,
        rst             ,
        i_mmio_paddr    : core_mmio_paddr,
        i_mmio_wdata    : core_mmio_wdata,
        i_mmio_wstrb    : core_mmio_wstrb,
        i_mmio_wen      : core_mmio_wen  ,
        i_mmio_ren      : core_mmio_ren  ,
        i_clint_sel     : core_clint_sel ,
        i_plic_sel      : core_plic_sel  ,
        i_uart_sel      : core_uart_sel  ,
        i_stall_mem     : core_stall_mem ,
        o_mmio_paddr    : bus_paddr      ,
        o_mmio_wdata    : bus_wdata      ,
        o_mmio_wstrb    : bus_wstrb      ,
        o_mmio_wen_clint: bus_wen_clint  ,
        o_mmio_ren_clint: bus_ren_clint  ,
        o_mmio_wen_plic : bus_wen_plic   ,
        o_mmio_ren_plic : bus_ren_plic   ,
        o_mmio_wen_uart : bus_wen_uart   ,
        o_mmio_ren_uart : bus_ren_uart   ,
        // Phase 5 DRAM single-port arbitration
        i_dmem_addr     : core_dmem_addr  ,
        i_dmem_wdata    : core_dmem_wdata ,
        i_dmem_wstrb    : core_dmem_wstrb ,
        i_dmem_wen      : core_dmem_wen   ,
        i_dmem_ren      : core_dmem_ren   ,
        i_dmem_req      : core_dmem_req   ,
        i_amo_inflight  : core_amo_inflight,
        o_dmem_grant    : core_dmem_grant ,
        o_dmem_addr     : o_dmem_addr     ,
        o_dmem_wdata    : o_dmem_wdata    ,
        o_dmem_wstrb    : o_dmem_wstrb    ,
        o_dmem_wen      : o_dmem_wen      ,
        o_dmem_ren      : o_dmem_ren      ,
        // memory_bus emits inv pulse on the granted write — fed into both
        // harts' dcache invalidate ports below (broadcast).
        o_dmem_inv_valid: bus_dmem_inv_valid,
        o_dmem_inv_addr : bus_dmem_inv_addr ,
    );

    // ============================================================
    // dcache invalidate broadcast (Phase 5).
    // memory_bus emits one inv pulse per granted DRAM write. Forward
    // combinationally (same cycle as the write commit) to every OTHER
    // hart's dcache invalidate input. The writer hart sees its own
    // write as a no-op (line was just updated by it).
    //
    // Same-cycle delivery is required for Linux SMP memory ordering:
    // a 1-cycle flop here lets the receiver's same-cycle read return a
    // stale value, which corrupts kthread structs during secondary CPU
    // bring-up (Oops at PC 0x207ff400 from a broken function pointer).
    //
    // No comb loop forms because every signal in the path is sourced
    // from a flop on either end (core_dmem_wen/grant come out of dcache
    // always_ff, and i_inv_valid feeds dcache always_ff on the receiver).
    // ============================================================
    if 2 == 2: gen_inv2 {
        // Forward invalidates to the non-writer hart. The receiver's
        // amo_inflight is intentionally NOT gated here: memory_bus
        // already prevents the writer hart from being granted while a
        // remote AMO holds the lock, so dropping invalidates on the
        // receiver only dropped legitimate cross-line writes when both
        // harts were doing independent AMOs simultaneously (scheduler
        // run-queue cmpxchg pattern). LR-SC reservation flush is handled
        // by memory.veryl's i_remote_inv_valid path.
        let inv_v   : logic = bus_dmem_inv_valid && bus_dmem_inv_addr[31];
        let inv_src : logic = core_dmem_grant[1] && core_dmem_wen[1]; // 1 = hart 1 wrote
        assign bus_inv_valid[0] = inv_v && inv_src;
        assign bus_inv_addr [0] = bus_dmem_inv_addr;
        assign bus_inv_valid[1] = inv_v && !inv_src;
        assign bus_inv_addr [1] = bus_dmem_inv_addr;
    } else: gen_inv_other {
        // N == 1 (or N >= 3): no broadcast.
        for h in 0..2: gen_tie {
            assign bus_inv_valid[h] = 1'b0;
            assign bus_inv_addr [h] = 64'd0;
        }
    }

    // ============================================================
    // CLINT
    // ============================================================
    inst u_clint: clint #(
        N_HARTS: 2,
    ) (
        clk                                ,
        rst                                ,
        i_addr     : bus_paddr[15:0]       ,
        i_wdata    : bus_wdata             ,
        i_wen      : bus_wen_clint         ,
        i_ren      : bus_ren_clint         ,
        o_rdata    : clint_rdata           ,
        o_timer_irq: timer_irq_arr         ,
        o_sw_irq   : sw_irq_arr            ,
        o_mtime    : mtime_val             ,
    );

    // ============================================================
    // PLIC
    // ============================================================
    inst u_plic: plic #(
        N_HARTS: 2,
    ) (
        clk                                          ,
        rst                                          ,
        i_src  : i_ext_irq | {21'd0, uart_irq, 10'd0},
        i_addr : bus_paddr[23:0]                     ,
        i_wdata: bus_wdata                           ,
        i_wen  : bus_wen_plic                        ,
        i_ren  : bus_ren_plic                        ,
        o_rdata: plic_rdata                          ,
        o_irq_m: plic_irq_m_arr                      ,
        o_irq_s: plic_irq_s_arr                      ,
    );

    // ============================================================
    // UART
    // ============================================================
    inst u_uart: uart (
        clk                                ,
        rst                                ,
        i_addr    : bus_paddr[2:0]         ,
        i_wdata   : bus_wdata[7:0]         ,
        i_wen     : bus_wen_uart           ,
        i_ren     : bus_ren_uart           ,
        o_rdata   : uart_rdata             ,
        o_tx_valid: o_uart_tx              ,
        o_tx_data : o_uart_data            ,
        i_rx_data : i_uart_rx_data         ,
        i_rx_valid: i_uart_rx_valid        ,
        o_irq     : uart_irq               ,
    );
}
