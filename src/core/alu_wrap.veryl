// Phase 7 v4: ALU + branch execute wrapper.
//
// Combinational shell around v1 `alu`. Takes one issued op from
// `iq_int` along with PRF-read source values, computes the ALU
// result, evaluates branch / JAL / JALR target + misprediction, and
// emits one CDB entry per cycle.
//
// Branch logic:
//   - cond branches: ALU output not used for rd; instead, compare
//     unit decides taken/not-taken via br_cond; target = pc + imm
//   - JAL : target = pc + imm; wb = pc + 4
//   - JALR: target = (rs1 + imm) & ~1; wb = pc + 4
//   - LUI / AUIPC: ALU SrcA forced to 0/PC, SrcB = imm
//
// Misprediction is detected against an upstream prediction encoded in
// the RenamedOp.base. For M1 we ignore prediction (always predict
// fall-through) so any taken branch / JAL / JALR is a mispredict.
// M2 adds gshare+BTB+RAS and predict_target carried in DecodedOp.
pub module alu_wrap #(
    param PRF_W    : u32 = 6,
    param ROB_IDX_W: u32 = 5,
) (
    // Issued op (combinational input from iq_int)
    i_issue_valid: input logic                     ,
    i_issue_op   : input pipeline_pkg::RenamedOp,
    // Per-field issue inputs (sim-bug workaround for cross-module struct-port).
    i_issue_rd_pdst: input logic<PRF_W>    ,
    i_issue_rob_idx: input logic<ROB_IDX_W>,

    // PRF read values (from prf_int)
    i_rs1_data: input logic<64>,
    i_rs2_data: input logic<64>,

    // P10 Supm/Ssnpm pointer masking. i_pm_mode is the effective PMM for this
    // access's privilege mode (00=off, 10=PMLEN7, 11=PMLEN16); i_pm_va selects
    // sign-extension (translated VA) vs zero-fill (bare PA) of the masked bits.
    // Applied to the data effective address (agu_addr) only; off (00) at reset.
    i_pm_mode: input logic<2>,
    i_pm_va  : input logic    ,

    // M2: LOAD return data from dmem (toy memory: combinational read).
    // Sampled when i_issue_op.base.is_load is true.
    i_load_data: input logic<64>,
    // M5.D dmem MMU fault inputs — combinational from dmem_mmu's o_fault
    // / o_fault_store. When set during a is_load (i_dmem_fault) or
    // is_store/is_amo (i_dmem_fault_s) access, the CDB writeback flags the
    // ROB entry for trap commit (cause=13/15).
    i_dmem_fault  : input logic,
    i_dmem_fault_s: input logic,
    // PMP (Smpmp) access fault (cause 5 load / 7 store) for the issuing access,
    // distinct from the page fault above. Mutually exclusive with i_dmem_fault.
    i_dmem_acc_fault  : input logic,
    i_dmem_acc_fault_s: input logic,
    // PMP (Smpmp) WRITE-permission denial for an SC at issue. An SC whose
    // reservation is invalid clears its store flag (no commit-time store, so
    // u_pmp_amo_commit never runs), yet the spec/ACT4 still require a store
    // access fault (cause 7) when the SC's address is W-denied — regardless of
    // the reservation. The core checks the SC's bare PA at issue and routes the
    // deny here; we fold it into the CDB store-fault. Bare-mode SC only.
    i_sc_acc_fault: input logic,
    // M8: next dword for misaligned LH/LW/LD that span 2 dwords.
    i_load_data_next: input logic<64>,
    // Phase 8 S5.1 store-to-load forward. The byte-network is computed in the CORE
    // (where the ROB store shadow and agu_addr are forward-refs / local — a large
    // comb reading a backward-referenced cross-module array breaks the Veryl-sim
    // settle and hangs). Here we only merge: i_fwd_mask[p]=1 → byte p of the
    // naturally-aligned load value comes from i_fwd_data[p*8+:8] (an older store)
    // instead of the dcache. 8 CONSTANT-slice selects (loop-var part-select WRITE
    // would re-trip a dynamic-write sim bug). Tied 0 on pipe-1 (no LOAD there).
    i_fwd_data: input logic<64>,
    i_fwd_mask: input logic<8> ,

    // M4: CSR combinational read value (from csr.o_rd_data),
    // sampled at issue time. CSR write side-band lives in o_cdb.
    i_csr_data: input logic<64>,

    // M5.A LR/SC reservation (single-hart). When SC is issued and
    // (rsv_valid && rsv_addr == agu_addr) the SC commits the STORE and
    // returns 0 to rd; otherwise no STORE is committed and rd = 1.
    i_rsv_valid: input logic    ,
    i_rsv_addr : input logic<64>,

    // M5.A per-field AMO inputs (bypass cross-module struct-port sim
    // bug): authoritative is_amo / amo_funct5 from iq_int per-field
    // outputs, plus is_amo_w derived from mem_funct3.
    i_is_amo    : input logic   ,
    i_amo_funct5: input logic<5>,
    // Zacas (amocas) — the comparison/expected value is the OLD architectural
    // value of rd (amocas reads rd as a third source). The core reads it from
    // prf[old_rd_pdst] and supplies it here. amocas writes the new value (rs2)
    // to memory only when mem == rd_cmp at the access width, and returns the old
    // memory value to rd (sign-extended). An AMO issues only at the ROB head, so
    // old_rd_pdst's producer has already committed — this value is always ready
    // (no IQ wakeup tracking needed). Unused for non-CAS AMOs.
    i_rd_cmp_data: input logic<64>,
    // M5.D per-field CSR inputs (same workaround).
    i_is_csr  : input logic                 ,
    i_csr_addr: input logic             <12>,
    i_csr_op  : input csr_pkg::CsrOp        ,
    i_csr_imm : input logic                 ,
    i_rs1_arch: input logic             <5> ,
    i_priv    : input csr_pkg::PrivLevel    ,
    // M6.B.3: FP load (FLW/FLD). Result goes to the FP regfile (the core
    // routes it via cdb_dest_is_fp); FLW (funct3=010) is NaN-boxed instead
    // of sign-extended. FP store data is supplied by the core on i_rs2_data.
    i_fp_ld: input logic,

    // CDB output (1-wide M1)
    o_cdb: output pipeline_pkg::CdbBus,
    // Debug: expose ALU operand observation for cosim trace
    o_dbg_alu_pc      : output logic<64>,
    o_dbg_alu_src_a   : output logic<64>,
    o_dbg_alu_src_b   : output logic<64>,
    o_dbg_alu_use_pc_a: output logic    ,
    o_dbg_alu_rs1_data: output logic<64>,
    o_dbg_alu_valid   : output logic    ,
    o_dbg_alu_alu_out : output logic<64>,
    o_dbg_alu_instr   : output logic<32>,
    o_dbg_alu_imm     : output logic<64>,
) {
    // ALU operand select
    let src_a: logic<64> = if i_issue_op.base.use_zero_a ?
        64'd0
    : if i_issue_op.base.use_pc_a ?
        i_issue_op.base.pc
    :
        i_rs1_data
    ;
    let src_b: logic<64> = if i_issue_op.base.use_imm_b ? i_issue_op.base.imm : i_rs2_data;

    var alu_out: logic<64>;
    inst u_alu: alu ( i_op: i_issue_op.base.alu_op, i_a: src_a, i_b: src_b, o_out: alu_out );

    // Branch evaluation
    let s1_eq : logic = i_rs1_data == i_rs2_data;
    let s1_lt : logic = $signed(i_rs1_data) <: $signed(i_rs2_data);
    let s1_ltu: logic = i_rs1_data <: i_rs2_data;

    var br_taken: logic;
    always_comb {
        case i_issue_op.base.br_cond {
            pipeline_pkg::BrCond::BEQ : br_taken = s1_eq;
            pipeline_pkg::BrCond::BNE : br_taken = !s1_eq;
            pipeline_pkg::BrCond::BLT : br_taken = s1_lt;
            pipeline_pkg::BrCond::BGE : br_taken = !s1_lt;
            pipeline_pkg::BrCond::BLTU: br_taken = s1_ltu;
            pipeline_pkg::BrCond::BGEU: br_taken = !s1_ltu;
            default                      : br_taken = 1'b0;
        }
    }

    // Resolved branch / JAL / JALR target
    let br_target  : logic<64> = i_issue_op.base.pc + i_issue_op.base.imm;
    let jalr_target: logic<64> = (i_rs1_data + i_issue_op.base.imm) & {63'h7fff_ffff_ffff_ffff, 1'b0};
    let pc_plus4   : logic<64> = i_issue_op.base.pc + 64'd4;
    let pc_plus2   : logic<64> = i_issue_op.base.pc + 64'd2; // RVC link (M7)

    var resolved_target: logic<64>;
    var taken          : logic    ;
    var is_ctrl        : logic    ;
    always_comb {
        is_ctrl = i_issue_op.base.is_branch || i_issue_op.base.is_jal || i_issue_op.base.is_jalr;
        if i_issue_op.base.is_jalr {
            resolved_target = jalr_target;
            taken           = 1'b1;
        } else if i_issue_op.base.is_jal {
            resolved_target = br_target;
            taken           = 1'b1;
        } else if i_issue_op.base.is_branch {
            // M7: not-taken target = pc+2 for RVC branches, pc+4 otherwise.
            let fall_pc        : logic<64> = if i_issue_op.base.is_rvc ? pc_plus2 : pc_plus4;
            resolved_target = if br_taken ? br_target : fall_pc;
            taken           = br_taken;
        } else {
            resolved_target = pc_plus4;
            taken           = 1'b0;
        }
    }

    // ============================================================
    // M2: LOAD / STORE address generation and result wiring
    // ============================================================
    // AGU address = rs1 + sign-extended imm (same as RISC-V I-type
    // load / S-type store). For STORE the immediate decode path is
    // S-type but imm_gen already provides the correct sign-extended
    // value.
    // M5.A AMO: address = rs1 directly (no immediate). We override the
    // immediate component to zero when is_amo.
    let agu_imm : logic<64> = if i_is_amo ? 64'd0 : i_issue_op.base.imm;
    let agu_raw : logic<64> = i_rs1_data + agu_imm;
    // P10 Supm/Ssnpm: apply pointer masking to the effective address so every
    // downstream use (translation, store address, AMO/SC, fault tval, store→load
    // forwarding) sees the same transformed address. PMLEN 7 masks [63:57],
    // PMLEN 16 masks [63:48]; the masked bits are sign-extended for a VA
    // (i_pm_va) or zeroed for a bare PA. Mode 00 (reset/legacy) is a no-op, so
    // existing code is byte-identical.
    var agu_addr: logic<64>;
    always_comb {
        case i_pm_mode {
            2'b10  : agu_addr = {(if i_pm_va ? agu_raw[56] : 1'b0) repeat 7, agu_raw[56:0]};
            2'b11  : agu_addr = {(if i_pm_va ? agu_raw[47] : 1'b0) repeat 16, agu_raw[47:0]};
            default: agu_addr = agu_raw;
        }
    }

    // LOAD funct3 sub-decode (sign / zero extend, byte / half / word / dword).
    let f3      : logic<3> = i_issue_op.base.mem_funct3;
    let byte_off: logic<3> = agu_addr[2:0];
    // Word-aligned (8-byte) read from i_load_data — toy memory returns
    // the 64-bit dword containing agu_addr.
    // M8: 128-bit concat of current + next dword, shifted by byte_off*8.
    // Covers any misalign within or across one dword boundary (RV64
    // max element is 8 bytes, max needed window is 15 bytes).
    let ld_shift_amt: logic<7>   = {byte_off, 3'b000} as 7;
    let ld_concat   : logic<128> = {i_load_data_next, i_load_data};
    let ld_shifted_w: logic<128> = ld_concat >> ld_shift_amt;
    let ld_shifted  : logic<64>  = ld_shifted_w[63:0];
    // Phase 8 S5.1: merge the core-computed forward bytes over the dcache bytes.
    // i_fwd_data is already in the naturally-aligned load frame (byte p = memory
    // address agu_addr+p, matching ld_shifted), so this is 8 constant-slice
    // selects. AMO is unaffected (it reads i_load_data directly, not ld_merged).
    let ld_merged: logic<64> = {
        if i_fwd_mask[7] ? i_fwd_data[63:56] : ld_shifted[63:56],
        if i_fwd_mask[6] ? i_fwd_data[55:48] : ld_shifted[55:48],
        if i_fwd_mask[5] ? i_fwd_data[47:40] : ld_shifted[47:40],
        if i_fwd_mask[4] ? i_fwd_data[39:32] : ld_shifted[39:32],
        if i_fwd_mask[3] ? i_fwd_data[31:24] : ld_shifted[31:24],
        if i_fwd_mask[2] ? i_fwd_data[23:16] : ld_shifted[23:16],
        if i_fwd_mask[1] ? i_fwd_data[15:8] : ld_shifted[15:8],
        if i_fwd_mask[0] ? i_fwd_data[7:0] : ld_shifted[7:0]
    };
    let ld_b_raw    : logic<8>   = ld_merged[7:0];
    let ld_h_raw    : logic<16>  = ld_merged[15:0];
    let ld_w_raw    : logic<32>  = ld_merged[31:0];
    let ld_d        : logic<64>  = ld_merged;
    let ld_b_sext   : logic<56>  = if ld_b_raw[7] ? 56'hff_ffff_ffff_ffff : 56'd0;
    let ld_h_sext   : logic<48>  = if ld_h_raw[15] ? 48'hffff_ffff_ffff : 48'd0;
    let ld_w_sext   : logic<32>  = if ld_w_raw[31] ? 32'hffff_ffff : 32'd0;
    let ld_lb       : logic<64>  = {ld_b_sext, ld_b_raw};
    let ld_lh       : logic<64>  = {ld_h_sext, ld_h_raw};
    let ld_lw       : logic<64>  = {ld_w_sext, ld_w_raw};
    let ld_lbu      : logic<64>  = {56'd0, ld_b_raw};
    let ld_lhu      : logic<64>  = {48'd0, ld_h_raw};
    let ld_lwu      : logic<64>  = {32'd0, ld_w_raw};

    var load_data_sel: logic<64>;
    always_comb {
        case f3 {
            3'b000 : load_data_sel = ld_lb; // LB
            3'b001 : load_data_sel = ld_lh; // LH
            3'b010 : load_data_sel = ld_lw; // LW
            3'b011 : load_data_sel = ld_d; // LD
            3'b100 : load_data_sel = ld_lbu; // LBU
            3'b101 : load_data_sel = ld_lhu; // LHU
            3'b110 : load_data_sel = ld_lwu; // LWU
            default: load_data_sel = ld_d;
        }
    }

    // ============================================================
    // M5.A AMO compute, generalized to Zabha widths .B(f3=000)/.H(001) on
    // top of .W(010)/.D(011). The target sub-word is right-aligned out of the
    // 8-byte i_load_data by the byte offset, so the RMW always runs on the low
    // `width` bits. New value (low `width` bits authoritative) by amo_funct5:
    //   AMOSWAP=00001: new = rs2          AMOMIN =10000: min_signed(old, rs2)
    //   AMOADD =00000: new = old + rs2    AMOMAX =10100: max_signed(old, rs2)
    //   AMOXOR =00100: new = old ^ rs2    AMOMINU=11000: min_unsigned(old, rs2)
    //   AMOAND =01100: new = old & rs2    AMOMAXU=11100: max_unsigned(old, rs2)
    //   AMOOR  =01000: new = old | rs2    LR     =00010: just load (no commit wr)
    //   SC     =00011: write rs2 (single-hart always succeeds)
    // rd gets the sign-extended old sub-word; the 4-size commit-time wstrb
    // generator writes exactly the target bytes.
    // ============================================================
    let amo_byte_off: logic<3>  = agu_addr[2:0];
    let amo_old_algn: logic<64> = i_load_data >> {amo_byte_off, 3'b000};
    let amo_old_b   : logic<8>  = amo_old_algn[7:0];
    let amo_old_h   : logic<16> = amo_old_algn[15:0];
    let amo_old_w   : logic<32> = amo_old_algn[31:0];
    let amo_b_b     : logic<8>  = i_rs2_data[7:0];
    let amo_b_h     : logic<16> = i_rs2_data[15:0];
    let amo_b_w     : logic<32> = i_rs2_data[31:0];
    // Zero- / sign-extend both operands to 64 bits at the access width so one
    // 64-bit datapath + comparator is correct for every width (default = .D).
    let amo_old_ze: logic<64> = if f3 == 3'b000 ? {56'd0, amo_old_b} : if f3 == 3'b001 ? {48'd0, amo_old_h} : if f3 == 3'b010 ? {32'd0, amo_old_w} : i_load_data;
    let amo_old_se: logic<64> = if f3 == 3'b000 ? {amo_old_b[7] repeat 56, amo_old_b} : if f3 == 3'b001 ? {amo_old_h[15] repeat 48, amo_old_h} : if f3 == 3'b010 ? {amo_old_w[31] repeat 32, amo_old_w} : i_load_data;
    let amo_b_ze  : logic<64> = if f3 == 3'b000 ? {56'd0, amo_b_b} : if f3 == 3'b001 ? {48'd0, amo_b_h} : if f3 == 3'b010 ? {32'd0, amo_b_w} : i_rs2_data;
    let amo_b_se  : logic<64> = if f3 == 3'b000 ? {amo_b_b[7] repeat 56, amo_b_b} : if f3 == 3'b001 ? {amo_b_h[15] repeat 48, amo_b_h} : if f3 == 3'b010 ? {amo_b_w[31] repeat 32, amo_b_w} : i_rs2_data;

    let amo_lt : logic = $signed(amo_old_se) <: $signed(amo_b_se);
    let amo_ltu: logic = amo_old_ze <: amo_b_ze;

    // Zacas (amocas, funct5=00101): zero-extend the rd comparison value at the
    // access width (same framing as amo_old_ze) so the equality test is
    // width-correct (.B/.H/.W compare only the low byte/half/word). On a match
    // the store fires with new value = rs2 (amo_new_64 below); on a mismatch the
    // store is suppressed (amo_commit_store). rd always gets the old memory
    // sub-word (amo_wb = amo_old_se), so the program observes the loaded value.
    let amo_cmp_ze  : logic<64> = if f3 == 3'b000 ? {56'd0, i_rd_cmp_data[7:0]} : if f3 == 3'b001 ? {48'd0, i_rd_cmp_data[15:0]} : if f3 == 3'b010 ? {32'd0, i_rd_cmp_data[31:0]} : i_rd_cmp_data;
    let amo_is_cas  : logic     = i_amo_funct5 == 5'b00101;
    let amocas_match: logic     = amo_old_ze == amo_cmp_ze;
    // Zacas amocas.q (funct5=00101, funct3=100): the full 128-bit compare, store
    // data and pair writeback happen at COMMIT (operands read from arch_regs).
    // Here at execute we only LOAD the 128-bit value (lo = i_load_data = mem[addr],
    // hi = i_load_data_next = mem[addr+8]; the access is 16-byte aligned so both
    // dwords share one cache line) and carry it to the ROB. The 64-bit amocas
    // store gate (amocas_match) is bypassed for .q — the store is always MARKED
    // (so the commit store machinery runs) and the commit side gates it on the
    // 128-bit match.
    let amo_is_cas_q: logic = amo_is_cas && f3 == 3'b100;

    // New value, right-aligned in the low `width` bits. ADD/bit-ops use the
    // zero-extended operands (low bits are width-correct; carry past the width
    // is masked off by the store wstrb); MIN/MAX select the extended operand.
    var amo_new_64: logic<64>;
    always_comb {
        case i_amo_funct5 {
            5'b00001: amo_new_64 = amo_b_ze; // SWAP
            5'b00000: amo_new_64 = amo_old_ze + amo_b_ze; // ADD
            5'b00100: amo_new_64 = amo_old_ze ^ amo_b_ze; // XOR
            5'b01100: amo_new_64 = amo_old_ze & amo_b_ze; // AND
            5'b01000: amo_new_64 = amo_old_ze | amo_b_ze; // OR
            5'b10000: amo_new_64 = if amo_lt ? amo_old_se : amo_b_se; // MIN
            5'b10100: amo_new_64 = if amo_lt ? amo_b_se : amo_old_se; // MAX
            5'b11000: amo_new_64 = if amo_ltu ? amo_old_ze : amo_b_ze; // MINU
            5'b11100: amo_new_64 = if amo_ltu ? amo_b_ze : amo_old_ze; // MAXU
            5'b00011: amo_new_64 = amo_b_ze; // SC: data = rs2
            5'b00101: amo_new_64 = amo_b_ze; // CAS: new value = rs2 (committed only on match)
            default : amo_new_64 = amo_b_ze;
        }
    }
    // STORE data for AMO: keep the new sub-word right-aligned. The commit-time
    // wstrb generator shifts store_data left by byte_off*8 and masks to the
    // funct3-derived target bytes, so a right-aligned value lands correctly for
    // every width (.B/.H/.W/.D) — no pre-shift here.
    let amo_store_data_64: logic<64> = amo_new_64;

    // AMO/LR rd value = old sub-word, sign-extended at the access width. SC rd
    // value = 0 (success) when reservation valid and address matches, else 1.
    let amo_is_sc: logic     = i_amo_funct5 == 5'b00011;
    let amo_is_lr: logic     = i_amo_funct5 == 5'b00010;
    let sc_match : logic     = i_rsv_valid && i_rsv_addr == agu_addr;
    let sc_wb    : logic<64> = if sc_match ? 64'd0 : 64'd1;
    // Atomics (LR/SC/AMO, incl. Zabha .B/.H and Zacas .Q) must be naturally
    // aligned. A misaligned atomic raises an ACCESS fault — cause 5 (LR, load)
    // or 7 (SC/AMO, store) — matching the Sail reference, which for atomics
    // takes the access-fault path, NOT the cause-4/6 misaligned-address path.
    // Width from funct3; heliodor otherwise handles misaligned plain
    // loads/stores in hardware, so this is the only place atomics get gated.
    // It also suppresses the commit store (amo_commit_store) so a faulting
    // misaligned AMO/SC never writes memory.
    let amo_misalign: logic = i_is_amo && (
        if f3 == 3'b000 ? 1'b0                      // .B never misaligns
        : if f3 == 3'b001 ? (agu_addr[0] != 1'b0)   // .H
        : if f3 == 3'b010 ? (agu_addr[1:0] != 2'd0) // .W
        : if f3 == 3'b011 ? (agu_addr[2:0] != 3'd0) // .D
        : (agu_addr[3:0] != 4'd0)                   // .Q (amocas.q, 16-byte)
    );
    let amo_wb   : logic<64> = if amo_is_sc ? sc_wb : amo_old_se;

    // Whether to drive a STORE at commit: AMO* (not LR/SC) always;
    // SC only if reservation matched; amocas only when the compare matched
    // (a mismatching CAS leaves memory unchanged).
    let amo_commit_store: logic = i_is_amo && !amo_is_lr && (!amo_is_sc || sc_match) && (!amo_is_cas || amocas_match || amo_is_cas_q) && !amo_misalign;

    // ============================================================
    // M4: CSR compute. csr_operand = csr_imm ? rs1_arch[4:0] : rs1
    // csrrw: new = operand
    // csrrs: new = csr | operand
    // csrrc: new = csr & ~operand
    // rd value = old csr (returned via wb_data)
    // ============================================================
    // M5.D: use per-field i_csr_imm / i_rs1_arch / i_csr_op (struct-port
    // sim bug workaround). Without this, RS/RC operations occasionally
    // get the wrong opcode read, mis-writing the target CSR.
    let csr_operand: logic<64> = if i_csr_imm ? {59'd0, i_rs1_arch} : i_rs1_data;
    var csr_new_val: logic<64>;
    always_comb {
        case i_csr_op {
            csr_pkg::CsrOp::RW: csr_new_val = csr_operand;
            csr_pkg::CsrOp::RS: csr_new_val = i_csr_data | csr_operand;
            csr_pkg::CsrOp::RC: csr_new_val = i_csr_data & ~csr_operand;
            default           : csr_new_val = csr_operand;
        }
    }

    // Result data: AMO/LR/SC writes amo_wb; CSR writes old CSR value
    // to rd; JAL/JALR write pc+4; LOAD writes load_data_sel; everything
    // else writes alu_out.
    // M7: for RVC-origin JAL/JALR the link is pc+2 (the original 2-byte
    // instruction width), not the expanded 32-bit equivalent's +4.
    let link_pc: logic<64> = if i_issue_op.base.is_rvc ? pc_plus2 : pc_plus4;
    // M6.B.3: FLW (FP load, funct3=010) NaN-boxes the 32-bit word into the
    // FP register (upper 32 bits all 1s) instead of sign-extending. FLD
    // (funct3=011) loads the full dword like an integer LD.
    // P10 Zfhmin: FLH (funct3=001) NaN-boxes the 16-bit half into the FP
    // register (upper 48 bits all 1s). FLW (010) boxes the 32-bit word; FLD
    // (011) loads the full dword.
    let fp_load_result: logic<64> = if i_fp_ld && f3 == 3'b001 ? {48'hffff_ffff_ffff, ld_h_raw}
    : if i_fp_ld && f3 == 3'b010 ? {32'hffff_ffff, ld_w_raw} : load_data_sel;
    let wb_data: logic<64> = if i_is_amo ?
        amo_wb
    : if i_is_csr ?
        i_csr_data
    : if i_issue_op.base.is_load ?
        fp_load_result
    : if i_issue_op.base.wb_pc4 ?
        link_pc
    :
        alu_out
    ;
    // pc_plus2 now used by link_pc (M7); previously dead.

    // Mispredict (M1 = always predict fall-through, so any taken is mispredict)
    let mispred: logic = is_ctrl && taken;

    assign o_cdb.valid       = i_issue_valid;
    // M6.B.3: an FP load writes the FP regfile (base.has_rd is the int has_rd,
    // which is 0 for FLW/FLD) — set has_rd for it so the CDB writes back.
    assign o_cdb.has_rd      = i_issue_valid && (i_issue_op.base.has_rd || i_fp_ld);
    assign o_cdb.pdst        = i_issue_rd_pdst;
    assign o_cdb.data        = wb_data;
    assign o_cdb.rob_idx     = i_issue_rob_idx;
    assign o_cdb.mispredict  = i_issue_valid && mispred;
    assign o_cdb.redirect_pc = resolved_target;
    // AMO/SC commit a STORE; LR does not. Plain LOAD/STORE goes through
    // is_store as before.
    assign o_cdb.is_store   = i_issue_valid && (i_issue_op.base.is_store || amo_commit_store);
    // Phase 8 S9: PLAIN load executing (excludes AMO-LR — atomics stay
    // conservative). store_addr/store_funct3 already carry this load's VA/size.
    assign o_cdb.is_load    = i_issue_valid && i_issue_op.base.is_load;
    assign o_cdb.store_addr = agu_addr;
    // For AMO/SC: store the computed amo_store_data_64; otherwise rs2.
    assign o_cdb.store_data = if i_is_amo ? amo_store_data_64 : i_rs2_data;
    // For AMO: funct3 carries width — .W (010) vs .D (011) — matches
    // SW/SD encoding so the existing wstrb generator handles it. amocas.q
    // (f3=100) stores 16 bytes: the LO dword uses the SD (011) width here; the
    // HI dword is written by the dcache 128-bit exclusive-merge extension.
    assign o_cdb.store_funct3 = if amo_is_cas_q ? 3'b011 : f3;
    // Zacas amocas.q: carry the loaded 128-bit value to the ROB for the
    // commit-time compare / pair writeback (is_cas_q is tagged at ROB alloc).
    assign o_cdb.cas_q_mem_lo = i_load_data;
    assign o_cdb.cas_q_mem_hi = i_load_data_next;
    assign o_cdb.is_csr       = i_issue_valid && i_is_csr;
    assign o_cdb.csr_addr     = i_csr_addr;
    assign o_cdb.csr_wdata    = csr_new_val;
    // M8.F: CSR access permission check.
    //   read-only when addr[11:10] == 2'b11 → write attempt is illegal
    //   priv level required = addr[9:8]; current priv must be >= required
    let csr_ro      : logic    = i_csr_addr[11:10] == 2'b11;
    let csr_would_wr: logic    = (i_csr_op == csr_pkg::CsrOp::RW) || (i_rs1_arch != 5'd0);
    let csr_req_priv: logic<2> = i_csr_addr[9:8];
    // priv enum encoding: USER=00, SUPERVISOR=01, MACHINE=11
    let csr_priv_ok: logic = if i_priv == csr_pkg::PrivLevel::MACHINE ?
        1'b1
    : if i_priv == csr_pkg::PrivLevel::SUPERVISOR ?
        (csr_req_priv != 2'b11)
    :
        (csr_req_priv == 2'b00)
    ;
    // RV64: the odd-numbered PMP config CSRs (pmpcfg1/3/.../15 = 0x3A1, 0x3A3,
    // …, 0x3AF) hold the upper config bytes only on RV32 and are NOT present on
    // RV64 — any access raises an illegal-instruction exception (the even
    // pmpcfg0/2/…/14 are WARL and read 0 for unimplemented entries). Matches the
    // Sail reference (ACT4 PMPSm csr_walk).
    let csr_unimpl: logic = (i_csr_addr[11:4] == 8'h3A) && i_csr_addr[0];
    assign o_cdb.csr_illegal = i_issue_valid && i_is_csr && ((csr_ro && csr_would_wr) || !csr_priv_ok || csr_unimpl);
    // M5.D dmem MMU page faults. AMO/SC count as stores. LR / plain LOAD
    // count as loads. Fault VA = the AGU-computed effective address.
    // An AMO (not LR) is a read-modify-write: the decoder sets BOTH mem_ren and
    // mem_wen, so base.is_load is 1, but the access is store-class for faults.
    // Exclude it from load-kind so its fault is reported as a STORE/AMO fault
    // (cause 7 access / 15 page), not a load fault (cause 5 / 13).
    let amo_not_lr       : logic = i_is_amo && !amo_is_lr;
    let mem_is_store_kind: logic = i_issue_op.base.is_store || amo_not_lr;
    let mem_is_load_kind : logic = (i_issue_op.base.is_load && !amo_not_lr) || (i_is_amo && amo_is_lr);
    // PMP/Smpmp: the AMO's dmem access drives the LOAD pmp signals (its RMW read
    // presents i_wen=0 → pmp_acc=R), so a fault arrives on i_dmem_fault /
    // i_dmem_acc_fault. Route it to the store/AMO fault. (dmem_mmu additionally
    // checks W for an AMO so a W-denied / R-allowed region also faults here.)
    let amo_rd_fault     : logic = amo_not_lr && (i_dmem_fault || i_dmem_acc_fault);
    assign o_cdb.is_lfault   = i_issue_valid && mem_is_load_kind && (i_dmem_fault || i_dmem_acc_fault || amo_misalign);
    assign o_cdb.is_sfault   = i_issue_valid && ((mem_is_store_kind && (i_dmem_fault_s || i_dmem_acc_fault_s)) || amo_rd_fault || i_sc_acc_fault || (amo_not_lr && amo_misalign));
    // PMP access fault flag (cause 5/7 instead of 13/15). Page fault wins, so
    // only set when there is NO page fault on the same access. i_sc_acc_fault is
    // a pure PMP denial (no page fault possible — bare-mode SC), so it is an
    // access fault unconditionally; a misaligned atomic (amo_misalign) is an
    // access fault too — cause 5/7 selected by is_lfault vs is_sfault above.
    assign o_cdb.fault_acc   = i_issue_valid
        && ((mem_is_load_kind && i_dmem_acc_fault && !i_dmem_fault)
            || (mem_is_store_kind && i_dmem_acc_fault_s && !i_dmem_fault_s)
            || (amo_not_lr && i_dmem_acc_fault && !i_dmem_fault)
            || i_sc_acc_fault
            || amo_misalign);
    assign o_cdb.fault_vaddr = agu_addr;

    assign o_dbg_alu_pc       = i_issue_op.base.pc;
    assign o_dbg_alu_src_a    = src_a;
    assign o_dbg_alu_src_b    = src_b;
    assign o_dbg_alu_use_pc_a = i_issue_op.base.use_pc_a;
    assign o_dbg_alu_rs1_data = i_rs1_data;
    assign o_dbg_alu_valid    = i_issue_valid;
    assign o_dbg_alu_alu_out  = alu_out;
    assign o_dbg_alu_instr    = i_issue_op.base.instr;
    assign o_dbg_alu_imm      = i_issue_op.base.imm;
}
