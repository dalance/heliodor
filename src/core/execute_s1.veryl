// Slot1 execute path: ALU-only lane for dual-issue superscalar.
// No FPU, no branch comparator, no CSR — just forwarding muxes + ALU.
pub module execute_s1 (
    clk  : input clock,
    rst  : input reset,
    // From slot1 ID/EX register
    i_valid    : input logic                    ,
    i_pc       : input logic                <64>,
    i_rs1_data : input logic                <64>,
    i_rs2_data : input logic                <64>,
    i_imm      : input logic                <64>,
    i_rd_addr  : input logic                <5> ,
    i_rs1_addr : input logic                <5> ,
    i_rs2_addr : input logic                <5> ,
    i_alu_op   : input alu_pkg::AluOp           ,
    i_alu_src_a: input pipeline_pkg::AluSrcA    ,
    i_alu_src_b: input pipeline_pkg::AluSrcB    ,
    i_reg_wen  : input logic                    ,
    // Forwarding data
    i_fwd_exmem  : input logic               <64>, // slot0 EX/MEM
    i_fwd_s1exwb : input logic               <64>, // slot1 EX/WB (previous cycle)
    i_fwd_memwb  : input logic               <64>, // slot0 MEM/WB
    i_fwd_a      : input pipeline_pkg::FwdSel    ,
    i_fwd_b      : input pipeline_pkg::FwdSel    ,
    // Control
    i_stall: input logic,
    i_flush: input logic,
    // Outputs (slot1 EX/WB pipeline register)
    o_valid   : output logic    ,
    o_pc      : output logic<64>,
    o_alu_out : output logic<64>,
    o_rd_addr : output logic<5> ,
    o_reg_wen : output logic    ,
) {
    import pipeline_pkg::*;

    // Forwarding muxes
    let fwd_rs1: logic<64> = case i_fwd_a {
        FwdSel::EX_MEM  : i_fwd_exmem,
        FwdSel::S1_EX_WB: i_fwd_s1exwb,
        FwdSel::MEM_WB  : i_fwd_memwb,
        default          : i_rs1_data,
    };

    let fwd_rs2: logic<64> = case i_fwd_b {
        FwdSel::EX_MEM  : i_fwd_exmem,
        FwdSel::S1_EX_WB: i_fwd_s1exwb,
        FwdSel::MEM_WB  : i_fwd_memwb,
        default          : i_rs2_data,
    };

    // ALU source muxes
    let alu_a: logic<64> = case i_alu_src_a {
        AluSrcA::PC  : i_pc,
        AluSrcA::ZERO: 64'd0,
        default      : fwd_rs1,
    };

    let alu_b: logic<64> = case i_alu_src_b {
        AluSrcB::IMM: i_imm,
        default     : fwd_rs2,
    };

    // ALU instance
    var alu_result: logic<64>;
    inst u_alu: alu (
        i_op: i_alu_op ,
        i_a : alu_a    ,
        i_b : alu_b    ,
        o_out: alu_result,
    );

    // EX1/WB1 pipeline register (bypasses MEM stage)
    always_ff (clk, rst) {
        if_reset {
            o_valid   = 1'b0;
            o_pc      = '0;
            o_alu_out = '0;
            o_rd_addr = 5'd0;
            o_reg_wen = 1'b0;
        } else if i_flush {
            o_valid   = 1'b0;
            o_pc      = '0;
            o_alu_out = '0;
            o_rd_addr = 5'd0;
            o_reg_wen = 1'b0;
        } else if !i_stall {
            o_valid   = i_valid;
            o_pc      = i_pc;
            o_alu_out = alu_result;
            o_rd_addr = i_rd_addr;
            o_reg_wen = i_valid && i_reg_wen;
        }
    }
}
