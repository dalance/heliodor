// chk_vu: observation-only invariant checker for vu_adapter.
//
// Ports (timing contract):
//   inputs : vu_adapter's same-cycle decisions and its registered outputs
//   o_chk  : registered sticky flags, one bit per violated invariant:
//            0 a source not done blocked a start (VA3: impossible when the
//              head holds the token)
//            1 a second VuDone before the first op retired or was killed
//            2 a WB packet without the VuDone of the same cycle
//            3 a memory fault completed without vu_mem_adapter's record
//            4 an allocation in a kill cycle
// Owns:
//   - no output feeds design logic; instantiated only under HELIODOR_CHK
pub module chk_vu::<CFG: core_cfg> (
    clk        : input  clock                                                   ,
    rst        : input  reset                                                   ,
    i_kill     : input  core_types::<CFG>::Kill                                 ,
    i_alloc_v  : input  logic                                                   ,
    i_src_block: input  logic                                                   ,
    i_done     : input  core_types::<CFG>::VuDone                               ,
    i_wb       : input  core_types::<CFG>::WbPacket                             ,
    i_retire   : input  logic                                                   ,
    i_mem_fault: input  logic                                                   ,
    i_mem_exc_v: input  logic                                                   ,
    o_chk      : output logic                      <core_types::<CFG>::CHK_VU_W>,
) {
    import core_types::<CFG>::*;

    var chk_q : logic<CHK_VU_W>;
    var seen_q: logic          ; // a VuDone left and its op has not retired

    var bad: logic<CHK_VU_W>;
    always_comb {
        bad    = 0;
        bad[0] = i_src_block;
        bad[1] = i_done.valid && seen_q;
        bad[2] = i_wb.valid && !i_done.valid;
        bad[3] = i_mem_fault && !i_mem_exc_v;
        bad[4] = i_alloc_v && i_kill.valid;
    }

    always_ff {
        if_reset {
            chk_q  = 0;
            seen_q = 1'b0;
        } else {
            chk_q = chk_q | bad;
            if i_retire || (i_kill.valid && i_kill.full) {
                seen_q = 1'b0;
            } else if i_done.valid {
                seen_q = 1'b1;
            }
        }
    }
    assign o_chk = chk_q;
}
