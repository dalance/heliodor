// Phase 8 M2/M4: conditional-branch direction predictor.
//
// 2^IDX_W 2-bit saturating counters (8192 default; Phase 8 S13.2). The index is supplied by the caller: M4 uses
// gshare (index = PC bits XOR global history), so the same static PC can map to
// different counters depending on the recent branch pattern — this captures
// correlated / data-dependent branches that a PC-only bimodal table aliases.
//
// The MSB is the taken prediction. The lookup index uses the SPECULATIVE global
// history; training uses the index that was actually used for the prediction
// (carried through the ROB as pred_index), since the history moves between fetch
// and commit. Counters reset to weakly-taken (the BTB only fills on the first
// taken occurrence, so the table is consulted only after a branch has gone taken
// at least once).
pub module bht #(
    param ENTRIES: u32 = 8192,
    param IDX_W  : u32 = 13  ,
) (
    clk: input clock,
    rst: input reset,

    i_index: input  logic<IDX_W>,
    o_taken: output logic        ,

    // Phase 8 S4a: 2nd lookup port (slot-1 of a 2-wide fetch bundle).
    i_index2: input  logic<IDX_W>,
    o_taken2: output logic        ,

    // Phase 8 S22: commit-side read port — the base prediction at the
    // committing branch's carried gshare index (TAGE altpred fallback).
    i_index3: input  logic<IDX_W>,
    o_taken3: output logic        ,

    i_train_en   : input logic        ,
    i_train_index: input logic<IDX_W>,
    i_train_taken: input logic        ,
) {
    // Realistic-SRAM migration (doc/sram_inventory.md "bht"): ctr was one array
    // with 3 lookup reads (i_index/2/3) + the train read-modify-write — a 4R1W SRAM
    // no compiler offers. Narrowed to 1R1W by REPLICATION-FOR-READS: one copy per
    // read port, plus a copy dedicated to the train RMW (its read and write share
    // the SAME index i_train_index → a 1R1W read-old macro). The train writes ALL
    // copies with the new value, so they stay identical (byte-identical behavior;
    // only the port count and macro shape change). The read stays combinational.
    var ctr_a: logic<2> [ENTRIES]; // 1R1W — i_index lookup
    var ctr_b: logic<2> [ENTRIES]; // 1R1W — i_index2 lookup
    var ctr_c: logic<2> [ENTRIES]; // 1R1W — i_index3 lookup
    var ctr_d: logic<2> [ENTRIES]; // 1R1W — train RMW (read-old + write, same index)

    assign o_taken  = ctr_a[i_index][1];
    assign o_taken2 = ctr_b[i_index2][1];
    assign o_taken3 = ctr_c[i_index3][1];

    always_ff (clk, rst) {
        if_reset {
            // ctr left un-reset (infers as SRAM). Cold entries read as the array's
            // power-up value rather than the old weakly-taken 2'b10 bias; a cold
            // misprediction self-corrects, so this is a perf-only cold start.
        } else if i_train_en {
            // Read the old counter from the RMW copy, saturate, write every copy.
            let old: logic<2> = ctr_d[i_train_index];
            let nw : logic<2> = if i_train_taken ? (if old == 2'b11 ? 2'b11 : old + 2'd1) : (if old == 2'b00 ? 2'b00 : old - 2'd1);
            ctr_a[i_train_index] = nw;
            ctr_b[i_train_index] = nw;
            ctr_c[i_train_index] = nw;
            ctr_d[i_train_index] = nw;
        }
    }
}
