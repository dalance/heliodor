// Phase 8 M2: bimodal direction predictor.
//
// 512 PC-indexed 2-bit saturating counters; index = pc[9:1]. The MSB is the
// taken/not-taken prediction. Consulted only when the BTB hits a conditional
// branch. Trained at commit on conditional branches.
//
// No global history (M4 adds gshare), so there is NO speculative predictor
// state to recover on a redirect — the table is PC-indexed and trained only by
// committed (architectural) branches.
//
// Counters reset to weakly-taken (2'b10): the BTB only fills on the first taken
// occurrence, so by the time this is consulted the branch has already gone
// taken at least once. Resizing ENTRIES requires updating the index slices.
pub module bht #(
    param ENTRIES: u32 = 512,
) (
    clk: input clock,
    rst: input reset,

    i_pc   : input  logic<64>,
    o_taken: output logic    ,

    i_train_en   : input logic    ,
    i_train_pc   : input logic<64>,
    i_train_taken: input logic    ,
) {
    var ctr: logic<2> [ENTRIES];

    let lk_idx: logic<9> = i_pc[9:1];
    assign o_taken = ctr[lk_idx][1];

    let tr_idx: logic<9> = i_train_pc[9:1];
    always_ff (clk, rst) {
        if_reset {
            for i in 0..ENTRIES {
                ctr[i] = 2'b10;
            }
        } else if i_train_en {
            if i_train_taken {
                ctr[tr_idx] = if ctr[tr_idx] == 2'b11 ? 2'b11 : ctr[tr_idx] + 2'd1;
            } else {
                ctr[tr_idx] = if ctr[tr_idx] == 2'b00 ? 2'b00 : ctr[tr_idx] - 2'd1;
            }
        }
    }
}
