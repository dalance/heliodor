// fu_pkg: every latency published across a module boundary.
//
// Issue timing (S = select cycle):
//   S              select, WB slot reservation, wake for LATENCY 1
//   A = S + ISS_TO_ACC  register read + bypass + FU accept, iq_release
//   W = A + LAT    registered WB packet on the WB bus, bypass source
//   W + PRF_WR     value readable from the PRF
// A wake event for a WB in cycle W is raised in cycle W - WAKE_LEAD.
//
// These are values, not knobs: adding a stage changes one of them and the
// rest of the schedule follows.
pub package fu_pkg {
    import opclass_pkg::*;

    const RR_DIST   : u32 = 0; // PRF read cycle to FU accept
    const ISS_TO_ACC: u32 = 1 + RR_DIST; // select to FU accept
    const WAKE_LEAD : u32 = ISS_TO_ACC + 1; // wake event to WB
    const PRF_WR    : u32 = 1; // WB cycle to first PRF read

    // FU latencies (section 5.6): a result accepted in cycle A is on the WB
    // bus in A + LAT. For the blocking FUs (DIV, FDIV) the value is the
    // minimum; the scheduler wakes their consumers from the WB grant.
    const LAT_ALU  : u32 = 1;
    const LAT_BRU  : u32 = 1;
    const LAT_SYS  : u32 = 1;
    const LAT_MUL  : u32 = 2;
    const LAT_DIV  : u32 = 36;
    const LAT_FMA  : u32 = 2;
    const LAT_FMISC: u32 = 1;
    const LAT_FDIV : u32 = 6;

    // Memory port and front-end latencies.
    const RESP_LAT   : u32 = 2; // dcache port accept to response
    const SNAP_OFS   : u32 = 0; // accept to data-array snapshot
    const LD_LAT     : u32 = 3 + RESP_LAT; // memory pipe m0 to WB
    const FWD_SKEW   : u32 = 0; // array snapshot to forward decision
    const SHADOW_LEN : u32 = FWD_SKEW; // sb drain shadow
    const IC_RESP_LAT: u32 = 1;
    const ITLB_LAT   : u32 = 1;

    // Blocking FUs hold their result and fill a free WB slot (HOLE_FILL);
    // every other kind reserves its WB slot at select (RESERVED).
    function is_blocking (
        k: input FuKind,
    ) -> logic {
        return k == FuKind::DIV || k == FuKind::FDIV;
    }

    function lat (
        k: input FuKind,
    ) -> u32 {
        return case k {
            FuKind::ALU   : LAT_ALU,
            FuKind::BRU   : LAT_BRU,
            FuKind::SYS   : LAT_SYS,
            FuKind::MUL   : LAT_MUL,
            FuKind::DIV   : LAT_DIV,
            FuKind::FMA   : LAT_FMA,
            FuKind::FMISC : LAT_FMISC,
            FuKind::FDIV  : LAT_FDIV,
            FuKind::LOAD  : LD_LAT,
            FuKind::STORE : LD_LAT,
            FuKind::ATOMIC: LD_LAT,
            default       : 0,
        };
    }

    // WB slot offset, counted from the select cycle, that a RESERVED op
    // claims. Every memory-pipe op leaves the pipe at the same stage.
    function claim_off (
        k: input FuKind,
    ) -> u32 {
        return ISS_TO_ACC + lat(k);
    }

    // Largest RESERVED claim offset of any FU; WB slot offsets range over
    // 0..WB_OFS_N-1.
    const MAX_CLAIM: u32 = ISS_TO_ACC + LD_LAT;
    const WB_OFF_W : u32 = tag_pkg::idx_w(MAX_CLAIM + 1);
    const WB_OFS_N : u32 = 1 << WB_OFF_W;

    type WbOff = logic<WB_OFF_W>;

    // A WB slot `off` cycles after the current one.
    struct WbSlot {
        valid: logic,
        off  : WbOff,
    }
}
