// fu_pkg: latencies published across module boundaries.
//
// Every path latency another module schedules against lives here and
// nowhere else; inserting a stage on a path changes exactly one of these.
pub package fu_pkg {
    // Memory port: accept cycle A to the response (dcache_port_adapter).
    const RESP_LAT: u32 = 2;
    // A to the data-array snapshot a HIT is delivered from.
    const SNAP_OFS: u32 = 0;
    // Data-array snapshot to the forward decision of the same load (both at m2).
    const FWD_SKEW: u32 = 0;
    // Cycles a drained store stays visible to forwarding after its ack.
    const SHADOW_LEN: u32 = FWD_SKEW;
    // Memory pipe m0 to the WB cycle of a load: m0, m1, m2 = A, RESP_LAT, then
    // the registered packet.
    const LD_LAT: u32 = 3 + RESP_LAT;
}
