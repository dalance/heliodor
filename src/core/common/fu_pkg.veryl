// fu_pkg: every latency published across a module boundary.
//
// A provider checks at elaboration that its own stage count equals the value
// here; a consumer derives its timing from the value only.
pub package fu_pkg {
    // icache: response exactly IC_RESP_LAT cycles after the request is accepted.
    const IC_RESP_LAT: u32 = 1;
    // Fetch-side translation (tlb(I) lookup, or Bare translation and PMA):
    // the ifu stage between taking an FTQ entry and requesting the icache.
    const ITLB_LAT: u32 = 1;
}
