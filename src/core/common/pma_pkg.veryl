// pma_pkg: physical address type and physical memory attributes.
//
// The platform map is a table of naturally aligned power-of-two regions
// owned by the SoC; pma_check is the only physical address decoder. A PA
// that matches no region is a hole (backed = 0) and faults on access.
pub package pma_pkg {
    type Pa = logic<56>;

    enum Target: logic<2> {
        DRAM,
        ROM,
        IO,
    }

    enum AmoClass: logic<2> {
        NONE,
        LRSC,
        FULL,
    }

    struct PmaAttr {
        target       : Target  ,
        backed       : logic   ,
        cacheable    : logic   ,
        coherent     : logic   ,
        executable   : logic   ,
        amo          : AmoClass,
        idempotent   : logic   , // speculative read allowed
        io_ordered   : logic   , // strongly ordered, non-speculative
        misaligned_ok: logic   ,
        pte_ok       : logic   ,
        cbo_ok       : logic   ,
    }

    // A region matches pa when (pa & mask) == base.
    struct PmaRegion {
        base: Pa     ,
        mask: Pa     ,
        attr: PmaAttr,
    }
}

// Attributes of pa: the OR of the matching regions' attributes (regions do
// not overlap, so at most one matches); all zero for a hole. A global
// function so that callers can instantiate it with their own table size.
function pma_check::<N: u32> (
    pa : input pma_pkg::Pa            ,
    tbl: input pma_pkg::PmaRegion  [N],
) -> pma_pkg::PmaAttr {
    var hit: logic<N>        ;
    var c  : logic<N> [13]   ;
    var r  : pma_pkg::PmaAttr;
    for i in 0..N {
        hit[i]    = (pa & tbl[i].mask) == tbl[i].base;
        c[0][i]   = tbl[i].attr.target[0];
        c[1][i]   = tbl[i].attr.target[1];
        c[2][i]   = tbl[i].attr.backed;
        c[3][i]   = tbl[i].attr.cacheable;
        c[4][i]   = tbl[i].attr.coherent;
        c[5][i]   = tbl[i].attr.executable;
        c[6][i]   = tbl[i].attr.amo[0];
        c[7][i]   = tbl[i].attr.amo[1];
        c[8][i]   = tbl[i].attr.idempotent;
        c[9][i]   = tbl[i].attr.io_ordered;
        c[10][i]  = tbl[i].attr.misaligned_ok;
        c[11][i]  = tbl[i].attr.pte_ok;
        c[12][i]  = tbl[i].attr.cbo_ok;
    }
    r.target        = {|(hit & c[1]), |(hit & c[0])} as pma_pkg::Target;
    r.backed        = |(hit & c[2]);
    r.cacheable     = |(hit & c[3]);
    r.coherent      = |(hit & c[4]);
    r.executable    = |(hit & c[5]);
    r.amo           = {|(hit & c[7]), |(hit & c[6])} as pma_pkg::AmoClass;
    r.idempotent    = |(hit & c[8]);
    r.io_ordered    = |(hit & c[9]);
    r.misaligned_ok = |(hit & c[10]);
    r.pte_ok        = |(hit & c[11]);
    r.cbo_ok        = |(hit & c[12]);
    return r;
}
