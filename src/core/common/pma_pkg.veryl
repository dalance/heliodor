// pma_pkg: physical memory attributes and the platform region table.
//
// Every physical address decode goes through pma_check (global, below): the
// core's fetch and memory pipes and the SoC use the same function over the
// same table. The table is a parameter of the SoC and the core; no module
// decodes a PA by its own window compare.
pub package pma_pkg {
    // Physical addresses are decoded over all 56 bits; no upper bit is dropped.
    type Pa = logic<56>;

    enum Target: logic<2> {
        DRAM,
        ROM,
        IO,
    }

    // Atomics a region accepts.
    enum AmoClass: logic<2> {
        NONE,
        LRSC,
        FULL,
    }

    // A hole (no region hit) reads as all zero: backed = 0, executable = 0.
    struct PmaAttr {
        target       : Target  ,
        backed       : logic   ,
        cacheable    : logic   ,
        coherent     : logic   ,
        executable   : logic   ,
        amo          : AmoClass,
        idempotent   : logic   , // speculative read allowed
        io_ordered   : logic   , // strongly ordered, non-speculative
        misaligned_ok: logic   ,
        pte_ok       : logic   ,
        cbo_ok       : logic   ,
    }

    const PMA_ATTR_W: u32 = 13;

    // A naturally aligned power-of-two region: pa hits when (pa & mask) == base.
    struct PmaRegion {
        base: Pa     ,
        mask: Pa     ,
        attr: PmaAttr,
    }

    // Table error bits returned by pma_table_err.
    const PMA_ERR_SHAPE  : u32 = 1 << 0; // not a power of two of at least 4 KiB, or base not aligned to it
    const PMA_ERR_OVERLAP: u32 = 1 << 1;
    const PMA_ERR_EXEC   : u32 = 1 << 2; // executable but not idempotent
    const PMA_ERR_PTE    : u32 = 1 << 3; // pte_ok without cacheable and coherent
    const PMA_ERR_AMO    : u32 = 1 << 4; // atomics on a non-cacheable region
}

// Attributes of pa under the region table tbl: per-region mask compare, then a
// one-hot AND-OR of the hit region's attributes; no hit is a hole (all zero).
// Global rather than a pma_pkg member because N is usually a module parameter.
function pma_check::<N: u32> (
    pa : input pma_pkg::Pa           ,
    tbl: input pma_pkg::PmaRegion [N],
) -> pma_pkg::PmaAttr {
    var hit : logic<N>                      ;
    var bits: logic<pma_pkg::PMA_ATTR_W> [N];
    for r in 0..N {
        hit[r]  = (pa & tbl[r].mask) == tbl[r].base;
        bits[r] = tbl[r].attr;
    }
    return tree_onehot_mux::<N, pma_pkg::PMA_ATTR_W>(hit, bits) as pma_pkg::PmaAttr;
}

// Table invariants (pma_pkg::PMA_ERR_* bits, 0 for a legal table). Evaluated
// on constants by the owner of the table; the 4 KiB minimum lets fetch and
// the memory pipes evaluate pma_check once per page-contained access.
function pma_table_err::<N: u32> (
    tbl: input pma_pkg::PmaRegion [N],
) -> u32 {
    var e   : u32        ;
    var size: pma_pkg::Pa;
    e    = 0;
    for r in 0..N {
        size = ~tbl[r].mask + 1;
        if size <: 56'h1000 || (size & (size - 1)) != 0 || (tbl[r].base & ~tbl[r].mask) != 0 {
            e |= pma_pkg::PMA_ERR_SHAPE;
        }
        if tbl[r].attr.executable && !tbl[r].attr.idempotent {
            e |= pma_pkg::PMA_ERR_EXEC;
        }
        if tbl[r].attr.pte_ok && !(tbl[r].attr.cacheable && tbl[r].attr.coherent) {
            e |= pma_pkg::PMA_ERR_PTE;
        }
        if tbl[r].attr.amo != pma_pkg::AmoClass::NONE && !tbl[r].attr.cacheable {
            e |= pma_pkg::PMA_ERR_AMO;
        }
        for r2 in 0..N {
            // Two aligned power-of-two regions overlap iff one contains the other's base.
            if r2 != r && (tbl[r2].base & tbl[r].mask) == tbl[r].base {
                e |= pma_pkg::PMA_ERR_OVERLAP;
            }
        }
    }
    return e;
}
