// opclass_pkg: config-independent op classification types.
//
// FuKind names the functional unit class an op executes on; FuSet is a bitset
// over FuKind (bit k set = FuKind k present), used by the FU topology tables of
// the config packages.
pub package opclass_pkg {
    enum FuKind: logic<4> {
        NONE,
        ALU,
        BRU,
        MUL,
        DIV,
        FMA,
        FMISC,
        FDIV, // also fround/froundnx: they run in the blocking FDIV shell
        SYS,
        LOAD,
        STORE,
        ATOMIC,
        VEC,
    }

    const FU_KIND_N: u32 = 13;

    type FuSet = logic<FU_KIND_N>;

    function fu_bit (
        k: input FuKind,
    ) -> FuSet {
        return (1 as FuSet) << k;
    }

    enum FlushKind: logic<2> {
        NONE,
        NEXT_PC,
        XRET,
    }

    // Architectural side effects applied at retire (bitset).
    struct Effect {
        fflags  : logic,
        fs_dirty: logic,
        vs_dirty: logic,
        vxsat   : logic,
        vcfg    : logic,
        vstart  : logic,
    }

    // Rename/dispatch resources an op consumes (bitset).
    struct Budget {
        int_rd : logic,
        fp_rd  : logic,
        lq     : logic,
        sq     : logic,
        vq     : logic,
        ckpt   : logic,
        pair_rd: logic,
    }

    // Decode-time class of an op; the only source of per-op serialization
    // rules (rename, dispatch and commit keep no lists of their own).
    struct OpClass {
        fu        : FuKind   ,
        nonspec   : logic    , // issue only with the oldest token
        drain     : logic    , // retire waits for sb.ordering_empty
        flush     : FlushKind, // retire ends the group and full-kills younger ops
        alone     : logic    , // retires only as the sole member of its commit group
        ld_barrier: logic    , // younger loads do not issue until this op retires
        csr_wr    : logic    , // csr_op == RW || rs1/uimm != 0
        effect    : Effect   ,
        reads_frm : logic    , // dynamic rounding mode read at execute
        budget    : Budget   ,
    }

    // ---- FU-specific op codes (DecOp.uop) ----
    //
    // uop is UOP_W bits; ALU, MUL and DIV carry alu_pkg::AluOp, the FP kinds
    // fpu_pkg::FpuOp, and the kinds below their own code.

    const UOP_W: u32 = 7;

    // BRU also computes AUIPC: every PC-relative value is formed where the PC
    // is read (fu_bru), so AUIPC is not a control op.
    enum BruOp: logic<4> {
        BEQ,
        BNE,
        BLT,
        BGE,
        BLTU,
        BGEU,
        JAL,
        JALR,
        AUIPC,
    }

    // The *I forms take the 5-bit uimm from imm[16:12] instead of rs1.
    enum SysOp: logic<4> {
        CSRRW,
        CSRRS,
        CSRRC,
        CSRRWI,
        CSRRSI,
        CSRRCI,
        SFENCE_VMA, // also SINVAL.VMA
        HFENCE_VVMA,
        HFENCE_GVMA,
    }

    // f3 is the RISC-V width field: size = f3[1:0], zero-extend = f3[2].
    struct LdUop {
        hlvx: logic   , // HLVX: execute permission instead of read
        hlv : logic   , // hypervisor guest access
        fp  : logic   , // FP destination
        f3  : logic<3>,
    }

    // cbo: f3 = cbo funct12[2:0] (0 inval, 1 clean, 2 flush, 4 zero).
    struct StUop {
        cbo: logic   ,
        hsv: logic   , // hypervisor guest access
        fp : logic   , // FP data source
        f3 : logic<3>,
    }

    enum AmoOp: logic<4> {
        LR,
        SC,
        SWAP,
        ADD,
        XOR,
        AND,
        OR,
        MIN,
        MAX,
        MINU,
        MAXU,
        CAS,
    }

    // f3 is the width field: 2 W, 3 D, 4 Q (amocas.q), 0/1 B/H (Zabha).
    struct AmoUop {
        op: AmoOp   ,
        f3: logic<3>,
    }

    // ---- op_class input ----

    // The decoder facts op_class reads; decode fills it from the reused
    // decoder's outputs and the instruction word.
    struct DecInfo {
        rd_nz     : logic            , // rd field != 0
        writes_int: logic            , // integer rd written
        writes_fp : logic            , // FP rd written
        is_branch : logic            ,
        is_jal    : logic            ,
        is_jalr   : logic            ,
        is_auipc  : logic            ,
        mem_ren   : logic            ,
        mem_wen   : logic            ,
        is_amo    : logic            ,
        amo_lr    : logic            ,
        amo_aq    : logic            ,
        is_csr    : logic            ,
        csr_wr    : logic            , // csr_op == RW || rs1/uimm != 0
        is_xret   : logic            ,
        is_sfence : logic            , // SFENCE.VMA, SINVAL.VMA, HFENCE.*
        is_sinval : logic            , // SFENCE.W.INVAL, SFENCE.INVAL.IR
        is_fence  : logic            ,
        is_fence_i: logic            ,
        is_fp     : logic            , // FP compute (not FP load/store)
        alu_op    : alu_pkg::AluOp   ,
        fpu_op    : fpu_pkg::FpuOp   ,
        fp_rm     : logic         <3>, // static rounding mode field
    }

    // FP ops whose rm field is a rounding mode (all others use it as a
    // sub-opcode or ignore it).
    function fp_rounds (
        op: input fpu_pkg::FpuOp,
    ) -> logic {
        case op {
            fpu_pkg::FpuOp::FMIN_S, fpu_pkg::FpuOp::FMAX_S, fpu_pkg::FpuOp::FMIN_D, fpu_pkg::FpuOp::FMAX_D,
            fpu_pkg::FpuOp::FMINM_S, fpu_pkg::FpuOp::FMAXM_S, fpu_pkg::FpuOp::FMINM_D, fpu_pkg::FpuOp::FMAXM_D,
            fpu_pkg::FpuOp::FSGNJ_S, fpu_pkg::FpuOp::FSGNJN_S, fpu_pkg::FpuOp::FSGNJX_S, fpu_pkg::FpuOp::FSGNJ_D,
            fpu_pkg::FpuOp::FSGNJN_D, fpu_pkg::FpuOp::FSGNJX_D, fpu_pkg::FpuOp::FEQ_S, fpu_pkg::FpuOp::FLT_S,
            fpu_pkg::FpuOp::FLE_S, fpu_pkg::FpuOp::FEQ_D, fpu_pkg::FpuOp::FLT_D, fpu_pkg::FpuOp::FLE_D,
            fpu_pkg::FpuOp::FLEQ_S, fpu_pkg::FpuOp::FLTQ_S, fpu_pkg::FpuOp::FLEQ_D, fpu_pkg::FpuOp::FLTQ_D,
            fpu_pkg::FpuOp::FCLASS_S, fpu_pkg::FpuOp::FCLASS_D, fpu_pkg::FpuOp::FMV_X_W, fpu_pkg::FpuOp::FMV_W_X,
            fpu_pkg::FpuOp::FMV_X_D, fpu_pkg::FpuOp::FMV_D_X, fpu_pkg::FpuOp::FMV_X_H, fpu_pkg::FpuOp::FMV_H_X,
            fpu_pkg::FpuOp::FLI_S, fpu_pkg::FpuOp::FLI_D, fpu_pkg::FpuOp::FCVTMOD_W_D: return 1'b0;
            default: return 1'b1;
        }
    }

    function fp_kind (
        op: input fpu_pkg::FpuOp,
    ) -> FuKind {
        case op {
            fpu_pkg::FpuOp::FADD_S, fpu_pkg::FpuOp::FSUB_S, fpu_pkg::FpuOp::FMUL_S, fpu_pkg::FpuOp::FADD_D,
            fpu_pkg::FpuOp::FSUB_D, fpu_pkg::FpuOp::FMUL_D, fpu_pkg::FpuOp::FMADD_S, fpu_pkg::FpuOp::FMSUB_S,
            fpu_pkg::FpuOp::FNMADD_S, fpu_pkg::FpuOp::FNMSUB_S, fpu_pkg::FpuOp::FMADD_D, fpu_pkg::FpuOp::FMSUB_D,
            fpu_pkg::FpuOp::FNMADD_D, fpu_pkg::FpuOp::FNMSUB_D: return FuKind::FMA;
            fpu_pkg::FpuOp::FDIV_S, fpu_pkg::FpuOp::FSQRT_S, fpu_pkg::FpuOp::FDIV_D, fpu_pkg::FpuOp::FSQRT_D,
            fpu_pkg::FpuOp::FROUND_S, fpu_pkg::FpuOp::FROUNDNX_S, fpu_pkg::FpuOp::FROUND_D,
            fpu_pkg::FpuOp::FROUNDNX_D: return FuKind::FDIV;
            default: return FuKind::FMISC;
        }
    }

    function int_kind (
        op: input alu_pkg::AluOp,
    ) -> FuKind {
        case op {
            alu_pkg::AluOp::MUL, alu_pkg::AluOp::MULH, alu_pkg::AluOp::MULHSU, alu_pkg::AluOp::MULHU,
            alu_pkg::AluOp::MULW: return FuKind::MUL;
            alu_pkg::AluOp::DIV, alu_pkg::AluOp::DIVU, alu_pkg::AluOp::REM, alu_pkg::AluOp::REMU, alu_pkg::AluOp::DIVW,
            alu_pkg::AluOp::DIVUW, alu_pkg::AluOp::REMW, alu_pkg::AluOp::REMUW: return FuKind::DIV;
            default: return FuKind::ALU;
        }
    }

    // The decode-time class of an op. `fault` is set when the op carries an
    // exception (fetch fault, illegal, ECALL, EBREAK): such an op completes at
    // dispatch as fu NONE with no other attribute. The x0 rule of has_rd lives
    // here only: budget.int_rd is never set for rd = x0.
    function op_class (
        d    : input DecInfo,
        fault: input logic  ,
    ) -> OpClass {
        var c: OpClass;
        c = 0 as OpClass;
        if fault {
            return c;
        }
        if d.is_amo {
            c.fu         = FuKind::ATOMIC;
            c.nonspec    = 1'b1;
            c.alone      = 1'b1;
            c.ld_barrier = d.amo_aq;
        } else if d.mem_ren {
            c.fu = FuKind::LOAD;
        } else if d.mem_wen {
            c.fu = FuKind::STORE;
        } else if d.is_branch || d.is_jal || d.is_jalr || d.is_auipc {
            c.fu = FuKind::BRU;
        } else if d.is_csr {
            c.fu      = FuKind::SYS;
            c.nonspec = 1'b1;
            c.alone   = 1'b1;
            c.csr_wr  = d.csr_wr;
            c.flush   = if d.csr_wr ? FlushKind::NEXT_PC : FlushKind::NONE;
        } else if d.is_sfence {
            c.fu      = FuKind::SYS;
            c.nonspec = 1'b1;
            c.drain   = 1'b1;
            c.alone   = 1'b1;
            c.flush   = FlushKind::NEXT_PC;
        } else if d.is_sinval || d.is_fence_i {
            c.drain = 1'b1;
            c.alone = 1'b1;
            c.flush = FlushKind::NEXT_PC;
        } else if d.is_fence {
            c.drain      = 1'b1;
            c.alone      = 1'b1;
            c.ld_barrier = 1'b1;
        } else if d.is_xret {
            c.alone = 1'b1;
            c.flush = FlushKind::XRET;
        } else if d.is_fp {
            c.fu              = fp_kind(d.fpu_op);
            c.effect.fflags   = 1'b1;
            c.effect.fs_dirty = 1'b1;
            c.reads_frm       = fp_rounds(d.fpu_op) && d.fp_rm == 3'b111;
        } else if d.writes_int {
            c.fu = int_kind(d.alu_op);
        }
        if c.fu == FuKind::LOAD && d.writes_fp {
            c.effect.fs_dirty = 1'b1;
        }
        // NONE ops (fences, xRET, hints) never write a register.
        c.budget.int_rd = c.fu != FuKind::NONE && d.writes_int && d.rd_nz;
        c.budget.fp_rd  = c.fu != FuKind::NONE && d.writes_fp;
        c.budget.lq     = c.fu == FuKind::LOAD || (c.fu == FuKind::ATOMIC && d.amo_lr);
        c.budget.sq     = c.fu == FuKind::STORE || (c.fu == FuKind::ATOMIC && !d.amo_lr);
        return c;
    }
}
