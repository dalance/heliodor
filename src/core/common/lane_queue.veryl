// lane_queue: in-order multi-lane queue at a stage boundary.
//
// Ports (timing contract):
//   i_valid/i_data : group handshake, lanes contiguous from lane 0; the whole
//                    group enters in a cycle with i_valid[0] && o_ready
//   o_ready        : registered state only (free entries >= W_IN)
//   o_valid/o_data : the oldest min(W_OUT, count) entries in order, lanes
//                    contiguous from lane 0, registered state only
//   i_take         : the consumer takes lanes 0..i_take-1 this cycle;
//                    i_take <= the number of valid output lanes
//   i_flush        : empties the queue at this edge; the input group and the
//                    take of the same cycle are discarded
// Owns:
//   - every accepted entry leaves exactly once, in acceptance order, unless
//     a flush discards it
//   - o_ready and o_valid never depend combinationally on i_valid, i_take or
//     i_flush
// Rationale:
//   - one queue type for every boundary that moves a group of lanes, so a
//     stage is inserted by adding a queue, not by editing its neighbours
//   - i_take lets a consumer accept a prefix of the group (dispatch credits);
//     the rest stays at the head
//   - DEPTH need not be a power of two; ring indices wrap by one subtraction
//     because no step exceeds DEPTH
pub module lane_queue #(
    param T    : type = logic,
    param W_IN : u32  = 1    ,
    param W_OUT: u32  = 1    ,
    param DEPTH: u32  = 2    ,
) (
    clk    : input  clock                                   ,
    rst    : input  reset                                   ,
    i_valid: input  logic                            [W_IN] ,
    i_data : input  T                                [W_IN] ,
    o_ready: output logic                                   ,
    o_valid: output logic                            [W_OUT],
    o_data : output T                                [W_OUT],
    i_take : input  logic<tag_pkg::idx_w(W_OUT + 1)>        ,
    i_flush: input  logic                                   ,
) {
    const PTR_W: u32 = tag_pkg::idx_w(DEPTH);
    const CNT_W: u32 = tag_pkg::idx_w(DEPTH + 1);
    const SUM_W: u32 = tag_pkg::idx_w(2 * DEPTH);
    const IN_W : u32 = tag_pkg::idx_w(W_IN + 1);
    const LN_W : u32 = tag_pkg::idx_w(W_IN);

    var buf_q : T            [DEPTH];
    var head_q: logic<PTR_W>        ;
    var tail_q: logic<PTR_W>        ;
    var cnt_q : logic<CNT_W>        ;

    // Ring position p + k for k <= DEPTH.
    function ring_add (
        p: input logic<PTR_W>,
        k: input logic<SUM_W>,
    ) -> logic<PTR_W> {
        let s: logic<SUM_W> = (p as SUM_W) + k;
        return if s >= DEPTH ? (s - DEPTH) as PTR_W : s as PTR_W;
    }

    var vin: logic<W_IN>;
    always_comb {
        for l in 0..W_IN {
            vin[l] = i_valid[l];
        }
    }
    let n_in: logic<IN_W> = tree_popcount::<W_IN, IN_W>(vin);

    assign o_ready = cnt_q <= DEPTH - W_IN;
    let push: logic = o_ready && i_valid[0];

    // Entry e takes input lane (e - tail) when that lane is in the group.
    var we   : logic [DEPTH];
    var wdata: T     [DEPTH];
    for e in 0..DEPTH :g_wr {
        let off : logic<PTR_W> = if e >= tail_q ? e - tail_q : e + DEPTH - tail_q;
        let lane: logic<LN_W>  = off as LN_W;
        assign we[e]    = push && !i_flush && off <: n_in;
        assign wdata[e] = i_data[lane];
    }

    always_ff {
        for e in 0..DEPTH {
            if we[e] {
                buf_q[e] = wdata[e];
            }
        }
    }

    for l in 0..W_OUT :g_rd {
        let pos: logic<PTR_W> = ring_add(head_q, l as SUM_W);
        assign o_valid[l] = cnt_q >: l;
        assign o_data[l]  = buf_q[pos];
    }

    let n_push: logic<IN_W> = if push ? n_in : 0;

    always_ff {
        if_reset {
            head_q = 0;
            tail_q = 0;
            cnt_q  = 0;
        } else if i_flush {
            head_q = 0;
            tail_q = 0;
            cnt_q  = 0;
        } else {
            head_q = ring_add(head_q, i_take as SUM_W);
            tail_q = ring_add(tail_q, n_push as SUM_W);
            cnt_q  = cnt_q + n_push - i_take;
        }
    }
}
