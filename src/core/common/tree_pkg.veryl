// tree_pkg: log-depth select, prefix and reduction helpers.
//
// Every reduction over N entries or lanes goes through these helpers instead
// of a serial `acc = f(acc, x[i])` loop: synthesis does not rebalance a
// compare-select chain, and stops restructuring altogether in large modules.
// Each helper is proven equal to a serial reference in tb/test_tree.veryl.
//
// They are global generic functions (prefix tree_) because their sizes are
// usually module parameters or core_types constants: a package generic
// function instantiated with those would make its package depend on the
// caller.

// Inclusive prefix OR: r[i] = |x[0..i]. Kogge-Stone, idx_w(N) levels.
function tree_prefix_or::<N: u32> (
    x: input logic<N>,
) -> logic<N> {
    var r: logic<N>;
    r = x;
    for s in 0..tag_pkg::idx_w(N) {
        r = r | (r << (1 << s));
    }
    return r;
}

// Inclusive prefix AND: r[i] = &x[0..i].
function tree_prefix_and::<N: u32> (
    x: input logic<N>,
) -> logic<N> {
    return ~tree_prefix_or::<N>(~x);
}

// One-hot of the lowest set bit of x; 0 when x is 0.
function tree_first::<N: u32> (
    x: input logic<N>,
) -> logic<N> {
    return x & ~(tree_prefix_or::<N>(x) << 1);
}

// Inclusive prefix count: c[i] is the number of set bits in x[0..i]. Feed
// `x << 1` for the exclusive count (rank).
function tree_prefix_count::<N: u32, CW: u32> (
    x: input  logic<N>     ,
    c: output logic<CW> [N],
) {
    var p: logic<CW> [N];
    for i in 0..N {
        c[i] = x[i] as CW;
    }
    for s in 0..tag_pkg::idx_w(N) {
        p = c;
        for i in 0..N {
            if i >= (1 << s) {
                c[i] = p[i] + p[i - (1 << s)];
            }
        }
    }
}

function tree_popcount::<N: u32, CW: u32> (
    x: input logic<N>,
) -> logic<CW> {
    var c: logic<CW> [N];
    tree_prefix_count::<N, CW>(x, c);
    return c[N - 1];
}

// AND-OR mux of d by a one-hot select; 0 when oh is 0, the OR of the selected
// words when several are set. Word-wide: each leaf masks a whole word, and a
// heap-shaped tree over the leaves padded to a power of two ORs the words.
function tree_onehot_mux::<N: u32, W: u32> (
    oh: input logic<N>    ,
    d : input logic<W> [N],
) -> logic<W> {
    var h: logic<W> [2 << tag_pkg::idx_w(N)];
    for i in 0..(1 << tag_pkg::idx_w(N)) {
        let leaf: u32 = (1 << tag_pkg::idx_w(N)) + i;
        if i <: N {
            h[leaf] = {oh[i] repeat W} & d[i];
        } else {
            h[leaf] = 0;
        }
    }
    for j in 1..(1 << tag_pkg::idx_w(N)) {
        let n: u32 = (1 << tag_pkg::idx_w(N)) - j;
        h[n] = h[2 * n] | h[2 * n + 1];
    }
    return h[1];
}

// Binary index of a one-hot vector; 0 when oh is 0, the OR of the indices
// when several bits are set.
function tree_onehot_enc::<N: u32, IW: u32> (
    oh: input logic<N>,
) -> logic<IW> {
    var idx: logic<IW> [N];
    for i in 0..N {
        idx[i] = i;
    }
    return tree_onehot_mux::<N, IW>(oh, idx);
}

// One-hot of the oldest valid entry by ring tag (tag_older); 0 when none is
// valid, and the lower index wins between equal tags. Heap-shaped tree over
// the leaves padded to a power of two with invalid entries, one tag_older per
// node.
function tree_oldest::<N: u32, W: u32> (
    v: input logic<N>    ,
    t: input logic<W> [N],
) -> logic<N> {
    var hv: logic                    [2 << tag_pkg::idx_w(N)];
    var ht: logic<W>                 [2 << tag_pkg::idx_w(N)];
    var hi: logic<tag_pkg::idx_w(N)> [2 << tag_pkg::idx_w(N)];
    var r : logic<N>                                         ;
    for i in 0..(1 << tag_pkg::idx_w(N)) {
        let leaf: u32 = (1 << tag_pkg::idx_w(N)) + i;
        if i <: N {
            hv[leaf] = v[i];
            ht[leaf] = t[i];
        } else {
            hv[leaf] = 1'b0;
            ht[leaf] = 0;
        }
        hi[leaf] = i;
    }
    for j in 1..(1 << tag_pkg::idx_w(N)) {
        let n    : u32   = (1 << tag_pkg::idx_w(N)) - j;
        let right: logic = hv[2 * n + 1] && (!hv[2 * n] || tag_older::<W>(ht[2 * n + 1], ht[2 * n]));
        hv[n] = hv[2 * n] || hv[2 * n + 1];
        ht[n] = if right ? ht[2 * n + 1] : ht[2 * n];
        hi[n] = if right ? hi[2 * n + 1] : hi[2 * n];
    }
    for i in 0..N {
        r[i] = hv[1] && hi[1] == i;
    }
    return r;
}
