// core_cfg: the configuration contract of the core.
//
// Every axis and structure size of the core comes from one package that
// implements this proto. Modules receive it only as `import core_types::<CFG>::*`;
// a size constant is read by its owning module and core_types, nowhere else.
// The structural constraints over these values are checked by
// core_types::CFG_ERR (one bit per constraint, 0 for a legal config).
pub proto package core_cfg {
    // Axes.
    const FETCH_W : u32; // ops extract delivers per cycle, = decode lanes
    const RENAME_W: u32; // ops renamed and dispatched per cycle
    const ISSUE_W : u32; // non-memory issue ports
    const MEM_W   : u32; // memory pipes = dcache CPU ports = load WB ports
    const COMMIT_W: u32; // ops retired per cycle = retire record lanes

    const FETCH_BYTES: u32; // fetch block size, 8 * FETCH_W

    // Structure sizes, each read only by its owner and core_types.
    const ROB_N    : u32;
    const LQ_N     : u32;
    const SQ_N     : u32;
    const SB_N     : u32; // committed store buffer, 64-byte lines
    const FTQ_N    : u32;
    const PRF_INT_N: u32;
    const PRF_FP_N : u32;
    const NUM_CKPT : u32; // rename checkpoints; 0 recovers by walk only
    const FBQ_N    : u32; // fetch buffer queue (ifu -> extract), blocks
    const DQ_N     : u32; // decode queue owned by extract, ops
    const RQ_N     : u32; // rename input queue (decode -> rename), ops

    // Widths of the opaque predictor types; bpu checks its internal layout
    // against them.
    const PRED_META_W: u32;
    const PRED_CKPT_W: u32;

    const DTLB_N   : u32;
    const ITLB_N   : u32;
    const PTW_D_QN : u32; // ptw request queue depth
    const PTW_I_QN : u32;
    const REISSUE_W: u32; // LQ re-issues per cycle
    const DC_NB    : u32; // dcache data banks
    const MSHR_N   : u32; // dcache MSHR entries

    // FU topology. Exec port p has the FU set PORT_FU[p] and is fed by IQ
    // PORT_IQ[p]. All memory pipes are fed by IQ MEM_IQ. IQ q has IQ_N[q]
    // entries with IQ_NSRC[q] source operands each.
    const PORT_FU: opclass_pkg::FuSet [ISSUE_W];
    const PORT_IQ: u32                [ISSUE_W];
    const N_IQ   : u32                         ;
    const MEM_IQ : u32                         ;
    const IQ_N   : u32                [N_IQ]   ;
    const IQ_NSRC: u32                [N_IQ]   ;
}
