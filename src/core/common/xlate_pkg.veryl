// xlate_pkg: translation types and the pure functions shared by the I and D
// translation paths (tlb, ptw, mem_pipe, ifu).
//
// The permission check, the PA construction and the selective-flush predicate
// exist once here; every consumer calls the same function instead of keeping
// a near copy.
pub package xlate_pkg {
    // CBO: cbo.clean/flush/inval, translated with read-or-write permission and
    // without a D-bit requirement; its faults are store-side.
    enum AccKind: logic<3> {
        LOAD,
        STORE,
        AMO,
        FETCH,
        CBO,
    }

    // Translation regime of a walk key: V1 for a guest access (V = 1), HLV
    // for a hypervisor load or store.
    enum Regime: logic<2> {
        V0,
        V1,
        HLV,
    }

    // vpn is VA[40:12] in every regime: a canonical Sv39 VA repeats VA[38]
    // in bits 40:39, and a key of a Bare first stage is GPA[40:12].
    struct PtwKey {
        vpn   : logic <29>,
        regime: Regime    ,
    }

    // virt: a guest lookup, which matches guest entries of the same vmid and
    // s1_on only; s1_on: the first stage (vsatp for a guest) is not Bare.
    struct TlbLookup {
        valid: logic    ,
        vpn  : logic<29>,
        asid : logic<16>,
        virt : logic    ,
        vmid : logic<14>,
        s1_on: logic    ,
    }

    // A lookup result. A napot entry is a 4 KiB entry whose ppn[3:0] already
    // holds VA[15:12]; napot only widens the sfence match. Only A = 1 leaves
    // are cached, so there is no A bit. A guest entry (virt) is the composed
    // GVA -> HPA translation: level is the smaller of the two leaves, r..g
    // the first-stage leaf (all set but u when s1_on = 0) and gr..gd the
    // G-stage leaf (all set when the G-stage is Bare, and in a V = 0 entry).
    struct TlbEntry {
        hit  : logic    ,
        ppn  : logic<44>,
        level: logic<2> , // 2: 1 GiB, 1: 2 MiB, 0: 4 KiB
        r    : logic    ,
        w    : logic    ,
        x    : logic    ,
        u    : logic    ,
        d    : logic    ,
        g    : logic    ,
        pbmt : logic<2> , // 0 PMA, 1 NC, 2 IO
        napot: logic    ,
        virt : logic    ,
        s1_on: logic    ,
        gr   : logic    ,
        gw   : logic    ,
        gx   : logic    ,
        gd   : logic    ,
    }

    const TLB_ENTRY_W: u32 = 62;

    // ptw -> tlb install.
    struct TlbFill {
        valid: logic    ,
        vpn  : logic<29>,
        asid : logic<16>,
        virt : logic    ,
        vmid : logic<14>,
        s1_on: logic    ,
        ppn  : logic<44>,
        level: logic<2> ,
        r    : logic    ,
        w    : logic    ,
        x    : logic    ,
        u    : logic    ,
        d    : logic    ,
        g    : logic    ,
        pbmt : logic<2> ,
        napot: logic    ,
        gr   : logic    ,
        gw   : logic    ,
        gx   : logic    ,
        gd   : logic    ,
    }

    // SFENCE.VMA retired with V = 1 is HFENCE_VVMA with hgatp's VMID.
    enum InvKind: logic<2> {
        SFENCE,
        HFENCE_VVMA,
        HFENCE_GVMA,
    }

    // Retire-time invalidation, the operands of SFENCE.VMA and HFENCE.*.
    // HFENCE_VVMA: vmid is hgatp.VMID, asid and all_asid come from rs2.
    // HFENCE_GVMA: vmid is rs2 and all_asid means rs2 was x0 (every VMID);
    // its GPA operand is not used, as guest entries hold no GPA.
    struct TlbInv {
        valid   : logic      ,
        kind    : InvKind    ,
        va      : logic  <64>,
        asid    : logic  <16>,
        vmid    : logic  <14>,
        all_va  : logic      , // rs1 was x0
        all_asid: logic      , // rs2 was x0
    }

    // CSR context of a translation, read at lookup (and latched by ptw at
    // walk start). prv is the effective privilege (VS and VU as S and U when
    // virt), sum/mxr mstatus, adue/pbmte menvcfg, asid/root satp. The guest
    // fields: virt is the effective V, vprv the privilege of HLV and HSV
    // (hstatus.SPVP), vsum/vmxr vsstatus, vadue/vpbmte henvcfg, vs_on/vasid/vroot
    // vsatp, g_on/vmid/groot hgatp.
    struct XlateCtx {
        prv   : csr_pkg::PrivLevel    ,
        sum   : logic                 ,
        mxr   : logic                 ,
        adue  : logic                 ,
        pbmte : logic                 ,
        asid  : logic             <16>,
        root  : logic             <44>,
        virt  : logic                 ,
        vprv  : csr_pkg::PrivLevel    ,
        vsum  : logic                 ,
        vmxr  : logic                 ,
        vadue : logic                 ,
        vpbmte: logic                 ,
        vs_on : logic                 ,
        vasid : logic             <16>,
        vroot : logic             <44>,
        g_on  : logic                 ,
        vmid  : logic             <14>,
        groot : logic             <44>,
    }

    // The context of one access, resolved from XlateCtx and the op's hlv.
    // The first stage uses prv..pbmte, the G-stage gmxr..gpbmte:
    // vsstatus.MXR applies to the first stage only, mstatus.MXR to both. A
    // guest first stage follows henvcfg.ADUE, the G-stage menvcfg.ADUE.
    struct XEff {
        two   : logic                 , // a guest access (V1 or HLV)
        prv   : csr_pkg::PrivLevel    ,
        sum   : logic                 ,
        mxr   : logic                 ,
        adue  : logic                 ,
        pbmte : logic                 ,
        gmxr  : logic                 ,
        gadue : logic                 ,
        gpbmte: logic                 ,
        s1_on : logic                 , // always 1 for V0 (its Bare case does not translate)
        g_on  : logic                 ,
        asid  : logic             <16>,
        root  : logic             <44>,
        vmid  : logic             <14>,
        groot : logic             <44>,
    }

    function xeff (
        c  : input XlateCtx,
        hlv: input logic   ,
    ) -> XEff {
        var e       : XEff;
        e.two    = c.virt || hlv;
        e.prv    = if hlv ? c.vprv : c.prv;
        e.sum    = if e.two ? c.vsum : c.sum;
        e.mxr    = c.mxr || (e.two && c.vmxr);
        e.adue   = if e.two ? c.vadue : c.adue;
        e.pbmte  = c.pbmte && (!e.two || c.vpbmte);
        e.gmxr   = c.mxr;
        e.gadue  = c.adue;
        e.gpbmte = c.pbmte;
        e.s1_on  = !e.two || c.vs_on;
        e.g_on   = e.two && c.g_on;
        e.asid   = if e.two ? c.vasid : c.asid;
        e.root   = if e.two ? c.vroot : c.root;
        e.vmid   = c.vmid;
        e.groot  = c.groot;
        return e;
    }

    // Whether an access translates: a guest access when either stage is on,
    // a V0 access when Sv39 is on for its privilege (v0_on).
    function xl_on (
        x    : input XEff ,
        v0_on: input logic,
    ) -> logic {
        return if x.two ? x.s1_on || x.g_on : v0_on;
    }

    // The translation key of va, VA[40:12].
    function vpn_of (
        va: input logic<64>,
    ) -> logic<29> {
        return va[40:12];
    }

    // An Sv39 first stage needs a canonical VA (else a page fault); a Bare
    // first stage over an Sv39x4 G-stage needs a GPA below 2^41 (else a
    // guest-page fault). Neither is looked up: such a VA would alias a key.
    function noncanon (
        x : input XEff     ,
        va: input logic<64>,
    ) -> logic {
        return x.s1_on && va[63:39] != {va[38] repeat 25};
    }

    function gpa_big (
        x : input XEff     ,
        va: input logic<64>,
    ) -> logic {
        return x.two && !x.s1_on && x.g_on && va[63:41] != '0;
    }

    function lookup_of (
        x    : input XEff     ,
        va   : input logic<64>,
        valid: input logic    ,
    ) -> TlbLookup {
        var l      : TlbLookup;
        l.valid = valid;
        l.vpn   = vpn_of(va);
        l.asid  = x.asid;
        l.virt  = x.two;
        l.vmid  = x.vmid;
        l.s1_on = x.s1_on;
        return l;
    }

    // walk: a guest entry failed a check. That is not a fault: the walk
    // finds the faulting stage and the GPA.
    struct Perm {
        ok    : logic   ,
        need_d: logic   , // store/AMO on W = 1, D = 0 with ADUE: the PA is not final
        cause : logic<6>, // page-fault cause when !ok
        walk  : logic   ,
    }

    struct TlbPerf {
        miss    : logic, // a valid lookup missed
        fill    : logic,
        fill_inv: logic, // a fill dropped because an invalidation came in the same cycle
        inv     : logic, // an invalidation removed at least one entry
        lk2     : logic, // valid lookups on two or more ports in one cycle
    }

    struct PtwPerf {
        req     : logic, // a request entered the queue
        coalesce: logic, // a request joined a queued or running walk
        full    : logic, // a request waited for queue room
        q_drop  : logic, // a queued request was dropped by a kill
        walk    : logic, // a walk started
        pte_rd  : logic, // a PTE read was accepted
        park    : logic, // a PTE read parked on a fill
        busy    : logic, // a PTE read waited for any fill to end
        retry   : logic,
        pfault  : logic, // a walk ended in a page fault
        afault  : logic, // a walk ended in an access fault (PTE PMP/PMA)
        install : logic,
        stale   : logic, // a faultless walk not installed (epoch)
        own_drop: logic, // a completed walk whose owner was dropped
        a_wr    : logic, // an A/D write setting A was accepted
        d_wr    : logic, // an A/D write setting D was accepted
        ad_rd   : logic, // an owned PTE read before an A/D write
        ad_redo : logic, // an A/D update found another leaf or failed: the walk restarts
        ad_wd   : logic, // an A/D write withdrawn in its slot
        two     : logic, // a guest (V1 or HLV) walk started
        g_rd    : logic, // a G-stage PTE read was accepted
        gfault  : logic, // a walk ended in a guest-page fault
    }

    function pf_cause (
        acc: input AccKind,
    ) -> logic<6> {
        return case acc {
            AccKind::FETCH: 6'd12,
            AccKind::LOAD : 6'd13,
            default       : 6'd15,
        };
    }

    function af_cause (
        acc: input AccKind,
    ) -> logic<6> {
        return case acc {
            AccKind::FETCH: 6'd1,
            AccKind::LOAD : 6'd5,
            default       : 6'd7,
        };
    }

    function gpf_cause (
        acc: input AccKind,
    ) -> logic<6> {
        return case acc {
            AccKind::FETCH: 6'd20,
            AccKind::LOAD : 6'd21,
            default       : 6'd23,
        };
    }

    // Permission of one stage's leaf for access acc. AMO needs W (which
    // implies R in a legal leaf); CBO needs R or W and no D; HLVX needs X
    // instead of R. The G-stage is checked as a U-mode access.
    function stage_perm (
        r   : input logic             ,
        w   : input logic             ,
        x   : input logic             ,
        u   : input logic             ,
        d   : input logic             ,
        acc : input AccKind           ,
        prv : input csr_pkg::PrivLevel,
        sum : input logic             ,
        mxr : input logic             ,
        adue: input logic             ,
        hlvx: input logic             ,
    ) -> Perm {
        var p    : Perm ;
        var rwx  : logic;
        var dirty: logic;
        let fetch: logic = acc == AccKind::FETCH;
        let st   : logic = acc == AccKind::STORE || acc == AccKind::AMO;
        let rd_ok: logic = if hlvx ? x : r || (mxr && x);
        rwx   = case acc {
            AccKind::LOAD : rd_ok,
            AccKind::STORE: w,
            AccKind::AMO  : w,
            AccKind::FETCH: x,
            default       : r || w,
        };
        let u_ok    : logic = if prv == csr_pkg::PrivLevel::USER ? u : (!u || (sum && !fetch));
        dirty    = !st || d;
        p.ok     = rwx && u_ok && (dirty || adue);
        p.need_d = rwx && u_ok && !dirty && adue;
        p.cause  = pf_cause(acc);
        p.walk   = 1'b0;
        return p;
    }

    // Permission of a cached entry for access acc under x. A guest entry
    // either passes both stages (need_d when a D bit of either stage is
    // missing under its ADUE) or asks for a walk.
    function perm_x (
        e   : input TlbEntry,
        acc : input AccKind ,
        x   : input XEff    ,
        hlvx: input logic   ,
    ) -> Perm {
        var p : Perm;
        var s1: Perm;
        var g : Perm;
        s1 = stage_perm(e.r, e.w, e.x, e.u, e.d, acc, x.prv, x.sum, x.mxr, x.adue, hlvx);
        g  = stage_perm(e.gr, e.gw, e.gx, 1'b1, e.gd, acc, csr_pkg::PrivLevel::USER, 1'b0, x.gmxr, x.gadue, hlvx);
        if !e.s1_on {
            s1.ok     = 1'b1;
            s1.need_d = 1'b0;
        }
        p = s1;
        if e.virt {
            p.ok     = s1.ok && g.ok;
            p.need_d = p.ok && (s1.need_d || g.need_d);
            p.walk   = !p.ok;
        }
        return p;
    }

    function entry_pa (
        e : input TlbEntry    ,
        va: input logic   <64>,
    ) -> pma_pkg::Pa {
        return case e.level {
            2'd2   : {e.ppn[43:18], va[29:0]},
            2'd1   : {e.ppn[43:9], va[20:0]},
            default: {e.ppn, va[11:0]},
        };
    }

    // Svpbmt composition: NC and IO only make the attributes stricter.
    function pbmt_attr (
        a   : input pma_pkg::PmaAttr   ,
        pbmt: input logic           <2>,
    ) -> pma_pkg::PmaAttr {
        var r: pma_pkg::PmaAttr;
        r = a;
        if pbmt != 2'd0 {
            r.cacheable     = 1'b0;
            r.amo           = pma_pkg::AmoClass::NONE;
            r.misaligned_ok = 1'b0;
        }
        if pbmt == 2'd2 {
            r.idempotent = 1'b0;
            r.io_ordered = 1'b1;
        }
        return r;
    }

    // Whether an invalidation removes a cached entry. SFENCE.VMA removes V
    // = 0 entries, HFENCE.VVMA the guest entries of its VMID, both by the
    // level-masked VA (a napot entry over its whole 64 KiB) and the ASID
    // (global entries survive an ASID-qualified fence). HFENCE.GVMA removes
    // every guest entry of its VMID (of every VMID for rs2 = x0).
    function inv_hit (
        inv  : input TlbInv    ,
        vpn  : input logic <29>,
        level: input logic <2> ,
        napot: input logic     ,
        asid : input logic <16>,
        g    : input logic     ,
        virt : input logic     ,
        vmid : input logic <14>,
    ) -> logic {
        let iv  : logic<29> = vpn_of(inv.va);
        let lv_m: logic     = case level {
            2'd2   : vpn[28:18] == iv[28:18],
            2'd1   : vpn[28:9] == iv[28:9],
            default: if napot ? vpn[28:4] == iv[28:4] : vpn == iv,
        };
        let va_m: logic = inv.all_va || lv_m;
        let as_m: logic = inv.all_asid || (asid == inv.asid && !g);
        let vm_m: logic = vmid == inv.vmid;
        return inv.valid && case inv.kind {
            InvKind::SFENCE     : !virt && va_m && as_m,
            InvKind::HFENCE_VVMA: virt && vm_m && va_m && as_m,
            default             : virt && (inv.all_asid || vm_m),
        };
    }
}
