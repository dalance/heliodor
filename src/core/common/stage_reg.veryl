// stage_reg: back-end pipeline register with the kill check built in.
//
// Ports (timing contract):
//   i_valid/i_data : the op entering this stage; no backpressure, the
//                    register advances every cycle
//   i_tag          : RobTag of the op in i_data
//   i_kill         : applied on the capture edge: an op that the kill of
//                    this cycle selects is not captured
//   o_valid/o_data : registered, one cycle after capture
// Owns:
//   - o_valid is never set for an op that the kill of its capture cycle
//     selects (killed(i_kill, i_tag))
// Rationale:
//   - only the capture edge is checked: the op held in o_data during a kill
//     cycle is the next stage's input, and that stage applies the same kill
//     when it captures it
//   - the tag is a separate port because T is opaque here
pub module stage_reg::<CFG: core_cfg> #(
    param T: type = logic,
) (
    clk    : input  clock                    ,
    rst    : input  reset                    ,
    i_valid: input  logic                    ,
    i_data : input  T                        ,
    i_tag  : input  core_types::<CFG>::RobTag,
    i_kill : input  core_types::<CFG>::Kill  ,
    o_valid: output logic                    ,
    o_data : output T                        ,
) {
    import core_types::<CFG>::*;

    var valid_q: logic;
    var data_q : T    ;

    always_ff {
        if_reset {
            valid_q = 1'b0;
        } else {
            valid_q = i_valid && !killed(i_kill, i_tag);
        }
    }

    always_ff {
        if i_valid {
            data_q = i_data;
        }
    }

    assign o_valid = valid_q;
    assign o_data  = data_q;
}
