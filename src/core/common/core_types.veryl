// core_types: config-dependent types, widths and derived constants.
//
// The only place where tag, index and port widths are computed; everything
// else uses the types below. Modules import it as `import core_types::<CFG>::*`.
pub package core_types::<CFG: core_cfg> {
    import opclass_pkg::*;

    // ---- Widths ----

    const ROB_IDX_W: u32 = tag_pkg::idx_w(CFG::ROB_N);
    const LQ_IDX_W : u32 = tag_pkg::idx_w(CFG::LQ_N);
    const SQ_IDX_W : u32 = tag_pkg::idx_w(CFG::SQ_N);
    const FTQ_IDX_W: u32 = tag_pkg::idx_w(CFG::FTQ_N);
    // int and fp share one PReg width: the reused vector unit and the CDB
    // bus assume PRF_INT_W == PRF_FP_W.
    const PREG_W: u32 = tag_pkg::idx_w(if CFG::PRF_INT_N >: CFG::PRF_FP_N ? CFG::PRF_INT_N : CFG::PRF_FP_N);
    const CKPT_W: u32 = tag_pkg::idx_w(CFG::NUM_CKPT);
    const FOFF_W: u32 = tag_pkg::idx_w(CFG::FETCH_BYTES / 2); // halfword offset in a fetch block

    // Full tag widths (wrap + index), the W argument of tag_older/tag_next.
    const ROB_TAG_W: u32 = ROB_IDX_W + 1;
    const LQ_TAG_W : u32 = LQ_IDX_W + 1;
    const SQ_TAG_W : u32 = SQ_IDX_W + 1;
    const FTQ_TAG_W: u32 = FTQ_IDX_W + 1;

    // Free-list sizes: every physical register beyond the 32 architectural
    // mappings. free_list and busy_table use these instead of the PRF sizes.
    const FREE_INT_N: u32 = CFG::PRF_INT_N - 32;
    const FREE_FP_N : u32 = CFG::PRF_FP_N - 32;
    // One FlPtr type serves both classes, so it is sized for the larger ring.
    const FL_IDX_W: u32 = tag_pkg::idx_w(if FREE_INT_N >: FREE_FP_N ? FREE_INT_N : FREE_FP_N);
    const FL_TAG_W: u32 = FL_IDX_W + 1;

    // ld_barrier sequence: at most ROB_N barriers are unretired, so two
    // extra bits keep the cyclic comparison unambiguous.
    const BAR_SEQ_W: u32 = ROB_IDX_W + 2;

    // ---- Derived counts ----

    const WB_N        : u32 = CFG::ISSUE_W + CFG::MEM_W; // one WB port per issue port and memory pipe
    const RETIRE_CNT_W: u32 = tag_pkg::idx_w(CFG::COMMIT_W + 1);
    // Stores retired per cycle: execute produces at most MEM_W per cycle.
    const ST_RET_N: u32 = CFG::MEM_W;
    // sb push ports, in lines: a line-crossing store pushes two lines.
    const PUSH_W: u32 = if CFG::MEM_W >: 2 ? CFG::MEM_W : 2;
    // walk reuses the rename RAT write ports.
    const WALK_W: u32 = CFG::RENAME_W;

    // Exec ports carrying FU kind k.
    function port_count (
        k: input FuKind,
    ) -> u32 {
        var c: u32;
        c = 0;
        for p in 0..CFG::ISSUE_W {
            c += CFG::PORT_FU[p][k] as u32;
        }
        return c;
    }

    // Issue ports fed by IQ q (exec ports, or the memory pipes for MEM_IQ).
    function iq_port_count (
        q: input u32,
    ) -> u32 {
        var c: u32;
        c = if q == CFG::MEM_IQ ? CFG::MEM_W : 0;
        for p in 0..CFG::ISSUE_W {
            c += (CFG::PORT_IQ[p] == q) as u32;
        }
        return c;
    }

    // Resolves per cycle, = FTQ PC read ports.
    const BRU_N: u32 = port_count(FuKind::BRU);

    // ---- Tags ----

    struct RobTag {
        wrap: logic           ,
        idx : logic<ROB_IDX_W>,
    }
    struct LqTag {
        wrap: logic          ,
        idx : logic<LQ_IDX_W>,
    }
    struct SqTag {
        wrap: logic          ,
        idx : logic<SQ_IDX_W>,
    }
    struct FtqTag {
        wrap: logic           ,
        idx : logic<FTQ_IDX_W>,
    }

    enum RegClass: logic {
        INT,
        FP,
    }

    struct PReg {
        cls: RegClass        ,
        idx: logic   <PREG_W>,
    }

    // Free-list ring pointer of one RegClass.
    struct FlPtr {
        wrap: logic          ,
        idx : logic<FL_IDX_W>,
    }

    type BarSeq = logic<BAR_SEQ_W>;

    // Identity of an op, carried with it through every stage. Live state
    // (ROB head, the driver of a port) is never re-read to identify an op.
    struct OpTag {
        rob   : RobTag        , // every op
        lq    : LqTag         , // loads, valid when lq_v
        lq_v  : logic         ,
        sq    : SqTag         , // stores and store-class atomics, valid when sq_v
        sq_v  : logic         ,
        ftq   : FtqTag        , // fetch block
        foff  : logic <FOFF_W>, // halfword offset in the block
        pdst  : PReg          ,
        has_rd: logic         , // 0 for x0 and no-destination ops
        ckpt  : logic <CKPT_W>, // checkpoint held by this op, valid when ckpt_v
        ckpt_v: logic         ,
    }

    // ---- Kill and redirect ----

    // Registered one-cycle pulse, at most one per cycle. A partial kill keeps
    // every op older than or equal to keep; the rewind targets come from the
    // rob dispatch snapshot of keep.
    struct Kill {
        valid   : logic         ,
        full    : logic         , // every in-flight op dies, the fields below are ignored
        keep    : RobTag        , // youngest surviving op
        lq_tail : LqTag         ,
        sq_tail : SqTag         ,
        fl_int  : FlPtr         , // free-list heads per RegClass
        fl_fp   : FlPtr         ,
        bar_seq : BarSeq        ,
        ftq_tail: FtqTag        , // next of the branch's FtqTag
        ckpt_v  : logic         ,
        ckpt    : logic <CKPT_W>,
    }

    // Only BR and BR_CM carry the branch outcome (Redirect.foff/taken) used to
    // repair predictor history and RAS.
    enum RedirKind: logic<3> {
        BR, // partial kill from a BRU resolve
        BR_CM, // full kill from the commit-time mispredict backstop
        TRAP,
        IRQ,
        XRET,
        SERIAL,
        REPLAY,
    }

    struct Redirect {
        valid   : logic            ,
        pc      : logic    <64>    ,
        ftq_keep: FtqTag           ,
        foff    : logic    <FOFF_W>, // halfword offset of the redirecting op in its block
        taken   : logic            , // resolved direction of that op
        kind    : RedirKind        ,
    }

    // Branch outcome carried by a BRU WB packet.
    struct BrResolve {
        valid  : logic         ,
        mispred: logic         ,
        taken  : logic         ,
        next_pc: logic <64>    ,
        ftq    : FtqTag        ,
        foff   : logic <FOFF_W>,
    }

    // ---- Execution (sections 5.6, 5.7, X) ----

    // Identity an FU echoes unchanged from its input to its WB packet.
    struct ExTag {
        rob   : RobTag,
        pdst  : PReg  ,
        has_rd: logic ,
    }

    // The only output of an execution unit; nothing travels beside it.
    struct WbPacket {
        valid : logic              ,
        tag   : ExTag              ,
        data  : logic          <64>,
        exc   : exc_pkg::ExcRec    ,
        fflags: logic          <5> ,
        br    : BrResolve          , // BRU ports only
    }

    // Scheduling wakeup: the value of pdst is on a WB bus WAKE_LEAD cycles
    // later (or later still for memory-pipe wake lanes).
    struct Wake {
        valid: logic,
        pdst : PReg ,
    }

    enum XfKind: logic<2> {
        SFENCE,
        HFENCE_VVMA,
        HFENCE_GVMA,
    }

    struct XlateFlush {
        valid   : logic     ,
        kind    : XfKind    ,
        va      : logic <64>,
        asid    : logic <16>,
        all_va  : logic     , // rs1 was x0
        all_asid: logic     , // rs2 was x0
    }

    // fu_sys -> commit: what a SYS op does at retire.
    struct SysPending {
        valid    : logic         ,
        tag      : RobTag        ,
        csr_addr : logic     <12>,
        csr_wdata: logic     <64>,
        xf       : XlateFlush    ,
    }

    // lq -> memory iq: a ld_barrier op retired; bar_ret is now seq.
    struct LoadFence {
        valid: logic ,
        seq  : BarSeq,
    }

    // ---- Issue queue records ----

    function iq_n_max () -> u32 {
        var m: u32;
        m = 0;
        for q in 0..CFG::N_IQ {
            if CFG::IQ_N[q] >: m {
                m = CFG::IQ_N[q];
            }
        }
        return m;
    }

    const IQ_ENT_W: u32 = tag_pkg::idx_w(iq_n_max());
    const SRC_N   : u32 = 3; // source slots of the widest op (FMA)

    struct IqSrc {
        en: logic, // the op reads this source
        pr: PReg ,
    }

    // Read only for the selected entry.
    struct IqCold {
        uop       : logic <fu_pkg::UOP_W>, // FU-specific op code
        imm       : logic <32>           ,
        rm        : logic <3>            ,
        ftq       : FtqTag               ,
        foff      : logic <FOFF_W>       ,
        pred_taken: logic                , // this op is its block's predicted taken exit
        rvc       : logic                ,
        lq        : LqTag                ,
        sq        : SqTag                ,
    }

    // dispatch -> iq, one per rename lane.
    struct IqAlloc {
        tag       : ExTag    ,
        fu        : FuKind   ,
        nonspec   : logic    , // select only with the oldest token
        src       : IqSrc <3>,
        rdy       : logic <3>, // initial ready per source (1 when unused)
        obey_fence: logic    , // a load behind an unretired ld_barrier op
        bar_w     : BarSeq   , // ld_barrier ops allocated before this load
        cold      : IqCold   ,
    }

    // iq -> exec_port / mem_pipe, one per issue port, combinational in S.
    struct IqGrant {
        valid: logic           ,
        entry: logic <IQ_ENT_W>, // returned with iq_release
        tag  : ExTag           ,
        fu   : FuKind          ,
        src  : IqSrc <3>       ,
        cold : IqCold          ,
    }

    struct IqRelease {
        valid: logic          ,
        entry: logic<IQ_ENT_W>,
    }

    // ---- Topology derived from the FU table ----

    // FU kinds a memory pipe accepts: every pipe takes loads and stores,
    // atomics run only on pipe 0.
    function mem_port_fu (
        m: input u32,
    ) -> FuSet {
        return fu_bit(FuKind::LOAD) | fu_bit(FuKind::STORE) | (if m == 0 ? fu_bit(FuKind::ATOMIC) : 0);
    }

    // The exec port that is issue port i of IQ q.
    function iq_exec_port (
        q: input u32,
        i: input u32,
    ) -> u32 {
        var r: u32;
        var c: u32;
        r = 0;
        c = 0;
        for p in 0..CFG::ISSUE_W {
            if CFG::PORT_IQ[p] == q {
                if c == i {
                    r = p;
                }
                c += 1;
            }
        }
        return r;
    }

    // Position of exec port p among the issue ports of its IQ.
    function exec_port_local (
        p: input u32,
    ) -> u32 {
        var c: u32;
        c = 0;
        for j in 0..CFG::ISSUE_W {
            if j <: p && CFG::PORT_IQ[j] == CFG::PORT_IQ[p] {
                c += 1;
            }
        }
        return c;
    }

    // FU set of issue port i of IQ q (memory pipe i for MEM_IQ).
    function iq_port_fu (
        q: input u32,
        i: input u32,
    ) -> FuSet {
        return if q == CFG::MEM_IQ ? mem_port_fu(i) : CFG::PORT_FU[iq_exec_port(q, i)];
    }

    // Whether FU kind k may read register class fp (0 INT, 1 FP) in source
    // slot s.
    function fu_reads (
        k : input FuKind,
        s : input u32   ,
        fp: input logic ,
    ) -> logic {
        var r: logic;
        r = 1'b0;
        case k {
            FuKind::ALU, FuKind::BRU, FuKind::MUL, FuKind::DIV, FuKind::SYS, FuKind::LOAD: {
                r = !fp && (s == 0 || (s == 1 && k != FuKind::LOAD));
            }
            FuKind::STORE, FuKind::ATOMIC: {
                r = (s == 0 && !fp) || s == 1;
            }
            FuKind::FMA: {
                r = fp && s <: 3;
            }
            FuKind::FMISC: {
                r = s == 0 || (s == 1 && fp);
            }
            FuKind::FDIV: {
                r = fp && s <: 2;
            }
            default: {}
        }
        return r;
    }

    // FU kinds a WB port carries: exec port w, or memory pipe w - ISSUE_W.
    function wb_fu (
        w: input u32,
    ) -> FuSet {
        return if w <: CFG::ISSUE_W ? CFG::PORT_FU[w] : mem_port_fu(w - CFG::ISSUE_W);
    }

    // Whether WB port w can write register class fp: the union of the
    // destination classes of its FUs.
    function wb_writes (
        w : input u32  ,
        fp: input logic,
    ) -> logic {
        var s   : FuSet;
        var iset: FuSet;
        var fset: FuSet;
        s    = wb_fu(w);
        iset = fu_bit(FuKind::ALU) | fu_bit(FuKind::BRU) | fu_bit(FuKind::MUL) | fu_bit(FuKind::DIV)
            | fu_bit(FuKind::SYS) | fu_bit(FuKind::FMISC) | fu_bit(FuKind::LOAD) | fu_bit(FuKind::ATOMIC);
        fset = fu_bit(FuKind::FMA) | fu_bit(FuKind::FMISC) | fu_bit(FuKind::FDIV) | fu_bit(FuKind::LOAD);
        return (s & (if fp ? fset : iset)) != 0;
    }

    // Furthest WB slot a RESERVED op on WB port w claims (D_p).
    function wb_depth (
        w: input u32,
    ) -> u32 {
        var d: u32  ;
        var s: FuSet;
        d = fu_pkg::WAKE_LEAD;
        s = wb_fu(w);
        for k in 0..FU_KIND_N {
            if s[k] && !fu_pkg::is_blocking(k as FuKind) && fu_pkg::claim_off(k as FuKind) >: d {
                d = fu_pkg::claim_off(k as FuKind);
            }
        }
        return d;
    }

    // PRF read ports: SRC_N per issue port, exec ports first, then memory
    // pipes; port r * SRC_N + s serves source slot s. Only the ports some FU
    // of that issue port reads in the class of the file exist.
    const PRF_RD_N: u32 = (CFG::ISSUE_W + CFG::MEM_W) * SRC_N;

    function rd_live (
        r : input u32  ,
        fp: input logic,
    ) -> logic {
        var l: logic;
        var s: FuSet;
        l = 1'b0;
        s = wb_fu(r / SRC_N);
        for k in 0..FU_KIND_N {
            if s[k] && fu_reads(k as FuKind, r % SRC_N, fp) {
                l = 1'b1;
            }
        }
        return l;
    }

    // Register read with bypass from the WB buses: the value of WB port w if
    // it writes pr this cycle (at most one does), else the PRF value.
    function bypass (
        pr: input PReg               ,
        rf: input logic   <64>       ,
        wb: input WbPacket     [WB_N],
    ) -> logic<64> {
        var hit: logic<WB_N>;
        var r  : logic<64>  ;
        for w in 0..WB_N {
            hit[w] = wb_writes(w, pr.cls == RegClass::FP) && wb[w].valid && wb[w].tag.has_rd && wb[w].tag.pdst == pr;
        }
        r = if hit == 0 ? rf : 0;
        for w in 0..WB_N {
            r = r | ({hit[w] repeat 64} & wb[w].data);
        }
        return r;
    }

    // Whether kill k removes the op tagged t.
    function killed (
        k: input Kill  ,
        t: input RobTag,
    ) -> logic {
        return k.valid && (k.full || tag_older::<ROB_TAG_W>(k.keep, t));
    }

    // ---- Structural constraints ----

    // One bit per violated constraint; a legal config has CFG_ERR == 0.
    // Constraints of a single module are added here by that module's owner.
    function cfg_err () -> u32 {
        var e: u32;
        e = 0;
        if CFG::FETCH_W != 1 && CFG::FETCH_W != 2 && CFG::FETCH_W != 4 {
            e |= 1 << 0; // icache block and one ITLB lookup per block cap fetch at 32 bytes
        }
        if CFG::FETCH_BYTES != 8 * CFG::FETCH_W {
            e |= 1 << 1;
        }
        if CFG::RENAME_W == 0 || CFG::ISSUE_W == 0 || CFG::MEM_W == 0 || CFG::COMMIT_W == 0 {
            e |= 1 << 2;
        }
        if CFG::ROB_N >: 256 || (CFG::ROB_N & (CFG::ROB_N - 1)) != 0 || CFG::ROB_N <: CFG::RENAME_W {
            e |= 1 << 3; // vector unit: 8-bit owner and idx - head age
        }
        if CFG::PRF_INT_N <= 32 || CFG::PRF_FP_N <= 32 {
            e |= 1 << 4;
        }
        if CFG::REISSUE_W == 0 || CFG::REISSUE_W >: CFG::MEM_W {
            e |= 1 << 5;
        }
        if CFG::MSHR_N != 1 || CFG::DC_NB != 1 {
            e |= 1 << 6; // one fill per hart until the new core boots N=4
        }
        if CFG::DQ_N <: CFG::FETCH_W || CFG::RQ_N <: CFG::FETCH_W || CFG::RQ_N <: CFG::RENAME_W {
            e |= 1 << 7; // a lane_queue holds at least one full group
        }
        if CFG::MEM_IQ >= CFG::N_IQ {
            e |= 1 << 8;
        }
        for q in 0..CFG::N_IQ {
            if iq_port_count(q) == 0 || CFG::IQ_N[q] <: CFG::RENAME_W || CFG::IQ_NSRC[q] == 0 || CFG::IQ_NSRC[q] >: 3 {
                e |= 1 << 9;
            }
        }
        for p in 0..CFG::ISSUE_W {
            if CFG::PORT_IQ[p] >= CFG::N_IQ || CFG::PORT_IQ[p] == CFG::MEM_IQ {
                e |= 1 << 10;
            }
            // Memory and dispatch-completed kinds never sit on an exec port.
            if (CFG::PORT_FU[p]
                    & (fu_bit(FuKind::NONE) | fu_bit(FuKind::LOAD) | fu_bit(FuKind::STORE) | fu_bit(FuKind::ATOMIC)
                        | fu_bit(FuKind::VEC))) != 0 {
                e |= 1 << 11;
            }
            // At most one HOLE_FILL (blocking) FU per port: one wb_resv requester.
            if CFG::PORT_FU[p][FuKind::DIV] && CFG::PORT_FU[p][FuKind::FDIV] {
                e |= 1 << 12;
            }
            // The ports of one FU kind share an IQ, so the destination IQ of an
            // op depends on its kind alone.
            for p2 in 0..CFG::ISSUE_W {
                if (CFG::PORT_FU[p] & CFG::PORT_FU[p2]) != 0 && CFG::PORT_IQ[p] != CFG::PORT_IQ[p2] {
                    e |= 1 << 13;
                }
            }
        }
        if port_count(FuKind::SYS) != 1 {
            e |= 1 << 14;
        }
        if port_count(FuKind::ALU) == 0 || port_count(FuKind::BRU) == 0 || port_count(FuKind::MUL) == 0
            || port_count(FuKind::DIV) == 0 || port_count(FuKind::FMA) == 0 || port_count(FuKind::FMISC) == 0
            || port_count(FuKind::FDIV) == 0 {
            e |= 1 << 15; // every exec kind decode can emit has a port
        }
        if CFG::NUM_CKPT != 0 {
            e |= 1 << 16; // rename recovers by walk only until the checkpoint pool exists
        }
        return e;
    }

    const CFG_ERR: u32 = cfg_err();
}
