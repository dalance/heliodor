// exc_pkg: the exception record carried with an op from its source (fetch,
// decode, memory pipe) to the oldest-exception register in the ROB.
pub package exc_pkg {
    // The H-extension fields: gpa is the faulting guest physical address
    // shifted right by 2 (htval/mtval2) of a guest-page fault, gva marks a
    // tval that holds a guest virtual address, and implicit a guest-page
    // fault of an implicit VS-stage PTE access (htinst/mtinst get the
    // pseudoinstruction of that access: a read, or with imp_wr the write of
    // the PTE's A/D update). dm (cause 3 only) makes the exception an
    // entry into Debug Mode instead of a trap: an EBREAK that dcsr.ebreakX
    // routes to the Debug Module, or any EBREAK in Debug Mode. trig marks a
    // trigger match (cause 3, tval carried from the source); trig_hit is the
    // mask of the triggers that fired, set as their hit bits on acceptance.
    const TRIG_MAX: u32 = 4;

    struct ExcRec {
        valid   : logic          ,
        cause   : logic<6>       ,
        tval    : logic<64>      ,
        gpa     : logic<62>      ,
        gva     : logic          ,
        implicit: logic          ,
        imp_wr  : logic          ,
        dm      : logic          ,
        trig    : logic          ,
        trig_hit: logic<TRIG_MAX>,
    }
}
