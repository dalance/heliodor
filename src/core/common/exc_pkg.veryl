// exc_pkg: the exception record carried with an op from its source (fetch,
// decode, memory pipe) to the oldest-exception register in the ROB.
pub package exc_pkg {
    // gpa (guest physical address, feeds htval as gpa >> 2) and gva (tval
    // holds a guest virtual address) are the H-extension fields; no source
    // in this core build sets them. dm (cause 3 only) makes the exception an
    // entry into Debug Mode instead of a trap: an EBREAK that dcsr.ebreakX
    // routes to the Debug Module, or any EBREAK in Debug Mode.
    struct ExcRec {
        valid: logic    ,
        cause: logic<6> ,
        tval : logic<64>,
        gpa  : logic<54>,
        gva  : logic    ,
        dm   : logic    ,
    }
}
