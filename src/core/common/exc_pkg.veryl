// Exception record carried with an op from its source (fetch, decode,
// memory pipe) to the oldest-exception register in the ROB.
pub package exc_pkg {
    // gpa feeds htval as gpa >> 2.
    struct ExcRec {
        valid: logic    ,
        cause: logic<6> ,
        tval : logic<64>,
        gpa  : logic<54>,
        gva  : logic    ,
    }
}
