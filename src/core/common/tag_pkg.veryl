// tag_pkg: config-independent index widths, and the age helpers for ring
// tags.
//
// A ring tag is {wrap, idx}: idx is the slot in a ring of N entries (N need
// not be a power of two) and wrap toggles each time idx passes N-1. W is the
// full tag width, 1 + index width (core_types exports ROB_TAG_W and friends).
//
// The age helpers are global generic functions rather than members of
// tag_pkg: a package generic function instantiated with a constant of its
// caller (a module parameter or a core_types constant) makes the package
// depend on the caller, while a global one is generated inside the caller.
pub package tag_pkg {
    // Index width for n entries, never below 1 so that single-entry axes
    // (MEM_W = 1, NUM_CKPT = 0) do not produce logic<0>.
    function idx_w (
        n: input u32,
    ) -> u32 {
        return if n >= 2 ? $clog2(n) : 1;
    }
}

// a is strictly older than b. Valid only while both tags live in the same
// ring window, i.e. their allocation counts differ by less than N.
function tag_older::<W: u32> (
    a: input logic<W>,
    b: input logic<W>,
) -> logic {
    return if a[W - 1] == b[W - 1] ? a[W - 2:0] <: b[W - 2:0] : a[W - 2:0] >: b[W - 2:0];
}

function tag_older_eq::<W: u32> (
    a: input logic<W>,
    b: input logic<W>,
) -> logic {
    return a == b || tag_older::<W>(a, b);
}

// The tag allocated after t in a ring of N entries.
function tag_next::<W: u32, N: u32> (
    t: input logic<W>,
) -> logic<W> {
    return if t[W - 2:0] == N - 1 ? {~t[W - 1], 1'b0 repeat W - 1} : t + 1;
}
