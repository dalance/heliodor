// tag_pkg: config-independent index widths. The ring-tag age helpers that
// go with them are the global functions in tag_age.veryl.
pub package tag_pkg {
    // Index width for n entries, never below 1 so that single-entry axes
    // (MEM_W = 1, NUM_CKPT = 0) do not produce logic<0>.
    function idx_w (
        n: input u32,
    ) -> u32 {
        return if n >= 2 ? $clog2(n) : 1;
    }
}
