// cfg_w4: the 4-4-6-2-4 supported config (fetch, rename, issue, memory, commit).
//
// Exec ports p0-p3 are integer (ALU on all, BRU on p0/p1, MUL on p2, SYS and
// DIV on p3) and share one IQ; p4/p5 are the FP ports (FMA on both, FMISC on
// p4, FDIV on p5) with their own IQ; the two memory pipes have a third IQ.
// The FU split lets the integer IQ carry 2 sources instead of 3.
pub package cfg_w4 for core_cfg {
    import opclass_pkg::*;

    const FETCH_W : u32 = 4;
    const RENAME_W: u32 = 4;
    const ISSUE_W : u32 = 6;
    const MEM_W   : u32 = 2;
    const COMMIT_W: u32 = 4;

    const FETCH_BYTES: u32 = 32;

    const ROB_N    : u32 = 128;
    const LQ_N     : u32 = 64;
    const SQ_N     : u32 = 32;
    const SB_N     : u32 = 16;
    const FTQ_N    : u32 = 32;
    const PRF_INT_N: u32 = 160;
    const PRF_FP_N : u32 = 96;
    const NUM_CKPT : u32 = 8;
    const FBQ_N    : u32 = 4;
    const DQ_N     : u32 = 16;
    const RQ_N     : u32 = 8;

    const PRED_META_W: u32 = 27;
    const PRED_CKPT_W: u32 = 69;

    const DTLB_N   : u32 = 32;
    const ITLB_N   : u32 = 16;
    const PTW_D_QN : u32 = 4;
    const PTW_I_QN : u32 = 1;
    const REISSUE_W: u32 = 1;
    const DC_NB    : u32 = 4;
    const MSHR_N   : u32 = 2;

    const PORT_FU: FuSet [ISSUE_W] = '{
        fu_bit(FuKind::ALU) | fu_bit(FuKind::BRU), fu_bit(FuKind::ALU) | fu_bit(FuKind::BRU),
        fu_bit(FuKind::ALU) | fu_bit(FuKind::MUL), fu_bit(FuKind::ALU) | fu_bit(FuKind::SYS) | fu_bit(FuKind::DIV),
        fu_bit(FuKind::FMA) | fu_bit(FuKind::FMISC), fu_bit(FuKind::FMA) | fu_bit(FuKind::FDIV)
    };
    const PORT_IQ: u32   [ISSUE_W] = '{0, 0, 0, 0, 1, 1};
    const N_IQ   : u32             = 3;
    const MEM_IQ : u32             = 2;
    const IQ_N   : u32   [N_IQ]    = '{32, 24, 24};
    const IQ_NSRC: u32   [N_IQ]    = '{2, 3, 2};
}
