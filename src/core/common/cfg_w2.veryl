// cfg_w2: the 2-2-2-1-2 supported config (fetch, rename, issue, memory, commit).
//
// Exec port p0 carries ALU, BRU, SYS, MUL and DIV; p1 carries ALU and the
// scalar FP units. Both are fed by one IQ because p1 mixes integer and FP
// work; the memory pipe has its own IQ.
pub package cfg_w2 for core_cfg {
    import opclass_pkg::*;

    const FETCH_W : u32 = 2;
    const RENAME_W: u32 = 2;
    const ISSUE_W : u32 = 2;
    const MEM_W   : u32 = 1;
    const COMMIT_W: u32 = 2;

    const FETCH_BYTES: u32 = 16;

    const ROB_N    : u32 = 64;
    const LQ_N     : u32 = 32;
    const SQ_N     : u32 = 16;
    const SB_N     : u32 = 8;
    const FTQ_N    : u32 = 32;
    const PRF_INT_N: u32 = 96;
    const PRF_FP_N : u32 = 64;
    const NUM_CKPT : u32 = 4;
    const FBQ_N    : u32 = 4;
    const DQ_N     : u32 = 8;
    const RQ_N     : u32 = 4;

    const PRED_META_W: u32 = 17;
    const PRED_CKPT_W: u32 = 68;

    const DTLB_N   : u32 = 32;
    const ITLB_N   : u32 = 16;
    const PTW_D_QN : u32 = 4;
    const PTW_I_QN : u32 = 1;
    const REISSUE_W: u32 = 1;
    const DC_NB    : u32 = 2;
    const MSHR_N   : u32 = 2;

    const PORT_FU: FuSet [ISSUE_W] = '{
        fu_bit(FuKind::ALU) | fu_bit(FuKind::BRU) | fu_bit(FuKind::SYS) | fu_bit(FuKind::MUL) | fu_bit(FuKind::DIV),
        fu_bit(FuKind::ALU) | fu_bit(FuKind::FMISC) | fu_bit(FuKind::FMA) | fu_bit(FuKind::FDIV)
    };
    const PORT_IQ: u32   [ISSUE_W] = '{0, 0};
    const N_IQ   : u32             = 2;
    const MEM_IQ : u32             = 1;
    const IQ_N   : u32   [N_IQ]    = '{24, 16};
    const IQ_NSRC: u32   [N_IQ]    = '{3, 2};
}
