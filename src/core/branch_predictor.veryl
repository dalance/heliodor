// Branch predictor: BTB (Branch Target Buffer) + BHT (Branch History Table)
//
// IF stage:  predict(pc) → taken, target
// EX stage:  update(pc, actual_taken, actual_target)
//
// BTB: 64-entry direct-mapped, stores target address for taken branches.
// BHT: 256-entry 2-bit saturating counter, predicts taken/not-taken.
//
// JAL instructions are always predicted taken (unconditional).
// JALR uses BTB target if available (indirect jump prediction).
// Conditional branches use BHT.
pub module branch_predictor (
    clk: input clock,
    rst: input reset,

    // IF stage: prediction query
    i_pc            : input  logic<64>,
    i_is_branch     : input  logic    , // current insn is a conditional branch
    i_is_jal        : input  logic    , // current insn is JAL
    i_is_jalr       : input  logic    , // current insn is JALR
    o_predict_taken : output logic    ,
    o_predict_target: output logic<64>,

    // EX stage: update after resolution
    i_update_valid    : input logic    ,
    i_update_pc       : input logic<64>,
    i_update_taken    : input logic    ,
    i_update_target   : input logic<64>,
    i_update_is_branch: input logic    , // was a conditional branch
) {
    // --- BTB: 64-entry direct-mapped ---
    // Index: pc[7:2] (6 bits, skip lowest 2 for word alignment)
    // Tag:   pc[63:8]
    var btb_valid : logic     [64];
    var btb_tag   : logic<56> [64];
    var btb_target: logic<64> [64];

    let pred_btb_idx  : logic<6>  = i_pc[7:2];
    let pred_btb_tag  : logic<56> = i_pc[63:8];
    let btb_hit       : logic     = btb_valid[pred_btb_idx] && btb_tag[pred_btb_idx] == pred_btb_tag;
    let btb_target_out: logic<64> = btb_target[pred_btb_idx];

    // --- BHT: 256-entry 2-bit saturating counter ---
    // Index: pc[9:2] (8 bits)
    // Counter: 00=strongly not-taken, 01=weakly not-taken,
    //          10=weakly taken, 11=strongly taken
    var bht: logic<2> [256];

    let pred_bht_idx     : logic<8> = i_pc[9:2];
    let pred_bht_count   : logic<2> = bht[pred_bht_idx];
    let bht_predict_taken: logic    = pred_bht_count[1]; // MSB = taken

    // --- Prediction logic ---
    // JAL: always taken, target from immediate (but we don't have it here;
    //      use BTB if available, otherwise predict not-taken and let EX redirect)
    // JALR: use BTB target if hit
    // Branch: use BHT + BTB
    // JAL: always taken, use BTB for target.
    // JALR: NOT predicted — target depends on register value which
    //       changes per call site.  Needs RAS for function returns.
    // Conditional branch: use BHT direction + BTB target.
    // JAL: predict taken if BTB has an entry.
    // Conditional branch: disabled pending investigation of Linux boot
    //   interaction with the calibration delay loop.
    // JALR: not predicted (needs RAS).
    assign o_predict_taken = if i_is_jal ? btb_hit : if i_is_branch ? bht_predict_taken && btb_hit : 1'b0;
    assign o_predict_target = btb_target_out;

    // --- Update logic (EX stage feedback) ---
    let upd_btb_idx: logic<6>  = i_update_pc[7:2];
    let upd_btb_tag: logic<56> = i_update_pc[63:8];
    let upd_bht_idx: logic<8>  = i_update_pc[9:2];

    always_ff (clk, rst) {
        if_reset {
            for i: i32 in 0..64 {
                btb_valid[i] = 1'b0;
            }
            for i: i32 in 0..256 {
                bht[i] = 2'b01; // weakly not-taken
            }
        } else if i_update_valid {
            // Update BTB on taken branches/jumps
            if i_update_taken {
                btb_valid[upd_btb_idx]  = 1'b1;
                btb_tag[upd_btb_idx]    = upd_btb_tag;
                btb_target[upd_btb_idx] = i_update_target;
            }
            // Update BHT for conditional branches only
            if i_update_is_branch {
                if i_update_taken && bht[upd_bht_idx] != 2'b11 {
                    bht[upd_bht_idx] = bht[upd_bht_idx] + 2'd1;
                }
                if !i_update_taken && bht[upd_bht_idx] != 2'b00 {
                    bht[upd_bht_idx] = bht[upd_bht_idx] - 2'd1;
                }
            }
        }
    }
}
