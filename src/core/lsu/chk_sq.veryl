// chk_sq: checker of sq.
//
// Ports (timing contract):
//   i_kill, i_alloc_valid, i_gnt : sq's inputs of this cycle
//   i_live, i_rob, i_hrdy : sq's registered entries
//   i_win_ok, i_ret : per commit-window slot, retire_ok and retiring
//   o_chk    : registered sticky flags:
//              0 a live entry is selected by the kill of the previous cycle
//              1 an allocation in a kill cycle
//              2 a store retires without retire_ok
//              3 a re-issue grant for an entry without a pending hi pass
// Owns:
//   - no output feeds design logic; instantiated only under HELIODOR_CHK
pub module chk_sq::<CFG: core_cfg> #(
    param N: u32 = 1,
) (
    clk     : input  clock                                     ,
    rst     : input  reset                                     ,
    i_kill  : input  core_types::<CFG>::Kill                   ,
    i_live  : input  logic<N>                                  ,
    i_rob   : input  core_types::<CFG>::RobTag  [N]            ,
    i_hrdy  : input  logic                      [N]            ,
    i_alloc_valid: input  logic                 [CFG::RENAME_W],
    i_win_ok: input  logic<CFG::MEM_W>                         ,
    i_ret   : input  logic<CFG::MEM_W>                         ,
    i_gnt   : input  logic<N>                                  ,
    o_chk   : output logic<4>                                  ,
) {
    import core_types::<CFG>::*;

    var kill_q: Kill    ;
    var chk_q : logic<4>;

    var bad: logic<4>;
    always_comb {
        bad = 4'd0;
        for e in 0..N {
            if kill_q.valid && i_live[e] && killed(kill_q, i_rob[e]) {
                bad[0] = 1'b1;
            }
            if i_gnt[e] && (!i_live[e] || !i_hrdy[e]) {
                bad[3] = 1'b1;
            }
        }
        for l in 0..CFG::RENAME_W {
            if i_alloc_valid[l] && i_kill.valid {
                bad[1] = 1'b1;
            }
        }
        if (i_ret & ~i_win_ok) != '0 {
            bad[2] = 1'b1;
        }
    }

    always_ff {
        if_reset {
            kill_q.valid = 1'b0;
            chk_q        = 4'd0;
        } else {
            kill_q = i_kill;
            chk_q  = chk_q | bad;
        }
    }
    assign o_chk = chk_q;
}
