// sb: committed store buffer; line write-combining, the drain port, the SB
// part of the forwarding network and the ordering predicate.
//
// Ports (timing contract):
//   i_push[PUSH_W]    : lines of the stores retired this cycle, in program
//                       order (port order); never more allocations than o_credit
//   o_credit          : registered state only; free entries (lines),
//                       saturated at PUSH_W (the most one cycle can push)
//   i_fwd_q -> o_fwd  : combinational, against registered entries
//   o_drain_*         : the head entry, registered state only, held until
//                       i_drain_ack (combinational from the dcache)
//   o_drain_urgent    : registered state only: at most one entry is free;
//                       asks the dcache to favour the drain
//   o_ordering_empty  : no entry: every committed store is visible; what
//                       FENCE and the other draining ops wait for
//   o_perf            : combinational event wires
//   o_chk             : sticky checker flags (HELIODOR_CHK only, else 0)
// Owns:
//   - a push merges into the youngest entry with its line, among the
//     registered entries (except the head acked this cycle) and the entries
//     made by earlier pushes of the same cycle; otherwise it allocates. A
//     fresh push (cbo.zero) always allocates; later pushes may merge into it
//   - a drained store stays visible to forwarding through its ack cycle and
//     SHADOW_LEN cycles after. This module is built for SHADOW_LEN = 0 (a
//     load forwards and reads the data array in the same cycle, so the ack
//     edge itself hands over); CFG_ERR bit 17 rejects any other value
//   - only the head drives the drain port, so the driver is the owner
// Rationale:
//   - merging into an older entry past entries of other lines reorders
//     stores to different lines; RVWMO allows it and ordering_empty restores
//     order for the operations that need it
//   - a push that shares its line with an earlier push of the cycle takes
//     the target of the first such push; new entries are numbered by a
//     prefix count, so no chain runs across the push ports
//   - the data and strobe of one entry fold this cycle's pushes in port
//     order (a later store overwrites an earlier one's bytes): a serial
//     fold over the PUSH_W = max(MEM_W, 2) push ports, exempt from the tree
//     rule
pub module sb::<CFG: core_cfg> (
    clk: input clock,
    rst: input reset,

    i_push: input  core_types::<CFG>::SbPush [core_types::<CFG>::PUSH_W],
    o_credit: output logic<core_types::<CFG>::SB_CREDIT_W>              ,

    i_fwd_q: input  core_types::<CFG>::FwdQuery [CFG::MEM_W],
    o_fwd  : output core_types::<CFG>::FwdPart  [CFG::MEM_W],

    o_drain_v     : output logic        ,
    o_drain_addr  : output logic<64>    ,
    o_drain_data  : output logic<64> [8],
    o_drain_strb  : output logic<8>  [8],
    o_drain_urgent: output logic        ,
    i_drain_ack   : input  logic        ,

    o_ordering_empty: output logic,

    o_chk: output logic<2>,

    o_perf: output core_types::<CFG>::SbPerf,
) {
    import core_types::<CFG>::*;

    const QN  : u32 = CFG::SB_N;
    const QIW : u32 = tag_pkg::idx_w(QN);
    const QTW : u32 = QIW + 1;

    function be512 (
        s: input logic<64>,
    ) -> logic<512> {
        var r: logic<512>;
        for i in 0..64 {
            r[i * 8+:8] = {s[i] repeat 8};
        }
        return r;
    }

    var head_q: logic<QTW>;
    var tail_q: logic<QTW>;

    var e_line: logic<50>  [QN];
    var e_data: logic<512> [QN];
    var e_strb: logic<64>  [QN];
    var e_wrap: logic      [QN];

    function sb_adv (
        t: input logic<QTW> ,
        k: input logic<32> ,
    ) -> logic<QTW> {
        var s: logic<32>;
        s = (t[QIW - 1:0] as 32) + k;
        return if s >= QN ? {~t[QTW - 1], (s - QN) as QIW} : {t[QTW - 1], s as QIW};
    }

    let cnt: logic<32> = if head_q[QTW - 1] == tail_q[QTW - 1] ? (tail_q[QIW - 1:0] as 32) - (head_q[QIW - 1:0] as 32) : QN - (head_q[QIW - 1:0] as 32) + (tail_q[QIW - 1:0] as 32);
    let hix: logic<QIW> = head_q[QIW - 1:0];
    assign o_credit = (if QN - cnt >: PUSH_W ? PUSH_W : QN - cnt) as SB_CREDIT_W;

    var live : logic<QN>;
    var rtags: logic<QTW> [QN]; // youngest-first order for tree_oldest
    always_comb {
        for e in 0..QN {
            live[e]  = if head_q[QTW - 1] == tail_q[QTW - 1] ? (e >= head_q[QIW - 1:0] && e <: tail_q[QIW - 1:0]) : (e >= head_q[QIW - 1:0] || e <: tail_q[QIW - 1:0]);
            rtags[e] = {e_wrap[e], ~(e as QIW)};
        }
    }

    // ---- push targets ----

    var p_m    : logic<QN>         [PUSH_W]; // registered entries holding the line
    var p_same : logic<PUSH_W>     [PUSH_W]; // earlier pushes of the same line
    var p_new  : logic<PUSH_W>             ;
    var p_rank : logic<QTW>        [PUSH_W]; // new entries before push k
    var p_base : logic<QIW>        [PUSH_W]; // target ignoring earlier pushes
    var p_tgt  : logic<QIW>        [PUSH_W];
    var p_nw   : logic<PUSH_W>             ; // wrap bit of a new entry's position
    var n_new  : logic<32>                 ;
    always_comb {
        for k in 0..PUSH_W {
            for e in 0..QN {
                p_m[k][e] = live[e] && !i_push[k].fresh && e_line[e] == i_push[k].line && !(e == hix && i_drain_ack);
            }
            for j in 0..PUSH_W {
                p_same[k][j] = j <: k && !i_push[k].fresh && i_push[j].valid && i_push[j].line == i_push[k].line;
            }
            p_new[k] = i_push[k].valid && p_same[k] == '0 && p_m[k] == '0;
        }
        tree_prefix_count::<PUSH_W, QTW>(p_new << 1, p_rank);
        n_new = tree_popcount::<PUSH_W, 32>(p_new);
        for k in 0..PUSH_W {
            let at: logic<QTW> = sb_adv(tail_q, p_rank[k] as 32);
            p_base[k] = if p_m[k] != '0 ? tree_onehot_enc::<QN, QIW>(tree_oldest::<QN, QTW>(p_m[k], rtags)) : at[QIW - 1:0];
            p_nw[k]   = at[QTW - 1];
        }
        for k in 0..PUSH_W {
            p_tgt[k] = if p_same[k] != '0 ? tree_onehot_mux::<PUSH_W, QIW>(tree_first::<PUSH_W>(p_same[k]), p_base) : p_base[k];
        }
    }

    // ---- forwarding ----

    for p in 0..CFG::MEM_W :g_fwd {
        var cov: logic<16>  [QN];
        var dat: logic<128> [QN];
        always_comb {
            for e in 0..QN {
                let hit: logic = live[e] && e_line[e] == i_fwd_q[p].line;
                let sm : logic<64>  = e_strb[e] >> {i_fwd_q[p].dw, 3'd0};
                let sd : logic<512> = e_data[e] >> {i_fwd_q[p].dw, 6'd0};
                cov[e] = if hit ? sm[15:0] & i_fwd_q[p].mask : 16'd0;
                dat[e] = sd[127:0];
            }
        }
        always_comb {
            for b in 0..16 {
                var c : logic<QN>    ;
                var bd: logic<8> [QN];
                for e in 0..QN {
                    c[e]  = cov[e][b];
                    bd[e] = dat[e][b * 8+:8];
                }
                o_fwd[p].cov[b]       = c != '0;
                o_fwd[p].data[b * 8+:8] = tree_onehot_mux::<QN, 8>(tree_oldest::<QN, QTW>(c, rtags), bd);
            }
            o_fwd[p].wt    = 1'b0;
            o_fwd[p].wait_sq = '0;
        }
    }

    // ---- drain and predicates ----

    assign o_drain_v      = cnt != 0;
    assign o_drain_addr   = {8'd0, e_line[hix], 6'd0};
    assign o_drain_urgent = cnt >= QN - 1;
    for l in 0..8 :g_dr {
        assign o_drain_data[l] = e_data[hix][l * 64+:64];
        assign o_drain_strb[l] = e_strb[hix][l * 8+:8];
    }
    assign o_ordering_empty = cnt == 0;

    // ---- state ----

    // Each entry's next value applies this cycle's pushes in port order.
    var n_wr  : logic<QN>       ;
    var n_line: logic<50>  [QN];
    var n_wrap: logic      [QN];
    var n_data: logic<512> [QN];
    var n_strb: logic<64>  [QN];
    always_comb {
        for e in 0..QN {
            n_wr[e]   = 1'b0;
            n_line[e] = e_line[e];
            n_wrap[e] = e_wrap[e];
            n_data[e] = e_data[e];
            n_strb[e] = e_strb[e];
            for k in 0..PUSH_W {
                if i_push[k].valid && p_tgt[k] == e {
                    let bits: logic<512> = be512(i_push[k].strb);
                    n_wr[e] = 1'b1;
                    if p_new[k] {
                        n_line[e] = i_push[k].line;
                        n_wrap[e] = p_nw[k];
                        n_data[e] = i_push[k].data & bits;
                        n_strb[e] = i_push[k].strb;
                    } else {
                        n_data[e] = (n_data[e] & ~bits) | (i_push[k].data & bits);
                        n_strb[e] = n_strb[e] | i_push[k].strb;
                    }
                }
            }
        }
    }

    always_ff {
        if_reset {
            head_q = '0;
            tail_q = '0;
        } else {
            head_q = sb_adv(head_q, i_drain_ack as 32);
            tail_q = sb_adv(tail_q, n_new);
            for e in 0..QN {
                if n_wr[e] {
                    e_line[e] = n_line[e];
                    e_wrap[e] = n_wrap[e];
                    e_data[e] = n_data[e];
                    e_strb[e] = n_strb[e];
                }
            }
        }
    }

    always_comb {
        var mg: logic<PUSH_W>;
        for k in 0..PUSH_W {
            mg[k] = i_push[k].valid && !p_new[k];
        }
        o_perf.merge  = |mg;
        o_perf.alloc  = p_new != '0;
        o_perf.full   = cnt == QN;
        o_perf.urgent = o_drain_urgent;
        o_perf.drain  = i_drain_ack;
    }

    #[ifdef(HELIODOR_CHK)]
    {
        inst u_chk: chk_sb (
            clk                        ,
            rst                        ,
            i_alloc: n_new             ,
            i_free : QN - cnt           ,
            i_ack  : i_drain_ack       ,
            i_empty: cnt == 0          ,
            o_chk                      ,
        );
    }
    #[ifndef(HELIODOR_CHK)]
    assign o_chk = 0;
}
