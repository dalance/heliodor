// chk_lq: observation-only invariant checker of lq (sticky flags)
//
//   o_chk[0] : a live entry is selected by the kill of the previous cycle
//   o_chk[1] : an allocation in a kill cycle
//   o_chk[2] : a verdict for an entry that is not live, or not in ISSUE or
//              INFLIGHT (only an op in the pipe gets one)
//   o_chk[3] : a re-issue grant for an entry that is not live and READY
pub module chk_lq::<CFG: core_cfg> #(
    param N: u32 = 1,
) (
    clk      : input  clock                                       ,
    rst      : input  reset                                       ,
    i_kill   : input  core_types::<CFG>::Kill                     ,
    i_live   : input  logic<N>                                    ,
    i_rob    : input  core_types::<CFG>::RobTag    [N]            ,
    i_state  : input  core_types::<CFG>::LqState   [N]            ,
    i_alloc_valid: input  logic                    [CFG::RENAME_W],
    i_verdict: input  core_types::<CFG>::LqVerdict [CFG::MEM_W]   ,
    i_gnt    : input  logic<N>                                    ,
    o_chk    : output logic<4>                                    ,
) {
    import core_types::<CFG>::*;

    var kill_q: Kill    ;
    var chk_q : logic<4>;

    var bad: logic<4>;
    always_comb {
        bad = 4'd0;
        for e in 0..N {
            if kill_q.valid && i_live[e] && killed(kill_q, i_rob[e]) {
                bad[0] = 1'b1;
            }
            for p in 0..CFG::MEM_W {
                if i_verdict[p].valid && i_verdict[p].lq.idx == e && (!i_live[e] || (i_state[e] != LqState::ISSUE && i_state[e] != LqState::INFLIGHT)) {
                    bad[2] = 1'b1;
                }
            }
            if i_gnt[e] && (!i_live[e] || i_state[e] != LqState::READY) {
                bad[3] = 1'b1;
            }
        }
        for l in 0..CFG::RENAME_W {
            if i_alloc_valid[l] && i_kill.valid {
                bad[1] = 1'b1;
            }
        }
    }

    always_ff {
        if_reset {
            kill_q.valid = 1'b0;
            chk_q        = 4'd0;
        } else {
            kill_q = i_kill;
            chk_q  = chk_q | bad;
        }
    }
    assign o_chk = chk_q;
}
