// chk_sb: checker of sb.
//
// Ports (timing contract):
//   i_alloc, i_free, i_ack, i_empty : sb's values of this cycle
//   o_chk    : registered sticky flags:
//              0 a cycle's pushes allocate more entries than were free
//              1 a drain ack while the buffer is empty
// Owns:
//   - no output feeds design logic; instantiated only under HELIODOR_CHK
pub module chk_sb (
    clk    : input  clock    ,
    rst    : input  reset    ,
    i_alloc: input  logic<32>, // entries allocated this cycle
    i_free : input  logic<32>, // free entries at the start of the cycle
    i_ack  : input  logic    ,
    i_empty: input  logic    ,
    o_chk  : output logic<2> ,
) {
    var chk_q: logic<2>;
    always_ff {
        if_reset {
            chk_q = 2'd0;
        } else {
            if i_alloc >: i_free {
                chk_q[0] = 1'b1;
            }
            if i_ack && i_empty {
                chk_q[1] = 1'b1;
            }
        }
    }
    assign o_chk = chk_q;
}
