// chk_head: observation-only invariant checker of a HEAD-port client
// (atomic_unit, io_unit) and its started latch (sticky flags)
//
//   o_chk[0] : a request presented while the op neither holds the oldest token
//              nor has its started latch set
//   o_chk[1] : a request presented while an earlier one is still unanswered
//   o_chk[2] : a kill selected the op of a set started latch
//   o_chk[3] : a request the unit must not present (atomic_unit: a write after
//              the watch saw the line leave; io_unit: a request after PENDING)
pub module chk_head (
    clk        : input  clock   ,
    rst        : input  reset   ,
    i_req      : input  logic   , // a request presented on the HEAD port
    i_tok_ok   : input  logic   , // the token is valid and names the op
    i_started  : input  logic   , // the started latch (registered)
    i_wait_resp: input  logic   , // a request is outstanding (registered)
    i_kill_st  : input  logic   ,
    i_forbid   : input  logic   ,
    o_chk      : output logic<4>,
) {
    var chk_q: logic<4>;
    always_ff {
        if_reset {
            chk_q = 4'd0;
        } else {
            if i_req && !i_tok_ok && !i_started {
                chk_q[0] = 1'b1;
            }
            if i_req && i_wait_resp {
                chk_q[1] = 1'b1;
            }
            if i_kill_st {
                chk_q[2] = 1'b1;
            }
            if i_forbid {
                chk_q[3] = 1'b1;
            }
        }
    }
    assign o_chk = chk_q;
}
