// mem_pipe: one memory pipe; address generation, translation (Bare or Sv39
// through a DTLB lookup port) with PMP and PMA, the dcache request,
// forwarding, load formatting and the WB packet
//
// Served: integer and FP loads and stores of 1, 2, 4 and 8 bytes, misaligned
// and line-crossing ones included where the region allows misaligned access;
// atomics (on the HEAD pipe) and CBO ops.
//   - a non-cacheable load parks for the head (io_unit performs it); a
//     non-cacheable store writes its SQ entry like any store (io_unit
//     performs it at the head)
//   - an atomic is translated and checked here, writes its SQ entry (an LR
//     its LQ entry's completion) and leaves m2 for atomic_unit, which writes
//     it back; with an exception it completes here. An atomic that missed
//     the DTLB hands its operands to atomic_unit on its first pass and its PA
//     on the re-issued pass
//   - cbo.clean/flush/inval are translated and checked only; cbo.zero is a
//     store of the whole line
//
// Ports (timing contract):
//   i_iss, i_re    : cycle S, combinational; at most one is valid (mem_port_arb
//                    holds the IQ for this pipe when it grants a re-issue);
//                    captured into m0
//   o_iq_rel       : m0; a new issue releases its IQ entry on acceptance
//   i_tok          : commit's oldest token, read at m1
//   o_started      : m1, the accepted nonspec walk request of the op holding
//                    the oldest token (commit's head_started_q)
//   o_rf_addr*, i_rf_*, i_wb : m0 register read, bypassed from the WB bus
//   i_xl_on, i_ctx, i_pmp* : read at m1; they change only at a flushing
//                    retire. i_xl_on: Sv39 is on for data accesses (satp
//                    mode and the effective privilege, MPRV included);
//                    i_ctx.prv is that effective privilege, also for PMP
//   i_pmm          : read at m0 with i_xl_on; the pointer-masking mode of
//                    the effective privilege, changed only by a flushing retire
//   o_tlb_lk/i_tlb : m1, the DTLB lookup port, combinational round trip
//   o_xreq_valid/o_xreq, i_xreq_gnt : m1, the walk request of a pass that
//                    missed the DTLB; i_xreq_gnt is its acceptance in the
//                    same cycle
//   i_ptw_evt      : the walker's broadcast; an event of the pass's key from
//                    its m1 cycle until the verdict (loads) or the STA write
//                    (stores) marks the pass, which then does not park
//   o_req_*        : m2 = A, the adapter's accept cycle. Every request is
//                    accepted and answered exactly RESP_LAT cycles later
//                    (dcache_port_adapter), so i_resp at R belongs to the
//                    pass at R whenever that pass sent one
//   o_fwd_q, i_fwd_sq, i_fwd_sb : m2, combinational round trip
//   o_snap, o_sta, o_std : m2, written on the m2 edge
//   i_split_lo     : lq's registered lo dword of the crossing load in flight
//                    (at most one: crossing loads run only as the oldest)
//   o_verdict, o_wake    : R = m2 + RESP_LAT, combinational from the response;
//                    the wake leads o_wb by one cycle (see core_types Wake)
//   o_wb           : registered, R + 1 = m0 + LD_LAT, merged with the
//                    non-pipe clients' hole-fill packets i_np_wb (the HEAD
//                    pipe; the slots differ, so at most one is valid)
//   o_wake         : merged likewise with i_np_wake (each one cycle before its
//                    packet, so a hole-fill wake never meets a pass's wake)
//   i_np_hf/o_hf_req : the non-pipe clients' hole-fill requests to the pipe's
//                    wb_resv (at most one is set)
//   o_amo          : m2, the atomic handed to atomic_unit (HEAD pipe only)
//   o_perf         : combinational event wires
//   i_kill         : applied on the capture edge of every stage, and to the
//                    verdict and wake of the op at R
// Owns:
//   - every pass leaves at R: at most one verdict and one packet per pass, so
//     a pass uses no WB slot but the one reserved when it entered m0
//   - a store's completion packet (R + 1) follows its store-resolve scan
//     (m2 + 1), so no younger load retires past an unseen violation
//   - a load's value is the dcache line merged with forwarded bytes; a load
//     that cannot get every byte this pass parks and re-issues
//   - a pass that missed the DTLB sends no request and no packet: a load
//     parks XLATE in lq, a store's STA write parks its sq entry; both
//     re-issue the same pass after the walk. A re-issue carrying the walk's
//     fault (xexc, the owner's answer) takes it instead of a lookup
//   - a store, AMO or SC pass that hits a W = 1, D = 0 entry under ADUE is
//     a miss whose walk sets D: it requests that walk (nonspec) only while
//     it holds the oldest token, and the acceptance is its started pulse;
//     without the token or the acceptance its STA write parks the entry on
//     the token (dpark)
// Rationale:
//   - a line-crossing access runs as two passes, each translated and checked
//     on its own line; a crossing load runs only once it holds the oldest
//     token and keeps its lo dword in the lq split buffer
//   - Bare: PA = VA, and a VA above the PA width is a hole (access fault).
//     Sv39: a non-canonical VA is a page fault without a lookup; a hit is
//     checked by xlate_pkg::perm, so a page fault wins over PMP and PMA
//   - access fault (cause 5 load and LR, 7 store, AMO, SC and CBO) for a
//     hole, a PMP denial, a misaligned access to a region without
//     misaligned_ok, any misaligned atomic (before translation), an atomic
//     to a region without the needed AMO class, and a CBO to a region
//     without cbo_ok. The
//     privileged spec allows an access fault for a misaligned access the
//     region cannot perform. PMP: an AMO needs read and write, a CBO
//     management op read or write
pub module mem_pipe::<CFG: core_cfg> #(
    param PMA_N  : u32                         = 1,
    param PMA_TBL: pma_pkg::PmaRegion [PMA_N] = '{
        default: pma_pkg::PmaRegion'{base: 0, mask: 0, attr: 0 as pma_pkg::PmaAttr}
    },
) (
    clk: input clock,
    rst: input reset,

    i_kill: input core_types::<CFG>::Kill,

    i_iss: input core_types::<CFG>::IqGrant   ,
    i_re : input core_types::<CFG>::MemReissue,

    o_iq_rel: output core_types::<CFG>::IqRelease,

    i_tok    : input  core_types::<CFG>::TagTok,
    o_started: output logic                    ,

    o_rf_addr1: output core_types::<CFG>::PReg                             ,
    o_rf_addr2: output core_types::<CFG>::PReg                             ,
    i_rf_int1 : input  logic<64>                                           ,
    i_rf_int2 : input  logic<64>                                           ,
    i_rf_fp2  : input  logic<64>                                           ,
    i_wb      : input  core_types::<CFG>::WbPacket [core_types::<CFG>::WB_N],

    i_xl_on  : input logic                   ,
    i_ctx    : input xlate_pkg::XlateCtx     ,
    i_pmm    : input logic              <2>  ,
    i_pmpcfg : input logic              <64> [2] ,
    i_pmpaddr: input logic              <64> [16],

    o_tlb_lk    : output xlate_pkg::TlbLookup          ,
    i_tlb       : input  xlate_pkg::TlbEntry           ,
    o_xreq_valid: output logic                         ,
    o_xreq      : output core_types::<CFG>::XlateReq   ,
    i_xreq_gnt  : input  logic                         ,
    i_ptw_evt   : input  core_types::<CFG>::PtwEvent   ,

    o_req_valid: output logic                     ,
    o_req      : output core_types::<CFG>::MemReq ,
    i_resp     : input  core_types::<CFG>::MemResp,

    o_fwd_q : output core_types::<CFG>::FwdQuery,
    i_fwd_sq: input  core_types::<CFG>::FwdPart ,
    i_fwd_sb: input  core_types::<CFG>::FwdPart ,

    o_snap: output core_types::<CFG>::LqSnap  ,
    o_sta : output core_types::<CFG>::StaWrite,
    o_std : output core_types::<CFG>::StdWrite,

    i_split_lo: input  logic<64>                   ,
    o_verdict : output core_types::<CFG>::LqVerdict,
    o_wake    : output core_types::<CFG>::Wake     ,
    o_wb      : output core_types::<CFG>::WbPacket ,

    o_amo    : output core_types::<CFG>::AtomicOp                            ,
    i_np_wb  : input  core_types::<CFG>::WbPacket [core_types::<CFG>::HF_N]  ,
    i_np_wake: input  core_types::<CFG>::Wake     [core_types::<CFG>::HF_N]  ,
    i_np_hf  : input  logic                       [core_types::<CFG>::HF_N]  ,
    o_hf_req : output logic                                                  ,

    o_perf: output core_types::<CFG>::MemPipePerf,
) {
    import core_types::<CFG>::*;

    // ---- helpers ----

    // An event of the walk of page vpn (the pipe walks V = 0 only).
    function ev_hit (
        e  : input PtwEvent ,
        vpn: input logic<27>,
    ) -> logic {
        return e.valid && e.key.vpn == vpn && e.key.regime == xlate_pkg::Regime::V0;
    }

    // ---- Stage contents ----

    struct M0Op {
        tag  : ExTag           ,
        op   : MemOp           ,
        lq   : LqTag           ,
        sq   : SqTag           ,
        imm  : logic<32>       ,
        src1 : PReg            ,
        src2 : PReg            ,
        entry: logic<IQ_ENT_W> ,
        new_ : logic           , // from the IQ (operands from the PRF)
        va   : logic<64>       , // re-issue: the stored VA
        half : logic           ,
        xexc : exc_pkg::ExcRec , // re-issue: the fault of the pass's walk
        aop  : opclass_pkg::AmoUop,
        cas  : logic<10>       , // atomic: {rs2, rd} arch numbers
    }

    struct M1Op {
        tag  : ExTag     ,
        op   : MemOp     ,
        lq   : LqTag     ,
        sq   : SqTag     ,
        new_ : logic     ,
        half : logic     ,
        va   : logic<64> , // VA of the access
        pva  : logic<64> , // VA of this pass (the next line base for the hi pass)
        m16  : logic<16> , // access bytes in the 16-byte window at va[5:3]
        xline: logic     ,
        data : logic<128>, // store bytes in the same window
        xexc : exc_pkg::ExcRec,
        rs2  : logic<64> ,
        aop  : opclass_pkg::AmoUop,
        cas  : logic<10> ,
    }

    struct M2Op {
        tag  : ExTag           ,
        op   : MemOp           ,
        lq   : LqTag           ,
        sq   : SqTag           ,
        new_ : logic           ,
        half : logic           ,
        va   : logic       <64>,
        m16  : logic       <16>,
        xline: logic           ,
        data : logic       <128>,
        rs2  : logic       <64>,
        aop  : opclass_pkg::AmoUop,
        cas  : logic       <10>,
        pa   : pma_pkg::Pa     , // PA of this pass
        attr : pma_pkg::PmaAttr,
        exc  : exc_pkg::ExcRec ,
        xmiss: logic           , // DTLB miss or a D-bit update: no PA
        xnd  : logic           , // the D-bit update
        xgnt : logic           , // the miss's walk request was taken
        xseen: logic           , // an event of vpn came since the request
        vpn  : logic       <27>, // page of this pass
    }

    // m2 to R: what the verdict needs besides the response.
    struct PostOp {
        tag    : ExTag          ,
        op     : MemOp          ,
        lq     : LqTag          ,
        new_   : logic          ,
        half   : logic          ,
        xline  : logic          ,
        va     : logic     <64> ,
        bo     : logic     <3>  ,
        pmask  : logic     <16> , // bytes of this pass in its window
        exc    : exc_pkg::ExcRec,
        io     : logic          , // a non-cacheable load: parks for io_unit
        req    : logic          , // a MemReq was sent
        fwd_cov: logic     <16> ,
        fwd_dat: logic     <128>,
        fwd_w  : logic          ,
        wait_sq: SqTag          ,
        xmiss  : logic          ,
        xgnt   : logic          ,
        xseen  : logic          ,
        vpn    : logic     <27> ,
    }

    // ---- S -> m0 ----

    var s_v   : logic;
    var s_d   : M0Op ;
    always_comb {
        s_v        = i_iss.valid || i_re.valid;
        s_d.tag    = if i_re.valid ? i_re.tag : i_iss.tag;
        s_d.op     = if i_re.valid ? i_re.op : mem_op(i_iss.fu, i_iss.cold.uop);
        s_d.lq     = if i_re.valid ? i_re.lq : i_iss.cold.lq;
        s_d.sq     = if i_re.valid ? i_re.sq : i_iss.cold.sq;
        s_d.imm    = if i_iss.fu == opclass_pkg::FuKind::ATOMIC ? 32'd0 : i_iss.cold.imm;
        s_d.aop    = i_iss.cold.uop as opclass_pkg::AmoUop;
        s_d.cas    = i_iss.cold.imm[9:0];
        s_d.src1   = i_iss.src[0].pr;
        s_d.src2   = i_iss.src[1].pr;
        s_d.entry  = i_iss.entry;
        s_d.new_   = !i_re.valid;
        s_d.va     = i_re.va;
        s_d.half   = i_re.valid && i_re.half;
        s_d.xexc   = if i_re.valid ? i_re.xexc : 0 as exc_pkg::ExcRec;
    }

    var m0_v: logic;
    var m0  : M0Op ;
    inst u_m0: stage_reg::<CFG> #(
        T: M0Op,
    ) (
        clk                   ,
        rst                   ,
        i_valid: s_v          ,
        i_data : s_d          ,
        i_tag  : s_d.tag.rob  ,
        i_kill                ,
        o_valid: m0_v         ,
        o_data : m0           ,
    );

    // ---- m0: operands, address, pass shape ----

    assign o_iq_rel.valid = m0_v && m0.new_;
    assign o_iq_rel.entry = m0.entry;
    assign o_rf_addr1     = m0.src1;
    assign o_rf_addr2     = m0.src2;

    let rs1: logic<64> = bypass(m0.src1, i_rf_int1, i_wb);
    let rs2: logic<64> = bypass(m0.src2, if m0.src2.cls == RegClass::FP ? i_rf_fp2 : i_rf_int2, i_wb);

    // Pointer masking replaces the top PMLEN bits of a new pass's effective
    // address, so translation, the LQ/SQ address and the reservation all see
    // the masked address: sign-extended when translated, zero for a bare PA.
    let m0_ea  : logic<64> = rs1 + {m0.imm[31] repeat 32, m0.imm};
    let m0_ext : logic     = i_xl_on && (if i_pmm[0] ? m0_ea[47] : m0_ea[56]);
    let m0_pm  : logic<64> = case i_pmm {
        2'b10  : {m0_ext repeat 7, m0_ea[56:0]},
        2'b11  : {m0_ext repeat 16, m0_ea[47:0]},
        default: m0_ea,
    };
    let m0_va  : logic<64> = if m0.new_ ? m0_pm : m0.va;
    let m0_bo  : logic<3>  = m0_va[2:0];
    let m0_m16 : logic<16> = if m0.op.q ? 16'hffff : if m0.op.cmo || m0.op.zero ? 16'd0 : mem_size_mask(m0.op.size) << m0_bo;
    let m0_dw  : logic<3>  = m0_va[5:3];

    var m1_in: M1Op;
    always_comb {
        m1_in.tag   = m0.tag;
        m1_in.op    = m0.op;
        m1_in.lq    = m0.lq;
        m1_in.sq    = m0.sq;
        m1_in.new_  = m0.new_;
        m1_in.half  = m0.half;
        m1_in.va    = m0_va;
        m1_in.pva   = if m0.half ? {m0_va[63:6] + 58'd1, 6'd0} : m0_va;
        m1_in.m16   = m0_m16;
        m1_in.xline = m0_dw == 3'd7 && m0_m16[15:8] != 8'd0;
        m1_in.data  = {64'd0, rs2} << {m0_bo, 3'd0};
        m1_in.xexc  = m0.xexc;
        m1_in.rs2   = rs2;
        m1_in.aop   = m0.aop;
        m1_in.cas   = m0.cas;
    }

    var m1_v: logic;
    var m1  : M1Op ;
    inst u_m1: stage_reg::<CFG> #(
        T: M1Op,
    ) (
        clk                    ,
        rst                    ,
        i_valid: m0_v          ,
        i_data : m1_in         ,
        i_tag  : m0.tag.rob    ,
        i_kill                 ,
        o_valid: m1_v          ,
        o_data : m1            ,
    );

    // ---- m1: translation, PMP, PMA ----

    // An LR translates as a load; SC, AMO and amocas as AMO (W and D).
    let m1_acc   : xlate_pkg::AccKind = if m1.op.amo ?
        (if m1.op.st ? xlate_pkg::AccKind::AMO : xlate_pkg::AccKind::LOAD)
    : if m1.op.cmo ?
        xlate_pkg::AccKind::CBO
    : if m1.op.st ?
        xlate_pkg::AccKind::STORE
    :
        xlate_pkg::AccKind::LOAD
    ;
    let m1_misal : logic              = ({1'b0, m1.va[2:0]} & ((4'd1 << m1.op.size) - 4'd1)) != 4'd0 || (m1.op.q && m1.va[3]);
    let m1_amis  : logic              = m1.op.amo && m1_misal; // faults before translation
    let m1_vpn   : logic<27>          = m1.pva[38:12];
    let m1_noncan: logic              = i_xl_on && m1.pva[63:39] != {m1.pva[38] repeat 25};
    let m1_xf    : logic              = m1.xexc.valid; // the walk's answer replaces the lookup
    let m1_perm  : xlate_pkg::Perm    = xlate_pkg::perm(i_tlb, m1_acc, i_ctx);
    let m1_lk    : logic              = i_xl_on && !m1_noncan && !m1_xf && !m1_amis;
    let m1_nd    : logic              = m1_lk && i_tlb.hit && m1_perm.ok && m1_perm.need_d;
    let m1_miss  : logic              = m1_lk && (!i_tlb.hit || m1_nd);
    let m1_pf    : logic              = !m1_amis && (m1_noncan || (m1_lk && i_tlb.hit && !m1_perm.ok));
    let m1_tok   : logic              = i_tok.valid && i_tok.tag == m1.tag.rob;

    always_comb {
        o_tlb_lk.valid = m1_v && m1_lk;
        o_tlb_lk.vpn   = m1_vpn;
        o_tlb_lk.asid  = i_ctx.asid;
    }

    // A crossing load's first pass does not walk: it parks HEAD and walks
    // once it runs as the oldest op.
    let m1_head: logic = !m1.op.st && m1.xline && m1.new_;
    assign o_xreq_valid = m1_v && m1_miss && !m1_head && (!m1_nd || m1_tok);
    assign o_started    = o_xreq_valid && m1_nd && i_xreq_gnt;
    always_comb {
        o_xreq.valid       = 1'b1;
        o_xreq.tag.client  = if m1.op.st ? MemClient::SQ : MemClient::LQ;
        o_xreq.tag.id      = if m1.op.st ? {m1.sq.wrap, m1.sq.idx} as MEMID_W : {m1.lq.wrap, m1.lq.idx} as MEMID_W;
        o_xreq.tag.rob_v   = 1'b1;
        o_xreq.tag.rob     = m1.tag.rob;
        o_xreq.va          = m1.pva;
        o_xreq.acc         = m1_acc;
        o_xreq.hlv         = 1'b0;
        o_xreq.hlvx        = 1'b0;
        o_xreq.nonspec     = m1_nd;
    }

    let m1_pa   : pma_pkg::Pa      = if i_xl_on ? xlate_pkg::entry_pa(i_tlb, m1.pva) : m1.pva[55:0];
    let m1_hole : logic            = !i_xl_on && m1.pva[63:56] != 8'd0;
    let m1_attr : pma_pkg::PmaAttr = xlate_pkg::pbmt_attr(pma_check::<PMA_N>(m1_pa, PMA_TBL), if i_xl_on ? i_tlb.pbmt : 2'd0);

    var m1_pmp_r: logic;
    var m1_pmp_w: logic;
    inst u_pmp_r: pmp_check (
        i_addr   : {8'd0, m1_pa}  ,
        i_acc    : 2'd0           ,
        i_priv   : i_ctx.prv      ,
        i_pmpcfg                  ,
        i_pmpaddr                 ,
        o_fault  : m1_pmp_r       ,
    );
    inst u_pmp_w: pmp_check (
        i_addr   : {8'd0, m1_pa}  ,
        i_acc    : 2'd1           ,
        i_priv   : i_ctx.prv      ,
        i_pmpcfg                  ,
        i_pmpaddr                 ,
        o_fault  : m1_pmp_w       ,
    );
    let m1_pmp_fault: logic = if m1.op.cmo ? m1_pmp_r && m1_pmp_w : if m1.op.rmw ? m1_pmp_r || m1_pmp_w : if m1.op.st ? m1_pmp_w : m1_pmp_r;
    // The access the region must support beyond being backed.
    let m1_pma_fault: logic = if m1.op.amo ?
        (m1_misal || !m1_attr.cacheable || m1_attr.amo == pma_pkg::AmoClass::NONE
        || (m1.op.rmw && m1_attr.amo != pma_pkg::AmoClass::FULL))
    : if m1.op.cmo || m1.op.zero ?
        !m1_attr.cbo_ok
    :
        m1_misal && !m1_attr.misaligned_ok
    ;

    let m1_af: logic = m1_hole || !m1_attr.backed || m1_pmp_fault || m1_pma_fault;

    var m2_in: M2Op;
    always_comb {
        m2_in.tag       = m1.tag;
        m2_in.op        = m1.op;
        m2_in.lq        = m1.lq;
        m2_in.sq        = m1.sq;
        m2_in.new_      = m1.new_;
        m2_in.half      = m1.half;
        m2_in.va        = m1.va;
        m2_in.m16       = m1.m16;
        m2_in.xline     = m1.xline;
        m2_in.data      = m1.data;
        m2_in.rs2       = m1.rs2;
        m2_in.aop       = m1.aop;
        m2_in.cas       = m1.cas;
        m2_in.pa        = m1_pa;
        m2_in.attr      = m1_attr;
        m2_in.xmiss     = m1_miss;
        m2_in.xnd       = m1_nd;
        m2_in.xgnt      = o_xreq_valid && i_xreq_gnt;
        m2_in.xseen     = ev_hit(i_ptw_evt, m1_vpn);
        m2_in.vpn       = m1_vpn;
        m2_in.exc.valid = m1_amis || m1_xf || m1_pf || (!m1_miss && m1_af);
        m2_in.exc.cause = if m1.op.st ? 6'd7 : 6'd5;
        m2_in.exc.tval  = m1.pva;
        m2_in.exc.gpa   = 54'd0;
        m2_in.exc.gva   = 1'b0;
        if m1_xf {
            m2_in.exc = m1.xexc;
        } else if m1_pf {
            m2_in.exc.cause = xlate_pkg::pf_cause(m1_acc);
        }
    }

    var m2_v: logic;
    var m2  : M2Op ;
    inst u_m2: stage_reg::<CFG> #(
        T: M2Op,
    ) (
        clk                    ,
        rst                    ,
        i_valid: m1_v          ,
        i_data : m2_in         ,
        i_tag  : m1.tag.rob    ,
        i_kill                 ,
        o_valid: m2_v          ,
        o_data : m2            ,
    );

    // ---- m2: request, forward query, snapshot, STA/STD ----

    let m2_live : logic     = m2_v && !killed(i_kill, m2.tag.rob);
    let m2_dw   : logic<3>  = if m2.half ? 3'd0 : m2.va[5:3];
    let m2_pmask: logic<16> = if m2.half ? {8'd0, m2.m16[15:8]} : if m2.xline ? {8'd0, m2.m16[7:0]} : m2.m16;
    let m2_load : logic     = m2_v && !m2.op.st && !m2.op.amo;
    let m2_xseen: logic     = m2.xseen || ev_hit(i_ptw_evt, m2.vpn);
    let m2_io   : logic     = m2_load && !m2.exc.valid && !m2.xmiss && !m2.attr.cacheable;
    // A crossing load runs its passes only as re-issues, which lq grants once it is oldest.
    let m2_go: logic = m2_load && !m2.exc.valid && !m2.xmiss && !m2_io && !(m2.xline && m2.new_);

    always_comb {
        o_req_valid           = m2_go;
        o_req.tag.client = MemClient::LQ;
        o_req.tag.id     = {m2.lq.wrap, m2.lq.idx} as MEMID_W;
        o_req.tag.rob_v  = 1'b1;
        o_req.tag.rob    = m2.tag.rob;
        o_req.cls        = MemCls::LOAD;
        o_req.pa         = {m2.pa[55:6], m2_dw, 3'd0};
        o_req.mask       = m2_pmask;
        o_req.wdata      = '0;
        o_req.attr       = '0;

        o_fwd_q.valid  = m2_go;
        o_fwd_q.line   = m2.pa[55:6];
        o_fwd_q.dw     = m2_dw;
        o_fwd_q.mask   = m2_pmask;
        o_fwd_q.sq_lim = m2.sq;

        o_snap.valid  = (m2_go || m2_io) && m2_live;
        o_snap.lq     = m2.lq;
        o_snap.half   = m2.half;
        o_snap.line   = m2.pa[55:6];
        o_snap.dw     = m2_dw;
        o_snap.mask   = m2_pmask;
        o_snap.io     = m2_io;
        o_snap.io_ord = m2.attr.io_ordered;
        o_snap.dram   = m2.attr.target == pma_pkg::Target::DRAM;

        o_sta.valid  = m2_live && m2.op.st;
        o_sta.sq     = m2.sq;
        o_sta.lq_lim = m2.lq;
        o_sta.half   = m2.half;
        o_sta.va     = m2.va;
        o_sta.line   = m2.pa[55:6];
        o_sta.dw     = m2_dw;
        o_sta.mask   = if m2.half ? {8'd0, m2.m16[15:8]} : m2.m16;
        o_sta.full   = m2.op.zero;
        o_sta.attr   = m2.attr;
        o_sta.exc    = m2.exc;
        o_sta.xmiss  = m2.xmiss;
        o_sta.xpark  = m2.xmiss && m2.xgnt && !m2.xseen;
        o_sta.dpark  = m2.xnd && !m2.xgnt;

        // Only the first pass reads rs2; re-issued passes carry no data. An
        // atomic's SQ entry never supplies data.
        o_std.valid = m2_live && m2.op.st && !m2.op.amo && !m2.half && m2.new_;
        o_std.sq    = m2.sq;
        o_std.data  = m2.data;
    }

    // The two forward sources combined by age: SQ entries are younger than
    // every store-buffer line.
    let fw_cov: logic<16>  = i_fwd_sq.cov | i_fwd_sb.cov;
    var fw_dat: logic<128>;
    always_comb {
        for b in 0..16 {
            fw_dat[b * 8+:8] = if i_fwd_sq.cov[b] ? i_fwd_sq.data[b * 8+:8] : i_fwd_sb.data[b * 8+:8];
        }
    }

    var post_in: PostOp;
    always_comb {
        post_in.tag     = m2.tag;
        post_in.op      = m2.op;
        post_in.lq      = m2.lq;
        post_in.new_    = m2.new_;
        post_in.half    = m2.half;
        post_in.xline   = m2.xline;
        post_in.va      = m2.va;
        post_in.bo      = m2.va[2:0];
        post_in.pmask   = m2_pmask;
        post_in.exc     = m2.exc;
        post_in.io      = m2_io;
        post_in.req     = m2_go;
        post_in.fwd_cov = if m2_go ? fw_cov & m2_pmask : 16'd0;
        post_in.fwd_dat = fw_dat;
        post_in.fwd_w   = m2_go && i_fwd_sq.wt;
        post_in.wait_sq = i_fwd_sq.wait_sq;
        post_in.xmiss   = m2.xmiss;
        post_in.xgnt    = m2.xgnt;
        post_in.xseen   = m2_xseen;
        post_in.vpn     = m2.vpn;
    }

    // An atomic without exception leaves for atomic_unit: its first pass
    // with the operands (and the PA unless it missed the DTLB), a re-issued
    // pass with the PA only.
    always_comb {
        o_amo.valid    = m2_live && m2.op.amo && !m2.exc.valid && (m2.new_ || !m2.xmiss);
        o_amo.first    = m2.new_;
        o_amo.xmiss    = m2.xmiss;
        o_amo.tag      = m2.tag;
        o_amo.amo      = m2.aop;
        o_amo.pa       = m2.pa;
        o_amo.rs2      = m2.rs2;
        o_amo.rd_arch  = m2.cas[4:0];
        o_amo.rs2_arch = m2.cas[9:5];
    }

    // ---- m2 -> R: RESP_LAT stages ----

    var dl_v: logic  [fu_pkg::RESP_LAT + 1];
    var dl_d: PostOp [fu_pkg::RESP_LAT + 1];
    assign dl_v[0] = m2_v;
    assign dl_d[0] = post_in;
    for k in 0..fu_pkg::RESP_LAT :g_dl {
        var dl_in: PostOp;
        always_comb {
            dl_in = dl_d[k];
            if k != 0 {
                dl_in.xseen = dl_d[k].xseen || ev_hit(i_ptw_evt, dl_d[k].vpn);
            }
        }
        inst u_dl: stage_reg::<CFG> #(
            T: PostOp,
        ) (
            clk                           ,
            rst                           ,
            i_valid: dl_v[k]              ,
            i_data : dl_in                ,
            i_tag  : dl_d[k].tag.rob      ,
            i_kill                        ,
            o_valid: dl_v[k + 1]          ,
            o_data : dl_d[k + 1]          ,
        );
    }

    // ---- R: verdict, wake, packet ----

    let r_v  : logic  = dl_v[fu_pkg::RESP_LAT] && !killed(i_kill, dl_d[fu_pkg::RESP_LAT].tag.rob);
    let r    : PostOp = dl_d[fu_pkg::RESP_LAT];
    let r_st : logic  = r.op.st;

    var r_win: logic<128>;
    always_comb {
        for b in 0..16 {
            r_win[b * 8+:8] = if r.fwd_cov[b] ? r.fwd_dat[b * 8+:8] : i_resp.data[b * 8+:8];
        }
    }
    let r_full : logic = r.req && r.fwd_cov == r.pmask;
    let r_rsp  : logic = r.req && i_resp.valid;
    let r_hit  : logic = r_rsp && i_resp.kind == RespKind::HIT;
    let r_exc  : logic = r.exc.valid;
    let r_amo  : logic = r.op.amo;
    let r_head : logic = !r_exc && !r_amo && (r.io || (r.xline && r.new_));
    let r_x    : logic = !r_exc && !r_head && r.xmiss;
    let r_wait : logic = !r_exc && !r_head && !r_x && r.fwd_w;
    let r_value: logic = !r_exc && !r_amo && !r_head && !r_wait && (r_full || r_hit);
    let r_lo   : logic = r_value && r.xline && !r.half;
    let r_done : logic = r_exc || (r_amo && !r.xmiss) || (r_value && !r_lo);

    let r_ldval: logic<64> = mem_fmt_load(if r.xline ? {r_win[63:0], i_split_lo} : r_win, r.bo, r.op);

    always_comb {
        o_verdict.valid    = r_v && !r_st;
        o_verdict.lq       = r.lq;
        o_verdict.split_lo = r_lo;
        o_verdict.lo_data  = r_win[63:0];
        o_verdict.why      = ParkWhy::FILL;
        o_verdict.fill_id  = i_resp.fill_id;
        o_verdict.sq_key   = r.wait_sq;
        o_verdict.va       = r.va;
        if r_done {
            o_verdict.state = LqState::DONE;
        } else if r_head {
            o_verdict.state = LqState::PARK;
            o_verdict.why   = ParkWhy::HEAD;
        } else if r_x {
            o_verdict.state = if r.xgnt && !r.xseen ? LqState::PARK : LqState::READY;
            o_verdict.why   = ParkWhy::XLATE;
        } else if r_wait {
            o_verdict.state = LqState::PARK;
            o_verdict.why   = ParkWhy::SQ;
        } else if r_lo {
            o_verdict.state = LqState::READY;
        } else if r_rsp && i_resp.kind == RespKind::MISS {
            o_verdict.state = LqState::PARK;
        } else if r_rsp && i_resp.kind == RespKind::RETRY && i_resp.reason == RetryReason::FILL_BUSY {
            o_verdict.state = LqState::PARK;
            o_verdict.why   = ParkWhy::BUSY;
        } else {
            o_verdict.state = LqState::READY;
        }
    }

    var np_wake: Wake;
    var np_wb  : WbPacket;
    always_comb {
        var hf: logic<HF_N>;
        np_wake = 0 as Wake;
        np_wb   = 0 as WbPacket;
        for k in 0..HF_N {
            np_wake = (np_wake | (if i_np_wake[k].valid ? i_np_wake[k] : 0 as Wake)) as Wake;
            np_wb   = (np_wb | (if i_np_wb[k].valid ? i_np_wb[k] : 0 as WbPacket)) as WbPacket;
            hf[k]   = i_np_hf[k];
        }
        o_hf_req = hf != '0;
    }

    let own_wake: logic = r_v && !r_st && !r_amo && r_done && !r_exc && r.tag.has_rd;
    assign o_wake.valid = own_wake || np_wake.valid;
    assign o_wake.pdst  = if own_wake ? r.tag.pdst : np_wake.pdst;

    // A store completes on its last pass; the lo pass of a crossing store
    // leaves the hi pass to the sq. An atomic completes here only with an
    // exception (atomic_unit writes it back otherwise).
    let r_pkt: logic = if r_amo ? r_exc : if r_st ? (r_exc || (!r.xmiss && !(r.xline && !r.half))) : r_done;

    var pkt_in: WbPacket;
    always_comb {
        pkt_in.valid  = 1'b1;
        pkt_in.tag    = r.tag;
        pkt_in.data   = if r_exc ? 64'd0 : r_ldval;
        pkt_in.exc    = r.exc;
        pkt_in.fflags = 5'd0;
        pkt_in.br     = '0;
        pkt_in.pair   = 1'b0;
    }

    var pkt_v: logic   ;
    var pkt  : WbPacket;
    inst u_wb: stage_reg::<CFG> #(
        T: WbPacket,
    ) (
        clk                          ,
        rst                          ,
        i_valid: dl_v[fu_pkg::RESP_LAT] && r_pkt,
        i_data : pkt_in              ,
        i_tag  : r.tag.rob           ,
        i_kill                       ,
        o_valid: pkt_v               ,
        o_data : pkt                 ,
    );
    always_comb {
        o_wb       = if pkt_v ? pkt : np_wb;
        o_wb.valid = pkt_v || np_wb.valid;
    }

    always_comb {
        o_perf.issue    = m0_v && m0.new_;
        o_perf.reissue  = m0_v && !m0.new_;
        o_perf.fwd_full = r_v && !r_st && r.req && r_full;
        o_perf.fwd_part = r_v && !r_st && r.req && !r_full && r.fwd_cov != 16'd0;
        o_perf.fwd_wait = r_v && r_wait;
        o_perf.split    = m2_v && m2.xline;
        o_perf.xmiss    = m1_v && m1_miss && !m1_nd;
        o_perf.dbit     = m1_v && m1_nd;
        o_perf.dwalk    = o_started;
        o_perf.fault    = r_v && r_exc;
        o_perf.hit      = r_v && r_hit;
        o_perf.miss     = r_v && r_rsp && i_resp.kind == RespKind::MISS;
        o_perf.retry    = r_v && r_rsp && i_resp.kind == RespKind::RETRY;
    }
}
