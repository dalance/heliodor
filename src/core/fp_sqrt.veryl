// IEEE 754 double-precision floating-point square root
// Iterative digit-by-digit sqrt, radix-4 (two result bits per RUN cycle), so
// the combinational path is two chained 64-bit compare/subtracts instead of the
// former 56-deep unrolled chain. Bit-exact with the original digit-recurrence.
// Latency: 1 (capture + normalize) + 28 (RUN, two iters each) + 1 (DONE) = 30.
pub module fp_sqrt (
    clk: input clock,
    rst: input reset,

    i_valid: input logic    ,
    i_a    : input logic<64>,
    i_rm   : input logic<3> ,
    i_flush: input logic    ,

    o_result: output logic<64>,
    o_fflags: output logic<5> ,
    o_valid : output logic    ,
    o_busy  : output logic    ,
) {
    enum State: logic<2> {
        IDLE = 2'd0,
        RUN = 2'd1,
        DONE = 2'd2,
    }

    var state    : State   ;
    var count    : logic<6>;
    var latched_m: logic<3>;

    // Operand-derived state captured at IDLE and held stable through RUN/DONE.
    var reg_r_exp         : logic<13>;
    var reg_is_special    : logic    ;
    var reg_special_result: logic<64>;
    var reg_special_fflags: logic<5> ;

    // Iteration state, advanced two digits per RUN cycle.
    var it_q  : logic<56>; // running result digits
    var it_rem: logic<64>; // running remainder
    var it_rad: logic<56>; // radicand shift register (2 bits consumed per step)

    assign o_busy = state != State::IDLE;

    // 28 RUN cycles (two digits each = 56) then DONE — 30 total.
    const RUN_LAST: logic<6> = 6'd27;

    // ====================================================================
    // Setup: unpack/classify the live operand, normalize, and form the
    // radicand + result exponent. Combinational off i_a; sampled into the
    // reg_*/it_* registers when IDLE accepts a job.
    // ====================================================================
    var su_is_special    : logic    ;
    var su_special_result: logic<64>;
    var su_special_fflags: logic<5> ;
    var su_r_exp         : logic<13>;
    var su_radicand      : logic<56>;

    always_comb {
        var sa: logic    ;
        var ea: logic<11>;
        var ma: logic<52>;

        sa = i_a[63];
        ea = i_a[62:52];
        ma = i_a[51:0];

        var a_is_zero: logic;
        var a_is_inf : logic;
        var a_is_nan : logic;
        var a_is_snan: logic;
        var a_is_sub : logic;

        a_is_zero = ea == 11'd0 && ma == 52'd0;
        a_is_inf  = ea == 11'h7FF && ma == 52'd0;
        a_is_nan  = ea == 11'h7FF && ma != 52'd0;
        a_is_snan = a_is_nan && ma[51] == 1'b0;
        a_is_sub  = ea == 11'd0 && ma != 52'd0;

        su_is_special     = 1'b0;
        su_special_result = 64'd0;
        su_special_fflags = 5'd0;
        su_r_exp          = 13'd0;
        su_radicand       = 56'd0;

        if a_is_nan {
            su_is_special     = 1'b1;
            su_special_result = 64'h7FF8_0000_0000_0000;
            if a_is_snan {
                su_special_fflags = 5'b10000;
            }
        } else if sa && !a_is_zero {
            // sqrt(negative) = NaN
            su_is_special     = 1'b1;
            su_special_result = 64'h7FF8_0000_0000_0000;
            su_special_fflags = 5'b10000;
        } else if a_is_inf {
            su_is_special     = 1'b1;
            su_special_result = {1'b0, 11'h7FF, 52'd0};
        } else if a_is_zero {
            su_is_special     = 1'b1;
            su_special_result = {sa, 63'd0};
        } else {
            // Normal/subnormal positive value
            var ea_eff: logic<13>;
            if a_is_sub {
                ea_eff = 13'd1;
            } else {
                ea_eff = {2'd0, ea};
            }

            var sig_a: logic<53>;
            if a_is_sub {
                sig_a = {1'b0, ma};
            } else {
                sig_a = {1'b1, ma};
            }

            // Normalize subnormals
            if a_is_sub {
                var lz: logic<6>;
                lz = 6'd53;
                for i in 0..53 {
                    if sig_a[52 - i] == 1'b1 && lz == 6'd53 {
                        lz = i[5:0];
                    }
                }
                sig_a  = sig_a << lz;
                ea_eff = ea_eff - {7'd0, lz};
            }

            // Unbiased exponent
            var unbiased: logic<13>;
            unbiased = ea_eff - 13'd1023;

            // If exponent is odd, multiply significand by 2
            // so we always compute sqrt of a value in [1, 4)
            // Radicand setup for digit-by-digit sqrt algorithm.
            // 112-bit radicand = radicand_hi(56) : radicand_lo(56=zeros)
            // Binary point at bit 110 of the 112-bit value.
            // Even exponent: radicand = sig_a (value in [1,2))
            //   → sig_a[52] maps to bit 110: radicand_hi = {1'b0, sig_a, 2'b00}
            // Odd exponent: radicand = sig_a * 2 (value in [2,4))
            //   → sig_a[52] maps to bit 111: radicand_hi = {sig_a, 3'b000}
            var radicand_hi: logic<56>;
            if unbiased[0] {
                radicand_hi = {sig_a, 3'b000};
            } else {
                radicand_hi = {1'b0, sig_a, 2'b00};
            }
            // Lower 56 bits are all zeros (extended precision)
            su_radicand = radicand_hi;

            // Result exponent
            var r_exp: logic<13>;
            if unbiased[12] {
                // Negative unbiased
                var neg_ub: logic<13>;
                neg_ub = ~unbiased + 13'd1;
                if unbiased[0] {
                    r_exp = 13'd1023 - (neg_ub + 13'd1) / 13'd2;
                } else {
                    r_exp = 13'd1023 - neg_ub / 13'd2;
                }
            } else {
                if unbiased[0] {
                    r_exp = (unbiased - 13'd1) / 13'd2 + 13'd1023;
                } else {
                    r_exp = unbiased / 13'd2 + 13'd1023;
                }
            }
            su_r_exp = r_exp;
        }
    }

    // ====================================================================
    // Two digit-by-digit iterations per RUN cycle (radix-4). Each step takes
    // the next 2 radicand bits, trial-subtracts (q<<2)|1, and shifts one
    // result bit into q (the radicand register is consumed top-first).
    // ====================================================================
    var nxt_q  : logic<56>;
    var nxt_rem: logic<64>;
    var nxt_rad: logic<56>;

    always_comb {
        // step 1
        var rem_sh1: logic<64>;
        var trial1 : logic<64>;
        var ge1    : logic    ;
        var q1     : logic<56>;
        var rem1   : logic<64>;
        var rad1   : logic<56>;
        rem_sh1 = {it_rem[61:0], it_rad[55:54]};
        trial1  = {6'd0, it_q, 2'b01};
        ge1     = rem_sh1 >= trial1;
        rem1    = if ge1 ? rem_sh1 - trial1 : rem_sh1;
        q1      = {it_q[54:0], ge1};
        rad1    = {it_rad[53:0], 2'b00};
        // step 2
        var rem_sh2: logic<64>;
        var trial2 : logic<64>;
        var ge2    : logic    ;
        rem_sh2 = {rem1[61:0], rad1[55:54]};
        trial2  = {6'd0, q1, 2'b01};
        ge2     = rem_sh2 >= trial2;
        nxt_rem = if ge2 ? rem_sh2 - trial2 : rem_sh2;
        nxt_q   = {q1[54:0], ge2};
        nxt_rad = {rad1[53:0], 2'b00};
    }

    // ====================================================================
    // Finalize: assemble the rounded result from the final result digits /
    // remainder. Combinational off the iteration/setup registers; sampled
    // into o_result in DONE.
    // ====================================================================
    var fin_result: logic<64>;
    var fin_fflags: logic<5> ;

    always_comb {
        fin_result = 64'd0;
        fin_fflags = 5'd0;

        if reg_is_special {
            fin_result = reg_special_result;
            fin_fflags = reg_special_fflags;
        } else {
            var q    : logic<56>;
            var rem  : logic<64>;
            var r_exp: logic<13>;
            q     = it_q;
            rem   = it_rem;
            r_exp = reg_r_exp;

            // q now has 56 bits of sqrt result
            // q[55] should be 1 for normalized result
            var sq_mant: logic<56>;
            if q[55] {
                sq_mant = q;
            } else {
                sq_mant = {q[54:0], 1'b0};
                r_exp   = r_exp - 13'd1;
            }

            // Sticky from remainder
            var sticky_rem: logic;
            sticky_rem = rem != 64'd0;
            sq_mant    = {sq_mant[55:1], sq_mant[0] | sticky_rem};

            // Check subnormal
            if r_exp <= 13'd0 {
                var sub_shift: logic<13>;
                sub_shift = 13'd1 - r_exp;
                var sub_sc   : logic<6>;
                if sub_shift >: 13'd56 {
                    sub_sc = 6'd56;
                } else {
                    sub_sc = sub_shift[5:0];
                }
                var sub_sticky: logic;
                sub_sticky = (sq_mant & ((56'd1 << sub_sc) - 56'd1)) != 56'd0;
                sq_mant    = sq_mant >> sub_sc;
                sq_mant    = {sq_mant[55:1], sq_mant[0] | sub_sticky};
                r_exp      = 13'd0;
            }

            // Rounding
            var g       : logic;
            var r       : logic;
            var s       : logic;
            var bit_lsb : logic;
            g        = sq_mant[2];
            r        = sq_mant[1];
            s        = sq_mant[0];
            bit_lsb  = sq_mant[3];
            var round_up: logic;
            case latched_m {
                3'b000 : round_up = g && (r || s || bit_lsb);
                3'b001 : round_up = 1'b0;
                3'b010 : round_up = 1'b0;
                3'b011 : round_up = g || r || s;
                3'b100 : round_up = g;
                default: round_up = g && (r || s || bit_lsb);
            }
            // 54-bit so a round-up overflowing the 53-bit significand bumps the
            // exponent (the old 53-bit add dropped that carry — cf. fp_sqrt_s).
            var rounded: logic<54>;
            rounded = {1'b0, sq_mant[55:3]} + {53'd0, round_up};
            if rounded[53] {
                r_exp = r_exp + 13'd1;
            }
            var nx: logic;
            nx = g || r || s;

            if r_exp >= 13'd2047 {
                fin_result = {1'b0, 11'h7FF, 52'd0};
                fin_fflags = 5'b00101;
            } else {
                fin_result = {1'b0, r_exp[10:0], rounded[51:0]};
                if nx {
                    fin_fflags = 5'b00001;
                }
                if r_exp == 13'd0 && nx {
                    fin_fflags = 5'b00011;
                }
            }
        }
    }

    // ====================================================================
    // FSM: capture + normalize (IDLE), two sqrt iterations per RUN cycle,
    // present the result (DONE).
    // ====================================================================
    always_ff (clk, rst) {
        if_reset {
            state              = State::IDLE;
            count              = '0;
            latched_m          = '0;
            reg_r_exp          = '0;
            reg_is_special     = '0;
            reg_special_result = '0;
            reg_special_fflags = '0;
            it_q               = '0;
            it_rem             = '0;
            it_rad             = '0;
            o_result           = '0;
            o_fflags           = '0;
            o_valid            = 1'b0;
        } else if i_flush {
            state   = State::IDLE;
            count   = '0;
            o_valid = 1'b0;
        } else {
            o_valid = 1'b0;

            case state {
                State::IDLE: {
                    if i_valid {
                        latched_m          = i_rm;
                        reg_r_exp          = su_r_exp;
                        reg_is_special     = su_is_special;
                        reg_special_result = su_special_result;
                        reg_special_fflags = su_special_fflags;
                        it_q               = '0;
                        it_rem             = '0;
                        it_rad             = su_radicand;
                        count              = '0;
                        state              = State::RUN;
                    }
                }
                State::RUN: {
                    it_q   = nxt_q;
                    it_rem = nxt_rem;
                    it_rad = nxt_rad;
                    if count == RUN_LAST {
                        state = State::DONE;
                    } else {
                        count = count + 6'd1;
                    }
                }
                State::DONE: {
                    o_result = fin_result;
                    o_fflags = fin_fflags;
                    o_valid  = 1'b1;
                    state    = State::IDLE;
                }
                default: {
                    state = State::IDLE;
                }
            }
        }
    }
}
