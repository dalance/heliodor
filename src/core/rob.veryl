// Reorder Buffer: 32-entry circular buffer for in-order commit.
// Supports allocate (tail), complete (by index), commit (head), flush.
// Same-cycle complete+commit bypass: when the completing entry is the head,
// commit output is available immediately (no 1-cycle delay).
//
// Head/tail are 7-bit pointers: [6:5] = wrap counter (epoch), [4:0] = array index.
// 2-bit wrap counter prevents aliasing for up to 128 allocations (4 full wraps).
// Full/empty: head == tail means empty, head[4:0] == tail[4:0] && head[6:5] != tail[6:5] means full.
pub module rob (
    clk: input clock,
    rst: input reset,

    // Allocate: add entry at tail (called at ID stage)
    i_alloc_valid : input  logic    ,
    i_alloc_pc    : input  logic<64>,
    i_alloc_rd    : input  logic<5> ,
    i_alloc_wen   : input  logic    , // instruction writes integer register
    i_alloc_is_fp : input  logic    , // FP instruction
    i_alloc_fp_wen: input  logic    , // instruction writes FP register
    i_alloc_compr : input  logic    , // compressed instruction
    o_alloc_idx   : output logic<5> , // allocated ROB index (tail[4:0])
    o_alloc_epoch : output logic<2> , // allocation epoch (tail[6:5])
    o_alloc_ready : output logic    , // ROB has space (not full)

    // Complete: mark entry as done, write result (called at WB or MSHR)
    i_complete_valid: input logic    ,
    i_complete_idx  : input logic<5> ,
    i_complete_epoch: input logic<2> , // epoch of completing instruction
    i_complete_data : input logic<64>,

    // Complete port 2: secondary completion (e.g., slot1 EX result from dual-issue)
    i_complete2_valid: input logic    ,
    i_complete2_idx  : input logic<5> ,
    i_complete2_epoch: input logic<2> ,
    i_complete2_data : input logic<64>,

    // Complete port 3: LQ retire (load queue head retirement).
    // Fires same cycle as normal WB path for a plain load — idempotent
    // dual completion (data matches wb_data). Groundwork for LQ-4 OoO
    // load issue where MEM/WB path is decoupled from load completion.
    i_complete3_valid: input logic    ,
    i_complete3_idx  : input logic<5> ,
    i_complete3_epoch: input logic<2> ,
    i_complete3_data : input logic<64>,

    // Complete port 4: async divider completion (D2 non-blocking DIV).
    // Dedicated port avoids mshr_wb_conflict with the normal WB path,
    // so the pipeline doesn't stall when the divider finishes while MEM
    // is firing WB for an unrelated earlier instruction.
    i_complete4_valid: input logic    ,
    i_complete4_idx  : input logic<5> ,
    i_complete4_epoch: input logic<2> ,
    i_complete4_data : input logic<64>,

    // Exception: mark entry as faulting (called at EX/MEM stage)
    i_exc_valid: input logic    ,
    i_exc_idx  : input logic<5> ,
    i_exc_cause: input logic<64>,

    // Suppress register write (for MSHR-absorbed loads)
    i_suppress_wen_valid: input logic    ,
    i_suppress_wen_idx  : input logic<5> ,

    // Cancel entry: mark as completed with wen=0 (for flushed RS-eligible instructions)
    i_cancel_valid: input logic    ,
    i_cancel_idx  : input logic<5> ,

    // Commit: retire head entry (in-order)
    o_commit_valid : output logic    ,
    o_commit_pc    : output logic<64>,
    o_commit_rd    : output logic<5> ,
    o_commit_data  : output logic<64>,
    o_commit_wen   : output logic    ,
    o_commit_is_fp : output logic    ,
    o_commit_fp_wen: output logic    ,
    o_commit_compr : output logic    ,
    o_commit_exc   : output logic    , // head has exception
    o_commit_cause : output logic<64>,
    o_commit_epoch : output logic<2> , // epoch of committing entry
    i_commit_ack   : input  logic    , // pipeline acknowledges commit

    // Flush: invalidate all entries (on trap/mret/sret)
    i_flush: input logic,

    // Squash: invalidate entries AFTER the given index (on branch misprediction).
    // i_squash_idx is a 7-bit pointer (same format as head/tail).
    i_squash_valid: input logic    ,
    i_squash_idx  : input logic<7> ,

    // Lookup: check if entry is completed (combinational, for RAT stall)
    i_lookup1_idx      : input  logic<5> ,
    o_lookup1_completed: output logic    ,
    o_lookup1_valid    : output logic    ,
    i_lookup2_idx      : input  logic<5> ,
    o_lookup2_completed: output logic    ,
    o_lookup2_valid    : output logic    ,

    // Data read ports (for RS operand resolution at dispatch)
    i_read1_idx      : input  logic<5> ,
    o_read1_data     : output logic<64>,
    o_read1_completed: output logic    ,
    o_read1_valid    : output logic    ,
    o_read1_epoch    : output logic<2> , // wrap_cnt of read1 entry
    i_read2_idx      : input  logic<5> ,
    o_read2_data     : output logic<64>,
    o_read2_completed: output logic    ,
    o_read2_valid    : output logic    ,
    o_read2_epoch    : output logic<2> , // wrap_cnt of read2 entry

    // Data read ports 3/4 (for FP RS operand resolution at dispatch)
    i_read3_idx      : input  logic<5> ,
    o_read3_data     : output logic<64>,
    o_read3_completed: output logic    ,
    o_read3_valid    : output logic    ,
    o_read3_epoch    : output logic<2> ,
    i_read4_idx      : input  logic<5> ,
    o_read4_data     : output logic<64>,
    o_read4_completed: output logic    ,
    o_read4_valid    : output logic    ,
    o_read4_epoch    : output logic<2> ,
    // Data read port 5 (FP RS rs3 for FMADD family)
    i_read5_idx      : input  logic<5> ,
    o_read5_data     : output logic<64>,
    o_read5_completed: output logic    ,
    o_read5_valid    : output logic    ,
    o_read5_epoch    : output logic<2> ,

    // Squash mask output (for RS cleanup — indexed by 5-bit ROB index)
    o_squash_mask: output logic [32],

    // Status
    o_empty      : output logic,
    o_full       : output logic,
    o_commit_idx : output logic<5>, // ROB index of committed entry (= head[4:0])
) {
    // Entry storage (32 entries)
    var valid    : logic     [32];
    var completed: logic     [32];
    var exception: logic     [32];
    var pc       : logic<64> [32];
    var rd_addr  : logic<5>  [32];
    var rd_data  : logic<64> [32];
    var reg_wen  : logic     [32];
    var is_fp    : logic     [32];
    var fp_wen   : logic     [32];
    var compr    : logic     [32];
    var cause    : logic<64> [32];
    var wrap_cnt : logic<2>  [32]; // wrap counter at allocation time (= tail[6:5])

    // Head and tail pointers (7-bit: [6:5] = wrap counter, [4:0] = index)
    var head: logic<7>;
    var tail: logic<7>;

    // Count: number of valid entries (0..32).
    var count: logic<6>; // 0..32

    // Squash mask: entry i should be squashed iff its current 7-bit
    // pointer ({wrap_cnt[i], i}) is in the half-open range [squash_idx,
    // tail). squash_idx is INCLUSIVE — both call sites set it to the
    // first entry to squash:
    //   - misprediction: squash_idx = BNE + 1 (first speculative)
    //   - p34_replay   : squash_idx = LOAD's idx (re-issue from LOAD)
    // Without the wrap_cnt term, the per-index distance ignores epochs:
    // post-wrap entries (range crossing an epoch boundary) get missed,
    // and committed older-epoch entries that share an index can get
    // mis-squashed. Without inclusive semantics, the entry at squash_idx
    // (e.g. the first speculative entry past a slow-resolving RS-routed
    // branch) is left valid+completed and may commit stale data before
    // the right-path alloc replaces it.
    var squash_mask: logic [32];
    always_comb {
        let sq_dt: logic<7> = tail - i_squash_idx;
        for i in 0..32 {
            squash_mask[i] = 1'b0;
            if i_squash_valid {
                let cur_ptr: logic<7> = {wrap_cnt[i], i[4:0]};
                let sq_di  : logic<7> = cur_ptr - i_squash_idx;
                if sq_di <: sq_dt {
                    squash_mask[i] = 1'b1;
                }
            }
        }
    }

    for i in 0..32 :g_sq_mask {
        assign o_squash_mask[i] = squash_mask[i];
    }

    let head_idx: logic<5> = head[4:0];
    let tail_idx: logic<5> = tail[4:0];

    assign o_empty       = count == 6'd0;
    assign o_full        = count == 6'd32;
    assign o_alloc_ready = count <: 6'd32;
    assign o_alloc_idx   = tail_idx;
    assign o_alloc_epoch = tail[6:5];
    assign o_commit_idx  = head_idx;

    // Same-cycle complete+commit bypass — any complete port may hit head
    let completing_head: logic = i_complete_valid && i_complete_idx == head_idx
                              && valid[head_idx] && !completed[head_idx] && !o_empty
                              && wrap_cnt[head_idx] == i_complete_epoch;
    let completing2_head: logic = i_complete2_valid && i_complete2_idx == head_idx
                               && valid[head_idx] && !completed[head_idx] && !o_empty
                               && wrap_cnt[head_idx] == i_complete2_epoch;
    // Port 3 (LQ retire) is safe to include in the commit bypass because
    // the LQ gates its retire output with MEM-stage sync — port 3 only
    // fires when LQ.head.rob matches the pipeline's current MEM/WB rob,
    // i.e., the retire target is the ROB head. With port 1 suppressed
    // for LQ-captured loads (mem_was_lq), port 3 is the sole completion
    // source and needs this bypass to keep commit same-cycle.
    let completing3_head: logic = i_complete3_valid && i_complete3_idx == head_idx
                               && valid[head_idx] && !completed[head_idx] && !o_empty
                               && wrap_cnt[head_idx] == i_complete3_epoch;
    let any_completing_head: logic = completing_head || completing2_head || completing3_head;

    // Lookup: completed flag with same-cycle bypass
    assign o_lookup1_completed = completed[i_lookup1_idx]
        || (any_completing_head && i_lookup1_idx == head_idx);
    assign o_lookup2_completed = completed[i_lookup2_idx]
        || (any_completing_head && i_lookup2_idx == head_idx);
    assign o_lookup1_valid = valid[i_lookup1_idx];
    assign o_lookup2_valid = valid[i_lookup2_idx];

    // Data read ports with same-cycle complete bypass (epoch-guarded).
    // Port 1 (slot0 WB) wins if multiple ports hit the same idx — port 3
    // is idempotent with port 1 when both fire (identical data). When
    // port 1 is suppressed for LQ-captured loads, port 3 provides the
    // same-cycle data for RS dispatches reading the load's rd_data.
    let read1_bypass_p0: logic = i_complete_valid && i_complete_idx == i_read1_idx
        && valid[i_read1_idx] && !completed[i_read1_idx] && wrap_cnt[i_read1_idx] == i_complete_epoch;
    let read1_bypass_p1: logic = i_complete2_valid && i_complete2_idx == i_read1_idx
        && valid[i_read1_idx] && !completed[i_read1_idx] && wrap_cnt[i_read1_idx] == i_complete2_epoch;
    let read1_bypass_p2: logic = i_complete3_valid && i_complete3_idx == i_read1_idx
        && valid[i_read1_idx] && !completed[i_read1_idx] && wrap_cnt[i_read1_idx] == i_complete3_epoch;
    let read2_bypass_p0: logic = i_complete_valid && i_complete_idx == i_read2_idx
        && valid[i_read2_idx] && !completed[i_read2_idx] && wrap_cnt[i_read2_idx] == i_complete_epoch;
    let read2_bypass_p1: logic = i_complete2_valid && i_complete2_idx == i_read2_idx
        && valid[i_read2_idx] && !completed[i_read2_idx] && wrap_cnt[i_read2_idx] == i_complete2_epoch;
    let read2_bypass_p2: logic = i_complete3_valid && i_complete3_idx == i_read2_idx
        && valid[i_read2_idx] && !completed[i_read2_idx] && wrap_cnt[i_read2_idx] == i_complete3_epoch;
    assign o_read1_data = if read1_bypass_p0 ? i_complete_data
                        : if read1_bypass_p1 ? i_complete2_data
                        : if read1_bypass_p2 ? i_complete3_data
                        : rd_data[i_read1_idx];
    assign o_read2_data = if read2_bypass_p0 ? i_complete_data
                        : if read2_bypass_p1 ? i_complete2_data
                        : if read2_bypass_p2 ? i_complete3_data
                        : rd_data[i_read2_idx];
    assign o_read1_completed = completed[i_read1_idx]
        || (any_completing_head && i_read1_idx == head_idx)
        || read1_bypass_p0 || read1_bypass_p1 || read1_bypass_p2;
    assign o_read1_valid = valid[i_read1_idx];
    assign o_read1_epoch = wrap_cnt[i_read1_idx];
    assign o_read2_completed = completed[i_read2_idx]
        || (any_completing_head && i_read2_idx == head_idx)
        || read2_bypass_p0 || read2_bypass_p1 || read2_bypass_p2;
    assign o_read2_valid = valid[i_read2_idx];
    assign o_read2_epoch = wrap_cnt[i_read2_idx];

    // Read ports 3/4: same bypass logic as 1/2, used by FP RS dispatch.
    let read3_bypass_p0: logic = i_complete_valid && i_complete_idx == i_read3_idx
        && valid[i_read3_idx] && !completed[i_read3_idx] && wrap_cnt[i_read3_idx] == i_complete_epoch;
    let read3_bypass_p1: logic = i_complete2_valid && i_complete2_idx == i_read3_idx
        && valid[i_read3_idx] && !completed[i_read3_idx] && wrap_cnt[i_read3_idx] == i_complete2_epoch;
    let read3_bypass_p2: logic = i_complete3_valid && i_complete3_idx == i_read3_idx
        && valid[i_read3_idx] && !completed[i_read3_idx] && wrap_cnt[i_read3_idx] == i_complete3_epoch;
    let read4_bypass_p0: logic = i_complete_valid && i_complete_idx == i_read4_idx
        && valid[i_read4_idx] && !completed[i_read4_idx] && wrap_cnt[i_read4_idx] == i_complete_epoch;
    let read4_bypass_p1: logic = i_complete2_valid && i_complete2_idx == i_read4_idx
        && valid[i_read4_idx] && !completed[i_read4_idx] && wrap_cnt[i_read4_idx] == i_complete2_epoch;
    let read4_bypass_p2: logic = i_complete3_valid && i_complete3_idx == i_read4_idx
        && valid[i_read4_idx] && !completed[i_read4_idx] && wrap_cnt[i_read4_idx] == i_complete3_epoch;
    assign o_read3_data = if read3_bypass_p0 ? i_complete_data
                        : if read3_bypass_p1 ? i_complete2_data
                        : if read3_bypass_p2 ? i_complete3_data
                        : rd_data[i_read3_idx];
    assign o_read4_data = if read4_bypass_p0 ? i_complete_data
                        : if read4_bypass_p1 ? i_complete2_data
                        : if read4_bypass_p2 ? i_complete3_data
                        : rd_data[i_read4_idx];
    assign o_read3_completed = completed[i_read3_idx]
        || (any_completing_head && i_read3_idx == head_idx)
        || read3_bypass_p0 || read3_bypass_p1 || read3_bypass_p2;
    assign o_read3_valid = valid[i_read3_idx];
    assign o_read3_epoch = wrap_cnt[i_read3_idx];
    assign o_read4_completed = completed[i_read4_idx]
        || (any_completing_head && i_read4_idx == head_idx)
        || read4_bypass_p0 || read4_bypass_p1 || read4_bypass_p2;
    assign o_read4_valid = valid[i_read4_idx];
    assign o_read4_epoch = wrap_cnt[i_read4_idx];

    // Read port 5: FP RS rs3 for FMADD family
    let read5_bypass_p0: logic = i_complete_valid && i_complete_idx == i_read5_idx
        && valid[i_read5_idx] && !completed[i_read5_idx] && wrap_cnt[i_read5_idx] == i_complete_epoch;
    let read5_bypass_p1: logic = i_complete2_valid && i_complete2_idx == i_read5_idx
        && valid[i_read5_idx] && !completed[i_read5_idx] && wrap_cnt[i_read5_idx] == i_complete2_epoch;
    let read5_bypass_p2: logic = i_complete3_valid && i_complete3_idx == i_read5_idx
        && valid[i_read5_idx] && !completed[i_read5_idx] && wrap_cnt[i_read5_idx] == i_complete3_epoch;
    assign o_read5_data = if read5_bypass_p0 ? i_complete_data
                        : if read5_bypass_p1 ? i_complete2_data
                        : if read5_bypass_p2 ? i_complete3_data
                        : rd_data[i_read5_idx];
    assign o_read5_completed = completed[i_read5_idx]
        || (any_completing_head && i_read5_idx == head_idx)
        || read5_bypass_p0 || read5_bypass_p1 || read5_bypass_p2;
    assign o_read5_valid = valid[i_read5_idx];
    assign o_read5_epoch = wrap_cnt[i_read5_idx];

    // Commit output: head is committable if either complete port hits it, or already completed
    let squash_head: logic = i_squash_valid && squash_mask[head_idx];
    assign o_commit_valid  = !squash_head
        && (any_completing_head || (!o_empty && valid[head_idx] && completed[head_idx]));
    assign o_commit_pc     = pc[head_idx];
    assign o_commit_rd     = rd_addr[head_idx];
    assign o_commit_data   = if completing_head ? i_complete_data
                            : if completing2_head ? i_complete2_data
                            : if completing3_head ? i_complete3_data
                            : rd_data[head_idx];
    assign o_commit_wen    = reg_wen[head_idx];
    assign o_commit_is_fp  = is_fp[head_idx];
    assign o_commit_fp_wen = fp_wen[head_idx];
    assign o_commit_compr  = compr[head_idx];
    assign o_commit_exc    = exception[head_idx];
    assign o_commit_cause  = cause[head_idx];
    assign o_commit_epoch  = wrap_cnt[head_idx];

    always_ff (clk, rst) {
        if_reset {
            head  = 7'd0;
            tail  = 7'd0;
            count = 6'd0;
            for i in 0..32 {
                valid[i]     = 1'b0;
                completed[i] = 1'b0;
                exception[i] = 1'b0;
            }
        } else if i_flush {
            head  = 7'd0;
            tail  = 7'd0;
            count = 6'd0;
            for i in 0..32 {
                valid[i]     = 1'b0;
                completed[i] = 1'b0;
                exception[i] = 1'b0;
            }
        } else {
            let do_alloc : logic = i_alloc_valid && o_alloc_ready && !i_squash_valid;
            let do_commit: logic = i_commit_ack && o_commit_valid;

            // Complete/exception/cancel BEFORE alloc (last write wins on same index)

            // Complete: epoch guard prevents stale completion from wrong generation
            if i_complete_valid && valid[i_complete_idx] && wrap_cnt[i_complete_idx] == i_complete_epoch {
                completed[i_complete_idx] = 1'b1;
                rd_data[i_complete_idx]   = i_complete_data;
            }
            // Complete port 2 (dual-issue slot1 completion)
            if i_complete2_valid && valid[i_complete2_idx] && wrap_cnt[i_complete2_idx] == i_complete2_epoch {
                completed[i_complete2_idx] = 1'b1;
                rd_data[i_complete2_idx]   = i_complete2_data;
            }
            // Complete port 3 (LQ retire). Idempotent with port 1 normal WB
            // for plain loads — last-write-wins with identical data.
            if i_complete3_valid && valid[i_complete3_idx] && wrap_cnt[i_complete3_idx] == i_complete3_epoch {
                completed[i_complete3_idx] = 1'b1;
                rd_data[i_complete3_idx]   = i_complete3_data;
            }
            // Complete port 4 (D2 async DIV). Runs in parallel with port 1
            // normal WB — DIV's instruction stays at EX stage until divider
            // finishes, so port 1 never fires for the same rob_idx/epoch.
            if i_complete4_valid && valid[i_complete4_idx] && wrap_cnt[i_complete4_idx] == i_complete4_epoch {
                completed[i_complete4_idx] = 1'b1;
                rd_data[i_complete4_idx]   = i_complete4_data;
            }

            if i_exc_valid {
                completed[i_exc_idx] = 1'b1;
                exception[i_exc_idx] = 1'b1;
                cause[i_exc_idx]     = i_exc_cause;
            }

            if i_suppress_wen_valid {
                reg_wen[i_suppress_wen_idx] = 1'b0;
            }

            if i_cancel_valid && valid[i_cancel_idx] {
                completed[i_cancel_idx] = 1'b1;
                reg_wen[i_cancel_idx]   = 1'b0;
                fp_wen[i_cancel_idx]    = 1'b0;
            }

            // Allocate at tail (AFTER complete: last write wins)
            if do_alloc {
                valid[tail_idx]     = 1'b1;
                completed[tail_idx] = 1'b0;
                exception[tail_idx] = 1'b0;
                pc[tail_idx]        = i_alloc_pc;
                rd_addr[tail_idx]   = i_alloc_rd;
                reg_wen[tail_idx]   = i_alloc_wen;
                is_fp[tail_idx]     = i_alloc_is_fp;
                fp_wen[tail_idx]    = i_alloc_fp_wen;
                compr[tail_idx]     = i_alloc_compr;
                wrap_cnt[tail_idx]  = tail[6:5];
                rd_data[tail_idx]   = '0;
                cause[tail_idx]     = '0;
                tail = tail + 7'd1;
            }

            // Commit: retire head
            if do_commit {
                valid[head_idx]     = 1'b0;
                completed[head_idx] = 1'b0;
                head = head + 7'd1;
            }

            // Count update
            if i_squash_valid {
                for i in 0..32 {
                    if squash_mask[i] {
                        valid[i]     = 1'b0;
                        completed[i] = 1'b0;
                        exception[i] = 1'b0;
                    }
                }
                // 7-bit arithmetic: squash_idx - head gives correct count (lower 6 bits)
                let sq_diff: logic<7> = i_squash_idx - head;
                let sq_new_count: logic<6> = sq_diff[5:0];
                tail = i_squash_idx;
                count = if do_commit ? sq_new_count - 6'd1 : sq_new_count;
            } else if do_alloc && do_commit {
                // Net change: 0
            } else if do_alloc {
                count = count + 6'd1;
            } else if do_commit {
                count = count - 6'd1;
            }
        }
    }
}
