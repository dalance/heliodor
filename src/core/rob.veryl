// Phase 7 v4: Reorder Buffer (in-order commit gate).
//
// 32 entries (M1). At dispatch the tail slot is allocated per
// in-flight op. The CDB writes back `result_written=1` when EX
// completes. Commit pops the head only when `result_written` is set
// (the precise-exception invariant that v2 violated).
//
// On commit-time mispredict / trap the ROB is fully flushed via
// `i_redirect_fire`. M6 will refine to branch-checkpoint recovery.
//
// M1: 1-wide commit + 1-wide alloc + 1 CDB. Fields are minimal
// (RobEntry struct in pipeline_pkg) — extended in M3+ for MUL/
// DIV / trap / AMO / STORE.
pub module rob #(
    param ROB_DEPTH: u32 = 32,
    param ROB_IDX_W: u32 = 5 ,
    param PRF_W    : u32 = 6 ,
) (
    clk: input clock,
    rst: input reset,

    // Allocation (dispatch)
    i_alloc_en   : input  logic                               ,
    i_alloc_entry: input  pipeline_pkg::RobEntry           ,
    o_alloc_idx  : output logic                    <ROB_IDX_W>,
    o_full       : output logic                               ,
    // Phase 8 S2: 2-wide alloc slot-1 (tail+1). Gated off (i_alloc_en2=0) until
    // the front end widens at S4. Caller guarantees room for 2 before asserting.
    i_alloc_en2   : input  logic                    ,
    i_alloc_entry2: input  pipeline_pkg::RobEntry   ,
    o_alloc_idx2  : output logic         <ROB_IDX_W>,

    // Writeback (CDB)
    i_cdb_valid      : input logic           ,
    i_cdb_rob_idx    : input logic<ROB_IDX_W>,
    i_cdb_result_data: input logic<64>       ,
    i_cdb_mispredict : input logic           ,
    i_cdb_redirect_pc: input logic<64>       ,
    // M2 STORE side-band on CDB
    i_cdb_is_store    : input logic    ,
    i_cdb_store_addr  : input logic<64>,
    i_cdb_store_data  : input logic<64>,
    i_cdb_store_funct3: input logic<3> ,
    // M4 CSR side-band on CDB
    i_cdb_is_csr     : input logic    ,
    i_cdb_csr_addr   : input logic<12>,
    i_cdb_csr_wdata  : input logic<64>,
    i_cdb_csr_illegal: input logic    ,
    // M5.D dmem MMU fault inputs
    i_cdb_is_lfault  : input logic    ,
    i_cdb_is_sfault  : input logic    ,
    i_cdb_fault_vaddr: input logic<64>,
    // M6: FP exception flags from the FPU (captured at FP CDB writeback,
    // accrued into fcsr at commit). fflags_wen is high only when an FP op
    // writes back; for ALU writebacks it is low and fflags are left as-is.
    i_cdb_fflags    : input logic<5>,
    i_cdb_fflags_wen: input logic   ,
    // M9.A.294 (F2): independent load-page-fault injection port. A
    // multi-cycle MMU walk reports o_fault one cycle after busy drops, by
    // which time the IQ has moved on to a different op — so the CDB tags
    // the fault to the wrong (current-issue) rob_idx. The core latches the
    // walk owner and delivers the fault to ITS rob_idx via this port,
    // independent of the CDB result write (which still lands on the
    // current issue). Marks result_written so the faulting load can reach
    // commit (and trap), unless squashed first as wrong-path.
    i_lfault_inj_v    : input logic           ,
    i_lfault_inj_rob  : input logic<ROB_IDX_W>,
    i_lfault_inj_vaddr: input logic<64>       ,
    // M9.3 inject-linkage probe (debug). PC of the load that STARTED the
    // faulting PTW walk (walk_pc_q in core). Recorded per ROB entry so that
    // at commit we can compare it to the committing op's own PC: equal ⇒ the
    // walk-owner load is itself the trapping op (genuine fault); different ⇒
    // the fault was injected into a reused/innocent entry (mis-attribution).
    i_lfault_inj_pc   : input logic<64>       ,

    // Commit (M1 = 1-wide)
    o_commit_valid: output logic                    ,
    o_commit_entry: output pipeline_pkg::RobEntry,
    // Per-field commit outputs (mirror of o_commit_entry, exposed
    // separately to avoid cross-module struct-port sim bug).
    o_commit_pc         : output logic<64>   ,
    o_commit_rd_arch    : output logic<5>    ,
    o_commit_rd_pdst    : output logic<PRF_W>,
    o_commit_old_rd_pdst: output logic<PRF_W>,
    o_commit_has_rd     : output logic       ,
    o_commit_illegal    : output logic       ,
    o_commit_mispredict : output logic       ,
    o_commit_redirect_pc: output logic<64>   ,
    // Phase 8 M1: carried predicted next PC + fields for the commit-time
    // mispredict check (see RobEntry).
    o_commit_pred_next_pc: output logic<64>  ,
    o_commit_is_rvc      : output logic      ,
    o_commit_is_control  : output logic      ,
    o_commit_is_cond     : output logic      , // M2: conditional branch (BHT train)
    o_commit_is_call     : output logic      , // M3: call (RAS push + BTB kind)
    o_commit_is_ret      : output logic      , // M3: return (RAS pop + BTB kind)
    o_commit_pred_index  : output logic<10>  , // M4: fetch-time BHT (gshare) index
    o_commit_result_data: output logic<64>   ,
    // M2 STORE drain
    o_commit_is_store    : output logic    ,
    o_commit_store_addr  : output logic<64>,
    o_commit_store_data  : output logic<64>,
    o_commit_store_funct3: output logic<3> ,
    // M2 LOAD-after-STORE ordering
    o_has_pending_store: output logic,
    // M9 SMP: high while any valid, result-written AMO/LR/SC entry is in
    // flight (computed but not yet committed). Drives the core's o_amo_inflight
    // so the memory_bus locks the bus to this hart across the AMO RMW window
    // (read value is captured at issue, written at commit — a remote write
    // between them must be impossible). Gated on sh_rw so only AMOs that have
    // already read are counted (an un-issued AMO must NOT lock — it could be
    // waiting on operands produced behind a spin on another hart → deadlock).
    o_has_pending_amo: output logic,
    // M9.A.298 translation-state barrier: high while any in-flight (valid,
    // not-yet-committed) entry will change translation state — a CSR write to
    // sstatus/mstatus/satp, an SFENCE.VMA, or an MRET/SRET. A younger LOAD/AMO
    // must not translate through the MMU until these commit (else it sees
    // stale SUM/MXR/MPRV/priv/satp and records a spurious page fault).
    o_has_pending_xlate: output logic,
    // M4 CSR drain + trap
    o_commit_is_csr     : output logic           ,
    o_commit_csr_addr   : output logic<12>       ,
    o_commit_csr_wdata  : output logic<64>       ,
    o_commit_is_ecall   : output logic           ,
    o_commit_is_ebreak  : output logic           ,
    o_commit_is_mret    : output logic           ,
    o_commit_is_sret    : output logic           ,
    o_commit_is_sfence  : output logic           ,
    o_commit_is_fence_i : output logic           , // M8.A FENCE.I → icache flush
    o_commit_is_ifault  : output logic           ,
    o_commit_is_lfault  : output logic           ,
    o_commit_is_sfault  : output logic           ,
    o_commit_fault_vaddr: output logic<64>       ,
    // M9.3 inject-linkage probe (debug): the head entry's recorded
    // walk-start PC and whether its fault was inject-delivered.
    o_commit_dbg_walk_pc: output logic<64>       ,
    o_commit_dbg_inj    : output logic           ,
    // M6: FP destination + accrued fflags drained at commit.
    o_commit_is_fp_dest : output logic           ,
    o_commit_is_fp      : output logic           , // any FP op (FS-disabled trap)
    o_commit_fflags     : output logic<5>        ,
    o_commit_fflags_wen : output logic           ,
    o_commit_idx        : output logic<ROB_IDX_W>,
    i_commit_ack        : input  logic           ,

    // Phase 8 S1: 2-wide commit slot-1 (head+1). Only "simple" entries are
    // eligible (not store/amo/csr/sfence/fence.i/trap/mret/sret/illegal/control/
    // fp) so slot-1 needs no serial machinery — only the integer rd writeback
    // fields. o_commit2_valid = head+1 is a simple, result-written entry within
    // the occupied window (and not a flush cycle). The core ANDs it with slot-0's
    // retire to drive i_commit_ack2.
    o_commit2_valid      : output logic           ,
    o_commit2_pc         : output logic<64>       ,
    o_commit2_rd_arch    : output logic<5>        ,
    o_commit2_rd_pdst    : output logic<PRF_W>    ,
    o_commit2_old_rd_pdst: output logic<PRF_W>    ,
    o_commit2_has_rd     : output logic           ,
    o_commit2_result_data: output logic<64>       ,
    i_commit_ack2        : input  logic           ,

    // Full flush (commit-time mispredict / trap)
    i_redirect_fire: input logic,

    // Status outputs (for asserts and dispatch back-pressure)
    o_head_idx: output logic<ROB_IDX_W>,
    o_size    : output logic<8>        ,
    // M1 debug: head entry state for stuck localization
    o_dbg_head_valid  : output logic    ,
    o_dbg_head_rw     : output logic    ,
    o_dbg_head_illegal: output logic    ,
    o_dbg_alloc_cnt   : output logic<32>,
    o_dbg_cdb_cnt     : output logic<32>,
    o_dbg_commit_cnt  : output logic<32>,
    o_dbg_head        : output logic<6> ,
    o_dbg_tail        : output logic<6> ,
) {
    var entries: pipeline_pkg::RobEntry    [ROB_DEPTH];
    var head   : logic                    <6>            ; // ROB_IDX_W + 1 for full/empty distinction
    var tail   : logic                    <6>            ;

    // Shadow arrays — workaround for Veryl sim dynamic-index
    // struct-field READ returning stale/wrong values. We mirror every
    // commit-time-consumed field as a standalone array (not packed into
    // the struct). This is a sim-bug workaround; the entries[] struct
    // is still used for fields that aren't critical at commit time, but
    // commit gating and consumer signals read the shadow.
    var sh_valid      : logic        [ROB_DEPTH];
    var sh_rw         : logic        [ROB_DEPTH];
    var sh_has_rd     : logic        [ROB_DEPTH];
    var sh_illegal    : logic        [ROB_DEPTH];
    var sh_mispredict : logic        [ROB_DEPTH];
    var sh_pc         : logic<64>    [ROB_DEPTH];
    var sh_rd_arch    : logic<5>     [ROB_DEPTH];
    var sh_rd_pdst    : logic<PRF_W> [ROB_DEPTH];
    var sh_old_rd_pdst: logic<PRF_W> [ROB_DEPTH];
    var sh_redirect_pc: logic<64>    [ROB_DEPTH];
    var sh_result_data: logic<64>    [ROB_DEPTH];
    // Phase 8 M1: carried predicted next PC + control/length, set at alloc.
    var sh_pred_next_pc: logic<64> [ROB_DEPTH];
    var sh_is_rvc      : logic     [ROB_DEPTH];
    var sh_is_control  : logic     [ROB_DEPTH];
    var sh_is_cond     : logic     [ROB_DEPTH]; // M2: conditional branch
    var sh_is_call     : logic     [ROB_DEPTH]; // M3: call
    var sh_is_ret      : logic     [ROB_DEPTH]; // M3: return
    var sh_pred_index  : logic<10> [ROB_DEPTH]; // M4: gshare index
    // M2 STORE side-band
    var sh_is_store    : logic     [ROB_DEPTH];
    var sh_is_amo      : logic     [ROB_DEPTH]; // M9 SMP: AMO/LR/SC (for bus lock)
    var sh_store_addr  : logic<64> [ROB_DEPTH];
    var sh_store_data  : logic<64> [ROB_DEPTH];
    var sh_store_funct3: logic<3>  [ROB_DEPTH];
    // M4 CSR + trap
    var sh_is_csr   : logic     [ROB_DEPTH];
    var sh_csr_addr : logic<12> [ROB_DEPTH];
    var sh_csr_wdata: logic<64> [ROB_DEPTH];
    var sh_is_ecall : logic     [ROB_DEPTH];
    var sh_is_ebreak: logic     [ROB_DEPTH];
    var sh_is_mret  : logic     [ROB_DEPTH];
    var sh_is_sret  : logic     [ROB_DEPTH];
    var sh_is_sfence: logic     [ROB_DEPTH];
    var sh_is_fence_i: logic    [ROB_DEPTH]; // M8.A FENCE.I
    var sh_is_ifault: logic     [ROB_DEPTH];
    // M5.D dmem MMU faults
    var sh_is_lfault  : logic     [ROB_DEPTH];
    var sh_is_sfault  : logic     [ROB_DEPTH];
    var sh_fault_vaddr: logic<64> [ROB_DEPTH];
    // M9.3 inject-linkage probe (debug-only shadows): per-entry walk-start PC
    // and inject-delivered flag, written by the lfault inject port.
    var sh_dbg_walk_pc: logic<64> [ROB_DEPTH];
    var sh_dbg_inj    : logic     [ROB_DEPTH];
    // M6: FP destination + accrued fflags
    var sh_is_fp_dest : logic     [ROB_DEPTH];
    var sh_is_fp      : logic     [ROB_DEPTH];
    var sh_fflags     : logic<5>  [ROB_DEPTH];
    var sh_fflags_wen : logic     [ROB_DEPTH];

    let head_idx: logic<ROB_IDX_W> = head[ROB_IDX_W - 1:0];
    let tail_idx: logic<ROB_IDX_W> = tail[ROB_IDX_W - 1:0];
    // Phase 8 S1: 2-wide commit slot-1 index = head+1.
    let head_p1  : logic<6>           = head + 6'd1;
    let head1_idx: logic<ROB_IDX_W> = head_p1[ROB_IDX_W - 1:0];
    // Phase 8 S2: 2-wide alloc slot-1 index = tail+1.
    let tail_p1  : logic<6>           = tail + 6'd1;
    let tail1_idx: logic<ROB_IDX_W> = tail_p1[ROB_IDX_W - 1:0];

    let is_empty: logic    = head == tail;
    let size_w  : logic<6> = tail - head;
    let is_full : logic    = size_w == 6'd32;

    // Phase 8 S1: head+1 is commit-slot-1 eligible when it is a valid,
    // result-written, SIMPLE integer op (no serial side effects) and at least 2
    // entries are occupied, and not a flush cycle.
    let c2_simple: logic = sh_valid[head1_idx] && sh_rw[head1_idx]
        && !sh_is_store[head1_idx] && !sh_is_amo[head1_idx] && !sh_is_csr[head1_idx]
        && !sh_is_sfence[head1_idx] && !sh_is_fence_i[head1_idx]
        && !sh_is_ecall[head1_idx] && !sh_is_ebreak[head1_idx]
        && !sh_is_mret[head1_idx] && !sh_is_sret[head1_idx]
        && !sh_is_lfault[head1_idx] && !sh_is_sfault[head1_idx] && !sh_is_ifault[head1_idx]
        && !sh_illegal[head1_idx] && !sh_is_control[head1_idx] && !sh_is_fp[head1_idx];
    let c2_valid: logic = c2_simple && (size_w >= 6'd2) && !i_redirect_fire;

    assign o_alloc_idx  = tail_idx;
    assign o_alloc_idx2 = tail1_idx;
    assign o_full       = is_full;
    // i_redirect_fire gate: during a flush cycle, suppress combinational
    // commit_valid so back-end (arch_regs / rat_arch / free_list push)
    // does not consume entries that will be invalidated this cycle.
    assign o_commit_valid = !is_empty && sh_valid[head_idx] && sh_rw[head_idx] && !i_redirect_fire;
    // o_commit_entry is built from shadow arrays. Reading entries[head_idx]
    // directly returns wrong field values under Veryl sim (dynamic-index
    // struct field READ bug; see sh_* workaround above).
    always_comb {
        o_commit_entry.valid          = sh_valid[head_idx];
        o_commit_entry.pc             = sh_pc[head_idx];
        o_commit_entry.rd_arch        = sh_rd_arch[head_idx];
        o_commit_entry.rd_pdst        = sh_rd_pdst[head_idx];
        o_commit_entry.old_rd_pdst    = sh_old_rd_pdst[head_idx];
        o_commit_entry.has_rd         = sh_has_rd[head_idx];
        o_commit_entry.result_written = sh_rw[head_idx];
        o_commit_entry.is_branch      = entries[head_idx].is_branch;
        o_commit_entry.is_jal         = entries[head_idx].is_jal;
        o_commit_entry.is_jalr        = entries[head_idx].is_jalr;
        o_commit_entry.mispredict     = sh_mispredict[head_idx];
        o_commit_entry.redirect_pc    = sh_redirect_pc[head_idx];
        o_commit_entry.illegal        = sh_illegal[head_idx];
        o_commit_entry.result_data    = sh_result_data[head_idx];
    }
    // Per-field commit outputs (bypass struct-port sim bug)
    assign o_commit_pc           = sh_pc[head_idx];
    assign o_commit_rd_arch      = sh_rd_arch[head_idx];
    assign o_commit_rd_pdst      = sh_rd_pdst[head_idx];
    assign o_commit_old_rd_pdst  = sh_old_rd_pdst[head_idx];
    assign o_commit_has_rd       = sh_has_rd[head_idx];
    assign o_commit_illegal      = sh_illegal[head_idx];
    assign o_commit_mispredict   = sh_mispredict[head_idx];
    assign o_commit_redirect_pc  = sh_redirect_pc[head_idx];
    assign o_commit_pred_next_pc = sh_pred_next_pc[head_idx];
    assign o_commit_is_rvc       = sh_is_rvc[head_idx];
    assign o_commit_is_control   = sh_is_control[head_idx];
    assign o_commit_is_cond      = sh_is_cond[head_idx];
    assign o_commit_is_call      = sh_is_call[head_idx];
    assign o_commit_is_ret       = sh_is_ret[head_idx];
    assign o_commit_pred_index   = sh_pred_index[head_idx];
    assign o_commit_result_data  = sh_result_data[head_idx];
    // Phase 8 S1: commit slot-1 (head+1) outputs.
    assign o_commit2_valid       = c2_valid;
    assign o_commit2_pc          = sh_pc[head1_idx];
    assign o_commit2_rd_arch     = sh_rd_arch[head1_idx];
    assign o_commit2_rd_pdst     = sh_rd_pdst[head1_idx];
    assign o_commit2_old_rd_pdst = sh_old_rd_pdst[head1_idx];
    assign o_commit2_has_rd      = sh_has_rd[head1_idx];
    assign o_commit2_result_data = sh_result_data[head1_idx];
    assign o_commit_is_store     = sh_is_store[head_idx];
    assign o_commit_store_addr   = sh_store_addr[head_idx];
    assign o_commit_store_data   = sh_store_data[head_idx];
    assign o_commit_store_funct3 = sh_store_funct3[head_idx];
    assign o_commit_is_csr       = sh_is_csr[head_idx];
    assign o_commit_csr_addr     = sh_csr_addr[head_idx];
    assign o_commit_csr_wdata    = sh_csr_wdata[head_idx];
    assign o_commit_is_ecall     = sh_is_ecall[head_idx];
    assign o_commit_is_ebreak    = sh_is_ebreak[head_idx];
    assign o_commit_is_mret      = sh_is_mret[head_idx];
    assign o_commit_is_sret      = sh_is_sret[head_idx];
    assign o_commit_is_sfence    = sh_is_sfence[head_idx];
    assign o_commit_is_fence_i   = sh_is_fence_i[head_idx];
    assign o_commit_is_ifault    = sh_is_ifault[head_idx];
    assign o_commit_is_lfault    = sh_is_lfault[head_idx];
    assign o_commit_is_sfault    = sh_is_sfault[head_idx];
    assign o_commit_fault_vaddr  = sh_fault_vaddr[head_idx];
    assign o_commit_dbg_walk_pc  = sh_dbg_walk_pc[head_idx];
    assign o_commit_dbg_inj      = sh_dbg_inj[head_idx];
    assign o_commit_is_fp_dest   = sh_is_fp_dest[head_idx];
    assign o_commit_is_fp        = sh_is_fp[head_idx];
    assign o_commit_fflags       = sh_fflags[head_idx];
    assign o_commit_fflags_wen   = sh_fflags_wen[head_idx];
    assign o_commit_idx          = head_idx;

    // M2 has_pending_store: OR-reduce over the active ROB window. A
    // STORE entry is "pending" while valid (not yet committed).
    var pending_store_w: logic;
    always_comb {
        pending_store_w = 1'b0;
        for i in 0..ROB_DEPTH {
            if sh_valid[i] && sh_is_store[i] {
                pending_store_w = 1'b1;
            }
        }
    }
    assign o_has_pending_store = pending_store_w;

    // M9 SMP: OR-reduce over the active ROB window for an AMO/LR/SC that has
    // already executed (sh_rw, i.e. read+computed) but not yet committed. This
    // is the [read, write] bus-lock window for the bus-atomic RMW. sh_rw gating
    // is essential: an allocated-but-unissued AMO must NOT lock (it may sit
    // behind a spin loop whose exit depends on a remote hart writing memory —
    // locking the bus there would deadlock). The 1-cycle gap before sh_rw is
    // set is covered by amo_read_pending_q in the core (issue is delayed until
    // the lock is asserted).
    var pending_amo_w: logic;
    always_comb {
        pending_amo_w = 1'b0;
        for i in 0..ROB_DEPTH {
            if sh_valid[i] && sh_rw[i] && sh_is_amo[i] {
                pending_amo_w = 1'b1;
            }
        }
    }
    assign o_has_pending_amo = pending_amo_w;

    // M9.A.298: translation-affecting state-change barrier. OR-reduce over the
    // active ROB window: a valid entry that is a CSR write to sstatus (0x100) /
    // mstatus (0x300) / satp (0x180), or an SFENCE.VMA, or an MRET/SRET. While
    // any such entry is in flight, a younger LOAD/AMO issuing to the AGU would
    // translate through the MMU using the OLD (committed) SUM/MXR/MPRV/priv/satp
    // and record a spurious page fault — Linux brackets user accesses with
    // `csrs sstatus,SUM; ld; csrc sstatus,SUM`, and the OoO load can translate
    // with SUM=0 before the csrs commits. Mirrors v1's i_amo_lq_stall narrow
    // CSR scope (heliodor_core.veryl:1186). iq_int's at_head escape keeps the
    // oldest entry issuable, so this can never deadlock the ROB head.
    var pending_xlate_w: logic;
    always_comb {
        pending_xlate_w = 1'b0;
        for i in 0..ROB_DEPTH {
            if sh_valid[i]
                && ((sh_is_csr[i]
                        && (sh_csr_addr[i] == 12'h100 || sh_csr_addr[i] == 12'h300 || sh_csr_addr[i] == 12'h180))
                    || sh_is_sfence[i] || sh_is_mret[i] || sh_is_sret[i]) {
                pending_xlate_w = 1'b1;
            }
        }
    }
    assign o_has_pending_xlate = pending_xlate_w;
    assign o_head_idx          = head_idx;
    assign o_size              = size_w[5:0] as 8;
    assign o_dbg_head_valid    = sh_valid[head_idx];
    assign o_dbg_head_rw       = sh_rw[head_idx];
    assign o_dbg_head_illegal  = entries[head_idx].illegal;
    assign o_dbg_head          = head;
    assign o_dbg_tail          = tail;

    var alloc_cnt : logic<32>;
    var cdb_cnt2  : logic<32>;
    var commit_cnt: logic<32>;

    always_ff (clk, rst) {
        if_reset {
            for i in 0..ROB_DEPTH {
                entries[i].valid          = 1'b0;
                entries[i].pc             = 64'd0;
                entries[i].rd_arch        = 5'd0;
                entries[i].rd_pdst        = 6'd0;
                entries[i].old_rd_pdst    = 6'd0;
                entries[i].has_rd         = 1'b0;
                entries[i].result_written = 1'b0;
                entries[i].is_branch      = 1'b0;
                entries[i].is_jal         = 1'b0;
                entries[i].is_jalr        = 1'b0;
                entries[i].mispredict     = 1'b0;
                entries[i].redirect_pc    = 64'd0;
                entries[i].illegal        = 1'b0;
                entries[i].result_data    = 64'd0;
                sh_valid[i]               = 1'b0;
                sh_rw[i]                  = 1'b0;
                sh_has_rd[i]              = 1'b0;
                sh_illegal[i]             = 1'b0;
                sh_mispredict[i]          = 1'b0;
                sh_pc[i]                  = 64'd0;
                sh_rd_arch[i]             = 5'd0;
                sh_rd_pdst[i]             = 6'd0;
                sh_old_rd_pdst[i]         = 6'd0;
                sh_redirect_pc[i]         = 64'd0;
                sh_result_data[i]         = 64'd0;
                sh_pred_next_pc[i]        = 64'd0;
                sh_is_rvc[i]              = 1'b0;
                sh_is_control[i]          = 1'b0;
                sh_is_cond[i]             = 1'b0;
                sh_is_call[i]             = 1'b0;
                sh_is_ret[i]              = 1'b0;
                sh_pred_index[i]          = 10'd0;
                sh_is_store[i]            = 1'b0;
                sh_is_amo[i]              = 1'b0;
                sh_store_addr[i]          = 64'd0;
                sh_store_data[i]          = 64'd0;
                sh_store_funct3[i]        = 3'd0;
                sh_is_csr[i]              = 1'b0;
                sh_csr_addr[i]            = 12'd0;
                sh_csr_wdata[i]           = 64'd0;
                sh_is_ecall[i]            = 1'b0;
                sh_is_ebreak[i]           = 1'b0;
                sh_is_mret[i]             = 1'b0;
                sh_is_sret[i]             = 1'b0;
                sh_is_sfence[i]           = 1'b0;
                sh_is_fence_i[i]          = 1'b0;
                sh_is_ifault[i]           = 1'b0;
                sh_is_lfault[i]           = 1'b0;
                sh_is_sfault[i]           = 1'b0;
                sh_fault_vaddr[i]         = 64'd0;
                sh_dbg_walk_pc[i]         = 64'd0;
                sh_dbg_inj[i]             = 1'b0;
                sh_is_fp_dest[i]          = 1'b0;
                sh_is_fp[i]               = 1'b0;
                sh_fflags[i]              = 5'd0;
                sh_fflags_wen[i]          = 1'b0;
            }
            head       = 6'd0;
            tail       = 6'd0;
            alloc_cnt  = 32'd0;
            cdb_cnt2   = 32'd0;
            commit_cnt = 32'd0;
        } else if i_redirect_fire {
            // Full flush — return ROB to empty. n_inflight in free_list
            // gets the same recovery_fire pulse so popped pdsts come back.
            for i in 0..ROB_DEPTH {
                entries[i].valid          = 1'b0;
                entries[i].result_written = 1'b0;
                sh_valid[i]               = 1'b0;
                sh_rw[i]                  = 1'b0;
                sh_has_rd[i]              = 1'b0;
                sh_illegal[i]             = 1'b0;
                sh_mispredict[i]          = 1'b0;
            }
            head = 6'd0;
            tail = 6'd0;
        } else {
            // Allocation (1-wide). Caller must ensure i_alloc_entry has
            // result_written=0 (heliodor_core sets it in rob_alloc_entry).
            // We do NOT do `entries[X] = src; entries[X].field = v;` —
            // that pattern is unsafe (Veryl JIT drops the post-assign
            // override, and SV NBA semantics are surprising for it).
            if i_alloc_en && !is_full {
                entries[tail_idx]        = i_alloc_entry;
                sh_valid[tail_idx]       = i_alloc_entry.valid;
                sh_rw[tail_idx]          = 1'b0;
                sh_has_rd[tail_idx]      = i_alloc_entry.has_rd;
                sh_illegal[tail_idx]     = i_alloc_entry.illegal;
                sh_mispredict[tail_idx]  = 1'b0;
                sh_pc[tail_idx]          = i_alloc_entry.pc;
                sh_rd_arch[tail_idx]     = i_alloc_entry.rd_arch;
                sh_rd_pdst[tail_idx]     = i_alloc_entry.rd_pdst;
                sh_old_rd_pdst[tail_idx] = i_alloc_entry.old_rd_pdst;
                sh_redirect_pc[tail_idx] = 64'd0;
                sh_result_data[tail_idx] = 64'd0;
                // Phase 8 M1: predicted next PC + control/length carried from fetch.
                sh_pred_next_pc[tail_idx] = i_alloc_entry.pred_next_pc;
                sh_is_rvc[tail_idx]       = i_alloc_entry.is_rvc;
                sh_is_control[tail_idx]   = i_alloc_entry.is_control;
                sh_is_cond[tail_idx]      = i_alloc_entry.is_branch;
                sh_is_call[tail_idx]      = i_alloc_entry.is_call;
                sh_is_ret[tail_idx]       = i_alloc_entry.is_ret;
                sh_pred_index[tail_idx]   = i_alloc_entry.pred_index;
                // M5.B: capture is_store at alloc (from decoder via
                // i_alloc_entry.is_store) so pending_store check sees the
                // STORE before its CDB. CDB later sets store_addr/data/funct3.
                sh_is_store[tail_idx]     = i_alloc_entry.is_store;
                sh_is_amo[tail_idx]       = i_alloc_entry.is_amo;
                sh_store_addr[tail_idx]   = 64'd0;
                sh_store_data[tail_idx]   = 64'd0;
                sh_store_funct3[tail_idx] = 3'd0;
                // M4: ecall/ebreak/mret captured at alloc-time (decode
                // result). M9.A.298: is_csr/csr_addr now ALSO captured at
                // alloc (was deferred to CDB) so the translation-barrier
                // (o_has_pending_xlate below) sees a translation-affecting
                // CSR write from dispatch — a younger LOAD must not translate
                // through the MMU before that CSR commits. csr_wdata is still
                // filled at CDB (the barrier needs only is_csr + csr_addr).
                sh_is_csr[tail_idx]      = i_alloc_entry.is_csr;
                sh_csr_addr[tail_idx]    = i_alloc_entry.csr_addr;
                sh_csr_wdata[tail_idx]   = 64'd0;
                sh_is_ecall[tail_idx]    = i_alloc_entry.is_ecall;
                sh_is_ebreak[tail_idx]   = i_alloc_entry.is_ebreak;
                sh_is_mret[tail_idx]     = i_alloc_entry.is_mret;
                sh_is_sret[tail_idx]     = i_alloc_entry.is_sret;
                sh_is_sfence[tail_idx]   = i_alloc_entry.is_sfence;
                sh_is_fence_i[tail_idx]  = i_alloc_entry.is_fence_i;
                sh_is_ifault[tail_idx]   = i_alloc_entry.is_ifault;
                sh_is_lfault[tail_idx]   = 1'b0;
                sh_is_sfault[tail_idx]   = 1'b0;
                sh_fault_vaddr[tail_idx] = 64'd0;
                sh_dbg_walk_pc[tail_idx] = 64'd0;
                sh_dbg_inj[tail_idx]     = 1'b0;
                sh_is_fp_dest[tail_idx]  = i_alloc_entry.is_fp_dest;
                sh_is_fp[tail_idx]       = i_alloc_entry.is_fp;
                sh_fflags[tail_idx]      = 5'd0;
                sh_fflags_wen[tail_idx]  = 1'b0;
                // Phase 8 S2: slot-1 alloc to tail+1 (younger op of the rename
                // bundle), gated off (i_alloc_en2=0) until S4. Mirrors slot-0
                // exactly with tail1_idx / i_alloc_entry2. Plain-array dynamic
                // writes; tail1_idx = tail_idx+1 so no collision with slot-0.
                if i_alloc_en2 {
                    entries[tail1_idx]        = i_alloc_entry2;
                    sh_valid[tail1_idx]       = i_alloc_entry2.valid;
                    sh_rw[tail1_idx]          = 1'b0;
                    sh_has_rd[tail1_idx]      = i_alloc_entry2.has_rd;
                    sh_illegal[tail1_idx]     = i_alloc_entry2.illegal;
                    sh_mispredict[tail1_idx]  = 1'b0;
                    sh_pc[tail1_idx]          = i_alloc_entry2.pc;
                    sh_rd_arch[tail1_idx]     = i_alloc_entry2.rd_arch;
                    sh_rd_pdst[tail1_idx]     = i_alloc_entry2.rd_pdst;
                    sh_old_rd_pdst[tail1_idx] = i_alloc_entry2.old_rd_pdst;
                    sh_redirect_pc[tail1_idx] = 64'd0;
                    sh_result_data[tail1_idx] = 64'd0;
                    sh_pred_next_pc[tail1_idx] = i_alloc_entry2.pred_next_pc;
                    sh_is_rvc[tail1_idx]       = i_alloc_entry2.is_rvc;
                    sh_is_control[tail1_idx]   = i_alloc_entry2.is_control;
                    sh_is_cond[tail1_idx]      = i_alloc_entry2.is_branch;
                    sh_is_call[tail1_idx]      = i_alloc_entry2.is_call;
                    sh_is_ret[tail1_idx]       = i_alloc_entry2.is_ret;
                    sh_pred_index[tail1_idx]   = i_alloc_entry2.pred_index;
                    sh_is_store[tail1_idx]     = i_alloc_entry2.is_store;
                    sh_is_amo[tail1_idx]       = i_alloc_entry2.is_amo;
                    sh_store_addr[tail1_idx]   = 64'd0;
                    sh_store_data[tail1_idx]   = 64'd0;
                    sh_store_funct3[tail1_idx] = 3'd0;
                    sh_is_csr[tail1_idx]      = i_alloc_entry2.is_csr;
                    sh_csr_addr[tail1_idx]    = i_alloc_entry2.csr_addr;
                    sh_csr_wdata[tail1_idx]   = 64'd0;
                    sh_is_ecall[tail1_idx]    = i_alloc_entry2.is_ecall;
                    sh_is_ebreak[tail1_idx]   = i_alloc_entry2.is_ebreak;
                    sh_is_mret[tail1_idx]     = i_alloc_entry2.is_mret;
                    sh_is_sret[tail1_idx]     = i_alloc_entry2.is_sret;
                    sh_is_sfence[tail1_idx]   = i_alloc_entry2.is_sfence;
                    sh_is_fence_i[tail1_idx]  = i_alloc_entry2.is_fence_i;
                    sh_is_ifault[tail1_idx]   = i_alloc_entry2.is_ifault;
                    sh_is_lfault[tail1_idx]   = 1'b0;
                    sh_is_sfault[tail1_idx]   = 1'b0;
                    sh_fault_vaddr[tail1_idx] = 64'd0;
                    sh_dbg_walk_pc[tail1_idx] = 64'd0;
                    sh_dbg_inj[tail1_idx]     = 1'b0;
                    sh_is_fp_dest[tail1_idx]  = i_alloc_entry2.is_fp_dest;
                    sh_is_fp[tail1_idx]       = i_alloc_entry2.is_fp;
                    sh_fflags[tail1_idx]      = 5'd0;
                    sh_fflags_wen[tail1_idx]  = 1'b0;
                }
                tail      = tail + (if i_alloc_en2 ? 6'd2 : 6'd1);
                alloc_cnt = alloc_cnt + (if i_alloc_en2 ? 32'd2 : 32'd1);
            }
            // CDB writeback (mark entry done)
            if i_cdb_valid {
                entries[i_cdb_rob_idx].result_written = 1'b1;
                entries[i_cdb_rob_idx].result_data    = i_cdb_result_data;
                entries[i_cdb_rob_idx].mispredict     = i_cdb_mispredict;
                entries[i_cdb_rob_idx].redirect_pc    = i_cdb_redirect_pc;
                sh_rw[i_cdb_rob_idx]                  = 1'b1;
                sh_mispredict[i_cdb_rob_idx]          = i_cdb_mispredict;
                sh_redirect_pc[i_cdb_rob_idx]         = i_cdb_redirect_pc;
                sh_result_data[i_cdb_rob_idx]         = i_cdb_result_data;
                sh_is_store[i_cdb_rob_idx]            = i_cdb_is_store;
                sh_store_addr[i_cdb_rob_idx]          = i_cdb_store_addr;
                sh_store_data[i_cdb_rob_idx]          = i_cdb_store_data;
                sh_store_funct3[i_cdb_rob_idx]        = i_cdb_store_funct3;
                sh_is_csr[i_cdb_rob_idx]              = i_cdb_is_csr;
                sh_csr_addr[i_cdb_rob_idx]            = i_cdb_csr_addr;
                sh_csr_wdata[i_cdb_rob_idx]           = i_cdb_csr_wdata;
                // CSR access violation → mark entry as illegal so commit traps.
                if i_cdb_csr_illegal {
                    entries[i_cdb_rob_idx].illegal = 1'b1;
                    sh_illegal[i_cdb_rob_idx]      = 1'b1;
                }
                // dmem MMU page faults — record into shadow so commit
                // stage maps to excp_cause 13 (load) / 15 (store).
                // Suppress the side-effects of the faulted memory op:
                // unset is_store so commit drain doesn't issue the write,
                // and clear has_rd so the PRF write is also skipped (the
                // commit trap path handles the redirect).
                if i_cdb_is_lfault || i_cdb_is_sfault {
                    sh_is_lfault[i_cdb_rob_idx]   = i_cdb_is_lfault;
                    sh_is_sfault[i_cdb_rob_idx]   = i_cdb_is_sfault;
                    sh_fault_vaddr[i_cdb_rob_idx] = i_cdb_fault_vaddr;
                    sh_is_store[i_cdb_rob_idx]    = 1'b0;
                    sh_has_rd[i_cdb_rob_idx]      = 1'b0;
                    entries[i_cdb_rob_idx].has_rd = 1'b0;
                }
                // M6: capture FP exception flags (only when an FP op writes
                // back; fflags_wen low for ALU writebacks leaves these as-is).
                if i_cdb_fflags_wen {
                    sh_fflags[i_cdb_rob_idx]     = i_cdb_fflags;
                    sh_fflags_wen[i_cdb_rob_idx] = 1'b1;
                }
                cdb_cnt2 = cdb_cnt2 + 32'd1;
            }
            // M9.A.294 (F2): load-fault injection (independent of CDB).
            // Delivers a load page fault to the walk-owner's ROB entry and
            // marks it result_written so it can commit-trap. Same side-effect
            // suppression as the CDB fault path (no store drain, no PRF write).
            if i_lfault_inj_v {
                sh_is_lfault[i_lfault_inj_rob]           = 1'b1;
                sh_fault_vaddr[i_lfault_inj_rob]         = i_lfault_inj_vaddr;
                sh_rw[i_lfault_inj_rob]                  = 1'b1;
                entries[i_lfault_inj_rob].result_written = 1'b1;
                sh_is_store[i_lfault_inj_rob]            = 1'b0;
                sh_has_rd[i_lfault_inj_rob]              = 1'b0;
                entries[i_lfault_inj_rob].has_rd         = 1'b0;
                // M9.3 inject-linkage probe: record who started this walk.
                sh_dbg_walk_pc[i_lfault_inj_rob]         = i_lfault_inj_pc;
                sh_dbg_inj[i_lfault_inj_rob]             = 1'b1;
            }
            // Commit. Back-end ack frees the slot. Phase 8 S1: 2-wide — slot-1
            // (head+1) retires alongside slot-0 when the core grants i_commit_ack2
            // (slot-0 retired AND head+1 is a simple integer op = c2_valid).
            if i_commit_ack && !is_empty && sh_rw[head_idx] {
                entries[head_idx].valid = 1'b0;
                sh_valid[head_idx]      = 1'b0;
                if i_commit_ack2 {
                    entries[head1_idx].valid = 1'b0;
                    sh_valid[head1_idx]      = 1'b0;
                    head                     = head + 6'd2;
                    commit_cnt               = commit_cnt + 32'd2;
                } else {
                    head       = head + 6'd1;
                    commit_cnt = commit_cnt + 32'd1;
                }
            }
        }
    }

    assign o_dbg_alloc_cnt  = alloc_cnt;
    assign o_dbg_cdb_cnt    = cdb_cnt2;
    assign o_dbg_commit_cnt = commit_cnt;
}
