// Reorder Buffer: 16-entry circular buffer for in-order commit.
// Supports allocate (tail), complete (by index), commit (head), flush.
// Same-cycle complete+commit bypass: when the completing entry is the head,
// commit output is available immediately (no 1-cycle delay).
//
// Head/tail are 6-bit pointers: [5:4] = wrap counter (epoch), [3:0] = array index.
// 2-bit wrap counter prevents aliasing for up to 64 allocations (4 full wraps).
// Full/empty: head == tail means empty, head[3:0] == tail[3:0] && head[5:4] != tail[5:4] means full.
pub module rob (
    clk: input clock,
    rst: input reset,

    // Allocate: add entry at tail (called at ID stage)
    i_alloc_valid : input  logic    ,
    i_alloc_pc    : input  logic<64>,
    i_alloc_rd    : input  logic<5> ,
    i_alloc_wen   : input  logic    , // instruction writes integer register
    i_alloc_is_fp : input  logic    , // FP instruction
    i_alloc_fp_wen: input  logic    , // instruction writes FP register
    i_alloc_compr : input  logic    , // compressed instruction
    o_alloc_idx   : output logic<4> , // allocated ROB index (tail[3:0])
    o_alloc_epoch : output logic<2> , // allocation epoch (tail[5:4])
    o_alloc_ready : output logic    , // ROB has space (not full)

    // Complete: mark entry as done, write result (called at WB or MSHR)
    i_complete_valid: input logic    ,
    i_complete_idx  : input logic<4> ,
    i_complete_epoch: input logic<2> , // epoch of completing instruction
    i_complete_data : input logic<64>,

    // Exception: mark entry as faulting (called at EX/MEM stage)
    i_exc_valid: input logic    ,
    i_exc_idx  : input logic<4> ,
    i_exc_cause: input logic<64>,

    // Suppress register write (for MSHR-absorbed loads)
    i_suppress_wen_valid: input logic    ,
    i_suppress_wen_idx  : input logic<4> ,

    // Cancel entry: mark as completed with wen=0 (for flushed RS-eligible instructions)
    i_cancel_valid: input logic    ,
    i_cancel_idx  : input logic<4> ,

    // Commit: retire head entry (in-order)
    o_commit_valid : output logic    ,
    o_commit_pc    : output logic<64>,
    o_commit_rd    : output logic<5> ,
    o_commit_data  : output logic<64>,
    o_commit_wen   : output logic    ,
    o_commit_is_fp : output logic    ,
    o_commit_fp_wen: output logic    ,
    o_commit_compr : output logic    ,
    o_commit_exc   : output logic    , // head has exception
    o_commit_cause : output logic<64>,
    o_commit_epoch : output logic<2> , // epoch of committing entry
    i_commit_ack   : input  logic    , // pipeline acknowledges commit

    // Flush: invalidate all entries (on trap/mret/sret)
    i_flush: input logic,

    // Squash: invalidate entries AFTER the given index (on branch misprediction).
    // i_squash_idx is a 5-bit pointer (same format as head/tail).
    i_squash_valid: input logic    ,
    i_squash_idx  : input logic<6> ,

    // Lookup: check if entry is completed (combinational, for RAT stall)
    i_lookup1_idx      : input  logic<4> ,
    o_lookup1_completed: output logic    ,
    o_lookup1_valid    : output logic    ,
    i_lookup2_idx      : input  logic<4> ,
    o_lookup2_completed: output logic    ,
    o_lookup2_valid    : output logic    ,

    // Data read ports (for RS operand resolution at dispatch)
    i_read1_idx      : input  logic<4> ,
    o_read1_data     : output logic<64>,
    o_read1_completed: output logic    ,
    o_read1_valid    : output logic    ,
    o_read1_epoch    : output logic<2> , // wrap_cnt of read1 entry
    i_read2_idx      : input  logic<4> ,
    o_read2_data     : output logic<64>,
    o_read2_completed: output logic    ,
    o_read2_valid    : output logic    ,
    o_read2_epoch    : output logic<2> , // wrap_cnt of read2 entry

    // Squash mask output (for RS cleanup — indexed by 4-bit ROB index)
    o_squash_mask: output logic [16],

    // Status
    o_empty      : output logic,
    o_full       : output logic,
    o_commit_idx : output logic<4>, // ROB index of committed entry (= head[3:0])
) {
    // Entry storage (16 entries)
    var valid    : logic     [16];
    var completed: logic     [16];
    var exception: logic     [16];
    var pc       : logic<64> [16];
    var rd_addr  : logic<5>  [16];
    var rd_data  : logic<64> [16];
    var reg_wen  : logic     [16];
    var is_fp    : logic     [16];
    var fp_wen   : logic     [16];
    var compr    : logic     [16];
    var cause    : logic<64> [16];
    var wrap_cnt : logic<2>  [16]; // wrap counter at allocation time (= tail[5:4])

    // Head and tail pointers (6-bit: [5:4] = wrap counter, [3:0] = index)
    var head: logic<6>;
    var tail: logic<6>;

    // Count: number of valid entries (0..16).
    var count: logic<5>; // 0..16

    // Squash mask: entry i should be squashed if it's in the range
    // (squash_idx, tail) — entries strictly AFTER squash_idx up to tail.
    var squash_mask: logic [16];
    always_comb {
        let sq_dt: logic<6> = tail - i_squash_idx;
        for i: i32 in 0..16 {
            squash_mask[i] = 1'b0;
            if i_squash_valid {
                let sq_di: logic<6> = {2'b0, i[3:0]} - i_squash_idx;
                if sq_di <: sq_dt && sq_di != 6'd0 {
                    squash_mask[i] = 1'b1;
                }
            }
        }
    }

    for i in 0..16 :g_sq_mask {
        assign o_squash_mask[i] = squash_mask[i];
    }

    let head_idx: logic<4> = head[3:0];
    let tail_idx: logic<4> = tail[3:0];

    assign o_empty       = count == 5'd0;
    assign o_full        = count == 5'd16;
    assign o_alloc_ready = count <: 5'd16;
    assign o_alloc_idx   = tail_idx;
    assign o_alloc_epoch = tail[5:4];
    assign o_commit_idx  = head_idx;

    // Same-cycle complete+commit bypass
    let completing_head: logic = i_complete_valid && i_complete_idx == head_idx
                              && valid[head_idx] && !completed[head_idx] && !o_empty
                              && wrap_cnt[head_idx] == i_complete_epoch;

    // Lookup: completed flag with same-cycle bypass
    assign o_lookup1_completed = completed[i_lookup1_idx]
        || (completing_head && i_lookup1_idx == head_idx);
    assign o_lookup2_completed = completed[i_lookup2_idx]
        || (completing_head && i_lookup2_idx == head_idx);
    assign o_lookup1_valid = valid[i_lookup1_idx];
    assign o_lookup2_valid = valid[i_lookup2_idx];

    // Data read ports with same-cycle complete bypass (epoch-guarded).
    // Without epoch check, stale completions from reallocated entries
    // would bypass wrong data to consumers.
    // Only bypass when the entry is NOT yet completed (avoids stale bypass overwriting correct data)
    let read1_bypass: logic = i_complete_valid && i_complete_idx == i_read1_idx
        && valid[i_read1_idx] && !completed[i_read1_idx] && wrap_cnt[i_read1_idx] == i_complete_epoch;
    let read2_bypass: logic = i_complete_valid && i_complete_idx == i_read2_idx
        && valid[i_read2_idx] && !completed[i_read2_idx] && wrap_cnt[i_read2_idx] == i_complete_epoch;
    assign o_read1_data = if read1_bypass ? i_complete_data : rd_data[i_read1_idx];
    assign o_read2_data = if read2_bypass ? i_complete_data : rd_data[i_read2_idx];
    assign o_read1_completed = completed[i_read1_idx]
        || (completing_head && i_read1_idx == head_idx);
    assign o_read1_valid = valid[i_read1_idx];
    assign o_read1_epoch = wrap_cnt[i_read1_idx];
    assign o_read2_completed = completed[i_read2_idx]
        || (completing_head && i_read2_idx == head_idx);
    assign o_read2_valid = valid[i_read2_idx];
    assign o_read2_epoch = wrap_cnt[i_read2_idx];

    // Commit output
    let squash_head: logic = i_squash_valid && squash_mask[head_idx];
    assign o_commit_valid  = !squash_head
        && (completing_head || (!o_empty && valid[head_idx] && completed[head_idx]));
    assign o_commit_pc     = pc[head_idx];
    assign o_commit_rd     = rd_addr[head_idx];
    assign o_commit_data   = if completing_head ? i_complete_data : rd_data[head_idx];
    assign o_commit_wen    = reg_wen[head_idx];
    assign o_commit_is_fp  = is_fp[head_idx];
    assign o_commit_fp_wen = fp_wen[head_idx];
    assign o_commit_compr  = compr[head_idx];
    assign o_commit_exc    = exception[head_idx];
    assign o_commit_cause  = cause[head_idx];
    assign o_commit_epoch  = wrap_cnt[head_idx];

    always_ff (clk, rst) {
        if_reset {
            head  = 6'd0;
            tail  = 6'd0;
            count = 5'd0;
            for i: i32 in 0..16 {
                valid[i]     = 1'b0;
                completed[i] = 1'b0;
                exception[i] = 1'b0;
            }
        } else if i_flush {
            head  = 6'd0;
            tail  = 6'd0;
            count = 5'd0;
            for i: i32 in 0..16 {
                valid[i]     = 1'b0;
                completed[i] = 1'b0;
                exception[i] = 1'b0;
            }
        } else {
            let do_alloc : logic = i_alloc_valid && o_alloc_ready && !i_squash_valid;
            let do_commit: logic = i_commit_ack && o_commit_valid;

            // Complete/exception/cancel BEFORE alloc (last write wins on same index)

            // Complete: epoch guard prevents stale completion from wrong generation
            if i_complete_valid && valid[i_complete_idx] && wrap_cnt[i_complete_idx] == i_complete_epoch {
                completed[i_complete_idx] = 1'b1;
                rd_data[i_complete_idx]   = i_complete_data;
            }

            if i_exc_valid {
                completed[i_exc_idx] = 1'b1;
                exception[i_exc_idx] = 1'b1;
                cause[i_exc_idx]     = i_exc_cause;
            }

            if i_suppress_wen_valid {
                reg_wen[i_suppress_wen_idx] = 1'b0;
            }

            if i_cancel_valid && valid[i_cancel_idx] {
                completed[i_cancel_idx] = 1'b1;
                reg_wen[i_cancel_idx]   = 1'b0;
                fp_wen[i_cancel_idx]    = 1'b0;
            }

            // Allocate at tail (AFTER complete: last write wins)
            if do_alloc {
                valid[tail_idx]     = 1'b1;
                completed[tail_idx] = 1'b0;
                exception[tail_idx] = 1'b0;
                pc[tail_idx]        = i_alloc_pc;
                rd_addr[tail_idx]   = i_alloc_rd;
                reg_wen[tail_idx]   = i_alloc_wen;
                is_fp[tail_idx]     = i_alloc_is_fp;
                fp_wen[tail_idx]    = i_alloc_fp_wen;
                compr[tail_idx]     = i_alloc_compr;
                wrap_cnt[tail_idx]  = tail[5:4];
                rd_data[tail_idx]   = '0;
                cause[tail_idx]     = '0;
                tail = tail + 6'd1;
            }

            // Commit: retire head
            if do_commit {
                valid[head_idx]     = 1'b0;
                completed[head_idx] = 1'b0;
                head = head + 6'd1;
            }

            // Count update
            if i_squash_valid {
                for i: i32 in 0..16 {
                    if squash_mask[i] {
                        valid[i]     = 1'b0;
                        completed[i] = 1'b0;
                        exception[i] = 1'b0;
                    }
                }
                // 6-bit arithmetic: squash_idx - head gives correct count (lower 5 bits)
                let sq_diff: logic<6> = i_squash_idx - head;
                let sq_new_count: logic<5> = sq_diff[4:0];
                tail = i_squash_idx;
                count = if do_commit ? sq_new_count - 5'd1 : sq_new_count;
            } else if do_alloc && do_commit {
                // Net change: 0
            } else if do_alloc {
                count = count + 5'd1;
            } else if do_commit {
                count = count - 5'd1;
            }
        }
    }
}
