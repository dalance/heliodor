// IEEE 754 double-precision floating-point divider
// Iterative restoring divider, radix-4 (two quotient bits per RUN cycle), so
// the combinational path is two chained 64-bit subtract/compares instead of the
// former 55-deep unrolled chain. Bit-exact with the original restoring math.
// Latency: 1 (capture + normalize + iter 0) + 27 (RUN, two iters each) + 1 (DONE) = 29.
pub module fp_divider (
    clk: input clock,
    rst: input reset,

    i_valid: input logic    , // start new division (pulse)
    i_a    : input logic<64>,
    i_b    : input logic<64>,
    i_rm   : input logic<3> ,
    i_flush: input logic    , // abort current operation

    o_result: output logic<64>,
    o_fflags: output logic<5> , // {NV, DZ, OF, UF, NX}
    o_valid : output logic    , // result ready (1-cycle pulse)
    o_busy  : output logic    , // divider occupied
) {
    enum State: logic<2> {
        IDLE = 2'd0,
        RUN = 2'd1,
        DONE = 2'd2,
    }

    var state    : State   ;
    var count    : logic<6>;
    var latched_m: logic<3>;

    // Operand-derived state captured at IDLE and held stable through RUN/DONE.
    var reg_sig_b         : logic<53>; // normalized divisor (iteration compare/subtract)
    var reg_ea_eff        : logic<13>;
    var reg_eb_eff        : logic<13>;
    var reg_r_sign        : logic    ;
    var reg_is_special    : logic    ; // NaN/inf/zero/div-by-zero short-circuit
    var reg_special_result: logic<64>;
    var reg_special_fflags: logic<5> ;

    // Iteration state, advanced two restoring-division steps per RUN cycle.
    var it_rem : logic<64>; // running remainder
    var it_quot: logic<56>; // running quotient (bit 55 set at init, 54..0 shifted in)

    // Busy while RUN or DONE — caller must not re-dispatch until o_valid.
    assign o_busy = state != State::IDLE;

    // 27 RUN cycles (two quotient bits each) then DONE — 29 total.
    const RUN_LAST: logic<6> = 6'd26;

    // Overflow result per rounding mode (IEEE/RISC-V): RNE/RMM -> inf,
    // RTZ -> max normal, RDN -> +max/-inf, RUP -> +inf/-max.
    function ovf_d (
        rm : input logic<3>,
        sgn: input logic   ,
    ) -> logic<64> {
        var r  : logic<64>;
        let inf: logic<64> = {sgn, 11'h7FF, 52'd0};
        let mx : logic<64> = {sgn, 11'h7FE, 52'hFFFFFFFFFFFFF};
        case rm {
            3'b001 : r = mx;
            3'b010 : r = if sgn ? inf : mx;
            3'b011 : r = if sgn ? mx : inf;
            default: r = inf;
        }
        return r;
    }

    // ====================================================================
    // Setup: unpack/classify the live operands and produce the normalized
    // significands, effective exponents, special-case result, and the
    // pre-loop initial remainder + top quotient bit + iteration 0 (folded in
    // so RUN runs an even 54 iterations at two per cycle). Combinational off
    // i_a/i_b; sampled into the reg_*/it_* registers when IDLE accepts a job.
    // ====================================================================
    var su_is_special    : logic    ;
    var su_special_result: logic<64>;
    var su_special_fflags: logic<5> ;
    var su_ea_eff        : logic<13>;
    var su_eb_eff        : logic<13>;
    var su_r_sign        : logic    ;
    var su_sig_b         : logic<53>;
    var su_init_rem      : logic<64>;
    var su_init_quot     : logic<56>;

    always_comb {
        var sa: logic    ;
        var ea: logic<11>;
        var ma: logic<52>;
        var sb: logic    ;
        var eb: logic<11>;
        var mb: logic<52>;

        sa = i_a[63];
        ea = i_a[62:52];
        ma = i_a[51:0];
        sb = i_b[63];
        eb = i_b[62:52];
        mb = i_b[51:0];

        su_r_sign = sa ^ sb;

        // Classify
        var a_is_zero: logic;
        var b_is_zero: logic;
        var a_is_inf : logic;
        var b_is_inf : logic;
        var a_is_nan : logic;
        var b_is_nan : logic;
        var a_is_snan: logic;
        var b_is_snan: logic;
        var a_is_sub : logic;
        var b_is_sub : logic;

        a_is_zero = ea == 11'd0 && ma == 52'd0;
        b_is_zero = eb == 11'd0 && mb == 52'd0;
        a_is_inf  = ea == 11'h7FF && ma == 52'd0;
        b_is_inf  = eb == 11'h7FF && mb == 52'd0;
        a_is_nan  = ea == 11'h7FF && ma != 52'd0;
        b_is_nan  = eb == 11'h7FF && mb != 52'd0;
        a_is_snan = a_is_nan && ma[51] == 1'b0;
        b_is_snan = b_is_nan && mb[51] == 1'b0;
        a_is_sub  = ea == 11'd0 && ma != 52'd0;
        b_is_sub  = eb == 11'd0 && mb != 52'd0;

        su_is_special     = 1'b0;
        su_special_result = 64'd0;
        su_special_fflags = 5'd0;
        su_ea_eff         = 13'd0;
        su_eb_eff         = 13'd0;
        su_sig_b          = 53'd0;
        su_init_rem       = 64'd0;
        su_init_quot      = 56'd0;

        if a_is_nan || b_is_nan {
            su_is_special     = 1'b1;
            su_special_result = 64'h7FF8_0000_0000_0000;
            if a_is_snan || b_is_snan {
                su_special_fflags = 5'b10000;
            }
        } else if a_is_inf && b_is_inf {
            su_is_special     = 1'b1;
            su_special_result = 64'h7FF8_0000_0000_0000; // inf/inf = NaN
            su_special_fflags = 5'b10000;
        } else if a_is_inf {
            su_is_special     = 1'b1;
            su_special_result = {su_r_sign, 11'h7FF, 52'd0}; // inf/x = inf
        } else if b_is_inf {
            su_is_special     = 1'b1;
            su_special_result = {su_r_sign, 63'd0}; // x/inf = 0
        } else if b_is_zero {
            su_is_special = 1'b1;
            if a_is_zero {
                su_special_result = 64'h7FF8_0000_0000_0000; // 0/0 = NaN
                su_special_fflags = 5'b10000;
            } else {
                su_special_result = {su_r_sign, 11'h7FF, 52'd0}; // x/0 = inf
                su_special_fflags = 5'b01000; // DZ
            }
        } else if a_is_zero {
            su_is_special     = 1'b1;
            su_special_result = {su_r_sign, 63'd0}; // 0/x = 0
        } else {
            // Normal/subnormal division setup
            var ea_eff: logic<13>;
            var eb_eff: logic<13>;
            if a_is_sub {
                ea_eff = 13'd1;
            } else {
                ea_eff = {2'd0, ea};
            }
            if b_is_sub {
                eb_eff = 13'd1;
            } else {
                eb_eff = {2'd0, eb};
            }

            var sig_a: logic<53>;
            var sig_b: logic<53>;
            if a_is_sub {
                sig_a = {1'b0, ma};
            } else {
                sig_a = {1'b1, ma};
            }
            if b_is_sub {
                sig_b = {1'b0, mb};
            } else {
                sig_b = {1'b1, mb};
            }

            // Normalize subnormals by finding leading 1
            var lz_a: logic<6>;
            var lz_b: logic<6>;
            lz_a = 6'd0;
            lz_b = 6'd0;
            if a_is_sub {
                lz_a = 6'd53;
                for i in 0..53 {
                    if sig_a[52 - i] == 1'b1 && lz_a == 6'd53 {
                        lz_a = i[5:0];
                    }
                }
                sig_a  = sig_a << lz_a;
                ea_eff = ea_eff - {7'd0, lz_a};
            }
            if b_is_sub {
                lz_b = 6'd53;
                for i in 0..53 {
                    if sig_b[52 - i] == 1'b1 && lz_b == 6'd53 {
                        lz_b = i[5:0];
                    }
                }
                sig_b  = sig_b << lz_b;
                eb_eff = eb_eff - {7'd0, lz_b};
            }

            su_ea_eff = ea_eff;
            su_eb_eff = eb_eff;
            su_sig_b  = sig_b;

            // Pre-loop step: the restoring-division invariant requires
            // `remainder < sig_b` at every iteration start, so pre-subtract
            // sig_b and set the top quotient bit when sig_a >= sig_b.
            var rem0: logic<64>;
            var q55 : logic    ;
            if sig_a >= sig_b {
                rem0 = {11'd0, sig_a - sig_b};
                q55  = 1'b1;
            } else {
                rem0 = {11'd0, sig_a};
                q55  = 1'b0;
            }
            // Iteration 0, folded into IDLE (leaves an even 54 iterations for RUN).
            var rem0_sh     : logic<64>;
            var b0          : logic    ;
            rem0_sh      = {rem0[62:0], 1'b0};
            b0           = rem0_sh >= {11'd0, sig_b};
            su_init_rem  = if b0 ? rem0_sh - {11'd0, sig_b} : rem0_sh;
            su_init_quot = {q55, 54'd0, b0};
        }
    }

    // ====================================================================
    // Two restoring-division steps per RUN cycle (radix-4). Each step shifts
    // the remainder left, conditionally subtracts the divisor, and emits one
    // quotient bit; the two bits shift into the low 54 bits of it_quot (bit 55
    // is the pre-loop bit and is preserved).
    // ====================================================================
    var nxt_rem : logic<64>;
    var nxt_quot: logic<56>;

    always_comb {
        var r1      : logic<64>;
        var b1      : logic    ;
        var r1b     : logic<64>;
        var r2      : logic<64>;
        var b2      : logic    ;
        r1       = {it_rem[62:0], 1'b0};
        b1       = r1 >= {11'd0, reg_sig_b};
        r1b      = if b1 ? r1 - {11'd0, reg_sig_b} : r1;
        r2       = {r1b[62:0], 1'b0};
        b2       = r2 >= {11'd0, reg_sig_b};
        nxt_rem  = if b2 ? r2 - {11'd0, reg_sig_b} : r2;
        nxt_quot = {it_quot[55], it_quot[52:0], b1, b2};
    }

    // ====================================================================
    // Finalize: assemble the rounded result from the final remainder /
    // quotient. Combinational off the iteration/setup registers; sampled
    // into o_result in DONE.
    // ====================================================================
    var fin_result: logic<64>;
    var fin_fflags: logic<5> ;

    always_comb {
        fin_result = 64'd0;
        fin_fflags = 5'd0;

        if reg_is_special {
            fin_result = reg_special_result;
            fin_fflags = reg_special_fflags;
        } else {
            var quotient : logic<56>;
            var remainder: logic<64>;
            quotient  = it_quot;
            remainder = it_rem;

            // quotient[55] should be 1 (or quotient[54] if sig_a < sig_b)
            var q_exp: logic<13>;
            q_exp = reg_ea_eff - reg_eb_eff + 13'd1023;

            var q_mant: logic<56>;
            if quotient[55] {
                q_mant = quotient;
            } else {
                // sig_a < sig_b: quotient < 1, shift left
                q_mant = {quotient[54:0], 1'b0};
                q_exp  = q_exp - 13'd1;
            }

            // Sticky from remainder
            var sticky_rem: logic;
            sticky_rem = remainder != 64'd0;
            q_mant     = {q_mant[55:1], q_mant[0] | sticky_rem};

            // Check for subnormal result. Signed compare: a tiny dividend over
            // a huge divisor drives q_exp negative (deep underflow); unsigned it
            // wrapped to a large positive and skipped this path, falling through
            // to the overflow test (→ ∞). Positive range here is ≤3068, so the
            // sign bit is unambiguous.
            if $signed(q_exp) <= 13'sd0 {
                var sub_shift: logic<13>;
                sub_shift = 13'd1 - q_exp;
                var sub_sc   : logic<6>;
                if sub_shift >: 13'd56 {
                    sub_sc = 6'd56;
                } else {
                    sub_sc = sub_shift[5:0];
                }
                var sub_sticky: logic;
                sub_sticky = (q_mant & ((56'd1 << sub_sc) - 56'd1)) != 56'd0;
                q_mant     = q_mant >> sub_sc;
                q_mant     = {q_mant[55:1], q_mant[0] | sub_sticky};
                q_exp      = 13'd0;
            }

            // Rounding
            var g       : logic;
            var r       : logic;
            var s       : logic;
            var bit_lsb : logic;
            g        = q_mant[2];
            r        = q_mant[1];
            s        = q_mant[0];
            bit_lsb  = q_mant[3];
            var round_up: logic;
            case latched_m {
                3'b000 : round_up = g && (r || s || bit_lsb);
                3'b001 : round_up = 1'b0;
                3'b010 : round_up = reg_r_sign && (g || r || s);
                3'b011 : round_up = !reg_r_sign && (g || r || s);
                3'b100 : round_up = g;
                default: round_up = g && (r || s || bit_lsb);
            }
            var rounded: logic<53>;
            rounded = q_mant[55:3] + {52'd0, round_up};
            if rounded[52] && !q_mant[55] {
                q_exp = q_exp + 13'd1;
            }
            var nx: logic;
            nx = g || r || s;

            if q_exp >= 13'd2047 {
                fin_result = ovf_d(latched_m, reg_r_sign);
                fin_fflags = 5'b00101;
            } else {
                fin_result = {reg_r_sign, q_exp[10:0], rounded[51:0]};
                if nx {
                    fin_fflags = 5'b00001;
                }
                if q_exp == 13'd0 && nx {
                    fin_fflags = 5'b00011;
                }
            }
        }
    }

    // ====================================================================
    // FSM: capture + normalize + iter 0 (IDLE), two restoring-division
    // iterations per RUN cycle, present the result (DONE).
    // ====================================================================
    always_ff (clk, rst) {
        if_reset {
            state              = State::IDLE;
            count              = '0;
            latched_m          = '0;
            reg_sig_b          = '0;
            reg_ea_eff         = '0;
            reg_eb_eff         = '0;
            reg_r_sign         = '0;
            reg_is_special     = '0;
            reg_special_result = '0;
            reg_special_fflags = '0;
            it_rem             = '0;
            it_quot            = '0;
            o_result           = '0;
            o_fflags           = '0;
            o_valid            = 1'b0;
        } else if i_flush {
            state   = State::IDLE;
            count   = '0;
            o_valid = 1'b0;
        } else {
            o_valid = 1'b0; // default: pulse

            case state {
                State::IDLE: {
                    if i_valid {
                        latched_m          = i_rm;
                        reg_sig_b          = su_sig_b;
                        reg_ea_eff         = su_ea_eff;
                        reg_eb_eff         = su_eb_eff;
                        reg_r_sign         = su_r_sign;
                        reg_is_special     = su_is_special;
                        reg_special_result = su_special_result;
                        reg_special_fflags = su_special_fflags;
                        it_rem             = su_init_rem;
                        it_quot            = su_init_quot;
                        count              = '0;
                        state              = State::RUN;
                    }
                }
                State::RUN: {
                    it_rem  = nxt_rem;
                    it_quot = nxt_quot;
                    if count == RUN_LAST {
                        state = State::DONE;
                    } else {
                        count = count + 6'd1;
                    }
                }
                State::DONE: {
                    o_result = fin_result;
                    o_fflags = fin_fflags;
                    o_valid  = 1'b1;
                    state    = State::IDLE;
                }
                default: {
                    state = State::IDLE;
                }
            }
        }
    }
}
