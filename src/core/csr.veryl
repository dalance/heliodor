// Phase 7 v4: minimal CSR file (M-mode only, M4).
//
// Implements the subset of M-mode CSRs sufficient for rv64ui-* startup:
//   mhartid (RO, 0)
//   mtvec, mstatus, mscratch, mepc, mcause, mtval, mie, mip
//   mcycle, minstret (counters, free-running)
//   misa (RO, return 0)
//   medeleg, mideleg (RW, accept writes — Phase 5+ wires them to
//                     trap_delegate logic; M4 keeps them as plain RW)
//   pmpcfg0, pmpaddr0 (RW, accept writes — no enforcement)
//   satp (RW, no MMU enforcement until M5)
//
// All other addresses return 0 on read and silently drop writes (so
// rv64ui startup does not trap on unknown CSR ops). M5+ MMU wires
// satp into the page-walker; for M4 it is just a register.
//
// Read port is combinational; write port is registered (commit-time).
// Trap entry / MRET updates also go through the registered write
// path; the caller (heliodor_core commit stage) drives i_trap_fire
// + i_mret_fire pulses.
pub module csr #(
    param HART_ID: u8 = 0,
) (
    clk: input clock,
    rst: input reset,

    // Combinational read (issue-time CSR value sample)
    i_rd_addr: input  logic<12>,
    o_rd_data: output logic<64>,

    // Registered CSR write (commit-time)
    i_wr_en  : input logic    ,
    i_wr_addr: input logic<12>,
    i_wr_data: input logic<64>,

    // External mtime (from CLINT) — read via CSR_TIME (0xC01). Without
    // this Linux delay loops never break because rdtime returns mcycle
    // (= per-instr counter, never matches mtime-based target).
    i_mtime: input logic<64>,

    // Trap entry (commit-time)
    i_trap_fire : input logic    ,
    i_trap_pc   : input logic<64>, // → mepc
    i_trap_cause: input logic<64>, // → mcause
    i_trap_tval : input logic<64>, // → mtval

    // MRET (commit-time): restore PC from mepc, restore mstatus[MIE]
    // from mstatus[MPIE], priv ← MPP
    i_mret_fire: input logic,
    // SRET (commit-time): restore priv ← SPP, SIE ← SPIE
    i_sret_fire: input logic,

    // mtvec for trap redirect target
    o_mtvec    : output logic<64>,
    o_mepc     : output logic<64>,
    o_stvec    : output logic<64>,
    o_dbg_stval: output logic<64>,
    o_dbg_mtval: output logic<64>,
    o_sepc     : output logic<64>,
    // Trap delegation decision (commit logic reads to pick mtvec vs stvec)
    o_medeleg: output logic<64>,
    o_mideleg: output logic<64>,

    // M5.C: MMU integration — satp + priv + mstatus permission bits.
    // M5.D: priv is now tracked here via i_trap_fire / i_mret_fire /
    // i_sret_fire and exposed through o_priv. trap_delegate_s indicates
    // the current trap fires into S-mode (caller picks stvec / scause /
    // sepc / stval write paths).
    o_satp: output logic             <64>,
    o_priv: output csr_pkg::PrivLevel    ,
    // M9.A.304: previous-cycle privilege snapshot (registered). Used by the
    // core's commit-time trap-delegation logic for SYNC exceptions (ECALL
    // cause + medeleg gate) to avoid the simulator cross-module comb eval-order
    // hazard of reading the LIVE `priv` that the trap-entry always_ff updates
    // in the same settling window — mirrors v1's csr.veryl priv_lvl_q.
    o_priv_prev  : output csr_pkg::PrivLevel,
    o_mstatus_sum: output logic             ,
    o_mstatus_mxr: output logic             ,
    // MPRV (bit 17) and MPP (bits 12:11) for effective-priv computation:
    // loads/stores in M-mode with MPRV=1 use MPP's priv level for
    // address translation / permission. Required for rv64si-dirty etc.
    o_mstatus_mprv: output logic   ,
    o_mstatus_mpp : output logic<2>,
    o_mstatus_tvm : output logic   , // Trap Virtual Memory (satp/sfence.vma in S-mode)
    o_mstatus_tsr : output logic   , // Trap SRET (sret in S-mode)
    o_mstatus_fs  : output logic<2>, // FP unit state (00=Off → FP traps illegal)
    // M5.D delegation decision: 1 if the current trap should go to S-mode
    // (medeleg bit for this cause set AND current priv ∈ {S, U}).
    i_trap_to_s: input logic,

    // M8.C IRQ source pins (from CLINT / PLIC). They set the
    // corresponding mip bits when asserted; mip CSR writes still
    // override (handler can clear via csrw mip, 0).
    i_irq_timer_m: input logic,
    i_irq_sw_m   : input logic,
    i_irq_ext_m  : input logic,

    // M8.C IRQ pending → trap decision (computed here, used by commit
    // stage to fire an interrupt trap when no synchronous trap fires).
    o_irq_pending: output logic    ,
    o_irq_cause  : output logic<64>, // MSB set + cause num
    o_irq_to_s   : output logic    , // delegated to S-mode

    // commit_instret pulse (for counter increment)
    i_instret_en: input logic,

    // M6: F/D fcsr. o_frm feeds the FPU's dynamic rounding mode. fflags are
    // OR-accrued from committing FP ops (i_fflags_set pulse + i_fflags), and
    // an FP commit marks mstatus.FS dirty.
    o_frm       : output logic<3>,
    i_fflags_set: input  logic   ,
    i_fflags    : input  logic<5>,
) {
    // === CSR address constants (subset) ===
    const ADDR_FFLAGS  : logic<12> = 12'h001;
    const ADDR_FRM     : logic<12> = 12'h002;
    const ADDR_FCSR    : logic<12> = 12'h003;
    const ADDR_MHARTID : logic<12> = 12'hF14;
    const ADDR_MSTATUS : logic<12> = 12'h300;
    const ADDR_MISA    : logic<12> = 12'h301;
    const ADDR_MEDELEG : logic<12> = 12'h302;
    const ADDR_MIDELEG : logic<12> = 12'h303;
    const ADDR_MIE     : logic<12> = 12'h304;
    const ADDR_MTVEC   : logic<12> = 12'h305;
    const ADDR_MSCRATCH: logic<12> = 12'h340;
    const ADDR_MEPC    : logic<12> = 12'h341;
    const ADDR_MCAUSE  : logic<12> = 12'h342;
    const ADDR_MTVAL   : logic<12> = 12'h343;
    const ADDR_MIP     : logic<12> = 12'h344;
    const ADDR_PMPCFG0 : logic<12> = 12'h3A0;
    const ADDR_PMPADDR0: logic<12> = 12'h3B0;
    const ADDR_SATP    : logic<12> = 12'h180;
    // M5.D S-mode CSRs
    const ADDR_SSTATUS   : logic<12> = 12'h100;
    const ADDR_SIE       : logic<12> = 12'h104;
    const ADDR_STVEC     : logic<12> = 12'h105;
    const ADDR_SCOUNTEREN: logic<12> = 12'h106;
    const ADDR_SSCRATCH  : logic<12> = 12'h140;
    const ADDR_SEPC      : logic<12> = 12'h141;
    const ADDR_SCAUSE    : logic<12> = 12'h142;
    const ADDR_STVAL     : logic<12> = 12'h143;
    const ADDR_SIP       : logic<12> = 12'h144;
    const ADDR_MCYCLE    : logic<12> = 12'hB00;
    const ADDR_MINSTRET  : logic<12> = 12'hB02;
    const ADDR_TIME      : logic<12> = 12'hC01; // user time (== mtime)
    const ADDR_CYCLE     : logic<12> = 12'hC00;
    const ADDR_INSTRET   : logic<12> = 12'hC02;

    // M5.D current privilege level
    var priv: csr_pkg::PrivLevel;
    // M9.A.304: 1-cycle-delayed snapshot of priv, captured at the TOP of the
    // registered always_ff (before any trap/mret/sret update). The core reads
    // this (not the live priv) for sync-exception delegation, so the eval order
    // of this block vs the core's commit comb cannot corrupt the decision.
    var priv_prev: csr_pkg::PrivLevel;

    // === Registered CSRs ===
    var mstatus : logic<64>;
    var mie     : logic<64>;
    var mtvec   : logic<64>;
    var mscratch: logic<64>;
    var mepc    : logic<64>;
    var mcause  : logic<64>;
    var mtval   : logic<64>;
    var mip     : logic<64>;
    var medeleg : logic<64>;
    var mideleg : logic<64>;
    var pmpcfg0 : logic<64>;
    var pmpaddr0: logic<64>;
    var satp    : logic<64>;
    var mcycle  : logic<64>;
    var minstret: logic<64>;
    // M6: fcsr — bits [7:5] = frm (rounding mode), [4:0] = fflags (NV DZ OF UF NX)
    var fcsr: logic<64>;
    // M5.D S-mode independent CSRs (sstatus/sie/sip are views of mstatus/mie/mip)
    var stvec     : logic<64>;
    var sscratch  : logic<64>;
    var sepc      : logic<64>;
    var scause    : logic<64>;
    var stval     : logic<64>;
    var scounteren: logic<64>;
    // sstatus visible bits: SIE(1), SPIE(5), SPP(8), FS(14:13), XS(16:15),
    // SUM(18), MXR(19), UXL(33:32), SD(63). UXL is read-only for RV64.
    const SSTATUS_MASK: logic<64> = 64'h8000_0003_000d_e162;
    // sie/sip visible bits: SSIE/SSIP(1), STIE/STIP(5), SEIE/SEIP(9)
    const SI_MASK: logic<64> = 64'h0000_0000_0000_0222;
    // RV64 SXL/UXL = 2 (XLEN=64), required by spec for RV64 cores.
    const MSTATUS_XL_RO: logic<64> = 64'h0000_000a_0000_0000;
    // SSTATUS UXL bits only ([33:32])
    const SSTATUS_XL_RO: logic<64> = 64'h0000_0002_0000_0000;

    // === Combinational read ===
    var rd_data_w: logic<64>;
    always_comb {
        case i_rd_addr {
            ADDR_FFLAGS    : rd_data_w = {59'd0, fcsr[4:0]};
            ADDR_FRM       : rd_data_w = {61'd0, fcsr[7:5]};
            ADDR_FCSR      : rd_data_w = {56'd0, fcsr[7:0]};
            ADDR_MHARTID   : rd_data_w = {56'd0, HART_ID};
            ADDR_MSTATUS   : rd_data_w = mstatus | MSTATUS_XL_RO;
            // RV64 MXL=2 in [63:62]; extensions: A=bit 0, I=bit 8, M=bit 12
            // (S/U added in M5.D). misa = 0x8000_0000_0000_1101 for RV64IMA.
            // S + U bit added once S-mode usable (M5.D)
            ADDR_MISA      : rd_data_w = 64'h8000_0000_0014_1101;
            // S-mode CSRs: sstatus/sie/sip are masked views; others standalone.
            ADDR_SSTATUS   : rd_data_w = (mstatus & SSTATUS_MASK) | SSTATUS_XL_RO;
            ADDR_SIE       : rd_data_w = mie & SI_MASK;
            ADDR_STVEC     : rd_data_w = stvec;
            ADDR_SCOUNTEREN: rd_data_w = scounteren;
            ADDR_SSCRATCH  : rd_data_w = sscratch;
            ADDR_SEPC      : rd_data_w = sepc;
            ADDR_SCAUSE    : rd_data_w = scause;
            ADDR_STVAL     : rd_data_w = stval;
            ADDR_SIP       : rd_data_w = mip & SI_MASK;
            ADDR_MEDELEG   : rd_data_w = medeleg;
            ADDR_MIDELEG   : rd_data_w = mideleg;
            ADDR_MIE       : rd_data_w = mie;
            ADDR_MTVEC     : rd_data_w = mtvec;
            ADDR_MSCRATCH  : rd_data_w = mscratch;
            ADDR_MEPC      : rd_data_w = mepc;
            ADDR_MCAUSE    : rd_data_w = mcause;
            ADDR_MTVAL     : rd_data_w = mtval;
            ADDR_MIP       : rd_data_w = mip;
            ADDR_PMPCFG0   : rd_data_w = pmpcfg0;
            ADDR_PMPADDR0  : rd_data_w = pmpaddr0;
            ADDR_SATP      : rd_data_w = satp;
            ADDR_MCYCLE    : rd_data_w = mcycle;
            ADDR_MINSTRET  : rd_data_w = minstret;
            ADDR_TIME      : rd_data_w = i_mtime; // external clint mtime
            ADDR_CYCLE     : rd_data_w = mcycle; // alias
            ADDR_INSTRET   : rd_data_w = minstret;
            default        : rd_data_w = 64'd0;
        }
    }
    // M8.C IRQ pending logic. mip[h/w-driven bits] OR with i_irq_*; the
    // CSR-written value still flows because mip is RW (handler clears).
    // mip layout: bit 1=SSIP, 3=MSIP, 5=STIP, 7=MTIP, 9=SEIP, 11=MEIP.
    let mip_eff : logic<64> = mip | (if i_irq_sw_m ? 64'h0008 : 64'd0) | (if i_irq_timer_m ? 64'h0080 : 64'd0)
        | (if i_irq_ext_m ? 64'h0800 : 64'd0);
    let mie_pend: logic<64> = mip_eff & mie;
    // M-mode global enable: MIE for M-priv; always enabled if priv < M.
    // S-mode global enable: SIE for S-priv (only when not delegated to M).
    let m_irqs_visible: logic<64> = mie_pend & ~mideleg;
    let s_irqs_visible: logic<64> = mie_pend & mideleg;
    let m_irq_gate    : logic     = (priv != csr_pkg::PrivLevel::MACHINE) || (mstatus[3] == 1'b1);
    let s_irq_gate    : logic     = (priv == csr_pkg::PrivLevel::USER)
        || (priv == csr_pkg::PrivLevel::SUPERVISOR && mstatus[1] == 1'b1);
    let m_irq_active  : logic     = m_irq_gate && (m_irqs_visible != 64'd0);
    let s_irq_active  : logic     = s_irq_gate && (s_irqs_visible != 64'd0);
    // Priority order (high → low): MEI MSI MTI SEI SSI STI
    var m_cause_w: logic<6>;
    always_comb {
        if m_irqs_visible[11] {
            m_cause_w = 6'd11;
        } else if m_irqs_visible[3] {
            m_cause_w = 6'd3;
        } else if m_irqs_visible[7] {
            m_cause_w = 6'd7;
        } else if m_irqs_visible[9] {
            m_cause_w = 6'd9;
        } else if m_irqs_visible[1] {
            m_cause_w = 6'd1;
        } else if m_irqs_visible[5] {
            m_cause_w = 6'd5;
        } else {
            m_cause_w = 6'd0;
        }
    }
    var s_cause_w: logic<6>;
    always_comb {
        if s_irqs_visible[9] {
            s_cause_w = 6'd9;
        } else if s_irqs_visible[1] {
            s_cause_w = 6'd1;
        } else if s_irqs_visible[5] {
            s_cause_w = 6'd5;
        } else {
            s_cause_w = 6'd0;
        }
    }
    assign o_irq_pending = m_irq_active || s_irq_active;
    assign o_irq_to_s    = !m_irq_active && s_irq_active;
    assign o_irq_cause   = if m_irq_active ? {1'b1, 57'd0, m_cause_w} : {1'b1, 57'd0, s_cause_w};

    assign o_rd_data      = rd_data_w;
    assign o_mtvec        = mtvec;
    assign o_mepc         = mepc;
    assign o_stvec        = stvec;
    assign o_dbg_stval    = stval;
    assign o_dbg_mtval    = mtval;
    assign o_sepc         = sepc;
    assign o_satp         = satp;
    assign o_medeleg      = medeleg;
    assign o_mideleg      = mideleg;
    assign o_priv         = priv;
    assign o_priv_prev    = priv_prev;
    assign o_mstatus_sum  = mstatus[18];
    assign o_mstatus_mxr  = mstatus[19];
    assign o_mstatus_mprv = mstatus[17];
    assign o_mstatus_mpp  = mstatus[12:11];
    assign o_mstatus_tvm  = mstatus[20];
    assign o_mstatus_tsr  = mstatus[22];
    assign o_mstatus_fs   = mstatus[14:13];
    assign o_frm          = fcsr[7:5];

    // === Registered writes + trap entry + counters ===
    always_ff (clk, rst) {
        if_reset {
            priv      = csr_pkg::PrivLevel::MACHINE;
            priv_prev = csr_pkg::PrivLevel::MACHINE;
            // M9.A.270: match v1 mstatus reset value.
            //   bits 35:34 SXL = 2 (= 64-bit S-mode XLEN)
            //   bits 33:32 UXL = 2 (= 64-bit U-mode XLEN)
            //   bit 13     FS bit 0 = 1 (FS = Initial)
            // RV64 requires SXL/UXL = 2 (Sv*). v4 previously reset to 0
            // (= invalid for RV64) which caused boot divergence vs v1 at
            // the very first csrw mstatus (cy 0x29) — discovered via
            // M9.A.269 cosim early retire ring comparison.
            mstatus    = 64'h0000000A00002000;
            mie        = 64'd0;
            mtvec      = 64'd0;
            mscratch   = 64'd0;
            mepc       = 64'd0;
            mcause     = 64'd0;
            mtval      = 64'd0;
            mip        = 64'd0;
            medeleg    = 64'd0;
            mideleg    = 64'd0;
            pmpcfg0    = 64'd0;
            pmpaddr0   = 64'd0;
            satp       = 64'd0;
            mcycle     = 64'd0;
            minstret   = 64'd0;
            fcsr       = 64'd0;
            stvec      = 64'd0;
            sscratch   = 64'd0;
            sepc       = 64'd0;
            scause     = 64'd0;
            stval      = 64'd0;
            scounteren = 64'd0;
        } else {
            // M9.A.304: snapshot priv BEFORE any trap/mret/sret update below.
            priv_prev = priv;
            // Trap entry (priority over CSR write since trap fires
            // commit-time and writes mepc/mcause/mtval atomically).
            // M5.D: if i_trap_to_s, the trap is delegated to S-mode —
            // update sepc/scause/stval + sstatus (SPP/SPIE/SIE) and
            // priv ← S. Else fall to M-mode handler.
            if i_trap_fire {
                if i_trap_to_s {
                    sepc   = i_trap_pc;
                    scause = i_trap_cause;
                    stval  = i_trap_tval;
                    // sstatus: SPIE ← SIE (bit 5 ← bit 1), SIE ← 0
                    mstatus[5] = mstatus[1];
                    mstatus[1] = 1'b0;
                    // SPP (bit 8) ← current priv: 0=U, 1=S
                    mstatus[8] = if priv == csr_pkg::PrivLevel::SUPERVISOR ? 1'b1 : 1'b0;
                    priv       = csr_pkg::PrivLevel::SUPERVISOR;
                } else {
                    mepc   = i_trap_pc;
                    mcause = i_trap_cause;
                    mtval  = i_trap_tval;
                    // mstatus: MPIE ← MIE (bit 7 ← bit 3), MIE ← 0
                    mstatus[7] = mstatus[3];
                    mstatus[3] = 1'b0;
                    // MPP (bits 12:11) ← current priv encoding (M=11, S=01, U=00)
                    if priv == csr_pkg::PrivLevel::MACHINE {
                        mstatus[12] = 1'b1;
                        mstatus[11] = 1'b1;
                    } else if priv == csr_pkg::PrivLevel::SUPERVISOR {
                        mstatus[12] = 1'b0;
                        mstatus[11] = 1'b1;
                    } else {
                        mstatus[12] = 1'b0;
                        mstatus[11] = 1'b0;
                    }
                    priv = csr_pkg::PrivLevel::MACHINE;
                }
            } else if i_mret_fire {
                // mstatus: MIE ← MPIE, MPIE ← 1; priv ← MPP; MPP ← U
                mstatus[3] = mstatus[7];
                mstatus[7] = 1'b1;
                if mstatus[12] == 1'b1 && mstatus[11] == 1'b1 {
                    priv = csr_pkg::PrivLevel::MACHINE;
                } else if mstatus[12] == 1'b0 && mstatus[11] == 1'b1 {
                    priv = csr_pkg::PrivLevel::SUPERVISOR;
                } else {
                    priv = csr_pkg::PrivLevel::USER;
                }
                // MPP ← U (00)
                mstatus[12] = 1'b0;
                mstatus[11] = 1'b0;
            } else if i_sret_fire {
                // sstatus: SIE ← SPIE, SPIE ← 1; priv ← SPP (1=S, 0=U); SPP ← U
                mstatus[1] = mstatus[5];
                mstatus[5] = 1'b1;
                priv       = if mstatus[8] == 1'b1 ? csr_pkg::PrivLevel::SUPERVISOR : csr_pkg::PrivLevel::USER;
                mstatus[8] = 1'b0;
            } else if i_wr_en {
                case i_wr_addr {
                    ADDR_FFLAGS    : fcsr[4:0] = i_wr_data[4:0];
                    ADDR_FRM       : fcsr[7:5] = i_wr_data[2:0];
                    ADDR_FCSR      : fcsr[7:0] = i_wr_data[7:0];
                    ADDR_MSTATUS   : mstatus  = i_wr_data;
                    ADDR_MEDELEG   : medeleg  = i_wr_data;
                    ADDR_MIDELEG   : mideleg  = i_wr_data;
                    ADDR_MIE       : mie      = i_wr_data;
                    ADDR_MTVEC     : mtvec    = i_wr_data;
                    ADDR_MSCRATCH  : mscratch = i_wr_data;
                    ADDR_MEPC      : mepc     = i_wr_data;
                    ADDR_MCAUSE    : mcause   = i_wr_data;
                    ADDR_MTVAL     : mtval    = i_wr_data;
                    ADDR_MIP       : mip      = i_wr_data;
                    ADDR_PMPCFG0   : pmpcfg0  = i_wr_data;
                    ADDR_PMPADDR0  : pmpaddr0 = i_wr_data;
                    ADDR_SATP      : satp     = i_wr_data;
                    ADDR_MCYCLE    : mcycle   = i_wr_data;
                    ADDR_MINSTRET  : minstret = i_wr_data;
                    // S-mode CSRs (M5.D). sstatus/sie/sip write through to
                    // mstatus/mie/mip masked by visible bits.
                    ADDR_SSTATUS   : mstatus    = (mstatus & ~SSTATUS_MASK) | (i_wr_data & SSTATUS_MASK);
                    ADDR_SIE       : mie        = (mie & ~SI_MASK) | (i_wr_data & SI_MASK);
                    ADDR_SIP       : mip        = (mip & ~SI_MASK) | (i_wr_data & SI_MASK);
                    ADDR_STVEC     : stvec      = i_wr_data;
                    ADDR_SCOUNTEREN: scounteren = i_wr_data;
                    ADDR_SSCRATCH  : sscratch   = i_wr_data;
                    ADDR_SEPC      : sepc       = i_wr_data;
                    ADDR_SCAUSE    : scause     = i_wr_data;
                    ADDR_STVAL     : stval      = i_wr_data;
                    default        : {}
                }
            }
            // M6: accrue FP exception flags from a committing FP op and mark
            // mstatus.FS dirty. 1-wide commit makes this mutually exclusive
            // with the CSR-write / trap / mret / sret cases above.
            if i_fflags_set {
                fcsr[4:0]      = fcsr[4:0] | i_fflags;
                mstatus[14:13] = 2'b11; // FS = Dirty
            }
            // Free-running counters. Per RISC-V priv spec, a CSR write
            // to minstret/mcycle suppresses the increment that the
            // very next instruction would observe — implement by gating
            // the increment when the same cycle CSR-writes the counter.
            let mcycle_being_written  : logic = i_wr_en && i_wr_addr == ADDR_MCYCLE;
            let minstret_being_written: logic = i_wr_en && i_wr_addr == ADDR_MINSTRET;
            if !mcycle_being_written {
                mcycle = mcycle + 64'd1;
            }
            if i_instret_en && !minstret_being_written {
                minstret = minstret + 64'd1;
            }
        }
    }
}
