// Phase 7 v4: Integer Issue Queue.
//
// 8 entries (M1), holds renamed integer ops awaiting source-operand
// readiness. Each entry tracks {rs1_pdst, rs1_ready, rs2_pdst,
// rs2_ready}; the CDB snoop sets rs*_ready when broadcasting a pdst
// matching rs1/rs2.
//
// PRF-ready bitmap (the IQ owns it for M1 simplicity): CDB writes
// set ready[pdst]=1, rename clears ready[new_pdst]=0 on allocation.
// Initial rs*_ready at rename samples this bitmap.
//
// CDB snoop wakeup is gated by `i_cdb_has_rd` — non-rd ops (stores,
// branches without link) drive the CDB to mark their ROB entry done,
// but their pdst is the spec-time free-list pop value with no real
// architectural data; waking on it falsely marks consumers ready.
//
// M1: lowest-index ready entry wins issue. M6 widens to age-ordered
// priority pick.
pub module iq_int #(
    param IQ_N     : u32 = 8 ,
    param IQ_W     : u32 = 3 ,
    param PRF_N    : u32 = 64,
    param PRF_W    : u32 = 6 ,
    param ROB_IDX_W: u32 = 5 ,
    // CP front-pipeline (cp_front_pipeline_plan.md, I1): issue-grant SCHEDULED
    // wakeup for fixed-latency (pipe1_ok) producers. When 1, a granted ALU-class
    // op wakes its consumers + sets prf_ready at the GRANT edge (one cycle before
    // its CDB broadcast), so a front register that delays the consumer's PRF read
    // by one cycle keeps dependent ALU chains 1/cycle (the +1 FR depth is hidden).
    // Built DEAD (=0, byte-identical) until the front register lands — enabling it
    // WITHOUT the front register wakes consumers a cycle early and is WRONG.
    param SCHED_WAKEUP: bit = 1,
    // CP front-pipeline (I2): register the o_issue_* outputs (the front register).
    // When 0, o_issue_* fall back to the live combinational select = today's
    // behavior (the FR regs stay invalid). Flips to 1 with SCHED_WAKEUP at I3.
    param FRONT_PIPE: bit = 1,
) (
    clk: input clock,
    rst: input reset,

    // Allocation
    i_alloc_en : input  logic                     ,
    i_alloc_op : input  pipeline_pkg::RenamedOp,
    o_alloc_rdy: output logic                     ,
    // Phase 8 S2: 2-wide alloc slot-1. Gated off (i_alloc_en2=0) until S4.
    i_alloc_en2 : input  logic                  ,
    i_alloc_op2 : input  pipeline_pkg::RenamedOp,
    o_alloc_rdy2: output logic                  ,

    // PRF-ready bitmap maintenance (rename clears, CDB sets)
    i_rename_set_pending: input logic       ,
    i_rename_pdst       : input logic<PRF_W>,
    // Phase 8 S2: slot-1 rename clears its new pdst's ready bit too (2-wide
    // rename). Gated off until S4.
    i_rename_set_pending2: input logic       ,
    i_rename_pdst2       : input logic<PRF_W>,

    // CDB writeback snoop
    i_cdb_valid : input logic       ,
    i_cdb_has_rd: input logic       ,
    i_cdb_pdst  : input logic<PRF_W>,
    // Phase 8 S3: 2nd int CDB snoop (pipe-1 lane). Same wakeup semantics as lane
    // 0. Gated off (i_cdb2_valid=0) until S3.b enables 2-issue.
    i_cdb2_valid : input logic       ,
    i_cdb2_has_rd: input logic       ,
    i_cdb2_pdst  : input logic<PRF_W>,

    // M6: integer PRF-ready query for iq_fp. An INT→FP op issued from iq_fp
    // reads an integer source whose ready state lives in THIS queue's
    // prf_ready bitmap. The core queries it at rename with the int rs1 pdst
    // to seed iq_fp's int-source initial readiness.
    i_fp_int_query_pdst: input  logic<PRF_W>,
    o_fp_int_query_rdy : output logic       ,

    // M6.B.3: FP CDB snoop — an FP store (FSW/FSD) reads its data operand
    // (rs2) from the FP regfile, so that rs2 wakes on the FP writeback, not
    // the int one. i_alloc_rs2_fp_ready seeds its initial readiness (from the
    // FP PRF-ready bitmap that iq_fp owns).
    i_fp_cdb_valid     : input logic       ,
    i_fp_cdb_has_rd    : input logic       ,
    i_fp_cdb_pdst      : input logic<PRF_W>,
    i_alloc_rs2_fp_ready: input logic      ,

    // Issue (M1 = 1 op/cycle)
    o_issue_valid: output logic                     ,
    o_issue_op   : output pipeline_pkg::RenamedOp,
    // Per-field issue outputs (bypass cross-module struct-port sim bug).
    o_issue_rs1_pdst: output logic<PRF_W>    ,
    o_issue_rs2_pdst: output logic<PRF_W>    ,
    o_issue_rd_pdst : output logic<PRF_W>    ,
    // Zacas: the OLD pdst of rd (amocas compare/expected value). The core reads
    // prf[this] and feeds it to alu_wrap. Carried from RenamedOp.old_rd_pdst; no
    // readiness tracking (an AMO issues at the ROB head where its producer has
    // committed).
    o_issue_rd_old_pdst: output logic<PRF_W>,
    o_issue_rob_idx : output logic<ROB_IDX_W>,
    o_issue_is_load : output logic           ,
    // M5.A: per-field AMO outputs (sim-bug workaround for cross-module
    // struct-port). Mirror i_alloc_op.base.is_amo / amo_funct5.
    o_issue_is_amo    : output logic   ,
    o_issue_amo_funct5: output logic<5>,
    // Zacas amocas.q: per-field flag (the issuing AMO is a 128-bit pair CAS). The
    // core uses it to hold the read until the store buffer drains (its 2-dword
    // read needs both dwords coherent, and the overlap gate only covers the
    // primary dword).
    o_issue_is_cas_q  : output logic   ,
    // M5.D: per-field CSR outputs (same sim-bug workaround).
    o_issue_is_csr  : output logic             ,
    o_issue_csr_addr: output logic         <12>,
    o_issue_csr_op  : output csr_pkg::CsrOp    ,
    o_issue_csr_imm : output logic             ,
    o_issue_rs1_arch: output logic         <5> ,
    // M6.B.3: FP load/store flags of the issued op (per-field; the core uses
    // them to route the FP load result to prf_fp and to read FP store data).
    o_issue_fp_ld   : output logic             ,
    o_issue_fp_st   : output logic             ,
    i_issue_ack     : input  logic             ,
    // A-LOOP A2 piece 1 (cp_a_loop_plan.md §11.6, LOAD_SPEC): a dcache-FREE FR-drain
    // ack. Identical value to i_issue_ack for every op (for a plain load, both =
    // lsr_capture||mshr_capture — the load's ack is already Stage-A/MSHR, never the
    // iss_dc_ok normal branch); it just removes the iss_dc_ok dcache cone from the
    // FR-drain STA path (the §11.5 (a1) slot-0 leak). DEAD (unused) at LOAD_SPEC=0.
    i_fr_drain_ack  : input  logic             ,
    // Phase 8 S3.b: 2nd issue port (pipe-1). Picks the lowest-index ready entry
    // that is pipe-1-eligible — register ALU / branch / JAL / JALR / LUI / AUIPC
    // (MUL/DIV included: they are plain AluOp results, not a separate busy unit)
    // — and distinct from the slot-0 issue_idx. LOAD/STORE/AMO/CSR/FP stay on
    // slot-0/pipe-0 (pipe-1 has no mem/csr/amo/fp side-bands). Both issue slots
    // snoop both CDB lanes (S3.a wakeup). pipe-1 completes in one cycle with no
    // back-pressure, so i_issue_ack2 == o_issue_valid2 from the core.
    o_issue_valid2   : output logic                     ,
    o_issue_op2      : output pipeline_pkg::RenamedOp,
    o_issue_rs1_pdst2: output logic<PRF_W>              ,
    o_issue_rs2_pdst2: output logic<PRF_W>              ,
    o_issue_rd_pdst2 : output logic<PRF_W>              ,
    o_issue_rob_idx2 : output logic<ROB_IDX_W>          ,
    // Phase 8 S5.2: slot-1 op is a LOAD (per-field, sim-safe). Lets the core
    // drive the 2nd dcache read port + gate the slot-1 LOAD completion on a
    // hit. 0 until S5.2 step 3 admits loads to the slot-1 select (pipe1_ok).
    o_issue_is_load2 : output logic                     ,
    i_issue_ack2     : input  logic                     ,
    // Phase 8 S5.1 LOAD ordering (age-relative, replaces the M2 global
    // i_block_loads). The ROB reports whether any store-ordering blocker
    // exists (an unknown-addr plain store or an AMO/SC) and the age of the
    // OLDEST such blocker (i_block_store_age, = rob_idx-head). A LOAD is
    // blocked iff that oldest blocker is OLDER than the load (its age is
    // strictly smaller). A known plain store no longer blocks — the load
    // issues and the ROB forwards the overlapping bytes (o_fwd_*).
    i_block_store_exists: input logic           ,
    i_block_store_age   : input logic<ROB_IDX_W>,
    // M9.A.298 translation-state barrier: high while an in-flight CSR write to
    // sstatus/mstatus/satp, an SFENCE.VMA, or an MRET/SRET has not committed.
    // A younger LOAD/AMO must not issue (it would translate through the MMU
    // with stale SUM/MXR/MPRV/priv/satp and record a spurious page fault).
    // Same at_head escape as i_block_loads, so the ROB head never deadlocks.
    i_block_mem_xlate: input logic,
    // M2 LOAD ordering hint: ROB head idx. A LOAD whose rob_idx == head
    // is the OLDEST entry — no older STORE can exist, so it is safe to
    // issue even when i_block_loads is asserted. Avoids the classic
    // deadlock where an older LOAD waits at ROB head for a younger
    // STORE that itself waits for the LOAD to commit.
    i_rob_head_idx: input logic<ROB_IDX_W>,

    // Flush (commit-time redirect) — full clear.
    i_flush: input logic,

    // Phase 8 S8.D: early (execute-time) PARTIAL squash. Drops only entries
    // YOUNGER than the mispredicting branch (rob age, relative to i_rob_head_idx,
    // strictly greater than the branch's age). Mutually exclusive with i_flush
    // (the commit-time full clear); coexists with this cycle's CDB wakeups so
    // surviving older entries still wake. Gated OFF (i_squash_en=0) until S8.E.
    i_squash_en : input logic              ,
    i_squash_idx: input logic<ROB_IDX_W>   ,
) {
    var ops     : pipeline_pkg::RenamedOp [IQ_N];
    var occupied: logic                      [IQ_N];
    var rs1_rdy : logic                      [IQ_N];
    var rs2_rdy : logic                      [IQ_N];

    // Shadow arrays — workaround for Veryl sim dynamic-index struct
    // field READ bug. We mirror the rs1/rs2_pdst/rd_pdst/rob_idx/is_load
    // values for CDB wakeup compares and for the per-field issue path.
    var sh_rs1_pdst   : logic         <PRF_W>     [IQ_N];
    var sh_rs2_pdst   : logic         <PRF_W>     [IQ_N];
    var sh_rd_pdst    : logic         <PRF_W>     [IQ_N];
    var sh_rd_old_pdst: logic         <PRF_W>     [IQ_N]; // Zacas: amocas compare value pdst
    // CP front-pipeline (SCHED_WAKEUP): has_rd mirror of the issued op, so the
    // grant-time scheduled wakeup gates false wakeups on link-less branches /
    // stores (same reason the CDB snoop gates on i_cdb_has_rd). Shadowed like the
    // other tags to avoid the dynamic-index struct-field READ on ops[idx].base.
    var sh_has_rd     : logic                     [IQ_N];
    var sh_rob_idx   : logic         <ROB_IDX_W> [IQ_N];
    var sh_is_load   : logic                     [IQ_N];
    // Phase 8 S3.b: store flag mirror — pipe-1 eligibility excludes stores
    // (no store side-band on CDB lane 1). Shadowed like the other tags so the
    // dynamic-index issue-select read is not the buggy struct-field read.
    var sh_is_store  : logic                     [IQ_N];
    var sh_is_amo    : logic                     [IQ_N];
    // DIV/REM go to the multi-cycle int_divider FU (pipe-0 / lane-0 only), so
    // they are excluded from pipe-1 eligibility (lane 1 has no divider hook).
    var sh_is_div    : logic                     [IQ_N];
    var sh_amo_funct5: logic         <5>         [IQ_N];
    var sh_is_cas_q  : logic                     [IQ_N]; // Zacas amocas.q
    var sh_is_csr    : logic                     [IQ_N];
    var sh_csr_addr  : logic         <12>        [IQ_N];
    var sh_csr_op    : csr_pkg::CsrOp            [IQ_N];
    var sh_csr_imm   : logic                     [IQ_N];
    var sh_rs1_arch  : logic         <5>         [IQ_N];
    // M6.B.3: FP load/store tags. sh_rs2_is_fp = the rs2 (store data) operand
    // lives in the FP regfile (FP store) → tracked against the FP CDB.
    var sh_fp_ld     : logic                     [IQ_N];
    var sh_fp_st     : logic                     [IQ_N];
    var sh_rs2_is_fp : logic                     [IQ_N];

    var prf_ready: logic [PRF_N];

    // CP front-pipeline (FRONT_PIPE fix A, cp_front_pipeline_plan.md): the FR
    // present-readiness bitmap. Set ONLY at the REAL CDB broadcast (a producer that
    // actually executed), never at the SCHEDULED grant. prf_ready (above) drives
    // SELECTION (a consumer is woken/seeded early so it enters the FR 1-cycle-behind
    // = 1/cycle), but a scheduled producer can STALL in the FR (lane-0 yields to
    // FPU/MSHR/MMU-walk) and land its result late. prf_done gates the FR PRESENT:
    // an FR'd op only drives o_issue_valid once its int sources have really landed,
    // so a stalled producer holds the consumer instead of feeding it a stale read
    // — speculative selection, confirmed execute, no replay (plan §I3 fix A).
    var prf_done : logic [PRF_N];

    // CP front-pipeline (FRONT_PIPE, cp_front_pipeline_plan.md I2): the front
    // register — register the o_issue_* outputs so the issue-select cone ends here
    // (cycle N) and the registered bundle drives the core's regread/AGU/MMU/dcache
    // next cycle (N+1), pulling the ~7 ns select cone out of series with the back
    // half. One whole-RenamedOp reg + valid per issue slot (both slots, uniform —
    // a slot-0-only FR mis-times a slot-1 single-cycle consumer; plan §1.2). A
    // 1-deep stall-capable handshake: capture when the slot selects and the FR is
    // empty/draining, free the IQ slot at capture, drain on the core ack. Built
    // DEAD (FRONT_PIPE=0): the regs stay invalid, o_issue_* fall back to the live
    // combinational select, so behavior is today's. Flips on at I3 with SCHED_WAKEUP.
    var fr0_op_q   : pipeline_pkg::RenamedOp;
    var fr0_valid_q: logic                  ;
    var fr1_op_q   : pipeline_pkg::RenamedOp;
    var fr1_valid_q: logic                  ;

    // A-LOOP A1 (cp_a_loop_plan.md §3, "pipelined select"): split the ~12.9 ns /
    // 126-level select→wakeup loop into two clock cycles. The loop is
    //   rs*_rdy → cand0/argmin → sched_wake0 (sh_rd_pdst[issue_idx] dyn-mux →
    //            per-entry compare) → rs*_rdy (FF D)
    // and is the keystone scheduler floor (cp_a_sched_scheduler_pipeline_plan.md §6:
    // 126 levels, no incremental lever, can only be PIPELINED, not shortened). Register
    // the SCHEDULED-WAKEUP pdst after the argmin + sh_rd_pdst[pick] dyn-mux:
    //   stage 1 (deep)    = cand0/argmin + sh_rd_pdst[issue_idx]   → sel_wake0_pdst_q
    //   stage 2 (shallow) = sel_wake0_pdst_q → per-entry compare → rs*_rdy write
    // so the deepest half (the age-argmin + the dyn-mux) is one cycle and the wakeup
    // tail (~0.2 ns, §3) is the next. DEAD at SEL_PIPE=0: the registers feed nothing
    // (DCE'd) and the wakeup applies the LIVE sched_wake0/1 — byte-identical to today.
    //
    // At SEL_PIPE=1 the wakeup is one cycle LATE relative to the producer's grant. A
    // late wakeup is CONSERVATIVE: it only delays a consumer's selection, never lets it
    // read a stale operand (it now coincides with the producer's real CDB broadcast, so
    // the CDB snoop would have woken it anyway). The cost is the SCHED_WAKEUP head-start
    // (dependent ALU chains fall back to the CDB snoop = +1-cy dependent issue, an IPC
    // hit). The 1/cycle RECOVERY — a speculative wakeup off the LIVE pick at N + a
    // pick-freeze + mispick-squash (§3 pieces 2/4) — is the next sub-step (A1.1),
    // flipped in the coordinated bundle (cp_a_loop_plan.md §6 measurement dependency).
    // The grant (FR capture / IQ-slot free) stays LIVE at N here; only the wakeup
    // (the in-loop half) is pipelined.
    const SEL_PIPE: bit = 0;
    var sel_wake0_en_q  : logic       ;
    var sel_wake0_pdst_q: logic<PRF_W>;
    var sel_wake1_en_q  : logic       ;
    var sel_wake1_pdst_q: logic<PRF_W>;

    // A-LOOP A1.1 (cp_a_loop_plan.md §10, "grandparent speculative wakeup"): the
    // 1/cycle recovery for the SEL_PIPE loop split. A1.0's registered wake lands one
    // cycle LATE (the +1.7..8.2 % IPC). A1.1 pre-wakes a consumer one cycle EARLIER off
    // a REGISTERED grandparent prediction — the rd_pdst of an entry made NEWLY-FULLY-
    // READY by THIS cycle's applied wake (that entry is predicted to be SELECTED next
    // cycle, so its consumers are woken now). Shallow (register→compare, no argmin), so
    // the loop stays split AND dependent ALU chains recover 1/cycle (§10.2/§10.3).
    //
    // NO replay for the ALU class (§10.1): the spec wake sets rs*_rdy EARLY but never
    // prf_ready/prf_done, so a spec-woken consumer's PRESENT is still gated by the FR
    // fr0_src_done (prf_done = real broadcast). A wrong prediction only makes the
    // consumer SELECT early and then HOLD in the FR until its producer truly executes —
    // never a stale read. The one remaining corner (FR head-of-line block if a
    // mis-predicted producer is slow) is §10.4, deferred to the bundle co-flip.
    //
    // DEAD at SPEC_WAKE=0: gp_wake*_*_q are written unconditionally but READ only inside
    // the `if SPEC_WAKE` block → const-folded away / DCE'd, byte-identical to A1.0.
    //
    // §10.8 COMPLETE A1.1 (2026-07-01): TWO grandparent lanes + RECURSIVE chaining. The
    // predictor scans entries made newly-ready by ANY of this cycle's +1cy/spec wakes
    // {aw0, aw1 (both scheduled/sel slots), gp0, gp1 (last cycle's speculative wakes —
    // the recursion)} and registers the OLDEST TWO ALU-producers → gp_wake0/gp_wake1.
    // Slot-1 covers the 2-wide issue; recursion carries a dependent chain > 1 grandparent
    // hop (a spec-woken op becomes ready → predicts the next hop). Deadlock-safe: only
    // ALU-class producers (prod_ok, executable on EITHER FR slot) are registered (§10.8).
    const SPEC_WAKE: bit = 0;
    var gp_wake0_en_q  : logic       ;
    var gp_wake0_pdst_q: logic<PRF_W>;
    var gp_wake1_en_q  : logic       ;
    var gp_wake1_pdst_q: logic<PRF_W>;

    // A-LOOP A2 (cp_a_loop_plan.md §11, "decouple the LOAD grant-gating leak"): the
    // in-flight plain-load / AMO dcache completion gates the FR-drain (hence the next
    // op's slot_grant and its scheduled wakeup), leaking the dcache ~6 ns blob into the
    // rs1_rdy loop (§11.5). LOAD_SPEC decouples the grant from the dcache. Piece 1 (this
    // scaffold, byte-identical at =0 AND =1): the slot-0 plain-load FR-drain uses the
    // dcache-FREE i_fr_drain_ack instead of i_issue_ack — same value (a plain load acks
    // via lsr_capture already), so no functional change, only the iss_dc_ok cone leaves
    // the fr_drain0 STA path. Pieces 2 (AMO FR-decouple) + 3 (slot-1 load spec+poison)
    // co-flip with the retain-until-confirmed + poison substrate (§11.6). DEAD at =0.
    const LOAD_SPEC: bit = 0;

    // DIV/REM (incl. the W variants) decode of the two alloc ops — recorded into
    // sh_is_div so the pipe-1 select can exclude them.
    let alloc_is_div: logic = i_alloc_op.base.alu_op == alu_pkg::AluOp::DIV
        || i_alloc_op.base.alu_op == alu_pkg::AluOp::DIVU
        || i_alloc_op.base.alu_op == alu_pkg::AluOp::REM
        || i_alloc_op.base.alu_op == alu_pkg::AluOp::REMU
        || i_alloc_op.base.alu_op == alu_pkg::AluOp::DIVW
        || i_alloc_op.base.alu_op == alu_pkg::AluOp::DIVUW
        || i_alloc_op.base.alu_op == alu_pkg::AluOp::REMW
        || i_alloc_op.base.alu_op == alu_pkg::AluOp::REMUW;
    let alloc_is_div2: logic = i_alloc_op2.base.alu_op == alu_pkg::AluOp::DIV
        || i_alloc_op2.base.alu_op == alu_pkg::AluOp::DIVU
        || i_alloc_op2.base.alu_op == alu_pkg::AluOp::REM
        || i_alloc_op2.base.alu_op == alu_pkg::AluOp::REMU
        || i_alloc_op2.base.alu_op == alu_pkg::AluOp::DIVW
        || i_alloc_op2.base.alu_op == alu_pkg::AluOp::DIVUW
        || i_alloc_op2.base.alu_op == alu_pkg::AluOp::REMW
        || i_alloc_op2.base.alu_op == alu_pkg::AluOp::REMUW;

    // Find first free slot (allocation)
    var free_idx     : logic<IQ_W>;
    var has_free_slot: logic      ;
    always_comb {
        free_idx      = 3'd0;
        has_free_slot = 1'b0;
        for i in 0..IQ_N {
            if !has_free_slot && !occupied[i] {
                free_idx      = i as IQ_W;
                has_free_slot = 1'b1;
            }
        }
    }
    assign o_alloc_rdy = has_free_slot;

    // Phase 8 S2: second free slot = lowest unoccupied index strictly greater
    // than free_idx (slot-0's slot). Drives the slot-1 alloc (gated off until S4).
    var free_idx2     : logic<IQ_W>;
    var has_free_slot2: logic      ;
    always_comb {
        free_idx2      = 3'd0;
        has_free_slot2 = 1'b0;
        for i in 0..IQ_N {
            if has_free_slot && !has_free_slot2 && !occupied[i] && ((i as IQ_W) >: free_idx) {
                free_idx2      = i as IQ_W;
                has_free_slot2 = 1'b1;
            }
        }
    }
    assign o_alloc_rdy2 = has_free_slot2;

    // M6: combinational int PRF-ready query (for iq_fp int-source readiness).
    // CP front-pipeline (SCHED_WAKEUP): use prf_DONE, not prf_ready. The scheduled
    // wakeup sets prf_ready one cycle EARLY (at the producer's grant) to hide the FR
    // depth for FR-delayed INT consumers in this queue. But iq_fp has NO front
    // register — an int→fp op reads the integer PRF combinationally the cycle it
    // issues. Seeding its int-source readiness from the EARLY prf_ready lets it issue
    // before the producer's real CDB broadcast wrote the PRF → stale int operand
    // (e.g. rv64uf-fdiv subtest 6 when the producer stalls in the FR). prf_done is
    // set ONLY at the real broadcast, so the int→fp op waits for the value to truly
    // land. When SCHED_WAKEUP=0 prf_done == prf_ready (no early set) → byte-identical.
    assign o_fp_int_query_rdy = prf_done[i_fp_int_query_pdst];

    // Phase 8 S4c: OLDEST-ready issue (was lowest-IQ-slot-index). Pick the ready
    // unblocked entry with the smallest age = (rob_idx - rob_head) in ROB_IDX_W
    // wrapping arithmetic (0 = at head = oldest). rob_idx is unique per entry so
    // there are no age ties. Oldest-first puts critical-path ops (loads,
    // commit-blocking ops) on pipe-0 first instead of whatever sits at a low IQ
    // slot — position-based select deferred high-slot loads and cost load-use
    // stalls. LOADs are blocked when i_block_loads is high UNLESS at ROB head
    // (oldest, so no older STORE can be pending).
    // Fmax tree-ize: pairwise-argmin of two packed candidates. Pack layout =
    // {valid(1), age(ROB_IDX_W=5), idx(IQ_W=3)} = 9 bits (the 5'd0/3'd0 literals
    // elsewhere in this module assume the same widths). argmin over a tie-free
    // age key (rob_idx is unique → ages are unique), so a balanced reduction is
    // bit-identical to the old linear running-argmin — same transform the FP LZC
    // tree-ize used. Picks the valid candidate with the smaller age.
    function pick_oldest (
        a: input logic<9>,
        b: input logic<9>,
    ) -> logic<9> {
        return if !a[8] ? b : if !b[8] ? a : if a[7:3] <: b[7:3] ? a : b;
    }
    // Phase 8 S4c: OLDEST-ready issue. Was a linear O(IQ_N) running-argmin that,
    // together with the rob oldest-blocker scan it depends on, formed the ~32ns
    // head of the synth critical path (rob_head → this select → AGU → dmem).
    // Now a per-entry candidate build + balanced pairwise-argmin tree.
    var cand0: logic<9> [IQ_N];
    always_comb {
        for i in 0..IQ_N {
            let at_head: logic            = sh_rob_idx[i] == i_rob_head_idx;
            let age    : logic<ROB_IDX_W> = sh_rob_idx[i] - i_rob_head_idx;
            // Phase 8 S5.1: a LOAD is blocked iff the OLDEST store-ordering
            // blocker (unknown-addr plain store / AMO) is older than it
            // (i_block_store_age strictly less than the load's age). at_head is
            // subsumed (age 0 → no older blocker possible) but kept harmless.
            // S16: an AMO's execute-time memory read must obey the same
            // ordering — without this term it could pass an older
            // unknown-addr store (or FENCE, folded into the same gate).
            // CSR ops issue at ROB head only (serializing) so that the
            // commit-time CSR write is visible to the following csrr.
            // M9.A.298: LOAD/AMO also blocked while an older translation-state
            // change (CSR sstatus/mstatus/satp, SFENCE, MRET/SRET) is in flight,
            // so the MMU never translates it with stale SUM/MXR/priv/satp.
            // P9.3 (in-cache AMO): an AMO/LR/SC issues at the ROB HEAD only.
            // Its memory read takes no part in store-to-load forwarding, so
            // it must never pass an EXECUTED-but-uncommitted older store —
            // the old force-miss re-fill's latency masked this (the older
            // store reached the committed-store buffer, whose overlap gate
            // ordered the read); an owned-line hit reads instantly and
            // exposed it (rv64ua amomax/amomin subtest 4: sw x0 then amomax
            // read stale). At the head every older op has retired; the
            // committed-store buffer overlap gate covers the rest.
            let blocked: logic = ((sh_is_load[i] || sh_is_amo[i]) && i_block_store_exists && (i_block_store_age <: age))
                || (sh_is_amo[i] && !at_head)
                || ((sh_is_load[i] || sh_is_amo[i]) && i_block_mem_xlate && !at_head) || (sh_is_csr[i] && !at_head);
            let ready  : logic = occupied[i] && rs1_rdy[i] && rs2_rdy[i] && !blocked;
            cand0[i] = {ready, age, i as IQ_W};
        }
    }
    // balanced pairwise-argmin tree (IQ_N = 8 → depth 3). Intermediate lets per
    // level (Veryl mis-flags nested same-function calls as recursion).
    let iss0_a0     : logic<9> = pick_oldest(cand0[0], cand0[1]);
    let iss0_a1     : logic<9> = pick_oldest(cand0[2], cand0[3]);
    let iss0_a2     : logic<9> = pick_oldest(cand0[4], cand0[5]);
    let iss0_a3     : logic<9> = pick_oldest(cand0[6], cand0[7]);
    let iss0_b0     : logic<9> = pick_oldest(iss0_a0, iss0_a1);
    let iss0_b1     : logic<9> = pick_oldest(iss0_a2, iss0_a3);
    let iss0_win    : logic<9> = pick_oldest(iss0_b0, iss0_b1);
    let has_issuable: logic       = iss0_win[8];
    let issue_idx   : logic<IQ_W> = if iss0_win[8] ? iss0_win[2:0] : 3'd0;
    // CP front-pipeline (FRONT_PIPE fix A): FR present-readiness. An FR'd op drives
    // o_issue_valid only once its INT sources have really executed (prf_done) — a
    // scheduled producer that stalled in the FR has prf_done=0, so its consumer
    // holds here instead of reading a stale PRF value (plan §I3 fix A). rs1 is
    // always int; rs2 is int unless FP store data (fp_st — broadcast-woken from the
    // FP CDB, already really ready when selected, so skip the int check). No-source
    // ops (LUI/AUIPC/…) present immediately. Defined here (before the o_issue_valid
    // assign) — Veryl forbids referring to a let before its definition.
    let fr0_src_done: logic = (!fr0_op_q.base.has_rs1 || prf_done[fr0_op_q.rs1_pdst])
        && (fr0_op_q.base.fp_st || !fr0_op_q.base.has_rs2 || prf_done[fr0_op_q.rs2_pdst]);
    let fr1_src_done: logic = (!fr1_op_q.base.has_rs1 || prf_done[fr1_op_q.rs1_pdst])
        && (fr1_op_q.base.fp_st || !fr1_op_q.base.has_rs2 || prf_done[fr1_op_q.rs2_pdst]);
    // CP front-pipeline: o_issue_* = FRONT_PIPE ? registered FR : live select. The
    // per-field FR reads are STATIC field reads of the (non-array) fr0_op_q, so they
    // are safe — the sh_* shadow arrays only worked around the *dynamic*-index
    // struct-field-read bug. fr0_op_q.<f> == sh_<f>[issue_idx] for the captured op
    // (both come from i_alloc_op), so FRONT_PIPE=0 is exactly today's output.
    assign o_issue_valid      = if FRONT_PIPE ? (fr0_valid_q && fr0_src_done) : has_issuable;
    assign o_issue_op         = if FRONT_PIPE ? fr0_op_q : ops[issue_idx];
    assign o_issue_rs1_pdst    = if FRONT_PIPE ? fr0_op_q.rs1_pdst : sh_rs1_pdst[issue_idx];
    assign o_issue_rs2_pdst    = if FRONT_PIPE ? fr0_op_q.rs2_pdst : sh_rs2_pdst[issue_idx];
    assign o_issue_rd_pdst     = if FRONT_PIPE ? fr0_op_q.rd_pdst : sh_rd_pdst[issue_idx];
    assign o_issue_rd_old_pdst = if FRONT_PIPE ? fr0_op_q.old_rd_pdst : sh_rd_old_pdst[issue_idx];
    assign o_issue_rob_idx    = if FRONT_PIPE ? fr0_op_q.rob_idx : sh_rob_idx[issue_idx];
    assign o_issue_is_load    = if FRONT_PIPE ? fr0_op_q.base.is_load : sh_is_load[issue_idx];
    assign o_issue_is_amo     = if FRONT_PIPE ? fr0_op_q.base.is_amo : sh_is_amo[issue_idx];
    assign o_issue_amo_funct5 = if FRONT_PIPE ? fr0_op_q.base.amo_funct5 : sh_amo_funct5[issue_idx];
    assign o_issue_is_cas_q   = if FRONT_PIPE ? fr0_op_q.base.is_cas_q : sh_is_cas_q[issue_idx];
    assign o_issue_is_csr     = if FRONT_PIPE ? fr0_op_q.base.is_csr : sh_is_csr[issue_idx];
    assign o_issue_csr_addr   = if FRONT_PIPE ? fr0_op_q.base.csr_addr : sh_csr_addr[issue_idx];
    assign o_issue_csr_op     = if FRONT_PIPE ? fr0_op_q.base.csr_op : sh_csr_op[issue_idx];
    assign o_issue_csr_imm    = if FRONT_PIPE ? fr0_op_q.base.csr_imm : sh_csr_imm[issue_idx];
    assign o_issue_rs1_arch   = if FRONT_PIPE ? fr0_op_q.base.rs1_arch : sh_rs1_arch[issue_idx];
    assign o_issue_fp_ld      = if FRONT_PIPE ? fr0_op_q.base.fp_ld : sh_fp_ld[issue_idx];
    assign o_issue_fp_st      = if FRONT_PIPE ? fr0_op_q.base.fp_st : sh_fp_st[issue_idx];

    // Phase 8 S3.b/S4c: 2nd issue pick — the OLDEST-ready pipe-1-eligible entry
    // that is not the slot-0 pick. Eligible entries are never blocked
    // (i_block_loads / i_block_mem_xlate / CSR-serialize gate only LOAD/AMO/CSR,
    // all excluded by pipe1_ok), so no `blocked` term is needed. Selected by age
    // (oldest = smallest rob_idx-head) like slot-0, so the two oldest ready ops
    // co-issue.
    // Phase 8 S5.2: slot-1 also admits a bare-mode LOAD, but only as a FALLBACK so
    // it NEVER displaces ALU work (a load takes slot-1 only when no pipe-1 ALU op
    // is ready — slot-1 would otherwise be idle, so this is strictly ≥ baseline).
    // Tier A = oldest-ready ALU-class pipe1 op (the old pipe1_ok set). Tier L =
    // oldest-ready plain int LOAD, blocked by the SAME store-ordering / xlate gate
    // as slot-0 (the core's 2nd forward network + 2nd dcache port carry the data;
    // the core completes a slot-1 load only on a bare-mode 2nd-port HIT, else holds
    // it in the IQ via i_issue_ack2=0). Final pick: A preferred, else L. (A merged
    // age-ordered scan (tier-1) where a load competes with ALU was tried — only
    // -0.18% extra on Dhrystone vs the slot-waste risk of a non-completing load, so
    // fallback-only is kept.)
    var cand2A: logic<9> [IQ_N];
    var cand2L: logic<9> [IQ_N];
    always_comb {
        for i in 0..IQ_N {
            let at_head: logic            = sh_rob_idx[i] == i_rob_head_idx;
            let age    : logic<ROB_IDX_W> = sh_rob_idx[i] - i_rob_head_idx;
            // Tier A: ALU-class (no load/store/amo/csr/fp).
            let pipe1_ok: logic = !sh_is_load[i] && !sh_is_store[i] && !sh_is_amo[i]
                && !sh_is_csr[i] && !sh_fp_ld[i] && !sh_fp_st[i] && !sh_is_div[i];
            let ready2A: logic = occupied[i] && rs1_rdy[i] && rs2_rdy[i] && pipe1_ok && ((i as IQ_W) != issue_idx);
            cand2A[i] = {ready2A, age, i as IQ_W};
            // Tier L: a plain integer LOAD (not AMO/FP), blocked by the same
            // store-ordering / xlate-barrier gate slot-0 uses for loads.
            let ld_blocked: logic = (i_block_store_exists && (i_block_store_age <: age))
                || (i_block_mem_xlate && !at_head);
            let ready2L: logic = occupied[i] && rs1_rdy[i] && rs2_rdy[i]
                && sh_is_load[i] && !sh_is_amo[i] && !sh_fp_ld[i]
                && !ld_blocked && ((i as IQ_W) != issue_idx);
            cand2L[i] = {ready2L, age, i as IQ_W};
        }
    }
    // balanced pairwise-argmin trees; each gated by has_issuable (slot-0 issued).
    let win2A_a0      : logic<9> = pick_oldest(cand2A[0], cand2A[1]);
    let win2A_a1      : logic<9> = pick_oldest(cand2A[2], cand2A[3]);
    let win2A_a2      : logic<9> = pick_oldest(cand2A[4], cand2A[5]);
    let win2A_a3      : logic<9> = pick_oldest(cand2A[6], cand2A[7]);
    let win2A_b0      : logic<9> = pick_oldest(win2A_a0, win2A_a1);
    let win2A_b1      : logic<9> = pick_oldest(win2A_a2, win2A_a3);
    let win2A         : logic<9> = pick_oldest(win2A_b0, win2A_b1);
    let win2L_a0      : logic<9> = pick_oldest(cand2L[0], cand2L[1]);
    let win2L_a1      : logic<9> = pick_oldest(cand2L[2], cand2L[3]);
    let win2L_a2      : logic<9> = pick_oldest(cand2L[4], cand2L[5]);
    let win2L_a3      : logic<9> = pick_oldest(cand2L[6], cand2L[7]);
    let win2L_b0      : logic<9> = pick_oldest(win2L_a0, win2L_a1);
    let win2L_b1      : logic<9> = pick_oldest(win2L_a2, win2L_a3);
    let win2L         : logic<9> = pick_oldest(win2L_b0, win2L_b1);
    let has_issuable2A: logic       = has_issuable && win2A[8];
    // CP front-pipeline: Tier L (slot-1 LOADS, S5.2) is DISABLED under FRONT_PIPE.
    // A slot-1 load completes only on a same-cycle dcache hit (ld2_complete); on a
    // miss the baseline holds it in the IQ and re-issues. But the FR frees the IQ
    // slot at capture, so a missing load captured into fr1 has no retry path and
    // DEADLOCKS (it can become the ROB head while stuck in fr1, which has no MSHR).
    // Loads are also variable-latency — outside the scheduled-wakeup fixed-latency
    // set (pipe1_ok). So under FRONT_PIPE all loads take slot-0 (the LSR 2-stage,
    // which has proper miss/MSHR handling); fr1 only ever holds pipe1_ok ALU ops.
    let has_issuable2L: logic       = has_issuable && win2L[8] && !FRONT_PIPE;
    let has_issuable2 : logic       = has_issuable2A || has_issuable2L;
    let issue_idx2    : logic<IQ_W> = if has_issuable2A ? win2A[2:0] : win2L[2:0];
    assign o_issue_valid2 = if FRONT_PIPE ? (fr1_valid_q && fr1_src_done) : has_issuable2;
    assign o_issue_op2       = if FRONT_PIPE ? fr1_op_q : ops[issue_idx2];
    assign o_issue_rs1_pdst2 = if FRONT_PIPE ? fr1_op_q.rs1_pdst : sh_rs1_pdst[issue_idx2];
    assign o_issue_rs2_pdst2 = if FRONT_PIPE ? fr1_op_q.rs2_pdst : sh_rs2_pdst[issue_idx2];
    assign o_issue_rd_pdst2  = if FRONT_PIPE ? fr1_op_q.rd_pdst : sh_rd_pdst[issue_idx2];
    assign o_issue_rob_idx2  = if FRONT_PIPE ? fr1_op_q.rob_idx : sh_rob_idx[issue_idx2];
    assign o_issue_is_load2  = if FRONT_PIPE ? fr1_op_q.base.is_load : sh_is_load[issue_idx2];

    // CP front-pipeline: the FR (front register) handshake. slot{0,1}_grant = the
    // cycle the slot's selected op LEAVES the IQ — into the FR when FRONT_PIPE,
    // else into execute on the core ack (today). At FRONT_PIPE=0 these fold to the
    // old "ack && has_issuable" so the IQ-slot free + scheduled wakeup below are
    // byte-for-byte today's. fr_capture fires when the slot has a ready op and the
    // FR is empty or draining this cycle (1-deep, refills as it drains); !i_flush
    // because flush clears the FR in the always_ff i_flush branch.
    // A2 piece 1: the slot-0 FR-drain uses the dcache-free ack under LOAD_SPEC. Same
    // value as i_issue_ack (§11.6), so byte-identical; only the iss_dc_ok dcache cone
    // leaves the fr_drain0 → slot0_grant → sched_wake → rs1_rdy STA path.
    let fr_drain0  : logic = fr0_valid_q && (if LOAD_SPEC ? i_fr_drain_ack : i_issue_ack);
    let fr_drain1  : logic = fr1_valid_q && i_issue_ack2;
    let fr_capture0: logic = has_issuable  && (!fr0_valid_q || fr_drain0) && !i_flush;
    let fr_capture1: logic = has_issuable2 && (!fr1_valid_q || fr_drain1) && !i_flush;
    let slot0_grant: logic = if FRONT_PIPE ? fr_capture0 : (has_issuable && i_issue_ack);
    let slot1_grant: logic = if FRONT_PIPE ? fr_capture1 : (has_issuable2 && i_issue_ack2);

    // CP front-pipeline (SCHED_WAKEUP): grant-time fixed-latency producer detect.
    // A slot-0 grant is fixed-latency iff the issued op is pipe1_ok (ALU-class:
    // no load/store/amo/csr/fp/div). A slot-1 grant is fixed-latency iff it took
    // the ALU tier (has_issuable2A) — the load tier (has_issuable2L) is
    // variable-latency and stays on the CDB-broadcast snoop. sh_has_rd gates false
    // wakeups on link-less branches (their sh_rd_pdst has no real data, like a
    // non-rd CDB op). Keyed on slot_grant = the op leaves the IQ (→FR or →execute).
    let iss0_pipe1     : logic        = !sh_is_load[issue_idx] && !sh_is_store[issue_idx]
        && !sh_is_amo[issue_idx] && !sh_is_csr[issue_idx]
        && !sh_fp_ld[issue_idx] && !sh_fp_st[issue_idx] && !sh_is_div[issue_idx];
    let sched_wake0_en  : logic        = slot0_grant && iss0_pipe1 && sh_has_rd[issue_idx];
    let sched_wake0_pdst: logic<PRF_W> = sh_rd_pdst[issue_idx];
    let sched_wake1_en  : logic        = slot1_grant && has_issuable2A && sh_has_rd[issue_idx2];
    let sched_wake1_pdst: logic<PRF_W> = sh_rd_pdst[issue_idx2];

    // A-LOOP A1.1 (SPEC_WAKE, cp_a_loop_plan.md §10.2/§10.8): the grandparent PREDICTOR.
    // aw0/aw1 = the SCHEDULED wakes actually APPLIED to rs*_rdy this cycle for the two
    // issue slots (the SEL_PIPE mux, mirroring the always_ff `sw0`/`sw1`). An entry
    // becomes NEWLY-FULLY-READY when this cycle's wakes complete its last pending operand;
    // it is then predicted to be SELECTED next cycle, so its rd_pdst is registered and
    // next cycle used to pre-wake ITS consumers a cycle early. The register breaks the
    // loop before the argmin (§10.3): at SEL_PIPE=1 aw0/aw1 are registers, so the
    // detection is register→compare→argmin-tree→register — no live select cone.
    //
    // §10.8 COMPLETE: the wake set also includes last cycle's SPECULATIVE wakes
    // (gp_wake0/gp_wake1, restricted to ALU-class consumers like the application) — this
    // is the RECURSION that carries a dependent chain > 1 grandparent hop. Registers the
    // OLDEST TWO ALU-producers (gp_wake0 = oldest, gp_wake1 = 2nd, mirroring issue_idx /
    // issue_idx2) so the 2-wide issue is covered. DEAD at SPEC_WAKE=0 (feeds gp_wake*_*_q,
    // read only in the gated block; the gp-wake terms are further SPEC_WAKE-gated).
    let aw0_en  : logic        = if SEL_PIPE ? sel_wake0_en_q : sched_wake0_en;
    let aw0_pdst: logic<PRF_W> = if SEL_PIPE ? sel_wake0_pdst_q : sched_wake0_pdst;
    let aw1_en  : logic        = if SEL_PIPE ? sel_wake1_en_q : sched_wake1_en;
    let aw1_pdst: logic<PRF_W> = if SEL_PIPE ? sel_wake1_pdst_q : sched_wake1_pdst;
    var cand_gp0: logic<9> [IQ_N];
    always_comb {
        for i in 0..IQ_N {
            let age    : logic<ROB_IDX_W> = sh_rob_idx[i] - i_rob_head_idx;
            // consumer class the SPECULATIVE wake actually touches (matches the always_ff
            // application) — so the recursion's readiness projection is consistent.
            let spec_ok: logic = !sh_is_load[i] && !sh_is_store[i] && !sh_is_amo[i]
                && !sh_is_csr[i] && !sh_fp_ld[i] && !sh_fp_st[i];
            // rs1 woken THIS cycle by a scheduled wake (aw0/aw1) OR — for ALU consumers —
            // by last cycle's speculative grandparent wake (gp0/gp1 = the recursion).
            let w1_aw: logic = (aw0_en && sh_rs1_pdst[i] == aw0_pdst) || (aw1_en && sh_rs1_pdst[i] == aw1_pdst);
            let w1_gp: logic = SPEC_WAKE && spec_ok
                && ((gp_wake0_en_q && sh_rs1_pdst[i] == gp_wake0_pdst_q) || (gp_wake1_en_q && sh_rs1_pdst[i] == gp_wake1_pdst_q));
            let woke_rs1: logic = occupied[i] && (w1_aw || w1_gp);
            let w2_aw: logic = !sh_rs2_is_fp[i] && ((aw0_en && sh_rs2_pdst[i] == aw0_pdst) || (aw1_en && sh_rs2_pdst[i] == aw1_pdst));
            let w2_gp: logic = SPEC_WAKE && spec_ok && !sh_rs2_is_fp[i]
                && ((gp_wake0_en_q && sh_rs2_pdst[i] == gp_wake0_pdst_q) || (gp_wake1_en_q && sh_rs2_pdst[i] == gp_wake1_pdst_q));
            let woke_rs2: logic = occupied[i] && (w2_aw || w2_gp);
            // Predict only off FIXED-LATENCY ALU-class PRODUCERS (§10.8 deadlock fix). A
            // spec-woken consumer HOLDS the FR until prf_done[producer]; if that producer
            // is a slot-0-only memory op (load/amo/csr) OR a many-cycle div, it can wedge
            // the FR. An ALU/branch/mul producer executes on EITHER FR slot, so the
            // consumer always drains — no wedge. (load-producer prediction is A2.)
            let prod_ok: logic = spec_ok && !sh_is_div[i];
            // newly-fully-ready THIS cycle: was not already ready, is ready after the
            // wakes, and a wake completed it (has_rd → its rd_pdst is a real producer).
            let becomes: logic = occupied[i] && sh_has_rd[i] && prod_ok && !(rs1_rdy[i] && rs2_rdy[i])
                && (rs1_rdy[i] || woke_rs1) && (rs2_rdy[i] || woke_rs2) && (woke_rs1 || woke_rs2);
            cand_gp0[i] = {becomes, age, i as IQ_W};
        }
    }
    // pick the OLDEST newly-ready ALU producer (lane 0) via the pick_oldest argmin tree.
    let gp0_a0  : logic<9> = pick_oldest(cand_gp0[0], cand_gp0[1]);
    let gp0_a1  : logic<9> = pick_oldest(cand_gp0[2], cand_gp0[3]);
    let gp0_a2  : logic<9> = pick_oldest(cand_gp0[4], cand_gp0[5]);
    let gp0_a3  : logic<9> = pick_oldest(cand_gp0[6], cand_gp0[7]);
    let gp0_b0  : logic<9> = pick_oldest(gp0_a0, gp0_a1);
    let gp0_b1  : logic<9> = pick_oldest(gp0_a2, gp0_a3);
    let gp0_win : logic<9> = pick_oldest(gp0_b0, gp0_b1);
    let gp0_idx : logic<IQ_W>  = gp0_win[2:0];
    let gp_wake0_en  : logic        = gp0_win[8];
    let gp_wake0_pdst: logic<PRF_W> = sh_rd_pdst[gp0_idx];
    // §10.8 lane 1: the 2nd-oldest newly-ready ALU producer (mask lane-0's pick), so the
    // 2-wide issue has both grandparents. Mirrors the issue_idx2 second-pick pattern.
    var cand_gp1: logic<9> [IQ_N];
    always_comb {
        for i in 0..IQ_N {
            cand_gp1[i] = if gp_wake0_en && ((i as IQ_W) == gp0_idx) ? 9'd0 : cand_gp0[i];
        }
    }
    let gp1_a0  : logic<9> = pick_oldest(cand_gp1[0], cand_gp1[1]);
    let gp1_a1  : logic<9> = pick_oldest(cand_gp1[2], cand_gp1[3]);
    let gp1_a2  : logic<9> = pick_oldest(cand_gp1[4], cand_gp1[5]);
    let gp1_a3  : logic<9> = pick_oldest(cand_gp1[6], cand_gp1[7]);
    let gp1_b0  : logic<9> = pick_oldest(gp1_a0, gp1_a1);
    let gp1_b1  : logic<9> = pick_oldest(gp1_a2, gp1_a3);
    let gp1_win : logic<9> = pick_oldest(gp1_b0, gp1_b1);
    let gp1_idx : logic<IQ_W>  = gp1_win[2:0];
    let gp_wake1_en  : logic        = gp1_win[8];
    let gp_wake1_pdst: logic<PRF_W> = sh_rd_pdst[gp1_idx];

    // Phase 8 S4b: intra-bundle RAW. When slot-1 (the younger op of a 2-wide
    // rename bundle) sources slot-0's just-renamed int dest, the core's rename
    // bypass routes slot-1's rs pdst to slot-0's new pdst (== i_rename_pdst). At
    // alloc, prf_ready[that pdst] is the STALE pre-clear value — the freshly-
    // popped pdst's ready bit is still 1 from its prior life, and slot-0's clear
    // (i_rename_set_pending below) lands at the SAME clock edge (NBA) — so the
    // source would be wrongly marked ready. Force it not-ready: slot-0 has not
    // executed yet, and no CDB can produce a just-popped pdst this cycle.
    let s1_intra_rs1: logic = i_rename_set_pending && i_alloc_op2.base.has_rs1
        && i_alloc_op2.rs1_pdst == i_rename_pdst;
    let s1_intra_rs2: logic = i_rename_set_pending && i_alloc_op2.base.has_rs2
        && !i_alloc_op2.base.fp_st && i_alloc_op2.rs2_pdst == i_rename_pdst;

    always_ff (clk, rst) {
        if_reset {
            for i in 0..IQ_N {
                occupied[i]      = 1'b0;
                rs1_rdy[i]       = 1'b0;
                rs2_rdy[i]       = 1'b0;
                sh_rs1_pdst[i]   = 6'd0;
                sh_rs2_pdst[i]   = 6'd0;
                sh_rd_pdst[i]    = 6'd0;
                sh_rd_old_pdst[i] = 6'd0;
                sh_has_rd[i]     = 1'b0;
                sh_rob_idx[i]    = 5'd0;
                sh_is_load[i]    = 1'b0;
                sh_is_store[i]   = 1'b0;
                sh_is_amo[i]     = 1'b0;
                sh_is_div[i]     = 1'b0;
                sh_amo_funct5[i] = 5'd0;
                sh_is_cas_q[i]   = 1'b0;
                sh_is_csr[i]     = 1'b0;
                sh_csr_addr[i]   = 12'd0;
                sh_csr_op[i]     = csr_pkg::CsrOp::RW;
                sh_csr_imm[i]    = 1'b0;
                sh_rs1_arch[i]   = 5'd0;
                sh_fp_ld[i]      = 1'b0;
                sh_fp_st[i]      = 1'b0;
                sh_rs2_is_fp[i]  = 1'b0;
            }
            for i in 0..PRF_N {
                // Initial RAT identity → PRF[0..31] are ready;
                // PRF[32..63] are free-list entries with no producer yet
                // (any rename clears their ready bit before issue depends
                // on them).
                prf_ready[i] = 1'b1;
                prf_done[i]  = 1'b1; // FR fix A: same initial state (RAT identity is "executed")
            }
            // CP front-pipeline: FR starts empty (dead when FRONT_PIPE=0).
            fr0_valid_q = 1'b0;
            fr1_valid_q = 1'b0;
            fr0_op_q    = '0;
            fr1_op_q    = '0;
            // A-LOOP A1 (SEL_PIPE): the pipelined-wakeup register starts empty.
            sel_wake0_en_q   = 1'b0;
            sel_wake0_pdst_q = 6'd0;
            sel_wake1_en_q   = 1'b0;
            sel_wake1_pdst_q = 6'd0;
            // A-LOOP A1.1 (SPEC_WAKE): the grandparent predictors start empty.
            gp_wake0_en_q   = 1'b0;
            gp_wake0_pdst_q = 6'd0;
            gp_wake1_en_q   = 1'b0;
            gp_wake1_pdst_q = 6'd0;
        } else if i_flush {
            for i in 0..IQ_N {
                occupied[i] = 1'b0;
            }
            // CP front-pipeline: a commit-time redirect squashes the in-flight FR op.
            fr0_valid_q = 1'b0;
            fr1_valid_q = 1'b0;
            // A-LOOP A1 (SEL_PIPE): a commit-time redirect squashes the in-flight
            // pipelined wakeup — a flushed producer must not wake a (now-cleared)
            // consumer late. Clearing the enable suffices (pdst is don't-care when
            // disabled). Dead at SEL_PIPE=0 (the register feeds nothing).
            sel_wake0_en_q = 1'b0;
            sel_wake1_en_q = 1'b0;
            // A-LOOP A1.1 (SPEC_WAKE): a flushed producer must not spec-wake a
            // (now-cleared) consumer next cycle. Clearing the enables suffices.
            gp_wake0_en_q = 1'b0;
            gp_wake1_en_q = 1'b0;
            // PRF-ready bitmap state survives flush — recovery_fire on
            // free_list reclaims squashed pdsts; the ready bits on those
            // reclaimed pdsts remain whatever they were (the next rename
            // will reset them). On subsequent commits the bitmap stays
            // consistent.
        } else {
            // CDB snoop: wake matching rs*_pdst and set prf_ready[pdst].
            // Gate by has_rd to suppress false wakeups from non-rd ops.
            if i_cdb_valid && i_cdb_has_rd {
                prf_ready[i_cdb_pdst] = 1'b1;
                prf_done[i_cdb_pdst]  = 1'b1; // FR fix A: real execute landed
                for i in 0..IQ_N {
                    if occupied[i] && sh_rs1_pdst[i] == i_cdb_pdst {
                        rs1_rdy[i] = 1'b1;
                    }
                    // rs1 is always an integer source. rs2 wakes on the int
                    // CDB only when it is NOT an FP-store data operand.
                    if occupied[i] && !sh_rs2_is_fp[i] && sh_rs2_pdst[i] == i_cdb_pdst {
                        rs2_rdy[i] = 1'b1;
                    }
                }
            }
            // Phase 8 S3: 2nd int CDB snoop (pipe-1 lane). Identical wakeup; a
            // given pdst is produced by exactly one lane so the two never race.
            if i_cdb2_valid && i_cdb2_has_rd {
                prf_ready[i_cdb2_pdst] = 1'b1;
                prf_done[i_cdb2_pdst]  = 1'b1; // FR fix A: real execute landed (pipe-1)
                for i in 0..IQ_N {
                    if occupied[i] && sh_rs1_pdst[i] == i_cdb2_pdst {
                        rs1_rdy[i] = 1'b1;
                    }
                    if occupied[i] && !sh_rs2_is_fp[i] && sh_rs2_pdst[i] == i_cdb2_pdst {
                        rs2_rdy[i] = 1'b1;
                    }
                }
            }
            // M6.B.3: FP-store data operand (rs2_is_fp) wakes on the FP CDB.
            if i_fp_cdb_valid && i_fp_cdb_has_rd {
                for i in 0..IQ_N {
                    if occupied[i] && sh_rs2_is_fp[i] && sh_rs2_pdst[i] == i_fp_cdb_pdst {
                        rs2_rdy[i] = 1'b1;
                    }
                }
            }
            // CP front-pipeline (I1): grant-time SCHEDULED wakeup of fixed-latency
            // producers (cp_front_pipeline_plan.md §1.3-1.4). Mirrors the CDB snoop
            // but keyed on the GRANTED ALU-class producer's pdst — one cycle BEFORE
            // its CDB broadcast. Set here (before rename-clear/alloc) so a consumer
            // renamed THIS cycle seeds ready from prf_ready, exactly like the CDB
            // snoop. With a front register delaying the consumer's PRF read by one
            // cycle, "ready visible at N+1" lines up with "result in PRF at N+2" —
            // dependent ALU chains stay 1/cycle, no operand bypass needed. Built
            // DEAD (SCHED_WAKEUP=0) until the front register lands; enabling it
            // without the FR wakes consumers a cycle early and is WRONG.
            if SCHED_WAKEUP {
                // A-LOOP A1 (SEL_PIPE): apply the PIPELINED (registered) wakeup pdst at
                // =1 (stage 2 of the split loop), else the LIVE sched_wake (=0,
                // byte-identical). At =1 sw*_q is the producer picked LAST cycle (NBA
                // pre-edge), so the wakeup lands one cycle later (see the SEL_PIPE decl).
                let sw0_en  : logic        = if SEL_PIPE ? sel_wake0_en_q : sched_wake0_en;
                let sw0_pdst: logic<PRF_W> = if SEL_PIPE ? sel_wake0_pdst_q : sched_wake0_pdst;
                let sw1_en  : logic        = if SEL_PIPE ? sel_wake1_en_q : sched_wake1_en;
                let sw1_pdst: logic<PRF_W> = if SEL_PIPE ? sel_wake1_pdst_q : sched_wake1_pdst;
                if sw0_en {
                    prf_ready[sw0_pdst] = 1'b1;
                    for i in 0..IQ_N {
                        if occupied[i] && sh_rs1_pdst[i] == sw0_pdst {
                            rs1_rdy[i] = 1'b1;
                        }
                        if occupied[i] && !sh_rs2_is_fp[i] && sh_rs2_pdst[i] == sw0_pdst {
                            rs2_rdy[i] = 1'b1;
                        }
                    }
                }
                if sw1_en {
                    prf_ready[sw1_pdst] = 1'b1;
                    for i in 0..IQ_N {
                        if occupied[i] && sh_rs1_pdst[i] == sw1_pdst {
                            rs1_rdy[i] = 1'b1;
                        }
                        if occupied[i] && !sh_rs2_is_fp[i] && sh_rs2_pdst[i] == sw1_pdst {
                            rs2_rdy[i] = 1'b1;
                        }
                    }
                }
                // A-LOOP A1 (SEL_PIPE): pipeline-register the scheduled-wakeup pdst —
                // the cycle-N argmin + sh_rd_pdst[issue_idx] dyn-mux lands here
                // (stage-1 boundary); the compare + rs*_rdy write above reads it next
                // cycle (stage 2). Written unconditionally (the LIVE sched_wake* is a
                // comb let); DEAD at SEL_PIPE=0 (read nowhere → DCE).
                sel_wake0_en_q   = sched_wake0_en;
                sel_wake0_pdst_q = sched_wake0_pdst;
                sel_wake1_en_q   = sched_wake1_en;
                sel_wake1_pdst_q = sched_wake1_pdst;
            }
            // A-LOOP A1.1 (SPEC_WAKE, §10.2): grandparent SPECULATIVE wake. Apply last
            // cycle's prediction (gp_wake0_pdst_q = the rd_pdst of an entry that became
            // newly-fully-ready last cycle, hence predicted SELECTED this cycle) to
            // pre-wake ITS consumers — one cycle earlier than the conservative sched/sel
            // wake above would reach them. This recovers the +1cy A1.0 costs on dependent
            // ALU chains (§10.2). Runs AFTER the scheduled wake so it only ADDS readiness
            // (last-write-wins). Sets rs*_rdy for EXISTING entries only — NOT prf_ready
            // (no speculative seed of a same-cycle rename) and NOT prf_done — so a
            // mis-predicted consumer's PRESENT stays gated by the FR fr0_src_done
            // (prf_done = real broadcast): it SELECTs early then HOLDs, never stale-reads
            // (§10.1, ALU class = no replay). DEAD at SPEC_WAKE=0 (block removed).
            if SPEC_WAKE {
                for i in 0..IQ_N {
                    // A1.1 speculation is restricted to FIXED-LATENCY ALU-class CONSUMERS
                    // (§10.1). A memory-op consumer (load/store/amo/csr/fp) must NOT be
                    // spec-woken: its issue-side-effects (AMO RFO) and store-ordering are
                    // NOT covered by the prf_done PRESENT hold, so an early speculative
                    // SELECT breaks ordering/results (MEASURED: without this gate,
                    // rv64ui-lh / rv64ua-amoxor_w / litmus N=2 fail; SEL_PIPE=1 alone is
                    // 252/0). ALU/branch/mul/div consumers hold safely in the FR until
                    // prf_done, so they are the only ones woken early.
                    let spec_ok: logic = !sh_is_load[i] && !sh_is_store[i] && !sh_is_amo[i]
                        && !sh_is_csr[i] && !sh_fp_ld[i] && !sh_fp_st[i];
                    // §10.8: apply BOTH grandparent lanes (gp0 = oldest, gp1 = 2nd-oldest
                    // newly-ready producer) so the 2-wide issue's two producers both
                    // pre-wake their consumers a cycle early.
                    let m1: logic = (gp_wake0_en_q && sh_rs1_pdst[i] == gp_wake0_pdst_q)
                        || (gp_wake1_en_q && sh_rs1_pdst[i] == gp_wake1_pdst_q);
                    let m2: logic = (gp_wake0_en_q && sh_rs2_pdst[i] == gp_wake0_pdst_q)
                        || (gp_wake1_en_q && sh_rs2_pdst[i] == gp_wake1_pdst_q);
                    if occupied[i] && spec_ok && m1 {
                        rs1_rdy[i] = 1'b1;
                    }
                    if occupied[i] && spec_ok && !sh_rs2_is_fp[i] && m2 {
                        rs2_rdy[i] = 1'b1;
                    }
                }
            }
            // A-LOOP A1.1 (SPEC_WAKE): register the two grandparent predictors (the comb
            // detection above the always_ff). GATED by SPEC_WAKE so the D input const-folds
            // to 0 at SPEC_WAKE=0: `veryl synth` does NOT DCE an unused REGISTER (only its
            // Q's fanout), so an ungated write leaves the recursive 2-lane predictor cone
            // (cand_gp0 → gp0 argmin → cand_gp1 → gp1 argmin → sh_rd_pdst dyn-mux) driving
            // the FF D — a 16.78 ns dead path that becomes the synth #1 even though the Q is
            // unused (byte-identical in sim, but NOT synth-CP-neutral). Gating the D to a
            // const makes the cone DCE-able so the committed DEAD state is truly neutral.
            gp_wake0_en_q   = if SPEC_WAKE ? gp_wake0_en   : 1'b0;
            gp_wake0_pdst_q = if SPEC_WAKE ? gp_wake0_pdst : 6'd0;
            gp_wake1_en_q   = if SPEC_WAKE ? gp_wake1_en   : 1'b0;
            gp_wake1_pdst_q = if SPEC_WAKE ? gp_wake1_pdst : 6'd0;
            // Rename clears prf_ready[new_pdst] so subsequent renames
            // that depend on it see "not ready" until producer writes back.
            if i_rename_set_pending {
                prf_ready[i_rename_pdst] = 1'b0;
                prf_done[i_rename_pdst]  = 1'b0; // FR fix A: new producer has not executed
            }
            // Phase 8 S2: slot-1 rename clears its own new pdst's ready bit
            // (2-wide rename). Gated off (i_rename_set_pending2=0) until S4.
            if i_rename_set_pending2 {
                prf_ready[i_rename_pdst2] = 1'b0;
                prf_done[i_rename_pdst2]  = 1'b0; // FR fix A: new producer has not executed (slot-1)
            }
            // Issue: free the slot once the op leaves the IQ. slot0_grant folds to
            // (i_issue_ack && has_issuable) when FRONT_PIPE=0 (today); when FRONT_PIPE
            // it is fr_capture0 — the op is freed AT CAPTURE into the FR (the FR then
            // holds the only copy and drains to the core on its own ack).
            if slot0_grant {
                occupied[issue_idx] = 1'b0;
            }
            // Phase 8 S3.b: free the slot-1 (pipe-1) issued entry. issue_idx2 !=
            // issue_idx by construction, so the two frees touch distinct elements.
            if slot1_grant {
                occupied[issue_idx2] = 1'b0;
            }
            // Allocate: install op in free_idx, sample initial ready bits
            // from prf_ready. For !has_rsN ops the ready bit is forced 1.
            if i_alloc_en && has_free_slot {
                ops[free_idx]           = i_alloc_op;
                sh_rs1_pdst[free_idx]   = i_alloc_op.rs1_pdst;
                sh_rs2_pdst[free_idx]   = i_alloc_op.rs2_pdst;
                sh_rd_pdst[free_idx]    = i_alloc_op.rd_pdst;
                sh_rd_old_pdst[free_idx] = i_alloc_op.old_rd_pdst;
                sh_has_rd[free_idx]     = i_alloc_op.base.has_rd;
                sh_rob_idx[free_idx]    = i_alloc_op.rob_idx;
                sh_is_load[free_idx]    = i_alloc_op.base.is_load;
                sh_is_store[free_idx]   = i_alloc_op.base.is_store;
                sh_is_amo[free_idx]     = i_alloc_op.base.is_amo;
                sh_is_div[free_idx]     = alloc_is_div;
                sh_amo_funct5[free_idx] = i_alloc_op.base.amo_funct5;
                sh_is_cas_q[free_idx]   = i_alloc_op.base.is_cas_q;
                sh_is_csr[free_idx]     = i_alloc_op.base.is_csr;
                sh_csr_addr[free_idx]   = i_alloc_op.base.csr_addr;
                sh_csr_op[free_idx]     = i_alloc_op.base.csr_op;
                sh_csr_imm[free_idx]    = i_alloc_op.base.csr_imm;
                sh_rs1_arch[free_idx]   = i_alloc_op.base.rs1_arch;
                sh_fp_ld[free_idx]      = i_alloc_op.base.fp_ld;
                sh_fp_st[free_idx]      = i_alloc_op.base.fp_st;
                sh_rs2_is_fp[free_idx]  = i_alloc_op.base.fp_st;
                occupied[free_idx]      = 1'b1;
                // Initial readiness: sample prf_ready at rename. If the
                // CDB *this cycle* matches rs*_pdst the rs*_rdy needs to
                // reflect that. The CDB snoop above runs for ALL ops
                // (not just the just-allocated one), but free_idx was
                // !occupied — the loop skipped it. Handle here:
                // Phase 8 S3: a same-cycle producer may be on either CDB lane.
                rs1_rdy[free_idx] = (!i_alloc_op.base.has_rs1) || prf_ready[i_alloc_op.rs1_pdst]
                    || (i_cdb_valid && i_cdb_has_rd && i_cdb_pdst == i_alloc_op.rs1_pdst)
                    || (i_cdb2_valid && i_cdb2_has_rd && i_cdb2_pdst == i_alloc_op.rs1_pdst);
                // M6.B.3: an FP store's rs2 (data) is an FP source — seed its
                // readiness from the FP query / FP CDB instead of the int bitmap.
                rs2_rdy[free_idx] = (!i_alloc_op.base.has_rs2)
                    || (if i_alloc_op.base.fp_st ? i_alloc_rs2_fp_ready : prf_ready[i_alloc_op.rs2_pdst])
                    || (if i_alloc_op.base.fp_st ?
                        (i_fp_cdb_valid && i_fp_cdb_has_rd && i_fp_cdb_pdst == i_alloc_op.rs2_pdst)
                        : ((i_cdb_valid && i_cdb_has_rd && i_cdb_pdst == i_alloc_op.rs2_pdst)
                            || (i_cdb2_valid && i_cdb2_has_rd && i_cdb2_pdst == i_alloc_op.rs2_pdst)));
            }
            // Phase 8 S2: slot-1 alloc (younger op of the rename bundle) to
            // free_idx2. Mirrors slot-0 with i_alloc_op2 / free_idx2; gated off
            // (i_alloc_en2=0) until S4. NOTE for S4: when slot-1 sources slot-0's
            // just-renamed pdst (intra-bundle RAW), prf_ready sampled here is the
            // stale pre-clear value under NBA — S4 must force rs*_rdy=0 for that
            // case (slot-0 has not executed yet). Tracked as an S4 flip task.
            if i_alloc_en2 && has_free_slot2 {
                ops[free_idx2]           = i_alloc_op2;
                sh_rs1_pdst[free_idx2]   = i_alloc_op2.rs1_pdst;
                sh_rs2_pdst[free_idx2]   = i_alloc_op2.rs2_pdst;
                sh_rd_pdst[free_idx2]    = i_alloc_op2.rd_pdst;
                sh_rd_old_pdst[free_idx2] = i_alloc_op2.old_rd_pdst;
                sh_has_rd[free_idx2]     = i_alloc_op2.base.has_rd;
                sh_rob_idx[free_idx2]    = i_alloc_op2.rob_idx;
                sh_is_load[free_idx2]    = i_alloc_op2.base.is_load;
                sh_is_store[free_idx2]   = i_alloc_op2.base.is_store;
                sh_is_amo[free_idx2]     = i_alloc_op2.base.is_amo;
                sh_is_div[free_idx2]     = alloc_is_div2;
                sh_amo_funct5[free_idx2] = i_alloc_op2.base.amo_funct5;
                sh_is_cas_q[free_idx2]   = i_alloc_op2.base.is_cas_q;
                sh_is_csr[free_idx2]     = i_alloc_op2.base.is_csr;
                sh_csr_addr[free_idx2]   = i_alloc_op2.base.csr_addr;
                sh_csr_op[free_idx2]     = i_alloc_op2.base.csr_op;
                sh_csr_imm[free_idx2]    = i_alloc_op2.base.csr_imm;
                sh_rs1_arch[free_idx2]   = i_alloc_op2.base.rs1_arch;
                sh_fp_ld[free_idx2]      = i_alloc_op2.base.fp_ld;
                sh_fp_st[free_idx2]      = i_alloc_op2.base.fp_st;
                sh_rs2_is_fp[free_idx2]  = i_alloc_op2.base.fp_st;
                occupied[free_idx2]      = 1'b1;
                // Phase 8 S4b: force not-ready on an intra-bundle RAW (s1_intra_*);
                // else sample prf_ready + BOTH int CDB lanes same-cycle (lane 1 /
                // i_cdb2 was missing — a slot-0/older producer can land on pipe-1).
                rs1_rdy[free_idx2] = (!i_alloc_op2.base.has_rs1)
                    || (!s1_intra_rs1
                        && (prf_ready[i_alloc_op2.rs1_pdst]
                            || (i_cdb_valid && i_cdb_has_rd && i_cdb_pdst == i_alloc_op2.rs1_pdst)
                            || (i_cdb2_valid && i_cdb2_has_rd && i_cdb2_pdst == i_alloc_op2.rs1_pdst)));
                rs2_rdy[free_idx2] = (!i_alloc_op2.base.has_rs2)
                    || (if i_alloc_op2.base.fp_st ?
                        (i_alloc_rs2_fp_ready
                            || (i_fp_cdb_valid && i_fp_cdb_has_rd && i_fp_cdb_pdst == i_alloc_op2.rs2_pdst))
                    :
                        (!s1_intra_rs2
                            && (prf_ready[i_alloc_op2.rs2_pdst]
                                || (i_cdb_valid && i_cdb_has_rd && i_cdb_pdst == i_alloc_op2.rs2_pdst)
                                || (i_cdb2_valid && i_cdb2_has_rd && i_cdb2_pdst == i_alloc_op2.rs2_pdst))));
            }
            // Phase 8 S8.D: partial age-based squash (gated off until S8.E). After
            // this cycle's CDB wakeups + (suppressed) alloc, drop only the entries
            // YOUNGER than the branch — rob age (relative to head) strictly greater
            // than the branch's age. Older entries survive with their wakeups.
            // i_flush (full clear) is the mutually-exclusive commit-time path.
            if i_squash_en {
                // Wrap both ages to ROB_IDX_W via 5-bit intermediates (mirrors the
                // issue-select `age` above). The inline subtraction form widens under
                // the Veryl cc sim and mis-clears entries (see rob.veryl squash note).
                let sq_branch_age: logic<ROB_IDX_W> = i_squash_idx - i_rob_head_idx;
                for i in 0..IQ_N {
                    let sq_age: logic<ROB_IDX_W> = sh_rob_idx[i] - i_rob_head_idx;
                    if occupied[i] && (sq_age >: sq_branch_age) {
                        occupied[i] = 1'b0;
                    }
                }
            }
            // CP front-pipeline (I2): FR capture / drain / partial-squash. Dead when
            // FRONT_PIPE=0 (fr*_valid_q never set → o_issue_* take the live select).
            // capture refills (and overrides a same-cycle drain so the FR runs
            // 1/cycle); else drain empties; else a partial squash drops the held op
            // if it is YOUNGER than the resolving branch — mirroring the IQ squash
            // above. ops[issue_idx] is the live select (issue_idx != free_idx, so
            // alloc never aliases it).
            if FRONT_PIPE {
                // CP front-pipeline (FR squash, NBA-correct). capture/drain/squash
                // MUST be mutually exclusive: this is an always_ff, so reads of
                // fr0_op_q/fr0_valid_q in a later statement see the PRE-edge value
                // (NBA), not a same-cycle capture. The old code captured (fr0_op_q <=
                // new) then ran the squash reading the OLD fr0_op_q's age but writing
                // fr0_valid_q — when a capture and a younger-than-branch OLD occupant
                // coincided, the squash's `fr0_valid_q <= 0` clobbered the capture's
                // `<= 1`, ORPHANING the just-captured op (it left the IQ at fr_capture
                // but its FR valid bit was cleared). The fix: decide validity from the
                // op that will ACTUALLY occupy the FR this cycle — the captured op
                // (squash it by ITS own age) on capture, else the held op (squash by
                // its age) on hold. A simultaneous drain (refill) is subsumed by the
                // capture branch; the drained old op already executed combinationally.
                let sq_br_age: logic<ROB_IDX_W> = i_squash_idx - i_rob_head_idx;
                if fr_capture0 {
                    let cap_age0: logic<ROB_IDX_W> = ops[issue_idx].rob_idx - i_rob_head_idx;
                    fr0_op_q    = ops[issue_idx];
                    fr0_valid_q = !(i_squash_en && (cap_age0 >: sq_br_age));
                } else if fr_drain0 {
                    fr0_valid_q = 1'b0;
                } else if i_squash_en && fr0_valid_q {
                    let hold_age0: logic<ROB_IDX_W> = fr0_op_q.rob_idx - i_rob_head_idx;
                    if hold_age0 >: sq_br_age {
                        fr0_valid_q = 1'b0;
                    }
                }
                if fr_capture1 {
                    let cap_age1: logic<ROB_IDX_W> = ops[issue_idx2].rob_idx - i_rob_head_idx;
                    fr1_op_q    = ops[issue_idx2];
                    fr1_valid_q = !(i_squash_en && (cap_age1 >: sq_br_age));
                } else if fr_drain1 {
                    fr1_valid_q = 1'b0;
                } else if i_squash_en && fr1_valid_q {
                    let hold_age1: logic<ROB_IDX_W> = fr1_op_q.rob_idx - i_rob_head_idx;
                    if hold_age1 >: sq_br_age {
                        fr1_valid_q = 1'b0;
                    }
                }
            }
        }
    }
}
