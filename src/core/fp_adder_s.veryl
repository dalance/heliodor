// IEEE 754 single-precision floating-point adder/subtractor
// Handles normals, subnormals, zeros, infinities, NaNs.
// PIPE: 0 = combinational (legacy, byte-identical); 1 = 2-stage (result valid N+1).
// The datapath is cut after the aligned add (stage 1) / before normalize+round
// (stage 2); PIPE=0 bypasses the midpoint register → identical combinational result.
pub module fp_adder_s #(
    param PIPE: u32 = 0,
) (
    clk     : input  clock     ,
    rst     : input  reset     ,
    i_a     : input  logic<32>,
    i_b     : input  logic<32>,
    i_sub   : input  logic    ,
    i_rm    : input  logic<3> ,
    o_result: output logic<32>,
    o_fflags: output logic<5> ,
) {
    import fpu_pkg::*;

    function clz26 (
        val: input logic<26>,
    ) -> logic<5> {
        let r: logic<9> = clz::<26>(val);
        return r[4:0];
    }

    // Overflow result per rounding mode (IEEE/RISC-V): RNE/RMM -> inf,
    // RTZ -> max normal, RDN -> +max/-inf, RUP -> +inf/-max.
    function ovf_s (
        rm : input logic<3>,
        sgn: input logic   ,
    ) -> logic<32> {
        var r  : logic<32>;
        let inf: logic<32> = {sgn, 8'hFF, 23'd0};
        let mx : logic<32> = {sgn, 8'hFE, 23'h7FFFFF};
        case rm {
            3'b001 : r = mx;
            3'b010 : r = if sgn ? inf : mx;
            3'b011 : r = if sgn ? mx : inf;
            default: r = inf;
        }
        return r;
    }

    // ===== Stage 1: unpack / classify / align / add + special-case resolve =====
    var s1_done: logic    ;
    var s1_res : logic<32>;
    var s1_ffl : logic<5> ;
    var s1_sum : logic<28>;
    var s1_exp : logic<10>;
    var s1_sign: logic    ;
    always_comb {
        var sa    : logic    ;
        var ea    : logic<8> ;
        var ma    : logic<23>;
        var sb_raw: logic    ;
        var eb    : logic<8> ;
        var mb    : logic<23>;
        var sb    : logic    ;
        sa     = i_a[31];
        ea     = i_a[30:23];
        ma     = i_a[22:0];
        sb_raw = i_b[31];
        eb     = i_b[30:23];
        mb     = i_b[22:0];
        sb     = sb_raw ^ i_sub;

        var a_is_zero: logic;
        var b_is_zero: logic;
        var a_is_inf : logic;
        var b_is_inf : logic;
        var a_is_nan : logic;
        var b_is_nan : logic;
        var a_is_snan: logic;
        var b_is_snan: logic;
        var a_is_sub : logic;
        var b_is_sub : logic;
        a_is_zero = ea == 8'd0 && ma == 23'd0;
        b_is_zero = eb == 8'd0 && mb == 23'd0;
        a_is_inf  = ea == 8'hFF && ma == 23'd0;
        b_is_inf  = eb == 8'hFF && mb == 23'd0;
        a_is_nan  = ea == 8'hFF && ma != 23'd0;
        b_is_nan  = eb == 8'hFF && mb != 23'd0;
        a_is_snan = a_is_nan && ma[22] == 1'b0;
        b_is_snan = b_is_nan && mb[22] == 1'b0;
        a_is_sub  = ea == 8'd0 && ma != 23'd0;
        b_is_sub  = eb == 8'd0 && mb != 23'd0;

        var ea_eff: logic<10>;
        var eb_eff: logic<10>;
        if a_is_sub || a_is_zero {
            ea_eff = 10'd1;
        } else {
            ea_eff = {2'b0, ea};
        }
        if b_is_sub || b_is_zero {
            eb_eff = 10'd1;
        } else {
            eb_eff = {2'b0, eb};
        }

        var imp_a: logic;
        var imp_b: logic;
        if a_is_sub || a_is_zero {
            imp_a = 1'b0;
        } else {
            imp_a = 1'b1;
        }
        if b_is_sub || b_is_zero {
            imp_b = 1'b0;
        } else {
            imp_b = 1'b1;
        }
        var sig_a: logic<24>;
        var sig_b: logic<24>;
        sig_a = {imp_a, ma};
        sig_b = {imp_b, mb};

        // Extend to 27 bits for G/R/S
        var ext_a: logic<27>;
        var ext_b: logic<27>;
        ext_a = {sig_a, 3'b000};
        ext_b = {sig_b, 3'b000};

        var a_ge_b: logic;
        if ea_eff != eb_eff {
            a_ge_b = ea_eff >: eb_eff;
        } else {
            a_ge_b = !(sig_a <: sig_b);
        }

        var large_sign: logic    ;
        var small_sign: logic    ;
        var large_ext : logic<27>;
        var small_ext : logic<27>;
        var result_exp: logic<10>;
        var shift_amt : logic<10>;
        if a_ge_b {
            large_sign = sa;
            small_sign = sb;
            large_ext  = ext_a;
            small_ext  = ext_b;
            result_exp = ea_eff;
            shift_amt  = ea_eff - eb_eff;
        } else {
            large_sign = sb;
            small_sign = sa;
            large_ext  = ext_b;
            small_ext  = ext_a;
            result_exp = eb_eff;
            shift_amt  = eb_eff - ea_eff;
        }

        var shift_clamped: logic<5>;
        if shift_amt >: 10'd27 {
            shift_clamped = 5'd27;
        } else {
            shift_clamped = shift_amt[4:0];
        }

        var shifted            : logic<27>;
        var shift_mask         : logic<27>;
        var sticky_shift       : logic    ;
        var shifted_with_sticky: logic<27>;
        shifted             = small_ext >> shift_clamped;
        shift_mask          = (27'd1 << shift_clamped) - 27'd1;
        sticky_shift        = (small_ext & shift_mask) != 27'd0;
        shifted_with_sticky = {shifted[26:1], shifted[0] | sticky_shift};

        var eff_sub: logic;
        eff_sub = large_sign ^ small_sign;

        var sum32: logic<32>;
        if eff_sub {
            sum32 = {5'd0, large_ext} - {5'd0, shifted_with_sticky};
        } else {
            sum32 = {5'd0, large_ext} + {5'd0, shifted_with_sticky};
        }
        var sum: logic<28>;
        sum = sum32[27:0];

        // Stage-1 outputs to the midpoint
        s1_sum  = sum;
        s1_exp  = result_exp;
        s1_sign = large_sign;
        s1_done = 1'b0;
        s1_res  = 32'd0;
        s1_ffl  = 5'd0;

        if a_is_nan || b_is_nan {
            s1_done = 1'b1;
            s1_res  = 32'h7FC00000;
            if a_is_snan || b_is_snan {
                s1_ffl = 5'b10000;
            }
        } else if a_is_inf && b_is_inf {
            s1_done = 1'b1;
            if sa == sb {
                s1_res = {sa, 8'hFF, 23'd0};
            } else {
                s1_res = 32'h7FC00000;
                s1_ffl = 5'b10000;
            }
        } else if a_is_inf {
            s1_done = 1'b1;
            s1_res  = {sa, 8'hFF, 23'd0};
        } else if b_is_inf {
            s1_done = 1'b1;
            s1_res  = {sb, 8'hFF, 23'd0};
        } else if a_is_zero && b_is_zero {
            s1_done = 1'b1;
            let zero_sign: logic = if sa == sb ? sa : if i_rm == 3'b010 ? 1'b1 : 1'b0;
            s1_res = {zero_sign, 31'd0};
        } else if a_is_zero {
            s1_done = 1'b1;
            s1_res  = {sb, eb, mb};
        } else if b_is_zero {
            s1_done = 1'b1;
            s1_res  = {sa, ea, ma};
        } else {
            s1_done = 1'b0; // normal: stage 2
        }
    }

    // ===== Midpoint register (cut) + PIPE=0 bypass =====
    var s1_done_q: logic    ;
    var s1_res_q : logic<32>;
    var s1_ffl_q : logic<5> ;
    var s1_sum_q : logic<28>;
    var s1_exp_q : logic<10>;
    var s1_sign_q: logic    ;
    var s1_rm_q  : logic<3> ;
    always_ff (clk, rst) {
        if_reset {
            s1_done_q = 1'b0;
            s1_res_q  = 32'd0;
            s1_ffl_q  = 5'd0;
            s1_sum_q  = 28'd0;
            s1_exp_q  = 10'd0;
            s1_sign_q = 1'b0;
            s1_rm_q   = 3'd0;
        } else {
            s1_done_q = s1_done;
            s1_res_q  = s1_res;
            s1_ffl_q  = s1_ffl;
            s1_sum_q  = s1_sum;
            s1_exp_q  = s1_exp;
            s1_sign_q = s1_sign;
            s1_rm_q   = i_rm;
        }
    }
    let s1_done_sel: logic     = if PIPE == 1 ? s1_done_q : s1_done;
    let s1_res_sel : logic<32> = if PIPE == 1 ? s1_res_q : s1_res;
    let s1_ffl_sel : logic<5>  = if PIPE == 1 ? s1_ffl_q : s1_ffl;
    let s1_sum_sel : logic<28> = if PIPE == 1 ? s1_sum_q : s1_sum;
    let s1_exp_sel : logic<10> = if PIPE == 1 ? s1_exp_q : s1_exp;
    let s1_sign_sel: logic     = if PIPE == 1 ? s1_sign_q : s1_sign;
    let s1_rm_sel  : logic<3>  = if PIPE == 1 ? s1_rm_q : i_rm;

    // ===== Stage 2: normalize + round =====
    var result: logic<32>;
    var fflags: logic<5> ;
    always_comb {
        var r_exp : logic<10>;
        var r_mant: logic<27>;
        result = 32'd0;
        fflags = 5'd0;
        r_exp  = s1_exp_sel;
        r_mant = {s1_sum_sel[26:0]};

        if s1_done_sel {
            result = s1_res_sel;
            fflags = s1_ffl_sel;
        } else {
            if s1_sum_sel == 28'd0 {
                let zs: logic = if s1_rm_sel == 3'b010 ? 1'b1 : 1'b0;
                result = {zs, 31'd0};
            } else if s1_sum_sel[27] {
                var co_m: logic<27>;
                co_m = s1_sum_sel[27:1];
                co_m = {co_m[26:1], co_m[0] | s1_sum_sel[0]};
                var co_e: logic<10>;
                co_e = s1_exp_sel + 10'd1;
                var co_g: logic;
                var co_r: logic;
                var co_s: logic;
                var co_l: logic;
                co_g = co_m[2];
                co_r = co_m[1];
                co_s = co_m[0];
                co_l = co_m[3];
                var co_ru: logic;
                case s1_rm_sel {
                    3'b000 : co_ru = co_g && (co_r || co_s || co_l);
                    3'b001 : co_ru = 1'b0;
                    3'b010 : co_ru = s1_sign_sel && (co_g || co_r || co_s);
                    3'b011 : co_ru = !s1_sign_sel && (co_g || co_r || co_s);
                    3'b100 : co_ru = co_g;
                    default: co_ru = co_g && (co_r || co_s || co_l);
                }
                var co_rd: logic<24>;
                co_rd = co_m[26:3] + {23'd0, co_ru};
                if co_rd[23] && !co_m[26] {
                    co_e = co_e + 10'd1;
                }
                if co_e >= 10'd255 {
                    result = ovf_s(s1_rm_sel, s1_sign_sel);
                    fflags = 5'b00101;
                } else {
                    result = {s1_sign_sel, co_e[7:0], co_rd[22:0]};
                    if co_g || co_r || co_s {
                        fflags = 5'b00001;
                    }
                }
            } else {
                let lzc         : logic<5>  = clz26(s1_sum_sel[25:0]);
                let actual_shift: logic<5>  = if s1_sum_sel[26] ? 5'd0 : lzc + 5'd1;
                let norm_mant   : logic<27> = s1_sum_sel[26:0] << actual_shift;
                let norm_exp    : logic<10> = s1_exp_sel - {5'd0, actual_shift};
                if $signed(norm_exp) <= 10'sd0 {
                    let ss: logic<10> = 10'd1 - norm_exp;
                    let sc: logic<5>  = if ss >: 10'd27 ? 5'd27 : ss[4:0];
                    let sm: logic<27> = norm_mant >> sc;
                    let st: logic     = (norm_mant & ((27'd1 << sc) - 27'd1)) != 27'd0;
                    r_mant = {sm[26:1], sm[0] | st};
                    r_exp  = 10'd0;
                } else {
                    r_mant = norm_mant;
                    r_exp  = norm_exp;
                }
                var nc_g: logic;
                var nc_r: logic;
                var nc_s: logic;
                var nc_l: logic;
                nc_g = r_mant[2];
                nc_r = r_mant[1];
                nc_s = r_mant[0];
                nc_l = r_mant[3];
                var nc_ru: logic;
                case s1_rm_sel {
                    3'b000 : nc_ru = nc_g && (nc_r || nc_s || nc_l);
                    3'b001 : nc_ru = 1'b0;
                    3'b010 : nc_ru = s1_sign_sel && (nc_g || nc_r || nc_s);
                    3'b011 : nc_ru = !s1_sign_sel && (nc_g || nc_r || nc_s);
                    3'b100 : nc_ru = nc_g;
                    default: nc_ru = nc_g && (nc_r || nc_s || nc_l);
                }
                var nc_rd: logic<25>;
                nc_rd = {1'b0, r_mant[26:3]} + {24'd0, nc_ru};
                var fe: logic<10>;
                var fm: logic<23>;
                if nc_rd[24] {
                    fe = r_exp + 10'd1;
                    fm = nc_rd[23:1];
                } else {
                    fe = r_exp;
                    fm = nc_rd[22:0];
                }
                var nc_nx: logic;
                nc_nx = nc_g || nc_r || nc_s;
                if fe >= 10'd255 {
                    result = ovf_s(s1_rm_sel, s1_sign_sel);
                    fflags = 5'b00101;
                } else {
                    result = {s1_sign_sel, fe[7:0], fm};
                    if nc_nx {
                        fflags = 5'b00001;
                    }
                    if fe == 10'd0 && nc_nx {
                        fflags = 5'b00011;
                    }
                }
            }
        }
    }

    assign o_result = result;
    assign o_fflags = fflags;
}
