// heliodor_core_w2, heliodor_core_w4: the core under each supported config
// as a non-generic module, so the SoC and Verilator wrappers name one module
// per config. Ports are those of heliodor_core.

pub module heliodor_core_w2 #(
    param PMA_N      : u32                            = 1,
    param PMA_REGIONS: pma_pkg::PmaRegion     [PMA_N] = '{
        default: pma_pkg::PmaRegion'{base: 0, mask: 0, attr: 0 as pma_pkg::PmaAttr}
    },
) (
    clk: input clock,
    rst: input reset,

    i_hart_id : input logic<8> ,
    i_reset_pc: input logic<64>,

    o_dmem_addr     : output logic<64>,
    o_dmem_ren      : output logic    ,
    o_dmem_req      : output logic    ,
    o_dmem_rfo      : output logic    ,
    o_dmem_dram     : output logic    ,
    i_dmem_grant    : input  logic    ,
    i_dmem_rdata    : input  logic<64>,
    i_dmem_fill_excl: input  logic    ,

    o_imemr_addr : output logic<64>,
    o_imemr_req  : output logic    ,
    o_imemr_dram : output logic    ,
    o_imemr_iread: output logic    ,
    i_imemr_grant: input  logic    ,
    i_imemr_rdata: input  logic<64>,

    o_dmemw_addr : output logic<64>    ,
    o_dmem_wdata : output logic<64> [8],
    o_dmem_wstrb : output logic<8>  [8],
    o_dmem_wen   : output logic        ,
    o_dmemw_wb   : output logic        ,
    o_dmemw_req  : output logic        ,
    i_dmemw_grant: input  logic        ,

    i_probe_v   : input  logic    ,
    i_probe_addr: input  logic<64>,
    i_probe_self: input  logic    ,
    o_probe_ack : output logic    ,
    i_inv_v     : input  logic    ,
    i_inv_addr  : input  logic<64>,
    i_inv2_v    : input  logic    ,
    i_inv2_addr : input  logic<64>,

    i_irq_timer_m: input logic    ,
    i_irq_sw_m   : input logic    ,
    i_irq_ext_m  : input logic    ,
    i_irq_ext_s  : input logic    ,
    i_mtime      : input logic<64>,

    o_retire : output retire_pkg::RetireRec [cfg_w2::COMMIT_W],
    o_irq_evt: output retire_pkg::IrqEvent                 ,

    i_dbg_retire_limit_en: input logic    ,
    i_dbg_retire_limit   : input logic<64>,
    i_dbg_irq_mask       : input logic    ,
    i_dbg_irq_allow      : input logic    ,

    o_perf: output core_types::<cfg_w2>::CorePerf,
    o_chk : output core_types::<cfg_w2>::CoreChk ,
) {
    inst u_core: heliodor_core::<cfg_w2> #(
        PMA_N      : PMA_N      ,
        PMA_REGIONS: PMA_REGIONS,
    ) (
        clk                  ,
        rst                  ,
        i_hart_id            ,
        i_reset_pc           ,
        o_dmem_addr          ,
        o_dmem_ren           ,
        o_dmem_req           ,
        o_dmem_rfo           ,
        o_dmem_dram          ,
        i_dmem_grant         ,
        i_dmem_rdata         ,
        i_dmem_fill_excl     ,
        o_imemr_addr         ,
        o_imemr_req          ,
        o_imemr_dram         ,
        o_imemr_iread        ,
        i_imemr_grant        ,
        i_imemr_rdata        ,
        o_dmemw_addr         ,
        o_dmem_wdata         ,
        o_dmem_wstrb         ,
        o_dmem_wen           ,
        o_dmemw_wb           ,
        o_dmemw_req          ,
        i_dmemw_grant        ,
        i_probe_v            ,
        i_probe_addr         ,
        i_probe_self         ,
        o_probe_ack          ,
        i_inv_v              ,
        i_inv_addr           ,
        i_inv2_v             ,
        i_inv2_addr          ,
        i_irq_timer_m        ,
        i_irq_sw_m           ,
        i_irq_ext_m          ,
        i_irq_ext_s          ,
        i_mtime              ,
        o_retire             ,
        o_irq_evt            ,
        i_dbg_retire_limit_en,
        i_dbg_retire_limit   ,
        i_dbg_irq_mask       ,
        i_dbg_irq_allow      ,
        o_perf               ,
        o_chk                ,
    );
}

pub module heliodor_core_w4 #(
    param PMA_N      : u32                            = 1,
    param PMA_REGIONS: pma_pkg::PmaRegion     [PMA_N] = '{
        default: pma_pkg::PmaRegion'{base: 0, mask: 0, attr: 0 as pma_pkg::PmaAttr}
    },
) (
    clk: input clock,
    rst: input reset,

    i_hart_id : input logic<8> ,
    i_reset_pc: input logic<64>,

    o_dmem_addr     : output logic<64>,
    o_dmem_ren      : output logic    ,
    o_dmem_req      : output logic    ,
    o_dmem_rfo      : output logic    ,
    o_dmem_dram     : output logic    ,
    i_dmem_grant    : input  logic    ,
    i_dmem_rdata    : input  logic<64>,
    i_dmem_fill_excl: input  logic    ,

    o_imemr_addr : output logic<64>,
    o_imemr_req  : output logic    ,
    o_imemr_dram : output logic    ,
    o_imemr_iread: output logic    ,
    i_imemr_grant: input  logic    ,
    i_imemr_rdata: input  logic<64>,

    o_dmemw_addr : output logic<64>    ,
    o_dmem_wdata : output logic<64> [8],
    o_dmem_wstrb : output logic<8>  [8],
    o_dmem_wen   : output logic        ,
    o_dmemw_wb   : output logic        ,
    o_dmemw_req  : output logic        ,
    i_dmemw_grant: input  logic        ,

    i_probe_v   : input  logic    ,
    i_probe_addr: input  logic<64>,
    i_probe_self: input  logic    ,
    o_probe_ack : output logic    ,
    i_inv_v     : input  logic    ,
    i_inv_addr  : input  logic<64>,
    i_inv2_v    : input  logic    ,
    i_inv2_addr : input  logic<64>,

    i_irq_timer_m: input logic    ,
    i_irq_sw_m   : input logic    ,
    i_irq_ext_m  : input logic    ,
    i_irq_ext_s  : input logic    ,
    i_mtime      : input logic<64>,

    o_retire : output retire_pkg::RetireRec [cfg_w4::COMMIT_W],
    o_irq_evt: output retire_pkg::IrqEvent                 ,

    i_dbg_retire_limit_en: input logic    ,
    i_dbg_retire_limit   : input logic<64>,
    i_dbg_irq_mask       : input logic    ,
    i_dbg_irq_allow      : input logic    ,

    o_perf: output core_types::<cfg_w4>::CorePerf,
    o_chk : output core_types::<cfg_w4>::CoreChk ,
) {
    inst u_core: heliodor_core::<cfg_w4> #(
        PMA_N      : PMA_N      ,
        PMA_REGIONS: PMA_REGIONS,
    ) (
        clk                  ,
        rst                  ,
        i_hart_id            ,
        i_reset_pc           ,
        o_dmem_addr          ,
        o_dmem_ren           ,
        o_dmem_req           ,
        o_dmem_rfo           ,
        o_dmem_dram          ,
        i_dmem_grant         ,
        i_dmem_rdata         ,
        i_dmem_fill_excl     ,
        o_imemr_addr         ,
        o_imemr_req          ,
        o_imemr_dram         ,
        o_imemr_iread        ,
        i_imemr_grant        ,
        i_imemr_rdata        ,
        o_dmemw_addr         ,
        o_dmem_wdata         ,
        o_dmem_wstrb         ,
        o_dmem_wen           ,
        o_dmemw_wb           ,
        o_dmemw_req          ,
        i_dmemw_grant        ,
        i_probe_v            ,
        i_probe_addr         ,
        i_probe_self         ,
        o_probe_ack          ,
        i_inv_v              ,
        i_inv_addr           ,
        i_inv2_v             ,
        i_inv2_addr          ,
        i_irq_timer_m        ,
        i_irq_sw_m           ,
        i_irq_ext_m          ,
        i_irq_ext_s          ,
        i_mtime              ,
        o_retire             ,
        o_irq_evt            ,
        i_dbg_retire_limit_en,
        i_dbg_retire_limit   ,
        i_dbg_irq_mask       ,
        i_dbg_irq_allow      ,
        o_perf               ,
        o_chk                ,
    );
}
