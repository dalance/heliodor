// IEEE 754 single-precision fused multiply-add: round(a*b +/- c) with a SINGLE
// rounding. Handles normals, subnormals, zeros, infinities, NaNs.
//
// Operation select:
//   i_neg_p  negate the product  (a*b)        -> -(a*b)
//   i_sub_c  negate the addend   (+c)         -> -c
// so the four RISC-V FMAs map as:
//   FMADD  =  a*b + c   neg_p=0 sub_c=0
//   FMSUB  =  a*b - c   neg_p=0 sub_c=1
//   FNMSUB = -a*b + c   neg_p=1 sub_c=0
//   FNMADD = -a*b - c   neg_p=1 sub_c=1
//
// Datapath: the full 48-bit product sig_a*sig_b is kept exactly and the 24-bit
// addend significand is aligned into an 80-bit fixed-point window anchored at
// max(product_msb, addend_msb). The larger term always left-shifts (lossless);
// the smaller term right-shifts with a sticky bit. The two terms are added in
// two's complement, the magnitude is normalized (leading-one search) and rounded
// exactly once. This is the IEEE fusedMultiplyAdd, not the non-fused
// round(round(a*b)+c).
//
// PIPE: 0 = combinational (legacy, byte-identical); 1 = 2-stage (result valid N+1).
// The datapath is cut after the aligned two's-complement add (stage 1) / before
// the leading-one normalize + round (stage 2); PIPE=0 bypasses the midpoint
// register → identical combinational result.
pub module fp_fma_s #(
    param PIPE: u32 = 0,
) (
    clk     : input  clock     ,
    rst     : input  reset     ,
    i_a     : input  logic<32>,
    i_b     : input  logic<32>,
    i_c     : input  logic<32>,
    i_neg_p : input  logic    ,
    i_sub_c : input  logic    ,
    i_rm    : input  logic<3> ,
    o_result: output logic<32>,
    o_fflags: output logic<5> ,
) {
    import fpu_pkg::*;

    // Align a 48-bit significand into the 80-bit window. `sh` is the signed
    // left-shift (bit 12 = sign); negative => right shift with sticky. Returns
    // {aligned[79:0], sticky}.
    function align48 (
        sig: input logic<48>,
        sh : input logic<13>,
    ) -> logic<81> {
        var al: logic<80>;
        var st: logic    ;
        let ext: logic<80> = {32'd0, sig};
        if sh[12] == 1'b0 {
            // non-negative: left shift (lossless by construction)
            al = ext << sh[6:0];
            st = 1'b0;
        } else {
            let rs: logic<13> = ~sh + 13'd1; // -sh
            if rs >= 13'd48 {
                al = 80'd0;
                st = sig != 48'd0;
            } else {
                let rsu : logic<6>  = rs[5:0];
                let mask: logic<48> = (48'd1 << rsu) - 48'd1;
                al = ext >> rsu;
                st = (sig & mask) != 48'd0;
            }
        }
        return {al, st};
    }

    function round_up_fn (
        rm : input logic<3>,
        sgn: input logic   ,
        g  : input logic   ,
        rr : input logic   ,
        ss : input logic   ,
        ll : input logic   ,
    ) -> logic {
        var ru: logic;
        case rm {
            3'b000 : ru = g && (rr || ss || ll);
            3'b001 : ru = 1'b0;
            3'b010 : ru = sgn && (g || rr || ss);
            3'b011 : ru = !sgn && (g || rr || ss);
            3'b100 : ru = g;
            default: ru = g && (rr || ss || ll);
        }
        return ru;
    }

    // ===== Stage 1: decode / special-case resolve / multiply + align + add =====
    var s1_done    : logic    ;
    var s1_res     : logic<32>;
    var s1_ffl     : logic<5> ;
    var s1_sum_mag : logic<84>;
    var s1_res_sign: logic    ;
    var s1_lsb_w   : logic<12>;
    always_comb {
        // ---- decode ----
        let sa: logic     = i_a[31];
        let ea: logic<8>  = i_a[30:23];
        let ma: logic<23> = i_a[22:0];
        let sb: logic     = i_b[31];
        let eb: logic<8>  = i_b[30:23];
        let mb: logic<23> = i_b[22:0];
        let sc: logic     = i_c[31];
        let ec: logic<8>  = i_c[30:23];
        let mc: logic<23> = i_c[22:0];

        let a_zero: logic = ea == 8'd0 && ma == 23'd0;
        let b_zero: logic = eb == 8'd0 && mb == 23'd0;
        let c_zero: logic = ec == 8'd0 && mc == 23'd0;
        let a_inf : logic = ea == 8'hFF && ma == 23'd0;
        let b_inf : logic = eb == 8'hFF && mb == 23'd0;
        let c_inf : logic = ec == 8'hFF && mc == 23'd0;
        let a_nan : logic = ea == 8'hFF && ma != 23'd0;
        let b_nan : logic = eb == 8'hFF && mb != 23'd0;
        let c_nan : logic = ec == 8'hFF && mc != 23'd0;
        let a_snan: logic = a_nan && ma[22] == 1'b0;
        let b_snan: logic = b_nan && mb[22] == 1'b0;
        let c_snan: logic = c_nan && mc[22] == 1'b0;
        let a_sub : logic = ea == 8'd0 && ma != 23'd0;
        let b_sub : logic = eb == 8'd0 && mb != 23'd0;
        let c_sub : logic = ec == 8'd0 && mc != 23'd0;

        // signs after applying the negate controls
        let prod_sign: logic = sa ^ sb ^ i_neg_p;
        let c_sign   : logic = sc ^ i_sub_c;

        let inf_zero: logic = (a_inf && b_zero) || (a_zero && b_inf);

        let qnan: logic<32> = 32'h7FC00000;

        // main-path datapath (computed unconditionally; used only when !s1_done)
        let sig_a: logic<24> = if a_sub ? {1'b0, ma} : {1'b1, ma};
        let sig_b: logic<24> = if b_sub ? {1'b0, mb} : {1'b1, mb};
        let sig_c: logic<24> = if c_sub || c_zero ? {1'b0, mc} : {1'b1, mc};

        let ext_a: logic<48> = {24'd0, sig_a};
        let ext_b: logic<48> = {24'd0, sig_b};
        var prod : logic<48>;
        prod = ext_a * ext_b;

        let a_e10: logic<10> = if a_sub ? 10'd1 : {2'd0, ea};
        let b_e10: logic<10> = if b_sub ? 10'd1 : {2'd0, eb};
        let c_e10: logic<10> = if c_sub || c_zero ? 10'd1 : {2'd0, ec};

        let pe: logic<12> = {2'd0, a_e10} + {2'd0, b_e10} - 12'd300;
        let ce: logic<12> = {2'd0, c_e10} - 12'd150;

        let p_top    : logic<12> = pe + 12'd47;
        let c_top    : logic<12> = ce + 12'd23;
        let c_top_eff: logic<12> = if c_zero ? 12'h800 : c_top; // -2048 sentinel
        let top_exp  : logic<12> = if $signed(p_top) >= $signed(c_top_eff) ? p_top : c_top_eff;
        let lsb_w    : logic<12> = top_exp - 12'd78;

        let shift_p: logic<13> = {pe[11], pe} - {lsb_w[11], lsb_w};
        let shift_c: logic<13> = {ce[11], ce} - {lsb_w[11], lsb_w};

        let ap: logic<81> = align48(prod, shift_p);
        let ac: logic<81> = align48({24'd0, sig_c}, shift_c);

        let field_p: logic<81> = ap;
        let field_c: logic<81> = ac;

        let ext_p   : logic<84> = {3'd0, field_p};
        let ext_c   : logic<84> = {3'd0, field_c};
        let signed_p: logic<84> = if prod_sign ? ~ext_p + 84'd1 : ext_p;
        let signed_c: logic<84> = if c_sign ? ~ext_c + 84'd1 : ext_c;
        let sum_s   : logic<84> = signed_p + signed_c;

        let res_sign: logic     = sum_s[83];
        let sum_mag : logic<84> = if sum_s[83] ? ~sum_s + 84'd1 : sum_s;

        // Stage-1 outputs to the midpoint
        s1_sum_mag  = sum_mag;
        s1_res_sign = res_sign;
        s1_lsb_w    = lsb_w;
        s1_done     = 1'b0;
        s1_res      = 32'd0;
        s1_ffl      = 5'd0;

        if a_nan || b_nan || c_nan {
            // NaN operand: canonical qNaN. NV if any sNaN, or inf*0 also present.
            s1_done = 1'b1;
            s1_res  = qnan;
            if a_snan || b_snan || c_snan || inf_zero {
                s1_ffl = 5'b10000;
            }
        } else if inf_zero {
            // 0 * inf (no NaN inputs): invalid
            s1_done = 1'b1;
            s1_res  = qnan;
            s1_ffl  = 5'b10000;
        } else if a_inf || b_inf {
            // product is +/-inf (other operand finite nonzero)
            s1_done = 1'b1;
            if c_inf && (prod_sign != c_sign) {
                s1_res = qnan; // inf - inf
                s1_ffl = 5'b10000;
            } else {
                s1_res = {prod_sign, 8'hFF, 23'd0};
            }
        } else if c_inf {
            // finite product + inf addend
            s1_done = 1'b1;
            s1_res  = {c_sign, 8'hFF, 23'd0};
        } else if a_zero || b_zero {
            // product is zero, all finite
            s1_done = 1'b1;
            if c_zero {
                let zsign: logic = if prod_sign == c_sign ? prod_sign : if i_rm == 3'b010 ? 1'b1 : 1'b0;
                s1_res = {zsign, 31'd0};
            } else {
                // result = +/- c (exact)
                s1_res = {c_sign, i_c[30:0]};
            }
        } else {
            // MAIN PATH: normalize + round deferred to stage 2.
            s1_done = 1'b0;
        }
    }

    // ===== Midpoint register (cut) + PIPE=0 bypass =====
    var s1_done_q    : logic    ;
    var s1_res_q     : logic<32>;
    var s1_ffl_q     : logic<5> ;
    var s1_sum_mag_q : logic<84>;
    var s1_res_sign_q: logic    ;
    var s1_lsb_w_q   : logic<12>;
    var s1_rm_q      : logic<3> ;
    always_ff (clk, rst) {
        if_reset {
            s1_done_q     = 1'b0;
            s1_res_q      = 32'd0;
            s1_ffl_q      = 5'd0;
            s1_sum_mag_q  = 84'd0;
            s1_res_sign_q = 1'b0;
            s1_lsb_w_q    = 12'd0;
            s1_rm_q       = 3'd0;
        } else {
            s1_done_q     = s1_done;
            s1_res_q      = s1_res;
            s1_ffl_q      = s1_ffl;
            s1_sum_mag_q  = s1_sum_mag;
            s1_res_sign_q = s1_res_sign;
            s1_lsb_w_q    = s1_lsb_w;
            s1_rm_q       = i_rm;
        }
    }
    let s1_done_sel    : logic     = if PIPE == 1 ? s1_done_q : s1_done;
    let s1_res_sel     : logic<32> = if PIPE == 1 ? s1_res_q : s1_res;
    let s1_ffl_sel     : logic<5>  = if PIPE == 1 ? s1_ffl_q : s1_ffl;
    let s1_sum_mag_sel : logic<84> = if PIPE == 1 ? s1_sum_mag_q : s1_sum_mag;
    let s1_res_sign_sel: logic     = if PIPE == 1 ? s1_res_sign_q : s1_res_sign;
    let s1_lsb_w_sel   : logic<12> = if PIPE == 1 ? s1_lsb_w_q : s1_lsb_w;
    let s1_rm_sel      : logic<3>  = if PIPE == 1 ? s1_rm_q : i_rm;

    // ===== Stage 2: leading-one normalize + round =====
    var result: logic<32>;
    var fflags: logic<5> ;
    always_comb {
        result = 32'd0;
        fflags = 5'd0;

        if s1_done_sel {
            result = s1_res_sel;
            fflags = s1_ffl_sel;
        } else if s1_sum_mag_sel == 84'd0 {
            // exact cancellation to zero (nonzero operands) -> +0, -0 in RDN
            let zsign: logic = if s1_rm_sel == 3'b010 ? 1'b1 : 1'b0;
            result = {zsign, 31'd0};
        } else {
            // normalize: leading-one search (sum_mag != 0 in this branch)
            let lz84: logic<9> = clz::<84>(s1_sum_mag_sel);
            let lzc : logic<7> = lz84[6:0];
            let norm: logic<84> = s1_sum_mag_sel << lzc;
            // biased exp = lsb_w + 209 - lzc
            let biased: logic<12> = s1_lsb_w_sel + 12'd209 - {5'd0, lzc};

            // 27-bit normalized significand: [26:3] = 24-bit, [2:0] = G,R,S.
            let nm: logic<27> = {norm[83:60], norm[59], norm[58], norm[57:0] != 58'd0};

            // --- unbounded rounding: determines tininess (after rounding) ---
            let ru0  : logic     = round_up_fn(s1_rm_sel, s1_res_sign_sel, nm[2], nm[1], nm[0], nm[3]);
            let sig0 : logic<25> = {1'b0, nm[26:3]} + {24'd0, ru0};
            let exp_u: logic<12> = biased + {11'd0, sig0[24]};
            let tiny : logic     = $signed(exp_u) <= 12'sd0;

            if $signed(biased) >= 12'sd1 {
                // ---- normal result (exact result >= smallest normal) ----
                let nx    : logic = nm[2] || nm[1] || nm[0];
                var efield: logic<12>;
                var frac  : logic<23>;
                if sig0[24] == 1'b1 {
                    efield = biased + 12'd1;
                    frac   = 23'd0;
                } else {
                    efield = biased;
                    frac   = sig0[22:0];
                }
                if $signed(efield) >= 12'sd255 {
                    let inf_r : logic<32> = {s1_res_sign_sel, 8'hFF, 23'd0};
                    let maxn  : logic<32> = {s1_res_sign_sel, 8'hFE, 23'h7FFFFF};
                    var ov_res: logic<32>;
                    case s1_rm_sel {
                        3'b001 : ov_res = maxn;
                        3'b010 : ov_res = if s1_res_sign_sel ? inf_r : maxn;
                        3'b011 : ov_res = if s1_res_sign_sel ? maxn : inf_r;
                        default: ov_res = inf_r;
                    }
                    result = ov_res;
                    fflags  = 5'b00101; // OF | NX
                } else {
                    result = {s1_res_sign_sel, efield[7:0], frac};
                    if nx {
                        fflags = 5'b00001;
                    }
                }
            } else {
                // ---- subnormal result (exact result < smallest normal) ----
                let ss    : logic<12> = 12'd1 - biased;
                let scl   : logic<6>  = if $signed(ss) >: 12'sd27 ? 6'd27 : ss[5:0];
                let sm    : logic<27> = nm >> scl;
                let stk   : logic     = (nm & ((27'd1 << scl) - 27'd1)) != 27'd0;
                let nms   : logic<27> = {sm[26:1], sm[0] | stk};
                let nx_sub: logic     = nms[2] || nms[1] || nms[0];
                let ru1   : logic     = round_up_fn(s1_rm_sel, s1_res_sign_sel, nms[2], nms[1], nms[0], nms[3]);
                let sig1  : logic<25> = {1'b0, nms[26:3]} + {24'd0, ru1};
                let efield: logic<12> = {11'd0, sig1[23]};
                let frac  : logic<23> = sig1[22:0];
                result = {s1_res_sign_sel, efield[7:0], frac};
                if nx_sub {
                    fflags = 5'b00001;
                }
                if tiny && nx_sub {
                    fflags = 5'b00011; // UF | NX
                }
            }
        }
    }

    assign o_result = result;
    assign o_fflags = fflags;
}
