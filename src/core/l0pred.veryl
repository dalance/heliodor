// F1 option (B): L0 fast predictor — the overriding-predictor fast path.
//
// A small, ASYNC-READ (combinational) per-PC next-target predictor read at Stage-A
// of the decoupled extract pipeline (cp_predictor_sram_plan.md, "F1 option (B)").
// Under PRED_OVERRIDE the big BTB/BHT/TAGE are CLOCKED (read one cycle late) and
// resolve at Stage-B, so a naive Stage-A advances sequentially and pays a +1
// override bubble on every taken-cond / return / indirect. This L0 gives Stage-A a
// 0-bubble first guess: it predicts the taken target combinationally, Stage-A
// advances there, and the clocked full predictor at Stage-B OVERRIDES only when it
// disagrees (the classic L0-fast / L2-clocked overriding-predictor pair).
//
// Deliberately SMALL — a real L0 is fast BECAUSE it is small (an async-read flop RF,
// below the SRAM-compiler floor, like the RAS / fully-assoc TLBs; sram_inventory §2).
// It is a coverage-limited approximation of the full predictor, trained at commit
// from the SAME taken-control stream (a subset — the hottest sites). Returns use the
// core's RAS peek (not held here); indirects are NOT predicted (no fast iBTB) → they
// fall through at Stage-A and pay the Stage-B override bubble, which is rare.
//
// Correctness is NOT this module's concern: every prediction is speculative and
// validated at commit (heliodor_core c_bp_mispredict + the rob PRED_OVERRIDE lane-B
// guard). A cold / aliased / wrong L0 entry only costs an override bubble.
pub module l0pred #(
    param BTB_IDX_W: u32 = 5, // 32-entry micro-BTB
    param BHT_IDX_W: u32 = 7, // 128-entry PC-indexed bimodal
) (
    clk: input clock,
    rst: input reset,

    // Lookup port 2 — the SLOT-1 PC of the same Stage-A bundle. A 2-wide fetch
    // delivers two instructions per Stage-A produce, but the L0 only ever covered
    // slot 0, so a taken slot-1 branch paid the Stage-B override bubble
    // unconditionally. Measured: that is 67-68 % of ALL override bubbles on both
    // dhrystone and coremark — far more than the L0's slot-0 coverage gap. A second
    // ASYNC read port is the right shape here precisely because this is a small flop
    // RF, not an SRAM macro (a 2R SRAM would need duplication; cf. the full BTB/BHT,
    // which are 1R1W by replication — sram_inventory.md:166).
    i_pc2     : input  logic<64>,
    o_hit2    : output logic    ,
    o_target2 : output logic<64>,
    o_is_cond2: output logic    ,
    o_is_ret2 : output logic    ,
    o_is_ind2 : output logic    ,
    o_bimodal_strong2: output logic,

    // Lookup (combinational, on the Stage-A fetch PC).
    i_pc     : input  logic<64>,
    o_hit    : output logic    ,
    o_target : output logic<64>,
    o_is_cond: output logic    , // conditional branch → consult the bimodal
    o_is_ret : output logic    , // return → the core uses its RAS peek instead
    o_is_ind : output logic    , // non-return indirect → L0 does not predict (fall through)
    // PC-indexed bimodal, reported as STRONG-taken (counter == 2'b11) only. A weak/not-taken
    // conditional is NOT taken by the L0 fast path — the full TAGE (far more accurate than a
    // gshare-less bimodal) resolves it at Stage-B. This keeps the L0 from turning a full-predicted
    // not-taken conditional into a double-bubble (l0_redir to the wrong target + Stage-B correct),
    // the way an unconfident fast direction predictor otherwise regresses hard-to-predict branches.
    o_bimodal_strong: output logic,

    // Train (commit). The micro-BTB fills on any taken control op (mirrors the full
    // BTB train); the bimodal is a plain PC-indexed 2-bit counter trained on the
    // conditional-branch outcome (mirrors the full BHT train, PC index, no gshare).
    i_btb_train_en     : input logic    ,
    i_btb_train_pc     : input logic<64>,
    i_btb_train_target : input logic<64>,
    i_btb_train_is_cond: input logic    ,
    i_btb_train_is_ret : input logic    ,
    i_btb_train_is_ind : input logic    ,
    i_bht_train_en     : input logic    ,
    i_bht_train_pc     : input logic<64>,
    i_bht_train_taken  : input logic    ,
) {
    const BTB_N    : u32 = 1 << BTB_IDX_W;
    const BTB_TAG_W: u32 = 63 - BTB_IDX_W;
    const BHT_N    : u32 = 1 << BHT_IDX_W;

    // Small flop arrays (async read). valid/target/flag bits + a 2-bit bimodal.
    var btb_valid : logic            [BTB_N];
    var btb_tag   : logic<BTB_TAG_W> [BTB_N];
    var btb_target: logic<64>        [BTB_N];
    var btb_cond  : logic            [BTB_N];
    var btb_ret   : logic            [BTB_N];
    var btb_ind   : logic            [BTB_N];
    var bimodal   : logic<2>         [BHT_N];

    let lk_idx: logic<BTB_IDX_W> = i_pc[BTB_IDX_W:1];
    let lk_tag: logic<BTB_TAG_W> = i_pc[63:BTB_IDX_W + 1];
    assign o_hit     = btb_valid[lk_idx] && (btb_tag[lk_idx] == lk_tag);
    assign o_target  = btb_target[lk_idx];
    assign o_is_cond = btb_cond[lk_idx];
    assign o_is_ret  = btb_ret[lk_idx];
    assign o_is_ind  = btb_ind[lk_idx];

    let bht_idx: logic<BHT_IDX_W> = i_pc[BHT_IDX_W:1];
    assign o_bimodal_strong = bimodal[bht_idx] == 2'b11;

    // Port 2 (slot-1) — same arrays, second async read.
    let lk_idx2: logic<BTB_IDX_W> = i_pc2[BTB_IDX_W:1];
    let lk_tag2: logic<BTB_TAG_W> = i_pc2[63:BTB_IDX_W + 1];
    assign o_hit2     = btb_valid[lk_idx2] && (btb_tag[lk_idx2] == lk_tag2);
    assign o_target2  = btb_target[lk_idx2];
    assign o_is_cond2 = btb_cond[lk_idx2];
    assign o_is_ret2  = btb_ret[lk_idx2];
    assign o_is_ind2  = btb_ind[lk_idx2];
    let bht_idx2: logic<BHT_IDX_W> = i_pc2[BHT_IDX_W:1];
    assign o_bimodal_strong2 = bimodal[bht_idx2] == 2'b11;

    let tr_btb_idx: logic<BTB_IDX_W> = i_btb_train_pc[BTB_IDX_W:1];
    let tr_btb_tag: logic<BTB_TAG_W> = i_btb_train_pc[63:BTB_IDX_W + 1];
    let tr_bht_idx: logic<BHT_IDX_W> = i_bht_train_pc[BHT_IDX_W:1];
    always_ff (clk, rst) {
        if_reset {
            // A small flop RF (below the SRAM floor) — reset every field, unlike the
            // SRAM-inferred full BTB/BHT which leave data un-reset to infer a macro.
            for i in 0..BTB_N {
                btb_valid[i]  = 1'b0;
                btb_tag[i]    = '0;
                btb_target[i] = 64'd0;
                btb_cond[i]   = 1'b0;
                btb_ret[i]    = 1'b0;
                btb_ind[i]    = 1'b0;
            }
            for i in 0..BHT_N {
                bimodal[i] = 2'b01; // cold = weakly not-taken (conservative fast path)
            }
        } else {
            if i_btb_train_en {
                btb_valid[tr_btb_idx]  = 1'b1;
                btb_tag[tr_btb_idx]    = tr_btb_tag;
                btb_target[tr_btb_idx] = i_btb_train_target;
                btb_cond[tr_btb_idx]   = i_btb_train_is_cond;
                btb_ret[tr_btb_idx]    = i_btb_train_is_ret;
                btb_ind[tr_btb_idx]    = i_btb_train_is_ind;
            }
            if i_bht_train_en {
                let old: logic<2> = bimodal[tr_bht_idx];
                bimodal[tr_bht_idx] = if i_bht_train_taken ?
                    (if old == 2'b11 ? 2'b11 : old + 2'd1)
                  : (if old == 2'b00 ? 2'b00 : old - 2'd1);
            }
        }
    }
}
