// 32x64-bit register file with 4 read ports and 2 write ports
// x0 is hardwired to zero. Write-first forwarding from both write ports.
// WAW priority: port 2 (slot1) wins over port 1 (slot0) for same rd.
pub module regfile #(
    param DEBUG: bit = 1,
) (
    clk: input clock,
    rst: input reset,
    // Read ports 1-2 (slot0)
    i_rs1     : input  logic<5> ,
    i_rs2     : input  logic<5> ,
    o_rs1_data: output logic<64>,
    o_rs2_data: output logic<64>,
    // Read ports 3-4 (slot1)
    i_rs3     : input  logic<5> ,
    i_rs4     : input  logic<5> ,
    o_rs3_data: output logic<64>,
    o_rs4_data: output logic<64>,
    // Write port 1 (slot0 WB)
    i_rd     : input logic<5> ,
    i_rd_data: input logic<64>,
    i_wen    : input logic    ,
    // Write port 2 (slot1 WB)
    i_rd2     : input logic<5> ,
    i_rd2_data: input logic<64>,
    i_wen2    : input logic    ,
    // Debug
    o_debug   : output logic<64> [32],
    o_dbg_pass: output logic         ,
    o_dbg_r1  : output logic<64>     ,
    o_dbg_r2  : output logic<64>     ,
    o_dbg_r3  : output logic<64>     ,
) {
    var regs: logic<64> [32];

    // Write ports: port 2 (slot1) has priority for WAW
    always_ff (clk, rst) {
        if_reset {
            for i in 0..32 {
                regs[i] = '0;
            }
        } else {
            if i_wen && i_rd != 5'd0 {
                regs[i_rd] = i_rd_data;
            }
            // Port 2 writes after port 1 → wins on WAW
            if i_wen2 && i_rd2 != 5'd0 {
                regs[i_rd2] = i_rd2_data;
            }
        }
    }

    // Read with write-first forwarding from both write ports.
    // Priority: port2 (slot1, later in program order) > port1 (slot0) > regfile
    assign o_rs1_data = if i_rs1 == 5'd0 ?
        64'd0
    : if i_wen2 && i_rs1 == i_rd2 ?
        i_rd2_data
    : if i_wen && i_rs1 == i_rd ?
        i_rd_data
    :
        regs[i_rs1]
    ;
    assign o_rs2_data = if i_rs2 == 5'd0 ?
        64'd0
    : if i_wen2 && i_rs2 == i_rd2 ?
        i_rd2_data
    : if i_wen && i_rs2 == i_rd ?
        i_rd_data
    :
        regs[i_rs2]
    ;
    assign o_rs3_data = if i_rs3 == 5'd0 ?
        64'd0
    : if i_wen2 && i_rs3 == i_rd2 ?
        i_rd2_data
    : if i_wen && i_rs3 == i_rd ?
        i_rd_data
    :
        regs[i_rs3]
    ;
    assign o_rs4_data = if i_rs4 == 5'd0 ?
        64'd0
    : if i_wen2 && i_rs4 == i_rd2 ?
        i_rd2_data
    : if i_wen && i_rs4 == i_rd ?
        i_rd_data
    :
        regs[i_rs4]
    ;

    // Debug port
    if DEBUG :g_debug {
        for i in 0..32 :g_dbg {
            assign o_debug[i] = regs[i];
        }
    }

    assign o_dbg_pass = regs[1] == 64'd5 && regs[2] == 64'd3 && regs[3] == 64'd8 && regs[4] == 64'd2;
    assign o_dbg_r1   = regs[1];
    assign o_dbg_r2   = regs[2];
    assign o_dbg_r3   = regs[3];
}
