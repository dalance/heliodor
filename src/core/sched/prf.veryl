// prf: physical register file of one register class, multi-ported flops.
//
// Ports (timing contract):
//   i_raddr/o_rdata : read port r serves source slot r % SRC_N of issue port
//                     r / SRC_N (exec ports, then memory pipes); combinational
//                     from the registered array. Only the ports some FU of
//                     that issue port reads in this class exist; the others
//                     read 0
//   i_wb            : every WB port; a packet writes at this edge when it is
//                     valid, has_rd and its pdst is of this class; the value
//                     is readable from the next cycle (PRF_WR = 1)
//   o_chk           : sticky invariant flags (HELIODOR_CHK only)
// Owns:
//   - each entry is written by at most one WB port per cycle
// Rationale:
//   - no write-to-read forwarding: the WB cycle is covered by the bypass
//   - every entry resets to 0, so integer pdst 0 (x0) reads 0 forever
//   - write enables come from the packet's destination class, so no WB port
//     needs a priority mux between the files
pub module prf::<CFG: core_cfg> #(
    param CLS    : core_types::<CFG>::RegClass = core_types::<CFG>::RegClass::INT,
    param N_ENTRY: u32                         = 32                             ,
) (
    clk    : input  clock                                                        ,
    rst    : input  reset                                                        ,
    i_raddr: input  core_types::<CFG>::PReg         [core_types::<CFG>::PRF_RD_N],
    o_rdata: output logic                      <64> [core_types::<CFG>::PRF_RD_N],
    i_wb   : input  core_types::<CFG>::WbPacket     [core_types::<CFG>::WB_N]    ,
    o_chk  : output logic                                                        , // two WB ports wrote one entry
) {
    import core_types::<CFG>::*;

    const FP: logic = CLS == RegClass::FP;

    var wdat: logic<64> [WB_N];
    always_comb {
        for w in 0..WB_N {
            wdat[w] = i_wb[w].data;
        }
    }

    var rf_q: logic<64> [N_ENTRY];

    var we: logic<WB_N> [N_ENTRY];
    always_comb {
        for e in 0..N_ENTRY {
            for w in 0..WB_N {
                we[e][w] = wb_writes(w, FP) && i_wb[w].valid && i_wb[w].tag.has_rd && i_wb[w].tag.pdst.cls == CLS
                    && i_wb[w].tag.pdst.idx == e;
            }
        }
    }

    always_ff {
        if_reset {
            rf_q = '{default: 0};
        } else {
            for e in 0..N_ENTRY {
                if we[e] != 0 {
                    rf_q[e] = tree_onehot_mux::<WB_N, 64>(we[e], wdat);
                }
            }
        }
    }

    for r in 0..PRF_RD_N :g_rd {
        if rd_live(r, FP) :g_live {
            assign o_rdata[r] = rf_q[i_raddr[r].idx];
        } else {
            assign o_rdata[r] = 0;
        }
    }

    #[ifdef(HELIODOR_CHK)]
    {
        var multi: logic<N_ENTRY>;
        always_comb {
            for e in 0..N_ENTRY {
                multi[e] = (we[e] & (we[e] - 1)) != 0;
            }
        }
        var chk_q: logic;
        always_ff {
            if_reset {
                chk_q = 1'b0;
            } else if multi != 0 {
                chk_q = 1'b1;
            }
        }
        assign o_chk = chk_q;
    }
    #[ifndef(HELIODOR_CHK)]
    assign o_chk = 1'b0;
}
