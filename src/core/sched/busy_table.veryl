// busy_table: per physical register, whether its value is scheduled
// (prf_ready). Read only by dispatch for the initial ready bits of IQ
// entries.
//
// Ports (timing contract):
//   i_clr_valid/i_clr : rn_ edge, the pdsts allocated this cycle become not
//                       ready
//   i_wake            : the wake lanes; the pdst becomes ready at this edge
//   i_rd / o_rdy      : combinational read of the registered table
//   o_chk             : sticky invariant flags (HELIODOR_CHK only)
// Owns:
//   - a pdst is ready from the edge of its wake until the edge of its next
//     allocation; a clear and a set of one pdst in one cycle leave it clear
// Rationale:
//   - reset to all ready: the architectural mappings are ready, and a free
//     pdst is cleared when it is allocated
//   - not a kill consumer: a killed op's pdst is cleared again when reused
pub module busy_table::<CFG: core_cfg> (
    clk        : input  clock                                            ,
    rst        : input  reset                                            ,
    i_clr_valid: input  logic                   [CFG::RENAME_W]          ,
    i_clr      : input  core_types::<CFG>::PReg [CFG::RENAME_W]          ,
    i_wake     : input  core_types::<CFG>::Wake [core_types::<CFG>::WB_N],
    i_rd       : input  core_types::<CFG>::PReg [CFG::RENAME_W * 3]      ,
    o_rdy      : output logic                   [CFG::RENAME_W * 3]      ,
    o_chk      : output logic                                            , // clear and set of one pdst in one cycle
) {
    import core_types::<CFG>::*;

    const INT_N: u32 = FREE_INT_N + 32;
    const FP_N : u32 = FREE_FP_N + 32;
    const RD_N : u32 = CFG::RENAME_W * 3;

    var rdy_int_q: logic<INT_N>;
    var rdy_fp_q : logic<FP_N> ;

    // Per-entry set and clear, decoded once per entry.
    var set_int: logic<INT_N>;
    var clr_int: logic<INT_N>;
    var set_fp : logic<FP_N> ;
    var clr_fp : logic<FP_N> ;
    always_comb {
        for e in 0..INT_N {
            var s: logic<WB_N>         ;
            var c: logic<CFG::RENAME_W>;
            for w in 0..WB_N {
                s[w] = i_wake[w].valid && i_wake[w].pdst.cls == RegClass::INT && i_wake[w].pdst.idx == e;
            }
            for l in 0..CFG::RENAME_W {
                c[l] = i_clr_valid[l] && i_clr[l].cls == RegClass::INT && i_clr[l].idx == e;
            }
            set_int[e] = |s;
            clr_int[e] = |c;
        }
        for e in 0..FP_N {
            var s: logic<WB_N>         ;
            var c: logic<CFG::RENAME_W>;
            for w in 0..WB_N {
                s[w] = i_wake[w].valid && i_wake[w].pdst.cls == RegClass::FP && i_wake[w].pdst.idx == e;
            }
            for l in 0..CFG::RENAME_W {
                c[l] = i_clr_valid[l] && i_clr[l].cls == RegClass::FP && i_clr[l].idx == e;
            }
            set_fp[e] = |s;
            clr_fp[e] = |c;
        }
    }

    always_ff {
        if_reset {
            rdy_int_q = '1;
            rdy_fp_q  = '1;
        } else {
            rdy_int_q = (rdy_int_q | set_int) & ~clr_int;
            rdy_fp_q  = (rdy_fp_q | set_fp) & ~clr_fp;
        }
    }

    always_comb {
        for r in 0..RD_N {
            o_rdy[r] = if i_rd[r].cls == RegClass::FP ? rdy_fp_q[i_rd[r].idx] : rdy_int_q[i_rd[r].idx];
        }
    }

    #[ifdef(HELIODOR_CHK)]
    {
        var chk_q: logic;
        always_ff {
            if_reset {
                chk_q = 1'b0;
            } else if (set_int & clr_int) != 0 || (set_fp & clr_fp) != 0 {
                chk_q = 1'b1;
            }
        }
        assign o_chk = chk_q;
    }
    #[ifndef(HELIODOR_CHK)]
    assign o_chk = 1'b0;
}
