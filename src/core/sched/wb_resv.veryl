// wb_resv: the WB slot reservation table of one WB port.
//
// Ports (timing contract):
//   o_ok       : combinational from registered state and this cycle's grant;
//                bit o = the WB slot o cycles ahead may be reserved by a
//                select this cycle
//   i_resv     : the select of this cycle reserves slot i_resv.off
//   i_hf_req   : a blocking FU holds a finished result (HOLE_FILL)
//   o_hf_grant : same cycle as i_hf_req: the earliest free slot in
//                [WAKE_LEAD, D]; the result goes on the WB bus off cycles later
//   o_chk      : sticky invariant flags (HELIODOR_CHK only)
// Owns:
//   - at most one result per WB port and cycle: no slot is granted twice
//   - every i_hf_req is granted in the same cycle
// Rationale:
//   - only slots WAKE_LEAD..D-1 are stored: no claim is ever made below
//     WAKE_LEAD, and slot D is free at the start of every cycle because the
//     furthest claim is D, so a hole-fill grant always exists
//   - the combinational path runs one way: state -> hole-fill grant ->
//     select mask -> next state; nothing flows back from the select
//   - not a kill consumer: the slot of a killed op stays empty
pub module wb_resv #(
    param D: u32 = 3, // furthest RESERVED claim offset of this port
) (
    clk       : input  clock                           ,
    rst       : input  reset                           ,
    o_ok      : output logic         <fu_pkg::WB_OFS_N>,
    i_resv    : input  fu_pkg::WbSlot                  ,
    i_hf_req  : input  logic                           ,
    o_hf_grant: output fu_pkg::WbSlot                  ,
    o_perf    : output logic         <2>               , // {hole fill delayed past WAKE_LEAD, hole fill granted}
    o_chk     : output logic         <2>               , // {grant missing, reservation collision}
) {
    import fu_pkg::*;

    const N: u32 = WB_OFS_N;

    var resv_q: logic<N>;

    // Candidate hole-fill slots: free stored slots and slot D.
    var hf_cand: logic<N>;
    always_comb {
        for o in 0..N {
            hf_cand[o] = o >= WAKE_LEAD && o <= D && !resv_q[o];
        }
    }
    let hf_oh: logic<N> = tree_first::<N>(hf_cand);

    always_comb {
        o_hf_grant.valid = i_hf_req;
        o_hf_grant.off   = tree_onehot_enc::<N, WB_OFF_W>(hf_oh);
    }

    let hf_mask: logic<N> = if i_hf_req ? hf_oh : 0;
    always_comb {
        for o in 0..N {
            o_ok[o] = o >= WAKE_LEAD && !resv_q[o] && !hf_mask[o];
        }
    }

    let sel_mask: logic<N> = if i_resv.valid ? (1 as N) << i_resv.off : 0;
    // Every slot moves one step closer per cycle.
    let next_q: logic<N> = (resv_q | sel_mask | hf_mask) >> 1;

    always_ff {
        if_reset {
            resv_q = 0;
        } else {
            for o in 0..N {
                resv_q[o] = o >= WAKE_LEAD && o <: D && next_q[o];
            }
        }
    }

    assign o_perf = {o_hf_grant.valid && o_hf_grant.off != WAKE_LEAD, o_hf_grant.valid};

    #[ifdef(HELIODOR_CHK)]
    {
        var chk_q: logic<2>;
        always_ff {
            if_reset {
                chk_q = 0;
            } else {
                if i_resv.valid && (i_resv.off >: D || !o_ok[i_resv.off]) {
                    chk_q[0] = 1'b1;
                }
                if i_hf_req && hf_oh == 0 {
                    chk_q[1] = 1'b1;
                }
            }
        }
        assign o_chk = chk_q;
    }
    #[ifndef(HELIODOR_CHK)]
    assign o_chk = 0;
}
