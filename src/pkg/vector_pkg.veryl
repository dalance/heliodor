// Phase 12: Vector (RVV 1.0) extension shared package.
//
// heliodor's vector unit (VU) is a decoupled, in-order execution unit
// (ReOVE-style, ISLPED'24): it owns the architectural vector register file
// (VRF) and the vector config state, receives vector instructions in program
// order, and executes them in order — the VRF is NOT renamed and not tracked by
// the OoO scalar issue queues. This package holds the geometry constants and the
// decoded vector-op enum shared by the decoder, the VU, and the CSR file.
//
// Target: VLEN = 128, ELEN = 64 (integer + FP single/double, all LMUL). V0 lands
// the config + first arithmetic op; later sub-phases extend VecOp.
pub package vector_pkg {
    // Geometry.
    const VLEN  : u32 = 128; // bits per vector register
    const VLENB : u32 = 16;  // bytes per vector register (the vlenb CSR value)
    const ELEN  : u32 = 64;  // max element width in bits
    const VRF_N : u32 = 32;  // architectural vector registers v0..v31
    const VRF_W : u32 = 5;   // log2(VRF_N)

    // Decoded vector operation (V0 subset; extended in V1+). 5 bits leaves room.
    enum VecOp: logic<5> {
        NONE     = 5'd0,
        // Configuration (vset{i}vl{i}). The AVL / vtype source differs per
        // variant; the VU resolves it from the raw instruction word + the
        // renamed scalar operand (AVL) it reads through the int CDB path.
        VSETVL   = 5'd1, // vtype <- x[rs2],      AVL <- x[rs1] (rd/rs1==x0 specials)
        VSETVLI  = 5'd2, // vtype <- inst[30:20], AVL <- x[rs1] (rd/rs1==x0 specials)
        VSETIVLI = 5'd3, // vtype <- inst[29:20], AVL <- uimm[19:15]
        // Integer ALU (OPIVV/VX/VI + OPMVV/VX): vd[i] = vs2[i] OP (vs1[i] |
        // x[rs1] | imm). The VU sub-decodes the exact op from funct6 (inst[31:26])
        // and the operand mode from funct3 (inst[14:12]): VV=000/OPMVV=010 (read
        // vs1), VX=100/OPMVX=110 (read x[rs1]), VI=011 (imm5). Covers add/sub/rsub,
        // and/or/xor, sll/srl/sra, minu/min/maxu/max (V2a); compares/merge (V2b);
        // mul/mulh{,u,su}, div{,u}, rem{,u} (V2c). Widening/narrowing are later.
        VALU     = 5'd4,
        // Vector -> scalar move: x[rd] = sign-extend(vs2[element 0], SEW).
        VMV_X_S  = 5'd7,
        // V1: unit-stride vector load/store. EEW comes from the instruction
        // width field (inst[14:12]: 000=8, 101=16, 110=32, 111=64), vm from
        // inst[25]. The base address is x[rs1] (the renamed scalar operand);
        // VLE writes the vector dest vd, VSE reads vs3 (= inst[11:7]).
        VLE      = 5'd8, // vd[i]      <- mem[x[rs1] + i*EEW/8]
        VSE      = 5'd9, // mem[x[rs1] + i*EEW/8] <- vs3[i]
        // V3: vector FP arithmetic (OPFVV, vector-vector): vd[i] = vs2[i] OP
        // vs1[i] for FP add/sub/mul/min/max/sgnj{,n,x}. The VU sub-decodes the
        // exact op from funct6 + SEW into an fpu_pkg::FpuOp and streams the
        // elements one per cycle through a shared fpu_wrap instance
        // (element-serial). SEW = 32 (single) / 64 (double). The .vf (scalar-FP)
        // forms, FP compares, FMA, div/sqrt, conversions come in later V3 subs.
        VFALU    = 5'd10,
        // V3f: FP scalar <-> vector element-0 moves.
        //   VFMV_S_F (OPFVF funct6 010000): vd[0] <- f[rs1], rest undisturbed.
        //   VFMV_F_S (OPFVV funct6 010000, vs1=0): f[rd] <- vs2[0]. This writes
        //     the scalar FP register file, so it renames an FP dest (fp_writes_fp)
        //     and the VU drives the FP CDB (cdb_dest_is_fp) at writeback — the FP
        //     analogue of vmv.x.s.
        VFMV_S_F = 5'd11,
        VFMV_F_S = 5'd12,
        // V4c: mask-register logical ops (OPMVV .mm, funct6 011xxx): vmand /
        // vmnand / vmandn / vmxor / vmor / vmnor / vmorn / vmxnor. A whole-register
        // bitwise op vd = vs2 OP vs1 over the first vl bits (tail undisturbed),
        // single-cycle. Mask registers are never LMUL-scaled (always one vreg).
        VMLOGIC  = 5'd13,
        // V4d: mask-register reductions to a scalar int rd (VWXUNARY0, OPMVV
        // funct6 010000): vcpop.m (vs1=10000) counts the active source-mask bits
        // set; vfirst.m (vs1=10001) returns the lowest active set index, or -1.
        // Active = (i < vl) && (vm || v0[i]); the source bits are vs2. Like
        // vmv.x.s these write x[rd] over the int CDB in a single (fire) cycle.
        VCPOP    = 5'd14,
        // V4e-1: mask set-prefix ops (VMUNARY0, OPMVV funct6 010100): vmsbf.m
        // (vs1=00001) / vmsof.m (vs1=00010) / vmsif.m (vs1=00011). A whole-
        // register mask→mask op (1 vreg, single-cycle) writing a prefix mask
        // derived from the first active set bit of vs2: before-first / only-
        // first / including-first. Active = (i < vl) && (vm || v0[i]).
        VMSPRE   = 5'd15,
        // V4e-2: viota.m (vs1=10000) / vid.v (vs1=10001), VMUNARY0 funct6 010100.
        // These write SEW-wide elements across EMUL dest registers, so they run on
        // the register-serial path (one dest group per cycle). viota.m writes the
        // exclusive prefix-sum of active source-mask (vs2) bits; vid.v writes each
        // element's own index (vs2 unused). Inactive / tail elements undisturbed.
        VIOTA    = 5'd16,
        // V4f-1: vector slide (OPIVX/OPIVI funct6 001110 vslideup / 001111
        // vslidedown). vd[i] = vs2[i - off] (up, i >= off; lower elements
        // undisturbed) or vs2[i + off] (down, 0 past the end). off = x[rs1] (.vx)
        // or uimm5 (.vi). LMUL=1 only for now (single-cycle whole-register shift).
        VSLIDE   = 5'd17,
        // V4f-3: vrgather (OPIVV/OPIVX/OPIVI funct6 001100). vd[i] = vs2[idx]
        // where idx = vs1[i] (.vv, per-element) or x[rs1]/uimm5 (.vx/.vi,
        // broadcast); idx >= VLMAX gives 0. LMUL=1 (single-cycle index select).
        VRGATHER = 5'd18,
        // V4f-4: vcompress.vm (OPMVV funct6 010111). vs1 is a bit-per-element
        // mask; the vs2 elements whose mask bit is 1 are packed densely into the
        // low elements of vd (stream compaction). Elements past the packed count
        // stay undisturbed. Unmasked (no v0). LMUL=1 (single-cycle compaction).
        VCOMPRESS = 5'd19,
    }

    // vtype field layout (the architectural vtype CSR value):
    //   [2:0]  vlmul  (000=1, 001=2, 010=4, 011=8, 101=1/8, 110=1/4, 111=1/2; 100 reserved)
    //   [5:3]  vsew   (SEW = 8 << vsew: 000=8, 001=16, 010=32, 011=64; >=100 reserved)
    //   [6]    vta    (tail agnostic)
    //   [7]    vma    (mask agnostic)
    //   [XLEN-1] vill (illegal config — set when a reserved/unsupported vtype is requested)
}
