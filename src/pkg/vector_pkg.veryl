// Phase 12: Vector (RVV 1.0) extension shared package.
//
// heliodor's vector unit (VU) is a decoupled, in-order execution unit
// (ReOVE-style, ISLPED'24): it owns the architectural vector register file
// (VRF) and the vector config state, receives vector instructions in program
// order, and executes them in order — the VRF is NOT renamed and not tracked by
// the OoO scalar issue queues. This package holds the geometry constants and the
// decoded vector-op enum shared by the decoder, the VU, and the CSR file.
//
// Target: VLEN = 128, ELEN = 64 (integer + FP single/double, all LMUL). V0 lands
// the config + first arithmetic op; later sub-phases extend VecOp.
pub package vector_pkg {
    // Geometry.
    const VLEN  : u32 = 128; // bits per vector register
    const VLENB : u32 = 16;  // bytes per vector register (the vlenb CSR value)
    const ELEN  : u32 = 64;  // max element width in bits
    const VRF_N : u32 = 32;  // architectural vector registers v0..v31
    const VRF_W : u32 = 5;   // log2(VRF_N)

    // Decoded vector operation (V0 subset; extended in V1+). 5 bits leaves room.
    enum VecOp: logic<5> {
        NONE     = 5'd0,
        // Configuration (vset{i}vl{i}). The AVL / vtype source differs per
        // variant; the VU resolves it from the raw instruction word + the
        // renamed scalar operand (AVL) it reads through the int CDB path.
        VSETVL   = 5'd1, // vtype <- x[rs2],      AVL <- x[rs1] (rd/rs1==x0 specials)
        VSETVLI  = 5'd2, // vtype <- inst[30:20], AVL <- x[rs1] (rd/rs1==x0 specials)
        VSETIVLI = 5'd3, // vtype <- inst[29:20], AVL <- uimm[19:15]
        // Integer add: vd[i] = vs2[i] + (vs1[i] | x[rs1] | sign-extend(simm5)).
        VADD_VV  = 5'd4,
        VADD_VX  = 5'd5,
        VADD_VI  = 5'd6,
        // Vector -> scalar move: x[rd] = sign-extend(vs2[element 0], SEW).
        VMV_X_S  = 5'd7,
    }

    // vtype field layout (the architectural vtype CSR value):
    //   [2:0]  vlmul  (000=1, 001=2, 010=4, 011=8, 101=1/8, 110=1/4, 111=1/2; 100 reserved)
    //   [5:3]  vsew   (SEW = 8 << vsew: 000=8, 001=16, 010=32, 011=64; >=100 reserved)
    //   [6]    vta    (tail agnostic)
    //   [7]    vma    (mask agnostic)
    //   [XLEN-1] vill (illegal config — set when a reserved/unsupported vtype is requested)
}
