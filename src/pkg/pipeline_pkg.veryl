// Out-of-order pipeline package.
//
// Constants and types for the OoO core (pure Tomasulo + PRF + ROB + LSQ).
// `decode_pkg` holds the shared instruction decoder's control enums
// (AluSrcA/B, WbSel, ...); this package holds the OoO datapath types.
pub package pipeline_pkg {
    // ============================================================
    // Width parameters
    // ============================================================
    // M1-M5: 1-wide. M6+: 2-wide. Constants carried at the larger
    // final size so index widths don't change across milestones.
    const FETCH_W   : u32 = 1; // M6 raises to 2
    const RENAME_W  : u32 = 1;
    const DISPATCH_W: u32 = 1;
    const COMMIT_W  : u32 = 1;
    const ISSUE_W   : u32 = 1; // total across FUs

    // ============================================================
    // Register file / ROB / IQ / LSQ depths
    // ============================================================
    // PRF: arch (32) + max in-flight rename. 64 is the M1 floor.
    // Width is wide enough to address the M6 PRF (96).
    const ARCH_REG_N: u32 = 32;
    const PRF_INT_N : u32 = 64;
    const PRF_INT_W : u32 = 6; // log2(PRF_INT_N) = 6
    const PRF_FP_N  : u32 = 64;
    const PRF_FP_W  : u32 = 6;

    const ROB_DEPTH: u32 = 32;
    const ROB_IDX_W: u32 = 5; // log2(ROB_DEPTH)

    const IQ_INT_N: u32 = 8;
    const IQ_INT_W: u32 = 3;
    const IQ_MEM_N: u32 = 8;
    const IQ_MEM_W: u32 = 3;
    const IQ_FP_N : u32 = 8;
    const IQ_FP_W : u32 = 3;

    const LQ_DEPTH: u32 = 8;
    const LQ_IDX_W: u32 = 3;
    const SQ_DEPTH: u32 = 8;
    const SQ_IDX_W: u32 = 3;

    const CDB_N: u32 = 1; // M6 raises to 2

    // ============================================================
    // Functional unit kinds (routed by IQ)
    // ============================================================
    enum FuKind: logic<3> {
        ALU = 3'd0,
        BRANCH = 3'd1,
        MUL = 3'd2,
        DIV = 3'd3,
        AGU = 3'd4, // M5
        FPU = 3'd5, // M6
        CSR = 3'd6, // M4
        AMO = 3'd7, // M4
    }

    // ============================================================
    // Redirect sources (for invariant: only ROB_COMMIT may redirect)
    // ============================================================
    enum RedirectSrc: logic<2> {
        NONE = 2'd0,
        ROB_COMMIT = 2'd1, // only legitimate source for in-order fix-up
        FRONTEND = 2'd2, // BP/BTB redirect inside fetch (still local)
    }

    // ============================================================
    // Branch condition encoding (subset of riscv_pkg::BranchOp)
    // ============================================================
    enum BrCond: logic<3> {
        BEQ = 3'd0,
        BNE = 3'd1,
        BLT = 3'd4,
        BGE = 3'd5,
        BLTU = 3'd6,
        BGEU = 3'd7,
        NONE = 3'd2, // not a branch (JAL/JALR/non-branch)
    }

    // ============================================================
    // Decoded op (M1 minimal: ALU/branch/JAL/JALR/LUI/AUIPC). Extended
    // in M3+ for MUL/DIV (fu_kind), M4 for CSR/trap, M5 for LOAD/STORE.
    // ============================================================
    struct DecodedOp {
        valid     : logic             ,
        pc        : logic         <64>,
        instr     : logic         <32>,
        fu_kind   : FuKind            ,
        alu_op    : alu_pkg::AluOp    ,
        rd_arch   : logic         <5> ,
        rs1_arch  : logic         <5> ,
        rs2_arch  : logic         <5> ,
        has_rd    : logic             ,
        has_rs1   : logic             ,
        has_rs2   : logic             ,
        imm       : logic         <64>,
        use_imm_b : logic             , // alu src B = imm
        use_pc_a  : logic             , // alu src A = pc (AUIPC)
        use_zero_a: logic             , // alu src A = 0 (LUI)
        is_branch : logic             ,
        is_jal    : logic             ,
        is_jalr   : logic             ,
        br_cond   : BrCond            ,
        wb_pc4    : logic             , // JAL/JALR: rd = pc+4
        is_load   : logic             , // M2
        is_store  : logic             , // M2
        mem_funct3: logic         <3> , // M2: LB/LH/LW/LD/LBU/LHU/LWU/SB/SH/SW/SD
        // Phase 11-H HLV/HLVX/HSV: hypervisor virtual-memory access. hlv marks a
        // load/store that translates through the guest's two-stage MMU (vsatp →
        // hgatp) with the privilege selected by hstatus.SPVP, even though the
        // core runs in HS-mode (V=0). hlvx additionally checks execute (X) instead
        // of read (R) permission at the VS-stage leaf (HLVX.HU/.WU). Both 0 for
        // every ordinary load/store, so V=0 / non-HLV behaviour is unchanged.
        hlv       : logic             ,
        hlvx      : logic             ,
        // M4: Zicsr + trap
        is_csr   : logic             ,
        csr_op   : csr_pkg::CsrOp    ,
        csr_imm  : logic             , // csrr*i variant (rs1 = zero-ext imm5)
        csr_addr : logic         <12>,
        is_ecall : logic             ,
        is_ebreak: logic             ,
        is_mret  : logic             ,
        is_sret  : logic             , // M5.D
        is_sfence: logic             , // M5.D SFENCE.VMA
        is_fence_i: logic            , // M8.A FENCE.I — flush icache at commit
        is_fence  : logic            , // S15: plain FENCE — load-ordering barrier in the ROB
        // P10 Zicboz: cbo.zero — a store-class op that zeroes the whole cache
        // block at rs1. Flows as a store (AGU/MMU, committed-store buffer) but
        // the buffer push fills all 8 lanes with zero; it also acts as a load
        // barrier so younger loads cannot read the line before it commits.
        is_cbo_zero: logic           ,
        // M5.A: A-extension. is_amo=1 for LR/SC/AMO*. amo_funct5 is
        // riscv_pkg::AmoOp encoding (inst[31:27]). amo_is_w distinguishes
        // .W (funct3=010) from .D (funct3=011).
        is_amo    : logic   ,
        amo_funct5: logic<5>,
        amo_is_w  : logic   ,
        is_rvc    : logic   , // M7: 2-byte instr; link = pc+2
        // M6: F/D extension. is_fp = touches the FP regfile (OP-FP / FMADD /
        // FP load-store). is_fpu_op = routes to the FPU/iq_fp (OP-FP / FMADD;
        // NOT FP load/store, which go through the LSU). fp_writes_fp/_int give
        // the destination register file. fp_rs{1,2}_is_fp / fp_uses_rs3 mark
        // FP source operands; fp_int_src marks an INT→FP op reading integer
        // rs1. fp_ld/fp_st flag FP load (writes FP rd) / FP store (rs2 = FP
        // data). rs3_arch is the FMADD third source.
        is_fp        : logic         ,
        is_fpu_op    : logic         ,
        fpu_op       : fpu_pkg::FpuOp,
        fp_rm        : logic     <3> ,
        rs3_arch     : logic     <5> ,
        fp_writes_fp : logic         ,
        fp_writes_int: logic         ,
        fp_rs1_is_fp : logic         ,
        fp_rs2_is_fp : logic         ,
        fp_uses_rs3  : logic         ,
        fp_int_src   : logic         ,
        fp_ld        : logic         ,
        fp_st        : logic         ,
        // Phase 12 V0: Vector (OP-V) fields. is_vec = any vector instruction.
        // vec_op selects the operation; vec_uses_scalar marks an integer rs1
        // source (vadd.vx / vset*vl AVL); vec_writes_int marks an integer rd dest
        // (vmv.x.s / vset*vl vl). The VRF source/dest registers reuse the
        // rd_arch/rs1_arch/rs2_arch fields (same instruction-word positions).
        is_vec         : logic              ,
        vec_op         : vector_pkg::VecOp  ,
        vec_uses_scalar: logic              ,
        vec_writes_int : logic              ,
        illegal      : logic         ,
    }

    // ============================================================
    // Renamed op (post rename + free_list pop)
    // ============================================================
    struct RenamedOp {
        base       : DecodedOp           ,
        rd_pdst    : logic    <PRF_INT_W>, // new pdst (= invalid if !has_rd)
        rs1_pdst   : logic    <PRF_INT_W>,
        rs2_pdst   : logic    <PRF_INT_W>,
        old_rd_pdst: logic    <PRF_INT_W>,
        rob_idx    : logic    <ROB_IDX_W>,
    }

    // ============================================================
    // CDB (Common Data Bus) entry — broadcast on writeback.
    // M1: CDB_N=1. M6 ramps to 2.
    // ============================================================
    struct CdbBus {
        valid      : logic           ,
        has_rd     : logic           , // gates PRF write
        pdst       : logic<PRF_INT_W>,
        data       : logic<64>       ,
        rob_idx    : logic<ROB_IDX_W>,
        mispredict : logic           ,
        redirect_pc: logic<64>       ,
        // M2 STORE: captured at execute, drained from ROB at commit
        is_store    : logic    ,
        store_addr  : logic<64>,
        store_data  : logic<64>,
        store_funct3: logic<3> ,
        // Phase 8 S9: a PLAIN load (not AMO-LR) executed this cycle. The ROB
        // records its VA (= store_addr, the AGU output) + size (= store_funct3)
        // into the Load Queue shadow so an older store resolving its address can
        // detect a memory-order violation (a younger load that bypassed it).
        is_load     : logic    ,
        // M4 CSR write side-band (drained from ROB at commit)
        is_csr     : logic    ,
        csr_addr   : logic<12>,
        csr_wdata  : logic<64>, // new CSR value (post-mod)
        csr_illegal: logic    , // CSR access violation (read-only write or priv)
        // M5.D: dmem MMU page fault. is_lfault = load page fault (cause=13);
        // is_sfault = store/AMO page fault (cause=15). fault_vaddr carries
        // the faulting VA into mtval/stval.
        is_lfault  : logic    ,
        is_sfault  : logic    ,
        fault_vaddr: logic<64>,
    }

    // ============================================================
    // ROB entry (M1 minimal: ALU + branch). Extended in M3+ for MUL/
    // DIV result tagging, M4 for CSR/trap/AMO, M5 for STORE/LOAD.
    // ============================================================
    struct RobEntry {
        valid         : logic           , // entry occupied
        pc            : logic<64>       , // for retire stream + redirect_pc
        rd_arch       : logic<5>        , // arch register destination
        rd_pdst       : logic<PRF_INT_W>, // new pdst (= invalid if !has_rd)
        old_rd_pdst   : logic<PRF_INT_W>, // pdst to push to free-list on commit
        has_rd        : logic           , // false for branches without link / stores etc.
        result_written: logic           , // CDB has written back — commit gate
        is_branch     : logic           , // cond branch (B*)
        is_jal        : logic           ,
        is_jalr       : logic           ,
        mispredict    : logic           , // EX detected mispredict → commit redirect
        redirect_pc   : logic<64>       , // resolved target (for mispredict)
        // Phase 8 M1: mispredict decided at commit from the frontend's chosen
        // next PC. arch-next-PC = is_control ? redirect_pc(=resolved target)
        //                                    : pc + (is_rvc ? 2 : 4)
        // mispredict = (pred_next_pc != arch-next-PC).
        pred_next_pc  : logic<64>       , // next PC the frontend fetched after this op
        is_rvc        : logic           , // 2-byte instr → fall-through = pc+2
        is_control    : logic           , // branch/jal/jalr → arch-next-PC = resolved target
        // M3 RAS: call = jal/jalr writing a link reg; ret = jalr reading a link
        // reg with no link write. Used at commit to train the BTB kind and to
        // push/pop the architectural RAS.
        is_call       : logic           ,
        is_ret        : logic           ,
        // M4 gshare: the BHT index used at fetch (pc XOR speculative global
        // history). Carried so commit trains the exact entry that predicted.
        pred_index    : logic<13>       , // S13.2: gshare/BHT index width
        // S22 TAGE: this instance folded into spec_ghr_l at delivery (BTB hit
        // + is_cond). Commit folds committed_ghr_l only for these instances so
        // the speculative and committed long histories stay the same stream.
        ghr_fold      : logic           ,
        illegal       : logic           , // illegal instruction → trap on commit
        result_data   : logic<64>       , // for branches: actual target / link value
        // M2 STORE: captured at CDB writeback, drained from ROB at commit
        is_store    : logic    , // M2: STORE op
        store_addr  : logic<64>, // dmem addr computed at execute
        store_data  : logic<64>, // rs2 value (write operand)
        store_funct3: logic<3> , // SB/SH/SW/SD width selector
        // Phase 11-H HLV/HSV: this load/store/AMO is a hypervisor virtual-memory
        // access (two-stage guest translation). Carried so a committing HSV store
        // drives the dmem MMU in two-stage mode and so any HLV/HSV memory fault
        // sets hstatus.GVA (stval holds a guest VA). 0 for all ordinary ops.
        is_mem_virt : logic    ,
        // M4 CSR + trap
        is_csr   : logic    , // CSR write commits at retire
        csr_addr : logic<12>,
        csr_wdata: logic<64>,
        is_ecall : logic    ,
        is_ebreak: logic    ,
        is_mret  : logic    ,
        is_sret  : logic    , // M5.D
        is_sfence: logic    , // M5.D
        // P9.5: SFENCE.VMA operand register indices (rs1=VA, rs2=ASID). The op
        // is serializing, so at its commit arch_regs[rs1/rs2] hold the resolved
        // VA/ASID; rs*==x0 selects the wildcard (all-addresses / all-ASIDs)
        // flush variants. Only meaningful when is_sfence.
        sfence_rs1: logic<5>,
        sfence_rs2: logic<5>,
        is_fence_i: logic   , // M8.A FENCE.I — flush icache at commit
        is_fence : logic    , // S15: plain FENCE — load-ordering barrier
        is_cbo_zero: logic  , // P10 Zicboz cbo.zero — zero a cache block at commit
        // M5.A AMO: at execute time alu_wrap reads memory + computes the
        // new value. Commit drives dmem with (store_addr, store_data,
        // store_funct3). is_amo flags it; LR has is_amo + !is_store (no
        // write at commit); SC always succeeds (single hart) and uses
        // is_store.
        is_amo   : logic,
        // M6: F/D. is_fp_dest = the destination is an FP register (commit
        // pushes old_rd_pdst to the FP free-list and renames the FP arch RAT
        // instead of the integer ones; rd_pdst/old_rd_pdst are REUSED to hold
        // the FP pdst, since a given op writes int XOR fp). fflags/fflags_wen
        // are captured at FP CDB writeback and OR-accrued into fcsr at commit.
        is_fp_dest: logic   ,
        // is_fp = any FP instruction (OP-FP / FMADD / FP load / FP store).
        // Used at commit to raise an illegal-instruction trap when mstatus.FS
        // is Off (FP disabled). Distinct from is_fp_dest (FP-writing ops only).
        is_fp     : logic   ,
        // Phase 12 V0: any vector instruction (OP-V). Used at commit to raise an
        // illegal-instruction trap when mstatus.VS is Off, and to keep vector ops
        // out of 2-wide slot-1 commit (mirrors is_fp).
        is_vec    : logic   ,
        fflags    : logic<5>,
        fflags_wen: logic   ,
        is_ifault: logic, // instruction page fault (cause=12) at fetch
        // M5.D dmem MMU: load (cause=13) / store (cause=15) page faults.
        is_lfault  : logic    ,
        is_sfault  : logic    ,
        fault_vaddr: logic<64>,
        // Phase 11-H3d: an instruction fetch that faulted in the G-stage (a guest
        // instruction guest-page-fault, cause 20) + the faulting guest PA (htval).
        ifault_gstage: logic    ,
        ifault_gpa   : logic<64>,
    }
}
