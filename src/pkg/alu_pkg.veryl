// ALU operation definitions
pub package alu_pkg {
    // Phase 10: widened to 6 bits to hold the RV64 B-extension (Zba/Zbb/Zbs) ops.
    enum AluOp: logic<6> {
        // RV64I
        ADD = 6'd0,
        SUB = 6'd1,
        SLL = 6'd2,
        SLT = 6'd3,
        SLTU = 6'd4,
        XOR = 6'd5,
        SRL = 6'd6,
        SRA = 6'd7,
        OR = 6'd8,
        AND = 6'd9,
        ADDW = 6'd10,
        SUBW = 6'd11,
        SLLW = 6'd12,
        SRLW = 6'd13,
        SRAW = 6'd14,
        // RV64M
        MUL = 6'd15,
        MULH = 6'd16,
        MULHSU = 6'd17,
        MULHU = 6'd18,
        DIV = 6'd19,
        DIVU = 6'd20,
        REM = 6'd21,
        REMU = 6'd22,
        MULW = 6'd23,
        DIVW = 6'd24,
        DIVUW = 6'd25,
        REMW = 6'd26,
        REMUW = 6'd27,
        // Zba (address generation)
        SH1ADD = 6'd28,
        SH2ADD = 6'd29,
        SH3ADD = 6'd30,
        ADD_UW = 6'd31,
        SH1ADD_UW = 6'd32,
        SH2ADD_UW = 6'd33,
        SH3ADD_UW = 6'd34,
        SLLI_UW = 6'd35,
        // Zbb (basic bit manipulation)
        ANDN = 6'd36,
        ORN = 6'd37,
        XNOR = 6'd38,
        CLZ = 6'd39,
        CTZ = 6'd40,
        CPOP = 6'd41,
        CLZW = 6'd42,
        CTZW = 6'd43,
        CPOPW = 6'd44,
        MAX = 6'd45,
        MAXU = 6'd46,
        MIN = 6'd47,
        MINU = 6'd48,
        SEXT_B = 6'd49,
        SEXT_H = 6'd50,
        ZEXT_H = 6'd51,
        ROL = 6'd52,
        ROR = 6'd53,
        ROLW = 6'd54,
        RORW = 6'd55,
        ORC_B = 6'd56,
        REV8 = 6'd57,
        // Zbs (single-bit)
        BCLR = 6'd58,
        BEXT = 6'd59,
        BINV = 6'd60,
        BSET = 6'd61,
    }
}
