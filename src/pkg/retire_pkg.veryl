// retire_pkg: the retire observation contract shared by every core and the tb.
//
// One RetireRec per commit lane, registered one cycle after retire. The record
// stream, serialized by `order`, is the architectural trace; the lane position
// is not part of it. This package is config-independent: lane count is a
// parameter of the consumers (rvfi_tracer, retire_mon), never of the types.
pub package retire_pkg {
    // Version of the trace text, the rolling hash and the checkpoint file
    // layout. Bump it whenever any of them changes: checkpoint files carry it
    // in word 0 and a mismatch reads as "golden is stale", not as divergence.
    const TRACER_VER: logic<64> = 64'h0000_0000_0000_0003;

    // RISC-V exception and interrupt codes all fit in 6 bits; the interrupt
    // flag of mcause is implied by the record kind (trap vs IrqEvent).
    const CAUSE_W: u32 = 6;

    enum RdKind: logic<2> {
        NONE = 2'd0,
        INT = 2'd1,
        FP = 2'd2,
    }

    struct RetireRec {
        // A retired op, or the trap record of a synchronous exception.
        // Replayed and killed ops produce no record.
        valid: logic,
        // +1 per record, trap records included.
        order: logic<64>,
        pc   : logic<64>,
        // Architectural next PC; 0 in a trap record (the next record's pc is
        // the trap target).
        next_pc: logic<64>,
        // Expanded 32-bit instruction; undefined in a fetch-fault trap record.
        insn  : logic<32>     ,
        is_rvc: logic         ,
        trap  : logic         ,
        cause : logic<CAUSE_W>,
        tval  : logic<64>     ,
        // Mode at retire, before any update by this record's trap.
        priv: logic<2>,
        virt: logic   ,
        // NONE in a trap record. FP values are NaN-boxed to 64 bits.
        rd_kind : RdKind    ,
        rd_addr : logic <5> ,
        rd_wdata: logic <64>,
        // Second register of an amocas.q pair.
        rd2_valid: logic    ,
        rd2_wdata: logic<64>,
        // First byte of the access (the lower PA of a split access). Size is
        // log2 bytes (0..4). Masks are per byte; data is right-aligned, the
        // _hi words carry bytes 8..15 of a 16-byte access. AMO: rdata is the
        // old value, wdata the new one.
        mem_size    : logic<3> ,
        mem_vaddr   : logic<64>,
        mem_paddr   : logic<64>,
        mem_io      : logic    ,
        mem_rmask   : logic<16>,
        mem_wmask   : logic<16>,
        mem_rdata   : logic<64>,
        mem_rdata_hi: logic<64>,
        mem_wdata   : logic<64>,
        mem_wdata_hi: logic<64>,
        // Only for an op that writes the CSR; the value offered to the write
        // port, before WARL legalization.
        csr_valid: logic    ,
        csr_addr : logic<12>,
        csr_wdata: logic<64>,
        // Flags raised by this op.
        fflags: logic<5>,
        // Vector op: element writes to the VRF, their vrf_hash_step fold in
        // write order, and vtype/vl/vstart after retire. The mem_* fields of a
        // vector op are not compared.
        vec_v   : logic    ,
        vrf_wcnt: logic<8> ,
        vrf_hash: logic<64>,
        vtype   : logic<64>,
        vl      : logic<64>,
        vstart  : logic<64>,
    }

    // Interrupt taken. `order` is the order of the next record; the event
    // consumes none. Only in cycles with no valid lane record.
    struct IrqEvent {
        valid: logic         ,
        cause: logic<CAUSE_W>,
        epc  : logic<64>     ,
        order: logic<64>     ,
    }

    // retire_mon contract-checker bits (chk_retire).
    const CHK_RET_W       : u32 = 6;
    const CHK_RET_LANE_GAP: u32 = 0; // valid lane above an invalid one
    const CHK_RET_ORDER   : u32 = 1; // record order is not the expected next order
    const CHK_RET_TRAP_LN : u32 = 2; // trap record on a lane other than 0
    const CHK_RET_FLUSH   : u32 = 3; // a valid record after a trap in the same cycle
    const CHK_RET_IRQ     : u32 = 4; // IrqEvent with lane records, or with a wrong order
    const CHK_RET_TRAP_FX : u32 = 5; // trap record with rd, memory write, CSR write or next_pc

    // splitmix64 finalizer: a bijection on 64 bits with full avalanche.
    function mix64 (
        x: input logic<64>,
    ) -> logic<64> {
        var y: logic<64>;
        y = x ^ (x >> 30);
        y = y * 64'hbf58_476d_1ce4_e5b9;
        y = y ^ (y >> 27);
        y = y * 64'h94d0_49bb_1331_11eb;
        y = y ^ (y >> 31);
        return y;
    }

    // One VRF write folded into a vector op's vrf_hash, starting from 0.
    // Order-dependent, so the fold must follow write order.
    function vrf_hash_step (
        h   : input logic<64>              ,
        vd  : input logic<5>               ,
        data: input logic<vector_pkg::VLEN>,
    ) -> logic<64> {
        var a: logic<64>              ;
        var d: logic<vector_pkg::VLEN>;
        a = mix64(h ^ {59'd0, vd} ^ 64'h9e37_79b9_7f4a_7c15);
        d = data;
        for _c in 0..(vector_pkg::VLEN / 64) {
            a = mix64(a ^ d[63:0]);
            d = d >> 64;
        }
        return a;
    }
}
