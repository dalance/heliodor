// FPU package definitions for RV64F/D extensions
pub package fpu_pkg {
    // FPU operation type. P10 Zfa: widened to 7 bits (base F/D reaches 58).
    enum FpuOp: logic<7> {
        NONE = 6'd0,
        // Single-precision
        FADD_S = 6'd1,
        FSUB_S = 6'd2,
        FMUL_S = 6'd3,
        FDIV_S = 6'd4,
        FSQRT_S = 6'd5,
        FMIN_S = 6'd6,
        FMAX_S = 6'd7,
        FSGNJ_S = 6'd8,
        FSGNJN_S = 6'd9,
        FSGNJX_S = 6'd10,
        FCVT_W_S = 6'd11,
        FCVT_WU_S = 6'd12,
        FCVT_S_W = 6'd13,
        FCVT_S_WU = 6'd14,
        FCVT_L_S = 6'd15,
        FCVT_LU_S = 6'd16,
        FCVT_S_L = 6'd17,
        FCVT_S_LU = 6'd18,
        FMV_X_W = 6'd19,
        FMV_W_X = 6'd20,
        FEQ_S = 6'd21,
        FLT_S = 6'd22,
        FLE_S = 6'd23,
        FCLASS_S = 6'd24,
        FMADD_S = 6'd25,
        FMSUB_S = 6'd26,
        FNMADD_S = 6'd27,
        FNMSUB_S = 6'd28,
        // Double-precision
        FADD_D = 6'd29,
        FSUB_D = 6'd30,
        FMUL_D = 6'd31,
        FDIV_D = 6'd32,
        FSQRT_D = 6'd33,
        FMIN_D = 6'd34,
        FMAX_D = 6'd35,
        FSGNJ_D = 6'd36,
        FSGNJN_D = 6'd37,
        FSGNJX_D = 6'd38,
        FCVT_W_D = 6'd39,
        FCVT_WU_D = 6'd40,
        FCVT_D_W = 6'd41,
        FCVT_D_WU = 6'd42,
        FCVT_L_D = 6'd43,
        FCVT_LU_D = 6'd44,
        FCVT_D_L = 6'd45,
        FCVT_D_LU = 6'd46,
        FMV_X_D = 6'd47,
        FMV_D_X = 6'd48,
        FEQ_D = 6'd49,
        FLT_D = 6'd50,
        FLE_D = 6'd51,
        FCLASS_D = 6'd52,
        FMADD_D = 6'd53,
        FMSUB_D = 6'd54,
        FNMADD_D = 6'd55,
        FNMSUB_D = 6'd56,
        FCVT_S_D = 6'd57,
        FCVT_D_S = 6'd58,
        // P10 Zfa
        FMINM_S = 7'd59,
        FMAXM_S = 7'd60,
        FMINM_D = 7'd61,
        FMAXM_D = 7'd62,
        FLEQ_S = 7'd63,
        FLTQ_S = 7'd64,
        FLEQ_D = 7'd65,
        FLTQ_D = 7'd66,
        FROUND_S = 7'd67,
        FROUNDNX_S = 7'd68,
        FROUND_D = 7'd69,
        FROUNDNX_D = 7'd70,
        FCVTMOD_W_D = 7'd71,
        FLI_S = 7'd72,
        FLI_D = 7'd73,
        // P10 Zfhmin: half-precision (binary16) conversions + moves
        FCVT_S_H = 7'd74, // half → single (widening, exact)
        FCVT_H_S = 7'd75, // single → half (narrowing, rounded)
        FCVT_D_H = 7'd76, // half → double (widening, exact)
        FCVT_H_D = 7'd77, // double → half (narrowing, rounded)
        FMV_X_H = 7'd78, // half bits → int (sign-extended low 16)
        FMV_H_X = 7'd79, // int low 16 → half (NaN-boxed)
    }

    // IEEE 754 rounding modes
    enum FpRm: logic<3> {
        RNE = 3'b000, // Round to Nearest, ties to Even
        RTZ = 3'b001, // Round towards Zero
        RDN = 3'b010, // Round Down (towards -inf)
        RUP = 3'b011, // Round Up (towards +inf)
        RMM = 3'b100, // Round to Nearest, ties to Max Magnitude
        DYN = 3'b111, // Dynamic (use frm CSR)
    }

    // NaN-boxing: single-precision value in 64-bit register
    // Upper 32 bits must be all 1s
    const NANBOX_MASK: logic<32> = 32'hFFFFFFFF;

    // Canonical NaN values
    const CANONICAL_NAN_S: logic<32> = 32'h7FC00000;
    const CANONICAL_NAN_D: logic<64> = 64'h7FF8000000000000;
    // P10 Zfhmin: canonical half-precision (binary16) NaN
    const CANONICAL_NAN_H: logic<16> = 16'h7E00;

    // ---- Leading-zero count helpers (shared by every FP datapath) --------
    // Population count of a 64-bit word via the canonical log-depth SWAR tree
    // (6 halving stages instead of a 64-deep ripple).
    function popcount64 (
        x: input logic<64>,
    ) -> logic<7> {
        var t: logic<64>;
        t = (x & 64'h5555555555555555) + ((x >> 1) & 64'h5555555555555555);
        t = (t & 64'h3333333333333333) + ((t >> 2) & 64'h3333333333333333);
        t = (t & 64'h0f0f0f0f0f0f0f0f) + ((t >> 4) & 64'h0f0f0f0f0f0f0f0f);
        t = (t & 64'h00ff00ff00ff00ff) + ((t >> 8) & 64'h00ff00ff00ff00ff);
        t = (t & 64'h0000ffff0000ffff) + ((t >> 16) & 64'h0000ffff0000ffff);
        t = (t & 64'h00000000ffffffff) + ((t >> 32) & 64'h00000000ffffffff);
        return t[6:0];
    }

    // Leading-zero count of a 256-bit value: balanced suffix-OR (Hillis-Steele)
    // followed by a tree popcount. ~suffix_or is 1^clz 0^(256-clz) from the MSB,
    // so its population count equals the leading-zero count. Returns 256 if x==0.
    function clz256 (
        x: input logic<256>,
    ) -> logic<9> {
        var so: logic<256>;
        so = x;
        so = so | (so >> 1);
        so = so | (so >> 2);
        so = so | (so >> 4);
        so = so | (so >> 8);
        so = so | (so >> 16);
        so = so | (so >> 32);
        so = so | (so >> 64);
        so = so | (so >> 128);
        let z : logic<256> = ~so;
        let p0: logic<7>   = popcount64(z[63:0]);
        let p1: logic<7>   = popcount64(z[127:64]);
        let p2: logic<7>   = popcount64(z[191:128]);
        let p3: logic<7>   = popcount64(z[255:192]);
        return {2'd0, p0} + {2'd0, p1} + {2'd0, p2} + {2'd0, p3};
    }

    // Leading-zero count of a W-bit value (W <= 256), counted from bit W-1.
    // Bit-exact with a top-down serial scan. Returns W when x == 0 (matching the
    // old `lzc = W` sentinel), so callers need not special-case zero themselves.
    function clz::<W: u32> (
        x: input logic<W>,
    ) -> logic<9> {
        var r: logic<9>;
        if x == 0 {
            r = W as 9;
        } else {
            // Top-justify x into the high W bits so clz256 counts from its MSB.
            r = clz256((x as 256) << (256 - W));
        }
        return r;
    }
}
