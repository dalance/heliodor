// Sv39 MMU: Virtual-to-Physical address translation
// Performs 3-level page table walk using data memory interface.
// Includes a 16-entry fully-associative TLB for fast translation.
// Stalls the pipeline during page table walk on TLB miss.
pub module mmu #(
    // P10 Svadu: 1 = this MMU performs hardware A/D write-back (the data side,
    // which owns a write channel through the dcache). 0 = lazy-relax only: with
    // ADUE the leaf no longer faults on A=0 / D=0, but the bits are NOT written
    // back (the instruction side's PTW port is a read-only coherent stream with
    // no write channel — see heliodor_core's iptw FSM). The leaf still
    // translates; the A bit is simply left stale on a fetch-only access.
    param WRITE_AD: u8 = 1,
    // PMA: when 1, a PTE read whose physical address hits no backed memory
    // region (a "hole") raises an access fault (cause 1/5/7) instead of reading
    // garbage and page-faulting on the bogus PTE. Default 0 (boot/SoC put no
    // page table in a hole); only the ACT4 arch harness enables it. Mirrors the
    // wrapper's final-PA pma_hole. (ACT4 SvZicbo: a non-leaf PTE points the next
    // level into a hole, so the PTE read itself access-faults.)
    param PMA_FAULT: bit = 0,
) (
    clk: input clock,
    rst: input reset,
    // Translation request
    i_vaddr: input logic<64>,
    i_req  : input logic    ,
    i_store: input logic    , // 1=store, 0=load/fetch
    i_fetch: input logic    , // 1=instruction fetch
    // Zicbom cbo.clean/flush/inval: routed as a store (i_store=1) for address
    // plumbing, but its page permission is R-OR-W (not strict W) and it neither
    // requires nor sets the D bit. i_cbo=1 selects those relaxed semantics.
    i_cbo  : input logic    ,
    // Translation result
    o_paddr: output logic<64>,
    o_valid: output logic    ,
    o_fault: output logic    ,
    // PMP (Smpmp): the page-table walk read a PTE whose physical address is
    // denied by PMP (SvPMP `pmp_on_pte`). The walk faults as an ACCESS fault
    // (cause 1/5/7 by the original access type) rather than a page fault; the
    // wrapper masks o_fault and routes this to its o_acc_fault. Asserted with
    // o_fault (so o_fault stays the "walk failed" signal that drives o_busy).
    o_acc_fault: output logic,
    o_busy : output logic    ,
    // P10 Svpbmt: this translation maps to non-cacheable memory (PBMT NC/IO).
    // Mirrors o_paddr's TLB-hit/walk mux. 0 when VM off (the PA-based MMIO
    // window still routes bare/M-mode device accesses uncached in the core).
    o_uncached: output logic,
    // M9.A.296: pulse high the cycle a NEW PTW starts (TLB miss in IDLE).
    // Lets an OoO core bind the walk to the requesting load's rob_idx for
    // correct page-fault attribution across back-to-back walks.
    o_walk_start: output logic,
    // M9.3: the FSM is in IDLE (no walk owns the port). Combinationally a pure
    // function of the `state` register, so it does NOT depend on i_vaddr — an
    // OoO core may use it to gate a VA pin without forming a combinational loop
    // through i_vaddr. v1 (in-order) leaves this unconnected.
    o_idle: output logic,
    // CP commit-store pre-translate: a side-effect-free STORE-semantics probe of the
    // current i_vaddr against the V=0 TLB. o_sprobe_ok is high only on a clean
    // single-stage TLB hit with store (W&D-folded) + U permission on a cacheable
    // page while IDLE (no walk in flight) — i.e. a store committing this VA would
    // take the no-fault TLB fast path. o_sprobe_pa is that hit's PA. Pure
    // combinational read of the existing TLB arrays: it asserts NO request, starts
    // NO walk, and writes NO state, so probing a (possibly wrong-path / speculative)
    // store VA at execute is free of side effects. Anything that is not a clean hit
    // (miss, W/D/U/PMP deny, uncached, non-canonical, virt, mid-walk) reports ok=0,
    // and the store falls back to the normal commit-time translation.
    o_sprobe_pa: output logic<64>,
    o_sprobe_ok: output logic    ,
    // SATP register
    i_satp: input logic             <64>,
    i_priv: input csr_pkg::PrivLevel    ,
    // PMP (Smpmp): config + addresses, for the implicit PTE-read protection check
    // performed on every page-table-walk memory access (SvPMP). The PTE reads use
    // the privilege of the original access (i_priv) and the read permission (R).
    i_pmpcfg : input logic<64> [2] ,
    i_pmpaddr: input logic<64> [16],
    // mstatus permission bits
    i_sum: input logic, // Supervisor User Memory access
    i_mxr: input logic, // Make eXecutable Readable
    // P10 Svpbmt: menvcfg.PBMTE. When 1, the leaf PTE's PBMT field (bits 62:61)
    // is interpreted (01=NC / 10=IO → uncached; 11=reserved → fault); when 0 the
    // field is ignored (current behaviour), keeping this inert for legacy code.
    i_pbmte: input logic,
    // P10 Svadu: menvcfg.ADUE. When 1, the leaf PTE's A (and, for stores, D)
    // bits are updated by hardware instead of faulting: a leaf with A=0 / D=0
    // no longer faults, and (when WRITE_AD=1) the walk writes the updated PTE
    // back to memory. When 0 the legacy Svade behaviour (fault on A=0 / D=0)
    // is kept, so this is inert for existing code and the boot kernel.
    i_adue: input logic,
    // === Phase 11-H two-stage translation ===
    // i_virt = this access is virtualized (V=1, VS/VU mode). When set, the walk
    // performs nested VS-stage (i_vsatp, Sv39) → G-stage (i_hgatp, Sv39x4)
    // translation instead of the single-stage i_satp walk: each VS-stage PTE is
    // itself a guest-physical address that the G-stage translates before the
    // memory read. The V=1 path does NOT use the TLB (it walks every access), so
    // the single-stage path (i_virt=0) is byte-identical to before. i_satp / the
    // whole existing FSM remain the V=0 behaviour.
    i_virt : input logic     ,
    i_vsatp: input logic <64>,
    i_hgatp: input logic <64>,
    // Phase 11-H HLVX.HU/.WU: the final access checks execute (X) permission
    // instead of read (R) on the leaf PTE. Only meaningful for a two-stage (V=1
    // or HLV-driven) data access; ignored on the single-stage / fetch paths.
    i_hlvx : input logic     ,
    // A two-stage fault that occurred in the G-stage (guest-physical) walk, so
    // the core can raise a guest-page-fault (cause 20/21/23) instead of a plain
    // VS-stage page-fault (12/13/15). Core cause routing is H3; surfaced now.
    o_gstage_fault: output logic,
    // Phase 11-H3c: the guest physical address being translated when a G-stage
    // fault occurred (g_in_gpa). The core writes htval = this >> 2 on a
    // guest-page-fault trap. Only meaningful while o_gstage_fault is asserted.
    o_fault_gpa   : output logic<64>,
    // Page table walk memory interface
    o_ptw_addr : output logic<64>,
    o_ptw_req  : output logic    ,
    // P10 Svadu: A/D write-back. o_ptw_wen pulses while the FSM is in WRITE_AD,
    // driving a full-dword store of o_ptw_wdata (the A/D-updated leaf PTE) to
    // o_ptw_addr (which still holds the leaf PTE's address). The wrapper routes
    // it onto the dmem write port; i_ptw_data carries the read data as before.
    o_ptw_wen  : output logic    ,
    o_ptw_wdata: output logic<64>,
    i_ptw_data : input  logic<64>,
    i_ptw_valid: input  logic    ,
    // Downstream stall: keep DONE state active while dcache is filling
    i_stall: input logic,
    // TLB flush (SFENCE.VMA). P9.5: selective flush — rs1 VA / rs2 ASID and
    // their x0 (wildcard) flags. An entry is invalidated when
    //   (rs1==x0 OR its VPN matches the VA) AND
    //   (rs2==x0 OR (its ASID matches AND it is not global)),
    // which realises all four SFENCE.VMA variants (global pages survive an
    // ASID-qualified fence but not a VA-qualified one).
    i_sfence: input logic,
    i_sfence_vaddr   : input logic<64>,
    i_sfence_asid    : input logic<16>,
    i_sfence_rs1_zero: input logic    ,
    i_sfence_rs2_zero: input logic    ,
    // Pipeline redirect: cancel in-flight PTW to prevent TLB poisoning
    // when the fetch address changes during a page table walk.
    i_redirect: input logic,
    // M9.A.303 debug: expose faulting-PTE + TLB-hit context so the tb can
    // localize the v4 dmem load-fault loop (kernel VA 0x80616198 spurious
    // fault). o_dbg_pte = last PTW-read PTE; o_dbg_tlb_hit distinguishes a
    // TLB-hit permission fault from a walk fault; o_dbg_tlb_ppn/perm expose
    // the matched TLB entry when a TLB-hit fault occurs.
    o_dbg_pte     : output logic<64>,
    o_dbg_tlb_hit : output logic    ,
    o_dbg_tlb_ppn : output logic<44>,
    o_dbg_tlb_perm: output logic<4> , // {r, w, x, u}
) {
    import csr_pkg::*;
    import fpu_pkg::*; // clz (shared log-depth leading-zero tree)

    // SATP fields
    let satp_mode: logic<4>  = i_satp[63:60];
    let satp_asid: logic<16> = i_satp[59:44]; // P9.5: address-space id
    let satp_ppn : logic<44> = i_satp[43:0];

    // Virtual address fields (Sv39)
    let vpn2    : logic<9>  = i_vaddr[38:30];
    let vpn1    : logic<9>  = i_vaddr[29:21];
    let vpn0    : logic<9>  = i_vaddr[20:12];
    let page_off: logic<12> = i_vaddr[11:0];

    // VPN for TLB tag (27 bits = VPN[2] || VPN[1] || VPN[0])
    let vpn_full: logic<27> = i_vaddr[38:12];

    // === Phase 11-H two-stage decode ===
    // hgatp: MODE[63:60] (8 = Sv39x4), VMID[57:44], PPN[43:0]. Sv39x4's root
    // page table is 4x wider, so the top index spans 11 bits (GPA[40:30]).
    const HGATP_MODE_SV39X4: logic<4> = 4'd8;
    let hgatp_mode: logic<4>  = i_hgatp[63:60];
    let hgatp_ppn : logic<44> = i_hgatp[43:0];
    let vsatp_mode: logic<4>  = i_vsatp[63:60];
    let vsatp_ppn : logic<44> = i_vsatp[43:0];
    // A virtualized access (V=1) that is not in M-mode. VS-stage paging is on
    // when vsatp=Sv39; G-stage when hgatp=Sv39x4. two_stage = either is on; when
    // both are Bare the access is identity (handled by the passthrough mux).
    let v_active : logic = i_virt && i_priv != PrivLevel::MACHINE;
    let vs_on    : logic = v_active && vsatp_mode == SATP_MODE_SV39;
    let g_on     : logic = v_active && hgatp_mode == HGATP_MODE_SV39X4;
    let two_stage: logic = vs_on || g_on;

    // Phase 11-H V=1 TLB tag sources: VMID (hgatp[57:44]) distinguishes guests;
    // VS-ASID (vsatp[59:44]) distinguishes the guest's own address spaces. The
    // combined two-stage TLB below tags each cached GVA->HPA entry with both.
    let hgatp_vmid: logic<14> = i_hgatp[57:44];
    let vsatp_asid: logic<16> = i_vsatp[59:44];
    // The V=1 TLB serves (and fills) only the fully-virtualized case: both the
    // VS-stage and G-stage active, and not an HLVX access (which checks X on a
    // read — never cached). When the guest disables its own paging (vsatp Bare)
    // the entries go inert (GPA-direct accesses re-walk), so a vsatp mode switch
    // needs no extra flush.
    let v1_lookup_en: logic = vs_on && g_on && !i_hlvx;

    // Translation enabled (single-stage, V=0): Sv39 mode and not in M-mode. The
    // whole existing FSM/TLB/output logic keys off this, so gating it on !i_virt
    // makes the single-stage path inert under virtualization (the two-stage path
    // takes over) while leaving V=0 byte-identical.
    let vm_enabled: logic = !i_virt && satp_mode == SATP_MODE_SV39 && i_priv != PrivLevel::MACHINE;

    // Sv39 requires the VA's high bits [63:39] to be a sign-extension of bit 38;
    // any other VA is non-canonical and faults before the walk even begins. The
    // TLB tags only VA[38:12], so a non-canonical VA could alias (and spuriously
    // hit) a cached canonical entry — hence this gates the whole single-stage
    // translation (TLB-hit fast path AND walk start), not just the walk. Only
    // single-stage VM applies (the two-stage / V=1 path uses its own GVA rules).
    let va_noncanonical: logic = vm_enabled && (i_vaddr[63:39] != {i_vaddr[38] repeat 25});

    // ============================================================
    // TLB: 16-entry fully-associative
    // ============================================================
    var tlb_valid : logic     [16];
    var tlb_vpn   : logic<27> [16];
    var tlb_ppn   : logic<44> [16];
    var tlb_perm_r: logic     [16];
    var tlb_perm_w: logic     [16];
    var tlb_perm_x: logic     [16];
    var tlb_perm_u: logic     [16]; // U bit (user page)
    var tlb_level : logic<2>  [16]; // leaf level (0/1/2)
    // P9.5: per-entry ASID + global (G) bit. An entry matches when it is global
    // (kernel mapping, shared across address spaces) OR its ASID equals the
    // current satp.ASID — so a process switch (satp ASID change with no flush,
    // the ASID-enabled Linux path) no longer returns another space's stale
    // translation. A full SFENCE.VMA still flushes everything (conservative).
    var tlb_asid  : logic<16> [16];
    var tlb_global: logic     [16];
    var tlb_unc   : logic     [16]; // P10 Svpbmt: NC/IO (non-cacheable) translation

    // TLB lookup (combinational)
    var tlb_hit    : logic    ;
    var tlb_hit_idx: logic<4> ;
    var tlb_hit_ppn: logic<44>;
    var tlb_hit_r  : logic    ;
    var tlb_hit_w  : logic    ;
    var tlb_hit_x  : logic    ;
    var tlb_hit_u  : logic    ;
    var tlb_hit_unc: logic    ; // P10 Svpbmt
    var tlb_hit_lvl: logic<2> ;

    always_comb {
        var tlb_m: logic<16>;
        tlb_m = 16'd0;
        for i in 0..16 {
            // Match based on page level:
            // Level 2 (1GB): match VPN[2] only (bits 26:18)
            // Level 1 (2MB): match VPN[2:1] (bits 26:9)
            // Level 0 (4KB): match all VPN[2:0] (bits 26:0)
            let asid_ok: logic = tlb_global[i] || tlb_asid[i] == satp_asid;
            // Phase 11-H: the TLB holds only V=0 (single-stage) entries; a
            // virtualized access (i_virt) always misses and walks two-stage.
            tlb_m[i] = tlb_valid[i] && asid_ok && !i_virt
                && ((tlb_level[i] == 2'd2 && tlb_vpn[i][26:18] == vpn_full[26:18])
                    || (tlb_level[i] == 2'd1 && tlb_vpn[i][26:9] == vpn_full[26:9])
                    || (tlb_level[i] == 2'd0 && tlb_vpn[i] == vpn_full));
        }
        // Highest matching index wins (bit-exact with the old top-down `if
        // match_ok { ... }` priority scan): the leading one of the match vector,
        // found by the shared clz tree, indexes the entry arrays directly (a
        // log-depth mux tree) instead of a 16-deep loop-carried priority chain.
        let tlb_any : logic    = tlb_m != 16'd0;
        let tlb_lead: logic<9> = clz::<16>(tlb_m);
        let tlb_sel : logic<4> = 4'd15 - tlb_lead[3:0];
        tlb_hit     = tlb_any;
        tlb_hit_idx = if tlb_any ? tlb_sel : 4'd0;
        tlb_hit_ppn = if tlb_any ? tlb_ppn[tlb_sel] : 44'd0;
        tlb_hit_r   = if tlb_any ? tlb_perm_r[tlb_sel] : 1'b0;
        tlb_hit_w   = if tlb_any ? tlb_perm_w[tlb_sel] : 1'b0;
        tlb_hit_x   = if tlb_any ? tlb_perm_x[tlb_sel] : 1'b0;
        tlb_hit_u   = if tlb_any ? tlb_perm_u[tlb_sel] : 1'b0;
        tlb_hit_lvl = if tlb_any ? tlb_level[tlb_sel] : 2'd0;
        tlb_hit_unc = if tlb_any ? tlb_unc[tlb_sel] : 1'b0;
    }

    // TLB hit physical address construction
    var tlb_pa: logic<64>;
    always_comb {
        case tlb_hit_lvl {
            2'd2   : tlb_pa = {8'b0, tlb_hit_ppn[43:18], i_vaddr[29:0]};
            2'd1   : tlb_pa = {8'b0, tlb_hit_ppn[43:9], i_vaddr[20:0]};
            default: tlb_pa = {8'b0, tlb_hit_ppn, page_off};
        }
    }

    // TLB hit permission check (RISC-V Sv39 spec compliant)
    // R/W/X permission with MXR: MXR=1 makes X pages readable
    let tlb_read_ok: logic = tlb_hit_r || (i_mxr && tlb_hit_x);
    let tlb_rwx_ok : logic = if i_cbo ? (tlb_hit_r || tlb_hit_w) : if i_fetch ? tlb_hit_x : if i_store ? tlb_hit_w : tlb_read_ok;
    // U-bit check:
    //   U=1 (user page): U-mode OK; S-mode needs SUM=1, never executable by S
    //   U=0 (supervisor page): S-mode OK; U-mode never
    let tlb_u_ok   : logic = if i_priv == PrivLevel::USER ? tlb_hit_u : (if tlb_hit_u ? (i_sum && !i_fetch) : 1'b1);
    let tlb_perm_ok: logic = tlb_rwx_ok && tlb_u_ok;
    // CP commit-store pre-translate: STORE-semantics TLB permission (see o_sprobe_*
    // assigns below). The store permission is W with D folded in at fill
    // (tlb_perm_w = pte_w && pte_d), so a clean (D=0) page reports W=0 and falls
    // back — exactly the page that the commit walk must Svadu-update or fault on.
    // U-bit check is the same tlb_u_ok (i_fetch=0 here).
    let tlb_store_perm_ok: logic = tlb_hit_w && tlb_u_ok;

    // Round-robin replacement pointer
    var tlb_replace_idx: logic<4>;

    // ============================================================
    // Phase 11-H V=1 TLB: 32-entry combined two-stage cache
    // ============================================================
    // Caches the final guest-VA -> host-PA translation produced by a successful
    // two-stage walk (VS-stage Sv39 + G-stage Sv39x4), so a steady-state guest
    // does not re-walk every fetch/load/store (each two-stage walk is ~10-15
    // dependent memory reads). Tagged by {VMID, VS-ASID, guest VPN}; the effective
    // page level is min(VS leaf level, G leaf level) and the stored host PPN +
    // level reconstruct the HPA exactly as the single-stage TLB does. Permissions
    // are the per-stage AND (VS perm & G perm), with each stage's D folded into W.
    // A lookup HITS only when the combined permission allows the access; a tag
    // match that fails the permission check falls through to a full walk, which
    // re-derives the correctly-attributed VS-/G-stage fault — so this TLB never
    // produces a fault itself. Flushed wholesale on any SFENCE.VMA / HFENCE (guest
    // VS-stage fence, or the hypervisor's HFENCE.VVMA/GVMA — both reach the MMU as
    // i_sfence; see decoder.veryl).
    var v1_valid : logic     [32];
    var v1_vpn   : logic<27> [32];
    var v1_vmid  : logic<14> [32];
    var v1_asid  : logic<16> [32];
    var v1_global: logic     [32]; // VS leaf G bit (global within the guest)
    var v1_level : logic<2>  [32]; // effective leaf level (min of the two stages)
    var v1_ppn   : logic<44> [32]; // host PPN (4KB-granular)
    var v1_r     : logic     [32]; // combined R (VS.r & G.r)
    var v1_w     : logic     [32]; // combined W, D folded ((VS.w&VS.d)&(G.w&G.d))
    var v1_x     : logic     [32]; // combined X (VS.x & G.x)
    var v1_u     : logic     [32]; // VS leaf U (G leaf U is always 1)
    var v1_repl  : logic<5>      ; // round-robin replacement pointer

    var v1_match  : logic    ;
    var v1_hit_ppn: logic<44>;
    var v1_hit_r  : logic    ;
    var v1_hit_w  : logic    ;
    var v1_hit_x  : logic    ;
    var v1_hit_u  : logic    ;
    var v1_hit_lvl: logic<2> ;
    always_comb {
        var v1_m: logic<32>;
        v1_m = 32'd0;
        for i in 0..32 {
            let asid_ok: logic = v1_global[i] || v1_asid[i] == vsatp_asid;
            v1_m[i] = v1_valid[i] && v1_lookup_en && v1_vmid[i] == hgatp_vmid && asid_ok
                && ((v1_level[i] == 2'd2 && v1_vpn[i][26:18] == vpn_full[26:18])
                    || (v1_level[i] == 2'd1 && v1_vpn[i][26:9] == vpn_full[26:9])
                    || (v1_level[i] == 2'd0 && v1_vpn[i] == vpn_full));
        }
        // Highest matching index wins (bit-exact with the old top-down priority
        // scan): clz of the 32-bit match vector indexes the entry arrays
        // directly (log-depth mux tree), not a 32-deep priority chain.
        let v1_any : logic    = v1_m != 32'd0;
        let v1_lead: logic<9> = clz::<32>(v1_m);
        let v1_sel : logic<5> = 5'd31 - v1_lead[4:0];
        v1_match   = v1_any;
        v1_hit_ppn = if v1_any ? v1_ppn[v1_sel] : 44'd0;
        v1_hit_r   = if v1_any ? v1_r[v1_sel] : 1'b0;
        v1_hit_w   = if v1_any ? v1_w[v1_sel] : 1'b0;
        v1_hit_x   = if v1_any ? v1_x[v1_sel] : 1'b0;
        v1_hit_u   = if v1_any ? v1_u[v1_sel] : 1'b0;
        v1_hit_lvl = if v1_any ? v1_level[v1_sel] : 2'd0;
    }

    // Reconstruct the host PA from the matched entry (same level mux as V=0).
    var v1_pa: logic<64>;
    always_comb {
        case v1_hit_lvl {
            2'd2   : v1_pa = {8'b0, v1_hit_ppn[43:18], i_vaddr[29:0]};
            2'd1   : v1_pa = {8'b0, v1_hit_ppn[43:9], i_vaddr[20:0]};
            default: v1_pa = {8'b0, v1_hit_ppn, page_off};
        }
    }
    // Combined permission check. A tag match that fails this is NOT a hit — it
    // falls through to a full walk for correct VS-/G-stage fault attribution.
    let v1_read_ok: logic = v1_hit_r || (i_mxr && v1_hit_x);
    let v1_rwx_ok : logic = if i_cbo ? (v1_hit_r || v1_hit_w) : if i_fetch ? v1_hit_x : if i_store ? v1_hit_w : v1_read_ok;
    let v1_u_ok   : logic = if i_priv == PrivLevel::USER ? v1_hit_u : (if v1_hit_u ? (i_sum && !i_fetch) : 1'b1);
    let v1_hit    : logic = v1_match && v1_rwx_ok && v1_u_ok;

    // ============================================================
    // Page table walk state machine
    // ============================================================
    enum State: logic<4> {
        IDLE = 4'd0,
        LEVEL2 = 4'd1, // Reading level-2 PTE
        LEVEL1 = 4'd2, // Reading level-1 PTE
        LEVEL0 = 4'd3, // Reading level-0 PTE
        DONE = 4'd4, // Translation complete, waiting for data access
        FAULT = 4'd5,
        FAULT2 = 4'd6, // 1-cycle delay after FAULT (let fetch PC update)
        WRITE_AD = 4'd7, // P10 Svadu: writing the A/D-updated leaf PTE back
        // Phase 11-H two-stage (V=1) states. The G-stage sub-walk (GST_*) reads
        // G-stage PTEs at host PAs directly; VS_RD reads the VS-stage PTE at the
        // host PA the G-stage just produced; TS_DONE/TS_FAULT mirror DONE/FAULT
        // for the two-stage result (no TLB fill in V=1).
        GST_L2 = 4'd8,
        GST_L1 = 4'd9,
        GST_L0 = 4'd10,
        VS_RD = 4'd11,
        TS_DONE = 4'd12,
        TS_FAULT = 4'd13,
        TS_FAULT2 = 4'd14,
    }

    var state  : State    ;
    var pte    : logic<64>;
    var pte_ppn: logic<44>;

    // PTE fields
    let pte_v: logic = pte[0];
    let pte_r: logic = pte[1];
    let pte_w: logic = pte[2];
    let pte_x: logic = pte[3];
    let pte_u: logic = pte[4];
    let pte_a: logic = pte[6];
    let pte_d: logic = pte[7];
    // Physical address construction
    var pa: logic<64>;

    // PTW address computation
    var ptw_addr_reg: logic<64>;

    // PMP (Smpmp) SvPMP: set when the walk faults because a PTE-read physical
    // address (o_ptw_addr = ptw_addr_reg) is PMP-denied. Distinguishes the FAULT
    // state as an ACCESS fault (cause 1/5/7) from a page fault; cleared at each
    // new walk start. `pte_pmp_deny` is the combinational PMP verdict on the PTE
    // address currently being read.
    var walk_acc_fault: logic;
    var pte_pmp_deny  : logic;
    inst u_ptw_pmp: pmp_check (
        i_addr   : ptw_addr_reg,
        i_acc    : 2'd0        , // implicit PTE read = R permission
        i_priv                 ,
        i_pmpcfg               ,
        i_pmpaddr              ,
        o_fault  : pte_pmp_deny,
    );
    // P10 Svadu + PMP: the hardware A/D write-back is a WRITE to the leaf PTE's
    // physical address (o_ptw_addr = ptw_addr_reg). It needs PMP WRITE
    // permission; if the PTE's region is W-denied the triggering access takes an
    // access fault (cause 1/5/7) instead of updating the bits. (ACT4 SvaduPMP.)
    var pte_pmp_deny_w: logic;
    inst u_ptw_pmp_w: pmp_check (
        i_addr   : ptw_addr_reg  ,
        i_acc    : 2'd1          , // A/D write-back = W permission
        i_priv                   ,
        i_pmpcfg                 ,
        i_pmpaddr                ,
        o_fault  : pte_pmp_deny_w,
    );
    // PMA: the PTE being read this level lives at ptw_addr_reg; if that PA is
    // unbacked (a hole) the implicit read access-faults (same backing map as the
    // wrapper's final-PA pma_hole: DRAM pa[31] / CLINT 0x02 / UART 0x1 / PLIC
    // 0x0C). Treated like a PMP-deny → walk_acc_fault. PMA_FAULT=0 → inert.
    let pte_pma_hole: logic = PMA_FAULT && !(ptw_addr_reg[31] || ptw_addr_reg[31:24] == 8'h02 || ptw_addr_reg[31:28] == 4'h1 || ptw_addr_reg[31:24] == 8'h0c);

    // Track which level the leaf PTE was found at
    var leaf_level: logic<2>;

    // Leaf-PTE PPN captured at leaf detection. Decoupled from `pte` register
    // for cleaner data flow.
    var leaf_pte_ppn: logic<44>;
    // P9.5: leaf-PTE global (G) bit, captured at leaf detection (mirrors
    // leaf_pte_ppn); written into the TLB entry at DONE.
    var leaf_global: logic;

    // Latched walk VA — captured at IDLE→LEVEL2 transition. Earlier code
    // used the combinational `vpn_full` (= i_vaddr[38:12]) for TLB writes in
    // the DONE state. If `i_vaddr` changed mid-walk (e.g., fetch PC updated
    // during a multi-cycle walk), the TLB would be poisoned with the
    // current-cycle VA but the PTE walked for the original VA. v4 Linux
    // stub: kernel fetch at VA 0x80000118 mis-mapped to PA 0x118 because
    // an earlier low-VA walk's PTE (PPN=0) was stored under vpn_full=0x80000.
    var walk_vpn_full: logic<27>;
    var walk_vpn1    : logic<9> ;
    var walk_vpn0    : logic<9> ;
    var walk_page_off: logic<12>;
    // P9.5: ASID latched at walk start (satp is stable across a walk, but latch
    // it for the same reason walk_vpn_full is latched — the TLB fill at DONE
    // must use the walk's ASID, not a drifted current value).
    var walk_asid    : logic<16>;

    // === Phase 11-H two-stage walk registers (used only when i_virt) ===
    // The VS-stage descends vsatp's page table over the guest VA; every VS PTE
    // it must read lives at a guest PA, which the G-stage sub-walk (over hgatp)
    // translates to a host PA first. g_after_fin marks whether the current
    // G-stage result is the final HPA (g_after_fin=1) or a VS PTE host address
    // to read next (g_after_fin=0). No TLB is used in V=1 (walk every access).
    var ts_gva     : logic<64>; // latched guest VA being translated
    var ts_is_store: logic    ; // latched access type (leaf perm + A/D)
    var ts_is_fetch: logic    ;
    var ts_is_xperm: logic    ; // Phase 11-H HLVX: final access checks X, not R
    var vs_lvl     : logic<2> ; // current VS-stage level (2..0)
    var g_in_gpa   : logic<64>; // guest PA the G-stage sub-walk is translating
    var g_after_fin: logic    ; // 1 = G result is final HPA; 0 = a VS PTE host addr
    var ts_hpa     : logic<64>; // final host PA result
    var ts_gflt    : logic    ; // the latched two-stage fault was in the G-stage
    // V=1 TLB fill context, latched alongside the walk. ts_fill_ok gates the fill
    // on the both-stages-active, non-HLVX case (mirrors v1_lookup_en at walk
    // start). vs_leaf_* capture the VS-stage leaf's level / permissions / global
    // bit when the VS leaf is found (VS_RD); they are combined with the final
    // G-stage leaf's permissions at fill time (the GST_* g_after_fin branch).
    var ts_vmid    : logic<14>;
    var ts_vs_asid : logic<16>;
    var ts_fill_ok : logic    ;
    var vs_leaf_lvl: logic<2> ;
    var vs_leaf_r  : logic    ;
    var vs_leaf_w  : logic    ;
    var vs_leaf_x  : logic    ;
    var vs_leaf_u  : logic    ;
    var vs_leaf_d  : logic    ;
    var vs_leaf_g  : logic    ;

    // Leaf PTE validity: valid + leaf (R or X) + PBMT not reserved, plus the
    // A/D requirement. With Svade (i_adue=0) the A bit must be set and, for a
    // store, the D bit too — otherwise fault. With Svadu (i_adue=1) an A=0 /
    // D=0 leaf no longer faults; hardware updates the bits instead.
    // Superpage: level-1 requires PPN[0]=0, level-2 requires PPN[1:0]=0.
    // A cbo is treated as a read for A/D: it needs A but not D (it does not dirty
    // the page), so only a genuine store (i_store && !i_cbo) requires the D bit.
    let ad_ok     : logic = i_ptw_data[6] && (!(i_store && !i_cbo) || i_ptw_data[7]);
    // PTE bits [60:54] are reserved in Sv39 and must be zero in EVERY PTE (leaf
    // or non-leaf); a non-zero value is a reserved encoding → page fault.
    let pte_rsvd_hi: logic = i_ptw_data[60:54] != 7'd0;
    // W=1 with R=0 (X W R encodings 010 / 110) is reserved-for-future-use →
    // page fault, regardless of level or X. (A real pointer PTE is 000.)
    let pte_wr_rsvd: logic = i_ptw_data[2] && !i_ptw_data[1];
    // P10 Svpbmt: the leaf PBMT field (62:61). When PBMTE=1 only 11 is reserved
    // (01/10 select NC/IO); when PBMTE=0 Svpbmt is off and ANY non-zero PBMT is
    // a reserved encoding → fault (the Sv `svpbmt_disabled` suite checks this).
    let pbmt_rsvd  : logic = if i_pbmte ? (i_ptw_data[62:61] == 2'b11) : (i_ptw_data[62:61] != 2'b00);
    let leaf_valid: logic = i_ptw_data[0] && (i_ptw_data[1] || i_ptw_data[3])
        && (ad_ok || i_adue)
        && !pbmt_rsvd && !pte_rsvd_hi && !pte_wr_rsvd;
    // A non-leaf (pointer) PTE must leave the leaf-only fields clear, else the
    // encoding is reserved → page fault: the N bit (Svnapot, 63), the PBMT field
    // (62:61), the D/A/U bits (7/6/4 — leaf-only; G at bit 5 IS allowed and
    // propagates), the reserved bits [60:54], and W (a pointer has W=0; W set
    // with R=0/X=0 is the reserved 010 encoding). (N/PBMT/D/A/U are only
    // architecturally meaningful in leaf PTEs.)
    let nonleaf_reserved: logic = i_ptw_data[63] || i_ptw_data[62:61] != 2'b00
        || i_ptw_data[7] || i_ptw_data[6] || i_ptw_data[4]
        || pte_rsvd_hi || i_ptw_data[2];
    // P10 Svadu: this leaf needs an A/D write-back. Only the data side
    // (WRITE_AD=1) writes the bits back; the i-side just relaxes the fault.
    let need_ad_wb: logic = (WRITE_AD != 0) && i_adue && !ad_ok;
    // The leaf PTE with A (and, for a store, D) set — used as both the
    // write-back data and the cached/DONE PTE, so the TLB write permission
    // (pte_w && pte_d) reflects the freshly-set D bit.
    let pte_ad_new: logic<64> = i_ptw_data | 64'h40 | (if i_store && !i_cbo ? 64'h80 : 64'd0);

    // === Phase 11-H two-stage helpers ===
    // Incoming PTE (i_ptw_data) field views, shared by the G-stage and VS-stage
    // walk transitions (the PTE format is identical at both stages).
    let in_v   : logic     = i_ptw_data[0];
    let in_r   : logic     = i_ptw_data[1];
    let in_w   : logic     = i_ptw_data[2];
    let in_x   : logic     = i_ptw_data[3];
    let in_u   : logic     = i_ptw_data[4];
    let in_a   : logic     = i_ptw_data[6];
    let in_d   : logic     = i_ptw_data[7];
    let in_leaf: logic     = i_ptw_data[1] || i_ptw_data[3];
    let in_ppn : logic<44> = i_ptw_data[53:10];
    // VS-stage VPN fields from the latched guest VA (Sv39: 9/9/9).
    let ts_vpn1: logic<9> = ts_gva[29:21];
    let ts_vpn0: logic<9> = ts_gva[20:12];
    // G-stage VPN fields from the GPA under translation (Sv39x4: 11/9/9).
    let g_vpn1 : logic<9> = g_in_gpa[29:21];
    let g_vpn0 : logic<9> = g_in_gpa[20:12];
    // G-stage permission for the current sub-walk. When g_after_fin the access is
    // the real one (fetch/store/load); otherwise it is an implicit load of a
    // VS-stage PTE. G-stage pages must be user (U=1); SUM does not apply.
    let g_rwx_ok: logic = if g_after_fin ?
        (if ts_is_fetch || ts_is_xperm ? in_x : if ts_is_store ? in_w : (in_r || (i_mxr && in_x)))
    :
        (in_r || (i_mxr && in_x))
    ;
    let g_ad_ok : logic = in_a && (!(g_after_fin && ts_is_store) || in_d);
    let g_perm_ok: logic = g_rwx_ok && in_u && g_ad_ok;
    // VS-stage leaf permission for the real access (uses VS-mode sum/mxr, which
    // the core supplies on i_sum/i_mxr when i_virt).
    let vs_rwx_ok: logic = if ts_is_fetch || ts_is_xperm ? in_x : if ts_is_store ? in_w : (in_r || (i_mxr && in_x));
    let vs_u_ok  : logic = if i_priv == PrivLevel::USER ? in_u : (if in_u ? (i_sum && !ts_is_fetch) : 1'b1);
    let vs_ad_ok : logic = in_a && (!ts_is_store || in_d);
    let vs_perm_ok: logic = vs_rwx_ok && vs_u_ok && vs_ad_ok;

    always_ff (clk, rst) {
        if_reset {
            state           = State::IDLE;
            pte             = '0;
            leaf_level      = 2'd0;
            leaf_pte_ppn    = 44'd0;
            leaf_global     = 1'b0;
            walk_acc_fault  = 1'b0;
            walk_vpn_full   = 27'd0;
            walk_vpn1       = 9'd0;
            walk_vpn0       = 9'd0;
            walk_page_off   = 12'd0;
            walk_asid       = 16'd0;
            tlb_replace_idx = 4'd0;
            // Phase 11-H two-stage registers.
            ts_gva      = 64'd0;
            ts_is_store = 1'b0;
            ts_is_fetch = 1'b0;
            ts_is_xperm = 1'b0;
            vs_lvl      = 2'd0;
            g_in_gpa    = 64'd0;
            g_after_fin = 1'b0;
            ts_hpa      = 64'd0;
            ts_gflt     = 1'b0;
            // V=1 TLB
            for i in 0..32 {
                v1_valid[i] = 1'b0;
            }
            v1_repl     = 5'd0;
            ts_vmid     = 14'd0;
            ts_vs_asid  = 16'd0;
            ts_fill_ok  = 1'b0;
            vs_leaf_lvl = 2'd0;
            vs_leaf_r   = 1'b0;
            vs_leaf_w   = 1'b0;
            vs_leaf_x   = 1'b0;
            vs_leaf_u   = 1'b0;
            vs_leaf_d   = 1'b0;
            vs_leaf_g   = 1'b0;
        } else if i_sfence {
            // SFENCE.VMA: invalidate the selected TLB entries (see the port
            // comment). A wildcard rs1/rs2 (x0) widens the match to all VAs /
            // all ASIDs; rs1=x0,rs2=x0 degenerates to the old full flush.
            let sf_vpn: logic<27> = i_sfence_vaddr[38:12];
            for i in 0..16 {
                let va_match: logic = i_sfence_rs1_zero
                    || (tlb_level[i] == 2'd2 && tlb_vpn[i][26:18] == sf_vpn[26:18])
                    || (tlb_level[i] == 2'd1 && tlb_vpn[i][26:9] == sf_vpn[26:9])
                    || (tlb_level[i] == 2'd0 && tlb_vpn[i] == sf_vpn);
                let asid_match: logic = i_sfence_rs2_zero
                    || (tlb_asid[i] == i_sfence_asid && !tlb_global[i]);
                if va_match && asid_match {
                    tlb_valid[i] = 1'b0;
                }
            }
            // Phase 11-H: any SFENCE.VMA / HFENCE flushes the whole V=1 TLB. This
            // is conservative (full flush regardless of operands), but correct for
            // every case that can stale a guest translation: a guest VS-stage
            // fence, and the hypervisor's HFENCE.VVMA/GVMA (both arrive here as
            // i_sfence — see decoder.veryl).
            for i in 0..32 {
                v1_valid[i] = 1'b0;
            }
            state = State::IDLE;
        } else if i_redirect && state != State::IDLE && state != State::DONE && state != State::WRITE_AD && state != State::TS_DONE {
            // Pipeline redirect (misprediction/trap): cancel in-flight PTW.
            // Phase 11-H: a two-stage walk (GST_*/VS_RD) is also safely abortable
            // (no TLB to poison in V=1); TS_DONE, like DONE, holds a valid result.
            // The fetch address has changed, so continuing the walk would
            // register the old PTE under the new VPN — TLB poisoning.
            // EXCEPTION: DONE state already has a valid PTE for its latched
            // walk VA. Caching it in the TLB is always safe (the VA tag now
            // uses walk_vpn_full, not the post-redirect i_vaddr). Skipping
            // DONE on redirect previously dropped TLB writes silently, so
            // back-to-back fetches for the same VA re-walked, each time
            // also potentially missing the write — observed in v4 Linux
            // stub as walks 1 and 2 both storing at TLB idx=0 (= no
            // increment) at cy=0x2a83 / 0x2a8e.
            state = State::IDLE;
        } else {
            case state {
                State::IDLE: {
                    if i_req && vm_enabled && !tlb_hit && !va_noncanonical {
                        // TLB miss: start page table walk
                        // PTE address = satp.PPN * 4096 + VPN[2] * 8
                        ptw_addr_reg = {8'b0, satp_ppn, vpn2, 3'b000};
                        // SvPMP: each fresh walk starts with no PTE access fault.
                        walk_acc_fault = 1'b0;
                        // Latch the walk's VA components so subsequent
                        // levels and the TLB write at DONE use the original
                        // VA, not whatever i_vaddr drifts to during the walk.
                        walk_vpn_full = vpn_full;
                        walk_vpn1     = vpn1;
                        walk_vpn0     = vpn0;
                        walk_page_off = page_off;
                        walk_asid     = satp_asid;
                        state         = State::LEVEL2;
                    } else if i_req && two_stage && !v1_hit {
                        // Phase 11-H: start a two-stage walk. Latch the access.
                        // The first GPA to G-translate is either the VS L2 PTE
                        // address (vsatp.PPN*4096 + VPN2*8) or, if vsatp is Bare,
                        // the GVA itself. Compute it into a local: g_in_gpa is a
                        // register, so reading it back this same cycle would see
                        // its OLD value under non-blocking assignment.
                        let first_gpa: logic<64> = if vs_on ?
                            {8'd0, vsatp_ppn, 12'd0} + {52'd0, i_vaddr[38:30], 3'd0}
                        :
                            i_vaddr
                        ;
                        ts_gva      = i_vaddr;
                        ts_is_store = i_store;
                        ts_is_fetch = i_fetch;
                        ts_is_xperm = i_hlvx;
                        ts_gflt     = 1'b0;
                        // V=1 TLB fill context for this walk.
                        ts_vmid     = hgatp_vmid;
                        ts_vs_asid  = vsatp_asid;
                        ts_fill_ok  = vs_on && g_on && !i_hlvx;
                        vs_lvl      = 2'd2;
                        g_in_gpa    = first_gpa;
                        g_after_fin = if vs_on ? 1'b0 : 1'b1;
                        if g_on {
                            ptw_addr_reg = {8'd0, hgatp_ppn, 12'd0} + {50'd0, first_gpa[40:30], 3'd0};
                            state        = State::GST_L2;
                        } else if vs_on {
                            // hgatp Bare: G-stage identity. The VS PTE host addr
                            // equals its guest PA — read it directly.
                            ptw_addr_reg = first_gpa;
                            state        = State::VS_RD;
                        } else {
                            // Both stages Bare under V=1: identity. (two_stage is
                            // false here, so this branch is unreachable; kept for
                            // totality.) Treat as a 1-cycle done.
                            ts_hpa = i_vaddr;
                            state  = State::TS_DONE;
                        }
                    }
                }
                State::LEVEL2: {
                    if pte_pmp_deny || pte_pma_hole {
                        // SvPMP/PMA: fault on the PMP verdict at level entry, before
                        // i_ptw_valid (a suppressed denied-PTE read else lets the walk
                        // linger past the trap into M-mode → bogus TLB fill). See LEVEL0.
                        walk_acc_fault = 1'b1;
                        state          = State::FAULT;
                    } else if i_ptw_valid {
                        pte = i_ptw_data;
                        if i_ptw_data[0] == 1'b0 {
                            // Invalid PTE
                            state = State::FAULT;
                        } else if i_ptw_data[1] || i_ptw_data[3] {
                            // Leaf PTE at level 2 (1GB gigapage)
                            // Check alignment: PPN[1:0] (i.e. PPN[17:0]) must be 0.
                            // Svnapot N=1 is reserved above level 0 in Sv39 → fault.
                            if !leaf_valid || i_ptw_data[27:10] != 18'd0 || i_ptw_data[63] {
                                state = State::FAULT;
                            } else {
                                leaf_level   = 2'd2;
                                leaf_pte_ppn = i_ptw_data[53:10];
                                leaf_global  = i_ptw_data[5];
                                // P10 Svadu: A/D update needed → write-back first.
                                // PMP: a W-denied PTE region faults the access.
                                if need_ad_wb && pte_pmp_deny_w {
                                    walk_acc_fault = 1'b1;
                                    state          = State::FAULT;
                                } else if need_ad_wb {
                                    pte   = pte_ad_new;
                                    state = State::WRITE_AD;
                                } else {
                                    state = State::DONE;
                                }
                            }
                        } else if nonleaf_reserved {
                            // Non-leaf PTE with a reserved N / PBMT field → fault.
                            state = State::FAULT;
                        } else {
                            // Non-leaf: follow to level 1
                            let next_ppn    : logic<44> = i_ptw_data[53:10];
                            ptw_addr_reg = {8'b0, next_ppn, walk_vpn1, 3'b000};
                            state        = State::LEVEL1;
                        }
                    }
                }
                State::LEVEL1: {
                    if pte_pmp_deny || pte_pma_hole {
                        // SvPMP/PMA: fault on the PMP verdict at level entry, before
                        // i_ptw_valid (a suppressed denied-PTE read else lets the walk
                        // linger past the trap into M-mode → bogus TLB fill). See LEVEL0.
                        walk_acc_fault = 1'b1;
                        state          = State::FAULT;
                    } else if i_ptw_valid {
                        pte = i_ptw_data;
                        if i_ptw_data[0] == 1'b0 {
                            state = State::FAULT;
                        } else if i_ptw_data[1] || i_ptw_data[3] {
                            // Leaf PTE at level 1 (2MB megapage)
                            // Check alignment: PPN[0] (i.e. PPN[8:0]) must be 0.
                            // Svnapot N=1 is reserved above level 0 in Sv39 → fault.
                            if !leaf_valid || i_ptw_data[18:10] != 9'd0 || i_ptw_data[63] {
                                state = State::FAULT;
                            } else {
                                leaf_level   = 2'd1;
                                leaf_pte_ppn = i_ptw_data[53:10];
                                leaf_global  = i_ptw_data[5];
                                // P10 Svadu: A/D update needed → write-back first.
                                // PMP: a W-denied PTE region faults the access.
                                if need_ad_wb && pte_pmp_deny_w {
                                    walk_acc_fault = 1'b1;
                                    state          = State::FAULT;
                                } else if need_ad_wb {
                                    pte   = pte_ad_new;
                                    state = State::WRITE_AD;
                                } else {
                                    state = State::DONE;
                                }
                            }
                        } else if nonleaf_reserved {
                            // Non-leaf PTE with a reserved N / PBMT field → fault.
                            state = State::FAULT;
                        } else {
                            let next_ppn    : logic<44> = i_ptw_data[53:10];
                            ptw_addr_reg = {8'b0, next_ppn, walk_vpn0, 3'b000};
                            state        = State::LEVEL0;
                        }
                    }
                }
                State::LEVEL0: {
                    if pte_pmp_deny || pte_pma_hole {
                        // SvPMP/PMA: fault as soon as this level's PTE physical
                        // address is PMP-denied / unbacked — do NOT wait for
                        // i_ptw_valid. A PMP-denied PTE read is SUPPRESSED (never
                        // completes), so the FSM fault inside `if i_ptw_valid` below
                        // would never fire; the walk then lingers in this level until
                        // the faulting access traps. If that trap raises privilege to
                        // M (the priv test framework handles in M-mode), the now-M
                        // PMP re-check passes (M bypasses PMP), the read finally
                        // completes, and the walk reaches DONE — filling a BOGUS TLB
                        // entry. A re-issued same-VA access then hits it and BYPASSES
                        // the fault (ACT4 SvPMPZicbo pte_zicbom: only the 1st of 3
                        // back-to-back cbo to the L0-denied VA faulted). Faulting on
                        // the (registered, stable) PMP verdict at level entry — while
                        // still in the access's own privilege — cancels the walk
                        // before DONE, so no TLB fill and every retry re-walks/re-faults.
                        walk_acc_fault = 1'b1;
                        state          = State::FAULT;
                    } else if i_ptw_valid {
                        pte = i_ptw_data;
                        if i_ptw_data[0] == 1'b0 {
                            state = State::FAULT;
                        } else if i_ptw_data[1] || i_ptw_data[3] {
                            // Leaf PTE at level 0 (4KB page, or 64KB NAPOT if N=1).
                            if !leaf_valid {
                                state = State::FAULT;
                            } else if i_ptw_data[63] {
                                // P10 Svnapot: N=1 marks a NAPOT contiguous range.
                                // Sv39 defines only the 64KB size, encoded as
                                // PPN[3:0]==4'b1000; any other encoding is reserved
                                // → fault. The translated PPN takes its low 4 bits
                                // from VA[15:12] (= vpn0[3:0]); we resolve them here
                                // and store a plain per-4KB TLB entry, so no
                                // NAPOT-awareness is needed on the TLB-hit path.
                                if i_ptw_data[13:10] != 4'b1000 {
                                    state = State::FAULT;
                                } else {
                                    leaf_level   = 2'd0;
                                    leaf_pte_ppn = {i_ptw_data[53:14], walk_vpn0[3:0]};
                                    leaf_global  = i_ptw_data[5];
                                    // P10 Svadu: A/D update needed → write-back first.
                                    // PMP: a W-denied PTE region faults the access.
                                    if need_ad_wb && pte_pmp_deny_w {
                                        walk_acc_fault = 1'b1;
                                        state          = State::FAULT;
                                    } else if need_ad_wb {
                                        pte   = pte_ad_new;
                                        state = State::WRITE_AD;
                                    } else {
                                        state = State::DONE;
                                    }
                                }
                            } else {
                                leaf_level   = 2'd0;
                                leaf_pte_ppn = i_ptw_data[53:10];
                                leaf_global  = i_ptw_data[5];
                                // P10 Svadu: A/D update needed → write-back first.
                                // PMP: a W-denied PTE region faults the access.
                                if need_ad_wb && pte_pmp_deny_w {
                                    walk_acc_fault = 1'b1;
                                    state          = State::FAULT;
                                } else if need_ad_wb {
                                    pte   = pte_ad_new;
                                    state = State::WRITE_AD;
                                } else {
                                    state = State::DONE;
                                }
                            }
                        } else {
                            // Non-leaf at level 0 is invalid
                            state = State::FAULT;
                        }
                    }
                }
                State::DONE: {
                    // Fill TLB immediately and return to IDLE.
                    // Don't wait for downstream stall — the TLB entry
                    // is valid regardless of icache/dcache state.
                    tlb_valid[tlb_replace_idx] = 1'b1;
                    // Use latched walk VA, not the (possibly drifted)
                    // current i_vaddr's vpn_full. See walk_vpn_full
                    // declaration for the v4 Linux stub bug context.
                    tlb_vpn[tlb_replace_idx]    = walk_vpn_full;
                    tlb_ppn[tlb_replace_idx]    = leaf_pte_ppn;
                    tlb_perm_r[tlb_replace_idx] = pte_r;
                    // Fold D bit into TLB write permission so that a
                    // cached leaf with W=1 but D=0 still faults on store,
                    // letting software set D and sfence to retry.
                    tlb_perm_w[tlb_replace_idx] = pte_w && pte_d;
                    tlb_perm_x[tlb_replace_idx] = pte_x;
                    tlb_perm_u[tlb_replace_idx] = pte_u;
                    tlb_level[tlb_replace_idx]  = leaf_level;
                    // P9.5: tag with the walk's ASID + the leaf's global bit.
                    tlb_asid[tlb_replace_idx]   = walk_asid;
                    tlb_global[tlb_replace_idx] = leaf_global;
                    // P10 Svpbmt: cache the NC/IO memory type. pte holds the leaf
                    // PTE; PBMT 01/10 → non-cacheable (only when PBMTE enables it).
                    tlb_unc[tlb_replace_idx]    = i_pbmte && (pte[62:61] == 2'b01 || pte[62:61] == 2'b10);
                    tlb_replace_idx             = tlb_replace_idx + 4'd1;
                    state                       = State::IDLE;
                }
                State::FAULT: {
                    // Wait 1 cycle before returning to IDLE.
                    // This allows the fetch PC to update (via NBA) after a trap
                    // redirect, preventing the PTW from restarting with the
                    // stale faulting PC on the next cycle.
                    state = State::FAULT2;
                }
                State::FAULT2: {
                    state = State::IDLE;
                }
                State::WRITE_AD: {
                    // P10 Svadu: hold here while the A/D-updated PTE is written
                    // back (o_ptw_wen + o_ptw_wdata below; ptw_addr_reg still
                    // holds the leaf PTE address). The wrapper's dcache accepts
                    // the write the cycle i_stall drops — the same handshake the
                    // PTE reads use via i_ptw_valid — after which the translation
                    // completes. pte already carries the updated A/D bits, so the
                    // DONE TLB fill records the freshly-set D in its write perm.
                    if !i_stall {
                        state = State::DONE;
                    }
                }
                // ===== Phase 11-H two-stage (V=1) walk =====
                // G-stage sub-walk: read G PTEs at host PAs (ptw_addr_reg). On a
                // leaf, build the host PA and either finish (g_after_fin → TS_DONE)
                // or hand the host address of a VS PTE to VS_RD. A G-stage fault
                // sets ts_gflt (guest-page-fault).
                State::GST_L2: {
                    if i_ptw_valid {
                        if !in_v {
                            ts_gflt = 1'b1;
                            state   = State::TS_FAULT;
                        } else if in_leaf {
                            if !g_perm_ok || in_ppn[17:0] != 18'd0 {
                                ts_gflt = 1'b1;
                                state   = State::TS_FAULT;
                            } else {
                                let g_hpa: logic<64> = {8'd0, in_ppn[43:18], g_in_gpa[29:0]};
                                if g_after_fin {
                                    ts_hpa = g_hpa;
                                    if ts_fill_ok {
                                        // G gigapage: effective level = min(VS, 2) = VS.
                                        let eff_lvl: logic<2> = vs_leaf_lvl;
                                        v1_valid[v1_repl]  = 1'b1;
                                        v1_vpn[v1_repl]    = ts_gva[38:12];
                                        v1_vmid[v1_repl]   = ts_vmid;
                                        v1_asid[v1_repl]   = ts_vs_asid;
                                        v1_global[v1_repl] = vs_leaf_g;
                                        v1_level[v1_repl]  = eff_lvl;
                                        v1_ppn[v1_repl]    = g_hpa[55:12];
                                        v1_r[v1_repl]      = vs_leaf_r && in_r;
                                        v1_w[v1_repl]      = (vs_leaf_w && vs_leaf_d) && (in_w && in_d);
                                        v1_x[v1_repl]      = vs_leaf_x && in_x;
                                        v1_u[v1_repl]      = vs_leaf_u;
                                        v1_repl            = v1_repl + 5'd1;
                                    }
                                    state  = State::TS_DONE;
                                } else {
                                    ptw_addr_reg = g_hpa;
                                    state        = State::VS_RD;
                                }
                            }
                        } else {
                            ptw_addr_reg = {8'd0, in_ppn, 12'd0} + {52'd0, g_vpn1, 3'd0};
                            state        = State::GST_L1;
                        }
                    }
                }
                State::GST_L1: {
                    if i_ptw_valid {
                        if !in_v {
                            ts_gflt = 1'b1;
                            state   = State::TS_FAULT;
                        } else if in_leaf {
                            if !g_perm_ok || in_ppn[8:0] != 9'd0 {
                                ts_gflt = 1'b1;
                                state   = State::TS_FAULT;
                            } else {
                                let g_hpa: logic<64> = {8'd0, in_ppn[43:9], g_in_gpa[20:0]};
                                if g_after_fin {
                                    ts_hpa = g_hpa;
                                    if ts_fill_ok {
                                        // G megapage: effective level = min(VS, 1).
                                        let eff_lvl: logic<2> = if vs_leaf_lvl == 2'd0 ? 2'd0 : 2'd1;
                                        v1_valid[v1_repl]  = 1'b1;
                                        v1_vpn[v1_repl]    = ts_gva[38:12];
                                        v1_vmid[v1_repl]   = ts_vmid;
                                        v1_asid[v1_repl]   = ts_vs_asid;
                                        v1_global[v1_repl] = vs_leaf_g;
                                        v1_level[v1_repl]  = eff_lvl;
                                        v1_ppn[v1_repl]    = g_hpa[55:12];
                                        v1_r[v1_repl]      = vs_leaf_r && in_r;
                                        v1_w[v1_repl]      = (vs_leaf_w && vs_leaf_d) && (in_w && in_d);
                                        v1_x[v1_repl]      = vs_leaf_x && in_x;
                                        v1_u[v1_repl]      = vs_leaf_u;
                                        v1_repl            = v1_repl + 5'd1;
                                    }
                                    state  = State::TS_DONE;
                                } else {
                                    ptw_addr_reg = g_hpa;
                                    state        = State::VS_RD;
                                }
                            }
                        } else {
                            ptw_addr_reg = {8'd0, in_ppn, 12'd0} + {52'd0, g_vpn0, 3'd0};
                            state        = State::GST_L0;
                        }
                    }
                }
                State::GST_L0: {
                    if i_ptw_valid {
                        if !in_v || !in_leaf || !g_perm_ok {
                            ts_gflt = 1'b1;
                            state   = State::TS_FAULT;
                        } else {
                            let g_hpa: logic<64> = {8'd0, in_ppn, g_in_gpa[11:0]};
                            if g_after_fin {
                                ts_hpa = g_hpa;
                                if ts_fill_ok {
                                    // G 4KB leaf: effective level = min(VS, 0) = 0.
                                    let eff_lvl: logic<2> = 2'd0;
                                    v1_valid[v1_repl]  = 1'b1;
                                    v1_vpn[v1_repl]    = ts_gva[38:12];
                                    v1_vmid[v1_repl]   = ts_vmid;
                                    v1_asid[v1_repl]   = ts_vs_asid;
                                    v1_global[v1_repl] = vs_leaf_g;
                                    v1_level[v1_repl]  = eff_lvl;
                                    v1_ppn[v1_repl]    = g_hpa[55:12];
                                    v1_r[v1_repl]      = vs_leaf_r && in_r;
                                    v1_w[v1_repl]      = (vs_leaf_w && vs_leaf_d) && (in_w && in_d);
                                    v1_x[v1_repl]      = vs_leaf_x && in_x;
                                    v1_u[v1_repl]      = vs_leaf_u;
                                    v1_repl            = v1_repl + 5'd1;
                                }
                                state  = State::TS_DONE;
                            } else {
                                ptw_addr_reg = g_hpa;
                                state        = State::VS_RD;
                            }
                        }
                    }
                }
                // VS-stage PTE read (at the host PA the G-stage produced). A leaf
                // gives the final guest PA, which is then G-translated (g_after_fin
                // =1). A non-leaf descends to the next VS level, whose PTE is again
                // a guest PA that the G-stage must translate. VS faults: ts_gflt=0.
                State::VS_RD: {
                    if i_ptw_valid {
                        if !in_v {
                            ts_gflt = 1'b0;
                            state   = State::TS_FAULT;
                        } else if in_leaf {
                            let vs_align_bad: logic = (vs_lvl == 2'd2 && in_ppn[17:0] != 18'd0)
                                || (vs_lvl == 2'd1 && in_ppn[8:0] != 9'd0);
                            if !vs_perm_ok || vs_align_bad {
                                ts_gflt = 1'b0;
                                state   = State::TS_FAULT;
                            } else {
                                let gpa_fin: logic<64> = if vs_lvl == 2'd2 ?
                                    {8'd0, in_ppn[43:18], ts_gva[29:0]}
                                : if vs_lvl == 2'd1 ?
                                    {8'd0, in_ppn[43:9], ts_gva[20:0]}
                                :
                                    {8'd0, in_ppn, ts_gva[11:0]}
                                ;
                                g_in_gpa    = gpa_fin;
                                g_after_fin = 1'b1;
                                // Capture VS leaf level/perms/global for the V=1
                                // TLB fill (combined with the G leaf at fill time).
                                vs_leaf_lvl = vs_lvl;
                                vs_leaf_r   = in_r;
                                vs_leaf_w   = in_w;
                                vs_leaf_x   = in_x;
                                vs_leaf_u   = in_u;
                                vs_leaf_d   = in_d;
                                vs_leaf_g   = i_ptw_data[5];
                                if g_on {
                                    ptw_addr_reg = {8'd0, hgatp_ppn, 12'd0} + {50'd0, gpa_fin[40:30], 3'd0};
                                    state        = State::GST_L2;
                                } else {
                                    ts_hpa = gpa_fin;
                                    state  = State::TS_DONE;
                                }
                            }
                        } else if vs_lvl == 2'd0 {
                            // Non-leaf at the lowest VS level is invalid.
                            ts_gflt = 1'b0;
                            state   = State::TS_FAULT;
                        } else {
                            let nidx    : logic<9>  = if vs_lvl == 2'd2 ? ts_vpn1 : ts_vpn0;
                            let next_gpa: logic<64> = {8'd0, in_ppn, 12'd0} + {52'd0, nidx, 3'd0};
                            g_in_gpa    = next_gpa;
                            vs_lvl      = vs_lvl - 2'd1;
                            g_after_fin = 1'b0;
                            if g_on {
                                ptw_addr_reg = {8'd0, hgatp_ppn, 12'd0} + {50'd0, next_gpa[40:30], 3'd0};
                                state        = State::GST_L2;
                            } else {
                                ptw_addr_reg = next_gpa;
                                state        = State::VS_RD;
                            }
                        }
                    }
                }
                State::TS_DONE: {
                    // Two-stage translation complete. Hold the result (o_paddr=
                    // ts_hpa, o_valid) while the core still requests this exact
                    // access; drop to IDLE once it deasserts i_req or moves to a
                    // new VA, so the next access re-walks. No TLB fill in V=1.
                    if !i_req || i_vaddr != ts_gva {
                        state = State::IDLE;
                    }
                }
                State::TS_FAULT: {
                    state = State::TS_FAULT2;
                }
                State::TS_FAULT2: {
                    state = State::IDLE;
                }
                default: {
                    state = State::IDLE;
                }
            }
        }
    }

    // Physical address from PTE
    assign pte_ppn = pte[53:10];

    always_comb {
        if !vm_enabled {
            // No translation: pass through
            pa = i_vaddr;
        } else {
            case leaf_level {
                // Gigapage (1GB, level 2): PA = leaf_PPN[43:18] || VA[29:0]
                2'd2   : pa = {8'b0, leaf_pte_ppn[43:18], i_vaddr[29:0]};
                // Megapage (2MB, level 1): PA = leaf_PPN[43:9] || VA[20:0]
                2'd1   : pa = {8'b0, leaf_pte_ppn[43:9], i_vaddr[20:0]};
                // 4KB page (level 0): PA = leaf_PPN || VA[11:0]
                default: pa = {8'b0, leaf_pte_ppn, page_off};
            }
        }
    }

    // PTW result permission check (same logic as TLB hit)
    let ptw_read_ok: logic = pte_r || (i_mxr && pte_x);
    let ptw_rwx_ok : logic = if i_cbo ? (pte_r || pte_w) : if i_fetch ? pte_x : if i_store ? pte_w : ptw_read_ok;
    let ptw_u_ok   : logic = if i_priv == PrivLevel::USER ? pte_u : (if pte_u ? (i_sum && !i_fetch) : 1'b1);
    let perm_ok    : logic = ptw_rwx_ok && ptw_u_ok;

    // M9.A.258: DONE state corresponds to walk_vpn_full's VA, not necessarily
    // the current i_vaddr. If a different load arrives at the moment the prior
    // load's walk reaches DONE (pipeline switched ops mid-DONE-cycle), pa is
    // computed using current i_vaddr but stale leaf_pte_ppn — producing a wrong
    // PA. Gate o_valid / o_fault on walk_va_match so the DONE result only
    // applies when current i_vaddr matches the walked VA. Mismatch holds busy
    // (via the !ptw_valid branch in o_busy), letting mmu return to IDLE and
    // re-walk for the new i_vaddr. Same root cause class as M9.A.255 IMMU
    // straddle bug (Bug A): both stem from o_paddr using stale leaf_pte_ppn
    // with mismatched i_vaddr.
    let walk_va_match: logic = walk_vpn_full == vpn_full;

    // Outputs: TLB hit takes priority over PTW result. Phase 11-H: a virtualized
    // access (vm_enabled=0 because !i_virt is false) returns the two-stage host
    // PA (ts_hpa, valid in TS_DONE) when any stage is on, else passes through.
    // Phase 11-H: a V=1 TLB hit (combined two-stage translation cached) serves
    // the host PA in IDLE with no walk, exactly like the V=0 tlb_hit fast path.
    let v1_hit_idle: logic = v1_hit && state == State::IDLE;
    assign o_paddr = if !vm_enabled ?
        (if v1_hit_idle ? v1_pa : if two_stage ? ts_hpa : i_vaddr)
    : if tlb_hit && state == State::IDLE ?
        tlb_pa
    :
        pa
    ;

    // P10 Svpbmt: NC/IO memory type for the current translation. Mirrors the
    // o_paddr TLB-hit/walk mux. pte_unc covers the just-walked leaf (DONE path).
    let pte_unc: logic = i_pbmte && (pte[62:61] == 2'b01 || pte[62:61] == 2'b10);
    // P10 Svpbmt fix: pte_unc reflects the `pte` REGISTER, which during a walk
    // (LEVEL2/1/0) still holds the PREVIOUS translation's leaf — a stale value.
    // The intermediate PTE reads themselves are ALWAYS cacheable (page-table
    // memory), so o_uncached must be 0 then; otherwise a walk that follows a
    // PBMT NC/IO translation marks its PTE reads uncached, and the D-cache's
    // single-beat uncached read of that (DRAM) PTE address returns i_mem_rdata
    // (shared-bus shadow / pre-load buf_q) instead of the cached PTE → a garbage
    // PTE → spurious page-fault storm (6.6 SMP boot). pte_unc is valid only at
    // DONE, where `pte` is the just-walked leaf and the access is the data
    // access; the tlb-hit path already supplies tlb_hit_unc for cached hits.
    assign o_uncached = if !vm_enabled ?
        1'b0
    : if tlb_hit && state == State::IDLE ?
        tlb_hit_unc
    : if state == State::DONE ?
        pte_unc
    :
        1'b0
    ;

    // CP commit-store pre-translate: side-effect-free STORE probe outputs. A clean
    // V=0 TLB hit usable as a store fast path is one in IDLE (no walk owns the
    // result) on a canonical VA with store (W&D) + U permission and a cacheable
    // page. tlb_pa is the same PA the commit-time store_drive translation would
    // produce for this VA. Anything else reports ok=0 and the core falls back to
    // commit translation.
    assign o_sprobe_pa = tlb_pa;
    assign o_sprobe_ok = vm_enabled && tlb_hit && state == State::IDLE
        && !va_noncanonical && tlb_store_perm_ok && !tlb_hit_unc;

    assign o_valid = if va_noncanonical ?
        1'b0
    : if !vm_enabled ?
        (if v1_hit_idle ? i_req : if two_stage ? (state == State::TS_DONE && i_vaddr == ts_gva) : i_req)
    : if tlb_hit && state == State::IDLE ?
        (i_req && tlb_perm_ok)
    :
        (state == State::DONE && perm_ok && walk_va_match)
    ;

    // M9.A.313: the FAULT-state fault, like the DONE-state result (M9.A.258),
    // corresponds to walk_vpn_full's VA — NOT necessarily the current i_vaddr.
    // dmem_mmu hardwires i_redirect=0, so a walk started for a (later squashed)
    // wrong-path access is NOT aborted; it runs to FAULT and, if the FAULT term
    // is ungated, fires o_fault while the OoO core's i_vaddr has already drifted
    // to a younger VALID access — delivering that walk's fault to the wrong VA
    // (spurious page fault, e.g. v4 Linux boot loops at VA 0x80616198 / a stack
    // VA 0x...ca3d??). Gate the FAULT term on walk_va_match too: when the
    // current i_vaddr no longer matches the walked VA, suppress the fault and
    // hold busy (mmu proceeds FAULT->FAULT2->IDLE and re-walks for the current
    // VA). v1 (in-order) holds i_vaddr stable through the walk stall, so
    // walk_va_match is always 1 at its faults — no behavior change for v1.
    // Phase 11-H: the two-stage TS_FAULT, like the single-stage FAULT (M9.A.313)
    // and the two-stage TS_DONE result (o_valid above), corresponds to the WALKED
    // guest VA (ts_gva) — NOT necessarily the current i_vaddr. dmem_mmu hardwires
    // i_redirect=0, so a walk started for a (later squashed) wrong-path / NULL
    // load is NOT aborted; it runs to TS_FAULT and, if ungated, fires o_fault
    // while the OoO core's i_vaddr has drifted to a younger VALID access —
    // delivering that orphan walk's fault to the wrong VA. Observed under the
    // H5.2b V=1 guest boot: garbage VS-stage walks (gva 0x0/0x60/...) deliver a
    // spurious load page fault (cause 13) onto a valid kernel STACK load
    // (init_thread_union `ld ra,56(sp)`), oopsing the guest into a die_lock
    // double-fault deadlock. Gate the TS_FAULT term on i_vaddr == ts_gva (the
    // exact analog of walk_va_match for the nested walk): a drifted current
    // i_vaddr suppresses the stale fault and holds busy (ts_busy keeps TS_FAULT/
    // TS_FAULT2 busy), so the mmu drains FAULT->IDLE and re-walks the current VA.
    let _fault_out: logic = if va_noncanonical ?
        // Non-canonical Sv39 VA: fault immediately on the request, bypassing
        // both the TLB-hit fast path and the walk (see va_noncanonical).
        i_req
    : if !vm_enabled ?
        (if two_stage ? (state == State::TS_FAULT && i_vaddr == ts_gva) : 1'b0)
    : if tlb_hit && state == State::IDLE ?
        (i_req && !tlb_perm_ok)
    :
        ((state == State::FAULT || (state == State::DONE && !perm_ok)) && walk_va_match)
    ;
    assign o_fault = _fault_out;
    // SvPMP: the walk failed because a PTE read was PMP-denied. Gate strictly on
    // the FAULT state (not the broader _fault_out, which also covers TLB-hit and
    // DONE leaf-permission PAGE faults) so a stale walk_acc_fault from a previous
    // walk can never re-route a later page fault as an access fault. The wrapper
    // treats this as an ACCESS fault and masks the page fault (o_fault && !acc).
    assign o_acc_fault = (state == State::FAULT) && walk_va_match && walk_acc_fault;
    // Phase 11-H: distinguish a G-stage (guest-physical) fault so the core can
    // raise a guest-page-fault (cause 20/21/23) rather than a VS-stage one.
    assign o_gstage_fault = state == State::TS_FAULT && ts_gflt;
    // Phase 11-H3c: the faulting guest PA (valid alongside o_gstage_fault).
    assign o_fault_gpa    = g_in_gpa;
    // Debug: trace MMU faults (limited)


    // TLB miss in IDLE: state transitions to LEVEL2 on the clock edge,
    // but combinationally o_busy must already be high to prevent the
    // pipeline from advancing PC during the 1-cycle IDLE→LEVEL2 gap.
    let tlb_miss_start: logic = state == State::IDLE && i_req && vm_enabled && !tlb_hit && !va_noncanonical;
    // Phase 11-H two-stage: the IDLE→walk gap + the walk states must hold busy
    // (mirrors the single-stage logic). TS_DONE/IDLE are NOT busy (the core
    // performs the data access then); TS_FAULT/TS_FAULT2 are busy like FAULT.
    let ts_miss_start: logic = state == State::IDLE && i_req && two_stage && !v1_hit;
    let ts_busy      : logic = two_stage && (ts_miss_start
        || state == State::GST_L2 || state == State::GST_L1 || state == State::GST_L0
        || state == State::VS_RD || state == State::TS_FAULT || state == State::TS_FAULT2);
    // FAULT and FAULT2 must be busy to prevent pipeline from
    // advancing during fault handling (otherwise sfence.vma in ID
    // fires and resets the TLB, causing an infinite fault loop).
    assign o_busy       = (vm_enabled && ((state != State::IDLE && state != State::DONE) || tlb_miss_start)) || ts_busy;
    assign o_walk_start = tlb_miss_start || ts_miss_start;
    // M9.3: IDLE = no walk physically owns the port (purely from the `state`
    // register; independent of i_vaddr/tlb_hit, so loop-free for the consumer).
    assign o_idle       = state == State::IDLE;
    assign o_ptw_addr   = ptw_addr_reg;
    assign o_ptw_req    = state == State::LEVEL2 || state == State::LEVEL1 || state == State::LEVEL0
        || state == State::GST_L2 || state == State::GST_L1 || state == State::GST_L0
        || state == State::VS_RD;
    // P10 Svadu: A/D write-back drive. pte holds the A/D-updated leaf PTE; the
    // address is o_ptw_addr (= ptw_addr_reg, still the leaf PTE address).
    assign o_ptw_wen    = state == State::WRITE_AD;
    assign o_ptw_wdata  = pte;

    // M9.A.303 debug
    assign o_dbg_pte      = pte;
    assign o_dbg_tlb_hit  = tlb_hit && state == State::IDLE;
    assign o_dbg_tlb_ppn  = tlb_hit_ppn;
    assign o_dbg_tlb_perm = {tlb_hit_r, tlb_hit_w, tlb_hit_x, tlb_hit_u};

}
