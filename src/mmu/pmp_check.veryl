// PMP (Physical Memory Protection, Smpmp) checker — combinational.
//
// Given a physical address, the access type, the effective privilege, and the
// 16 PMP entries (pmpcfg0/pmpcfg2 + pmpaddr0..15), decide whether the access is
// allowed. The matching entry is the LOWEST-numbered entry whose address range
// covers the access; its R/W/X bits then grant or deny. M-mode bypasses an
// UNLOCKED matching entry (L=0); a locked entry (L=1) is enforced even in
// M-mode. With at least one entry implemented, an access that matches NO entry
// is allowed only in M-mode (S/U-mode faults).
//
// Address fields are addr[55:2] (PHYS_ADDR_WIDTH=56, granularity G=0 so NA4 is
// supported). pmpcfg byte: [7]=L, [4:3]=A (0 OFF / 1 TOR / 2 NA4 / 3 NAPOT),
// [2]=X, [1]=W, [0]=R.
pub module pmp_check (
    i_addr  : input  logic<64>          , // physical address being accessed
    i_acc   : input  logic<2>           , // 0=read, 1=write, 2=execute
    i_priv  : input  csr_pkg::PrivLevel ,
    i_pmpcfg : input logic<64> [2] ,
    i_pmpaddr: input logic<64> [16],
    o_fault : output logic              , // 1 => PMP denies the access
) {
    import csr_pkg::*;

    let addr_word: logic<54> = i_addr[55:2];
    let is_m     : logic     = i_priv == PrivLevel::MACHINE;

    var matched : logic;
    var allow_w : logic;
    var any_cfg : logic; // any entry enabled (A != OFF)
    always_comb {
        matched = 1'b0;
        allow_w = 1'b0;
        any_cfg = 1'b0;
        for e in 0..16 {
            // Per-entry config byte (entry e -> pmpcfg[e/8] byte e%8).
            let cfg : logic<8>  = i_pmpcfg[e / 8][(e % 8) * 8+:8];
            let a   : logic<2>  = cfg[4:3];
            let l   : logic     = cfg[7];
            let this_a: logic<54> = i_pmpaddr[e][53:0];
            // TOR lower bound = previous entry's address (0 for entry 0).
            let lo  : logic<54> = if e == 0 ? 54'd0 : i_pmpaddr[(e + 15) % 16][53:0];
            // NAPOT range mask: trailing ones of this_a, plus the first zero.
            let nmask: logic<54> = this_a ^ (this_a + 54'd1);
            let matchE: logic =
                if a == 2'd1 ? ((addr_word >= lo) && (addr_word <: this_a))      // TOR
                : if a == 2'd2 ? (addr_word == this_a)                           // NA4
                : if a == 2'd3 ? ((addr_word & ~nmask) == (this_a & ~nmask))     // NAPOT
                : 1'b0;                                                          // OFF
            // Permission for this access type.
            let perm: logic = if i_acc == 2'd0 ? cfg[0] : if i_acc == 2'd1 ? cfg[1] : cfg[2];
            if a != 2'd0 {
                any_cfg = 1'b1;
            }
            if !matched && matchE {
                matched = 1'b1;
                // M-mode bypasses an unlocked match; otherwise check R/W/X.
                allow_w = (is_m && !l) || perm;
            }
        }
    }

    // Matched: enforce the entry's permission (M-mode bypasses an unlocked one).
    // No match with at least one entry enabled: M allowed, S/U denied. When NO
    // entry is enabled at all (any_cfg=0), PMP is inactive and every access
    // passes — firmware always configures PMP before entering S/U, so the
    // "implemented but wholly unconfigured" case is untestable from S/U-mode
    // (the first S/U instruction fetch would itself fault); this keeps a PMP-
    // unaware boot/firmware working without weakening any configured check.
    assign o_fault = if matched ? !allow_w : (!is_m && any_cfg);
}
