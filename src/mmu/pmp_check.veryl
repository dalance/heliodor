// PMP (Physical Memory Protection, Smpmp) check, combinational.
//
// The matching entry is the LOWEST-numbered entry whose address range covers
// the access; its R/W/X bits then grant or deny. M-mode bypasses an UNLOCKED
// matching entry (L=0); a locked entry (L=1) is enforced even in M-mode. An
// access that matches NO entry is allowed in M-mode and faults in S/U-mode,
// as the privileged spec requires whenever at least one entry is implemented
// (all 16 always are), even with every entry OFF. An entry that matches some
// but not all bytes of an access makes it fail when it is the lowest-numbered
// entry matching any of them, whatever the privilege.
//
// Address fields are addr[PALEN-1:2] (granularity G=0, so NA4 is supported). pmpcfg byte: [7]=L, [4:3]=A (0 OFF / 1 TOR / 2 NA4 / 3 NAPOT),
// [2]=X, [1]=W, [0]=R.
pub package pmp_pkg {
    const AW: u32 = pma_pkg::PALEN - 2;

    // One entry as the matchers read it. nmask and tor depend on the CSRs
    // only, so pmp_decode makes them once for every matcher.
    struct PmpEnt {
        cfg  : logic<8> ,
        addr : logic<AW>, // pmpaddr[AW-1:0]
        nmask: logic<AW>, // NAPOT: the trailing ones of addr plus the first zero
        tor  : logic    , // TOR: the previous entry's addr <: addr
    }

    // The match of one access: some entry matches (hit), the lowest matching
    // entry covers every byte (all), and that entry's config byte.
    struct PmpRes {
        hit: logic   ,
        all: logic   ,
        cfg: logic<8>,
    }

    // acc: 0 read, 1 write, 2 execute.
    function fault (
        r   : input PmpRes            ,
        acc : input logic<2>          ,
        priv: input csr_pkg::PrivLevel,
    ) -> logic {
        let is_m: logic = priv == csr_pkg::PrivLevel::MACHINE;
        let perm: logic = if acc == 2'd0 ? r.cfg[0] : if acc == 2'd1 ? r.cfg[1] : r.cfg[2];
        return if r.hit ? !(r.all && ((is_m && !r.cfg[7]) || perm)) : !is_m;
    }
}

// The entries of pmpcfg0/pmpcfg2 and pmpaddr0..15 for pmp_match.
pub module pmp_decode (
    i_pmpcfg : input  logic          <64> [2] ,
    i_pmpaddr: input  logic          <64> [16],
    o_ent    : output pmp_pkg::PmpEnt     [16],
) {
    always_comb {
        for e in 0..16 {
            let a             : logic<pmp_pkg::AW> = i_pmpaddr[e][pmp_pkg::AW - 1:0];
            let lo            : logic<pmp_pkg::AW> = if e == 0 ? '0 : i_pmpaddr[e - 1][pmp_pkg::AW - 1:0];
            o_ent[e].cfg   = i_pmpcfg[e / 8][(e % 8) * 8+:8];
            o_ent[e].addr  = a;
            o_ent[e].nmask = a ^ (a + 1);
            o_ent[e].tor   = lo <: a;
        }
    }
}

// The PMP match of N accesses in one naturally aligned 64-byte block: access
// n covers the words [i_lo4[n], i_hi4[n]] of block i_blk. The result does
// not depend on the access type or the privilege; pmp_pkg::fault applies
// them.
// Rationale:
//   - an address compare with an entry splits into the block part (addr[PALEN-1:6],
//     the same for every access) and the word offset, so the block compares
//     are made once per entry and shared by the N accesses, which leaves
//     4-bit compares per access
//   - for a NA4 or NAPOT region smaller than the block, a region strictly
//     between the two ends overlaps the access without matching either end
//   - the lowest match is mvec & -mvec, a log-depth subtract instead of a
//     16-deep priority chain
pub module pmp_match #(
    param N: u32 = 1,
) (
    i_blk: input  pma_pkg::Line          , // addr[PALEN-1:6] of every access
    i_lo4: input  logic          <4> [N] , // first word of access n
    i_hi4: input  logic          <4> [N] , // last word of access n
    i_ent: input  pmp_pkg::PmpEnt    [16],
    o_res: output pmp_pkg::PmpRes    [N] ,
) {
    // Block compares, per entry. The TOR lower bound of entry e is the
    // address of entry e - 1 (0 for entry 0).
    var b_lt: logic<16>; // i_blk <: the entry's block
    var b_eq: logic<16>; // i_blk == the entry's block
    var p_gt: logic<16>; // i_blk >: the lower bound's block
    var p_eq: logic<16>; // i_blk == the lower bound's block
    var n_eq: logic<16>; // i_blk lies in the NAPOT region above the word bits
    always_comb {
        for e in 0..16 {
            let a      : logic<pmp_pkg::AW> = i_ent[e].addr;
            let lo     : logic<pmp_pkg::AW> = if e == 0 ? '0 : i_ent[e - 1].addr;
            b_lt[e] = i_blk <: a[pmp_pkg::AW - 1:4];
            b_eq[e] = i_blk == a[pmp_pkg::AW - 1:4];
            p_gt[e] = i_blk >: lo[pmp_pkg::AW - 1:4];
            p_eq[e] = i_blk == lo[pmp_pkg::AW - 1:4];
            n_eq[e] = ((i_blk ^ a[pmp_pkg::AW - 1:4]) & ~i_ent[e].nmask[pmp_pkg::AW - 1:4]) == '0;
        }
    }

    for n in 0..N :g_acc {
        let lo4 : logic<4>  = i_lo4[n];
        let hi4 : logic<4>  = i_hi4[n];
        var mvec: logic<16>; // the entry matches some byte
        var avec: logic<16>; // the entry matches every byte
        always_comb {
            for e in 0..16 {
                let ta     : logic<4> = i_ent[e].addr[3:0];
                let nm     : logic<4> = i_ent[e].nmask[3:0];
                let pa     : logic<4> = if e == 0 ? 4'd0 : i_ent[e - 1].addr[3:0];
                let lo_lt_a: logic    = b_lt[e] || (b_eq[e] && lo4 <: ta);
                let hi_lt_a: logic    = b_lt[e] || (b_eq[e] && hi4 <: ta);
                let lo_ge_p: logic    = p_gt[e] || (p_eq[e] && lo4 >= pa);
                let hi_ge_p: logic    = p_gt[e] || (p_eq[e] && hi4 >= pa);
                let n_lo   : logic    = n_eq[e] && ((lo4 ^ ta) & ~nm) == 4'd0;
                let n_hi   : logic    = n_eq[e] && ((hi4 ^ ta) & ~nm) == 4'd0;
                let n_in   : logic    = b_eq[e] && lo4 <: (ta & ~nm) && hi4 >: (ta | nm);
                mvec[e] = case i_ent[e].cfg[4:3] {
                    2'd1   : lo_lt_a && hi_ge_p && i_ent[e].tor,
                    2'd2   : b_eq[e] && lo4 <= ta && ta <= hi4,
                    2'd3   : n_lo || n_hi || n_in,
                    default: 1'b0,
                };
                avec[e] = case i_ent[e].cfg[4:3] {
                    2'd1   : lo_ge_p && hi_lt_a,
                    2'd2   : b_eq[e] && lo4 == ta && hi4 == ta,
                    default: n_lo && n_hi,
                };
            }
        }
        let low: logic<16> = mvec & (16'd0 - mvec);
        always_comb {
            o_res[n].hit = |mvec;
            o_res[n].all = |(low & avec);
            o_res[n].cfg = 8'd0;
            for e in 0..16 {
                if low[e] {
                    o_res[n].cfg = i_ent[e].cfg;
                }
            }
        }
    }
}

// The bytes [i_lo, i_hi] of one access, both in the same naturally aligned
// 64-byte block, from the raw CSRs (the old core's form).
pub module pmp_range_check (
    i_lo     : input  logic<64>         , // first byte of the access
    i_hi     : input  logic<64>         , // last byte, same 64-byte block
    i_acc    : input  logic<2>          , // 0=read, 1=write, 2=execute
    i_priv   : input  csr_pkg::PrivLevel,
    i_pmpcfg : input  logic<64>     [2] ,
    i_pmpaddr: input  logic<64>     [16],
    o_fault  : output logic             , // 1 => PMP denies the access
) {
    var ent: pmp_pkg::PmpEnt [16];
    var res: pmp_pkg::PmpRes [1] ;
    inst u_dec: pmp_decode (
        i_pmpcfg        ,
        i_pmpaddr       ,
        o_ent    : ent  ,
    );
    inst u_match: pmp_match #(
        N: 1,
    ) (
        i_blk: i_lo[pma_pkg::PALEN - 1:6],
        i_lo4: '{i_lo[5:2]},
        i_hi4: '{i_hi[5:2]},
        i_ent: ent                       ,
        o_res: res                       ,
    );
    assign o_fault = pmp_pkg::fault(res[0], i_acc, i_priv);
}

// The 4-byte granule holding i_addr (the old core's form).
pub module pmp_check (
    i_addr   : input  logic<64>         , // physical address being accessed
    i_acc    : input  logic<2>          , // 0=read, 1=write, 2=execute
    i_priv   : input  csr_pkg::PrivLevel,
    i_pmpcfg : input  logic<64>     [2] ,
    i_pmpaddr: input  logic<64>     [16],
    o_fault  : output logic             , // 1 => PMP denies the access
) {
    inst u_range: pmp_range_check (
        i_lo   : i_addr,
        i_hi   : i_addr,
        i_acc          ,
        i_priv         ,
        i_pmpcfg       ,
        i_pmpaddr      ,
        o_fault        ,
    );
}
