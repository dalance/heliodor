// Instruction memory MMU
// Sits between the fetch stage and the icache.
// In Bare mode (satp.MODE=0 or M-mode): pure passthrough.
// In Sv39 mode: translates virtual PC to physical address using TLB.
// TLB miss triggers a page table walk via a dedicated PTW memory port
// (routed to the data memory interface by the top module).
pub module imem_mmu #(
    // PMA hole access-fault enable (fetch outside DRAM/CLINT/UART/PLIC faults).
    param PMA_FAULT: bit = 1,
) (
    clk: input clock,
    rst: input reset,
    // CPU side (virtual address from fetch)
    i_vaddr: input logic<64>,
    i_req  : input logic    ,
    // Translation result
    o_paddr: output logic<64>,
    o_valid: output logic    ,
    o_fault: output logic    ,
    // PMP (Smpmp) instruction access fault (cause 1), distinct from o_fault.
    o_acc_fault: output logic,
    o_busy : output logic    ,
    // SATP/privilege
    i_satp: input logic             <64>,
    i_priv: input csr_pkg::PrivLevel    ,
    i_sum : input logic                 ,
    i_mxr : input logic                 ,
    i_pbmte: input logic                , // P10 Svpbmt: menvcfg.PBMTE (reserved-PBMT fault on fetch)
    i_adue : input logic                , // P10 Svadu: menvcfg.ADUE (relax A=0 fault on fetch)
    // PMP (Smpmp): config + addresses for the instruction-fetch protection check.
    i_pmpcfg : input logic<64> [2] ,
    i_pmpaddr: input logic<64> [16],
    // Phase 11-H two-stage translation (V=1, VS/VU instruction fetch).
    i_virt : input logic     ,
    i_vsatp: input logic <64>,
    i_hgatp: input logic <64>,
    o_gstage_fault: output logic, // fault was in the G-stage walk
    o_fault_gpa   : output logic<64>, // Phase 11-H3c: faulting guest PA (for htval)
    // PTW memory interface (64-bit, routed to dmem by top)
    o_ptw_addr : output logic<64>,
    o_ptw_req  : output logic    ,
    i_ptw_data : input  logic<64>,
    i_ptw_valid: input  logic    ,
    // P10 Svadu: instruction-side A-bit write-back. When menvcfg.ADUE relaxes an
    // A=0 fetch fault, the MMU also writes the updated PTE (A=1) back. The i-side
    // has no memory write channel of its own, so the core routes this single-dword
    // write through the d-cache store-drain port (coherent merge). o_ptw_wen pulses
    // in the WRITE_AD state with o_ptw_wdata = the A-updated leaf PTE (addr =
    // o_ptw_addr); i_ptw_write_done acks acceptance so the walk can complete.
    o_ptw_wen  : output logic    ,
    o_ptw_wdata: output logic<64>,
    i_ptw_write_done: input logic,
    // Downstream stall (icache filling)
    i_icache_stall: input logic,
    // TLB flush (SFENCE.VMA). P9.5: selective-flush operands — rs1 VA / rs2
    // ASID and their x0 (wildcard) flags.
    i_sfence: input logic,
    i_sfence_vaddr   : input logic<64>,
    i_sfence_asid    : input logic<16>,
    i_sfence_rs1_zero: input logic    ,
    i_sfence_rs2_zero: input logic    ,
    // Pipeline redirect: cancel in-flight PTW (branch misprediction, trap, etc.)
    i_redirect: input logic,
) {
    import csr_pkg::*;

    // Phase 11-H: enable for the single-stage V=0 Sv39 path OR a virtualized
    // (V=1) fetch with either stage active. V=0 byte-identical (single_vm == the
    // old vm_enabled when i_virt=0; two_stage=0).
    let satp_mode : logic<4> = i_satp[63:60];
    let vsatp_mode: logic<4> = i_vsatp[63:60];
    let hgatp_mode: logic<4> = i_hgatp[63:60];
    let single_vm : logic    = !i_virt && satp_mode == SATP_MODE_SV39 && i_priv != PrivLevel::MACHINE;
    let two_stage : logic    = i_virt && i_priv != PrivLevel::MACHINE
        && (vsatp_mode == SATP_MODE_SV39 || hgatp_mode == 4'd8);
    let vm_enabled: logic    = single_vm || two_stage;

    // MMU submodule (TLB + PTW)
    var mmu_paddr: logic<64>;
    var mmu_valid: logic    ;
    var mmu_fault: logic    ;
    var mmu_acc_fault: logic; // SvPMP: walk faulted on a PMP-denied PTE read
    var mmu_busy : logic    ;
    var ptw_wen  : logic    ; // P10 Svadu: A-bit write-back active (WRITE_AD state)
    var ptw_wdata: logic<64>; // P10 Svadu: A-updated leaf PTE to write back

    // P10 Svadu: WRITE_AD=1 — the i-side now performs hardware A-bit write-back
    // for an instruction fetch of an A=0 page under menvcfg.ADUE. The mmu's PTE
    // reads still come over the read-only coherent stream; the write-back is routed
    // by the core through the d-cache store-drain port. The WRITE_AD state is held
    // (i_stall below) until i_ptw_write_done acks the store-drain accepted it.
    inst u_mmu: mmu #(
        WRITE_AD : 1        ,
        PMA_FAULT: PMA_FAULT,
    ) (
        clk                                ,
        rst                                ,
        i_vaddr                            ,
        i_req         : i_req && vm_enabled,
        i_store       : 1'b0               , // instruction fetch is never a store
        i_fetch       : 1'b1               , // always an instruction fetch
        i_cbo         : 1'b0               , // i-side is never a cbo
        o_paddr       : mmu_paddr          ,
        o_valid       : mmu_valid          ,
        o_fault       : mmu_fault          ,
        o_acc_fault   : mmu_acc_fault      ,
        o_busy        : mmu_busy           ,
        o_walk_start  : _                  , // M9.A.296: not needed for fetch
        o_idle        : _                  , // M9.3: dmem-only VA-pin gate
        i_satp                             ,
        i_priv                             ,
        i_pmpcfg                           ,
        i_pmpaddr                          ,
        i_sum                              ,
        i_mxr                              ,
        i_pbmte                            ,
        i_adue                             ,
        i_virt                             ,
        i_vsatp                            ,
        i_hgatp                            ,
        i_hlvx        : 1'b0               , // HLVX is a data access; never a fetch
        o_gstage_fault                     ,
        o_fault_gpa                        ,
        o_uncached    : _                  , // i-side does not route uncached fetch
        o_ptw_addr                         ,
        o_ptw_req                          ,
        o_ptw_wen     : ptw_wen            , // P10 Svadu: A-bit write-back request
        o_ptw_wdata   : ptw_wdata          ,
        i_ptw_data                         ,
        i_ptw_valid                        ,
        // Hold the WRITE_AD state until the core's store-drain accepts the A-bit
        // write (i_ptw_write_done); during PTE reads it is just the icache stall.
        i_stall       : i_icache_stall || (ptw_wen && !i_ptw_write_done),
        i_sfence                           ,
        i_sfence_vaddr                     ,
        i_sfence_asid                      ,
        i_sfence_rs1_zero                  ,
        i_sfence_rs2_zero                  ,
        i_redirect                         ,
        o_dbg_pte     : _                  , // M9.A.303: dmem-only debug
        o_dbg_tlb_hit : _                  ,
        o_dbg_tlb_ppn : _                  ,
        o_dbg_tlb_perm: _                  ,
    );

    // Outputs
    // SvPMP: a PMP-denied PTE read makes the walk an ACCESS fault (cause 1), not a
    // page fault — mask the page fault and route it through o_acc_fault below.
    let pte_acc_fault: logic = vm_enabled && mmu_acc_fault;
    // IMEM_MMU_STAGE (F1, § scaffold below): renamed to *_raw = the live
    // combinational translation result; the ports are redefined as *_eff below.
    let o_paddr_raw: logic<64> = if vm_enabled ? mmu_paddr : i_vaddr;
    let o_valid_raw: logic     = if vm_enabled ? mmu_valid : i_req;
    let o_fault_raw: logic     = vm_enabled && mmu_fault && !pte_acc_fault;
    // SvPMP: when the walk faults on a PMP-denied PTE the MMU is still in its
    // FAULT state (mmu_busy=1), but the access fault must be delivered with
    // o_busy low — mirroring the final-PA fetch access fault (mmu_valid, busy=0)
    // that the core already handles. Drop busy for this case only; the page-fault
    // path (pte_acc_fault=0) keeps its existing busy-during-FAULT behaviour.
    assign o_busy  = vm_enabled && mmu_busy && !pte_acc_fault;

    // PMP check on the final fetch physical address (execute permission). A page
    // fault wins, so the access fault only fires once a PA is produced.
    let fetch_pa: logic<64> = if vm_enabled ? mmu_paddr : i_vaddr;
    let pmp_active: logic   = i_req && (if vm_enabled ? (mmu_valid && !mmu_fault) : 1'b1);
    var pmp_deny  : logic;
    inst u_pmp: pmp_check (
        i_addr   : fetch_pa,
        i_acc    : 2'd2    , // execute (X)
        i_priv             ,
        i_pmpcfg           ,
        i_pmpaddr          ,
        o_fault  : pmp_deny,
    );
    // PMA: a fetch whose final PA has no backing executable memory (a hole) takes
    // an instruction access fault (cause 1), same as a PMP-X denial. Map: DRAM
    // pa[31], CLINT 0x02xx_xxxx, UART 0x1xxx_xxxx, PLIC 0x0Cxx_xxxx (only DRAM is
    // really executable, but the SoC decode defines these as the backed regions;
    // a fetch outside them faults). (ACT4 cfg_A_tor_zero: jalr to PA 0.)
    let pma_hole: logic = PMA_FAULT && !(fetch_pa[31] || fetch_pa[31:24] == 8'h02 || fetch_pa[31:28] == 4'h1 || fetch_pa[31:24] == 8'h0c);
    let o_acc_fault_raw: logic = (pmp_active && (pmp_deny || pma_hole)) || pte_acc_fault;

    // ── Phase D step B: IMEM_MMU_STAGE DEAD scaffold (F1 — imem translate reg) ──
    // Register the fetch TRANSLATION RESULT (o_paddr / o_valid / o_fault /
    // o_acc_fault) so the icache is addressed by a flop instead of the ~5.36 ns
    // combinational V=1 two-stage TLB cone (u_mmu.v1_vpn→v1_level→v1_valid→v1_u→
    // i_sum→v1_match→v1_hit→mmu_paddr→o_paddr — the fetch-half floor, 76% of the
    // ~7 ns fetch half; cp_frontend_pipeline_plan.md §6). Pattern = ICACHE_SYNC_
    // READ / DCACHE_SYNC_READ (8344d0a / d93c2e3): DEAD at 0 — each port is
    // `? *_q : *_raw` == *_raw (byte-identical) and every *_q is reset-only (the
    // `if IMEM_MMU_STAGE` write-fold) → DCE'd, synth-CP-neutral. At 1 the result
    // is a cycle late (a pure pipeline reg — the TLB is flops, not SRAM); the
    // fetch FSM +1-bubble / redirect-restart / o_busy-vs-registered-valid skew /
    // V=1 htval (o_gstage_fault/o_fault_gpa stay live) is the functional
    // bundle-flip work, so =1 is FF-insertion measurement only, not functional.
    // Only the 4 result outputs are registered; the walk handshake (o_busy, the
    // PTW port, A-bit write-back) and htval side-info stay LIVE. None of the 4
    // has an internal reader (PMP/PMA use the separate `fetch_pa` recompute).
    const IMEM_MMU_STAGE: bit = 0;
    var o_paddr_q    : logic<64>;
    var o_valid_q    : logic    ;
    var o_fault_q    : logic    ;
    var o_acc_fault_q: logic    ;
    always_ff (clk, rst) {
        if_reset {
            o_paddr_q     = 64'd0;
            o_valid_q     = 1'b0;
            o_fault_q     = 1'b0;
            o_acc_fault_q = 1'b0;
        } else if IMEM_MMU_STAGE {
            o_paddr_q     = o_paddr_raw;
            o_valid_q     = o_valid_raw;
            o_fault_q     = o_fault_raw;
            o_acc_fault_q = o_acc_fault_raw;
        }
    }
    assign o_paddr     = if IMEM_MMU_STAGE ? o_paddr_q     : o_paddr_raw;
    assign o_valid     = if IMEM_MMU_STAGE ? o_valid_q     : o_valid_raw;
    assign o_fault     = if IMEM_MMU_STAGE ? o_fault_q     : o_fault_raw;
    assign o_acc_fault = if IMEM_MMU_STAGE ? o_acc_fault_q : o_acc_fault_raw;

    // P10 Svadu: A-bit write-back request to the core (store-drain port).
    assign o_ptw_wen   = vm_enabled && ptw_wen;
    assign o_ptw_wdata = ptw_wdata;
}
