// Instruction memory MMU
// Sits between the fetch stage and the icache.
// In Bare mode (satp.MODE=0 or M-mode): pure passthrough.
// In Sv39 mode: translates virtual PC to physical address using TLB.
// TLB miss triggers a page table walk via a dedicated PTW memory port
// (routed to the data memory interface by the top module).
pub module imem_mmu (
    clk: input clock,
    rst: input reset,
    // CPU side (virtual address from fetch)
    i_vaddr: input logic<64>,
    i_req  : input logic    ,
    // Translation result
    o_paddr: output logic<64>,
    o_valid: output logic    ,
    o_fault: output logic    ,
    o_busy : output logic    ,
    // SATP/privilege
    i_satp: input logic             <64>,
    i_priv: input csr_pkg::PrivLevel    ,
    i_sum : input logic                 ,
    i_mxr : input logic                 ,
    i_pbmte: input logic                , // P10 Svpbmt: menvcfg.PBMTE (reserved-PBMT fault on fetch)
    i_adue : input logic                , // P10 Svadu: menvcfg.ADUE (relax A=0 fault on fetch)
    // Phase 11-H two-stage translation (V=1, VS/VU instruction fetch).
    i_virt : input logic     ,
    i_vsatp: input logic <64>,
    i_hgatp: input logic <64>,
    o_gstage_fault: output logic, // fault was in the G-stage walk
    o_fault_gpa   : output logic<64>, // Phase 11-H3c: faulting guest PA (for htval)
    // PTW memory interface (64-bit, routed to dmem by top)
    o_ptw_addr : output logic<64>,
    o_ptw_req  : output logic    ,
    i_ptw_data : input  logic<64>,
    i_ptw_valid: input  logic    ,
    // P10 Svadu: instruction-side A-bit write-back. When menvcfg.ADUE relaxes an
    // A=0 fetch fault, the MMU also writes the updated PTE (A=1) back. The i-side
    // has no memory write channel of its own, so the core routes this single-dword
    // write through the d-cache store-drain port (coherent merge). o_ptw_wen pulses
    // in the WRITE_AD state with o_ptw_wdata = the A-updated leaf PTE (addr =
    // o_ptw_addr); i_ptw_write_done acks acceptance so the walk can complete.
    o_ptw_wen  : output logic    ,
    o_ptw_wdata: output logic<64>,
    i_ptw_write_done: input logic,
    // Downstream stall (icache filling)
    i_icache_stall: input logic,
    // TLB flush (SFENCE.VMA). P9.5: selective-flush operands — rs1 VA / rs2
    // ASID and their x0 (wildcard) flags.
    i_sfence: input logic,
    i_sfence_vaddr   : input logic<64>,
    i_sfence_asid    : input logic<16>,
    i_sfence_rs1_zero: input logic    ,
    i_sfence_rs2_zero: input logic    ,
    // Pipeline redirect: cancel in-flight PTW (branch misprediction, trap, etc.)
    i_redirect: input logic,
) {
    import csr_pkg::*;

    // Phase 11-H: enable for the single-stage V=0 Sv39 path OR a virtualized
    // (V=1) fetch with either stage active. V=0 byte-identical (single_vm == the
    // old vm_enabled when i_virt=0; two_stage=0).
    let satp_mode : logic<4> = i_satp[63:60];
    let vsatp_mode: logic<4> = i_vsatp[63:60];
    let hgatp_mode: logic<4> = i_hgatp[63:60];
    let single_vm : logic    = !i_virt && satp_mode == SATP_MODE_SV39 && i_priv != PrivLevel::MACHINE;
    let two_stage : logic    = i_virt && i_priv != PrivLevel::MACHINE
        && (vsatp_mode == SATP_MODE_SV39 || hgatp_mode == 4'd8);
    let vm_enabled: logic    = single_vm || two_stage;

    // MMU submodule (TLB + PTW)
    var mmu_paddr: logic<64>;
    var mmu_valid: logic    ;
    var mmu_fault: logic    ;
    var mmu_busy : logic    ;
    var ptw_wen  : logic    ; // P10 Svadu: A-bit write-back active (WRITE_AD state)
    var ptw_wdata: logic<64>; // P10 Svadu: A-updated leaf PTE to write back

    // P10 Svadu: WRITE_AD=1 — the i-side now performs hardware A-bit write-back
    // for an instruction fetch of an A=0 page under menvcfg.ADUE. The mmu's PTE
    // reads still come over the read-only coherent stream; the write-back is routed
    // by the core through the d-cache store-drain port. The WRITE_AD state is held
    // (i_stall below) until i_ptw_write_done acks the store-drain accepted it.
    inst u_mmu: mmu #(
        WRITE_AD: 1,
    ) (
        clk                                ,
        rst                                ,
        i_vaddr                            ,
        i_req         : i_req && vm_enabled,
        i_store       : 1'b0               , // instruction fetch is never a store
        i_fetch       : 1'b1               , // always an instruction fetch
        o_paddr       : mmu_paddr          ,
        o_valid       : mmu_valid          ,
        o_fault       : mmu_fault          ,
        o_busy        : mmu_busy           ,
        o_walk_start  : _                  , // M9.A.296: not needed for fetch
        o_idle        : _                  , // M9.3: dmem-only VA-pin gate
        i_satp                             ,
        i_priv                             ,
        i_sum                              ,
        i_mxr                              ,
        i_pbmte                            ,
        i_adue                             ,
        i_virt                             ,
        i_vsatp                            ,
        i_hgatp                            ,
        i_hlvx        : 1'b0               , // HLVX is a data access; never a fetch
        o_gstage_fault                     ,
        o_fault_gpa                        ,
        o_uncached    : _                  , // i-side does not route uncached fetch
        o_ptw_addr                         ,
        o_ptw_req                          ,
        o_ptw_wen     : ptw_wen            , // P10 Svadu: A-bit write-back request
        o_ptw_wdata   : ptw_wdata          ,
        i_ptw_data                         ,
        i_ptw_valid                        ,
        // Hold the WRITE_AD state until the core's store-drain accepts the A-bit
        // write (i_ptw_write_done); during PTE reads it is just the icache stall.
        i_stall       : i_icache_stall || (ptw_wen && !i_ptw_write_done),
        i_sfence                           ,
        i_sfence_vaddr                     ,
        i_sfence_asid                      ,
        i_sfence_rs1_zero                  ,
        i_sfence_rs2_zero                  ,
        i_redirect                         ,
        o_dbg_pte     : _                  , // M9.A.303: dmem-only debug
        o_dbg_tlb_hit : _                  ,
        o_dbg_tlb_ppn : _                  ,
        o_dbg_tlb_perm: _                  ,
    );

    // Outputs
    assign o_paddr = if vm_enabled ? mmu_paddr : i_vaddr;
    assign o_valid = if vm_enabled ? mmu_valid : i_req;
    assign o_fault = vm_enabled && mmu_fault;
    assign o_busy  = vm_enabled && mmu_busy;
    // P10 Svadu: A-bit write-back request to the core (store-drain port).
    assign o_ptw_wen   = vm_enabled && ptw_wen;
    assign o_ptw_wdata = ptw_wdata;
}
