// Data memory MMU
// Sits between the memory stage and external data memory interface.
// In Bare mode (satp.MODE=0 or M-mode): pure passthrough.
// In Sv39 mode: performs 3-level page table walk via the mmu submodule,
// then issues the actual load/store using the translated physical address.
pub module dmem_mmu #(
    // PMA hole access-fault enable (DRAM/CLINT/UART/PLIC are backed; all else
    // faults). Default on; can be disabled per-instantiation if a SoC map differs.
    param PMA_FAULT: bit = 1,
) (
    clk          : input  clock                 ,
    rst          : input  reset                 ,
    i_vaddr      : input  logic             <64>,
    i_wdata      : input  logic             <64>,
    i_wen        : input  logic                 ,
    i_ren        : input  logic                 ,
    i_wstrb      : input  logic             <8> ,
    o_rdata      : output logic             <64>,
    o_dmem_addr  : output logic             <64>,
    o_dmem_wdata : output logic             <64>,
    i_dmem_rdata : input  logic             <64>,
    o_dmem_wen   : output logic                 ,
    o_dmem_ren   : output logic                 ,
    o_dmem_wstrb : output logic             <8> ,
    i_satp       : input  logic             <64>,
    i_priv       : input  csr_pkg::PrivLevel    ,
    i_sum        : input  logic                 ,
    i_mxr        : input  logic                 ,
    i_pbmte      : input  logic                 , // P10 Svpbmt: menvcfg.PBMTE
    i_adue       : input  logic                 , // P10 Svadu: menvcfg.ADUE (HW A/D update)
    // PMP (Smpmp): config + addresses, for the physical-address protection check.
    i_pmpcfg     : input  logic             <64> [2] ,
    i_pmpaddr    : input  logic             <64> [16],
    // PMP: the current data access is an AMO (read-modify-write). An AMO needs
    // BOTH read and write permission, so its PMP check must also test W (the RMW
    // read presents i_wen=0, which would otherwise only check R).
    i_is_amo     : input  logic             ,
    // Phase 11-H two-stage translation (V=1, VS/VU data accesses).
    i_virt       : input  logic             ,
    i_vsatp      : input  logic         <64>,
    i_hgatp      : input  logic         <64>,
    i_hlvx       : input  logic             , // Phase 11-H HLVX: final access checks X

    o_gstage_fault: output logic            , // fault was in the G-stage walk
    o_fault_gpa  : output logic         <64>, // Phase 11-H3c: faulting guest PA (for htval)
    o_busy       : output logic                 ,
    o_fault      : output logic                 ,
    o_fault_store: output logic                 ,
    // PMP (Smpmp) access fault on the data access (cause 5 load / 7 store),
    // distinct from the page fault o_fault. Mutually exclusive with o_fault.
    o_acc_fault      : output logic             ,
    o_acc_fault_store: output logic             ,
    // SvPMP: the access fault came from a PMP-denied PTE READ on the walk (not the
    // leaf-PA permission). The core keeps this for a cbo.clean/flush/inval (whose
    // leaf rule is R-or-W, but a PTE-read PMP fault always applies) — see
    // cbo_m_acc_fault. Already folded into o_acc_fault{,_store}; this just isolates it.
    o_pte_acc_fault  : output logic             ,
    o_uncached   : output logic                 , // P10 Svpbmt: NC/IO translation
    // P10 Svadu: the MMU is writing an A/D-updated PTE back this cycle. The core
    // forces the dcache write (i_wen) for it, bypassing the committing-store
    // gates (sb_vm_ok / AMO / MMIO) since this write is the walk's, not a store's.
    o_ad_writeback: output logic,
    o_rdata_valid: output logic                 ,
    // M9.A.296: PTW-start pulse (passthrough from mmu). For OoO fault
    // attribution. v1 (in-order) leaves this unconnected.
    o_walk_start: output logic,
    // M9.3: MMU FSM is in IDLE (no walk owns the port). Passthrough from mmu;
    // used by the OoO core to gate the load-walk VA pin on a REAL in-flight
    // walk. Loop-free (mmu derives it from its `state` register only).
    o_idle: output logic,
    // D-cache stall: PTW data is not valid while dcache is filling
    i_dcache_stall: input logic,
    // TLB flush (SFENCE.VMA). P9.5: selective-flush operands.
    i_sfence: input logic,
    i_sfence_vaddr   : input logic<64>,
    i_sfence_asid    : input logic<16>,
    i_sfence_rs1_zero: input logic    ,
    i_sfence_rs2_zero: input logic    ,
    // M9.A.303 debug: surface faulting-PTE + TLB-hit context + the dmem PTW
    // address/req so the tb can characterize the v4 load-fault loop.
    o_dbg_ptw_req : output logic    ,
    o_dbg_ptw_addr: output logic<64>,
    o_dbg_pte     : output logic<64>,
    o_dbg_tlb_hit : output logic    ,
    o_dbg_tlb_ppn : output logic<44>,
    o_dbg_tlb_perm: output logic<4> ,
) {
    import csr_pkg::*;

    // SATP decode. Phase 11-H: vm_enabled is true for the single-stage V=0 Sv39
    // path OR a virtualized (V=1) access with either stage active. V=0 is
    // byte-identical (single_vm == the old vm_enabled when i_virt=0; two_stage=0).
    let satp_mode : logic<4> = i_satp[63:60];
    let vsatp_mode: logic<4> = i_vsatp[63:60];
    let hgatp_mode: logic<4> = i_hgatp[63:60];
    let single_vm : logic    = !i_virt && satp_mode == SATP_MODE_SV39 && i_priv != PrivLevel::MACHINE;
    let two_stage : logic    = i_virt && i_priv != PrivLevel::MACHINE
        && (vsatp_mode == SATP_MODE_SV39 || hgatp_mode == 4'd8);
    let vm_enabled: logic    = single_vm || two_stage;
    let mem_req   : logic    = i_wen || i_ren;

    // PTW submodule
    var ptw_paddr: logic<64>;
    var ptw_valid: logic    ;
    var ptw_fault: logic    ;
    var ptw_acc_fault: logic; // SvPMP: walk faulted on a PMP-denied PTE read
    var ptw_busy : logic    ;
    var ptw_addr : logic<64>;
    var ptw_req  : logic    ;
    var ptw_wen  : logic    ; // P10 Svadu: A/D write-back active
    var ptw_wdata: logic<64>; // P10 Svadu: A/D-updated PTE to write back

    inst u_mmu: mmu (
        clk                       ,
        rst                       ,
        i_vaddr                   ,
        i_req       : mem_req     ,
        i_store     : i_wen       ,
        i_fetch     : 1'b0        ,
        o_paddr     : ptw_paddr   ,
        o_valid     : ptw_valid   ,
        o_fault     : ptw_fault   ,
        o_acc_fault : ptw_acc_fault,
        o_busy      : ptw_busy    ,
        o_walk_start: o_walk_start,
        o_idle      : o_idle      ,
        i_satp                    ,
        i_priv                    ,
        i_pmpcfg                  ,
        i_pmpaddr                 ,
        i_sum                     ,
        i_mxr                     ,
        i_pbmte                   ,
        i_adue                    ,
        i_virt                    ,
        i_vsatp                   ,
        i_hgatp                   ,
        i_hlvx                    ,
        o_gstage_fault            ,
        o_fault_gpa               ,
        o_uncached                ,
        o_ptw_addr  : ptw_addr    ,
        o_ptw_req   : ptw_req     ,
        o_ptw_wen   : ptw_wen     ,
        o_ptw_wdata : ptw_wdata   ,
        i_ptw_data  : i_dmem_rdata,
        // PTW data is valid only when dcache is not stalling
        i_ptw_valid: ptw_req && !i_dcache_stall,
        // Hold DONE state while dcache is stalling on translated PA
        i_stall       : i_dcache_stall,
        i_sfence                      ,
        i_sfence_vaddr                ,
        i_sfence_asid                 ,
        i_sfence_rs1_zero             ,
        i_sfence_rs2_zero             ,
        i_redirect    : 1'b0          ,
        o_dbg_pte     : o_dbg_pte     ,
        o_dbg_tlb_hit : o_dbg_tlb_hit ,
        o_dbg_tlb_ppn : o_dbg_tlb_ppn ,
        o_dbg_tlb_perm: o_dbg_tlb_perm,
    );

    // M9.A.303 debug: dmem PTW address/req (the internal walk address)
    assign o_dbg_ptw_req  = ptw_req;
    assign o_dbg_ptw_addr = ptw_addr;

    // External memory mux. P10 Svadu: during the A/D write-back (ptw_wen) the
    // address is the leaf PTE (ptw_addr), the data is the updated PTE
    // (ptw_wdata), and a full-dword strobe writes all 8 PTE bytes. ptw_req=0 and
    // ptw_valid=0 in WRITE_AD, so the read-side mux terms naturally stay off.
    assign o_dmem_addr = if vm_enabled && (ptw_req || ptw_wen) ? ptw_addr : if vm_enabled && ptw_valid ? ptw_paddr : i_vaddr;

    assign o_dmem_wdata = if vm_enabled && ptw_wen ? ptw_wdata : i_wdata;

    // PMP (Smpmp): an access denied by PMP must NOT reach memory — gate the DATA
    // read/write (NOT the PTW PTE read ptw_req or A/D write-back ptw_wen) on the
    // access fault. Suppressing the read also keeps a denied load from missing
    // the dcache and stalling forever on a fill it must never perform; the fault
    // is still reported via o_acc_fault (from i_ren/i_wen, not o_dmem_*), so the
    // load/store commits the fault instead. acc_deny is assigned below (fwd-decl).
    var acc_deny: logic;
    assign o_dmem_wen   = ((if vm_enabled ? (ptw_valid && i_wen) : i_wen) && !acc_deny) || (vm_enabled && ptw_wen);
    assign o_dmem_ren   = ((if vm_enabled ? (ptw_valid && i_ren) : i_ren) && !acc_deny) || (vm_enabled && ptw_req);
    assign o_dmem_wstrb = if acc_deny ? '0 : if vm_enabled ? (if ptw_wen ? 8'hFF : if ptw_valid ? i_wstrb : '0) : i_wstrb;

    // P10 Svadu: surface the write-back cycle to the core (forces dcache i_wen).
    assign o_ad_writeback = vm_enabled && ptw_wen;

    assign o_rdata = if vm_enabled ? (if ptw_valid ? i_dmem_rdata : '0) : i_dmem_rdata;
    // rdata_valid: high when o_rdata carries actual memory data (not zeros from PTW)
    assign o_rdata_valid = if vm_enabled ? ptw_valid : 1'b1;

    // Busy: stall the pipeline for the Sv39 TRANSLATION only.
    // - mem_req && !ptw_valid: request arrived but translation not yet
    //   complete (covers the IDLE→LEVEL2 transition cycle where ptw_busy
    //   is not yet asserted).
    // - ptw_busy: during PTW walk (LEVEL2/LEVEL1/LEVEL0 states).
    // Phase 8 S10 (Sv39 non-blocking): the old third term
    // `ptw_valid && i_dcache_stall` (translated PA's DATA access waiting on a
    // cache fill) is gone — it re-exported the dcache's back-pressure as MMU
    // busy, freezing the whole pipe for the fill under VM. The dcache stall
    // belongs to the core's dcache-reader gates (iss_dc_ok / commit store
    // gates), which hold exactly the ops that need the dcache; the walk's own
    // PTE reads are still held by i_stall inside the mmu. Busy now drops at
    // translation success (ptw_valid), which also lets the core's walk-owner
    // tag (walk_v_q) clear then — safe, as no walk fault can arrive after
    // ptw_valid.
    // Busy: stall pipeline during translation, but NOT during fault
    // (fault must be visible to trap logic without stall masking it)
    assign o_busy        = vm_enabled && !ptw_fault
        && (ptw_busy || (mem_req && !ptw_valid));
    // SvPMP: a PMP-denied PTE read makes the walk fault as an ACCESS fault, not a
    // page fault — mask the page-fault outputs and route it via o_acc_fault below.
    let pte_acc_fault: logic = vm_enabled && ptw_acc_fault;
    assign o_fault       = vm_enabled && ptw_fault && !pte_acc_fault;
    assign o_fault_store = vm_enabled && ptw_fault && i_wen && !pte_acc_fault;

    // PMP check on the FINAL data access (Bare PA, or the translated PA once the
    // walk has produced it). The implicit PTE reads during a walk are checked
    // separately (see the PTW path). A page fault takes priority over PMP, so the
    // access fault only fires when the access actually reaches a physical address.
    let pmp_pa    : logic<64> = if vm_enabled ? ptw_paddr : i_vaddr;
    let pmp_acc   : logic<2>  = if i_wen ? 2'd1 : 2'd0; // store=W(1), load=R(0)
    let pmp_active: logic     = mem_req && (if vm_enabled ? (ptw_valid && !ptw_fault) : 1'b1);
    var pmp_deny  : logic;
    inst u_pmp: pmp_check (
        i_addr   : pmp_pa  ,
        i_acc    : pmp_acc ,
        i_priv             ,
        i_pmpcfg           ,
        i_pmpaddr          ,
        o_fault  : pmp_deny,
    );
    // PMP: an AMO additionally requires WRITE permission. Its RMW read presents
    // i_wen=0 (so u_pmp above checks only R); check W here and OR the denial in,
    // so a W-denied / R-allowed region faults the AMO too. The fault is reported
    // on the LOAD signal (o_acc_fault) — the AMO drives i_ren — and the core's
    // alu_wrap routes an AMO's load-side fault to a store/AMO access fault (7).
    var pmp_deny_amo_w: logic;
    inst u_pmp_amo_w: pmp_check (
        i_addr   : pmp_pa       ,
        i_acc    : 2'd1         , // write
        i_priv                  ,
        i_pmpcfg                ,
        i_pmpaddr               ,
        o_fault  : pmp_deny_amo_w,
    );
    // PMA: an access whose final PA hits no memory/device region (a "hole") takes
    // an access fault, identical to a PMP denial. heliodor's physical address map
    // (mirrors heliodor_soc): DRAM pa[31], CLINT 0x02xx_xxxx, UART 0x1xxx_xxxx,
    // PLIC 0x0Cxx_xxxx — anything else is unbacked. (ACT4 ExceptionsSv* +
    // PMPSm cfg_A_tor_zero: a store/load to PA 0 must access-fault.)
    let pma_hole: logic = PMA_FAULT && !(pmp_pa[31] || pmp_pa[31:24] == 8'h02 || pmp_pa[31:28] == 4'h1 || pmp_pa[31:24] == 8'h0c);
    assign acc_deny          = pmp_active && (pmp_deny || (i_is_amo && pmp_deny_amo_w) || pma_hole);
    // SvPMP: the data-access PMP denial (acc_deny, on the final PA) OR a PTE-read
    // PMP denial during the walk (pte_acc_fault) both raise an access fault of the
    // original type (cause 5 load / 7 store). They are disjoint in time (acc_deny
    // needs ptw_valid; pte_acc_fault fires mid-walk before ptw_valid).
    assign o_acc_fault       = acc_deny || pte_acc_fault;
    assign o_acc_fault_store = (acc_deny || pte_acc_fault) && i_wen;
    assign o_pte_acc_fault   = pte_acc_fault;

}
