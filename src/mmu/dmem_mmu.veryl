// Data memory MMU
// Sits between the memory stage and external data memory interface.
// In Bare mode (satp.MODE=0 or M-mode): pure passthrough.
// In Sv39 mode: performs 3-level page table walk via the mmu submodule,
// then issues the actual load/store using the translated physical address.
pub module dmem_mmu (
    clk          : input  clock                 ,
    rst          : input  reset                 ,
    i_vaddr      : input  logic             <64>,
    i_wdata      : input  logic             <64>,
    i_wen        : input  logic                 ,
    i_ren        : input  logic                 ,
    i_wstrb      : input  logic             <8> ,
    o_rdata      : output logic             <64>,
    o_dmem_addr  : output logic             <64>,
    o_dmem_wdata : output logic             <64>,
    i_dmem_rdata : input  logic             <64>,
    o_dmem_wen   : output logic                 ,
    o_dmem_ren   : output logic                 ,
    o_dmem_wstrb : output logic             <8> ,
    i_satp       : input  logic             <64>,
    i_priv       : input  csr_pkg::PrivLevel    ,
    i_sum        : input  logic                 ,
    i_mxr        : input  logic                 ,
    o_busy       : output logic                 ,
    o_fault      : output logic                 ,
    o_fault_store: output logic                 ,
    o_rdata_valid: output logic                 ,
    // M9.A.296: PTW-start pulse (passthrough from mmu). For OoO fault
    // attribution. v1 (in-order) leaves this unconnected.
    o_walk_start: output logic,
    // M9.3: MMU FSM is in IDLE (no walk owns the port). Passthrough from mmu;
    // used by the OoO core to gate the load-walk VA pin on a REAL in-flight
    // walk. Loop-free (mmu derives it from its `state` register only).
    o_idle: output logic,
    // D-cache stall: PTW data is not valid while dcache is filling
    i_dcache_stall: input logic,
    // TLB flush (SFENCE.VMA)
    i_sfence: input logic,
    // M9.A.303 debug: surface faulting-PTE + TLB-hit context + the dmem PTW
    // address/req so the tb can characterize the v4 load-fault loop.
    o_dbg_ptw_req : output logic    ,
    o_dbg_ptw_addr: output logic<64>,
    o_dbg_pte     : output logic<64>,
    o_dbg_tlb_hit : output logic    ,
    o_dbg_tlb_ppn : output logic<44>,
    o_dbg_tlb_perm: output logic<4> ,
) {
    import csr_pkg::*;

    // SATP decode
    let satp_mode : logic<4> = i_satp[63:60];
    let vm_enabled: logic    = satp_mode == SATP_MODE_SV39 && i_priv != PrivLevel::MACHINE;
    let mem_req   : logic    = i_wen || i_ren;

    // PTW submodule
    var ptw_paddr: logic<64>;
    var ptw_valid: logic    ;
    var ptw_fault: logic    ;
    var ptw_busy : logic    ;
    var ptw_addr : logic<64>;
    var ptw_req  : logic    ;

    inst u_mmu: mmu (
        clk                       ,
        rst                       ,
        i_vaddr                   ,
        i_req       : mem_req     ,
        i_store     : i_wen       ,
        i_fetch     : 1'b0        ,
        o_paddr     : ptw_paddr   ,
        o_valid     : ptw_valid   ,
        o_fault     : ptw_fault   ,
        o_busy      : ptw_busy    ,
        o_walk_start: o_walk_start,
        o_idle      : o_idle      ,
        i_satp                    ,
        i_priv                    ,
        i_sum                     ,
        i_mxr                     ,
        o_ptw_addr  : ptw_addr    ,
        o_ptw_req   : ptw_req     ,
        i_ptw_data  : i_dmem_rdata,
        // PTW data is valid only when dcache is not stalling
        i_ptw_valid: ptw_req && !i_dcache_stall,
        // Hold DONE state while dcache is stalling on translated PA
        i_stall       : i_dcache_stall,
        i_sfence                      ,
        i_redirect    : 1'b0          ,
        o_dbg_pte     : o_dbg_pte     ,
        o_dbg_tlb_hit : o_dbg_tlb_hit ,
        o_dbg_tlb_ppn : o_dbg_tlb_ppn ,
        o_dbg_tlb_perm: o_dbg_tlb_perm,
    );

    // M9.A.303 debug: dmem PTW address/req (the internal walk address)
    assign o_dbg_ptw_req  = ptw_req;
    assign o_dbg_ptw_addr = ptw_addr;

    // External memory mux
    assign o_dmem_addr = if vm_enabled && ptw_req ? ptw_addr : if vm_enabled && ptw_valid ? ptw_paddr : i_vaddr;

    assign o_dmem_wdata = i_wdata;

    assign o_dmem_wen   = if vm_enabled ? (ptw_valid && i_wen) : i_wen;
    assign o_dmem_ren   = if vm_enabled ? (ptw_req || (ptw_valid && i_ren)) : i_ren;
    assign o_dmem_wstrb = if vm_enabled ? (if ptw_valid ? i_wstrb : '0) : i_wstrb;

    assign o_rdata = if vm_enabled ? (if ptw_valid ? i_dmem_rdata : '0) : i_dmem_rdata;
    // rdata_valid: high when o_rdata carries actual memory data (not zeros from PTW)
    assign o_rdata_valid = if vm_enabled ? ptw_valid : 1'b1;

    // Busy: stall the pipeline for the Sv39 TRANSLATION only.
    // - mem_req && !ptw_valid: request arrived but translation not yet
    //   complete (covers the IDLE→LEVEL2 transition cycle where ptw_busy
    //   is not yet asserted).
    // - ptw_busy: during PTW walk (LEVEL2/LEVEL1/LEVEL0 states).
    // Phase 8 S10 (Sv39 non-blocking): the old third term
    // `ptw_valid && i_dcache_stall` (translated PA's DATA access waiting on a
    // cache fill) is gone — it re-exported the dcache's back-pressure as MMU
    // busy, freezing the whole pipe for the fill under VM. The dcache stall
    // belongs to the core's dcache-reader gates (iss_dc_ok / commit store
    // gates), which hold exactly the ops that need the dcache; the walk's own
    // PTE reads are still held by i_stall inside the mmu. Busy now drops at
    // translation success (ptw_valid), which also lets the core's walk-owner
    // tag (walk_v_q) clear then — safe, as no walk fault can arrive after
    // ptw_valid.
    // Busy: stall pipeline during translation, but NOT during fault
    // (fault must be visible to trap logic without stall masking it)
    assign o_busy        = vm_enabled && !ptw_fault
        && (ptw_busy || (mem_req && !ptw_valid));
    assign o_fault       = vm_enabled && ptw_fault;
    assign o_fault_store = vm_enabled && ptw_fault && i_wen;

}
