// Phase 7 v4: Physical Register File (integer).
//
// 64 entries, 2 read ports, 1 write port (CDB). Reads return the
// registered value; same-cycle write-then-read forwarding is not
// needed in M1 because wakeup→issue→read is at least one cycle deep:
// a producer that writes on cycle N cannot be source-read until N+1.
//
// Reset state: PRF[0..31] = 0. The initial RAT maps arch r0..r31 to
// PRF[0..31]; rename never allocates a new pdst for rd=0 (so PRF[0]
// stays 0).
pub module prf_int #(
    param PRF_N: u32 = 64,
    param PRF_W: u32 = 6 ,
) (
    clk: input clock,
    rst: input reset,

    // Read ports
    i_rd1_pdst: input  logic<PRF_W>,
    o_rd1_data: output logic<64>   ,
    i_rd2_pdst: input  logic<PRF_W>,
    o_rd2_data: output logic<64>   ,

    // Write port (CDB)
    i_wr_en  : input logic        ,
    i_wr_pdst: input logic<PRF_W> ,
    i_wr_data: input logic<64>    ,
) {
    var prf: logic<64> [PRF_N];

    always_ff (clk, rst) {
        if_reset {
            for i in 0..PRF_N {
                prf[i] = 64'd0;
            }
        } else if i_wr_en {
            // Static-index ladder write to avoid Veryl-sim dynamic-index
            // array WRITE bug. PRF[0] is the arch-zero hard tie; rename
            // never allocates a write to it, but for safety we still
            // include r=0 in the ladder (the upstream gates handle it).
            for r in 0..PRF_N {
                if i_wr_pdst == (r as PRF_W) {
                    prf[r] = i_wr_data;
                }
            }
        }
    }

    assign o_rd1_data = prf[i_rd1_pdst];
    assign o_rd2_data = prf[i_rd2_pdst];
}
