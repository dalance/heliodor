// Phase 7 v4: v1↔v4 retire-PC lockstep checker.
//
// Consumes two retire-PC streams (one per core) and asserts that they
// match. v1 and v4 are not cycle-locked because their IPC differs, but
// the *retire order* must match exactly — same hex, deterministic IRQ
// inputs ⇒ same retire PC sequence.
//
// Each side feeds in {valid, pc, rd, rd_v, data} per cycle (retire-time
// observation). Internal FIFOs buffer up to FIFO_DEPTH entries; the
// comparator pops one from each side when both FIFOs are non-empty and
// latches diverged=1 on mismatch. The enclosing tb is responsible for
// $assert / $finish on first divergence.
pub module cosim_checker #(
    // M9.A.308: bumped 65536→262144. v1 (heliodor_top, full caches) retires
    // faster than v4 (bare core + comb dmem + MMU-walk stalls), so v1's FIFO
    // accumulates the IPC-gap backlog while do_pop is gated by the slower v4.
    // At 65536 the Linux-boot gap (65580 @cy356646) overran the ring and the
    // wrapped write corrupted the unread head → a SPURIOUS pc_mism (not a v4
    // bug; the 158929 pairs before it all matched). 262144 covers the ~165K
    // gap of a 900K-cy window; the fifo_ovf guard below flags any residual
    // overflow distinctly (kind=3) so it can never masquerade as a divergence.
    param FIFO_DEPTH: u32 = 262144,
    param FIFO_W    : u32 = 18    , // log2(FIFO_DEPTH)
) (
    clk: input clock,
    rst: input reset,

    // Cycle counter for context (driven by tb)
    i_cycle: input logic<32>,

    // v1 side (golden reference, heliodor_top)
    i_v1_push: input logic    ,
    i_v1_pc  : input logic<64>,
    i_v1_rd_v: input logic    ,
    i_v1_rd  : input logic<5> ,
    i_v1_data: input logic<64>,

    // v4 side (DUT)
    i_v4_push: input logic    ,
    i_v4_pc  : input logic<64>,
    i_v4_rd_v: input logic    ,
    i_v4_rd  : input logic<5> ,
    i_v4_data: input logic<64>,

    // Outputs (tb-visible)
    o_diverged          : output logic    , // sticky on first mismatch
    o_compared_cnt      : output logic<32>, // count of compared (v1, v4) pairs
    o_v1_pushed_cnt     : output logic<32>, // total v1 retires observed
    o_v4_pushed_cnt     : output logic<32>, // total v4 retires observed
    o_first_diverge_cy  : output logic<32>,
    o_first_diverge_kind: output logic<2> , // 1=PC, 2=ARCH-REG
    o_first_diverge_v1pc: output logic<64>,
    o_first_diverge_v4pc: output logic<64>,
) {
    // ============================================================
    // FIFO storage (ring buffers)
    // ============================================================
    var v1_pc_q  : logic<64> [FIFO_DEPTH];
    var v1_rd_v_q: logic     [FIFO_DEPTH];
    var v1_rd_q  : logic<5>  [FIFO_DEPTH];
    var v1_data_q: logic<64> [FIFO_DEPTH];
    var v1_wr    : logic<32>             ; // wider to avoid overflow on long tests
    var v1_rd_ptr: logic<32>             ;

    var v4_pc_q  : logic<64> [FIFO_DEPTH];
    var v4_rd_v_q: logic     [FIFO_DEPTH];
    var v4_rd_q  : logic<5>  [FIFO_DEPTH];
    var v4_data_q: logic<64> [FIFO_DEPTH];
    var v4_wr    : logic<32>             ;
    var v4_rd_ptr: logic<32>             ;

    var diverged          : logic    ;
    var compared          : logic<32>;
    var v1_pushed         : logic<32>;
    var v4_pushed         : logic<32>;
    var first_diverge_cy  : logic<32>;
    var first_diverge_kind: logic<2> ;
    var first_diverge_v1pc: logic<64>;
    var first_diverge_v4pc: logic<64>;

    // Compare-pair ring: captures the LAST 256 (v1, v4) retire pairs that
    // were popped+compared. On divergence detection we dump this ring so we
    // can see the actual retire-history leading up to (and including) the
    // divergence — the tb-side per-side rings are misaligned because v1
    // and v4 retire at different cycles.
    var cmp_v1pc  : logic<64> [256];
    var cmp_v4pc  : logic<64> [256];
    var cmp_v1rdv : logic     [256];
    var cmp_v4rdv : logic     [256];
    var cmp_v1rd  : logic<5>  [256];
    var cmp_v4rd  : logic<5>  [256];
    var cmp_v1data: logic<64> [256];
    var cmp_v4data: logic<64> [256];
    var cmp_idx   : logic<8>       ;

    var v1_empty: logic        ;
    var v4_empty: logic        ;
    var do_pop  : logic        ;
    var v1_idx  : logic<FIFO_W>;
    var v4_idx  : logic<FIFO_W>;
    // M9.A.308: FIFO occupancy + overflow guard. If either side's backlog
    // reaches FIFO_DEPTH the next push would wrap the ring and overwrite the
    // unread head, corrupting the comparison. Detect it and stop with a
    // distinct marker (kind=3) instead of letting it surface as a false
    // pc_mism/data_mism.
    var v1_occ  : logic<32>;
    var v4_occ  : logic<32>;
    var fifo_ovf: logic    ;
    always_comb {
        v1_empty = v1_wr == v1_rd_ptr;
        v4_empty = v4_wr == v4_rd_ptr;
        do_pop   = !v1_empty && !v4_empty && !diverged;
        v1_idx   = v1_rd_ptr[FIFO_W - 1:0];
        v4_idx   = v4_rd_ptr[FIFO_W - 1:0];
        v1_occ   = v1_wr - v1_rd_ptr;
        v4_occ   = v4_wr - v4_rd_ptr;
        fifo_ovf = (v1_occ >= FIFO_DEPTH) || (v4_occ >= FIFO_DEPTH);
    }

    var pc_mism  : logic;
    var data_mism: logic;
    always_comb {
        pc_mism = do_pop && v1_pc_q[v1_idx] != v4_pc_q[v4_idx];
        // arch-reg check: only compare (rd, data) when both sides agree
        // there's a writable destination. rd=0 (architectural zero) or
        // rd_v=0 ops have don't-care data fields — comparing them is
        // a false-positive vector (e.g. JAL x0, 0 link value).
        let both_rdv : logic = v1_rd_v_q[v1_idx] && v4_rd_v_q[v4_idx];
        data_mism = do_pop && !pc_mism
            && (v1_rd_v_q[v1_idx] != v4_rd_v_q[v4_idx]
                || (both_rdv && (v1_rd_q[v1_idx] != v4_rd_q[v4_idx] || v1_data_q[v1_idx] != v4_data_q[v4_idx])));
    }

    always_ff (clk, rst) {
        if_reset {
            v1_wr              = 32'd0;
            v1_rd_ptr          = 32'd0;
            v4_wr              = 32'd0;
            v4_rd_ptr          = 32'd0;
            diverged           = 1'b0;
            compared           = 32'd0;
            v1_pushed          = 32'd0;
            v4_pushed          = 32'd0;
            first_diverge_cy   = 32'hffffffff;
            first_diverge_kind = 2'd0;
            first_diverge_v1pc = 64'd0;
            first_diverge_v4pc = 64'd0;
            cmp_idx            = 8'd0;
            for k in 0..256 {
                cmp_v1pc[k]   = 64'd0;
                cmp_v4pc[k]   = 64'd0;
                cmp_v1rdv[k]  = 1'b0;
                cmp_v4rdv[k]  = 1'b0;
                cmp_v1rd[k]   = 5'd0;
                cmp_v4rd[k]   = 5'd0;
                cmp_v1data[k] = 64'd0;
                cmp_v4data[k] = 64'd0;
            }
        } else {
            // M9.A.308: freeze with kind=3 the moment a FIFO is full, before
            // the wrapping push corrupts the unread head. This is a harness
            // capacity limit, NOT a v4 divergence.
            if fifo_ovf && !diverged {
                diverged           = 1'b1;
                first_diverge_cy   = i_cycle;
                first_diverge_kind = 2'd3;
                first_diverge_v1pc = v1_occ;
                first_diverge_v4pc = v4_occ;
            }
            if i_v1_push && !fifo_ovf {
                v1_pc_q[v1_wr[FIFO_W - 1:0]]   = i_v1_pc;
                v1_rd_v_q[v1_wr[FIFO_W - 1:0]] = i_v1_rd_v;
                v1_rd_q[v1_wr[FIFO_W - 1:0]]   = i_v1_rd;
                v1_data_q[v1_wr[FIFO_W - 1:0]] = i_v1_data;
                v1_wr                          = v1_wr + 32'd1;
                v1_pushed                      = v1_pushed + 32'd1;
            }
            if i_v4_push {
                v4_pc_q[v4_wr[FIFO_W - 1:0]]   = i_v4_pc;
                v4_rd_v_q[v4_wr[FIFO_W - 1:0]] = i_v4_rd_v;
                v4_rd_q[v4_wr[FIFO_W - 1:0]]   = i_v4_rd;
                v4_data_q[v4_wr[FIFO_W - 1:0]] = i_v4_data;
                v4_wr                          = v4_wr + 32'd1;
                v4_pushed                      = v4_pushed + 32'd1;
            }
            if do_pop {
                // Always capture in compare ring (includes the divergence pair).
                cmp_v1pc[cmp_idx]   = v1_pc_q[v1_idx];
                cmp_v4pc[cmp_idx]   = v4_pc_q[v4_idx];
                cmp_v1rdv[cmp_idx]  = v1_rd_v_q[v1_idx];
                cmp_v4rdv[cmp_idx]  = v4_rd_v_q[v4_idx];
                cmp_v1rd[cmp_idx]   = v1_rd_q[v1_idx];
                cmp_v4rd[cmp_idx]   = v4_rd_q[v4_idx];
                cmp_v1data[cmp_idx] = v1_data_q[v1_idx];
                cmp_v4data[cmp_idx] = v4_data_q[v4_idx];
                cmp_idx             = cmp_idx + 8'd1;

                if pc_mism {
                    diverged           = 1'b1;
                    first_diverge_cy   = i_cycle;
                    first_diverge_kind = 2'd1;
                    first_diverge_v1pc = v1_pc_q[v1_idx];
                    first_diverge_v4pc = v4_pc_q[v4_idx];
                    $display          ("=== cosim COMPARE RING DUMP (pc_mism) ===");
                    for j in 0..256 {
                        let off     : logic<8> = cmp_idx + j;
                        $display("cmpv1pc=%h v4pc=%h", cmp_v1pc[off], cmp_v4pc[off]);
                    }
                    $display("=== end RING DUMP ===");
                } else if data_mism {
                    diverged           = 1'b1;
                    first_diverge_cy   = i_cycle;
                    first_diverge_kind = 2'd2;
                    first_diverge_v1pc = v1_pc_q[v1_idx];
                    first_diverge_v4pc = v4_pc_q[v4_idx];
                    $display          ("=== cosim COMPARE RING DUMP (data_mism) ===");
                    for j in 0..256 {
                        let off     : logic<8> = cmp_idx + j;
                        $display("cmpv1pc=%h v4pc=%h", cmp_v1pc[off], cmp_v4pc[off]);
                    }
                    $display("=== end RING DUMP ===");
                } else {
                    compared = compared + 32'd1;
                }
                v1_rd_ptr = v1_rd_ptr + 32'd1;
                v4_rd_ptr = v4_rd_ptr + 32'd1;
            }
        }
    }

    assign o_diverged           = diverged;
    assign o_compared_cnt       = compared;
    assign o_v1_pushed_cnt      = v1_pushed;
    assign o_v4_pushed_cnt      = v4_pushed;
    assign o_first_diverge_cy   = first_diverge_cy;
    assign o_first_diverge_kind = first_diverge_kind;
    assign o_first_diverge_v1pc = first_diverge_v1pc;
    assign o_first_diverge_v4pc = first_diverge_v4pc;
}
