// Phase 7 v4: Register Alias Table (speculative + architectural).
//
// Two RATs coexist:
//   rat_spec — updated at rename (speculative)
//   rat_arch — updated at ROB commit (architectural, the source of truth
//              for misprediction/trap recovery)
//
// Reset: identity rat_spec[r] = rat_arch[r] = r (PRF 0..31). arch r0
// stays mapped to PRF 0 forever; rename never replaces it.
//
// Recovery: on `i_recovery_fire` (commit-time misprediction or trap)
// copy rat_arch into rat_spec single-cycle. M6 will upgrade to branch
// checkpoint restore for faster mispredict recovery.
pub module rat_v4 #(
    param PRF_W : u32 = 6 ,
    param ARCH_N: u32 = 32,
) (
    clk: input clock,
    rst: input reset,

    // rat_spec read ports (rename source operands + rd old-pdst capture)
    i_rs1_arch    : input  logic<5>     ,
    o_rs1_pdst    : output logic<PRF_W> ,
    i_rs2_arch    : input  logic<5>     ,
    o_rs2_pdst    : output logic<PRF_W> ,
    i_rd_arch     : input  logic<5>     ,
    o_rd_old_pdst : output logic<PRF_W> ,

    // rat_spec write (rename time)
    i_rename_en   : input logic         ,
    i_rename_arch : input logic<5>      ,
    i_rename_pdst : input logic<PRF_W>  ,

    // rat_arch write (commit time)
    i_commit_en   : input logic         ,
    i_commit_arch : input logic<5>      ,
    i_commit_pdst : input logic<PRF_W>  ,

    // Recovery: copy rat_arch → rat_spec
    i_recovery_fire: input logic,
) {
    var rat_spec: logic<PRF_W> [ARCH_N];
    var rat_arch: logic<PRF_W> [ARCH_N];

    assign o_rs1_pdst    = rat_spec[i_rs1_arch];
    assign o_rs2_pdst    = rat_spec[i_rs2_arch];
    assign o_rd_old_pdst = rat_spec[i_rd_arch];

    always_ff (clk, rst) {
        if_reset {
            for i in 0..ARCH_N {
                rat_spec[i] = i as PRF_W;
                rat_arch[i] = i as PRF_W;
            }
        } else {
            if i_recovery_fire {
                for i in 0..ARCH_N {
                    rat_spec[i] = rat_arch[i];
                }
            } else if i_rename_en {
                // Static-index ladder to avoid dynamic-index array WRITE
                // (Veryl sim bug for dynamic ranges across renames).
                // r=0 skipped — arch zero never renamed.
                for r in 1..ARCH_N {
                    if i_rename_arch == (r as 5) {
                        rat_spec[r] = i_rename_pdst;
                    }
                }
            }
            if i_commit_en {
                for r in 1..ARCH_N {
                    if i_commit_arch == (r as 5) {
                        rat_arch[r] = i_commit_pdst;
                    }
                }
            }
        }
    }
}
