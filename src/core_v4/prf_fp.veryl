// Phase 7 v4: Physical Register File (floating-point).
//
// 64 entries, 3 read ports (rs1/rs2/rs3 — rs3 is the FMADD/FMSUB third
// operand), 1 write port (FP CDB). Same registered-read, no same-cycle
// write-forward model as prf_int (wakeup→issue→read is ≥1 cycle deep).
//
// Unlike prf_int, f0 is NOT hardwired to zero: every arch FP register is
// a normal renameable register. Reset value 0 (= +0.0 / canonical) is
// harmless; arch programs initialise FP regs explicitly before use.
pub module prf_fp #(
    param PRF_N: u32 = 64,
    param PRF_W: u32 = 6 ,
) (
    clk: input clock,
    rst: input reset,

    // Read ports
    i_rd1_pdst: input  logic<PRF_W>,
    o_rd1_data: output logic<64>   ,
    i_rd2_pdst: input  logic<PRF_W>,
    o_rd2_data: output logic<64>   ,
    i_rd3_pdst: input  logic<PRF_W>,
    o_rd3_data: output logic<64>   ,

    // Write port (FP CDB)
    i_wr_en  : input logic       ,
    i_wr_pdst: input logic<PRF_W>,
    i_wr_data: input logic<64>   ,
) {
    var prf: logic<64> [PRF_N];

    always_ff (clk, rst) {
        if_reset {
            for i in 0..PRF_N {
                prf[i] = 64'd0;
            }
        } else if i_wr_en {
            // Static-index ladder write (Veryl-sim dynamic-index array
            // WRITE workaround), matching prf_int.
            for r in 0..PRF_N {
                if i_wr_pdst == (r as PRF_W) {
                    prf[r] = i_wr_data;
                }
            }
        }
    }

    assign o_rd1_data = prf[i_rd1_pdst];
    assign o_rd2_data = prf[i_rd2_pdst];
    assign o_rd3_data = prf[i_rd3_pdst];
}
