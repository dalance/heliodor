// Real Linux kernel boot integration test.
// Boots Linux v5.15 with M-mode SBI firmware through S-mode kernel init.
// Uses the real kernel image (linux_dram_real.hex, ~11 MB) + DTB.
//
// This test is marked #[ignore] because it takes several minutes.
// Run explicitly with: veryl test --ignored --test test_linux_boot
//
// Memory map:
//   PA 0x00000000 : Firmware ROM (16 KB)
//   PA 0x02000000 : CLINT (internal to heliodor_top)
//   PA 0x0C000000 : PLIC  (internal to heliodor_top)
//   PA 0x10000000 : UART  (internal to heliodor_top)
//   PA 0x80000000 : DRAM  (32 MB, kernel Image + DTB)
module test_linux_boot_harness (
    clk   : input  clock    ,
    rst   : input  reset    ,
    o_pass: output logic    ,
    o_r1  : output logic<64>,
    o_r2  : output logic<64>,
    o_r3  : output logic<64>,
    o_lq_issue_cnt: output logic<32>,
    o_lq_alloc_cnt: output logic<32>,
    o_lq_mshr_cnt : output logic<32>,
    o_sb_fwd_hit_cnt     : output logic<32>,
    o_sb_fwd_partial_cnt : output logic<32>,
    o_sb_fwd_mismatch_cnt: output logic<32>,
    o_jalr_mispred_cnt   : output logic<32>,
    o_jalr_mispred_ret   : output logic<32>,
    o_jalr_mispred_ind   : output logic<32>,
) {
    var imem_addr     : logic<64>     ;
    var imem_rdata    : logic<32>     ;
    var imem_ren      : logic         ;
    var dmem_addr     : logic<64>     ;
    var dmem_wdata    : logic<64>     ;
    var dmem_rdata    : logic<64>     ;
    var dmem_wen      : logic         ;
    var dmem_ren      : logic         ;
    var dmem_wstrb    : logic<8>      ;
    var dbg_regs      : logic<64> [32];
    var dbg_pc        : logic<64>     ;
    var _dbg_pass     : logic         ;
    var _dbg_r1       : logic<64>     ;
    var _dbg_r2       : logic<64>     ;
    var dbg_r3        : logic<64>     ;
    var iptw_addr     : logic<64>     ;
    var iptw_req      : logic         ;
    var iptw_rdata    : logic<64>     ;
    var dbg_stall     : logic<8>      ;
    var _dbg_instret  : logic         ;
    var uart_tx       : logic         ;
    var uart_data     : logic<8>      ;
    var bp_predict    : logic         ;
    var bp_mispred    : logic         ;
    var bp_taken      : logic         ;
    var bp_ex_pc      : logic<64>     ;
    var bp_target     : logic<64>     ;
    var trap_taken_dbg: logic         ;
    var trap_cause_dbg: logic<64>     ;
    var trap_pc_dbg   : logic<64>     ;
    var jalr_mispred_pulse  : logic   ;
    var jalr_mispred_return : logic   ;
    var jalr_mispred_indirec: logic   ;
    var jalr_mispred_cnt    : logic<32>;
    var jalr_mispred_ret_cnt: logic<32>;
    var jalr_mispred_ind_cnt: logic<32>;
    var lq_issue_cnt  : logic<32>     ;
    var lq_alloc_cnt  : logic<32>     ;
    var lq_mshr_cnt   : logic<32>     ;
    var sb_fwd_hit_cnt     : logic<32>;
    var sb_fwd_partial_cnt : logic<32>;
    var sb_fwd_mismatch_cnt: logic<32>;

    inst dut: heliodor_top #(
        RESET_PC: 0,
    ) (
        clk                             ,
        rst                             ,
        o_imem_addr     : imem_addr     ,
        i_imem_rdata    : imem_rdata    ,
        o_imem_ren      : imem_ren      ,
        o_iptw_addr     : iptw_addr     ,
        o_iptw_req      : iptw_req      ,
        i_iptw_rdata    : iptw_rdata    ,
        i_uart_rx_data  : 8'd0          ,
        i_uart_rx_valid : 1'b0          ,
        o_dmem_addr     : dmem_addr     ,
        o_dmem_wdata    : dmem_wdata    ,
        i_dmem_rdata    : dmem_rdata    ,
        o_dmem_wen      : dmem_wen      ,
        o_dmem_ren      : dmem_ren      ,
        o_dmem_wstrb    : dmem_wstrb    ,
        o_dbg_regs      : dbg_regs      ,
        o_dbg_pc        : dbg_pc        ,
        o_dbg_pass      : _dbg_pass     ,
        o_dbg_r1        : _dbg_r1       ,
        o_dbg_r2        : _dbg_r2       ,
        o_dbg_r3        : dbg_r3        ,
        i_ext_irq       : 32'd0         ,
        o_dbg_stall     : dbg_stall     ,
        o_dbg_instret   : _dbg_instret  ,
        o_dbg_bp_predict: bp_predict    ,
        o_dbg_bp_mispred: bp_mispred    ,
        o_dbg_bp_taken  : bp_taken      ,
        o_dbg_bp_ex_pc  : bp_ex_pc      ,
        o_dbg_bp_target : bp_target     ,
        o_dbg_trap_taken: trap_taken_dbg,
        o_dbg_trap_cause: trap_cause_dbg,
        o_dbg_trap_pc   : trap_pc_dbg   ,
        o_dbg_mispred_jalr        : jalr_mispred_pulse  ,
        o_dbg_mispred_jalr_return : jalr_mispred_return ,
        o_dbg_mispred_jalr_indirect: jalr_mispred_indirec,
        o_dbg_lq_issue_cnt: lq_issue_cnt,
        o_dbg_lq_alloc_cnt: lq_alloc_cnt,
        o_dbg_lq_mshr_cnt : lq_mshr_cnt ,
        o_dbg_sb_fwd_hit_cnt     : sb_fwd_hit_cnt     ,
        o_dbg_sb_fwd_partial_cnt : sb_fwd_partial_cnt ,
        o_dbg_sb_fwd_mismatch_cnt: sb_fwd_mismatch_cnt,
        o_uart_tx       : uart_tx       ,
        o_uart_data     : uart_data     ,
    );

    // ============================================================
    // Memory arrays
    // ============================================================
    // Firmware ROM: 16 KB = 4096 × 32-bit words
    var fw_rom: logic<32> [4096];

    // DRAM: 32 MB = 8388608 × 32-bit words (PA 0x80000000 - 0x81FFFFFF)
    var dram: logic<32> [8388608];

    initial {
        $readmemh("test/hex/linux_boot_fw.hex", fw_rom);
        $readmemh("test/hex/linux_dram_real.hex", dram);
    }

    // ============================================================
    // Address decode
    // ============================================================
    // Firmware ROM: PA[31:14] == 0 (0x00000000 - 0x00003FFF)
    let imem_in_fw  : logic = imem_addr[31:14] == 18'd0;
    let dmem_in_dram: logic = dmem_addr[31];
    let iptw_in_fw  : logic = iptw_addr[31:14] == 18'd0;
    let iptw_in_dram: logic = iptw_addr[31];

    // DRAM word index (from PA, 32 MB range → 23-bit index)
    let dram_imem_idx: logic<23> = imem_addr[24:2];
    let dram_dmem_lo : logic<23> = {dmem_addr[24:3], 1'b0};
    let dram_dmem_hi : logic<23> = {dmem_addr[24:3], 1'b1};
    let dram_iptw_lo : logic<23> = {iptw_addr[24:3], 1'b0};
    let dram_iptw_hi : logic<23> = {iptw_addr[24:3], 1'b1};

    // Firmware ROM indices
    let fw_imem_idx: logic<12> = imem_addr[13:2];
    let fw_iptw_lo : logic<12> = {iptw_addr[13:3], 1'b0};
    let fw_iptw_hi : logic<12> = {iptw_addr[13:3], 1'b1};

    // ============================================================
    // Write-first forwarding for DRAM
    // ============================================================
    var fwd_lo: logic<32>;
    var fwd_hi: logic<32>;
    always_comb {
        fwd_lo = dram[dram_dmem_lo];
        fwd_hi = dram[dram_dmem_hi];
        if dmem_wen && dmem_in_dram {
            if dmem_wstrb[0] {
                fwd_lo[7:0] = dmem_wdata[7:0];
            }
            if dmem_wstrb[1] {
                fwd_lo[15:8] = dmem_wdata[15:8];
            }
            if dmem_wstrb[2] {
                fwd_lo[23:16] = dmem_wdata[23:16];
            }
            if dmem_wstrb[3] {
                fwd_lo[31:24] = dmem_wdata[31:24];
            }
            if dmem_wstrb[4] {
                fwd_hi[7:0] = dmem_wdata[39:32];
            }
            if dmem_wstrb[5] {
                fwd_hi[15:8] = dmem_wdata[47:40];
            }
            if dmem_wstrb[6] {
                fwd_hi[23:16] = dmem_wdata[55:48];
            }
            if dmem_wstrb[7] {
                fwd_hi[31:24] = dmem_wdata[63:56];
            }
        }
    }

    // ============================================================
    // Instruction memory read (32-bit)
    // ============================================================
    assign imem_rdata = if imem_in_fw ? fw_rom[fw_imem_idx] : if imem_addr[31] ? dram[dram_imem_idx] : 32'd0;

    // ============================================================
    // Instruction PTW read (64-bit) with write forwarding
    // ============================================================
    let iptw_lo: logic<32> = if iptw_in_dram && dmem_wen && dmem_in_dram && dram_iptw_lo == dram_dmem_lo ?
        fwd_lo
    : if iptw_in_dram && dmem_wen && dmem_in_dram && dram_iptw_lo == dram_dmem_hi ?
        fwd_hi
    : if iptw_in_dram ?
        dram[dram_iptw_lo]
    : if iptw_in_fw ?
        fw_rom[fw_iptw_lo]
    :
        32'd0
    ;
    let iptw_hi: logic<32> = if iptw_in_dram && dmem_wen && dmem_in_dram && dram_iptw_hi == dram_dmem_lo ?
        fwd_lo
    : if iptw_in_dram && dmem_wen && dmem_in_dram && dram_iptw_hi == dram_dmem_hi ?
        fwd_hi
    : if iptw_in_dram ?
        dram[dram_iptw_hi]
    : if iptw_in_fw ?
        fw_rom[fw_iptw_hi]
    :
        32'd0
    ;
    assign iptw_rdata = {iptw_hi, iptw_lo};

    // ============================================================
    // Data memory read (64-bit, no write forwarding for dmem self-read)
    // ============================================================
    assign dmem_rdata = if dmem_in_dram ?
        {dram[dram_dmem_hi], dram[dram_dmem_lo]}
    : if dmem_addr[31:14] == 18'd0 ?
        {fw_rom[{dmem_addr[13:3], 1'b1}], fw_rom[{dmem_addr[13:3], 1'b0}]}
    :
        64'd0
    ;

    // ============================================================
    // Data memory write (byte-strobe, DRAM only)
    // ============================================================
    always_ff (clk, rst) {
        if_reset {} else if dmem_wen && dmem_in_dram {
            if dmem_wstrb[0] {
                dram[dram_dmem_lo][7:0] = dmem_wdata[7:0];
            }
            if dmem_wstrb[1] {
                dram[dram_dmem_lo][15:8] = dmem_wdata[15:8];
            }
            if dmem_wstrb[2] {
                dram[dram_dmem_lo][23:16] = dmem_wdata[23:16];
            }
            if dmem_wstrb[3] {
                dram[dram_dmem_lo][31:24] = dmem_wdata[31:24];
            }
            if dmem_wstrb[4] {
                dram[dram_dmem_hi][7:0] = dmem_wdata[39:32];
            }
            if dmem_wstrb[5] {
                dram[dram_dmem_hi][15:8] = dmem_wdata[47:40];
            }
            if dmem_wstrb[6] {
                dram[dram_dmem_hi][23:16] = dmem_wdata[55:48];
            }
            if dmem_wstrb[7] {
                dram[dram_dmem_hi][31:24] = dmem_wdata[63:56];
            }
        }
    }

    // ============================================================
    // UART output trace + periodic PC trace
    // ============================================================
    var cycle_cnt: logic<32>;
    var prev_tp  : logic<64>;
    var first_trap_seen: logic;
    var first_trap_cy  : logic<32>;
    var first_trap_pc  : logic<64>;
    var first_trap_cause: logic<64>;
    var first_trap_x3  : logic<64>;
    var trap_total     : logic<32>;
    var gp_high_cy     : logic<32>;
    var gp_high_seen   : logic;
    var pc_27208_cy    : logic<32>;
    var pc_27208_seen  : logic;
    always_ff (clk, rst) {
        if_reset {
            cycle_cnt = 0;
            prev_tp   = 0;
            jalr_mispred_cnt = 32'd0;
            jalr_mispred_ret_cnt = 32'd0;
            jalr_mispred_ind_cnt = 32'd0;
            first_trap_seen = 1'b0;
            first_trap_cy   = 32'd0;
            first_trap_pc   = 64'd0;
            first_trap_cause= 64'd0;
            first_trap_x3   = 64'd0;
            trap_total      = 32'd0;
            gp_high_cy      = 32'd0;
            gp_high_seen    = 1'b0;
            pc_27208_cy     = 32'd0;
            pc_27208_seen   = 1'b0;
        } else {
            cycle_cnt = cycle_cnt + 1;
            if trap_taken_dbg {
                trap_total = trap_total + 32'd1;
                if !first_trap_seen {
                    first_trap_seen  = 1'b1;
                    first_trap_cy    = cycle_cnt;
                    first_trap_pc    = trap_pc_dbg;
                    first_trap_cause = trap_cause_dbg;
                    first_trap_x3    = dbg_regs[3];
                }
            }
            // Capture first cycle gp becomes high-half (bit 63 set)
            if dbg_regs[3][63] == 1'b1 && !gp_high_seen {
                gp_high_seen = 1'b1;
                gp_high_cy   = cycle_cnt;
            }
            // Capture first cycle PC reaches the v4-trapping VA 0xffffffff80027208
            if dbg_pc == 64'hffffffff80027208 && !pc_27208_seen {
                pc_27208_seen = 1'b1;
                pc_27208_cy   = cycle_cnt;
            }
            // Periodic trap state dump
            if cycle_cnt[15:0] == 16'd0 {
                $display("v1tr [%d] first_trap_seen=%b cy=%h pc=%h cause=%h x3@trap=%h total=%h",
                          cycle_cnt, first_trap_seen, first_trap_cy, first_trap_pc,
                          first_trap_cause, first_trap_x3, trap_total);
                $display("v1tr   gp_high_seen=%b cy=%h pc_27208_seen=%b cy=%h current_x3=%h",
                          gp_high_seen, gp_high_cy, pc_27208_seen, pc_27208_cy, dbg_regs[3]);
            }
            if jalr_mispred_pulse {
                jalr_mispred_cnt = jalr_mispred_cnt + 32'd1;
            }
            if jalr_mispred_return {
                jalr_mispred_ret_cnt = jalr_mispred_ret_cnt + 32'd1;
            }
            if jalr_mispred_indirec {
                jalr_mispred_ind_cnt = jalr_mispred_ind_cnt + 32'd1;
            }
            if uart_tx {
                $write("%c", uart_data);
            }
            // Periodic trace
            if cycle_cnt[19:0] == 20'd0 {
                $display("  [%d] PC=%h", cycle_cnt, dbg_pc);
            }
        }
    }

    // ============================================================
    // Debug outputs
    // ============================================================
    assign o_r1   = dbg_regs[9]; // x9
    assign o_r2   = dbg_regs[11]; // x11
    assign o_r3   = dbg_r3; // x3 (0xAA=success)
    assign o_pass = dbg_r3 == 64'hAA;
    assign o_lq_issue_cnt = lq_issue_cnt;
    assign o_lq_alloc_cnt = lq_alloc_cnt;
    assign o_lq_mshr_cnt  = lq_mshr_cnt;
    assign o_sb_fwd_hit_cnt      = sb_fwd_hit_cnt;
    assign o_sb_fwd_partial_cnt  = sb_fwd_partial_cnt;
    assign o_sb_fwd_mismatch_cnt = sb_fwd_mismatch_cnt;
    assign o_jalr_mispred_cnt    = jalr_mispred_cnt;
    assign o_jalr_mispred_ret    = jalr_mispred_ret_cnt;
    assign o_jalr_mispred_ind    = jalr_mispred_ind_cnt;

    // M9.A.244 (2026-05-26): mirror v4's L0 PTE @0x80a89ff0 trace on v1.
    // Lets us pin __set_fixmap caller's a2 (= phys arg) at the populate
    // store and compare against v4 (which calls with a2=0 / clear path).
    var trace_cy_v1: logic<32>;
    always_ff (clk, rst) {
        if_reset {
            trace_cy_v1 = 32'd0;
        } else {
            trace_cy_v1 = trace_cy_v1 + 32'd1;
        }
    }
    // M9.A.250: trace __set_fixmap entry args on v1.
    let sfx_v1: logic = dbg_pc == 64'hffffffff80003dd6;
    var sfx_seen_v1: logic;
    always_ff (clk, rst) {
        if_reset {
            sfx_seen_v1 = 1'b0;
        } else if sfx_v1 && !sfx_seen_v1 {
            $display("[v1 __set_fixmap entry] cy=%d a0=%h a1=%h a2=%h",
                      trace_cy_v1, dbg_regs[10], dbg_regs[11], dbg_regs[12]);
            sfx_seen_v1 = 1'b1;
        } else if !sfx_v1 {
            sfx_seen_v1 = 1'b0;
        }
    }

    // M9.A.249: track get_pmd_virt_fixmap return value on v1 to diff
    // against v4 (which returned vmemmap VA = 0xffffffcefeffe000).
    let pmd_ret_v1: logic = dbg_pc == 64'hffffffff8020331e;
    var pmd_seen_v1: logic;
    always_ff (clk, rst) {
        if_reset {
            pmd_seen_v1 = 1'b0;
        } else if pmd_ret_v1 && !pmd_seen_v1 {
            $display("[v1 get_pmd_virt_fixmap pc=8020331e] cy=%d a0=%h s0=%h s5=%h s1=%h",
                      trace_cy_v1, dbg_regs[10], dbg_regs[8], dbg_regs[21], dbg_regs[9]);
            pmd_seen_v1 = 1'b1;
        } else if !pmd_ret_v1 {
            pmd_seen_v1 = 1'b0;
        }
    }

    // M9.A.245 mirror on v1: track create_pgd_mapping entry args.
    let cpm_entry_v1: logic = dbg_pc == 64'hffffffff80202f76;
    var cpm_seen_v1 : logic;
    always_ff (clk, rst) {
        if_reset {
            cpm_seen_v1 = 1'b0;
        } else if cpm_entry_v1 && !cpm_seen_v1 {
            $display("[v1 create_pgd_mapping] cy=%d pgdp=%h va=%h pa=%h sz=%h prot=%h ra=%h",
                      trace_cy_v1, dbg_regs[10], dbg_regs[11], dbg_regs[12],
                      dbg_regs[13], dbg_regs[14], dbg_regs[1]);
            cpm_seen_v1 = 1'b1;
        } else if !cpm_entry_v1 {
            cpm_seen_v1 = 1'b0;
        }
    }

    let target_hit_v1: logic = (dmem_wen || dmem_ren) && (dmem_addr == 64'h0000000080a89ff0);
    always_ff (clk, rst) {
        if_reset {} else if target_hit_v1 {
            $display("[v1 L0 PTE @0x80a89ff0] cy=%d wen=%b ren=%b wdata=%h wstrb=%h rdata=%h pc=%h a0=%h a1=%h a2=%h a3=%h a4=%h",
                      trace_cy_v1, dmem_wen, dmem_ren, dmem_wdata, dmem_wstrb, dmem_rdata,
                      dbg_pc, dbg_regs[10], dbg_regs[11], dbg_regs[12], dbg_regs[13], dbg_regs[14]);
        }
    }
}

#[test(test_linux_boot)]
#[ignore]
module test_linux_boot {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen(clk);

    var pass: logic    ;
    var r1  : logic<64>;
    var r2  : logic<64>;
    var r3  : logic<64>;
    var lq_issue_cnt: logic<32>;
    var lq_alloc_cnt: logic<32>;
    var lq_mshr_cnt : logic<32>;
    var sb_fwd_hit_cnt     : logic<32>;
    var sb_fwd_partial_cnt : logic<32>;
    var sb_fwd_mismatch_cnt: logic<32>;
    var jalr_mispred_cnt_o : logic<32>;
    var jalr_mispred_ret_o : logic<32>;
    var jalr_mispred_ind_o : logic<32>;

    inst harness: test_linux_boot_harness (
        clk   : clk ,
        rst   : rst ,
        o_pass: pass,
        o_r1  : r1  ,
        o_r2  : r2  ,
        o_r3  : r3  ,
        o_lq_issue_cnt: lq_issue_cnt,
        o_lq_alloc_cnt: lq_alloc_cnt,
        o_lq_mshr_cnt : lq_mshr_cnt ,
        o_sb_fwd_hit_cnt     : sb_fwd_hit_cnt     ,
        o_sb_fwd_partial_cnt : sb_fwd_partial_cnt ,
        o_sb_fwd_mismatch_cnt: sb_fwd_mismatch_cnt,
        o_jalr_mispred_cnt   : jalr_mispred_cnt_o ,
        o_jalr_mispred_ret   : jalr_mispred_ret_o ,
        o_jalr_mispred_ind   : jalr_mispred_ind_o ,
    );

    initial {
        rst.assert(clk);
        // Boot completes at ~31M cycles; poll in 10k-cycle chunks so a
        // successful boot exits early (Verilator tb does the same via
        // per-cycle `if (pass) break`). 50M total is the hard ceiling.
        for _i in 0..5000 {
            clk.next(10_000);
            if pass {
                break;
            }
        }
        $display("x9=%h x11=%h x3=%h pass=%b lq: alloc=%d mshr=%d issue_cyc=%d", r1, r2, r3, pass, lq_alloc_cnt, lq_mshr_cnt, lq_issue_cnt);
        // First-trap diag is dumped periodically inside the harness module
        $display("sb_fwd: hit=%d partial=%d mismatch=%d", sb_fwd_hit_cnt, sb_fwd_partial_cnt, sb_fwd_mismatch_cnt);
        $display("jalr_mispred: total=%d return=%d indirect=%d", jalr_mispred_cnt_o, jalr_mispred_ret_o, jalr_mispred_ind_o);
        $assert (pass, "Real Linux boot: expected x3=0xAA (SBI SRST shutdown)");
        $display("Real Linux kernel boot test passed");
        $finish ();
    }
}
