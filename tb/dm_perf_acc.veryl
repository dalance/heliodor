// dm_perf_acc: accumulates heliodor_soc_smp's o_dm_obs (soc_pkg::DmObs).
// Counts, while i_en, the cycles each bit is 1 and prints them once at the
// rising edge of i_dump, in perf_acc's format with core id 1:
//   PERF 1 <width> <width> 0 0 0 0 0   layout line, core 1 = the Debug Module
//   PB 1 <bit> <count>                 nonzero bits only, bit 0 = LSB of DmObs
// A pulse field (dmi_rd, cmd.start, sba.done, hart.gresume) counts events, a
// level field (hart.halted, rst.hrst) counts cycles. test/gates/fire_check.py
// names the bits from the struct sources.
module dm_perf_acc (
    clk   : input clock         ,
    rst   : input reset         ,
    i_obs : input soc_pkg::DmObs,
    i_en  : input logic         ,
    i_dump: input logic         ,
) {
    const W: u32 = $bits(soc_pkg::DmObs);

    var bits: logic<W>;
    assign bits = i_obs;

    var dump_q: logic;
    always_ff {
        if_reset {
            dump_q = 1'b0;
        } else {
            dump_q = i_dump;
        }
    }
    let dump: logic = i_dump && !dump_q;

    always_ff {
        if_reset {} else if dump {
            $display("PERF 1 %d %d 0 0 0 0 0", W, W);
        }
    }

    for i in 0..W :g_bit {
        var cnt: logic<64>;
        always_ff {
            if_reset {
                cnt = 64'd0;
            } else if i_en && bits[i] {
                cnt = cnt + 64'd1;
            }
        }
        always_ff {
            if_reset {} else if dump && cnt != 64'd0 {
                $display("PB 1 %d %d", i, cnt);
            }
        }
    }
}
