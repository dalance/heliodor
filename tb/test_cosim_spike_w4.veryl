// W4 copies of the N=1 boots, hvlinux and the multi-hart runs in
// test_cosim_spike.veryl, with the same harness parameters as the W4 gates of
// the same images.

#[test(test_cosim_spike_w4_linux_boot)]
#[ignore]
module test_cosim_spike_w4_linux_boot {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var pass   : logic    ;
    var fail   : logic    ;
    var x3     : logic<64>;
    var cycles : logic<64>;
    var instret: logic<64>;
    var last_pc: logic<64>;
    inst h: boot_soc_harness #(
        FW_HEX  : "test/hex/linux_boot_fw.hex"  ,
        DRAM_HEX: "test/hex/linux_dram_real.hex",
        CORE    : tb_core_sel::CORE_W4          ,
    ) (
        clk               ,
        rst               ,
        o_pass   : pass   ,
        o_fail   : fail   ,
        o_x3     : x3     ,
        o_cycles : cycles ,
        o_instret: instret,
        o_last_pc: last_pc,
        o_ret_cnt: _      ,
        o_traps  : _      ,
    );
    inst cosim: $comp::spike_cosim #(
        MAP     : "boot"                        ,
        HEX_FILE: "test/hex/linux_dram_real.hex",
        ROM_HEX : "test/hex/linux_boot_fw.hex"  ,
        TRIGGERS: 4                             ,
    ) (
        clk               ,
        rec0: h.retire[0] ,
        rec1: h.retire[1] ,
        rec2: h.retire[2] ,
        rec3: h.retire[3] ,
        irq : h.irq_evt[0],
    );
    initial {
        rst.assert(clk);
        for i in 0..3700 {
            clk.next(10000);
            if pass || fail {
                break;
            }
            if i % 100 == 99 {
                $display("cosim w4 5.15 probe: cy=%d instret=%d pc=%h", cycles, instret, last_pc);
            }
        }
        $display("cosim w4 5.15: cy=%d instret=%d x3=%h pass=%b", cycles, instret, x3, pass);
        $assert(pass, "cosim w4 5.15: did not reach SBI shutdown");
        $finish();
    }
}

