        clk              ,
        rst              ,
        o_pass   : pass  ,
        o_fail   : fail  ,
        o_x3     : _     ,
        o_cycles : cycles,
        o_instret: _     ,
        o_last_pc: _     ,
        o_ret_cnt: _     ,
        o_traps  : _     ,
    );
    inst cosim: $comp::spike_cosim_smp #(
        HEX_FILE : "test/coh/unc_n2.hex",
        TOHOST_PA: 64'h8000_3000        ,
        TRIGGERS : 4                    ,
    ) (
        clk,
        rec: {h.retire[7], h.retire[6], h.retire[5], h.retire[4], h.retire[3], h.retire[2], h.retire[1], h.retire[0]},
        irq: {h.irq_evt[1], h.irq_evt[0]},
    );
    initial {
        rst.assert(clk);
        for _i in 0..300 {
            clk.next(10000);
            if pass || fail {
                break;
            }
        }
        clk.next(10);
        $display("cosim w4 smp unc(N=2): cycles=%d pass=%b fail=%b", cycles, pass, fail);
        $assert(pass, "cosim w4 smp unc(N=2): fail");
        $finish();
    }
}

#[test(test_cosim_spike_w4_smp_tkt_2hart)]
