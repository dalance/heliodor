// gdb_soc_harness: N_HARTS new-core harts on heliodor_soc_smp with the
// MAP_BOOT table, a boot ROM (FW_HEX) and a 32 MiB DRAM (DRAM_HEX) in an
// AXI4 slave model, with the SoC's APB DMI port brought out for an external
// debugger. It is the harness of the riscv-tests debug suite (gdbserver.py):
// the Verilator wrapper sim/verilator/tb_soc_dm.sv puts the tb-only JTAG
// DTM in front of the APB port.
//
// There is no pass condition: the run lasts as long as the debugger. o_fail
// is sticky: a core checker, chk_dm, the retire contract or an AXI protocol
// flag of any hart (o_chk is hart 0's monitor flags, o_fail_h the failing
// harts). The rising edge of i_dump prints the firing counters of every
// hart, mem_ctrl and the Debug Module (perf_acc, mc_perf_acc, dm_perf_acc).
module gdb_soc_harness #(
    param N_HARTS : u32                   = 1                             ,
    param FW_HEX  : string                = "test/debug/gg/gg_rom.hex"    ,
    param DRAM_HEX: string                = "test/debug/gg/gg_dram.hex"   ,
    param CORE    : soc_pkg::CoreSel      = soc_pkg::CoreSel::W2          ,
    param AXI_CFG : axi4_tb_pkg::SlaveCfg = axi4_tb_pkg::FIXED            ,
    param AXI_SEED: bit<32>               = 32'h1                         ,
) (
    clk        : input  clock                                          ,
    rst        : input  reset                                          ,
    i_psel     : input  logic                                          ,
    i_penable  : input  logic                                          ,
    i_pwrite   : input  logic                                          ,
    i_paddr    : input  logic<9>                                       ,
    i_pwdata   : input  logic<32>                                      ,
    i_pstrb    : input  logic<4>                                       ,
    o_pready   : output logic                                          ,
    o_prdata   : output logic<32>                                      ,
    o_pslverr  : output logic                                          ,
    i_dump     : input  logic                                          ,
    o_fail     : output logic                                          ,
    o_fail_h   : output logic<N_HARTS>                                 ,
    o_chk      : output logic<14 + soc_pkg::CHK_W + retire_pkg::CHK_RET_W>,
    o_instret  : output logic<64>                                      ,
) {
    const RL: u32 = soc_pkg::RET_LANES;
    const MW: u32 = 14 + soc_pkg::CHK_W + retire_pkg::CHK_RET_W;
    const IW: u32 = $clog2(N_HARTS * 2 + 1);
    const WB: u32 = 2 * N_HARTS;

    var axi_arvalid: logic                     ;
    var axi_arready: logic                     ;
    var axi_arid   : logic<IW>                 ;
    var axi_araddr : logic<56>                 ;
    var axi_arlen  : logic<8>                  ;
    var axi_arsize : logic<3>                  ;
    var axi_arburst: logic<2>                  ;
    var axi_rvalid : logic                     ;
    var axi_rready : logic                     ;
    var axi_rid    : logic<IW>                 ;
    var axi_rdata  : logic<64>                 ;
    var axi_rresp  : logic<2>                  ;
    var axi_rlast  : logic                     ;
    var axi_awvalid: logic                     ;
    var axi_awready: logic                     ;
    var axi_awid   : logic<IW>                 ;
    var axi_awaddr : logic<56>                 ;
    var axi_awlen  : logic<8>                  ;
    var axi_awsize : logic<3>                  ;
    var axi_awburst: logic<2>                  ;
    var axi_wvalid : logic                     ;
    var axi_wready : logic                     ;
    var axi_wdata  : logic<64>                 ;
    var axi_wstrb  : logic<8>                  ;
    var axi_wlast  : logic                     ;
    var axi_bvalid : logic                     ;
    var axi_bready : logic                     ;
    var axi_bid    : logic<IW>                 ;
    var axi_bresp  : logic<2>                  ;
    var axi_chk    : logic<axi4_tb_pkg::CHK_N> ;
    var axi_err    : logic<3>                  ;

    var retire   : retire_pkg::RetireRec  [N_HARTS * RL];
    var retire_dm: logic                  [N_HARTS]     ;
    var irq_evt  : retire_pkg::IrqEvent   [N_HARTS]     ;
    var core_chk : logic<soc_pkg::CHK_W>  [N_HARTS]     ;
    var core_perf: logic<soc_pkg::PERF_W> [N_HARTS]     ;
    var mc_perf  : soc_pkg::McPerf                      ;
    var uart_tx_v: logic                                ;
    var uart_tx_d: logic<8>                             ;
    var dm_obs   : soc_pkg::DmObs                       ;
    var dm_chk   : logic<13>                            ;

    inst dut: heliodor_soc_smp #(
        N_HARTS    : N_HARTS                    ,
        RESET_PC   : 64'h0000_0000              ,
        CORE       : CORE                       ,
        MTIME_SRC  : soc_pkg::MTIME_CYCLE       ,
        MTIME_DIV  : 10                         ,
        PMA_N      : tb_platform_pkg::MAP_BOOT_N,
        PMA_REGIONS: tb_platform_pkg::MAP_BOOT  ,
        AXI_WB_N   : WB                         ,
    ) (
        clk                                          ,
        rst                                          ,
        o_imem_addr          : _                     ,
        i_imem_rdata         : '{default: 32'd0}     ,
        o_imem_ren           : _                     ,
        o_iptw_addr          : _                     ,
        o_iptw_req           : _                     ,
        i_iptw_rdata         : '{default: 64'd0}     ,
        o_dmem_addr          : _                     ,
        o_dmem_wdata         : _                     ,
        o_dmem_wen           : _                     ,
        o_dmem_ren           : _                     ,
        o_dmem_wstrb         : _                     ,
        o_dmem_wdata_hi      : _                     ,
        o_dmem_wstrb_hi      : _                     ,
        o_axi_arvalid        : axi_arvalid           ,
        i_axi_arready        : axi_arready           ,
        o_axi_arid           : axi_arid              ,
        o_axi_araddr         : axi_araddr            ,
        o_axi_arlen          : axi_arlen             ,
        o_axi_arsize         : axi_arsize            ,
        o_axi_arburst        : axi_arburst           ,
        i_axi_rvalid         : axi_rvalid            ,
        o_axi_rready         : axi_rready            ,
        i_axi_rid            : axi_rid               ,
        i_axi_rdata          : axi_rdata             ,
        i_axi_rresp          : axi_rresp             ,
        i_axi_rlast          : axi_rlast             ,
        o_axi_awvalid        : axi_awvalid           ,
        i_axi_awready        : axi_awready           ,
        o_axi_awid           : axi_awid              ,
        o_axi_awaddr         : axi_awaddr            ,
        o_axi_awlen          : axi_awlen             ,
        o_axi_awsize         : axi_awsize            ,
        o_axi_awburst        : axi_awburst           ,
        o_axi_wvalid         : axi_wvalid            ,
        i_axi_wready         : axi_wready            ,
        o_axi_wdata          : axi_wdata             ,
        o_axi_wstrb          : axi_wstrb             ,
        o_axi_wlast          : axi_wlast             ,
        i_axi_bvalid         : axi_bvalid            ,
        o_axi_bready         : axi_bready            ,
        i_axi_bid            : axi_bid               ,
        i_axi_bresp          : axi_bresp             ,
        o_axi_err            : axi_err               ,
        o_uart_tx_valid      : uart_tx_v             ,
        o_uart_tx_data       : uart_tx_d             ,
        o_retire             : retire                ,
        o_retire_dm          : retire_dm             ,
        o_irq_evt            : irq_evt               ,
        o_core_chk           : core_chk              ,
        o_core_perf          : core_perf             ,
        o_mc_perf            : mc_perf               ,
        i_mtime_tick         : 1'b0                  ,
        i_ext_irq_src        : 32'd0                 ,
        i_dbg_retire_limit_en: '0                    ,
        i_dbg_retire_limit   : '0                    ,
        i_dbg_irq_mask       : '0                    ,
        i_dbg_irq_allow      : '0                    ,
        i_dm_rst             : rst                   ,
        i_dm_psel            : i_psel                ,
        i_dm_penable         : i_penable             ,
        i_dm_pwrite          : i_pwrite              ,
        i_dm_paddr           : i_paddr               ,
        i_dm_pwdata          : i_pwdata              ,
        i_dm_pstrb           : i_pstrb               ,
        i_dm_pprot           : 3'd0                  ,
        o_dm_pready          : o_pready              ,
        o_dm_prdata          : o_prdata              ,
        o_dm_pslverr         : o_pslverr             ,
        o_dm_obs             : dm_obs                ,
    );

    inst u_chk_dm: chk_dm #(
        N_HARTS: N_HARTS,
    ) (
        clk                   ,
        rst                   ,
        i_psel   : i_psel     ,
        i_penable: i_penable  ,
        i_pwrite : i_pwrite   ,
        i_paddr  : i_paddr    ,
        i_pwdata : i_pwdata   ,
        i_pstrb  : i_pstrb    ,
        i_pready : o_pready   ,
        i_obs    : dm_obs     ,
        o_chk    : dm_chk     ,
    );

    inst u_mem: axi4_mem #(
        ID_W   : IW              ,
        MEM_DW : 4194304         ,
        HEX    : DRAM_HEX        ,
        ROM_EN : 1'b1            ,
        ROM_DW : 2048            ,
        ROM_HEX: FW_HEX          ,
        CFG    : AXI_CFG         ,
        SEED   : AXI_SEED        ,
        MAX_RD : N_HARTS * 2 + 1 ,
        MAX_WR : WB              ,
    ) (
        clk                    ,
        rst                    ,
        i_arvalid: axi_arvalid ,
        o_arready: axi_arready ,
        i_arid   : axi_arid    ,
        i_araddr : axi_araddr  ,
        i_arlen  : axi_arlen   ,
        i_arsize : axi_arsize  ,
        i_arburst: axi_arburst ,
        o_rvalid : axi_rvalid  ,
        i_rready : axi_rready  ,
        o_rid    : axi_rid     ,
        o_rdata  : axi_rdata   ,
        o_rresp  : axi_rresp   ,
        o_rlast  : axi_rlast   ,
        i_awvalid: axi_awvalid ,
        o_awready: axi_awready ,
        i_awid   : axi_awid    ,
        i_awaddr : axi_awaddr  ,
        i_awlen  : axi_awlen   ,
        i_awsize : axi_awsize  ,
        i_awburst: axi_awburst ,
        i_wvalid : axi_wvalid  ,
        o_wready : axi_wready  ,
        i_wdata  : axi_wdata   ,
        i_wstrb  : axi_wstrb   ,
        i_wlast  : axi_wlast   ,
        o_bvalid : axi_bvalid  ,
        i_bready : axi_bready  ,
        o_bid    : axi_bid     ,
        o_bresp  : axi_bresp   ,
        o_chk    : axi_chk     ,
    );
    // The suite reads unmapped addresses through SBA and progbuf on purpose;
    // the SoC answers those itself, so an AXI error response is still a fault.
    let axi_bad: logic = (axi_chk != '0) || axi_err != 3'd0;

    always_ff {
        if_reset {} else if uart_tx_v {
            $write("%c", uart_tx_d);
        }
    }

    inst u_mpa: mc_perf_acc (
        clk             ,
        rst             ,
        i_perf: mc_perf ,
        i_en  : !i_dump ,
        i_dump: i_dump  ,
    );

    inst u_dpa: dm_perf_acc (
        clk            ,
        rst            ,
        i_obs : dm_obs ,
        i_en  : !i_dump,
        i_dump: i_dump ,
    );

    var h_fail: logic     [N_HARTS];
    var h_chk : logic<MW> [N_HARTS];
    var h_inst: logic<64> [N_HARTS];

    for h in 0..N_HARTS :g_hart {
        var ret: retire_pkg::RetireRec [RL];
        for l in 0..RL :g_l {
            assign ret[l] = retire[h * RL + l];
        }

        if CORE == soc_pkg::CoreSel::W4 :g_pa4 {
            inst u_pa: perf_acc::<cfg_w4> #(
                CORE_ID: 4,
            ) (
                clk                  ,
                rst                  ,
                i_perf: core_perf[h] ,
                i_en  : !i_dump      ,
                i_dump: i_dump       ,
            );
        } else {
            inst u_pa: perf_acc::<cfg_w2> #(
                CORE_ID: 2,
            ) (
                clk                  ,
                rst                  ,
                i_perf: core_perf[h] ,
                i_en  : !i_dump      ,
                i_dump: i_dump       ,
            );
        }

        // TOHOST_PA is outside every region: no store reaches it, so the
        // monitor never sees a terminal record and only its checks matter.
        inst u_mon: retire_mon #(
            LANES    : RL                       ,
            TOHOST_PA: 64'hffff_ffff_ffff_fff0  ,
            CHK_W    : 14 + soc_pkg::CHK_W      ,
            DM_OK    : 1'b1                     ,
        ) (
            clk                                                    ,
            rst                                                    ,
            i_retire       : ret                                   ,
            i_retire_dm    : retire_dm[h]                          ,
            i_irq_evt      : irq_evt[h]                            ,
            i_chk          : {axi_bad && h == 0, (if h == 0 ? dm_chk : 13'd0), core_chk[h]},
            i_hash_mismatch: 1'b0                                  ,
            i_restart      : dm_obs.rst.hrst[h]                    ,
            o_stop         : _                                     ,
            o_x3           : _                                     ,
            o_tohost       : _                                     ,
            o_pass         : _                                     ,
            o_fail         : h_fail[h]                             ,
            o_done         : _                                     ,
            o_cycles       : _                                     ,
            o_instret      : h_inst[h]                             ,
            o_last_pc      : _                                     ,
            o_ret_cnt      : _                                     ,
            o_trap_cnt     : _                                     ,
            o_chk          : h_chk[h]                              ,
        );
        assign o_fail_h[h] = h_fail[h];
    }

    always_comb {
        o_fail = 1'b0;
        for h in 0..N_HARTS {
            o_fail |= h_fail[h];
        }
    }
    assign o_chk     = h_chk[0];
    assign o_instret = h_inst[0];
}
