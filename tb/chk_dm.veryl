// chk_dm: Debug Module checker on the SoC's APB DMI port and o_dm_obs.
// Observation only; sticky flags, 0 for a clean run.
//   o_chk[0] : an ACCESS cycle not preceded by SETUP or by the same transfer
//   o_chk[1] : paddr, pwrite, pwdata or pstrb changed during a transfer
//   o_chk[2] : a completed transfer without exactly one DMI event, or a DMI
//              event outside a completion
//   o_chk[3] : a halt request to a hart that does not exist
//   o_chk[4] : an abstract command busy while its hart is not halted
//   o_chk[5] : a System Bus Access starting while one is outstanding, or a
//              completion with none outstanding
//   o_chk[6] : a hart newly halted while a running hart of its halt group
//              has no halt request
//   o_chk[7] : a RESUME flag raised for a hart that is not halted
//   o_chk[8] : a RESUME flag raised while a halted hart of the same resume
//              group has none
//   o_chk[9] : the platform entered ndmreset while mem_ctrl was not idle on
//              AXI the cycle before
//   o_chk[10]: a hart entered hartreset while its core was not quiet the
//              cycle before
//   o_chk[11]: havereset not set for a hart the cycle after it was in reset
//   o_chk[12]: a hart in reset with resethaltreq has no halt request
module chk_dm #(
    param N_HARTS: u32 = 1,
) (
    clk      : input  clock         ,
    rst      : input  reset         ,
    i_psel   : input  logic         ,
    i_penable: input  logic         ,
    i_pwrite : input  logic         ,
    i_paddr  : input  logic<9>      ,
    i_pwdata : input  logic<32>     ,
    i_pstrb  : input  logic<4>      ,
    i_pready : input  logic         ,
    i_obs    : input  soc_pkg::DmObs,
    o_chk    : output logic<13>     ,
) {
    var sel_q  : logic    ;
    var en_q   : logic    ;
    var write_q: logic    ;
    var addr_q : logic<9> ;
    var wdata_q: logic<32>;
    var strb_q : logic<4> ;
    var pready_q: logic   ;
    var chk_q  : logic<13>;
    var sba_q  : logic    ; // an SBA access is outstanding
    var hlt_q  : logic<8> ;
    var res_q  : logic<8> ;
    var ndm_q  : logic    ;
    var idle_q : logic    ;
    var hrst_q : logic<8> ;
    var quiet_q: logic<8> ;

    let in_xfer : logic = sel_q && !(en_q && pready_q);
    let access  : logic = i_psel && i_penable;
    let bad_ph  : logic = access && !(sel_q && (!en_q || !pready_q));
    let bad_hold: logic = i_psel && in_xfer && (i_pwrite != write_q || i_paddr != addr_q || i_pwdata != wdata_q
        || i_pstrb != strb_q);
    let done    : logic = access && i_pready;
    let n_evt   : logic<2> = {1'b0, i_obs.dmi_rd} + {1'b0, i_obs.dmi_wr} + {1'b0, i_obs.dmi_err};
    let bad_evt : logic = if done ? n_evt != 2'd1 : n_evt != 2'd0;
    let bad_hreq: logic = N_HARTS <: 8 && (i_obs.haltreq >> N_HARTS) != 8'd0;
    let bad_busy: logic = i_obs.cmd.busy && !i_obs.cmd.halted;
    let bad_sba : logic = (i_obs.sba.start && sba_q) || (i_obs.sba.done && !sba_q);

    let hs      : dm_pkg::HartObs = i_obs.hart;
    let hlt_rise: logic<8>        = hs.halted & ~hlt_q;
    let res_rise: logic<8>        = hs.resume & ~res_q;
    let bad_res : logic           = (res_rise & ~hs.halted) != 8'd0;
    let rs      : dm_pkg::RstObs  = i_obs.rst;
    let bad_ndm : logic           = rs.ndm && !ndm_q && !idle_q;
    let hr_rise : logic<8>        = rs.hrst & ~hrst_q & (if rs.ndm ? 8'd0 : 8'hff);
    let bad_hr  : logic           = (hr_rise & ~quiet_q) != 8'd0;
    let bad_have: logic           = (hrst_q & ~rs.havereset) != 8'd0;
    let bad_rhr : logic           = (rs.hrst & rs.resethalt & ~i_obs.haltreq) != 8'd0;
    var bad_ghlt: logic           ;
    var bad_gres: logic           ;
    always_comb {
        bad_ghlt = 1'b0;
        bad_gres = 1'b0;
        for k in 0..N_HARTS {
            for h in 0..N_HARTS {
                if hlt_rise[k] && hs.hgrp[k * 4+:4] != 4'd0 && hs.hgrp[h * 4+:4] == hs.hgrp[k * 4+:4] && !hs.halted[h]
                    && !i_obs.haltreq[h] {
                    bad_ghlt = 1'b1;
                }
                if res_rise[k] && hs.rgrp[k * 4+:4] != 4'd0 && hs.rgrp[h * 4+:4] == hs.rgrp[k * 4+:4] && hs.halted[h]
                    && !hs.resume[h] {
                    bad_gres = 1'b1;
                }
            }
        }
    }

    always_ff {
        if_reset {
            sel_q      = 1'b0;
            en_q       = 1'b0;
            write_q    = 1'b0;
            addr_q     = 9'd0;
            wdata_q    = 32'd0;
            strb_q     = 4'd0;
            pready_q   = 1'b0;
            chk_q      = 13'd0;
            sba_q      = 1'b0;
            hlt_q      = 8'd0;
            res_q      = 8'd0;
            ndm_q      = 1'b0;
            idle_q     = 1'b0;
            hrst_q     = 8'd0;
            quiet_q    = 8'd0;
        } else {
            sel_q      = i_psel;
            en_q       = i_penable;
            write_q    = i_pwrite;
            addr_q     = i_paddr;
            wdata_q    = i_pwdata;
            strb_q     = i_pstrb;
            pready_q = i_pready;
            chk_q      = chk_q | {bad_rhr, bad_have, bad_hr, bad_ndm, bad_gres, bad_res, bad_ghlt, bad_sba, bad_busy, bad_hreq,
                bad_evt, bad_hold, bad_ph};
            sba_q      = (sba_q && !i_obs.sba.done) || i_obs.sba.start;
            hlt_q      = hs.halted;
            res_q      = hs.resume;
            ndm_q      = rs.ndm;
            idle_q     = rs.idle;
            hrst_q     = rs.hrst;
            quiet_q    = rs.quiet;
        }
    }
    assign o_chk = chk_q;
}
