// SMP Linux boot test (heliodor_soc).
//
// Stage K1: instantiate heliodor_soc with N_HARTS=1 and replay the existing
//          single-hart Linux boot. Validates the SoC wrapper + memory_bus
//          path before flipping to multi-hart.
// Stage K6: switch N_HARTS to 2 (and use linux_dram_real_2hart.hex when
//          available) once the SBI HSM hart_start path lands. For now hart
//          1 boots straight into _secondary_park and waits forever.
//
// Memory map: same as test_linux_boot. DRAM is a single 32 MB array; both
// harts read it concurrently (multi-port read), but only hart 0 writes
// (hart 1 stays in wfi parking).
// heliodor_soc is hardcoded for 2 harts; this harness mirrors that.
module test_linux_boot_smp_harness #(
    param N_HARTS: u32 = 2,
) (
    clk             : input  clock,
    rst             : input  reset,
    o_pass          : output logic    ,
    o_dbg_r3        : output logic<64>,
    o_dbg_pc0       : output logic<64>,
    o_dbg_pc1       : output logic<64>,
    o_h1_kernel_seen: output logic    ,
    o_h1_retire_cnt : output logic<32>,
) {
    // Per-hart bundles
    var imem_addr : logic<64> [N_HARTS];
    var imem_rdata: logic<32> [N_HARTS];
    var imem_ren  : logic     [N_HARTS];
    var iptw_addr : logic<64> [N_HARTS];
    var iptw_req  : logic     [N_HARTS];
    var iptw_rdata: logic<64> [N_HARTS];
    var dmem_addr : logic<64> [N_HARTS];
    var dmem_wdata: logic<64> [N_HARTS];
    var dmem_rdata: logic<64> [N_HARTS];
    var dmem_wen  : logic     [N_HARTS];
    var dmem_ren  : logic     [N_HARTS];
    var dmem_wstrb: logic<8>  [N_HARTS];

    var uart_tx     : logic   ;
    var uart_data   : logic<8>;
    var h0_x3       : logic<64>;
    var h0_pc       : logic<64>;
    var h1_pc       : logic<64>;
    var h1_instret  : logic   ;

    inst dut: heliodor_soc #(
        RESET_PC: 0,
    ) (
        clk                            ,
        rst                            ,
        o_imem_addr     : imem_addr    ,
        i_imem_rdata    : imem_rdata   ,
        o_imem_ren      : imem_ren     ,
        o_iptw_addr     : iptw_addr    ,
        o_iptw_req      : iptw_req     ,
        i_iptw_rdata    : iptw_rdata   ,
        o_dmem_addr     : dmem_addr    ,
        o_dmem_wdata    : dmem_wdata   ,
        i_dmem_rdata    : dmem_rdata   ,
        o_dmem_wen      : dmem_wen     ,
        o_dmem_ren      : dmem_ren     ,
        o_dmem_wstrb    : dmem_wstrb   ,
        i_ext_irq       : 32'd0        ,
        o_uart_tx       : uart_tx      ,
        o_uart_data     : uart_data    ,
        i_uart_rx_data  : 8'd0         ,
        i_uart_rx_valid : 1'b0         ,
        o_dbg_h0_x3     : h0_x3        ,
        o_dbg_h0_pc     : h0_pc        ,
        o_dbg_h1_pc     : h1_pc        ,
        o_dbg_h1_instret: h1_instret   ,
    );

    // Track whether hart 1 ever entered kernel address space (>= 0x80000000)
    // and how many instructions it retired there.
    var h1_kernel_seen : logic    ;
    var h1_retire_cnt  : logic<32>;
    always_ff (clk, rst) {
        if_reset {
            h1_kernel_seen = 1'b0;
            h1_retire_cnt  = 32'd0;
        } else {
            if h1_pc[31] {
                h1_kernel_seen = 1'b1;
            }
            if h1_instret {
                h1_retire_cnt = h1_retire_cnt + 32'd1;
            }
        }
    }

    // ============================================================
    // Memory arrays — shared firmware ROM and DRAM
    // ============================================================
    var fw_rom: logic<32> [4096]   ;
    var dram  : logic<32> [8388608];

    initial {
        $readmemh("test/hex/linux_boot_fw.hex", fw_rom);
        $readmemh("test/hex/linux_dram_real_2hart.hex", dram);
    }

    // hart 0 drives DRAM writes (hart 1 is parked → no writes during boot)
    let h0_dmem_addr : logic<64> = dmem_addr[0];
    let h0_dmem_wdata: logic<64> = dmem_wdata[0];
    let h0_dmem_wen  : logic     = dmem_wen[0];
    let h0_dmem_wstrb: logic<8>  = dmem_wstrb[0];
    let h0_dmem_in_dram: logic   = h0_dmem_addr[31];
    let h0_dram_lo   : logic<23> = {h0_dmem_addr[24:3], 1'b0};
    let h0_dram_hi   : logic<23> = {h0_dmem_addr[24:3], 1'b1};

    always_ff (clk, rst) {
        if_reset {} else if h0_dmem_wen && h0_dmem_in_dram {
            if h0_dmem_wstrb[0] { dram[h0_dram_lo][7:0]   = h0_dmem_wdata[7:0]; }
            if h0_dmem_wstrb[1] { dram[h0_dram_lo][15:8]  = h0_dmem_wdata[15:8]; }
            if h0_dmem_wstrb[2] { dram[h0_dram_lo][23:16] = h0_dmem_wdata[23:16]; }
            if h0_dmem_wstrb[3] { dram[h0_dram_lo][31:24] = h0_dmem_wdata[31:24]; }
            if h0_dmem_wstrb[4] { dram[h0_dram_hi][7:0]   = h0_dmem_wdata[39:32]; }
            if h0_dmem_wstrb[5] { dram[h0_dram_hi][15:8]  = h0_dmem_wdata[47:40]; }
            if h0_dmem_wstrb[6] { dram[h0_dram_hi][23:16] = h0_dmem_wdata[55:48]; }
            if h0_dmem_wstrb[7] { dram[h0_dram_hi][31:24] = h0_dmem_wdata[63:56]; }
        }
    }

    // Per-hart memory read paths (combinational reads — both harts can read
    // independently every cycle).
    for h in 0..N_HARTS: gen_mem {
        let imem_in_fw   : logic     = imem_addr[h][31:14] == 18'd0;
        let imem_in_dram : logic     = imem_addr[h][31];
        let dram_imem_idx: logic<23> = imem_addr[h][24:2];
        let fw_imem_idx  : logic<12> = imem_addr[h][13:2];
        assign imem_rdata[h] = if imem_in_fw   ? fw_rom[fw_imem_idx]
                            : if imem_in_dram ? dram[dram_imem_idx]
                            : 32'd0;

        let iptw_in_fw   : logic     = iptw_addr[h][31:14] == 18'd0;
        let iptw_in_dram : logic     = iptw_addr[h][31];
        let dram_iptw_lo : logic<23> = {iptw_addr[h][24:3], 1'b0};
        let dram_iptw_hi : logic<23> = {iptw_addr[h][24:3], 1'b1};
        let fw_iptw_lo   : logic<12> = {iptw_addr[h][13:3], 1'b0};
        let fw_iptw_hi   : logic<12> = {iptw_addr[h][13:3], 1'b1};
        let iptw_lo: logic<32> = if iptw_in_dram ? dram[dram_iptw_lo]
                              : if iptw_in_fw   ? fw_rom[fw_iptw_lo]
                              : 32'd0;
        let iptw_hi: logic<32> = if iptw_in_dram ? dram[dram_iptw_hi]
                              : if iptw_in_fw   ? fw_rom[fw_iptw_hi]
                              : 32'd0;
        assign iptw_rdata[h] = {iptw_hi, iptw_lo};

        let dmem_in_dram : logic     = dmem_addr[h][31];
        let dmem_in_fw   : logic     = dmem_addr[h][31:14] == 18'd0;
        let dram_dmem_lo : logic<23> = {dmem_addr[h][24:3], 1'b0};
        let dram_dmem_hi : logic<23> = {dmem_addr[h][24:3], 1'b1};
        let fw_dmem_lo   : logic<12> = {dmem_addr[h][13:3], 1'b0};
        let fw_dmem_hi   : logic<12> = {dmem_addr[h][13:3], 1'b1};
        assign dmem_rdata[h] = if dmem_in_dram ? {dram[dram_dmem_hi], dram[dram_dmem_lo]}
                            : if dmem_in_fw   ? {fw_rom[fw_dmem_hi], fw_rom[fw_dmem_lo]}
                            : 64'd0;
    }

    // ============================================================
    // Pass criterion: hart 0 reaches the SBI shutdown convention.
    // dbg surface is hart-0/-1 PC + a passthrough SoC-internal x3.
    // The SoC doesn't currently surface dbg_r3, so reuse uart_data as a
    // boot-progress hint (any UART output → boot is making progress).
    // For Stage K1 we just observe a cycle window.
    // ============================================================
    var cycle_cnt: logic<32>;
    always_ff (clk, rst) {
        if_reset {
            cycle_cnt = 0;
        } else {
            cycle_cnt = cycle_cnt + 1;
        }
    }

    // UART output trace — print every byte the firmware/kernel writes to UART.
    always_ff (clk, rst) {
        if_reset {
        } else {
            if uart_tx {
                $write("%c", uart_data);
            }
        }
    }

    assign o_dbg_r3        = h0_x3;
    assign o_dbg_pc0       = h0_pc;
    assign o_dbg_pc1       = h1_pc;
    assign o_h1_kernel_seen = h1_kernel_seen;
    assign o_h1_retire_cnt  = h1_retire_cnt;
    // Pass: hart 0 wrote 0xAA to x3 (SBI shutdown convention from Linux).
    assign o_pass = h0_x3 == 64'h00000000000000aa;
}

#[test(test_linux_boot_smp2)]
#[ignore]
module test_linux_boot_smp2 {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen(clk);

    var pass      : logic    ;
    var r3        : logic<64>;
    var pc0       : logic<64>;
    var pc1       : logic<64>;
    var h1_seen   : logic    ;
    var h1_retired: logic<32>;

    inst harness: test_linux_boot_smp_harness (
        clk             : clk        ,
        rst             : rst        ,
        o_pass          : pass       ,
        o_dbg_r3        : r3         ,
        o_dbg_pc0       : pc0        ,
        o_dbg_pc1       : pc1        ,
        o_h1_kernel_seen: h1_seen    ,
        o_h1_retire_cnt : h1_retired ,
    );

    initial {
        rst.assert(clk);
        // Wait for SBI shutdown OR until hart 1 has retired ≥1024 kernel
        // instructions (proxy for "secondary CPU online and running").
        for _i in 0..15000 {
            clk.next(10000);
            if pass {
                break;
            }
        }
        $display("test_linux_boot_smp2 r3=%h pass=%d hart1_pc=%h hart1_kernel=%d hart1_retired=%d",
                 r3, pass, pc1, h1_seen, h1_retired);
        $assert (pass, "heliodor_soc N=2 Linux boot failed");
        $display("test_linux_boot_smp2 boot passed");
        $finish ();
    }
}
