// SMP Linux boot test (heliodor_soc).
//
// Stage K1: instantiate heliodor_soc with N_HARTS=1 and replay the existing
//          single-hart Linux boot. Validates the SoC wrapper + memory_bus
//          path before flipping to multi-hart.
// Stage K6: switch N_HARTS to 2 (and use linux_dram_real_2hart.hex when
//          available) once the SBI HSM hart_start path lands. For now hart
//          1 boots straight into _secondary_park and waits forever.
//
// Memory map: same as test_linux_boot. DRAM is a single 32 MB array; both
// harts read it concurrently (multi-port read), but only hart 0 writes
// (hart 1 stays in wfi parking).
// heliodor_soc is hardcoded for 2 harts; this harness mirrors that.
module test_linux_boot_smp_harness #(
    param N_HARTS: u32 = 2,
) (
    clk             : input  clock,
    rst             : input  reset,
    o_pass          : output logic    ,
    o_dbg_r3        : output logic<64>,
    o_dbg_pc0       : output logic<64>,
    o_dbg_pc1       : output logic<64>,
    o_h1_kernel_seen: output logic    ,
    o_h1_retire_cnt : output logic<32>,
    o_h1_callin     : output logic    ,
    o_h1_notify     : output logic    ,
    o_h1_set_online : output logic    ,
    o_h1_complete   : output logic    ,
) {
    // Per-hart bundles (imem and iptw stay per-hart for now — Phase 5-A
    // only consolidates the dcache path. dmem is now a single shared
    // port driven by memory_bus inside heliodor_soc.)
    var imem_addr : logic<64> [N_HARTS];
    var imem_rdata: logic<32> [N_HARTS];
    var imem_ren  : logic     [N_HARTS];
    var iptw_addr : logic<64> [N_HARTS];
    var iptw_req  : logic     [N_HARTS];
    var iptw_rdata: logic<64> [N_HARTS];
    // Single shared DRAM port (Phase 5)
    var dmem_addr : logic<64>;
    var dmem_wdata: logic<64>;
    var dmem_rdata: logic<64>;
    var dmem_wen  : logic    ;
    var dmem_ren  : logic    ;
    var dmem_wstrb: logic<8> ;

    var uart_tx     : logic   ;
    var uart_data   : logic<8>;
    var h0_x3       : logic<64>;
    var h0_pc       : logic<64>;
    var h1_pc       : logic<64>;
    var h1_instret  : logic   ;
    var h1_sw_irq   : logic   ;
    var h0_sw_irq   : logic   ;
    var clint_wen   : logic    ;
    var clint_addr  : logic<16>;
    var clint_wdata : logic<64>;
    var h0_inv_valid: logic    ;
    var h1_inv_valid: logic    ;
    var h0_trap_taken: logic    ;
    var h0_trap_cause: logic<64>;
    var h1_trap_taken: logic    ;
    var h1_trap_cause: logic<64>;
    var h0_mmio_wen   : logic    ;
    var h0_mmio_paddr : logic<32>;
    var h0_clint_sel  : logic    ;
    var h1_mmio_wen   : logic    ;
    var h1_mmio_paddr : logic<32>;
    var h1_clint_sel  : logic    ;
    var h0_mmio_grant : logic    ;
    var h1_mmio_grant : logic    ;
    var h0_dmem_addr  : logic<64>;
    var h0_dmem_wen   : logic    ;
    var h0_dmem_ren   : logic    ;
    var h0_dmem_wdata : logic<64>;
    var h1_dmem_addr  : logic<64>;
    var h1_dmem_wen   : logic    ;
    var h1_dmem_ren   : logic    ;
    var h1_dmem_wdata : logic<64>;
    var h0_grant_total: logic<32>;
    var h1_grant_total: logic<32>;
    var clint_wen_total: logic<32>;

    inst dut: heliodor_soc #(
        RESET_PC: 0,
    ) (
        clk                            ,
        rst                            ,
        o_imem_addr     : imem_addr    ,
        i_imem_rdata    : imem_rdata   ,
        o_imem_ren      : imem_ren     ,
        o_iptw_addr     : iptw_addr    ,
        o_iptw_req      : iptw_req     ,
        i_iptw_rdata    : iptw_rdata   ,
        o_dmem_addr     : dmem_addr    ,
        o_dmem_wdata    : dmem_wdata   ,
        i_dmem_rdata    : dmem_rdata   ,
        o_dmem_wen      : dmem_wen     ,
        o_dmem_ren      : dmem_ren     ,
        o_dmem_wstrb    : dmem_wstrb   ,
        i_ext_irq       : 32'd0        ,
        o_uart_tx       : uart_tx      ,
        o_uart_data     : uart_data    ,
        i_uart_rx_data  : 8'd0         ,
        i_uart_rx_valid : 1'b0         ,
        o_dbg_h0_x3     : h0_x3        ,
        o_dbg_h0_pc     : h0_pc        ,
        o_dbg_h1_pc     : h1_pc        ,
        o_dbg_h1_instret: h1_instret   ,
        o_dbg_h1_sw_irq : h1_sw_irq    ,
        o_dbg_h0_sw_irq : h0_sw_irq    ,
        o_dbg_clint_wen : clint_wen    ,
        o_dbg_clint_addr: clint_addr   ,
        o_dbg_clint_wdata: clint_wdata ,
        o_dbg_h0_inv_valid: h0_inv_valid,
        o_dbg_h1_inv_valid: h1_inv_valid,
        o_dbg_h0_trap_taken: h0_trap_taken,
        o_dbg_h0_trap_cause: h0_trap_cause,
        o_dbg_h1_trap_taken: h1_trap_taken,
        o_dbg_h1_trap_cause: h1_trap_cause,
        o_dbg_h0_mmio_wen   : h0_mmio_wen,
        o_dbg_h0_mmio_paddr : h0_mmio_paddr,
        o_dbg_h0_clint_sel  : h0_clint_sel,
        o_dbg_h1_mmio_wen   : h1_mmio_wen,
        o_dbg_h1_mmio_paddr : h1_mmio_paddr,
        o_dbg_h1_clint_sel  : h1_clint_sel,
        o_dbg_h0_mmio_grant : h0_mmio_grant,
        o_dbg_h1_mmio_grant : h1_mmio_grant,
        o_dbg_h0_dmem_addr  : h0_dmem_addr,
        o_dbg_h0_dmem_wen   : h0_dmem_wen,
        o_dbg_h0_dmem_ren   : h0_dmem_ren,
        o_dbg_h0_dmem_wdata : h0_dmem_wdata,
        o_dbg_h1_dmem_addr  : h1_dmem_addr,
        o_dbg_h1_dmem_wen   : h1_dmem_wen,
        o_dbg_h1_dmem_ren   : h1_dmem_ren,
        o_dbg_h1_dmem_wdata : h1_dmem_wdata,
    );

    // Track whether hart 1 ever entered kernel address space (>= 0x80000000)
    // and how many instructions it retired there.
    // Also sticky-flag a few key kernel symbols to confirm secondary
    // actually reached them (vs. spinning forever in do_raw_spin_lock):
    //   - smp_callin:           0xffffffff800052b8
    //   - notify_cpu_starting:  0xffffffff8000d7d8
    //   - set_cpu_online:       0xffffffff8000dd28
    //   - complete:             0xffffffff80043c24
    // Pass detection by UART text match: kernel prints
    //   "smp: Brought up 1 node, 2 CPUs"
    // when both harts are cpu_online. We watch the byte stream for the
    // 8-character signature "Brought " (sufficient to be unique in a
    // typical RV64 Linux boot log) and latch brought_up_seen on match.
    var h1_kernel_seen     : logic    ;
    var h1_retire_cnt      : logic<32>;
    var h1_smp_callin_seen : logic    ;
    var h1_notify_seen     : logic    ;
    var h1_set_online_seen : logic    ;
    var h1_complete_seen   : logic    ;
    var brought_up_seen    : logic    ;
    var bu_match_idx       : logic<3> ;
    // Oops-PC trigger and bad function-pointer load tracker.
    // The 2-hart Linux boot dies with an unmapped jump to virtual address
    // 0x00000000_207ff400 from a corrupted scheduler function pointer.
    // Capture (a) the cycle and dmem_addr where 0x207ff400 first appears
    // on the bus as a load result (so we can identify which kernel struct
    // field is being corrupted), and (b) the cycle when the PC actually
    // reaches 0x207ff400 (the fault dispatch).
    var oops_triggered     : logic    ;
    var bad_ptr_log_cnt    : logic<4> ;
    var bad_ptr_write_cnt  : logic<4> ;
    var fetch_bad_pa_h0    : logic    ;
    var fetch_bad_pa_h1    : logic    ;
    // Phase 5 SMP debug: hlist_bl_lock spin diagnostics
    var spin_addr_cnt      : logic<7> ;
    var h0_writes_in_spin  : logic<7> ;
    // Phase 5: track all writes to h1's spin lock address (0x80ab4fe0)
    var lock_write_cnt     : logic<5> ;
    // Track msip writes to CLINT (per-hart). msip[h] = CLINT_BASE + 4*h.
    var msip0_write_cnt    : logic<32>;
    var msip1_write_cnt    : logic<32>;
    // Hart 0 firmware: count `sw t6,0(t5)` retire at sbi_ipi+0x26 (PC 0x39c)
    // — the actual instruction that writes msip[hartid] in the sbi_ipi
    // loop. If sbi_ipi is entered (h0_sbi_ipi_cnt) but sw_cnt == 0, the
    // loop is exiting before reaching the store (mask==0 or unsupported).
    var h0_sbi_ipi_sw_cnt  : logic<32>;
    // Trap entry counters: m_trap_handler (PC 0xa0) is the M-mode trap
    // entry point; m_handle_irq (PC 0xd2) is the interrupt sub-dispatcher.
    // If hart 1's trap_cnt is 0 we know mip never asserted, so any msip[1]
    // write the firmware made never reached the CLINT->core wire (or the
    // CLINT is not driving sw_irq into hart 1's core).
    var h1_trap_cnt        : logic<32>;
    var h1_irq_cnt         : logic<32>;
    // Cycles during which CLINT raised hart 1's MSIP wire. Independent of
    // whether hart 1's core actually trapped — distinguishes the
    // "CLINT not driving sw_irq" case from "core not trapping" case.
    var h1_swirq_cyc       : logic<32>;
    var h0_swirq_cyc       : logic<32>;
    // S-mode kernel IPI/IRQ handler reach counters. handle_IPI and
    // riscv_intc_irq tell us whether SSIP, once raised by m_handle_msip,
    // actually drives the kernel's IPI dispatch path.
    var h0_handle_ipi_cnt  : logic<32>;
    var h0_intc_irq_cnt    : logic<32>;
    var h1_handle_ipi_cnt  : logic<32>;
    var h1_intc_irq_cnt    : logic<32>;
    // Phase 5 deadlock diagnostic: count entries to scheduler/stop functions
    // per-hart so we can tell whether the stop_machine livelock is because
    // hart 1 never enters multi_cpu_stop (cpu_stopper kthread never woken)
    // or because both hearts spin on stale state inside multi_cpu_stop.
    var h0_sched_ttwu_cnt  : logic<32>;
    var h1_sched_ttwu_cnt  : logic<32>;
    var h0_try_wake_cnt    : logic<32>;
    var h1_try_wake_cnt    : logic<32>;
    var h0_multi_stop_cnt  : logic<32>;
    var h1_multi_stop_cnt  : logic<32>;
    var h0_stopper_cnt     : logic<32>;
    var h1_stopper_cnt     : logic<32>;
    // Cycles a remote-write invalidate hit each hart. If h1 receives no
    // invalidates after Brought up, that's the smoking gun for cache
    // coherence broadcasts not reaching hart 1 (or no DRAM writes from
    // hart 0 happening — also important to know).
    var h0_inv_cyc         : logic<32>;
    var h1_inv_cyc         : logic<32>;
    // riscv_clear_ipi entry counter — Linux kernel calls this from
    // handle_IPI to clear mip.SSIP. If h1's count is much smaller than
    // h1_handle_ipi_cnt (594), then SSIP isn't being acked, so handle_IPI
    // re-fires endlessly on the same SSIP. PC: 0xffffffff80003caa.
    var h0_clear_ipi_cnt   : logic<32>;
    var h1_clear_ipi_cnt   : logic<32>;
    // send_ipi_mask + arch_send_call_function entry counters per-hart.
    // Tells us which side is the IPI sender. PC: send_ipi_mask=0x80003b5a,
    // arch_send_call_function_ipi_mask=0x80003e86.
    var h0_send_ipi_cnt    : logic<32>;
    var h1_send_ipi_cnt    : logic<32>;
    var h0_send_call_cnt   : logic<32>;
    var h1_send_call_cnt   : logic<32>;
    // Trap cause counters (interrupt traps only, MSB=1).
    // S-mode interrupt causes:
    //   1 = SSIP (software interrupt)
    //   5 = STIP (timer interrupt)
    //   9 = SEIP (external interrupt)
    // M-mode causes have similar structure shifted +2 (MSIP=3, MTIP=7, MEIP=11).
    var h0_trap_ssip_cnt   : logic<32>;
    var h1_trap_ssip_cnt   : logic<32>;
    var h0_trap_stip_cnt   : logic<32>;
    var h1_trap_stip_cnt   : logic<32>;
    var h0_trap_seip_cnt   : logic<32>;
    var h1_trap_seip_cnt   : logic<32>;
    var h0_trap_msip_cnt   : logic<32>;
    var h1_trap_msip_cnt   : logic<32>;
    var h0_trap_mtip_cnt   : logic<32>;
    var h1_trap_mtip_cnt   : logic<32>;
    var h0_trap_other_cnt  : logic<32>;
    var h1_trap_other_cnt  : logic<32>;
    // Scheduler entry counters.
    //   __schedule        = 0xffffffff800dff28
    //   schedule_idle     = 0xffffffff800e024a
    //   scheduler_tick    = 0xffffffff800193e2
    //   enqueue_task_rt   = 0xffffffff8001ef76
    //   pick_next_task    (constprop variants — track __schedule instead)
    var h0_sched_cnt       : logic<32>;
    var h1_sched_cnt       : logic<32>;
    var h0_sched_idle_cnt  : logic<32>;
    var h1_sched_idle_cnt  : logic<32>;
    var h0_sched_tick_cnt  : logic<32>;
    var h1_sched_tick_cnt  : logic<32>;
    var h0_enq_rt_cnt      : logic<32>;
    var h1_enq_rt_cnt      : logic<32>;
    // kthread / smpboot unpark counters. cpu_stopper for hart 1 must be
    // unparked for it to become runnable. If smpboot_unpark_threads is
    // called from hart 0 with cpu=1, hart 1's percpu kthreads (including
    // cpu_stopper) get unparked.
    //   smpboot_unpark_threads = 0xffffffff800167a6
    //   kthread_unpark         = 0xffffffff80014758
    //   smpboot_create_threads = 0xffffffff80016746
    var h0_unpark_thr_cnt  : logic<32>;
    var h1_unpark_thr_cnt  : logic<32>;
    var h0_kth_unpark_cnt  : logic<32>;
    var h1_kth_unpark_cnt  : logic<32>;
    var h0_create_thr_cnt  : logic<32>;
    var h1_create_thr_cnt  : logic<32>;
    // Cycles spent INSIDE cpu_stopper_thread function range
    // [0x8003bbc8, 0x8003bd2c) — once entered, the kthread loops inside
    // this PC range, so this counts "kthread running" cycles. 0 means
    // hart 1's cpu_stopper kthread NEVER ran. >0 means it ran but maybe
    // exited via park/work-empty schedule().
    var h0_stopper_in_cyc  : logic<32>;
    var h1_stopper_in_cyc  : logic<32>;
    // Same for multi_cpu_stop range [0x8003bd2c, 0x8003be16)
    var h0_mstop_in_cyc    : logic<32>;
    var h1_mstop_in_cyc    : logic<32>;
    // Task placement / binding diagnostics.
    //   set_task_cpu          = 0xffffffff80017f86
    //   set_cpus_allowed_ptr  = 0xffffffff8001910a
    //   kthread_bind          = 0xffffffff800146d6
    //   select_task_rq_rt     = 0xffffffff8001f2a2
    //   select_task_rq        = 0xffffffff80017e0a
    var h0_set_taskcpu_cnt : logic<32>;
    var h1_set_taskcpu_cnt : logic<32>;
    var h0_set_allow_cnt   : logic<32>;
    var h1_set_allow_cnt   : logic<32>;
    var h0_kth_bind_cnt    : logic<32>;
    var h1_kth_bind_cnt    : logic<32>;
    var h0_seltask_rt_cnt  : logic<32>;
    var h1_seltask_rt_cnt  : logic<32>;
    var h0_seltask_cnt     : logic<32>;
    var h1_seltask_cnt     : logic<32>;
    // stop_one_cpu queues a single-cpu work — important to know if
    // stop_machine is using the multi-cpu path or just stop_one_cpu.
    //   stop_one_cpu              = 0xffffffff8003bcce
    //   cpu_stop_queue_work       (private, doesn't appear in symtab)
    //   wake_up_process           = 0xffffffff800187aa
    var h0_stop_one_cnt    : logic<32>;
    var h1_stop_one_cnt    : logic<32>;
    var h0_wake_proc_cnt   : logic<32>;
    var h1_wake_proc_cnt   : logic<32>;
    // sched_set_stop_task = 0xffffffff800195f4 — sets rq[cpu]->stop pointer
    // for the stop scheduler class. If never called for cpu=1, hart 1 has
    // no stop task and pick_next_task_stop on hart 1 returns NULL.
    // sched_setscheduler_nocheck = 0xffffffff800195e2 — used by sched_set_fifo
    var h0_set_stop_cnt    : logic<32>;
    var h1_set_stop_cnt    : logic<32>;
    var h0_set_sched_cnt   : logic<32>;
    var h1_set_sched_cnt   : logic<32>;
    // **Critical**: stop_machine_unpark sets stopper->enabled=true. If
    // hart 1 never calls cpuhp_online_idle → stop_machine_unpark, hart
    // 1's cpu_stopper.enabled stays false, and cpu_stop_queue_work
    // silently DROPS work for hart 1. multi_cpu_stop on hart 0 then
    // waits forever for hart 1 to ack — exact symptom we're seeing.
    //   cpuhp_online_idle    = 0xffffffff80007be0
    //   stop_machine_unpark  = 0xffffffff8003bfde
    //   stop_machine_park    = 0xffffffff8003bfbc
    var h0_chp_idle_cnt    : logic<32>;
    var h1_chp_idle_cnt    : logic<32>;
    var h0_smunpark_cnt    : logic<32>;
    var h1_smunpark_cnt    : logic<32>;
    // Stop sched-class internals.
    //   select_task_rq_stop = 0xffffffff80024264
    //   pick_next_task_stop = 0xffffffff8002428e
    //   set_next_task_stop  = 0xffffffff8002426a
    var h0_seltask_stop_cnt: logic<32>;
    var h1_seltask_stop_cnt: logic<32>;
    var h0_picknxt_stop_cnt: logic<32>;
    var h1_picknxt_stop_cnt: logic<32>;
    var h0_setnxt_stop_cnt : logic<32>;
    var h1_setnxt_stop_cnt : logic<32>;
    // Track the first 4 CLINT MSIP region writes (addr 0x0000-0x001F) so
    // we can confirm whether sbi_ipi's sw msip[1]=1 actually reaches the
    // CLINT input port. addr=0 → msip[0], addr=4 → msip[1].
    var clint_msip_w_cnt   : logic<4>;
    // Per-target msip-set total cycle counters + firmware-path classifier
    var msip0_set_total       : logic<32>;
    var msip1_set_total       : logic<32>;
    var fw_v02_msip_writes    : logic<32>;
    var fw_legacy_msip0_writes: logic<32>;
    var fw_legacy_msip1_writes: logic<32>;
    // Per-hart-of-origin firmware sbi_ipi v02 msip-write breakdown.
    // When h0_pc=0x382 (firmware sbi_ipi sw t6,0(t5)), what addr is being
    // written? If hart 0 writes msip[0]=cycles_h0_w0, msip[1]=cycles_h0_w1,
    // we know exactly what firmware computed for the target.
    var h0_at382_addr0: logic<32>;
    var h0_at382_addr4: logic<32>;
    var h1_at382_addr0: logic<32>;
    var h1_at382_addr4: logic<32>;
    // Per-hart firmware path entry counters (current 2-hart firmware build).
    //   m_trap_handler    PC = 0x000000b4
    //   m_handle_ecall    PC = 0x000001ec
    //   sbi_ipi (v02)     PC = 0x0000035c
    //   sbi_legacy_ipi    PC = 0x0000025e
    var h0_fw_trap_cnt    : logic<32>;
    var h1_fw_trap_cnt    : logic<32>;
    var h0_fw_ecall_cnt   : logic<32>;
    var h1_fw_ecall_cnt   : logic<32>;
    var h0_fw_sbi_ipi_cnt : logic<32>;
    var h1_fw_sbi_ipi_cnt : logic<32>;
    var h0_fw_sbi_lipi_cnt: logic<32>;
    var h1_fw_sbi_lipi_cnt: logic<32>;
    // Per-hart MMIO request observation. Counts cycles where each hart
    // is asking the bus to write CLINT msip[0] / msip[1]. If the
    // request count is > 0 but actual msip writes are 0, memory_bus
    // arbitration is dropping the request.
    var h0_req_msip0_cyc : logic<32>;
    var h0_req_msip1_cyc : logic<32>;
    var h1_req_msip0_cyc : logic<32>;
    var h1_req_msip1_cyc : logic<32>;
    // Branch-taken counters at firmware sbi_ipi exits.
    //   sbi_ipi_done        PC = 0x0000038e (a0=0, no work)
    //   sbi_ipi_unsupported PC = 0x00000394 (a6 != 0, bad fid)
    var h0_sbi_ipi_done_cnt : logic<32>;
    var h1_sbi_ipi_done_cnt : logic<32>;
    var h0_sbi_ipi_uns_cnt  : logic<32>;
    var h1_sbi_ipi_uns_cnt  : logic<32>;
    // Raw PC-only counter for firmware sbi_ipi msip-write PC (0x382),
    // without any clint_wen / clint_addr filter. Tells us how often each
    // hart actually reaches the sw instruction regardless of bus state.
    var h0_at382_raw : logic<32>;
    var h1_at382_raw : logic<32>;

    // Free-running cycle counter used by stage prints (declared early).
    var cycle_cnt: logic<32>;
    always_ff (clk, rst) {
        if_reset {
            cycle_cnt = 0;
        } else {
            cycle_cnt = cycle_cnt + 1;
        }
    }

    // Phase 5 SBI-shutdown progress markers. Each kernel boot function
    // entry latches a sticky bit and prints the cycle of first reach.
    // Markers check BOTH hart PCs since kernel_init is a kthread that
    // can run on either hart. PC observation is unreliable at single-
    // cycle granularity (F0 dual-issue can retire multiple PCs in one
    // cycle), so absence of a marker doesn't necessarily mean the PC
    // wasn't visited — but presence is definitive.
    var stage_smp_init           : logic;
    var stage_kernel_init_free   : logic;
    var stage_workqueue_init     : logic;
    var stage_migration_init     : logic;
    var stage_rest_init          : logic;
    var stage_start_kernel       : logic;
    var stage_sched_init_smp     : logic;
    var stage_sched_init_granul  : logic;
    var stage_init_sched_rt_class: logic;
    var stage_page_alloc_late    : logic;
    var stage_page_writeback     : logic;
    var stage_shmem_init         : logic;
    var stage_driver_init        : logic;
    var stage_console_on_rootfs  : logic;
    var stage_prepare_namespace  : logic;
    var stage_mount_block_root   : logic;
    var stage_panic              : logic;
    var stage_emergency_restart  : logic;
    var stage_vprintk_emit       : logic;
    var stage_console_unlock     : logic;
    var stage_wait_for_completion: logic;
    var stage_stop_machine       : logic;

    // Phase 5 SBI deadlock diagnostics: per-hart firmware entry counters.
    // M-mode firmware addresses (from objdump linux_boot_fw_2hart.elf,
    // post-IPI patch — addresses shifted from earlier baseline):
    //   m_handle_timer       = 0x108
    //   m_handle_msip        = 0x12c
    //   m_handle_ecall       = 0x1a4
    //   sbi_legacy_set_timer = 0x220
    //   sbi_time             = 0x334  (approx; not precisely tracked)
    //   sbi_ipi              = 0x37c
    //   sbi_rfence_stub      = 0x3d8
    //   sbi_hsm_hart_start   = 0x408
    // Counts increment whenever the corresponding hart's PC equals the
    // function entry; a non-zero count for hart 1 confirms the per-hart
    // mtimecmp / msip path is actually firing on hart 1.
    var h1_timer_cnt   : logic<32>;
    var h1_msip_cnt    : logic<32>;
    var h1_ecall_cnt   : logic<32>;
    var h1_sbi_time_cnt: logic<32>;
    var h1_sbi_lstm_cnt: logic<32>;
    var h1_sbi_ipi_cnt : logic<32>;
    var h1_sbi_lipi_cnt: logic<32>;
    var h1_park_cnt    : logic<32>;
    var h0_timer_cnt   : logic<32>;
    var h0_msip_cnt    : logic<32>;
    var h0_ecall_cnt   : logic<32>;
    var h0_sbi_time_cnt: logic<32>;
    var h0_sbi_lstm_cnt: logic<32>;
    var h0_sbi_ipi_cnt : logic<32>;
    var h0_sbi_lipi_cnt: logic<32>;
    // Sticky bits to flag first-time firmware entry on hart 1 (so we can
    // print a single line noting the cycle).
    var h1_timer_seen   : logic;
    var h1_msip_seen    : logic;
    var h1_sbi_time_seen: logic;
    var h1_sbi_lstm_seen: logic;
    var h1_ecall_seen   : logic;

    // SBI version probe sticky bits (sbi_base_get_spec_version @ 0x2a0).
    // If kernel logs "SBI v0.1 detected" yet the marker fires, the kernel
    // is indeed calling our handler; the issue is then in the return path
    // or the kernel's parsing of the version word.
    var h0_sbi_specver_seen: logic;
    var h1_sbi_specver_seen: logic;

    // High-water mark trackers within the kernel .init.text region
    // [0xffffffff80806000, 0xffffffff80820000) so we can see how far past
    // init_sched_rt_class (0x80806b6a) kernel_init kthread actually got.
    // Updated only AFTER stage_init_sched_rt_class fires to avoid earlier
    // unrelated visits.
    var max_init_pc_h0 : logic<64>;
    var max_init_pc_h1 : logic<64>;

    // Static-mux the per-position target byte for "Brought " to avoid
    // dynamic array indexing in the simulator.
    let bu_target_byte: logic<8> =
        if bu_match_idx == 3'd0 ? 8'h42  // 'B'
        : if bu_match_idx == 3'd1 ? 8'h72  // 'r'
        : if bu_match_idx == 3'd2 ? 8'h6f  // 'o'
        : if bu_match_idx == 3'd3 ? 8'h75  // 'u'
        : if bu_match_idx == 3'd4 ? 8'h67  // 'g'
        : if bu_match_idx == 3'd5 ? 8'h68  // 'h'
        : if bu_match_idx == 3'd6 ? 8'h74  // 't'
        : 8'h20; // ' '
    always_ff (clk, rst) {
        if_reset {
            h1_kernel_seen     = 1'b0;
            h1_retire_cnt      = 32'd0;
            h1_smp_callin_seen = 1'b0;
            h1_notify_seen     = 1'b0;
            h1_set_online_seen = 1'b0;
            h1_complete_seen   = 1'b0;
            brought_up_seen    = 1'b0;
            bu_match_idx       = 3'd0;
            stage_smp_init           = 1'b0;
            stage_kernel_init_free   = 1'b0;
            stage_workqueue_init     = 1'b0;
            stage_migration_init     = 1'b0;
            stage_rest_init          = 1'b0;
            stage_start_kernel       = 1'b0;
            stage_sched_init_smp     = 1'b0;
            stage_sched_init_granul  = 1'b0;
            stage_init_sched_rt_class = 1'b0;
            stage_page_alloc_late    = 1'b0;
            stage_page_writeback     = 1'b0;
            stage_shmem_init         = 1'b0;
            stage_driver_init        = 1'b0;
            stage_console_on_rootfs  = 1'b0;
            stage_prepare_namespace  = 1'b0;
            stage_mount_block_root   = 1'b0;
            stage_panic              = 1'b0;
            stage_emergency_restart  = 1'b0;
            stage_vprintk_emit       = 1'b0;
            stage_console_unlock     = 1'b0;
            stage_wait_for_completion = 1'b0;
            spin_addr_cnt              = 7'd0;
            h0_writes_in_spin          = 7'd0;
            lock_write_cnt             = 5'd0;
            stage_stop_machine       = 1'b0;
            h1_timer_cnt    = 32'd0;
            h1_msip_cnt     = 32'd0;
            h1_ecall_cnt    = 32'd0;
            h1_sbi_time_cnt = 32'd0;
            h1_sbi_lstm_cnt = 32'd0;
            h1_sbi_ipi_cnt  = 32'd0;
            h1_sbi_lipi_cnt = 32'd0;
            h1_park_cnt     = 32'd0;
            h0_timer_cnt    = 32'd0;
            h0_msip_cnt     = 32'd0;
            h0_ecall_cnt    = 32'd0;
            h0_sbi_time_cnt = 32'd0;
            h0_sbi_lstm_cnt = 32'd0;
            h0_sbi_ipi_cnt  = 32'd0;
            h0_sbi_lipi_cnt = 32'd0;
            h1_timer_seen    = 1'b0;
            h1_msip_seen     = 1'b0;
            h1_sbi_time_seen = 1'b0;
            h1_sbi_lstm_seen = 1'b0;
            h1_ecall_seen    = 1'b0;
            h0_sbi_specver_seen = 1'b0;
            h1_sbi_specver_seen = 1'b0;
            max_init_pc_h0   = 64'd0;
            max_init_pc_h1   = 64'd0;
            oops_triggered    = 1'b0;
            bad_ptr_log_cnt   = 4'd0;
            bad_ptr_write_cnt = 4'd0;
            fetch_bad_pa_h0   = 1'b0;
            fetch_bad_pa_h1   = 1'b0;
            msip0_write_cnt   = 32'd0;
            msip1_write_cnt   = 32'd0;
            h0_sbi_ipi_sw_cnt = 32'd0;
            h1_trap_cnt       = 32'd0;
            h1_irq_cnt        = 32'd0;
            h1_swirq_cyc      = 32'd0;
            h0_swirq_cyc      = 32'd0;
            h0_handle_ipi_cnt = 32'd0;
            h0_intc_irq_cnt   = 32'd0;
            h1_handle_ipi_cnt = 32'd0;
            h1_intc_irq_cnt   = 32'd0;
            clint_msip_w_cnt  = 4'd0;
            msip0_set_total       = 32'd0;
            msip1_set_total       = 32'd0;
            h0_grant_total = 32'd0;
            h1_grant_total = 32'd0;
            clint_wen_total = 32'd0;
            fw_v02_msip_writes    = 32'd0;
            fw_legacy_msip0_writes = 32'd0;
            fw_legacy_msip1_writes = 32'd0;
            h0_at382_addr0 = 32'd0;
            h0_at382_addr4 = 32'd0;
            h1_at382_addr0 = 32'd0;
            h1_at382_addr4 = 32'd0;
            h0_fw_trap_cnt    = 32'd0;
            h1_fw_trap_cnt    = 32'd0;
            h0_fw_ecall_cnt   = 32'd0;
            h1_fw_ecall_cnt   = 32'd0;
            h0_fw_sbi_ipi_cnt = 32'd0;
            h1_fw_sbi_ipi_cnt = 32'd0;
            h0_fw_sbi_lipi_cnt = 32'd0;
            h1_fw_sbi_lipi_cnt = 32'd0;
            h0_req_msip0_cyc = 32'd0;
            h0_req_msip1_cyc = 32'd0;
            h1_req_msip0_cyc = 32'd0;
            h1_req_msip1_cyc = 32'd0;
            h0_sbi_ipi_done_cnt = 32'd0;
            h1_sbi_ipi_done_cnt = 32'd0;
            h0_sbi_ipi_uns_cnt  = 32'd0;
            h1_sbi_ipi_uns_cnt  = 32'd0;
            h0_at382_raw = 32'd0;
            h1_at382_raw = 32'd0;
            h0_sched_ttwu_cnt = 32'd0;
            h1_sched_ttwu_cnt = 32'd0;
            h0_try_wake_cnt   = 32'd0;
            h1_try_wake_cnt   = 32'd0;
            h0_multi_stop_cnt = 32'd0;
            h1_multi_stop_cnt = 32'd0;
            h0_stopper_cnt    = 32'd0;
            h1_stopper_cnt    = 32'd0;
            h0_inv_cyc        = 32'd0;
            h1_inv_cyc        = 32'd0;
            h0_clear_ipi_cnt  = 32'd0;
            h1_clear_ipi_cnt  = 32'd0;
            h0_send_ipi_cnt   = 32'd0;
            h1_send_ipi_cnt   = 32'd0;
            h0_send_call_cnt  = 32'd0;
            h1_send_call_cnt  = 32'd0;
            h0_trap_ssip_cnt  = 32'd0;
            h1_trap_ssip_cnt  = 32'd0;
            h0_trap_stip_cnt  = 32'd0;
            h1_trap_stip_cnt  = 32'd0;
            h0_trap_seip_cnt  = 32'd0;
            h1_trap_seip_cnt  = 32'd0;
            h0_trap_msip_cnt  = 32'd0;
            h1_trap_msip_cnt  = 32'd0;
            h0_trap_mtip_cnt  = 32'd0;
            h1_trap_mtip_cnt  = 32'd0;
            h0_trap_other_cnt = 32'd0;
            h1_trap_other_cnt = 32'd0;
            h0_sched_cnt      = 32'd0;
            h1_sched_cnt      = 32'd0;
            h0_sched_idle_cnt = 32'd0;
            h1_sched_idle_cnt = 32'd0;
            h0_sched_tick_cnt = 32'd0;
            h1_sched_tick_cnt = 32'd0;
            h0_enq_rt_cnt     = 32'd0;
            h1_enq_rt_cnt     = 32'd0;
            h0_unpark_thr_cnt = 32'd0;
            h1_unpark_thr_cnt = 32'd0;
            h0_kth_unpark_cnt = 32'd0;
            h1_kth_unpark_cnt = 32'd0;
            h0_create_thr_cnt = 32'd0;
            h1_create_thr_cnt = 32'd0;
            h0_stopper_in_cyc = 32'd0;
            h1_stopper_in_cyc = 32'd0;
            h0_mstop_in_cyc   = 32'd0;
            h1_mstop_in_cyc   = 32'd0;
            h0_set_taskcpu_cnt = 32'd0;
            h1_set_taskcpu_cnt = 32'd0;
            h0_set_allow_cnt  = 32'd0;
            h1_set_allow_cnt  = 32'd0;
            h0_kth_bind_cnt   = 32'd0;
            h1_kth_bind_cnt   = 32'd0;
            h0_seltask_rt_cnt = 32'd0;
            h1_seltask_rt_cnt = 32'd0;
            h0_seltask_cnt    = 32'd0;
            h1_seltask_cnt    = 32'd0;
            h0_stop_one_cnt   = 32'd0;
            h1_stop_one_cnt   = 32'd0;
            h0_wake_proc_cnt  = 32'd0;
            h1_wake_proc_cnt  = 32'd0;
            h0_set_stop_cnt   = 32'd0;
            h1_set_stop_cnt   = 32'd0;
            h0_set_sched_cnt  = 32'd0;
            h1_set_sched_cnt  = 32'd0;
            h0_chp_idle_cnt   = 32'd0;
            h1_chp_idle_cnt   = 32'd0;
            h0_smunpark_cnt   = 32'd0;
            h1_smunpark_cnt   = 32'd0;
            h0_seltask_stop_cnt = 32'd0;
            h1_seltask_stop_cnt = 32'd0;
            h0_picknxt_stop_cnt = 32'd0;
            h1_picknxt_stop_cnt = 32'd0;
            h0_setnxt_stop_cnt  = 32'd0;
            h1_setnxt_stop_cnt  = 32'd0;
        } else {
            // Trigger first when hart 0 enters Linux page-fault handler
            // (no_context+0x2 = ffffffff80004622) which signals the Oops
            // is about to be dumped. This freezes oops_triggered so the
            // surrounding bad-pointer trace stops; we only care about
            // events BEFORE this point.
            if !oops_triggered && h0_pc == 64'hffffffff80004622 {
                oops_triggered = 1'b1;
                $write("[OOPS_HANDLER_ENTRY cyc=%h h0_pc=%h h1_pc=%h]\n",
                       cycle_cnt, h0_pc, h1_pc);
            }
            // CLINT msip[h] write tracking. msip[0] @ 0x02000000, msip[1]
            // @ 0x02000004. dmem is the bus-arbitrated single port, so any
            // write to these addresses is some hart asking the SBI/CLINT
            // to interrupt itself or another hart.
            // Phase 5 SMP debug: capture h1's spin-loop load address.
            // h1 stalls in hlist_bl_lock (PC 0xffffffff80072c90..0xffffffff80072ca8).
            // Match h1_pc upper bits == 0xffffffff80072c and lower nibble in spin range.
            let h1_in_lock_fn: logic =
                h1_pc[63:32] == 32'hffffffff &&
                h1_pc[31:8] == 24'h80072c;
            // Trace h1's PC every cycle when in the lock function (first 64 events).
            // Now uses per-hart dmem signals (h1_dmem_*) to see h1's actual
            // requests including cache-hit reads.
            if h1_in_lock_fn && spin_addr_cnt <: 7'd63 {
                spin_addr_cnt = spin_addr_cnt + 7'd1;
                $write("[H1_LOCK_PC#%h cyc=%h h1_pc=%h h1_dmem_addr=%h h1_ren=%b h1_wen=%b h1_wdata=%h h1_inv=%b]\n",
                       spin_addr_cnt, cycle_cnt, h1_pc, h1_dmem_addr,
                       h1_dmem_ren, h1_dmem_wen, h1_dmem_wdata, h1_inv_valid);
            }
            // Log h0 dmem writes during spin window (after first spin event).
            if dmem_wen && h0_pc[63:32] == 32'hffffffff
                        && h0_writes_in_spin <: 7'd31 && spin_addr_cnt >: 7'd0 {
                h0_writes_in_spin = h0_writes_in_spin + 7'd1;
                $write("[H0_WRITE_DURING_SPIN#%h cyc=%h addr=%h wdata=%h h0_pc=%h]\n",
                       h0_writes_in_spin, cycle_cnt, dmem_addr, dmem_wdata, h0_pc);
            }
            // Track ALL writes to the lock address h1 spins on (0x80ab4fe0).
            // First 32 events captured.
            if dmem_wen && dmem_addr[31:0] == 32'h80ab4fe0 && lock_write_cnt <: 5'd31 {
                lock_write_cnt = lock_write_cnt + 5'd1;
                $write("[LOCK_WRITE#%h cyc=%h wdata=%h h0_pc=%h h1_pc=%h]\n",
                       lock_write_cnt, cycle_cnt, dmem_wdata, h0_pc, h1_pc);
            }
            if dmem_wen && dmem_addr[31:0] == 32'h02000000 {
                msip0_write_cnt = msip0_write_cnt + 32'd1;
            }
            if dmem_wen && dmem_addr[31:0] == 32'h02000004 {
                msip1_write_cnt = msip1_write_cnt + 32'd1;
                if msip1_write_cnt <: 32'd5 {
                    $write("[MSIP1_WRITE#%h cyc=%h wdata=%h h0_pc=%h h1_pc=%h]\n",
                           msip1_write_cnt + 32'd1, cycle_cnt, dmem_wdata, h0_pc, h1_pc);
                }
            }

            // Direct fetch trigger: capture when hart 0's translated
            // physical fetch address falls in the bad page 0x207ff___.
            // sticky-first only.
            if !oops_triggered && fetch_bad_pa_h0 == 1'b0
                && imem_addr[0][31:12] == 20'h207ff && imem_addr[0][63:32] == 32'd0 {
                fetch_bad_pa_h0 = 1'b1;
                $write("[FETCH_BAD_PA_FIRST_h0 cyc=%h pa=%h h0_pc=%h h1_pc=%h]\n",
                       cycle_cnt, imem_addr[0], h0_pc, h1_pc);
            }
            if !oops_triggered && fetch_bad_pa_h1 == 1'b0
                && imem_addr[1][31:12] == 20'h207ff && imem_addr[1][63:32] == 32'd0 {
                fetch_bad_pa_h1 = 1'b1;
                $write("[FETCH_BAD_PA_FIRST_h1 cyc=%h pa=%h h0_pc=%h h1_pc=%h]\n",
                       cycle_cnt, imem_addr[1], h0_pc, h1_pc);
            }
            // Match anything in the 0x00000000_207ff000-0x207fffff page
            // (the unmapped page the bad function pointer points into),
            // since the actual fault PC could be any offset within the
            // page (jalr masks LSB, load value may have low bits set).
            let bad_load_match: logic = dmem_rdata[63:32] == 32'd0
                                     && dmem_rdata[31:12] == 20'h207ff;
            let bad_write_match: logic = dmem_wdata[63:32] == 32'd0
                                      && dmem_wdata[31:12] == 20'h207ff;
            // Pre-Oops bad pointer load tracking — only first event to
            // keep log size minimal so the bg task output isn't truncated.
            if !oops_triggered && bad_load_match && bad_ptr_log_cnt == 4'd0 {
                bad_ptr_log_cnt = 4'd1;
                $write("[BAD_PTR_LOAD_FIRST cyc=%h val=%h dmem_addr=%h h0_pc=%h h1_pc=%h]\n",
                       cycle_cnt, dmem_rdata, dmem_addr, h0_pc, h1_pc);
            }
            if !oops_triggered && dmem_wen && bad_write_match && bad_ptr_write_cnt == 4'd0 {
                bad_ptr_write_cnt = 4'd1;
                $write("[BAD_PTR_WRITE_FIRST cyc=%h val=%h dmem_addr=%h h0_pc=%h h1_pc=%h]\n",
                       cycle_cnt, dmem_wdata, dmem_addr, h0_pc, h1_pc);
            }
            if h1_pc[31] {
                h1_kernel_seen = 1'b1;
            }
            if h1_instret {
                h1_retire_cnt = h1_retire_cnt + 32'd1;
            }
            // Updated to latest kernel build (post Phase 5 kernel patches):
            //   smp_callin           = 0xffffffff80003a88
            //   notify_cpu_starting  = 0xffffffff80007c52
            //   set_cpu_online       = 0xffffffff80008244
            //   complete             = 0xffffffff800227bc
            //   secondary_start_sbi  = 0xffffffff80001062
            if h1_pc == 64'hffffffff80003a88 { h1_smp_callin_seen = 1'b1; }
            if h1_pc == 64'hffffffff80007c52 { h1_notify_seen     = 1'b1; }
            if h1_pc == 64'hffffffff80008244 { h1_set_online_seen = 1'b1; }
            if h1_pc == 64'hffffffff800227bc { h1_complete_seen   = 1'b1; }
            // Boot path stage markers — check BOTH harts (kernel_init kthread can run on either).
            // Updated to current 2-hart kernel (System.map dated 2026-05-03):
            //   start_kernel               = 0xffffffff80200472
            //   smp_init                   = 0xffffffff802073f8
            //   workqueue_init             = 0xffffffff80204444
            //   migration_init             = 0xffffffff80204c9a
            //   kernel_init_freeable       = 0xffffffff80200bc4
            //   rest_init                  = 0xffffffff800df930
            //   sched_init_smp             = 0xffffffff80204e90
            //   sched_init_granularity     = 0xffffffff8020522a
            //   init_sched_rt_class        = 0xffffffff80205244
            //   page_alloc_init_late       = 0xffffffff80209072
            //   driver_init                = 0xffffffff8020d34c
            //   prepare_namespace          = 0xffffffff80201268
            //   mount_block_root           = 0xffffffff80200f8a
            //   panic                      = 0xffffffff800ddc00
            //   emergency_restart          = 0xffffffff80015b8c
            //   vprintk_emit               = 0xffffffff80027a80
            //   console_unlock             = 0xffffffff80027350
            //   wait_for_completion        = 0xffffffff800e07e4
            if !stage_start_kernel       && (h0_pc == 64'hffffffff80200472 || h1_pc == 64'hffffffff80200472) {
                stage_start_kernel       = 1'b1;
                $write("[stage  4 start_kernel        cyc=%h]\n", cycle_cnt);
            }
            if !stage_smp_init           && (h0_pc == 64'hffffffff802073f8 || h1_pc == 64'hffffffff802073f8) {
                stage_smp_init           = 1'b1;
                $write("[stage  6 smp_init            cyc=%h]\n", cycle_cnt);
            }
            if !stage_workqueue_init     && (h0_pc == 64'hffffffff80204444 || h1_pc == 64'hffffffff80204444) {
                stage_workqueue_init     = 1'b1;
                $write("[stage 6.2 workqueue_init     cyc=%h]\n", cycle_cnt);
            }
            if !stage_migration_init     && (h0_pc == 64'hffffffff80204c9a || h1_pc == 64'hffffffff80204c9a) {
                stage_migration_init     = 1'b1;
                $write("[stage 6.4 migration_init     cyc=%h]\n", cycle_cnt);
            }
            if !stage_kernel_init_free   && (h0_pc == 64'hffffffff80200bc4 || h1_pc == 64'hffffffff80200bc4) {
                stage_kernel_init_free   = 1'b1;
                $write("[stage  8 kernel_init_freeable cyc=%h]\n", cycle_cnt);
            }
            if !stage_rest_init          && (h0_pc == 64'hffffffff800df930 || h1_pc == 64'hffffffff800df930) {
                stage_rest_init          = 1'b1;
                $write("[stage  5 rest_init           cyc=%h]\n", cycle_cnt);
            }
            if !stage_sched_init_smp     && (h0_pc == 64'hffffffff80204e90 || h1_pc == 64'hffffffff80204e90) {
                stage_sched_init_smp     = 1'b1;
                $write("[stage 6.1 sched_init_smp     cyc=%h]\n", cycle_cnt);
            }
            if !stage_sched_init_granul  && (h0_pc == 64'hffffffff8020522a || h1_pc == 64'hffffffff8020522a) {
                stage_sched_init_granul  = 1'b1;
                $write("[stage 6.1.3 sched_init_granularity cyc=%h]\n", cycle_cnt);
            }
            if !stage_init_sched_rt_class && (h0_pc == 64'hffffffff80205244 || h1_pc == 64'hffffffff80205244) {
                stage_init_sched_rt_class = 1'b1;
                $write("[stage 6.1.5 init_sched_rt_class cyc=%h]\n", cycle_cnt);
            }
            // Post-sched_init_smp markers: gated on stage_init_sched_rt_class
            // so early false-positive sticky doesn't hide the real call.
            if !stage_page_alloc_late    && stage_init_sched_rt_class && (h0_pc == 64'hffffffff80209072 || h1_pc == 64'hffffffff80209072) {
                stage_page_alloc_late    = 1'b1;
                $write("[stage 6.6 page_alloc_init_late cyc=%h]\n", cycle_cnt);
            }
            if !stage_driver_init        && stage_init_sched_rt_class && (h0_pc == 64'hffffffff8020d34c || h1_pc == 64'hffffffff8020d34c) {
                stage_driver_init        = 1'b1;
                $write("[stage 8.2 driver_init        cyc=%h]\n", cycle_cnt);
            }
            if !stage_prepare_namespace  && stage_init_sched_rt_class && (h0_pc == 64'hffffffff80201268 || h1_pc == 64'hffffffff80201268) {
                stage_prepare_namespace  = 1'b1;
                $write("[stage  9 prepare_namespace   cyc=%h]\n", cycle_cnt);
            }
            if !stage_mount_block_root   && stage_init_sched_rt_class && (h0_pc == 64'hffffffff80200f8a || h1_pc == 64'hffffffff80200f8a) {
                stage_mount_block_root   = 1'b1;
                $write("[stage 10 mount_block_root    cyc=%h]\n", cycle_cnt);
            }
            if !stage_panic              && (h0_pc == 64'hffffffff800ddc00 || h1_pc == 64'hffffffff800ddc00) {
                stage_panic              = 1'b1;
                $write("[stage 11 panic               cyc=%h]\n", cycle_cnt);
            }
            if !stage_emergency_restart  && (h0_pc == 64'hffffffff80015b8c || h1_pc == 64'hffffffff80015b8c) {
                stage_emergency_restart  = 1'b1;
                $write("[stage 12 emergency_restart   cyc=%h]\n", cycle_cnt);
            }
            if !stage_vprintk_emit       && (h0_pc == 64'hffffffff80027a80 || h1_pc == 64'hffffffff80027a80) {
                stage_vprintk_emit       = 1'b1;
                $write("[stage Z vprintk_emit         cyc=%h]\n", cycle_cnt);
            }
            if !stage_console_unlock     && (h0_pc == 64'hffffffff80027350 || h1_pc == 64'hffffffff80027350) {
                stage_console_unlock     = 1'b1;
                $write("[stage Z2 console_unlock      cyc=%h]\n", cycle_cnt);
            }
            if !stage_wait_for_completion && (h0_pc == 64'hffffffff800e07e4 || h1_pc == 64'hffffffff800e07e4) {
                stage_wait_for_completion = 1'b1;
                $write("[stage W wait_for_completion  cyc=%h]\n", cycle_cnt);
            }
            if !stage_stop_machine       && (h0_pc == 64'hffffffff8003bd2c || h1_pc == 64'hffffffff8003bd2c) {
                stage_stop_machine       = 1'b1;
                $write("[stage SM stop_machine        cyc=%h]\n", cycle_cnt);
            }
            // Per-hart firmware entry counters + first-reach prints.
            // Addresses from objdump linux_boot_fw_2hart.elf (post-IPI patch).
            if h1_pc == 64'hec  { h1_timer_cnt    = h1_timer_cnt + 32'd1; }
            if h1_pc == 64'h112 { h1_msip_cnt     = h1_msip_cnt + 32'd1; }
            if h1_pc == 64'h19c { h1_ecall_cnt    = h1_ecall_cnt + 32'd1; }
            if h1_pc == 64'h34e { h1_sbi_time_cnt = h1_sbi_time_cnt + 32'd1; }
            if h1_pc == 64'h218 { h1_sbi_lstm_cnt = h1_sbi_lstm_cnt + 32'd1; }
            if h1_pc == 64'h376 { h1_sbi_ipi_cnt  = h1_sbi_ipi_cnt + 32'd1; }
            if h1_pc == 64'h25e { h1_sbi_lipi_cnt = h1_sbi_lipi_cnt + 32'd1; }
            if h1_pc == 64'h474 { h1_park_cnt     = h1_park_cnt + 32'd1; }
            if h1_pc == 64'ha0  { h1_trap_cnt     = h1_trap_cnt + 32'd1; }
            if h1_pc == 64'hd2  { h1_irq_cnt      = h1_irq_cnt + 32'd1; }
            if h1_sw_irq        { h1_swirq_cyc    = h1_swirq_cyc + 32'd1; }
            if h0_sw_irq        { h0_swirq_cyc    = h0_swirq_cyc + 32'd1; }
            // Updated to latest kernel: handle_IPI=0x80003d08, riscv_intc_irq=0x800a7344
            if h0_pc == 64'hffffffff80003d08 { h0_handle_ipi_cnt = h0_handle_ipi_cnt + 32'd1; }
            if h0_pc == 64'hffffffff800a7344 { h0_intc_irq_cnt   = h0_intc_irq_cnt + 32'd1; }
            if h1_pc == 64'hffffffff80003d08 { h1_handle_ipi_cnt = h1_handle_ipi_cnt + 32'd1; }
            if h1_pc == 64'hffffffff800a7344 { h1_intc_irq_cnt   = h1_intc_irq_cnt + 32'd1; }
            // Phase 5 deadlock diagnostic: scheduler/stop-machine entries.
            //   sched_ttwu_pending = 0xffffffff8001835e
            //   try_to_wake_up     = 0xffffffff80018590
            //   multi_cpu_stop     = 0xffffffff8003bd2c
            //   cpu_stopper_thread = 0xffffffff8003bbc8
            if h0_pc == 64'hffffffff8001835e { h0_sched_ttwu_cnt = h0_sched_ttwu_cnt + 32'd1; }
            if h1_pc == 64'hffffffff8001835e { h1_sched_ttwu_cnt = h1_sched_ttwu_cnt + 32'd1; }
            if h0_pc == 64'hffffffff80018590 { h0_try_wake_cnt   = h0_try_wake_cnt   + 32'd1; }
            if h1_pc == 64'hffffffff80018590 { h1_try_wake_cnt   = h1_try_wake_cnt   + 32'd1; }
            if h0_pc == 64'hffffffff8003bd2c { h0_multi_stop_cnt = h0_multi_stop_cnt + 32'd1; }
            if h1_pc == 64'hffffffff8003bd2c { h1_multi_stop_cnt = h1_multi_stop_cnt + 32'd1; }
            if h0_pc == 64'hffffffff8003bbc8 { h0_stopper_cnt    = h0_stopper_cnt    + 32'd1; }
            if h1_pc == 64'hffffffff8003bbc8 { h1_stopper_cnt    = h1_stopper_cnt    + 32'd1; }
            if h0_inv_valid                  { h0_inv_cyc        = h0_inv_cyc        + 32'd1; }
            if h1_inv_valid                  { h1_inv_cyc        = h1_inv_cyc        + 32'd1; }
            if h0_pc == 64'hffffffff80003caa { h0_clear_ipi_cnt  = h0_clear_ipi_cnt  + 32'd1; }
            if h1_pc == 64'hffffffff80003caa { h1_clear_ipi_cnt  = h1_clear_ipi_cnt  + 32'd1; }
            if h0_pc == 64'hffffffff80003b5a { h0_send_ipi_cnt   = h0_send_ipi_cnt   + 32'd1; }
            if h1_pc == 64'hffffffff80003b5a { h1_send_ipi_cnt   = h1_send_ipi_cnt   + 32'd1; }
            if h0_pc == 64'hffffffff80003e86 { h0_send_call_cnt  = h0_send_call_cnt  + 32'd1; }
            if h1_pc == 64'hffffffff80003e86 { h1_send_call_cnt  = h1_send_call_cnt  + 32'd1; }
            // Trap cause classification. trap_cause MSB=1 means interrupt;
            // low 6 bits are the cause number. We sample each trap pulse.
            if h0_trap_taken {
                if h0_trap_cause == 64'h8000000000000001 { h0_trap_ssip_cnt = h0_trap_ssip_cnt + 32'd1; }
                else if h0_trap_cause == 64'h8000000000000005 { h0_trap_stip_cnt = h0_trap_stip_cnt + 32'd1; }
                else if h0_trap_cause == 64'h8000000000000009 { h0_trap_seip_cnt = h0_trap_seip_cnt + 32'd1; }
                else if h0_trap_cause == 64'h8000000000000003 { h0_trap_msip_cnt = h0_trap_msip_cnt + 32'd1; }
                else if h0_trap_cause == 64'h8000000000000007 { h0_trap_mtip_cnt = h0_trap_mtip_cnt + 32'd1; }
                else                                          { h0_trap_other_cnt = h0_trap_other_cnt + 32'd1; }
            }
            if h1_trap_taken {
                if h1_trap_cause == 64'h8000000000000001 { h1_trap_ssip_cnt = h1_trap_ssip_cnt + 32'd1; }
                else if h1_trap_cause == 64'h8000000000000005 { h1_trap_stip_cnt = h1_trap_stip_cnt + 32'd1; }
                else if h1_trap_cause == 64'h8000000000000009 { h1_trap_seip_cnt = h1_trap_seip_cnt + 32'd1; }
                else if h1_trap_cause == 64'h8000000000000003 { h1_trap_msip_cnt = h1_trap_msip_cnt + 32'd1; }
                else if h1_trap_cause == 64'h8000000000000007 { h1_trap_mtip_cnt = h1_trap_mtip_cnt + 32'd1; }
                else                                          { h1_trap_other_cnt = h1_trap_other_cnt + 32'd1; }
            }
            // Scheduler entry counters
            if h0_pc == 64'hffffffff800dff28 { h0_sched_cnt      = h0_sched_cnt      + 32'd1; }
            if h1_pc == 64'hffffffff800dff28 { h1_sched_cnt      = h1_sched_cnt      + 32'd1; }
            if h0_pc == 64'hffffffff800e024a { h0_sched_idle_cnt = h0_sched_idle_cnt + 32'd1; }
            if h1_pc == 64'hffffffff800e024a { h1_sched_idle_cnt = h1_sched_idle_cnt + 32'd1; }
            if h0_pc == 64'hffffffff800193e2 { h0_sched_tick_cnt = h0_sched_tick_cnt + 32'd1; }
            if h1_pc == 64'hffffffff800193e2 { h1_sched_tick_cnt = h1_sched_tick_cnt + 32'd1; }
            // activate_task = 0xffffffff80017ba2 (called from try_to_wake_up
            // → ttwu_do_activate). Tracks task enqueues onto runqueues.
            if h0_pc == 64'hffffffff80017ba2 { h0_enq_rt_cnt     = h0_enq_rt_cnt     + 32'd1; }
            if h1_pc == 64'hffffffff80017ba2 { h1_enq_rt_cnt     = h1_enq_rt_cnt     + 32'd1; }
            if h0_pc == 64'hffffffff800167a6 { h0_unpark_thr_cnt = h0_unpark_thr_cnt + 32'd1; }
            if h1_pc == 64'hffffffff800167a6 { h1_unpark_thr_cnt = h1_unpark_thr_cnt + 32'd1; }
            if h0_pc == 64'hffffffff80014758 { h0_kth_unpark_cnt = h0_kth_unpark_cnt + 32'd1; }
            if h1_pc == 64'hffffffff80014758 { h1_kth_unpark_cnt = h1_kth_unpark_cnt + 32'd1; }
            if h0_pc == 64'hffffffff80016746 { h0_create_thr_cnt = h0_create_thr_cnt + 32'd1; }
            if h1_pc == 64'hffffffff80016746 { h1_create_thr_cnt = h1_create_thr_cnt + 32'd1; }
            // Range checks for "in cpu_stopper_thread" and "in multi_cpu_stop".
            // cpu_stopper_thread = [0x8003bbc8, 0x8003bd2c), 0x164 bytes
            // multi_cpu_stop     = [0x8003bd2c, 0x8003be16), 0xea bytes
            if h0_pc[63:32] == 32'hffffffff && h0_pc[31:0] >: 32'h8003bbc7 && h0_pc[31:0] <: 32'h8003bd2c {
                h0_stopper_in_cyc = h0_stopper_in_cyc + 32'd1;
            }
            if h1_pc[63:32] == 32'hffffffff && h1_pc[31:0] >: 32'h8003bbc7 && h1_pc[31:0] <: 32'h8003bd2c {
                h1_stopper_in_cyc = h1_stopper_in_cyc + 32'd1;
            }
            if h0_pc[63:32] == 32'hffffffff && h0_pc[31:0] >: 32'h8003bd2b && h0_pc[31:0] <: 32'h8003be16 {
                h0_mstop_in_cyc = h0_mstop_in_cyc + 32'd1;
            }
            if h1_pc[63:32] == 32'hffffffff && h1_pc[31:0] >: 32'h8003bd2b && h1_pc[31:0] <: 32'h8003be16 {
                h1_mstop_in_cyc = h1_mstop_in_cyc + 32'd1;
            }
            // Task placement counters
            if h0_pc == 64'hffffffff80017f86 { h0_set_taskcpu_cnt = h0_set_taskcpu_cnt + 32'd1; }
            if h1_pc == 64'hffffffff80017f86 { h1_set_taskcpu_cnt = h1_set_taskcpu_cnt + 32'd1; }
            if h0_pc == 64'hffffffff8001910a { h0_set_allow_cnt   = h0_set_allow_cnt   + 32'd1; }
            if h1_pc == 64'hffffffff8001910a { h1_set_allow_cnt   = h1_set_allow_cnt   + 32'd1; }
            if h0_pc == 64'hffffffff800146d6 { h0_kth_bind_cnt    = h0_kth_bind_cnt    + 32'd1; }
            if h1_pc == 64'hffffffff800146d6 { h1_kth_bind_cnt    = h1_kth_bind_cnt    + 32'd1; }
            if h0_pc == 64'hffffffff8001f2a2 { h0_seltask_rt_cnt  = h0_seltask_rt_cnt  + 32'd1; }
            if h1_pc == 64'hffffffff8001f2a2 { h1_seltask_rt_cnt  = h1_seltask_rt_cnt  + 32'd1; }
            if h0_pc == 64'hffffffff80017e0a { h0_seltask_cnt     = h0_seltask_cnt     + 32'd1; }
            if h1_pc == 64'hffffffff80017e0a { h1_seltask_cnt     = h1_seltask_cnt     + 32'd1; }
            if h0_pc == 64'hffffffff8003bcce { h0_stop_one_cnt    = h0_stop_one_cnt    + 32'd1; }
            if h1_pc == 64'hffffffff8003bcce { h1_stop_one_cnt    = h1_stop_one_cnt    + 32'd1; }
            if h0_pc == 64'hffffffff800187aa { h0_wake_proc_cnt   = h0_wake_proc_cnt   + 32'd1; }
            if h1_pc == 64'hffffffff800187aa { h1_wake_proc_cnt   = h1_wake_proc_cnt   + 32'd1; }
            if h0_pc == 64'hffffffff800195f4 { h0_set_stop_cnt    = h0_set_stop_cnt    + 32'd1; }
            if h1_pc == 64'hffffffff800195f4 { h1_set_stop_cnt    = h1_set_stop_cnt    + 32'd1; }
            if h0_pc == 64'hffffffff800195e2 { h0_set_sched_cnt   = h0_set_sched_cnt   + 32'd1; }
            if h1_pc == 64'hffffffff800195e2 { h1_set_sched_cnt   = h1_set_sched_cnt   + 32'd1; }
            if h0_pc == 64'hffffffff80007be0 { h0_chp_idle_cnt    = h0_chp_idle_cnt    + 32'd1; }
            if h1_pc == 64'hffffffff80007be0 { h1_chp_idle_cnt    = h1_chp_idle_cnt    + 32'd1; }
            if h0_pc == 64'hffffffff8003bfde { h0_smunpark_cnt    = h0_smunpark_cnt    + 32'd1; }
            if h1_pc == 64'hffffffff8003bfde { h1_smunpark_cnt    = h1_smunpark_cnt    + 32'd1; }
            if h0_pc == 64'hffffffff80024264 { h0_seltask_stop_cnt = h0_seltask_stop_cnt + 32'd1; }
            if h1_pc == 64'hffffffff80024264 { h1_seltask_stop_cnt = h1_seltask_stop_cnt + 32'd1; }
            if h0_pc == 64'hffffffff8002428e { h0_picknxt_stop_cnt = h0_picknxt_stop_cnt + 32'd1; }
            if h1_pc == 64'hffffffff8002428e { h1_picknxt_stop_cnt = h1_picknxt_stop_cnt + 32'd1; }
            if h0_pc == 64'hffffffff8002426a { h0_setnxt_stop_cnt  = h0_setnxt_stop_cnt  + 32'd1; }
            if h1_pc == 64'hffffffff8002426a { h1_setnxt_stop_cnt  = h1_setnxt_stop_cnt  + 32'd1; }
            // CLINT MSIP SET only (wdata bit0 = 1) — clears are uninteresting
            // (secondary/firmware self-clear). Set events are kernel→firmware
            // IPI delivery requests.
            // Print every CLINT MSIP SET event (cap removed for diagnostic).
            // Lifted from 16 to 64 events so we can see ALL IPI deliveries
            // during stop_machine livelock investigation.
            if clint_wen && clint_addr[15:5] == 11'd0 && clint_wdata[0] == 1'b1 && clint_msip_w_cnt <: 4'hf {
                clint_msip_w_cnt = clint_msip_w_cnt + 4'd1;
                $write("[CLINT_MSIP_SET#%h cyc=%h addr=%h h0_pc=%h h1_pc=%h]\n",
                       clint_msip_w_cnt, cycle_cnt, clint_addr, h0_pc, h1_pc);
            }
            // Per-target MSIP write counters (no cap), broken down by which
            // firmware path issued the write. Address-based: msip[0]=addr 0,
            // msip[1]=addr 4. Always counts even after print-cap exhausted.
            if clint_wen && clint_addr[15:0] == 16'h0000 && clint_wdata[0] == 1'b1 {
                msip0_set_total = msip0_set_total + 32'd1;
            }
            if clint_wen && clint_addr[15:0] == 16'h0004 && clint_wdata[0] == 1'b1 {
                msip1_set_total = msip1_set_total + 32'd1;
                if msip1_set_total <: 32'd5 {
                    $write("[MSIP1_SET cyc=%h h0_pc=%h h1_pc=%h wdata=%h]\n", cycle_cnt, h0_pc, h1_pc, clint_wdata);
                }
            }
            if h0_mmio_grant { h0_grant_total = h0_grant_total + 32'd1; }
            if h1_mmio_grant { h1_grant_total = h1_grant_total + 32'd1; }
            if clint_wen     { clint_wen_total = clint_wen_total + 32'd1; }
            // Firmware path classifier: when an MSIP set event fires, also
            // record which path's PC was on the bus that cycle.
            //   sbi_ipi (v0.2)              msip-write PC = 0x382
            //   sbi_legacy_send_ipi msip[0] PC = 0x26c (h1 → h0)
            //   sbi_legacy_send_ipi msip[1] PC = 0x274 (h0 → h1)
            if clint_wen && clint_wdata[0] == 1'b1 && clint_addr[15:5] == 11'd0 {
                if h0_pc[15:0] == 16'h0382 || h1_pc[15:0] == 16'h0382 {
                    fw_v02_msip_writes = fw_v02_msip_writes + 32'd1;
                }
                if h0_pc[15:0] == 16'h026c || h1_pc[15:0] == 16'h026c {
                    fw_legacy_msip0_writes = fw_legacy_msip0_writes + 32'd1;
                }
                if h0_pc[15:0] == 16'h0274 || h1_pc[15:0] == 16'h0274 {
                    fw_legacy_msip1_writes = fw_legacy_msip1_writes + 32'd1;
                }
                // Per-hart-of-origin breakdown: when each hart is at the
                // firmware sbi_ipi msip-write PC, what address is on bus.
                if h0_pc[15:0] == 16'h0382 && clint_addr[15:0] == 16'h0000 { h0_at382_addr0 = h0_at382_addr0 + 32'd1; }
                if h0_pc[15:0] == 16'h0382 && clint_addr[15:0] == 16'h0004 { h0_at382_addr4 = h0_at382_addr4 + 32'd1; }
                if h1_pc[15:0] == 16'h0382 && clint_addr[15:0] == 16'h0000 { h1_at382_addr0 = h1_at382_addr0 + 32'd1; }
                if h1_pc[15:0] == 16'h0382 && clint_addr[15:0] == 16'h0004 { h1_at382_addr4 = h1_at382_addr4 + 32'd1; }
            }
            // Per-hart firmware entry-point counters (free-running).
            // Use full 64-bit PC to avoid kernel false positives — firmware
            // entry PCs are at low memory (< 0x1000) and have upper bits 0.
            // Current 2-hart firmware (post-gate-removal):
            //   m_trap_handler  PC = 0x000000a0
            //   m_handle_ecall  PC = 0x0000019c
            //   sbi_ipi (v02)   PC = 0x0000035c
            //   sbi_legacy_ipi  PC = 0x0000025e
            if h0_pc == 64'h00000000_000000a0 { h0_fw_trap_cnt    = h0_fw_trap_cnt    + 32'd1; }
            if h1_pc == 64'h00000000_000000a0 { h1_fw_trap_cnt    = h1_fw_trap_cnt    + 32'd1; }
            if h0_pc == 64'h00000000_0000019c { h0_fw_ecall_cnt   = h0_fw_ecall_cnt   + 32'd1; }
            if h1_pc == 64'h00000000_0000019c { h1_fw_ecall_cnt   = h1_fw_ecall_cnt   + 32'd1; }
            if h0_pc == 64'h00000000_0000035c { h0_fw_sbi_ipi_cnt = h0_fw_sbi_ipi_cnt + 32'd1; }
            if h1_pc == 64'h00000000_0000035c { h1_fw_sbi_ipi_cnt = h1_fw_sbi_ipi_cnt + 32'd1; }
            if h0_pc == 64'h00000000_0000025e { h0_fw_sbi_lipi_cnt = h0_fw_sbi_lipi_cnt + 32'd1; }
            if h1_pc == 64'h00000000_0000025e { h1_fw_sbi_lipi_cnt = h1_fw_sbi_lipi_cnt + 32'd1; }
            // Per-hart MMIO request observation (BEFORE arbitration)
            if h0_mmio_wen && h0_clint_sel && h0_mmio_paddr[15:0] == 16'h0000 { h0_req_msip0_cyc = h0_req_msip0_cyc + 32'd1; }
            if h0_mmio_wen && h0_clint_sel && h0_mmio_paddr[15:0] == 16'h0004 { h0_req_msip1_cyc = h0_req_msip1_cyc + 32'd1; }
            if h1_mmio_wen && h1_clint_sel && h1_mmio_paddr[15:0] == 16'h0000 { h1_req_msip0_cyc = h1_req_msip0_cyc + 32'd1; }
            if h1_mmio_wen && h1_clint_sel && h1_mmio_paddr[15:0] == 16'h0004 {
                h1_req_msip1_cyc = h1_req_msip1_cyc + 32'd1;
            }
            // sbi_ipi early-exit branch counters (firmware PCs in current build)
            if h0_pc == 64'h00000000_0000038e { h0_sbi_ipi_done_cnt = h0_sbi_ipi_done_cnt + 32'd1; }
            if h1_pc == 64'h00000000_0000038e { h1_sbi_ipi_done_cnt = h1_sbi_ipi_done_cnt + 32'd1; }
            if h0_pc == 64'h00000000_00000394 { h0_sbi_ipi_uns_cnt  = h0_sbi_ipi_uns_cnt  + 32'd1; }
            if h1_pc == 64'h00000000_00000394 { h1_sbi_ipi_uns_cnt  = h1_sbi_ipi_uns_cnt  + 32'd1; }
            // Raw PC visit counter for sbi_ipi msip-write PC (no bus filter)
            if h0_pc == 64'h00000000_00000382 {
                h0_at382_raw = h0_at382_raw + 32'd1;
                if h0_at382_raw <: 32'd5 {
                    $write("[H0_AT382 #%h cyc=%h paddr=%h wen=%b clint_sel=%b grant=%b clint_wen=%b clint_addr=%h clint_wdata[0]=%b]\n",
                           h0_at382_raw, cycle_cnt, h0_mmio_paddr, h0_mmio_wen, h0_clint_sel, h0_mmio_grant,
                           clint_wen, clint_addr, clint_wdata[0]);
                }
            }
            if h1_pc == 64'h00000000_00000382 {
                h1_at382_raw = h1_at382_raw + 32'd1;
                if h1_at382_raw <: 32'd3 {
                    $write("[H1_AT382 #%h cyc=%h paddr=%h wen=%b clint_sel=%b]\n",
                           h1_at382_raw, cycle_cnt, h1_mmio_paddr, h1_mmio_wen, h1_clint_sel);
                }
            }
            if h0_pc == 64'hec  { h0_timer_cnt    = h0_timer_cnt + 32'd1; }
            if h0_pc == 64'h112 { h0_msip_cnt     = h0_msip_cnt + 32'd1; }
            if h0_pc == 64'h19c { h0_ecall_cnt    = h0_ecall_cnt + 32'd1; }
            if h0_pc == 64'h34e { h0_sbi_time_cnt = h0_sbi_time_cnt + 32'd1; }
            if h0_pc == 64'h218 { h0_sbi_lstm_cnt = h0_sbi_lstm_cnt + 32'd1; }
            if h0_pc == 64'h376 { h0_sbi_ipi_cnt  = h0_sbi_ipi_cnt + 32'd1; }
            if h0_pc == 64'h25e { h0_sbi_lipi_cnt = h0_sbi_lipi_cnt + 32'd1; }
            if h0_pc == 64'h39c { h0_sbi_ipi_sw_cnt = h0_sbi_ipi_sw_cnt + 32'd1; }
            if !h1_timer_seen    && h1_pc == 64'h118 {
                h1_timer_seen    = 1'b1;
                $write("[fw h1 m_handle_timer       cyc=%h]\n", cycle_cnt);
            }
            if !h1_msip_seen     && h1_pc == 64'h14c {
                h1_msip_seen     = 1'b1;
                $write("[fw h1 m_handle_msip        cyc=%h]\n", cycle_cnt);
            }
            if !h1_ecall_seen    && h1_pc == 64'h1ec {
                h1_ecall_seen    = 1'b1;
                $write("[fw h1 m_handle_ecall       cyc=%h]\n", cycle_cnt);
            }
            if !h1_sbi_lstm_seen && h1_pc == 64'h280 {
                h1_sbi_lstm_seen = 1'b1;
                $write("[fw h1 sbi_legacy_set_timer cyc=%h]\n", cycle_cnt);
            }
            if !h1_sbi_time_seen && h1_pc == 64'h3ec {
                h1_sbi_time_seen = 1'b1;
                $write("[fw h1 sbi_time             cyc=%h]\n", cycle_cnt);
            }
            if !h0_sbi_specver_seen && h0_pc == 64'h340 {
                h0_sbi_specver_seen = 1'b1;
                $write("[fw h0 sbi_base_get_spec_version cyc=%h]\n", cycle_cnt);
            }
            if !h1_sbi_specver_seen && h1_pc == 64'h340 {
                h1_sbi_specver_seen = 1'b1;
                $write("[fw h1 sbi_base_get_spec_version cyc=%h]\n", cycle_cnt);
            }
            // Track highest PC visited inside .init.text after we've
            // reached init_sched_rt_class. This is our window into how
            // far kernel_init kthread is actually progressing.
            // Current 2-hart kernel has .init.text at 0xffffffff80200000-0x8020ffff
            // (bits[23:17] = 0x10). Update if relinking moves the section.
            if stage_init_sched_rt_class {
                if h0_pc[63:24] == 40'hffffffff80 && h0_pc[23:17] == 7'h10 {
                    if h0_pc >: max_init_pc_h0 {
                        max_init_pc_h0 = h0_pc;
                    }
                }
                if h1_pc[63:24] == 40'hffffffff80 && h1_pc[23:17] == 7'h10 {
                    if h1_pc >: max_init_pc_h1 {
                        max_init_pc_h1 = h1_pc;
                    }
                }
            }
            if uart_tx {
                if uart_data == bu_target_byte {
                    if bu_match_idx == 3'd7 {
                        brought_up_seen = 1'b1;
                    } else {
                        bu_match_idx = bu_match_idx + 3'd1;
                    }
                } else if uart_data == 8'h42 {
                    bu_match_idx = 3'd1;
                } else {
                    bu_match_idx = 3'd0;
                }
            }
        }
    }

    // ============================================================
    // Memory arrays — shared firmware ROM and DRAM
    // ============================================================
    var fw_rom: logic<32> [4096]   ;
    var dram  : logic<32> [8388608];

    initial {
        $readmemh("test/hex/linux_boot_fw_2hart.hex", fw_rom);
        $readmemh("test/hex/linux_dram_real_2hart.hex", dram);
    }

    // Single-port DRAM write (Phase 5). memory_bus arbitrates between
    // harts so only one transaction lands per cycle. The granted hart's
    // write goes through dmem_addr/wdata/wstrb directly.
    let dmem_in_dram : logic     = dmem_addr[31];
    let dram_dmem_lo : logic<23> = {dmem_addr[24:3], 1'b0};
    let dram_dmem_hi : logic<23> = {dmem_addr[24:3], 1'b1};

    always_ff (clk, rst) {
        if_reset {} else {
            if dmem_wen && dmem_in_dram {
                if dmem_wstrb[0] { dram[dram_dmem_lo][7:0]   = dmem_wdata[7:0]; }
                if dmem_wstrb[1] { dram[dram_dmem_lo][15:8]  = dmem_wdata[15:8]; }
                if dmem_wstrb[2] { dram[dram_dmem_lo][23:16] = dmem_wdata[23:16]; }
                if dmem_wstrb[3] { dram[dram_dmem_lo][31:24] = dmem_wdata[31:24]; }
                if dmem_wstrb[4] { dram[dram_dmem_hi][7:0]   = dmem_wdata[39:32]; }
                if dmem_wstrb[5] { dram[dram_dmem_hi][15:8]  = dmem_wdata[47:40]; }
                if dmem_wstrb[6] { dram[dram_dmem_hi][23:16] = dmem_wdata[55:48]; }
                if dmem_wstrb[7] { dram[dram_dmem_hi][31:24] = dmem_wdata[63:56]; }
            }
        }
    }

    // dmem read path — single port, broadcast to both harts inside SoC.
    let dmem_in_fw  : logic     = dmem_addr[31:14] == 18'd0;
    let fw_dmem_lo  : logic<12> = {dmem_addr[13:3], 1'b0};
    let fw_dmem_hi  : logic<12> = {dmem_addr[13:3], 1'b1};
    assign dmem_rdata = if dmem_in_dram ? {dram[dram_dmem_hi], dram[dram_dmem_lo]}
                      : if dmem_in_fw   ? {fw_rom[fw_dmem_hi], fw_rom[fw_dmem_lo]}
                      : 64'd0;

    // Per-hart imem and iptw read paths (still independent ports).
    for h in 0..N_HARTS: gen_mem {
        let imem_in_fw   : logic     = imem_addr[h][31:14] == 18'd0;
        let imem_in_dram : logic     = imem_addr[h][31];
        let dram_imem_idx: logic<23> = imem_addr[h][24:2];
        let fw_imem_idx  : logic<12> = imem_addr[h][13:2];
        assign imem_rdata[h] = if imem_in_fw   ? fw_rom[fw_imem_idx]
                            : if imem_in_dram ? dram[dram_imem_idx]
                            : 32'd0;

        let iptw_in_fw   : logic     = iptw_addr[h][31:14] == 18'd0;
        let iptw_in_dram : logic     = iptw_addr[h][31];
        let dram_iptw_lo : logic<23> = {iptw_addr[h][24:3], 1'b0};
        let dram_iptw_hi : logic<23> = {iptw_addr[h][24:3], 1'b1};
        let fw_iptw_lo   : logic<12> = {iptw_addr[h][13:3], 1'b0};
        let fw_iptw_hi   : logic<12> = {iptw_addr[h][13:3], 1'b1};
        let iptw_lo: logic<32> = if iptw_in_dram ? dram[dram_iptw_lo]
                              : if iptw_in_fw   ? fw_rom[fw_iptw_lo]
                              : 32'd0;
        let iptw_hi: logic<32> = if iptw_in_dram ? dram[dram_iptw_hi]
                              : if iptw_in_fw   ? fw_rom[fw_iptw_hi]
                              : 32'd0;
        assign iptw_rdata[h] = {iptw_hi, iptw_lo};
    }

    // ============================================================
    // Pass criterion: hart 0 reaches the SBI shutdown convention.
    // (cycle_cnt declared earlier so stage prints can reference it.)
    // ============================================================

    // UART output trace — capped at 16K bytes so the bg-task log isn't
    // truncated past the trigger output. Sufficient to see the boot
    // progress up to "Brought up 1 node, 2 CPUs" or any early panic.
    var uart_print_cnt: logic<32>;
    always_ff (clk, rst) {
        if_reset {
            uart_print_cnt = 32'd0;
        } else {
            if uart_tx && uart_print_cnt <: 32'd16384 {
                $write("%c", uart_data);
                uart_print_cnt = uart_print_cnt + 32'd1;
            }
        }
    }

    // Progress trace: every 1M cycles, summary line. Reduce I/O overhead
    // for long sim runs (2B+ cycles needed to reach SBI shutdown on 2-hart).
    always_ff (clk, rst) {
        if_reset {
        } else {
            if cycle_cnt[23:0] == 24'd0 && cycle_cnt != 32'd0 {
                $write("[smp-trace cyc=%h h1_pc=%h h1_ret=%h h0_pc=%h max_h0=%h max_h1=%h]\n",
                       cycle_cnt, h1_pc, h1_retire_cnt, h0_pc, max_init_pc_h0, max_init_pc_h1);
            }
            // Every ~33M cycles, dump per-hart firmware entry counters so
            // we can confirm the timer / msip / SBI paths actually fire on
            // hart 1 before the deadlock.
            if cycle_cnt[24:0] == 25'd0 && cycle_cnt != 32'd0 {
                $write("[fw-cnt cyc=%h h0(m=%h e=%h sw_irq=%h hipi=%h intc=%h) h1(trap=%h irq=%h m=%h e=%h sw_irq=%h hipi=%h intc=%h)]\n",
                       cycle_cnt,
                       h0_msip_cnt, h0_ecall_cnt, h0_swirq_cyc, h0_handle_ipi_cnt, h0_intc_irq_cnt,
                       h1_trap_cnt, h1_irq_cnt, h1_msip_cnt, h1_ecall_cnt, h1_swirq_cyc, h1_handle_ipi_cnt, h1_intc_irq_cnt);
                $write("[sched-cnt cyc=%h h0(ttwu=%h ttwu_up=%h mstop=%h stopper=%h inv=%h) h1(ttwu=%h ttwu_up=%h mstop=%h stopper=%h inv=%h)]\n",
                       cycle_cnt,
                       h0_sched_ttwu_cnt, h0_try_wake_cnt, h0_multi_stop_cnt, h0_stopper_cnt, h0_inv_cyc,
                       h1_sched_ttwu_cnt, h1_try_wake_cnt, h1_multi_stop_cnt, h1_stopper_cnt, h1_inv_cyc);
                $write("[ipi-cnt cyc=%h h0(clr=%h smask=%h scall=%h) h1(clr=%h smask=%h scall=%h)]\n",
                       cycle_cnt,
                       h0_clear_ipi_cnt, h0_send_ipi_cnt, h0_send_call_cnt,
                       h1_clear_ipi_cnt, h1_send_ipi_cnt, h1_send_call_cnt);
                $write("[msip-write cyc=%h msip0_total=%h msip1_total=%h fw(v02=%h leg_msip0=%h leg_msip1=%h) h0@382(addr0=%h addr4=%h) h1@382(addr0=%h addr4=%h) grant_h0=%h grant_h1=%h clint_wen=%h]\n",
                       cycle_cnt,
                       msip0_set_total, msip1_set_total,
                       fw_v02_msip_writes, fw_legacy_msip0_writes, fw_legacy_msip1_writes,
                       h0_at382_addr0, h0_at382_addr4, h1_at382_addr0, h1_at382_addr4,
                       h0_grant_total, h1_grant_total, clint_wen_total);
                $write("[fw-path cyc=%h h0(trap=%h ecall=%h sbi_ipi=%h sbi_lipi=%h) h1(trap=%h ecall=%h sbi_ipi=%h sbi_lipi=%h)]\n",
                       cycle_cnt,
                       h0_fw_trap_cnt, h0_fw_ecall_cnt, h0_fw_sbi_ipi_cnt, h0_fw_sbi_lipi_cnt,
                       h1_fw_trap_cnt, h1_fw_ecall_cnt, h1_fw_sbi_ipi_cnt, h1_fw_sbi_lipi_cnt);
                $write("[mmio-req cyc=%h h0(req_msip0=%h req_msip1=%h) h1(req_msip0=%h req_msip1=%h)]\n",
                       cycle_cnt,
                       h0_req_msip0_cyc, h0_req_msip1_cyc,
                       h1_req_msip0_cyc, h1_req_msip1_cyc);
                $write("[sbi-ipi-exits cyc=%h h0(done=%h uns=%h at382_raw=%h) h1(done=%h uns=%h at382_raw=%h)]\n",
                       cycle_cnt,
                       h0_sbi_ipi_done_cnt, h0_sbi_ipi_uns_cnt, h0_at382_raw,
                       h1_sbi_ipi_done_cnt, h1_sbi_ipi_uns_cnt, h1_at382_raw);
                $write("[trap-cnt cyc=%h h0(ssip=%h stip=%h seip=%h msip=%h mtip=%h other=%h) h1(ssip=%h stip=%h seip=%h msip=%h mtip=%h other=%h)]\n",
                       cycle_cnt,
                       h0_trap_ssip_cnt, h0_trap_stip_cnt, h0_trap_seip_cnt, h0_trap_msip_cnt, h0_trap_mtip_cnt, h0_trap_other_cnt,
                       h1_trap_ssip_cnt, h1_trap_stip_cnt, h1_trap_seip_cnt, h1_trap_msip_cnt, h1_trap_mtip_cnt, h1_trap_other_cnt);
                $write("[sch2-cnt cyc=%h h0(sch=%h schi=%h tick=%h enqRT=%h) h1(sch=%h schi=%h tick=%h enqRT=%h)]\n",
                       cycle_cnt,
                       h0_sched_cnt, h0_sched_idle_cnt, h0_sched_tick_cnt, h0_enq_rt_cnt,
                       h1_sched_cnt, h1_sched_idle_cnt, h1_sched_tick_cnt, h1_enq_rt_cnt);
                $write("[unpark cyc=%h h0(unpkT=%h kunpk=%h create=%h stp_in=%h ms_in=%h) h1(unpkT=%h kunpk=%h create=%h stp_in=%h ms_in=%h)]\n",
                       cycle_cnt,
                       h0_unpark_thr_cnt, h0_kth_unpark_cnt, h0_create_thr_cnt, h0_stopper_in_cyc, h0_mstop_in_cyc,
                       h1_unpark_thr_cnt, h1_kth_unpark_cnt, h1_create_thr_cnt, h1_stopper_in_cyc, h1_mstop_in_cyc);
                $write("[bind cyc=%h h0(setcpu=%h allow=%h kbind=%h seltRT=%h selT=%h stopOne=%h wakeP=%h setstop=%h setsch=%h chpi=%h smunpk=%h) h1(setcpu=%h allow=%h kbind=%h seltRT=%h selT=%h stopOne=%h wakeP=%h setstop=%h setsch=%h chpi=%h smunpk=%h)]\n",
                       cycle_cnt,
                       h0_set_taskcpu_cnt, h0_set_allow_cnt, h0_kth_bind_cnt, h0_seltask_rt_cnt, h0_seltask_cnt, h0_stop_one_cnt, h0_wake_proc_cnt, h0_set_stop_cnt, h0_set_sched_cnt, h0_chp_idle_cnt, h0_smunpark_cnt,
                       h1_set_taskcpu_cnt, h1_set_allow_cnt, h1_kth_bind_cnt, h1_seltask_rt_cnt, h1_seltask_cnt, h1_stop_one_cnt, h1_wake_proc_cnt, h1_set_stop_cnt, h1_set_sched_cnt, h1_chp_idle_cnt, h1_smunpark_cnt);
                $write("[stop-cls cyc=%h h0(seltop=%h pickN=%h setN=%h) h1(seltop=%h pickN=%h setN=%h)]\n",
                       cycle_cnt,
                       h0_seltask_stop_cnt, h0_picknxt_stop_cnt, h0_setnxt_stop_cnt,
                       h1_seltask_stop_cnt, h1_picknxt_stop_cnt, h1_setnxt_stop_cnt);
            }
        }
    }

    assign o_dbg_r3        = h0_x3;
    assign o_dbg_pc0       = h0_pc;
    assign o_dbg_pc1       = h1_pc;
    assign o_h1_kernel_seen = h1_kernel_seen;
    assign o_h1_retire_cnt  = h1_retire_cnt;
    assign o_h1_callin      = h1_smp_callin_seen;
    assign o_h1_notify      = h1_notify_seen;
    assign o_h1_set_online  = h1_set_online_seen;
    assign o_h1_complete    = h1_complete_seen;
    // Pass: either hart 0 wrote 0xAA (SBI shutdown — full Linux boot
    // through to userspace, may exceed cycle budget) OR kernel printed
    // "Brought up" indicating both CPUs successfully online (SMP boot
    // success, sufficient for Phase 4 K6/K7).
    // Pass: either hart 0 wrote 0xAA (SBI shutdown — Phase 5 SMP boot
    // through to userspace panic + SBI SRST, currently blocked by an
    // unidentified deadlock past init_sched_rt_class) OR kernel printed
    // "Brought up" confirming both CPUs online. The "Brought up" branch
    // currently lets the test pass; SBI shutdown is the Phase 5 close
    // criterion still under investigation.
    // Phase 5 SBI-shutdown verification: pass on h0_x3==0xAA only (full
    // boot through to userspace SBI SRST). The "Brought up" branch is
    // disabled here so we observe whether the fixed timer path actually
    // carries the kernel through to shutdown.
    assign o_pass = (h0_x3 == 64'h00000000000000aa);
}

#[test(test_smp_linux_boot)]
#[ignore]
module test_smp_linux_boot {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen(clk);

    var pass      : logic    ;
    var r3        : logic<64>;
    var pc0       : logic<64>;
    var pc1       : logic<64>;
    var h1_seen   : logic    ;
    var h1_retired: logic<32>;
    var h1_callin     : logic;
    var h1_notify     : logic;
    var h1_set_online : logic;
    var h1_complete   : logic;

    inst harness: test_linux_boot_smp_harness (
        clk             : clk        ,
        rst             : rst        ,
        o_pass          : pass       ,
        o_dbg_r3        : r3         ,
        o_dbg_pc0       : pc0        ,
        o_dbg_pc1       : pc1        ,
        o_h1_kernel_seen: h1_seen    ,
        o_h1_retire_cnt : h1_retired ,
        o_h1_callin     : h1_callin    ,
        o_h1_notify     : h1_notify    ,
        o_h1_set_online : h1_set_online,
        o_h1_complete   : h1_complete  ,
    );

    initial {
        rst.assert(clk);
        // Wait for SBI shutdown. 500M cycles default; experiments with 2B
        // cycles still show the kernel deadlocks in driver_init body
        // around max_init_pc_h0=0x8081e17a (memory_bus fairness gives the
        // furthest progress, but kthreads on hart 1 never actually clear
        // the wait_for_completion blocks). Reaching SBI shutdown requires
        // either working IPI infrastructure or sim-level WFI halt to make
        // a 5B+ cycle run feasible.
        for _i in 0..6000 {
            clk.next(10000);
            if pass {
                break;
            }
        }
        $display("test_smp_linux_boot r3=%h pass=%d hart1_pc=%h hart1_kernel=%d hart1_retired=%d callin=%d notify=%d set_online=%d complete=%d",
                 r3, pass, pc1, h1_seen, h1_retired,
                 h1_callin, h1_notify, h1_set_online, h1_complete);
        $assert (pass, "heliodor_soc N=2 Linux boot failed");
        $display("test_smp_linux_boot boot passed");
        $finish ();
    }
}
