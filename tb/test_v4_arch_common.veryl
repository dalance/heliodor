#[test(test_v4_arch_rv64ui_srl)]
#[ignore]
module test_v4_arch_rv64ui_srl {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen(clk);
    var pass: logic; var fail: logic; var tohost: logic<32>;
    inst h: test_v4_arch_common_harness #(HEX_FILE: "test/riscv-arch-test/build/rv64ui/srl.hex", TOHOST_IDX: 1024) (clk, rst, o_pass: pass, o_fail: fail, o_tohost: tohost);
    initial {
        rst.assert(clk); clk.next(300000);
