module test_arch_rv64ui_andi_harness (
    clk     : input  clock    ,
    rst     : input  reset    ,
    o_pass  : output logic    ,
    o_fail  : output logic    ,
    o_tohost: output logic<32>,
) {
    var imem_addr : logic<64>     ;
