// M6.B.2 FP smoke test for the v4 OoO core.
//
// Reuses test_v4_arch_common_harness (DRAM @ 0x80000000 + tohost @
// 0x80001000) to run custom/fp_smoke.hex, which exercises the FPU compute
// datapath (FCVT int↔fp, FADD/FSUB/FMUL .S/.D, FEQ/FLT, FMV.X.D/FMV.D.X)
// without any FP load/store (those are wired in M6.B.3). tohost==1 → pass.
#[test(test_v4_fp_smoke)]
#[ignore]
module test_v4_fp_smoke {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var pass  : logic    ;
    var fail  : logic    ;
    var tohost: logic<32>;
    inst h: test_v4_arch_common_harness #(
        HEX_FILE  : "test/riscv-arch-test/build/custom/fp_smoke.hex",
        TOHOST_IDX: 1024                                            ,
    ) (
        clk                ,
        rst                ,
        o_pass    : pass   ,
        o_fail    : fail   ,
        o_tohost  : tohost ,
    );
    initial {
        rst.assert(clk);
        clk.next  (200000);
        $display  ("v4 fp_smoke tohost=%h pass=%b", tohost, pass);
        $assert   (pass, "v4 fp_smoke fail");
        $display  ("v4 fp_smoke PASS");
        $finish   ();
    }
}
