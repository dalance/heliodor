// Phase 7 v4 Linux stub boot scaffolding.
//
// Memory map (matches v1):
//   PA 0x00000000 : Firmware ROM (16 KB, linux_boot_fw.hex)
//   PA 0x02000000 : CLINT (internal)
//   PA 0x10000000 : UART  (internal stub — prints via $write)
//   PA 0x80000000 : DRAM  (256 KB, kernel + DTB from linux_dram.hex)
//
// This is a wiring scaffold: it instantiates heliodor_core_v4 with a
// memory map that mirrors the v1 stub harness, ties CLINT timer/sw
// irqs into the core, and exposes arch_shadow[3] (= x3) so a boot
// completes when the SBI SRST shutdown stub writes 0xAA there. It is
// expected to NOT yet reach SBI shutdown — multiple v4 capabilities
// still need work (Sv39 cross-page PTW, dcache, real WFI, etc.).
// Goal of this scaffold is to provide the surface area for incremental
// v4 boot debug.
module test_v4_linux_stub_harness (
    clk   : input  clock    ,
    rst   : input  reset    ,
    o_pass: output logic    ,
    o_r3  : output logic<64>,
) {
    var imem_addr      : logic<64>     ;
    var imem_rdata     : logic<32>     ;
    var imem_ren       : logic         ;
    var dmem_addr      : logic<64>     ;
    var dmem_wdata     : logic<64>     ;
    var dmem_rdata     : logic<64>     ;
    var dmem_rdata_next: logic<64>     ;
    var dmem_wen       : logic         ;
    var dmem_ren       : logic         ;
    var dmem_wstrb     : logic<8>      ;
    var dmem_wdata_hi  : logic<64>     ;
    var dmem_wstrb_hi  : logic<8>      ;
    var dbg_regs       : logic<64> [32];
    var dbg_pc         : logic<64>     ;
    var ret_v          : logic         ;
    var ret_pc         : logic<64>     ;
    var ret_rdv        : logic         ;
    var ret_rd         : logic<5>      ;
    var ret_data       : logic<64>     ;
    var dbg_rename_cnt : logic<32>     ;
    var dbg_cdb_cnt    : logic<32>     ;
    var dbg_rob_size   : logic<8>      ;
    var dbg_if_v       : logic         ;
    var dbg_if_instr   : logic<32>     ;
    var dbg_stall_dr   : logic         ;
    var dbg_head_valid : logic         ;
    var dbg_head_rw    : logic         ;
    var dbg_head_il    : logic         ;
    var dbg_r_alloc    : logic<32>     ;
    var dbg_r_cdb      : logic<32>     ;
    var dbg_r_commit   : logic<32>     ;
    var dbg_r_head     : logic<6>      ;
    var dbg_r_tail     : logic<6>      ;
    var dbg_sepc      : logic<64>;
    var dbg_mepc      : logic<64>;
    var dbg_priv      : logic<2>;
    var dbg_trap_fire : logic;
    var dbg_trap_pc   : logic<64>;
    var dbg_trap_cause: logic<64>;
    var dbg_trap_to_s : logic;
    var dbg_satp      : logic<64>;
    var dbg_imem_vaddr: logic<64>;
    var dbg_imem_paddr: logic<64>;
    var dbg_imem_valid: logic;
    var dbg_imem_fault: logic;
    var dbg_csrwr_v   : logic;
    var dbg_csrwr_addr: logic<12>;
    var dbg_csrwr_wdata:logic<64>;
    var dbg_ptw_req   : logic;
    var dbg_ptw_addr  : logic<64>;
    var dbg_ptw_data  : logic<64>;

    // CLINT signals
    var clint_rdata    : logic<64>     ;
    var clint_timer_irq: logic [1]     ;
    var clint_sw_irq   : logic [1]     ;
    var clint_mtime    : logic<64>     ;

    inst dut: heliodor_core_v4 #(
        RESET_PC: 64'h00000000,
    ) (
        clk                            ,
        rst                            ,
        o_imem_addr        : imem_addr      ,
        i_imem_rdata       : imem_rdata     ,
        o_imem_ren         : imem_ren       ,
        o_dmem_addr        : dmem_addr      ,
        o_dmem_wdata       : dmem_wdata     ,
        i_dmem_rdata       : dmem_rdata     ,
        i_dmem_rdata_next  : dmem_rdata_next,
        o_dmem_wen         : dmem_wen       ,
        o_dmem_ren         : dmem_ren       ,
        o_dmem_wstrb       : dmem_wstrb     ,
        o_dmem_wdata_hi    : dmem_wdata_hi  ,
        o_dmem_wstrb_hi    : dmem_wstrb_hi  ,
        i_irq_timer_m      : clint_timer_irq[0],
        i_irq_sw_m         : clint_sw_irq[0]   ,
        i_irq_ext_m        : 1'b0              ,
        o_dbg_pc           : dbg_pc     ,
        o_dbg_regs         : dbg_regs   ,
        o_dbg_retire_v_a   : ret_v      ,
        o_dbg_retire_pc_a  : ret_pc     ,
        o_dbg_retire_rd_v_a: ret_rdv    ,
        o_dbg_retire_rd_a  : ret_rd     ,
        o_dbg_retire_data_a: ret_data   ,
        o_dbg_rename_cnt   : dbg_rename_cnt ,
        o_dbg_cdb_cnt      : dbg_cdb_cnt    ,
        o_dbg_rob_size     : dbg_rob_size   ,
        o_dbg_if_v         : dbg_if_v       ,
        o_dbg_if_instr     : dbg_if_instr   ,
        o_dbg_stall_dr     : dbg_stall_dr   ,
        o_dbg_head_valid   : dbg_head_valid ,
        o_dbg_head_rw      : dbg_head_rw    ,
        o_dbg_head_illegal : dbg_head_il    ,
        o_dbg_rob_alloc_cnt: dbg_r_alloc    ,
        o_dbg_rob_cdb_cnt  : dbg_r_cdb      ,
        o_dbg_rob_commit_cnt: dbg_r_commit  ,
        o_dbg_rob_head     : dbg_r_head     ,
        o_dbg_rob_tail     : dbg_r_tail     ,
        o_dbg_sepc         : dbg_sepc       ,
        o_dbg_mepc         : dbg_mepc       ,
        o_dbg_priv         : dbg_priv       ,
        o_dbg_trap_fire    : dbg_trap_fire  ,
        o_dbg_trap_pc      : dbg_trap_pc    ,
        o_dbg_trap_cause   : dbg_trap_cause ,
        o_dbg_trap_to_s    : dbg_trap_to_s  ,
        o_dbg_satp         : dbg_satp       ,
        o_dbg_imem_vaddr   : dbg_imem_vaddr ,
        o_dbg_imem_paddr   : dbg_imem_paddr ,
        o_dbg_imem_valid   : dbg_imem_valid ,
        o_dbg_imem_fault   : dbg_imem_fault ,
        o_dbg_csrwr_v      : dbg_csrwr_v    ,
        o_dbg_csrwr_addr   : dbg_csrwr_addr ,
        o_dbg_csrwr_wdata  : dbg_csrwr_wdata,
        o_dbg_ptw_req      : dbg_ptw_req,
        o_dbg_ptw_addr     : dbg_ptw_addr,
        o_dbg_ptw_data     : dbg_ptw_data,
    );

    // Firmware ROM: 16 KB
    var fw_rom: logic<32> [4096];
    // DRAM: 256 KB
    var dram: logic<32> [65536];
    initial {
        $readmemh("test/hex/linux_boot_fw.hex", fw_rom);
        $readmemh("test/hex/linux_dram.hex", dram);
    }

    let imem_in_fw : logic = imem_addr[31:14] == 18'd0;
    let in_fw      : logic = dmem_addr[31:14] == 18'd0;
    let in_dram    : logic = dmem_addr[31];
    let in_uart    : logic = dmem_addr[31:28] == 4'h1;
    let in_clint   : logic = dmem_addr[31:24] == 8'h02;

    let dram_imem_idx: logic<16> = imem_addr[17:2];
    let fw_imem_idx  : logic<12> = imem_addr[13:2];
    assign imem_rdata = if imem_in_fw ? fw_rom[fw_imem_idx]
                        : if imem_addr[31] ? dram[dram_imem_idx]
                        : 32'd0;

    let dram_dmem_lo : logic<16> = {dmem_addr[17:3], 1'b0};
    let dram_dmem_hi : logic<16> = {dmem_addr[17:3], 1'b1};
    let dram_dmem_nx_lo: logic<16> = {(dmem_addr[17:3] + 15'd1), 1'b0};
    let dram_dmem_nx_hi: logic<16> = {(dmem_addr[17:3] + 15'd1), 1'b1};
    let fw_dmem_lo  : logic<12> = {dmem_addr[13:3], 1'b0};
    let fw_dmem_hi  : logic<12> = {dmem_addr[13:3], 1'b1};

    // dmem read: DRAM / firmware ROM / CLINT (UART read returns 0 stub)
    assign dmem_rdata = if in_dram ? {dram[dram_dmem_hi], dram[dram_dmem_lo]}
                        : if in_fw   ? {fw_rom[fw_dmem_hi], fw_rom[fw_dmem_lo]}
                        : if in_clint ? clint_rdata
                        : 64'd0;
    assign dmem_rdata_next = if in_dram ? {dram[dram_dmem_nx_hi], dram[dram_dmem_nx_lo]}
                             : 64'd0;

    // CLINT instance (1 hart)
    inst u_clint: clint #(
        N_HARTS: 1,
    ) (
        clk            ,
        rst            ,
        i_addr     : dmem_addr[15:0],
        i_wdata    : dmem_wdata     ,
        i_wen      : dmem_wen && in_clint,
        i_ren      : dmem_ren && in_clint,
        o_rdata    : clint_rdata    ,
        o_timer_irq: clint_timer_irq,
        o_sw_irq   : clint_sw_irq   ,
        o_mtime    : clint_mtime    ,
    );
    let _unused_mtime: logic<64> = clint_mtime;
    let _unused_t_irq: logic = clint_timer_irq[0];
    let _unused_s_irq: logic = clint_sw_irq[0];

    // dmem write
    always_ff (clk, rst) {
        if_reset {} else if dmem_wen && in_dram {
            if dmem_wstrb[0] { dram[dram_dmem_lo][7:0]   = dmem_wdata[7:0];   }
            if dmem_wstrb[1] { dram[dram_dmem_lo][15:8]  = dmem_wdata[15:8];  }
            if dmem_wstrb[2] { dram[dram_dmem_lo][23:16] = dmem_wdata[23:16]; }
            if dmem_wstrb[3] { dram[dram_dmem_lo][31:24] = dmem_wdata[31:24]; }
            if dmem_wstrb[4] { dram[dram_dmem_hi][7:0]   = dmem_wdata[39:32]; }
            if dmem_wstrb[5] { dram[dram_dmem_hi][15:8]  = dmem_wdata[47:40]; }
            if dmem_wstrb[6] { dram[dram_dmem_hi][23:16] = dmem_wdata[55:48]; }
            if dmem_wstrb[7] { dram[dram_dmem_hi][31:24] = dmem_wdata[63:56]; }
            if dmem_wstrb_hi[0] { dram[dram_dmem_nx_lo][7:0]   = dmem_wdata_hi[7:0];   }
            if dmem_wstrb_hi[1] { dram[dram_dmem_nx_lo][15:8]  = dmem_wdata_hi[15:8];  }
            if dmem_wstrb_hi[2] { dram[dram_dmem_nx_lo][23:16] = dmem_wdata_hi[23:16]; }
            if dmem_wstrb_hi[3] { dram[dram_dmem_nx_lo][31:24] = dmem_wdata_hi[31:24]; }
            if dmem_wstrb_hi[4] { dram[dram_dmem_nx_hi][7:0]   = dmem_wdata_hi[39:32]; }
            if dmem_wstrb_hi[5] { dram[dram_dmem_nx_hi][15:8]  = dmem_wdata_hi[47:40]; }
            if dmem_wstrb_hi[6] { dram[dram_dmem_nx_hi][23:16] = dmem_wdata_hi[55:48]; }
            if dmem_wstrb_hi[7] { dram[dram_dmem_nx_hi][31:24] = dmem_wdata_hi[63:56]; }
        } else if dmem_wen && in_uart {
            if dmem_wstrb[0] { $write("%c", dmem_wdata[7:0]); }
            if dmem_wstrb[1] { $write("%c", dmem_wdata[15:8]); }
            if dmem_wstrb[2] { $write("%c", dmem_wdata[23:16]); }
            if dmem_wstrb[3] { $write("%c", dmem_wdata[31:24]); }
            if dmem_wstrb[4] { $write("%c", dmem_wdata[39:32]); }
            if dmem_wstrb[5] { $write("%c", dmem_wdata[47:40]); }
            if dmem_wstrb[6] { $write("%c", dmem_wdata[55:48]); }
            if dmem_wstrb[7] { $write("%c", dmem_wdata[63:56]); }
        }
    }

    assign o_r3   = dbg_regs[3];
    assign o_pass = dbg_regs[3] == 64'hAA;

    // Trap firing trace + periodic PC trace.
    // Capture first trap's PC/cause/etc. into sticky regs (Veryl sim
    // appears to silently drop $display deep inside always_ff conds —
    // sample state into vars and dump in periodic trace).
    var cyc           : logic<32>;
    var trap_seen     : logic<16>;
    var first_trap_pc : logic<64>;
    var first_trap_cause: logic<64>;
    var first_trap_cy : logic<32>;
    var first_trap_priv: logic<2>;
    var first_trap_to_s: logic;
    // 2nd/3rd trap capture
    var trap2_pc : logic<64>;
    var trap2_cause: logic<64>;
    var trap2_cy : logic<32>;
    var trap2_priv: logic<2>;
    var trap2_to_s: logic;
    var trap3_pc : logic<64>;
    var trap3_cause: logic<64>;
    var trap3_cy : logic<32>;
    var trap3_priv: logic<2>;
    var trap3_to_s: logic;
    // 0xDD reached marker
    var r3_dd_seen: logic;
    var r3_dd_cy  : logic<32>;
    var r3_dd_pc  : logic<64>;
    // 0xEE reached marker
    var r3_ee_seen: logic;
    var r3_ee_cy  : logic<32>;
    // Sliding-window retire trace of last 64 commits. Each entry stores
    // (pc, rd, data) for the commit. fw_ring_idx is the next write
    // position; samples are dumped chronologically when stuck condition
    // triggers (r3 == 0xDD).
    var fw_ring_idx: logic<6>;
    var fw_ring_pc : logic<64> [64];
    var fw_ring_rd : logic<5>  [64];
    var fw_ring_dat: logic<64> [64];
    var dd_dumped  : logic;
    // Capture first 4 satp writes
    var satp_cnt   : logic<4>;
    var satp_w1_cy : logic<32>; var satp_w1_data: logic<64>; var satp_w1_pc: logic<64>;
    var satp_w2_cy : logic<32>; var satp_w2_data: logic<64>; var satp_w2_pc: logic<64>;
    var satp_w3_cy : logic<32>; var satp_w3_data: logic<64>; var satp_w3_pc: logic<64>;
    var satp_w4_cy : logic<32>; var satp_w4_data: logic<64>; var satp_w4_pc: logic<64>;
    // PTW capture: first 8 PTW reads with addr + data
    var ptw_cnt   : logic<5>;
    var ptw1_cy: logic<32>; var ptw1_addr: logic<64>; var ptw1_data: logic<64>;
    var ptw2_cy: logic<32>; var ptw2_addr: logic<64>; var ptw2_data: logic<64>;
    var ptw3_cy: logic<32>; var ptw3_addr: logic<64>; var ptw3_data: logic<64>;
    var ptw4_cy: logic<32>; var ptw4_addr: logic<64>; var ptw4_data: logic<64>;
    var ptw5_cy: logic<32>; var ptw5_addr: logic<64>; var ptw5_data: logic<64>;
    var ptw6_cy: logic<32>; var ptw6_addr: logic<64>; var ptw6_data: logic<64>;
    var ptw7_cy: logic<32>; var ptw7_addr: logic<64>; var ptw7_data: logic<64>;
    var ptw8_cy: logic<32>; var ptw8_addr: logic<64>; var ptw8_data: logic<64>;
    always_ff (clk, rst) {
        if_reset {
            cyc       = 32'd0;
            trap_seen = 16'd0;
            first_trap_pc    = 64'd0;
            first_trap_cause = 64'd0;
            first_trap_cy    = 32'd0;
            first_trap_priv  = 2'd0;
            first_trap_to_s  = 1'b0;
            trap2_pc = 64'd0; trap2_cause = 64'd0; trap2_cy = 32'd0; trap2_priv = 2'd0; trap2_to_s = 1'b0;
            trap3_pc = 64'd0; trap3_cause = 64'd0; trap3_cy = 32'd0; trap3_priv = 2'd0; trap3_to_s = 1'b0;
            r3_dd_seen = 1'b0; r3_dd_cy = 32'd0; r3_dd_pc = 64'd0;
            r3_ee_seen = 1'b0; r3_ee_cy = 32'd0;
            fw_ring_idx = 6'd0;
            dd_dumped = 1'b0;
            satp_cnt = 4'd0;
            satp_w1_cy = 32'd0; satp_w1_data = 64'd0; satp_w1_pc = 64'd0;
            satp_w2_cy = 32'd0; satp_w2_data = 64'd0; satp_w2_pc = 64'd0;
            satp_w3_cy = 32'd0; satp_w3_data = 64'd0; satp_w3_pc = 64'd0;
            satp_w4_cy = 32'd0; satp_w4_data = 64'd0; satp_w4_pc = 64'd0;
            ptw_cnt = 5'd0;
            ptw1_cy = 32'd0; ptw1_addr = 64'd0; ptw1_data = 64'd0;
            ptw2_cy = 32'd0; ptw2_addr = 64'd0; ptw2_data = 64'd0;
            ptw3_cy = 32'd0; ptw3_addr = 64'd0; ptw3_data = 64'd0;
            ptw4_cy = 32'd0; ptw4_addr = 64'd0; ptw4_data = 64'd0;
            ptw5_cy = 32'd0; ptw5_addr = 64'd0; ptw5_data = 64'd0;
            ptw6_cy = 32'd0; ptw6_addr = 64'd0; ptw6_data = 64'd0;
            ptw7_cy = 32'd0; ptw7_addr = 64'd0; ptw7_data = 64'd0;
            ptw8_cy = 32'd0; ptw8_addr = 64'd0; ptw8_data = 64'd0;
            for i in 0..64 {
                fw_ring_pc[i]  = 64'd0;
                fw_ring_rd[i]  = 5'd0;
                fw_ring_dat[i] = 64'd0;
            }
        } else {
            cyc = cyc + 32'd1;
            if dbg_trap_fire {
                trap_seen = trap_seen + 16'd1;
                if trap_seen == 16'd0 {
                    first_trap_pc    = dbg_trap_pc;
                    first_trap_cause = dbg_trap_cause;
                    first_trap_cy    = cyc;
                    first_trap_priv  = dbg_priv;
                    first_trap_to_s  = dbg_trap_to_s;
                } else if trap_seen == 16'd1 {
                    trap2_pc = dbg_trap_pc; trap2_cause = dbg_trap_cause; trap2_cy = cyc; trap2_priv = dbg_priv; trap2_to_s = dbg_trap_to_s;
                } else if trap_seen == 16'd2 {
                    trap3_pc = dbg_trap_pc; trap3_cause = dbg_trap_cause; trap3_cy = cyc; trap3_priv = dbg_priv; trap3_to_s = dbg_trap_to_s;
                }
            }
            // Sliding window: capture every retire (with rd write) until frozen
            if ret_v && !dd_dumped {
                fw_ring_pc[fw_ring_idx]  = ret_pc;
                fw_ring_rd[fw_ring_idx]  = if ret_rdv ? ret_rd : 5'd0;
                fw_ring_dat[fw_ring_idx] = if ret_rdv ? ret_data : 64'd0;
                fw_ring_idx = fw_ring_idx + 6'd1;
            }
            // Freeze ring once r3 first hits 0xDD (stop writing further)
            if r3_dd_seen && !dd_dumped {
                dd_dumped = 1'b1;
            }
            // Sticky capture: each csrwr to satp (addr 0x180)
            if dbg_csrwr_v && dbg_csrwr_addr == 12'h180 {
                if satp_cnt == 4'd0 {
                    satp_w1_cy = cyc; satp_w1_data = dbg_csrwr_wdata; satp_w1_pc = dbg_pc;
                } else if satp_cnt == 4'd1 {
                    satp_w2_cy = cyc; satp_w2_data = dbg_csrwr_wdata; satp_w2_pc = dbg_pc;
                } else if satp_cnt == 4'd2 {
                    satp_w3_cy = cyc; satp_w3_data = dbg_csrwr_wdata; satp_w3_pc = dbg_pc;
                } else if satp_cnt == 4'd3 {
                    satp_w4_cy = cyc; satp_w4_data = dbg_csrwr_wdata; satp_w4_pc = dbg_pc;
                }
                if satp_cnt != 4'd15 { satp_cnt = satp_cnt + 4'd1; }
            }
            // PTW capture: every PTW req in priv=S (post-satp activation)
            if dbg_ptw_req && dbg_priv != 2'd3 && !dd_dumped {
                if ptw_cnt == 5'd0 {
                    ptw1_cy = cyc; ptw1_addr = dbg_ptw_addr; ptw1_data = dbg_ptw_data;
                } else if ptw_cnt == 5'd1 {
                    ptw2_cy = cyc; ptw2_addr = dbg_ptw_addr; ptw2_data = dbg_ptw_data;
                } else if ptw_cnt == 5'd2 {
                    ptw3_cy = cyc; ptw3_addr = dbg_ptw_addr; ptw3_data = dbg_ptw_data;
                } else if ptw_cnt == 5'd3 {
                    ptw4_cy = cyc; ptw4_addr = dbg_ptw_addr; ptw4_data = dbg_ptw_data;
                } else if ptw_cnt == 5'd4 {
                    ptw5_cy = cyc; ptw5_addr = dbg_ptw_addr; ptw5_data = dbg_ptw_data;
                } else if ptw_cnt == 5'd5 {
                    ptw6_cy = cyc; ptw6_addr = dbg_ptw_addr; ptw6_data = dbg_ptw_data;
                } else if ptw_cnt == 5'd6 {
                    ptw7_cy = cyc; ptw7_addr = dbg_ptw_addr; ptw7_data = dbg_ptw_data;
                } else if ptw_cnt == 5'd7 {
                    ptw8_cy = cyc; ptw8_addr = dbg_ptw_addr; ptw8_data = dbg_ptw_data;
                }
                if ptw_cnt != 5'd31 { ptw_cnt = ptw_cnt + 5'd1; }
            }
            if !r3_dd_seen && dbg_regs[3] == 64'hDD {
                r3_dd_seen = 1'b1;
                r3_dd_cy = cyc;
                r3_dd_pc = dbg_pc;
            }
            if !r3_ee_seen && dbg_regs[3] == 64'hEE {
                r3_ee_seen = 1'b1;
                r3_ee_cy = cyc;
            }
            if cyc[12:0] == 13'd0 {
                $display("v4 linux: cy=%h pc=%h commit=%h x3=%h priv=%h sepc=%h mepc=%h trap_cnt=%h",
                          cyc, dbg_pc, dbg_r_commit, dbg_regs[3], dbg_priv, dbg_sepc, dbg_mepc, trap_seen);
                $display("v4   trap[0]: cy=%h pc=%h cause=%h priv=%h to_s=%b",
                          first_trap_cy, first_trap_pc, first_trap_cause, first_trap_priv, first_trap_to_s);
                $display("v4   trap[1]: cy=%h pc=%h cause=%h priv=%h to_s=%b",
                          trap2_cy, trap2_pc, trap2_cause, trap2_priv, trap2_to_s);
                $display("v4   trap[2]: cy=%h pc=%h cause=%h priv=%h to_s=%b",
                          trap3_cy, trap3_pc, trap3_cause, trap3_priv, trap3_to_s);
                $display("v4   r3_dd: seen=%b cy=%h pc=%h    r3_ee: seen=%b cy=%h",
                          r3_dd_seen, r3_dd_cy, r3_dd_pc, r3_ee_seen, r3_ee_cy);
                $display("v4   immu: satp=%h vaddr=%h paddr=%h valid=%b fault=%b",
                          dbg_satp, dbg_imem_vaddr, dbg_imem_paddr, dbg_imem_valid, dbg_imem_fault);
                $display("v4   satp_cnt=%h", satp_cnt);
                $display("v4   satp[0]: cy=%h pc=%h wdata=%h", satp_w1_cy, satp_w1_pc, satp_w1_data);
                $display("v4   satp[1]: cy=%h pc=%h wdata=%h", satp_w2_cy, satp_w2_pc, satp_w2_data);
                $display("v4   satp[2]: cy=%h pc=%h wdata=%h", satp_w3_cy, satp_w3_pc, satp_w3_data);
                $display("v4   satp[3]: cy=%h pc=%h wdata=%h", satp_w4_cy, satp_w4_pc, satp_w4_data);
                $display("v4   ptw_cnt=%h", ptw_cnt);
                $display("v4   ptw[0]: cy=%h addr=%h data=%h", ptw1_cy, ptw1_addr, ptw1_data);
                $display("v4   ptw[1]: cy=%h addr=%h data=%h", ptw2_cy, ptw2_addr, ptw2_data);
                $display("v4   ptw[2]: cy=%h addr=%h data=%h", ptw3_cy, ptw3_addr, ptw3_data);
                $display("v4   ptw[3]: cy=%h addr=%h data=%h", ptw4_cy, ptw4_addr, ptw4_data);
                $display("v4   ptw[4]: cy=%h addr=%h data=%h", ptw5_cy, ptw5_addr, ptw5_data);
                $display("v4   ptw[5]: cy=%h addr=%h data=%h", ptw6_cy, ptw6_addr, ptw6_data);
                $display("v4   ptw[6]: cy=%h addr=%h data=%h", ptw7_cy, ptw7_addr, ptw7_data);
                $display("v4   ptw[7]: cy=%h addr=%h data=%h", ptw8_cy, ptw8_addr, ptw8_data);
                $display("v4 RING (head=%0d, frozen=%b):", fw_ring_idx, dd_dumped);
                for i in 0..64 {
                    $display("v4 ring[%02d] pc=%h rd=%h dat=%h",
                              i, fw_ring_pc[i], fw_ring_rd[i], fw_ring_dat[i]);
                }
            }
        }
    }
}

#[test(test_v4_linux_stub)]
#[ignore]
module test_v4_linux_stub {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen(clk);

    var pass: logic    ;
    var r3  : logic<64>;

    inst harness: test_v4_linux_stub_harness (
        clk   : clk ,
        rst   : rst ,
        o_pass: pass,
        o_r3  : r3  ,
    );

    initial {
        rst.assert(clk);
        clk.next  (500000);
        $display  ("v4 linux stub: x3=%h pass=%b", r3, pass);
        $assert   (pass, "v4 Linux stub boot: expected x3=0xAA (SBI SRST shutdown)");
        $display  ("v4 Linux stub boot PASS");
        $finish   ();
    }
}
