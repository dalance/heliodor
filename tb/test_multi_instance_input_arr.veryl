// Reproducer for the memory_bus N=1 panic
// (project_phase4_bisect.md: "the len is 1 but the index is 1").
//
// Pattern: an input port array `i_arr [N]` (parameterized N), read
// inside the module via dynamic index `arr[idx]` where idx is wider
// than ceil(log2(N)). When N=1 and idx is logic<3>, the simulator
// computes a const-index path with index=1 against an array of size 1.

module input_arr_module #(
    param N: u32 = 1,
) (
    i_arr: input  logic<8> [N],
    i_idx: input  logic<3>    , // 3-bit dyn idx, can value 0..7
    o_val: output logic<8>    ,
) {
    assign o_val = i_arr[i_idx];
}

module test_input_arr_harness #(
    param N: u32 = 1,
) (
    clk    : input  clock         ,
    rst    : input  reset         ,
    o_pass : output logic         ,
    o_val  : output logic<8>      ,
) {
    var arr  : logic<8> [N];
    var idx  : logic<3>;
    var val  : logic<8>;
    var cycle: logic<32>;

    inst u: input_arr_module #(N: N) (
        i_arr: arr,
        i_idx: idx,
        o_val: val,
    );

    always_ff (clk, rst) {
        if_reset {
            cycle = 32'd0;
        } else {
            cycle = cycle + 32'd1;
        }
    }

    always_comb {
        for h in 0..N {
            arr[h] = 8'h0A + ({6'd0, h as 2});
        }
    }
    assign idx = 3'd0; // always read element 0 (within range)

    assign o_pass = val == 8'h0A;
    assign o_val  = val;
}

#[test(test_multi_instance_input_arr_n1)]
module test_multi_instance_input_arr_n1 {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen(clk);

    var pass: logic;
    var val : logic<8>;

    inst h: test_input_arr_harness #(N: 1) (
        clk    : clk ,
        rst    : rst ,
        o_pass : pass,
        o_val  : val ,
    );

    initial {
        rst.assert(clk);
        for _i in 0..4 {
            clk.next(10);
        }
        $display("test_input_arr_n1: val=%h pass=%b", val, pass);
        $assert(pass, "input array N=1 dyn-idx read failed");
        $display("test_input_arr_n1: passed");
        $finish();
    }
}
