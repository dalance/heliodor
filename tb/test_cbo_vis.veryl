// cbo.clean/flush/inval seen by an agent outside the coherence domain
// (test/cmo/cbo_vis.S): the tb writes and checks the DRAM behind the SoC's
// AXI port directly (boot_soc_harness BD_OPS) at fixed cycles, and checks
// each stored line in the cycle hart 0 retires the CMO on it (the CMO must
// not complete before its writeback has its B). The 2-hart runs then read
// the stored lines through System Bus Access
// (test/debug/dmi/cbo_vis_sba.dmi), which must see them (design doc D.11).
// The program reports through tohost before the DRAM checks at CHK_CY, so a
// run is judged at its end. The AXI variants (W2) run the same program
// under WR_LAG (slow W and B), STALL and REORDER.

package cbo_vis_pkg {
    import axi4_tb_pkg::*;

    const POKE_CY: logic<32> = 32'd20000;
    const CHK_CY : logic<32> = 32'd30000;

    const OPS1_N: u32            = 6;
    const OPS1  : BdOp [OPS1_N] = '{
        BdOp'{cy: POKE_CY, wr: 1'b1, pa: 64'h8000_0880, data: 64'hc2c2_c2c2_c2c2_c2c2, cbo: 1'b0},
        BdOp'{cy: POKE_CY, wr: 1'b1, pa: 64'h8000_0940, data: 64'hf2f2_f2f2_f2f2_f2f2, cbo: 1'b0},
        BdOp'{cy: CHK_CY, wr: 1'b0, pa: 64'h8000_0800, data: 64'ha1a1_a1a1_a1a1_a1a1, cbo: 1'b0},
        BdOp'{cy: CHK_CY, wr: 1'b0, pa: 64'h8000_0840, data: 64'hb1b1_b1b1_b1b1_b1b1, cbo: 1'b0},
        BdOp'{cy: 32'd0, wr: 1'b0, pa: 64'h8000_0800, data: 64'ha1a1_a1a1_a1a1_a1a1, cbo: 1'b1},
        BdOp'{cy: 32'd0, wr: 1'b0, pa: 64'h8000_0840, data: 64'hb1b1_b1b1_b1b1_b1b1, cbo: 1'b1}
    };

    const OPS2_N: u32            = 11;
    const OPS2  : BdOp [OPS2_N] = '{
        BdOp'{cy: POKE_CY, wr: 1'b1, pa: 64'h8000_0880, data: 64'hc2c2_c2c2_c2c2_c2c2, cbo: 1'b0},
        BdOp'{cy: POKE_CY, wr: 1'b1, pa: 64'h8000_0940, data: 64'hf2f2_f2f2_f2f2_f2f2, cbo: 1'b0},
        BdOp'{cy: POKE_CY, wr: 1'b1, pa: 64'h8000_0980, data: 64'h6262_6262_6262_6262, cbo: 1'b0},
        BdOp'{cy: CHK_CY, wr: 1'b0, pa: 64'h8000_0800, data: 64'ha1a1_a1a1_a1a1_a1a1, cbo: 1'b0},
        BdOp'{cy: CHK_CY, wr: 1'b0, pa: 64'h8000_0840, data: 64'hb1b1_b1b1_b1b1_b1b1, cbo: 1'b0},
        BdOp'{cy: CHK_CY, wr: 1'b0, pa: 64'h8000_08c0, data: 64'hd1d1_d1d1_d1d1_d1d1, cbo: 1'b0},
        BdOp'{cy: CHK_CY, wr: 1'b0, pa: 64'h8000_0900, data: 64'he1e1_e1e1_e1e1_e1e1, cbo: 1'b0},
        BdOp'{cy: 32'd0, wr: 1'b0, pa: 64'h8000_0800, data: 64'ha1a1_a1a1_a1a1_a1a1, cbo: 1'b1},
        BdOp'{cy: 32'd0, wr: 1'b0, pa: 64'h8000_0840, data: 64'hb1b1_b1b1_b1b1_b1b1, cbo: 1'b1},
        BdOp'{cy: 32'd0, wr: 1'b0, pa: 64'h8000_08c0, data: 64'hd1d1_d1d1_d1d1_d1d1, cbo: 1'b1},
        BdOp'{cy: 32'd0, wr: 1'b0, pa: 64'h8000_0900, data: 64'he1e1_e1e1_e1e1_e1e1, cbo: 1'b1}
    };
}

module cbo_vis_harness #(
    param N_HARTS: u32                   = 1                    ,
    param CORE   : soc_pkg::CoreSel      = tb_core_sel::CORE_W2 ,
    param AXI_CFG: axi4_tb_pkg::SlaveCfg = axi4_tb_pkg::FIXED   ,
) (
    clk     : input  clock    ,
    rst     : input  reset    ,
    o_pass  : output logic    ,
    o_fail  : output logic    ,
    o_cycles: output logic<64>,
) {
    if N_HARTS == 1 :g_n1 {
        inst u_h: boot_soc_harness #(
            N_HARTS    : 1                           ,
            DRAM_HEX   : "test/cmo/cbo_vis1.hex"     ,
            ROM_EN     : 1'b0                        ,
            PMA_N      : tb_platform_pkg::MAP_ARCH_N ,
            PMA_REGIONS: tb_platform_pkg::MAP_ARCH   ,
            RESET_PC   : 64'h8000_0000               ,
            PASS_BY_X3 : 1'b0                        ,
            TOHOST_PA  : 64'h8000_1000               ,
            CORE       : CORE                        ,
            AXI_CFG    : AXI_CFG                     ,
            BD_N       : cbo_vis_pkg::OPS1_N         ,
            BD_OPS     : cbo_vis_pkg::OPS1           ,
        ) (
            clk             ,
            rst             ,
            o_pass          ,
            o_fail          ,
            o_x3     : _    ,
            o_cycles        ,
            o_instret: _    ,
            o_last_pc: _    ,
            o_ret_cnt: _    ,
            o_traps  : _    ,
        );
    } else :g_n2 {
        inst u_h: boot_soc_harness #(
            N_HARTS    : 2                                ,
            DRAM_HEX   : "test/cmo/cbo_vis2.hex"          ,
            ROM_EN     : 1'b0                             ,
            PMA_N      : tb_platform_pkg::MAP_ARCH_N      ,
            PMA_REGIONS: tb_platform_pkg::MAP_ARCH        ,
            RESET_PC   : 64'h8000_0000                    ,
            PASS_BY_X3 : 1'b0                             ,
            TOHOST_PA  : 64'h8000_1000                    ,
            CORE       : CORE                             ,
            AXI_CFG    : AXI_CFG                          ,
            DMI_EN     : 1'b1                             ,
            DMI_FILE   : "test/debug/dmi/cbo_vis_sba.hex" ,
            BD_N       : cbo_vis_pkg::OPS2_N              ,
            BD_OPS     : cbo_vis_pkg::OPS2                ,
        ) (
            clk             ,
            rst             ,
            o_pass          ,
            o_fail          ,
            o_x3     : _    ,
            o_cycles        ,
            o_instret: _    ,
            o_last_pc: _    ,
            o_ret_cnt: _    ,
            o_traps  : _    ,
        );
    }
}

#[test(test_w2_cbo_vis_1hart)]
module test_w2_cbo_vis_1hart {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass  : logic    ;
    var fail  : logic    ;
    var cycles: logic<64>;

    inst h: cbo_vis_harness #(
        N_HARTS: 1                    ,
        CORE   : tb_core_sel::CORE_W2 ,
        AXI_CFG: axi4_tb_pkg::FIXED   ,
    ) (
        clk             ,
        rst             ,
        o_pass  : pass  ,
        o_fail  : fail  ,
        o_cycles: cycles,
    );

    initial {
        rst.assert(clk);
        clk.next(45000);
        $display("w2 cbo_vis(N=1): cycles=%d pass=%b fail=%b", cycles, pass, fail);
        $assert (pass, "w2 cbo_vis(N=1): DRAM backdoor check, stale line after a CMO, trap or timeout");
        $finish ();
    }
}

