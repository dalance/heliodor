// fp_misc in the input windows where it deliberately differs from fpu_wrap
// (fp_tb_pkg::known_div), against hand-computed IEEE 754 results with
// tininess detected after rounding; and the fu_fdiv checker on an injected
// issue to the busy unit.
#[test(test_fp_misc_directed)]
module test_fp_misc_directed {
    import fpu_pkg::FpuOp;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var op : FpuOp    ;
    var a  : logic<64>;
    var rm : logic<3> ;
    var res: logic<64>;
    var ffl: logic<5> ;

    inst dut: fp_misc (
        i_op    : op   ,
        i_a     : a    ,
        i_b     : 64'd0,
        i_rm    : rm   ,
        i_fli   : 5'd0 ,
        o_result: res  ,
        o_fflags: ffl  ,
    );

    function set (
        e_op: input FpuOp    ,
        e_a : input logic<64>,
        e_rm: input logic<3> ,
    ) {
        op = e_op;
        a  = e_a;
        rm = e_rm;
    }

    // fu_fdiv presented an op while busy.
    var f_valid: logic                              ;
    var f_rdy  : logic                              ;
    var f_chk  : logic                      <2>     ;
    var f_src  : logic                      <64> [2];
    var f_tag  : core_types::<cfg_w2>::ExTag        ;
    var f_kill : core_types::<cfg_w2>::Kill         ;
    var f_grant: fu_pkg::WbSlot                     ;
    always_comb {
        f_src[0] = 64'h4000_0000_0000_0000;
        f_src[1] = 64'h3FF0_0000_0000_0000;
        f_tag    = 0 as core_types::<cfg_w2>::ExTag;
        f_kill   = 0 as core_types::<cfg_w2>::Kill;
        f_grant  = 0 as fu_pkg::WbSlot;
    }
    inst u_fdiv: fu_fdiv::<cfg_w2> (
        clk                      ,
        rst                      ,
        i_valid   : f_valid      ,
        i_op      : FpuOp::FDIV_D,
        i_tag     : f_tag        ,
        i_src     : f_src        ,
        i_rm      : 3'b000       ,
        i_frm     : 3'b000       ,
        i_kill    : f_kill       ,
        o_ready   : f_rdy        ,
        o_hf_req  : _            ,
        o_hf_tag  : _            ,
        i_wb_grant: f_grant      ,
        o_wb      : _            ,
        o_perf    : _            ,
        o_chk     : f_chk        ,
    );

    initial {
        f_valid = 1'b0;
        rst.assert(clk);
        clk.next(2);

        // 2^31 - 0.5 rounds to 2^31: out of range, NV (fpu_wrap: NX).
        set(FpuOp::FCVT_W_D, 64'h41DF_FFFF_FFE0_0000, 3'b000);
        clk.next(1);
        $assert(res == 64'h0000_0000_7FFF_FFFF && ffl == 5'b10000, "FCVT.W.D 2^31-0.5 RNE");

        // -(2^31 + 0.5) rounds to -2^31 under RNE: in range, NX (fpu_wrap: NV).
        set(FpuOp::FCVT_W_D, 64'hC1E0_0000_0010_0000, 3'b000);
        clk.next(1);
        $assert(res == 64'hFFFF_FFFF_8000_0000 && ffl == 5'b00001, "FCVT.W.D -(2^31+0.5) RNE");

        // The same value under RDN rounds to -2^31 - 1: NV.
        set(FpuOp::FCVT_W_D, 64'hC1E0_0000_0010_0000, 3'b010);
        clk.next(1);
        $assert(res == 64'hFFFF_FFFF_8000_0000 && ffl == 5'b10000, "FCVT.W.D -(2^31+0.5) RDN");

        // 2^32 - 0.5 rounds to 2^32: out of range for WU, NV (fpu_wrap: NX).
        set(FpuOp::FCVT_WU_D, 64'h41EF_FFFF_FFF0_0000, 3'b000);
        clk.next(1);
        $assert(res == 64'hFFFF_FFFF_FFFF_FFFF && ffl == 5'b10000, "FCVT.WU.D 2^32-0.5 RNE");

        // FCVTMOD truncates -(2^31 + 0.5) to -2^31: in range, NX (fpu_wrap: NV).
        set(FpuOp::FCVTMOD_W_D, 64'hC1E0_0000_0010_0000, 3'b001);
        clk.next(1);
        $assert(res == 64'hFFFF_FFFF_8000_0000 && ffl == 5'b00001, "FCVTMOD.W.D -(2^31+0.5)");

        // (2 - 2^-24) * 2^127 rounds to 2^128 under RNE: OF and NX (fpu_wrap:
        // NX only); RTZ truncates it to the largest finite value.
        set(FpuOp::FCVT_S_D, 64'h47EF_FFFF_F000_0000, 3'b000);
        clk.next(1);
        $assert(res == 64'hFFFF_FFFF_7F80_0000 && ffl == 5'b00101, "FCVT.S.D overflow by rounding RNE");
        set(FpuOp::FCVT_S_D, 64'h47EF_FFFF_F000_0000, 3'b001);
        clk.next(1);
        $assert(res == 64'hFFFF_FFFF_7F7F_FFFF && ffl == 5'b00001, "FCVT.S.D near overflow RTZ");

        // (2 - 2^-24) * 2^-127 rounds to 2^-126 at full precision: not tiny,
        // NX only (fpu_wrap: UF and NX).
        set(FpuOp::FCVT_S_D, 64'h380F_FFFF_F000_0000, 3'b000);
        clk.next(1);
        $assert(res == 64'hFFFF_FFFF_0080_0000 && ffl == 5'b00001, "FCVT.S.D tininess after rounding");

        // (2 - 2^-23) * 2^-127 is exact at full precision, so tiny, and the
        // subnormal rounding still reaches 2^-126: UF and NX.
        set(FpuOp::FCVT_S_D, 64'h380F_FFFF_E000_0000, 3'b000);
        clk.next(1);
        $assert(res == 64'hFFFF_FFFF_0080_0000 && ffl == 5'b00011, "FCVT.S.D tiny rounding to min normal");

        // 1.5 * 2^-25 rounds to the smallest half subnormal (fpu_wrap: 0).
        set(FpuOp::FCVT_H_D, 64'h3E68_0000_0000_0000, 3'b000);
        clk.next(1);
        $assert(res == 64'hFFFF_FFFF_FFFF_0001 && ffl == 5'b00011, "FCVT.H.D 1.5*2^-25 RNE");

        // 2^-30 rounds up under RUP, to zero under RNE.
        set(FpuOp::FCVT_H_D, 64'h3E10_0000_0000_0000, 3'b011);
        clk.next(1);
        $assert(res == 64'hFFFF_FFFF_FFFF_0001 && ffl == 5'b00011, "FCVT.H.D 2^-30 RUP");
        set(FpuOp::FCVT_H_D, 64'h3E10_0000_0000_0000, 3'b000);
        clk.next(1);
        $assert(res == 64'hFFFF_FFFF_FFFF_0000 && ffl == 5'b00011, "FCVT.H.D 2^-30 RNE");

        // (2 - 2^-11) * 2^-15 rounds to 2^-14 at full precision: NX only
        // (fpu_wrap: UF and NX).
        set(FpuOp::FCVT_H_S, 64'hFFFF_FFFF_387F_F000, 3'b000);
        clk.next(1);
        $assert(res == 64'hFFFF_FFFF_FFFF_0400 && ffl == 5'b00001, "FCVT.H.S tininess after rounding");
        set(FpuOp::FCVT_H_D, 64'h3F0F_FE00_0000_0000, 3'b000);
        clk.next(1);
        $assert(res == 64'hFFFF_FFFF_FFFF_0400 && ffl == 5'b00001, "FCVT.H.D tininess after rounding");

        // |x| in [2^53, 2^63) shifts left (fpu_wrap: -2^53 gives -2^52).
        set(FpuOp::FCVT_L_D, 64'hC340_0000_0000_0000, 3'b000);
        clk.next(1);
        $assert(res == 64'hFFE0_0000_0000_0000 && ffl == 5'b00000, "FCVT.L.D -2^53");
        set(FpuOp::FCVT_L_D, 64'h43D0_0000_0000_0F8F, 3'b000);
        clk.next(1);
        $assert(res == 64'h4000_0000_003E_3C00 && ffl == 5'b00000, "FCVT.L.D 2^62 + 0xF8F * 2^10");

        // fu_fdiv checker: a second op while the first is in the unit.
        f_valid = 1'b1;
        clk.next(1);
        $assert(!f_rdy, "fu_fdiv ready after accept");
        clk.next(1);
        f_valid = 1'b0;
        clk.next(1);
        $assert(f_chk == 2'b01, "fu_fdiv busy-issue checker did not fire");
        $finish();
    }
}
