#[test(test_w2_privd_sstc)]
module test_w2_privd_sstc {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var pass  : logic    ;
    var fail  : logic    ;
    var tohost: logic<32>;
    inst h: test_arch_common_harness #(
        CORE      : tb_core_sel::CORE_W2     ,
        HEX_FILE  : "test/sstc/sstc_test.hex",
        TOHOST_IDX: 1024                     ,
