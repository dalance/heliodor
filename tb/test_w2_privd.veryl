        clk             ,
        rst             ,
        o_pass  : pass  ,
        o_fail  : fail  ,
        o_tohost: tohost,
    );
    initial {
        rst.assert(clk);
        for _i in 0..100 {
            clk.next(1000);
            if pass || fail {
                break;
            }
        }
        $display("w2 privd/sstc (pass/fail) tohost=%h pass=%b", tohost, pass);
        $assert(pass, "w2 privd/sstc fail");
        $finish();
    }
}

