// Unit test for fp_reservation_station: dispatch → CDB wakeup → issue.
module test_fp_reservation_station_harness (
    clk      : input  clock    ,
    rst      : input  reset    ,
    o_cycle  : output logic<16>,
    o_issued : output logic    ,
    o_s1_data: output logic<64>,
    o_s2_data: output logic<64>,
    o_s3_data: output logic<64>,
    o_rob    : output logic<5> ,
    o_done   : output logic    ,
    o_pass   : output logic    ,
) {
    var cyc             : logic<16>     ;
    var squash_mask_zero: logic     [32];
    always_comb {
        for i in 0..32 {
            squash_mask_zero[i] = 1'b0;
        }
    }
    always_ff (clk, rst) {
        if_reset {
            cyc = 16'd0;
        } else {
            cyc = cyc + 16'd1;
        }
    }

    // Dispatch one FADD.D at cycle 2 with rs1 pending (tag=3, epoch=0),
    // rs2 ready (data=0x4000...), rs3 unused (ready, data=0).
    // CDB broadcasts tag=3 data=0x3FF0... at cycle 4. Issue should fire
    // cycle 5 with correct operands.
    var disp_valid   : logic    ;
    var disp_s1_ready: logic    ;
    var disp_s2_ready: logic    ;
    var disp_s3_ready: logic    ;
    var cdb_valid    : logic    ;
    var cdb_rob      : logic<5> ;
    var cdb_data     : logic<64>;

    always_comb {
        disp_valid    = cyc == 16'd2;
        disp_s1_ready = 1'b0; // rs1 depends on rob_idx=3
        disp_s2_ready = 1'b1; // rs2 ready with 2.0
        disp_s3_ready = 1'b1; // rs3 unused (fp_wen=1 but no FMA)
        cdb_valid     = cyc == 16'd4;
        cdb_rob       = 5'd3;
        cdb_data      = 64'h3FF0000000000000; // 1.0
    }

    var issue_valid : logic             ;
    var issue_pc    : logic         <64>;
    var issue_rob   : logic         <5> ;
    var issue_s1    : logic         <64>;
    var issue_s2    : logic         <64>;
    var issue_s3    : logic         <64>;
    var issue_op    : fpu_pkg::FpuOp    ;
    var issue_rm    : logic         <3> ;
    var issue_rd    : logic         <5> ;
    var issue_rs1   : logic         <5> ;
    var issue_rs2   : logic         <5> ;
    var issue_rs3   : logic         <5> ;
    var issue_wen   : logic             ;
    var issue_fflags: logic             ;
    var issue_epoch : logic         <2> ;
    var disp_ready  : logic             ;
    var sel_vld     : logic             ;

    inst u_rs: fp_reservation_station (
        clk                                            ,
        rst                                            ,
        i_dispatch_valid       : disp_valid            ,
        i_dispatch_pc          : 64'h1000              ,
        i_dispatch_fpu_op      : fpu_pkg::FpuOp::FADD_D,
        i_dispatch_rm          : 3'b000                ,
        i_dispatch_rd          : 5'd7                  ,
        i_dispatch_rs1         : 5'd1                  ,
        i_dispatch_rs2         : 5'd2                  ,
        i_dispatch_rs3         : 5'd0                  ,
        i_dispatch_fp_wen      : 1'b1                  ,
        i_dispatch_fflags_valid: 1'b1                  ,
        i_dispatch_rob         : 5'd5                  ,
        i_dispatch_epoch       : 2'd0                  ,
        i_dispatch_s1_ready    : disp_s1_ready         ,
        i_dispatch_s1_tag      : 5'd3                  , // waiting for rob=3
        i_dispatch_s1_epoch    : 2'd0                  ,
        i_dispatch_s1_data     : 64'd0                 ,
        i_dispatch_s2_ready    : disp_s2_ready         ,
        i_dispatch_s2_tag      : 5'd0                  ,
        i_dispatch_s2_epoch    : 2'd0                  ,
        i_dispatch_s2_data     : 64'h4000000000000000  , // 2.0
        i_dispatch_s3_ready    : disp_s3_ready         ,
        i_dispatch_s3_tag      : 5'd0                  ,
        i_dispatch_s3_epoch    : 2'd0                  ,
        i_dispatch_s3_data     : 64'd0                 ,
        o_dispatch_ready       : disp_ready            ,
        o_issue_valid          : issue_valid           ,
        o_issue_pc             : issue_pc              ,
        o_issue_fpu_op         : issue_op              ,
        o_issue_rm             : issue_rm              ,
        o_issue_rd             : issue_rd              ,
        o_issue_rs1            : issue_rs1             ,
        o_issue_rs2            : issue_rs2             ,
        o_issue_rs3            : issue_rs3             ,
        o_issue_s1_data        : issue_s1              ,
        o_issue_s2_data        : issue_s2              ,
        o_issue_s3_data        : issue_s3              ,
        o_issue_fp_wen         : issue_wen             ,
        o_issue_fflags_valid   : issue_fflags          ,
        o_issue_rob            : issue_rob             ,
        o_issue_epoch          : issue_epoch           ,
        i_issue_stall          : 1'b0                  ,
        i_fp_cdb0_valid        : cdb_valid             ,
        i_fp_cdb0_rob          : cdb_rob               ,
        i_fp_cdb0_epoch        : 2'd0                  ,
        i_fp_cdb0_data         : cdb_data              ,
        i_fp_cdb1_valid        : 1'b0                  ,
        i_fp_cdb1_rob          : 5'd0                  ,
        i_fp_cdb1_epoch        : 2'd0                  ,
        i_fp_cdb1_data         : 64'd0                 ,
        i_flush                : 1'b0                  ,
        i_squash_valid         : 1'b0                  ,
        i_squash_mask          : squash_mask_zero      ,
        o_sel_valid            : sel_vld               ,
    );

    // Latch the issue observation for end-of-test check.
    var saw_issue: logic    ;
    var saw_s1   : logic<64>;
    var saw_s2   : logic<64>;
    var saw_s3   : logic<64>;
    var saw_rob  : logic<5> ;
    always_ff (clk, rst) {
        if_reset {
            saw_issue = 1'b0;
            saw_s1    = '0;
            saw_s2    = '0;
            saw_s3    = '0;
            saw_rob   = '0;
        } else if issue_valid && !saw_issue {
            saw_issue = 1'b1;
            saw_s1    = issue_s1;
            saw_s2    = issue_s2;
            saw_s3    = issue_s3;
            saw_rob   = issue_rob;
        }
    }

    assign o_cycle   = cyc;
    assign o_issued  = saw_issue;
    assign o_s1_data = saw_s1;
    assign o_s2_data = saw_s2;
    assign o_s3_data = saw_s3;
    assign o_rob     = saw_rob;
    assign o_done    = cyc >: 16'd20;
    assign o_pass    = saw_issue && saw_s1
        == 64'h3FF0000000000000 // 1.0 from CDB
         && saw_s2
        == 64'h4000000000000000 // 2.0 from dispatch
         && saw_rob == 5'd5;
}

#[test(test_fp_reservation_station)]
module test_fp_reservation_station {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var cycle  : logic<16>;
    var issued : logic    ;
    var s1_data: logic<64>;
    var s2_data: logic<64>;
    var s3_data: logic<64>;
    var rob    : logic<5> ;
    var done   : logic    ;
    var pass   : logic    ;

    inst harness: test_fp_reservation_station_harness (
        clk               ,
        rst               ,
        o_cycle  : cycle  ,
        o_issued : issued ,
        o_s1_data: s1_data,
        o_s2_data: s2_data,
        o_s3_data: s3_data,
        o_rob    : rob    ,
        o_done   : done   ,
        o_pass   : pass   ,
    );

    initial {
        rst.assert(clk);
        for _i in 0..30 {
            clk.next(1);
        }
        $display("cycle=%d issued=%d s1=%h s2=%h rob=%d", cycle, issued, s1_data, s2_data, rob);
        $assert (pass, "fp_reservation_station: dispatch→CDB wakeup→issue failed");
        $display("fp_reservation_station test passed");
        $finish ();
    }
}
