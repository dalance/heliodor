// LSU checkers fire on injected violations: chk_sb (allocation beyond the
// free entries, ack while empty), chk_sq (retire without retire_ok, an
// allocation in a kill cycle), chk_lq (a re-issue grant for a non-READY
// entry), chk_mem_port (a response with no request, two event sources, a
// killed held HEAD request, a fill under an uncached read) and chk_head (a
// request without token or started latch, a second outstanding request, a
// killed started op, a forbidden request).
#[test(test_lsu_chk)]
module test_lsu_chk {
    import core_types::<cfg_w2>::*;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var stp: logic<8>;

    var sb_c: logic<2>;
    inst u_sb: chk_sb (
        clk                                   ,
        rst                                   ,
        i_alloc: if stp == 8'd2 ? 3 : 1      ,
        i_free : 2                            ,
        i_ack  : stp == 8'd4                 ,
        i_empty: stp == 8'd4                 ,
        o_chk  : sb_c                         ,
    );

    var kill : Kill     ;
    var sqav : logic    [2];
    var sq_c : logic<4> ;
    always_comb {
        kill       = '0;
        kill.valid = stp == 8'd6;
        kill.full  = 1'b1;
        sqav[0]    = stp == 8'd6;
        sqav[1]    = 1'b0;
    }
    inst u_sq: chk_sq::<cfg_w2> #(
        N: 4,
    ) (
        clk                                   ,
        rst                                   ,
        i_kill  : kill                        ,
        i_live  : 4'b0000                     ,
        i_rob   : '{default: '0}              ,
        i_hrdy  : '{default: 1'b0}            ,
        i_alloc_valid: sqav                   ,
        i_win_ok: 1'b0                        ,
        i_ret   : stp == 8'd8                ,
        i_gnt   : 4'b0000                     ,
        o_chk   : sq_c                        ,
    );

    var lqvd: LqVerdict [1];
    var st  : LqState   [4];
    var lq_c: logic<4>  ;
    always_comb {
        lqvd = '{default: '0};
        for e in 0..4 {
            st[e] = LqState::PARK;
        }
    }
    inst u_lq: chk_lq::<cfg_w2> #(
        N: 4,
    ) (
        clk                                          ,
        rst                                          ,
        i_kill   : '0                                ,
        i_live   : 4'b1111                           ,
        i_rob    : '{default: '0}                    ,
        i_state  : st                                ,
        i_alloc_valid: '{1'b0, 1'b0}                 ,
        i_verdict: lqvd                              ,
        i_gnt    : if stp == 8'd10 ? 4'b0010 : 4'b0000,
        o_chk    : lq_c                              ,
    );

    var mreq : MemReq  [1];
    var mresp: MemResp [1];
    var mp_c : logic<6>;
    always_comb {
        mreq        = '{default: '0};
        mresp       = '{default: '0};
        mresp[0].valid = stp == 8'd12;
    }
    inst u_mp: chk_mem_port::<cfg_w2> (
        clk                                          ,
        rst                                          ,
        i_req_valid: '{1'b0}                         ,
        i_req      : mreq                            ,
        i_resp     : mresp                           ,
        i_ev_src   : if stp == 8'd14 ? 5'b00011 : 5'b00000,
        i_miss_hit : 1'b0                            ,
        i_nf_kill  : stp == 8'd16                   ,
        i_skid_lost: 1'b0                            ,
        i_unc_fill : stp == 8'd18                   ,
        o_chk      : mp_c                            ,
    );

    var hd_c: logic<4>;
    inst u_hd: chk_head (
        clk                                          ,
        rst                                          ,
        i_req      : stp == 8'd2 || stp == 8'd4     ,
        i_tok_ok   : stp == 8'd4                    ,
        i_started  : 1'b0                            ,
        i_wait_resp: stp == 8'd4                    ,
        i_kill_st  : stp == 8'd6                    ,
        i_forbid   : stp == 8'd8                    ,
        o_chk      : hd_c                            ,
    );

    always_ff (clk, rst) {
        if_reset {
            stp = 8'd0;
        } else {
            stp = stp + 8'd1;
        }
    }

    initial {
        rst.assert(clk);
        clk.next(20);
        $display("chk: sb=%b sq=%b lq=%b mp=%b hd=%b", sb_c, sq_c, lq_c, mp_c, hd_c);
        $assert(sb_c == 2'b11, "chk_sb did not fire");
        $assert(sq_c == 4'b0110, "chk_sq did not fire as expected");
        $assert(lq_c == 4'b1000, "chk_lq did not fire as expected");
        $assert(mp_c == 6'b101101, "chk_mem_port did not fire as expected");
        $assert(hd_c == 4'b1111, "chk_head did not fire as expected");
        $finish();
    }
}
