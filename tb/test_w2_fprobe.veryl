#[test(test_w2_fprobe_b04_frm)]
module test_w2_fprobe_b04_frm {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var pass  : logic    ;
    var fail  : logic    ;
    var tohost: logic<32>;
    inst h: test_arch_common_harness #(
        CORE      : tb_core_sel::CORE_W2       ,
        HEX_FILE  : "test/directed/b04_frm.hex",
        TOHOST_IDX: 1024                       ,
    ) (
        clk             ,
        rst             ,
        o_pass  : pass  ,
        o_fail  : fail  ,
        o_tohost: tohost,
    );
    initial {
        rst.assert(clk);
        for _i in 0..200 {
            clk.next(1000);
            if pass || fail {
                break;
            }
        }
        $display("w2 fprobe/b04_frm (pass/fail) tohost=%h pass=%b", tohost, pass);
        $assert(pass, "w2 fprobe/b04_frm fail");
        $finish();
    }
}

