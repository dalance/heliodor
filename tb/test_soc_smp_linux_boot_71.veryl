// Linux 7.1 RVA23 SMP boot (N=2 / N=4), driven through heliodor_soc_smp.
//
// Reuses test_soc_smp_linux_boot_harness (parameterized by N_HARTS / HEX_FW /
// HEX_DRAM) with the 7.1 SMP assets: one SMP kernel Image (CONFIG_SMP,
// NR_CPUS=8) + the RVA23 firmware (menvcfg STCE/PBMTE/ADUE + SBI DBCN, same
// hex for every hart count) + the 2/4-cpu RVA23 device trees. The N>=2 boot is
// what exercises Zawrs (wrs.{nto,sto} busy-wait across harts) on top of Svadu /
// Svinval. Pass = hart0 x3 == 0xAA (SBI SRST shutdown).
//
//   veryl test --ignored --test test_soc_71_smp_linux_boot_2hart
//   veryl test --ignored --test test_soc_71_smp_linux_boot_4hart

#[test(test_soc_71_smp_linux_boot_2hart)]
#[ignore]
module test_soc_71_smp_linux_boot_2hart {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass     : logic     ;
    var r3       : logic<64> ;
    var cy       : logic<32> ;
    var pc_all   : logic<64> [2];
    var ret_all  : logic<32> [2];
    var trapc_all: logic<32> [2];

    #[allow(missing_port)]
    inst harness: test_soc_smp_linux_boot_harness #(
        N_HARTS  : 2                                ,
        HEX_FW   : "test/hex/linux_boot_fw_71.hex"  ,
        HEX_DRAM : "test/hex/linux_dram_71_2hart.hex",
    ) (
        clk                   ,
        rst                   ,
        o_pass     : pass     ,
        o_r3       : r3       ,
        o_cy       : cy       ,
        o_pc_all   : pc_all   ,
        o_ret_all  : ret_all  ,
        o_trapc_all: trapc_all,
    );

    initial {
        rst.assert(clk);
        // Poll for SBI shutdown (hart0 x3==0xAA); budget 100M cycles. Rising
        // per-hart retire = forward progress; a frozen count = a stuck hart.
        for _i in 0..10000 {
            clk.next(10000);
            if _i % 200 == 0 {
                $display("  [71 n2 probe] cy=%h pc=[%h %h] ret=[%h %h] trap=[%h %h]", cy, pc_all[0], pc_all[1], ret_all[0], ret_all[1], trapc_all[0], trapc_all[1]);
            }
            if pass {
                break;
            }
        }
        $display("linux 7.1 SMP(N=2) boot: cy=%h pass=%b r3=%h", cy, pass, r3);
        for h in 0..2 {
            $display("  hart%h: pc=%h retired=%h traps=%h", h, pc_all[h], ret_all[h], trapc_all[h]);
        }
        $assert(pass, "linux 7.1 SMP(N=2) boot: did not reach SBI shutdown (hart0 x3 != 0xAA)");
        $finish();
    }
}

#[test(test_soc_71_smp_linux_boot_4hart)]
#[ignore]
module test_soc_71_smp_linux_boot_4hart {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass     : logic     ;
    var r3       : logic<64> ;
    var cy       : logic<32> ;
    var pc_all   : logic<64> [4];
    var ret_all  : logic<32> [4];
    var trapc_all: logic<32> [4];

    #[allow(missing_port)]
    inst harness: test_soc_smp_linux_boot_harness #(
        N_HARTS  : 4                                ,
        HEX_FW   : "test/hex/linux_boot_fw_71.hex"  ,
        HEX_DRAM : "test/hex/linux_dram_71_4hart.hex",
    ) (
        clk                   ,
        rst                   ,
        o_pass     : pass     ,
        o_r3       : r3       ,
        o_cy       : cy       ,
        o_pc_all   : pc_all   ,
        o_ret_all  : ret_all  ,
        o_trapc_all: trapc_all,
    );

    initial {
        rst.assert(clk);
        for _i in 0..10000 {
            clk.next(10000);
            if _i % 100 == 0 {
                $display("  [71 n4 probe] cy=%h pc=[%h %h %h %h] ret=[%h %h %h %h] trap=[%h %h %h %h]", cy, pc_all[0], pc_all[1], pc_all[2], pc_all[3], ret_all[0], ret_all[1], ret_all[2], ret_all[3], trapc_all[0], trapc_all[1], trapc_all[2], trapc_all[3]);
            }
            if pass {
                break;
            }
        }
        $display("linux 7.1 SMP(N=4) boot: cy=%h pass=%b r3=%h", cy, pass, r3);
        for h in 0..4 {
            $display("  hart%h: pc=%h retired=%h traps=%h", h, pc_all[h], ret_all[h], trapc_all[h]);
        }
        $assert(pass, "linux 7.1 SMP(N=4) boot: did not reach SBI shutdown (hart0 x3 != 0xAA)");
        $finish();
    }
}
