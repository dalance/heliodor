// tb_core_sel: the core a harness runs when its CORE parameter is left at
// the default. Generated new-core tests name CORE_W2/CORE_W4 explicitly.
package tb_core_sel {
    const CORE_V14: soc_pkg::CoreSel = soc_pkg::CoreSel::V14;
    const CORE_W2 : soc_pkg::CoreSel = soc_pkg::CoreSel::W2;
    const CORE_W4 : soc_pkg::CoreSel = soc_pkg::CoreSel::W4;
    const CORE    : soc_pkg::CoreSel = CORE_V14;
}
