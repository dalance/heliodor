// The DMI script player must fail a script whose checks do not hold: a read
// mismatch and a POLL that runs out of reads (test/debug/dmi/selftest_bad.dmi).
// The passing side is the GD test dbg/dmi_selftest.
#[test(test_dmi_seq_bad)]
module test_dmi_seq_bad {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var pass  : logic    ;
    var fail  : logic    ;
    var tohost: logic<32>;
    inst h: arch_soc_harness #(
        CORE    : soc_pkg::CoreSel::W2             ,
        HEX_FILE: "test/debug/prog/spin.hex"       ,
        DMI_EN  : 1'b1                             ,
        DMI_FILE: "test/debug/dmi/selftest_bad.hex",
    ) (
        clk             ,
        rst             ,
        o_pass  : pass  ,
        o_fail  : fail  ,
        o_tohost: tohost,
    );
    initial {
        rst.assert(clk);
        for _i in 0..20 {
            clk.next(100);
            if pass || fail {
                break;
            }
        }
        $display("dmi_seq bad script: pass=%b fail=%b", pass, fail);
        $assert(fail && !pass, "dm_seq passed a failing script");
        $finish();
    }
}
