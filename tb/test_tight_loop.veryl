// Test: tight loop with RS instructions and BNE (no NOPs)
// Reproduces arch test deadlock pattern:
//   6 RS instructions followed by a direct-path BNE.
module test_tight_loop_harness (
    clk   : input  clock    ,
    rst   : input  reset    ,
    o_pass: output logic    ,
    o_r1  : output logic<64>,
    o_r2  : output logic<64>,
    o_r3  : output logic<64>,
) {
    var imem_addr : logic<64>     ;
    var imem_rdata: logic<32>     ;
    var imem_ren  : logic         ;
    var dmem_addr : logic<64>     ;
    var dmem_wdata: logic<64>     ;
    var dmem_rdata: logic<64>     ;
    var dmem_wen  : logic         ;
    var dmem_ren  : logic         ;
    var dmem_wstrb: logic<8>      ;
    var dbg_regs  : logic<64> [32];
    var dbg_pc    : logic<64>     ;
    var dbg_pass  : logic         ;
    var dbg_r1    : logic<64>     ;
    var dbg_r2    : logic<64>     ;
    var dbg_r3    : logic<64>     ;
    var _iptw_addr: logic<64>     ;
    var _iptw_req : logic         ;

    inst dut: heliodor_top (
        clk                        ,
        rst                        ,
        o_imem_addr    : imem_addr ,
        i_imem_rdata   : imem_rdata,
        o_imem_ren     : imem_ren  ,
        o_iptw_addr    : _iptw_addr,
        o_iptw_req     : _iptw_req ,
        i_iptw_rdata   : 64'd0     ,
        i_uart_rx_data : 8'd0      ,
        i_uart_rx_valid: 1'b0      ,
        o_dmem_addr    : dmem_addr ,
        o_dmem_wdata   : dmem_wdata,
        i_dmem_rdata   : dmem_rdata,
        o_dmem_wen     : dmem_wen  ,
        o_dmem_ren     : dmem_ren  ,
        o_dmem_wstrb   : dmem_wstrb,
        o_dbg_regs     : dbg_regs  ,
        o_dbg_pc       : dbg_pc    ,
        o_dbg_pass     : dbg_pass  ,
        o_dbg_r1       : dbg_r1    ,
        o_dbg_r2       : dbg_r2    ,
        o_dbg_r3       : dbg_r3    ,
        i_ext_irq      : 32'd0     ,
    );

    assign dmem_rdata = 64'd0;

    // Program: two subtests mimicking arch test add (subtests 23 & 24).
    // Subtest A: loop with NOPs (like subtest 23)
    //   0x00: ADDI x4, x0, 0
    //   0x04: ADDI x1, x0, 15
    //   0x08: ADDI x2, x0, 11
    //   0x0C: ADD  x14, x1, x2     # a4 = 26
    //   0x10: NOP
    //   0x14: NOP
    //   0x18: ADDI x6, x14, 0      # x6 = a4 (mv t1, a4)
    //   0x1C: ADDI x4, x4, 1
    //   0x20: ADDI x5, x0, 2
    //   0x24: BNE  x4, x5, -0x20   # back to 0x04, offset=-0x20
    //   0x28: ADDI x7, x0, 26      # x7 = 26 (expected)
    //   0x2C: BNE  x6, x7, 0x50    # fail check → skip to NOP zone
    //
    // Subtest B: tight loop, no NOPs (like subtest 24)
    //   0x30: ADDI x4, x0, 0
    //   0x34: ADDI x1, x0, 13
    //   0x38: ADDI x2, x0, 11
    //   0x3C: ADD  x14, x1, x2     # a4 = 24
    //   0x40: ADDI x4, x4, 1
    //   0x44: ADDI x5, x0, 2
    //   0x48: BNE  x4, x5, -0x14   # back to 0x34, offset=-0x14
    //   0x4C: ADDI x3, x0, 1       # marker: done
    //   0x50+: NOP

    always_comb {
        case imem_addr[7:0] {
            // Subtest A: with NOPs
            8'h00  : imem_rdata = 32'h00000213; // ADDI x4, x0, 0
            8'h04  : imem_rdata = 32'h00f00093; // ADDI x1, x0, 15
            8'h08  : imem_rdata = 32'h00b00113; // ADDI x2, x0, 11
            8'h0C  : imem_rdata = 32'h00208733; // ADD  x14, x1, x2
            8'h10  : imem_rdata = 32'h00000013; // NOP
            8'h14  : imem_rdata = 32'h00000013; // NOP
            8'h18  : imem_rdata = 32'h00070313; // ADDI x6, x14, 0 (mv t1, a4)
            8'h1C  : imem_rdata = 32'h00120213; // ADDI x4, x4, 1
            8'h20  : imem_rdata = 32'h00200293; // ADDI x5, x0, 2
            8'h24  : imem_rdata = 32'hfe521063; // BNE  x4, x5, -0x20 (to 0x04)
            8'h28  : imem_rdata = 32'h01a00393; // ADDI x7, x0, 26
            8'h2C  : imem_rdata = 32'h02731463; // BNE  x6, x7, +0x28 (to 0x54 fail)
            // Subtest B: tight (no NOPs)
            8'h30  : imem_rdata = 32'h00000213; // ADDI x4, x0, 0
            8'h34  : imem_rdata = 32'h00d00093; // ADDI x1, x0, 13
            8'h38  : imem_rdata = 32'h00b00113; // ADDI x2, x0, 11
            8'h3C  : imem_rdata = 32'h00208733; // ADD  x14, x1, x2
            8'h40  : imem_rdata = 32'h00120213; // ADDI x4, x4, 1
            8'h44  : imem_rdata = 32'h00800293; // ADDI x5, x0, 8  (8 iterations)
            8'h48  : imem_rdata = 32'hfe5216e3; // BNE  x4, x5, -0x14 (to 0x34)
            8'h4C  : imem_rdata = 32'h00100193; // ADDI x3, x0, 1
            // Infinite loop to prevent PC from wrapping back to 0x00 and
            // restarting subtest A (which would reset x4 to 0).
            8'h50  : imem_rdata = 32'h0000006f; // JAL x0, 0 (loop to self)
            default: imem_rdata = 32'h0000006f; // JAL x0, 0 (also loop)
        }
    }

    assign o_r1 = dbg_r1;
    assign o_r2 = dbg_r2;
    assign o_r3 = dbg_r3;
    // x3 = 1 (loop finished), x4 = 8 (loop counter, 8 iterations), x14 = 24 (13 + 11)
    assign o_pass = dbg_regs[3] == 64'd1 && dbg_regs[4] == 64'd8 && dbg_regs[14] == 64'd24;
}

#[test(test_tight_loop)]
module test_tight_loop {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass: logic    ;
    var r1  : logic<64>;
    var r2  : logic<64>;
    var r3  : logic<64>;

    inst harness: test_tight_loop_harness ( clk: clk, rst: rst, o_pass: pass, o_r1: r1, o_r2: r2, o_r3: r3 );

    initial {
        rst.assert(clk);
        clk.next  (500);
        $display  ("r1=%h r2=%h r3=%h pass=%b", r1, r2, r3, pass);
        $assert   (pass, "Tight loop test failed");
        $display  ("Tight loop test passed");
        $finish   ();
    }
}
