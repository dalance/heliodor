// LSU walking test: mem_pipe x MEM_W, lq, sq, sb, mem_port_arb,
// atomic_unit, io_unit and the dcache over a
// behavioural memory with the mem_ctrl slot protocol (1-cycle accept,
// latency, 8-beat stream, single-beat uncached reads; a write channel with
// random grants; random line recalls; invalidates of lines this hart cannot
// own; a device with a read side effect).
//
// A synthetic driver plays dispatch, the memory IQ (atomics issue on the
// HEAD pipe once they hold the oldest token), the arch RAT and PRF reads of
// atomic_unit, and commit; mem_pipe hands atomics to atomic_unit, and lq/sq
// offer non-cacheable ops to io_unit. The program is a
// pure function of the op index (loads, stores, fences, atomics and
// non-cacheable accesses over a few lines, with misaligned and line-crossing
// accesses), so a kill simply re-dispatches from the op after keep. Every
// load and atomic is checked at retire against a byte image updated in
// program order; a contended counter, incremented by a remote agent through
// recalls, checks atomicity; device access counts check that every
// non-cacheable access happens exactly once. Random partial kills, withheld
// tokens with interrupt-like full kills, delayed store data, recalls and
// invalidates stress the park, re-issue, replay, watch and reservation paths.
module lsu_harness::<CFG: core_cfg> #(
    param SEED: logic<64> = 1  ,
    param NOPS: u32       = 600,
    param XOPS: bit       = 1  , // atomics and non-cacheable ops in the program
) (
    clk      : input  clock    ,
    rst      : input  reset    ,
    o_done   : output logic    ,
    o_pass   : output logic    ,
    o_retired: output logic<32>,
    o_cov    : output logic<32>,
    o_cov2   : output logic<32>,
    o_cov3   : output logic<8> , // events of more than one pipe or push port
    o_chk    : output logic<32>,
) {
    import core_types::<CFG>::*;
    import opclass_pkg::*;

    const MW: u32 = CFG::MEM_W;
    const CTR_VA: logic<64> = 64'h8000_0f00;
    const IO_VA : logic<64> = 64'h1000_0000;
    const NC_VA : logic<64> = 64'h9000_0000;
    const RN: u32 = CFG::ROB_N;
    const RW: u32 = ROB_IDX_W;
    const CMW: u32 = CFG::COMMIT_W;
    const DW: u32 = CFG::RENAME_W;

    // ---- program ----

    function mix (
        x: input logic<64>,
    ) -> logic<64> {
        var z: logic<64>;
        z = x + 64'h9e37_79b9_7f4a_7c15;
        z = (z ^ (z >> 30)) * 64'hbf58_476d_1ce4_e5b9;
        z = (z ^ (z >> 27)) * 64'h94d0_49bb_1331_11eb;
        return z ^ (z >> 31);
    }

    // kind: 0 load, 1 store, 2 fence, 3 atomic, 4 non-cacheable
    struct POp {
        kind: logic<3> ,
        op  : MemOp    ,
        va  : logic<64>,
        imm : logic<12>,
        data: logic<64>,
        amo : AmoUop   ,
        ctr : logic    , // amoadd.d of 1 on the contended counter
        cmat: logic    , // amocas: the compare value is memory's
        cmp : logic<64>, // amocas: otherwise this (and its inverse above it)
        hi  : logic<64>, // amocas.q: rs2+1
        st  : logic    , // non-cacheable: store
        nc  : logic    , // non-cacheable: DRAM rather than the device
    }

    function pop0 (
        pi: input logic<32>,
    ) -> POp {
        var r  : POp      ;
        var h  : logic<64>;
        var g  : logic<64>;
        var off: logic<6> ;
        var am : logic<3> ;
        var sel: logic<5> ;
        var f3 : logic<3> ;
        var aa : logic<6> ;
        h         = mix(SEED ^ {32'd0, pi});
        g         = mix(h ^ 64'h3c3c_5a5a);
        r.op      = 0 as MemOp;
        r.kind    = if h[3:0] <: 4'd7 || h[3:0] == 4'd15 ? 3'd0 : if h[3:0] <: 4'd14 ? 3'd1 : 3'd2;
        r.op.st   = r.kind == 3'd1;
        r.op.size = h[5:4];
        r.op.sgn  = h[19];
        am        = case h[5:4] {
            2'd0   : 3'b111,
            2'd1   : 3'b110,
            2'd2   : 3'b100,
            default: 3'b000,
        };
        off       = if h[18:16] == 3'd0 ? h[15:10] : {h[12:10], h[15:13] & am};
        r.va      = 64'h8000_0000 | {49'd0, h[8:6], 12'd0} | {57'd0, h[9], 6'd0};
        // a quarter of the accesses hit two hot dwords, for store-load overlap
        if h[24:23] == 2'd0 {
            off  = {2'd0, h[10], h[15:13] & am};
            r.va = 64'h8000_0000;
        }
        r.va      = r.va + {58'd0, off};
        r.imm     = {h[31], h[31:21]};
        r.data    = mix(h);
        r.amo     = '0;
        r.ctr     = 1'b0;
        r.cmat    = g[20];
        r.cmp     = mix(g);
        r.hi      = mix(g ^ 64'h1);
        r.st      = 1'b0;
        r.nc      = 1'b0;
        if XOPS && g[2:0] == 3'd0 {
            r.kind = 3'd3;
        } else if XOPS && g[5:3] == 3'd0 {
            r.kind = 3'd4;
        }
        if r.kind == 3'd3 {
            // LR 6/32, SC 6/32, each AMO op 2/32, amocas 2/32
            sel      = {g[30], g[9:6]};
            r.amo.op = if sel <: 5'd6 ? AmoOp::LR : if sel <: 5'd12 ? AmoOp::SC : if sel >: 5'd29 ? AmoOp::CAS : (((sel - 5'd12) >> 1) + 5'd2) as AmoOp;
            f3       = if r.amo.op == AmoOp::LR || r.amo.op == AmoOp::SC ? {2'b01, g[10]} : if r.amo.op == AmoOp::CAS ? (if g[12:10] >: 3'd4 ? 3'd3 : g[12:10]) : {1'b0, g[11:10]};
            aa       = case f3 {
                3'd0   : 6'b111111,
                3'd1   : 6'b111110,
                3'd2   : 6'b111100,
                3'd3   : 6'b111000,
                default: 6'b110000,
            };
            r.va     = 64'h8000_0000 | {49'd0, g[15:13], 12'd0} | {57'd0, g[16], 6'd0};
            if g[18:17] == 2'd0 {
                r.va = 64'h8000_0000 | {57'd0, g[16], 6'd0};
            }
            r.va     = r.va + {58'd0, g[24:19] & aa};
            if g[27:25] <: 3'd2 && r.amo.op != AmoOp::LR && r.amo.op != AmoOp::SC && r.amo.op != AmoOp::CAS {
                r.ctr    = 1'b1;
                r.amo.op = AmoOp::ADD;
                f3       = 3'd3;
                r.va     = CTR_VA;
                r.data   = 64'd1;
            }
            r.amo.f3  = f3;
            r.op      = mem_op(FuKind::ATOMIC, r.amo as UOP_W);
        }
        if r.kind == 3'd4 {
            r.st      = g[6];
            r.nc      = g[7];
            r.op.st   = g[6];
            r.op.size = g[9:8];
            r.op.sgn  = g[15];
            am        = case g[9:8] {
                2'd0   : 3'b111,
                2'd1   : 3'b110,
                2'd2   : 3'b100,
                default: 3'b000,
            };
            r.va      = if g[7] ? NC_VA | {56'd0, g[14:10], 3'd0} : IO_VA | {60'd0, g[6] || g[10], 3'd0};
            r.va      = r.va | {61'd0, g[13:11] & am};
        }
        return r;
    }

    // An SC usually names the address of an LR one, two or eight ops before
    // it (the last one often after the ownership pin expired).
    function pop (
        pi: input logic<32>,
    ) -> POp {
        var r : POp;
        var p1: POp;
        var p2: POp;
        var pe: POp;
        r  = pop0(pi);
        p1 = pop0(pi - 1);
        p2 = pop0(pi - 2);
        pe = pop0(pi - 8);
        // most LRs are followed by an SC a few ops later
        if XOPS && r.kind <: 3'd3 && ((p2.kind == 3'd3 && p2.amo.op == AmoOp::LR && r.cmp[4:3] != 2'd0) || (pe.kind == 3'd3 && pe.amo.op == AmoOp::LR && r.cmp[5])) {
            r.kind   = 3'd3;
            r.amo.op = AmoOp::SC;
            r.amo.f3 = 3'd3;
            r.va     = r.va & ~64'd7;
            r.ctr    = 1'b0;
        }
        if r.kind == 3'd3 && r.amo.op == AmoOp::SC && r.cmp[1:0] != 2'd0 {
            if p1.kind == 3'd3 && p1.amo.op == AmoOp::LR {
                r.va      = p1.va;
                r.amo.f3  = p1.amo.f3;
            } else if p2.kind == 3'd3 && p2.amo.op == AmoOp::LR {
                r.va      = p2.va;
                r.amo.f3  = p2.amo.f3;
            } else if pe.kind == 3'd3 && pe.amo.op == AmoOp::LR {
                r.va      = pe.va;
                r.amo.f3  = pe.amo.f3;
            }
        }
        if r.kind == 3'd3 {
            r.op = mem_op(FuKind::ATOMIC, r.amo as UOP_W);
        }
        return r;
    }

    // Reference arithmetic of an atomic on the bytes at its address.
    struct ARef {
        wr : logic     ,
        nv : logic<128>, // new bytes from the address
        rd : logic<64> ,
        rd2: logic<64> ,
    }

    function sext (
        v : input logic<64>,
        sz: input logic<2> ,
    ) -> logic<64> {
        return case sz {
            2'd0   : {v[7] repeat 56, v[7:0]},
            2'd1   : {v[15] repeat 48, v[15:0]},
            2'd2   : {v[31] repeat 32, v[31:0]},
            default: v,
        };
    }

    function zext (
        v : input logic<64>,
        sz: input logic<2> ,
    ) -> logic<64> {
        return case sz {
            2'd0   : {56'd0, v[7:0]},
            2'd1   : {48'd0, v[15:0]},
            2'd2   : {32'd0, v[31:0]},
            default: v,
        };
    }

    function ref_amo (
        po : input POp       ,
        old: input logic<128>,
        cmp: input logic<128>,
    ) -> ARef {
        var r : ARef     ;
        var sz: logic<2> ;
        var a : logic<64>;
        var s : logic<64>;
        var n : logic<64>;
        sz = po.op.size;
        a  = sext(old[63:0], sz);
        s  = sext(po.data, sz);
        n  = case po.amo.op {
            AmoOp::ADD : a + s,
            AmoOp::XOR : a ^ s,
            AmoOp::AND : a & s,
            AmoOp::OR  : a | s,
            AmoOp::MIN : if (a ^ {1'b1, 63'd0}) <: (s ^ {1'b1, 63'd0}) ? a : s,
            AmoOp::MAX : if (a ^ {1'b1, 63'd0}) <: (s ^ {1'b1, 63'd0}) ? s : a,
            AmoOp::MINU: if zext(a, sz) <: zext(s, sz) ? a : s,
            AmoOp::MAXU: if zext(a, sz) <: zext(s, sz) ? s : a,
            default    : s,
        };
        r.rd  = a;
        r.rd2 = old[127:64];
        r.nv  = {64'd0, n};
        r.wr  = po.amo.op != AmoOp::LR && po.amo.op != AmoOp::SC;
        if po.amo.op == AmoOp::CAS {
            r.wr = if po.amo.f3 == 3'd4 ? old == cmp : zext(old[63:0], sz) == zext(cmp[63:0], sz);
            if po.amo.f3 == 3'd4 {
                r.nv = {po.hi, po.data};
                r.rd = old[63:0];
            }
        }
        return r;
    }

    // ---- DUT wiring ----

    var kill_q: Kill;

    var iss    : IqGrant    [MW];
    var re     : MemReissue [MW];
    var hold   : logic      [MW];
    var arsv   : fu_pkg::WbSlot [MW];
    var iqrsv  : fu_pkg::WbSlot [MW];
    var rs_ok  : logic<fu_pkg::WB_OFS_N> [MW];
    var lq_gnt : logic          ;
    var sq_gnt : logic          ;
    var wb_ok  : logic      [MW];
    var mp_amo : AtomicOp   [MW];
    var mp_hf  : logic      [MW];
    var np_gnt : fu_pkg::WbSlot ;
    var np_wb  : WbPacket   [HF_N];
    var np_wake: Wake       [HF_N];
    var np_hf  : logic      [HF_N];

    var rf_a1 : PReg      [MW];
    var rf_a2 : PReg      [MW];
    var rf_d1 : logic<64> [MW];
    var rf_d2 : logic<64> [MW];
    var wb_bus: WbPacket  [WB_N];

    var req_v : logic    [MW];
    var req   : MemReq   [MW];
    var resp  : MemResp  [MW];
    var evt   : MemEvent     ;
    var fwd_q : FwdQuery [MW];
    var fwd_sq: FwdPart  [MW];
    var fwd_sb: FwdPart  [MW];
    var snap  : LqSnap   [MW];
    var sta   : StaWrite [MW];
    var std_p : StdWrite [MW]; // from the pipes
    var std   : StdWrite [MW]; // to sq/lq, possibly delayed
    var verd  : LqVerdict[MW];
    var wb    : WbPacket [MW];
    var wake  : Wake     [MW];
    var pperf : MemPipePerf [MW];
    var iq_rel: IqRelease [MW];

    var lq_av    : logic     [DW]    ;
    var lq_alloc : LqAlloc   [DW]    ;
    var sq_av    : logic     [DW]    ;
    var sq_alloc : SqAlloc   [DW]    ;
    var lq_free  : logic<LQ_CNT_W>   ;
    var sq_free  : logic<SQ_CNT_W>   ;
    var lq_atag  : LqTag     [DW + 1];
    var sq_atag  : SqTag     [DW + 1];
    var bar_alloc: logic<TAKE_W>     ;
    var bar_ret  : logic             ;
    var bar_after: BarSeq    [DW + 1];
    var bar_rt   : BarSeq            ;
    var lfence   : LoadFence         ;
    var lq_re    : MemReissue        ;
    var sq_re    : MemReissue        ;
    var lq_win   : LqCmWin   [CMW]   ;
    var sq_win   : SqCmWin   [MW]    ;
    var split_lo : logic<64>         ;
    var lq_ret   : logic<RETIRE_CNT_W>;
    var sq_ret   : logic<RETIRE_CNT_W>;
    var push     : SbPush    [PUSH_W];
    var sq_head  : SqTag             ;
    var sb_free  : logic<SB_CREDIT_W>;
    var ord_empty: logic             ;
    var lqperf   : LqPerf            ;
    var sqperf   : SqPerf            ;
    var sbperf   : SbPerf            ;
    var arbperf  : ArbPerf           ;
    var dcperf   : DcachePerf        ;
    var coh_v    : logic     [COH_N] ;
    var coh_line : logic<50> [COH_N] ;
    var tok_v    : logic             ;
    var tokt     : TagTok            ;
    var tok      : RobTag            ;
    var inv_q    : logic             ;
    var inv_a_q  : logic<64>         ;
    var spur_q   : logic             ;
    var spur_l_q : logic<50>         ;

    var dr_v   : logic        ;
    var dr_addr: logic<64>    ;
    var dr_data: logic<64> [8];
    var dr_strb: logic<8>  [8];
    var dr_urg : logic        ;
    var dr_ack : logic        ;

    var c_lq : logic<4>;
    var c_sq : logic<5>;
    var c_sb : logic<2>;
    var c_dc : logic<CHK_DC_W>;
    var c_at : logic<4>;
    var c_io : logic<4>;

    // HEAD-port clients
    var hd_req  : logic    [NP_N];
    var hd_gnt  : logic    [NP_N];
    var hd_slot : logic    [NP_N];
    var np_v    : logic    [NP_N];
    var np_req  : MemReq   [NP_N];
    // No walkers: the pipes run Bare.
    for k in 0..NP_N :g_nowalk {
        if k == NP_PTW_D || k == NP_PTW_I :g_tie {
            assign hd_req[k] = 1'b0;
            assign np_v[k]   = 1'b0;
            assign np_req[k] = 0 as MemReq;
        }
    }
    var at_st   : logic          ;
    var at_emp  : logic          ;
    var at_done : logic          ;
    var at_wr   : logic          ;
    var at_wd   : logic<128>     ;
    var at_coh_v: logic     [COH_N];
    var at_coh_l: logic<50> [COH_N];
    var at_rat  : logic<5>       ;
    var at_preg : logic<PREG_W>  ;
    var at_prf  : PReg           ;
    var at_prfd : logic<64>      ;
    var atperf  : AtomicPerf     ;
    var io_ld   : IoOp           ;
    var io_st   : IoOp           ;
    var io_st_s : logic          ;
    var io_ldd  : logic          ;
    var io_sdone: logic          ;
    var ioperf  : IoPerf         ;
    var hret    : logic          ;
    var rsv_clr : logic          ;

    const PMA: pma_pkg::PmaRegion [3] = '{
        pma_pkg::PmaRegion'{base: 56'h80_0000_0000 >> 8, mask: 56'hff_ffff_fe00_0000, attr: pma_pkg::PmaAttr'{target: pma_pkg::Target::DRAM, backed: 1, cacheable: 1, coherent: 1, executable: 1, amo: pma_pkg::AmoClass::FULL, idempotent: 1, io_ordered: 0, misaligned_ok: 1, pte_ok: 1, cbo_ok: 1}},
        pma_pkg::PmaRegion'{base: IO_VA[55:0], mask: 56'hff_ffff_ffff_f000, attr: pma_pkg::PmaAttr'{target: pma_pkg::Target::IO, backed: 1, cacheable: 0, coherent: 0, executable: 0, amo: pma_pkg::AmoClass::NONE, idempotent: 0, io_ordered: 1, misaligned_ok: 0, pte_ok: 0, cbo_ok: 0}},
        pma_pkg::PmaRegion'{base: NC_VA[55:0], mask: 56'hff_ffff_ffff_f000, attr: pma_pkg::PmaAttr'{target: pma_pkg::Target::DRAM, backed: 1, cacheable: 0, coherent: 0, executable: 0, amo: pma_pkg::AmoClass::NONE, idempotent: 1, io_ordered: 0, misaligned_ok: 0, pte_ok: 0, cbo_ok: 0}}
    };

    always_comb {
        for w in 0..WB_N {
            wb_bus[w] = '0;
        }
    }

    // Bare translation in M-mode: the pipes never look up or walk.
    var mctx: xlate_pkg::XlateCtx;
    always_comb {
        mctx     = 0 as xlate_pkg::XlateCtx;
        mctx.prv = csr_pkg::PrivLevel::MACHINE;
    }

    var hf_gnt_p: fu_pkg::WbSlot [MW];
    for p in 0..MW :g_pipe {
        var mwb  : WbPacket [HF_N];
        var mwake: Wake     [HF_N];
        var mhf  : logic    [HF_N];
        for k in 0..HF_N :g_np {
            if mem_port_head(p) :g_head {
                assign mwb[k]   = np_wb[k];
                assign mwake[k] = np_wake[k];
                assign mhf[k]   = np_hf[k];
            } else {
                assign mwb[k]   = 0 as WbPacket;
                assign mwake[k] = 0 as Wake;
                assign mhf[k]   = 1'b0;
            }
        }
        inst u_pipe: mem_pipe::<CFG> #(
            PMA_N  : 3  ,
            PMA_TBL: PMA,
        ) (
            clk                             ,
            rst                             ,
            i_kill        : kill_q          ,
            i_iss         : iss[p]          ,
            i_re          : re[p]           ,
            o_iq_rel      : iq_rel[p]       ,
            i_tok         : tokt            ,
            o_started     : _               ,
            o_rf_addr1    : rf_a1[p]        ,
            o_rf_addr2    : rf_a2[p]        ,
            i_rf_int1     : rf_d1[p]        ,
            i_rf_int2     : rf_d2[p]        ,
            i_rf_fp2      : 64'd0           ,
            i_wb          : wb_bus          ,
            i_xl_on       : 1'b0            ,
            i_ctx         : mctx            ,
            i_pmm         : 2'd0            ,
            i_pmpcfg      : '{64'd0, 64'd0} ,
            i_pmpaddr     : '{default: 64'd0},
            o_tlb_lk      : _               ,
            i_tlb         : 0 as xlate_pkg::TlbEntry,
            o_xreq_valid  : _               ,
            o_xreq        : _               ,
            i_xreq_gnt    : 1'b0            ,
            i_ptw_evt     : 0 as PtwEvent   ,
            o_req_valid   : req_v[p]        ,
            o_req         : req[p]          ,
            i_resp        : resp[p]         ,
            o_fwd_q       : fwd_q[p]        ,
            i_fwd_sq      : fwd_sq[p]       ,
            i_fwd_sb      : fwd_sb[p]       ,
            o_snap        : snap[p]         ,
            o_sta         : sta[p]          ,
            o_std         : std_p[p]        ,
            i_split_lo    : split_lo        ,
            o_verdict     : verd[p]         ,
            o_wake        : wake[p]         ,
            o_wb          : wb[p]           ,
            o_amo         : mp_amo[p]       ,
            i_np_wb       : mwb             ,
            i_np_wake     : mwake           ,
            i_np_hf       : mhf             ,
            o_hf_req      : mp_hf[p]        ,
            o_perf        : pperf[p]        ,
        );
        inst u_rs: wb_resv #(
            D: wb_depth(CFG::ISSUE_W + p),
        ) (
            clk                    ,
            rst                    ,
            o_ok      : rs_ok[p]   ,
            i_resv    : arsv[p]    ,
            i_hf_req  : mp_hf[p]   ,
            o_hf_grant: hf_gnt_p[p],
            o_perf    : _          ,
            o_chk     : _          ,
        );
    }
    assign np_gnt = hf_gnt_p[HEAD_PORT];

    inst u_arb: mem_port_arb::<CFG> (
        clk                         ,
        rst                         ,
        i_wb_ok       : wb_ok       ,
        i_lq_re       : lq_re       ,
        i_sq_re       : sq_re       ,
        i_iq_resv     : iqrsv       ,
        i_np_req      : hd_req      ,
        o_port_hold   : hold        ,
        o_re          : re          ,
        o_resv        : arsv        ,
        o_lq_gnt      : lq_gnt      ,
        o_sq_gnt      : sq_gnt      ,
        o_np_gnt      : hd_gnt      ,
        o_np_slot     : hd_slot     ,
        o_perf        : arbperf     ,
    );

    // ---- atomic_unit and io_unit ----

    inst u_at: atomic_unit::<CFG> (
        clk                                ,
        rst                                ,
        i_kill          : kill_q           ,
        i_hart_id       : SEED             ,
        i_op            : mp_amo[HEAD_PORT],
        o_ready         : _                ,
        i_tok           : tokt             ,
        i_head_retired  : hret             ,
        i_rsv_clr       : rsv_clr          ,
        i_ordering_empty: ord_empty        ,
        o_head_req      : hd_req[NP_ATOMIC],
        i_head_gnt      : hd_gnt[NP_ATOMIC] ,
        i_head_slot     : hd_slot[NP_ATOMIC],
        o_req_valid     : np_v[NP_ATOMIC]  ,
        o_req           : np_req[NP_ATOMIC],
        i_resp          : resp[0]          ,
        i_evt           : evt              ,
        i_coh_v         : at_coh_v         ,
        i_coh_line      : at_coh_l         ,
        o_rat_rd        : at_rat           ,
        i_rat_preg      : at_preg          ,
        o_prf_rd        : at_prf           ,
        i_prf_data      : at_prfd          ,
        o_started       : at_st            ,
        o_empty         : at_emp           ,
        o_hf_req        : np_hf[HF_ATOMIC] ,
        i_wb_grant      : np_gnt           ,
        o_wb            : np_wb[HF_ATOMIC] ,
        o_wake          : np_wake[HF_ATOMIC],
        o_done          : at_done          ,
        o_wrote         : at_wr            ,
        o_wdata         : at_wd            ,
        o_rd2_valid     : _                ,
        o_rd2           : _                ,
        o_chk           : c_at             ,
        o_perf          : atperf           ,
    );

    inst u_io: io_unit::<CFG> (
        clk                                ,
        rst                                ,
        i_kill          : kill_q           ,
        i_tok           : tokt             ,
        i_ld            : io_ld            ,
        i_st            : io_st            ,
        i_ordering_empty: ord_empty        ,
        i_atomic_empty  : at_emp           ,
        i_head_retired  : hret             ,
        o_head_req      : hd_req[NP_IO]    ,
        i_head_gnt      : hd_gnt[NP_IO]     ,
        i_head_slot     : hd_slot[NP_IO]    ,
        o_req_valid     : np_v[NP_IO]      ,
        o_req           : np_req[NP_IO]    ,
        i_resp          : resp[0]          ,
        i_evt           : evt              ,
        o_started       : io_st_s          ,
        o_busy          : _                ,
        o_ld_done       : io_ldd           ,
        o_st_done       : io_sdone         ,
        o_done_id       : _                ,
        o_hf_req        : np_hf[HF_IO]     ,
        i_wb_grant      : np_gnt           ,
        o_wb            : np_wb[HF_IO]     ,
        o_wake          : np_wake[HF_IO]   ,
        o_chk           : c_io             ,
        o_perf          : ioperf           ,
    );

    inst u_lq: lq::<CFG> (
        clk                          ,
        rst                          ,
        i_kill       : kill_q        ,
        i_alloc_valid: lq_av         ,
        i_alloc      : lq_alloc      ,
        o_free       : lq_free       ,
        o_alloc_tag  : lq_atag       ,
        i_bar_alloc  : bar_alloc     ,
        i_bar_ret    : bar_ret       ,
        o_bar_after  : bar_after     ,
        o_bar_ret    : bar_rt        ,
        o_load_fence : lfence        ,
        i_snap       : snap          ,
        i_sta        : sta           ,
        i_verdict    : verd          ,
        i_mem_ev     : evt           ,
        i_coh_v      : coh_v         ,
        i_coh_line   : coh_line      ,
        i_std        : std           ,
        i_sq_head    : sq_head       ,
        i_oldest     : tokt          ,
        i_ptw_evt    : 0 as PtwEvent ,
        i_ptw_resp   : 0 as XlateResp,
        i_retire_cnt : lq_ret        ,
        o_reissue    : lq_re         ,
        i_reissue_gnt: lq_gnt        ,
        o_win        : lq_win        ,
        o_split_lo   : split_lo      ,
        o_io         : io_ld         ,
        i_io_done    : io_ldd        ,
        o_chk        : c_lq          ,
        o_perf       : lqperf        ,
    );

    inst u_sq: sq::<CFG> (
        clk                          ,
        rst                          ,
        i_kill       : kill_q        ,
        i_alloc_valid: sq_av         ,
        i_alloc      : sq_alloc      ,
        o_free       : sq_free       ,
        o_alloc_tag  : sq_atag       ,
        i_sta        : sta           ,
        i_std        : std           ,
        i_ptw_evt    : 0 as PtwEvent ,
        i_ptw_resp   : 0 as XlateResp,
        i_tok        : tokt          ,
        i_fwd_q      : fwd_q         ,
        o_fwd        : fwd_sq        ,
        o_reissue    : sq_re         ,
        i_reissue_gnt: sq_gnt        ,
        o_win        : sq_win        ,
        i_retire_cnt : sq_ret        ,
        o_push       : push          ,
        o_head       : sq_head       ,
        o_io         : io_st         ,
        i_wt_done    : io_sdone      ,
        i_amo_done   : at_done       ,
        i_amo_wrote  : at_wr         ,
        i_amo_wdata  : at_wd         ,
        o_chk        : c_sq          ,
        o_perf       : sqperf        ,
    );

    inst u_sb: sb::<CFG> (
        clk                             ,
        rst                             ,
        i_push          : push          ,
        o_credit        : sb_free       ,
        i_fwd_q         : fwd_q         ,
        o_fwd           : fwd_sb        ,
        o_drain_v       : dr_v          ,
        o_drain_addr    : dr_addr       ,
        o_drain_data    : dr_data       ,
        o_drain_strb    : dr_strb       ,
        o_drain_urgent  : dr_urg        ,
        i_drain_ack     : dr_ack        ,
        o_ordering_empty: ord_empty     ,
        o_chk           : c_sb          ,
        o_perf          : sbperf        ,
    );

    // ---- dcache ----

    var ev1_v    : logic    ;
    var ev1_a    : logic<64>;
    var ev2_v    : logic    ;
    var ev2_a    : logic<64>;

    var mr_addr : logic<64>    ;
    var mr_req  : logic        ;
    var mr_gnt  : logic        ;
    var mr_data : logic<64>    ;
    var mr_rfo  : logic        ;
    var fexcl_q : logic        ;
    var mw_addr : logic<64>    ;
    var mw_data : logic<64> [8];
    var mw_strb : logic<8>  [8];
    var mw_wen  : logic        ;
    var mw_wb   : logic        ;
    var mw_req  : logic        ;
    var mw_gnt  : logic        ;
    var pr_v_q  : logic        ;
    var pr_a_q  : logic<64>    ;
    var pr_ack  : logic        ;

    inst u_dc: dcache::<CFG> (
        clk                           ,
        rst                           ,
        i_kill        : kill_q        ,
        i_req_valid   : req_v         ,
        i_req         : req           ,
        i_np_valid    : np_v          ,
        i_np_req      : np_req        ,
        o_req_ready   : _             ,
        o_resp        : resp          ,
        o_evt         : evt           ,
        i_drain_v     : dr_v          ,
        i_drain_addr  : dr_addr       ,
        i_drain_data  : dr_data       ,
        i_drain_strb  : dr_strb       ,
        i_drain_urgent: dr_urg        ,
        o_drain_ack   : dr_ack        ,
        i_inv_v       : inv_q         ,
        i_inv_addr    : inv_a_q       ,
        i_inv2_v      : 1'b0          ,
        i_inv2_addr   : 64'd0         ,
        i_probe_v     : pr_v_q        ,
        i_probe_addr  : pr_a_q        ,
        i_probe_self  : 1'b0          ,
        o_probe_ack   : pr_ack        ,
        o_ev1_v       : ev1_v         ,
        o_ev1_addr    : ev1_a         ,
        o_ev2_v       : ev2_v         ,
        o_ev2_addr    : ev2_a         ,
        o_memr_addr   : mr_addr       ,
        o_memr_ren    : _             ,
        o_memr_rfo    : mr_rfo        ,
        o_memr_line   : _             ,
        o_memr_req    : mr_req        ,
        i_memr_grant  : mr_gnt        ,
        i_mem_rdata   : mr_data       ,
        i_fill_excl   : fexcl_q       ,
        o_memw_addr   : mw_addr       ,
        o_memw_wdata  : mw_data       ,
        o_memw_wstrb  : mw_strb       ,
        o_memw_wen    : mw_wen        ,
        o_memw_wb     : mw_wb         ,
        o_memw_req    : mw_req        ,
        i_memw_grant  : mw_gnt        ,
        o_chk         : c_dc          ,
        o_perf        : dcperf        ,
    );

    assign coh_v[0]    = inv_q;
    assign coh_line[0] = inv_a_q[55:6];
    assign coh_v[1]    = 1'b0;
    assign coh_line[1] = '0;
    assign coh_v[2]    = ev1_v;
    assign coh_line[2] = ev1_a[55:6];
    assign coh_v[3]    = ev2_v;
    assign coh_line[3] = ev2_a[55:6];
    // atomic_unit also sees spurious events: a false watch or reservation
    // loss only costs a retry or a failed SC
    always_comb {
        at_coh_v    = coh_v;
        at_coh_l    = coh_line;
        at_coh_v[1] = spur_q;
        at_coh_l[1] = spur_l_q;
    }

    // ---- memory model ----

    var lfsr: logic<64>;
    var mem  : logic<64> [4096]; // 32 KiB at 0x8000_0000; mix(dword index) until written
    var mem_w: logic     [4096];

    function mem_init (
        d: input logic<12>,
    ) -> logic<64> {
        return mix({52'd0, d} ^ 64'h5555);
    }

    function is_io (
        a: input logic<64>,
    ) -> logic {
        return a[55:12] == IO_VA[55:12];
    }

    function is_nc (
        a: input logic<64>,
    ) -> logic {
        return a[55:8] == NC_VA[55:8];
    }

    // The device at IO_VA: dword 0 counts its reads (a read side effect),
    // dword 1 is a plain register. NC_VA is 256 bytes of DRAM only ever
    // accessed without caching.
    var dev_c_q : logic<64>     ;
    var dev_d_q : logic<64>     ;
    var nc_mem  : logic<64> [32];
    var dev_rd_q: logic<32>     ; // device and NC reads
    var dev_wr_q: logic<32>     ; // device and NC writes

    var rs_q: logic<2>; // 0 idle, 1 latency, 2 stream
    var rw_q: logic<4>;
    var rb_q: logic<3>;
    let mr_unc : logic     = is_io(mr_addr) || is_nc(mr_addr);
    let unc_dat: logic<64> = if is_nc(mr_addr) ? nc_mem[mr_addr[7:3]] : if mr_addr[3] ? dev_d_q : dev_c_q;
    assign mr_gnt  = (rs_q == 2'd0 && mr_req && lfsr[40]) || rs_q == 2'd2;
    assign mr_data = if mr_unc ? unc_dat : if mem_w[mr_addr[14:3]] ? mem[mr_addr[14:3]] : mem_init(mr_addr[14:3]);
    assign mw_gnt  = mw_req && lfsr[41:40] != 2'd0;

    var mw_old: logic<64> [8];
    var mw_new: logic<64> [8];
    always_comb {
        for l in 0..8 {
            let d: logic<12> = {mw_addr[14:6], l as 3};
            var m: logic<64>;
            for b in 0..8 {
                m[b * 8+:8] = {mw_strb[l][b] repeat 8};
            }
            mw_old[l] = if mem_w[d] ? mem[d] : mem_init(d);
            mw_new[l] = (mw_old[l] & ~m) | (mw_data[l] & m);
        }
    }
    let mw_unc: logic = is_io(mw_addr) || is_nc(mw_addr);
    let mw_ln : logic<3> = mw_addr[5:3];
    var mw_um : logic<64>;
    always_comb {
        for b in 0..8 {
            mw_um[b * 8+:8] = {mw_strb[mw_ln][b] repeat 8};
        }
    }

    // The contended counter: a remote agent increments it, through a recall
    // of the line, at the edge the recall completes.
    const CTR_D: logic<12> = CTR_VA[14:3];
    let ctr_cur: logic<64> = if mw_wen && !mw_unc && mw_addr[14:6] == CTR_D[11:3] && mw_strb[CTR_D[2:0]] != 8'd0 ?
        mw_new[CTR_D[2:0]]
    : if mem_w[CTR_D] ?
        mem[CTR_D]
    :
        mem_init(CTR_D)
    ;
    var pr_inc_q: logic    ;
    var at_g_q  : logic<2> ; // the atomic's HEAD slot grant, delayed to the cycle before its request
    var rcnt_q  : logic<32>; // remote increments done
    var own_q   : logic [512]; // a line this hart may hold E or M
    // ---- driver state ----

    var r_pi   : logic<32>       [RN];
    var r_done : logic           [RN];
    var r_exc  : logic           [RN];
    var r_val  : logic<64>       [RN];
    var r_lq   : LqTag           [RN];
    var r_sq   : SqTag           [RN];
    var r_lqlim: LqTag           [RN];
    var r_sqlim: SqTag           [RN];
    var r_slq  : LqTag           [RN]; // dispatch snapshot after this op
    var r_ssq  : SqTag           [RN];
    var r_sbar : BarSeq          [RN];
    var r_iniq : logic           [RN];
    var r_barw : BarSeq          [RN];
    var r_obey : logic           [RN];
    var r_kind : logic<3>        [RN];
    var r_ln   : logic<50>       [RN]; // lines of the access
    var r_ln2  : logic<50>       [RN];
    var r_val2 : logic<64>       [RN];
    var sq_rob : RobTag          [CFG::SQ_N];

    var ctr_n_q  : logic<64>; // counter atomics retired
    var rc_snap_q: logic<32>; // remote increments when the counter write landed
    var trsv_v_q : logic    ; // the reservation as the program sees it
    var trsv_pa_q: logic<64>;
    var tlost_q  : logic    ; // an event on its line since the LR retired
    var sc_sent_q: logic    ; // the head atomic presented a write
    var lr_age_q : logic<16>; // cycles since the last LR retired
    var io_ld_n_q: logic<32>; // non-cacheable loads retired
    var io_st_n_q: logic<32>;
    var io_r0_q  : logic<64>; // device counter reads retired
    var tdev_q   : logic<64>; // the device register as the program sees it
    var nc_gold  : logic<8>  [256];
    var irq_q    : logic    ;
    var irq_n_q  : logic<4> ;
    var hs_q     : logic    ; // head_started
    var cnt2_q   : logic<16> [32];
    var cnt3_q   : logic<16> [8] ;

    var head_q : RobTag   ;
    var tail_q : RobTag   ;
    var disp_q : logic<32>;
    var gold   : logic<8> [32768]; // program-order byte image; mem_init until written
    var gold_w : logic    [32768];
    var ok_q   : logic    ;
    var nret_q : logic<32>;
    var idle_q : logic<16>;
    var cyc_q  : logic<32>;

    var cnt_q  : logic<16> [32]; // coverage counters

    var hv_q   : logic   [MW];
    var hd_q   : StdWrite[MW];
    var hc_q   : logic<4>[MW];

    let rob_cnt: logic<32> = if head_q.wrap == tail_q.wrap ? (tail_q.idx as 32) - (head_q.idx as 32) : RN - (head_q.idx as 32) + (tail_q.idx as 32);

    function mk_uop (
        po: input POp,
    ) -> logic<UOP_W> {
        return if po.kind == 3'd3 ? po.amo as UOP_W : (if po.op.st ? {1'b0, po.op.size} : {!po.op.sgn, po.op.size}) as UOP_W;
    }

    function mk_fu (
        po: input POp,
    ) -> FuKind {
        return if po.kind == 3'd3 ? FuKind::ATOMIC : if po.op.st ? FuKind::STORE : FuKind::LOAD;
    }

    // LQ ops: loads, LR and non-cacheable loads; SQ ops: stores, the other
    // atomics and non-cacheable stores.
    function in_lq (
        po: input POp,
    ) -> logic {
        return (po.kind == 3'd0 || po.kind == 3'd4 || po.kind == 3'd3) && !po.op.st;
    }

    function in_sq (
        po: input POp,
    ) -> logic {
        return (po.kind == 3'd1 || po.kind == 3'd4 || po.kind == 3'd3) && po.op.st;
    }

    // The line of the last byte of an access.
    function ln_last (
        po: input POp,
    ) -> logic<50> {
        var a: logic<64>;
        a = po.va + ((64'd1 << po.op.size) - 64'd1);
        return a[55:6];
    }

    function radv (
        t: input RobTag   ,
        k: input logic<32>,
    ) -> RobTag {
        var r: RobTag   ;
        var s: logic<32>;
        s = (t.idx as 32) + k;
        r.idx  = s[RW - 1:0];
        r.wrap = if s >= RN ? ~t.wrap : t.wrap;
        return r;
    }

    function ridx (
        t: input RobTag   ,
        k: input logic<32>,
    ) -> logic<RW> {
        let r: RobTag = radv(t, k);
        return r.idx;
    }

    function live_at (
        e: input logic<32>,
        h: input RobTag   ,
        t: input RobTag   ,
    ) -> logic {
        return if h.wrap == t.wrap ? (e >= (h.idx as 32) && e <: (t.idx as 32)) : (e >= (h.idx as 32) || e <: (t.idx as 32));
    }

    assign tok_v      = rob_cnt != 0 && !kill_q.valid && !irq_q;
    assign tokt.valid = tok_v;
    assign tokt.tag   = tok;
    assign tok   = head_q;

    // ---- dispatch ----

    var d_take : logic<32>  ;
    var d_op   : POp    [DW];
    var d_nld  : logic<32> [DW + 1];
    var d_nst  : logic<32> [DW + 1];
    var d_nbar : logic<32> [DW + 1];
    always_comb {
        d_nld[0]  = 0;
        d_nst[0]  = 0;
        d_nbar[0] = 0;
        d_take    = 0;
        for l in 0..DW {
            d_op[l]       = pop(disp_q + l);
            d_nld[l + 1]  = d_nld[l] + (in_lq(d_op[l]) as 32);
            d_nst[l + 1]  = d_nst[l] + (in_sq(d_op[l]) as 32);
            d_nbar[l + 1] = d_nbar[l] + ((d_op[l].kind == 3'd2) as 32);
            if d_take == l && rob_cnt + l + 1 <= RN && d_nld[l + 1] <= (lq_free as 32) && d_nst[l + 1] <= (sq_free as 32) && !kill_q.valid && lfsr[3 + l] {
                d_take = l + 1;
            }
        }
        for l in 0..DW {
            let rt: RobTag = radv(tail_q, l);
            lq_av[l]    = 1'b0;
            lq_alloc[l] = '0;
            sq_av[l]    = 1'b0;
            sq_alloc[l] = '0;
        }
        // compact the loads and stores of the taken lanes into slots
        for l in 0..DW {
            let rt: RobTag = radv(tail_q, l);
            if l <: d_take && in_lq(d_op[l]) {
                lq_av[d_nld[l]]             = 1'b1;
                lq_alloc[d_nld[l]].ex.rob   = rt;
                lq_alloc[d_nld[l]].ex.pdst.cls = RegClass::FP;
                lq_alloc[d_nld[l]].ex.pdst.idx = rt.idx as PREG_W;
                lq_alloc[d_nld[l]].ex.has_rd = 1'b1;
                lq_alloc[d_nld[l]].fu       = mk_fu(d_op[l]);
                lq_alloc[d_nld[l]].uop      = mk_uop(d_op[l]);
                lq_alloc[d_nld[l]].sq_lim   = sq_atag[d_nst[l]];
            }
            if l <: d_take && in_sq(d_op[l]) {
                sq_av[d_nst[l]]             = 1'b1;
                sq_alloc[d_nst[l]].rob      = rt;
                sq_alloc[d_nst[l]].fu       = mk_fu(d_op[l]);
                sq_alloc[d_nst[l]].uop      = mk_uop(d_op[l]);
                sq_alloc[d_nst[l]].lq_lim   = lq_atag[d_nld[l]];
            }
        }
        var nb: logic<32>;
        nb = 0;
        for l in 0..DW {
            if l <: d_take && d_op[l].kind == 3'd2 {
                nb = nb + 1;
            }
        }
        bar_alloc = nb as TAKE_W;
    }

    // ---- memory IQ (oldest eligible, with random skips) ----

    // An atomic issues only on the HEAD pipe while it holds the token; every
    // other op issues speculatively.
    var sel_v: logic     [MW];
    var sel_e: logic<RW> [MW];
    always_comb {
        var taken: logic<RN>;
        taken = '0;
        for p in 0..MW {
            sel_v[p] = 1'b0;
            sel_e[p] = '0;
            for k in 0..RN {
                let e : logic<RW> = ridx(head_q, k);
                let iw: logic     = (k as 32) <: rob_cnt;
                let at: logic     = r_kind[e] == 3'd3;
                let ok: logic     = !at || (k == 0 && tok_v && mem_port_head(p));
                let el: logic     = iw && r_iniq[e] && r_kind[e] != 3'd2 && ok && !taken[e] && !(r_obey[e] && !(lfence.valid && lfence.seq == r_barw[e]));
                if el && !sel_v[p] && !hold[p] && wb_ok[p] && !kill_q.valid && lfsr[(k + p * 7) % 64] {
                    sel_v[p] = 1'b1;
                    sel_e[p] = e;
                }
            }
            if sel_v[p] {
                taken[sel_e[p]] = 1'b1;
            }
        }
    }

    for p in 0..MW :g_iss {
        let e : logic<RW> = sel_e[p];
        let po: POp       = pop(r_pi[e]);
        always_comb {
            iss[p]              = '0;
            iss[p].valid        = sel_v[p];
            iss[p].tag.rob.wrap = if e >= head_q.idx ? head_q.wrap : ~head_q.wrap;
            iss[p].tag.rob.idx  = e;
            iss[p].tag.pdst.cls = RegClass::FP;
            iss[p].tag.pdst.idx = e as PREG_W;
            iss[p].tag.has_rd   = !po.op.st || po.kind == 3'd3;
            iss[p].fu           = mk_fu(po);
            iss[p].cold.uop     = mk_uop(po);
            iss[p].cold.imm     = if po.kind == 3'd3 ? {22'd0, 5'd12, 5'd10} : {po.imm[11] repeat 20, po.imm};
            iss[p].cold.lq      = if in_lq(po) ? r_lq[e] : r_lqlim[e];
            iss[p].cold.sq      = if in_sq(po) ? r_sq[e] : r_sqlim[e];
            iss[p].src[0].en    = 1'b1;
            iss[p].src[0].pr.cls = RegClass::INT;
            iss[p].src[0].pr.idx = e as PREG_W;
            iss[p].src[1].en    = po.op.st;
            iss[p].src[1].pr.cls = RegClass::INT;
            iss[p].src[1].pr.idx = (e as PREG_W) + (RN as PREG_W);
            iqrsv[p]            = if sel_v[p] ? fu_pkg::WbSlot'{valid: 1'b1, off: fu_pkg::claim_off(FuKind::LOAD) as fu_pkg::WbOff} : 0 as fu_pkg::WbSlot;
            wb_ok[p]            = rs_ok[p][fu_pkg::claim_off(FuKind::LOAD)];
        }
        // the register file: rs1 = va - imm, rs2 = store data
        let p1: POp = pop(r_pi[rf_a1[p].idx[RW - 1:0]]);
        let p2: POp = pop(r_pi[rf_a2[p].idx[RW - 1:0]]);
        assign rf_d1[p] = p1.va - (if p1.kind == 3'd3 ? 64'd0 : {p1.imm[11] repeat 52, p1.imm});
        assign rf_d2[p] = p2.data;
    }

    // ---- atomic_unit's arch RAT and PRF reads ----

    let hpo: POp = pop(r_pi[head_q.idx]);
    // memory's bytes at the head op's address, for amocas compare values
    var hraw: logic<128>;
    always_comb {
        for b in 0..16 {
            let gi: logic<15> = hpo.va[14:0] + b;
            let iv: logic<64> = mem_init(gi[14:3]);
            hraw[b * 8+:8] = if gold_w[gi] ? gold[gi] : iv[gi[2:0] * 8+:8];
        }
    }
    // arch RAT = identity; the PRF holds rd (10), rd+1 (11) and rs2+1 (13)
    assign at_preg = at_rat as PREG_W;
    always_comb {
        at_prfd = case at_prf.idx {
            10     : if hpo.cmat ? hraw[63:0] : hpo.cmp,
            11     : if hpo.cmat ? hraw[127:64] : ~hpo.cmp,
            13     : hpo.hi,
            default: 64'd0,
        };
    }

    // ---- store data delay (separate STD arrival) ----

    for p in 0..MW :g_std {
        let rel: logic = hv_q[p] && hc_q[p] == 4'd0;
        let dly: logic = std_p[p].valid && !hv_q[p] && lfsr[45 + p];
        always_comb {
            std[p] = if rel ? hd_q[p] : if dly ? '0 : std_p[p];
        }
    }

    // ---- commit ----

    var c_ret  : logic<32>;
    var c_ld   : logic<32>;
    var c_st   : logic<32>;
    var c_fence: logic    ;
    var c_rply : logic    ;
    var c_bad  : logic    ;
    var c_x    : logic    ; // an atomic or non-cacheable op retires at lane 0
    always_comb {
        var stop : logic    ;
        var lines: logic<32>;
        c_ret   = 0;
        c_ld    = 0;
        c_st    = 0;
        c_fence = 1'b0;
        c_rply  = 1'b0;
        c_bad   = 1'b0;
        c_x     = 1'b0;
        stop    = kill_q.valid;
        lines   = 0;
        for l in 0..CMW {
            let e : logic<RW> = ridx(head_q, l);
            let po: POp       = pop(r_pi[e]);
            if !stop {
                if (l as 32) >= rob_cnt {
                    stop = 1'b1;
                } else if po.kind == 3'd2 {
                    if l == 0 && ord_empty {
                        c_ret   = 1;
                        c_fence = 1'b1;
                    }
                    stop = 1'b1;
                } else if po.kind >= 3'd3 {
                    // a store-class one also waits for its SQ entry's retire_ok
                    var rk: logic;
                    rk = !po.op.st;
                    for k in 0..MW {
                        if po.op.st && sq_win[k].valid && sq_win[k].tag == r_sq[e] {
                            rk = sq_win[k].retire_ok;
                        }
                    }
                    if l == 0 && r_done[e] && rk {
                        c_ret = 1;
                        c_x   = 1'b1;
                        c_ld  = (!po.op.st) as 32;
                        c_st  = po.op.st as 32;
                    }
                    stop = 1'b1;
                } else if !r_done[e] {
                    stop = 1'b1;
                } else if po.kind == 3'd0 {
                    var pz: logic;
                    var fd: logic;
                    pz = 1'b0;
                    fd = 1'b0;
                    for k in 0..CMW {
                        if lq_win[k].valid && lq_win[k].tag == r_lq[e] {
                            pz = lq_win[k].poison;
                            fd = 1'b1;
                        }
                    }
                    if !fd || r_exc[e] {
                        c_bad = 1'b1;
                        stop  = 1'b1;
                    } else if pz {
                        if l == 0 {
                            c_rply = 1'b1;
                        }
                        stop = 1'b1;
                    } else {
                        c_ret = c_ret + 1;
                        c_ld  = c_ld + 1;
                    }
                } else {
                    var rk: logic;
                    var sp: logic;
                    rk = 1'b0;
                    sp = 1'b0;
                    for k in 0..MW {
                        if sq_win[k].valid && sq_win[k].tag == r_sq[e] {
                            rk = sq_win[k].retire_ok;
                            sp = sq_win[k].lines == 2'd2;
                        }
                    }
                    if r_exc[e] {
                        c_bad = 1'b1;
                        stop  = 1'b1;
                    } else if !rk || c_st + 1 >: MW || lines + 1 + (sp as 32) >: (sb_free as 32) || lines + 1 + (sp as 32) >: PUSH_W {
                        stop = 1'b1;
                    } else {
                        c_ret = c_ret + 1;
                        c_st  = c_st + 1;
                        lines = lines + 1 + (sp as 32);
                    }
                }
            }
        }
        lq_ret  = c_ld as RETIRE_CNT_W;
        sq_ret  = c_st as RETIRE_CNT_W;
        bar_ret = c_fence;
    }

    // expected value of each retiring load from the byte image
    var c_mis: logic;
    var c_mpi: logic<32>;
    var c_mex: logic<64>;
    var c_mgt: logic<64>;
    always_comb {
        c_mis = 1'b0;
        c_mpi = 0;
        c_mex = 0;
        c_mgt = 0;
        for l in 0..CMW {
            let e : logic<RW> = ridx(head_q, l);
            let po: POp       = pop(r_pi[e]);
            var raw: logic<64>;
            var ex : logic<64>;
            for b in 0..8 {
                let gi: logic<15> = po.va[14:0] + b;
                let iv: logic<64> = mem_init(gi[14:3]);
                raw[b * 8+:8] = if gold_w[gi] ? gold[gi] : iv[gi[2:0] * 8+:8];
                // older stores retiring in this cycle (earlier lanes)
                for j in 0..l {
                    let ej: logic<RW> = ridx(head_q, j);
                    let pj: POp       = pop(r_pi[ej]);
                    let dj: logic<15> = gi - pj.va[14:0];
                    if (j as 32) <: c_ret && pj.kind == 3'd1 && dj <: ({11'd0, 4'd1} << pj.op.size) {
                        raw[b * 8+:8] = pj.data[dj[2:0] * 8+:8];
                    }
                }
            }
            ex = case po.op.size {
                2'd0   : if po.op.sgn ? {raw[7] repeat 56, raw[7:0]} : {56'd0, raw[7:0]},
                2'd1   : if po.op.sgn ? {raw[15] repeat 48, raw[15:0]} : {48'd0, raw[15:0]},
                2'd2   : if po.op.sgn ? {raw[31] repeat 32, raw[31:0]} : {32'd0, raw[31:0]},
                default: raw,
            };
            if (l as 32) <: c_ret && po.kind == 3'd0 && r_val[e] != ex {
                c_mis = 1'b1;
                c_mpi = r_pi[e];
                c_mex = ex;
                c_mgt = r_val[e];
            }
        }
    }

    // ---- retire checks of atomics and non-cacheable ops ----

    function tb_fmt (
        raw: input logic<64>,
        bo : input logic<3> ,
        op : input MemOp    ,
    ) -> logic<64> {
        let v: logic<64> = raw >> {bo, 3'd0};
        return if op.sgn ? sext(v, op.size) : zext(v, op.size);
    }

    var x_bad: logic     ;
    var x_why: logic<3>  ;
    var x_wr : logic     ; // the atomic wrote memory
    var x_nv : logic<128>; // its new bytes from the address
    var x_nb : logic<5>  ;
    always_comb {
        let e : logic<RW> = head_q.idx;
        var rf : ARef     ;
        var raw: logic<64>;
        var ex : logic<64>;
        var ls : logic    ;
        rf    = ref_amo(hpo, hraw, if hpo.cmat ? hraw : {~hpo.cmp, hpo.cmp});
        x_bad = 1'b0;
        x_why = 3'd0;
        x_wr  = 1'b0;
        x_nv  = rf.nv;
        x_nb  = if hpo.amo.f3 == 3'd4 ? 5'd16 : 5'd1 << hpo.op.size;
        ls    = !trsv_v_q || trsv_pa_q != hpo.va || tlost_q;
        raw   = if hpo.nc ?
            {nc_gold[{hpo.va[7:3], 3'd7}], nc_gold[{hpo.va[7:3], 3'd6}], nc_gold[{hpo.va[7:3], 3'd5}], nc_gold[{hpo.va[7:3], 3'd4}],
             nc_gold[{hpo.va[7:3], 3'd3}], nc_gold[{hpo.va[7:3], 3'd2}], nc_gold[{hpo.va[7:3], 3'd1}], nc_gold[{hpo.va[7:3], 3'd0}]}
        : if hpo.va[3] ?
            tdev_q
        :
            64'h1000 + io_r0_q
        ;
        ex = tb_fmt(raw, hpo.va[2:0], hpo.op);
        if c_x && hpo.kind == 3'd3 {
            if hpo.ctr {
                if r_val[e] != mem_init(CTR_D) + ctr_n_q + {32'd0, rc_snap_q} {
                    x_bad = 1'b1;
                    x_why = 3'd1;
                }
            } else if hpo.amo.op == AmoOp::SC {
                if r_val[e] >: 64'd1 || (ls && r_val[e] != 64'd1) {
                    x_bad = 1'b1;
                    x_why = 3'd2;
                }
                x_wr = r_val[e] == 64'd0;
                x_nv = {64'd0, hpo.data};
            } else {
                if r_val[e] != rf.rd || (hpo.amo.f3 == 3'd4 && r_val2[e] != rf.rd2) {
                    x_bad = 1'b1;
                    x_why = 3'd3;
                }
                x_wr = rf.wr;
            }
        }
        if c_x && hpo.kind == 3'd4 {
            if !hpo.st && (r_val[e] != ex || dev_rd_q != io_ld_n_q + 1 || dev_wr_q != io_st_n_q) {
                x_bad = 1'b1;
                x_why = 3'd4;
            }
            if hpo.st && (dev_wr_q != io_st_n_q + 1 || dev_rd_q != io_ld_n_q) {
                x_bad = 1'b1;
                x_why = 3'd5;
            }
        }
    }

    // ---- kills ----

    // an interrupt is taken only while the head has not started an access
    let x_take: logic = irq_q && !hs_q && rob_cnt != 0 && !kill_q.valid && c_ret == 0 && !c_rply && lfsr[61:60] == 2'd0;
    assign rsv_clr = x_take;
    assign hret    = c_ret != 0;

    var k_next: Kill     ;
    var k_pi  : logic<32>;
    always_comb {
        let kn: logic<32> = if rob_cnt == 0 ? 1 : rob_cnt;
        let kr: RobTag    = radv(head_q, lfsr[63:56] % kn);
        let kk: logic<RW> = kr.idx;
        k_next          = '0;
        k_pi            = disp_q;
        if c_rply || x_take {
            k_next.valid = 1'b1;
            k_next.full  = 1'b1;
            k_pi         = r_pi[head_q.idx];
        } else if !kill_q.valid && c_ret == 0 && rob_cnt >= 2 && lfsr[22:16] == 7'd0 {
            k_next.valid   = 1'b1;
            k_next.keep    = kr;
            k_next.lq_tail = r_slq[kk];
            k_next.sq_tail = r_ssq[kk];
            k_next.bar_seq = r_sbar[kk];
            k_pi           = r_pi[kk] + 1;
        }
    }
    var kpi_q: logic<32>;

    // ---- sequential ----

    always_ff {
        if_reset {
            lfsr   = SEED ^ 64'h0123_4567_89ab_cdef;
            kill_q = '0;
            head_q = '0;
            tail_q = '0;
            disp_q = 0;
            kpi_q  = 0;
            ok_q   = 1'b1;
            nret_q = 0;
            idle_q = 0;
            at_g_q = '0;
            cyc_q  = 0;
            rs_q   = 2'd0;
            rw_q   = 4'd0;
            rb_q   = 3'd0;
            pr_v_q = 1'b0;
            pr_a_q = '0;
            pr_inc_q  = 1'b0;
            rcnt_q    = 0;
            fexcl_q   = 1'b1;
            inv_q     = 1'b0;
            inv_a_q   = '0;
            spur_q    = 1'b0;
            spur_l_q  = '0;
            dev_c_q   = 64'h1000;
            dev_d_q   = 64'd0;
            dev_rd_q  = 0;
            dev_wr_q  = 0;
            ctr_n_q   = 0;
            rc_snap_q = 0;
            trsv_v_q  = 1'b0;
            trsv_pa_q = '0;
            tlost_q   = 1'b0;
            sc_sent_q = 1'b0;
            lr_age_q  = 0;
            io_ld_n_q = 0;
            io_st_n_q = 0;
            io_r0_q   = 0;
            tdev_q    = 64'd0;
            irq_q     = 1'b0;
            irq_n_q   = 4'd0;
            hs_q      = 1'b0;
            for i in 0..32 {
                cnt_q[i]  = 0;
                cnt2_q[i] = 0;
                nc_mem[i] = 64'd0;
            }
            for i in 0..8 {
                cnt3_q[i] = 0;
            }
            for i in 0..256 {
                nc_gold[i] = 8'd0;
            }
            for i in 0..512 {
                own_q[i] = 1'b0;
            }
            for p in 0..MW {
                hv_q[p] = 1'b0;
                hc_q[p] = 4'd0;
            }
            for e in 0..RN {
                r_iniq[e] = 1'b0;
                r_done[e] = 1'b0;
            }
            for d in 0..4096 {
                mem_w[d] = 1'b0;
            }
            for b in 0..32768 {
                gold_w[b] = 1'b0;
            }
        } else {
            var t : logic<64>;
            var ev : logic<32>;
            var ev3: logic<8> ;
            t     = lfsr ^ (lfsr << 13);
            t     = t ^ (t >> 7);
            t     = t ^ (t << 17);
            lfsr  = t;
            cyc_q = cyc_q + 1;

            // memory read slot; an uncached read is served in its grant cycle
            case rs_q {
                2'd0: if mr_gnt && mr_unc {
                    dev_rd_q = dev_rd_q + 1;
                    if is_io(mr_addr) && !mr_addr[3] {
                        dev_c_q = dev_c_q + 64'd1;
                    }
                } else if mr_gnt {
                    rs_q    = 2'd1;
                    rw_q    = {2'd0, lfsr[47:46]} + 4'd1;
                    fexcl_q = mr_rfo || lfsr[39];
                    own_q[mr_addr[14:6]] = mr_rfo || lfsr[39];
                }
                2'd1: {
                    rw_q = rw_q - 4'd1;
                    if rw_q == 4'd1 {
                        rs_q = 2'd2;
                        rb_q = 3'd0;
                    }
                }
                default: {
                    rb_q = rb_q + 3'd1;
                    if rb_q == 3'd7 {
                        rs_q = 2'd0;
                    }
                }
            }
            // memory write channel
            if mw_wen && mw_unc {
                dev_wr_q = dev_wr_q + 1;
                if is_nc(mw_addr) {
                    nc_mem[mw_addr[7:3]] = (nc_mem[mw_addr[7:3]] & ~mw_um) | (mw_data[mw_ln] & mw_um);
                } else if mw_addr[3] {
                    dev_d_q = (dev_d_q & ~mw_um) | (mw_data[mw_ln] & mw_um);
                }
            } else if mw_wen {
                for l in 0..8 {
                    var m: logic<64>;
                    for b in 0..8 {
                        m[b * 8+:8] = {mw_strb[l][b] repeat 8};
                    }
                    if mw_strb[l] != 8'd0 {
                        mem[{mw_addr[14:6], l as 3}]   = (mw_old[l] & ~m) | (mw_data[l] & m);
                        mem_w[{mw_addr[14:6], l as 3}] = 1'b1;
                    }
                }
            }
            // recalls: random lines, the counter line (a remote increment),
            // and the line of an atomic about to present its request
            if pr_v_q && (pr_ack || (mw_wen && mw_wb && mw_addr[55:6] == pr_a_q[55:6])) {
                pr_v_q = 1'b0;
                if pr_inc_q {
                    mem[CTR_D]   = ctr_cur + 64'd1;
                    mem_w[CTR_D] = 1'b1;
                    rcnt_q       = rcnt_q + 1;
                }
            } else if !pr_v_q && at_g_q[1] && r_kind[head_q.idx] == 3'd3 && (lfsr[33:32] == 2'd0 || (hpo.amo.op == AmoOp::SC && lr_age_q >: 16'd64)) {
                pr_v_q   = 1'b1;
                pr_a_q   = hpo.va;
                pr_inc_q = hpo.ctr;
            } else if !pr_v_q && lfsr[55:49] <: 7'd2 {
                pr_v_q   = 1'b1;
                pr_inc_q = lfsr[31:30] == 2'd0;
                pr_a_q   = if lfsr[31:30] == 2'd0 ? CTR_VA : 64'h8000_0000 | {49'd0, lfsr[12:10], 12'd0} | {56'd0, lfsr[14:13], 6'd0};
            }
            // invalidates of lines this hart cannot hold E or M
            inv_q = 1'b0;
            if lfsr[47:42] == 6'd0 {
                let la: logic<64> = 64'h8000_0000 | {49'd0, lfsr[12:10], 12'd0} | {56'd0, lfsr[14:13], 6'd0};
                if !own_q[la[14:6]] {
                    inv_q   = 1'b1;
                    inv_a_q = la;
                }
            }
            // spurious events for atomic_unit only
            spur_q   = lfsr[29:22] == 8'd0;
            spur_l_q = if lfsr[25] ? hpo.va[55:6] : trsv_pa_q[55:6];
            // the counter write landed: remember the remote increments so far
            if np_v[NP_ATOMIC] && np_req[NP_ATOMIC].cls == MemCls::STORE_EXCL && np_req[NP_ATOMIC].pa[55:6] == CTR_VA[55:6] && dcperf.excl_pass {
                rc_snap_q = rcnt_q;
            }
            // interrupts withhold the token for a while and may be taken
            if irq_q {
                irq_n_q = irq_n_q - 4'd1;
                if irq_n_q == 4'd0 || x_take {
                    irq_q = 1'b0;
                }
            } else if lfsr[40:34] == 7'd0 {
                irq_q   = 1'b1;
                irq_n_q = lfsr[21:18] | 4'd1;
            }
            if at_st || io_st_s {
                hs_q = 1'b1;
            } else if c_ret != 0 || (kill_q.valid && kill_q.full) {
                hs_q = 1'b0;
            }
            // the reservation as the program sees it
            // (frozen once an SC presented its write: later events are after it)
            if np_v[NP_ATOMIC] && np_req[NP_ATOMIC].cls == MemCls::STORE_EXCL {
                sc_sent_q = 1'b1;
            }
            for c in 0..COH_N {
                if at_coh_v[c] && at_coh_l[c] == trsv_pa_q[55:6] && !sc_sent_q {
                    tlost_q = 1'b1;
                }
            }
            if x_take {
                trsv_v_q = 1'b0;
            }
            if lr_age_q != 16'hffff {
                lr_age_q = lr_age_q + 16'd1;
            }

            // store data delay
            for p in 0..MW {
                let rel: logic = hv_q[p] && hc_q[p] == 4'd0;
                if hv_q[p] && !rel {
                    hc_q[p] = hc_q[p] - 4'd1;
                }
                if rel {
                    hv_q[p] = 1'b0;
                }
                if std_p[p].valid && (rel || (!hv_q[p] && lfsr[45 + p])) {
                    // a store data that is not passed through waits here
                    hv_q[p] = 1'b1;
                    hd_q[p] = std_p[p];
                    hc_q[p] = lfsr[53:50];
                }
                if kill_q.valid && hv_q[p] && killed(kill_q, sq_rob[hd_q[p].sq.idx]) {
                    hv_q[p] = 1'b0;
                }
            }

            // completion packets; a pair packet is the in-place rd+1 write of
            // amocas.q and completes nothing
            for p in 0..MW {
                if wb[p].valid {
                    if wb[p].pair {
                        r_val2[wb[p].tag.rob.idx] = wb[p].data;
                    } else {
                        r_done[wb[p].tag.rob.idx] = 1'b1;
                        r_exc[wb[p].tag.rob.idx]  = wb[p].exc.valid;
                        r_val[wb[p].tag.rob.idx]  = wb[p].data;
                    }
                }
            }

            // issue
            for p in 0..MW {
                if sel_v[p] {
                    r_iniq[sel_e[p]] = 1'b0;
                }
            }
            for e in 0..RN {
                if lfence.valid && lfence.seq == r_barw[e] {
                    r_obey[e] = 1'b0;
                }
            }

            // commit
            if c_mis || c_bad || x_bad {
                ok_q = 1'b0;
                if ok_q {
                    $display("lsu mismatch seed=%d cyc=%d mis=%b bad=%b pi=%d exp=%h got=%h", SEED, cyc_q, c_mis, c_bad, c_mpi, c_mex, c_mgt);
                    $display("lsu x mismatch why=%d pi=%d kind=%d op=%d f3=%d va=%h got=%h rsv=%b %h lost=%b", x_why, r_pi[head_q.idx], hpo.kind, hpo.amo.op, hpo.amo.f3, hpo.va, r_val[head_q.idx], trsv_v_q, trsv_pa_q, tlost_q);
                }
            }
            if c_x && hpo.kind == 3'd3 {
                if x_wr {
                    for b in 0..16 {
                        if (b as 5) <: x_nb {
                            gold[(hpo.va[14:0] + b) as 15]   = x_nv[b * 8+:8];
                            gold_w[(hpo.va[14:0] + b) as 15] = 1'b1;
                        }
                    }
                }
                if hpo.ctr {
                    ctr_n_q = ctr_n_q + 64'd1;
                }
                if hpo.amo.op == AmoOp::LR {
                    lr_age_q  = 0;
                    trsv_v_q  = 1'b1;
                    trsv_pa_q = hpo.va;
                    tlost_q   = 1'b0;
                }
                if hpo.amo.op == AmoOp::SC {
                    trsv_v_q = 1'b0;
                }
                sc_sent_q = 1'b0;
            }
            if c_x && hpo.kind == 3'd4 {
                if hpo.st {
                    io_st_n_q = io_st_n_q + 1;
                    for b in 0..8 {
                        if (b as 4) <: (4'd1 << hpo.op.size) {
                            if hpo.nc {
                                nc_gold[(hpo.va[7:0] + b) as 8] = hpo.data[b * 8+:8];
                            } else {
                                tdev_q[(hpo.va[2:0] + b) * 8+:8] = hpo.data[b * 8+:8];
                            }
                        }
                    }
                } else {
                    io_ld_n_q = io_ld_n_q + 1;
                    if !hpo.nc && !hpo.va[3] {
                        io_r0_q = io_r0_q + 64'd1;
                    }
                }
            }
            for l in 0..CMW {
                let e : logic<RW> = ridx(head_q, l);
                let po: POp       = pop(r_pi[e]);
                if (l as 32) <: c_ret && po.kind == 3'd1 {
                    for b in 0..8 {
                        let bi: logic<3>  = b;
                        let sz: logic<4>  = 4'd1 << po.op.size;
                        if (bi as 4) <: sz {
                            gold[(po.va[14:0] + b) as 15]   = po.data[b * 8+:8];
                            gold_w[(po.va[14:0] + b) as 15] = 1'b1;
                        }
                    }
                }
            }
            head_q = radv(head_q, c_ret);
            nret_q = nret_q + c_ret;
            idle_q = if c_ret != 0 ? 0 : idle_q + 1;
            at_g_q = {at_g_q[0], hd_gnt[NP_ATOMIC]};

            // kill (registered: takes effect on the next edge)
            kill_q = k_next;
            kpi_q  = k_pi;
            if kill_q.valid {
                tail_q = if kill_q.full ? head_q : radv(kill_q.keep, 1);
                disp_q = kpi_q;
            } else {
                // dispatch
                for l in 0..DW {
                    if l <: d_take {
                        let e: logic<RW> = ridx(tail_q, l);
                        r_pi[e]    = disp_q + l;
                        r_done[e]  = d_op[l].kind == 3'd2;
                        r_exc[e]   = 1'b0;
                        r_iniq[e]  = d_op[l].kind != 3'd2;
                        r_kind[e]  = d_op[l].kind;
                        r_ln[e]    = d_op[l].va[55:6];
                        r_ln2[e]   = ln_last(d_op[l]);
                        r_lq[e]    = lq_atag[d_nld[l]];
                        r_sq[e]    = sq_atag[d_nst[l]];
                        r_lqlim[e] = lq_atag[d_nld[l]];
                        r_sqlim[e] = sq_atag[d_nst[l]];
                        r_slq[e]   = lq_atag[d_nld[l + 1]];
                        r_ssq[e]   = sq_atag[d_nst[l + 1]];
                        r_sbar[e]  = bar_after[d_nbar[l + 1]];
                        r_barw[e]  = bar_after[d_nbar[l]];
                        r_obey[e]  = d_op[l].kind == 3'd0 && bar_after[d_nbar[l]] != bar_rt;
                        if in_sq(d_op[l]) {
                            sq_rob[sq_atag[d_nst[l]].idx] = radv(tail_q, l);
                        }
                    }
                }
                tail_q = radv(tail_q, d_take);
                disp_q = disp_q + d_take;
            }

            // coverage
            for p in 0..MW {
                if pperf[p].fwd_full {
                    cnt_q[0] = cnt_q[0] + 1;
                }
                if pperf[p].fwd_part {
                    cnt_q[1] = cnt_q[1] + 1;
                }
                if pperf[p].split {
                    cnt_q[2] = cnt_q[2] + 1;
                }
                if pperf[p].miss {
                    cnt_q[3] = cnt_q[3] + 1;
                }
                if pperf[p].retry {
                    cnt_q[4] = cnt_q[4] + 1;
                }
                if pperf[p].fwd_wait {
                    cnt_q[5] = cnt_q[5] + 1;
                }
            }
            if lqperf.poison_sta {
                cnt_q[6] = cnt_q[6] + 1;
            }
            if lqperf.poison_coh {
                cnt_q[7] = cnt_q[7] + 1;
            }
            if lqperf.park_fill {
                cnt_q[8] = cnt_q[8] + 1;
            }
            if lqperf.park_busy {
                cnt_q[9] = cnt_q[9] + 1;
            }
            if lqperf.park_head {
                cnt_q[10] = cnt_q[10] + 1;
            }
            if lqperf.reissue {
                cnt_q[11] = cnt_q[11] + 1;
            }
            if sqperf.reissue {
                cnt_q[12] = cnt_q[12] + 1;
            }
            if sbperf.merge {
                cnt_q[13] = cnt_q[13] + 1;
            }
            if sbperf.urgent {
                cnt_q[14] = cnt_q[14] + 1;
            }
            if dcperf.attach {
                cnt_q[15] = cnt_q[15] + 1;
            }
            if dcperf.crit_hit {
                cnt_q[16] = cnt_q[16] + 1;
            }
            if dcperf.huf {
                cnt_q[17] = cnt_q[17] + 1;
            }
            if dcperf.drain_rfo {
                cnt_q[18] = cnt_q[18] + 1;
            }
            if dcperf.drain_merge {
                cnt_q[19] = cnt_q[19] + 1;
            }
            if if MW >: 1 ? dcperf.r_bank : dcperf.vic_wb {
                cnt_q[20] = cnt_q[20] + 1;
            }
            if dcperf.r_inv_race {
                cnt_q[21] = cnt_q[21] + 1;
            }
            if dcperf.r_fill_busy {
                cnt_q[22] = cnt_q[22] + 1;
            }
            if c_rply {
                cnt_q[23] = cnt_q[23] + 1;
            }
            if k_next.valid && !k_next.full {
                cnt_q[24] = cnt_q[24] + 1;
            }
            if c_fence {
                cnt_q[25] = cnt_q[25] + 1;
            }
            if lqperf.park_sq {
                cnt_q[26] = cnt_q[26] + 1;
            }
            if dcperf.hit {
                cnt_q[27] = cnt_q[27] + 1;
            }
            if sbperf.drain {
                cnt_q[28] = cnt_q[28] + 1;
            }
            if pr_v_q && pr_ack {
                cnt_q[29] = cnt_q[29] + 1;
            }
            if dcperf.r_preempted {
                cnt_q[30] = cnt_q[30] + 1;
            }
            if lfence.valid {
                cnt_q[31] = cnt_q[31] + 1;
            }
            ev[0]  = atperf.start;
            ev[1]  = atperf.ld_excl;
            ev[2]  = atperf.st_excl;
            ev[3]  = atperf.pass;
            ev[4]  = atperf.fail;
            ev[5]  = atperf.watch;
            ev[6]  = atperf.backoff;
            ev[7]  = atperf.park_fill;
            ev[8]  = atperf.park_busy;
            ev[9]  = atperf.retry;
            ev[10] = atperf.rsv_set;
            ev[11] = atperf.rsv_coh;
            ev[12] = atperf.rsv_clr;
            ev[13] = atperf.sc_nores;
            ev[14] = atperf.cas_miss;
            ev[15] = atperf.tok_lost;
            ev[16] = ioperf.load;
            ev[17] = ioperf.store;
            ev[18] = ioperf.cmo;
            ev[19] = ioperf.ord_wait;
            ev[20] = dcperf.probe_wb;
            ev[21] = dcperf.nf_busy;
            ev[22] = dcperf.excl_pass;
            ev[23] = dcperf.excl_busy;
            ev[24] = dcperf.unc_done;
            ev[25] = dcperf.wt_done;
            ev[26] = c_x && hpo.kind == 3'd3 && hpo.amo.op == AmoOp::SC && r_val[head_q.idx] == 64'd0;
            ev[27] = c_x && hpo.kind == 3'd3 && hpo.amo.op == AmoOp::SC && r_val[head_q.idx] == 64'd1;
            ev[28] = pr_v_q && pr_inc_q && (pr_ack || (mw_wen && mw_wb && mw_addr[55:6] == pr_a_q[55:6]));
            ev[29] = inv_q;
            ev[30] = x_take;
            ev[31] = c_x && hpo.kind == 3'd3 && hpo.amo.f3 == 3'd4;
            for i in 0..32 {
                if ev[i] {
                    cnt2_q[i] = cnt2_q[i] + 1;
                }
            }
            ev3[0] = sqperf.sta_multi;
            ev3[1] = sqperf.fwd_multi;
            ev3[2] = sqperf.ret_multi;
            ev3[3] = lqperf.scan_multi;
            ev3[4] = sbperf.push_multi;
            ev3[5] = sbperf.merge_same;
            ev3[6] = dcperf.share;
            ev3[7] = lqperf.poison_sta && lqperf.scan_multi;
            for i in 0..8 {
                if ev3[i] {
                    cnt3_q[i] = cnt3_q[i] + 1;
                }
            }
        }
    }

    always_comb {
        for i in 0..32 {
            o_cov[i]  = cnt_q[i] != 0;
            o_cov2[i] = cnt2_q[i] != 0;
        }
        for i in 0..8 {
            o_cov3[i] = cnt3_q[i] != 0;
        }
    }
    assign o_chk     = {3'd0, c_io, c_at, c_dc, c_sb, c_sq, c_lq, ok_q == 1'b0};
    assign o_pass    = ok_q && idle_q <: 16'd3000;
    assign o_done    = nret_q >= NOPS || idle_q >= 16'd3000;
    assign o_retired = nret_q;
}

#[test(test_lsu)]
module test_lsu {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var d: logic     [6];
    var p: logic     [6];
    var n: logic<32> [6];
    var v: logic<32> [6];
    var w: logic<32> [6];
    var c: logic<32> [6];
    var x: logic<8>  [6];

    inst h0: lsu_harness::<cfg_w2> #(
        SEED: 64'h1,
    ) (
        clk               ,
        rst               ,
        o_done   : d[0]   ,
        o_pass   : p[0]   ,
        o_retired: n[0]   ,
        o_cov    : v[0]   ,
        o_cov2   : w[0]   ,
        o_cov3   : x[0]   ,
        o_chk    : c[0]   ,
    );
    inst h1: lsu_harness::<cfg_w2> #(
        SEED: 64'h3,
    ) (
        clk               ,
        rst               ,
        o_done   : d[1]   ,
        o_pass   : p[1]   ,
        o_retired: n[1]   ,
        o_cov    : v[1]   ,
        o_cov2   : w[1]   ,
        o_cov3   : x[1]   ,
        o_chk    : c[1]   ,
    );
    inst h2: lsu_harness::<cfg_w4> #(
        SEED: 64'h2,
    ) (
        clk               ,
        rst               ,
        o_done   : d[2]   ,
        o_pass   : p[2]   ,
        o_retired: n[2]   ,
        o_cov    : v[2]   ,
        o_cov2   : w[2]   ,
        o_cov3   : x[2]   ,
        o_chk    : c[2]   ,
    );
    inst h3: lsu_harness::<cfg_w4> #(
        SEED: 64'h8,
    ) (
        clk               ,
        rst               ,
        o_done   : d[3]   ,
        o_pass   : p[3]   ,
        o_retired: n[3]   ,
        o_cov    : v[3]   ,
        o_cov2   : w[3]   ,
        o_cov3   : x[3]   ,
        o_chk    : c[3]   ,
    );
    inst h4: lsu_harness::<cfg_w4> #(
        SEED: 64'h2,
        XOPS: 0    ,
    ) (
        clk               ,
        rst               ,
        o_done   : d[4]   ,
        o_pass   : p[4]   ,
        o_retired: n[4]   ,
        o_cov    : v[4]   ,
        o_cov2   : w[4]   ,
        o_cov3   : x[4]   ,
        o_chk    : c[4]   ,
    );

    inst h5: lsu_harness::<cfg_w4_sb8> #(
        SEED: 64'h2,
        XOPS: 0    ,
    ) (
        clk               ,
        rst               ,
        o_done   : d[5]   ,
        o_pass   : p[5]   ,
        o_retired: n[5]   ,
        o_cov    : v[5]   ,
        o_cov2   : w[5]   ,
        o_cov3   : x[5]   ,
        o_chk    : c[5]   ,
    );

    initial {
        rst.assert(clk);
        clk.next(14000);
        for i in 0..6 {
            $display("lsu %d: done=%b pass=%b retired=%d cov=%b cov2=%b cov3=%b chk=%b", i, d[i], p[i], n[i], v[i], w[i], x[i], c[i]);
        }
        $assert(d[0] && p[0] && c[0] == 32'd0 && d[1] && p[1] && c[1] == 32'd0, "lsu w2 failed");
        $assert(d[2] && p[2] && c[2] == 32'd0 && d[3] && p[3] && c[3] == 32'd0 && d[4] && p[4] && c[4] == 32'd0 && d[5] && p[5] && c[5] == 32'd0, "lsu w4 failed");
        $assert((v[0] | v[1]) == 32'hffff_ffff, "lsu w2: a mechanism did not fire");
        $assert((v[2] | v[3] | v[4] | v[5]) == 32'hffff_ffff, "lsu w4: a mechanism did not fire");
        $assert((w[0] | w[1]) == 32'hffff_ffff, "lsu w2: an atomic or io mechanism did not fire");
        $assert((w[2] | w[3]) == 32'hffff_ffff, "lsu w4: an atomic or io mechanism did not fire");
        $assert((x[2] | x[3] | x[4]) == 8'hff, "lsu w4: a two-pipe mechanism did not fire");
        $finish();
    }
}
