// CSR module unit test.
// Verifies CSRRW/CSRRS/CSRRC read-modify-write semantics on mscratch
// (a side-effect-free WARL register), plus mtvec write/read.
module test_csr_harness (
    clk   : input  clock   ,
    rst   : input  reset   ,
    o_pass: output logic   ,
    o_done: output logic   ,
    o_tc  : output logic<8>,
) {
    import csr_pkg::CsrOp;
    import csr_pkg::PrivLevel;

    var tc: logic<8>;

    always_ff {
        if_reset {
            tc = 8'd0;
        } else {
            tc = tc + 8'd1;
        }
    }

    const CSR_MSCRATCH: logic<12> = 12'h340;
    const CSR_MTVEC   : logic<12> = 12'h305;

    var addr      : logic<12>;
    var wen       : logic    ;
    var op        : CsrOp    ;
    var wdata     : logic<64>;
    var trap      : logic    ;
    var trap_cause: logic<64>;
    var trap_pc   : logic<64>;
    var trap_val  : logic<64>;
    var mret      : logic    ;
    var sret      : logic    ;
    var timer_irq : logic    ;
    var ext_irq_m : logic    ;
    var ext_irq_s : logic    ;
    var sw_irq    : logic    ;
    var instret   : logic    ;
    var mtime     : logic<64>;
    var is_ecall  : logic    ;

    var rdata       : logic    <64>;
    var mret_pc     : logic    <64>;
    var sret_pc     : logic    <64>;
    var mtvec       : logic    <64>;
    var stvec       : logic    <64>;
    var priv        : PrivLevel    ;
    var irq_pending : logic        ;
    var irq_cause   : logic    <64>;
    var satp        : logic    <64>;
    var sum         : logic        ;
    var mxr         : logic        ;
    var access_fault: logic        ;
    var frm         : logic    <3> ;

    inst dut: csr (
        clk                         ,
        rst                         ,
        i_addr        : addr        ,
        o_rdata       : rdata       ,
        i_wen         : wen         ,
        i_op          : op          ,
        i_wdata       : wdata       ,
        i_trap        : trap        ,
        i_trap_cause  : trap_cause  ,
        i_trap_pc     : trap_pc     ,
        i_trap_val    : trap_val    ,
        i_mret        : mret        ,
        i_sret        : sret        ,
        o_mret_pc     : mret_pc     ,
        o_sret_pc     : sret_pc     ,
        o_mtvec       : mtvec       ,
        o_stvec       : stvec       ,
        o_priv        : priv        ,
        o_irq_pending : irq_pending ,
        o_irq_cause   : irq_cause   ,
        i_timer_irq   : timer_irq   ,
        i_ext_irq_m   : ext_irq_m   ,
        i_ext_irq_s   : ext_irq_s   ,
        i_sw_irq      : sw_irq      ,
        i_instret     : instret     ,
        i_mtime       : mtime       ,
        i_is_ecall    : is_ecall    ,
        o_satp        : satp        ,
        o_sum         : sum         ,
        o_mxr         : mxr         ,
        o_access_fault: access_fault,
        o_frm         : frm         ,
    );

    // Default: read mscratch every cycle. Override on specific tc.
    always_comb {
        addr       = CSR_MSCRATCH;
        wen        = 1'b0;
        op         = CsrOp::RW;
        wdata      = 64'd0;
        trap       = 1'b0;
        trap_cause = 64'd0;
        trap_pc    = 64'd0;
        trap_val   = 64'd0;
        mret       = 1'b0;
        sret       = 1'b0;
        timer_irq  = 1'b0;
        ext_irq_m  = 1'b0;
        ext_irq_s  = 1'b0;
        sw_irq     = 1'b0;
        instret    = 1'b0;
        mtime      = 64'd0;
        is_ecall   = 1'b0;

        case tc {
            8'd1: {
                addr  = CSR_MSCRATCH;
                wen   = 1'b1;
                op    = CsrOp::RW;
                wdata = 64'hDEAD_BEEF_CAFE_BABE;
            }
            8'd3: {
                addr  = CSR_MSCRATCH;
                wen   = 1'b1;
                op    = CsrOp::RS;
                wdata = 64'h0000_FFFF_0000_FFFF;
            }
            8'd5: {
                addr  = CSR_MSCRATCH;
                wen   = 1'b1;
                op    = CsrOp::RC;
                wdata = 64'hF0F0_0000_F0F0_0000;
            }
            8'd7: {
                addr  = CSR_MTVEC;
                wen   = 1'b1;
                op    = CsrOp::RW;
                wdata = 64'h0000_0000_8000_0100;
            }
            default: {}
        }
    }

    // Sample mscratch read on quiet cycles. addr defaults to mscratch
    // (and rdata is comb), so we can capture rdata directly.
    var sample_rw : logic<64>;
    var sample_rs : logic<64>;
    var sample_rc : logic<64>;
    var sample_mtv: logic<64>;
    always_ff {
        if_reset {
            sample_rw  = 64'hAAAA_AAAA_AAAA_AAAA;
            sample_rs  = 64'hAAAA_AAAA_AAAA_AAAA;
            sample_rc  = 64'hAAAA_AAAA_AAAA_AAAA;
            sample_mtv = 64'hAAAA_AAAA_AAAA_AAAA;
        } else {
            if tc == 8'd2 {
                sample_rw = rdata;
            }
            if tc == 8'd4 {
                sample_rs = rdata;
            }
            if tc == 8'd6 {
                sample_rc = rdata;
            }
            if tc == 8'd9 {
                sample_mtv = mtvec;
            }
        }
    }

    var ok: logic;
    always_comb {
        ok = 1'b1;
        case tc {
            8'd11: {
                // Expected sequence:
                //   tc=1: CSRRW mscratch <- 0xDEAD_BEEF_CAFE_BABE
                //   tc=3: CSRRS bits 0xFFFF_0000_FFFF → set
                //          0xDEAD_BEEF_CAFE_BABE | 0x0000_FFFF_0000_FFFF
                //          = 0xDEAD_FFFF_CAFE_FFFF
                //   tc=5: CSRRC bits 0xF0F0_0000_F0F0_0000 → clear
                //          0xDEAD_FFFF_CAFE_FFFF & ~0xF0F0_0000_F0F0_0000
                //          = 0xDEAD_FFFF_CAFE_FFFF & 0x0F0F_FFFF_0F0F_FFFF
                //          = 0x0E0D_FFFF_0A0E_FFFF
                if sample_rw != 64'hDEAD_BEEF_CAFE_BABE {
                    ok = 1'b0;
                }
                if sample_rs != 64'hDEAD_FFFF_CAFE_FFFF {
                    ok = 1'b0;
                }
                if sample_rc != 64'h0E0D_FFFF_0A0E_FFFF {
                    ok = 1'b0;
                }
                if sample_mtv != 64'h0000_0000_8000_0100 {
                    ok = 1'b0;
                }
            }
            default: {}
        }
    }

    var failed: logic;
    always_ff {
        if_reset {
            failed = 1'b0;
        } else if !ok {
            failed = 1'b1;
        }
    }

    assign o_tc   = tc;
    assign o_pass = !failed;
    assign o_done = tc >: 8'd13;
}

#[test(test_csr)]
module test_csr {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen;

    var pass: logic   ;
    var done: logic   ;
    var tc  : logic<8>;

    inst harness: test_csr_harness (
        clk   : clk ,
        rst   : rst ,
        o_pass: pass,
        o_done: done,
        o_tc  : tc  ,
    );

    initial {
        rst.assert(clk);
        for _i: i32 in 0..16 {
            clk.next(1);
        }
        $assert (pass, "CSR test failed");
        $display("CSR test passed");
        $finish ();
    }
}
