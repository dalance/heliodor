// AUTO-GENERATED v4 FP arch-test harnesses (rv64uf + rv64ud).
// Reuses test_v4_arch_common_harness; see gen_tb.py for the v1 generator.

#[test(test_v4_arch_rv64uf_fadd)]
module test_v4_arch_rv64uf_fadd {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var pass  : logic    ;
    var fail  : logic    ;
    var tohost: logic<32>;
    inst h: test_v4_arch_common_harness #(
        HEX_FILE  : "test/riscv-arch-test/build/rv64uf/fadd.hex",
        TOHOST_IDX: 1024                                          ,
    ) (
        clk                ,
        rst                ,
        o_pass    : pass   ,
        o_fail    : fail   ,
        o_tohost  : tohost ,
    );
    initial {
        rst.assert(clk);
        clk.next  (300000);
        $display  ("v4 rv64uf-fadd tohost=%h pass=%b", tohost, pass);
        $assert   (pass, "v4 rv64uf-fadd fail");
        $display  ("v4 rv64uf-fadd PASS");
        $finish   ();
    }
}

