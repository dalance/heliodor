// stage_reg: partial and full kill on the capture edge, for both supported
// configs. Tags are base + off in the ROB ring with off < ROB_N, so the op
// with the larger off is younger; a partial kill removes ops younger than
// keep. Also checks killed() against tag_older.
module stage_reg_harness::<CFG: core_cfg> (
    clk   : input  clock   ,
    rst   : input  reset   ,
    o_pass: output logic   ,
    o_done: output logic   ,
    o_cov : output logic<4>,
) {
    import core_types::<CFG>::*;

    var lfsr0: logic<64>;
    var lfsr1: logic<64>;
    var cnt  : logic<16>;
    var ok   : logic    ;
    var cov_q: logic<4> ;

    let base : logic <ROB_TAG_W> = lfsr1[63:64 - ROB_TAG_W];
    let off_t: logic <ROB_IDX_W> = lfsr0[ROB_IDX_W - 1:0];
    let off_k: logic <ROB_IDX_W> = lfsr0[ROB_IDX_W + 15:16];
    let t_tag: RobTag            = (base + off_t) as RobTag;
    let k_tag: RobTag            = (base + off_k) as RobTag;

    var kill: Kill ;
    var din : OpTag;
    always_comb {
        kill       = 0 as Kill;
        kill.valid = lfsr0[40];
        kill.full  = lfsr0[41] && lfsr0[42];
        kill.keep  = k_tag;
        din        = lfsr1[$bits(OpTag) - 1:0] as OpTag;
        din.rob    = t_tag;
    }
    let vin: logic = lfsr0[43] || lfsr0[44];

    let exp_kill: logic = kill.valid && (kill.full || off_k <: off_t);

    var vout: logic;
    var dout: OpTag;
    inst dut: stage_reg::<CFG> #(
        T: OpTag,
    ) (
        clk           ,
        rst           ,
        i_valid: vin  ,
        i_data : din  ,
        i_tag  : t_tag,
        i_kill : kill ,
        o_valid: vout ,
        o_data : dout ,
    );

    var ev_q: logic;
    var ed_q: OpTag;

    let k_got: logic = killed(kill, t_tag);
    let k_age: logic = kill.valid && (kill.full || tag_older::<ROB_TAG_W>(kill.keep, t_tag));
    let bad  : logic = k_got != exp_kill || k_got != k_age || vout != ev_q || (ev_q && dout != ed_q);

    always_ff {
        if_reset {
            lfsr0 = 64'h1234_5678_9abc_def0;
            lfsr1 = 64'hfedc_ba98_7654_3210;
            cnt   = 0;
            ok    = 1'b1;
            cov_q = 0;
            ev_q  = 1'b0;
            ed_q  = 0 as OpTag;
        } else {
            if bad {
                ok = 1'b0;
            }
            if vin && kill.valid && !kill.full {
                if exp_kill {
                    cov_q[0] = 1'b1;
                } else {
                    cov_q[1] = 1'b1;
                }
            }
            if vin && kill.full {
                cov_q[2] = 1'b1;
            }
            if vin && kill.valid && !kill.full && off_k == off_t {
                cov_q[3] = 1'b1;
            }
            ev_q  = vin && !exp_kill;
            ed_q  = din;
            var t0   : logic<64>;
            var t1   : logic<64>;
            t0    = lfsr0 ^ (lfsr0 << 13);
            t0    = t0 ^ (t0 >> 7);
            t0    = t0 ^ (t0 << 17);
            lfsr0 = t0;
            t1    = lfsr1 ^ (lfsr1 >> 11);
            t1    = t1 ^ (t1 << 9);
            t1    = t1 ^ (t1 >> 13);
            lfsr1 = t1;
            cnt   = cnt + 1;
        }
    }

    assign o_pass = ok;
    assign o_done = cnt >= 16'd3000;
    assign o_cov  = cov_q;
}

#[test(test_stage_reg)]
module test_stage_reg {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass2: logic   ;
    var done2: logic   ;
    var cov2 : logic<4>;
    var pass4: logic   ;
    var done4: logic   ;
    var cov4 : logic<4>;
    inst h2: stage_reg_harness::<cfg_w2> (
        clk          ,
        rst          ,
        o_pass: pass2,
        o_done: done2,
        o_cov : cov2 ,
    );
    inst h4: stage_reg_harness::<cfg_w4> (
        clk          ,
        rst          ,
        o_pass: pass4,
        o_done: done4,
        o_cov : cov4 ,
    );

    initial {
        rst.assert(clk);
        clk.next(3100);
        $display("stage_reg: w2 pass=%b cov=%b  w4 pass=%b cov=%b", pass2, cov2, pass4, cov4);
        $assert(done2 && done4, "stage_reg test did not run enough cycles");
        $assert(pass2 && pass4, "stage_reg kill mismatch");
        $assert(cov2 == 4'b1111 && cov4 == 4'b1111, "stage_reg kill scenario not covered");
        $finish();
    }
}
