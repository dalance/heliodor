// ---- Independent double-FMA stream: writeback must follow the FMA's own op ----
// The multi-cycle completion it guards is only reached when the scalar FPU runs
// FMA_PIPE3=1; at the 2-stage default this is a plain FMA check.
#[test(test_arch_fma_ilp)]
#[ignore]
module test_arch_fma_ilp {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var pass  : logic    ;
    var fail  : logic    ;
    var tohost: logic<32>;
    inst h: test_arch_common_harness #(
        HEX_FILE  : "test/fma/fma_ilp.hex",
        TOHOST_IDX: 1024,
    ) (
        clk          ,
        rst          ,
        o_pass  : pass  ,
        o_fail  : fail  ,
        o_tohost: tohost,
    );
    initial {
        rst.assert(clk);
        clk.next  (100000);
        $display  ("fma-ilp tohost=%h pass=%b", tohost, pass);
        $assert   (pass, "fma-ilp fail");
        $display  ("fma-ilp PASS");
        $finish   ();
    }
}
