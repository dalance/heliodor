        HEX_FILE  : "test/zfa/zfa_s3.hex",
        TOHOST_IDX: 1024,
    ) (
        clk          ,
        rst          ,
        o_pass  : pass  ,
        o_fail  : fail  ,
        o_tohost: tohost,
    );
    initial {
        rst.assert(clk);
        clk.next  (100000);
        $display  ("zfa-s3 tohost=%h pass=%b", tohost, pass);
        $assert   (pass, "zfa-s3 fail");
        $display  ("zfa-s3 PASS");
        $finish   ();
    }
}

