// FP arch-test modules (rv64uf + rv64ud), maintained directly (the original
// generator was removed in the P7 cleanup). Each reuses test_arch_common_harness
// (defined in test_arch_common.veryl) with its own HEX_FILE. All are
// #[ignore]: tb/test_w2_rv64uf.veryl, tb/test_w2_rv64ud.veryl and their W4
// twins run the same images in the default suite.

#[test(test_arch_rv64uf_fadd)]
#[ignore]
module test_arch_rv64uf_fadd {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var pass  : logic    ;
    var fail  : logic    ;
    var tohost: logic<32>;
    inst h: test_arch_common_harness #(
        HEX_FILE  : "test/riscv-arch-test/build/rv64uf/fadd.hex",
        TOHOST_IDX: 1024                                          ,
    ) (
        clk                ,
        rst                ,
        o_pass    : pass   ,
        o_fail    : fail   ,
        o_tohost  : tohost ,
    );
    initial {
        rst.assert(clk);
        clk.next  (300000);
        $display  ("v4 rv64uf-fadd tohost=%h pass=%b", tohost, pass);
        $assert   (pass, "v4 rv64uf-fadd fail");
        $display  ("v4 rv64uf-fadd PASS");
        $finish   ();
    }
}

