// Linux 7.1 RVA23 verification boot (1-hart) on heliodor_soc_smp, default
// core: the 7.1 kernel + RVA23 DTS (test/hex/linux_dram_71.hex) and the
// RVA23 firmware (menvcfg STCE/PBMTE/ADUE + SBI DBCN,
// test/hex/linux_boot_fw_71.hex). The 7.1 kernel additionally exercises
// Svadu (hardware A/D update via menvcfg.ADUE) and Svinval (sinval.vma TLB
// range flush); Zawrs needs the SMP boot.
//
// Pass = x3 reaches 0xAA (SBI SRST shutdown after init runs).
// Marked #[ignore] (long run):  veryl test --ignored --test test_soc_71_linux_boot
#[test(test_soc_71_linux_boot)]
#[ignore]
module test_soc_71_linux_boot {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass   : logic    ;
    var fail   : logic    ;
    var x3     : logic<64>;
    var cycles : logic<64>;
    var instret: logic<64>;
    var last_pc: logic<64>;

    inst u_h: boot_soc_harness #(
        FW_HEX  : "test/hex/linux_boot_fw_71.hex",
        DRAM_HEX: "test/hex/linux_dram_71.hex",
    ) (
        clk                 ,
        rst                 ,
        o_pass   : pass     ,
        o_fail   : fail     ,
        o_x3     : x3       ,
        o_cycles : cycles   ,
        o_instret: instret  ,
        o_last_pc: last_pc  ,
        o_ret_cnt: _        ,
        o_traps  : _        ,
    );

    initial {
        rst.assert(clk);
        for i in 0..5100 {
            clk.next(10000);
            if pass || fail {
                break;
            }
            if i % 50 == 49 {
                $display("SoC 7.1 linux boot probe: cy=%d instret=%d pc=%h x3=%h", cycles, instret, last_pc, x3);
            }
        }
        $display("SoC 7.1 linux boot: cy=%d instret=%d x3=%h pass=%b fail=%b", cycles, instret, x3, pass, fail);
        $assert (pass, "SoC 7.1 linux boot: did not reach SBI shutdown (x3 != 0xAA)");
        $finish ();
    }
}

// The 7.1 boot with the vector kernel and firmware
// (test/hex/linux_boot_fw_71v.hex). The kernel detects V, probes VLEN with a
// kernel-mode vsetvli and enables vector state; the userspace /init then runs a
// RVV self-test (vsetvli + vle32 + vadd.vv + vmul.vx, verified) before issuing
// the SBI shutdown, so reaching x3 == 0xAA proves vector works end-to-end under
// a real OS (lazy enable, context save/restore).
// Marked #[ignore] (long run):  veryl test --ignored --test test_soc_71v_linux_boot
#[test(test_soc_71v_linux_boot)]
#[ignore]
module test_soc_71v_linux_boot {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass   : logic    ;
    var fail   : logic    ;
    var x3     : logic<64>;
    var cycles : logic<64>;
    var instret: logic<64>;
    var last_pc: logic<64>;

    inst u_h: boot_soc_harness #(
        FW_HEX  : "test/hex/linux_boot_fw_71v.hex",
        DRAM_HEX: "test/hex/linux_dram_71v.hex",
    ) (
        clk                 ,
        rst                 ,
        o_pass   : pass     ,
        o_fail   : fail     ,
        o_x3     : x3       ,
        o_cycles : cycles   ,
        o_instret: instret  ,
        o_last_pc: last_pc  ,
        o_ret_cnt: _        ,
        o_traps  : _        ,
    );

    initial {
        rst.assert(clk);
        for i in 0..5100 {
            clk.next(10000);
            if pass || fail {
                break;
            }
            if i % 50 == 49 {
                $display("SoC 7.1v linux boot probe: cy=%d instret=%d pc=%h x3=%h", cycles, instret, last_pc, x3);
            }
        }
        $display("SoC 7.1v linux boot: cy=%d instret=%d x3=%h pass=%b fail=%b", cycles, instret, x3, pass, fail);
        $assert (pass, "SoC 7.1v linux boot: did not reach SBI shutdown (x3 != 0xAA)");
        $finish ();
    }
}

// The 7.1 N=1 boot on the new core (W2), pass/fail only. The 51M-cycle
// budget is an early-exit bound of about 3x the old core's boot (~17.1M), not
// a measured figure.
#[test(test_w2_linux_boot_71)]
#[ignore]
module test_w2_linux_boot_71 {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass   : logic    ;
    var fail   : logic    ;
    var x3     : logic<64>;
    var cycles : logic<64>;
    var instret: logic<64>;
    var last_pc: logic<64>;

    inst u_h: boot_soc_harness #(
        FW_HEX  : "test/hex/linux_boot_fw_71.hex",
        DRAM_HEX: "test/hex/linux_dram_71.hex"   ,
        CORE    : tb_core_sel::CORE_W2          ,
    ) (
        clk                 ,
        rst                 ,
        o_pass   : pass     ,
        o_fail   : fail     ,
        o_x3     : x3       ,
        o_cycles : cycles   ,
        o_instret: instret  ,
        o_last_pc: last_pc  ,
        o_ret_cnt: _        ,
        o_traps  : _        ,
    );

    initial {
        rst.assert(clk);
        for i in 0..5100 {
            clk.next(10000);
            if pass || fail {
                break;
            }
            if i % 50 == 49 {
                $display("w2 7.1 boot probe: cy=%d instret=%d pc=%h x3=%h", cycles, instret, last_pc, x3);
            }
        }
        $display("w2 linux 7.1 boot: cy=%d instret=%d x3=%h pass=%b fail=%b", cycles, instret, x3, pass, fail);
        $assert (pass, "w2 linux 7.1 boot: did not reach SBI shutdown (x3 != 0xAA)");
        $finish ();
    }
}

