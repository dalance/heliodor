// Phase 7 v4 M9.3: N=2 SMP Linux boot smoke through heliodor_soc_smp.
//
// Mirrors test_soc_linux_boot (single-hart) but drives the SMP SoC: per-hart
// instruction fetch (o_imem_*) and PTW (o_iptw_*) are arrays served from the same
// firmware ROM + DRAM, while the data path (o_dmem_*) is the single shared port
// the SoC's memory_bus arbitrates. CLINT / UART live inside the SoC. Pass = hart0
// x3 reaches 0xAA (SBI SRST shutdown). 2-hart firmware + SMP kernel image.
//
// Marked #[ignore] (long run). The two SMP boot tests have INDEPENDENTLY
// selectable names (neither is a prefix of the other):
//   veryl test --ignored --test test_soc_smp_linux_boot_2hart   # N=2 only
//   veryl test --ignored --test test_soc_smp_linux_boot_4hart   # N=4 only
//   veryl test --ignored --test test_soc_smp_linux_boot         # both
// (N=1 single-hart boot is the separate test_soc_linux_boot.)
module test_soc_smp_linux_boot_harness #(
    param N_HARTS   : u32    = 2                                   ,
    param HEX_FW    : string = "test/hex/linux_boot_fw_2hart.hex"  ,
    param HEX_DRAM  : string = "test/hex/linux_dram_real_2hart.hex",
) (
    clk : input clock,
    rst : input reset,
    o_pass : output logic    ,
    o_r3   : output logic<64>,
    o_r3_h1: output logic<64>,
    o_pc0  : output logic<64>,
    o_pc1  : output logic<64>,
    o_ret0  : output logic<32>,
    o_ret1  : output logic<32>,
    o_trapc0: output logic<32>,
    o_trapc1: output logic<32>,
    o_cy   : output logic<32>,
    // M9.4 N=4: clean per-hart liveness arrays (PC + retire/trap counters) for
    // ALL harts, so the N=4 top module can observe harts 2/3 without the N=2
    // hart1-only forensic ports. Additive; the N=2 top module ignores these.
    o_pc_all   : output logic<64> [N_HARTS],
    o_ret_all  : output logic<32> [N_HARTS],
    o_trapc_all: output logic<32> [N_HARTS],
) {
    // Per-hart instruction fetch + PTW (tb-served from shared memory).
    var imem_addr : logic<64> [N_HARTS];
    var imem_rdata: logic<32> [N_HARTS];
    var imem_ren  : logic     [N_HARTS];
    var iptw_addr : logic<64> [N_HARTS];
    var iptw_req  : logic     [N_HARTS];
    var iptw_rdata: logic<64> [N_HARTS];
    // Shared data port (arbitrated inside the SoC).
    var dmem_addr    : logic<64>;
    var dmem_wdata   : logic<64>;
    var dmem_rdata   : logic<64>;
    var dmem_wen     : logic    ;
    var dmem_ren     : logic    ;
    var dmem_wstrb   : logic<8> ;
    var dmem_wdata_hi: logic<64>;
    var dmem_wstrb_hi: logic<8> ;
    var uart_tx_v    : logic    ;
    var uart_tx_d    : logic<8> ;
    var dbg_r3        : logic<64> [N_HARTS];
    var dbg_pc        : logic<64> [N_HARTS];
    var dbg_retire_v  : logic     [N_HARTS];
    var dbg_trap_fire : logic     [N_HARTS];

    inst dut: heliodor_soc_smp #(
        N_HARTS : N_HARTS      ,
        RESET_PC: 64'h0000_0000,
    ) (
        clk                          ,
        rst                          ,
        o_imem_addr    : imem_addr   ,
        i_imem_rdata   : imem_rdata  ,
        o_imem_ren     : imem_ren    ,
        o_iptw_addr    : iptw_addr   ,
        o_iptw_req     : iptw_req    ,
        i_iptw_rdata   : iptw_rdata  ,
        o_dmem_addr    : dmem_addr   ,
        o_dmem_wdata   : dmem_wdata  ,
        i_dmem_rdata   : dmem_rdata  ,
        o_dmem_wen     : dmem_wen    ,
        o_dmem_ren     : dmem_ren    ,
        o_dmem_wstrb   : dmem_wstrb  ,
        o_dmem_wdata_hi: dmem_wdata_hi,
        o_dmem_wstrb_hi: dmem_wstrb_hi,
        o_uart_tx_valid: uart_tx_v   ,
        o_uart_tx_data : uart_tx_d   ,
        o_dbg_r3        : dbg_r3        ,
        o_dbg_pc        : dbg_pc        ,
        o_dbg_retire_v  : dbg_retire_v  ,
        o_dbg_trap_fire : dbg_trap_fire ,
    );

    // Firmware ROM (16 KB) + DRAM (32 MB), shared by both harts.
    #[allow(initial_assign)]
    var fw_rom: logic<32> [4096]   ;
    #[allow(initial_assign)]
    var dram  : logic<32> [8388608];
    initial {
        $readmemh(HEX_FW, fw_rom);
        $readmemh(HEX_DRAM, dram);
    }

    // Per-hart instruction fetch + PTW: firmware (PA < 0x4000) else DRAM (PA[31]).
    for h in 0..N_HARTS :gen_fetch {
        let imem_in_fw   : logic     = imem_addr[h][31:14] == 18'd0;
        let dram_imem_idx: logic<23> = imem_addr[h][24:2];
        let fw_imem_idx  : logic<12> = imem_addr[h][13:2];
        assign imem_rdata[h] = if imem_in_fw ? fw_rom[fw_imem_idx] : if imem_addr[h][31] ? dram[dram_imem_idx] : 32'd0;

        let iptw_in_fw  : logic     = iptw_addr[h][31:14] == 18'd0;
        let iptw_in_dram: logic     = iptw_addr[h][31];
        let dram_iptw_lo: logic<23> = {iptw_addr[h][24:3], 1'b0};
        let dram_iptw_hi: logic<23> = {iptw_addr[h][24:3], 1'b1};
        let fw_iptw_lo  : logic<12> = {iptw_addr[h][13:3], 1'b0};
        let fw_iptw_hi  : logic<12> = {iptw_addr[h][13:3], 1'b1};
        assign iptw_rdata[h] = if iptw_in_dram ?
            {dram[dram_iptw_hi], dram[dram_iptw_lo]}
        : if iptw_in_fw ?
            {fw_rom[fw_iptw_hi], fw_rom[fw_iptw_lo]}
        :
            64'd0
        ;
    }
    let _unused_imem_ren: logic = imem_ren[0];
    let _unused_iptw_req: logic = iptw_req[0];
    let _unused_dmem_ren: logic = dmem_ren;

    // Shared data reads: DRAM / firmware ROM (CLINT + UART served inside the SoC).
    let in_fw  : logic = dmem_addr[31:14] == 18'd0;
    let in_dram: logic = dmem_addr[31];

    let dram_dmem_lo   : logic<23> = {dmem_addr[24:3], 1'b0};
    let dram_dmem_hi   : logic<23> = {dmem_addr[24:3], 1'b1};
    let dram_dmem_nx_lo: logic<23> = {(dmem_addr[24:3] + 22'd1), 1'b0};
    let dram_dmem_nx_hi: logic<23> = {(dmem_addr[24:3] + 22'd1), 1'b1};
    let fw_dmem_lo     : logic<12> = {dmem_addr[13:3], 1'b0};
    let fw_dmem_hi     : logic<12> = {dmem_addr[13:3], 1'b1};
    assign dmem_rdata = if in_dram ?
        {dram[dram_dmem_hi], dram[dram_dmem_lo]}
    : if in_fw ?
        {fw_rom[fw_dmem_hi], fw_rom[fw_dmem_lo]}
    :
        64'd0
    ;

    // Cycle counter (declared here so the LOCKW diag in the DRAM-write
    // always_ff below can read it; incremented in the counter always_ff later).
    var cy: logic<32>;

    // Shared DRAM write (lo dword + misaligned hi-side carry). The SoC gates
    // o_dmem_wen / o_dmem_wstrb_hi to DRAM accesses only.
    always_ff (clk, rst) {
        if_reset {} else if dmem_wen && in_dram {
            if dmem_wstrb[0] {
                dram[dram_dmem_lo][7:0] = dmem_wdata[7:0];
            }
            if dmem_wstrb[1] {
                dram[dram_dmem_lo][15:8] = dmem_wdata[15:8];
            }
            if dmem_wstrb[2] {
                dram[dram_dmem_lo][23:16] = dmem_wdata[23:16];
            }
            if dmem_wstrb[3] {
                dram[dram_dmem_lo][31:24] = dmem_wdata[31:24];
            }
            if dmem_wstrb[4] {
                dram[dram_dmem_hi][7:0] = dmem_wdata[39:32];
            }
            if dmem_wstrb[5] {
                dram[dram_dmem_hi][15:8] = dmem_wdata[47:40];
            }
            if dmem_wstrb[6] {
                dram[dram_dmem_hi][23:16] = dmem_wdata[55:48];
            }
            if dmem_wstrb[7] {
                dram[dram_dmem_hi][31:24] = dmem_wdata[63:56];
            }
            // misaligned hi-side (next dword)
            if dmem_wstrb_hi[0] {
                dram[dram_dmem_nx_lo][7:0] = dmem_wdata_hi[7:0];
            }
            if dmem_wstrb_hi[1] {
                dram[dram_dmem_nx_lo][15:8] = dmem_wdata_hi[15:8];
            }
            if dmem_wstrb_hi[2] {
                dram[dram_dmem_nx_lo][23:16] = dmem_wdata_hi[23:16];
            }
            if dmem_wstrb_hi[3] {
                dram[dram_dmem_nx_lo][31:24] = dmem_wdata_hi[31:24];
            }
            if dmem_wstrb_hi[4] {
                dram[dram_dmem_nx_hi][7:0] = dmem_wdata_hi[39:32];
            }
            if dmem_wstrb_hi[5] {
                dram[dram_dmem_nx_hi][15:8] = dmem_wdata_hi[47:40];
            }
            if dmem_wstrb_hi[6] {
                dram[dram_dmem_nx_hi][23:16] = dmem_wdata_hi[55:48];
            }
            if dmem_wstrb_hi[7] {
                dram[dram_dmem_nx_hi][31:24] = dmem_wdata_hi[63:56];
            }
        }
    }


    // UART TX echo (SoC consumes the writes; mirror to stdout).
    always_ff (clk, rst) {
        if_reset {} else if uart_tx_v {
            $write("%c", uart_tx_d);
        }
    }

    // Cycle counter + per-hart retire/trap counters + pass latch (hart0 x3==0xAA).
    // (var cy is declared earlier, above the DRAM-write always_ff.)
    var ret0  : logic<32>;
    var ret1  : logic<32>;
    var trapc0 : logic<32>;
    var trapc1 : logic<32>;
    always_ff (clk, rst) {
        if_reset {
            cy      = 32'd0;
            ret0    = 32'd0;
            ret1    = 32'd0;
            trapc0  = 32'd0;
            trapc1  = 32'd0;
        } else {
            cy = cy + 32'd1;
            if dbg_retire_v[0] {
                ret0 = ret0 + 32'd1;
            }
            if dbg_retire_v[1] {
                ret1 = ret1 + 32'd1;
            }
            if dbg_trap_fire[0] {
                trapc0 = trapc0 + 32'd1;
            }
            if dbg_trap_fire[1] {
                trapc1 = trapc1 + 32'd1;
            }
        }
    }
    assign o_cy     = cy;
    assign o_ret0   = ret0;
    assign o_ret1   = ret1;
    assign o_trapc0 = trapc0;
    assign o_trapc1 = trapc1;

    // M9.4 N=4: per-hart retire/trap counters for ALL harts (N-generic).
    var ret_arr  : logic<32> [N_HARTS];
    var trapc_arr: logic<32> [N_HARTS];
    always_ff (clk, rst) {
        if_reset {
            for h in 0..N_HARTS {
                ret_arr[h]   = 32'd0;
                trapc_arr[h] = 32'd0;
            }
        } else {
            for h in 0..N_HARTS {
                if dbg_retire_v[h] {
                    ret_arr[h] = ret_arr[h] + 32'd1;
                }
                if dbg_trap_fire[h] {
                    trapc_arr[h] = trapc_arr[h] + 32'd1;
                }
            }
        }
    }
    assign o_pc_all    = dbg_pc;
    assign o_ret_all   = ret_arr;
    assign o_trapc_all = trapc_arr;
    assign o_r3    = dbg_r3[0];
    assign o_r3_h1 = dbg_r3[1];
    assign o_pc0   = dbg_pc[0];
    assign o_pc1   = dbg_pc[1];
    assign o_pass  = dbg_r3[0] == 64'h00000000000000aa;

}

#[test(test_soc_smp_linux_boot_2hart)]
#[ignore]
module test_soc_smp_linux_boot_2hart {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass : logic    ;
    var r3   : logic<64>;
    var r3_h1: logic<64>;
    var pc0  : logic<64>;
    var pc1  : logic<64>;
    var ret0   : logic<32>;
    var ret1   : logic<32>;
    var trapc0 : logic<32>;
    var trapc1 : logic<32>;
    var cy     : logic<32>;

    inst harness: test_soc_smp_linux_boot_harness (
        clk             ,
        rst             ,
        o_pass  : pass   ,
        o_r3    : r3     ,
        o_r3_h1 : r3_h1  ,
        o_pc0   : pc0    ,
        o_pc1   : pc1    ,
        o_ret0  : ret0   ,
        o_ret1  : ret1   ,
        o_trapc0: trapc0 ,
        o_trapc1: trapc1 ,
        o_cy    : cy     ,
    );

    initial {
        rst.assert(clk);
        // Poll for SBI shutdown (hart0 x3==0xAA); budget 100M cycles. The periodic
        // probe shows per-hart PC + retire/trap counts: a moving PC / rising retire
        // = forward progress; a frozen retire = a deadlock (never extend to mask it).
        for _i in 0..10000 {
            clk.next(10000);
            if _i % 1000 == 0 {
                $display("  [smp probe] cy=%h h0_pc=%h h1_pc=%h ret0=%h ret1=%h trap0=%h trap1=%h", cy, pc0, pc1, ret0, ret1, trapc0, trapc1);
            }
            if pass {
                break;
            }
        }
        $display("v4 SoC SMP(N=2) boot: cy=%h pass=%b h0_pc=%h h1_pc=%h ret0=%h ret1=%h trap0=%h trap1=%h", cy, pass, pc0, pc1, ret0, ret1, trapc0, trapc1);
        $assert(pass, "v4 SoC SMP(N=2) boot: did not reach SBI shutdown (hart0 x3 != 0xAA)");
        $finish();
    }
}

// ============================================================
// M9.4 — N=4 SMP Linux boot.
//
// Reuses test_soc_smp_linux_boot_harness with N_HARTS=4 and the 4-hart hex
// assets: linux_boot_fw_4hart.hex (firmware already carries the Phase 6.A.3
// HART_START msip delay, 0x80000 cy for target hart>=1) and
// linux_dram_real_4hart.hex (kernel CONFIG_NR_CPUS=4 + 4-cpu DTB @ 0x81400000).
// The SoC/bus/CLINT are already N_HARTS-parameterized (memory_bus gen_n4), and
// the M9.3 free-list fix (commit 3a28998) is N-agnostic and already in the core.
//
// The N=2-only harness ports (o_r3_h1 / o_pc0/1 / o_ret0/1 / o_trapc0/1) are
// left unconnected (#[allow(missing_port)]); all harts are observed via the
// clean per-hart o_pc_all / o_ret_all / o_trapc_all liveness arrays. Pass =
// hart0 x3 == 0xAA.
//
//   veryl test --ignored --test test_soc_smp_linux_boot_4hart
// ============================================================
#[test(test_soc_smp_linux_boot_4hart)]
#[ignore]
module test_soc_smp_linux_boot_4hart {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass     : logic     ;
    var r3       : logic<64> ;
    var cy       : logic<32> ;
    var pc_all   : logic<64> [4];
    var ret_all  : logic<32> [4];
    var trapc_all: logic<32> [4];

    #[allow(missing_port)]
    inst harness: test_soc_smp_linux_boot_harness #(
        N_HARTS   : 4                                   ,
        HEX_FW    : "test/hex/linux_boot_fw_4hart.hex"  ,
        HEX_DRAM  : "test/hex/linux_dram_real_4hart.hex",
    ) (
        clk                   ,
        rst                   ,
        o_pass     : pass     ,
        o_r3       : r3       ,
        o_cy       : cy       ,
        o_pc_all   : pc_all   ,
        o_ret_all  : ret_all  ,
        o_trapc_all: trapc_all,
    );

    initial {
        rst.assert(clk);
        // Poll for SBI shutdown (hart0 x3==0xAA); budget 100M cycles. The per-100-iter
        // probe shows all 4 harts' PC + retire/trap counts: rising retire on a hart =
        // forward progress; a frozen count = a stuck hart. Healthy trajectory: hart0
        // boots solo (~0-18M), then secondaries wake sequentially via the firmware-
        // delayed SBI HART_START (hart1 ~18M, hart2 ~22M, hart3 ~26M), then the kernel
        // completes SMP bring-up and reaches SBI shutdown (~52M with the M9.4 SMP fixes:
        // sticky AMO bus-lock + SC commit-time re-validation + age-gated SC clear).
        // Never extend the budget to mask a frozen (deadlocked) retire count.
        for _i in 0..10000 {
            clk.next(10000);
            // Per-100-iter trajectory probe: per-hart PC + retire/trap counts.
            if _i % 100 == 0 {
                $display("  [n4 probe] cy=%h pc=[%h %h %h %h] ret=[%h %h %h %h] trap=[%h %h %h %h]", cy, pc_all[0], pc_all[1], pc_all[2], pc_all[3], ret_all[0], ret_all[1], ret_all[2], ret_all[3], trapc_all[0], trapc_all[1], trapc_all[2], trapc_all[3]);
            }
            if pass {
                break;
            }
        }
        $display("v4 SoC SMP(N=4) boot: cy=%h pass=%b r3=%h", cy, pass, r3);
        for h in 0..4 {
            $display("  hart%h: pc=%h retired=%h traps=%h", h, pc_all[h], ret_all[h], trapc_all[h]);
        }
        $assert(pass, "v4 SoC SMP(N=4) boot: did not reach SBI shutdown (hart0 x3 != 0xAA)");
        $finish();
    }
}
