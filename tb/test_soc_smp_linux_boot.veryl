// SMP Linux 5.15 boots on heliodor_soc_smp (boot_soc_harness with N_HARTS > 1)
// on the default core. Pass = hart 0 x3 reaches 0xAA (SBI SRST shutdown) with
// every hart's checker at 0.
//
// Marked #[ignore] (long run). The names are independently selectable:
//   veryl test --ignored --test test_soc_smp_linux_boot_2hart   # N=2 only
//   veryl test --ignored --test test_soc_smp_linux_boot_4hart   # N=4 only
//   veryl test --ignored --test test_soc_smp_linux_boot_8hart   # N=8 only
// (N=1 single-hart boot is the separate test_soc_linux_boot.)

#[test(test_soc_smp_linux_boot_2hart)]
#[ignore]
module test_soc_smp_linux_boot_2hart {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass   : logic    ;
    var fail   : logic    ;
    var x3     : logic<64>;
    var cycles : logic<64>;
    var instret: logic<64>;

    inst h: boot_soc_harness #(
        N_HARTS   : 2,
        FW_HEX    : "test/hex/linux_boot_fw_2hart.hex",
        DRAM_HEX  : "test/hex/linux_dram_real_2hart.hex",
        PROBE_LOG2: 20,
    ) (
        clk                 ,
        rst                 ,
        o_pass   : pass     ,
        o_fail   : fail     ,
        o_x3     : x3       ,
        o_cycles : cycles   ,
        o_instret: instret  ,
        o_last_pc: _        ,
        o_ret_cnt: _        ,
        o_traps  : _        ,
    );

    initial {
        rst.assert(clk);
        for _i in 0..10000 {
            clk.next(10000);
            if pass || fail {
                break;
            }
        }
        clk.next(10);
        $display("smp(N=2) linux boot: cycles=%d instret=%d x3=%h pass=%b fail=%b", cycles, instret, x3, pass, fail);
        $assert (pass, "smp(N=2) linux boot: checker, hart failure or no SBI shutdown");
        $finish ();
    }
}

// The 4-hart firmware waits for each HSM HART_START on mtime
// (linux_boot_fw_4hart_mt.hex) instead of an instruction-count busy delay.
#[test(test_soc_smp_linux_boot_4hart)]
#[ignore]
module test_soc_smp_linux_boot_4hart {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass   : logic    ;
    var fail   : logic    ;
    var x3     : logic<64>;
    var cycles : logic<64>;
    var instret: logic<64>;

    inst h: boot_soc_harness #(
        N_HARTS   : 4,
        FW_HEX    : "test/hex/linux_boot_fw_4hart_mt.hex",
        DRAM_HEX  : "test/hex/linux_dram_real_4hart.hex",
        PROBE_LOG2: 20,
    ) (
        clk                 ,
        rst                 ,
        o_pass   : pass     ,
        o_fail   : fail     ,
        o_x3     : x3       ,
        o_cycles : cycles   ,
        o_instret: instret  ,
        o_last_pc: _        ,
        o_ret_cnt: _        ,
        o_traps  : _        ,
    );

    initial {
        rst.assert(clk);
        for _i in 0..10000 {
            clk.next(10000);
            if pass || fail {
                break;
            }
        }
        clk.next(10);
        $display("smp(N=4) linux boot: cycles=%d instret=%d x3=%h pass=%b fail=%b", cycles, instret, x3, pass, fail);
        $assert (pass, "smp(N=4) linux boot: checker, hart failure or no SBI shutdown");
        $finish ();
    }
}

// N=8: the memory_bus generic round-robin arm (N>=5) must bring up 8 harts
// without starvation. Cross-checked on Verilator
// (sim/verilator/tb_soc_smp_linux_boot_8hart.sv).
#[test(test_soc_smp_linux_boot_8hart)]
#[ignore]
module test_soc_smp_linux_boot_8hart {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass   : logic    ;
    var fail   : logic    ;
    var x3     : logic<64>;
    var cycles : logic<64>;
    var instret: logic<64>;

    inst h: boot_soc_harness #(
        N_HARTS   : 8,
        FW_HEX    : "test/hex/linux_boot_fw_8hart.hex",
        DRAM_HEX  : "test/hex/linux_dram_real_8hart.hex",
        PROBE_LOG2: 20,
    ) (
        clk                 ,
        rst                 ,
        o_pass   : pass     ,
        o_fail   : fail     ,
        o_x3     : x3       ,
        o_cycles : cycles   ,
        o_instret: instret  ,
        o_last_pc: _        ,
        o_ret_cnt: _        ,
        o_traps  : _        ,
    );

    initial {
        rst.assert(clk);
        for _i in 0..10000 {
            clk.next(10000);
            if pass || fail {
                break;
            }
        }
        clk.next(10);
        $display("smp(N=8) linux boot: cycles=%d instret=%d x3=%h pass=%b fail=%b", cycles, instret, x3, pass, fail);
        $assert (pass, "smp(N=8) linux boot: checker, hart failure or no SBI shutdown");
        $finish ();
    }
}
