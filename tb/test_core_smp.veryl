#[test(test_w2_smp_linux_boot_2hart)]
#[ignore]
module test_w2_smp_linux_boot_2hart {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass   : logic    ;
    var fail   : logic    ;
    var x3     : logic<64>;
    var cycles : logic<64>;
    var instret: logic<64>;

    inst h: boot_soc_harness #(
        N_HARTS   : 2                                    ,
        FW_HEX    : "test/hex/linux_boot_fw_2hart.hex"   ,
        DRAM_HEX  : "test/hex/linux_dram_real_2hart.hex" ,
        CORE      : tb_core_sel::CORE_W2               ,
        PROBE_LOG2: 20                                      ,
    ) (
        clk                 ,
        rst                 ,
        o_pass   : pass     ,
        o_fail   : fail     ,
        o_x3     : x3       ,
        o_cycles : cycles   ,
        o_instret: instret  ,
        o_last_pc: _        ,
        o_ret_cnt: _        ,
        o_traps  : _        ,
    );

    initial {
        rst.assert(clk);
        for _i in 0..10000 {
            clk.next(10000);
            if pass || fail {
                break;
            }
        }
        clk.next(10);
        $display("w2 smp(N=2) linux boot: cycles=%d instret=%d x3=%h pass=%b fail=%b", cycles, instret, x3, pass, fail);
        $assert (pass, "w2 smp(N=2) linux boot: checker, hart failure or no SBI shutdown");
        $finish ();
    }
}

