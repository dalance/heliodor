// SMP gates of the new core on heliodor_soc_smp (boot_soc_harness with
// N_HARTS > 1). GB2/GB4: the 5.15 SMP Linux boot, pass = hart 0 x3 := 0xAA
// with every hart's checker at 0. GT2/GT4: the RVWMO litmus battery
// (test/litmus/litmus.S), pass = hart 0 writes tohost = 1; a forbidden
// outcome or a trap on any hart writes another value (see litmus.S for the
// encoding). The litmus image needs no ROM and runs under MAP_ARCH. The
// default suite runs the N=2 battery with fewer iterations of the ordering
// tests (litmus_n2_short.hex); the _full_ tests run the V14 image.

#[test(test_w2_litmus_2hart)]
module test_w2_litmus_2hart {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass  : logic    ;
    var fail  : logic    ;
    var cycles: logic<64>;

    inst h: boot_soc_harness #(
        N_HARTS    : 2                            ,
        DRAM_HEX   : "test/litmus/litmus_n2_short.hex",
        ROM_EN     : 1'b0                         ,
        PMA_N      : tb_platform_pkg::MAP_ARCH_N  ,
        PMA_REGIONS: tb_platform_pkg::MAP_ARCH    ,
        RESET_PC   : 64'h8000_0000                ,
        PASS_BY_X3 : 1'b0                         ,
        TOHOST_PA  : 64'h8000_1000                ,
        CORE       : tb_core_sel::CORE_W2         ,
    ) (
        clk                ,
        rst                ,
        o_pass   : pass    ,
        o_fail   : fail    ,
        o_x3     : _       ,
        o_cycles : cycles  ,
        o_instret: _       ,
        o_last_pc: _       ,
        o_ret_cnt: _       ,
        o_traps  : _       ,
    );

    initial {
        rst.assert(clk);
        for _i in 0..3000 {
            clk.next(10000);
            if pass || fail {
                break;
            }
        }
        clk.next(10);
        $display("w2 litmus(N=2): cycles=%d pass=%b fail=%b", cycles, pass, fail);
        $assert (pass, "w2 litmus(N=2): forbidden outcome, trap, checker or timeout");
        $finish ();
    }
}

