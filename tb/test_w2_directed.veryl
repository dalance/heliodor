#[test(test_w2_directed_svnapot)]
module test_w2_directed_svnapot {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var pass  : logic    ;
    var fail  : logic    ;
    var tohost: logic<32>;
    inst h: test_arch_common_harness #(
        CORE      : tb_core_sel::CORE_W2                      ,
        HEX_FILE  : "test/svnapot/svnapot_test.hex"           ,
        TOHOST_IDX: 1024                                      ,
        CK_EN     : 1                                         ,
        CK_FILE   : "test/golden/arch/directed/svnapot.ck.hex",
    ) (
        clk             ,
        rst             ,
        o_pass  : pass  ,
        o_fail  : fail  ,
        o_tohost: tohost,
    );
    initial {
        rst.assert(clk);
        for _i in 0..100 {
            clk.next(1000);
            if pass || fail {
                break;
            }
        }
        $display("w2 directed/svnapot (lockstep) tohost=%h pass=%b", tohost, pass);
        $assert(pass, "w2 directed/svnapot fail");
        $finish();
    }
}

