// No records at all: the checker must stay idle, so the harness cannot pass.
#[test(test_rvfi_adapter_chk_idle)]
module test_rvfi_adapter_chk_idle {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var ret : retire_pkg::RetireRec [2];
    var dump: logic                    ;
    var err : logic<5>                 ;
    var idle: logic                    ;
    always_comb {
        for j in 0..2 {
            ret[j] = 0 as retire_pkg::RetireRec;
        }
    }
    inst u_chk: rvfi_adapter_chk #(
        NRET: 2,
    ) (
        clk                                     ,
        rst                                     ,
        i_retire   : ret                        ,
        i_retire_dm: 1'b0                       ,
        i_irq_evt  : 0 as retire_pkg::IrqEvent,
        i_dump     : dump                       ,
        o_err      : err                        ,
        o_idle     : idle                       ,
    );
    initial {
        dump = 1'b0;
        rst.assert(clk);
        clk.next(100);
        dump = 1'b1;
        clk.next(2);
        $display("rvfi_chk idle=%b err=%b", idle, err);
        $assert(idle && err == 5'd0, "rvfi_adapter_chk: not idle without records");
        $finish();
    }
}
