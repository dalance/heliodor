// rvfi_adapter on riscv-tests images through arch_soc_harness's RVFI_CHK
// (rvfi_adapter_chk).

#[test(test_rvfi_adapter_rv64ui_add)]
module test_rvfi_adapter_rv64ui_add {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var pass  : logic    ;
    var fail  : logic    ;
    var tohost: logic<32>;
    inst h: arch_soc_harness #(
        CORE      : tb_core_sel::CORE_W2                       ,
        HEX_FILE  : "test/riscv-arch-test/build/rv64ui/add.hex",
        TOHOST_IDX: 1024                                       ,
        RVFI_CHK  : 1'b1                                       ,
    ) (
        clk             ,
        rst             ,
        o_pass  : pass  ,
        o_fail  : fail  ,
        o_tohost: tohost,
    );
    initial {
        rst.assert(clk);
        for _i in 0..300 {
            clk.next(1000);
            if pass || fail {
                break;
            }
        }
        $display("rvfi w2 rv64ui/add tohost=%h pass=%b", tohost, pass);
        $assert(pass, "rvfi w2 rv64ui/add fail");
        $finish();
    }
}

