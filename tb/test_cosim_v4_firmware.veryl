// Phase 7 v4 M9 cosim: SBI firmware-only lockstep test.
//
// Runs heliodor_top (v1, golden ref) and heliodor_core_v4 with the same
// linux_boot_fw.hex (16KB SBI firmware that ends with `mret` into the
// kernel address 0x80000000). The kernel area is zero-stubbed so after
// mret both cores enter trap loops via instruction-fetch-fault. As long
// as both cores agree on the retire PC stream cycle-by-cycle, cosim is
// green. The FIRST divergence cycle pinpoints the v4 bug.
//
// Memory map (tb-internal, replicated for v1 and v4):
//   PA 0x00000000 - 0x00003FFF : firmware ROM (16 KB)
//   PA 0x02000000 - 0x0200FFFF : CLINT MMIO (stub for v4; v1 internal)
//   PA 0x80000000 - 0x800003FF : DRAM stub (1 KB zero, kernel area)
//
// Run:
//   veryl test --ignored --test test_cosim_v4_firmware
module test_cosim_v4_firmware_harness (
    clk            : input  clock    ,
    rst            : input  reset    ,
    o_diverged     : output logic    ,
    o_compared_cnt : output logic<32>,
    o_v1_pushed_cnt: output logic<32>,
    o_v4_pushed_cnt: output logic<32>,
    o_fd_cy        : output logic<32>,
    o_fd_kind      : output logic<2> ,
    o_fd_v1pc      : output logic<64>,
    o_fd_v4pc      : output logic<64>,
) {
    var cycle: logic<32>;
    always_ff (clk, rst) {
        if_reset {
            cycle = 32'd0;
        } else {
            cycle = cycle + 32'd1;
        }
    }

    // ============================================================
    // v1 instance (heliodor_top, golden reference)
    // ============================================================
    var v1_imem_addr  : logic<64>     ;
    var v1_imem_rdata : logic<32>     ;
    var v1_imem_ren   : logic         ;
    var v1_dmem_addr  : logic<64>     ;
    var v1_dmem_wdata : logic<64>     ;
    var v1_dmem_rdata : logic<64>     ;
    var v1_dmem_wen   : logic         ;
    var v1_dmem_ren   : logic         ;
    var v1_dmem_wstrb : logic<8>      ;
    var v1_iptw_addr  : logic<64>     ;
    var v1_iptw_req   : logic         ;
    var v1_iptw_rdata : logic<64>     ;
    var v1_dbg_regs   : logic<64> [32];
    var v1_dbg_pc     : logic<64>     ;
    var v1_dbg_pass   : logic         ;
    var v1_dbg_r1     : logic<64>     ;
    var v1_dbg_r2     : logic<64>     ;
    var v1_dbg_r3     : logic<64>     ;
    var v1_ret_v_a    : logic         ;
    var v1_ret_pc_a   : logic<64>     ;
    var v1_ret_rdv_a  : logic         ;
    var v1_ret_rd_a   : logic<5>      ;
    var v1_ret_data_a : logic<64>     ;
    var v1_dbg_instret: logic         ;

    inst v1: heliodor_top #(
        RESET_PC: 64'h00000000,
    ) (
        clk                                ,
        rst                                ,
        o_imem_addr        : v1_imem_addr  ,
        i_imem_rdata       : v1_imem_rdata ,
        o_imem_ren         : v1_imem_ren   ,
        o_iptw_addr        : v1_iptw_addr  ,
        o_iptw_req         : v1_iptw_req   ,
        i_iptw_rdata       : v1_iptw_rdata ,
        i_uart_rx_data     : 8'd0          ,
        i_uart_rx_valid    : 1'b0          ,
        o_dmem_addr        : v1_dmem_addr  ,
        o_dmem_wdata       : v1_dmem_wdata ,
        i_dmem_rdata       : v1_dmem_rdata ,
        o_dmem_wen         : v1_dmem_wen   ,
        o_dmem_ren         : v1_dmem_ren   ,
        o_dmem_wstrb       : v1_dmem_wstrb ,
        o_dbg_regs         : v1_dbg_regs   ,
        o_dbg_pc           : v1_dbg_pc     ,
        o_dbg_pass         : v1_dbg_pass   ,
        o_dbg_r1           : v1_dbg_r1     ,
        o_dbg_r2           : v1_dbg_r2     ,
        o_dbg_r3           : v1_dbg_r3     ,
        i_ext_irq          : 32'd0         ,
        o_dbg_instret      : v1_dbg_instret,
        o_dbg_retire_v_a   : v1_ret_v_a    ,
        o_dbg_retire_pc_a  : v1_ret_pc_a   ,
        o_dbg_retire_rd_v_a: v1_ret_rdv_a  ,
        o_dbg_retire_rd_a  : v1_ret_rd_a   ,
        o_dbg_retire_data_a: v1_ret_data_a ,
    );

    // v1 memory: firmware ROM + DRAM stub
    var v1_fw_rom: logic<32> [4096];
    var v1_dram  : logic<32> [256] ; // 1KB kernel area (zero)
    initial {
        $readmemh("test/hex/linux_boot_fw.hex", v1_fw_rom);
        $readmemh("test/hex/zero_1k.hex", v1_dram);
    }
    let v1_imem_in_fw   : logic     = v1_imem_addr[31:14] == 18'd0;
    let v1_dmem_in_fw   : logic     = v1_dmem_addr[31:14] == 18'd0;
    let v1_dmem_in_dram : logic     = v1_dmem_addr[31];
    let v1_iptw_in_fw   : logic     = v1_iptw_addr[31:14] == 18'd0;
    let v1_iptw_in_dram : logic     = v1_iptw_addr[31];
    let v1_imem_fw_idx  : logic<12> = v1_imem_addr[13:2];
    let v1_imem_dram_idx: logic<8>  = v1_imem_addr[9:2];
    let v1_dmem_fw_lo   : logic<12> = {v1_dmem_addr[13:3], 1'b0};
    let v1_dmem_fw_hi   : logic<12> = {v1_dmem_addr[13:3], 1'b1};
    let v1_dmem_dram_lo : logic<8>  = {v1_dmem_addr[9:3], 1'b0};
    let v1_dmem_dram_hi : logic<8>  = {v1_dmem_addr[9:3], 1'b1};
    let v1_iptw_fw_lo   : logic<12> = {v1_iptw_addr[13:3], 1'b0};
    let v1_iptw_fw_hi   : logic<12> = {v1_iptw_addr[13:3], 1'b1};
    let v1_iptw_dram_lo : logic<8>  = {v1_iptw_addr[9:3], 1'b0};
    let v1_iptw_dram_hi : logic<8>  = {v1_iptw_addr[9:3], 1'b1};
    assign v1_imem_rdata = if v1_imem_in_fw ?
        v1_fw_rom[v1_imem_fw_idx]
    : if v1_imem_addr[31] ?
        v1_dram[v1_imem_dram_idx]
    :
        32'd0
    ;
    assign v1_dmem_rdata = if v1_dmem_in_fw ?
        {v1_fw_rom[v1_dmem_fw_hi], v1_fw_rom[v1_dmem_fw_lo]}
    : if v1_dmem_in_dram ?
        {v1_dram[v1_dmem_dram_hi], v1_dram[v1_dmem_dram_lo]}
    :
        64'd0
    ;
    assign v1_iptw_rdata = if v1_iptw_in_fw ?
        {v1_fw_rom[v1_iptw_fw_hi], v1_fw_rom[v1_iptw_fw_lo]}
    : if v1_iptw_in_dram ?
        {v1_dram[v1_iptw_dram_hi], v1_dram[v1_iptw_dram_lo]}
    :
        64'd0
    ;
    always_ff (clk, rst) {
        if_reset {} else if v1_dmem_wen && v1_dmem_in_dram {
            if v1_dmem_wstrb[0] {
                v1_dram[v1_dmem_dram_lo][7:0]   = v1_dmem_wdata[7:0];
            }
            if v1_dmem_wstrb[1] {
                v1_dram[v1_dmem_dram_lo][15:8]  = v1_dmem_wdata[15:8];
            }
            if v1_dmem_wstrb[2] {
                v1_dram[v1_dmem_dram_lo][23:16] = v1_dmem_wdata[23:16];
            }
            if v1_dmem_wstrb[3] {
                v1_dram[v1_dmem_dram_lo][31:24] = v1_dmem_wdata[31:24];
            }
            if v1_dmem_wstrb[4] {
                v1_dram[v1_dmem_dram_hi][7:0]   = v1_dmem_wdata[39:32];
            }
            if v1_dmem_wstrb[5] {
                v1_dram[v1_dmem_dram_hi][15:8]  = v1_dmem_wdata[47:40];
            }
            if v1_dmem_wstrb[6] {
                v1_dram[v1_dmem_dram_hi][23:16] = v1_dmem_wdata[55:48];
            }
            if v1_dmem_wstrb[7] {
                v1_dram[v1_dmem_dram_hi][31:24] = v1_dmem_wdata[63:56];
            }
        }
    }

    // ============================================================
    // v4 instance (heliodor_core_v4)
    // ============================================================
    var v4_imem_addr      : logic<64>     ;
    var v4_imem_rdata     : logic<32>     ;
    var v4_imem_ren       : logic         ;
    var v4_iptw_addr      : logic<64>     ; // M8.C: instruction-PTW bus
    var v4_iptw_rdata     : logic<64>     ;
    var v4_dmem_addr      : logic<64>     ;
    var v4_dmem_wdata     : logic<64>     ;
    var v4_dmem_rdata     : logic<64>     ;
    var v4_dmem_rdata_next: logic<64>     ;
    var v4_dmem_wen       : logic         ;
    var v4_dmem_ren       : logic         ;
    var v4_dmem_wstrb     : logic<8>      ;
    var v4_dbg_regs       : logic<64> [32];
    var v4_dbg_pc         : logic<64>     ;
    var v4_ret_v_a        : logic         ;
    var v4_ret_pc_a       : logic<64>     ;
    var v4_ret_rdv_a      : logic         ;
    var v4_ret_rd_a       : logic<5>      ;
    var v4_ret_data_a     : logic<64>     ;
    var v4_rename_cnt     : logic<32>     ;
    var v4_cdb_cnt        : logic<32>     ;
    var v4_rob_size       : logic<8>      ;
    var v4_if_v           : logic         ;
    var v4_if_instr       : logic<32>     ;
    var v4_stall_dr       : logic         ;
    var v4_hv             : logic         ;
    var v4_hrw            : logic         ;
    var v4_hil            : logic         ;
    var v4_r_alloc        : logic<32>     ;
    var v4_r_cdb          : logic<32>     ;
    var v4_r_commit       : logic<32>     ;
    var v4_r_head         : logic<6>      ;
    var v4_r_tail         : logic<6>      ;
    var _d1               : logic<64>     ;
    var v4_dbg_mepc       : logic<64>     ;
    var _d3               : logic<2>      ;
    var _d4               : logic         ;
    var _d5               : logic<64>     ;
    var _d6               : logic<64>     ;
    var _d7               : logic         ;
    var _d8               : logic<64>     ;
    var _d9               : logic<64>     ;
    var _d10              : logic<64>     ;
    var _d11              : logic         ;
    var _d12              : logic         ;
    var v4_csrwr_v        : logic         ;
    var v4_csrwr_addr     : logic<12>     ;
    var v4_csrwr_wdata    : logic<64>     ;
    var _d16              : logic         ;
    var _d17              : logic<64>     ;
    var _d18              : logic<64>     ;
    var _d19              : logic         ;
    var _d20              : logic<64>     ;
    var _d21              : logic<64>     ;
    var v4_alu_pc         : logic<64>     ;
    var v4_alu_src_a      : logic<64>     ;
    var v4_alu_src_b      : logic<64>     ;
    var v4_alu_use_pc_a   : logic         ;
    var v4_alu_rs1_data   : logic<64>     ;
    var v4_alu_valid      : logic         ;
    var v4_alu_alu_out    : logic<64>     ;
    var v4_alu_instr      : logic<32>     ;
    var v4_alu_imm        : logic<64>     ;
    var v4_stval          : logic<64>     ;
    var v4_mtval          : logic<64>     ;

    inst v4: heliodor_core_v4 #(
        RESET_PC: 64'h00000000,
    ) (
        clk                                       ,
        rst                                       ,
        o_imem_addr           : v4_imem_addr      ,
        i_imem_rdata          : v4_imem_rdata     ,
        o_imem_ren            : v4_imem_ren       ,
        o_iptw_addr           : v4_iptw_addr      ,
        o_iptw_req            : _                 ,
        i_iptw_rdata          : v4_iptw_rdata     ,
        o_dmem_addr           : v4_dmem_addr      ,
        o_dmem_wdata          : v4_dmem_wdata     ,
        i_dmem_rdata          : v4_dmem_rdata     ,
        i_dmem_rdata_next     : v4_dmem_rdata_next,
        o_dmem_wen            : v4_dmem_wen       ,
        o_dmem_ren            : v4_dmem_ren       ,
        o_dmem_wstrb          : v4_dmem_wstrb     ,
        o_dmem_wdata_hi       : _                 ,
        o_dmem_wstrb_hi       : _                 ,
        o_dmem_req            : _    ,
        i_dmem_grant          : 1'b1 ,
        i_dcache_inv_valid    : 1'b0 ,
        i_dcache_inv_addr     : 64'd0,
        o_amo_inflight        : _    ,
        i_irq_timer_m         : 1'b0              ,
        i_irq_sw_m            : 1'b0              ,
        i_irq_ext_m           : 1'b0              ,
        i_mtime               : 64'd0             ,
        o_dbg_pc              : v4_dbg_pc         ,
        o_dbg_regs            : v4_dbg_regs       ,
        o_dbg_retire_v_a      : v4_ret_v_a        ,
        o_dbg_retire_pc_a     : v4_ret_pc_a       ,
        o_dbg_retire_rd_v_a   : v4_ret_rdv_a      ,
        o_dbg_retire_rd_a     : v4_ret_rd_a       ,
        o_dbg_retire_data_a   : v4_ret_data_a     ,
        o_dbg_rename_cnt      : v4_rename_cnt     ,
        o_dbg_cdb_cnt         : v4_cdb_cnt        ,
        o_dbg_rob_size        : v4_rob_size       ,
        o_dbg_if_v            : v4_if_v           ,
        o_dbg_if_instr        : v4_if_instr       ,
        o_dbg_stall_dr        : v4_stall_dr       ,
        o_dbg_head_valid      : v4_hv             ,
        o_dbg_head_rw         : v4_hrw            ,
        o_dbg_head_illegal    : v4_hil            ,
        o_dbg_rob_alloc_cnt   : v4_r_alloc        ,
        o_dbg_rob_cdb_cnt     : v4_r_cdb          ,
        o_dbg_rob_commit_cnt  : v4_r_commit       ,
        o_dbg_rob_head        : v4_r_head         ,
        o_dbg_rob_tail        : v4_r_tail         ,
        o_dbg_sepc            : _d1               ,
        o_dbg_mepc            : v4_dbg_mepc       ,
        o_dbg_priv            : _d3               ,
        o_dbg_trap_fire       : _d4               ,
        o_dbg_trap_pc         : _d5               ,
        o_dbg_trap_cause      : _d6               ,
        o_dbg_trap_to_s       : _d7               ,
        o_dbg_satp            : _d8               ,
        o_dbg_imem_vaddr      : _d9               ,
        o_dbg_imem_paddr      : _d10              ,
        o_dbg_imem_valid      : _d11              ,
        o_dbg_imem_fault      : _d12              ,
        o_dbg_csrwr_v         : v4_csrwr_v        ,
        o_dbg_csrwr_addr      : v4_csrwr_addr     ,
        o_dbg_csrwr_wdata     : v4_csrwr_wdata    ,
        o_dbg_ptw_req         : _d16              ,
        o_dbg_ptw_addr        : _d17              ,
        o_dbg_ptw_data        : _d18              ,
        o_dbg_redirect_fire   : _d19              ,
        o_dbg_redirect_pc     : _d20              ,
        o_dbg_redirect_src_pc : _d21              ,
        o_dbg_alu_pc_out      : v4_alu_pc         ,
        o_dbg_alu_src_a_out   : v4_alu_src_a      ,
        o_dbg_alu_src_b_out   : v4_alu_src_b      ,
        o_dbg_alu_use_pc_a_out: v4_alu_use_pc_a   ,
        o_dbg_alu_rs1_data_out: v4_alu_rs1_data   ,
        o_dbg_alu_valid_out   : v4_alu_valid      ,
        o_dbg_alu_alu_out_out : v4_alu_alu_out    ,
        o_dbg_alu_instr_out   : v4_alu_instr      ,
        o_dbg_alu_imm_out     : v4_alu_imm        ,
        o_dbg_stval_out       : v4_stval          ,
        o_dbg_mtval_out       : v4_mtval          ,
    );

    // v4 memory: firmware ROM + DRAM stub
    var v4_fw_rom: logic<32> [4096];
    var v4_dram  : logic<32> [256] ;
    initial {
        $readmemh("test/hex/linux_boot_fw.hex", v4_fw_rom);
        $readmemh("test/hex/zero_1k.hex", v4_dram);
    }
    let v4_imem_in_fw   : logic     = v4_imem_addr[31:14] == 18'd0;
    let v4_dmem_in_fw   : logic     = v4_dmem_addr[31:14] == 18'd0;
    let v4_dmem_in_dram : logic     = v4_dmem_addr[31];
    let v4_imem_fw_idx  : logic<12> = v4_imem_addr[13:2];
    let v4_imem_dram_idx: logic<8>  = v4_imem_addr[9:2];
    let v4_dmem_fw_lo   : logic<12> = {v4_dmem_addr[13:3], 1'b0};
    let v4_dmem_fw_hi   : logic<12> = {v4_dmem_addr[13:3], 1'b1};
    let v4_dmem_dram_lo : logic<8>  = {v4_dmem_addr[9:3], 1'b0};
    let v4_dmem_dram_hi : logic<8>  = {v4_dmem_addr[9:3], 1'b1};
    assign v4_imem_rdata      = if v4_imem_in_fw ?
        v4_fw_rom[v4_imem_fw_idx]
    : if v4_imem_addr[31] ?
        v4_dram[v4_imem_dram_idx]
    :
        32'd0
    ;
    assign v4_dmem_rdata      = if v4_dmem_in_fw ?
        {v4_fw_rom[v4_dmem_fw_hi], v4_fw_rom[v4_dmem_fw_lo]}
    : if v4_dmem_in_dram ?
        {v4_dram[v4_dmem_dram_hi], v4_dram[v4_dmem_dram_lo]}
    :
        64'd0
    ;
    assign v4_dmem_rdata_next = 64'd0;
    // M8.C: instruction-PTW PTE read (mirrors v1_iptw on v4_fw_rom / v4_dram).
    let v4_iptw_in_fw  : logic     = v4_iptw_addr[31:14] == 18'd0;
    let v4_iptw_in_dram: logic     = v4_iptw_addr[31];
    let v4_iptw_fw_lo  : logic<12> = {v4_iptw_addr[13:3], 1'b0};
    let v4_iptw_fw_hi  : logic<12> = {v4_iptw_addr[13:3], 1'b1};
    let v4_iptw_dram_lo: logic<8>  = {v4_iptw_addr[9:3], 1'b0};
    let v4_iptw_dram_hi: logic<8>  = {v4_iptw_addr[9:3], 1'b1};
    assign v4_iptw_rdata = if v4_iptw_in_fw ?
        {v4_fw_rom[v4_iptw_fw_hi], v4_fw_rom[v4_iptw_fw_lo]}
    : if v4_iptw_in_dram ?
        {v4_dram[v4_iptw_dram_hi], v4_dram[v4_iptw_dram_lo]}
    :
        64'd0
    ;
    always_ff (clk, rst) {
        if_reset {} else if v4_dmem_wen && v4_dmem_in_dram {
            if v4_dmem_wstrb[0] {
                v4_dram[v4_dmem_dram_lo][7:0]   = v4_dmem_wdata[7:0];
            }
            if v4_dmem_wstrb[1] {
                v4_dram[v4_dmem_dram_lo][15:8]  = v4_dmem_wdata[15:8];
            }
            if v4_dmem_wstrb[2] {
                v4_dram[v4_dmem_dram_lo][23:16] = v4_dmem_wdata[23:16];
            }
            if v4_dmem_wstrb[3] {
                v4_dram[v4_dmem_dram_lo][31:24] = v4_dmem_wdata[31:24];
            }
            if v4_dmem_wstrb[4] {
                v4_dram[v4_dmem_dram_hi][7:0]   = v4_dmem_wdata[39:32];
            }
            if v4_dmem_wstrb[5] {
                v4_dram[v4_dmem_dram_hi][15:8]  = v4_dmem_wdata[47:40];
            }
            if v4_dmem_wstrb[6] {
                v4_dram[v4_dmem_dram_hi][23:16] = v4_dmem_wdata[55:48];
            }
            if v4_dmem_wstrb[7] {
                v4_dram[v4_dmem_dram_hi][31:24] = v4_dmem_wdata[63:56];
            }
        }
    }

    // ============================================================
    // Cosim checker
    // ============================================================
    var diverged_w     : logic    ;
    var compared_cnt_w : logic<32>;
    var v1_pushed_cnt_w: logic<32>;
    var v4_pushed_cnt_w: logic<32>;
    var fd_cy_w        : logic<32>;
    var fd_kind_w      : logic<2> ;
    var fd_v1pc_w      : logic<64>;
    var fd_v4pc_w      : logic<64>;

    let v1_ret_v_filt: logic = v1_ret_v_a && (v1_ret_pc_a != 64'd0);
    let v4_ret_v_filt: logic = v4_ret_v_a && (v4_ret_pc_a != 64'd0);

    inst u_check: cosim_checker (
        clk                                  ,
        rst                                  ,
        i_cycle             : cycle          ,
        i_v1_push           : v1_ret_v_filt  ,
        i_v1_pc             : v1_ret_pc_a    ,
        i_v1_rd_v           : v1_ret_rdv_a   ,
        i_v1_rd             : v1_ret_rd_a    ,
        i_v1_data           : v1_ret_data_a  ,
        i_v4_push           : v4_ret_v_filt  ,
        i_v4_pc             : v4_ret_pc_a    ,
        i_v4_rd_v           : v4_ret_rdv_a   ,
        i_v4_rd             : v4_ret_rd_a    ,
        i_v4_data           : v4_ret_data_a  ,
        o_diverged          : diverged_w     ,
        o_compared_cnt      : compared_cnt_w ,
        o_v1_pushed_cnt     : v1_pushed_cnt_w,
        o_v4_pushed_cnt     : v4_pushed_cnt_w,
        o_first_diverge_cy  : fd_cy_w        ,
        o_first_diverge_kind: fd_kind_w      ,
        o_first_diverge_v1pc: fd_v1pc_w      ,
        o_first_diverge_v4pc: fd_v4pc_w      ,
    );

    assign o_diverged      = diverged_w;
    assign o_compared_cnt  = compared_cnt_w;
    assign o_v1_pushed_cnt = v1_pushed_cnt_w;
    assign o_v4_pushed_cnt = v4_pushed_cnt_w;
    assign o_fd_cy         = fd_cy_w;
    assign o_fd_kind       = fd_kind_w;
    assign o_fd_v1pc       = fd_v1pc_w;
    assign o_fd_v4pc       = fd_v4pc_w;

    // ============================================================
    // Per-side retire PC rings (16 entry each) — frozen 4 cycles
    // after first divergence so we can see the v1 and v4 paths
    // diverging side-by-side.
    // ============================================================
    var ring_freeze    : logic         ;
    var ring_freeze_dly: logic<3>      ;
    var v1_ring_idx    : logic<6>      ;
    var v1_ring_pcs    : logic<64> [64];
    var v1_ring_cys    : logic<32> [64];
    var v4_ring_idx    : logic<6>      ;
    var v4_ring_pcs    : logic<64> [64];
    var v4_ring_cys    : logic<32> [64];
    always_ff (clk, rst) {
        if_reset {
            ring_freeze     = 1'b0;
            ring_freeze_dly = 3'd0;
            v1_ring_idx     = 6'd0;
            v4_ring_idx     = 6'd0;
            for i in 0..64 {
                v1_ring_pcs[i] = 64'd0;
                v1_ring_cys[i] = 32'd0;
                v4_ring_pcs[i] = 64'd0;
                v4_ring_cys[i] = 32'd0;
            }
        } else {
            if v1_ret_v_filt && !ring_freeze && v1_ring_idx != 6'd63 {
                v1_ring_pcs[v1_ring_idx] = v1_ret_pc_a;
                v1_ring_cys[v1_ring_idx] = cycle;
                v1_ring_idx              = v1_ring_idx + 6'd1;
            }
            if v4_ret_v_filt && !ring_freeze && v4_ring_idx != 6'd63 {
                v4_ring_pcs[v4_ring_idx] = v4_ret_pc_a;
                v4_ring_cys[v4_ring_idx] = cycle;
                v4_ring_idx              = v4_ring_idx + 6'd1;
            }
            if diverged_w && !ring_freeze {
                if ring_freeze_dly == 3'd4 {
                    ring_freeze = 1'b1;
                } else {
                    ring_freeze_dly = ring_freeze_dly + 3'd1;
                }
            }
        }
    }
    // Direct ROM read snapshot: read v1_fw_rom[4] and v4_fw_rom[4]
    // (= bytes at PA 0x10, should be 0x0a828293 = ADDI t0,t0,168).
    var rom_check_v1: logic<32>;
    var rom_check_v4: logic<32>;
    assign rom_check_v1 = v1_fw_rom[12'd4];
    assign rom_check_v4 = v4_fw_rom[12'd4];
    always_ff (clk, rst) {
        if_reset {} else if cycle == 32'd10 {
            $display("[v1_fw_rom[4]] = %h  (expected 0a828293)", rom_check_v1);
            $display("[v4_fw_rom[4]] = %h  (expected 0a828293)", rom_check_v4);
        }
    }

    // v4 imem rdata trace: capture (cycle, imem_addr, imem_rdata) for
    // first 16 fetches. Pinpoints whether wrong bytes come from memory
    // or are corrupted later in the pipeline.
    var v4_im_idx   : logic<5>      ;
    var v4_im_cys   : logic<32> [16];
    var v4_im_addrs : logic<64> [16];
    var v4_im_rdatas: logic<32> [16];
    var v4_im_freeze: logic         ;
    always_ff (clk, rst) {
        if_reset {
            v4_im_idx    = 5'd0;
            v4_im_freeze = 1'b0;
            for i in 0..16 {
                v4_im_cys[i]    = 32'd0;
                v4_im_addrs[i]  = 64'd0;
                v4_im_rdatas[i] = 32'd0;
            }
        } else {
            if v4_imem_ren && !v4_im_freeze && v4_im_idx != 5'd15 {
                v4_im_cys[v4_im_idx]    = cycle;
                v4_im_addrs[v4_im_idx]  = v4_imem_addr;
                v4_im_rdatas[v4_im_idx] = v4_imem_rdata;
                v4_im_idx               = v4_im_idx + 5'd1;
            }
            if diverged_w && !v4_im_freeze {
                v4_im_freeze = 1'b1;
            }
        }
    }
    always_ff (clk, rst) {
        if_reset {} else if v4_im_freeze && cycle[5:0] == 6'd0 {
            $display("[v4 imem rdata trace]");
            for i in 0..16 {
                if v4_im_cys[i] != 32'd0 {
                    $display("  im[%h] cy=%h addr=%h rdata=%h", i, v4_im_cys[i], v4_im_addrs[i], v4_im_rdatas[i]);
                }
            }
        }
    }

    // ALU fire trace (= every valid issue): capture base_pc, src_a,
    // rs1_data, alu_out per op so we can see the full data chain.
    var v4_alu_idx   : logic<5>      ;
    var v4_alu_cys   : logic<32> [16];
    var v4_alu_pcs   : logic<64> [16];
    var v4_alu_src_as: logic<64> [16];
    var v4_alu_src_bs: logic<64> [16];
    var v4_alu_rs1s  : logic<64> [16];
    var v4_alu_outs  : logic<64> [16];
    var v4_alu_instrs: logic<32> [16];
    var v4_alu_imms  : logic<64> [16];
    var v4_alu_freeze: logic         ;
    always_ff (clk, rst) {
        if_reset {
            v4_alu_idx    = 5'd0;
            v4_alu_freeze = 1'b0;
            for i in 0..16 {
                v4_alu_cys[i]    = 32'd0;
                v4_alu_pcs[i]    = 64'd0;
                v4_alu_src_as[i] = 64'd0;
                v4_alu_src_bs[i] = 64'd0;
                v4_alu_rs1s[i]   = 64'd0;
                v4_alu_outs[i]   = 64'd0;
                v4_alu_instrs[i] = 32'd0;
                v4_alu_imms[i]   = 64'd0;
            }
        } else {
            if v4_alu_valid && !v4_alu_freeze && v4_alu_idx != 5'd15 {
                v4_alu_cys[v4_alu_idx]    = cycle;
                v4_alu_pcs[v4_alu_idx]    = v4_alu_pc;
                v4_alu_src_as[v4_alu_idx] = v4_alu_src_a;
                v4_alu_src_bs[v4_alu_idx] = v4_alu_src_b;
                v4_alu_rs1s[v4_alu_idx]   = v4_alu_rs1_data;
                v4_alu_outs[v4_alu_idx]   = v4_alu_alu_out;
                v4_alu_instrs[v4_alu_idx] = v4_alu_instr;
                v4_alu_imms[v4_alu_idx]   = v4_alu_imm;
                v4_alu_idx                = v4_alu_idx + 5'd1;
            }
            if diverged_w && !v4_alu_freeze {
                v4_alu_freeze = 1'b1;
            }
        }
    }
    always_ff (clk, rst) {
        if_reset {} else if v4_alu_freeze && cycle[5:0] == 6'd0 {
            $display("[v4 alu fire trace]");
            for i in 0..16 {
                if v4_alu_cys[i] != 32'd0 {
                    $display(
                        "  alu[%h] cy=%h pc=%h instr=%h imm=%h src_a=%h src_b=%h rs1=%h alu_out=%h",
                        i,
                        v4_alu_cys[i],
                        v4_alu_pcs[i],
                        v4_alu_instrs[i],
                        v4_alu_imms[i],
                        v4_alu_src_as[i],
                        v4_alu_src_bs[i],
                        v4_alu_rs1s[i],
                        v4_alu_outs[i],
                    );
                }
            }
        }
    }

    // v4 CSR write ring (= every CSR write seen, frozen with rings)
    var v4_csrw_idx        : logic<5>      ;
    var v4_csrw_cys        : logic<32> [16];
    var v4_csrw_pcs        : logic<64> [16];
    var v4_csrw_addr_log   : logic<12> [16];
    var v4_csrw_data       : logic<64> [16];
    var v4_mepc_at_mret_cy : logic<32>     ;
    var v4_mepc_at_mret_val: logic<64>     ;
    var v4_mret_seen       : logic         ;
    var v4_c_is_mret_w     : logic         ; // 1 cy delayed reflecting commit-time mret
    always_ff (clk, rst) {
        if_reset {
            v4_csrw_idx = 5'd0;
            for i in 0..16 {
                v4_csrw_cys[i]      = 32'd0;
                v4_csrw_pcs[i]      = 64'd0;
                v4_csrw_addr_log[i] = 12'd0;
                v4_csrw_data[i]     = 64'd0;
            }
            v4_mepc_at_mret_cy  = 32'd0;
            v4_mepc_at_mret_val = 64'd0;
            v4_mret_seen        = 1'b0;
        } else {
            if v4_csrwr_v && !ring_freeze && v4_csrw_idx != 5'd15 {
                v4_csrw_cys[v4_csrw_idx]      = cycle;
                v4_csrw_pcs[v4_csrw_idx]      = v4_dbg_pc;
                v4_csrw_addr_log[v4_csrw_idx] = v4_csrwr_addr;
                v4_csrw_data[v4_csrw_idx]     = v4_csrwr_wdata;
                v4_csrw_idx                   = v4_csrw_idx + 5'd1;
            }
            // Capture mepc at the cycle after mret retire (= when redirect fires)
            if v4_ret_v_filt && v4_ret_pc_a == 64'h00000000_000000b0 && !v4_mret_seen {
                v4_mepc_at_mret_cy  = cycle;
                v4_mepc_at_mret_val = v4_dbg_mepc;
                v4_mret_seen        = 1'b1;
            }
        }
    }
    // Display ring on every cycle once frozen (tb sees it through outputs)
    always_ff (clk, rst) {
        if_reset {} else if ring_freeze && cycle[5:0] == 6'd0 {
            $display("[v4 csrw trace]");
            for i in 0..16 {
                if v4_csrw_cys[i] != 32'd0 {
                    $display(
                        "  csrw[%h] cy=%h pc=%h addr=%h data=%h",
                        i,
                        v4_csrw_cys[i],
                        v4_csrw_pcs[i],
                        v4_csrw_addr_log[i],
                        v4_csrw_data[i],
                    );
                }
            }
            $display("[v4 mepc at mret] cy=%h val=%h", v4_mepc_at_mret_cy, v4_mepc_at_mret_val);
            $display("[cosim ring dump @cy=%h diverged@cy=%h]", cycle, fd_cy_w);
            for i in 0..64 {
                if v1_ring_cys[i] != 32'd0 {
                    $display("  v1[%h] cy=%h pc=%h", i, v1_ring_cys[i], v1_ring_pcs[i]);
                }
            }
            for i in 0..64 {
                if v4_ring_cys[i] != 32'd0 {
                    $display("  v4[%h] cy=%h pc=%h", i, v4_ring_cys[i], v4_ring_pcs[i]);
                }
            }
        }
    }
}

#[test(test_cosim_v4_firmware)]
#[ignore]
module test_cosim_v4_firmware {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var diverged : logic    ;
    var compared : logic<32>;
    var v1_pushed: logic<32>;
    var v4_pushed: logic<32>;
    var fd_cy    : logic<32>;
    var fd_kind  : logic<2> ;
    var fd_v1pc  : logic<64>;
    var fd_v4pc  : logic<64>;

    inst h: test_cosim_v4_firmware_harness (
        clk                       ,
        rst                       ,
        o_diverged     : diverged ,
        o_compared_cnt : compared ,
        o_v1_pushed_cnt: v1_pushed,
        o_v4_pushed_cnt: v4_pushed,
        o_fd_cy        : fd_cy    ,
        o_fd_kind      : fd_kind  ,
        o_fd_v1pc      : fd_v1pc  ,
        o_fd_v4pc      : fd_v4pc  ,
    );

    initial {
        rst.assert(clk);
        clk.next  (100_000);
        $display  (
            "[test_cosim_v4_firmware] diverged=%b compared=%d v1_pushed=%d v4_pushed=%d fd_cy=%d kind=%d v1pc=%h v4pc=%h",
            diverged,
            compared,
            v1_pushed,
            v4_pushed,
            fd_cy,
            fd_kind,
            fd_v1pc,
            fd_v4pc,
        );
        $finish   ();
    }
}
