// lane_queue: group handshake, partial take and flush against a sequence
// scoreboard. The producer offers groups of consecutive sequence numbers and
// holds each group until it is accepted or flushed; every accepted number must
// come out exactly once and in order, and a flush drops everything accepted
// so far plus the group offered in the flush cycle.
package lane_queue_tb_pkg {
    struct Item {
        seq : logic<16>,
        lane: logic<3> ,
    }
}

module lane_queue_harness #(
    param W_IN : u32 = 2,
    param W_OUT: u32 = 2,
    param DEPTH: u32 = 4,
) (
    clk   : input  clock   ,
    rst   : input  reset   ,
    o_pass: output logic   ,
    o_done: output logic   ,
    o_cov : output logic<5>,
) {
    import lane_queue_tb_pkg::*;

    const TK_W: u32 = tag_pkg::idx_w(W_OUT + 1);
    const GN_W: u32 = tag_pkg::idx_w(W_IN + 1);

    var lfsr  : logic<64>  ;
    var cnt   : logic<16>  ;
    var ok    : logic      ;
    var cov_q : logic<5>   ;
    var pseq_q: logic<16>  ;
    var pn_q  : logic<GN_W>;
    var exp_q : logic<16>  ;

    var iv  : logic       [W_IN] ;
    var id  : Item        [W_IN] ;
    var rdy : logic              ;
    var ov  : logic       [W_OUT];
    var od  : Item        [W_OUT];
    var take: logic<TK_W>        ;

    always_comb {
        for l in 0..W_IN {
            iv[l]      = l <: pn_q;
            id[l].seq  = pseq_q + l;
            id[l].lane = l;
        }
    }

    // Rare flushes; slow phases with no take let the queue fill up.
    let flush: logic = lfsr[20:15] == 0;
    let slow : logic = lfsr[45:43] == 0;

    inst dut: lane_queue #(
        T    : Item,
        W_IN       ,
        W_OUT      ,
        DEPTH      ,
    ) (
        clk           ,
        rst           ,
        i_valid: iv   ,
        i_data : id   ,
        o_ready: rdy  ,
        o_valid: ov   ,
        o_data : od   ,
        i_take : take ,
        i_flush: flush,
    );

    let occ: logic<16> = pseq_q - exp_q;

    var nvalid: logic<TK_W>;
    var bad   : logic      ;
    always_comb {
        nvalid = 0;
        bad    = 1'b0;
        for l in 0..W_OUT {
            nvalid += ov[l];
            if ov[l] && od[l].seq != exp_q + l {
                bad = 1'b1;
            }
        }
        for l in 1..W_OUT {
            if ov[l] && !ov[l - 1] {
                bad = 1'b1;
            }
        }
        if nvalid != (if occ >: W_OUT ? W_OUT : occ) {
            bad = 1'b1;
        }
        if rdy != (occ + W_IN <= DEPTH) {
            bad = 1'b1;
        }
    }

    assign take = if slow ? 0 : (lfsr[7:0] % (nvalid + 1)) as TK_W;

    let fire  : logic       = rdy && iv[0];
    let new_pn: logic<GN_W> = (lfsr[31:24] % (W_IN + 1)) as GN_W;

    always_ff {
        if_reset {
            lfsr   = 64'h0123_4567_89ab_cdef;
            cnt    = 0;
            ok     = 1'b1;
            cov_q  = 0;
            pseq_q = 0;
            pn_q   = 0;
            exp_q  = 0;
        } else {
            if bad {
                ok = 1'b0;
            }
            if !rdy {
                cov_q[0] = 1'b1;
            }
            if take != 0 && take <: nvalid && !flush {
                cov_q[1] = 1'b1;
            }
            if flush && fire {
                cov_q[2] = 1'b1;
            }
            if flush && occ != 0 {
                cov_q[3] = 1'b1;
            }
            if take == W_OUT && !flush {
                cov_q[4] = 1'b1;
            }
            if flush {
                pseq_q = pseq_q + pn_q;
                exp_q  = pseq_q + pn_q;
                pn_q   = new_pn;
            } else {
                if fire {
                    pseq_q = pseq_q + pn_q;
                }
                if fire || pn_q == 0 {
                    pn_q = new_pn;
                }
                exp_q = exp_q + take;
            }
            var t   : logic<64>;
            t    = lfsr ^ (lfsr << 13);
            t    = t ^ (t >> 7);
            t    = t ^ (t << 17);
            lfsr = t;
            cnt  = cnt + 1;
        }
    }

    assign o_pass = ok;
    assign o_done = cnt >= 16'd3000;
    assign o_cov  = cov_q;
}

#[test(test_lane_queue)]
module test_lane_queue {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass: logic    [6];
    var done: logic    [6];
    var cov : logic<5> [6];
    inst h0: lane_queue_harness #(
        W_IN : 2,
        W_OUT: 2,
        DEPTH: 4,
    ) (
        clk            ,
        rst            ,
        o_pass: pass[0],
        o_done: done[0],
        o_cov : cov[0] ,
    );
    inst h1: lane_queue_harness #(
        W_IN : 4,
        W_OUT: 2,
        DEPTH: 8,
    ) (
        clk            ,
        rst            ,
        o_pass: pass[1],
        o_done: done[1],
        o_cov : cov[1] ,
    );
    inst h2: lane_queue_harness #(
        W_IN : 2,
        W_OUT: 4,
        DEPTH: 6,
    ) (
        clk            ,
        rst            ,
        o_pass: pass[2],
        o_done: done[2],
        o_cov : cov[2] ,
    );
    inst h3: lane_queue_harness #(
        W_IN : 3,
        W_OUT: 3,
        DEPTH: 5,
    ) (
        clk            ,
        rst            ,
        o_pass: pass[3],
        o_done: done[3],
        o_cov : cov[3] ,
    );
    inst h4: lane_queue_harness #(
        W_IN : 1,
        W_OUT: 1,
        DEPTH: 1,
    ) (
        clk            ,
        rst            ,
        o_pass: pass[4],
        o_done: done[4],
        o_cov : cov[4] ,
    );
    inst h5: lane_queue_harness #(
        W_IN : 4 ,
        W_OUT: 4 ,
        DEPTH: 16,
    ) (
        clk            ,
        rst            ,
        o_pass: pass[5],
        o_done: done[5],
        o_cov : cov[5] ,
    );

    initial {
        rst.assert(clk);
        clk.next(3100);
        $display(
            "lane_queue: pass %b%b%b%b%b%b cov %b %b %b %b %b %b",
            pass[0],
            pass[1],
            pass[2],
            pass[3],
            pass[4],
            pass[5],
            cov[0],
            cov[1],
            cov[2],
            cov[3],
            cov[4],
            cov[5],
        );
        $assert(done[0], "lane_queue test did not run enough cycles");
        $assert(
            pass[0] && pass[1] && pass[2] && pass[3] && pass[4] && pass[5],
            "lane_queue diverged from the scoreboard",
        );
        // Partial take needs W_OUT > 1 (h4 has a single output lane).
        $assert(
            cov[0] == 5'b11111 && cov[1] == 5'b11111 && cov[2] == 5'b11111 && cov[3] == 5'b11111 && cov[4] == 5'b11101
                && cov[5] == 5'b11111,
            "lane_queue scenario not covered",
        );
        $finish();
    }
}
