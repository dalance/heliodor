// Repro for v4 corruption: struct array (= IQ entries) with full
// DecodedOp + alloc/issue index pattern. Write into ops[alloc_idx],
// read from ops[issue_idx], verify instr.bit[22] stays 0.
module test_sim_struct_arr_harness (
    clk        : input  clock     ,
    rst        : input  reset     ,
    o_read_a   : output logic<32> ,
    o_read_imm : output logic<64> ,
    o_correct  : output logic     ,
) {
    import pipeline_v4_pkg::*;
    var ops      : DecodedOp [8];
    var alloc_idx: logic<3>;
    var issue_idx: logic<3>;
    var op_in    : DecodedOp;
    var op_out   : DecodedOp;
    var cy       : logic<32>;

    // Producer: build op_in (= ADDI t0, t0, 168, imm=0xa8)
    always_comb {
        op_in.valid     = 1'b1;
        op_in.pc        = 64'h0000000000000010;
        op_in.instr     = 32'h0a828293;
        op_in.fu_kind   = FuKind::ALU;
        op_in.alu_op    = alu_pkg::AluOp::ADD;
        op_in.rd_arch   = 5'd5;
        op_in.rs1_arch  = 5'd5;
        op_in.rs2_arch  = 5'd0;
        op_in.has_rd    = 1'b1;
        op_in.has_rs1   = 1'b1;
        op_in.has_rs2   = 1'b0;
        op_in.imm       = 64'h00000000000000a8;
        op_in.use_imm_b = 1'b1;
        op_in.use_pc_a  = 1'b0;
        op_in.use_zero_a= 1'b0;
        op_in.is_branch = 1'b0;
        op_in.is_jal    = 1'b0;
        op_in.is_jalr   = 1'b0;
        op_in.br_cond   = BrCond::NONE;
        op_in.wb_pc4    = 1'b0;
        op_in.is_load   = 1'b0;
        op_in.is_store  = 1'b0;
        op_in.mem_funct3= 3'd0;
        op_in.is_csr    = 1'b0;
        op_in.csr_op    = csr_pkg::CsrOp::RW;
        op_in.csr_imm   = 1'b0;
        op_in.csr_addr  = 12'd0;
        op_in.is_ecall  = 1'b0;
        op_in.is_ebreak = 1'b0;
        op_in.is_mret   = 1'b0;
        op_in.is_sret   = 1'b0;
        op_in.is_sfence = 1'b0;
        op_in.is_amo    = 1'b0;
        op_in.amo_funct5= 5'd0;
        op_in.amo_is_w  = 1'b0;
        op_in.is_rvc    = 1'b0;
        op_in.illegal   = 1'b0;
    }

    always_ff (clk, rst) {
        if_reset {
            alloc_idx = 3'd0;
            issue_idx = 3'd0;
            cy        = 32'd0;
            for i in 0..8 {
                ops[i].valid     = 1'b0;
                ops[i].pc        = 64'd0;
                ops[i].instr     = 32'd0;
                ops[i].fu_kind   = FuKind::ALU;
                ops[i].alu_op    = alu_pkg::AluOp::ADD;
                ops[i].rd_arch   = 5'd0;
                ops[i].rs1_arch  = 5'd0;
                ops[i].rs2_arch  = 5'd0;
                ops[i].has_rd    = 1'b0;
                ops[i].has_rs1   = 1'b0;
                ops[i].has_rs2   = 1'b0;
                ops[i].imm       = 64'd0;
                ops[i].use_imm_b = 1'b0;
                ops[i].use_pc_a  = 1'b0;
                ops[i].use_zero_a= 1'b0;
                ops[i].is_branch = 1'b0;
                ops[i].is_jal    = 1'b0;
                ops[i].is_jalr   = 1'b0;
                ops[i].br_cond   = BrCond::NONE;
                ops[i].wb_pc4    = 1'b0;
                ops[i].is_load   = 1'b0;
                ops[i].is_store  = 1'b0;
                ops[i].mem_funct3= 3'd0;
                ops[i].is_csr    = 1'b0;
                ops[i].csr_op    = csr_pkg::CsrOp::RW;
                ops[i].csr_imm   = 1'b0;
                ops[i].csr_addr  = 12'd0;
                ops[i].is_ecall  = 1'b0;
                ops[i].is_ebreak = 1'b0;
                ops[i].is_mret   = 1'b0;
                ops[i].is_sret   = 1'b0;
                ops[i].is_sfence = 1'b0;
                ops[i].is_amo    = 1'b0;
                ops[i].amo_funct5= 5'd0;
                ops[i].amo_is_w  = 1'b0;
                ops[i].is_rvc    = 1'b0;
                ops[i].illegal   = 1'b0;
            }
        } else {
            cy = cy + 32'd1;
            // cy=1: alloc ops[0] with op_in
            // cy=3: issue ops[0]
            if cy == 32'd0 {
                ops[alloc_idx] = op_in;
                alloc_idx = alloc_idx + 3'd1;
            }
        }
    }
    assign op_out = ops[issue_idx];
    assign o_read_a   = op_out.instr;
    assign o_read_imm = op_out.imm;
    assign o_correct  = op_out.instr == 32'h0a828293;
}

#[test(test_sim_struct_arr)]
#[ignore]
module test_sim_struct_arr {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen(clk);
    var a   : logic<32>;
    var i   : logic<64>;
    var ok  : logic;
    inst h: test_sim_struct_arr_harness (
        clk                       ,
        rst                       ,
        o_read_a    : a           ,
        o_read_imm  : i           ,
        o_correct   : ok          ,
    );
    initial {
        rst.assert(clk);
        clk.next(5);
        $display("[test_sim_struct_arr] instr=%h imm=%h ok=%b (expected: instr=0x0a828293 ok=1)",
                  a, i, ok);
        $assert(ok, "struct array field corruption");
        $finish();
    }
}
