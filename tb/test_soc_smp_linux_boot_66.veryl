// Linux 6.6 RVA23 SMP boot (N=2 / N=4) on heliodor_soc_smp, default core:
// one SMP kernel Image (CONFIG_SMP, NR_CPUS=8) + the RVA23 firmware (menvcfg
// STCE/PBMTE/ADUE + SBI DBCN) + the 2/4-cpu RVA23 device trees. Pass = hart0
// x3 == 0xAA (SBI SRST shutdown).
//
//   veryl test --ignored --test test_soc_66_smp_linux_boot_2hart
//   veryl test --ignored --test test_soc_66_smp_linux_boot_4hart

#[test(test_soc_66_smp_linux_boot_2hart)]
#[ignore]
module test_soc_66_smp_linux_boot_2hart {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass   : logic    ;
    var fail   : logic    ;
    var x3     : logic<64>;
    var cycles : logic<64>;
    var instret: logic<64>;

    inst h: boot_soc_harness #(
        N_HARTS   : 2,
        FW_HEX    : "test/hex/linux_boot_fw_66_smp.hex",
        DRAM_HEX  : "test/hex/linux_dram_66_2hart.hex",
        PROBE_LOG2: 20,
    ) (
        clk                 ,
        rst                 ,
        o_pass   : pass     ,
        o_fail   : fail     ,
        o_x3     : x3       ,
        o_cycles : cycles   ,
        o_instret: instret  ,
        o_last_pc: _        ,
        o_ret_cnt: _        ,
        o_traps  : _        ,
    );

    initial {
        rst.assert(clk);
        for _i in 0..10000 {
            clk.next(10000);
            if pass || fail {
                break;
            }
        }
        clk.next(10);
        $display("6.6 smp(N=2) linux boot: cycles=%d instret=%d x3=%h pass=%b fail=%b", cycles, instret, x3, pass, fail);
        $assert (pass, "6.6 smp(N=2) linux boot: checker, hart failure or no SBI shutdown");
        $finish ();
    }
}

#[test(test_soc_66_smp_linux_boot_4hart)]
#[ignore]
module test_soc_66_smp_linux_boot_4hart {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass   : logic    ;
    var fail   : logic    ;
    var x3     : logic<64>;
    var cycles : logic<64>;
    var instret: logic<64>;

    inst h: boot_soc_harness #(
        N_HARTS   : 4,
        FW_HEX    : "test/hex/linux_boot_fw_66_smp.hex",
        DRAM_HEX  : "test/hex/linux_dram_66_4hart.hex",
        PROBE_LOG2: 20,
    ) (
        clk                 ,
        rst                 ,
        o_pass   : pass     ,
        o_fail   : fail     ,
        o_x3     : x3       ,
        o_cycles : cycles   ,
        o_instret: instret  ,
        o_last_pc: _        ,
        o_ret_cnt: _        ,
        o_traps  : _        ,
    );

    initial {
        rst.assert(clk);
        for _i in 0..10000 {
            clk.next(10000);
            if pass || fail {
                break;
            }
        }
        clk.next(10);
        $display("6.6 smp(N=4) linux boot: cycles=%d instret=%d x3=%h pass=%b fail=%b", cycles, instret, x3, pass, fail);
        $assert (pass, "6.6 smp(N=4) linux boot: checker, hart failure or no SBI shutdown");
        $finish ();
    }
}
