// ROB (Reorder Buffer) unit test.
// Tests: allocate, complete, commit, flush, full/empty detection.
module test_rob_harness (
    clk   : input  clock   ,
    rst   : input  reset   ,
    o_pass: output logic   ,
    o_done: output logic   ,
) {
    var tc: logic<8>;

    always_ff {
        if_reset {
            tc = 8'd0;
        } else {
            tc = tc + 8'd1;
        }
    }

    // DUT signals
    var alloc_valid  : logic    ;
    var alloc_pc     : logic<64>;
    var alloc_rd     : logic<5> ;
    var alloc_wen    : logic    ;
    var alloc_is_fp  : logic    ;
    var alloc_fp_wen : logic    ;
    var alloc_compr  : logic    ;
    var alloc_idx    : logic<4> ;
    var alloc_ready  : logic    ;

    var comp_valid   : logic    ;
    var comp_idx     : logic<4> ;
    var comp_data    : logic<64>;
    var pc_table     : logic<64> [16];
    var comp_pc      : logic<64>;
    always_comb {
        comp_pc = pc_table[comp_idx];
    }
    always_ff {
        if_reset {
            for i in 0..16 {
                pc_table[i] = 64'd0;
            }
        } else {
            if alloc_valid && alloc_ready {
                pc_table[alloc_idx] = alloc_pc;
            }
        }
    }

    var exc_valid    : logic    ;
    var exc_idx      : logic<4> ;
    var exc_cause    : logic<64>;

    var suppress_wen_valid: logic    ;
    var suppress_wen_idx  : logic<4> ;

    var commit_valid : logic    ;
    var commit_pc    : logic<64>;
    var commit_rd    : logic<5> ;
    var commit_data  : logic<64>;
    var commit_wen   : logic    ;
    var commit_is_fp : logic    ;
    var commit_fp_wen: logic    ;
    var commit_compr : logic    ;
    var commit_exc   : logic    ;
    var commit_cause : logic<64>;
    var commit_ack   : logic    ;

    var flush        : logic    ;
    var empty        : logic    ;
    var full         : logic    ;
    var commit_idx   : logic<4> ;

    inst dut: rob (
        clk                                 ,
        rst                                 ,
        i_alloc_valid  : alloc_valid        ,
        i_alloc_pc     : alloc_pc           ,
        i_alloc_rd     : alloc_rd           ,
        i_alloc_wen    : alloc_wen          ,
        i_alloc_is_fp  : alloc_is_fp       ,
        i_alloc_fp_wen : alloc_fp_wen      ,
        i_alloc_compr  : alloc_compr       ,
        o_alloc_idx    : alloc_idx          ,
        o_alloc_epoch  : _                  ,
        o_alloc_ready  : alloc_ready        ,
        i_complete_valid: comp_valid        ,
        i_complete_idx  : comp_idx          ,
        i_complete_epoch: 1'b0             ,
        i_complete_data : comp_data         ,
        i_complete_pc   : comp_pc           ,
        i_exc_valid    : exc_valid          ,
        i_exc_idx      : exc_idx            ,
        i_exc_cause    : exc_cause          ,
        i_suppress_wen_valid: suppress_wen_valid,
        i_suppress_wen_idx  : suppress_wen_idx  ,
        o_commit_valid : commit_valid       ,
        o_commit_pc    : commit_pc          ,
        o_commit_rd    : commit_rd          ,
        o_commit_data  : commit_data        ,
        o_commit_wen   : commit_wen         ,
        o_commit_is_fp : commit_is_fp       ,
        o_commit_fp_wen: commit_fp_wen      ,
        o_commit_compr : commit_compr       ,
        o_commit_exc   : commit_exc         ,
        o_commit_cause : commit_cause       ,
        o_commit_epoch : _                  ,
        i_commit_ack   : commit_ack         ,
        i_flush        : flush              ,
        i_squash_valid : 1'b0              ,
        i_squash_idx   : 5'd0              ,
        i_cancel_valid : 1'b0              ,
        i_cancel_idx   : 4'd0              ,
        i_lookup1_idx      : 4'd0              ,
        o_lookup1_completed: _               ,
        o_lookup1_valid    : _               ,
        i_lookup2_idx      : 4'd0              ,
        o_lookup2_completed: _               ,
        o_lookup2_valid    : _               ,
        i_read1_idx        : 4'd0               ,
        o_read1_data       : _                  ,
        o_read1_completed  : _                  ,
        o_read1_valid      : _                  ,
        i_read2_idx        : 4'd0               ,
        o_read2_data       : _                  ,
        o_read2_completed  : _                  ,
        o_read2_valid      : _                  ,
        o_squash_mask  : _                  ,
        o_empty        : empty              ,
        o_full         : full               ,
        o_commit_idx   : commit_idx         ,
    );

    var failed: logic;

    always_comb {
        alloc_valid  = 1'b0;
        alloc_pc     = '0;
        alloc_rd     = 5'd0;
        alloc_wen    = 1'b0;
        alloc_is_fp  = 1'b0;
        alloc_fp_wen = 1'b0;
        alloc_compr  = 1'b0;
        comp_valid   = 1'b0;
        comp_idx     = 4'd0;
        comp_data    = '0;
        exc_valid    = 1'b0;
        exc_idx      = 4'd0;
        exc_cause    = '0;
        suppress_wen_valid = 1'b0;
        suppress_wen_idx   = 4'd0;
        commit_ack   = 1'b0;
        flush        = 1'b0;

        case tc {
            // tc=1: after reset, ROB is empty
            // (checked in always_ff below)

            // tc=2: allocate entry 0 (ADD x5, PC=0x100)
            8'd2: {
                alloc_valid = 1'b1;
                alloc_pc    = 64'h100;
                alloc_rd    = 5'd5;
                alloc_wen   = 1'b1;
            }

            // tc=3: allocate entry 1 (LD x6, PC=0x104)
            8'd3: {
                alloc_valid = 1'b1;
                alloc_pc    = 64'h104;
                alloc_rd    = 5'd6;
                alloc_wen   = 1'b1;
            }

            // tc=4: complete entry 0 with data 0xDEAD
            8'd4: {
                comp_valid = 1'b1;
                comp_idx   = 4'd0;
                comp_data  = 64'hDEAD;
            }

            // tc=5: commit head (entry 0)
            8'd5: {
                commit_ack = 1'b1;
            }

            // tc=6: complete entry 1 with data 0xBEEF
            8'd6: {
                comp_valid = 1'b1;
                comp_idx   = 4'd1;
                comp_data  = 64'hBEEF;
            }

            // tc=7: commit head (entry 1)
            8'd7: {
                commit_ack = 1'b1;
            }

            // tc=8: empty after both committed

            // tc=9..24: allocate 16 entries (fill ROB)
            8'd9: {
                alloc_valid = 1'b1;
                alloc_pc    = 64'h200;
                alloc_rd    = 5'd1;
                alloc_wen   = 1'b1;
            }
            8'd10: {
                alloc_valid = 1'b1;
                alloc_pc    = 64'h204;
                alloc_rd    = 5'd2;
                alloc_wen   = 1'b1;
            }
            8'd11: {
                alloc_valid = 1'b1;
                alloc_pc    = 64'h208;
                alloc_rd    = 5'd3;
                alloc_wen   = 1'b1;
            }
            8'd12: {
                alloc_valid = 1'b1;
                alloc_pc    = 64'h20C;
                alloc_rd    = 5'd4;
                alloc_wen   = 1'b1;
            }
            8'd13: {
                alloc_valid = 1'b1;
                alloc_pc    = 64'h210;
                alloc_rd    = 5'd5;
                alloc_wen   = 1'b1;
            }
            8'd14: {
                alloc_valid = 1'b1;
                alloc_pc    = 64'h214;
                alloc_rd    = 5'd6;
                alloc_wen   = 1'b1;
            }
            8'd15: {
                alloc_valid = 1'b1;
                alloc_pc    = 64'h218;
                alloc_rd    = 5'd7;
                alloc_wen   = 1'b1;
            }
            8'd16: {
                alloc_valid = 1'b1;
                alloc_pc    = 64'h21C;
                alloc_rd    = 5'd8;
                alloc_wen   = 1'b1;
            }
            8'd17: {
                alloc_valid = 1'b1;
                alloc_pc    = 64'h220;
                alloc_rd    = 5'd9;
                alloc_wen   = 1'b1;
            }
            8'd18: {
                alloc_valid = 1'b1;
                alloc_pc    = 64'h224;
                alloc_rd    = 5'd10;
                alloc_wen   = 1'b1;
            }
            8'd19: {
                alloc_valid = 1'b1;
                alloc_pc    = 64'h228;
                alloc_rd    = 5'd11;
                alloc_wen   = 1'b1;
            }
            8'd20: {
                alloc_valid = 1'b1;
                alloc_pc    = 64'h22C;
                alloc_rd    = 5'd12;
                alloc_wen   = 1'b1;
            }
            8'd21: {
                alloc_valid = 1'b1;
                alloc_pc    = 64'h230;
                alloc_rd    = 5'd13;
                alloc_wen   = 1'b1;
            }
            8'd22: {
                alloc_valid = 1'b1;
                alloc_pc    = 64'h234;
                alloc_rd    = 5'd14;
                alloc_wen   = 1'b1;
            }
            8'd23: {
                alloc_valid = 1'b1;
                alloc_pc    = 64'h238;
                alloc_rd    = 5'd15;
                alloc_wen   = 1'b1;
            }
            8'd24: {
                alloc_valid = 1'b1;
                alloc_pc    = 64'h23C;
                alloc_rd    = 5'd16;
                alloc_wen   = 1'b1;
            }
            // tc=25: ROB should be full

            // tc=26: flush
            8'd26: {
                flush = 1'b1;
            }
            // tc=27: ROB should be empty after flush

            // tc=28: allocate + exception test
            8'd28: {
                alloc_valid = 1'b1;
                alloc_pc    = 64'h300;
                alloc_rd    = 5'd10;
                alloc_wen   = 1'b1;
            }
            // tc=29: mark as exception
            8'd29: {
                exc_valid = 1'b1;
                exc_idx   = 4'd0;
                exc_cause = 64'h2; // illegal instruction
            }
            // tc=30: commit should show exception
            8'd30: {
                commit_ack = 1'b1;
            }

            default: {}
        }
    }

    always_ff {
        if_reset {
            failed = 1'b0;
        } else {
            case tc {
                // tc=1: ROB empty after reset
                8'd1: {
                    if !empty || full {
                        $display("FAIL tc=1: expected empty=1 full=0, got empty=%b full=%b", empty, full);
                        failed = 1'b1;
                    }
                }
                // tc=3: after allocating entry 0, not empty
                8'd3: {
                    if empty {
                        $display("FAIL tc=3: expected not empty after alloc");
                        failed = 1'b1;
                    }
                }
                // tc=5: head should be committable (entry 0 completed)
                8'd5: {
                    if !commit_valid || commit_pc != 64'h100 || commit_rd != 5'd5 || commit_data != 64'hDEAD {
                        $display("FAIL tc=5: commit_valid=%b pc=%h rd=%d data=%h", commit_valid, commit_pc, commit_rd, commit_data);
                        failed = 1'b1;
                    }
                }
                // tc=7: head should be entry 1
                8'd7: {
                    if !commit_valid || commit_pc != 64'h104 || commit_rd != 5'd6 || commit_data != 64'hBEEF {
                        $display("FAIL tc=7: commit_valid=%b pc=%h rd=%d data=%h", commit_valid, commit_pc, commit_rd, commit_data);
                        failed = 1'b1;
                    }
                }
                // tc=8: empty after both committed
                8'd8: {
                    if !empty {
                        $display("FAIL tc=8: expected empty after 2 commits");
                        failed = 1'b1;
                    }
                }
                // tc=25: ROB now 32 entries, 16 allocs is not full
                8'd25: {
                    if full {
                        $display("FAIL tc=25: ROB=32, 16 allocs should not be full, full=%b", full);
                        failed = 1'b1;
                    }
                }
                // tc=27: empty after flush
                8'd27: {
                    if !empty {
                        $display("FAIL tc=27: expected empty after flush");
                        failed = 1'b1;
                    }
                }
                // tc=30: exception commit
                8'd30: {
                    if !commit_valid || !commit_exc || commit_cause != 64'h2 || commit_pc != 64'h300 {
                        $display("FAIL tc=30: exc commit_valid=%b exc=%b cause=%h pc=%h", commit_valid, commit_exc, commit_cause, commit_pc);
                        failed = 1'b1;
                    }
                }
                default: {}
            }
        }
    }

    assign o_pass = !failed;
    assign o_done = tc >: 8'd33;
}

#[test(test_rob)]
module test_rob {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen(clk);

    var pass: logic;
    var done: logic;

    inst harness: test_rob_harness (
        clk    : clk ,
        rst    : rst ,
        o_pass : pass,
        o_done : done,
    );

    initial {
        rst.assert(clk);
        for _i in 0..36 {
            clk.next(1);
        }
        $assert (pass, "ROB test failed");
        $display("ROB test passed");
        $finish ();
    }
}
