// Direct minimal repro using DecodedOp from pipeline_pkg.
// Set instr=0x0a828293 and imm=0xa8 (same as v4 ADDI corruption).
// Verify that across producer→register→consumer, instr.bit[22] stays 0.
module test_sim_decoded_op_producer (
    clk: input  clock                     ,
    rst: input  reset                     ,
    o  : output pipeline_pkg::DecodedOp,
) {
    import pipeline_pkg::*;
    var q: DecodedOp;
    always_ff (clk, rst) {
        if_reset {
            q.valid      = 1'b0;
            q.pc         = 64'd0;
            q.instr      = 32'd0;
            q.fu_kind    = FuKind::ALU;
            q.alu_op     = alu_pkg::AluOp::ADD;
            q.rd_arch    = 5'd0;
            q.rs1_arch   = 5'd0;
            q.rs2_arch   = 5'd0;
            q.has_rd     = 1'b0;
            q.has_rs1    = 1'b0;
            q.has_rs2    = 1'b0;
            q.imm        = 64'd0;
            q.use_imm_b  = 1'b0;
            q.use_pc_a   = 1'b0;
            q.use_zero_a = 1'b0;
            q.is_branch  = 1'b0;
            q.is_jal     = 1'b0;
            q.is_jalr    = 1'b0;
            q.br_cond    = BrCond::NONE;
            q.wb_pc4     = 1'b0;
            q.is_load    = 1'b0;
            q.is_store   = 1'b0;
            q.mem_funct3 = 3'd0;
            q.is_csr     = 1'b0;
            q.csr_op     = csr_pkg::CsrOp::RW;
            q.csr_imm    = 1'b0;
            q.csr_addr   = 12'd0;
            q.is_ecall   = 1'b0;
            q.is_ebreak  = 1'b0;
            q.is_mret    = 1'b0;
            q.is_sret    = 1'b0;
            q.is_sfence  = 1'b0;
            q.is_amo     = 1'b0;
            q.amo_funct5 = 5'd0;
            q.amo_is_w   = 1'b0;
            q.is_rvc     = 1'b0;
            q.illegal    = 1'b0;
        } else {
            q.valid      = 1'b1;
            q.pc         = 64'h0000000000000010;
            q.instr      = 32'h0a828293; // ADDI t0, t0, 168
            q.fu_kind    = FuKind::ALU;
            q.alu_op     = alu_pkg::AluOp::ADD;
            q.rd_arch    = 5'd5;
            q.rs1_arch   = 5'd5;
            q.rs2_arch   = 5'd0;
            q.has_rd     = 1'b1;
            q.has_rs1    = 1'b1;
            q.has_rs2    = 1'b0;
            q.imm        = 64'h00000000000000a8; // 168
            q.use_imm_b  = 1'b1;
            q.use_pc_a   = 1'b0;
            q.use_zero_a = 1'b0;
            q.is_branch  = 1'b0;
            q.is_jal     = 1'b0;
            q.is_jalr    = 1'b0;
            q.br_cond    = BrCond::NONE;
            q.wb_pc4     = 1'b0;
            q.is_load    = 1'b0;
            q.is_store   = 1'b0;
            q.mem_funct3 = 3'd0;
            q.is_csr     = 1'b0;
            q.csr_op     = csr_pkg::CsrOp::RW;
            q.csr_imm    = 1'b0;
            q.csr_addr   = 12'd0;
            q.is_ecall   = 1'b0;
            q.is_ebreak  = 1'b0;
            q.is_mret    = 1'b0;
            q.is_sret    = 1'b0;
            q.is_sfence  = 1'b0;
            q.is_amo     = 1'b0;
            q.amo_funct5 = 5'd0;
            q.amo_is_w   = 1'b0;
            q.is_rvc     = 1'b0;
            q.illegal    = 1'b0;
        }
    }
    assign o = q;
}

module test_sim_decoded_op_consumer (
    clk    : input  clock                         ,
    rst    : input  reset                         ,
    i      : input  pipeline_pkg::DecodedOp    ,
    o_instr: output logic                     <32>,
    o_imm  : output logic                     <64>,
    o_bit22: output logic                         ,
) {
    assign o_instr = i.instr;
    assign o_imm   = i.imm;
    assign o_bit22 = i.instr[22];
}

module test_sim_decoded_op_harness (
    clk      : input  clock    ,
    rst      : input  reset    ,
    o_instr  : output logic<32>,
    o_imm    : output logic<64>,
    o_bit22  : output logic    ,
    o_correct: output logic    ,
) {
    var dec  : pipeline_pkg::DecodedOp    ;
    var instr: logic                     <32>;
    var imm  : logic                     <64>;
    var bit22: logic                         ;

    inst p: test_sim_decoded_op_producer ( clk, rst, o: dec );
    inst c: test_sim_decoded_op_consumer ( clk, rst, i: dec, o_instr: instr, o_imm: imm, o_bit22: bit22 );

    assign o_instr   = instr;
    assign o_imm     = imm;
    assign o_bit22   = bit22;
    assign o_correct = instr == 32'h0a828293;
}

#[test(test_sim_decoded_op)]
#[ignore]
module test_sim_decoded_op {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var instr: logic<32>;
    var imm  : logic<64>;
    var bit22: logic    ;
    var ok   : logic    ;
    inst h: test_sim_decoded_op_harness ( clk, rst, o_instr: instr, o_imm: imm, o_bit22: bit22, o_correct: ok );
    initial {
        rst.assert(clk);
        clk.next  (5);
        $display  (
            "[test_sim_decoded_op] instr=%h imm=%h bit22=%b ok=%b (expected: instr=0x0a828293 bit22=0 ok=1)",
            instr,
            imm,
            bit22,
            ok,
        );
        $assert   (ok, "DecodedOp field corruption");
        $finish   ();
    }
}
