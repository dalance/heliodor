// Phase 7 v4 real Linux boot integration test.
//
// Boots the real Linux v5.15 kernel image through SBI firmware on the
// clean-redesign v4 OoO core. Uses the same hex as v1's test_linux_boot
// (linux_boot_fw.hex + linux_dram_real.hex, ~11 MB DRAM image).
//
// Marked #[ignore] because it takes a long time. Run explicitly with:
//   veryl test --ignored --test test_v4_linux_boot
//
// Memory map (matches v1 test_linux_boot):
//   PA 0x00000000 : Firmware ROM (16 KB, linux_boot_fw.hex)
//   PA 0x02000000 : CLINT (internal)
//   PA 0x10000000 : UART (internal stub — prints via $write)
//   PA 0x80000000 : DRAM (32 MB, kernel + DTB from linux_dram_real.hex)
//
// Pass condition: x3 register reaches 0xAA (SBI SRST shutdown).
module test_v4_linux_boot_harness (
    clk      : input  clock    ,
    rst      : input  reset    ,
    o_pass   : output logic    ,
    o_r3     : output logic<64>,
    o_cy     : output logic<32>,
    o_ret    : output logic<32>,
    o_lrc    : output logic<32>,
    o_trapcnt: output logic<32>,
    o_lf     : output logic    ,
    o_lpc    : output logic<64>,
    o_ftpc   : output logic<64>,
    o_fcause : output logic<64>,
    o_tlpc   : output logic<64>,
    o_tlcause: output logic<64>,
    o_satp   : output logic<64>,
    o_priv   : output logic<2> ,
    o_pc     : output logic<64>,
    o_uart   : output logic<32>,
    o_ecall  : output logic<32>,
) {
    var imem_addr      : logic<64>     ;
    var imem_rdata     : logic<32>     ;
    var imem_ren       : logic         ;
    var dmem_addr      : logic<64>     ;
    var dmem_wdata     : logic<64>     ;
    var dmem_rdata     : logic<64>     ;
    var dmem_rdata_next: logic<64>     ;
    var dmem_wen       : logic         ;
    var dmem_ren       : logic         ;
    var dmem_wstrb     : logic<8>      ;
    var dmem_wdata_hi  : logic<64>     ;
    var dmem_wstrb_hi  : logic<8>      ;
    var dbg_regs       : logic<64> [32];
    var dbg_pc         : logic<64>     ;
    var dbg_sepc      : logic<64>; var dbg_mepc: logic<64>; var dbg_priv: logic<2>;
    var dbg_trap_fire : logic    ; var dbg_trap_pc: logic<64>;
    var dbg_trap_cause: logic<64>; var dbg_trap_to_s: logic;
    var dbg_satp      : logic<64>; var dbg_imem_vaddr: logic<64>; var dbg_imem_paddr: logic<64>;
    var dbg_imem_valid: logic    ; var dbg_imem_fault: logic;
    var dbg_csrwr_v   : logic    ;
    var dbg_csrwr_addr: logic<12>;
    var dbg_csrwr_wdata:logic<64>;
    var dbg_ptw_req   : logic    ; var dbg_ptw_addr : logic<64>; var dbg_ptw_data : logic<64>;
    var dbg_redir_v   : logic;
    var dbg_redir_pc  : logic<64>;
    var dbg_redir_src : logic<64>;
    var dbg_alu_pc    : logic<64>;
    var dbg_alu_src_a : logic<64>;
    var dbg_alu_src_b : logic<64>;
    var dbg_alu_use_pc_a: logic;
    var dbg_alu_rs1_data: logic<64>;
    var dbg_alu_valid   : logic    ;
    var dbg_alu_alu_out : logic<64>;
    var dbg_alu_instr   : logic<32>;
    var dbg_alu_imm     : logic<64>;
    var dbg_stval     : logic<64>;
    var dbg_mtval     : logic<64>;
    var dbg_dmm_busy  : logic    ;
    var dbg_iptw_req  : logic    ;
    var dbg_core_dren : logic    ;
    var dbg_core_dmem_va : logic<64>; // M9.A.291: DMMU input VA
    // M9.A.292: AGU input snoop
    var dbg_agu_issue_v : logic    ;
    var dbg_agu_rs1_arch: logic<5> ;
    var dbg_agu_rs1_pdst: logic<6> ;
    var dbg_agu_rs1_data: logic<64>;
    var dbg_agu_imm     : logic<64>;
    var dbg_agu_addr    : logic<64>;
    var dbg_agu_is_load : logic    ;
    var dbg_agu_is_store: logic    ;
    var dbg_agu_rob_idx : logic<5> ;
    var _ret_v: logic; var _ret_pc: logic<64>; var _ret_rdv: logic; var _ret_rd: logic<5>; var _ret_data: logic<64>;
    var _rename_cnt: logic<32>; var _cdb_cnt: logic<32>; var _rob_size: logic<8>;
    var _if_v: logic; var _if_instr: logic<32>; var _stall_dr: logic;
    var _head_valid: logic; var _head_rw: logic; var _head_il: logic;
    var _r_alloc: logic<32>; var _r_cdb: logic<32>; var _r_commit: logic<32>;
    var _r_head: logic<6>; var _r_tail: logic<6>;

    // CLINT signals
    var clint_rdata    : logic<64>     ;
    var clint_timer_irq: logic [1]     ;
    var clint_sw_irq   : logic [1]     ;
    var clint_mtime    : logic<64>     ;

    inst dut: heliodor_core_v4 #(
        RESET_PC: 64'h00000000,
    ) (
        clk                            ,
        rst                            ,
        o_imem_addr        : imem_addr      ,
        i_imem_rdata       : imem_rdata     ,
        o_imem_ren         : imem_ren       ,
        o_dmem_addr        : dmem_addr      ,
        o_dmem_wdata       : dmem_wdata     ,
        i_dmem_rdata       : dmem_rdata     ,
        i_dmem_rdata_next  : dmem_rdata_next,
        o_dmem_wen         : dmem_wen       ,
        o_dmem_ren         : dmem_ren       ,
        o_dmem_wstrb       : dmem_wstrb     ,
        o_dmem_wdata_hi    : dmem_wdata_hi  ,
        o_dmem_wstrb_hi    : dmem_wstrb_hi  ,
        i_irq_timer_m      : clint_timer_irq[0],
        i_mtime            : clint_mtime    ,
        i_irq_sw_m         : clint_sw_irq[0]   ,
        i_irq_ext_m        : 1'b0              ,
        o_dbg_pc           : dbg_pc     ,
        o_dbg_regs         : dbg_regs   ,
        o_dbg_retire_v_a   : _ret_v      ,
        o_dbg_retire_pc_a  : _ret_pc     ,
        o_dbg_retire_rd_v_a: _ret_rdv    ,
        o_dbg_retire_rd_a  : _ret_rd     ,
        o_dbg_retire_data_a: _ret_data   ,
        o_dbg_rename_cnt   : _rename_cnt ,
        o_dbg_cdb_cnt      : _cdb_cnt    ,
        o_dbg_rob_size     : _rob_size   ,
        o_dbg_if_v         : _if_v       ,
        o_dbg_if_instr     : _if_instr   ,
        o_dbg_stall_dr     : _stall_dr   ,
        o_dbg_head_valid   : _head_valid ,
        o_dbg_head_rw      : _head_rw    ,
        o_dbg_head_illegal : _head_il    ,
        o_dbg_rob_alloc_cnt: _r_alloc    ,
        o_dbg_rob_cdb_cnt  : _r_cdb      ,
        o_dbg_rob_commit_cnt: _r_commit  ,
        o_dbg_rob_head     : _r_head     ,
        o_dbg_rob_tail     : _r_tail     ,
        o_dbg_sepc         : dbg_sepc, o_dbg_mepc: dbg_mepc, o_dbg_priv: dbg_priv,
        o_dbg_trap_fire    : dbg_trap_fire, o_dbg_trap_pc: dbg_trap_pc,
        o_dbg_trap_cause   : dbg_trap_cause, o_dbg_trap_to_s: dbg_trap_to_s,
        o_dbg_satp         : dbg_satp, o_dbg_imem_vaddr: dbg_imem_vaddr, o_dbg_imem_paddr: dbg_imem_paddr,
        o_dbg_imem_valid   : dbg_imem_valid, o_dbg_imem_fault: dbg_imem_fault,
        o_dbg_csrwr_v      : dbg_csrwr_v, o_dbg_csrwr_addr: dbg_csrwr_addr, o_dbg_csrwr_wdata: dbg_csrwr_wdata,
        o_dbg_ptw_req      : dbg_ptw_req, o_dbg_ptw_addr: dbg_ptw_addr, o_dbg_ptw_data: dbg_ptw_data,
        o_dbg_redirect_fire: dbg_redir_v, o_dbg_redirect_pc: dbg_redir_pc, o_dbg_redirect_src_pc: dbg_redir_src,
        o_dbg_alu_pc_out: dbg_alu_pc, o_dbg_alu_src_a_out: dbg_alu_src_a, o_dbg_alu_src_b_out: dbg_alu_src_b, o_dbg_alu_use_pc_a_out: dbg_alu_use_pc_a, o_dbg_alu_rs1_data_out: dbg_alu_rs1_data, o_dbg_alu_valid_out: dbg_alu_valid, o_dbg_alu_alu_out_out: dbg_alu_alu_out, o_dbg_alu_instr_out: dbg_alu_instr, o_dbg_alu_imm_out: dbg_alu_imm, o_dbg_stval_out: dbg_stval, o_dbg_mtval_out: dbg_mtval,
        o_dbg_dmem_mmu_busy: dbg_dmm_busy, o_dbg_core_dmem_vaddr: dbg_core_dmem_va,
        o_dbg_core_dmem_wen: _, o_dbg_core_dmem_ren: dbg_core_dren,
        o_dbg_imem_ptw_req: dbg_iptw_req, o_dbg_commit_store_fire: _,
        o_dbg_agu_issue_v: dbg_agu_issue_v, o_dbg_agu_rs1_arch: dbg_agu_rs1_arch,
        o_dbg_agu_rs1_pdst: dbg_agu_rs1_pdst, o_dbg_agu_rs1_data: dbg_agu_rs1_data,
        o_dbg_agu_imm: dbg_agu_imm, o_dbg_agu_addr: dbg_agu_addr,
        o_dbg_agu_is_load: dbg_agu_is_load, o_dbg_agu_is_store: dbg_agu_is_store,
        o_dbg_agu_rob_idx: dbg_agu_rob_idx,
    );

    // Firmware ROM: 16 KB
    var fw_rom: logic<32> [4096];
    // DRAM: 32 MB (Linux kernel + DTB)
    var dram: logic<32> [8388608];
    initial {
        $readmemh("test/hex/linux_boot_fw.hex", fw_rom);
        // M9 (2026-05-25): v4-specific kernel binary patch — replaces two
        // PC-relative la gp sequences (PA 0x80001050, 0x80001088) with
        // absolute LUI+ADDI so gp = 0xffffffff80a85c20 regardless of which
        // PC half the code runs at. The original kernel head.S relies on a
        // TLB-eviction-induced trap to re-execute `la gp` at high-half PC
        // (= v1 behavior). v4's IFU + MMU walk fresh after csrw satp, so
        // no trap fires, gp stays low-half, kernel OOPSes. See
        // project_phase7_v4_m9_blocker.md.
        $readmemh("test/hex/linux_dram_real.hex", dram);
    }

    let imem_in_fw : logic = imem_addr[31:14] == 18'd0;
    let in_fw      : logic = dmem_addr[31:14] == 18'd0;
    let in_dram    : logic = dmem_addr[31];
    let in_uart    : logic = dmem_addr[31:28] == 4'h1;
    let in_clint   : logic = dmem_addr[31:24] == 8'h02;

    let dram_imem_idx: logic<23> = imem_addr[24:2];
    let fw_imem_idx  : logic<12> = imem_addr[13:2];
    assign imem_rdata = if imem_in_fw ? fw_rom[fw_imem_idx]
                        : if imem_addr[31] ? dram[dram_imem_idx]
                        : 32'd0;

    let dram_dmem_lo : logic<23> = {dmem_addr[24:3], 1'b0};
    let dram_dmem_hi : logic<23> = {dmem_addr[24:3], 1'b1};
    let dram_dmem_nx_lo: logic<23> = {(dmem_addr[24:3] + 22'd1), 1'b0};
    let dram_dmem_nx_hi: logic<23> = {(dmem_addr[24:3] + 22'd1), 1'b1};
    let fw_dmem_lo  : logic<12> = {dmem_addr[13:3], 1'b0};
    let fw_dmem_hi  : logic<12> = {dmem_addr[13:3], 1'b1};

    assign dmem_rdata = if in_dram ? {dram[dram_dmem_hi], dram[dram_dmem_lo]}
                        : if in_fw   ? {fw_rom[fw_dmem_hi], fw_rom[fw_dmem_lo]}
                        : if in_clint ? clint_rdata
                        : 64'd0;
    assign dmem_rdata_next = if in_dram ? {dram[dram_dmem_nx_hi], dram[dram_dmem_nx_lo]}
                             : 64'd0;

    inst u_clint: clint #(N_HARTS: 1) (
        clk            ,
        rst            ,
        i_addr     : dmem_addr[15:0],
        i_wdata    : dmem_wdata     ,
        i_wen      : dmem_wen && in_clint,
        i_ren      : dmem_ren && in_clint,
        o_rdata    : clint_rdata    ,
        o_timer_irq: clint_timer_irq,
        o_sw_irq   : clint_sw_irq   ,
        o_mtime    : clint_mtime    ,
    );
    let _unused_mtime: logic<64> = clint_mtime;
    let _unused_t_irq: logic = clint_timer_irq[0];
    let _unused_s_irq: logic = clint_sw_irq[0];

    always_ff (clk, rst) {
        if_reset {} else if dmem_wen && in_dram {
            if dmem_wstrb[0] { dram[dram_dmem_lo][7:0]   = dmem_wdata[7:0];   }
            if dmem_wstrb[1] { dram[dram_dmem_lo][15:8]  = dmem_wdata[15:8];  }
            if dmem_wstrb[2] { dram[dram_dmem_lo][23:16] = dmem_wdata[23:16]; }
            if dmem_wstrb[3] { dram[dram_dmem_lo][31:24] = dmem_wdata[31:24]; }
            if dmem_wstrb[4] { dram[dram_dmem_hi][7:0]   = dmem_wdata[39:32]; }
            if dmem_wstrb[5] { dram[dram_dmem_hi][15:8]  = dmem_wdata[47:40]; }
            if dmem_wstrb[6] { dram[dram_dmem_hi][23:16] = dmem_wdata[55:48]; }
            if dmem_wstrb[7] { dram[dram_dmem_hi][31:24] = dmem_wdata[63:56]; }
            if dmem_wstrb_hi[0] { dram[dram_dmem_nx_lo][7:0]   = dmem_wdata_hi[7:0];   }
            if dmem_wstrb_hi[1] { dram[dram_dmem_nx_lo][15:8]  = dmem_wdata_hi[15:8];  }
            if dmem_wstrb_hi[2] { dram[dram_dmem_nx_lo][23:16] = dmem_wdata_hi[23:16]; }
            if dmem_wstrb_hi[3] { dram[dram_dmem_nx_lo][31:24] = dmem_wdata_hi[31:24]; }
            if dmem_wstrb_hi[4] { dram[dram_dmem_nx_hi][7:0]   = dmem_wdata_hi[39:32]; }
            if dmem_wstrb_hi[5] { dram[dram_dmem_nx_hi][15:8]  = dmem_wdata_hi[47:40]; }
            if dmem_wstrb_hi[6] { dram[dram_dmem_nx_hi][23:16] = dmem_wdata_hi[55:48]; }
            if dmem_wstrb_hi[7] { dram[dram_dmem_nx_hi][31:24] = dmem_wdata_hi[63:56]; }
        } else if dmem_wen && in_uart {
            if dmem_wstrb[0] { $write("%c", dmem_wdata[7:0]); }
            if dmem_wstrb[1] { $write("%c", dmem_wdata[15:8]); }
            if dmem_wstrb[2] { $write("%c", dmem_wdata[23:16]); }
            if dmem_wstrb[3] { $write("%c", dmem_wdata[31:24]); }
            if dmem_wstrb[4] { $write("%c", dmem_wdata[39:32]); }
            if dmem_wstrb[5] { $write("%c", dmem_wdata[47:40]); }
            if dmem_wstrb[6] { $write("%c", dmem_wdata[55:48]); }
            if dmem_wstrb[7] { $write("%c", dmem_wdata[63:56]); }
        }
    }

    // Minimal v4 boot trace: cy counter + cause=13 first-trap snapshot +
    // a5 (rd=15) write ring frozen at first cause=13 trap. All other
    // per-PC $display blocks and heavyweight rings (s2/a0/ret_pc/fetch/
    // PTW/CSR/etc.) removed for sim speed — they were debugging the
    // M9.A.258 memmap bug which is now resolved.
    assign o_r3   = dbg_regs[3];
    assign o_pass = dbg_regs[3] == 64'hAA;

    var cy             : logic<32>;
    var ret_total      : logic<32>;
    var last_ret_cy    : logic<32>;
    var trap_cnt       : logic<32>;
    var first_trap_seen: logic    ;
    var first_trap_cy  : logic<32>;
    var first_trap_pc  : logic<64>;
    var first_trap_cause: logic<64>;
    var trap_last_pc   : logic<64>;
    var trap_last_cause: logic<64>;
    var lfault_seen    : logic    ;
    var lfault_cy      : logic<32>;
    var lfault_pc      : logic<64>;
    var lfault_satp    : logic<64>;
    var lfault_tval    : logic<64>;
    var lfault_regs    : logic<64> [32];
    var uart_wr_cnt    : logic<32>;
    var ecall_first_cy : logic<32>;
    var ecall_seen     : logic    ;

    // M9.A.259: a5 (rd=15) write ring — 32 entries, frozen at first
    // cause=13 trap. Used to find which instruction wrote the bogus
    // a5=0x05253023c12154d1 leading to the userspace-init OOPS at
    // PC 0x800b406e (c.ld a1, 32(a5)).
    var a5_ring_pc  : logic<64> [32];
    var a5_ring_cy  : logic<32> [32];
    var a5_ring_data: logic<64> [32];
    var a5_ring_idx : logic<5>      ;
    var a5_dumped   : logic         ;
    // M9.A.260: a0 (rd=10) write ring — 64 entries, frozen at first
    // cause=13 trap. Find which load wrote a0=0xffffffff8009d8f2
    // (= the wild kernel-text pointer that propagated through s1/s2).
    var a0_ring_pc  : logic<64> [64];
    var a0_ring_cy  : logic<32> [64];
    var a0_ring_data: logic<64> [64];
    var a0_ring_idx : logic<6>      ;
    // M9.A.273: full reg snapshot at OOPS chain PCs. Captures cy + 32 regs
    // at retire of each suspect PC, frozen at first cause=13. Compare with
    // v1 boot retires at same PCs to identify register-state divergence.
    // 8 slots × 32 regs × 64 bits = 2 KB.
    var snap_cy   : logic<32> [8];
    var snap_pc   : logic<64> [8];
    var snap_regs : logic<64> [256]; // flattened: slot*32 + reg
    var snap_idx  : logic<4>      ;
    // M9.A.261: ALL stores to PA 0x80d65428 (= the addr that returned
    // wild 0xffffffff8009d8f2 in M9.A.260). Identifies the kernel writer
    // and expected value (or absence of writer = uninitialized read).
    var st428_ring_pc  : logic<64> [32];
    var st428_ring_cy  : logic<32> [32];
    var st428_ring_data: logic<64> [32];
    var st428_ring_idx : logic<5>      ;
    // M9.A.262: ring of last 32 in-DRAM dmem activity (ren or wen).
    // Captures dmem_addr + dmem_rdata at every dram access, frozen at
    // lfault. Used to verify whether v4's PC 0x800b40bc load (around
    // cy 21421947) sent dmem_addr=0x80d65428 (correct, then dram race)
    // or some other PA (mmu translation race).
    var ld_ring_cy   : logic<32> [32];
    var ld_ring_pc   : logic<64> [32];
    var ld_ring_addr : logic<64> [32];
    var ld_ring_rdata: logic<64> [32];
    var ld_ring_ren  : logic     [32];
    var ld_ring_wen  : logic     [32];
    var ld_ring_idx  : logic<5>      ;
    // M9.A.278: capture ALL stores whose data == 0xffffffff8009d8f2
    // (= the wild value that became a0/s0 at PC 0x8004a878 cy 21421830).
    // Find which store(s) deposited this value into memory.
    var stwild_cy   : logic<32> [32];
    var stwild_pc   : logic<64> [32];
    var stwild_addr : logic<64> [32];
    var stwild_idx  : logic<5>      ;
    // M9.A.278: track return value of kernel function 0x80049dfe.
    // PC 0x8004a842 retires right after `jal 0x80049dfe` returns;
    // at that point a0 holds the return value. Capture each return.
    var f49dfe_cy   : logic<32> [32];
    var f49dfe_a0   : logic<64> [32];
    var f49dfe_idx  : logic<5>      ;
    // M9.A.279: capture ALL loads whose rdata == 0xffffffff8009d8f2
    // — finds the FIRST load that brings the wild value into a register.
    // Determines whether bug is "mem held wild" or "v4 returned wrong data".
    var ldwild_cy   : logic<32> [64];
    var ldwild_pc   : logic<64> [64];
    var ldwild_addr : logic<64> [64];
    var ldwild_idx  : logic<6>      ;
    // M9.A.279: capture all loads at PC 0x8004a874 (= ld s0, 8(sp) in the
    // function whose `mv a0, s0` at PC 0x8004a878 made a0 wild).
    var ld4a874_cy   : logic<32> [16];
    var ld4a874_addr : logic<64> [16];
    var ld4a874_rdata: logic<64> [16];
    var ld4a874_idx  : logic<4>      ;
    // M9.A.280: capture ALL stores to PA 0x80ca3c38 (the dword that holds
    // the wild value loaded by ld s0, 8(sp) at PC 0x8004a874).
    // If kernel `sd zero, 8(sp)` at PC 0x8004a828 stored 0 to this PA
    // but the load still returns wild, store-to-load ordering is broken.
    var st_ca3c38_cy   : logic<32> [32];
    var st_ca3c38_pc   : logic<64> [32];
    var st_ca3c38_data : logic<64> [32];
    var st_ca3c38_idx  : logic<5>      ;
    // M9.A.281: capture every retire in cy window [21421800, 21421835]
    // (= 35 cycles around the wild load at cy 21421827).
    // Determines actual PC sequence executed by v4 (vs expected by kernel).
    var cywin_cy   : logic<32> [64];
    var cywin_pc   : logic<64> [64];
    var cywin_rd_v : logic     [64];
    var cywin_rd   : logic<5>  [64];
    var cywin_data : logic<64> [64];
    var cywin_idx  : logic<6>      ;
    // M9.A.281: capture every dmem access (ren or wen) in same window.
    var dmwin_cy    : logic<32> [64];
    var dmwin_pc    : logic<64> [64];
    var dmwin_addr  : logic<64> [64];
    var dmwin_rdata : logic<64> [64];
    var dmwin_wdata : logic<64> [64];
    var dmwin_ren   : logic     [64];
    var dmwin_wen   : logic     [64];
    var dmwin_idx   : logic<6>      ;
    // M9.A.282: distinguish v4 jal-target vs store-load-ordering bug.
    // PA 0x80ca3c28 store ring — what value was written by func 0x80049dfe's
    // prologue (sd ra, 136(sp) at PC 0x80049e06)?
    var st_ca3c28_cy   : logic<32> [32];
    var st_ca3c28_pc   : logic<64> [32];
    var st_ca3c28_data : logic<64> [32];
    var st_ca3c28_idx  : logic<5>      ;
    // M9.A.282: ring of all retires at PC 0x80049dfe (function entry).
    // Captures cy + ra (= dbg_regs[1]) at entry. Determines if 0x80049dfe
    // was actually entered (and via what caller).
    // M9.A.284: enlarged from 32 to 256 entries — 32-entry overwrite
    // covered only ~44K cy of history but the epilogue load at cy 21421807
    // referenced a caller_sp that did not appear in any of the most recent
    // 32 entries (latest at cy 21377601). 256 entries should capture the
    // older 0x80049dfe call whose caller_sp matches the observed PA.
    var f49dfe_entry_cy : logic<32> [256];
    var f49dfe_entry_ra : logic<64> [256];
    var f49dfe_entry_sp : logic<64> [256];
    var f49dfe_entry_idx: logic<8>       ;
    var f49894_entry_cy : logic<32> [256];
    var f49894_entry_ra : logic<64> [256];
    var f49894_entry_sp : logic<64> [256];
    var f49894_entry_idx: logic<8>       ;
    // M9.A.284: filter rings — only entries where caller_sp == 0xffffffff80ca3c30
    // (the value implied by the wild epilogue load at PA 0x80ca3c28 = sp+136).
    // Catches whichever historical f49dfe / f49894 call lined up with that sp.
    var f49dfe_3c30_cy : logic<32> [32];
    var f49dfe_3c30_ra : logic<64> [32];
    var f49dfe_3c30_idx: logic<5>      ;
    var f49894_3c30_cy : logic<32> [32];
    var f49894_3c30_ra : logic<64> [32];
    var f49894_3c30_idx: logic<5>      ;
    // M9.A.285: capture f8004a7a2 (caller of PC 0x8004a874 path) entry retires.
    var f4a7a2_cy : logic<32> [128];
    var f4a7a2_ra : logic<64> [128];
    var f4a7a2_sp : logic<64> [128];
    var f4a7a2_s0 : logic<64> [128];
    var f4a7a2_idx: logic<7>       ;
    // M9.A.285: capture ALL stores in cy window [21415486, 21421826] that
    // target PAs in 0x80ca3cXX (stack frame range surrounding 0x80ca3c38).
    var stkst_cy   : logic<32> [128];
    var stkst_pc   : logic<64> [128];
    var stkst_addr : logic<32> [128];
    var stkst_data : logic<64> [128];
    var stkst_idx  : logic<7>       ;
    // M9.A.285: capture ALL retires in cy window [21420000, 21421835].
    // Wider than cywin (which was 21421780..21421835) — covers f8004a7a2
    // entry/prologue/body that precedes the OOPS-time epilogue load.
    var ret2_cy   : logic<32> [256];
    var ret2_pc   : logic<64> [256];
    var ret2_rd_v : logic     [256];
    var ret2_rd   : logic<5>  [256];
    var ret2_data : logic<64> [256];
    var ret2_idx  : logic<8>       ;
    // M9.A.287: capture every rd=02 (sp) retire in cy [21414900, 21421827].
    // Wraps modulo 256. Lets us trace EVERY sp update across the f8004a7a2
    // body+sub-calls to localize the anomalous sp jump from 0xca3c30 to 0xca3c40.
    var sp_ring_cy   : logic<32> [256];
    var sp_ring_pc   : logic<64> [256];
    var sp_ring_data : logic<64> [256];
    var sp_ring_idx  : logic<8>       ;
    // M9.A.293: UNCONDITIONAL per-issue AGU ring (decisive test). Records
    // EVERY IQ issue (not just rs1==sp) in the OOPS window with rob_idx +
    // rs1_arch + pdst + AGU addr + dmem_mmu_busy. Compares the bad cy
    // 22364522 (core_va=0x1078) against the correct replay cy 22364523:
    //   different rob_idx  → IQ select-flip during MMU-busy stall (mech A)
    //   same rob_idx       → RAT/rename rs1 mis-map of c.ldsp (mech B)
    var sp_agu_cy   : logic<32> [256];
    var sp_agu_robi : logic<5>  [256];
    var sp_agu_arch : logic<5>  [256];
    var sp_agu_pdst : logic<6>  [256];
    var sp_agu_data : logic<64> [256];
    var sp_agu_imm  : logic<64> [256];
    var sp_agu_addr : logic<64> [256];
    var sp_agu_ld   : logic     [256];
    var sp_agu_st   : logic     [256];
    var sp_agu_busy : logic     [256];
    var sp_agu_idx  : logic<8>       ;
    // M9.A.287: capture every PC 0x800b3e08 retire (function entry).
    // Records sp BEFORE addi (= caller_sp). Verifies whether caller_sp =
    // 0xca3c40 is observed at the OOPS-window call.
    var b3e08_cy : logic<32> [64];
    var b3e08_sp : logic<64> [64];
    var b3e08_ra : logic<64> [64];
    var b3e08_idx: logic<6>      ;
    // M9.A.289: capture every dbg_trap_fire pulse with full context.
    // Wraps modulo 128 so latest traps are preserved. New OOPS at
    // PC 0x8004a3c2 cy 22364524 — need trap sequence to see whether
    // an async IRQ or earlier sync exception led to bad sp/satp state.
    var trap_ring_cy   : logic<32> [128];
    var trap_ring_pc   : logic<64> [128];
    var trap_ring_cause: logic<64> [128];
    var trap_ring_tval : logic<64> [128];
    var trap_ring_satp : logic<64> [128];
    var trap_ring_to_s : logic     [128];
    var trap_ring_idx  : logic<7>       ;
    // M9.A.289: ld_late ring — last 64 dmem loads in cy [22364400, 22364530]
    // (window around new OOPS at PC 0x8004a3c2 cy 22364524).
    var ldlt_cy    : logic<32> [64];
    var ldlt_pc    : logic<64> [64];
    var ldlt_addr  : logic<64> [64];
    var ldlt_rdata : logic<64> [64];
    var ldlt_idx   : logic<6>      ;
    // M9.A.291: extended ldlt context — IMMU PTW state + core's DMMU input VA.
    var ldlt2_cy       : logic<32> [128];
    var ldlt2_pc       : logic<64> [128];
    var ldlt2_addr     : logic<64> [128];
    var ldlt2_va       : logic<64> [128];
    var ldlt2_iptw_req : logic     [128];
    var ldlt2_core_ren : logic     [128];
    var ldlt2_idx      : logic<7>       ;
    // M9.A.290: wider retire trace covering cy [22363000, 22364530].
    // 256 entries, wraps to keep latest. Helps see SFENCE / context switch
    // patterns immediately before OOPS at PC 0x8004a3c2 cy 22364524.
    var ret3_cy   : logic<32> [256];
    var ret3_pc   : logic<64> [256];
    var ret3_rd_v : logic     [256];
    var ret3_rd   : logic<5>  [256];
    var ret3_data : logic<64> [256];
    var ret3_idx  : logic<8>       ;
    // M9.A.290: SFENCE.VMA retire history (last 32) — capture cy + PC
    // + reg values that drive sfence args. Whole-boot ring (wraps).
    var sfence_cy : logic<32> [32];
    var sfence_pc : logic<64> [32];
    var sfence_idx: logic<5>      ;

    let in_uart_w: logic = dmem_wen && (dmem_addr[31:28] == 4'h1);

    always_ff (clk, rst) {
        if_reset {
            cy = 32'd0;
            ret_total = 32'd0;
            last_ret_cy = 32'd0;
            trap_cnt = 32'd0;
            first_trap_seen = 1'b0;
            first_trap_cy = 32'd0;
            first_trap_pc = 64'd0;
            first_trap_cause = 64'd0;
            trap_last_pc = 64'd0;
            trap_last_cause = 64'd0;
            lfault_seen = 1'b0;
            lfault_cy = 32'd0;
            lfault_pc = 64'd0;
            lfault_satp = 64'd0;
            lfault_tval = 64'd0;
            for i in 0..32 { lfault_regs[i] = 64'd0; }
            uart_wr_cnt = 32'd0;
            ecall_first_cy = 32'd0;
            ecall_seen = 1'b0;
            a5_ring_idx = 5'd0;
            a5_dumped = 1'b0;
            for k in 0..32 {
                a5_ring_pc[k] = 64'd0;
                a5_ring_cy[k] = 32'd0;
                a5_ring_data[k] = 64'd0;
            }
            a0_ring_idx = 6'd0;
            for k in 0..64 {
                a0_ring_pc[k] = 64'd0;
                a0_ring_cy[k] = 32'd0;
                a0_ring_data[k] = 64'd0;
            }
            snap_idx = 4'd0;
            for k in 0..8 {
                snap_cy[k] = 32'd0;
                snap_pc[k] = 64'd0;
            }
            for k in 0..256 { snap_regs[k] = 64'd0; }
            st428_ring_idx = 5'd0;
            for k in 0..32 {
                st428_ring_pc[k] = 64'd0;
                st428_ring_cy[k] = 32'd0;
                st428_ring_data[k] = 64'd0;
            }
            ld_ring_idx = 5'd0;
            for k in 0..32 {
                ld_ring_cy[k]   = 32'd0;
                ld_ring_pc[k]   = 64'd0;
                ld_ring_addr[k] = 64'd0;
                ld_ring_rdata[k] = 64'd0;
                ld_ring_ren[k]   = 1'b0;
                ld_ring_wen[k]   = 1'b0;
            }
            stwild_idx = 5'd0;
            for k in 0..32 {
                stwild_cy[k]   = 32'd0;
                stwild_pc[k]   = 64'd0;
                stwild_addr[k] = 64'd0;
            }
            f49dfe_idx = 5'd0;
            for k in 0..32 {
                f49dfe_cy[k] = 32'd0;
                f49dfe_a0[k] = 64'd0;
            }
            ldwild_idx = 6'd0;
            for k in 0..64 {
                ldwild_cy[k]   = 32'd0;
                ldwild_pc[k]   = 64'd0;
                ldwild_addr[k] = 64'd0;
            }
            ld4a874_idx = 4'd0;
            for k in 0..16 {
                ld4a874_cy[k]    = 32'd0;
                ld4a874_addr[k]  = 64'd0;
                ld4a874_rdata[k] = 64'd0;
            }
            st_ca3c38_idx = 5'd0;
            for k in 0..32 {
                st_ca3c38_cy[k]   = 32'd0;
                st_ca3c38_pc[k]   = 64'd0;
                st_ca3c38_data[k] = 64'd0;
            }
            cywin_idx = 6'd0;
            for k in 0..64 {
                cywin_cy[k]   = 32'd0;
                cywin_pc[k]   = 64'd0;
                cywin_rd_v[k] = 1'b0;
                cywin_rd[k]   = 5'd0;
                cywin_data[k] = 64'd0;
            }
            dmwin_idx = 6'd0;
            for k in 0..64 {
                dmwin_cy[k]    = 32'd0;
                dmwin_pc[k]    = 64'd0;
                dmwin_addr[k]  = 64'd0;
                dmwin_rdata[k] = 64'd0;
                dmwin_wdata[k] = 64'd0;
                dmwin_ren[k]   = 1'b0;
                dmwin_wen[k]   = 1'b0;
            }
            st_ca3c28_idx = 5'd0;
            for k in 0..32 {
                st_ca3c28_cy[k]   = 32'd0;
                st_ca3c28_pc[k]   = 64'd0;
                st_ca3c28_data[k] = 64'd0;
            }
            f49dfe_entry_idx = 8'd0;
            for k in 0..256 {
                f49dfe_entry_cy[k] = 32'd0;
                f49dfe_entry_ra[k] = 64'd0;
                f49dfe_entry_sp[k] = 64'd0;
            }
            f49894_entry_idx = 8'd0;
            for k in 0..256 {
                f49894_entry_cy[k] = 32'd0;
                f49894_entry_ra[k] = 64'd0;
                f49894_entry_sp[k] = 64'd0;
            }
            f49dfe_3c30_idx = 5'd0;
            f49894_3c30_idx = 5'd0;
            for k in 0..32 {
                f49dfe_3c30_cy[k] = 32'd0;
                f49dfe_3c30_ra[k] = 64'd0;
                f49894_3c30_cy[k] = 32'd0;
                f49894_3c30_ra[k] = 64'd0;
            }
            f4a7a2_idx = 7'd0;
            for k in 0..128 {
                f4a7a2_cy[k] = 32'd0;
                f4a7a2_ra[k] = 64'd0;
                f4a7a2_sp[k] = 64'd0;
                f4a7a2_s0[k] = 64'd0;
                stkst_cy[k]   = 32'd0;
                stkst_pc[k]   = 64'd0;
                stkst_addr[k] = 32'd0;
                stkst_data[k] = 64'd0;
            }
            stkst_idx = 7'd0;
            ret2_idx  = 8'd0;
            for k in 0..256 {
                ret2_cy[k]   = 32'd0;
                ret2_pc[k]   = 64'd0;
                ret2_rd_v[k] = 1'b0;
                ret2_rd[k]   = 5'd0;
                ret2_data[k] = 64'd0;
            }
            sp_ring_idx = 8'd0;
            for k in 0..256 {
                sp_ring_cy[k]   = 32'd0;
                sp_ring_pc[k]   = 64'd0;
                sp_ring_data[k] = 64'd0;
            }
            sp_agu_idx = 8'd0;
            for k in 0..256 {
                sp_agu_cy[k]   = 32'd0;
                sp_agu_robi[k] = 5'd0;
                sp_agu_arch[k] = 5'd0;
                sp_agu_pdst[k] = 6'd0;
                sp_agu_data[k] = 64'd0;
                sp_agu_imm[k]  = 64'd0;
                sp_agu_addr[k] = 64'd0;
                sp_agu_ld[k]   = 1'b0;
                sp_agu_st[k]   = 1'b0;
                sp_agu_busy[k] = 1'b0;
            }
            b3e08_idx = 6'd0;
            for k in 0..64 {
                b3e08_cy[k] = 32'd0;
                b3e08_sp[k] = 64'd0;
                b3e08_ra[k] = 64'd0;
            }
            trap_ring_idx = 7'd0;
            for k in 0..128 {
                trap_ring_cy[k]    = 32'd0;
                trap_ring_pc[k]    = 64'd0;
                trap_ring_cause[k] = 64'd0;
                trap_ring_tval[k]  = 64'd0;
                trap_ring_satp[k]  = 64'd0;
                trap_ring_to_s[k]  = 1'b0;
            }
            ldlt_idx = 6'd0;
            for k in 0..64 {
                ldlt_cy[k]    = 32'd0;
                ldlt_pc[k]    = 64'd0;
                ldlt_addr[k]  = 64'd0;
                ldlt_rdata[k] = 64'd0;
            }
            ldlt2_idx = 7'd0;
            for k in 0..128 {
                ldlt2_cy[k]       = 32'd0;
                ldlt2_pc[k]       = 64'd0;
                ldlt2_addr[k]     = 64'd0;
                ldlt2_va[k]       = 64'd0;
                ldlt2_iptw_req[k] = 1'b0;
                ldlt2_core_ren[k] = 1'b0;
            }
            ret3_idx = 8'd0;
            for k in 0..256 {
                ret3_cy[k]   = 32'd0;
                ret3_pc[k]   = 64'd0;
                ret3_rd_v[k] = 1'b0;
                ret3_rd[k]   = 5'd0;
                ret3_data[k] = 64'd0;
            }
            sfence_idx = 5'd0;
            for k in 0..32 {
                sfence_cy[k] = 32'd0;
                sfence_pc[k] = 64'd0;
            }
        } else {
            cy = cy + 32'd1;
            // M9.A.294: progress heartbeat (~every 512K cy). Lets the run be
            // monitored despite block-buffered stdout — a stalled cy means
            // hang, advancing cy + ret means forward progress.
            if cy[18:0] == 19'd0 {
                $display("v4 HEARTBEAT cy=%d ret=%d pc=%h trap=%d", cy, ret_total, dbg_pc, trap_cnt);
            }
            if _ret_v {
                ret_total = ret_total + 32'd1;
                last_ret_cy = cy;
            }
            if _ret_v && _ret_rd == 5'd15 && !a5_dumped {
                a5_ring_pc[a5_ring_idx]   = _ret_pc;
                a5_ring_cy[a5_ring_idx]   = cy;
                a5_ring_data[a5_ring_idx] = _ret_data;
                a5_ring_idx               = a5_ring_idx + 5'd1;
            }
            if _ret_v && _ret_rd == 5'd10 && !a5_dumped {
                a0_ring_pc[a0_ring_idx]   = _ret_pc;
                a0_ring_cy[a0_ring_idx]   = cy;
                a0_ring_data[a0_ring_idx] = _ret_data;
                a0_ring_idx               = a0_ring_idx + 6'd1;
            }
            // M9.A.273: snapshot regs at OOPS chain PCs.
            if _ret_v && !a5_dumped && (
                _ret_pc == 64'hffffffff800b41b2 ||  // function/loop start
                _ret_pc == 64'hffffffff800b40bc ||  // c.ld a0, 40(a0) — first wild a0
                _ret_pc == 64'hffffffff800b3dc6 ||  // c.sd s0, 32(a0) — store to 0x80d65428
                _ret_pc == 64'hffffffff800b40ec ||  // store wild ra to stack
                _ret_pc == 64'hffffffff800b406a ||  // c.ld a5, 40(a0)
                _ret_pc == 64'hffffffff800b406c ||  // c.beqz a5, +24
                _ret_pc == 64'hffffffff800b406e     // c.ld a1, 32(a5) — FAULT
            ) {
                snap_cy[snap_idx[2:0]] = cy;
                snap_pc[snap_idx[2:0]] = _ret_pc;
                // M9.A.273: circular ring (always overwrite, no max-cap).
                // Captures last 8 snapshots before lfault freeze — includes OOPS context.
                for s in 0..8 {
                    if snap_idx[2:0] == (s as 3) {
                        for r in 0..32 {
                            snap_regs[s * 32 + r] = dbg_regs[r];
                        }
                    }
                }
                snap_idx = snap_idx + 4'd1;
            }
            // Capture stores hitting the 8-byte dword containing PA 0x80d65428.
            // dmem_addr low 3 bits are the byte offset within the dword;
            // strip them with [31:3] == [31:3] of target. M9.A.260 found
            // a0 = ld 0x80d65428 returned wild 0xffffffff8009d8f2.
            if dmem_wen && (dmem_addr[31:3] == 32'h80d65428 >> 3) && !a5_dumped {
                st428_ring_pc[st428_ring_idx]   = dbg_pc;
                st428_ring_cy[st428_ring_idx]   = cy;
                st428_ring_data[st428_ring_idx] = dmem_wdata;
                st428_ring_idx                  = st428_ring_idx + 5'd1;
            }
            // M9.A.262: capture last 32 in-DRAM dmem accesses (any ren/wen).
            if (dmem_ren || dmem_wen) && dmem_addr[31] && !a5_dumped {
                ld_ring_cy[ld_ring_idx]   = cy;
                ld_ring_pc[ld_ring_idx]   = dbg_pc;
                ld_ring_addr[ld_ring_idx] = dmem_addr;
                ld_ring_rdata[ld_ring_idx] = dmem_rdata;
                ld_ring_ren[ld_ring_idx]   = dmem_ren;
                ld_ring_wen[ld_ring_idx]   = dmem_wen;
                ld_ring_idx                = ld_ring_idx + 5'd1;
            }
            // M9.A.289: capture loads in cy window around new OOPS at PC 0x8004a3c2 cy 22364524.
            if cy >: 32'd22364399 && cy <: 32'd22364531 && dmem_ren && !a5_dumped {
                ldlt_cy[ldlt_idx]    = cy;
                ldlt_pc[ldlt_idx]    = dbg_pc;
                ldlt_addr[ldlt_idx]  = dmem_addr;
                ldlt_rdata[ldlt_idx] = dmem_rdata;
                ldlt_idx             = ldlt_idx + 6'd1;
            }
            // M9.A.291: extended capture — distinguish IMMU PTW vs DMMU load.
            // Wider window cy [22364200, 22364530]. Records each dmem_ren
            // event with (dmem_addr, core_dmem_va, iptw_req, core_ren).
            if cy >: 32'd22364199 && cy <: 32'd22364531 && dmem_ren && !a5_dumped && ldlt2_idx <: 7'd127 {
                ldlt2_cy[ldlt2_idx]       = cy;
                ldlt2_pc[ldlt2_idx]       = dbg_pc;
                ldlt2_addr[ldlt2_idx]     = dmem_addr;
                ldlt2_va[ldlt2_idx]       = dbg_core_dmem_va;
                ldlt2_iptw_req[ldlt2_idx] = dbg_iptw_req;
                ldlt2_core_ren[ldlt2_idx] = dbg_core_dren;
                ldlt2_idx                 = ldlt2_idx + 7'd1;
            }
            // M9.A.290: wider retire trace cy [22363000, 22364530] (wraps).
            if cy >: 32'd22362999 && cy <: 32'd22364531 && _ret_v && !a5_dumped {
                ret3_cy[ret3_idx]   = cy;
                ret3_pc[ret3_idx]   = _ret_pc;
                ret3_rd_v[ret3_idx] = _ret_rdv;
                ret3_rd[ret3_idx]   = _ret_rd;
                ret3_data[ret3_idx] = _ret_data;
                ret3_idx            = ret3_idx + 8'd1;
            }
            // M9.A.278: capture stores whose data equals the wild value
            // 0xffffffff8009d8f2 — finds source store of OOPS-chain corruption.
            if dmem_wen && dmem_wdata == 64'hffffffff8009d8f2 && !a5_dumped {
                stwild_cy[stwild_idx]   = cy;
                stwild_pc[stwild_idx]   = dbg_pc;
                stwild_addr[stwild_idx] = dmem_addr;
                stwild_idx              = stwild_idx + 5'd1;
            }
            // M9.A.278: capture return values of kernel function 0x80049dfe.
            // PC 0x8004a842 retires right after `jal 0x80049dfe`; a0 = return.
            if _ret_v && _ret_pc == 64'hffffffff8004a842 && !a5_dumped {
                f49dfe_cy[f49dfe_idx] = cy;
                f49dfe_a0[f49dfe_idx] = dbg_regs[10];
                f49dfe_idx            = f49dfe_idx + 5'd1;
            }
            // M9.A.279: capture all loads returning 0xffffffff8009d8f2.
            // First such load brings wild value into a register.
            if dmem_ren && dmem_rdata == 64'hffffffff8009d8f2 && !a5_dumped {
                ldwild_cy[ldwild_idx]   = cy;
                ldwild_pc[ldwild_idx]   = dbg_pc;
                ldwild_addr[ldwild_idx] = dmem_addr;
                ldwild_idx              = ldwild_idx + 6'd1;
            }
            // M9.A.279: capture all loads at PC 0x8004a874 (ld s0, 8(sp))
            // where s0 became wild → propagated to a0 at PC 0x8004a878.
            if dmem_ren && dbg_pc == 64'hffffffff8004a874 && !a5_dumped {
                ld4a874_cy[ld4a874_idx]    = cy;
                ld4a874_addr[ld4a874_idx]  = dmem_addr;
                ld4a874_rdata[ld4a874_idx] = dmem_rdata;
                ld4a874_idx                = ld4a874_idx + 4'd1;
            }
            // M9.A.280: capture all stores to PA 0x80ca3c38 (8-byte aligned).
            // Tests whether kernel store reached this PA before the wild load.
            if dmem_wen && dmem_addr[31:3] == 32'h10194787 && !a5_dumped {
                st_ca3c38_cy[st_ca3c38_idx]   = cy;
                st_ca3c38_pc[st_ca3c38_idx]   = dbg_pc;
                st_ca3c38_data[st_ca3c38_idx] = dmem_wdata;
                st_ca3c38_idx                 = st_ca3c38_idx + 5'd1;
            }
            // M9.A.281: capture every retire in cy [21421780, 21421835] window.
            if cy >: 32'd21421779 && cy <: 32'd21421836 && _ret_v && !a5_dumped && cywin_idx <: 6'd63 {
                cywin_cy[cywin_idx]   = cy;
                cywin_pc[cywin_idx]   = _ret_pc;
                cywin_rd_v[cywin_idx] = _ret_rdv;
                cywin_rd[cywin_idx]   = _ret_rd;
                cywin_data[cywin_idx] = _ret_data;
                cywin_idx             = cywin_idx + 6'd1;
            }
            // M9.A.281: capture every dmem access in cy [21421780, 21421835].
            if cy >: 32'd21421779 && cy <: 32'd21421836 && (dmem_ren || dmem_wen) && !a5_dumped && dmwin_idx <: 6'd63 {
                dmwin_cy[dmwin_idx]    = cy;
                dmwin_pc[dmwin_idx]    = dbg_pc;
                dmwin_addr[dmwin_idx]  = dmem_addr;
                dmwin_rdata[dmwin_idx] = dmem_rdata;
                dmwin_wdata[dmwin_idx] = dmem_wdata;
                dmwin_ren[dmwin_idx]   = dmem_ren;
