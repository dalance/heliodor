// Phase 7 v4 real Linux boot integration test.
//
// Boots the real Linux v5.15 kernel image through SBI firmware on the
// clean-redesign v4 OoO core. Uses the same hex as v1's test_linux_boot
// (linux_boot_fw.hex + linux_dram_real.hex, ~11 MB DRAM image).
//
// Marked #[ignore] because it takes a long time. Run explicitly with:
//   veryl test --ignored --test test_v4_linux_boot
//
// Memory map (matches v1 test_linux_boot):
//   PA 0x00000000 : Firmware ROM (16 KB, linux_boot_fw.hex)
//   PA 0x02000000 : CLINT (internal)
//   PA 0x10000000 : UART (internal stub — prints via $write)
//   PA 0x80000000 : DRAM (32 MB, kernel + DTB from linux_dram_real.hex)
//
// Pass condition: x3 register reaches 0xAA (SBI SRST shutdown).
module test_v4_linux_boot_harness (
    clk      : input  clock    ,
    rst      : input  reset    ,
    o_pass   : output logic    ,
    o_r3     : output logic<64>,
    o_cy     : output logic<32>,
    o_ret    : output logic<32>,
    o_lrc    : output logic<32>,
    o_trapcnt: output logic<32>,
    o_lf     : output logic    ,
    o_lpc    : output logic<64>,
    o_ftpc   : output logic<64>,
    o_fcause : output logic<64>,
    o_tlpc   : output logic<64>,
    o_tlcause: output logic<64>,
    o_satp   : output logic<64>,
    o_priv   : output logic<2> ,
    o_pc     : output logic<64>,
    o_uart   : output logic<32>,
    o_ecall  : output logic<32>,
) {
    var imem_addr      : logic<64>     ;
    var imem_rdata     : logic<32>     ;
    var imem_ren       : logic         ;
    var dmem_addr      : logic<64>     ;
    var dmem_wdata     : logic<64>     ;
    var dmem_rdata     : logic<64>     ;
    var dmem_rdata_next: logic<64>     ;
    var dmem_wen       : logic         ;
    var dmem_ren       : logic         ;
    var dmem_wstrb     : logic<8>      ;
    var dmem_wdata_hi  : logic<64>     ;
    var dmem_wstrb_hi  : logic<8>      ;
    var dbg_regs       : logic<64> [32];
    var dbg_pc         : logic<64>     ;
    var dbg_sepc      : logic<64>; var dbg_mepc: logic<64>; var dbg_priv: logic<2>;
    var dbg_trap_fire : logic    ; var dbg_trap_pc: logic<64>;
    var dbg_trap_cause: logic<64>; var dbg_trap_to_s: logic;
    var dbg_satp      : logic<64>; var dbg_imem_vaddr: logic<64>; var dbg_imem_paddr: logic<64>;
    var dbg_imem_valid: logic    ; var dbg_imem_fault: logic;
    var dbg_csrwr_v   : logic    ;
    var dbg_csrwr_addr: logic<12>;
    var dbg_csrwr_wdata:logic<64>;
    var dbg_ptw_req   : logic    ; var dbg_ptw_addr : logic<64>; var dbg_ptw_data : logic<64>;
    var dbg_redir_v   : logic;
    var dbg_redir_pc  : logic<64>;
    var dbg_redir_src : logic<64>;
    var dbg_alu_pc    : logic<64>;
    var dbg_alu_src_a : logic<64>;
    var dbg_alu_src_b : logic<64>;
    var dbg_alu_use_pc_a: logic;
    var dbg_alu_rs1_data: logic<64>;
    var dbg_alu_valid   : logic    ;
    var dbg_alu_alu_out : logic<64>;
    var dbg_alu_instr   : logic<32>;
    var dbg_alu_imm     : logic<64>;
    var dbg_stval     : logic<64>;
    var dbg_mtval     : logic<64>;
    var dbg_dmm_busy  : logic    ;
    var dbg_iptw_req  : logic    ;
    var dbg_core_dren : logic    ;
    var _ret_v: logic; var _ret_pc: logic<64>; var _ret_rdv: logic; var _ret_rd: logic<5>; var _ret_data: logic<64>;
    var _rename_cnt: logic<32>; var _cdb_cnt: logic<32>; var _rob_size: logic<8>;
    var _if_v: logic; var _if_instr: logic<32>; var _stall_dr: logic;
    var _head_valid: logic; var _head_rw: logic; var _head_il: logic;
    var _r_alloc: logic<32>; var _r_cdb: logic<32>; var _r_commit: logic<32>;
    var _r_head: logic<6>; var _r_tail: logic<6>;

    // CLINT signals
    var clint_rdata    : logic<64>     ;
    var clint_timer_irq: logic [1]     ;
    var clint_sw_irq   : logic [1]     ;
    var clint_mtime    : logic<64>     ;

    inst dut: heliodor_core_v4 #(
        RESET_PC: 64'h00000000,
    ) (
        clk                            ,
        rst                            ,
        o_imem_addr        : imem_addr      ,
        i_imem_rdata       : imem_rdata     ,
        o_imem_ren         : imem_ren       ,
        o_dmem_addr        : dmem_addr      ,
        o_dmem_wdata       : dmem_wdata     ,
        i_dmem_rdata       : dmem_rdata     ,
        i_dmem_rdata_next  : dmem_rdata_next,
        o_dmem_wen         : dmem_wen       ,
        o_dmem_ren         : dmem_ren       ,
        o_dmem_wstrb       : dmem_wstrb     ,
        o_dmem_wdata_hi    : dmem_wdata_hi  ,
        o_dmem_wstrb_hi    : dmem_wstrb_hi  ,
        i_irq_timer_m      : clint_timer_irq[0],
        i_mtime            : clint_mtime    ,
        i_irq_sw_m         : clint_sw_irq[0]   ,
        i_irq_ext_m        : 1'b0              ,
        o_dbg_pc           : dbg_pc     ,
        o_dbg_regs         : dbg_regs   ,
        o_dbg_retire_v_a   : _ret_v      ,
        o_dbg_retire_pc_a  : _ret_pc     ,
        o_dbg_retire_rd_v_a: _ret_rdv    ,
        o_dbg_retire_rd_a  : _ret_rd     ,
        o_dbg_retire_data_a: _ret_data   ,
        o_dbg_rename_cnt   : _rename_cnt ,
        o_dbg_cdb_cnt      : _cdb_cnt    ,
        o_dbg_rob_size     : _rob_size   ,
        o_dbg_if_v         : _if_v       ,
        o_dbg_if_instr     : _if_instr   ,
        o_dbg_stall_dr     : _stall_dr   ,
        o_dbg_head_valid   : _head_valid ,
        o_dbg_head_rw      : _head_rw    ,
        o_dbg_head_illegal : _head_il    ,
        o_dbg_rob_alloc_cnt: _r_alloc    ,
        o_dbg_rob_cdb_cnt  : _r_cdb      ,
        o_dbg_rob_commit_cnt: _r_commit  ,
        o_dbg_rob_head     : _r_head     ,
        o_dbg_rob_tail     : _r_tail     ,
        o_dbg_sepc         : dbg_sepc, o_dbg_mepc: dbg_mepc, o_dbg_priv: dbg_priv,
        o_dbg_trap_fire    : dbg_trap_fire, o_dbg_trap_pc: dbg_trap_pc,
        o_dbg_trap_cause   : dbg_trap_cause, o_dbg_trap_to_s: dbg_trap_to_s,
        o_dbg_satp         : dbg_satp, o_dbg_imem_vaddr: dbg_imem_vaddr, o_dbg_imem_paddr: dbg_imem_paddr,
        o_dbg_imem_valid   : dbg_imem_valid, o_dbg_imem_fault: dbg_imem_fault,
        o_dbg_csrwr_v      : dbg_csrwr_v, o_dbg_csrwr_addr: dbg_csrwr_addr, o_dbg_csrwr_wdata: dbg_csrwr_wdata,
        o_dbg_ptw_req      : dbg_ptw_req, o_dbg_ptw_addr: dbg_ptw_addr, o_dbg_ptw_data: dbg_ptw_data,
        o_dbg_redirect_fire: dbg_redir_v, o_dbg_redirect_pc: dbg_redir_pc, o_dbg_redirect_src_pc: dbg_redir_src,
        o_dbg_alu_pc_out: dbg_alu_pc, o_dbg_alu_src_a_out: dbg_alu_src_a, o_dbg_alu_src_b_out: dbg_alu_src_b, o_dbg_alu_use_pc_a_out: dbg_alu_use_pc_a, o_dbg_alu_rs1_data_out: dbg_alu_rs1_data, o_dbg_alu_valid_out: dbg_alu_valid, o_dbg_alu_alu_out_out: dbg_alu_alu_out, o_dbg_alu_instr_out: dbg_alu_instr, o_dbg_alu_imm_out: dbg_alu_imm, o_dbg_stval_out: dbg_stval, o_dbg_mtval_out: dbg_mtval,
        o_dbg_dmem_mmu_busy: dbg_dmm_busy, o_dbg_core_dmem_vaddr: _,
        o_dbg_core_dmem_wen: _, o_dbg_core_dmem_ren: dbg_core_dren,
        o_dbg_imem_ptw_req: dbg_iptw_req, o_dbg_commit_store_fire: _,
    );

    // Firmware ROM: 16 KB
    var fw_rom: logic<32> [4096];
    // DRAM: 32 MB (Linux kernel + DTB)
    var dram: logic<32> [8388608];
    initial {
        $readmemh("test/hex/linux_boot_fw.hex", fw_rom);
        // M9 (2026-05-25): v4-specific kernel binary patch — replaces two
        // PC-relative la gp sequences (PA 0x80001050, 0x80001088) with
        // absolute LUI+ADDI so gp = 0xffffffff80a85c20 regardless of which
        // PC half the code runs at. The original kernel head.S relies on a
        // TLB-eviction-induced trap to re-execute `la gp` at high-half PC
        // (= v1 behavior). v4's IFU + MMU walk fresh after csrw satp, so
        // no trap fires, gp stays low-half, kernel OOPSes. See
        // project_phase7_v4_m9_blocker.md.
        $readmemh("test/hex/linux_dram_real.hex", dram);
    }

    let imem_in_fw : logic = imem_addr[31:14] == 18'd0;
    let in_fw      : logic = dmem_addr[31:14] == 18'd0;
    let in_dram    : logic = dmem_addr[31];
    let in_uart    : logic = dmem_addr[31:28] == 4'h1;
    let in_clint   : logic = dmem_addr[31:24] == 8'h02;

    let dram_imem_idx: logic<23> = imem_addr[24:2];
    let fw_imem_idx  : logic<12> = imem_addr[13:2];
    assign imem_rdata = if imem_in_fw ? fw_rom[fw_imem_idx]
                        : if imem_addr[31] ? dram[dram_imem_idx]
                        : 32'd0;

    let dram_dmem_lo : logic<23> = {dmem_addr[24:3], 1'b0};
    let dram_dmem_hi : logic<23> = {dmem_addr[24:3], 1'b1};
    let dram_dmem_nx_lo: logic<23> = {(dmem_addr[24:3] + 22'd1), 1'b0};
    let dram_dmem_nx_hi: logic<23> = {(dmem_addr[24:3] + 22'd1), 1'b1};
    let fw_dmem_lo  : logic<12> = {dmem_addr[13:3], 1'b0};
    let fw_dmem_hi  : logic<12> = {dmem_addr[13:3], 1'b1};

    assign dmem_rdata = if in_dram ? {dram[dram_dmem_hi], dram[dram_dmem_lo]}
                        : if in_fw   ? {fw_rom[fw_dmem_hi], fw_rom[fw_dmem_lo]}
                        : if in_clint ? clint_rdata
                        : 64'd0;
    assign dmem_rdata_next = if in_dram ? {dram[dram_dmem_nx_hi], dram[dram_dmem_nx_lo]}
                             : 64'd0;

    inst u_clint: clint #(N_HARTS: 1) (
        clk            ,
        rst            ,
        i_addr     : dmem_addr[15:0],
        i_wdata    : dmem_wdata     ,
        i_wen      : dmem_wen && in_clint,
        i_ren      : dmem_ren && in_clint,
        o_rdata    : clint_rdata    ,
        o_timer_irq: clint_timer_irq,
        o_sw_irq   : clint_sw_irq   ,
        o_mtime    : clint_mtime    ,
    );
    let _unused_mtime: logic<64> = clint_mtime;
    let _unused_t_irq: logic = clint_timer_irq[0];
    let _unused_s_irq: logic = clint_sw_irq[0];

    always_ff (clk, rst) {
        if_reset {} else if dmem_wen && in_dram {
            if dmem_wstrb[0] { dram[dram_dmem_lo][7:0]   = dmem_wdata[7:0];   }
            if dmem_wstrb[1] { dram[dram_dmem_lo][15:8]  = dmem_wdata[15:8];  }
            if dmem_wstrb[2] { dram[dram_dmem_lo][23:16] = dmem_wdata[23:16]; }
            if dmem_wstrb[3] { dram[dram_dmem_lo][31:24] = dmem_wdata[31:24]; }
            if dmem_wstrb[4] { dram[dram_dmem_hi][7:0]   = dmem_wdata[39:32]; }
            if dmem_wstrb[5] { dram[dram_dmem_hi][15:8]  = dmem_wdata[47:40]; }
            if dmem_wstrb[6] { dram[dram_dmem_hi][23:16] = dmem_wdata[55:48]; }
            if dmem_wstrb[7] { dram[dram_dmem_hi][31:24] = dmem_wdata[63:56]; }
            if dmem_wstrb_hi[0] { dram[dram_dmem_nx_lo][7:0]   = dmem_wdata_hi[7:0];   }
            if dmem_wstrb_hi[1] { dram[dram_dmem_nx_lo][15:8]  = dmem_wdata_hi[15:8];  }
            if dmem_wstrb_hi[2] { dram[dram_dmem_nx_lo][23:16] = dmem_wdata_hi[23:16]; }
            if dmem_wstrb_hi[3] { dram[dram_dmem_nx_lo][31:24] = dmem_wdata_hi[31:24]; }
            if dmem_wstrb_hi[4] { dram[dram_dmem_nx_hi][7:0]   = dmem_wdata_hi[39:32]; }
            if dmem_wstrb_hi[5] { dram[dram_dmem_nx_hi][15:8]  = dmem_wdata_hi[47:40]; }
            if dmem_wstrb_hi[6] { dram[dram_dmem_nx_hi][23:16] = dmem_wdata_hi[55:48]; }
            if dmem_wstrb_hi[7] { dram[dram_dmem_nx_hi][31:24] = dmem_wdata_hi[63:56]; }
        } else if dmem_wen && in_uart {
            if dmem_wstrb[0] { $write("%c", dmem_wdata[7:0]); }
            if dmem_wstrb[1] { $write("%c", dmem_wdata[15:8]); }
            if dmem_wstrb[2] { $write("%c", dmem_wdata[23:16]); }
            if dmem_wstrb[3] { $write("%c", dmem_wdata[31:24]); }
            if dmem_wstrb[4] { $write("%c", dmem_wdata[39:32]); }
            if dmem_wstrb[5] { $write("%c", dmem_wdata[47:40]); }
            if dmem_wstrb[6] { $write("%c", dmem_wdata[55:48]); }
            if dmem_wstrb[7] { $write("%c", dmem_wdata[63:56]); }
        }
    }

    // Minimal v4 boot trace: cy counter + cause=13 first-trap snapshot +
    // a5 (rd=15) write ring frozen at first cause=13 trap. All other
    // per-PC $display blocks and heavyweight rings (s2/a0/ret_pc/fetch/
    // PTW/CSR/etc.) removed for sim speed — they were debugging the
    // M9.A.258 memmap bug which is now resolved.
    assign o_r3   = dbg_regs[3];
    assign o_pass = dbg_regs[3] == 64'hAA;

    var cy             : logic<32>;
    var ret_total      : logic<32>;
    var last_ret_cy    : logic<32>;
    var trap_cnt       : logic<32>;
    var first_trap_seen: logic    ;
    var first_trap_cy  : logic<32>;
    var first_trap_pc  : logic<64>;
    var first_trap_cause: logic<64>;
    var trap_last_pc   : logic<64>;
    var trap_last_cause: logic<64>;
    var lfault_seen    : logic    ;
    var lfault_cy      : logic<32>;
    var lfault_pc      : logic<64>;
    var lfault_satp    : logic<64>;
    var lfault_tval    : logic<64>;
    var lfault_regs    : logic<64> [32];
    var uart_wr_cnt    : logic<32>;
    var ecall_first_cy : logic<32>;
    var ecall_seen     : logic    ;

    // M9.A.259: a5 (rd=15) write ring — 32 entries, frozen at first
    // cause=13 trap. Used to find which instruction wrote the bogus
    // a5=0x05253023c12154d1 leading to the userspace-init OOPS at
    // PC 0x800b406e (c.ld a1, 32(a5)).
    var a5_ring_pc  : logic<64> [32];
    var a5_ring_cy  : logic<32> [32];
    var a5_ring_data: logic<64> [32];
    var a5_ring_idx : logic<5>      ;
    var a5_dumped   : logic         ;
    // M9.A.260: a0 (rd=10) write ring — 64 entries, frozen at first
    // cause=13 trap. Find which load wrote a0=0xffffffff8009d8f2
    // (= the wild kernel-text pointer that propagated through s1/s2).
    var a0_ring_pc  : logic<64> [64];
    var a0_ring_cy  : logic<32> [64];
    var a0_ring_data: logic<64> [64];
    var a0_ring_idx : logic<6>      ;
    // M9.A.273: full reg snapshot at OOPS chain PCs. Captures cy + 32 regs
    // at retire of each suspect PC, frozen at first cause=13. Compare with
    // v1 boot retires at same PCs to identify register-state divergence.
    // 8 slots × 32 regs × 64 bits = 2 KB.
    var snap_cy   : logic<32> [8];
    var snap_pc   : logic<64> [8];
    var snap_regs : logic<64> [256]; // flattened: slot*32 + reg
    var snap_idx  : logic<4>      ;
    // M9.A.261: ALL stores to PA 0x80d65428 (= the addr that returned
    // wild 0xffffffff8009d8f2 in M9.A.260). Identifies the kernel writer
    // and expected value (or absence of writer = uninitialized read).
    var st428_ring_pc  : logic<64> [32];
    var st428_ring_cy  : logic<32> [32];
    var st428_ring_data: logic<64> [32];
    var st428_ring_idx : logic<5>      ;
    // M9.A.262: ring of last 32 in-DRAM dmem activity (ren or wen).
    // Captures dmem_addr + dmem_rdata at every dram access, frozen at
    // lfault. Used to verify whether v4's PC 0x800b40bc load (around
    // cy 21421947) sent dmem_addr=0x80d65428 (correct, then dram race)
    // or some other PA (mmu translation race).
    var ld_ring_cy   : logic<32> [32];
    var ld_ring_pc   : logic<64> [32];
    var ld_ring_addr : logic<64> [32];
    var ld_ring_rdata: logic<64> [32];
    var ld_ring_ren  : logic     [32];
    var ld_ring_wen  : logic     [32];
    var ld_ring_idx  : logic<5>      ;

    let in_uart_w: logic = dmem_wen && (dmem_addr[31:28] == 4'h1);

    always_ff (clk, rst) {
        if_reset {
            cy = 32'd0;
            ret_total = 32'd0;
            last_ret_cy = 32'd0;
            trap_cnt = 32'd0;
            first_trap_seen = 1'b0;
            first_trap_cy = 32'd0;
            first_trap_pc = 64'd0;
            first_trap_cause = 64'd0;
            trap_last_pc = 64'd0;
            trap_last_cause = 64'd0;
            lfault_seen = 1'b0;
            lfault_cy = 32'd0;
            lfault_pc = 64'd0;
            lfault_satp = 64'd0;
            lfault_tval = 64'd0;
            for i in 0..32 { lfault_regs[i] = 64'd0; }
            uart_wr_cnt = 32'd0;
            ecall_first_cy = 32'd0;
            ecall_seen = 1'b0;
            a5_ring_idx = 5'd0;
            a5_dumped = 1'b0;
            for k in 0..32 {
                a5_ring_pc[k] = 64'd0;
                a5_ring_cy[k] = 32'd0;
                a5_ring_data[k] = 64'd0;
            }
            a0_ring_idx = 6'd0;
            for k in 0..64 {
                a0_ring_pc[k] = 64'd0;
                a0_ring_cy[k] = 32'd0;
                a0_ring_data[k] = 64'd0;
            }
            snap_idx = 4'd0;
            for k in 0..8 {
                snap_cy[k] = 32'd0;
                snap_pc[k] = 64'd0;
            }
            for k in 0..256 { snap_regs[k] = 64'd0; }
            st428_ring_idx = 5'd0;
            for k in 0..32 {
                st428_ring_pc[k] = 64'd0;
                st428_ring_cy[k] = 32'd0;
                st428_ring_data[k] = 64'd0;
            }
            ld_ring_idx = 5'd0;
            for k in 0..32 {
                ld_ring_cy[k]   = 32'd0;
                ld_ring_pc[k]   = 64'd0;
                ld_ring_addr[k] = 64'd0;
                ld_ring_rdata[k] = 64'd0;
                ld_ring_ren[k]   = 1'b0;
                ld_ring_wen[k]   = 1'b0;
            }
        } else {
            cy = cy + 32'd1;
            if _ret_v {
                ret_total = ret_total + 32'd1;
                last_ret_cy = cy;
            }
            if _ret_v && _ret_rd == 5'd15 && !a5_dumped {
                a5_ring_pc[a5_ring_idx]   = _ret_pc;
                a5_ring_cy[a5_ring_idx]   = cy;
                a5_ring_data[a5_ring_idx] = _ret_data;
                a5_ring_idx               = a5_ring_idx + 5'd1;
            }
            if _ret_v && _ret_rd == 5'd10 && !a5_dumped {
                a0_ring_pc[a0_ring_idx]   = _ret_pc;
                a0_ring_cy[a0_ring_idx]   = cy;
                a0_ring_data[a0_ring_idx] = _ret_data;
                a0_ring_idx               = a0_ring_idx + 6'd1;
            }
            // M9.A.273: snapshot regs at OOPS chain PCs.
            if _ret_v && !a5_dumped && (
                _ret_pc == 64'hffffffff800b41b2 ||  // function/loop start
                _ret_pc == 64'hffffffff800b40bc ||  // c.ld a0, 40(a0) — first wild a0
                _ret_pc == 64'hffffffff800b3dc6 ||  // c.sd s0, 32(a0) — store to 0x80d65428
                _ret_pc == 64'hffffffff800b40ec ||  // store wild ra to stack
                _ret_pc == 64'hffffffff800b406a ||  // c.ld a5, 40(a0)
                _ret_pc == 64'hffffffff800b406c ||  // c.beqz a5, +24
                _ret_pc == 64'hffffffff800b406e     // c.ld a1, 32(a5) — FAULT
            ) {
                snap_cy[snap_idx[2:0]] = cy;
                snap_pc[snap_idx[2:0]] = _ret_pc;
                // M9.A.273: circular ring (always overwrite, no max-cap).
                // Captures last 8 snapshots before lfault freeze — includes OOPS context.
                for s in 0..8 {
                    if snap_idx[2:0] == (s as 3) {
                        for r in 0..32 {
                            snap_regs[s * 32 + r] = dbg_regs[r];
                        }
                    }
                }
                snap_idx = snap_idx + 4'd1;
            }
            // Capture stores hitting the 8-byte dword containing PA 0x80d65428.
            // dmem_addr low 3 bits are the byte offset within the dword;
            // strip them with [31:3] == [31:3] of target. M9.A.260 found
            // a0 = ld 0x80d65428 returned wild 0xffffffff8009d8f2.
            if dmem_wen && (dmem_addr[31:3] == 32'h80d65428 >> 3) && !a5_dumped {
                st428_ring_pc[st428_ring_idx]   = dbg_pc;
                st428_ring_cy[st428_ring_idx]   = cy;
                st428_ring_data[st428_ring_idx] = dmem_wdata;
                st428_ring_idx                  = st428_ring_idx + 5'd1;
            }
            // M9.A.262: capture last 32 in-DRAM dmem accesses (any ren/wen).
            if (dmem_ren || dmem_wen) && dmem_addr[31] && !a5_dumped {
                ld_ring_cy[ld_ring_idx]   = cy;
                ld_ring_pc[ld_ring_idx]   = dbg_pc;
                ld_ring_addr[ld_ring_idx] = dmem_addr;
                ld_ring_rdata[ld_ring_idx] = dmem_rdata;
                ld_ring_ren[ld_ring_idx]   = dmem_ren;
                ld_ring_wen[ld_ring_idx]   = dmem_wen;
                ld_ring_idx                = ld_ring_idx + 5'd1;
            }
            if dbg_trap_fire {
                trap_cnt = trap_cnt + 32'd1;
                trap_last_pc = dbg_trap_pc;
                trap_last_cause = dbg_trap_cause;
                if !first_trap_seen {
                    first_trap_seen = 1'b1;
                    first_trap_cy = cy;
                    first_trap_pc = dbg_trap_pc;
                    first_trap_cause = dbg_trap_cause;
                }
                if dbg_trap_cause == 64'd13 && !lfault_seen {
                    lfault_seen = 1'b1;
                    lfault_cy = cy;
                    lfault_pc = dbg_trap_pc;
                    lfault_satp = dbg_satp;
                    lfault_tval = if dbg_trap_to_s ? dbg_stval : dbg_mtval;
                    for i in 0..32 { lfault_regs[i] = dbg_regs[i]; }
                }
                if !ecall_seen && (dbg_trap_cause == 64'd8 || dbg_trap_cause == 64'd9 || dbg_trap_cause == 64'd11) {
                    ecall_seen = 1'b1;
                    ecall_first_cy = cy;
                }
            }
            if lfault_seen && !a5_dumped {
                a5_dumped = 1'b1;
                $display("[v4 LOAD PAGE FAULT cause=13] cy=%d pc=%h tval=%h satp=%h",
                          lfault_cy, lfault_pc, lfault_tval, lfault_satp);
                $display("  regs: a0=%h a1=%h a2=%h a3=%h a4=%h a5=%h a6=%h a7=%h",
                          lfault_regs[10], lfault_regs[11], lfault_regs[12], lfault_regs[13],
                          lfault_regs[14], lfault_regs[15], lfault_regs[16], lfault_regs[17]);
                $display("  regs: s0=%h s1=%h s2=%h s3=%h s4=%h s5=%h",
                          lfault_regs[8], lfault_regs[9], lfault_regs[18], lfault_regs[19],
                          lfault_regs[20], lfault_regs[21]);
                $display("  regs: s6=%h s7=%h s8=%h s9=%h s10=%h s11=%h",
                          lfault_regs[22], lfault_regs[23], lfault_regs[24], lfault_regs[25],
                          lfault_regs[26], lfault_regs[27]);
                $display("[v4 a5 ring last 32 writes (oldest first)]");
                for k in 0..32 {
                    let off: logic<5> = a5_ring_idx + k;
                    $display("  a5[%h] cy=%d pc=%h data=%h",
                              k, a5_ring_cy[off], a5_ring_pc[off], a5_ring_data[off]);
                }
                $display("[v4 a0 ring last 64 writes (oldest first)]");
                for k in 0..64 {
                    let off: logic<6> = a0_ring_idx + k;
                    $display("  a0[%h] cy=%d pc=%h data=%h",
                              k, a0_ring_cy[off], a0_ring_pc[off], a0_ring_data[off]);
                }
                $display("[v4 stores to dword @0x80d65428 last 32 (oldest first)]");
                for k in 0..32 {
                    let off: logic<5> = st428_ring_idx + k;
                    $display("  st428[%h] cy=%d pc=%h wdata=%h",
                              k, st428_ring_cy[off], st428_ring_pc[off], st428_ring_data[off]);
                }
                $display("[v4 in-DRAM dmem activity last 32 (oldest first)]");
                for k in 0..32 {
                    let off: logic<5> = ld_ring_idx + k;
                    $display("  ld[%h] cy=%d pc=%h addr=%h rdata=%h ren=%b wen=%b",
                              k, ld_ring_cy[off], ld_ring_pc[off], ld_ring_addr[off],
                              ld_ring_rdata[off], ld_ring_ren[off], ld_ring_wen[off]);
                }
                $display("[v4 OOPS chain PC reg snapshots (circular, last 8, oldest first by ring offset)]");
                for k in 0..8 {
                    let off: logic<3> = snap_idx[2:0] + (k as 3);
                    $display("  snap[%h] cy=%d pc=%h", k, snap_cy[off], snap_pc[off]);
                    $display("    a0=%h a1=%h a2=%h a3=%h a4=%h a5=%h a6=%h a7=%h",
                              snap_regs[off * 32 +10], snap_regs[off * 32 +11], snap_regs[off * 32 +12], snap_regs[off * 32 +13],
                              snap_regs[off * 32 +14], snap_regs[off * 32 +15], snap_regs[off * 32 +16], snap_regs[off * 32 +17]);
                    $display("    s0=%h s1=%h s2=%h s3=%h s4=%h s5=%h s6=%h s7=%h",
                              snap_regs[off * 32 +8], snap_regs[off * 32 +9], snap_regs[off * 32 +18], snap_regs[off * 32 +19],
                              snap_regs[off * 32 +20], snap_regs[off * 32 +21], snap_regs[off * 32 +22], snap_regs[off * 32 +23]);
                    $display("    s8=%h s9=%h s10=%h s11=%h ra=%h sp=%h gp=%h tp=%h",
                              snap_regs[off * 32 +24], snap_regs[off * 32 +25], snap_regs[off * 32 +26], snap_regs[off * 32 +27],
                              snap_regs[off * 32 +1], snap_regs[off * 32 +2], snap_regs[off * 32 +3], snap_regs[off * 32 +4]);
                }
            }
            if in_uart_w {
                uart_wr_cnt = uart_wr_cnt + 32'd1;
            }
            // M9.A.275/276: per-cycle dmem + alu activity around cy 21421946
            // (suspect load PC 0x800b40bc). alu_src_a + alu_rs1_data show
            // PRF read value — verify if a0 read matches a0_ring's value.
            if cy >: 32'd21421940 && cy <: 32'd21421965 {
                $display("[v4 cy=%d] dmem_addr=%h ren=%b wen=%b rdata=%h alu_v=%b alu_pc=%h alu_out=%h alu_src_a=%h alu_src_b=%h alu_rs1=%h alu_imm=%h alu_instr=%h dbg_pc=%h",
                          cy, dmem_addr, dmem_ren, dmem_wen, dmem_rdata,
                          dbg_alu_valid, dbg_alu_pc, dbg_alu_alu_out,
                          dbg_alu_src_a, dbg_alu_src_b, dbg_alu_rs1_data, dbg_alu_imm,
                          dbg_alu_instr, dbg_pc);
            }
        }
    }

    assign o_cy      = cy;
    assign o_ret     = ret_total;
    assign o_lrc     = last_ret_cy;
    assign o_trapcnt = trap_cnt;
    assign o_lf      = lfault_seen;
    assign o_lpc     = lfault_pc;
    assign o_ftpc    = first_trap_pc;
    assign o_fcause  = first_trap_cause;
    assign o_tlpc    = trap_last_pc;
    assign o_tlcause = trap_last_cause;
    assign o_satp    = dbg_satp;
    assign o_priv    = dbg_priv;
    assign o_pc      = dbg_pc;
    assign o_uart    = uart_wr_cnt;
    assign o_ecall   = ecall_first_cy;
}

#[test(test_v4_linux_boot)]
#[ignore]
module test_v4_linux_boot {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen(clk);

    var pass: logic;
    var r3  : logic<64>;
    var s_cy     : logic<32>;
    var s_ret    : logic<32>;
    var s_lrc    : logic<32>;
    var s_trapcnt: logic<32>;
    var s_lf     : logic    ;
    var s_lpc    : logic<64>;
    var s_ftpc   : logic<64>;
    var s_fcause : logic<64>;
    var s_tlpc   : logic<64>;
    var s_tlcause: logic<64>;
    var s_satp   : logic<64>;
    var s_priv   : logic<2> ;
    var s_pc     : logic<64>;
    var s_uart   : logic<32>;
    var s_ecall  : logic<32>;

    inst harness: test_v4_linux_boot_harness (
        clk             ,
        rst             ,
        o_pass   : pass     ,
        o_r3     : r3       ,
        o_cy     : s_cy     ,
        o_ret    : s_ret    ,
        o_lrc    : s_lrc    ,
        o_trapcnt: s_trapcnt,
        o_lf     : s_lf     ,
        o_lpc    : s_lpc    ,
        o_ftpc   : s_ftpc   ,
        o_fcause : s_fcause ,
        o_tlpc   : s_tlpc   ,
        o_tlcause: s_tlcause,
        o_satp   : s_satp   ,
        o_priv   : s_priv   ,
        o_pc     : s_pc     ,
        o_uart   : s_uart   ,
        o_ecall  : s_ecall  ,
    );

    initial {
        rst.assert(clk);
        clk.next  (25_000_000); // 25M cy — M9.A.259: OOPS at cy ~21.4M (post-M9.A.258 fix). v4 sim ~7K cy/sec → ~60min
        $display  ("v4 SUMMARY cy=%h ret=%h lrc=%h trap=%h pri=%h satp=%h pc=%h", s_cy, s_ret, s_lrc, s_trapcnt, s_priv, s_satp, s_pc);
        $display  ("v4 SUMMARY lf=%b lpc=%h ftpc=%h fcause=%h tlpc=%h tlcause=%h", s_lf, s_lpc, s_ftpc, s_fcause, s_tlpc, s_tlcause);
        $display  ("v4 SUMMARY uart=%h ecall=%h", s_uart, s_ecall);
        $display  ("v4 linux real boot smoke: x3=%h pass=%b", r3, pass);
        $finish   ();
    }
}
