            // pre-retire value (= caller_sp before the prologue addi).
            if _ret_v && _ret_pc == 64'hffffffff80049dfe && !a5_dumped {
                f49dfe_entry_cy[f49dfe_entry_idx] = cy;
                f49dfe_entry_ra[f49dfe_entry_idx] = dbg_regs[1];
