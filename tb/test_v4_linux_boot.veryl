// Phase 7 v4 real Linux boot integration test.
//
// Boots the real Linux v5.15 kernel image through SBI firmware on the
// clean-redesign v4 OoO core. Uses the same hex as v1's test_linux_boot
// (linux_boot_fw.hex + linux_dram_real.hex, ~11 MB DRAM image).
//
// Marked #[ignore] because it takes a long time. Run explicitly with:
//   veryl test --ignored --test test_v4_linux_boot
//
// Memory map (matches v1 test_linux_boot):
//   PA 0x00000000 : Firmware ROM (16 KB, linux_boot_fw.hex)
//   PA 0x02000000 : CLINT (internal)
//   PA 0x10000000 : UART (internal stub — prints via $write)
//   PA 0x80000000 : DRAM (32 MB, kernel + DTB from linux_dram_real.hex)
//
// Pass condition: x3 register reaches 0xAA (SBI SRST shutdown).
module test_v4_linux_boot_harness (
    clk      : input  clock    ,
    rst      : input  reset    ,
    o_pass   : output logic    ,
    o_r3     : output logic<64>,
    o_cy     : output logic<32>,
    o_ret    : output logic<32>,
    o_lrc    : output logic<32>,
    o_trapcnt: output logic<32>,
    o_lf     : output logic    ,
    o_lpc    : output logic<64>,
    o_ftpc   : output logic<64>,
    o_fcause : output logic<64>,
    o_tlpc   : output logic<64>,
    o_tlcause: output logic<64>,
    o_satp   : output logic<64>,
    o_priv   : output logic<2> ,
    o_pc     : output logic<64>,
    o_uart   : output logic<32>,
    o_ecall  : output logic<32>,
) {
    var imem_addr      : logic<64>     ;
    var imem_rdata     : logic<32>     ;
    var imem_ren       : logic         ;
    var dmem_addr      : logic<64>     ;
    var dmem_wdata     : logic<64>     ;
    var dmem_rdata     : logic<64>     ;
    var dmem_rdata_next: logic<64>     ;
    var dmem_wen       : logic         ;
    var dmem_ren       : logic         ;
    var dmem_wstrb     : logic<8>      ;
    var dmem_wdata_hi  : logic<64>     ;
    var dmem_wstrb_hi  : logic<8>      ;
    var dbg_regs       : logic<64> [32];
    var dbg_pc         : logic<64>     ;
    var dbg_sepc      : logic<64>; var dbg_mepc: logic<64>; var dbg_priv: logic<2>;
    var dbg_trap_fire : logic    ; var dbg_trap_pc: logic<64>;
    var dbg_trap_cause: logic<64>; var dbg_trap_to_s: logic;
    var dbg_satp      : logic<64>; var dbg_imem_vaddr: logic<64>; var dbg_imem_paddr: logic<64>;
    var dbg_imem_valid: logic    ; var dbg_imem_fault: logic;
    var dbg_csrwr_v   : logic    ;
    var dbg_csrwr_addr: logic<12>;
    var dbg_csrwr_wdata:logic<64>;
    var dbg_ptw_req   : logic    ; var dbg_ptw_addr : logic<64>; var dbg_ptw_data : logic<64>;
    var dbg_redir_v   : logic;
    var dbg_redir_pc  : logic<64>;
    var dbg_redir_src : logic<64>;
    var dbg_alu_pc    : logic<64>;
    var dbg_alu_src_a : logic<64>;
    var dbg_alu_src_b : logic<64>;
    var dbg_alu_use_pc_a: logic;
    var dbg_alu_rs1_data: logic<64>;
    var dbg_alu_valid   : logic    ;
    var dbg_alu_alu_out : logic<64>;
    var dbg_alu_instr   : logic<32>;
    var dbg_alu_imm     : logic<64>;
    var dbg_stval     : logic<64>;
    var dbg_mtval     : logic<64>;
    var dbg_dmm_busy  : logic    ;
    var dbg_iptw_req  : logic    ;
    var dbg_core_dren : logic    ;
    var _ret_v: logic; var _ret_pc: logic<64>; var _ret_rdv: logic; var _ret_rd: logic<5>; var _ret_data: logic<64>;
    var _rename_cnt: logic<32>; var _cdb_cnt: logic<32>; var _rob_size: logic<8>;
    var _if_v: logic; var _if_instr: logic<32>; var _stall_dr: logic;
    var _head_valid: logic; var _head_rw: logic; var _head_il: logic;
    var _r_alloc: logic<32>; var _r_cdb: logic<32>; var _r_commit: logic<32>;
    var _r_head: logic<6>; var _r_tail: logic<6>;

    // CLINT signals
    var clint_rdata    : logic<64>     ;
    var clint_timer_irq: logic [1]     ;
    var clint_sw_irq   : logic [1]     ;
    var clint_mtime    : logic<64>     ;

    inst dut: heliodor_core_v4 #(
        RESET_PC: 64'h00000000,
    ) (
        clk                            ,
        rst                            ,
        o_imem_addr        : imem_addr      ,
        i_imem_rdata       : imem_rdata     ,
        o_imem_ren         : imem_ren       ,
        o_dmem_addr        : dmem_addr      ,
        o_dmem_wdata       : dmem_wdata     ,
        i_dmem_rdata       : dmem_rdata     ,
        i_dmem_rdata_next  : dmem_rdata_next,
        o_dmem_wen         : dmem_wen       ,
        o_dmem_ren         : dmem_ren       ,
        o_dmem_wstrb       : dmem_wstrb     ,
        o_dmem_wdata_hi    : dmem_wdata_hi  ,
        o_dmem_wstrb_hi    : dmem_wstrb_hi  ,
        i_irq_timer_m      : clint_timer_irq[0],
        i_mtime            : clint_mtime    ,
        i_irq_sw_m         : clint_sw_irq[0]   ,
        i_irq_ext_m        : 1'b0              ,
        o_dbg_pc           : dbg_pc     ,
        o_dbg_regs         : dbg_regs   ,
        o_dbg_retire_v_a   : _ret_v      ,
        o_dbg_retire_pc_a  : _ret_pc     ,
        o_dbg_retire_rd_v_a: _ret_rdv    ,
        o_dbg_retire_rd_a  : _ret_rd     ,
        o_dbg_retire_data_a: _ret_data   ,
        o_dbg_rename_cnt   : _rename_cnt ,
        o_dbg_cdb_cnt      : _cdb_cnt    ,
        o_dbg_rob_size     : _rob_size   ,
        o_dbg_if_v         : _if_v       ,
        o_dbg_if_instr     : _if_instr   ,
        o_dbg_stall_dr     : _stall_dr   ,
        o_dbg_head_valid   : _head_valid ,
        o_dbg_head_rw      : _head_rw    ,
        o_dbg_head_illegal : _head_il    ,
        o_dbg_rob_alloc_cnt: _r_alloc    ,
        o_dbg_rob_cdb_cnt  : _r_cdb      ,
        o_dbg_rob_commit_cnt: _r_commit  ,
        o_dbg_rob_head     : _r_head     ,
        o_dbg_rob_tail     : _r_tail     ,
        o_dbg_sepc         : dbg_sepc, o_dbg_mepc: dbg_mepc, o_dbg_priv: dbg_priv,
        o_dbg_trap_fire    : dbg_trap_fire, o_dbg_trap_pc: dbg_trap_pc,
        o_dbg_trap_cause   : dbg_trap_cause, o_dbg_trap_to_s: dbg_trap_to_s,
        o_dbg_satp         : dbg_satp, o_dbg_imem_vaddr: dbg_imem_vaddr, o_dbg_imem_paddr: dbg_imem_paddr,
        o_dbg_imem_valid   : dbg_imem_valid, o_dbg_imem_fault: dbg_imem_fault,
        o_dbg_csrwr_v      : dbg_csrwr_v, o_dbg_csrwr_addr: dbg_csrwr_addr, o_dbg_csrwr_wdata: dbg_csrwr_wdata,
        o_dbg_ptw_req      : dbg_ptw_req, o_dbg_ptw_addr: dbg_ptw_addr, o_dbg_ptw_data: dbg_ptw_data,
        o_dbg_redirect_fire: dbg_redir_v, o_dbg_redirect_pc: dbg_redir_pc, o_dbg_redirect_src_pc: dbg_redir_src,
        o_dbg_alu_pc_out: dbg_alu_pc, o_dbg_alu_src_a_out: dbg_alu_src_a, o_dbg_alu_src_b_out: dbg_alu_src_b, o_dbg_alu_use_pc_a_out: dbg_alu_use_pc_a, o_dbg_alu_rs1_data_out: dbg_alu_rs1_data, o_dbg_alu_valid_out: dbg_alu_valid, o_dbg_alu_alu_out_out: dbg_alu_alu_out, o_dbg_alu_instr_out: dbg_alu_instr, o_dbg_alu_imm_out: dbg_alu_imm, o_dbg_stval_out: dbg_stval, o_dbg_mtval_out: dbg_mtval,
        o_dbg_dmem_mmu_busy: dbg_dmm_busy, o_dbg_core_dmem_vaddr: _,
        o_dbg_core_dmem_wen: _, o_dbg_core_dmem_ren: dbg_core_dren,
        o_dbg_imem_ptw_req: dbg_iptw_req, o_dbg_commit_store_fire: _,
    );

    // Firmware ROM: 16 KB
    var fw_rom: logic<32> [4096];
    // DRAM: 32 MB (Linux kernel + DTB)
    var dram: logic<32> [8388608];
    initial {
        $readmemh("test/hex/linux_boot_fw.hex", fw_rom);
        // M9 (2026-05-25): v4-specific kernel binary patch — replaces two
        // PC-relative la gp sequences (PA 0x80001050, 0x80001088) with
        // absolute LUI+ADDI so gp = 0xffffffff80a85c20 regardless of which
        // PC half the code runs at. The original kernel head.S relies on a
        // TLB-eviction-induced trap to re-execute `la gp` at high-half PC
        // (= v1 behavior). v4's IFU + MMU walk fresh after csrw satp, so
        // no trap fires, gp stays low-half, kernel OOPSes. See
        // project_phase7_v4_m9_blocker.md.
        $readmemh("test/hex/linux_dram_real.hex", dram);
    }

    let imem_in_fw : logic = imem_addr[31:14] == 18'd0;
    let in_fw      : logic = dmem_addr[31:14] == 18'd0;
    let in_dram    : logic = dmem_addr[31];
    let in_uart    : logic = dmem_addr[31:28] == 4'h1;
    let in_clint   : logic = dmem_addr[31:24] == 8'h02;

    let dram_imem_idx: logic<23> = imem_addr[24:2];
    let fw_imem_idx  : logic<12> = imem_addr[13:2];
    assign imem_rdata = if imem_in_fw ? fw_rom[fw_imem_idx]
                        : if imem_addr[31] ? dram[dram_imem_idx]
                        : 32'd0;

    let dram_dmem_lo : logic<23> = {dmem_addr[24:3], 1'b0};
    let dram_dmem_hi : logic<23> = {dmem_addr[24:3], 1'b1};
    let dram_dmem_nx_lo: logic<23> = {(dmem_addr[24:3] + 22'd1), 1'b0};
    let dram_dmem_nx_hi: logic<23> = {(dmem_addr[24:3] + 22'd1), 1'b1};
    let fw_dmem_lo  : logic<12> = {dmem_addr[13:3], 1'b0};
    let fw_dmem_hi  : logic<12> = {dmem_addr[13:3], 1'b1};

    assign dmem_rdata = if in_dram ? {dram[dram_dmem_hi], dram[dram_dmem_lo]}
                        : if in_fw   ? {fw_rom[fw_dmem_hi], fw_rom[fw_dmem_lo]}
                        : if in_clint ? clint_rdata
                        : 64'd0;
    assign dmem_rdata_next = if in_dram ? {dram[dram_dmem_nx_hi], dram[dram_dmem_nx_lo]}
                             : 64'd0;

    inst u_clint: clint #(N_HARTS: 1) (
        clk            ,
        rst            ,
        i_addr     : dmem_addr[15:0],
        i_wdata    : dmem_wdata     ,
        i_wen      : dmem_wen && in_clint,
        i_ren      : dmem_ren && in_clint,
        o_rdata    : clint_rdata    ,
        o_timer_irq: clint_timer_irq,
        o_sw_irq   : clint_sw_irq   ,
        o_mtime    : clint_mtime    ,
    );
    let _unused_mtime: logic<64> = clint_mtime;
    let _unused_t_irq: logic = clint_timer_irq[0];
    let _unused_s_irq: logic = clint_sw_irq[0];

    always_ff (clk, rst) {
        if_reset {} else if dmem_wen && in_dram {
            if dmem_wstrb[0] { dram[dram_dmem_lo][7:0]   = dmem_wdata[7:0];   }
            if dmem_wstrb[1] { dram[dram_dmem_lo][15:8]  = dmem_wdata[15:8];  }
            if dmem_wstrb[2] { dram[dram_dmem_lo][23:16] = dmem_wdata[23:16]; }
            if dmem_wstrb[3] { dram[dram_dmem_lo][31:24] = dmem_wdata[31:24]; }
            if dmem_wstrb[4] { dram[dram_dmem_hi][7:0]   = dmem_wdata[39:32]; }
            if dmem_wstrb[5] { dram[dram_dmem_hi][15:8]  = dmem_wdata[47:40]; }
            if dmem_wstrb[6] { dram[dram_dmem_hi][23:16] = dmem_wdata[55:48]; }
            if dmem_wstrb[7] { dram[dram_dmem_hi][31:24] = dmem_wdata[63:56]; }
            if dmem_wstrb_hi[0] { dram[dram_dmem_nx_lo][7:0]   = dmem_wdata_hi[7:0];   }
            if dmem_wstrb_hi[1] { dram[dram_dmem_nx_lo][15:8]  = dmem_wdata_hi[15:8];  }
            if dmem_wstrb_hi[2] { dram[dram_dmem_nx_lo][23:16] = dmem_wdata_hi[23:16]; }
            if dmem_wstrb_hi[3] { dram[dram_dmem_nx_lo][31:24] = dmem_wdata_hi[31:24]; }
            if dmem_wstrb_hi[4] { dram[dram_dmem_nx_hi][7:0]   = dmem_wdata_hi[39:32]; }
            if dmem_wstrb_hi[5] { dram[dram_dmem_nx_hi][15:8]  = dmem_wdata_hi[47:40]; }
            if dmem_wstrb_hi[6] { dram[dram_dmem_nx_hi][23:16] = dmem_wdata_hi[55:48]; }
            if dmem_wstrb_hi[7] { dram[dram_dmem_nx_hi][31:24] = dmem_wdata_hi[63:56]; }
        } else if dmem_wen && in_uart {
            if dmem_wstrb[0] { $write("%c", dmem_wdata[7:0]); }
            if dmem_wstrb[1] { $write("%c", dmem_wdata[15:8]); }
            if dmem_wstrb[2] { $write("%c", dmem_wdata[23:16]); }
            if dmem_wstrb[3] { $write("%c", dmem_wdata[31:24]); }
            if dmem_wstrb[4] { $write("%c", dmem_wdata[39:32]); }
            if dmem_wstrb[5] { $write("%c", dmem_wdata[47:40]); }
            if dmem_wstrb[6] { $write("%c", dmem_wdata[55:48]); }
            if dmem_wstrb[7] { $write("%c", dmem_wdata[63:56]); }
        }
    }

    assign o_r3   = dbg_regs[3];
    assign o_pass = dbg_regs[3] == 64'hAA;

    // Periodic boot progress + trap / mtime instrumentation so we can
    // distinguish "kernel WFI waiting for IRQ" from "kernel executing".
    var cy           : logic<32>;
    var trap_cnt     : logic<32>;
    var ecall_seen   : logic;
    var ecall_first_cy: logic<32>;
    var first_trap_seen : logic;
    var first_trap_cy   : logic<32>;
    var first_trap_pc   : logic<64>;
    var first_trap_cause: logic<64>;
    var first_trap_priv : logic<2>;
    var first_trap_satp : logic<64>;
    var first_trap_paddr: logic<64>;
    // Ring of last 8 PTW events (addr + data)
    var ptw_idx  : logic<3>;
    var ptw_addrs: logic<64> [8];
    var ptw_datas: logic<64> [8];
    var ptw_freeze: logic;
    // Capture first 64 stores to PT root areas to catch full PT setup
    // history (earlier 16-entry ring overflowed before trap).
    var st_idx   : logic<6>;
    var st_addrs : logic<64> [64];
    var st_datas : logic<64> [64];
    var st_cys   : logic<32> [64];
    var st_freeze: logic;
    var st_total : logic<32>;  // count of all PT stores even when ring full
    // satp write capture (first 4)
    var satp_idx : logic<2>;
    var satp_cys : logic<32> [4];
    var satp_vals: logic<64> [4];
    var satp_freeze: logic;
    // Fetch PC ring: last 16 valid fetches (vaddr, paddr, cy).
    // Frozen 5 cycles after first_trap so we capture the trap PC + a few prior.
    var fetch_idx       : logic<4>;
    var fetch_vaddrs    : logic<64> [16];
    var fetch_paddrs    : logic<64> [16];
    var fetch_cys       : logic<32> [16];
    var fetch_freeze    : logic;
    var fetch_freeze_dly: logic<4>;
    // mepc write capture (first 8 mepc writes — to see firmware's
    // setup of kernel entry before mret)
    var mepc_idx  : logic<3>;
    var mepc_cys  : logic<32> [8];
    var mepc_vals : logic<64> [8];
    var mepc_freeze: logic;
    // High-half fetch ring: first 8 fetches with VA bit[39]=1 (= high-half
    // kernel VA). Captures kernel high-half jump (la+jr in head.S).
    var hfetch_idx  : logic<3>;
    var hfetch_cys  : logic<32> [8];
    var hfetch_vas  : logic<64> [8];
    var hfetch_freeze: logic;
    // M9 IRQ path diag:
    //   irq_first_cy: first cycle clint o_timer_irq[0] = 1
    //   clint_wr_cnt: count of MMIO writes to clint range (0x02000000..0x02010000)
    //   clint_wr_last_addr/data: address+value of latest clint write
    var irq_first_cy: logic<32>;
    var irq_seen    : logic    ;
    var clint_wr_cnt: logic<32>;
    var clint_wr_last_addr: logic<64>;
    var clint_wr_last_data: logic<64>;
    var clint_wr_first_cy : logic<32>;
    var clint_wr_first_addr: logic<64>;
    var clint_wr_first_data: logic<64>;
    var clint_wr_first_seen: logic;
    // UART byte write count (to dmem_addr 0x10000000 / range 0x10000000..0x10001000)
    var uart_wr_cnt: logic<32>;
    var uart_wr_first_cy: logic<32>;
    var uart_wr_first_seen: logic;
    // Retire PC ring: last 32 retire PCs frozen at first_trap (precise
    // exception verification — what was the last committed insn before
    // trap entry? Compare with first_trap_pc to see if SEPC is correct.)
    var ret_idx   : logic<9>;
    var ret_pcs   : logic<64> [512];
    var ret_cys   : logic<32> [512];
    var ret_rdvs  : logic     [512];
    var ret_rds   : logic<5>  [512];
    var ret_datas : logic<64> [512];
    var ret_freeze: logic;
    var ret_freeze_dly: logic<8>;
    var ret_total : logic<32>;
    // s2 (x18) write ring — every retire with rd=18 captured. 64-entry
    // circular. Each entry: cy, PC, new s2 value. Helps trace where s2
    // gets a garbage value (e.g. ffffffce_fefXX000).
    var s2w_idx   : logic<6>;
    var s2w_cys   : logic<32> [64];
    var s2w_pcs   : logic<64> [64];
    var s2w_datas : logic<64> [64];
    var s2w_total : logic<32>;
    // a0 (x10) write ring — same purpose, trace a0 to find function returning
    // the garbage value 0xffffffce_fefXX000.
    var a0w_idx   : logic<6>;
    var a0w_cys   : logic<32> [64];
    var a0w_pcs   : logic<64> [64];
    var a0w_datas : logic<64> [64];
    var a0w_total : logic<32>;
    // GARBAGE filter ring: ANY retire (any rd) whose data == 0xffffffce_XXXX.
    // Captures all instructions that produce garbage-like values.
    var gbw_idx   : logic<6>;
    var gbw_cys   : logic<32> [64];
    var gbw_pcs   : logic<64> [64];
    var gbw_rds   : logic<5>  [64];
    var gbw_datas : logic<64> [64];
    var gbw_total : logic<32>;
    // Second / third trap capture so we can see recursive page faults inside
    // the trap handler. v4 may double-fault before handler reaches `la gp`.
    var trap2_pc   : logic<64>;
    var trap2_cause: logic<64>;
    var trap2_cy   : logic<32>;
    var trap2_stval: logic<64>;
    var trap2_seen : logic;
    var trap3_pc   : logic<64>;
    var trap3_cause: logic<64>;
    var trap3_cy   : logic<32>;
    var trap3_seen : logic;
    // M9 perf debug: full trap history (32 entries — cause/pc per trap) so we
    // can tell normal-ECALL flow (cause=9, S-mode SBI putchar) apart from
    // exception-loop (cause=2/12/13/15 = illegal/page-fault).
    var trap_hist_idx : logic<5>;
    var trap_hist_cys : logic<32> [32];
    var trap_hist_pcs : logic<64> [32];
    var trap_hist_cau : logic<64> [32];
    // Last trap captured (= newest, observable even after first 32 fill).
    var trap_last_cy   : logic<32>;
    var trap_last_pc   : logic<64>;
    var trap_last_cause: logic<64>;
    // Specific cause=13 (load page fault) tracker — Oops PC capture
    var lfault_seen   : logic;
    var lfault_cy     : logic<32>;
    var lfault_pc     : logic<64>;
    var lfault_stval  : logic<64>;
    // Snapshot all arch regs at lfault
    var lfault_regs   : logic<64> [32];
    // M9 perf debug: per-cycle IFU fault snapshot. Capture (cy, vaddr, paddr,
    // valid, ptw_req, ptw_addr, ptw_data) for first 32 cycles where
    // dbg_imem_fault is high. Identifies whether MMU walk fails or TLB
    // perm check denies a normally-mapped page.
    var ifault_idx   : logic<6>;
    var ifault_cys   : logic<32> [32];
    var ifault_vaddrs: logic<64> [32];
    var ifault_paddrs: logic<64> [32];
    var ifault_satp  : logic<64> [32];
    // Per-cycle PTW snapshot when ptw_req fires (last 16 PTW transactions).
    var ptw2_idx   : logic<4>;
    var ptw2_cys   : logic<32> [16];
    var ptw2_addrs : logic<64> [16];
    var ptw2_datas : logic<64> [16];
    // Snapshot of x3 (gp) and full reg file at first_trap so we can correlate
    // stval (= rs1 + imm) with the actual rs1 read by the trapping load.
    var trap_x1 : logic<64>;
    var trap_x2 : logic<64>;
    var trap_x3 : logic<64>;
    var trap_x8 : logic<64>;
    var trap_x10: logic<64>;
    var trap_regs_captured: logic;
    // Dedicated capture: every retire with rd=3 (gp). 16 entries, frozen at first_trap.
    var gpw_idx   : logic<4>;
    var gpw_cys   : logic<32> [16];
    var gpw_pcs   : logic<64> [16];
    var gpw_datas : logic<64> [16];
    var gpw_total : logic<32>;
    var gpw_freeze: logic;
    // Redirect ring: last 16 redirects (src_pc, target_pc, cy) frozen at first_trap
    // Used to identify wrong jump target bugs (e.g. c.jr ra with bad ra).
    var rdr_idx   : logic<4>;
    var rdr_srcs  : logic<64> [16];
    var rdr_tgts  : logic<64> [16];
    var rdr_cys   : logic<32> [16];
    var rdr_freeze: logic;
    var rdr_freeze_dly: logic<3>;
    var rdr_total : logic<32>;
    // CSR write ring (= 16 entries, frozen at first_trap+4cy)
    var csrw_idx   : logic<4>;
    var csrw_cys   : logic<32> [16];
    var csrw_pcs   : logic<64> [16];
    var csrw_addrs : logic<12> [16];
    var csrw_datas : logic<64> [16];
    var csrw_freeze: logic;
    var csrw_freeze_dly: logic<3>;
    // Last retire cy — for IPC summary at SUMMARY $display
    var last_ret_cy: logic<32>;
    always_ff (clk, rst) {
        if_reset {
            cy            = 32'd0;
            trap_cnt      = 32'd0;
            ecall_seen    = 1'b0;
            ecall_first_cy= 32'd0;
            first_trap_seen  = 1'b0;
            first_trap_cy    = 32'd0;
            first_trap_pc    = 64'd0;
            first_trap_cause = 64'd0;
            first_trap_priv  = 2'd0;
            first_trap_satp  = 64'd0;
            first_trap_paddr = 64'd0;
            ptw_idx          = 3'd0;
            ptw_freeze       = 1'b0;
            for i in 0..8 {
                ptw_addrs[i] = 64'd0;
                ptw_datas[i] = 64'd0;
            }
            st_idx     = 6'd0;
            st_freeze  = 1'b0;
            st_total   = 32'd0;
            satp_idx   = 2'd0;
            satp_freeze= 1'b0;
            for i in 0..4 {
                satp_cys[i]  = 32'd0;
                satp_vals[i] = 64'd0;
            }
            fetch_idx        = 4'd0;
            fetch_freeze     = 1'b0;
            fetch_freeze_dly = 4'd0;
            for i in 0..16 {
                fetch_vaddrs[i] = 64'd0;
                fetch_paddrs[i] = 64'd0;
                fetch_cys[i]    = 32'd0;
            }
            mepc_idx   = 3'd0;
            mepc_freeze= 1'b0;
            for i in 0..8 {
                mepc_cys[i]  = 32'd0;
                mepc_vals[i] = 64'd0;
            }
            hfetch_idx    = 3'd0;
            hfetch_freeze = 1'b0;
            for i in 0..8 {
                hfetch_cys[i] = 32'd0;
                hfetch_vas[i] = 64'd0;
            }
            irq_first_cy = 32'd0;
            irq_seen     = 1'b0;
            clint_wr_cnt = 32'd0;
            clint_wr_last_addr = 64'd0;
            clint_wr_last_data = 64'd0;
            clint_wr_first_cy   = 32'd0;
            clint_wr_first_addr = 64'd0;
            clint_wr_first_data = 64'd0;
            clint_wr_first_seen = 1'b0;
            uart_wr_cnt = 32'd0;
            uart_wr_first_cy   = 32'd0;
            uart_wr_first_seen = 1'b0;
            for i in 0..64 {
                st_addrs[i] = 64'd0;
                st_datas[i] = 64'd0;
                st_cys[i]   = 32'd0;
            }
            ret_idx        = 9'd0;
            ret_freeze     = 1'b0;
            ret_freeze_dly = 8'd0;
            ret_total      = 32'd0;
            for i in 0..512 {
                ret_pcs[i]   = 64'd0;
                ret_cys[i]   = 32'd0;
                ret_rdvs[i]  = 1'b0;
                ret_rds[i]   = 5'd0;
                ret_datas[i] = 64'd0;
            }
            s2w_idx   = 6'd0;
            s2w_total = 32'd0;
            for i in 0..64 {
                s2w_cys[i]   = 32'd0;
                s2w_pcs[i]   = 64'd0;
                s2w_datas[i] = 64'd0;
            }
            a0w_idx   = 6'd0;
            a0w_total = 32'd0;
            for i in 0..64 {
                a0w_cys[i]   = 32'd0;
                a0w_pcs[i]   = 64'd0;
                a0w_datas[i] = 64'd0;
            }
            gbw_idx   = 6'd0;
            gbw_total = 32'd0;
            for i in 0..64 {
                gbw_cys[i]   = 32'd0;
                gbw_pcs[i]   = 64'd0;
                gbw_rds[i]   = 5'd0;
                gbw_datas[i] = 64'd0;
            }
            trap2_pc    = 64'd0;
            trap2_cause = 64'd0;
            trap2_cy    = 32'd0;
            trap2_stval = 64'd0;
            trap2_seen  = 1'b0;
            trap3_pc    = 64'd0;
            trap3_cause = 64'd0;
            trap3_cy    = 32'd0;
            trap3_seen  = 1'b0;
            trap_hist_idx = 5'd0;
            trap_last_cy   = 32'd0;
            trap_last_pc   = 64'd0;
            trap_last_cause= 64'd0;
            lfault_seen   = 1'b0;
            lfault_cy     = 32'd0;
            lfault_pc     = 64'd0;
            lfault_stval  = 64'd0;
            for i in 0..32 {
                lfault_regs[i] = 64'd0;
            }
            for i in 0..32 {
                trap_hist_cys[i] = 32'd0;
                trap_hist_pcs[i] = 64'd0;
                trap_hist_cau[i] = 64'd0;
            }
            ifault_idx = 6'd0;
            for i in 0..32 {
                ifault_cys[i]    = 32'd0;
                ifault_vaddrs[i] = 64'd0;
                ifault_paddrs[i] = 64'd0;
                ifault_satp[i]   = 64'd0;
            }
            ptw2_idx = 4'd0;
            for i in 0..16 {
                ptw2_cys[i]   = 32'd0;
                ptw2_addrs[i] = 64'd0;
                ptw2_datas[i] = 64'd0;
            }
            trap_x1  = 64'd0;
            trap_x2  = 64'd0;
            trap_x3  = 64'd0;
            trap_x8  = 64'd0;
            trap_x10 = 64'd0;
            trap_regs_captured = 1'b0;
            gpw_idx    = 4'd0;
            gpw_total  = 32'd0;
            gpw_freeze = 1'b0;
            for i in 0..16 {
                gpw_cys[i]   = 32'd0;
                gpw_pcs[i]   = 64'd0;
                gpw_datas[i] = 64'd0;
            }
            rdr_idx        = 4'd0;
            rdr_freeze     = 1'b0;
            rdr_freeze_dly = 3'd0;
            rdr_total      = 32'd0;
            for i in 0..16 {
                rdr_srcs[i] = 64'd0;
                rdr_tgts[i] = 64'd0;
                rdr_cys[i]  = 32'd0;
            }
            csrw_idx        = 4'd0;
            csrw_freeze     = 1'b0;
            csrw_freeze_dly = 3'd0;
            for i in 0..16 {
                csrw_cys[i]   = 32'd0;
                csrw_pcs[i]   = 64'd0;
                csrw_addrs[i] = 12'd0;
                csrw_datas[i] = 64'd0;
            }
            last_ret_cy = 32'd0;
        } else {
            cy = cy + 32'd1;
            if dbg_trap_fire {
                trap_cnt = trap_cnt + 32'd1;
                // ECALL from S = cause 9, from M = cause 11, from U = 8
                if !ecall_seen && (dbg_trap_cause == 64'd8 || dbg_trap_cause == 64'd9 || dbg_trap_cause == 64'd11) {
                    ecall_seen     = 1'b1;
                    ecall_first_cy = cy;
                }
                if !first_trap_seen {
                    first_trap_seen  = 1'b1;
                    first_trap_cy    = cy;
                    first_trap_pc    = dbg_trap_pc;
                    first_trap_cause = dbg_trap_cause;
                    first_trap_priv  = dbg_priv;
                    first_trap_satp  = dbg_satp;
                    first_trap_paddr = dbg_imem_paddr;
                    ptw_freeze       = 1'b1;
                }
            }
            // Capture PTW events into ring (frozen at first trap)
            if dbg_ptw_req && !ptw_freeze {
                ptw_addrs[ptw_idx] = dbg_ptw_addr;
                ptw_datas[ptw_idx] = dbg_ptw_data;
                ptw_idx = ptw_idx + 3'd1;
            }
            // Capture first 16 NON-ZERO PTE writes to PT root areas.
            // Zero writes are PT clearing; non-zero = real PTE setup.
            let pt_st_match: logic =
                (dmem_addr >= 64'h80404000 && dmem_addr <: 64'h80405000) ||
                (dmem_addr >= 64'h80a8a000 && dmem_addr <: 64'h80a8b000);
            if dmem_wen && pt_st_match && dmem_wdata != 64'd0 && !st_freeze {
                st_total = st_total + 32'd1;
                if st_idx != 6'd63 {
                    st_addrs[st_idx] = dmem_addr;
                    st_datas[st_idx] = dmem_wdata;
                    st_cys[st_idx]   = cy;
                    st_idx = st_idx + 6'd1;
                }
            }
            if first_trap_seen && !st_freeze {
                st_freeze = 1'b1;
            }
            // Capture satp CSR writes
            if dbg_csrwr_v && dbg_csrwr_addr == 12'h180 && !satp_freeze && satp_idx != 2'd3 {
                satp_cys[satp_idx]  = cy;
                satp_vals[satp_idx] = dbg_csrwr_wdata;
                satp_idx = satp_idx + 2'd1;
            }
            if first_trap_seen && !satp_freeze {
                satp_freeze = 1'b1;
            }
            // Fetch ring: push every valid imem fetch (vaddr + paddr).
            // After first_trap, give 5 more cycles so trap handler PC is
            // also visible, then freeze.
            if dbg_imem_valid && !fetch_freeze {
                fetch_vaddrs[fetch_idx] = dbg_imem_vaddr;
                fetch_paddrs[fetch_idx] = dbg_imem_paddr;
                fetch_cys[fetch_idx]    = cy;
                fetch_idx = fetch_idx + 4'd1;
            }
            if first_trap_seen && !fetch_freeze {
                if fetch_freeze_dly == 4'd5 {
                    fetch_freeze = 1'b1;
                } else {
                    fetch_freeze_dly = fetch_freeze_dly + 4'd1;
                }
            }
            // mepc write capture (CSR 0x341)
            if dbg_csrwr_v && dbg_csrwr_addr == 12'h341 && !mepc_freeze && mepc_idx != 3'd7 {
                mepc_cys[mepc_idx]  = cy;
                mepc_vals[mepc_idx] = dbg_csrwr_wdata;
                mepc_idx = mepc_idx + 3'd1;
            }
            if first_trap_seen && !mepc_freeze {
                mepc_freeze = 1'b1;
            }
            // High-half fetch capture: vaddr bit[39]=1 (= high-half kernel VA)
            if dbg_imem_valid && dbg_imem_vaddr[39] == 1'b1 && !hfetch_freeze && hfetch_idx != 3'd7 {
                hfetch_cys[hfetch_idx] = cy;
                hfetch_vas[hfetch_idx] = dbg_imem_vaddr;
                hfetch_idx = hfetch_idx + 3'd1;
            }
            if first_trap_seen && !hfetch_freeze {
                hfetch_freeze = 1'b1;
            }
            // First clint o_timer_irq pulse
            if clint_timer_irq[0] && !irq_seen {
                irq_first_cy = cy;
                irq_seen     = 1'b1;
            }
            // Clint MMIO write count (in_clint && dmem_wen)
            if dmem_wen && in_clint {
                clint_wr_cnt       = clint_wr_cnt + 32'd1;
                clint_wr_last_addr = dmem_addr;
                clint_wr_last_data = dmem_wdata;
                if !clint_wr_first_seen {
                    clint_wr_first_cy   = cy;
                    clint_wr_first_addr = dmem_addr;
                    clint_wr_first_data = dmem_wdata;
                    clint_wr_first_seen = 1'b1;
                }
            }
            // UART byte write count (in_uart && dmem_wen)
            if dmem_wen && in_uart {
                uart_wr_cnt = uart_wr_cnt + 32'd1;
                if !uart_wr_first_seen {
                    uart_wr_first_cy   = cy;
                    uart_wr_first_seen = 1'b1;
                }
            }
            // Retire PC ring: capture every retire (lane A) until 4 cycles
            // after first_trap. Latest is at ret_idx-1 mod 32.
            if _ret_v && !ret_freeze {
                ret_pcs[ret_idx]   = _ret_pc;
                ret_cys[ret_idx]   = cy;
                ret_rdvs[ret_idx]  = _ret_rdv;
                ret_rds[ret_idx]   = _ret_rd;
                ret_datas[ret_idx] = _ret_data;
                ret_idx = ret_idx + 9'd1;
                ret_total = ret_total + 32'd1;
            }
            // s2 (x18) write ring — capture every retire writing rd=18.
            // Circular (64 entries). Freezes when ret_ring freezes (=
            // lfault_seen).
            if _ret_v && _ret_rdv && _ret_rd == 5'd18 && !ret_freeze {
                s2w_cys[s2w_idx]   = cy;
                s2w_pcs[s2w_idx]   = _ret_pc;
                s2w_datas[s2w_idx] = _ret_data;
                s2w_idx = s2w_idx + 6'd1;
                s2w_total = s2w_total + 32'd1;
            }
            // a0 (x10) write ring — same.
            if _ret_v && _ret_rdv && _ret_rd == 5'd10 && !ret_freeze {
                a0w_cys[a0w_idx]   = cy;
                a0w_pcs[a0w_idx]   = _ret_pc;
                a0w_datas[a0w_idx] = _ret_data;
                a0w_idx = a0w_idx + 6'd1;
                a0w_total = a0w_total + 32'd1;
            }
            // GARBAGE filter: any retire writing a value of pattern
            // 0xffffffce_XXXX_XXXX (= the kernel page-fault address family).
            if _ret_v && _ret_rdv && !ret_freeze && _ret_data[63:40] == 24'hffffff && _ret_data[39:32] == 8'hce {
                gbw_cys[gbw_idx]   = cy;
                gbw_pcs[gbw_idx]   = _ret_pc;
                gbw_rds[gbw_idx]   = _ret_rd;
                gbw_datas[gbw_idx] = _ret_data;
                gbw_idx = gbw_idx + 6'd1;
                gbw_total = gbw_total + 32'd1;
            }
            // Freeze ret_ring on first cause=13 trap (= the OOPS) so we
            // capture pre-fault retires. The faulting LOAD itself doesn't
            // retire (trap diverts), so we freeze on lfault_seen instead.
            if lfault_seen && !ret_freeze {
                ret_freeze = 1'b1;
            }
            // Second / third trap capture (recursive page-fault detection)
            if dbg_trap_fire && first_trap_seen && !trap2_seen {
                trap2_pc    = dbg_trap_pc;
                trap2_cause = dbg_trap_cause;
                trap2_cy    = cy;
                trap2_stval = dbg_stval;
                trap2_seen  = 1'b1;
            }
            if dbg_trap_fire && trap2_seen && !trap3_seen {
                trap3_pc    = dbg_trap_pc;
                trap3_cause = dbg_trap_cause;
                trap3_cy    = cy;
                trap3_seen  = 1'b1;
            }
            // Trap history: first 32 traps + last trap
            if dbg_trap_fire {
                trap_last_cy    = cy;
                trap_last_pc    = dbg_trap_pc;
                trap_last_cause = dbg_trap_cause;
                // Cause=13 (load page fault) — snapshot regs at first occurrence
                if dbg_trap_cause == 64'd13 && !lfault_seen {
                    lfault_seen  = 1'b1;
                    lfault_cy    = cy;
                    lfault_pc    = dbg_trap_pc;
                    lfault_stval = dbg_stval;
                    for i in 0..32 {
                        lfault_regs[i] = dbg_regs[i];
                    }
                }
                if trap_hist_idx != 5'd31 {
                    trap_hist_cys[trap_hist_idx] = cy;
                    trap_hist_pcs[trap_hist_idx] = dbg_trap_pc;
                    trap_hist_cau[trap_hist_idx] = dbg_trap_cause;
                    trap_hist_idx = trap_hist_idx + 5'd1;
                }
            }
            // Per-cycle imem fault snapshot (capture first 32 fault events)
            if dbg_imem_fault && ifault_idx != 6'd32 {
                ifault_cys[ifault_idx[4:0]]    = cy;
                ifault_vaddrs[ifault_idx[4:0]] = dbg_imem_vaddr;
                ifault_paddrs[ifault_idx[4:0]] = dbg_imem_paddr;
                ifault_satp[ifault_idx[4:0]]   = dbg_satp;
                ifault_idx = ifault_idx + 6'd1;
            }
            // PTW snapshot (last 16 PTW transactions, circular)
            if dbg_ptw_req {
                ptw2_cys[ptw2_idx]   = cy;
                ptw2_addrs[ptw2_idx] = dbg_ptw_addr;
                ptw2_datas[ptw2_idx] = dbg_ptw_data;
                ptw2_idx = ptw2_idx + 4'd1;
            }
            // Snapshot key arch regs at first trap entry (cycle of trap_fire).
            if dbg_trap_fire && !trap_regs_captured {
                trap_x1  = dbg_regs[1];
                trap_x2  = dbg_regs[2];
                trap_x3  = dbg_regs[3];
                trap_x8  = dbg_regs[8];
                trap_x10 = dbg_regs[10];
                trap_regs_captured = 1'b1;
            }
            // Capture every retire writing rd=3 (gp) so we can locate the
            // instruction that produced the suspected low-half gp value.
            if _ret_v && _ret_rdv && _ret_rd == 5'd3 && !gpw_freeze {
                gpw_total = gpw_total + 32'd1;
                if gpw_idx != 4'd15 {
                    gpw_cys[gpw_idx]   = cy;
                    gpw_pcs[gpw_idx]   = _ret_pc;
                    gpw_datas[gpw_idx] = _ret_data;
                    gpw_idx = gpw_idx + 4'd1;
                }
            }
            if first_trap_seen && !gpw_freeze {
                gpw_freeze = 1'b1;
            }
            // Redirect ring: every redirect_fire captured as (src_pc, target).
            if dbg_redir_v && !rdr_freeze {
                rdr_srcs[rdr_idx] = dbg_redir_src;
                rdr_tgts[rdr_idx] = dbg_redir_pc;
                rdr_cys[rdr_idx]  = cy;
                rdr_idx = rdr_idx + 4'd1;
                rdr_total = rdr_total + 32'd1;
            }
            if first_trap_seen && !rdr_freeze {
                if rdr_freeze_dly == 3'd4 {
                    rdr_freeze = 1'b1;
                } else {
                    rdr_freeze_dly = rdr_freeze_dly + 3'd1;
                }
            }
            // CSR write ring (16 entries)
            if dbg_csrwr_v && !csrw_freeze {
                csrw_cys[csrw_idx]   = cy;
                csrw_pcs[csrw_idx]   = dbg_pc;
                csrw_addrs[csrw_idx] = dbg_csrwr_addr;
                csrw_datas[csrw_idx] = dbg_csrwr_wdata;
                csrw_idx = csrw_idx + 4'd1;
            }
            if first_trap_seen && !csrw_freeze {
                if csrw_freeze_dly == 3'd4 {
                    csrw_freeze = 1'b1;
                } else {
                    csrw_freeze_dly = csrw_freeze_dly + 3'd1;
                }
            }
            // Track last-retire cy for IPC summary (no hang detection needed; lfault_seen handles it)
            if _ret_v {
                last_ret_cy = cy;
            }
            if cy[17:0] == 18'd0 && 1'b0 {
                $display("v4 linux boot @cy=%h: pc=%h x3=%h priv=%h trap_cnt=%h mtime=%h ecall_first_cy=%h",
                          cy, dbg_pc, dbg_regs[3], dbg_priv, trap_cnt, clint_mtime, ecall_first_cy);
                $display("v4   first_trap: cy=%h pc=%h cause=%h priv=%h satp=%h paddr=%h",
                          first_trap_cy, first_trap_pc, first_trap_cause, first_trap_priv,
                          first_trap_satp, first_trap_paddr);
                $display("v4   stval=%h mtval=%h (= faulting VA at first_trap)", dbg_stval, dbg_mtval);
                $display("v4   ptw[0] addr=%h data=%h", ptw_addrs[0], ptw_datas[0]);
                $display("v4   ptw[1] addr=%h data=%h", ptw_addrs[1], ptw_datas[1]);
                $display("v4   ptw[2] addr=%h data=%h", ptw_addrs[2], ptw_datas[2]);
                $display("v4   ptw[3] addr=%h data=%h", ptw_addrs[3], ptw_datas[3]);
                $display("v4   ptw[4] addr=%h data=%h", ptw_addrs[4], ptw_datas[4]);
                $display("v4   ptw[5] addr=%h data=%h", ptw_addrs[5], ptw_datas[5]);
                $display("v4   ptw[6] addr=%h data=%h", ptw_addrs[6], ptw_datas[6]);
                $display("v4   ptw[7] addr=%h data=%h", ptw_addrs[7], ptw_datas[7]);
                $display("v4   st_total=%h (ring cap=64)", st_total);
                for i in 0..64 {
                    if st_cys[i] != 32'd0 {
                        $display("v4   st[%h] cy=%h addr=%h data=%h",
                                  i, st_cys[i], st_addrs[i], st_datas[i]);
                    }
                }
                for i in 0..4 {
                    $display("v4   satp_w[%h] cy=%h val=%h",
                              i, satp_cys[i], satp_vals[i]);
                }
                for i in 0..16 {
                    $display("v4   fet[%h] cy=%h va=%h pa=%h",
                              i, fetch_cys[i], fetch_vaddrs[i], fetch_paddrs[i]);
                }
                for i in 0..8 {
                    $display("v4   mepc_w[%h] cy=%h val=%h",
                              i, mepc_cys[i], mepc_vals[i]);
                }
                for i in 0..8 {
                    $display("v4   hfet[%h] cy=%h va=%h",
                              i, hfetch_cys[i], hfetch_vas[i]);
                }
                $display("v4   irq: seen=%b first_cy=%h", irq_seen, irq_first_cy);
                $display("v4   clint_wr: cnt=%h first_cy=%h first_addr=%h first_data=%h last_addr=%h last_data=%h",
                          clint_wr_cnt, clint_wr_first_cy, clint_wr_first_addr, clint_wr_first_data,
                          clint_wr_last_addr, clint_wr_last_data);
                $display("v4   uart_wr: cnt=%h first_cy=%h", uart_wr_cnt, uart_wr_first_cy);
                $display("v4   trap_regs: x1=%h x2=%h x3=%h x8=%h x10=%h captured=%b",
                          trap_x1, trap_x2, trap_x3, trap_x8, trap_x10, trap_regs_captured);
                $display("v4   gpw_total=%h (all retires writing gp)", gpw_total);
                for i in 0..16 {
                    if gpw_cys[i] != 32'd0 {
                        $display("v4   gpw[%h] cy=%h pc=%h data=%h",
                                  i, gpw_cys[i], gpw_pcs[i], gpw_datas[i]);
                    }
                }
                $display("v4   trap2: seen=%b cy=%h pc=%h cause=%h stval=%h",
                          trap2_seen, trap2_cy, trap2_pc, trap2_cause, trap2_stval);
                $display("v4   trap3: seen=%b cy=%h pc=%h cause=%h",
                          trap3_seen, trap3_cy, trap3_pc, trap3_cause);
                $display("v4   trap_last: cy=%h pc=%h cause=%h",
                          trap_last_cy, trap_last_pc, trap_last_cause);
                $display("v4   lfault: seen=%b cy=%h pc=%h stval=%h",
                          lfault_seen, lfault_cy, lfault_pc, lfault_stval);
                for i in 0..32 {
                    $display("v4   lfault_reg[%h]=%h", i, lfault_regs[i]);
                }
                $display("v4   s2w_total=%h (ring cap=64, latest at idx %h)", s2w_total, s2w_idx);
                for i in 0..64 {
                    if s2w_cys[i] != 32'd0 {
                        $display("v4   s2w[%h] cy=%h pc=%h data=%h",
                                  i, s2w_cys[i], s2w_pcs[i], s2w_datas[i]);
                    }
                }
                $display("v4   a0w_total=%h (ring cap=64, latest at idx %h)", a0w_total, a0w_idx);
                for i in 0..64 {
                    if a0w_cys[i] != 32'd0 {
                        $display("v4   a0w[%h] cy=%h pc=%h data=%h",
                                  i, a0w_cys[i], a0w_pcs[i], a0w_datas[i]);
                    }
                }
                $display("v4   gbw_total=%h (ring cap=64, latest at idx %h)", gbw_total, gbw_idx);
                for i in 0..64 {
                    if gbw_cys[i] != 32'd0 {
                        $display("v4   gbw[%h] cy=%h pc=%h rd=%h data=%h",
                                  i, gbw_cys[i], gbw_pcs[i], gbw_rds[i], gbw_datas[i]);
                    }
                }
                for i in 0..32 {
                    if trap_hist_cys[i] != 32'd0 {
                        $display("v4   trap_hist[%h] cy=%h pc=%h cause=%h",
                                  i, trap_hist_cys[i], trap_hist_pcs[i], trap_hist_cau[i]);
                    }
                }
                $display("v4   ifault_total_observed=%h", ifault_idx);
                for i in 0..32 {
                    if ifault_cys[i] != 32'd0 {
                        $display("v4   ifault[%h] cy=%h va=%h pa=%h satp=%h",
                                  i, ifault_cys[i], ifault_vaddrs[i], ifault_paddrs[i], ifault_satp[i]);
                    }
                }
                for i in 0..16 {
                    if ptw2_cys[i] != 32'd0 {
                        $display("v4   ptw2[%h] cy=%h addr=%h data=%h",
                                  i, ptw2_cys[i], ptw2_addrs[i], ptw2_datas[i]);
                    }
                }
                $display("v4   ret_total=%h (ring cap=512, latest at idx %h)", ret_total, ret_idx);
                for i in 0..512 {
                    if ret_cys[i] != 32'd0 {
                        $display("v4   ret[%h] cy=%h pc=%h rdv=%b rd=%h data=%h",
                                  i, ret_cys[i], ret_pcs[i], ret_rdvs[i], ret_rds[i], ret_datas[i]);
                    }
                }
                $display("v4   rdr_total=%h (ring cap=16, latest at idx %h)", rdr_total, rdr_idx);
                for i in 0..16 {
                    if rdr_cys[i] != 32'd0 {
                        $display("v4   rdr[%h] cy=%h src=%h tgt=%h",
                                  i, rdr_cys[i], rdr_srcs[i], rdr_tgts[i]);
                    }
                }
                for i in 0..16 {
                    if csrw_cys[i] != 32'd0 {
                        $display("v4   csrw[%h] cy=%h pc=%h addr=%h data=%h",
                                  i, csrw_cys[i], csrw_pcs[i], csrw_addrs[i], csrw_datas[i]);
                    }
                }
            }
        }
    }
    // Summary state outputs — assigned here since variables are defined above
    assign o_cy      = cy;
    assign o_ret     = ret_total;
    assign o_lrc     = last_ret_cy;
    assign o_trapcnt = trap_cnt;
    assign o_lf      = lfault_seen;
    assign o_lpc     = lfault_pc;
    assign o_ftpc    = first_trap_pc;
    assign o_fcause  = first_trap_cause;
    assign o_tlpc    = trap_last_pc;
    assign o_tlcause = trap_last_cause;
    assign o_satp    = dbg_satp;
    assign o_priv    = dbg_priv;
    assign o_pc      = dbg_pc;
    assign o_uart    = uart_wr_cnt;
    assign o_ecall   = ecall_first_cy;

    // M9.A.243 (2026-05-26): L0 PTE @ 0x80a89ff0 access trace.
    // Per memory project_phase7_v4_m9_blocker.md: v1 populates this PTE
    // with 0x207ff8e7 multiple times; v4 only stores 0 (clear) once and
    // never populates → later load to vmemmap VA faults → kernel OOPS.
    // Trace every read/write to 0x80a89ff0 with a 16-deep retire-PC ring
    // for context, so we can identify which retire path v4 takes that
    // skips the populate step.
    var trace_cy_v4: logic<32>;
    always_ff (clk, rst) {
        if_reset {
            trace_cy_v4 = 32'd0;
        } else {
            trace_cy_v4 = trace_cy_v4 + 32'd1;
        }
    }
    var ret_ring_pc : logic<64> [16];
    var ret_ring_cy : logic<32> [16];
    var ret_ring_rd : logic<5>  [16];
    var ret_ring_dat: logic<64> [16];
    var ret_ring_idx: logic<4>      ;
    always_ff (clk, rst) {
        if_reset {
            ret_ring_idx = 4'd0;
            for k in 0..16 {
                ret_ring_pc[k]  = 64'd0;
                ret_ring_cy[k]  = 32'd0;
                ret_ring_rd[k]  = 5'd0;
                ret_ring_dat[k] = 64'd0;
            }
        } else {
            if _ret_v {
                ret_ring_pc[ret_ring_idx]  = _ret_pc;
                ret_ring_cy[ret_ring_idx]  = trace_cy_v4;
                ret_ring_rd[ret_ring_idx]  = _ret_rd;
                ret_ring_dat[ret_ring_idx] = _ret_data;
                ret_ring_idx               = ret_ring_idx + 4'd1;
            }
        }
    }
    // M9.A.245 (2026-05-26): trace every create_pgd_mapping call entry.
    // Args (per RISC-V calling convention):
    //   a0 = pgdp, a1 = va, a2 = pa, a3 = sz, a4 = prot
    // best_map_size selects PMD_SIZE only when (base aligned 2MB && size>=2MB)
    // M9.A.250: trace __set_fixmap entry args on v4 to compare with v1.
    let sfx_v4: logic = _ret_v && (_ret_pc == 64'hffffffff80003dd6);
    always_ff (clk, rst) {
        if_reset {} else if sfx_v4 {
            $display("[v4 __set_fixmap entry] cy=%d a0=%h a1=%h a2=%h",
                      trace_cy_v4, dbg_regs[10], dbg_regs[11], dbg_regs[12]);
        }
    }

    // M9.A.252: trace c.beqz a2 (PC 0x80003e06) and the two sd targets
    // (populate PC 0x80003e0e, clear PC 0x80003e16) to confirm whether
    // v4 wrongly takes the clear path with a2=0xe7.
    let beqz_a2_v4   : logic = _ret_v && (_ret_pc == 64'hffffffff80003e06);
    let pop_sd_v4    : logic = _ret_v && (_ret_pc == 64'hffffffff80003e0e);
    let clear_sd_v4  : logic = _ret_v && (_ret_pc == 64'hffffffff80003e16);
    always_ff (clk, rst) {
        if_reset {} else {
            if beqz_a2_v4 {
                $display("[v4 c.beqz a2 PC=80003e06] cy=%d a2=%h",
                          trace_cy_v4, dbg_regs[12]);
            }
            if pop_sd_v4 {
                $display("[v4 populate sd PC=80003e0e] cy=%d a2=%h a4=%h",
                          trace_cy_v4, dbg_regs[12], dbg_regs[14]);
            }
            if clear_sd_v4 {
                $display("[v4 clear sd PC=80003e16] cy=%d a4=%h",
                          trace_cy_v4, dbg_regs[14]);
            }
        }
    }

    // M9.A.253: pin which step in the arithmetic chain produces wrong a4.
    // Disasm:
    //   80003dd6  slliw a4, a0, 0xc
    //   80003dda  slli  a4, a4, 0x20
    //   80003ddc  lui   a5, 0xfceff
    //   80003de0  srli  a4, a4, 0x20      ← a4 = 0x2000 (for a0=2)
    //   80003de2  slli  a5, a5, 0xc       ← a5 = 0xffffffceff000000
    //   80003de4  sub   a5, a5, a4        ← a5 = 0xffffffcefeffe000
    //   80003df2  srli  a3, a5, 0xc       ← a3 = 0xfffffcefeffe
    //   80003df6  andi  a3, a3, 511       ← a3 = 0x1fe (= 510)
    //   80003dfa  auipc a4, 0xa85
    //   80003dfe  addi  a4, a4, 518       ← a4 = 0x80a89000
    //   80003e02  slli  a3, a3, 0x3       ← a3 = 0xff0
    //   80003e04  add   a4, a4, a3        ← a4 = 0x80a89ff0
    let p_slliw_a4  : logic = _ret_v && (_ret_pc == 64'hffffffff80003dd6);
    let p_slli_a4   : logic = _ret_v && (_ret_pc == 64'hffffffff80003dda);
    let p_srli_a4   : logic = _ret_v && (_ret_pc == 64'hffffffff80003de0);
    let p_sub_a5    : logic = _ret_v && (_ret_pc == 64'hffffffff80003de4);
    let p_andi_a3   : logic = _ret_v && (_ret_pc == 64'hffffffff80003df6);
    let p_addi_a4   : logic = _ret_v && (_ret_pc == 64'hffffffff80003dfe);
    let p_slli_a3   : logic = _ret_v && (_ret_pc == 64'hffffffff80003e02);
    let p_add_a4_a3 : logic = _ret_v && (_ret_pc == 64'hffffffff80003e04);
    always_ff (clk, rst) {
        if_reset {} else {
            if p_slliw_a4  { $display("[v4 slliw a4,a0,12] cy=%d a4_res=%h a0=%h", trace_cy_v4, _ret_data, dbg_regs[10]); }
            if p_slli_a4   { $display("[v4 slli  a4,a4,32] cy=%d a4_res=%h",       trace_cy_v4, _ret_data); }
            if p_srli_a4   { $display("[v4 srli  a4,a4,32] cy=%d a4_res=%h",       trace_cy_v4, _ret_data); }
            if p_sub_a5    { $display("[v4 sub a5,a5,a4]   cy=%d a5_res=%h a4=%h", trace_cy_v4, _ret_data, dbg_regs[14]); }
            if p_andi_a3   { $display("[v4 andi a3,a3,511] cy=%d a3_res=%h a5=%h", trace_cy_v4, _ret_data, dbg_regs[15]); }
            if p_addi_a4   { $display("[v4 addi a4,a4,518] cy=%d a4_res=%h",       trace_cy_v4, _ret_data); }
            if p_slli_a3   { $display("[v4 slli a3,a3,3]   cy=%d a3_res=%h",       trace_cy_v4, _ret_data); }
            if p_add_a4_a3 { $display("[v4 add a4,a4,a3]   cy=%d a4_res=%h a3=%h", trace_cy_v4, _ret_data, dbg_regs[13]); }
        }
    }

    // M9.A.254: trace ALU execution when PC = 0x80003dd6 (slliw a4, a0, 0xc).
    // ALU sees src_a/src_b/instr/imm at EX cycle. If src_a != 2 or instr
    // bits don't match SLLIW encoding 0x00c5171b, the OoO bug is in
    // dispatch / IQ / PRF read.
    let alu_slliw: logic = dbg_alu_valid && (dbg_alu_pc == 64'hffffffff80003dd6);
    always_ff (clk, rst) {
        if_reset {} else if alu_slliw {
            $display("[v4 ALU EX slliw] cy=%d src_a=%h src_b=%h alu_out=%h instr=%h imm=%h rs1_data=%h",
                      trace_cy_v4, dbg_alu_src_a, dbg_alu_src_b, dbg_alu_alu_out,
                      dbg_alu_instr, dbg_alu_imm, dbg_alu_rs1_data);
        }
    }


    let cpm_entry: logic = _ret_v && (_ret_pc == 64'hffffffff80202f76);
    always_ff (clk, rst) {
        if_reset {} else if cpm_entry {
            $display("[v4 create_pgd_mapping] cy=%d pgdp=%h va=%h pa=%h sz=%h prot=%h ra=%h",
                      trace_cy_v4, dbg_regs[10], dbg_regs[11], dbg_regs[12],
                      dbg_regs[13], dbg_regs[14], dbg_regs[1]);
        }
    }

    // M9.A.246: paging_init loop trace.
    //   PC ffffffff8020360e  ld a5, 32(sp)   ← upper bound load (a5 = _ret_data)
    //   PC ffffffff80203610  bltu s2, a5, +0x24   ← loop continue check
    //   PC ffffffff80203656  add s2, s2, s9  ← loop counter increment
    let ld_a5: logic = _ret_v && (_ret_pc == 64'hffffffff8020360e);
    let bltu_s2_a5: logic = _ret_v && (_ret_pc == 64'hffffffff80203610);
    let add_s2_s9: logic = _ret_v && (_ret_pc == 64'hffffffff80203656);
    always_ff (clk, rst) {
        if_reset {} else {
            if ld_a5 {
                $display("[v4 ld a5,32(sp)] cy=%d a5_loaded=%h sp=%h",
                          trace_cy_v4, _ret_data, dbg_regs[2]);
            }
            if bltu_s2_a5 {
                $display("[v4 bltu s2,a5]  cy=%d s2=%h a5=%h",
                          trace_cy_v4, dbg_regs[18], dbg_regs[15]);
            }
            if add_s2_s9 {
                $display("[v4 add s2,s2,s9] cy=%d s2_new=%h s9=%h",
                          trace_cy_v4, _ret_data, dbg_regs[25]);
            }
        }
    }

    // M9.A.247: collect last 64 writes to s2 (rd=18). On first LOAD page
    // fault (cause=13), dump the ring — gives the full s2 mutation history
    // leading up to the corrupt s2 = vmemmap VA.
    // M9.A.248 (2026-05-26): also collect last 128 writes to a0 (rd=10).
    // a0 is the return-value register; we want to see who wrote a0 =
    // vmemmap VA right before the `mv s2, a0` at PC 0x80202fe2.
    var a0_ring_pc  : logic<64> [128];
    var a0_ring_cy  : logic<32> [128];
    var a0_ring_data: logic<64> [128];
    var a0_ring_idx : logic<7>       ;
    // Trap-history ring (32 entries)
    var tring_cy : logic<32> [32];
    var tring_pc : logic<64> [32];
    var tring_cau: logic<64> [32];
    var tring_tv : logic<64> [32];
    var tring_idx: logic<5>      ;
    var s2_ring_pc  : logic<64> [64];
    var s2_ring_cy  : logic<32> [64];
    var s2_ring_data: logic<64> [64];
    var s2_ring_idx : logic<6>      ;
    var s2_dumped   : logic         ;
    always_ff (clk, rst) {
        if_reset {
            s2_ring_idx = 6'd0;
            a0_ring_idx = 7'd0;
            s2_dumped   = 1'b0;
            for k in 0..64 {
                s2_ring_pc[k]   = 64'd0;
                s2_ring_cy[k]   = 32'd0;
                s2_ring_data[k] = 64'd0;
            }
            for k in 0..128 {
                a0_ring_pc[k]   = 64'd0;
                a0_ring_cy[k]   = 32'd0;
                a0_ring_data[k] = 64'd0;
            }
            tring_idx = 5'd0;
            for k in 0..32 {
                tring_cy[k]  = 32'd0;
                tring_pc[k]  = 64'd0;
                tring_cau[k] = 64'd0;
                tring_tv[k]  = 64'd0;
            }
        } else {
            if _ret_v && _ret_rd == 5'd18 {
                s2_ring_pc  [s2_ring_idx] = _ret_pc;
                s2_ring_cy  [s2_ring_idx] = trace_cy_v4;
                s2_ring_data[s2_ring_idx] = _ret_data;
                s2_ring_idx               = s2_ring_idx + 6'd1;
            }
            if _ret_v && _ret_rd == 5'd10 {
                a0_ring_pc  [a0_ring_idx] = _ret_pc;
                a0_ring_cy  [a0_ring_idx] = trace_cy_v4;
                a0_ring_data[a0_ring_idx] = _ret_data;
                a0_ring_idx               = a0_ring_idx + 7'd1;
            }
            if dbg_trap_fire {
                tring_cy [tring_idx] = trace_cy_v4;
                tring_pc [tring_idx] = dbg_trap_pc;
                tring_cau[tring_idx] = dbg_trap_cause;
                tring_tv [tring_idx] = if dbg_trap_to_s ? dbg_stval : dbg_mtval;
                tring_idx            = tring_idx + 5'd1;
            }
            if dbg_trap_fire && dbg_trap_cause == 64'd13 && !s2_dumped {
                s2_dumped = 1'b1;
                $display("[v4 trap history first 32]");
                for k in 0..32 {
                    let off: logic<5> = tring_idx + k;
                    $display("  tr[%h] cy=%d pc=%h cause=%h tval=%h",
                              k, tring_cy[off], tring_pc[off], tring_cau[off], tring_tv[off]);
                }
                $display("[v4 s2 history at first load fault] trap_pc=%h",
                          dbg_trap_pc);
                for k in 0..64 {
                    let off: logic<6> = s2_ring_idx + k;
                    $display("  s2[%h] cy=%d pc=%h s2_new=%h",
                              k, s2_ring_cy[off], s2_ring_pc[off], s2_ring_data[off]);
                }
                $display("[v4 a0 history at first load fault]");
                for k in 0..128 {
                    let off: logic<7> = a0_ring_idx + k;
                    $display("  a0[%h] cy=%d pc=%h a0_new=%h",
                              k, a0_ring_cy[off], a0_ring_pc[off], a0_ring_data[off]);
                }
            }
        }
    }

    // M9.A.246b: capture 80 retires after 2nd create_pgd_mapping commit
    // (= cy ~841466) so we can see why paging_init loop doesn't iterate.
    var p2_arm: logic;
    var p2_cnt: logic<7>;
    var p2_pc : logic<64> [80];
    var p2_cy : logic<32> [80];
    always_ff (clk, rst) {
        if_reset {
            p2_arm = 1'b0;
            p2_cnt = 7'd0;
            for k in 0..80 {
                p2_pc[k] = 64'd0;
                p2_cy[k] = 32'd0;
            }
        } else {
            if cpm_entry && trace_cy_v4 >: 32'd841200 && !p2_arm {
                p2_arm = 1'b1;
                p2_cnt = 7'd0;
            } else if p2_arm && _ret_v {
                if p2_cnt <: 7'd80 {
                    p2_pc[p2_cnt] = _ret_pc;
                    p2_cy[p2_cnt] = trace_cy_v4;
                    p2_cnt        = p2_cnt + 7'd1;
                } else {
                    $display("[v4 post-2nd-cpm 80 retires]:");
                    for k in 0..80 {
                        $display("  p2[%h] cy=%d pc=%h", k, p2_cy[k], p2_pc[k]);
                    }
                    p2_arm = 1'b0;
                }
            }
        }
    }

    let target_hit: logic = (dmem_wen || dmem_ren) && (dmem_addr == 64'h0000000080a89ff0);
    always_ff (clk, rst) {
        if_reset {} else if target_hit {
            $display("[v4 L0 PTE @0x80a89ff0] cy=%d wen=%b ren=%b wdata=%h wstrb=%h rdata=%h pc=%h ra=%h a0=%h a1=%h a2=%h a3=%h a4=%h",
                      trace_cy_v4, dmem_wen, dmem_ren, dmem_wdata, dmem_wstrb, dmem_rdata,
                      dbg_pc, dbg_regs[1], dbg_regs[10], dbg_regs[11], dbg_regs[12], dbg_regs[13], dbg_regs[14]);
            $display("  recent retires (oldest first):");
            for k in 0..16 {
                let off: logic<4> = ret_ring_idx + k;
                $display("    ret[%h] cy=%d pc=%h rd=%h data=%h",
                          k, ret_ring_cy[off], ret_ring_pc[off],
                          ret_ring_rd[off], ret_ring_dat[off]);
            }
        }
    }

    // Post-trace ring: when the clear-store at cy ~842402 fires (target_hit
    // with wen=1 wdata=0 in DRAM range), capture next 64 retires so we can
    // see where the caller's control flow goes after returning from
    // __set_fixmap's clear path (v1: re-enters __set_fixmap for populate;
    // v4: presumably branches elsewhere → no populate ever happens).
    var post_arm   : logic;
    var post_cnt   : logic<7>;
    var post_pc    : logic<64> [64];
    var post_cy    : logic<32> [64];
    var post_rd    : logic<5>  [64];
    var post_dat   : logic<64> [64];
    let clear_event: logic = target_hit && dmem_wen && (dmem_wdata == 64'd0);
    always_ff (clk, rst) {
        if_reset {
            post_arm = 1'b0;
            post_cnt = 7'd0;
            for k in 0..64 {
                post_pc[k]  = 64'd0;
                post_cy[k]  = 32'd0;
                post_rd[k]  = 5'd0;
                post_dat[k] = 64'd0;
            }
        } else {
            if clear_event && trace_cy_v4 >: 32'd800000 && !post_arm {
                post_arm = 1'b1;
                post_cnt = 7'd0;
            } else if post_arm && _ret_v {
                if post_cnt <: 7'd64 {
                    post_pc [post_cnt] = _ret_pc;
                    post_cy [post_cnt] = trace_cy_v4;
                    post_rd [post_cnt] = _ret_rd;
                    post_dat[post_cnt] = _ret_data;
                    post_cnt           = post_cnt + 7'd1;
                } else {
                    $display("[v4 post-clear retires] dump 64 retires after clear-store:");
                    for k in 0..64 {
                        $display("  post[%h] cy=%d pc=%h rd=%h data=%h",
                                  k, post_cy[k], post_pc[k], post_rd[k], post_dat[k]);
                    }
                    post_arm = 1'b0;
                }
            }
        }
    }

    // M9.A.257: per-cycle dmem activity dump around suspected failing
    // load cycle (6651880..6651910). Shows dmem_addr / ren / rdata / busy
    // / ptw / IMMU PTW takeover / ALU EX so we can see exactly what
    // o_dmem_addr was at the moment alu_wrap captured 0.
    always_ff (clk, rst) {
        if_reset {} else {
            if trace_cy_v4 >: 32'd6651880 && trace_cy_v4 <: 32'd6651910 {
                $display("[v4 cy=%d] dmem_addr=%h ren=%b wen=%b rdata=%h iptw=%b iptw_addr=---"
                          , trace_cy_v4, dmem_addr, dmem_ren, dmem_wen, dmem_rdata, dbg_iptw_req);
                $display("           dmem_mmu_busy=%b core_dren=%b ptw_req=%b ptw_addr=%h alu_v=%b alu_pc=%h alu_out=%h",
                          dbg_dmm_busy, dbg_core_dren, dbg_ptw_req, dbg_ptw_addr,
                          dbg_alu_valid, dbg_alu_pc, dbg_alu_alu_out);
            }
        }
    }

    // M9.A.256: trace memmap_init_range loop fault chain.
    // Disasm (verified from linux_dram_real_v4_patched.hex):
    //   PC 0x80217740  ld   a4, 0(s10)      ← a4 = mem[s10] (zone start_pfn)
    //   PC 0x80217744  ld   a0, 0(s9)       ← a0 = mem[s9]  (vmemmap base, SUSPECT)
    //   PC 0x80217748  c.li a3, -1
    //   PC 0x8021774a  sub  a4, s0, a4      ← a4 = pfn - start_pfn
    //   PC 0x8021774e  mul  a4, a4, s11     ← a4 *= sizeof(page)=0x38
    //   PC 0x80217752  c.add a0, a0, a4     ← a0 = vmemmap_base + offset
    //   ... (later)
    //   PC 0x80217766  sd   zero, 24(a0)    ← FAULT (badaddr=a0+24=0x9d60)
    //
    // Reverse derivation: a0_final=0x9d48, badaddr=0x9d60. a4=(s0-mem[s10])*0x38.
    // Observed s0=0x802cf, s11=0x38. If mem[s10]=0x80000 then a4=0x9d48 exactly,
    // which means a0_old must be 0 — i.e. ld a0,0(s9) wrongly returns 0.
    // v1 boots same binary to SBI shutdown, so this is a v4-specific load bug.
    //
    // Strategy: ring of last 16 iterations capturing (ld_a4_val, ld_a0_val,
    // cadd_a0_result) per iteration. Freeze on first cause=15 store fault.
    var mm_ldA4_data: logic<64> [16];
    var mm_ldA4_cy  : logic<32> [16];
    var mm_ldA4_idx : logic<4>;
    var mm_ldA0_data: logic<64> [16];
    var mm_ldA0_cy  : logic<32> [16];
    var mm_ldA0_idx : logic<4>;
    var mm_cadd_data: logic<64> [16];
    var mm_cadd_cy  : logic<32> [16];
    var mm_cadd_idx : logic<4>;
    var mm_sub_data : logic<64> [16];
    var mm_sub_cy   : logic<32> [16];
    var mm_sub_idx  : logic<4>;
    var mm_mul_data : logic<64> [16];
    var mm_mul_cy   : logic<32> [16];
    var mm_mul_idx  : logic<4>;
    var mm_freeze   : logic;
    var mm_dumped   : logic;

    // Store page fault (cause=15) snapshot — distinct from existing cause=13.
    var sfault_seen : logic;
    var sfault_cy   : logic<32>;
    var sfault_pc   : logic<64>;
    var sfault_tval : logic<64>;
    var sfault_regs : logic<64> [32];

    let mm_p_ldA4: logic = _ret_v && (_ret_pc == 64'hffffffff80217740);
    let mm_p_ldA0: logic = _ret_v && (_ret_pc == 64'hffffffff80217744);
    let mm_p_sub : logic = _ret_v && (_ret_pc == 64'hffffffff8021774a);
    let mm_p_mul : logic = _ret_v && (_ret_pc == 64'hffffffff8021774e);
    let mm_p_cadd: logic = _ret_v && (_ret_pc == 64'hffffffff80217752);

    always_ff (clk, rst) {
        if_reset {
            mm_ldA4_idx = 4'd0; mm_ldA0_idx = 4'd0; mm_cadd_idx = 4'd0;
            mm_sub_idx  = 4'd0; mm_mul_idx  = 4'd0;
            mm_freeze   = 1'b0; mm_dumped   = 1'b0;
            sfault_seen = 1'b0;
            sfault_cy   = 32'd0;
            sfault_pc   = 64'd0;
            sfault_tval = 64'd0;
            for k in 0..16 {
                mm_ldA4_data[k] = 64'd0; mm_ldA4_cy[k] = 32'd0;
                mm_ldA0_data[k] = 64'd0; mm_ldA0_cy[k] = 32'd0;
                mm_cadd_data[k] = 64'd0; mm_cadd_cy[k] = 32'd0;
                mm_sub_data[k]  = 64'd0; mm_sub_cy[k]  = 32'd0;
                mm_mul_data[k]  = 64'd0; mm_mul_cy[k]  = 32'd0;
            }
            for k in 0..32 { sfault_regs[k] = 64'd0; }
        } else {
            if !mm_freeze {
                if mm_p_ldA4 {
                    mm_ldA4_data[mm_ldA4_idx] = _ret_data;
                    mm_ldA4_cy  [mm_ldA4_idx] = trace_cy_v4;
                    mm_ldA4_idx               = mm_ldA4_idx + 4'd1;
                }
                if mm_p_ldA0 {
                    mm_ldA0_data[mm_ldA0_idx] = _ret_data;
                    mm_ldA0_cy  [mm_ldA0_idx] = trace_cy_v4;
                    mm_ldA0_idx               = mm_ldA0_idx + 4'd1;
                }
                if mm_p_sub {
                    mm_sub_data[mm_sub_idx] = _ret_data;
                    mm_sub_cy  [mm_sub_idx] = trace_cy_v4;
                    mm_sub_idx              = mm_sub_idx + 4'd1;
                }
                if mm_p_mul {
                    mm_mul_data[mm_mul_idx] = _ret_data;
                    mm_mul_cy  [mm_mul_idx] = trace_cy_v4;
                    mm_mul_idx              = mm_mul_idx + 4'd1;
                }
                if mm_p_cadd {
                    mm_cadd_data[mm_cadd_idx] = _ret_data;
                    mm_cadd_cy  [mm_cadd_idx] = trace_cy_v4;
                    mm_cadd_idx               = mm_cadd_idx + 4'd1;
                }
            }
            if dbg_trap_fire && dbg_trap_cause == 64'd15 && !sfault_seen {
                sfault_seen = 1'b1;
                sfault_cy   = trace_cy_v4;
                sfault_pc   = dbg_trap_pc;
                sfault_tval = if dbg_trap_to_s ? dbg_stval : dbg_mtval;
                for i in 0..32 {
                    sfault_regs[i] = dbg_regs[i];
                }
            }
            if sfault_seen && !mm_freeze {
                mm_freeze = 1'b1;
            }
            if mm_freeze && !mm_dumped {
                mm_dumped = 1'b1;
                $display("[v4 STORE PAGE FAULT cause=15] cy=%d pc=%h badaddr=%h sfault_iter15_load_cy=likely_6651894", sfault_cy, sfault_pc, sfault_tval);
                $display("  regs: a0=%h a1=%h a2=%h a3=%h a4=%h a5=%h",
                          sfault_regs[10], sfault_regs[11], sfault_regs[12],
                          sfault_regs[13], sfault_regs[14], sfault_regs[15]);
                $display("  regs: s0=%h s1=%h s7=%h s8=%h s9=%h s10=%h s11=%h",
                          sfault_regs[8], sfault_regs[9], sfault_regs[23],
                          sfault_regs[24], sfault_regs[25], sfault_regs[26], sfault_regs[27]);
                $display("[v4 memmap iter ring: ld_a4 @PC 80217740 last 16, oldest first]");
                for k in 0..16 {
                    let off: logic<4> = mm_ldA4_idx + k;
                    $display("  ldA4[%h] cy=%d data=%h", k, mm_ldA4_cy[off], mm_ldA4_data[off]);
                }
                $display("[v4 memmap iter ring: ld_a0 @PC 80217744 last 16, oldest first]");
                for k in 0..16 {
                    let off: logic<4> = mm_ldA0_idx + k;
                    $display("  ldA0[%h] cy=%d data=%h", k, mm_ldA0_cy[off], mm_ldA0_data[off]);
                }
                $display("[v4 memmap iter ring: sub_a4 @PC 8021774a last 16, oldest first]");
                for k in 0..16 {
                    let off: logic<4> = mm_sub_idx + k;
                    $display("  subA4[%h] cy=%d data=%h", k, mm_sub_cy[off], mm_sub_data[off]);
                }
                $display("[v4 memmap iter ring: mul_a4 @PC 8021774e last 16, oldest first]");
                for k in 0..16 {
                    let off: logic<4> = mm_mul_idx + k;
                    $display("  mulA4[%h] cy=%d data=%h", k, mm_mul_cy[off], mm_mul_data[off]);
                }
                $display("[v4 memmap iter ring: c.add a0 @PC 80217752 last 16, oldest first]");
                for k in 0..16 {
                    let off: logic<4> = mm_cadd_idx + k;
                    $display("  caddA0[%h] cy=%d data=%h", k, mm_cadd_cy[off], mm_cadd_data[off]);
                }
            }
        }
    }
}

#[test(test_v4_linux_boot)]
#[ignore]
module test_v4_linux_boot {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen(clk);

    var pass: logic;
    var r3  : logic<64>;
    var s_cy     : logic<32>;
    var s_ret    : logic<32>;
    var s_lrc    : logic<32>;
    var s_trapcnt: logic<32>;
    var s_lf     : logic    ;
    var s_lpc    : logic<64>;
    var s_ftpc   : logic<64>;
    var s_fcause : logic<64>;
    var s_tlpc   : logic<64>;
    var s_tlcause: logic<64>;
    var s_satp   : logic<64>;
    var s_priv   : logic<2> ;
    var s_pc     : logic<64>;
    var s_uart   : logic<32>;
    var s_ecall  : logic<32>;

    inst harness: test_v4_linux_boot_harness (
        clk             ,
        rst             ,
        o_pass   : pass     ,
        o_r3     : r3       ,
        o_cy     : s_cy     ,
        o_ret    : s_ret    ,
        o_lrc    : s_lrc    ,
        o_trapcnt: s_trapcnt,
        o_lf     : s_lf     ,
        o_lpc    : s_lpc    ,
        o_ftpc   : s_ftpc   ,
        o_fcause : s_fcause ,
        o_tlpc   : s_tlpc   ,
        o_tlcause: s_tlcause,
        o_satp   : s_satp   ,
        o_priv   : s_priv   ,
        o_pc     : s_pc     ,
        o_uart   : s_uart   ,
        o_ecall  : s_ecall  ,
    );

    initial {
        rst.assert(clk);
        clk.next  (50_000_000); // 50M cy — M9.A.255 fixes resolved boot stuck; expand budget for full SBI shutdown
        $display  ("v4 SUMMARY cy=%h ret=%h lrc=%h trap=%h pri=%h satp=%h pc=%h", s_cy, s_ret, s_lrc, s_trapcnt, s_priv, s_satp, s_pc);
        $display  ("v4 SUMMARY lf=%b lpc=%h ftpc=%h fcause=%h tlpc=%h tlcause=%h", s_lf, s_lpc, s_ftpc, s_fcause, s_tlpc, s_tlcause);
        $display  ("v4 SUMMARY uart=%h ecall=%h", s_uart, s_ecall);
        $display  ("v4 linux real boot smoke: x3=%h pass=%b", r3, pass);
        $finish   ();
    }
}
