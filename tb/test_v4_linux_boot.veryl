            if dmem_wen && dmem_addr[31:3] == 32'h10194785 && !a5_dumped {
                st_ca3c28_cy[st_ca3c28_idx]   = cy;
                st_ca3c28_pc[st_ca3c28_idx]   = dbg_pc;
                st_ca3c28_data[st_ca3c28_idx] = dmem_wdata;
                st_ca3c28_idx                 = st_ca3c28_idx + 5'd1;
