// Standalone tests for fp_divider and fp_sqrt modules (multi-cycle D1).
module test_fp_div_sqrt_harness (
    clk   : input  clock    ,
    rst   : input  reset    ,
    o_pass: output logic    ,
    o_r1  : output logic<64>,
    o_r2  : output logic<64>,
    o_r3  : output logic<64>,
) {
    // Kick off the divider and sqrt once after reset; each module takes
    // ~57 cycles to present o_valid. The testbench waits long enough.
    var start_q: logic;
    always_ff (clk, rst) {
        if_reset {
            start_q = 1'b0;
        } else {
            start_q = 1'b1; // one-shot start on the first non-reset cycle
        }
    }
    let start_pulse: logic = !start_q;

    // FDIV: 10.0 / 5.0 = 2.0
    var div_result: logic<64>;
    var div_fflags: logic<5> ;
    var div_valid : logic    ;
    var div_busy  : logic    ;
    inst u_div: fp_divider (
        clk                           ,
        rst                           ,
        i_valid : start_pulse         ,
        i_a     : 64'h4024000000000000, // 10.0
        i_b     : 64'h4014000000000000, //  5.0
        i_rm    : 3'b000              ,
        i_flush : 1'b0                ,
        o_result: div_result          ,
        o_fflags: div_fflags          ,
        o_valid : div_valid           ,
        o_busy  : div_busy            ,
    );

    // FSQRT: sqrt(4.0) = 2.0
    var sqrt_result: logic<64>;
    var sqrt_fflags: logic<5> ;
    var sqrt_valid : logic    ;
    var sqrt_busy  : logic    ;
    inst u_sqrt: fp_sqrt (
        clk                           ,
        rst                           ,
        i_valid : start_pulse         ,
        i_a     : 64'h4010000000000000, // 4.0
        i_rm    : 3'b000              ,
        i_flush : 1'b0                ,
        o_result: sqrt_result         ,
        o_fflags: sqrt_fflags         ,
        o_valid : sqrt_valid          ,
        o_busy  : sqrt_busy           ,
    );

    // Latch the o_valid pulses so the end-of-test check is stable.
    var div_done_q : logic    ;
    var sqrt_done_q: logic    ;
    var div_res_q  : logic<64>;
    var sqrt_res_q : logic<64>;
    always_ff (clk, rst) {
        if_reset {
            div_done_q  = 1'b0;
            sqrt_done_q = 1'b0;
            div_res_q   = '0;
            sqrt_res_q  = '0;
        } else {
            if div_valid {
                div_res_q  = div_result;
                div_done_q = 1'b1;
            }
            if sqrt_valid {
                sqrt_res_q  = sqrt_result;
                sqrt_done_q = 1'b1;
            }
        }
    }

    assign o_r1 = div_res_q;
    assign o_r2 = sqrt_res_q;
    assign o_r3 = 64'd0;
    // DIV: 10/5 = 2.0 = 0x4000000000000000
    // SQRT: sqrt(4.0) = 2.0 = 0x4000000000000000
    assign o_pass = div_done_q && sqrt_done_q && div_res_q == 64'h4000000000000000 && sqrt_res_q
        == 64'h4000000000000000;
}

#[test(test_fp_div_sqrt)]
module test_fp_div_sqrt {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass: logic    ;
    var r1  : logic<64>;
    var r2  : logic<64>;
    var r3  : logic<64>;

    inst harness: test_fp_div_sqrt_harness ( clk, rst, o_pass: pass, o_r1: r1, o_r2: r2, o_r3: r3 );

    initial {
        rst.assert(clk);
        clk.next  (100); // multi-cycle FP div/sqrt: ~57 cycles each
        $display  (r1, r2, r3, pass);
        $assert   (pass, "fp_div 10/5 and fp_sqrt(4) should both be 2.0");
        $display  ("fp_div/sqrt test passed");
        $finish   ();
    }
}
