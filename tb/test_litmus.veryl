// RVWMO litmus-test suite on the SMP SoC (boot_soc_harness on the default
// core).
//
// Runs test/litmus/litmus_n{2,4,8}.hex (built by `make -C test/litmus`): all
// harts boot at 0x80000000, run the litmus battery (CoRR / CoWW / MP / SB /
// LB / IRIW variants + AMO atomicity + LR/SC mutual exclusion) with a
// barrier-framed, jitter-offset iteration loop, and accumulate an outcome
// histogram in DRAM. Hart0 checks the forbidden-outcome table and writes
// tohost: 1 = PASS; any other value is a forbidden outcome or a trap (see
// test/litmus/litmus.S for the test list and encodings). The image needs no
// ROM and runs under MAP_ARCH; tohost is seen by retire_mon on the store.

// N=2: tests 0..9 (no IRIW).
#[test(test_litmus_2hart)]
module test_litmus_2hart {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass  : logic    ;
    var fail  : logic    ;
    var cycles: logic<64>;

    inst h: boot_soc_harness #(
        N_HARTS    : 2,
        DRAM_HEX   : "test/litmus/litmus_n2.hex",
        ROM_EN     : 1'b0,
        PMA_N      : tb_platform_pkg::MAP_ARCH_N,
        PMA_REGIONS: tb_platform_pkg::MAP_ARCH,
        RESET_PC   : 64'h8000_0000,
        PASS_BY_X3 : 1'b0,
        TOHOST_PA  : 64'h8000_1000,
        PROBE_LOG2 : 20,
    ) (
        clk                ,
        rst                ,
        o_pass   : pass    ,
        o_fail   : fail    ,
        o_x3     : _       ,
        o_cycles : cycles  ,
        o_instret: _       ,
        o_last_pc: _       ,
        o_ret_cnt: _       ,
        o_traps  : _       ,
    );

    initial {
        rst.assert(clk);
        for _i in 0..3000 {
            clk.next(10000);
            if pass || fail {
                break;
            }
        }
        clk.next(10);
        $display("litmus(N=2): cycles=%d pass=%b fail=%b", cycles, pass, fail);
        $assert (pass, "litmus(N=2): forbidden outcome, trap, checker or timeout");
        $finish ();
    }
}

// N=4: adds IRIW+fence (test 10); harts 2/3 also stress the barrier/bus on
// the 2-hart tests. #[ignore] (N=4 sim is slow); run with:
//   veryl test --ignored --test test_litmus_4hart
#[test(test_litmus_4hart)]
#[ignore]
module test_litmus_4hart {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass  : logic    ;
    var fail  : logic    ;
    var cycles: logic<64>;

    inst h: boot_soc_harness #(
        N_HARTS    : 4,
        DRAM_HEX   : "test/litmus/litmus_n4.hex",
        ROM_EN     : 1'b0,
        PMA_N      : tb_platform_pkg::MAP_ARCH_N,
        PMA_REGIONS: tb_platform_pkg::MAP_ARCH,
        RESET_PC   : 64'h8000_0000,
        PASS_BY_X3 : 1'b0,
        TOHOST_PA  : 64'h8000_1000,
        PROBE_LOG2 : 20,
    ) (
        clk                ,
        rst                ,
        o_pass   : pass    ,
        o_fail   : fail    ,
        o_x3     : _       ,
        o_cycles : cycles  ,
        o_instret: _       ,
        o_last_pc: _       ,
        o_ret_cnt: _       ,
        o_traps  : _       ,
    );

    initial {
        rst.assert(clk);
        for _i in 0..3000 {
            clk.next(10000);
            if pass || fail {
                break;
            }
        }
        clk.next(10);
        $display("litmus(N=4): cycles=%d pass=%b fail=%b", cycles, pass, fail);
        $assert (pass, "litmus(N=4): forbidden outcome, trap, checker or timeout");
        $finish ();
    }
}

// N=8: same battery, all 8 harts arrive at every sense-reversing
// barrier (litmus.S bakes NH=8), so a starved hart hangs the barrier: the
// check that the memory_bus generic round-robin arm (N>=5) is fair.
// #[ignore] (N=8 sim is slow); run with:
//   veryl test --ignored --test test_litmus_8hart
#[test(test_litmus_8hart)]
#[ignore]
module test_litmus_8hart {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass  : logic    ;
    var fail  : logic    ;
    var cycles: logic<64>;

    inst h: boot_soc_harness #(
        N_HARTS    : 8,
        DRAM_HEX   : "test/litmus/litmus_n8.hex",
        ROM_EN     : 1'b0,
        PMA_N      : tb_platform_pkg::MAP_ARCH_N,
        PMA_REGIONS: tb_platform_pkg::MAP_ARCH,
        RESET_PC   : 64'h8000_0000,
        PASS_BY_X3 : 1'b0,
        TOHOST_PA  : 64'h8000_1000,
        PROBE_LOG2 : 20,
    ) (
        clk                ,
        rst                ,
        o_pass   : pass    ,
        o_fail   : fail    ,
        o_x3     : _       ,
        o_cycles : cycles  ,
        o_instret: _       ,
        o_last_pc: _       ,
        o_ret_cnt: _       ,
        o_traps  : _       ,
    );

    initial {
        rst.assert(clk);
        for _i in 0..4000 {
            clk.next(10000);
            if pass || fail {
                break;
            }
        }
        clk.next(10);
        $display("litmus(N=8): cycles=%d pass=%b fail=%b", cycles, pass, fail);
        $assert (pass, "litmus(N=8): forbidden outcome, trap, checker or timeout");
        $finish ();
    }
}
