// axi4_mem: the memory behind a harness's AXI4 port, an axi4_slave_model
// (DRAM at 0x8000_0000 and an optional ROM) watched by an axi4_mon.
//
// Ports (timing contract):
//   AXI4 slave side of the SoC port (56-bit PA), as axi4_slave_model
//   o_chk: the monitor's sticky protocol flags (axi4_tb_pkg::CHK_*)
module axi4_mem #(
    param ID_W    : u32                   = 1                   ,
    param MEM_DW  : u32                   = 1024                ,
    param HEX     : string                = ""                  ,
    param ROM_EN  : bit                   = 1'b0                ,
    param ROM_DW  : u32                   = 2                   ,
    param ROM_HEX : string                = ""                  ,
    param CFG     : axi4_tb_pkg::SlaveCfg = axi4_tb_pkg::FIXED  ,
    param SEED    : bit<32>               = 32'h1               ,
    param MAX_RD  : u32                   = 8                   ,
    param MAX_WR  : u32                   = 8                   ,
) (
    clk      : input  clock                    ,
    rst      : input  reset                    ,
    i_arvalid: input  logic                    ,
    o_arready: output logic                    ,
    i_arid   : input  logic<ID_W>              ,
    i_araddr : input  logic<56>                ,
    i_arlen  : input  logic<8>                 ,
    i_arsize : input  logic<3>                 ,
    i_arburst: input  logic<2>                 ,
    o_rvalid : output logic                    ,
    i_rready : input  logic                    ,
    o_rid    : output logic<ID_W>              ,
    o_rdata  : output logic<64>                ,
    o_rresp  : output logic<2>                 ,
    o_rlast  : output logic                    ,
    i_awvalid: input  logic                    ,
    o_awready: output logic                    ,
    i_awid   : input  logic<ID_W>              ,
    i_awaddr : input  logic<56>                ,
    i_awlen  : input  logic<8>                 ,
    i_awsize : input  logic<3>                 ,
    i_awburst: input  logic<2>                 ,
    i_wvalid : input  logic                    ,
    o_wready : output logic                    ,
    i_wdata  : input  logic<64>                ,
    i_wstrb  : input  logic<8>                 ,
    i_wlast  : input  logic                    ,
    o_bvalid : output logic                    ,
    i_bready : input  logic                    ,
    o_bid    : output logic<ID_W>              ,
    o_bresp  : output logic<2>                 ,
    o_chk    : output logic<axi4_tb_pkg::CHK_N>,
) {
    let araddr: logic<64> = {8'd0, i_araddr};
    let awaddr: logic<64> = {8'd0, i_awaddr};

    inst u_slave: axi4_slave_model #(
        ID_W    : ID_W          ,
        MEM_BASE: 64'h8000_0000 ,
        MEM_DW  : MEM_DW        ,
        HEX_EN  : 1'b1          ,
        HEX     : HEX           ,
        ROM_EN  : ROM_EN        ,
        ROM_BASE: 64'h0         ,
        ROM_DW  : ROM_DW        ,
        ROM_HEX : ROM_HEX       ,
        CFG     : CFG           ,
        SEED    : SEED          ,
    ) (
        clk                  ,
        rst                  ,
        i_arvalid            ,
        o_arready            ,
        i_arid               ,
        i_araddr : araddr    ,
        i_arlen              ,
        o_rvalid             ,
        i_rready             ,
        o_rid                ,
        o_rdata              ,
        o_rresp              ,
        o_rlast              ,
        i_awvalid            ,
        o_awready            ,
        i_awid               ,
        i_awaddr : awaddr    ,
        i_awlen              ,
        i_wvalid             ,
        o_wready             ,
        i_wdata              ,
        i_wstrb              ,
        o_bvalid             ,
        i_bready             ,
        o_bid                ,
        o_bresp              ,
    );

    inst u_mon: axi4_mon #(
        ID_W  : ID_W  ,
        MAX_RD: MAX_RD,
        MAX_WR: MAX_WR,
    ) (
        clk                    ,
        rst                    ,
        i_arvalid              ,
        i_arready: o_arready   ,
        i_arid                 ,
        i_araddr : araddr      ,
        i_arlen                ,
        i_arsize               ,
        i_arburst              ,
        i_rvalid : o_rvalid    ,
        i_rready               ,
        i_rid    : o_rid       ,
        i_rdata  : o_rdata     ,
        i_rresp  : o_rresp     ,
        i_rlast  : o_rlast     ,
        i_awvalid              ,
        i_awready: o_awready   ,
        i_awid                 ,
        i_awaddr : awaddr      ,
        i_awlen                ,
        i_awsize               ,
        i_awburst              ,
        i_wvalid               ,
        i_wready : o_wready    ,
        i_wdata                ,
        i_wstrb                ,
        i_wlast                ,
        i_bvalid : o_bvalid    ,
        i_bready               ,
        i_bid    : o_bid       ,
        i_bresp  : o_bresp     ,
        o_chk                  ,
    );
}
