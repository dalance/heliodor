// RV64C compressed instruction expander unit test.
// Verifies a representative set of encodings expand to the expected
// 32-bit instruction, and that known illegal patterns set o_illegal.
module test_c_expander_harness (
    clk   : input  clock   ,
    rst   : input  reset   ,
    o_pass: output logic   ,
    o_done: output logic   ,
    o_tc  : output logic<8>,
) {
    var tc: logic<8>;

    always_ff {
        if_reset {
            tc = 8'd0;
        } else {
            tc = tc + 8'd1;
        }
    }

    var cinstr  : logic<16>;
    var instr   : logic<32>;
    var illegal : logic    ;

    inst dut: c_expander (
        i_cinstr : cinstr ,
        o_instr  : instr  ,
        o_illegal: illegal,
    );

    var exp_instr  : logic<32>;
    var exp_illegal: logic    ;
    var valid      : logic    ;

    always_comb {
        cinstr      = 16'd0;
        exp_instr   = 32'h0000_0013; // default NOP
        exp_illegal = 1'b0;
        valid       = 1'b1;

        case tc {
            // tc=1: C.NOP (0x0001) → ADDI x0, x0, 0 = 0x00000013
            8'd1: {
                cinstr    = 16'h0001;
                exp_instr = 32'h0000_0013;
            }
            // tc=2: C.LI x10, 0 (0x4501) → ADDI x10, x0, 0 = 0x00000513
            8'd2: {
                cinstr    = 16'h4501;
                exp_instr = 32'h0000_0513;
            }
            // tc=3: C.LI x15, 1 (0x4785) → ADDI x15, x0, 1 = 0x00100793
            8'd3: {
                cinstr    = 16'h4785;
                exp_instr = 32'h0010_0793;
            }
            // tc=4: C.MV x10, x11 (0x852e) → ADD x10, x0, x11 = 0x00b00533
            8'd4: {
                cinstr    = 16'h852e;
                exp_instr = 32'h00b0_0533;
            }
            // tc=5: C.ADD x10, x11 (0x952e) → ADD x10, x10, x11 = 0x00b50533
            8'd5: {
                cinstr    = 16'h952e;
                exp_instr = 32'h00b5_0533;
            }
            // tc=6: All-zero (0x0000) → C.ADDI4SPN with nzuimm=0 → illegal
            8'd6: {
                cinstr      = 16'h0000;
                exp_illegal = 1'b1;
                exp_instr   = 32'h0000_0013; // default NOP
            }
            // tc=7: C.EBREAK (0x9002) → EBREAK = 0x00100073
            8'd7: {
                cinstr    = 16'h9002;
                exp_instr = 32'h0010_0073;
            }
            // tc=8: C.ADDI x10, 1 (0x0505) → ADDI x10, x10, 1 = 0x00150513
            8'd8: {
                cinstr    = 16'h0505;
                exp_instr = 32'h0015_0513;
            }
            // tc=9: C.ADDIW x10, 1 (0x2505) → ADDIW x10, x10, 1 = 0x0015051b
            8'd9: {
                cinstr    = 16'h2505;
                exp_instr = 32'h0015_051b;
            }
            // tc=10: C.J +0 (0xa001) → JAL x0, 0 = 0x0000006f
            8'd10: {
                cinstr    = 16'ha001;
                exp_instr = 32'h0000_006f;
            }
            // tc=11: C.JR x1 (0x8082) → JALR x0, x1, 0 = 0x00008067
            8'd11: {
                cinstr    = 16'h8082;
                exp_instr = 32'h0000_8067;
            }
            // tc=12: C.JALR x1 (0x9082) → JALR x1, x1, 0 = 0x000080e7
            8'd12: {
                cinstr    = 16'h9082;
                exp_instr = 32'h0000_80e7;
            }
            default: {
                valid = 1'b0;
            }
        }
    }

    var failed: logic;
    always_ff {
        if_reset {
            failed = 1'b0;
        } else if valid && (instr != exp_instr || illegal != exp_illegal) {
            failed = 1'b1;
        }
    }

    assign o_tc   = tc;
    assign o_pass = !failed;
    assign o_done = tc >: 8'd14;
}

#[test(test_c_expander)]
module test_c_expander {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen;

    var pass: logic   ;
    var done: logic   ;
    var tc  : logic<8>;

    inst harness: test_c_expander_harness (
        clk   : clk ,
        rst   : rst ,
        o_pass: pass,
        o_done: done,
        o_tc  : tc  ,
    );

    initial {
        rst.assert(clk);
        for _i: i32 in 0..16 {
            clk.next(1);
        }
        $assert (pass, "c_expander test failed");
        $display("c_expander test passed");
        $finish ();
    }
}
