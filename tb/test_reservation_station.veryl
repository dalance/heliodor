// Unit test for reservation_station: dispatch → CDB wakeup → issue.
module test_reservation_station_harness (
    clk      : input  clock    ,
    rst      : input  reset    ,
    o_cycle  : output logic<16>,
    o_issued : output logic    ,
    o_s1_data: output logic<64>,
    o_s2_data: output logic<64>,
    o_rob    : output logic<5> ,
    o_done   : output logic    ,
    o_pass   : output logic    ,
) {
    var cyc             : logic<16>     ;
    var squash_mask_zero: logic     [32];
    always_comb {
        for i: i32 in 0..32 {
            squash_mask_zero[i] = 1'b0;
        }
    }
    always_ff (clk, rst) {
        if_reset {
            cyc = 16'd0;
        } else {
            cyc = cyc + 16'd1;
        }
    }

    // Dispatch one ADD at cycle 2 with rs1 pending (tag=3, epoch=0),
    // rs2 ready (data=0x5). CDB0 broadcasts tag=3 data=0x7 at cycle 4.
    // Issue should fire cycle 5 with s1=0x7, s2=0x5, rob=5.
    var disp_valid   : logic    ;
    var disp_s1_ready: logic    ;
    var disp_s2_ready: logic    ;
    var cdb0_valid   : logic    ;
    var cdb0_rob     : logic<5> ;
    var cdb0_data    : logic<64>;

    always_comb {
        disp_valid    = cyc == 16'd2;
        disp_s1_ready = 1'b0;
        disp_s2_ready = 1'b1;
        cdb0_valid    = cyc == 16'd4;
        cdb0_rob      = 5'd3;
        cdb0_data     = 64'h0000000000000007;
    }

    var issue_valid : logic                    ;
    var issue_pc    : logic                <64>;
    var issue_op    : alu_pkg::AluOp           ;
    var issue_src_a : pipeline_pkg::AluSrcA    ;
    var issue_src_b : pipeline_pkg::AluSrcB    ;
    var issue_imm   : logic                <64>;
    var issue_rd    : logic                <5> ;
    var issue_rs1   : logic                <5> ;
    var issue_rs2   : logic                <5> ;
    var issue_s1    : logic                <64>;
    var issue_s2    : logic                <64>;
    var issue_wen   : logic                    ;
    var issue_rob   : logic                <5> ;
    var issue_epoch : logic                <2> ;
    var issue2_valid: logic                    ;
    var issue2_pc   : logic                <64>;
    var issue2_op   : alu_pkg::AluOp           ;
    var issue2_src_a: pipeline_pkg::AluSrcA    ;
    var issue2_src_b: pipeline_pkg::AluSrcB    ;
    var issue2_imm  : logic                <64>;
    var issue2_rd   : logic                <5> ;
    var issue2_rs1  : logic                <5> ;
    var issue2_rs2  : logic                <5> ;
    var issue2_s1   : logic                <64>;
    var issue2_s2   : logic                <64>;
    var issue2_wen  : logic                    ;
    var issue2_rob  : logic                <5> ;
    var issue2_epoch: logic                <2> ;
    var disp_ready  : logic                    ;
    var sel_vld     : logic                    ;

    inst u_rs: reservation_station (
        clk                                            ,
        rst                                            ,
        i_dispatch_valid   : disp_valid                ,
        i_dispatch_pc      : 64'h1000                  ,
        i_dispatch_alu_op  : alu_pkg::AluOp::ADD       ,
        i_dispatch_src_a   : pipeline_pkg::AluSrcA::REG,
        i_dispatch_src_b   : pipeline_pkg::AluSrcB::REG,
        i_dispatch_imm     : 64'd0                     ,
        i_dispatch_rd      : 5'd7                      ,
        i_dispatch_rs1     : 5'd1                      ,
        i_dispatch_rs2     : 5'd2                      ,
        i_dispatch_wen     : 1'b1                      ,
        i_dispatch_rob     : 5'd5                      ,
        i_dispatch_epoch   : 2'd0                      ,
        i_dispatch_s1_ready: disp_s1_ready             ,
        i_dispatch_s1_tag  : 5'd3                      ,
        i_dispatch_s1_epoch: 2'd0                      ,
        i_dispatch_s1_data : 64'd0                     ,
        i_dispatch_s2_ready: disp_s2_ready             ,
        i_dispatch_s2_tag  : 5'd0                      ,
        i_dispatch_s2_epoch: 2'd0                      ,
        i_dispatch_s2_data : 64'h0000000000000005      ,
        o_dispatch_ready   : disp_ready                ,
        o_issue_valid      : issue_valid               ,
        o_issue_pc         : issue_pc                  ,
        o_issue_alu_op     : issue_op                  ,
        o_issue_src_a      : issue_src_a               ,
        o_issue_src_b      : issue_src_b               ,
        o_issue_imm        : issue_imm                 ,
        o_issue_rd         : issue_rd                  ,
        o_issue_rs1        : issue_rs1                 ,
        o_issue_rs2        : issue_rs2                 ,
        o_issue_s1_data    : issue_s1                  ,
        o_issue_s2_data    : issue_s2                  ,
        o_issue_wen        : issue_wen                 ,
        o_issue_rob        : issue_rob                 ,
        o_issue_epoch      : issue_epoch               ,
        i_issue_stall      : 1'b0                      ,
        o_issue2_valid     : issue2_valid              ,
        o_issue2_pc        : issue2_pc                 ,
        o_issue2_alu_op    : issue2_op                 ,
        o_issue2_src_a     : issue2_src_a              ,
        o_issue2_src_b     : issue2_src_b              ,
        o_issue2_imm       : issue2_imm                ,
        o_issue2_rd        : issue2_rd                 ,
        o_issue2_rs1       : issue2_rs1                ,
        o_issue2_rs2       : issue2_rs2                ,
        o_issue2_s1_data   : issue2_s1                 ,
        o_issue2_s2_data   : issue2_s2                 ,
        o_issue2_wen       : issue2_wen                ,
        o_issue2_rob       : issue2_rob                ,
        o_issue2_epoch     : issue2_epoch              ,
        i_issue2_stall     : 1'b0                      ,
        i_cdb0_valid       : cdb0_valid                ,
        i_cdb0_rob         : cdb0_rob                  ,
        i_cdb0_epoch       : 2'd0                      ,
        i_cdb0_data        : cdb0_data                 ,
        i_cdb1_valid       : 1'b0                      ,
        i_cdb1_rob         : 5'd0                      ,
        i_cdb1_epoch       : 2'd0                      ,
        i_cdb1_data        : 64'd0                     ,
        i_cdb2_valid       : 1'b0                      ,
        i_cdb2_rob         : 5'd0                      ,
        i_cdb2_epoch       : 2'd0                      ,
        i_cdb2_data        : 64'd0                     ,
        i_flush            : 1'b0                      ,
        i_squash_valid     : 1'b0                      ,
        i_squash_mask      : squash_mask_zero          ,
        o_sel_valid        : sel_vld                   ,
    );

    // Latch the issue observation for end-of-test check.
    var saw_issue: logic    ;
    var saw_s1   : logic<64>;
    var saw_s2   : logic<64>;
    var saw_rob  : logic<5> ;
    always_ff (clk, rst) {
        if_reset {
            saw_issue = 1'b0;
            saw_s1    = '0;
            saw_s2    = '0;
            saw_rob   = '0;
        } else if issue_valid && !saw_issue {
            saw_issue = 1'b1;
            saw_s1    = issue_s1;
            saw_s2    = issue_s2;
            saw_rob   = issue_rob;
        }
    }

    assign o_cycle   = cyc;
    assign o_issued  = saw_issue;
    assign o_s1_data = saw_s1;
    assign o_s2_data = saw_s2;
    assign o_rob     = saw_rob;
    assign o_done    = cyc >: 16'd20;
    assign o_pass    = saw_issue && saw_s1 == 64'h0000000000000007 && saw_s2 == 64'h0000000000000005 && saw_rob == 5'd5;
}

#[test(test_reservation_station)]
module test_reservation_station {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen;

    var cycle  : logic<16>;
    var issued : logic    ;
    var s1_data: logic<64>;
    var s2_data: logic<64>;
    var rob    : logic<5> ;
    var done   : logic    ;
    var pass   : logic    ;

    inst harness: test_reservation_station_harness (
        clk               ,
        rst               ,
        o_cycle  : cycle  ,
        o_issued : issued ,
        o_s1_data: s1_data,
        o_s2_data: s2_data,
        o_rob    : rob    ,
        o_done   : done   ,
        o_pass   : pass   ,
    );

    initial {
        rst.assert(clk);
        for _i: i32 in 0..30 {
            clk.next(1);
        }
        $display("cycle=%d issued=%d s1=%h s2=%h rob=%d", cycle, issued, s1_data, s2_data, rob);
        $assert (pass, "reservation_station: dispatch→CDB wakeup→issue failed");
        $display("reservation_station test passed");
        $finish ();
    }
}

// Dual-issue test: dispatch two entries with all operands ready,
// expect both sel and sel2 to fire in a single cycle.
module test_reservation_station_dual_harness (
    clk     : input  clock    ,
    rst     : input  reset    ,
    o_cycle : output logic<16>,
    o_pass  : output logic    ,
) {
    var cyc             : logic<16>     ;
    var squash_mask_zero: logic     [32];
    always_comb {
        for i: i32 in 0..32 {
            squash_mask_zero[i] = 1'b0;
        }
    }
    always_ff (clk, rst) {
        if_reset {
            cyc = 16'd0;
        } else {
            cyc = cyc + 16'd1;
        }
    }

    // Cycle 2: dispatch entry A (rob=10, rs1 pending on tag=3)
    // Cycle 3: dispatch entry B (rob=11, rs1 pending on tag=4)
    // Cycle 5: CDB0 broadcasts tag=3 data=100, CDB1 broadcasts tag=4
    //          data=200 simultaneously → both entries wake up.
    // Cycle 6: dual-issue (slot0: A, slot1: B) fires registered.
    var disp_valid: logic    ;
    var disp_rob  : logic<5> ;
    var disp_tag  : logic<5> ;
    var cdb0_valid: logic    ;
    var cdb1_valid: logic    ;

    always_comb {
        disp_valid = (cyc == 16'd2) || (cyc == 16'd3);
        disp_rob   = if cyc == 16'd2 ? 5'd10 : 5'd11;
        disp_tag   = if cyc == 16'd2 ? 5'd3 : 5'd4;
        cdb0_valid = cyc == 16'd5;
        cdb1_valid = cyc == 16'd5;
    }

    var issue_valid : logic           ;
    var issue_rob   : logic       <5> ;
    var issue_s1    : logic       <64>;
    var issue2_valid: logic           ;
    var issue2_rob  : logic       <5> ;
    var issue2_s1   : logic       <64>;
    var issue_pc    : logic       <64>;
    var issue_op    : alu_pkg::AluOp  ;
    var issue_src_a : pipeline_pkg::AluSrcA;
    var issue_src_b : pipeline_pkg::AluSrcB;
    var issue_imm   : logic       <64>;
    var issue_rd    : logic       <5> ;
    var issue_rs1   : logic       <5> ;
    var issue_rs2   : logic       <5> ;
    var issue_s2    : logic       <64>;
    var issue_wen   : logic           ;
    var issue_epoch : logic       <2> ;
    var issue2_pc   : logic       <64>;
    var issue2_op   : alu_pkg::AluOp  ;
    var issue2_src_a: pipeline_pkg::AluSrcA;
    var issue2_src_b: pipeline_pkg::AluSrcB;
    var issue2_imm  : logic       <64>;
    var issue2_rd   : logic       <5> ;
    var issue2_rs1  : logic       <5> ;
    var issue2_rs2  : logic       <5> ;
    var issue2_s2   : logic       <64>;
    var issue2_wen  : logic           ;
    var issue2_epoch: logic       <2> ;
    var disp_ready  : logic           ;
    var sel_vld     : logic           ;

    inst u_rs: reservation_station (
        clk                                            ,
        rst                                            ,
        i_dispatch_valid   : disp_valid                ,
        i_dispatch_pc      : 64'h2000                  ,
        i_dispatch_alu_op  : alu_pkg::AluOp::ADD       ,
        i_dispatch_src_a   : pipeline_pkg::AluSrcA::REG,
        i_dispatch_src_b   : pipeline_pkg::AluSrcB::REG,
        i_dispatch_imm     : 64'd0                     ,
        i_dispatch_rd      : 5'd8                      ,
        i_dispatch_rs1     : 5'd1                      ,
        i_dispatch_rs2     : 5'd2                      ,
        i_dispatch_wen     : 1'b1                      ,
        i_dispatch_rob     : disp_rob                  ,
        i_dispatch_epoch   : 2'd0                      ,
        i_dispatch_s1_ready: 1'b0                      ,
        i_dispatch_s1_tag  : disp_tag                  ,
        i_dispatch_s1_epoch: 2'd0                      ,
        i_dispatch_s1_data : 64'd0                     ,
        i_dispatch_s2_ready: 1'b1                      ,
        i_dispatch_s2_tag  : 5'd0                      ,
        i_dispatch_s2_epoch: 2'd0                      ,
        i_dispatch_s2_data : 64'd0                     ,
        o_dispatch_ready   : disp_ready                ,
        o_issue_valid      : issue_valid               ,
        o_issue_pc         : issue_pc                  ,
        o_issue_alu_op     : issue_op                  ,
        o_issue_src_a      : issue_src_a               ,
        o_issue_src_b      : issue_src_b               ,
        o_issue_imm        : issue_imm                 ,
        o_issue_rd         : issue_rd                  ,
        o_issue_rs1        : issue_rs1                 ,
        o_issue_rs2        : issue_rs2                 ,
        o_issue_s1_data    : issue_s1                  ,
        o_issue_s2_data    : issue_s2                  ,
        o_issue_wen        : issue_wen                 ,
        o_issue_rob        : issue_rob                 ,
        o_issue_epoch      : issue_epoch               ,
        i_issue_stall      : 1'b0                      ,
        o_issue2_valid     : issue2_valid              ,
        o_issue2_pc        : issue2_pc                 ,
        o_issue2_alu_op    : issue2_op                 ,
        o_issue2_src_a     : issue2_src_a              ,
        o_issue2_src_b     : issue2_src_b              ,
        o_issue2_imm       : issue2_imm                ,
        o_issue2_rd        : issue2_rd                 ,
        o_issue2_rs1       : issue2_rs1                ,
        o_issue2_rs2       : issue2_rs2                ,
        o_issue2_s1_data   : issue2_s1                 ,
        o_issue2_s2_data   : issue2_s2                 ,
        o_issue2_wen       : issue2_wen                ,
        o_issue2_rob       : issue2_rob                ,
        o_issue2_epoch     : issue2_epoch              ,
        i_issue2_stall     : 1'b0                      ,
        i_cdb0_valid       : cdb0_valid                ,
        i_cdb0_rob         : 5'd3                      ,
        i_cdb0_epoch       : 2'd0                      ,
        i_cdb0_data        : 64'd100                   ,
        i_cdb1_valid       : cdb1_valid                ,
        i_cdb1_rob         : 5'd4                      ,
        i_cdb1_epoch       : 2'd0                      ,
        i_cdb1_data        : 64'd200                   ,
        i_cdb2_valid       : 1'b0                      ,
        i_cdb2_rob         : 5'd0                      ,
        i_cdb2_epoch       : 2'd0                      ,
        i_cdb2_data        : 64'd0                     ,
        i_flush            : 1'b0                      ,
        i_squash_valid     : 1'b0                      ,
        i_squash_mask      : squash_mask_zero          ,
        o_sel_valid        : sel_vld                   ,
    );

    // Latch dual-issue observation: both should fire in the same cycle
    // after both entries are dispatched (cyc=4 or later).
    var saw_dual  : logic    ;
    var saw_rob_a : logic<5> ;
    var saw_rob_b : logic<5> ;
    var saw_data_a: logic<64>;
    var saw_data_b: logic<64>;
    always_ff (clk, rst) {
        if_reset {
            saw_dual   = 1'b0;
            saw_rob_a  = '0;
            saw_rob_b  = '0;
            saw_data_a = '0;
            saw_data_b = '0;
        } else if issue_valid && issue2_valid && !saw_dual {
            saw_dual   = 1'b1;
            saw_rob_a  = issue_rob;
            saw_rob_b  = issue2_rob;
            saw_data_a = issue_s1;
            saw_data_b = issue2_s1;
        }
    }

    assign o_cycle = cyc;
    // Pass: both issue ports fired in the same cycle; the first entry
    // dispatched (rob=10) takes slot0 by lowest-index priority, second
    // (rob=11) takes slot1. Data matches the dispatched payload.
    assign o_pass  = saw_dual
                  && saw_rob_a == 5'd10 && saw_data_a == 64'd100
                  && saw_rob_b == 5'd11 && saw_data_b == 64'd200;
}

#[test(test_reservation_station_dual)]
module test_reservation_station_dual {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen;

    var cycle: logic<16>;
    var pass : logic    ;

    inst harness: test_reservation_station_dual_harness (
        clk            ,
        rst            ,
        o_cycle: cycle ,
        o_pass : pass  ,
    );

    initial {
        rst.assert(clk);
        for _i: i32 in 0..30 {
            clk.next(1);
        }
        $display("dual: cycle=%d pass=%d", cycle, pass);
        $assert (pass, "reservation_station dual-issue failed");
        $display("reservation_station dual-issue test passed");
        $finish ();
    }
}

// Squash test: dispatch an entry whose ROB index is later in the
// squash mask; confirm the entry is invalidated and never issues.
module test_reservation_station_squash_harness (
    clk     : input  clock    ,
    rst     : input  reset    ,
    o_cycle : output logic<16>,
    o_pass  : output logic    ,
) {
    var cyc               : logic<16>     ;
    var squash_mask_active: logic     [32];
    var squash_mask_zero  : logic     [32];
    always_comb {
        for i: i32 in 0..32 {
            squash_mask_zero[i]   = 1'b0;
            squash_mask_active[i] = i == 32'd10; // mask bit 10
        }
    }
    always_ff (clk, rst) {
        if_reset {
            cyc = 16'd0;
        } else {
            cyc = cyc + 16'd1;
        }
    }

    // Cycle 2: dispatch entry A (rob=10, fully ready).
    // Cycle 3: squash with mask[10]=1 — entry A invalidated before issuing.
    // Observation window: o_issue_valid must remain 0 for all subsequent
    // cycles (the entry never issues despite being ready).
    var disp_valid   : logic    ;
    var squash_valid : logic    ;
    var squash_mask  : logic [32];

    always_comb {
        disp_valid   = cyc == 16'd2;
        squash_valid = cyc == 16'd3;
        for i: i32 in 0..32 {
            squash_mask[i] = if squash_valid ? squash_mask_active[i] : 1'b0;
        }
    }

    var issue_valid : logic           ;
    var issue_pc    : logic       <64>;
    var issue_op    : alu_pkg::AluOp  ;
    var issue_src_a : pipeline_pkg::AluSrcA;
    var issue_src_b : pipeline_pkg::AluSrcB;
    var issue_imm   : logic       <64>;
    var issue_rd    : logic       <5> ;
    var issue_rs1   : logic       <5> ;
    var issue_rs2   : logic       <5> ;
    var issue_s1    : logic       <64>;
    var issue_s2    : logic       <64>;
    var issue_wen   : logic           ;
    var issue_rob   : logic       <5> ;
    var issue_epoch : logic       <2> ;
    var issue2_valid: logic           ;
    var issue2_pc   : logic       <64>;
    var issue2_op   : alu_pkg::AluOp  ;
    var issue2_src_a: pipeline_pkg::AluSrcA;
    var issue2_src_b: pipeline_pkg::AluSrcB;
    var issue2_imm  : logic       <64>;
    var issue2_rd   : logic       <5> ;
    var issue2_rs1  : logic       <5> ;
    var issue2_rs2  : logic       <5> ;
    var issue2_s1   : logic       <64>;
    var issue2_s2   : logic       <64>;
    var issue2_wen  : logic           ;
    var issue2_rob  : logic       <5> ;
    var issue2_epoch: logic       <2> ;
    var disp_ready  : logic           ;
    var sel_vld     : logic           ;

    inst u_rs: reservation_station (
        clk                                            ,
        rst                                            ,
        i_dispatch_valid   : disp_valid                ,
        i_dispatch_pc      : 64'h3000                  ,
        i_dispatch_alu_op  : alu_pkg::AluOp::ADD       ,
        i_dispatch_src_a   : pipeline_pkg::AluSrcA::REG,
        i_dispatch_src_b   : pipeline_pkg::AluSrcB::REG,
        i_dispatch_imm     : 64'd0                     ,
        i_dispatch_rd      : 5'd9                      ,
        i_dispatch_rs1     : 5'd1                      ,
        i_dispatch_rs2     : 5'd2                      ,
        i_dispatch_wen     : 1'b1                      ,
        i_dispatch_rob     : 5'd10                     ,
        i_dispatch_epoch   : 2'd0                      ,
        i_dispatch_s1_ready: 1'b1                      ,
        i_dispatch_s1_tag  : 5'd0                      ,
        i_dispatch_s1_epoch: 2'd0                      ,
        i_dispatch_s1_data : 64'd42                    ,
        i_dispatch_s2_ready: 1'b1                      ,
        i_dispatch_s2_tag  : 5'd0                      ,
        i_dispatch_s2_epoch: 2'd0                      ,
        i_dispatch_s2_data : 64'd84                    ,
        o_dispatch_ready   : disp_ready                ,
        o_issue_valid      : issue_valid               ,
        o_issue_pc         : issue_pc                  ,
        o_issue_alu_op     : issue_op                  ,
        o_issue_src_a      : issue_src_a               ,
        o_issue_src_b      : issue_src_b               ,
        o_issue_imm        : issue_imm                 ,
        o_issue_rd         : issue_rd                  ,
        o_issue_rs1        : issue_rs1                 ,
        o_issue_rs2        : issue_rs2                 ,
        o_issue_s1_data    : issue_s1                  ,
        o_issue_s2_data    : issue_s2                  ,
        o_issue_wen        : issue_wen                 ,
        o_issue_rob        : issue_rob                 ,
        o_issue_epoch      : issue_epoch               ,
        i_issue_stall      : 1'b0                      ,
        o_issue2_valid     : issue2_valid              ,
        o_issue2_pc        : issue2_pc                 ,
        o_issue2_alu_op    : issue2_op                 ,
        o_issue2_src_a     : issue2_src_a              ,
        o_issue2_src_b     : issue2_src_b              ,
        o_issue2_imm       : issue2_imm                ,
        o_issue2_rd        : issue2_rd                 ,
        o_issue2_rs1       : issue2_rs1                ,
        o_issue2_rs2       : issue2_rs2                ,
        o_issue2_s1_data   : issue2_s1                 ,
        o_issue2_s2_data   : issue2_s2                 ,
        o_issue2_wen       : issue2_wen                ,
        o_issue2_rob       : issue2_rob                ,
        o_issue2_epoch     : issue2_epoch              ,
        i_issue2_stall     : 1'b0                      ,
        i_cdb0_valid       : 1'b0                      ,
        i_cdb0_rob         : 5'd0                      ,
        i_cdb0_epoch       : 2'd0                      ,
        i_cdb0_data        : 64'd0                     ,
        i_cdb1_valid       : 1'b0                      ,
        i_cdb1_rob         : 5'd0                      ,
        i_cdb1_epoch       : 2'd0                      ,
        i_cdb1_data        : 64'd0                     ,
        i_cdb2_valid       : 1'b0                      ,
        i_cdb2_rob         : 5'd0                      ,
        i_cdb2_epoch       : 2'd0                      ,
        i_cdb2_data        : 64'd0                     ,
        i_flush            : 1'b0                      ,
        i_squash_valid     : squash_valid              ,
        i_squash_mask      : squash_mask               ,
        o_sel_valid        : sel_vld                   ,
    );

    // Expect: o_issue_valid stays 0 for all cycles ≥ 4 (the squashed
    // entry never emerges at the registered output).
    var saw_issue: logic;
    always_ff (clk, rst) {
        if_reset {
            saw_issue = 1'b0;
        } else if issue_valid && cyc >: 16'd3 {
            saw_issue = 1'b1;
        }
    }

    assign o_cycle = cyc;
    assign o_pass  = !saw_issue; // pass = never saw a post-squash issue
}

#[test(test_reservation_station_squash)]
module test_reservation_station_squash {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen;

    var cycle: logic<16>;
    var pass : logic    ;

    inst harness: test_reservation_station_squash_harness (
        clk            ,
        rst            ,
        o_cycle: cycle ,
        o_pass : pass  ,
    );

    initial {
        rst.assert(clk);
        for _i: i32 in 0..30 {
            clk.next(1);
        }
        $display("squash: cycle=%d pass=%d", cycle, pass);
        $assert (pass, "reservation_station squash suppression failed");
        $display("reservation_station squash test passed");
        $finish ();
    }
}
