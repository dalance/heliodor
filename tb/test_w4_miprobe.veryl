    var pass  : logic    ;
    var fail  : logic    ;
    var tohost: logic<32>;
    inst h: test_arch_common_harness #(
        CORE      : tb_core_sel::CORE_W4           ,
        HEX_FILE  : "test/directed/mi_csr_warl.hex",
