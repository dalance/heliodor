// test_sched_chk: the invariant checkers of wb_resv, busy_table, prf and iq
// raise their flags on injected violations (and only then).
#[test(test_sched_chk)]
module test_sched_chk {
    import core_types::<cfg_w2>::*;
    import opclass_pkg::*;
    import fu_pkg::*;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    // wb_resv: a select claiming a slot an earlier select already holds.
    var rs_resv: WbSlot          ;
    var rs_ok  : logic <WB_OFS_N>;
    var rs_gnt : WbSlot          ;
    var rs_perf: logic <2>       ;
    var rs_chk : logic <2>       ;
    inst u_rs: wb_resv #(
        D: 3,
    ) (
        clk                ,
        rst                ,
        o_ok      : rs_ok  ,
        i_resv    : rs_resv,
        i_hf_req  : 1'b0   ,
        o_hf_grant: rs_gnt ,
        o_perf    : rs_perf,
        o_chk     : rs_chk ,
    );

    // busy_table: a clear and a wake of one pdst in one cycle.
    var bt_clr_v: logic [2]   ;
    var bt_clr  : PReg  [2]   ;
    var wake    : Wake  [WB_N];
    var bt_rd   : PReg  [6]   ;
    var bt_rdy  : logic [6]   ;
    var bt_chk  : logic       ;
    inst u_bt: busy_table::<cfg_w2> (
        clk                  ,
        rst                  ,
        i_clr_valid: bt_clr_v,
        i_clr      : bt_clr  ,
        i_wake     : wake    ,
        i_rd       : bt_rd   ,
        o_rdy      : bt_rdy  ,
        o_chk      : bt_chk  ,
    );

    // prf: two WB ports writing one entry.
    var raddr : PReg         [PRF_RD_N];
    var rdata : logic   <64> [PRF_RD_N];
    var wb    : WbPacket     [WB_N]    ;
    var pf_chk: logic                  ;
    inst u_prf: prf::<cfg_w2> #(
        FP     : 0 ,
        N_ENTRY: 96,
    ) (
        clk            ,
        rst            ,
        i_raddr: raddr ,
        o_rdata: rdata ,
        i_wb   : wb    ,
        o_chk  : pf_chk,
    );

    // iq: allocation in a kill cycle, and a release of a FREE entry.
    var al_v   : logic               [2];
    var al     : IqAlloc             [2];
    var free_n : logic    <5>           ;
    var wb_ok  : logic    <WB_OFS_N> [2];
    var busy   : FuSet               [2];
    var hold   : logic               [2];
    var gnt    : IqGrant             [2];
    var resv   : WbSlot              [2];
    var rel    : IqRelease           [2];
    var kill   : Kill                   ;
    var iq_perf: logic    <2>           ;
    var iq_chk : logic    <3>           ;
    inst u_iq: iq::<cfg_w2> #(
        Q: 0,
    ) (
        clk                          ,
        rst                          ,
        i_alloc_valid: al_v          ,
        i_alloc      : al            ,
        o_free       : free_n        ,
        i_wake       : wake          ,
        i_tok_valid  : 1'b0          ,
        i_tok        : 0 as RobTag   ,
        i_wb_ok      : wb_ok         ,
        i_fu_busy    : busy          ,
        i_port_hold  : hold          ,
        i_load_fence : 0 as LoadFence,
        o_grant      : gnt           ,
        o_resv       : resv          ,
        i_release    : rel           ,
        i_kill       : kill          ,
        o_perf       : iq_perf       ,
        o_chk        : iq_chk        ,
    );

    initial {
        rs_resv  = 0 as WbSlot;
        bt_clr_v = '{default: 0};
        bt_clr   = '{default: 0 as PReg};
        wake     = '{default: 0 as Wake};
        bt_rd    = '{default: 0 as PReg};
        raddr    = '{default: 0 as PReg};
        wb       = '{default: 0 as WbPacket};
        al_v     = '{default: 0};
        al       = '{default: 0 as IqAlloc};
        wb_ok    = '{default: '1};
        busy     = '{default: 0};
        hold     = '{default: 0};
        rel      = '{default: 0 as IqRelease};
        kill     = 0 as Kill;
        rst.assert(clk);
        clk.next(2);
        $assert(rs_chk == 0 && bt_chk == 1'b0 && pf_chk == 1'b0 && iq_chk == 0, "checker raised without a violation");

        // wb_resv: claim slot 3, then slot 2 one cycle later (the same slot).
        rs_resv.valid = 1'b1;
        rs_resv.off   = 3;
        clk.next();
        rs_resv.off = 2;
        clk.next();
        rs_resv.valid = 1'b0;

        // busy_table: clear and wake pdst 40 together.
        bt_clr_v[0]      = 1'b1;
        bt_clr[0].idx    = 40;
        wake[0].valid    = 1'b1;
        wake[0].pdst.idx = 40;
        // prf: wb0 and wbm0 both write int pdst 41.
        wb[0].valid        = 1'b1;
        wb[0].tag.has_rd   = 1'b1;
        wb[0].tag.pdst.idx = 41;
        wb[2].valid        = 1'b1;
        wb[2].tag.has_rd   = 1'b1;
        wb[2].tag.pdst.idx = 41;
        // iq: allocate during a kill, release entry 5 which is FREE.
        al_v[0]           = 1'b1;
        al[0].fu          = FuKind::ALU;
        al[0].tag.rob     = 0 as RobTag;
        al[0].tag.rob.idx = 3;
        kill.valid        = 1'b1;
        kill.full         = 1'b1;
        rel[0].valid      = 1'b1;
        rel[0].entry      = 5;
        clk.next();
        bt_clr_v[0]   = 1'b0;
        wake[0].valid = 1'b0;
        wb[0].valid   = 1'b0;
        wb[2].valid   = 1'b0;
        al_v[0]       = 1'b0;
        kill.valid    = 1'b0;
        rel[0].valid  = 1'b0;
        clk.next(2);
        $display("sched_chk: wb_resv=%b busy_table=%b prf=%b iq=%b", rs_chk, bt_chk, pf_chk, iq_chk);
        $assert(rs_chk == 2'b01, "wb_resv collision not flagged");
        $assert(bt_chk == 1'b1, "busy_table clear/set not flagged");
        $assert(pf_chk == 1'b1, "prf double write not flagged");
        $assert(iq_chk == 3'b110, "iq kill-cycle allocation / bad release not flagged");
        $finish();
    }
}

// Every IQ (including the memory IQ) and every exec port of a config
// elaborates, and an idle IQ reports all entries free.
module sched_elab_iq::<CFG: core_cfg> #(
    param Q: u32 = 0,
) (
    clk   : input  clock,
    rst   : input  reset,
    o_full: output logic, // o_free == IQ_N
) {
    import core_types::<CFG>::*;

    const NP: u32 = iq_port_count(Q);

    var al_v: logic                                                [CFG::RENAME_W];
    var al  : IqAlloc                                              [CFG::RENAME_W];
    var wake: Wake                                                 [WB_N]         ;
    var ok  : logic             <fu_pkg::WB_OFS_N>                 [NP]           ;
    var busy: opclass_pkg::FuSet                                   [NP]           ;
    var hold: logic                                                [NP]           ;
    var rel : IqRelease                                            [NP]           ;
    var free: logic             <tag_pkg::idx_w(CFG::IQ_N[Q] + 1)>                ;
    always_comb {
        al_v = '{default: 0};
        al   = '{default: 0 as IqAlloc};
        wake = '{default: 0 as Wake};
        ok   = '{default: '1};
        busy = '{default: 0};
        hold = '{default: 0};
        rel  = '{default: 0 as IqRelease};
    }
    inst u: iq::<CFG> #(
        Q: Q,
    ) (
        clk                          ,
        rst                          ,
        i_alloc_valid: al_v          ,
        i_alloc      : al            ,
        o_free       : free          ,
        i_wake       : wake          ,
        i_tok_valid  : 1'b0          ,
        i_tok        : 0 as RobTag   ,
        i_wb_ok      : ok            ,
        i_fu_busy    : busy          ,
        i_port_hold  : hold          ,
        i_load_fence : 0 as LoadFence,
        o_grant      : _             ,
        o_resv       : _             ,
        i_release    : rel           ,
        i_kill       : 0 as Kill     ,
        o_perf       : _             ,
        o_chk        : _             ,
    );
    assign o_full = free == CFG::IQ_N[Q];
}

module sched_elab::<CFG: core_cfg> (
    clk   : input  clock,
    rst   : input  reset,
    o_full: output logic,
) {
    import core_types::<CFG>::*;

    var full: logic<CFG::N_IQ>;
    for q in 0..CFG::N_IQ :g_iq {
        inst u_iq: sched_elab_iq::<CFG> #(
            Q: q,
        ) (
            clk            ,
            rst            ,
            o_full: full[q],
        );
    }
    assign o_full = &full;

    var wb: WbPacket     [WB_N] ;
    var rd: logic   <64> [SRC_N];
    always_comb {
        wb = '{default: 0 as WbPacket};
        rd = '{default: 0};
    }
    for p in 0..CFG::ISSUE_W :g_ep {
        inst u_ep: exec_port::<CFG> #(
            P: p,
        ) (
            clk                              ,
            rst                              ,
            i_grant     : 0 as IqGrant       ,
            i_kill      : 0 as Kill          ,
            o_release   : _                  ,
            o_fu_busy   : _                  ,
            o_rd        : _                  ,
            i_rd_int    : rd                 ,
            i_rd_fp     : rd                 ,
            i_wb        : wb                 ,
            o_wb        : _                  ,
            o_wake      : _                  ,
            o_hf_req    : _                  ,
            i_hf_grant  : 0 as fu_pkg::WbSlot,
            o_ftq_rd    : _                  ,
            i_ftq_base  : 0                  ,
            i_ftq_target: 0                  ,
            o_csr_raddr : _                  ,
            i_csr_rdata : 0                  ,
            i_tok_valid : 1'b0               ,
            i_tok       : 0 as RobTag        ,
            o_started   : _                  ,
            o_sys       : _                  ,
            o_perf      : _                  ,
            o_chk       : _                  ,
        );
    }
}

#[test(test_sched_elab)]
module test_sched_elab {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var full2: logic;
    var full4: logic;
    inst e2: sched_elab::<cfg_w2> (
        clk          ,
        rst          ,
        o_full: full2,
    );
    inst e4: sched_elab::<cfg_w4> (
        clk          ,
        rst          ,
        o_full: full4,
    );

    initial {
        rst.assert(clk);
        clk.next(3);
        $assert(full2 && full4, "an idle IQ does not report all entries free");
        $finish();
    }
}
