// AXI4 directed tests (verification plan §10.4): programs run behind the tb
// slave model in settings that open the window of one ordering rule of
// mem_ctrl (design §MM.5). tohost == 1 passes; a wrong value, a trap, an AXI
// protocol flag or the cycle bound fails.
//
//   I1: test/axi/i1.S under WR_LAG, a read after an accepted, unfinished
//       write (NC, cacheable miss, and IO without a fence)
//   I2: test/coh/coh.S under BACKPRESSURE (veto recalls and write-through
//       drains against slow AW/W)
//   I3: test/coh/unc.S under SLOW, uncached reads held across recalls
//   I4: test/axi/i4.S under SLOW, NC writes into a line another hart is
//       gathering
//   I5: test/coh/ad.S under REORDER, gathers of several slots out of order
//   I6: i1 and unc under STALL, every ready low most cycles
//   U46: test/axi/err.S on a 2 MiB slave, DECERR on R and B must set both
//       sticky error flags of the SoC

module axi_dir_harness #(
    param N_HARTS : u32                   = 1                 ,
    param DRAM_HEX: string                = ""                ,
    param CFG     : axi4_tb_pkg::SlaveCfg = axi4_tb_pkg::FIXED,
    param SEED    : bit<32>               = 32'h1             ,
    param IRQ_SRC : bit<32>               = 32'd0             ,
    param MEM_DW  : u32                   = 4194304           ,
    param ERR_EXP : bit                   = 1'b0              ,
) (
    clk     : input  clock    ,
    rst     : input  reset    ,
    o_pass  : output logic    ,
    o_fail  : output logic    ,
    o_cycles: output logic<64>,
) {
    inst u_h: boot_soc_harness #(
        N_HARTS    : N_HARTS                     ,
        DRAM_HEX   : DRAM_HEX                    ,
        ROM_EN     : 1'b0                        ,
        PMA_N      : tb_platform_pkg::MAP_ARCH_N ,
        PMA_REGIONS: tb_platform_pkg::MAP_ARCH   ,
        RESET_PC   : 64'h8000_0000               ,
        PASS_BY_X3 : 1'b0                        ,
        TOHOST_PA  : 64'h8000_3000               ,
        CORE       : tb_core_sel::CORE_W2        ,
        EXT_IRQ_SRC: IRQ_SRC                     ,
        AXI_CFG    : CFG                         ,
        AXI_SEED   : SEED                        ,
        AXI_MEM_DW : MEM_DW                      ,
        AXI_ERR_EXP: ERR_EXP                     ,
    ) (
        clk             ,
        rst             ,
        o_pass          ,
        o_fail          ,
        o_x3     : _    ,
        o_cycles        ,
        o_instret: _    ,
        o_last_pc: _    ,
        o_ret_cnt: _    ,
        o_traps  : _    ,
    );
}

#[test(test_axi_i1)]
module test_axi_i1 {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass  : logic    ;
    var fail  : logic    ;
    var cycles: logic<64>;

    inst h: axi_dir_harness #(
        N_HARTS : 1                  ,
        DRAM_HEX: "test/axi/i1.hex",
        CFG     : axi4_tb_pkg::WR_LAG,
    ) (
        clk             ,
        rst             ,
        o_pass  : pass  ,
        o_fail  : fail  ,
        o_cycles: cycles,
    );

    initial {
        rst.assert(clk);
        for _i in 0..100 {
            clk.next(10000);
            if pass || fail {
                break;
            }
        }
        clk.next(10);
        $display("test_axi_i1: cycles=%d pass=%b fail=%b", cycles, pass, fail);
        $assert (pass, "test_axi_i1: wrong value, trap, checker or timeout");
        $finish ();
    }
}

