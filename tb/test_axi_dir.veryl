#[test(test_axi_err)]
module test_axi_err {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass  : logic    ;
    var fail  : logic    ;
    var cycles: logic<64>;

    inst h: axi_dir_harness #(
        N_HARTS : 1                  ,
        DRAM_HEX: "test/axi/err.hex",
        CFG     : axi4_tb_pkg::FIXED,
        MEM_DW  : 262144            ,
        ERR_EXP : 1'b1              ,
    ) (
        clk             ,
        rst             ,
        o_pass  : pass  ,
        o_fail  : fail  ,
        o_cycles: cycles,
    );

    initial {
        rst.assert(clk);
        for _i in 0..100 {
            clk.next(10000);
            if pass || fail {
                break;
            }
        }
        clk.next(10);
        $display("test_axi_err: cycles=%d pass=%b fail=%b", cycles, pass, fail);
        $assert (pass, "test_axi_err: AXI error flags not both set, trap, checker or timeout");
        $finish ();
    }
}
