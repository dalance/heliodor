// dm_resume_lat: per-hart latency of a resume, from the cycle the Debug
// Module raises the hart's RESUME flag (o_dm_obs.hart.resume) to the hart's
// RESUMING write (hart.halted falls) and to its first record outside Debug
// Mode. Prints, at the rising edge of i_dump, one line per hart that resumed:
//   resume hart<h>: n=<resumes> resuming_avg=<c> resuming_max=<c> retire_avg=<c> retire_max=<c>
// A resume whose hart halts again before retiring anything (a step that
// traps into Debug Mode, an abstract command) is not counted.
module dm_resume_lat #(
    param N_HARTS: u32 = 1,
) (
    clk       : input clock                          ,
    rst       : input reset                          ,
    i_obs     : input soc_pkg::DmObs                 ,
    i_retire  : input logic                 [N_HARTS], // a record on lane 0
    i_retire_dm: input logic                [N_HARTS], // the records of this cycle are Debug Mode's
    i_dump    : input logic                          ,
) {
    var dump_q: logic;
    always_ff {
        if_reset {
            dump_q = 1'b0;
        } else {
            dump_q = i_dump;
        }
    }
    let dump: logic = i_dump && !dump_q;

    for h in 0..N_HARTS :g_h {
        var res_q : logic    ; // RESUME flag, the cycle before
        var hlt_q : logic    ; // halted, the cycle before
        var wait_q: logic    ; // between RESUME and the first record
        var t_q   : logic<32>; // cycles since RESUME
        var tr_q  : logic<32>; // cycles from RESUME to RESUMING of this resume
        var n_q   : logic<32>;
        var rs_sum: logic<64>;
        var rs_max: logic<32>;
        var rt_sum: logic<64>;
        var rt_max: logic<32>;
        let rise_r: logic = i_obs.hart.resume[h] && !res_q;
        let fall_h: logic = !i_obs.hart.halted[h] && hlt_q;
        let first : logic = wait_q && i_retire[h] && !i_retire_dm[h];
        always_ff {
            if_reset {
                res_q  = 1'b0;
                hlt_q  = 1'b0;
                wait_q = 1'b0;
                t_q    = 32'd0;
                tr_q   = 32'd0;
                n_q    = 32'd0;
                rs_sum = 64'd0;
                rs_max = 32'd0;
                rt_sum = 64'd0;
                rt_max = 32'd0;
            } else {
                res_q = i_obs.hart.resume[h];
                hlt_q = i_obs.hart.halted[h];
                if rise_r {
                    wait_q = 1'b1;
                    t_q    = 32'd0;
                } else if first {
                    wait_q = 1'b0;
                    n_q    += 32'd1;
                    rs_sum += {32'd0, tr_q};
                    rt_sum += {32'd0, t_q};
                    if tr_q >: rs_max {
                        rs_max = tr_q;
                    }
                    if t_q >: rt_max {
                        rt_max = t_q;
                    }
                } else if wait_q && i_obs.hart.halted[h] && !hlt_q {
                    wait_q = 1'b0;
                } else if wait_q {
                    t_q += 32'd1;
                    if fall_h {
                        tr_q = t_q;
                    }
                }
                if dump && n_q != 32'd0 {
                    $display("resume hart%d: n=%d resuming_avg=%d resuming_max=%d retire_avg=%d retire_max=%d", h, n_q,
                        rs_sum / {32'd0, n_q}, rs_max, rt_sum / {32'd0, n_q}, rt_max);
                }
            }
        }
    }
}
