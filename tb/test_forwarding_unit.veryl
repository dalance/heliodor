// Forwarding unit test.
// Pure combinational. EX/MEM has higher priority than MEM/WB; x0 is
// never forwarded.
module test_forwarding_unit_harness (
    clk   : input  clock   ,
    rst   : input  reset   ,
    o_pass: output logic   ,
    o_done: output logic   ,
    o_tc  : output logic<8>,
) {
    var tc: logic<8>;

    always_ff {
        if_reset {
            tc = 8'd0;
        } else {
            tc = tc + 8'd1;
        }
    }

    // FwdSel encodings (match pipeline_pkg)
    const NONE  : logic<2> = 2'd0;
    const EX_MEM: logic<2> = 2'd1;
    const MEM_WB: logic<2> = 2'd2;

    var rs1_addr : logic<5>;
    var rs2_addr : logic<5>;
    var exmem_rd : logic<5>;
    var exmem_wen: logic   ;
    var memwb_rd : logic<5>;
    var memwb_wen: logic   ;
    var fwd_a    : logic<2>;
    var fwd_b    : logic<2>;

    inst dut: forwarding_unit (
        i_rs1_addr : rs1_addr ,
        i_rs2_addr : rs2_addr ,
        i_exmem_rd : exmem_rd ,
        i_exmem_wen: exmem_wen,
        i_memwb_rd : memwb_rd ,
        i_memwb_wen: memwb_wen,
        o_fwd_a    : fwd_a    ,
        o_fwd_b    : fwd_b    ,
    );

    var exp_a: logic<2>;
    var exp_b: logic<2>;
    var valid: logic   ;

    always_comb {
        rs1_addr  = 5'd0;
        rs2_addr  = 5'd0;
        exmem_rd  = 5'd0;
        exmem_wen = 1'b0;
        memwb_rd  = 5'd0;
        memwb_wen = 1'b0;
        exp_a     = NONE;
        exp_b     = NONE;
        valid     = 1'b1;

        case tc {
            // tc=1: no producers → NONE/NONE
            8'd1: {
                rs1_addr = 5'd5;
                rs2_addr = 5'd6;
            }
            // tc=2: EX/MEM forward to rs1
            8'd2: {
                rs1_addr  = 5'd5;
                exmem_rd  = 5'd5;
                exmem_wen = 1'b1;
                exp_a     = EX_MEM;
            }
            // tc=3: EX/MEM forward to rs2
            8'd3: {
                rs2_addr  = 5'd7;
                exmem_rd  = 5'd7;
                exmem_wen = 1'b1;
                exp_b     = EX_MEM;
            }
            // tc=4: MEM/WB forward to rs1 (no EX/MEM hit)
            8'd4: {
                rs1_addr  = 5'd9;
                memwb_rd  = 5'd9;
                memwb_wen = 1'b1;
                exp_a     = MEM_WB;
            }
            // tc=5: both stages have rs1 → EX/MEM wins (newer value)
            8'd5: {
                rs1_addr  = 5'd3;
                exmem_rd  = 5'd3;
                exmem_wen = 1'b1;
                memwb_rd  = 5'd3;
                memwb_wen = 1'b1;
                exp_a     = EX_MEM;
            }
            // tc=6: x0 destination must NOT forward
            8'd6: {
                rs1_addr  = 5'd0;
                exmem_rd  = 5'd0;
                exmem_wen = 1'b1;
                memwb_rd  = 5'd0;
                memwb_wen = 1'b1;
            }
            // tc=7: wen=0 → no forwarding even if rd matches
            8'd7: {
                rs1_addr  = 5'd5;
                exmem_rd  = 5'd5;
                exmem_wen = 1'b0;
                memwb_rd  = 5'd5;
                memwb_wen = 1'b0;
            }
            // tc=8: cross — EX/MEM matches rs1, MEM/WB matches rs2
            8'd8: {
                rs1_addr  = 5'd10;
                rs2_addr  = 5'd11;
                exmem_rd  = 5'd10;
                exmem_wen = 1'b1;
                memwb_rd  = 5'd11;
                memwb_wen = 1'b1;
                exp_a     = EX_MEM;
                exp_b     = MEM_WB;
            }
            // tc=9: both stages, neither matches
            8'd9: {
                rs1_addr  = 5'd5;
                rs2_addr  = 5'd6;
                exmem_rd  = 5'd7;
                exmem_wen = 1'b1;
                memwb_rd  = 5'd8;
                memwb_wen = 1'b1;
            }
            // tc=10: same producer covers both rs1 and rs2
            8'd10: {
                rs1_addr  = 5'd12;
                rs2_addr  = 5'd12;
                exmem_rd  = 5'd12;
                exmem_wen = 1'b1;
                exp_a     = EX_MEM;
                exp_b     = EX_MEM;
            }
            default: {
                valid = 1'b0;
            }
        }
    }

    var failed: logic;
    always_ff {
        if_reset {
            failed = 1'b0;
        } else if valid && (fwd_a != exp_a || fwd_b != exp_b) {
            failed = 1'b1;
        }
    }

    assign o_tc   = tc;
    assign o_pass = !failed;
    assign o_done = tc >: 8'd12;
}

#[test(test_forwarding_unit)]
module test_forwarding_unit {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen(clk);

    var pass: logic   ;
    var done: logic   ;
    var tc  : logic<8>;

    inst harness: test_forwarding_unit_harness (
        clk   : clk ,
        rst   : rst ,
        o_pass: pass,
        o_done: done,
        o_tc  : tc  ,
    );

    initial {
        rst.assert(clk);
        for _i in 0..14 {
            clk.next(1);
        }
        $assert (pass, "forwarding_unit test failed");
        $display("forwarding_unit test passed");
        $finish ();
    }
}
