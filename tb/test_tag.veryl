// tag_pkg: idx_w edge cases and the ring-tag helpers against allocation
// counts. A tag of allocation count s in a ring of N is
// {(s / N) % 2, s % N}; two live tags differ in count by less than N.
module tag_ref_harness #(
    param N: u32 = 3,
) (
    o_err: output logic,
) {
    const W: u32 = tag_pkg::idx_w(N) + 1;

    function tag_of (
        s: input u32,
    ) -> logic<W> {
        var r         : logic<W>;
        r[W - 1]   = (s / N) % 2;
        r[W - 2:0] = s % N;
        return r;
    }

    always_comb {
        o_err = 1'b0;
        // Four laps cover both wrap transitions twice.
        for s in 0..4 * N {
            if tag_next::<W, N>(tag_of(s)) != tag_of(s + 1) {
                o_err = 1'b1;
            }
            if tag_older::<W>(tag_of(s), tag_of(s)) || !tag_older_eq::<W>(tag_of(s), tag_of(s)) {
                o_err = 1'b1;
            }
            for d in 1..N {
                if !tag_older::<W>(tag_of(s), tag_of(s + d)) || tag_older::<W>(tag_of(s + d), tag_of(s)) {
                    o_err = 1'b1;
                }
                if !tag_older_eq::<W>(tag_of(s), tag_of(s + d)) || tag_older_eq::<W>(tag_of(s + d), tag_of(s)) {
                    o_err = 1'b1;
                }
            }
        }
    }
}

#[test(test_tag)]
module test_tag {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var err: logic [6];
    inst h1: tag_ref_harness #(
        N: 1,
    ) (
        o_err: err[0],
    );
    inst h2: tag_ref_harness #(
        N: 2,
    ) (
        o_err: err[1],
    );
    inst h3: tag_ref_harness #(
        N: 3,
    ) (
        o_err: err[2],
    );
    inst h5: tag_ref_harness #(
        N: 5,
    ) (
        o_err: err[3],
    );
    inst h6: tag_ref_harness #(
        N: 6,
    ) (
        o_err: err[4],
    );
    inst h8: tag_ref_harness #(
        N: 8,
    ) (
        o_err: err[5],
    );

    initial {
        rst.assert(clk);
        clk.next(2);
        $assert(tag_pkg::idx_w(0) == 1 && tag_pkg::idx_w(1) == 1 && tag_pkg::idx_w(2) == 1, "idx_w of 0..2 must be 1");
        $assert(tag_pkg::idx_w(3) == 2 && tag_pkg::idx_w(4) == 2 && tag_pkg::idx_w(5) == 3, "idx_w of 3..5");
        $assert(tag_pkg::idx_w(64) == 6 && tag_pkg::idx_w(65) == 7 && tag_pkg::idx_w(256) == 8, "idx_w of 64, 65, 256");
        $display("tag: err N=1,2,3,5,6,8 = %b %b %b %b %b %b", err[0], err[1], err[2], err[3], err[4], err[5]);
        $assert(
            !err[0] && !err[1] && !err[2] && !err[3] && !err[4] && !err[5],
            "tag helpers disagree with allocation counts",
        );
        $finish();
    }
}
