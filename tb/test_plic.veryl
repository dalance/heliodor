// PLIC unit test.
// Exercises priority configuration, enable bits, source pending latching,
// claim/complete flow, and priority-based source selection.
module test_plic_harness (
    clk   : input  clock   ,
    rst   : input  reset   ,
    o_pass: output logic   ,
    o_done: output logic   ,
    o_tc  : output logic<8>,
) {
    var tc: logic<8>;

    always_ff {
        if_reset {
            tc = 8'd0;
        } else {
            tc = tc + 8'd1;
        }
    }

    var src      : logic<32>    ;
    var addr     : logic<24>    ;
    var wdata    : logic<64>    ;
    var wen      : logic        ;
    var ren      : logic        ;
    var rdata    : logic<64>    ;
    var irq_m_arr: logic     [1];
    var irq_s_arr: logic     [1];
    let irq_m    : logic         = irq_m_arr[0];
    let irq_s    : logic         = irq_s_arr[0];

    inst dut: plic #(
        N_HARTS: 1,
    ) (
        clk               ,
        rst               ,
        i_src  : src      ,
        i_addr : addr     ,
        i_wdata: wdata    ,
        i_wen  : wen      ,
        i_ren  : ren      ,
        o_rdata: rdata    ,
        o_irq_m: irq_m_arr,
        o_irq_s: irq_s_arr,
    );

    always_comb {
        src   = 32'd0;
        addr  = 24'd0;
        wdata = 64'd0;
        wen   = 1'b0;
        ren   = 1'b0;

        // Pulse source 3 once to latch pending[3]
        if tc == 8'd3 {
            src[3] = 1'b1;
        }

        case tc {
            8'd1: {
                // enable_m[3] = 1
                addr  = 24'h002000;
                wdata = 64'h0000_0000_0000_0008;
                wen   = 1'b1;
            }
            8'd2: {
                // prio[3] = 5 → DUT uses i_addr[6:2] as src index, addr = 4*3 = 0x0C
                addr  = 24'h00000C;
                wdata = 64'h0000_0000_0000_0005;
                wen   = 1'b1;
            }
            8'd6: {
                // claim_m read → returns 3, also clears pending[3]
                addr = 24'h200004;
                ren  = 1'b1;
            }
            8'd8: {
                // read pending register to verify it was cleared
                addr = 24'h001000;
                ren  = 1'b1;
            }
            8'd10: {
                // complete: write claim_m = 3
                addr  = 24'h200004;
                wdata = 64'h0000_0000_0000_0003;
                wen   = 1'b1;
            }
            default: {}
        }
    }

    var sample_claim  : logic<64>;
    var sample_pending: logic<64>;
    always_ff {
        if_reset {
            sample_claim   = 64'hFFFF_FFFF_FFFF_FFFF;
            sample_pending = 64'hFFFF_FFFF_FFFF_FFFF;
        } else {
            if ren && addr == 24'h200004 && tc == 8'd6 {
                sample_claim = rdata;
            }
            if ren && addr == 24'h001000 && tc == 8'd8 {
                sample_pending = rdata;
            }
        }
    }

    var ok: logic;
    always_comb {
        ok = 1'b1;
        case tc {
            8'd5: {
                // pending[3] latched and prio>0 → irq_m must be high
                if !irq_m {
                    ok = 1'b0;
                }
            }
            8'd9: {
                // After claim, pending[3] cleared → irq_m low
                if irq_m {
                    ok = 1'b0;
                }
            }
            8'd12: {
                if sample_claim != 64'd3 {
                    ok = 1'b0;
                }
                if sample_pending != 64'd0 {
                    ok = 1'b0;
                }
            }
            default: {}
        }
    }

    var failed: logic;
    always_ff {
        if_reset {
            failed = 1'b0;
        } else if !ok {
            failed = 1'b1;
        }
    }

    assign o_tc   = tc;
    assign o_pass = !failed;
    assign o_done = tc >: 8'd14;
}

#[test(test_plic)]
module test_plic {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass: logic   ;
    var done: logic   ;
    var tc  : logic<8>;

    inst harness: test_plic_harness ( clk: clk, rst: rst, o_pass: pass, o_done: done, o_tc: tc );

    initial {
        rst.assert(clk);
        for _i in 0..16 {
            clk.next(1);
        }
        $assert (pass, "PLIC test failed");
        $display("PLIC test passed");
        $finish ();
    }
}
