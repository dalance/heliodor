// Phase 7 v4 M1.E: heliodor_core smoke test.
//
// Loads a small program of ALU ops into toy ROM and runs the M1 core
// for N cycles. Validates: rename pipelines, IQ wakeup, ROB commit
// produces sane retire stream. STORE/LOAD/CSR are illegal in M1 so we
// hand-craft an ALU-only sequence that exercises:
//   - rd != 0 with multiple in-flight ops
//   - RAW dependency (rd[N] used as rs1[N+1]) → IQ stall + wake
//   - branch backward (loop) → mispredict at commit + redirect
//
// Acceptance: after 200 cycles, x10 (a0) holds 64'd42 and x11 (a1)
// holds 64'd5 (loop iteration count). Computed at compile time of
// the embedded program; assertion in the test body.
//
// Program (hand-written, starts at 0x80000000):
//   addi x10, x0, 0       ; x10 = 0    (sum)
//   addi x11, x0, 5       ; x11 = 5    (loop counter)
//   addi x10, x10, 8      ; x10 += 8   (loop body — 5×8=40, then +2 = 42 below)
//   addi x11, x11, -1     ; x11 -= 1
//   bne  x11, x0, -8      ; branch back to addi x10,x10,8 while x11 != 0
//   addi x10, x10, 2      ; x10 += 2 → 42
//   jal  x0, 0            ; halt (infinite loop)
module test_smoke_harness (
    clk          : input  clock    ,
    rst          : input  reset    ,
    o_x10        : output logic<64>,
    o_x11        : output logic<64>,
    o_x12        : output logic<64>,
    o_x13        : output logic<64>,
    o_done       : output logic    ,
    o_cycle      : output logic<32>,
    o_commit_cnt : output logic<32>,
    o_last_ret_pc: output logic<64>,
    o_rename_cnt : output logic<32>,
    o_cdb_cnt    : output logic<32>,
    o_rob_size   : output logic<8> ,
    o_if_v       : output logic    ,
    o_if_instr   : output logic<32>,
    o_stall_dr   : output logic    ,
    o_hv         : output logic    ,
    o_hrw        : output logic    ,
    o_hil        : output logic    ,
    o_rob_alloc  : output logic<32>,
    o_rob_cdb    : output logic<32>,
    o_rob_commit : output logic<32>,
    o_rob_head   : output logic<6> ,
    o_rob_tail   : output logic<6> ,
) {
    var cycle: logic<32>;
    always_ff (clk, rst) {
        if_reset {
            cycle = 32'd0;
        } else {
            cycle = cycle + 32'd1;
        }
    }
    assign o_cycle = cycle;

    var imem_addr : logic<64>     ;
    var imem_rdata: logic<32>     ;
    var imem_ren  : logic         ;
    var dmem_addr : logic<64>     ;
    var dmemw_addr : logic<64>     ; // S23: write-channel address
    var dmem_wdata: logic<64> [8] ; // S25: write-channel line lanes
    var dmem_rdata: logic<64>     ;
    var dmem_wen  : logic         ;
    var dmem_ren  : logic         ;
    var dmem_wstrb: logic<8>  [8] ;
    var dbg_pc    : logic<64>     ;
    var dbg_regs  : logic<64> [32];
    var ret_v     : logic         ;
    var ret_pc    : logic<64>     ;
    var ret_rdv   : logic         ;
    var ret_rd    : logic<5>      ;
    var ret_data  : logic<64>     ;

    var rename_cnt: logic<32>;
    var cdb_cnt   : logic<32>;
    var rob_size  : logic<8> ;
    var if_v      : logic    ;
    var if_instr  : logic<32>;
    var stall_dr  : logic    ;
    var hv        : logic    ;
    var hrw       : logic    ;
    var hil       : logic    ;
    var r_alloc   : logic<32>;
    var r_cdb     : logic<32>;
    var r_commit  : logic<32>;
    var r_head    : logic<6> ;
    var r_tail    : logic<6> ;
    var _d1       : logic<64>;
    var _d2       : logic<64>;
    var _d3       : logic<2> ;
    var _d4       : logic    ;
    var _d5       : logic<64>;
    var _d6       : logic<64>;
    var _d7       : logic    ;
    var _d8       : logic<64>;
    var _d9       : logic<64>;
    var _d10      : logic<64>;
    var _d11      : logic    ;
    var _d12      : logic    ;
    var _d13      : logic    ;
    var _d14      : logic<12>;
    var _d15      : logic<64>;
    var _d16      : logic    ;
    var _d17      : logic<64>;
    var _d18      : logic<64>;
    var _d19      : logic    ;
    var _d20      : logic<64>;
    var _d21      : logic<64>;
    var _d22      : logic<64>;
    var _d23      : logic<64>;
    var _d24      : logic<64>;
    var _d25      : logic    ;
    var _d26      : logic<64>;
    var _d27      : logic    ;
    var _d28      : logic<64>;
    var _d29      : logic<32>;
    var _d30      : logic<64>;
    var _d31      : logic<64>;
    var _d32      : logic<64>;

    inst dut: heliodor_core #(
        RESET_PC: 64'h80000000,
    ) (
        clk                               ,
        rst                               ,
        o_imem_addr           : imem_addr ,
        i_imem_rdata          : imem_rdata,
        o_imem_ren            : imem_ren  ,
        o_iptw_addr           : _         , // M8.C: Bare smoke, no imem PTW
        o_iptw_req            : _         ,
        i_iptw_rdata          : 64'd0     ,
        o_dmem_addr           : dmem_addr ,
        o_dmem_wdata          : dmem_wdata,
        i_dmem_rdata          : dmem_rdata,
        i_dmem_rdata_next     : 64'd0     ,
        o_dmem_wen            : dmem_wen  ,
        o_dmem_ren            : dmem_ren  ,
        o_dmem_wstrb          : dmem_wstrb,
        o_dmemw_addr        : dmemw_addr      , // S23: write channel
        o_dmemw_req         : _               ,
        i_dmemw_grant       : 1'b1            ,
        o_dmem_wdata_hi       : _         ,
        o_dmem_wstrb_hi       : _         ,
        o_dmem_req            : _    ,
        i_dmem_grant          : 1'b1 ,
        i_dcache_inv_valid    : 1'b0 ,
        i_dcache_inv_addr     : 64'd0,
        i_dcache_inv2_valid     : 1'b0 ,
        i_dcache_inv2_addr      : 64'd0,
        o_dmemw_wb      : _,
        o_dmem_rfo      : _,
        i_dmem_fill_excl     : 1'b1,
        i_dcache_probe_v      : 1'b0,
        i_dcache_probe_self     : 1'b0,
        i_dcache_probe_addr     : 64'd0,
        o_dcache_probe_ack      : _,
        i_irq_timer_m         : 1'b0      ,
        i_irq_sw_m            : 1'b0      ,
        i_irq_ext_m           : 1'b0      ,
        i_irq_ext_s           : 1'b0      ,
        i_mtime               : 64'd0     ,
        o_dbg_pc              : dbg_pc    ,
        o_dbg_regs            : dbg_regs  ,
        o_dbg_retire_v_a      : ret_v     ,
        o_dbg_retire_pc_a     : ret_pc    ,
        o_dbg_retire_rd_v_a   : ret_rdv   ,
        o_dbg_retire_rd_a     : ret_rd    ,
        o_dbg_retire_data_a   : ret_data  ,
        o_dbg_rename_cnt      : rename_cnt,
        o_dbg_cdb_cnt         : cdb_cnt   ,
        o_dbg_rob_size        : rob_size  ,
        o_dbg_if_v            : if_v      ,
        o_dbg_if_instr        : if_instr  ,
        o_dbg_stall_dr        : stall_dr  ,
        o_dbg_head_valid      : hv        ,
        o_dbg_head_rw         : hrw       ,
        o_dbg_head_illegal    : hil       ,
        o_dbg_rob_alloc_cnt   : r_alloc   ,
        o_dbg_rob_cdb_cnt     : r_cdb     ,
        o_dbg_rob_commit_cnt  : r_commit  ,
        o_dbg_rob_head        : r_head    ,
        o_dbg_rob_tail        : r_tail    ,
        o_dbg_sepc            : _d1       ,
        o_dbg_mepc            : _d2       ,
        o_dbg_priv            : _d3       ,
        o_dbg_trap_fire       : _d4       ,
        o_dbg_trap_pc         : _d5       ,
        o_dbg_trap_cause      : _d6       ,
        o_dbg_trap_to_s       : _d7       ,
        o_dbg_satp            : _d8       ,
        o_dbg_imem_vaddr      : _d9       ,
        o_dbg_imem_paddr      : _d10      ,
        o_dbg_imem_valid      : _d11      ,
        o_dbg_imem_fault      : _d12      ,
        o_dbg_csrwr_v         : _d13      ,
        o_dbg_csrwr_addr      : _d14      ,
        o_dbg_csrwr_wdata     : _d15      ,
        o_dbg_ptw_req         : _d16      ,
        o_dbg_ptw_addr        : _d17      ,
        o_dbg_ptw_data        : _d18      ,
        o_dbg_redirect_fire   : _d19      ,
        o_dbg_redirect_pc     : _d20      ,
        o_dbg_redirect_src_pc : _d21      ,
        o_dbg_alu_pc_out      : _d22      ,
        o_dbg_alu_src_a_out   : _d23      ,
        o_dbg_alu_src_b_out   : _d24      ,
        o_dbg_alu_use_pc_a_out: _d25      ,
        o_dbg_alu_rs1_data_out: _d26      ,
        o_dbg_alu_valid_out   : _d27      ,
        o_dbg_alu_alu_out_out : _d28      ,
        o_dbg_alu_instr_out   : _d29      ,
        o_dbg_alu_imm_out     : _d30      ,
        o_dbg_stval_out       : _d31      ,
        o_dbg_mtval_out       : _d32      ,
    );

    // Toy imem: 8-word ROM holding the program above. Encoded for RV64I:
    //   00000513 addi x10, x0, 0
    //   00500593 addi x11, x0, 5
    //   00850513 addi x10, x10, 8
    //   fff58593 addi x11, x11, -1
    //   fe0596e3 bne  x11, x0, -8      (offset = -8 from current PC = 0x80000010)
    //   00250513 addi x10, x10, 2
    //   0000006f jal  x0, 0            (infinite halt)
    //   00000013 nop (addi x0, x0, 0)
    // Toy ROM (program + NOP padding). Hex layout in test/v4_smoke.hex.
    #[allow(initial_assign)]
    var imem: logic<32> [16];
    initial {
        $readmemh("test/v4_smoke.hex", imem);
    }
    let imem_idx: logic<4> = imem_addr[5:2];
    assign imem_rdata = imem[imem_idx];

    // Toy dmem: 16-word RAM at any address (lower 6 bits of dmem_addr
    // select word). Used by M2 LOAD/STORE smoke.
    var dmem   : logic<32> [16];
    let dmem_lo: logic<4>       = dmem_addr[5:2];
    let dmem_hi: logic<4>       = dmem_addr[5:2] | 4'h1;
    let _unused_dmemw_addr: logic<64> = dmemw_addr;
    always_ff (clk, rst) {
        if_reset {
            for i in 0..16 {
                dmem[i] = 32'd0;
            }
        } else if dmem_wen {
            // S25: line write — the 16-word RAM is exactly one 64B line, so
            // lane l maps to words {l,0}/{l,1} regardless of the address.
            for l in 0..8 {
                if dmem_wstrb[l] != 8'd0 {
                    let w_lo : logic<4>  = {l as 3, 1'b0};
                    let w_hi : logic<4>  = {l as 3, 1'b1};
                    let w_old: logic<64> = {dmem[w_hi], dmem[w_lo]};
                    let w_new: logic<64> = {
                        if dmem_wstrb[l][7] ? dmem_wdata[l][63:56] : w_old[63:56],
                        if dmem_wstrb[l][6] ? dmem_wdata[l][55:48] : w_old[55:48],
                        if dmem_wstrb[l][5] ? dmem_wdata[l][47:40] : w_old[47:40],
                        if dmem_wstrb[l][4] ? dmem_wdata[l][39:32] : w_old[39:32],
                        if dmem_wstrb[l][3] ? dmem_wdata[l][31:24] : w_old[31:24],
                        if dmem_wstrb[l][2] ? dmem_wdata[l][23:16] : w_old[23:16],
                        if dmem_wstrb[l][1] ? dmem_wdata[l][15:8] : w_old[15:8],
                        if dmem_wstrb[l][0] ? dmem_wdata[l][7:0] : w_old[7:0]
                    };
                    dmem[w_lo] = w_new[31:0];
                    dmem[w_hi] = w_new[63:32];
                }
            }
        }
    }
    assign dmem_rdata = {dmem[dmem_hi], dmem[dmem_lo]};

    assign o_x10 = dbg_regs[10];
    assign o_x11 = dbg_regs[11];
    assign o_x12 = dbg_regs[12];
    assign o_x13 = dbg_regs[13];
    // Done when x10=42 and x11=0 (final loop state)
    assign o_done = dbg_regs[10] == 64'd42 && dbg_regs[11] == 64'd0;

    var commit_cnt : logic<32>;
    var last_ret_pc: logic<64>;
    always_ff (clk, rst) {
        if_reset {
            commit_cnt  = 32'd0;
            last_ret_pc = 64'd0;
        } else if ret_v {
            commit_cnt  = commit_cnt + 32'd1;
            last_ret_pc = ret_pc;
        }
    }
    assign o_commit_cnt  = commit_cnt;
    assign o_last_ret_pc = last_ret_pc;
    assign o_rename_cnt  = rename_cnt;
    assign o_cdb_cnt     = cdb_cnt;
    assign o_rob_size    = rob_size;
    assign o_if_v        = if_v;
    assign o_if_instr    = if_instr;
    assign o_stall_dr    = stall_dr;
    assign o_hv          = hv;
    assign o_hrw         = hrw;
    assign o_hil         = hil;
    assign o_rob_alloc   = r_alloc;
    assign o_rob_cdb     = r_cdb;
    assign o_rob_commit  = r_commit;
    assign o_rob_head    = r_head;
    assign o_rob_tail    = r_tail;
}

#[test(test_smoke)]
#[ignore]
module test_smoke {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var x10        : logic<64>;
    var x11        : logic<64>;
    var x12        : logic<64>;
    var x13        : logic<64>;
    var done       : logic    ;
    var cycle      : logic<32>;
    var commit_cnt : logic<32>;
    var last_ret_pc: logic<64>;
    var rename_cnt : logic<32>;
    var cdb_cnt    : logic<32>;
    var rob_size   : logic<8> ;
    var if_v       : logic    ;
    var if_instr   : logic<32>;
    var stall_dr   : logic    ;
    var hv         : logic    ;
    var hrw        : logic    ;
    var hil        : logic    ;
    var r_alloc    : logic<32>;
    var r_cdb      : logic<32>;
    var r_commit   : logic<32>;
    var r_head     : logic<6> ;
    var r_tail     : logic<6> ;

    inst h: test_smoke_harness (
        clk                       ,
        rst                       ,
        o_x10        : x10        ,
        o_x11        : x11        ,
        o_x12        : x12        ,
        o_x13        : x13        ,
        o_done       : done       ,
        o_cycle      : cycle      ,
        o_commit_cnt : commit_cnt ,
        o_last_ret_pc: last_ret_pc,
        o_rename_cnt : rename_cnt ,
        o_cdb_cnt    : cdb_cnt    ,
        o_rob_size   : rob_size   ,
        o_if_v       : if_v       ,
        o_if_instr   : if_instr   ,
        o_stall_dr   : stall_dr   ,
        o_hv         : hv         ,
        o_hrw        : hrw        ,
        o_hil        : hil        ,
        o_rob_alloc  : r_alloc    ,
        o_rob_cdb    : r_cdb      ,
        o_rob_commit : r_commit   ,
        o_rob_head   : r_head     ,
        o_rob_tail   : r_tail     ,
    );

    initial {
        rst.assert(clk);
        clk.next  (5000);
        $display  (
            "[test_smoke] cy=%d x10=%h x11=%h commit=%d last_pc=%h rename=%d cdb=%d rob_sz=%d stall=%b head=%h tail=%h rob_alloc=%d rob_cdb=%d rob_commit=%d",
            cycle,
            x10,
            x11,
            commit_cnt,
            last_ret_pc,
            rename_cnt,
            cdb_cnt,
            rob_size,
            stall_dr,
            r_head,
            r_tail,
            r_alloc,
            r_cdb,
            r_commit,
        );
        // M3: MUL/DIV smoke. x10=7, x11=11, x12=mul=77, x13=divu=11.
        $display("[test_smoke] x12=%h x13=%h", x12, x13);
        $assert (x10 == 64'd7, "test_smoke: x10 != 7");
        $assert (x11 == 64'd11, "test_smoke: x11 != 11 (mul rs2)");
        $assert (x12 == 64'd77, "test_smoke: x12 != 77 (MUL result)");
        $assert (x13 == 64'd11, "test_smoke: x13 != 11 (DIVU result)");
        $display("[test_smoke] PASS");
        $finish ();
    }
}
