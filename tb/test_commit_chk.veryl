// The rob, commit and flush_ctrl checkers fire on injected violations: a
// scripted sequence breaks one invariant per step, and after each step the
// sticky flags must equal exactly the bits broken so far.
module commit_chk_harness::<CFG: core_cfg> (
    clk   : input  clock,
    rst   : input  reset,
    o_pass: output logic,
    o_done: output logic,
) {
    import core_types::<CFG>::*;
    import opclass_pkg::*;

    var cyc: logic<8>;
    var ok : logic   ;

    // ---- rob driven out of contract ----

    var al_v    : logic                  [CFG::RENAME_W];
    var al      : RobAlloc               [CFG::RENAME_W];
    var al_tag  : RobTag                 [CFG::RENAME_W];
    var wb      : WbPacket               [WB_N]         ;
    var ret_cnt : logic   <RETIRE_CNT_W>                ;
    var kill    : Kill                                  ;
    var rob_chk : logic   <CHK_ROB_W>                   ;
    var walk_bsy: logic                                 ;

    always_comb {
        for l in 0..CFG::RENAME_W {
            al_v[l]      = 1'b0;
            al[l]        = 0;
            al[l].ent.fu = FuKind::ALU;
        }
        for p in 0..WB_N {
            wb[p] = 0;
        }
        ret_cnt = 0;
        kill    = 0;
        if cyc == 2 {
            al_v[0] = 1'b1;
            al_v[1] = 1'b1;
        }
        if cyc == 4 {
            wb[0].valid       = 1'b1;
            wb[0].tag.rob.idx = 5; // bit 0: entry 5 is not live
        }
        if cyc == 6 || cyc == 7 {
            wb[0].valid = 1'b1; // bit 1: entry 0 completes twice
        }
        if cyc == 8 {
            kill.valid = 1'b1; // bit 2: allocation in a kill cycle
            al_v[0]    = 1'b1;
        }
        if cyc == 9 {
            kill.valid = 1'b1; // bit 6: partial kill while the walk of entry 1 is presented
        }
        if cyc == 11 {
            al_v[1] = 1'b1; // bit 3: lane 1 without lane 0
        }
        if cyc == 13 {
            ret_cnt = 2; // bit 5: one live entry
        }
    }

    inst u_rob: rob::<CFG> (
        clk                    ,
        rst                    ,
        i_alloc_valid: al_v    ,
        i_alloc      : al      ,
        o_alloc_tag  : al_tag  ,
        i_wb         : wb      ,
        i_retire_cnt : ret_cnt ,
        i_kill       : kill    ,
        i_rec_set    : 0       ,
        i_snap_tag   : 0       ,
        o_walk_busy  : walk_bsy,
        o_chk        : rob_chk ,
    );

    // bit 4: a head that disagrees with the shadow.
    var head_chk: logic <CHK_ROB_W>;
    var bad_head: TagTok           ;
    always_comb {
        bad_head       = 0;
        bad_head.valid = cyc == 3;
    }
    inst u_chk_rob: chk_rob::<CFG> (
        clk                      ,
        rst                      ,
        i_alloc_valid: '{0, 0},
        i_alloc      : al        ,
        i_alloc_tag  : '{0, 1},
        i_wb         : '{0, 0, 0},
        i_retire_cnt : 0         ,
        i_kill       : 0         ,
        i_head       : bad_head  ,
        i_walk_busy  : 1'b0      ,
        o_chk        : head_chk  ,
    );

    // ---- chk_commit ----

    var c_ret : logic<CFG::COMMIT_W>                ;
    var c_cm  : RobCm                [CFG::COMMIT_W];
    var c_kill: Kill                                ;
    var c_trap: logic                               ;
    var c_rep : logic                               ;
    var c_lq  : logic<CFG::COMMIT_W> [CFG::COMMIT_W];
    var c_sq  : logic<CFG::MEM_W>    [CFG::COMMIT_W];
    var c_st  : logic<STARTED_N>                    ;
    var cm_chk: logic<CHK_CM_W>                     ;
    always_comb {
        c_ret  = 0;
        c_kill = 0;
        c_trap = 1'b0;
        c_rep  = 1'b0;
        c_st   = 0;
        for l in 0..CFG::COMMIT_W {
            c_cm[l]        = 0;
            c_cm[l].ent.fu = FuKind::ALU;
            c_lq[l]        = 0;
            c_sq[l]        = 0;
        }
        if cyc == 2 {
            c_ret = 2'b10; // bit 0
        }
        if cyc == 4 {
            c_trap = 1'b1; // bit 1
            c_rep  = 1'b1;
        }
        if cyc == 6 {
            c_ret  = 2'b01; // bit 2
            c_trap = 1'b1;
        }
        if cyc == 8 {
            c_ret        = 2'b01; // bit 3
            c_kill.valid = 1'b1;
            c_kill.full  = 1'b1;
        }
        if cyc == 10 {
            c_ret          = 2'b01; // bit 4
            c_cm[0].ent.fu = FuKind::SYS;
        }
        if cyc == 12 {
            c_ret            = 2'b01; // bit 5
            c_cm[0].ent.lq_v = 1'b1;
        }
        if cyc == 14 {
            c_st = 1; // bit 6
        }
    }
    inst u_chk_cm: chk_commit::<CFG> (
        clk                  ,
        rst                  ,
        i_retire     : c_ret ,
        i_cm         : c_cm  ,
        i_kill       : c_kill,
        i_trap_fire  : c_trap,
        i_replay_fire: c_rep ,
        i_irq_take   : 1'b0  ,
        i_rf_lane    : 0     ,
        i_sys_q      : 0     ,
        i_lq_hit     : c_lq  ,
        i_sq_hit     : c_sq  ,
        i_started    : c_st  ,
        i_oldest     : 0     ,
        o_chk        : cm_chk,
    );

    // ---- chk_flush ----

    var f_cm  : CmFlush             ;
    var f_kill: Kill                ;
    var fl_chk: logic  <CHK_FLUSH_W>;
    always_comb {
        f_cm   = 0;
        f_kill = 0;
        if cyc == 2 {
            f_cm.valid = 1'b1; // bit 0: a backstop with no dropped resolve
            f_cm.kind  = RedirKind::BR_CM;
        }
        if cyc == 4 {
            f_kill.valid = 1'b1; // bit 1: no redirect
        }
    }
    inst u_chk_fl: chk_flush::<CFG> (
        clk                   ,
        rst                   ,
        i_wb      : '{0, 0, 0},
        i_adopt   : 1'b0      ,
        i_cm_flush: f_cm      ,
        i_kill    : f_kill    ,
        i_redirect: 0         ,
        o_chk     : fl_chk    ,
    );

    // Expected sticky flags one cycle after each step.
    var e_rob: logic<CHK_ROB_W>  ;
    var e_cm : logic<CHK_CM_W>   ;
    var e_fl : logic<CHK_FLUSH_W>;
    always_comb {
        e_rob = 0;
        e_cm  = 0;
        e_fl  = 0;
        if cyc >= 5 {
            e_rob[0] = 1'b1;
        }
        if cyc >= 8 {
            e_rob[1] = 1'b1;
        }
        if cyc >= 9 {
            e_rob[2] = 1'b1;
        }
        if cyc >= 10 {
            e_rob[6] = 1'b1;
        }
        if cyc >= 12 {
            e_rob[3] = 1'b1;
        }
        if cyc >= 14 {
            e_rob[5] = 1'b1;
        }
        for b in 0..7 {
            if cyc >= 3 + 2 * b {
                e_cm[b] = 1'b1;
            }
        }
        if cyc >= 3 {
            e_fl[0] = 1'b1;
        }
        if cyc >= 5 {
            e_fl[1] = 1'b1;
        }
    }

    always_ff {
        if_reset {
            cyc = 0;
            ok  = 1'b1;
        } else {
            if cyc != 8'hff {
                cyc = cyc + 1;
            }
            if rob_chk != e_rob || cm_chk != e_cm || fl_chk != e_fl || head_chk != (if cyc >= 4 ? 7'b001_0000 : 7'd0) {
                ok = 1'b0;
            }
        }
    }

    assign o_pass = ok;
    assign o_done = cyc >= 20;
}

#[test(test_commit_chk)]
module test_commit_chk {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass: logic;
    var done: logic;
    inst h: commit_chk_harness::<cfg_w2> (
        clk         ,
        rst         ,
        o_pass: pass,
        o_done: done,
    );

    initial {
        rst.assert(clk);
        clk.next(30);
        $display("commit checkers: pass=%b", pass);
        $assert(done && pass, "a commit checker did not fire as injected");
        $finish();
    }
}
