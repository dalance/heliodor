// SC failure test: an intervening store between LR and SC must
// invalidate the reservation, so the SC returns rd=1.
//
// Program:
//   addi x10, x0, 0       # test addr = 0
//   addi x11, x0, 42      # x11 = 42
//   sd x11, 0(x10)        # M[0] = 42
//   lr.d x1, (x10)        # x1 = 42, reservation set
//   addi x12, x0, 100     # x12 = 100
//   sd x12, 0(x10)        # M[0] = 100, BREAKS reservation
//   addi x13, x0, 200     # x13 = 200
//   sc.d x2, x13, (x10)   # SC must FAIL: x2 = 1, M[0] still 100
//   ld   x3, 0(x10)       # x3 = M[0] = 100
//
// Expected: x1=42 (LR loaded value), x2=1 (SC failed), x3=100 (memory
// holds the intervening store, NOT the SC's value 200).
module test_amo_fail_harness (
    clk   : input  clock    ,
    rst   : input  reset    ,
    o_pass: output logic    ,
    o_r1  : output logic<64>,
    o_r2  : output logic<64>,
    o_r3  : output logic<64>,
) {
    var imem_addr : logic<64>     ;
    var imem_rdata: logic<32>     ;
    var imem_ren  : logic         ;
    var dmem_addr : logic<64>     ;
    var dmem_wdata: logic<64>     ;
    var dmem_rdata: logic<64>     ;
    var dmem_wen  : logic         ;
    var dmem_ren  : logic         ;
    var dmem_wstrb: logic<8>      ;
    var dbg_regs  : logic<64> [32];
    var dbg_pc    : logic<64>     ;
    var dbg_pass  : logic         ;
    var dbg_r1    : logic<64>     ;
    var dbg_r2    : logic<64>     ;
    var dbg_r3    : logic<64>     ;
    var _iptw_addr: logic<64>     ;
    var _iptw_req : logic         ;

    inst dut: heliodor_top (
        clk                        ,
        rst                        ,
        o_imem_addr    : imem_addr ,
        i_imem_rdata   : imem_rdata,
        o_imem_ren     : imem_ren  ,
        o_iptw_addr    : _iptw_addr,
        o_iptw_req     : _iptw_req ,
        i_iptw_rdata   : 64'd0     ,
        i_uart_rx_data : 8'd0      ,
        i_uart_rx_valid: 1'b0      ,
        o_dmem_addr    : dmem_addr ,
        o_dmem_wdata   : dmem_wdata,
        i_dmem_rdata   : dmem_rdata,
        o_dmem_wen     : dmem_wen  ,
        o_dmem_ren     : dmem_ren  ,
        o_dmem_wstrb   : dmem_wstrb,
        o_dbg_regs     : dbg_regs  ,
        o_dbg_pc       : dbg_pc    ,
        o_dbg_pass     : dbg_pass  ,
        o_dbg_r1       : dbg_r1    ,
        o_dbg_r2       : dbg_r2    ,
        o_dbg_r3       : dbg_r3    ,
        i_ext_irq      : 32'd0     ,
    );

    var mem: logic<64> [8];

    let word_addr: logic<3> = dmem_addr[5:3];
    assign dmem_rdata = mem[word_addr];

    always_ff (clk, rst) {
        if_reset {
            mem[0] = 64'd0;
            mem[1] = 64'd0;
            mem[2] = 64'd0;
            mem[3] = 64'd0;
            mem[4] = 64'd0;
            mem[5] = 64'd0;
            mem[6] = 64'd0;
            mem[7] = 64'd0;
        } else if dmem_wen {
            mem[word_addr] = dmem_wdata;
        }
    }

    // Encodings (verified):
    //   addi x10, x0, 0      0x00000513
    //   addi x11, x0, 42     0x02A00593
    //   sd x11, 0(x10)       0x00B53023
    //   lr.d x1, (x10)       0x100520AF
    //   addi x12, x0, 100    0x06400613
    //   sd x12, 0(x10)       0x00C53023
    //   addi x13, x0, 200    0x0C800693
    //   sc.d x2, x13, (x10)  0x18D5312F
    //   ld x3, 0(x10)        0x00053183
    always_comb {
        case imem_addr[7:0] {
            8'h00  : imem_rdata = 32'h00000513; // addi x10,x0,0
            8'h04  : imem_rdata = 32'h00000013;
            8'h08  : imem_rdata = 32'h00000013;
            8'h0C  : imem_rdata = 32'h00000013;
            8'h10  : imem_rdata = 32'h02A00593; // addi x11,x0,42
            8'h14  : imem_rdata = 32'h00000013;
            8'h18  : imem_rdata = 32'h00000013;
            8'h1C  : imem_rdata = 32'h00000013;
            8'h20  : imem_rdata = 32'h00B53023; // sd x11,0(x10)
            8'h24  : imem_rdata = 32'h00000013;
            8'h28  : imem_rdata = 32'h00000013;
            8'h2C  : imem_rdata = 32'h00000013;
            8'h30  : imem_rdata = 32'h100520AF; // lr.d x1,(x10)
            8'h34  : imem_rdata = 32'h00000013;
            8'h38  : imem_rdata = 32'h00000013;
            8'h3C  : imem_rdata = 32'h00000013;
            8'h40  : imem_rdata = 32'h06400613; // addi x12,x0,100
            8'h44  : imem_rdata = 32'h00000013;
            8'h48  : imem_rdata = 32'h00000013;
            8'h4C  : imem_rdata = 32'h00000013;
            8'h50  : imem_rdata = 32'h00C53023; // sd x12,0(x10) ← breaks reservation
            8'h54  : imem_rdata = 32'h00000013;
            8'h58  : imem_rdata = 32'h00000013;
            8'h5C  : imem_rdata = 32'h00000013;
            8'h60  : imem_rdata = 32'h0C800693; // addi x13,x0,200
            8'h64  : imem_rdata = 32'h00000013;
            8'h68  : imem_rdata = 32'h00000013;
            8'h6C  : imem_rdata = 32'h00000013;
            8'h70  : imem_rdata = 32'h18D5312F; // sc.d x2,x13,(x10)
            8'h74  : imem_rdata = 32'h00000013;
            8'h78  : imem_rdata = 32'h00000013;
            8'h7C  : imem_rdata = 32'h00000013;
            8'h80  : imem_rdata = 32'h00053183; // ld x3,0(x10)
            8'h84  : imem_rdata = 32'h00000013;
            default: imem_rdata = 32'h00000013;
        }
    }

    assign o_r1 = dbg_r1;
    assign o_r2 = dbg_r2;
    assign o_r3 = dbg_r3;

    // Pass: LR loaded 42, SC returned 1 (failure), memory still has 100
    assign o_pass = dbg_r1 == 64'd42 && dbg_r2 == 64'd1 && dbg_r3 == 64'd100;
}

#[test(test_amo_fail)]
module test_amo_fail {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass: logic    ;
    var r1  : logic<64>;
    var r2  : logic<64>;
    var r3  : logic<64>;

    inst harness: test_amo_fail_harness ( clk: clk, rst: rst, o_pass: pass, o_r1: r1, o_r2: r2, o_r3: r3 );

    initial {
        rst.assert(clk);
        clk.next  (500);
        $display  ("r1=%h r2=%h r3=%h pass=%b", r1, r2, r3, pass);
        $assert   (pass, "SC failure test: expected x1=42 x2=1 x3=100");
        $display  ("amo_fail test passed");
        $finish   ();
    }
}
