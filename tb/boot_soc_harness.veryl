// boot_soc_harness: N_HARTS new-core harts on heliodor_soc_smp with a PMA
// table (MAP_BOOT by default), the firmware ROM (ROM_EN) and a 32 MiB DRAM
// in an AXI4 slave model (axi4_mem, timing AXI_CFG / AXI_SEED) behind the
// SoC's AXI4 port, one retire_mon and rvfi_tracer per hart. The new-core arm
// of the boot, SMP boot and litmus harnesses. An AXI protocol flag fails
// the run.
//
// Pass is decided by hart 0 (x3 := 0xAA when PASS_BY_X3, else tohost == 1);
// any hart's failure (checker bit, tohost not in {0, 1}) fails the run. The
// o_* scalars are hart 0's. REPLAY_EN replays the golden interrupt schedule
// IRQ_FILE through irq_replay on hart 0 (N_HARTS = 1 with MTIME_SRC =
// INSTRET for a golden lockstep run); a replay failure is the top bit of
// hart 0's monitor chk.
module boot_soc_harness #(
    param N_HARTS    : u32                                = 1                              ,
    param FW_HEX     : string                             = "test/hex/linux_boot_fw.hex"   ,
    param DRAM_HEX   : string                             = "test/hex/linux_dram_real.hex" ,
    param ROM_EN     : bit                                = 1'b1                           ,
    param PMA_N      : u32                                = tb_platform_pkg::MAP_BOOT_N    ,
    param PMA_REGIONS: pma_pkg::PmaRegion     [PMA_N]     = tb_platform_pkg::MAP_BOOT      ,
    param RESET_PC   : bit <64>                           = 64'h0000_0000                  ,
    param PASS_BY_X3 : bit                                = 1'b1                           ,
    param TOHOST_PA  : bit <64>                           = 64'd0                          ,
    param CORE       : soc_pkg::CoreSel                   = soc_pkg::CoreSel::W2           ,
    param MTIME_SRC  : u32                                = soc_pkg::MTIME_CYCLE           ,
    param MTIME_DIV  : u32                                = 10                             ,
    param REPLAY_EN  : bit                                = 1'b0                           ,
    param IRQ_FILE   : string                             = ""                             ,
    param CK_EN      : bit                                = 1'b0                           ,
    param CK_FILE    : string                             = ""                             ,
    param CK_PRINT   : bit                                = 1'b0                           ,
    param TRACE_EN   : bit                                = 1'b0                           ,
    param TRACE_LO   : bit <64>                           = 64'd0                          ,
    param TRACE_HI   : bit <64>                           = 64'hffff_ffff_ffff_ffff        ,
    param PROBE_LOG2 : u32                                = 0                              ,
    param EXT_IRQ_SRC: bit <32>                           = 32'd0                          ,
    param AXI_CFG    : axi4_tb_pkg::SlaveCfg              = axi4_tb_pkg::FIXED             ,
    param AXI_SEED   : bit <32>                           = 32'h1                          ,
    param AXI_MEM_DW : u32                                = 4194304                        , // slave DRAM, dwords
    param AXI_ERR_EXP: bit                                = 1'b0                           , // pass needs both AXI error flags
) (
    clk      : input  clock    ,
    rst      : input  reset    ,
    o_pass   : output logic    ,
    o_fail   : output logic    ,
    o_x3     : output logic<64>,
    o_cycles : output logic<64>,
    o_instret: output logic<64>,
    o_last_pc: output logic<64>,
    o_ret_cnt: output logic<64>,
    o_traps  : output logic<64>,
) {
    const RL: u32 = soc_pkg::RET_LANES;
    const MW: u32 = 2 + soc_pkg::CHK_W + retire_pkg::CHK_RET_W;
    const IW: u32 = $clog2(N_HARTS * 2);

    var axi_arvalid: logic                     ;
    var axi_arready: logic                     ;
    var axi_arid   : logic<IW>                 ;
    var axi_araddr : logic<56>                 ;
    var axi_arlen  : logic<8>                  ;
    var axi_arsize : logic<3>                  ;
    var axi_arburst: logic<2>                  ;
    var axi_rvalid : logic                     ;
    var axi_rready : logic                     ;
    var axi_rid    : logic<IW>                 ;
    var axi_rdata  : logic<64>                 ;
    var axi_rresp  : logic<2>                  ;
    var axi_rlast  : logic                     ;
    var axi_awvalid: logic                     ;
    var axi_awready: logic                     ;
    var axi_awid   : logic<IW>                 ;
    var axi_awaddr : logic<56>                 ;
    var axi_awlen  : logic<8>                  ;
    var axi_awsize : logic<3>                  ;
    var axi_awburst: logic<2>                  ;
    var axi_wvalid : logic                     ;
    var axi_wready : logic                     ;
    var axi_wdata  : logic<64>                 ;
    var axi_wstrb  : logic<8>                  ;
    var axi_wlast  : logic                     ;
    var axi_bvalid : logic                     ;
    var axi_bready : logic                     ;
    var axi_bid    : logic<IW>                 ;
    var axi_bresp  : logic<2>                  ;
    var axi_chk    : logic<axi4_tb_pkg::CHK_N> ;
    var axi_err    : logic<2>                  ;

    var retire     : retire_pkg::RetireRec         [N_HARTS * RL];
    var irq_evt    : retire_pkg::IrqEvent          [N_HARTS]  ;
    var core_chk   : logic<soc_pkg::CHK_W>         [N_HARTS]  ;
    var core_perf  : logic<soc_pkg::PERF_W>        [N_HARTS]  ;
    var mc_perf    : soc_pkg::McPerf                          ;
    var uart_tx_v  : logic                                    ;
    var uart_tx_d  : logic<8>                                 ;
    var rp_limit_en: logic                                    ;
    var rp_limit   : logic<64>                                ;
    var rp_mask    : logic                                    ;
    var rp_allow   : logic                                    ;
    var rp_fail    : logic                                    ;
    var lim_en     : logic<N_HARTS>                           ;
    var lim        : logic<N_HARTS, 64>                       ;
    var irq_mask   : logic<N_HARTS>                           ;
    var irq_allow  : logic<N_HARTS>                           ;

    always_comb {
        lim_en    = 0;
        lim       = 0;
        irq_mask  = 0;
        irq_allow = 0;
        lim_en[0]    = rp_limit_en;
        lim[0]       = rp_limit;
        irq_mask[0]  = rp_mask;
        irq_allow[0] = rp_allow;
    }

    var count   : logic<64>  [N_HARTS];
    var hash    : logic<64>  [N_HARTS];
    var mismatch: logic      [N_HARTS];

    var tc: logic<4>;
    always_ff {
        if_reset {
            tc = 4'd0;
        } else if tc != 4'hf {
            tc = tc + 4'd1;
        }
    }
    let ext_irq: logic<32> = if tc >= 4'd8 && tc <: 4'hf ? EXT_IRQ_SRC : 32'd0;

    inst dut: heliodor_soc_smp #(
        N_HARTS    : N_HARTS    ,
        RESET_PC   : RESET_PC   ,
        CORE       : CORE       ,
        MTIME_SRC  : MTIME_SRC  ,
        MTIME_DIV  : MTIME_DIV  ,
        PMA_N      : PMA_N      ,
        PMA_REGIONS: PMA_REGIONS,
    ) (
        clk                                          ,
        rst                                          ,
        o_imem_addr          : _                     ,
        i_imem_rdata         : '{default: 32'd0}     ,
        o_imem_ren           : _                     ,
        o_iptw_addr          : _                     ,
        o_iptw_req           : _                     ,
        i_iptw_rdata         : '{default: 64'd0}     ,
        o_dmem_addr          : _                     ,
        o_dmem_wdata         : _                     ,
        o_dmem_wen           : _                     ,
        o_dmem_ren           : _                     ,
        o_dmem_wstrb         : _                     ,
        o_dmem_wdata_hi      : _                     ,
        o_dmem_wstrb_hi      : _                     ,
        o_axi_arvalid        : axi_arvalid           ,
        i_axi_arready        : axi_arready           ,
        o_axi_arid           : axi_arid              ,
        o_axi_araddr         : axi_araddr            ,
        o_axi_arlen          : axi_arlen             ,
        o_axi_arsize         : axi_arsize            ,
        o_axi_arburst        : axi_arburst           ,
        i_axi_rvalid         : axi_rvalid            ,
        o_axi_rready         : axi_rready            ,
        i_axi_rid            : axi_rid               ,
        i_axi_rdata          : axi_rdata             ,
        i_axi_rresp          : axi_rresp             ,
        i_axi_rlast          : axi_rlast             ,
        o_axi_awvalid        : axi_awvalid           ,
        i_axi_awready        : axi_awready           ,
        o_axi_awid           : axi_awid              ,
        o_axi_awaddr         : axi_awaddr            ,
        o_axi_awlen          : axi_awlen             ,
        o_axi_awsize         : axi_awsize            ,
        o_axi_awburst        : axi_awburst           ,
        o_axi_wvalid         : axi_wvalid            ,
        i_axi_wready         : axi_wready            ,
        o_axi_wdata          : axi_wdata             ,
        o_axi_wstrb          : axi_wstrb             ,
        o_axi_wlast          : axi_wlast             ,
        i_axi_bvalid         : axi_bvalid            ,
        o_axi_bready         : axi_bready            ,
        i_axi_bid            : axi_bid               ,
        i_axi_bresp          : axi_bresp             ,
        o_axi_err            : axi_err               ,
        o_uart_tx_valid      : uart_tx_v             ,
        o_uart_tx_data       : uart_tx_d             ,
        o_retire             : retire                ,
        o_irq_evt            : irq_evt               ,
        o_core_chk           : core_chk              ,
        o_core_perf          : core_perf             ,
        o_mc_perf            : mc_perf               ,
        i_mtime_tick         : 1'b0                  ,
        i_ext_irq_src        : ext_irq               ,
        i_dbg_retire_limit_en: lim_en                ,
        i_dbg_retire_limit   : lim                   ,
        i_dbg_irq_mask       : irq_mask              ,
        i_dbg_irq_allow      : irq_allow             ,
    );

    inst u_mem: axi4_mem #(
        ID_W   : IW          ,
        MEM_DW : AXI_MEM_DW  ,
        HEX    : DRAM_HEX    ,
        ROM_EN : ROM_EN      ,
        ROM_DW : 2048        ,
        ROM_HEX: FW_HEX      ,
        CFG    : AXI_CFG     ,
        SEED   : AXI_SEED    ,
        MAX_RD : N_HARTS * 2 ,
        MAX_WR : N_HARTS * 2 ,
    ) (
        clk                    ,
        rst                    ,
        i_arvalid: axi_arvalid ,
        o_arready: axi_arready ,
        i_arid   : axi_arid    ,
        i_araddr : axi_araddr  ,
        i_arlen  : axi_arlen   ,
        i_arsize : axi_arsize  ,
        i_arburst: axi_arburst ,
        o_rvalid : axi_rvalid  ,
        i_rready : axi_rready  ,
        o_rid    : axi_rid     ,
        o_rdata  : axi_rdata   ,
        o_rresp  : axi_rresp   ,
        o_rlast  : axi_rlast   ,
        i_awvalid: axi_awvalid ,
        o_awready: axi_awready ,
        i_awid   : axi_awid    ,
        i_awaddr : axi_awaddr  ,
        i_awlen  : axi_awlen   ,
        i_awsize : axi_awsize  ,
        i_awburst: axi_awburst ,
        i_wvalid : axi_wvalid  ,
        o_wready : axi_wready  ,
        i_wdata  : axi_wdata   ,
        i_wstrb  : axi_wstrb   ,
        i_wlast  : axi_wlast   ,
        o_bvalid : axi_bvalid  ,
        i_bready : axi_bready  ,
        o_bid    : axi_bid     ,
        o_bresp  : axi_bresp   ,
        o_chk    : axi_chk     ,
    );
    let axi_bad: logic = (axi_chk != '0) || (axi_err != 2'b00 && !AXI_ERR_EXP);

    always_ff {
        if_reset {} else if uart_tx_v {
            $write("%c", uart_tx_d);
        }
    }

    if REPLAY_EN :g_rep {
        inst u_rep: irq_replay #(
            IRQ_FILE: IRQ_FILE,
            END_EN  : CK_EN   ,
            END_FILE: CK_FILE ,
        ) (
            clk                     ,
            rst                     ,
            i_count   : count[0]    ,
            i_irq_evt : irq_evt[0]  ,
            o_limit_en: rp_limit_en ,
            o_limit   : rp_limit    ,
            o_mask    : rp_mask     ,
            o_allow   : rp_allow    ,
            o_fail    : rp_fail     ,
            o_done    : _           ,
        );
    } else {
        assign rp_limit_en = 1'b0;
        assign rp_limit    = 64'd0;
        assign rp_mask     = 1'b0;
        assign rp_allow    = 1'b0;
        assign rp_fail     = 1'b0;
    }

    var h_x3    : logic<64>  [N_HARTS];
    var h_tohost: logic<32>  [N_HARTS];
    var h_cyc   : logic<64>  [N_HARTS];
    var h_inst  : logic<64>  [N_HARTS];
    var h_pc    : logic<64>  [N_HARTS];
    var h_ret   : logic<64>  [N_HARTS];
    var h_trap  : logic<64>  [N_HARTS];
    var h_pass  : logic      [N_HARTS];
    var h_fail  : logic      [N_HARTS];
    var h_done  : logic      [N_HARTS];
    var h_chk   : logic<MW>  [N_HARTS];
    var any_fail: logic               ;
    var done    : logic               ;

    always_comb {
        any_fail = 1'b0;
        for h in 0..N_HARTS {
            any_fail = any_fail | h_fail[h];
        }
    }
    assign done = h_done[0] || any_fail;

    inst u_mpa: mc_perf_acc (
        clk             ,
        rst             ,
        i_perf: mc_perf ,
        i_en  : !done   ,
        i_dump: done    ,
    );

    for h in 0..N_HARTS :g_hart {
        var stop: logic [RL];
        var ret : retire_pkg::RetireRec [RL];
        for l in 0..RL :g_l {
            assign ret[l] = retire[h * RL + l];
        }

        inst u_trc: rvfi_tracer #(
            LANES   : RL                  ,
            CK_EN   : CK_EN && h == 0     ,
            CK_FILE : CK_FILE             ,
            CK_LOG2 : 16                  ,
            CK_PRINT: CK_PRINT && h == 0  ,
            TRACE_EN: TRACE_EN            ,
            TRACE_LO: TRACE_LO            ,
            TRACE_HI: TRACE_HI            ,
        ) (
            clk                            ,
            rst                            ,
            i_retire       : ret           ,
            i_irq_evt      : irq_evt[h]    ,
            i_stop         : stop          ,
            i_flush        : 1'b0          ,
            o_count        : count[h]      ,
            o_hash         : hash[h]       ,
            o_final_valid  : _             ,
            o_hash_mismatch: mismatch[h]   ,
            o_ck_stale     : _             ,
        );

        if CORE == soc_pkg::CoreSel::W4 :g_pa4 {
            inst u_pa: perf_acc::<cfg_w4> #(
                CORE_ID: 4,
            ) (
                clk                  ,
                rst                  ,
                i_perf: core_perf[h] ,
                i_en  : !done        ,
                i_dump: done         ,
            );
        } else {
            inst u_pa: perf_acc::<cfg_w2> #(
                CORE_ID: 2,
            ) (
                clk                  ,
                rst                  ,
                i_perf: core_perf[h] ,
                i_en  : !done        ,
                i_dump: done         ,
            );
        }

        inst u_mon: retire_mon #(
            LANES     : RL                ,
            TOHOST_PA : TOHOST_PA         ,
            PASS_BY_X3: PASS_BY_X3        ,
            CHK_W     : 2 + soc_pkg::CHK_W,
        ) (
            clk                                                        ,
            rst                                                        ,
            i_retire       : ret                                       ,
            i_irq_evt      : irq_evt[h]                                ,
            i_chk          : {axi_bad && h == 0, rp_fail && h == 0, core_chk[h]},
            i_hash_mismatch: mismatch[h]                               ,
            o_stop         : stop                                      ,
            o_x3           : h_x3[h]                                   ,
            o_tohost       : h_tohost[h]                               ,
            o_pass         : h_pass[h]                                 ,
            o_fail         : h_fail[h]                                 ,
            o_done         : h_done[h]                                 ,
            o_cycles       : h_cyc[h]                                  ,
            o_instret      : h_inst[h]                                 ,
            o_last_pc      : h_pc[h]                                   ,
            o_ret_cnt      : h_ret[h]                                  ,
            o_trap_cnt     : h_trap[h]                                 ,
            o_chk          : h_chk[h]                                  ,
        );
    }

    assign o_pass    = h_pass[0] && !any_fail && (!AXI_ERR_EXP || axi_err == 2'b11);
    assign o_fail    = any_fail;
    assign o_x3      = h_x3[0];
    assign o_cycles  = h_cyc[0];
    assign o_instret = h_inst[0];
    assign o_last_pc = h_pc[0];
    assign o_ret_cnt = h_ret[0];
    assign o_traps   = h_trap[0];

    if PROBE_LOG2 != 0 :g_probe {
        var pcy: logic<64>;
        always_ff {
            if_reset {
                pcy = 64'd0;
            } else {
                pcy = pcy + 64'd1;
                if pcy[PROBE_LOG2 - 1:0] == '0 && !done {
                    for h in 0..N_HARTS {
                        $display("probe cy=%d hart%d: pc=%h records=%d traps=%d", pcy, h, h_pc[h], h_ret[h], h_trap[h]);
                    }
                }
            }
        }
    }

    var reported: logic;
    always_ff {
        if_reset {
            reported = 1'b0;
        } else if done && !reported {
            reported = 1'b1;
            $display("boot: x3=%h cycles=%d instret=%d chk=%h mismatch=%b records=%d hash=%h", h_x3[0], h_cyc[0], h_inst[0],
                h_chk[0], mismatch[0], count[0], hash[0]);
            for h in 0..N_HARTS {
                if h_tohost[h] != 32'd0 {
                    $display("boot hart%d: tohost=%h", h, h_tohost[h]);
                }
            }
            for h in 1..N_HARTS {
                $display("boot hart%d: instret=%d traps=%d chk=%h records=%d hash=%h pc=%h", h, h_inst[h], h_trap[h], h_chk[h],
                    count[h], hash[h], h_pc[h]);
            }
        }
    }
}
