// Shared harness for riscv-tests ISA test bench modules.
//
// Every per-test module in tb/test_arch.veryl instantiates this harness
// with its own HEX_FILE / TOHOST_IDX parameters.  Keeping the heavy
// boilerplate (heliodor_top instance, 1 MB DRAM, imem/dmem/iptw muxes,
// tohost extraction) in a single module massively reduces the amount of
// source that `veryl test` has to parse and analyze.
//
// The riscv-tests "p" environment writes to a tohost word at
// PA 0x80001000 (word index 1024 in the 32-bit DRAM array):
//   tohost == 1  → all subtests passed
//   tohost  > 1  → subtest with that ID failed

module test_arch_common_harness #(
    param HEX_FILE  : string = ""  ,
    param TOHOST_IDX: u32    = 1024,
) (
    clk     : input  clock    ,
    rst     : input  reset    ,
    o_pass  : output logic    ,
    o_fail  : output logic    ,
    o_tohost: output logic<32>,
) {
    var imem_addr   : logic<64>     ;
    var imem_rdata  : logic<32>     ;
    var imem_ren    : logic         ;
    var dmem_addr   : logic<64>     ;
    var dmem_wdata  : logic<64>     ;
    var dmem_rdata  : logic<64>     ;
    var dmem_wen    : logic         ;
    var dmem_ren    : logic         ;
    var dmem_wstrb  : logic<8>      ;
    var dbg_regs    : logic<64> [32];
    var dbg_pc      : logic<64>     ;
    var dbg_pass    : logic         ;
    var dbg_r1      : logic<64>     ;
    var dbg_r2      : logic<64>     ;
    var dbg_r3      : logic<64>     ;
    var iptw_addr   : logic<64>     ;
    var iptw_req    : logic         ;
    var iptw_rdata  : logic<64>     ;
    var _dbg_instret: logic         ;

    inst dut: heliodor_top #(
        RESET_PC: 64'h80000000,
    ) (
        clk                          ,
        rst                          ,
        o_imem_addr    : imem_addr   ,
        i_imem_rdata   : imem_rdata  ,
        o_imem_ren     : imem_ren    ,
        o_iptw_addr    : iptw_addr   ,
        o_iptw_req     : iptw_req    ,
        i_iptw_rdata   : iptw_rdata  ,
        i_uart_rx_data : 8'd0        ,
        i_uart_rx_valid: 1'b0        ,
        o_dmem_addr    : dmem_addr   ,
        o_dmem_wdata   : dmem_wdata  ,
        i_dmem_rdata   : dmem_rdata  ,
        o_dmem_wen     : dmem_wen    ,
        o_dmem_ren     : dmem_ren    ,
        o_dmem_wstrb   : dmem_wstrb  ,
        o_dbg_regs     : dbg_regs    ,
        o_dbg_pc       : dbg_pc      ,
        o_dbg_pass     : dbg_pass    ,
        o_dbg_r1       : dbg_r1      ,
        o_dbg_r2       : dbg_r2      ,
        o_dbg_r3       : dbg_r3      ,
        i_ext_irq      : 32'd0       ,
        o_dbg_instret  : _dbg_instret,
    );

    // 256 KB is enough for every riscv-tests hex file we ship (the
    // largest — rv64si-icache_alias — is ~28 KB). Keeping the array
    // small shaves a little off analyzer pass2, which eagerly allocates
    // one Value per element for every instantiation.
    var dram: logic<32> [65536];
    initial {
        $readmemh(HEX_FILE, dram);
    }

    let in_dram      : logic     = dmem_addr[31];
    let dram_imem_idx: logic<16> = imem_addr[17:2];
    let dram_dmem_lo : logic<16> = {dmem_addr[17:3], 1'b0};
    let dram_dmem_hi : logic<16> = {dmem_addr[17:3], 1'b1};

    assign imem_rdata = if imem_addr[31] ? dram[dram_imem_idx] : 32'd0;
    assign dmem_rdata = if in_dram ? {dram[dram_dmem_hi], dram[dram_dmem_lo]} : 64'd0;

    let dram_iptw_lo: logic<16> = {iptw_addr[17:3], 1'b0};
    let dram_iptw_hi: logic<16> = {iptw_addr[17:3], 1'b1};
    assign iptw_rdata   = if iptw_addr[31] ? {dram[dram_iptw_hi], dram[dram_iptw_lo]} : 64'd0;

    always_ff (clk, rst) {
        if_reset {} else if dmem_wen && in_dram {
            if dmem_wstrb[0] {
                dram[dram_dmem_lo][7:0] = dmem_wdata[7:0];
            }
            if dmem_wstrb[1] {
                dram[dram_dmem_lo][15:8] = dmem_wdata[15:8];
            }
            if dmem_wstrb[2] {
                dram[dram_dmem_lo][23:16] = dmem_wdata[23:16];
            }
            if dmem_wstrb[3] {
                dram[dram_dmem_lo][31:24] = dmem_wdata[31:24];
            }
            if dmem_wstrb[4] {
                dram[dram_dmem_hi][7:0] = dmem_wdata[39:32];
            }
            if dmem_wstrb[5] {
                dram[dram_dmem_hi][15:8] = dmem_wdata[47:40];
            }
            if dmem_wstrb[6] {
                dram[dram_dmem_hi][23:16] = dmem_wdata[55:48];
            }
            if dmem_wstrb[7] {
                dram[dram_dmem_hi][31:24] = dmem_wdata[63:56];
            }
        }
    }

    let tohost_lo: logic<32> = dram[TOHOST_IDX[15:0]];
    assign o_tohost  = tohost_lo;
    assign o_pass    = tohost_lo == 32'd1;
    assign o_fail    = tohost_lo[0] == 1'b0 && tohost_lo != 32'd0;
}
