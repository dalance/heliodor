// P10 Svadu: hardware A/D bit update. ADUE=1 writes the accessed/dirty bits
// back instead of faulting (verified by reading the PTE physically); ADUE=0
// faults on A=0 as before (discriminating).
#[test(test_arch_svadu)]
module test_arch_svadu {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var pass  : logic    ;
    var fail  : logic    ;
    var tohost: logic<32>;
    inst h: test_arch_common_harness #(
        HEX_FILE  : "test/svadu/svadu_test.hex",
        TOHOST_IDX: 1024,
    ) (
        clk          ,
        rst          ,
        o_pass  : pass  ,
        o_fail  : fail  ,
        o_tohost: tohost,
    );
    initial {
        rst.assert(clk);
        clk.next  (100000);
        $display  ("svadu tohost=%h pass=%b", tohost, pass);
        $assert   (pass, "svadu fail");
        $display  ("svadu PASS");
        $finish   ();
    }
}
