// ---- P10 Sstc: supervisor timer (stimecmp) directed test ----
// Uses MTIME_EN=1 so i_mtime advances and the timer can fire.
#[test(test_arch_sstc_stimecmp)]
module test_arch_sstc_stimecmp {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var pass  : logic    ;
    var fail  : logic    ;
    var tohost: logic<32>;
    inst h: test_arch_common_harness #(
        HEX_FILE  : "test/sstc/sstc_test.hex",
        TOHOST_IDX: 1024,
        MTIME_EN  : 1'b1,
    ) (
        clk          ,
        rst          ,
        o_pass  : pass  ,
        o_fail  : fail  ,
        o_tohost: tohost,
    );
    initial {
        rst.assert(clk);
        clk.next  (100000);
        $display  ("sstc-stimecmp tohost=%h pass=%b", tohost, pass);
        $assert   (pass, "sstc-stimecmp fail");
        $display  ("sstc-stimecmp PASS");
        $finish   ();
    }
}

