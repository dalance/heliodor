    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var pass  : logic    ;
    var fail  : logic    ;
    var tohost: logic<32>;
    inst h: test_arch_common_harness #(
        HEX_FILE  : "test/riscv-arch-test/build/rv64ui/lb.hex",
        TOHOST_IDX: 1024                                      ,
    ) (
        clk                                                   ,
        rst                                                   ,
        o_pass    : pass                                      ,
        o_fail    : fail                                      ,
        o_tohost  : tohost                                    ,
    );
    initial {
        rst.assert(clk);
        clk.next  (300000);
        $display  ("v4 rv64ui-lb tohost=%h pass=%b", tohost, pass);
        $assert   (pass, "v4 rv64ui-lb fail");
        $display  ("v4 rv64ui-lb PASS");
        $finish   ();
    }
}

