// irq_replay: drives one hart's schedule-replay debug inputs from a golden
// interrupt schedule and checks the core's interrupt events against it.
//
// Ports (timing contract):
//   i_count     : registered, records the tracer has absorbed
//   i_irq_evt   : registered interrupt event of the hart
//   o_limit_en, o_limit, o_mask, o_allow : registered, to the core's
//                 i_dbg_retire_limit_en/limit, i_dbg_irq_mask/allow
//   o_fail      : registered, sticky
//   o_done      : registered, every scheduled event has been seen
// Owns:
//   - For the next schedule entry (K, cause, epc): limit = K with limit_en,
//     mask and allow set, so the core stops before order K and takes the
//     interrupt only at that boundary. After the last entry: limit = the
//     golden final count (when END_EN) and mask set.
//   - Fail on an event whose order, cause or epc differs from the entry, an
//     event past the end of the schedule, or no event within WAIT_CY cycles
//     of the tracer reaching order K (the golden interrupt is not pending on
//     this core).
// Rationale:
//   - Schedule file ($readmemh, 64-bit words): [0] TRACER_VER, [1] n, then n
//     x (order, cause, epc). END_FILE is a checkpoint file; its final count
//     is word [3 + n].
//   - The inputs change only the cycle after an event, which is the core's
//     full-kill cycle, so the core never takes two interrupts on one entry.
module irq_replay #(
    param IRQ_FILE: string = "",
    param END_EN  : bit    = 0,
    param END_FILE: string = "",
    param DEPTH   : u32    = 1024,
    param CK_DEPTH: u32    = 256,
    param WAIT_CY : u32    = 1000,
) (
    clk       : input  clock               ,
    rst       : input  reset               ,
    i_count   : input  logic           <64>,
    i_irq_evt : input  retire_pkg::IrqEvent,
    o_limit_en: output logic               ,
    o_limit   : output logic           <64>,
    o_mask    : output logic               ,
    o_allow   : output logic               ,
    o_fail    : output logic               ,
    o_done    : output logic               ,
) {
    #[allow(initial_assign)]
    var sched: logic<64> [DEPTH];
    #[allow(initial_assign)]
    var ck_mem: logic<64> [CK_DEPTH];
    initial {
        $readmemh(IRQ_FILE, sched);
        if END_EN {
            $readmemh(END_FILE, ck_mem);
        }
    }

    let n      : logic<32> = sched[1][31:0];
    let ck_n   : logic<32> = ck_mem[2][31:0];
    let end_cnt: logic<64> = ck_mem[ck_n + 32'd3];

    var idx_q : logic<32>;
    var wait_q: logic<32>;
    var fail_q: logic    ;

    let base   : logic<32> = 32'd2 + idx_q * 32'd3;
    let k      : logic<64> = sched[base];
    let k_cause: logic<64> = sched[base + 32'd1];
    let k_epc  : logic<64> = sched[base + 32'd2];
    let active : logic     = idx_q <: n;

    let ev     : retire_pkg::IrqEvent = i_irq_evt;
    let ev_bad : logic                = ev.valid && (!active || ev.order != k || {58'd0, ev.cause} != k_cause || ev.epc != k_epc);
    let timeout: logic                = active && i_count == k && wait_q >= WAIT_CY;

    always_ff {
        if_reset {
            idx_q  = 32'd0;
            wait_q = 32'd0;
            fail_q = 1'b0;
        } else {
            if ev.valid {
                idx_q  = idx_q + 32'd1;
                wait_q = 32'd0;
            } else if active && i_count == k {
                wait_q = wait_q + 32'd1;
            }
            if (ev_bad || timeout) && !fail_q {
                fail_q = 1'b1;
                if ev_bad {
                    $display("irq_replay: event %d order=%d cause=%h epc=%h, expected order=%d cause=%h epc=%h", idx_q,
                        ev.order, ev.cause, ev.epc, k, k_cause, k_epc);
                } else {
                    $display("irq_replay: event %d (order=%d cause=%h) not taken within %d cycles", idx_q, k, k_cause,
                        WAIT_CY);
                }
            }
        }
    }

    assign o_limit_en = active || END_EN;
    assign o_limit    = if active ? k : end_cnt;
    assign o_mask     = 1'b1;
    assign o_allow    = active;
    assign o_fail     = fail_q;
    assign o_done     = !active;
}
