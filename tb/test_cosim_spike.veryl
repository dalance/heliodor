// Online spike co-simulation of the W2 core: the spike_cosim component
// (cosim/spike) steps spike once per retire record and fails the test on the
// first divergence. Needs spike (SPIKE_HOME). riscv-tests images and the
// benches here; the N=1 Linux boots and hvlinux at the end. The gate lists
// run under the cosim with test/gates/run_gc.py, ACT4 with run_act.py
// --cosim.

#[test(test_cosim_spike_rv64ui_add)]
#[ignore]
module test_cosim_spike_rv64ui_add {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var pass  : logic    ;
    var fail  : logic    ;
    var tohost: logic<32>;
    inst h: arch_soc_harness #(
        CORE      : tb_core_sel::CORE_W2,
        HEX_FILE  : "test/riscv-arch-test/build/rv64ui/add.hex",
        TOHOST_IDX: 1024,
    ) (
        clk             ,
        rst             ,
        o_pass  : pass  ,
        o_fail  : fail  ,
        o_tohost: tohost,
    );
    inst cosim: $comp::spike_cosim #(
        HEX_FILE : "test/riscv-arch-test/build/rv64ui/add.hex",
        TOHOST_PA: 64'h80001000,
    ) (
        clk              ,
        rec0: h.retire[0],
        rec1: h.retire[1],
        rec2: h.retire[2],
        rec3: h.retire[3],
        irq : h.irq_evt[0],
    );
    initial {
        rst.assert(clk);
        for _i in 0..500 {
            clk.next(1000);
            if pass || fail {
                break;
            }
        }
        $display("cosim w2 rv64ui/add tohost=%h pass=%b", tohost, pass);
        $assert(pass, "cosim w2 rv64ui/add fail");
        $finish();
    }
}

