#[test(test_cosim_spike_w2_smp_linux_boot_2hart)]
#[ignore]
module test_cosim_spike_w2_smp_linux_boot_2hart {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var pass   : logic    ;
    var fail   : logic    ;
    var x3     : logic<64>;
    var cycles : logic<64>;
    var instret: logic<64>;
    inst h: boot_soc_harness #(
        N_HARTS   : 2                                   ,
        FW_HEX    : "test/hex/linux_boot_fw_2hart.hex"  ,
        DRAM_HEX  : "test/hex/linux_dram_real_2hart.hex",
        PROBE_LOG2: 20                                  ,
        CORE      : tb_core_sel::CORE_W2                ,
    ) (
        clk               ,
        rst               ,
        o_pass   : pass   ,
        o_fail   : fail   ,
        o_x3     : x3     ,
        o_cycles : cycles ,
        o_instret: instret,
        o_last_pc: _      ,
        o_ret_cnt: _      ,
        o_traps  : _      ,
    );
    inst cosim: $comp::spike_cosim_smp #(
        MAP     : "boot"                              ,
        HEX_FILE: "test/hex/linux_dram_real_2hart.hex",
        ROM_HEX : "test/hex/linux_boot_fw_2hart.hex"  ,
    ) (
        clk,
        rec: {h.retire[7], h.retire[6], h.retire[5], h.retire[4], h.retire[3], h.retire[2], h.retire[1], h.retire[0]},
        irq: {h.irq_evt[1], h.irq_evt[0]},
    );
    initial {
        rst.assert(clk);
        for _i in 0..10000 {
            clk.next(10000);
            if pass || fail {
                break;
            }
        }
        clk.next(10);
        $display("cosim w2 smp(N=2) 5.15: cycles=%d instret=%d x3=%h pass=%b fail=%b", cycles, instret, x3, pass, fail);
        $assert(pass, "cosim w2 smp(N=2) 5.15: checker, hart failure or no SBI shutdown");
        $finish();
    }
}

#[test(test_cosim_spike_w2_smp_linux_boot_4hart)]
#[ignore]
module test_cosim_spike_w2_smp_linux_boot_4hart {
    inst clk: $tb::clock_gen;
