// Multi-hart images under spike_cosim_smp: one spike hart per DUT hart on a
// shared memory. The harness parameters match the gates of the same images,
// so the cycle counts are theirs.

#[test(test_cosim_spike_w2_litmus_2hart_short)]
#[ignore]
module test_cosim_spike_w2_litmus_2hart_short {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var pass  : logic    ;
    var fail  : logic    ;
    var cycles: logic<64>;
    inst h: boot_soc_harness #(
        N_HARTS    : 2                                ,
        DRAM_HEX   : "test/litmus/litmus_n2_short.hex",
        ROM_EN     : 1'b0                             ,
        PMA_N      : tb_platform_pkg::MAP_ARCH_N      ,
        PMA_REGIONS: tb_platform_pkg::MAP_ARCH        ,
        RESET_PC   : 64'h8000_0000                    ,
        PASS_BY_X3 : 1'b0                             ,
        TOHOST_PA  : 64'h8000_1000                    ,
        CORE       : tb_core_sel::CORE_W2             ,
    ) (
        clk              ,
        rst              ,
        o_pass   : pass  ,
        o_fail   : fail  ,
        o_x3     : _     ,
        o_cycles : cycles,
        o_instret: _     ,
        o_last_pc: _     ,
        o_ret_cnt: _     ,
        o_traps  : _     ,
    );
    inst cosim: $comp::spike_cosim_smp #(
        HEX_FILE : "test/litmus/litmus_n2_short.hex",
        TOHOST_PA: 64'h8000_1000                    ,
    ) (
        clk,
        rec: {h.retire[7], h.retire[6], h.retire[5], h.retire[4], h.retire[3], h.retire[2], h.retire[1], h.retire[0]},
        irq: {h.irq_evt[1], h.irq_evt[0]},
    );
    initial {
        rst.assert(clk);
        for _i in 0..3000 {
            clk.next(10000);
            if pass || fail {
                break;
            }
        }
        clk.next(10);
        $display("cosim w2 litmus(N=2, short): cycles=%d pass=%b fail=%b", cycles, pass, fail);
        $assert(pass, "cosim w2 litmus(N=2, short): fail");
        $finish();
    }
}

