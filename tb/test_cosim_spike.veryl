        N_HARTS   : 4                                    ,
        FW_HEX    : "test/hex/linux_boot_fw_4hart_mt.hex",
        DRAM_HEX  : "test/hex/linux_dram_real_4hart.hex" ,
        PROBE_LOG2: 20                                   ,
        CORE      : tb_core_sel::CORE_W2                 ,
    ) (
        clk               ,
        rst               ,
        o_pass   : pass   ,
        o_fail   : fail   ,
        o_x3     : x3     ,
        o_cycles : cycles ,
        o_instret: instret,
        o_last_pc: _      ,
        o_ret_cnt: _      ,
        o_traps  : _      ,
    );
    inst cosim: $comp::spike_cosim_smp #(
        MAP     : "boot"                               ,
        HEX_FILE: "test/hex/linux_dram_real_4hart.hex" ,
        ROM_HEX : "test/hex/linux_boot_fw_4hart_mt.hex",
    ) (
        clk,
        rec: {h.retire[15], h.retire[14], h.retire[13], h.retire[12], h.retire[11], h.retire[10], h.retire[9], h.retire[8], h.retire[7], h.retire[6], h.retire[5], h.retire[4], h.retire[3], h.retire[2], h.retire[1], h.retire[0]},
        irq: {h.irq_evt[3], h.irq_evt[2], h.irq_evt[1], h.irq_evt[0]},
    );
    initial {
