// Online spike co-simulation of the W2 core on riscv-tests images: the
// spike_cosim component (cosim/spike) steps spike once per retire record and
// fails the test on the first divergence. Needs spike (SPIKE_HOME).

#[test(test_cosim_spike_rv64ui_add)]
#[ignore]
module test_cosim_spike_rv64ui_add {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var pass  : logic    ;
    var fail  : logic    ;
    var tohost: logic<32>;
    inst h: arch_soc_harness #(
        CORE    : tb_core_sel::CORE_W2,
        HEX_FILE: "test/riscv-arch-test/build/rv64ui/add.hex",
    ) (
        clk             ,
        rst             ,
        o_pass  : pass  ,
        o_fail  : fail  ,
        o_tohost: tohost,
    );
    inst cosim: $comp::spike_cosim #(
        HEX_FILE: "test/riscv-arch-test/build/rv64ui/add.hex",
    ) (
        clk           ,
        rec0: h.retire[0],
        rec1: h.retire[1],
        rec2: h.retire[2],
        rec3: h.retire[3],
    );
    initial {
        rst.assert(clk);
        for _i in 0..300 {
            clk.next(1000);
            if pass || fail {
                break;
            }
        }
        $display("cosim w2 rv64ui/add tohost=%h pass=%b", tohost, pass);
        $assert(pass, "cosim w2 rv64ui/add fail");
        $finish();
    }
}

