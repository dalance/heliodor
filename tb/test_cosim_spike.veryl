        HEX_FILE  : "test/riscv-arch-test/build/rv64ui_v/add.hex",
        TOHOST_IDX: 1024,
    ) (
        clk             ,
        rst             ,
        o_pass  : pass  ,
        o_fail  : fail  ,
        o_tohost: tohost,
    );
    inst cosim: $comp::spike_cosim #(
        HEX_FILE : "test/riscv-arch-test/build/rv64ui_v/add.hex",
        TOHOST_PA: 64'h80001000,
    ) (
        clk              ,
        rec0: h.retire[0],
        rec1: h.retire[1],
        rec2: h.retire[2],
        rec3: h.retire[3],
        irq : h.irq_evt[0],
    );
    initial {
        rst.assert(clk);
        for _i in 0..500 {
            clk.next(1000);
            if pass || fail {
                break;
            }
        }
        $display("cosim w2 rv64ui_v/add tohost=%h pass=%b", tohost, pass);
        $assert(pass, "cosim w2 rv64ui_v/add fail");
        $finish();
    }
}

