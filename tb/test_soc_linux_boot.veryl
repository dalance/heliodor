        $assert (pass, "w4 linux boot: did not reach SBI shutdown (x3 != 0xAA)");
        $finish ();
    }
}

// test_w2_linux_boot_lockstep on the W4 configuration.
#[test(test_w4_linux_boot_lockstep)]
#[ignore]
module test_w4_linux_boot_lockstep {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass   : logic    ;
    var fail   : logic    ;
    var x3     : logic<64>;
    var cycles : logic<64>;
    var instret: logic<64>;
    var last_pc: logic<64>;
    var ret_cnt: logic<64>;

    inst harness: boot_soc_harness #(
        CORE     : tb_core_sel::CORE_W4                  ,
        MTIME_SRC: soc_pkg::MTIME_INSTRET                ,
        MTIME_DIV: 10                                    ,
        REPLAY_EN: 1                                     ,
        IRQ_FILE : "test/golden/boot/linux515_n1.irq.hex",
        CK_EN    : 1                                     ,
        CK_FILE  : "test/golden/boot/linux515_n1.ck.hex" ,
    ) (
        clk                 ,
        rst                 ,
        o_pass   : pass     ,
        o_fail   : fail     ,
        o_x3     : x3       ,
        o_cycles : cycles   ,
        o_instret: instret  ,
        o_last_pc: last_pc  ,
        o_ret_cnt: ret_cnt  ,
        o_traps  : _        ,
    );

    initial {
        rst.assert(clk);
        for i in 0..3700 {
            clk.next(10000);
            if pass || fail {
                break;
            }
            if i % 50 == 49 {
                $display("w4 lockstep probe: records=%d pc=%h x3=%h", ret_cnt, last_pc, x3);
            }
        }
        clk.next(10);
        $display("w4 linux boot lockstep: cycles=%d instret=%d x3=%h pass=%b fail=%b", cycles, instret, x3, pass, fail);
        $assert (pass, "w4 linux boot lockstep: mismatch, replay failure or no SBI shutdown");
        $finish ();
    }
}
