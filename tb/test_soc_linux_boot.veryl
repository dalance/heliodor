        clk                 ,
        rst                 ,
        o_pass       : pass   ,
        o_r3         : r3     ,
        o_cy         : cy     ,
        o_instret    : instret,
        o_last_pc    : last_pc,
    );

    initial {
        rst.assert(clk);
        for i in 0..3700 {
            clk.next(10000);
            if pass {
                break;
            }
