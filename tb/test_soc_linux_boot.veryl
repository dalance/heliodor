// SoC-level Linux boot: the 5.15 Linux boot firmware and kernel on
// heliodor_soc_smp (N_HARTS=1) with the MAP_BOOT table (boot_soc_harness).
// Pass = x3 reaches 0xAA (SBI SRST shutdown). CORE defaults to
// tb_core_sel::CORE; x3 and instret come from retire_mon.
//
// Marked #[ignore] (long run). Run explicitly with:
//   veryl test --ignored --test test_soc_linux_boot
module test_soc_linux_boot_harness #(
    param CORE: soc_pkg::CoreSel = tb_core_sel::CORE,
) (
    clk      : input  clock    ,
    rst      : input  reset    ,
    o_pass   : output logic    ,
    o_r3     : output logic<64>,
    o_cy     : output logic<32>,
    o_instret: output logic<32>,
    o_last_pc: output logic<64>,
) {
    var cy     : logic<32>;
    var instret: logic<64>;
    inst u_new: boot_soc_harness #(
        CORE: CORE,
    ) (
        clk                ,
        rst                ,
        o_pass   : o_pass   ,
        o_fail   : _        ,
        o_x3     : o_r3     ,
        o_cycles : _        ,
        o_instret: instret  ,
        o_last_pc: o_last_pc,
        o_ret_cnt: _        ,
        o_traps  : _        ,
    );
    always_ff {
        if_reset {
            cy = 32'd0;
        } else {
            cy = cy + 32'd1;
        }
    }
    assign o_cy      = cy;
    assign o_instret = instret[31:0];
}

// The 5.15 N=1 boot on the default core, pass/fail only.
#[test(test_soc_linux_boot)]
#[ignore]
module test_soc_linux_boot {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass   : logic    ;
    var r3     : logic<64>;
    var cy     : logic<32>;
    var instret: logic<32>;

    inst harness: test_soc_linux_boot_harness (
        clk                ,
        rst                ,
        o_pass   : pass    ,
        o_r3     : r3      ,
        o_cy     : cy      ,
        o_instret: instret ,
        o_last_pc: _       ,
    );

    initial {
        rst.assert(clk);
        // Poll in 10000-cycle chunks and break on pass so `cy` reports the
        // SBI-shutdown cycle to that resolution.
        for _i in 0..3700 {
            clk.next(10000);
            if pass {
                break;
            }
        }
        $display("SoC linux boot: cy=%d instret=%d x3=%h pass=%b", cy, instret, r3, pass);
        $assert (pass, "SoC linux boot: did not reach SBI shutdown (x3 != 0xAA)");
        $finish ();
    }
}

// The 5.15 N=1 boot on the new core (W2), pass/fail only. The 37M-cycle
// budget is an early-exit bound of about 3x the old core's boot, not a
// measured figure.
#[test(test_w2_linux_boot)]
#[ignore]
module test_w2_linux_boot {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass   : logic    ;
    var r3     : logic<64>;
    var cy     : logic<32>;
    var instret: logic<32>;
    var last_pc: logic<64>;

    inst harness: test_soc_linux_boot_harness #(
        CORE: tb_core_sel::CORE_W2,
    ) (
        clk                 ,
        rst                 ,
        o_pass       : pass   ,
        o_r3         : r3     ,
        o_cy         : cy     ,
        o_instret    : instret,
        o_last_pc    : last_pc,
    );

    initial {
        rst.assert(clk);
        for i in 0..3700 {
            clk.next(10000);
            if pass {
                break;
            }
            if i % 50 == 49 {
                $display("w2 boot probe: cy=%d instret=%d pc=%h x3=%h", cy, instret, last_pc, r3);
            }
        }
        $display("w2 linux boot: cy=%d instret=%d x3=%h pass=%b", cy, instret, r3, pass);
        $assert (pass, "w2 linux boot: did not reach SBI shutdown (x3 != 0xAA)");
        $finish ();
    }
}

// The 5.15 N=1 boot on the new core (W2) in golden lockstep (gate GL-B):
// mtime advances by retire count (K = 10), the golden interrupt schedule is
// replayed, and the trace hash is checked at every 2^16-record checkpoint.
#[test(test_w2_linux_boot_lockstep)]
#[ignore]
module test_w2_linux_boot_lockstep {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass   : logic    ;
    var fail   : logic    ;
    var x3     : logic<64>;
    var cycles : logic<64>;
    var instret: logic<64>;
    var last_pc: logic<64>;
    var ret_cnt: logic<64>;

    inst harness: boot_soc_harness #(
        CORE     : tb_core_sel::CORE_W2                  ,
        MTIME_SRC: soc_pkg::MTIME_INSTRET                ,
        MTIME_DIV: 10                                    ,
        REPLAY_EN: 1                                     ,
        IRQ_FILE : "test/golden/boot/linux515_n1.irq.hex",
        CK_EN    : 1                                     ,
        CK_FILE  : "test/golden/boot/linux515_n1.ck.hex" ,
    ) (
        clk                 ,
        rst                 ,
        o_pass   : pass     ,
        o_fail   : fail     ,
        o_x3     : x3       ,
        o_cycles : cycles   ,
        o_instret: instret  ,
        o_last_pc: last_pc  ,
        o_ret_cnt: ret_cnt  ,
        o_traps  : _        ,
    );

    initial {
        rst.assert(clk);
        for i in 0..3700 {
            clk.next(10000);
            if pass || fail {
                break;
            }
            if i % 50 == 49 {
                $display("w2 lockstep probe: records=%d pc=%h x3=%h", ret_cnt, last_pc, x3);
            }
        }
        clk.next(10);
        $display("w2 linux boot lockstep: cycles=%d instret=%d x3=%h pass=%b fail=%b", cycles, instret, x3, pass, fail);
        $assert (pass, "w2 linux boot lockstep: mismatch, replay failure or no SBI shutdown");
        $finish ();
    }
}

// test_w2_linux_boot on the W4 configuration.
#[test(test_w4_linux_boot)]
#[ignore]
module test_w4_linux_boot {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass   : logic    ;
    var r3     : logic<64>;
    var cy     : logic<32>;
    var instret: logic<32>;
    var last_pc: logic<64>;

    inst harness: test_soc_linux_boot_harness #(
        CORE: tb_core_sel::CORE_W4,
