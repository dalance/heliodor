// CLINT unit test.
// Exercises mtime auto-increment, mtimecmp write + timer_irq edge,
// msip write + sw_irq, and MMIO read-back.
module test_clint_harness (
    clk   : input  clock   ,
    rst   : input  reset   ,
    o_pass: output logic   ,
    o_done: output logic   ,
    o_tc  : output logic<8>,
) {
    var tc: logic<8>;

    always_ff {
        if_reset {
            tc = 8'd0;
        } else {
            tc = tc + 8'd1;
        }
    }

    // DUT I/O
    var addr     : logic<16>;
    var wdata    : logic<64>;
    var wen      : logic    ;
    var ren      : logic    ;
    var rdata    : logic<64>;
    var timer_irq: logic    ;
    var sw_irq   : logic    ;
    var mtime    : logic<64>;

    inst dut: clint (
        clk                   ,
        rst                   ,
        i_addr     : addr     ,
        i_wdata    : wdata    ,
        i_wen      : wen      ,
        i_ren      : ren      ,
        o_rdata    : rdata    ,
        o_timer_irq: timer_irq,
        o_sw_irq   : sw_irq   ,
        o_mtime    : mtime    ,
    );

    // Latched failure + latched read samples
    var failed     : logic    ;
    var sample_mtc : logic<64>;
    var sample_msip: logic<64>;

    always_ff {
        if_reset {
            sample_mtc  = 64'd0;
            sample_msip = 64'd0;
        } else {
            if ren && addr == 16'h4000 {
                sample_mtc = rdata;
            }
            if ren && addr == 16'h0000 {
                sample_msip = rdata;
            }
        }
    }

    // Scripted stimulus (per tc value).
    always_comb {
        addr  = 16'h0000;
        wdata = 64'd0;
        wen   = 1'b0;
        ren   = 1'b0;
        case tc {
            8'd4: {
                addr  = 16'h4000;
                wdata = 64'd1; // mtimecmp = 1 (mtime reaches 1 at ~10 cycles)
                wen   = 1'b1;
            }
            8'd12: {
                addr  = 16'h0000;
                wdata = 64'd1;
                wen   = 1'b1;
            }
            8'd14: {
                addr  = 16'h0000;
                wdata = 64'd0;
                wen   = 1'b1;
            }
            8'd16: {
                addr = 16'h4000;
                ren  = 1'b1;
            }
            8'd17: {
                addr = 16'h0000;
                ren  = 1'b1;
            }
            default: {}
        }
    }

    // Per-cycle combinational checks.  Each one indicates whether the
    // observation for THIS tc value is acceptable.
    var ok: logic;
    always_comb {
        ok = 1'b1;
        case tc {
            8'd5: {
                // mtime increments every 10 cycles; at tc=5, mtime=0 still.
                // Timer irq must be low: mtimecmp=1 written at tc=4.
                // mtime=0 < 1 → no irq yet.
                if timer_irq {
                    ok = 1'b0;
                }
                // msip should be 0 after reset → sw_irq low.
                if sw_irq {
                    ok = 1'b0;
                }
            }
            8'd19: {
                // By tc=19 the msip write at tc=14 has settled; sw_irq low.
                if sw_irq {
                    ok = 1'b0;
                }
                // sample_mtc captured at tc=16 (ren of mtimecmp) → 1
                if sample_mtc != 64'd1 {
                    ok = 1'b0;
                }
                // sample_msip captured at tc=17 (ren of msip) → 0
                if sample_msip[0] != 1'b0 {
                    ok = 1'b0;
                }
                // Timer irq: mtimecmp=1, mtime >= 1 by tc=19 (19 cycles / 10 = 1)
                if !timer_irq {
                    ok = 1'b0;
                }
            }
            default: {}
        }
    }

    always_ff {
        if_reset {
            failed = 1'b0;
        } else if !ok {
            failed = 1'b1;
        }
    }

    assign o_tc   = tc;
    assign o_pass = !failed;
    assign o_done = tc >: 8'd20;
}

#[test(test_clint)]
module test_clint {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen;

    var pass: logic   ;
    var done: logic   ;
    var tc  : logic<8>;

    inst harness: test_clint_harness (
        clk   : clk ,
        rst   : rst ,
        o_pass: pass,
        o_done: done,
        o_tc  : tc  ,
    );

    initial {
        rst.assert(clk);
        for _i: i32 in 0..22 {
            clk.next(1);
        }
        $assert (pass, "CLINT test failed");
        $display("CLINT test passed");
        $finish ();
    }
}
