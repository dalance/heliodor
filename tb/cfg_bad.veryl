// Deliberately illegal configs for test_cfg_constraints: together they set
// every core_types::CFG_ERR bit that depends on the config (all but bit 17,
// which checks fu_pkg latencies), which shows that each check can fire.
// A config package used through core_types must not share a file with its
// user (the generic instance would make the two files depend on each other).
package cfg_bad_a for core_cfg {
    import opclass_pkg::*;

    const FETCH_W    : u32 = 3;
    const RENAME_W   : u32 = 2;
    const ISSUE_W    : u32 = 2;
    const MEM_W      : u32 = 1;
    const COMMIT_W   : u32 = 2;
    const FETCH_BYTES: u32 = 16;
    const ROB_N      : u32 = 1;
    const LQ_N       : u32 = 32;
    const SQ_N       : u32 = 16;
    const SB_N       : u32 = 4;
    const FTQ_N      : u32 = 16;
    const PRF_INT_N  : u32 = 96;
    const PRF_FP_N   : u32 = 32;
    const NUM_CKPT   : u32 = 0;
    const FBQ_N      : u32 = 4;
    const DQ_N       : u32 = 8;
    const RQ_N       : u32 = 4;
    const PRED_META_W: u32 = 16;
    const PRED_CKPT_W: u32 = 72;
    const DTLB_N     : u32 = 16;
    const ITLB_N     : u32 = 16;
    const PTW_D_QN   : u32 = 4;
    const PTW_I_QN   : u32 = 1;
    const REISSUE_W  : u32 = 2;
    const DC_NB      : u32 = 1;
    const MSHR_N     : u32 = 2;

    const PORT_FU: FuSet [ISSUE_W] = '{
        fu_bit(FuKind::ALU) | fu_bit(FuKind::SYS) | fu_bit(FuKind::DIV) | fu_bit(FuKind::FDIV),
        fu_bit(FuKind::ALU) | fu_bit(FuKind::BRU) | fu_bit(FuKind::SYS) | fu_bit(FuKind::LOAD)
    };
    const PORT_IQ: u32   [ISSUE_W] = '{0, 1};
    const N_IQ   : u32             = 2;
    const MEM_IQ : u32             = 1;
    const IQ_N   : u32   [N_IQ]    = '{24, 16};
    const IQ_NSRC: u32   [N_IQ]    = '{3, 2};
}

package cfg_bad_b for core_cfg {
    import opclass_pkg::*;

    const FETCH_W    : u32 = 2;
    const RENAME_W   : u32 = 2;
    const ISSUE_W    : u32 = 2;
    const MEM_W      : u32 = 1;
    const COMMIT_W   : u32 = 0;
    const FETCH_BYTES: u32 = 16;
    const ROB_N      : u32 = 64;
    const LQ_N       : u32 = 32;
    const SQ_N       : u32 = 16;
    const SB_N       : u32 = 4;
    const FTQ_N      : u32 = 16;
    const PRF_INT_N  : u32 = 96;
    const PRF_FP_N   : u32 = 64;
    const NUM_CKPT   : u32 = 2;
    const FBQ_N      : u32 = 4;
    const DQ_N       : u32 = 1;
    const RQ_N       : u32 = 4;
    const PRED_META_W: u32 = 16;
    const PRED_CKPT_W: u32 = 72;
    const DTLB_N     : u32 = 16;
    const ITLB_N     : u32 = 16;
    const PTW_D_QN   : u32 = 4;
    const PTW_I_QN   : u32 = 1;
    const REISSUE_W  : u32 = 1;
    const DC_NB      : u32 = 2;
    const MSHR_N     : u32 = 1;

    const PORT_FU: FuSet [ISSUE_W] = '{
        fu_bit(FuKind::ALU) | fu_bit(FuKind::BRU) | fu_bit(FuKind::SYS) | fu_bit(FuKind::MUL) | fu_bit(FuKind::DIV),
        fu_bit(FuKind::ALU)
    };
    const PORT_IQ: u32   [ISSUE_W] = '{0, 0};
    const N_IQ   : u32             = 2;
    const MEM_IQ : u32             = 5;
    const IQ_N   : u32   [N_IQ]    = '{512, 16};
    const IQ_NSRC: u32   [N_IQ]    = '{4, 2};
}
