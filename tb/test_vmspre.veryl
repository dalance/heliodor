// Equivalence test for the vmsbf.m / vmsof.m / vmsif.m (vmspre) prefix logic.
// vector_unit replaced the VLEN-deep serial running-OR with a log-depth parallel
// prefix-OR; this harness drives the reference serial form and the parallel form
// with the same LFSR-random + directed-edge inputs every cycle and asserts they
// are bit-identical for all of them.
module test_vmspre_harness (
    clk   : input  clock,
    rst   : input  reset,
    o_pass: output logic,
    o_done: output logic,
) {
    var lfsr0: logic<64> ;
    var lfsr1: logic<64> ;
    var cnt  : logic<16> ;
    var ok   : logic     ;

    // Pseudo-random test vector (plus directed edges on vl8 / mode).
    let vs2  : logic<128> = {lfsr0, lfsr1};
    let msk  : logic<128> = {lfsr1, lfsr0} ^ {lfsr0[31:0], lfsr1[63:0], lfsr0[63:32]};
    let vl8  : logic<8>   = case cnt[2:0] {
        3'd0   : 8'd128,
        3'd1   : 8'd0,
        3'd2   : 8'd1,
        3'd3   : 8'd127,
        3'd4   : 8'd64,
        default: lfsr0[7:0],
    };
    let vm   : logic      = lfsr1[5];
    let mode : logic<2>   = case cnt[4:3] {
        2'd0   : 2'b01, // vmsbf
        2'd1   : 2'b10, // vmsof
        2'd2   : 2'b11, // vmsif
        default: lfsr0[9:8],
    };
    let vdold: logic<128> = {lfsr1, lfsr0};

    // ---- reference: VLEN-deep serial running-OR (the original form) ----
    var r_ser: logic<128>;
    always_comb {
        var found: logic;
        r_ser = vdold;
        found = 1'b0;
        for i in 0..128 {
            if ((i as 8) <: vl8) && (vm || msk[i]) {
                let bf : logic = !found && !vs2[i];
                let of : logic = !found && vs2[i];
                let sif: logic = !found;
                r_ser[i] = case mode {
                    2'b01  : bf,
                    2'b10  : of,
                    default: sif,
                };
                found = found || vs2[i];
            }
        }
    }

    // ---- parallel prefix-OR (must mirror vector_unit.veryl) ----
    let vlm   : logic<128> = if vl8 >= 8'd128 ? {1'b1 repeat 128} : (({127'd0, 1'b1} << vl8[6:0]) - {127'd0, 1'b1});
    let active: logic<128> = vlm & (if vm ? {1'b1 repeat 128} : msk);
    let elig  : logic<128> = active & vs2;
    let q1 : logic<128> = elig | (elig << 1);
    let q2 : logic<128> = q1 | (q1 << 2);
    let q3 : logic<128> = q2 | (q2 << 4);
    let q4 : logic<128> = q3 | (q3 << 8);
    let q5 : logic<128> = q4 | (q4 << 16);
    let q6 : logic<128> = q5 | (q5 << 32);
    let qin: logic<128> = q6 | (q6 << 64); // inclusive prefix-OR
    let bef: logic<128> = qin << 1;        // exclusive: OR(elig[0..i-1])
    let nf : logic<128> = ~bef;
    let bft: logic<128> = nf & ~vs2;
    let oft: logic<128> = nf & vs2;
    let sel: logic<128> = case mode {
        2'b01  : bft,
        2'b10  : oft,
        default: nf,
    };
    let r_tre: logic<128> = (active & sel) | (~active & vdold);

    let mismatch: logic = r_ser != r_tre;

    always_ff (clk, rst) {
        if_reset {
            lfsr0 = 64'h1234_5678_9abc_def0;
            lfsr1 = 64'hfedc_ba98_7654_3210;
            cnt   = 16'd0;
            ok    = 1'b1;
        } else {
            if mismatch {
                ok = 1'b0;
            }
            var t0: logic<64>;
            var t1: logic<64>;
            t0    = lfsr0 ^ (lfsr0 << 13);
            t0    = t0 ^ (t0 >> 7);
            t0    = t0 ^ (t0 << 17);
            lfsr0 = t0;
            t1    = lfsr1 ^ (lfsr1 >> 11);
            t1    = t1 ^ (t1 << 9);
            t1    = t1 ^ (t1 >> 13);
            lfsr1 = t1;
            cnt   = cnt + 16'd1;
        }
    }

    assign o_pass = ok;
    assign o_done = cnt >= 16'd4000;
}

#[test(test_vmspre)]
module test_vmspre {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen (clk);
    var pass: logic;
    var done: logic;
    inst h: test_vmspre_harness (
        clk           ,
        rst           ,
        o_pass: pass  ,
        o_done: done  ,
    );
    initial {
        rst.assert(clk);
        clk.next(4200);
        $display("vmspre equiv: pass=%b done=%b", pass, done);
        $assert(done, "vmspre test did not run enough cycles");
        $assert(pass, "vmspre parallel-prefix != serial reference");
        $finish();
    }
}
