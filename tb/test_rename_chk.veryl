// The decode/rename/free_list/dispatch checkers stay clear on legal input
// and set exactly the expected flag once a violation is injected. Each
// violation starts at its own cycle so every flag is seen rising alone.
module rename_chk_harness::<CFG: core_cfg> (
    clk   : input  clock,
    rst   : input  reset,
    o_pass: output logic,
    o_done: output logic,
) {
    import core_types::<CFG>::*;
    import opclass_pkg::*;

    const W : u32 = CFG::RENAME_W;
    const N : u32 = 8;
    const NQ: u32 = CFG::N_IQ;

    var cnt: logic<8>;
    var ok : logic   ;

    // decode: stray pred_taken from cycle 4.
    var dk: logic;
    inst u_dk: chk_decode #(
        W: 2,
    ) (
        clk                            ,
        rst                            ,
        i_taken_ok: {1'b1, !(cnt >= 4)},
        o_chk     : dk                 ,
    );

    // rename: duplicate mapping from cycle 6, blocked write from cycle 8,
    // a restore of a slot keep does not hold from cycle 20, a walk although
    // keep holds a slot from cycle 22.
    var spec: logic<PREG_W> [RAT_N];
    var arch: logic<PREG_W> [RAT_N];
    always_comb {
        for e in 0..RAT_N {
            spec[e] = e[4:0] as PREG_W;
            arch[e] = e[4:0] as PREG_W;
        }
        if cnt >= 6 {
            spec[33] = 5'd2 as PREG_W;
        }
    }
    var rk  : logic <4>           ;
    var rkk : Kill                ;
    var ckv : logic <CKPT_SLOT>   ;
    var own : RobTag [CKPT_SLOT]  ;
    always_comb {
        ckv          = 0;
        own          = '{default: 0 as RobTag};
        ckv[0]       = 1'b1;
        own[0].idx   = 3;
        rkk          = 0 as Kill;
        rkk.valid    = cnt == 20 || cnt == 22;
        rkk.keep.idx = if cnt == 20 ? 4 : 3;
        rkk.ckpt_v   = cnt == 20;
    }
    inst u_rk: chk_rename::<CFG> (
        clk                ,
        rst                ,
        i_spec   : spec    ,
        i_arch   : arch    ,
        i_blocked: cnt >= 8,
        i_kill   : rkk     ,
        i_ckv    : ckv     ,
        i_own    : own     ,
        o_chk    : rk      ,
    );

    // free_list: double push from cycle 10, bad occupancy from cycle 12.
    var ent : logic<PREG_W>        [N]            ;
    var fh  : FlPtr                               ;
    var ft  : FlPtr                               ;
    var rel : RenCm                [CFG::COMMIT_W];
    var push: logic<CFG::COMMIT_W>                ;
    always_comb {
        for e in 0..N {
            ent[e] = (32 + e) as PREG_W;
        }
        fh.wrap = 1'b0;
        fh.idx  = if cnt >= 12 ? 4 : 0;
        ft.wrap = 1'b0;
        ft.idx  = 2;
        push    = 0;
        for l in 0..CFG::COMMIT_W {
            rel[l]          = 0 as RenCm;
            rel[l].old_pdst = 33;
        }
        push[0] = cnt >= 10;
    }
    var fk: logic<2>;
    inst u_fk: chk_free_list::<CFG> #(
        N: N,
    ) (
        clk         ,
        rst         ,
        i_ent : ent ,
        i_head: fh  ,
        i_tail: ft  ,
        i_push: push,
        i_rel : rel ,
        o_chk : fk  ,
    );

    // dispatch: allocation while stalled from cycle 14, over-credit from
    // cycle 16, a NONE op in an IQ from cycle 18.
    var rv : logic              [W]     ;
    var ra : RobAlloc           [W]     ;
    var qv : logic              [NQ * W];
    var qa : IqAlloc            [NQ * W];
    var lsv: logic              [W]     ;
    var iqf: logic   <IQ_CNT_W> [NQ]    ;
    always_comb {
        for l in 0..W {
            rv[l]        = l == 0;
            ra[l]        = 0 as RobAlloc;
            ra[l].ent.fu = FuKind::ALU;
            lsv[l]       = 1'b0;
        }
        for i in 0..NQ * W {
            qv[i]    = 1'b0;
            qa[i]    = 0 as IqAlloc;
            qa[i].fu = FuKind::ALU;
        }
        for q in 0..NQ {
            iqf[q] = 4;
        }
        qv[0] = 1'b1;
        if cnt >= 18 {
            qa[0].fu = FuKind::NONE;
        }
    }
    var dc: logic<3>;
    inst u_dc: chk_dispatch::<CFG> (
        clk                                               ,
        rst                                               ,
        i_stall      : cnt >= 14,
        i_rob_valid  : rv                                 ,
        i_rob        : ra                                 ,
        i_iq_valid   : qv                                 ,
        i_iq         : qa                                 ,
        i_lq_valid   : lsv                                ,
        i_sq_valid   : lsv                                ,
        i_rob_free   : (if cnt >= 16 ? 0 : 4) as ROB_CNT_W,
        i_iq_free    : iqf                                ,
        i_lq_free    : 4 as LQ_CNT_W                      ,
        i_sq_free    : 4 as SQ_CNT_W                      ,
        i_pop_n_int  : 0 as TAKE_W                        ,
        i_pop_n_fp   : 0 as TAKE_W                        ,
        i_fl_int_free: 4 as FL_CNT_W                      ,
        i_fl_fp_free : 4 as FL_CNT_W                      ,
        o_chk        : dc                                 ,
    );

    // Expected flags one cycle after each injection.
    let got: logic<10> = {dc, fk, rk, dk};
    var exp: logic<10>;
    always_comb {
        exp[0] = cnt >= 5;
        exp[1] = cnt >= 7;
        exp[2] = cnt >= 9;
        exp[3] = cnt >= 21;
        exp[4] = cnt >= 23;
        exp[5] = cnt >= 13;
        exp[6] = cnt >= 11;
        exp[7] = cnt >= 15;
        exp[8] = cnt >= 17;
        exp[9] = cnt >= 19;
    }

    always_ff {
        if_reset {
            cnt = 0;
            ok  = 1'b1;
        } else {
            if got != exp {
                ok = 1'b0;
            }
            if cnt != 8'hff {
                cnt = cnt + 1;
            }
        }
    }

    assign o_pass = ok;
    assign o_done = cnt >= 26;
}

#[test(test_rename_chk)]
module test_rename_chk {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass2: logic;
    var done2: logic;
    var pass4: logic;
    var done4: logic;
    inst h2: rename_chk_harness::<cfg_w2> (
        clk          ,
        rst          ,
        o_pass: pass2,
        o_done: done2,
    );
    inst h4: rename_chk_harness::<cfg_w4> (
        clk          ,
        rst          ,
        o_pass: pass4,
        o_done: done4,
    );

    initial {
        rst.assert(clk);
        clk.next(32);
        $display("rename_chk: w2 pass=%b  w4 pass=%b", pass2, pass4);
        $assert(done2 && done4, "rename_chk test did not run enough cycles");
        $assert(pass2 && pass4, "a checker flag differs from the injected violations");
        $finish();
    }
}
