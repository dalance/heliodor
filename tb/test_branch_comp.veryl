// Branch comparator unit test.
// Covers all 6 branch conditions (BEQ/BNE/BLT/BGE/BLTU/BGEU) with
// edge values: 0, +1, -1, INT64_MAX, INT64_MIN, same-sign pairs, and
// the signed/unsigned boundary at 0x8000000000000000.
module test_branch_comp_harness (
    clk   : input  clock   ,
    rst   : input  reset   ,
    o_pass: output logic   ,
    o_done: output logic   ,
    o_tc  : output logic<8>,
) {
    // funct3 encodings (match riscv_pkg::BranchFunct3)
    const F_BEQ : logic<3> = 3'b000;
    const F_BNE : logic<3> = 3'b001;
    const F_BLT : logic<3> = 3'b100;
    const F_BGE : logic<3> = 3'b101;
    const F_BLTU: logic<3> = 3'b110;
    const F_BGEU: logic<3> = 3'b111;

    var tc: logic<8>;

    always_ff {
        if_reset {
            tc = 8'd0;
        } else {
            tc = tc + 8'd1;
        }
    }

    // Latched failure flag: any mismatch during execution sticks.
    var failed: logic;

    // DUT signals
    var rs1   : logic<64>;
    var rs2   : logic<64>;
    var funct3: logic<3> ;
    var taken : logic    ;
    var exp   : logic    ;
    var valid : logic    ; // tc in valid test-vector range

    inst dut: branch_comp (
        i_rs1   : rs1   ,
        i_rs2   : rs2   ,
        i_funct3: funct3,
        o_taken : taken ,
    );

    // Useful 64-bit constants
    const ZERO : logic<64> = 64'h0000_0000_0000_0000;
    const ONE  : logic<64> = 64'h0000_0000_0000_0001;
    const NEG1 : logic<64> = 64'hFFFF_FFFF_FFFF_FFFF;
    const MAX_S: logic<64> = 64'h7FFF_FFFF_FFFF_FFFF;
    const MIN_S: logic<64> = 64'h8000_0000_0000_0000;
    const MAX_U: logic<64> = 64'hFFFF_FFFF_FFFF_FFFF;

    always_comb {
        rs1    = ZERO;
        rs2    = ZERO;
        funct3 = F_BEQ;
        exp    = 1'b0;
        valid  = 1'b1;
        case tc {
            // ---------- BEQ ----------
            8'd1: {
                funct3 = F_BEQ;
                rs1    = ZERO;
                rs2    = ZERO;
                exp    = 1'b1;
            }
            8'd2: {
                funct3 = F_BEQ;
                rs1    = ONE;
                rs2    = ZERO;
                exp    = 1'b0;
            }
            8'd3: {
                funct3 = F_BEQ;
                rs1    = NEG1;
                rs2    = NEG1;
                exp    = 1'b1;
            }
            8'd4: {
                funct3 = F_BEQ;
                rs1    = MIN_S;
                rs2    = MIN_S;
                exp    = 1'b1;
            }
            // ---------- BNE ----------
            8'd5: {
                funct3 = F_BNE;
                rs1    = ZERO;
                rs2    = ZERO;
                exp    = 1'b0;
            }
            8'd6: {
                funct3 = F_BNE;
                rs1    = ONE;
                rs2    = ZERO;
                exp    = 1'b1;
            }
            8'd7: {
                funct3 = F_BNE;
                rs1    = NEG1;
                rs2    = MAX_S;
                exp    = 1'b1;
            }
            // ---------- BLT (signed) ----------
            8'd8: {
                funct3 = F_BLT;
                rs1    = ZERO;
                rs2    = ONE;
                exp    = 1'b1;
            } //  0 <  1
            8'd9: {
                funct3 = F_BLT;
                rs1    = ONE;
                rs2    = ZERO;
                exp    = 1'b0;
            } //  1 <  0
            8'd10: {
                funct3 = F_BLT;
                rs1    = NEG1;
                rs2    = ZERO;
                exp    = 1'b1;
            } // -1 <  0
            8'd11: {
                funct3 = F_BLT;
                rs1    = ZERO;
                rs2    = NEG1;
                exp    = 1'b0;
            } //  0 < -1
            8'd12: {
                funct3 = F_BLT;
                rs1    = MIN_S;
                rs2    = MAX_S;
                exp    = 1'b1;
            } // MIN < MAX
            8'd13: {
                funct3 = F_BLT;
                rs1    = MAX_S;
                rs2    = MIN_S;
                exp    = 1'b0;
            } // MAX < MIN
            8'd14: {
                funct3 = F_BLT;
                rs1    = NEG1;
                rs2    = ONE;
                exp    = 1'b1;
            } // -1 <  1
            // ---------- BGE (signed) ----------
            8'd15: {
                funct3 = F_BGE;
                rs1    = ZERO;
                rs2    = ZERO;
                exp    = 1'b1;
            } //  0 >= 0
            8'd16: {
                funct3 = F_BGE;
                rs1    = ONE;
                rs2    = ZERO;
                exp    = 1'b1;
            } //  1 >= 0
            8'd17: {
                funct3 = F_BGE;
                rs1    = NEG1;
                rs2    = ZERO;
                exp    = 1'b0;
            } // -1 >= 0
            8'd18: {
                funct3 = F_BGE;
                rs1    = MAX_S;
                rs2    = MIN_S;
                exp    = 1'b1;
            } // MAX >= MIN
            8'd19: {
                funct3 = F_BGE;
                rs1    = MIN_S;
                rs2    = MAX_S;
                exp    = 1'b0;
            } // MIN >= MAX
            // ---------- BLTU (unsigned) ----------
            8'd20: {
                funct3 = F_BLTU;
                rs1    = ZERO;
                rs2    = ONE;
                exp    = 1'b1;
            } //  0u <  1u
            8'd21: {
                funct3 = F_BLTU;
                rs1    = NEG1;
                rs2    = ZERO;
                exp    = 1'b0;
            } // MAX_U <  0
            8'd22: {
                funct3 = F_BLTU;
                rs1    = ZERO;
                rs2    = NEG1;
                exp    = 1'b1;
            } //  0 < MAX_U
            8'd23: {
                funct3 = F_BLTU;
                rs1    = MIN_S;
                rs2    = MAX_S;
                exp    = 1'b0;
            } // (unsigned) 0x8... > 0x7...
            8'd24: {
                funct3 = F_BLTU;
                rs1    = MAX_S;
                rs2    = MIN_S;
                exp    = 1'b1;
            } //
            // ---------- BGEU (unsigned) ----------
            8'd25: {
                funct3 = F_BGEU;
                rs1    = ZERO;
                rs2    = ZERO;
                exp    = 1'b1;
            }
            8'd26: {
                funct3 = F_BGEU;
                rs1    = NEG1;
                rs2    = ZERO;
                exp    = 1'b1;
            } // MAX_U >= 0
            8'd27: {
                funct3 = F_BGEU;
                rs1    = ZERO;
                rs2    = NEG1;
                exp    = 1'b0;
            }
            8'd28: {
                funct3 = F_BGEU;
                rs1    = MIN_S;
                rs2    = MAX_S;
                exp    = 1'b1;
            }
            8'd29: {
                funct3 = F_BGEU;
                rs1    = MAX_U;
                rs2    = MAX_U;
                exp    = 1'b1;
            }
            default: {
                valid = 1'b0;
            }
        }
    }

    // Latch failures as they happen.
    always_ff {
        if_reset {
            failed = 1'b0;
        } else if valid && (taken != exp) {
            failed = 1'b1;
        }
    }

    assign o_tc   = tc;
    assign o_pass = !failed;
    assign o_done = tc >: 8'd30;
}

// Native testbench
#[test(test_branch_comp)]
module test_branch_comp {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen(clk);

    var pass: logic   ;
    var done: logic   ;
    var tc  : logic<8>;

    inst harness: test_branch_comp_harness (
        clk   : clk ,
        rst   : rst ,
        o_pass: pass,
        o_done: done,
        o_tc  : tc  ,
    );

    initial {
        rst.assert(clk);
        for _i in 0..32 {
            clk.next(1);
        }
        $assert (pass, "branch_comp test failed");
        $display("branch_comp test passed");
        $finish ();
    }
}
