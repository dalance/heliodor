// rvfi_adapter: the retire record lanes as riscv-formal RVFI signals.
//
// Ports (timing contract):
//   i_retire[NRET]  : registered retire records (NRET = commit width)
//   i_retire_dm     : those records retired in Debug Mode (rvfi_dm)
//   i_halt[NRET]    : the terminal record (retire_mon's stop)
//   rvfi_*          : combinational from the inputs. Lane l of a signal of
//                     width W per lane is bits [l * W +: W] (riscv-formal's
//                     packing); the lanes keep the record order of the core,
//                     and rvfi_order is the record's order
// Rationale:
//   - every retire record is an RVFI retirement, a trap record included
//     (rvfi_trap, with pc_wdata 0: the next record, the handler's first, has
//     rvfi_intr). An interrupt (IrqEvent) retires nothing and only sets the
//     next record's rvfi_intr. Records in Debug Mode stay valid, marked by
//     the rvfi_dm extension, so rvfi_order has no gaps
//   - rvfi_ixl is 2 (RV64) in every mode
//   - rvfi_rs*, rvfi_rd_* carry integer registers only; FP sources and
//     destinations go to the extensions rvfi_frs1-3 and rvfi_frd
//   - memory: rvfi_mem_addr is the virtual address of the first byte; masks
//     and data are right-aligned to it, the _hi extensions carry bytes 8-15
//     of a 16-byte access. A vector op reports no memory access here
//   - CSRs, for Zicsr ops only (a trap's CSR updates are not reported):
//     rmask is all ones when the op reads the CSR, wmask all ones when it
//     writes it; wdata is the CSR's value after the write (after WARL
//     legalization). The generic rvfi_csr_{addr,rmask,wmask,rdata,wdata}
//     extension covers every CSR; the named riscv-formal ports cover a
//     fixed set of M-mode CSRs
//   - extensions: rvfi_virt (H), rvfi_v_* (vector: VRF write count and
//     hash, vtype, vl and vstart after the op), rvfi_fflags, rvfi_rd2_*
//     (rd + 1 of amocas.q), rvfi_mem_paddr and rvfi_mem_io
module rvfi_adapter #(
    param NRET: u32 = 2,
) (
    i_retire               : input  retire_pkg::RetireRec [NRET],
    i_retire_dm            : input  logic,
    i_halt                 : input  logic [NRET],
    rvfi_valid             : output logic<NRET>,
    rvfi_order             : output logic<NRET * 64>,
    rvfi_insn              : output logic<NRET * 32>,
    rvfi_trap              : output logic<NRET>,
    rvfi_halt              : output logic<NRET>,
    rvfi_intr              : output logic<NRET>,
    rvfi_mode              : output logic<NRET * 2>,
    rvfi_ixl               : output logic<NRET * 2>,
    rvfi_rs1_addr          : output logic<NRET * 5>,
    rvfi_rs2_addr          : output logic<NRET * 5>,
    rvfi_rs1_rdata         : output logic<NRET * 64>,
    rvfi_rs2_rdata         : output logic<NRET * 64>,
    rvfi_rd_addr           : output logic<NRET * 5>,
    rvfi_rd_wdata          : output logic<NRET * 64>,
    rvfi_pc_rdata          : output logic<NRET * 64>,
    rvfi_pc_wdata          : output logic<NRET * 64>,
    rvfi_mem_addr          : output logic<NRET * 64>,
    rvfi_mem_rmask         : output logic<NRET * 8>,
    rvfi_mem_wmask         : output logic<NRET * 8>,
    rvfi_mem_rdata         : output logic<NRET * 64>,
    rvfi_mem_wdata         : output logic<NRET * 64>,
    rvfi_csr_misa_rmask    : output logic<NRET * 64>,
    rvfi_csr_misa_wmask    : output logic<NRET * 64>,
    rvfi_csr_misa_rdata    : output logic<NRET * 64>,
    rvfi_csr_misa_wdata    : output logic<NRET * 64>,
    rvfi_csr_mstatus_rmask : output logic<NRET * 64>,
    rvfi_csr_mstatus_wmask : output logic<NRET * 64>,
    rvfi_csr_mstatus_rdata : output logic<NRET * 64>,
    rvfi_csr_mstatus_wdata : output logic<NRET * 64>,
    rvfi_csr_mtvec_rmask   : output logic<NRET * 64>,
    rvfi_csr_mtvec_wmask   : output logic<NRET * 64>,
    rvfi_csr_mtvec_rdata   : output logic<NRET * 64>,
    rvfi_csr_mtvec_wdata   : output logic<NRET * 64>,
    rvfi_csr_mscratch_rmask: output logic<NRET * 64>,
    rvfi_csr_mscratch_wmask: output logic<NRET * 64>,
    rvfi_csr_mscratch_rdata: output logic<NRET * 64>,
    rvfi_csr_mscratch_wdata: output logic<NRET * 64>,
    rvfi_csr_mepc_rmask    : output logic<NRET * 64>,
    rvfi_csr_mepc_wmask    : output logic<NRET * 64>,
    rvfi_csr_mepc_rdata    : output logic<NRET * 64>,
    rvfi_csr_mepc_wdata    : output logic<NRET * 64>,
    rvfi_csr_mcause_rmask  : output logic<NRET * 64>,
    rvfi_csr_mcause_wmask  : output logic<NRET * 64>,
    rvfi_csr_mcause_rdata  : output logic<NRET * 64>,
    rvfi_csr_mcause_wdata  : output logic<NRET * 64>,
    rvfi_csr_mcycle_rmask  : output logic<NRET * 64>,
    rvfi_csr_mcycle_wmask  : output logic<NRET * 64>,
    rvfi_csr_mcycle_rdata  : output logic<NRET * 64>,
    rvfi_csr_mcycle_wdata  : output logic<NRET * 64>,
    rvfi_csr_minstret_rmask: output logic<NRET * 64>,
    rvfi_csr_minstret_wmask: output logic<NRET * 64>,
    rvfi_csr_minstret_rdata: output logic<NRET * 64>,
    rvfi_csr_minstret_wdata: output logic<NRET * 64>,
    rvfi_csr_addr          : output logic<NRET * 12>,
    rvfi_csr_rmask         : output logic<NRET * 64>,
    rvfi_csr_wmask         : output logic<NRET * 64>,
    rvfi_csr_rdata         : output logic<NRET * 64>,
    rvfi_csr_wdata         : output logic<NRET * 64>,
    rvfi_frs1_addr         : output logic<NRET * 5>,
    rvfi_frs1_rdata        : output logic<NRET * 64>,
    rvfi_frs2_addr         : output logic<NRET * 5>,
    rvfi_frs2_rdata        : output logic<NRET * 64>,
    rvfi_frs3_addr         : output logic<NRET * 5>,
    rvfi_frs3_rdata        : output logic<NRET * 64>,
    rvfi_frd_addr          : output logic<NRET * 5>,
    rvfi_frd_wdata         : output logic<NRET * 64>,
    rvfi_fflags            : output logic<NRET * 5>,
    rvfi_rd2_addr          : output logic<NRET * 5>,
    rvfi_rd2_wdata         : output logic<NRET * 64>,
    rvfi_mem_paddr         : output logic<NRET * 64>,
    rvfi_mem_io            : output logic<NRET>,
    rvfi_mem_rmask_hi      : output logic<NRET * 8>,
    rvfi_mem_wmask_hi      : output logic<NRET * 8>,
    rvfi_mem_rdata_hi      : output logic<NRET * 64>,
    rvfi_mem_wdata_hi      : output logic<NRET * 64>,
    rvfi_virt              : output logic<NRET>,
    rvfi_dm                : output logic<NRET>,
    rvfi_v_valid           : output logic<NRET>,
    rvfi_v_vrf_wcnt        : output logic<NRET * 8>,
    rvfi_v_vrf_hash        : output logic<NRET * 64>,
    rvfi_v_vtype           : output logic<NRET * 64>,
    rvfi_v_vl              : output logic<NRET * 64>,
    rvfi_v_vstart          : output logic<NRET * 64>,
) {
    import retire_pkg::*;

    const ONES: logic<64> = '1;

    // Named riscv-formal CSR ports: index into the per-lane arrays below.
    const CSR_N: u32 = 8;
    const CSR_ADDR: bit<12> [CSR_N] = '{12'h301, 12'h300, 12'h305, 12'h340, 12'h341, 12'h342, 12'hB00, 12'hB02};

    var c_rmask: logic<64> [NRET, CSR_N];
    var c_wmask: logic<64> [NRET, CSR_N];
    var c_rdata: logic<64> [NRET, CSR_N];
    var c_wdata: logic<64> [NRET, CSR_N];

    always_comb {
        for l in 0..NRET {
            let r  : RetireRec = i_retire[l];
            let ok : logic     = r.valid && !r.trap;
            let mem: logic     = ok && !r.vec_v;
            let xrd: logic     = ok && r.rd_kind == RdKind::INT && r.rd_addr != 5'd0;
            let frd: logic     = ok && r.rd_kind == RdKind::FP;
            let cr : logic     = ok && r.csr_read;
            let cw : logic     = ok && r.csr_valid;

            rvfi_valid[l] = r.valid;
            rvfi_order[l * 64+:64] = r.order;
            rvfi_insn[l * 32+:32] = r.insn;
            rvfi_trap[l] = r.valid && r.trap;
            rvfi_halt[l] = r.valid && i_halt[l];
            rvfi_intr[l] = r.valid && r.intr;
            rvfi_mode[l * 2+:2] = r.priv;
            rvfi_ixl[l * 2+:2] = 2'd2;

            rvfi_rs1_addr[l * 5+:5] = if r.rs1_kind == RdKind::INT ? r.rs1_addr : 5'd0;
            rvfi_rs1_rdata[l * 64+:64] = if r.rs1_kind == RdKind::INT ? r.rs1_rdata : 64'd0;
            rvfi_rs2_addr[l * 5+:5] = if r.rs2_kind == RdKind::INT ? r.rs2_addr : 5'd0;
            rvfi_rs2_rdata[l * 64+:64] = if r.rs2_kind == RdKind::INT ? r.rs2_rdata : 64'd0;
            rvfi_rd_addr[l * 5+:5] = if xrd ? r.rd_addr : 5'd0;
            rvfi_rd_wdata[l * 64+:64] = if xrd ? r.rd_wdata : 64'd0;
            rvfi_pc_rdata[l * 64+:64] = r.pc;
            rvfi_pc_wdata[l * 64+:64] = r.next_pc;

            rvfi_mem_addr[l * 64+:64] = if mem && (r.mem_rmask | r.mem_wmask) != 16'd0 ? r.mem_vaddr : 64'd0;
            rvfi_mem_rmask[l * 8+:8] = if mem ? r.mem_rmask[7:0] : 8'd0;
            rvfi_mem_wmask[l * 8+:8] = if mem ? r.mem_wmask[7:0] : 8'd0;
            rvfi_mem_rdata[l * 64+:64] = if mem ? r.mem_rdata : 64'd0;
            rvfi_mem_wdata[l * 64+:64] = if mem ? r.mem_wdata : 64'd0;
            rvfi_mem_paddr[l * 64+:64] = if mem && (r.mem_rmask | r.mem_wmask) != 16'd0 ? r.mem_paddr : 64'd0;
            rvfi_mem_io[l] = mem && r.mem_io;
            rvfi_mem_rmask_hi[l * 8+:8] = if mem ? r.mem_rmask[15:8] : 8'd0;
            rvfi_mem_wmask_hi[l * 8+:8] = if mem ? r.mem_wmask[15:8] : 8'd0;
            rvfi_mem_rdata_hi[l * 64+:64] = if mem ? r.mem_rdata_hi : 64'd0;
            rvfi_mem_wdata_hi[l * 64+:64] = if mem ? r.mem_wdata_hi : 64'd0;

            rvfi_csr_addr[l * 12+:12] = if cr || cw ? r.csr_addr : 12'd0;
            rvfi_csr_rmask[l * 64+:64] = if cr ? ONES : 64'd0;
            rvfi_csr_wmask[l * 64+:64] = if cw ? ONES : 64'd0;
            rvfi_csr_rdata[l * 64+:64] = if cr ? r.csr_rdata : 64'd0;
            rvfi_csr_wdata[l * 64+:64] = if cw ? r.csr_new : 64'd0;
            for k in 0..CSR_N {
                let hit: logic = r.csr_addr == CSR_ADDR[k];
                c_rmask[l][k] = if cr && hit ? ONES : 64'd0;
                c_wmask[l][k] = if cw && hit ? ONES : 64'd0;
                c_rdata[l][k] = if cr && hit ? r.csr_rdata : 64'd0;
                c_wdata[l][k] = if cw && hit ? r.csr_new : 64'd0;
            }

            rvfi_frs1_addr[l * 5+:5] = if r.rs1_kind == RdKind::FP ? r.rs1_addr : 5'd0;
            rvfi_frs1_rdata[l * 64+:64] = if r.rs1_kind == RdKind::FP ? r.rs1_rdata : 64'd0;
            rvfi_frs2_addr[l * 5+:5] = if r.rs2_kind == RdKind::FP ? r.rs2_addr : 5'd0;
            rvfi_frs2_rdata[l * 64+:64] = if r.rs2_kind == RdKind::FP ? r.rs2_rdata : 64'd0;
            rvfi_frs3_addr[l * 5+:5] = if r.rs3_kind == RdKind::FP ? r.rs3_addr : 5'd0;
            rvfi_frs3_rdata[l * 64+:64] = if r.rs3_kind == RdKind::FP ? r.rs3_rdata : 64'd0;
            rvfi_frd_addr[l * 5+:5] = if frd ? r.rd_addr : 5'd0;
            rvfi_frd_wdata[l * 64+:64] = if frd ? r.rd_wdata : 64'd0;
            rvfi_fflags[l * 5+:5] = if ok ? r.fflags : 5'd0;
            rvfi_rd2_addr[l * 5+:5] = if ok && r.rd2_valid ? r.rd_addr + 5'd1 : 5'd0;
            rvfi_rd2_wdata[l * 64+:64] = if ok && r.rd2_valid ? r.rd2_wdata : 64'd0;

            rvfi_virt[l] = r.virt;
            rvfi_dm[l] = r.valid && i_retire_dm;
            rvfi_v_valid[l] = ok && r.vec_v;
            rvfi_v_vrf_wcnt[l * 8+:8] = if ok && r.vec_v ? r.vrf_wcnt : 8'd0;
            rvfi_v_vrf_hash[l * 64+:64] = if ok && r.vec_v ? r.vrf_hash : 64'd0;
            rvfi_v_vtype[l * 64+:64] = if ok && r.vec_v ? r.vtype : 64'd0;
            rvfi_v_vl[l * 64+:64] = if ok && r.vec_v ? r.vl : 64'd0;
            rvfi_v_vstart[l * 64+:64] = if ok && r.vec_v ? r.vstart : 64'd0;
        }
    }

    for l in 0..NRET :g_csr_misa {
        assign rvfi_csr_misa_rmask[l * 64+:64] = c_rmask[l][0];
        assign rvfi_csr_misa_wmask[l * 64+:64] = c_wmask[l][0];
        assign rvfi_csr_misa_rdata[l * 64+:64] = c_rdata[l][0];
        assign rvfi_csr_misa_wdata[l * 64+:64] = c_wdata[l][0];
    }
    for l in 0..NRET :g_csr_mstatus {
        assign rvfi_csr_mstatus_rmask[l * 64+:64] = c_rmask[l][1];
        assign rvfi_csr_mstatus_wmask[l * 64+:64] = c_wmask[l][1];
        assign rvfi_csr_mstatus_rdata[l * 64+:64] = c_rdata[l][1];
        assign rvfi_csr_mstatus_wdata[l * 64+:64] = c_wdata[l][1];
    }
    for l in 0..NRET :g_csr_mtvec {
        assign rvfi_csr_mtvec_rmask[l * 64+:64] = c_rmask[l][2];
        assign rvfi_csr_mtvec_wmask[l * 64+:64] = c_wmask[l][2];
        assign rvfi_csr_mtvec_rdata[l * 64+:64] = c_rdata[l][2];
        assign rvfi_csr_mtvec_wdata[l * 64+:64] = c_wdata[l][2];
    }
    for l in 0..NRET :g_csr_mscratch {
        assign rvfi_csr_mscratch_rmask[l * 64+:64] = c_rmask[l][3];
        assign rvfi_csr_mscratch_wmask[l * 64+:64] = c_wmask[l][3];
        assign rvfi_csr_mscratch_rdata[l * 64+:64] = c_rdata[l][3];
        assign rvfi_csr_mscratch_wdata[l * 64+:64] = c_wdata[l][3];
    }
    for l in 0..NRET :g_csr_mepc {
        assign rvfi_csr_mepc_rmask[l * 64+:64] = c_rmask[l][4];
        assign rvfi_csr_mepc_wmask[l * 64+:64] = c_wmask[l][4];
        assign rvfi_csr_mepc_rdata[l * 64+:64] = c_rdata[l][4];
        assign rvfi_csr_mepc_wdata[l * 64+:64] = c_wdata[l][4];
    }
    for l in 0..NRET :g_csr_mcause {
        assign rvfi_csr_mcause_rmask[l * 64+:64] = c_rmask[l][5];
        assign rvfi_csr_mcause_wmask[l * 64+:64] = c_wmask[l][5];
        assign rvfi_csr_mcause_rdata[l * 64+:64] = c_rdata[l][5];
        assign rvfi_csr_mcause_wdata[l * 64+:64] = c_wdata[l][5];
    }
    for l in 0..NRET :g_csr_mcycle {
        assign rvfi_csr_mcycle_rmask[l * 64+:64] = c_rmask[l][6];
        assign rvfi_csr_mcycle_wmask[l * 64+:64] = c_wmask[l][6];
        assign rvfi_csr_mcycle_rdata[l * 64+:64] = c_rdata[l][6];
        assign rvfi_csr_mcycle_wdata[l * 64+:64] = c_wdata[l][6];
    }
    for l in 0..NRET :g_csr_minstret {
        assign rvfi_csr_minstret_rmask[l * 64+:64] = c_rmask[l][7];
        assign rvfi_csr_minstret_wmask[l * 64+:64] = c_wmask[l][7];
        assign rvfi_csr_minstret_rdata[l * 64+:64] = c_rdata[l][7];
        assign rvfi_csr_minstret_wdata[l * 64+:64] = c_wdata[l][7];
    }
}
