// arch_soc_harness: one new-core hart on heliodor_soc_smp with the MAP_ARCH
// table, a 4 MiB DRAM in an AXI4 slave model (axi4_mem, timing AXI_CFG /
// AXI_SEED) behind the SoC's AXI4 port, retire_mon and rvfi_tracer. The
// new-core arm of test_arch_common_harness. chk_io_mon's flags and the AXI
// protocol flags fail the run. PASS_BY_X3 passes on x3 := 0xAA instead of tohost;
// EXT_IRQ_SRC is pulsed into the PLIC sources in cycles 8-14.
//
// DMI_EN plays the DMI script DMI_FILE (dm_seq) on the SoC's APB port and
// checks it with chk_dm; the run then passes once the script has reached END
// with no mismatch and the program has written tohost = 1 with nothing
// failed. Records retired in Debug Mode are not the program's (retire_mon
// and the tracer skip them); without DMI_EN one fails the run. Without
// DMI_EN the APB port is idle.
module arch_soc_harness #(
    param HEX_FILE   : string           = ""                  ,
    param TOHOST_IDX : u32              = 1024                ,
    param MTIME_SRC  : u32              = soc_pkg::MTIME_CYCLE,
    param MTIME_DIV  : u32              = 10                  ,
    param CORE       : soc_pkg::CoreSel = soc_pkg::CoreSel::W2,
    param CK_EN      : bit              = 1'b0                ,
    param CK_FILE    : string           = ""                  ,
    param TRACE_EN   : bit              = 1'b0                ,
    param PASS_BY_X3 : bit              = 1'b0                ,
    param EXT_IRQ_SRC: bit<32>          = 32'd0               ,
    param AXI_CFG    : axi4_tb_pkg::SlaveCfg = axi4_tb_pkg::FIXED,
    param AXI_SEED   : bit<32>          = 32'h1               ,
    param DMI_EN     : bit              = 1'b0                ,
    param DMI_FILE   : string           = ""                  ,
) (
    clk     : input  clock    ,
    rst     : input  reset    ,
    o_pass  : output logic    ,
    o_fail  : output logic    ,
    o_tohost: output logic<32>,
) {
    const RL       : u32       = soc_pkg::RET_LANES;
    const TOHOST_PA: bit  <64> = 64'h8000_0000 + (TOHOST_IDX as 64) * 4;

    var axi_arvalid  : logic                             ;
    var axi_arready  : logic                             ;
    var axi_arid     : logic<2>                          ;
    var axi_araddr   : logic<56>                         ;
    var axi_arlen    : logic<8>                          ;
    var axi_arsize   : logic<3>                          ;
    var axi_arburst  : logic<2>                          ;
    var axi_rvalid   : logic                             ;
    var axi_rready   : logic                             ;
    var axi_rid      : logic<2>                          ;
    var axi_rdata    : logic<64>                         ;
    var axi_rresp    : logic<2>                          ;
    var axi_rlast    : logic                             ;
    var axi_awvalid  : logic                             ;
    var axi_awready  : logic                             ;
    var axi_awid     : logic<2>                          ;
    var axi_awaddr   : logic<56>                         ;
    var axi_awlen    : logic<8>                          ;
    var axi_awsize   : logic<3>                          ;
    var axi_awburst  : logic<2>                          ;
    var axi_wvalid   : logic                             ;
    var axi_wready   : logic                             ;
    var axi_wdata    : logic<64>                         ;
    var axi_wstrb    : logic<8>                          ;
    var axi_wlast    : logic                             ;
    var axi_bvalid   : logic                             ;
    var axi_bready   : logic                             ;
    var axi_bid      : logic<2>                          ;
    var axi_bresp    : logic<2>                          ;
    var axi_chk      : logic<axi4_tb_pkg::CHK_N>         ;
    var axi_err      : logic<3>                          ;
    var retire       : retire_pkg::RetireRec         [RL];
    var retire_dm    : logic                         [1] ;
    var irq_evt      : retire_pkg::IrqEvent          [1] ;
    var core_chk     : logic<soc_pkg::CHK_W>         [1] ;
    var core_perf    : logic<soc_pkg::PERF_W>        [1] ;
    var mc_perf      : soc_pkg::McPerf                   ;
    var uart_tx_v    : logic                             ;
    var uart_tx_d    : logic<8>                          ;
    var io_obs       : soc_pkg::IoObs                [2] ;
    var tc           : logic<4>                          ;

    always_ff {
        if_reset {
            tc = 4'd0;
        } else if tc != 4'hf {
            tc = tc + 4'd1;
        }
    }
    let ext_irq: logic<32> = if tc >= 4'd8 && tc <: 4'hf ? EXT_IRQ_SRC : 32'd0;

    var dm_psel   : logic         ;
    var dm_penable: logic         ;
    var dm_pwrite : logic         ;
    var dm_paddr  : logic<9>      ;
    var dm_pwdata : logic<32>     ;
    var dm_pstrb  : logic<4>      ;
    var dm_pready : logic         ;
    var dm_prdata : logic<32>     ;
    var dm_pslverr: logic         ;
    var dm_obs    : soc_pkg::DmObs;
    var dm_chk    : logic<6>      ;
    var seq_done  : logic         ;
    var seq_fail  : logic         ;

    inst dut: heliodor_soc_smp #(
        N_HARTS    : 1                          ,
        RESET_PC   : 64'h8000_0000              ,
        CORE       : CORE                       ,
        MTIME_SRC  : MTIME_SRC                  ,
        MTIME_DIV  : MTIME_DIV                  ,
        UART_WRCNT : 1'b1                       ,
        PMA_N      : tb_platform_pkg::MAP_ARCH_N,
        PMA_REGIONS: tb_platform_pkg::MAP_ARCH  ,
        DM_BASE    : tb_platform_pkg::DM_BASE   ,
    ) (
        clk                            ,
        rst                            ,
        o_imem_addr    : _             ,
        i_imem_rdata   : '{32'd0}      ,
        o_imem_ren     : _             ,
        o_iptw_addr    : _             ,
        o_iptw_req     : _             ,
        i_iptw_rdata   : '{64'd0}      ,
        o_dmem_addr    : _             ,
        o_dmem_wdata   : _             ,
        o_dmem_wen     : _             ,
        o_dmem_ren     : _             ,
        o_dmem_wstrb   : _             ,
        o_dmem_wdata_hi: _             ,
        o_dmem_wstrb_hi: _             ,
        o_axi_arvalid  : axi_arvalid   ,
        i_axi_arready  : axi_arready   ,
        o_axi_arid     : axi_arid      ,
        o_axi_araddr   : axi_araddr    ,
        o_axi_arlen    : axi_arlen     ,
        o_axi_arsize   : axi_arsize    ,
        o_axi_arburst  : axi_arburst   ,
        i_axi_rvalid   : axi_rvalid    ,
        o_axi_rready   : axi_rready    ,
        i_axi_rid      : axi_rid       ,
        i_axi_rdata    : axi_rdata     ,
        i_axi_rresp    : axi_rresp     ,
        i_axi_rlast    : axi_rlast     ,
        o_axi_awvalid  : axi_awvalid   ,
        i_axi_awready  : axi_awready   ,
        o_axi_awid     : axi_awid      ,
        o_axi_awaddr   : axi_awaddr    ,
        o_axi_awlen    : axi_awlen     ,
        o_axi_awsize   : axi_awsize    ,
        o_axi_awburst  : axi_awburst   ,
        o_axi_wvalid   : axi_wvalid    ,
        i_axi_wready   : axi_wready    ,
        o_axi_wdata    : axi_wdata     ,
        o_axi_wstrb    : axi_wstrb     ,
        o_axi_wlast    : axi_wlast     ,
        i_axi_bvalid   : axi_bvalid    ,
        o_axi_bready   : axi_bready    ,
        i_axi_bid      : axi_bid       ,
        i_axi_bresp    : axi_bresp     ,
        o_axi_err      : axi_err       ,
        o_uart_tx_valid: uart_tx_v     ,
        o_uart_tx_data : uart_tx_d     ,
        o_retire       : retire        ,
        o_retire_dm    : retire_dm     ,
        o_irq_evt      : irq_evt       ,
        o_core_chk     : core_chk      ,
        o_core_perf    : core_perf     ,
        o_mc_perf      : mc_perf       ,
        i_ext_irq_src  : ext_irq       ,
        o_io_obs       : io_obs        ,
        i_dm_rst       : rst           ,
        i_dm_psel      : dm_psel       ,
        i_dm_penable   : dm_penable    ,
        i_dm_pwrite    : dm_pwrite     ,
        i_dm_paddr     : dm_paddr      ,
        i_dm_pwdata    : dm_pwdata     ,
        i_dm_pstrb     : dm_pstrb      ,
        i_dm_pprot     : 3'd0          ,
        o_dm_pready    : dm_pready     ,
        o_dm_prdata    : dm_prdata     ,
        o_dm_pslverr   : dm_pslverr    ,
        o_dm_obs       : dm_obs        ,
    );

    if DMI_EN :g_dmi {
        var rd_n: logic<32>;
        var wr_n: logic<32>;
        inst u_seq: dm_seq #(
            FILE: DMI_FILE,
        ) (
            clk                   ,
            rst                   ,
            o_psel   : dm_psel    ,
            o_penable: dm_penable ,
            o_pwrite : dm_pwrite  ,
            o_paddr  : dm_paddr   ,
            o_pwdata : dm_pwdata  ,
            o_pstrb  : dm_pstrb   ,
            i_pready : dm_pready  ,
            i_prdata : dm_prdata  ,
            i_pslverr: dm_pslverr ,
            o_done   : seq_done   ,
            o_fail   : seq_fail   ,
            o_rd_n   : rd_n       ,
            o_wr_n   : wr_n       ,
        );
        inst u_chk_dm: chk_dm (
            clk                   ,
            rst                   ,
            i_psel   : dm_psel    ,
            i_penable: dm_penable ,
            i_pwrite : dm_pwrite  ,
            i_paddr  : dm_paddr   ,
            i_pwdata : dm_pwdata  ,
            i_pstrb  : dm_pstrb   ,
            i_pready : dm_pready  ,
            i_obs    : dm_obs     ,
            o_chk    : dm_chk     ,
        );
        var said  : logic    ;
        var cmd_n : logic<32>;
        var err_n : logic<32>;
        var sbr_n : logic<32>;
        var sbw_n : logic<32>;
        var sbe_n : logic<32>;
        var sbbe_n: logic<32>;
        always_ff {
            if_reset {
                said   = 1'b0;
                cmd_n  = 32'd0;
                err_n  = 32'd0;
                sbr_n  = 32'd0;
                sbw_n  = 32'd0;
                sbe_n  = 32'd0;
                sbbe_n = 32'd0;
            } else {
                cmd_n  += {31'd0, dm_obs.cmd.start};
                err_n  += {31'd0, dm_obs.cmd.err != 3'd0};
                sbr_n  += {31'd0, dm_obs.sba.done && !dm_obs.sba.write};
                sbw_n  += {31'd0, dm_obs.sba.done && dm_obs.sba.write};
                sbe_n  += {31'd0, dm_obs.sba.err != 3'd0};
                sbbe_n += {31'd0, dm_obs.sba.busyerr};
                if seq_done && !said {
                    said = 1'b1;
                    $display("dmi: done fail=%b chk=%b reads=%d writes=%d cmds=%d cmderrs=%d sba_rd=%d sba_wr=%d sberrs=%d sbbusyerrs=%d tohost=%h",
                        seq_fail, dm_chk, rd_n, wr_n, cmd_n, err_n, sbr_n, sbw_n, sbe_n, sbbe_n, o_tohost);
                }
            }
        }
    } else {
        assign dm_psel    = 1'b0;
        assign dm_penable = 1'b0;
        assign dm_pwrite  = 1'b0;
        assign dm_paddr   = 9'd0;
        assign dm_pwdata  = 32'd0;
        assign dm_pstrb   = 4'd0;
        assign dm_chk     = 6'd0;
        assign seq_done   = 1'b0;
        assign seq_fail   = 1'b0;
    }

    inst u_mem: axi4_mem #(
        ID_W  : 2        ,
        MEM_DW: 524288   ,
        HEX   : HEX_FILE ,
        CFG   : AXI_CFG  ,
        SEED  : AXI_SEED ,
        MAX_RD: 3        ,
        MAX_WR: 2        ,
    ) (
        clk                    ,
        rst                    ,
        i_arvalid: axi_arvalid ,
        o_arready: axi_arready ,
        i_arid   : axi_arid    ,
        i_araddr : axi_araddr  ,
        i_arlen  : axi_arlen   ,
        i_arsize : axi_arsize  ,
        i_arburst: axi_arburst ,
        o_rvalid : axi_rvalid  ,
        i_rready : axi_rready  ,
        o_rid    : axi_rid     ,
        o_rdata  : axi_rdata   ,
        o_rresp  : axi_rresp   ,
        o_rlast  : axi_rlast   ,
        i_awvalid: axi_awvalid ,
        o_awready: axi_awready ,
        i_awid   : axi_awid    ,
        i_awaddr : axi_awaddr  ,
        i_awlen  : axi_awlen   ,
        i_awsize : axi_awsize  ,
        i_awburst: axi_awburst ,
        i_wvalid : axi_wvalid  ,
        o_wready : axi_wready  ,
        i_wdata  : axi_wdata   ,
        i_wstrb  : axi_wstrb   ,
        i_wlast  : axi_wlast   ,
        o_bvalid : axi_bvalid  ,
        i_bready : axi_bready  ,
        o_bid    : axi_bid     ,
        o_bresp  : axi_bresp   ,
        o_chk    : axi_chk     ,
    );
    let axi_bad: logic = (axi_chk != '0) || (axi_err != 3'b000);

    always_ff {
        if_reset {} else if uart_tx_v {
            $write("%c", uart_tx_d);
        }
    }

    var mon_pass: logic         ;
    var stop    : logic     [RL];
    var mismatch: logic         ;
    var done    : logic         ;
    var cycles  : logic<64>     ;
    var instret : logic<64>     ;
    var count   : logic<64>     ;
    var hash    : logic<64>     ;
    var io_chk  : logic<4>      ;
    var io_rd_n : logic<32>     ;
    var io_wr_n : logic<32>     ;
    var stop_any: logic         ;
    always_comb {
        stop_any = 1'b0;
        for l in 0..RL {
            stop_any |= stop[l];
        }
    }
    inst u_trc: rvfi_tracer #(
        LANES   : RL      ,
        CK_EN   : CK_EN   ,
        CK_FILE : CK_FILE ,
        TRACE_EN: TRACE_EN,
    ) (
        clk                          ,
        rst                          ,
        i_retire       : retire      ,
        i_retire_dm    : retire_dm[0],
        i_irq_evt      : irq_evt[0]  ,
        i_stop         : stop        ,
        i_flush        : 1'b0        ,
        o_count        : count       ,
        o_hash         : hash        ,
        o_final_valid  : _           ,
        o_hash_mismatch: mismatch    ,
        o_ck_stale     : _           ,
    );

    inst u_io: chk_io_mon #(
        LANES      : RL                         ,
        PMA_N      : tb_platform_pkg::MAP_ARCH_N,
        PMA_REGIONS: tb_platform_pkg::MAP_ARCH  ,
    ) (
        clk                 ,
        rst                 ,
        i_obs   : io_obs    ,
        i_retire: retire    ,
        i_end   : stop_any  ,
        o_chk   : io_chk    ,
        o_rd_n  : io_rd_n   ,
        o_wr_n  : io_wr_n   ,
    );

    inst u_mpa: mc_perf_acc (
        clk             ,
        rst             ,
        i_perf: mc_perf ,
        i_en  : !done   ,
        i_dump: done    ,
    );

    if CORE == soc_pkg::CoreSel::W4 :g_pa4 {
        inst u_pa: perf_acc::<cfg_w4> #(
            CORE_ID: 4,
        ) (
            clk                  ,
            rst                  ,
            i_perf: core_perf[0] ,
            i_en  : !done        ,
            i_dump: done         ,
        );
    } else {
        inst u_pa: perf_acc::<cfg_w2> #(
            CORE_ID: 2,
        ) (
            clk                  ,
            rst                  ,
            i_perf: core_perf[0] ,
            i_en  : !done        ,
            i_dump: done         ,
        );
    }

    inst u_mon: retire_mon #(
        LANES     : RL                ,
        TOHOST_PA : TOHOST_PA         ,
        PASS_BY_X3: PASS_BY_X3        ,
        CHK_W     : 12 + soc_pkg::CHK_W,
        DM_OK     : DMI_EN            ,
    ) (
        clk                          ,
        rst                          ,
        i_retire       : retire      ,
        i_retire_dm    : retire_dm[0],
        i_irq_evt      : irq_evt[0]  ,
        i_chk          : {seq_fail, dm_chk, axi_bad, io_chk, core_chk[0]},
        i_hash_mismatch: mismatch    ,
        o_stop         : stop        ,
        o_x3           : _           ,
        o_tohost       : o_tohost    ,
        o_pass         : mon_pass    ,
        o_fail         : o_fail      ,
        o_done         : done        ,
        o_cycles       : cycles      ,
        o_instret      : instret     ,
        o_last_pc      : _           ,
        o_ret_cnt      : _           ,
        o_trap_cnt     : _           ,
        o_chk          : _           ,
    );

    assign o_pass = if DMI_EN ? seq_done && mon_pass : mon_pass;

    var reported: logic;
    always_ff {
        if_reset {
            reported = 1'b0;
        } else if done && !reported {
            reported = 1'b1;
            $display("arch: tohost=%h cycles=%d instret=%d chk=%h io=%b/%d/%d mismatch=%b records=%d hash=%h", o_tohost,
                cycles, instret, core_chk[0], io_chk, io_rd_n, io_wr_n, mismatch, count, hash);
        }
    }
}
