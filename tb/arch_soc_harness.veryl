// arch_soc_harness: one new-core hart on heliodor_soc_smp with the MAP_ARCH
// table, a 4 MiB DRAM in an AXI4 slave model (axi4_mem, timing AXI_CFG /
// AXI_SEED) behind the SoC's AXI4 port, retire_mon and rvfi_tracer. The
// new-core arm of test_arch_common_harness. chk_io_mon's flags and the AXI
// protocol flags fail the run. PASS_BY_X3 passes on x3 := 0xAA instead of tohost;
// EXT_IRQ_SRC is pulsed into the PLIC sources in cycles 8-14.
module arch_soc_harness #(
    param HEX_FILE   : string           = ""                  ,
    param TOHOST_IDX : u32              = 1024                ,
    param MTIME_SRC  : u32              = soc_pkg::MTIME_CYCLE,
    param MTIME_DIV  : u32              = 10                  ,
    param CORE       : soc_pkg::CoreSel = soc_pkg::CoreSel::W2,
    param CK_EN      : bit              = 1'b0                ,
    param CK_FILE    : string           = ""                  ,
    param TRACE_EN   : bit              = 1'b0                ,
    param PASS_BY_X3 : bit              = 1'b0                ,
    param EXT_IRQ_SRC: bit<32>          = 32'd0               ,
    param AXI_CFG    : axi4_tb_pkg::SlaveCfg = axi4_tb_pkg::FIXED,
    param AXI_SEED   : bit<32>          = 32'h1               ,
) (
    clk     : input  clock    ,
    rst     : input  reset    ,
    o_pass  : output logic    ,
    o_fail  : output logic    ,
    o_tohost: output logic<32>,
) {
    const RL       : u32       = soc_pkg::RET_LANES;
    const TOHOST_PA: bit  <64> = 64'h8000_0000 + (TOHOST_IDX as 64) * 4;

    var axi_arvalid  : logic                             ;
    var axi_arready  : logic                             ;
    var axi_arid     : logic<1>                          ;
    var axi_araddr   : logic<56>                         ;
    var axi_arlen    : logic<8>                          ;
    var axi_arsize   : logic<3>                          ;
    var axi_arburst  : logic<2>                          ;
    var axi_rvalid   : logic                             ;
    var axi_rready   : logic                             ;
    var axi_rid      : logic<1>                          ;
    var axi_rdata    : logic<64>                         ;
    var axi_rresp    : logic<2>                          ;
    var axi_rlast    : logic                             ;
    var axi_awvalid  : logic                             ;
    var axi_awready  : logic                             ;
    var axi_awid     : logic<1>                          ;
    var axi_awaddr   : logic<56>                         ;
    var axi_awlen    : logic<8>                          ;
    var axi_awsize   : logic<3>                          ;
    var axi_awburst  : logic<2>                          ;
    var axi_wvalid   : logic                             ;
    var axi_wready   : logic                             ;
    var axi_wdata    : logic<64>                         ;
    var axi_wstrb    : logic<8>                          ;
    var axi_wlast    : logic                             ;
    var axi_bvalid   : logic                             ;
    var axi_bready   : logic                             ;
    var axi_bid      : logic<1>                          ;
    var axi_bresp    : logic<2>                          ;
    var axi_chk      : logic<axi4_tb_pkg::CHK_N>         ;
    var retire       : retire_pkg::RetireRec         [RL];
    var irq_evt      : retire_pkg::IrqEvent          [1] ;
    var core_chk     : logic<soc_pkg::CHK_W>         [1] ;
    var core_perf    : logic<soc_pkg::PERF_W>        [1] ;
    var uart_tx_v    : logic                             ;
    var uart_tx_d    : logic<8>                          ;
    var io_obs       : soc_pkg::IoObs                [2] ;
    var tc           : logic<4>                          ;

    always_ff {
        if_reset {
            tc = 4'd0;
        } else if tc != 4'hf {
            tc = tc + 4'd1;
        }
    }
    let ext_irq: logic<32> = if tc >= 4'd8 && tc <: 4'hf ? EXT_IRQ_SRC : 32'd0;

    inst dut: heliodor_soc_smp #(
        N_HARTS    : 1                          ,
        RESET_PC   : 64'h8000_0000              ,
        CORE       : CORE                       ,
        MTIME_SRC  : MTIME_SRC                  ,
        MTIME_DIV  : MTIME_DIV                  ,
        UART_WRCNT : 1'b1                       ,
        PMA_N      : tb_platform_pkg::MAP_ARCH_N,
        PMA_REGIONS: tb_platform_pkg::MAP_ARCH  ,
    ) (
        clk                            ,
        rst                            ,
        o_imem_addr    : _             ,
        i_imem_rdata   : '{32'd0}      ,
        o_imem_ren     : _             ,
        o_iptw_addr    : _             ,
        o_iptw_req     : _             ,
        i_iptw_rdata   : '{64'd0}      ,
        o_dmem_addr    : _             ,
        o_dmem_wdata   : _             ,
        o_dmem_wen     : _             ,
        o_dmem_ren     : _             ,
        o_dmem_wstrb   : _             ,
        o_dmem_wdata_hi: _             ,
        o_dmem_wstrb_hi: _             ,
        o_axi_arvalid  : axi_arvalid   ,
        i_axi_arready  : axi_arready   ,
        o_axi_arid     : axi_arid      ,
        o_axi_araddr   : axi_araddr    ,
        o_axi_arlen    : axi_arlen     ,
        o_axi_arsize   : axi_arsize    ,
        o_axi_arburst  : axi_arburst   ,
        i_axi_rvalid   : axi_rvalid    ,
        o_axi_rready   : axi_rready    ,
        i_axi_rid      : axi_rid       ,
        i_axi_rdata    : axi_rdata     ,
        i_axi_rresp    : axi_rresp     ,
        i_axi_rlast    : axi_rlast     ,
        o_axi_awvalid  : axi_awvalid   ,
        i_axi_awready  : axi_awready   ,
        o_axi_awid     : axi_awid      ,
        o_axi_awaddr   : axi_awaddr    ,
        o_axi_awlen    : axi_awlen     ,
        o_axi_awsize   : axi_awsize    ,
        o_axi_awburst  : axi_awburst   ,
        o_axi_wvalid   : axi_wvalid    ,
        i_axi_wready   : axi_wready    ,
        o_axi_wdata    : axi_wdata     ,
        o_axi_wstrb    : axi_wstrb     ,
        o_axi_wlast    : axi_wlast     ,
        i_axi_bvalid   : axi_bvalid    ,
        o_axi_bready   : axi_bready    ,
        i_axi_bid      : axi_bid       ,
        i_axi_bresp    : axi_bresp     ,
        o_uart_tx_valid: uart_tx_v     ,
        o_uart_tx_data : uart_tx_d     ,
        o_retire       : retire        ,
        o_irq_evt      : irq_evt       ,
        o_core_chk     : core_chk      ,
        o_core_perf    : core_perf     ,
        i_ext_irq_src  : ext_irq       ,
        o_io_obs       : io_obs        ,
    );

    inst u_mem: axi4_mem #(
        ID_W  : 1        ,
        MEM_DW: 524288   ,
        HEX   : HEX_FILE ,
        CFG   : AXI_CFG  ,
        SEED  : AXI_SEED ,
        MAX_RD: 2        ,
        MAX_WR: 2        ,
    ) (
        clk                    ,
        rst                    ,
        i_arvalid: axi_arvalid ,
        o_arready: axi_arready ,
        i_arid   : axi_arid    ,
        i_araddr : axi_araddr  ,
        i_arlen  : axi_arlen   ,
        i_arsize : axi_arsize  ,
        i_arburst: axi_arburst ,
        o_rvalid : axi_rvalid  ,
        i_rready : axi_rready  ,
        o_rid    : axi_rid     ,
        o_rdata  : axi_rdata   ,
        o_rresp  : axi_rresp   ,
        o_rlast  : axi_rlast   ,
        i_awvalid: axi_awvalid ,
        o_awready: axi_awready ,
        i_awid   : axi_awid    ,
        i_awaddr : axi_awaddr  ,
        i_awlen  : axi_awlen   ,
        i_awsize : axi_awsize  ,
        i_awburst: axi_awburst ,
        i_wvalid : axi_wvalid  ,
        o_wready : axi_wready  ,
        i_wdata  : axi_wdata   ,
        i_wstrb  : axi_wstrb   ,
        i_wlast  : axi_wlast   ,
        o_bvalid : axi_bvalid  ,
        i_bready : axi_bready  ,
        o_bid    : axi_bid     ,
        o_bresp  : axi_bresp   ,
        o_chk    : axi_chk     ,
    );
    let axi_bad: logic = axi_chk != '0;

    always_ff {
        if_reset {} else if uart_tx_v {
            $write("%c", uart_tx_d);
        }
    }

    var stop    : logic     [RL];
    var mismatch: logic         ;
    var done    : logic         ;
    var cycles  : logic<64>     ;
    var instret : logic<64>     ;
    var count   : logic<64>     ;
    var hash    : logic<64>     ;
    var io_chk  : logic<4>      ;
    var io_rd_n : logic<32>     ;
    var io_wr_n : logic<32>     ;
    var stop_any: logic         ;
    always_comb {
        stop_any = 1'b0;
        for l in 0..RL {
            stop_any |= stop[l];
        }
    }
    inst u_trc: rvfi_tracer #(
        LANES   : RL      ,
        CK_EN   : CK_EN   ,
        CK_FILE : CK_FILE ,
        TRACE_EN: TRACE_EN,
    ) (
        clk                         ,
        rst                         ,
        i_retire       : retire     ,
        i_irq_evt      : irq_evt[0] ,
        i_stop         : stop       ,
        i_flush        : 1'b0       ,
        o_count        : count      ,
        o_hash         : hash       ,
        o_final_valid  : _          ,
        o_hash_mismatch: mismatch   ,
        o_ck_stale     : _          ,
    );

    inst u_io: chk_io_mon #(
        LANES      : RL                         ,
        PMA_N      : tb_platform_pkg::MAP_ARCH_N,
        PMA_REGIONS: tb_platform_pkg::MAP_ARCH  ,
    ) (
        clk                 ,
        rst                 ,
        i_obs   : io_obs    ,
        i_retire: retire    ,
        i_end   : stop_any  ,
        o_chk   : io_chk    ,
        o_rd_n  : io_rd_n   ,
        o_wr_n  : io_wr_n   ,
    );

    if CORE == soc_pkg::CoreSel::W4 :g_pa4 {
        inst u_pa: perf_acc::<cfg_w4> #(
            CORE_ID: 4,
        ) (
            clk                  ,
            rst                  ,
            i_perf: core_perf[0] ,
            i_en  : !done        ,
            i_dump: done         ,
        );
    } else {
        inst u_pa: perf_acc::<cfg_w2> #(
            CORE_ID: 2,
        ) (
            clk                  ,
            rst                  ,
            i_perf: core_perf[0] ,
            i_en  : !done        ,
            i_dump: done         ,
        );
    }

    inst u_mon: retire_mon #(
        LANES     : RL                ,
        TOHOST_PA : TOHOST_PA         ,
        PASS_BY_X3: PASS_BY_X3        ,
        CHK_W     : 5 + soc_pkg::CHK_W,
    ) (
        clk                          ,
        rst                          ,
        i_retire       : retire      ,
        i_irq_evt      : irq_evt[0]  ,
        i_chk          : {axi_bad, io_chk, core_chk[0]},
        i_hash_mismatch: mismatch    ,
        o_stop         : stop        ,
        o_x3           : _           ,
        o_tohost       : o_tohost    ,
        o_pass         : o_pass      ,
        o_fail         : o_fail      ,
        o_done         : done        ,
        o_cycles       : cycles      ,
        o_instret      : instret     ,
        o_last_pc      : _           ,
        o_ret_cnt      : _           ,
        o_trap_cnt     : _           ,
        o_chk          : _           ,
    );

    var reported: logic;
    always_ff {
        if_reset {
            reported = 1'b0;
        } else if done && !reported {
            reported = 1'b1;
            $display("arch: tohost=%h cycles=%d instret=%d chk=%h io=%b/%d/%d mismatch=%b records=%d hash=%h", o_tohost,
                cycles, instret, core_chk[0], io_chk, io_rd_n, io_wr_n, mismatch, count, hash);
        }
    }
}
