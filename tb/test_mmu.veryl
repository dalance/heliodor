// Sv39 MMU unit test: page table walk through dmem_mmu
module test_mmu_harness (
    clk   : input  clock    ,
    rst   : input  reset    ,
    o_pass: output logic    ,
    o_r1  : output logic<64>,
    o_r2  : output logic<64>,
    o_r3  : output logic<64>,
) {
    import csr_pkg::*;

    // DUT signals
    var vaddr     : logic    <64>;
    var wdata     : logic    <64>;
    var wen       : logic        ;
    var ren       : logic        ;
    var wstrb     : logic    <8> ;
    var rdata     : logic    <64>;
    var dmem_addr : logic    <64>;
    var dmem_wdata: logic    <64>;
    var dmem_rdata: logic    <64>;
    var dmem_wen  : logic        ;
    var dmem_ren  : logic        ;
    var dmem_wstrb: logic    <8> ;
    var satp_val  : logic    <64>;
    var priv_val  : PrivLevel    ;
    var busy      : logic        ;
    var fault     : logic        ;
    var fault_st  : logic        ;

    inst dut: dmem_mmu (
        clk                      ,
        rst                      ,
        i_vaddr      : vaddr     ,
        i_wdata      : wdata     ,
        i_wen        : wen       ,
        i_ren        : ren       ,
        i_wstrb      : wstrb     ,
        o_rdata      : rdata     ,
        o_dmem_addr  : dmem_addr ,
        o_dmem_wdata : dmem_wdata,
        i_dmem_rdata : dmem_rdata,
        o_dmem_wen   : dmem_wen  ,
        o_dmem_ren   : dmem_ren  ,
        o_dmem_wstrb : dmem_wstrb,
        i_satp       : satp_val  ,
        i_priv       : priv_val  ,
        i_sum        : 1'b1      ,
        i_mxr        : 1'b0      ,
        i_pbmte      : 1'b0      ,
        o_uncached   : _         ,
        o_busy       : busy      ,
        o_fault      : fault     ,
        o_fault_store: fault_st  ,
    );

    // Simple memory (256 doublewords = 2KB)
    var mem: logic<64> [256];

    // Comb read
    assign dmem_rdata = mem[dmem_addr[10:3]];

    // Test state machine
    var tc           : logic<8> ;
    var stored_rdata : logic<64>;
    var bare_rdata   : logic<64>;
    var sv39_started : logic    ;
    var sv39_was_busy: logic    ;

    always_ff (clk, rst) {
        if_reset {
            tc            = 8'd0;
            vaddr         = '0;
            wdata         = '0;
            wen           = 1'b0;
            ren           = 1'b0;
            wstrb         = '0;
            satp_val      = '0;
            priv_val      = PrivLevel::MACHINE;
            stored_rdata  = '0;
            bare_rdata    = '0;
            sv39_started  = 1'b0;
            sv39_was_busy = 1'b0;

            // Initialize page table in memory
            // Root page table at physical page 0 (byte address 0x0), satp.PPN=0
            // Level-2 PTE at root[VPN2=0] = root[0] = mem[0]
            //   Leaf gigapage: V=1, R=1, W=1, X=0, U=1, A=1, D=1, PPN=0
            //   PTE = {PPN=0, RSW=0, D=1, A=1, G=0, U=1, X=0, W=1, R=1, V=1}
            //       = 0x00000000_000000DF
            mem[0] = 64'h00000000_000000DF;

            // Data at physical address 0x100 (word index 32): pre-loaded value
            mem[32] = 64'hDEAD_BEEF_CAFE_BABE;

        } else {
            // Default: no memory access
            wen = 1'b0;
            ren = 1'b0;

            if !busy {
                tc = tc + 8'd1;
            }

            case tc {
                // Phase 1: Bare mode test (M-mode, satp=0)
                8'd1: {
                    vaddr = 64'h0000_0000_0000_0100;
                    ren   = 1'b1;
                }
                8'd2: {
                    bare_rdata = rdata;
                }

                // Phase 2: Enable Sv39 (S-mode, satp with MODE=8)
                8'd4: {
                    satp_val = {4'd8, 16'd0, 44'd0};
                    priv_val = PrivLevel::SUPERVISOR;
                }

                // Phase 3: Read same address in Sv39 mode
                8'd6: {
                    vaddr        = 64'h0000_0000_0000_0100;
                    ren          = 1'b1;
                    sv39_started = 1'b1;
                }

                default: {}
            }

            // Capture rdata when PTW completes (busy falls from 1→0)
            if sv39_started && sv39_was_busy && !busy {
                stored_rdata = rdata;
            }
            sv39_was_busy = busy;

            // Memory write
            if dmem_wen {
                mem[dmem_addr[10:3]] = dmem_wdata;
            }
        }
    }

    assign o_r1   = bare_rdata;
    assign o_r2   = stored_rdata;
    assign o_r3   = 64'd0;
    assign o_pass = bare_rdata == 64'hDEAD_BEEF_CAFE_BABE && stored_rdata == 64'hDEAD_BEEF_CAFE_BABE;
}

#[test(test_mmu)]
module test_mmu {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass: logic    ;
    var r1  : logic<64>;
    var r2  : logic<64>;
    var r3  : logic<64>;

    inst harness: test_mmu_harness ( clk: clk, rst: rst, o_pass: pass, o_r1: r1, o_r2: r2, o_r3: r3 );

    initial {
        rst.assert(clk);
        for _i in 0..50 {
            clk.next(1);
        }
        $display(r1, r2, r3, pass);
        $assert (pass, "MMU test failed");
        $display("MMU Sv39 page table walk test passed");
        $finish ();
    }
}

// P9.5: TLB ASID isolation unit test.
//
// Maps the SAME VA (0x40000000, a 4KB page) to DIFFERENT physical pages under
// two ASIDs, with NO SFENCE.VMA between the address-space switches — the exact
// pattern ASID-enabled Linux uses on a context switch. The walk for ASID 1
// caches a non-global TLB entry (VA→PA_A); the read under ASID 2 must NOT use
// that stale entry — it must miss and re-walk to PA_B. A correct ASID-tagged
// TLB returns marker_B; a TLB that ignores ASID would return the stale
// marker_A. Also checks a GLOBAL (G=1) mapping is shared across both ASIDs.
module test_mmu_asid_harness (
    clk     : input  clock    ,
    rst     : input  reset    ,
    o_pass  : output logic    ,
    o_a1    : output logic<64>,
    o_a2    : output logic<64>,
    o_g2    : output logic<64>,
    o_ss    : output logic<64>, // selective-flush: survivor read (marker_A)
    o_sf    : output logic<64>, // selective-flush: flushed read (marker_B)
) {
    import csr_pkg::*;

    var vaddr     : logic<64>;
    var ren       : logic    ;
    var rdata     : logic<64>;
    var dmem_addr : logic<64>;
    var dmem_rdata: logic<64>;
    var satp_val  : logic<64>;
    var priv_val  : PrivLevel ;
    var busy      : logic    ;
    var sf        : logic    ; // SFENCE.VMA pulse
    var sf_vaddr  : logic<64>;
    var sf_asid   : logic<16>;
    var sf_rs1z   : logic    ;
    var sf_rs2z   : logic    ;

    inst dut: dmem_mmu (
        clk                      ,
        rst                      ,
        i_vaddr      : vaddr     ,
        i_wdata      : 64'd0     ,
        i_wen        : 1'b0      ,
        i_ren        : ren       ,
        i_wstrb      : 8'd0      ,
        o_rdata      : rdata     ,
        o_dmem_addr  : dmem_addr ,
        o_dmem_wdata : _         ,
        i_dmem_rdata : dmem_rdata,
        o_dmem_wen   : _         ,
        o_dmem_ren   : _         ,
        o_dmem_wstrb : _         ,
        i_satp       : satp_val  ,
        i_priv       : priv_val  ,
        i_sum        : 1'b1      ,
        i_mxr        : 1'b0      ,
        i_pbmte      : 1'b0      ,
        o_uncached   : _         ,
        i_sfence         : sf      ,
        i_sfence_vaddr   : sf_vaddr,
        i_sfence_asid    : sf_asid ,
        i_sfence_rs1_zero: sf_rs1z ,
        i_sfence_rs2_zero: sf_rs2z ,
        o_busy       : busy      ,
        o_fault      : _         ,
        o_fault_store: _         ,
    );

    // 32 KB behavioural memory (8 pages), combinational read.
    var mem: logic<64> [4096];
    assign dmem_rdata = mem[dmem_addr[14:3]];

    var tc      : logic<8> ;
    var phase   : logic<2> ; // which read is in flight (1=asid1,2=asid2,3=global)
    var was_busy: logic    ;
    var a1_rd   : logic<64>; // ASID-1 read of VA 0x40000000 (expect marker_A)
    var a2_rd   : logic<64>; // ASID-2 read of VA 0x40000000 (expect marker_B)
    var g2_rd   : logic<64>; // ASID-2 read of the GLOBAL VA (expect marker_G)
    // Selective SFENCE.VMA: after a non-matching ASID fence the ASID-1 entry
    // SURVIVES (HIT → its cached PA 0x3000 = marker_A); after the matching ASID
    // fence it is FLUSHED (re-walk → the remapped PTE PA 0x4000 = marker_B).
    var sf_surv : logic<64>;
    var sf_flsh : logic<64>;

    always_ff (clk, rst) {
        if_reset {
            tc       = 8'd0;
            vaddr    = '0;
            ren      = 1'b0;
            satp_val = '0;
            priv_val = PrivLevel::MACHINE;
            phase    = 2'd0;
            was_busy = 1'b0;
            a1_rd    = '0;
            a2_rd    = '0;
            g2_rd    = '0;
            sf       = 1'b0;
            sf_vaddr = '0;
            sf_asid  = '0;
            sf_rs1z  = 1'b0;
            sf_rs2z  = 1'b0;
            sf_surv  = '0;
            sf_flsh  = '0;
            for i in 0..4096 {
                mem[i] = 64'd0;
            }
            // Page table (satp.PPN = 0, root PT at PA 0):
            //   root[1] (VA 0x4000_0000, VPN2=1) → non-leaf L1 @ PA 0x1000
            mem[1]    = 64'h401; // PPN=1, V
            //   L1[0] → non-leaf L0 @ PA 0x2000
            mem[512]  = 64'h801; // PPN=2, V
            //   L0[0] → leaf 4KB page @ PA 0x3000, flags V|R|W|A|D (G=0)
            mem[1024] = 64'hCC7; // PPN=3, 0xC7
            //   root[2] (VA 0x8000_0000, VPN2=2) → GLOBAL leaf gigapage @ PA
            //   0x8000_0000, flags V|R|W|A|D|G (G=1). PPN must be 1GB-aligned.
            mem[2]    = 64'h2000_00E7; // PPN=0x80000, 0xE7 (G set)
            // Data pages:
            mem[1536] = 64'hAAAA_AAAA_AAAA_AAAA; // PA 0x3000 = marker_A
            mem[2048] = 64'hBBBB_BBBB_BBBB_BBBB; // PA 0x4000 = marker_B
            // GLOBAL gigapage maps VA 0x8000_0000 → PA 0x8000_0000; the dword
            // there is mem[(0x8000_0000>>3) & 0xFFF]... but that aliases low
            // memory. Place marker_G where the gigapage read lands: PA
            // 0x8000_0000 → mem[dmem_addr[14:3]] = mem[0]. Avoid clobbering the
            // root PT (mem[0..2]); instead read the global page at VA
            // 0x8000_3000 → PA 0x8000_3000 → mem[1536]? collides. Use VA
            // 0x8000_5000 → PA 0x8000_5000 → mem[(0x5000>>3)=2560].
            mem[2560] = 64'h6767_6767_6767_6767; // marker_G @ PA 0x8000_5000
        } else {
            ren = 1'b0;
            sf  = 1'b0;
            if !busy {
                tc = tc + 8'd1;
            }
            case tc {
                // ASID 1: read VA 0x4000_0000 → walks to PA 0x3000 = marker_A.
                8'd2: {
                    satp_val = {4'd8, 16'd1, 44'd0};
                    priv_val = PrivLevel::SUPERVISOR;
                }
                8'd4: {
                    vaddr = 64'h0000_0000_4000_0000;
                    ren   = 1'b1;
                    phase = 2'd1;
                }
                // Remap L0[0] → PA 0x4000 and switch to ASID 2 (NO sfence).
                8'd6: {
                    mem[1024] = 64'h10C7; // PPN=4, 0xC7
                    satp_val  = {4'd8, 16'd2, 44'd0};
                }
                // ASID 2: read VA 0x4000_0000 → must MISS the ASID-1 entry and
                // re-walk to PA 0x4000 = marker_B (isolation).
                8'd8: {
                    vaddr = 64'h0000_0000_4000_0000;
                    ren   = 1'b1;
                    phase = 2'd2;
                }
                // ASID 2: read the GLOBAL VA 0x8000_5000 → must HIT/translate
                // via the G=1 gigapage = marker_G (global shared across ASIDs).
                8'd10: {
                    vaddr = 64'h0000_0000_8000_5000;
                    ren   = 1'b1;
                    phase = 2'd3;
                }
                // The g2 walk has settled by now; capture it here (robust to the
                // busy-fall timing) before switching ASID. Then back to ASID 1
                // and stop the busy-fall capture (phase 0).
                8'd11: {
                    g2_rd    = rdata;
                    satp_val = {4'd8, 16'd1, 44'd0};
                    phase    = 2'd0;
                }
                // SFENCE.VMA(x0, asid=2): flush ASID 2 only — the ASID-1 entry
                // (VA 0x4000_0000 → cached PA 0x3000) must SURVIVE.
                8'd12: {
                    sf      = 1'b1;
                    sf_rs1z = 1'b1; // rs1 == x0 (all addresses)
                    sf_rs2z = 1'b0; // rs2 != x0 (ASID-qualified)
                    sf_asid = 16'd2;
                }
                // Read VA under ASID 1 → HIT the survivor → PA 0x3000 = marker_A.
                8'd14: {
                    vaddr = 64'h0000_0000_4000_0000;
                    ren   = 1'b1;
                }
                8'd15: {
                    sf_surv = rdata;
                }
                // SFENCE.VMA(x0, asid=1): now flush ASID 1 → the entry is gone.
                8'd16: {
                    sf      = 1'b1;
                    sf_rs1z = 1'b1;
                    sf_rs2z = 1'b0;
                    sf_asid = 16'd1;
                }
                // Read VA under ASID 1 → MISS → re-walk the remapped PTE →
                // PA 0x4000 = marker_B.
                8'd18: {
                    vaddr = 64'h0000_0000_4000_0000;
                    ren   = 1'b1;
                }
                8'd19: {
                    sf_flsh = rdata;
                }
                default: {}
            }
            // Capture each walking read's result when its walk settles (a1/a2/g2
            // are cold/isolation misses → walks). The selective-flush reads
            // (sf_surv hit / sf_flsh walk) are captured at tc+1 above, where
            // o_rdata holds the settled result for both hit and walk.
            if was_busy && !busy {
                if phase == 2'd1 {
                    a1_rd = rdata;
                }
                if phase == 2'd2 {
                    a2_rd = rdata;
                }
                if phase == 2'd3 {
                    g2_rd = rdata;
                }
            }
            was_busy = busy;
        }
    }

    assign o_a1   = a1_rd;
    assign o_a2   = a2_rd;
    assign o_g2   = g2_rd;
    assign o_ss   = sf_surv;
    assign o_sf   = sf_flsh;
    assign o_pass = a1_rd == 64'hAAAA_AAAA_AAAA_AAAA
        && a2_rd == 64'hBBBB_BBBB_BBBB_BBBB
        && g2_rd == 64'h6767_6767_6767_6767
        && sf_surv == 64'hAAAA_AAAA_AAAA_AAAA  // ASID-2 fence left ASID-1 alone
        && sf_flsh == 64'hBBBB_BBBB_BBBB_BBBB; // ASID-1 fence flushed it
}

#[test(test_mmu_asid)]
module test_mmu_asid {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass: logic    ;
    var a1  : logic<64>;
    var a2  : logic<64>;
    var g2  : logic<64>;
    var ss  : logic<64>;
    var sf  : logic<64>;

    inst harness: test_mmu_asid_harness (
        clk           ,
        rst           ,
        o_pass: pass  ,
        o_a1  : a1    ,
        o_a2  : a2    ,
        o_g2  : g2    ,
        o_ss  : ss    ,
        o_sf  : sf    ,
    );

    initial {
        rst.assert(clk);
        for _i in 0..140 {
            clk.next(1);
        }
        $display("mmu_asid: a1=%h a2=%h g2=%h surv=%h flsh=%h pass=%b", a1, a2, g2, ss, sf, pass);
        $assert(pass, "TLB ASID isolation / selective-flush test failed");
        $display("TLB ASID isolation + selective SFENCE.VMA test passed");
        $finish();
    }
}
