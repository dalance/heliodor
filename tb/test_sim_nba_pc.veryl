// Minimal repro for the v4 AUIPC base.pc+4 bug.
//
// Pattern: a single always_ff updates pc_q and (in the same block) latches
// pc_q into saved_pc_q. SystemVerilog NBA semantics dictate that
// saved_pc_q sees the OLD pc_q (= clock-edge value), so after N cycles:
//   pc_q       = 4 * N
//   saved_pc_q = 4 * (N - 1)
// i.e. saved_pc_q + 4 == pc_q.
//
// If Veryl JIT sim violates NBA and `saved_pc_q = pc_q` reads the
// NEW (post-advance) pc_q, then saved_pc_q == pc_q and the check fails.
// This is the suspected root cause of heliodor v4's AUIPC base.pc +4
// observation (cosim_v4_firmware: stvec=0x68c instead of 0x688).
module test_sim_nba_pc_harness (
    clk             : input  clock     ,
    rst             : input  reset     ,
    o_pc            : output logic<32> ,
    o_saved_pc      : output logic<32> ,
    o_nba_correct   : output logic     ,
) {
    var pc_q       : logic<32>;
    var saved_pc_q : logic<32>;
    always_ff (clk, rst) {
        if_reset {
            pc_q       = 32'd0;
            saved_pc_q = 32'd0;
        } else {
            saved_pc_q = pc_q;          // NBA: should latch OLD pc_q
            pc_q       = pc_q + 32'd4;  // NBA: pc_q advances at end of cycle
        }
    }
    assign o_pc            = pc_q;
    assign o_saved_pc      = saved_pc_q;
    // After cycle N (N >= 1): pc_q = 4N, saved_pc_q = 4(N-1) → diff = 4
    assign o_nba_correct   = (saved_pc_q + 32'd4) == pc_q;
}

#[test(test_sim_nba_pc)]
#[ignore]
module test_sim_nba_pc {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen(clk);
    var pc       : logic<32>;
    var saved_pc : logic<32>;
    var ok       : logic    ;
    inst h: test_sim_nba_pc_harness (
        clk                       ,
        rst                       ,
        o_pc          : pc        ,
        o_saved_pc    : saved_pc  ,
        o_nba_correct : ok        ,
    );
    initial {
        rst.assert(clk);
        clk.next(10);
        $display("[test_sim_nba_pc] cy=10 pc=%h saved=%h nba_correct=%b (expected: pc=0x28 saved=0x24 ok=1)",
                  pc, saved_pc, ok);
        $assert(ok, "Veryl JIT NBA violation: saved_pc reads NEW pc_q (post-advance)");
        $finish();
    }
}
