// SMP coherence directed tests of the new core (test/coh/coh.S): CoRR with a
// late-address first load, LR/SC reservation under contention, AMO watch,
// store-drain starvation bounds, the full-line write-through drain and PLIC
// claim contention. tohost is written by hart 0 (1 = pass) or by any hart
// (failure code, see coh.S). Source 1 and 2 of the PLIC are pulsed by the
// harness for the claim test.

#[test(test_w2_smp_coh_2hart)]
module test_w2_smp_coh_2hart {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass  : logic    ;
    var fail  : logic    ;
    var cycles: logic<64>;

    inst h: boot_soc_harness #(
        N_HARTS    : 2                          ,
        DRAM_HEX   : "test/coh/coh_n2.hex"      ,
        ROM_EN     : 1'b0                         ,
        PMA_N      : tb_platform_pkg::MAP_ARCH_N  ,
        PMA_REGIONS: tb_platform_pkg::MAP_ARCH    ,
        RESET_PC   : 64'h8000_0000                ,
        PASS_BY_X3 : 1'b0                         ,
        TOHOST_PA  : 64'h8000_3000                ,
        CORE       : tb_core_sel::CORE_W2         ,
        EXT_IRQ_SRC: 32'h0000_0006                ,
    ) (
        clk                ,
        rst                ,
        o_pass   : pass    ,
        o_fail   : fail    ,
        o_x3     : _       ,
        o_cycles : cycles  ,
        o_instret: _       ,
        o_last_pc: _       ,
        o_ret_cnt: _       ,
        o_traps  : _       ,
    );

    initial {
        rst.assert(clk);
        for _i in 0..300 {
            clk.next(10000);
            if pass || fail {
                break;
            }
        }
        clk.next(10);
        $display("test_w2_smp_coh_2hart: cycles=%d pass=%b fail=%b", cycles, pass, fail);
        $assert (pass, "test_w2_smp_coh_2hart: coherence check failed, trap, checker or timeout");
        $finish ();
    }
}

