// Performance measurement harness for heliodor.
//
// Like test_arch_common_harness but adds per-category stall/flush cycle
// counters using the o_dbg_stall bus.  After the program signals
// completion (tohost == 1), the testbench can read:
//   o_cycle_cnt     — total simulation cycles (after reset)
//   o_cnt_*         — per-category stall/flush counts
//
// Usage: instantiate with HEX_FILE pointing to the benchmark hex.

module test_perf_harness #(
    param HEX_FILE  : string = ""  ,
    param TOHOST_IDX: u32    = 1024,
) (
    clk     : input  clock    ,
    rst     : input  reset    ,
    o_pass  : output logic    ,
    o_tohost: output logic<32>,
    // Performance counters
    o_cycle_cnt    : output logic<64>,
    o_cnt_icache   : output logic<64>,
    o_cnt_immu     : output logic<64>,
    o_cnt_stall_if : output logic<64>,
    o_cnt_stall_id : output logic<64>,
    o_cnt_stall_ex : output logic<64>,
    o_cnt_stall_mem: output logic<64>,
    o_cnt_flush_id : output logic<64>,
    o_cnt_flush_ex : output logic<64>,
    o_cnt_instret  : output logic<64>,
    // Per-cause breakdown for stall_id (a subset of o_cnt_stall_id)
    o_cnt_cause_load_use: output logic<64>,
    o_cnt_cause_mmu     : output logic<64>,
    o_cnt_cause_cache   : output logic<64>,
    o_cnt_cause_rs      : output logic<64>,
    o_cnt_cause_rob_full: output logic<64>,
    o_cnt_cause_rs_full_int : output logic<64>,
    o_cnt_cause_rs_full_fp  : output logic<64>,
    o_cnt_cause_direct_stall: output logic<64>,
    o_cnt_cause_irq_wait    : output logic<64>,
    o_cnt_ds_operand : output logic<64>,
    o_cnt_ds_op_load : output logic<64>,
    o_cnt_ds_op_store: output logic<64>,
    o_cnt_ds_op_bj   : output logic<64>,
    o_cnt_ds_rs_yield: output logic<64>,
    o_cnt_ds_rob_full: output logic<64>,
    o_cnt_ds_drain   : output logic<64>,
    o_cnt_mispred_branch: output logic<64>,
    o_cnt_mispred_jalr  : output logic<64>,
    o_cnt_mispred_jal   : output logic<64>,
    o_cnt_flush_trap    : output logic<64>,
    o_cnt_mispred_jalr_return  : output logic<64>,
    o_cnt_mispred_jalr_indirect: output logic<64>,
    o_cnt_if_return            : output logic<64>,
    o_cnt_ras_used             : output logic<64>,
    o_cnt_ras_push             : output logic<64>,
    o_cnt_ras_pop              : output logic<64>,
    o_cnt_lq_issue             : output logic<32>,
    o_cnt_lq_alloc             : output logic<32>,
    o_cnt_lq_mshr              : output logic<32>,
    o_cnt_srs_disp             : output logic<32>,
    o_cnt_srs_issue            : output logic<32>,
    o_cnt_srs_drop             : output logic<32>,
    o_cnt_sb_fwd_hit           : output logic<32>,
    o_cnt_sb_fwd_partial       : output logic<32>,
    o_cnt_sb_fwd_mismatch      : output logic<32>,
    o_cnt_srs_load_drain_unresolved: output logic<32>,
    o_cnt_p34_spec_violation       : output logic<32>,
    o_cnt_dual_fetch               : output logic<32>,
    o_cnt_dual_issue               : output logic<32>,
) {
    var imem_addr      : logic<64>     ;
    var imem_rdata     : logic<32>     ;
    var imem_ren       : logic         ;
    var dmem_addr      : logic<64>     ;
    var dmem_wdata     : logic<64>     ;
    var dmem_rdata     : logic<64>     ;
    var dmem_wen       : logic         ;
    var dmem_ren       : logic         ;
    var dmem_wstrb     : logic<8>      ;
    var dbg_regs       : logic<64> [32];
    var dbg_pc         : logic<64>     ;
    var dbg_pass       : logic         ;
    var dbg_r1         : logic<64>     ;
    var dbg_r2         : logic<64>     ;
    var dbg_r3         : logic<64>     ;
    var iptw_addr      : logic<64>     ;
    var iptw_req       : logic         ;
    var iptw_rdata     : logic<64>     ;
    var dbg_stall      : logic<8>      ;
    var dbg_instret    : logic         ;
    var _dbg_bp_predict: logic         ;
    var _dbg_bp_mispred: logic         ;
    var _dbg_bp_taken  : logic         ;
    var _dbg_bp_ex_pc  : logic<64>     ;
    var _dbg_bp_target : logic<64>     ;
    var _dbg_trap_taken: logic         ;
    var _dbg_trap_cause: logic<64>     ;
    var _dbg_trap_pc   : logic<64>     ;
    var _lq_issue_cnt  : logic<32>     ;
    var _lq_alloc_cnt  : logic<32>     ;
    var _lq_mshr_cnt   : logic<32>     ;
    var _srs_disp_cnt  : logic<32>     ;
    var _srs_issue_cnt : logic<32>     ;
    var _srs_drop_cnt  : logic<32>     ;
    var _sb_fwd_hit_cnt     : logic<32>;
    var _sb_fwd_partial_cnt : logic<32>;
    var _sb_fwd_mismatch_cnt: logic<32>;
    var _srs_load_drain_unresolved_cnt: logic<32>;
    var _p34_spec_violation_cnt       : logic<32>;
    var _dual_fetch_cnt               : logic<32>;
    var _dual_issue_cnt               : logic<32>;
    var stall_load_use : logic         ;
    var stall_mmu      : logic         ;
    var stall_cache    : logic         ;
    var stall_rs       : logic         ;
    var stall_rob_full : logic         ;
    var stall_rs_full_int : logic      ;
    var stall_rs_full_fp  : logic      ;
    var stall_direct_stall: logic      ;
    var stall_irq_wait    : logic      ;
    var ds_operand : logic            ;
    var ds_op_load : logic            ;
    var ds_op_store: logic            ;
    var ds_op_bj   : logic            ;
    var ds_rs_yield: logic            ;
    var ds_rob_full: logic            ;
    var ds_drain   : logic            ;
    var mispred_branch: logic         ;
    var mispred_jalr  : logic         ;
    var mispred_jal   : logic         ;
    var flush_trap    : logic         ;
    var mispred_jalr_return  : logic  ;
    var mispred_jalr_indirect: logic  ;
    var if_return_seen       : logic  ;
    var ras_used_seen        : logic  ;
    var ras_push_seen        : logic  ;
    var ras_pop_seen         : logic  ;

    inst dut: heliodor_top #(
        RESET_PC: 64'h80000000,
    ) (
        clk                              ,
        rst                              ,
        o_imem_addr     : imem_addr      ,
        i_imem_rdata    : imem_rdata     ,
        o_imem_ren      : imem_ren       ,
        o_iptw_addr     : iptw_addr      ,
        o_iptw_req      : iptw_req       ,
        i_iptw_rdata    : iptw_rdata     ,
        i_uart_rx_data  : 8'd0           ,
        i_uart_rx_valid : 1'b0           ,
        o_dmem_addr     : dmem_addr      ,
        o_dmem_wdata    : dmem_wdata     ,
        i_dmem_rdata    : dmem_rdata     ,
        o_dmem_wen      : dmem_wen       ,
        o_dmem_ren      : dmem_ren       ,
        o_dmem_wstrb    : dmem_wstrb     ,
        o_dbg_regs      : dbg_regs       ,
        o_dbg_pc        : dbg_pc         ,
        o_dbg_pass      : dbg_pass       ,
        o_dbg_r1        : dbg_r1         ,
        o_dbg_r2        : dbg_r2         ,
        o_dbg_r3        : dbg_r3         ,
        i_ext_irq       : 32'd0          ,
        o_dbg_stall     : dbg_stall      ,
        o_dbg_instret   : dbg_instret    ,
        o_dbg_bp_predict: _dbg_bp_predict,
        o_dbg_bp_mispred: _dbg_bp_mispred,
        o_dbg_bp_taken  : _dbg_bp_taken  ,
        o_dbg_bp_ex_pc  : _dbg_bp_ex_pc  ,
        o_dbg_bp_target : _dbg_bp_target ,
        o_dbg_trap_taken: _dbg_trap_taken,
        o_dbg_trap_cause: _dbg_trap_cause,
        o_dbg_trap_pc   : _dbg_trap_pc   ,
        o_dbg_lq_issue_cnt: _lq_issue_cnt,
        o_dbg_lq_alloc_cnt: _lq_alloc_cnt,
        o_dbg_lq_mshr_cnt : _lq_mshr_cnt ,
        o_dbg_srs_disp_cnt : _srs_disp_cnt ,
        o_dbg_srs_issue_cnt: _srs_issue_cnt,
        o_dbg_srs_drop_cnt : _srs_drop_cnt ,
        o_dbg_sb_fwd_hit_cnt     : _sb_fwd_hit_cnt     ,
        o_dbg_sb_fwd_partial_cnt : _sb_fwd_partial_cnt ,
        o_dbg_sb_fwd_mismatch_cnt: _sb_fwd_mismatch_cnt,
        o_dbg_srs_load_drain_unresolved_cnt: _srs_load_drain_unresolved_cnt,
        o_dbg_p34_spec_violation_cnt       : _p34_spec_violation_cnt       ,
        o_dbg_dual_fetch_cnt               : _dual_fetch_cnt               ,
        o_dbg_dual_issue_cnt               : _dual_issue_cnt               ,
        o_dbg_stall_cause_load_use: stall_load_use,
        o_dbg_stall_cause_mmu     : stall_mmu     ,
        o_dbg_stall_cause_cache   : stall_cache   ,
        o_dbg_stall_cause_rs      : stall_rs      ,
        o_dbg_stall_cause_rob_full: stall_rob_full,
        o_dbg_stall_cause_rs_full_int : stall_rs_full_int ,
        o_dbg_stall_cause_rs_full_fp  : stall_rs_full_fp  ,
        o_dbg_stall_cause_direct_stall: stall_direct_stall,
        o_dbg_stall_cause_irq_wait    : stall_irq_wait    ,
        o_dbg_stall_ds_operand  : ds_operand  ,
        o_dbg_stall_ds_op_load  : ds_op_load  ,
        o_dbg_stall_ds_op_store : ds_op_store ,
        o_dbg_stall_ds_op_bj    : ds_op_bj    ,
        o_dbg_stall_ds_rs_yield : ds_rs_yield ,
        o_dbg_stall_ds_rob_full : ds_rob_full ,
        o_dbg_stall_ds_drain    : ds_drain    ,
        o_dbg_mispred_branch: mispred_branch,
        o_dbg_mispred_jalr  : mispred_jalr  ,
        o_dbg_mispred_jal   : mispred_jal   ,
        o_dbg_flush_trap    : flush_trap    ,
        o_dbg_mispred_jalr_return  : mispred_jalr_return  ,
        o_dbg_mispred_jalr_indirect: mispred_jalr_indirect,
        o_dbg_if_return_count      : if_return_seen       ,
        o_dbg_ras_used             : ras_used_seen        ,
        o_dbg_ras_push             : ras_push_seen        ,
        o_dbg_ras_pop              : ras_pop_seen         ,
    );

    // --- DRAM (256 KB) ---
    var dram: logic<32> [65536];
    initial {
        $readmemh(HEX_FILE, dram);
    }

    let in_dram      : logic     = dmem_addr[31];
    let dram_imem_idx: logic<16> = imem_addr[17:2];
    let dram_dmem_lo : logic<16> = {dmem_addr[17:3], 1'b0};
    let dram_dmem_hi : logic<16> = {dmem_addr[17:3], 1'b1};

    assign imem_rdata = if imem_addr[31] ? dram[dram_imem_idx] : 32'd0;
    assign dmem_rdata = if in_dram ? {dram[dram_dmem_hi], dram[dram_dmem_lo]} : 64'd0;

    let dram_iptw_lo: logic<16> = {iptw_addr[17:3], 1'b0};
    let dram_iptw_hi: logic<16> = {iptw_addr[17:3], 1'b1};
    assign iptw_rdata   = if iptw_addr[31] ? {dram[dram_iptw_hi], dram[dram_iptw_lo]} : 64'd0;

    always_ff (clk, rst) {
        if_reset {} else if dmem_wen && in_dram {
            if dmem_wstrb[0] {
                dram[dram_dmem_lo][7:0] = dmem_wdata[7:0];
            }
            if dmem_wstrb[1] {
                dram[dram_dmem_lo][15:8] = dmem_wdata[15:8];
            }
            if dmem_wstrb[2] {
                dram[dram_dmem_lo][23:16] = dmem_wdata[23:16];
            }
            if dmem_wstrb[3] {
                dram[dram_dmem_lo][31:24] = dmem_wdata[31:24];
            }
            if dmem_wstrb[4] {
                dram[dram_dmem_hi][7:0] = dmem_wdata[39:32];
            }
            if dmem_wstrb[5] {
                dram[dram_dmem_hi][15:8] = dmem_wdata[47:40];
            }
            if dmem_wstrb[6] {
                dram[dram_dmem_hi][23:16] = dmem_wdata[55:48];
            }
            if dmem_wstrb[7] {
                dram[dram_dmem_hi][31:24] = dmem_wdata[63:56];
            }
        }
    }

    // --- Tohost ---
    let tohost_lo: logic<32> = dram[TOHOST_IDX[15:0]];
    assign o_tohost  = tohost_lo;
    assign o_pass    = tohost_lo == 32'd1;

    // --- Performance counters (frozen at tohost != 0) ---
    var frozen       : logic    ;
    var cycle_cnt    : logic<64>;
    var cnt_icache   : logic<64>;
    var cnt_immu     : logic<64>;
    var cnt_stall_if : logic<64>;
    var cnt_stall_id : logic<64>;
    var cnt_stall_ex : logic<64>;
    var cnt_stall_mem: logic<64>;
    var cnt_flush_id : logic<64>;
    var cnt_flush_ex : logic<64>;
    var cnt_instret  : logic<64>;
    var cnt_cause_load_use: logic<64>;
    var cnt_cause_mmu     : logic<64>;
    var cnt_cause_cache   : logic<64>;
    var cnt_cause_rs      : logic<64>;
    var cnt_cause_rob_full: logic<64>;
    var cnt_cause_rs_full_int : logic<64>;
    var cnt_cause_rs_full_fp  : logic<64>;
    var cnt_cause_direct_stall: logic<64>;
    var cnt_cause_irq_wait    : logic<64>;
    var cnt_ds_operand : logic<64>;
    var cnt_ds_op_load : logic<64>;
    var cnt_ds_op_store: logic<64>;
    var cnt_ds_op_bj   : logic<64>;
    var cnt_ds_rs_yield: logic<64>;
    var cnt_ds_rob_full: logic<64>;
    var cnt_ds_drain   : logic<64>;
    var cnt_mispred_branch: logic<64>;
    var cnt_mispred_jalr  : logic<64>;
    var cnt_mispred_jal   : logic<64>;
    var cnt_flush_trap    : logic<64>;
    var cnt_mispred_jalr_return  : logic<64>;
    var cnt_mispred_jalr_indirect: logic<64>;
    var cnt_if_return            : logic<64>;
    var cnt_ras_used             : logic<64>;
    var cnt_ras_push             : logic<64>;
    var cnt_ras_pop              : logic<64>;

    always_ff (clk, rst) {
        if_reset {
            frozen        = 1'b0;
            cycle_cnt     = 64'd0;
            cnt_icache    = 64'd0;
            cnt_immu      = 64'd0;
            cnt_stall_if  = 64'd0;
            cnt_stall_id  = 64'd0;
            cnt_stall_ex  = 64'd0;
            cnt_stall_mem = 64'd0;
            cnt_flush_id  = 64'd0;
            cnt_flush_ex  = 64'd0;
            cnt_instret   = 64'd0;
            cnt_cause_load_use = 64'd0;
            cnt_cause_mmu      = 64'd0;
            cnt_cause_cache    = 64'd0;
            cnt_cause_rs       = 64'd0;
            cnt_cause_rob_full = 64'd0;
            cnt_cause_rs_full_int  = 64'd0;
            cnt_cause_rs_full_fp   = 64'd0;
            cnt_cause_direct_stall = 64'd0;
            cnt_cause_irq_wait     = 64'd0;
            cnt_ds_operand  = 64'd0;
            cnt_ds_op_load  = 64'd0;
            cnt_ds_op_store = 64'd0;
            cnt_ds_op_bj    = 64'd0;
            cnt_ds_rs_yield = 64'd0;
            cnt_ds_rob_full = 64'd0;
            cnt_ds_drain    = 64'd0;
            cnt_mispred_branch = 64'd0;
            cnt_mispred_jalr   = 64'd0;
            cnt_mispred_jal    = 64'd0;
            cnt_flush_trap     = 64'd0;
            cnt_mispred_jalr_return   = 64'd0;
            cnt_mispred_jalr_indirect = 64'd0;
            cnt_if_return             = 64'd0;
            cnt_ras_used              = 64'd0;
            cnt_ras_push              = 64'd0;
            cnt_ras_pop               = 64'd0;
        } else if !frozen {
            if tohost_lo != 32'd0 {
                frozen = 1'b1;
            }
            cycle_cnt = cycle_cnt + 64'd1;
            if dbg_stall[7] {
                cnt_icache = cnt_icache + 64'd1;
            }
            if dbg_stall[6] {
                cnt_immu = cnt_immu + 64'd1;
            }
            if dbg_stall[5] {
                cnt_stall_if = cnt_stall_if + 64'd1;
            }
            if dbg_stall[4] {
                cnt_stall_id = cnt_stall_id + 64'd1;
            }
            if dbg_stall[3] {
                cnt_stall_ex = cnt_stall_ex + 64'd1;
            }
            if dbg_stall[2] {
                cnt_stall_mem = cnt_stall_mem + 64'd1;
            }
            if dbg_stall[1] {
                cnt_flush_id = cnt_flush_id + 64'd1;
            }
            if dbg_stall[0] {
                cnt_flush_ex = cnt_flush_ex + 64'd1;
            }
            if dbg_instret {
                cnt_instret = cnt_instret + 64'd1;
            }
            if stall_load_use {
                cnt_cause_load_use = cnt_cause_load_use + 64'd1;
            }
            if stall_mmu {
                cnt_cause_mmu = cnt_cause_mmu + 64'd1;
            }
            if stall_cache {
                cnt_cause_cache = cnt_cause_cache + 64'd1;
            }
            if stall_rs {
                cnt_cause_rs = cnt_cause_rs + 64'd1;
            }
            if stall_rob_full {
                cnt_cause_rob_full = cnt_cause_rob_full + 64'd1;
            }
            if stall_rs_full_int {
                cnt_cause_rs_full_int = cnt_cause_rs_full_int + 64'd1;
            }
            if stall_rs_full_fp {
                cnt_cause_rs_full_fp = cnt_cause_rs_full_fp + 64'd1;
            }
            if stall_direct_stall {
                cnt_cause_direct_stall = cnt_cause_direct_stall + 64'd1;
            }
            if stall_irq_wait {
                cnt_cause_irq_wait = cnt_cause_irq_wait + 64'd1;
            }
            if ds_operand {
                cnt_ds_operand = cnt_ds_operand + 64'd1;
            }
            if ds_op_load {
                cnt_ds_op_load = cnt_ds_op_load + 64'd1;
            }
            if ds_op_store {
                cnt_ds_op_store = cnt_ds_op_store + 64'd1;
            }
            if ds_op_bj {
                cnt_ds_op_bj = cnt_ds_op_bj + 64'd1;
            }
            if ds_rs_yield {
                cnt_ds_rs_yield = cnt_ds_rs_yield + 64'd1;
            }
            if ds_rob_full {
                cnt_ds_rob_full = cnt_ds_rob_full + 64'd1;
            }
            if ds_drain {
                cnt_ds_drain = cnt_ds_drain + 64'd1;
            }
            if mispred_branch {
                cnt_mispred_branch = cnt_mispred_branch + 64'd1;
            }
            if mispred_jalr {
                cnt_mispred_jalr = cnt_mispred_jalr + 64'd1;
            }
            if mispred_jal {
                cnt_mispred_jal = cnt_mispred_jal + 64'd1;
            }
            if flush_trap {
                cnt_flush_trap = cnt_flush_trap + 64'd1;
            }
            if mispred_jalr_return {
                cnt_mispred_jalr_return = cnt_mispred_jalr_return + 64'd1;
            }
            if mispred_jalr_indirect {
                cnt_mispred_jalr_indirect = cnt_mispred_jalr_indirect + 64'd1;
            }
            if if_return_seen {
                cnt_if_return = cnt_if_return + 64'd1;
            }
            if ras_used_seen {
                cnt_ras_used = cnt_ras_used + 64'd1;
            }
            if ras_push_seen {
                cnt_ras_push = cnt_ras_push + 64'd1;
            }
            if ras_pop_seen {
                cnt_ras_pop = cnt_ras_pop + 64'd1;
            }
        }
    }

    assign o_cycle_cnt     = cycle_cnt;
    assign o_cnt_icache    = cnt_icache;
    assign o_cnt_immu      = cnt_immu;
    assign o_cnt_stall_if  = cnt_stall_if;
    assign o_cnt_stall_id  = cnt_stall_id;
    assign o_cnt_stall_ex  = cnt_stall_ex;
    assign o_cnt_stall_mem = cnt_stall_mem;
    assign o_cnt_flush_id  = cnt_flush_id;
    assign o_cnt_flush_ex  = cnt_flush_ex;
    assign o_cnt_instret   = cnt_instret;
    assign o_cnt_cause_load_use = cnt_cause_load_use;
    assign o_cnt_cause_mmu      = cnt_cause_mmu;
    assign o_cnt_cause_cache    = cnt_cause_cache;
    assign o_cnt_cause_rs       = cnt_cause_rs;
    assign o_cnt_cause_rob_full = cnt_cause_rob_full;
    assign o_cnt_cause_rs_full_int  = cnt_cause_rs_full_int;
    assign o_cnt_cause_rs_full_fp   = cnt_cause_rs_full_fp;
    assign o_cnt_cause_direct_stall = cnt_cause_direct_stall;
    assign o_cnt_cause_irq_wait     = cnt_cause_irq_wait;
    assign o_cnt_ds_operand  = cnt_ds_operand;
    assign o_cnt_ds_op_load  = cnt_ds_op_load;
    assign o_cnt_ds_op_store = cnt_ds_op_store;
    assign o_cnt_ds_op_bj    = cnt_ds_op_bj;
    assign o_cnt_ds_rs_yield = cnt_ds_rs_yield;
    assign o_cnt_ds_rob_full = cnt_ds_rob_full;
    assign o_cnt_ds_drain    = cnt_ds_drain;
    assign o_cnt_mispred_branch = cnt_mispred_branch;
    assign o_cnt_mispred_jalr   = cnt_mispred_jalr;
    assign o_cnt_mispred_jal    = cnt_mispred_jal;
    assign o_cnt_flush_trap     = cnt_flush_trap;
    assign o_cnt_mispred_jalr_return   = cnt_mispred_jalr_return;
    assign o_cnt_mispred_jalr_indirect = cnt_mispred_jalr_indirect;
    assign o_cnt_if_return             = cnt_if_return;
    assign o_cnt_ras_used              = cnt_ras_used;
    assign o_cnt_ras_push              = cnt_ras_push;
    assign o_cnt_ras_pop               = cnt_ras_pop;
    assign o_cnt_lq_issue              = _lq_issue_cnt;
    assign o_cnt_lq_alloc              = _lq_alloc_cnt;
    assign o_cnt_lq_mshr               = _lq_mshr_cnt;
    assign o_cnt_srs_disp              = _srs_disp_cnt;
    assign o_cnt_srs_issue             = _srs_issue_cnt;
    assign o_cnt_srs_drop              = _srs_drop_cnt;
    assign o_cnt_sb_fwd_hit            = _sb_fwd_hit_cnt;
    assign o_cnt_sb_fwd_partial        = _sb_fwd_partial_cnt;
    assign o_cnt_sb_fwd_mismatch       = _sb_fwd_mismatch_cnt;
    assign o_cnt_srs_load_drain_unresolved = _srs_load_drain_unresolved_cnt;
    assign o_cnt_p34_spec_violation        = _p34_spec_violation_cnt;
    assign o_cnt_dual_fetch                = _dual_fetch_cnt;
    assign o_cnt_dual_issue                = _dual_issue_cnt;
}
