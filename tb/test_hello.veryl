// Phase 7 v4 hello-world smoke test.
//
// Loads test/hex/hello_world.hex at PA 0 (the hex is hand-written
// RV64I that writes "Hello World\n" to UART at 0x10000000) and runs
// for a short while. Verifies basic v4 instruction fetch + UART
// MMIO routing end-to-end.
module test_hello_harness (
    clk: input clock,
    rst: input reset,
) {
    var imem_addr      : logic<64>     ;
    var imem_rdata     : logic<32>     ;
    var imem_ren       : logic         ;
    var dmem_addr      : logic<64>     ;
    var dmem_wdata     : logic<64>     ;
    var dmem_rdata     : logic<64>     ;
    var dmem_rdata_next: logic<64>     ;
    var dmem_wen       : logic         ;
    var dmem_ren       : logic         ;
    var dmem_wstrb     : logic<8>      ;
    var dmem_wdata_hi  : logic<64>     ;
    var dmem_wstrb_hi  : logic<8>      ;
    var dbg_regs       : logic<64> [32];
    var dbg_pc         : logic<64>     ;
    var ret_v          : logic         ;
    var ret_pc         : logic<64>     ;
    var ret_rdv        : logic         ;
    var ret_rd         : logic<5>      ;
    var ret_data       : logic<64>     ;
    var dbg_rename_cnt : logic<32>     ;
    var dbg_cdb_cnt    : logic<32>     ;
    var dbg_rob_size   : logic<8>      ;
    var dbg_if_v       : logic         ;
    var dbg_if_instr   : logic<32>     ;
    var dbg_stall_dr   : logic         ;
    var dbg_head_valid : logic         ;
    var dbg_head_rw    : logic         ;
    var dbg_head_il    : logic         ;
    var dbg_r_alloc    : logic<32>     ;
    var dbg_r_cdb      : logic<32>     ;
    var dbg_r_commit   : logic<32>     ;
    var dbg_r_head     : logic<6>      ;
    var dbg_r_tail     : logic<6>      ;
    var _d1            : logic<64>     ;
    var _d2            : logic<64>     ;
    var _d3            : logic<2>      ;
    var _d4            : logic         ;
    var _d5            : logic<64>     ;
    var _d6            : logic<64>     ;
    var _d7            : logic         ;
    var _d8            : logic<64>     ;
    var _d9            : logic<64>     ;
    var _d10           : logic<64>     ;
    var _d11           : logic         ;
    var _d12           : logic         ;
    var _d13           : logic         ;
    var _d14           : logic<12>     ;
    var _d15           : logic<64>     ;
    var _d16           : logic         ;
    var _d17           : logic<64>     ;
    var _d18           : logic<64>     ;
    var _d19           : logic         ;
    var _d20           : logic<64>     ;
    var _d21           : logic<64>     ;
    var _d22           : logic<64>     ;
    var _d23           : logic<64>     ;
    var _d24           : logic<64>     ;
    var _d25           : logic         ;
    var _d26           : logic<64>     ;
    var _d27           : logic         ;
    var _d28           : logic<64>     ;
    var _d29           : logic<32>     ;
    var _d30           : logic<64>     ;
    var _d31           : logic<64>     ;
    var _d32           : logic<64>     ;

    inst dut: heliodor_core #(
        RESET_PC: 64'h00000000,
    ) (
        clk                                    ,
        rst                                    ,
        o_imem_addr           : imem_addr      ,
        i_imem_rdata          : imem_rdata     ,
        o_imem_ren            : imem_ren       ,
        o_iptw_addr           : _              , // M8.C: Bare smoke, no imem PTW
        o_iptw_req            : _              ,
        i_iptw_rdata          : 64'd0          ,
        o_dmem_addr           : dmem_addr      ,
        o_dmem_wdata          : dmem_wdata     ,
        i_dmem_rdata          : dmem_rdata     ,
        i_dmem_rdata_next     : dmem_rdata_next,
        o_dmem_wen            : dmem_wen       ,
        o_dmem_ren            : dmem_ren       ,
        o_dmem_wstrb          : dmem_wstrb     ,
        o_dmem_wdata_hi       : dmem_wdata_hi  ,
        o_dmem_wstrb_hi       : dmem_wstrb_hi  ,
        o_dmem_req            : _    ,
        i_dmem_grant          : 1'b1 ,
        i_dcache_inv_valid    : 1'b0 ,
        i_dcache_inv_addr     : 64'd0,
        o_amo_inflight        : _    ,
        i_irq_timer_m         : 1'b0           ,
        i_irq_sw_m            : 1'b0           ,
        i_irq_ext_m           : 1'b0           ,
        i_mtime               : 64'd0          ,
        o_dbg_pc              : dbg_pc         ,
        o_dbg_regs            : dbg_regs       ,
        o_dbg_retire_v_a      : ret_v          ,
        o_dbg_retire_pc_a     : ret_pc         ,
        o_dbg_retire_rd_v_a   : ret_rdv        ,
        o_dbg_retire_rd_a     : ret_rd         ,
        o_dbg_retire_data_a   : ret_data       ,
        o_dbg_rename_cnt      : dbg_rename_cnt ,
        o_dbg_cdb_cnt         : dbg_cdb_cnt    ,
        o_dbg_rob_size        : dbg_rob_size   ,
        o_dbg_if_v            : dbg_if_v       ,
        o_dbg_if_instr        : dbg_if_instr   ,
        o_dbg_stall_dr        : dbg_stall_dr   ,
        o_dbg_head_valid      : dbg_head_valid ,
        o_dbg_head_rw         : dbg_head_rw    ,
        o_dbg_head_illegal    : dbg_head_il    ,
        o_dbg_rob_alloc_cnt   : dbg_r_alloc    ,
        o_dbg_rob_cdb_cnt     : dbg_r_cdb      ,
        o_dbg_rob_commit_cnt  : dbg_r_commit   ,
        o_dbg_rob_head        : dbg_r_head     ,
        o_dbg_rob_tail        : dbg_r_tail     ,
        o_dbg_sepc            : _d1            ,
        o_dbg_mepc            : _d2            ,
        o_dbg_priv            : _d3            ,
        o_dbg_trap_fire       : _d4            ,
        o_dbg_trap_pc         : _d5            ,
        o_dbg_trap_cause      : _d6            ,
        o_dbg_trap_to_s       : _d7            ,
        o_dbg_satp            : _d8            ,
        o_dbg_imem_vaddr      : _d9            ,
        o_dbg_imem_paddr      : _d10           ,
        o_dbg_imem_valid      : _d11           ,
        o_dbg_imem_fault      : _d12           ,
        o_dbg_csrwr_v         : _d13           ,
        o_dbg_csrwr_addr      : _d14           ,
        o_dbg_csrwr_wdata     : _d15           ,
        o_dbg_ptw_req         : _d16           ,
        o_dbg_ptw_addr        : _d17           ,
        o_dbg_ptw_data        : _d18           ,
        o_dbg_redirect_fire   : _d19           ,
        o_dbg_redirect_pc     : _d20           ,
        o_dbg_redirect_src_pc : _d21           ,
        o_dbg_alu_pc_out      : _d22           ,
        o_dbg_alu_src_a_out   : _d23           ,
        o_dbg_alu_src_b_out   : _d24           ,
        o_dbg_alu_use_pc_a_out: _d25           ,
        o_dbg_alu_rs1_data_out: _d26           ,
        o_dbg_alu_valid_out   : _d27           ,
        o_dbg_alu_alu_out_out : _d28           ,
        o_dbg_alu_instr_out   : _d29           ,
        o_dbg_alu_imm_out     : _d30           ,
        o_dbg_stval_out       : _d31           ,
        o_dbg_mtval_out       : _d32           ,
    );

    // 16 KB ROM at PA 0 for hello hex
    #[allow(initial_assign)]
    var rom: logic<32> [4096];
    initial {
        $readmemh("test/hex/hello_world.hex", rom);
    }

    let in_rom : logic = imem_addr[31:14] == 18'd0;
    let in_uart: logic = dmem_addr[31:28] == 4'h1;

    let rom_imem_idx: logic<12> = imem_addr[13:2];
    assign imem_rdata = if in_rom ? rom[rom_imem_idx] : 32'd0;

    assign dmem_rdata      = 64'd0;
    assign dmem_rdata_next = 64'd0;

    always_ff (clk, rst) {
        if_reset {} else if dmem_wen && in_uart {
            if dmem_wstrb[0] {
                $write("%c", dmem_wdata[7:0]);
            }
            if dmem_wstrb[1] {
                $write("%c", dmem_wdata[15:8]);
            }
            if dmem_wstrb[2] {
                $write("%c", dmem_wdata[23:16]);
            }
            if dmem_wstrb[3] {
                $write("%c", dmem_wdata[31:24]);
            }
            if dmem_wstrb[4] {
                $write("%c", dmem_wdata[39:32]);
            }
            if dmem_wstrb[5] {
                $write("%c", dmem_wdata[47:40]);
            }
            if dmem_wstrb[6] {
                $write("%c", dmem_wdata[55:48]);
            }
            if dmem_wstrb[7] {
                $write("%c", dmem_wdata[63:56]);
            }
        }
    }
}

#[test(test_hello)]
#[ignore]
module test_hello {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    inst harness: test_hello_harness ( clk: clk, rst: rst );

    initial {
        rst.assert(clk);
        clk.next  (5000);
        $display  ("\nv4 hello: 5000 cycles done");
        $finish   ();
    }
}
