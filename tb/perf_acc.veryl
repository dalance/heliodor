// perf_acc: accumulates one hart's flattened o_perf (core_types::CorePerf,
// zero-extended to soc_pkg::PERF_W by heliodor_soc_smp). Counts, while i_en,
// the cycles each bit is 1 and the full kills by RedirKind, and prints them
// once at the rising edge of i_dump:
//   PERF <core> <perf_w> <width> <N_IQ> <ISSUE_W> <MEM_W> <WB_N> <RETIRE_CNT_W>
//   PB <core> <bit> <count>    nonzero bits only, bit 0 = LSB of CorePerf
//   PK <core> <kind> <count>   nonzero RedirKind values of flush.full
// test/gates/fire_check.py names the bits from the struct sources and checks
// the width it computes against <width>.
module perf_acc::<CFG: core_cfg> #(
    param CORE_ID: u32 = 2,
) (
    clk   : input clock                 ,
    rst   : input reset                 ,
    i_perf: input logic<soc_pkg::PERF_W>,
    i_en  : input logic                 ,
    i_dump: input logic                 ,
) {
    import core_types::<CFG>::*;

    const W     : u32 = $bits(CorePerf);
    const KINDS : u32 = 8;

    var p: CorePerf;
    assign p = i_perf[W - 1:0];

    var dump_q: logic;
    always_ff {
        if_reset {
            dump_q = 1'b0;
        } else {
            dump_q = i_dump;
        }
    }
    let dump: logic = i_dump && !dump_q;

    always_ff {
        if_reset {} else if dump {
            $display("PERF %d %d %d %d %d %d %d %d", CORE_ID, soc_pkg::PERF_W, W, CFG::N_IQ, CFG::ISSUE_W, CFG::MEM_W,
                WB_N, RETIRE_CNT_W);
        }
    }

    for i in 0..W :g_bit {
        var cnt: logic<64>;
        always_ff {
            if_reset {
                cnt = 64'd0;
            } else if i_en && i_perf[i] {
                cnt = cnt + 64'd1;
            }
        }
        always_ff {
            if_reset {} else if dump && cnt != 64'd0 {
                $display("PB %d %d %d", CORE_ID, i, cnt);
            }
        }
    }

    for k in 0..KINDS :g_kind {
        var cnt: logic<64>;
        always_ff {
            if_reset {
                cnt = 64'd0;
            } else if i_en && p.flush.full && p.flush.full_kind == k as 3 {
                cnt = cnt + 64'd1;
            }
        }
        always_ff {
            if_reset {} else if dump && cnt != 64'd0 {
                $display("PK %d %d %d", CORE_ID, k, cnt);
            }
        }
    }
}
