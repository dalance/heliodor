// M9.4 directed test for the v4 OoO LR/SC reservation reorder bug.
//
// Runs test/lrsc_reorder/lrsc_reorder.hex (a single-hart, M-mode, tight
// read_lock-style loop on an UNCONTENDED lock) on the v4 arch harness. A correct
// core succeeds every sc.w and writes tohost=1; the OoO reorder bug (an older
// sc.w issuing after a younger lr.w wipes the reservation) makes an sc.w fail on
// an uncontended lock → tohost=2. Reproduces the N=4 boot livelock (hart0 stuck
// in arch_read_lock @0x80025b58) in ~thousands of cycles instead of ~57M.
#[test(test_v4_lrsc_reorder)]
#[ignore]
module test_v4_lrsc_reorder {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var pass  : logic    ;
    var fail  : logic    ;
    var tohost: logic<32>;
    inst h: test_v4_arch_common_harness #(
        HEX_FILE  : "test/lrsc_reorder/lrsc_reorder.hex",
        TOHOST_IDX: 1024                                ,
    ) (
        clk             ,
        rst             ,
        o_pass  : pass  ,
        o_fail  : fail  ,
        o_tohost: tohost,
    );
    initial {
        rst.assert(clk);
        clk.next  (100000);
        $display  ("v4 lrsc_reorder tohost=%h pass=%b (1=all sc.w ok, 2=an sc.w failed = reorder bug)", tohost, pass);
        $assert   (pass, "v4 lrsc_reorder: an sc.w failed on an UNCONTENDED lock (OoO LR/SC reservation reorder)");
        $display  ("v4 lrsc_reorder PASS");
        $finish   ();
    }
}
