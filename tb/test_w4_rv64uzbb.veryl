    inst h: test_arch_common_harness #(
        CORE      : tb_core_sel::CORE_W4                            ,
        HEX_FILE  : "test/riscv-arch-test/build/rv64uzbb/zext_h.hex",
        TOHOST_IDX: 1024                                            ,
    ) (
        clk             ,
        rst             ,
        o_pass  : pass  ,
        o_fail  : fail  ,
        o_tohost: tohost,
    );
    initial {
        rst.assert(clk);
        for _i in 0..300 {
            clk.next(1000);
            if pass || fail {
                break;
            }
        }
        $display("w4 rv64uzbb/zext_h (pass/fail) tohost=%h pass=%b", tohost, pass);
        $assert(pass, "w4 rv64uzbb/zext_h fail");
        $finish();
    }
}
