// axi4_tb_pkg: timing settings of the tb AXI4 slave model and the flag
// numbering of the AXI4 protocol checker.
//
// A stall probability is out of 256 per cycle (0 = never stalls). A latency
// is lat + (rand & lat_mask) cycles, so a mask of 0 makes it fixed.
package axi4_tb_pkg {
    struct SlaveCfg {
        ar_bp     : logic<8>, // ARREADY low
        aw_bp     : logic<8>, // AWREADY low
        w_bp      : logic<8>, // WREADY low
        r_lat     : logic<8>, // AR accept -> burst eligible for R
        r_lat1    : logic<8>, // r_lat of a single-beat burst (ARLEN 0)
        r_lat_mask: logic<8>,
        r_gap_bp  : logic<8>, // no beat presented in a cycle mid-burst
        b_lat     : logic<8>, // last W -> B eligible
        b_lat_mask: logic<8>,
        reorder   : logic   , // responses of different IDs out of order
    }

    // Accepts at once, one beat per cycle, fixed latency, in order. The
    // latencies reproduce the fixed-latency memory before AXI: the first beat
    // of a line comes 21 cycles after its L2 lookup (mem_ctrl's DRAM_WAIT of
    // 20), a single beat (ROM, uncached DRAM) as soon as the slave can.
    const FIXED: SlaveCfg = SlaveCfg'{
        ar_bp     : 8'd0  ,
        aw_bp     : 8'd0  ,
        w_bp      : 8'd0  ,
        r_lat     : 8'd17 ,
        r_lat1    : 8'd0  ,
        r_lat_mask: 8'd0  ,
        r_gap_bp  : 8'd0  ,
        b_lat     : 8'd1  ,
        b_lat_mask: 8'd0  ,
        reorder   : 1'b0  ,
    };
    // Long latencies and slow acceptance: little overlap between requests.
    const SLOW: SlaveCfg = SlaveCfg'{
        ar_bp     : 8'd192,
        aw_bp     : 8'd192,
        w_bp      : 8'd64 ,
        r_lat     : 8'd60 ,
        r_lat1    : 8'd60 ,
        r_lat_mask: 8'd63 ,
        r_gap_bp  : 8'd64 ,
        b_lat     : 8'd30 ,
        b_lat_mask: 8'd31 ,
        reorder   : 1'b0  ,
    };
    // Short latencies, every ready and the R beats stall often.
    const BACKPRESSURE: SlaveCfg = SlaveCfg'{
        ar_bp     : 8'd96 ,
        aw_bp     : 8'd96 ,
        w_bp      : 8'd96 ,
        r_lat     : 8'd4  ,
        r_lat1    : 8'd4  ,
        r_lat_mask: 8'd7  ,
        r_gap_bp  : 8'd96 ,
        b_lat     : 8'd1  ,
        b_lat_mask: 8'd7  ,
        reorder   : 1'b0  ,
    };
    // Responses of different IDs return out of order.
    const REORDER: SlaveCfg = SlaveCfg'{
        ar_bp     : 8'd32 ,
        aw_bp     : 8'd32 ,
        w_bp      : 8'd32 ,
        r_lat     : 8'd8  ,
        r_lat1    : 8'd8  ,
        r_lat_mask: 8'd31 ,
        r_gap_bp  : 8'd32 ,
        b_lat     : 8'd2  ,
        b_lat_mask: 8'd15 ,
        reorder   : 1'b1  ,
    };

    // Directed settings. WR_LAG: W and B are slow and R is fast, so a read
    // that passes an earlier write returns the old data.
    const WR_LAG: SlaveCfg = SlaveCfg'{
        ar_bp     : 8'd0  ,
        aw_bp     : 8'd0  ,
        w_bp      : 8'd240,
        r_lat     : 8'd2  ,
        r_lat1    : 8'd0  ,
        r_lat_mask: 8'd0  ,
        r_gap_bp  : 8'd0  ,
        b_lat     : 8'd40 ,
        b_lat_mask: 8'd15 ,
        reorder   : 1'b0  ,
    };
    // STALL: every ready and the R beats drop most cycles, responses reorder.
    const STALL: SlaveCfg = SlaveCfg'{
        ar_bp     : 8'd232,
        aw_bp     : 8'd232,
        w_bp      : 8'd232,
        r_lat     : 8'd16 ,
        r_lat1    : 8'd16 ,
        r_lat_mask: 8'd127,
        r_gap_bp  : 8'd232,
        b_lat     : 8'd16 ,
        b_lat_mask: 8'd127,
        reorder   : 1'b1  ,
    };

    // axi4_mon o_chk bits.
    const CHK_AR_HOLD : u32 = 0; // ARVALID dropped or AR payload changed before ARREADY
    const CHK_AW_HOLD : u32 = 1;
    const CHK_W_HOLD  : u32 = 2;
    const CHK_R_HOLD  : u32 = 3;
    const CHK_B_HOLD  : u32 = 4;
    const CHK_WLAST   : u32 = 5; // W beats of a burst != AWLEN + 1, or WLAST misplaced
    const CHK_RLAST   : u32 = 6; // R beats != ARLEN + 1, or RLAST misplaced
    const CHK_NO_REQ  : u32 = 7; // R or B with no outstanding request of that ID
    const CHK_B_EARLY : u32 = 8; // B before the last W of its burst
    const CHK_4K      : u32 = 9; // INCR burst crosses a 4 KiB boundary
    const CHK_ATTR    : u32 = 10; // AxBURST != INCR or AxSIZE wider than the bus
    const CHK_OUTSTAND: u32 = 11; // more outstanding requests than the limit
    const CHK_N       : u32 = 12;
}
