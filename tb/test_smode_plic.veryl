// P9.5: S-mode PLIC external-interrupt integration test.
//
// Wires a single heliodor_core to a PLIC (mirroring the SoC's MMIO routing)
// and runs test/hex/smode_plic_test.hex from ROM at PA 0. The program drops to
// S-mode, programs the PLIC (prio[10]=1, enable source 10 for its S-context,
// threshold=0), enables sie.SEIE + sstatus.SIE, and spins. The testbench pulses
// PLIC source 10; the PLIC raises o_irq_s[0] → the core's SEIP → an S-mode
// external interrupt (scause=9). The handler reads the claim register (an MMIO
// load that must return 10), completes, and sets x3=0xAA. Pass = x3==0xAA.
//
// This is register + MMIO only (no DRAM data / stack), so grant is tied high
// and i_dmem_rdata is served combinationally (PLIC reads) like the arch harness.
module test_smode_plic_harness (
    clk    : input  clock    ,
    rst    : input  reset    ,
    o_x3     : output logic<64>,
    o_x4     : output logic<64>, // scause captured by the handler
    o_t2     : output logic<64>, // claim value the handler read (x7)
    o_irq_s  : output logic    ,
    o_rd_addr: output logic<64>, // last PLIC read address (diagnostic)
    o_rd_cnt : output logic<64>, // count of PLIC reads
) {
    var imem_addr    : logic<64>     ;
    var imem_rdata   : logic<32>     ;
    var imem_ren     : logic         ;
    var dmem_addr    : logic<64>     ;
    var dmemw_addr   : logic<64>     ;
    var dmem_wdata   : logic<64> [8] ;
    var dmem_rdata   : logic<64>     ;
    var dmem_wen     : logic         ;
    var dmem_ren     : logic         ;
    var dmem_wstrb   : logic<8>  [8] ;
    var dmem_wdata_hi: logic<64>     ;
    var dmem_wstrb_hi: logic<8>      ;
    var dbg_regs     : logic<64> [32];

    // ----------------------------------------------------------------
    // PLIC + interrupt source. The testbench pulses source 10 early; the
    // PLIC latches pending and holds it until the handler claims.
    // ----------------------------------------------------------------
    var tc: logic<16>;
    always_ff (clk, rst) {
        if_reset {
            tc = 16'd0;
        } else {
            tc = tc + 16'd1;
        }
    }
    let src_pulse: logic      = (tc >= 16'd8) && (tc <: 16'd16);
    let plic_src : logic<32>  = if src_pulse ? 32'h0000_0400 : 32'd0; // bit 10 = UART
    let in_plic  : logic      = dmem_addr[31:24] == 8'h0c;
    let in_plic_w: logic      = dmemw_addr[31:24] == 8'h0c;
    let plic_wlane: logic<64> = dmem_wdata[dmemw_addr[5:3]];
    var plic_rdata: logic<64> ;
    var plic_irq_m: logic  [1];
    var plic_irq_s: logic  [1];
    inst u_plic: plic #(
        N_HARTS: 1,
    ) (
        clk                             ,
        rst                             ,
        i_src  : plic_src               ,
        i_addr : if dmem_wen && in_plic_w ? dmemw_addr[23:0] : dmem_addr[23:0],
        i_wdata: plic_wlane             ,
        i_wen  : dmem_wen && in_plic_w  ,
        i_ren  : dmem_ren && in_plic    ,
        o_rdata: plic_rdata             ,
        o_irq_m: plic_irq_m             ,
        o_irq_s: plic_irq_s             ,
    );
    assign o_irq_s = plic_irq_s[0];

    inst dut: heliodor_core #(
        RESET_PC: 64'h00000000,
    ) (
        clk                                    ,
        rst                                    ,
        o_imem_addr           : imem_addr      ,
        i_imem_rdata          : imem_rdata     ,
        o_imem_ren            : imem_ren       ,
        o_iptw_addr           : _              ,
        o_iptw_req            : _              ,
        i_iptw_rdata          : 64'd0          ,
        o_dmem_addr           : dmem_addr      ,
        o_dmem_wdata          : dmem_wdata     ,
        i_dmem_rdata          : dmem_rdata     ,
        i_dmem_rdata_next     : 64'd0          ,
        o_dmem_wen            : dmem_wen       ,
        o_dmem_ren            : dmem_ren       ,
        o_dmem_wstrb          : dmem_wstrb     ,
        o_dmemw_addr          : dmemw_addr     ,
        o_dmemw_req           : _              ,
        i_dmemw_grant         : 1'b1           ,
        o_dmem_wdata_hi       : dmem_wdata_hi  ,
        o_dmem_wstrb_hi       : dmem_wstrb_hi  ,
        o_dmem_req            : _              ,
        i_dmem_grant          : 1'b1           ,
        i_dcache_inv_valid    : 1'b0           ,
        i_dcache_inv_addr     : 64'd0          ,
        i_dcache_inv2_valid   : 1'b0           ,
        i_dcache_inv2_addr    : 64'd0          ,
        o_dmemw_wb            : _              ,
        o_dmem_rfo            : _              ,
        i_dmem_fill_excl      : 1'b1           ,
        i_dcache_probe_v      : 1'b0           ,
        i_dcache_probe_self   : 1'b0           ,
        i_dcache_probe_addr   : 64'd0          ,
        o_dcache_probe_ack    : _              ,
        i_irq_timer_m         : 1'b0           ,
        i_irq_sw_m            : 1'b0           ,
        i_irq_ext_m           : plic_irq_m[0]  ,
        i_irq_ext_s           : plic_irq_s[0]  ,
        i_mtime               : 64'd0          ,
        o_dbg_pc              : _              ,
        o_dbg_regs            : dbg_regs       ,
        o_dbg_retire_v_a      : _              ,
        o_dbg_retire_pc_a     : _              ,
        o_dbg_retire_rd_v_a   : _              ,
        o_dbg_retire_rd_a     : _              ,
        o_dbg_retire_data_a   : _              ,
        o_dbg_rename_cnt      : _              ,
        o_dbg_cdb_cnt         : _              ,
        o_dbg_rob_size        : _              ,
        o_dbg_if_v            : _              ,
        o_dbg_if_instr        : _              ,
        o_dbg_stall_dr        : _              ,
        o_dbg_head_valid      : _              ,
        o_dbg_head_rw         : _              ,
        o_dbg_head_illegal    : _              ,
        o_dbg_rob_alloc_cnt   : _              ,
        o_dbg_rob_cdb_cnt     : _              ,
        o_dbg_rob_commit_cnt  : _              ,
        o_dbg_rob_head        : _              ,
        o_dbg_rob_tail        : _              ,
        o_dbg_sepc            : _              ,
        o_dbg_mepc            : _              ,
        o_dbg_priv            : _              ,
        o_dbg_trap_fire       : _              ,
        o_dbg_trap_pc         : _              ,
        o_dbg_trap_cause      : _              ,
        o_dbg_trap_to_s       : _              ,
        o_dbg_satp            : _              ,
        o_dbg_imem_vaddr      : _              ,
        o_dbg_imem_paddr      : _              ,
        o_dbg_imem_valid      : _              ,
        o_dbg_imem_fault      : _              ,
        o_dbg_csrwr_v         : _              ,
        o_dbg_csrwr_addr      : _              ,
        o_dbg_csrwr_wdata     : _              ,
        o_dbg_ptw_req         : _              ,
        o_dbg_ptw_addr        : _              ,
        o_dbg_ptw_data        : _              ,
        o_dbg_redirect_fire   : _              ,
        o_dbg_redirect_pc     : _              ,
        o_dbg_redirect_src_pc : _              ,
        o_dbg_alu_pc_out      : _              ,
        o_dbg_alu_src_a_out   : _              ,
        o_dbg_alu_src_b_out   : _              ,
        o_dbg_alu_use_pc_a_out: _              ,
        o_dbg_alu_rs1_data_out: _              ,
        o_dbg_alu_valid_out   : _              ,
        o_dbg_alu_alu_out_out : _              ,
        o_dbg_alu_instr_out   : _              ,
        o_dbg_alu_imm_out     : _              ,
        o_dbg_stval_out       : _              ,
        o_dbg_mtval_out       : _              ,
    );

    // 16 KB ROM at PA 0 for the program.
    #[allow(initial_assign)]
    var rom: logic<32> [4096];
    initial {
        $readmemh("test/hex/smode_plic_test.hex", rom);
    }
    let in_rom      : logic      = imem_addr[31:14] == 18'd0;
    let rom_imem_idx: logic<12>  = imem_addr[13:2];
    assign imem_rdata = if in_rom ? rom[rom_imem_idx] : 32'd0;

    // Data reads: only the PLIC region is served (the program touches no DRAM).
    assign dmem_rdata = if in_plic ? plic_rdata : 64'd0;

    // Diagnostic: capture PLIC read accesses (dmem_ren && in_plic). An uncached
    // single read drives the EXACT claim address 0x0C201004; a (wrong) line fill
    // would drive the dword-aligned base 0x0C201000.
    var dbg_plic_rd_addr: logic<64>;
    var dbg_plic_rd_cnt : logic<16>;
    always_ff (clk, rst) {
        if_reset {
            dbg_plic_rd_addr = 64'd0;
            dbg_plic_rd_cnt  = 16'd0;
        } else if dmem_ren && in_plic {
            dbg_plic_rd_addr = dmem_addr;
            dbg_plic_rd_cnt  = dbg_plic_rd_cnt + 16'd1;
        }
    }

    assign o_x3 = dbg_regs[3];
    assign o_x4 = dbg_regs[4];
    assign o_t2 = dbg_regs[7]; // t2 == x7
    assign o_rd_addr = dbg_plic_rd_addr;
    assign o_rd_cnt  = {48'd0, dbg_plic_rd_cnt};
}

#[test(test_smode_plic)]
module test_smode_plic {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var x3     : logic<64>;
    var x4     : logic<64>;
    var t2     : logic<64>;
    var irq_s  : logic    ;
    var rd_addr: logic<64>;
    var rd_cnt : logic<64>;

    inst harness: test_smode_plic_harness (
        clk           ,
        rst           ,
        o_x3     : x3 ,
        o_x4     : x4 ,
        o_t2     : t2 ,
        o_irq_s  : irq_s,
        o_rd_addr: rd_addr,
        o_rd_cnt : rd_cnt,
    );

    initial {
        rst.assert(clk);
        // The setup + interrupt round-trip completes well within a few thousand
        // cycles; poll for the pass/fail sentinel (x3 settles to 0xAA / 0xDD / 0xEE).
        for _i in 0..2000 {
            clk.next(1);
            if x3 == 64'hAA {
                break;
            }
        }
        $display("smode_plic: x3=%h scause=%h claim(t2)=%h irq_s=%b rd_addr=%h rd_cnt=%h", x3, x4, t2, irq_s, rd_addr, rd_cnt);
        $assert(x3 == 64'hAA, "S-mode PLIC external interrupt test FAILED");
        $display("smode_plic test passed");
        $finish();
    }
}
