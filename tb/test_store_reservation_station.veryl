// Unit test for store_reservation_station:
// dispatch 2 stores, wake rs1 of first via CDB, then rs2 of first,
// issue fires for store0 in order. Store1 issues next cycle.
module test_store_reservation_station_harness (
    clk       : input  clock    ,
    rst       : input  reset    ,
    o_cycle   : output logic<16>,
    o_saw0    : output logic    ,
    o_saw1    : output logic    ,
    o_s0_s1   : output logic<64>,
    o_s0_s2   : output logic<64>,
    o_s0_rob  : output logic<5> ,
    o_s1_rob  : output logic<5> ,
    o_order_ok: output logic    ,
    o_done    : output logic    ,
    o_pass    : output logic    ,
) {
    var cyc             : logic<16>     ;
    var squash_mask_zero: logic     [32];
    always_comb {
        for i: i32 in 0..32 {
            squash_mask_zero[i] = 1'b0;
        }
    }
    always_ff (clk, rst) {
        if_reset {
            cyc = 16'd0;
        } else {
            cyc = cyc + 16'd1;
        }
    }

    // Dispatch sequence:
    //   cyc 2: store0 (rob=5, rs1 pending tag=3, rs2 pending tag=4)
    //   cyc 3: store1 (rob=6, both ready immediately, data=0xAA / addr base=0x200)
    // CDB broadcasts:
    //   cyc 4: cdb0 rob=3 data=0x100  → store0.rs1 ready
    //   cyc 5: cdb1 rob=4 data=0x55   → store0.rs2 ready → issue next cycle
    // Expected issues (in order):
    //   cyc 7: store0 (rob=5, s1=0x100, s2=0x55)
    //   cyc 8: store1 (rob=6, s1=0x200, s2=0xAA)
    var disp_valid  : logic    ;
    var disp_rob    : logic<5> ;
    var disp_s1_rdy : logic    ;
    var disp_s1_tag : logic<5> ;
    var disp_s1_data: logic<64>;
    var disp_s2_rdy : logic    ;
    var disp_s2_tag : logic<5> ;
    var disp_s2_data: logic<64>;
    var cdb0_valid  : logic    ;
    var cdb0_rob    : logic<5> ;
    var cdb0_data   : logic<64>;
    var cdb1_valid  : logic    ;
    var cdb1_rob    : logic<5> ;
    var cdb1_data   : logic<64>;

    always_comb {
        disp_valid    = cyc == 16'd2 || cyc == 16'd3;
        disp_rob      = if cyc == 16'd2 ? 5'd5 : 5'd6;
        // store0 both operands pending; store1 both ready.
        disp_s1_rdy   = cyc == 16'd3;
        disp_s1_tag   = if cyc == 16'd2 ? 5'd3 : 5'd0;
        disp_s1_data  = if cyc == 16'd3 ? 64'h0000000000000200 : 64'd0;
        disp_s2_rdy   = cyc == 16'd3;
        disp_s2_tag   = if cyc == 16'd2 ? 5'd4 : 5'd0;
        disp_s2_data  = if cyc == 16'd3 ? 64'h00000000000000AA : 64'd0;
        cdb0_valid    = cyc == 16'd4;
        cdb0_rob      = 5'd3;
        cdb0_data     = 64'h0000000000000100;
        cdb1_valid    = cyc == 16'd5;
        cdb1_rob      = 5'd4;
        cdb1_data     = 64'h0000000000000055;
    }

    var issue_valid : logic    ;
    var issue_pc    : logic<64>;
    var issue_imm   : logic<64>;
    var issue_funct3: logic<3> ;
    var issue_rs1   : logic<5> ;
    var issue_rs2   : logic<5> ;
    var issue_s1    : logic<64>;
    var issue_s2    : logic<64>;
    var issue_rob   : logic<5> ;
    var issue_epoch : logic<2> ;
    var disp_ready  : logic    ;
    var srs_count   : logic<3> ;
    var srs_full    : logic    ;
    var srs_empty   : logic    ;

    inst u_srs: store_reservation_station (
        clk                                       ,
        rst                                       ,
        i_dispatch_valid   : disp_valid           ,
        i_dispatch_pc      : 64'h2000             ,
        i_dispatch_imm     : 64'd0                ,
        i_dispatch_funct3  : 3'd3                 , // SD
        i_dispatch_rs1     : 5'd10                ,
        i_dispatch_rs2     : 5'd11                ,
        i_dispatch_rob     : disp_rob             ,
        i_dispatch_epoch   : 2'd0                 ,
        i_dispatch_s1_ready: disp_s1_rdy          ,
        i_dispatch_s1_tag  : disp_s1_tag          ,
        i_dispatch_s1_epoch: 2'd0                 ,
        i_dispatch_s1_data : disp_s1_data         ,
        i_dispatch_s2_ready: disp_s2_rdy          ,
        i_dispatch_s2_tag  : disp_s2_tag          ,
        i_dispatch_s2_epoch: 2'd0                 ,
        i_dispatch_s2_data : disp_s2_data         ,
        o_dispatch_ready   : disp_ready           ,
        o_issue_valid      : issue_valid          ,
        o_issue_pc         : issue_pc             ,
        o_issue_imm        : issue_imm            ,
        o_issue_funct3     : issue_funct3         ,
        o_issue_rs1        : issue_rs1            ,
        o_issue_rs2        : issue_rs2            ,
        o_issue_s1_data    : issue_s1             ,
        o_issue_s2_data    : issue_s2             ,
        o_issue_rob        : issue_rob            ,
        o_issue_epoch      : issue_epoch          ,
        i_issue_stall      : 1'b0                 ,
        i_cdb0_valid       : cdb0_valid           ,
        i_cdb0_rob         : cdb0_rob             ,
        i_cdb0_epoch       : 2'd0                 ,
        i_cdb0_data        : cdb0_data            ,
        i_cdb1_valid       : cdb1_valid           ,
        i_cdb1_rob         : cdb1_rob             ,
        i_cdb1_epoch       : 2'd0                 ,
        i_cdb1_data        : cdb1_data            ,
        i_cdb2_valid       : 1'b0                 ,
        i_cdb2_rob         : 5'd0                 ,
        i_cdb2_epoch       : 2'd0                 ,
        i_cdb2_data        : 64'd0                ,
        i_flush            : 1'b0                 ,
        i_squash_valid     : 1'b0                 ,
        i_squash_mask      : squash_mask_zero     ,
        o_count            : srs_count            ,
        o_full             : srs_full             ,
        o_empty            : srs_empty            ,
    );

    // Track the first two issues and verify order + data.
    var saw0     : logic    ;
    var saw0_s1  : logic<64>;
    var saw0_s2  : logic<64>;
    var saw0_rob : logic<5> ;
    var saw1     : logic    ;
    var saw1_rob : logic<5> ;
    var order_ok : logic    ;
    always_ff (clk, rst) {
        if_reset {
            saw0     = 1'b0;
            saw0_s1  = 64'd0;
            saw0_s2  = 64'd0;
            saw0_rob = 5'd0;
            saw1     = 1'b0;
            saw1_rob = 5'd0;
            order_ok = 1'b1;
        } else if issue_valid {
            if !saw0 {
                saw0     = 1'b1;
                saw0_s1  = issue_s1;
                saw0_s2  = issue_s2;
                saw0_rob = issue_rob;
                // Require first issue to be store0 (rob=5).
                if issue_rob != 5'd5 {
                    order_ok = 1'b0;
                }
            } else if !saw1 {
                saw1     = 1'b1;
                saw1_rob = issue_rob;
                if issue_rob != 5'd6 {
                    order_ok = 1'b0;
                }
            }
        }
    }

    assign o_cycle    = cyc;
    assign o_saw0     = saw0;
    assign o_saw1     = saw1;
    assign o_s0_s1    = saw0_s1;
    assign o_s0_s2    = saw0_s2;
    assign o_s0_rob   = saw0_rob;
    assign o_s1_rob   = saw1_rob;
    assign o_order_ok = order_ok;
    assign o_done     = cyc >: 16'd20;
    assign o_pass     = saw0 && saw1 && order_ok
                     && saw0_s1 == 64'h0000000000000100
                     && saw0_s2 == 64'h0000000000000055
                     && saw0_rob == 5'd5
                     && saw1_rob == 5'd6;
}

#[test(test_store_reservation_station)]
module test_store_reservation_station {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen;

    var cycle   : logic<16>;
    var saw0    : logic    ;
    var saw1    : logic    ;
    var s0_s1   : logic<64>;
    var s0_s2   : logic<64>;
    var s0_rob  : logic<5> ;
    var s1_rob  : logic<5> ;
    var order_ok: logic    ;
    var done    : logic    ;
    var pass    : logic    ;

    inst harness: test_store_reservation_station_harness (
        clk                 ,
        rst                 ,
        o_cycle   : cycle   ,
        o_saw0    : saw0    ,
        o_saw1    : saw1    ,
        o_s0_s1   : s0_s1   ,
        o_s0_s2   : s0_s2   ,
        o_s0_rob  : s0_rob  ,
        o_s1_rob  : s1_rob  ,
        o_order_ok: order_ok,
        o_done    : done    ,
        o_pass    : pass    ,
    );

    initial {
        rst.assert(clk);
        for _i: i32 in 0..30 {
            clk.next(1);
        }
        $display("cycle=%d saw0=%d saw1=%d s0_s1=%h s0_s2=%h s0_rob=%d s1_rob=%d order_ok=%d",
                 cycle, saw0, saw1, s0_s1, s0_s2, s0_rob, s1_rob, order_ok);
        $assert (pass, "store_reservation_station: in-order issue with CDB wakeup failed");
        $display("store_reservation_station test passed");
        $finish ();
    }
}
