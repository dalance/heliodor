// Direct fpu_wrap probe for the int->FP inexact (NX) flag.  Drives the six
// FCVT.{S,D}.{W,WU,L,LU} ops on inexact and exact magnitudes and checks
// o_fflags[0] (NX).  This exercises the int_to_fp_inexact helper called from
// the fflags block's `if` conditions — the path that the (now reverted)
// cvt_int_nx workaround used to avoid (it tripped a veryl simulator bug where a
// function call in an `if` condition always read 0; fixed in veryl cb8ba0ce).
#[test(test_fpcvt_nx)]
module test_fpcvt_nx {
    import fpu_pkg::FpuOp;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var op    : FpuOp              ;
    var rs1   : logic<64>          ;
    var fflags: logic<5>           ;
    var busy  : logic              ;
    var fwen  : logic              ;
    var cdb   : pipeline_pkg::CdbBus;

    inst dut: fpu_wrap (
        clk                            ,
        rst                            ,
        i_issue_valid     : 1'b1       ,
        i_fpu_op          : op         ,
        i_fp_rm           : 3'b000     , // RNE (static)
        i_fli_idx         : 5'd0       ,
        i_frm             : 3'b000     ,
        i_issue_rd_pdst   : 6'd0       ,
        i_issue_rob_idx   : 5'd0       ,
        i_issue_has_rd    : 1'b1       ,
        i_issue_writes_int: 1'b0       ,
        i_s1_data         : 64'd0      ,
        i_s2_data         : 64'd0      ,
        i_s3_data         : 64'd0      ,
        i_int_rs1_data    : rs1        ,
        i_flush           : 1'b0       ,
        o_fpu_busy        : busy       ,
        o_cdb             : cdb        ,
        o_fflags          : fflags     ,
        o_fflags_wen      : fwen       ,
    );

    // fcvt is single-cycle combinational: drive op/rs1, settle, read o_fflags[0].
    function check (
        e_op : input FpuOp     ,
        e_rs1: input logic<64> ,
    ) {
        op  = e_op;
        rs1 = e_rs1;
    }

    initial {
        rst.assert(clk);
        clk.next(2);

        // FCVT.S.L of 2^24 + 1 -> inexact in single -> NX = 1
        check(FpuOp::FCVT_S_L, 64'd16777217);
        clk.next (1);
        $assert  (fflags[0] == 1'b1, "FCVT.S.L inexact: NX not raised");

        // FCVT.S.L of 5 -> exact -> NX = 0
        check(FpuOp::FCVT_S_L, 64'd5);
        clk.next (1);
        $assert  (fflags[0] == 1'b0, "FCVT.S.L exact: NX wrongly raised");

        // FCVT.S.L of -(2^24 + 1) -> inexact (magnitude rounds) -> NX = 1
        check(FpuOp::FCVT_S_L, 64'hFFFFFFFF_FEFFFFFF);
        clk.next (1);
        $assert  (fflags[0] == 1'b1, "FCVT.S.L negative inexact: NX not raised");

        // FCVT.S.W of 2^24 + 1 (fits int32) -> inexact -> NX = 1
        check(FpuOp::FCVT_S_W, 64'd16777217);
        clk.next (1);
        $assert  (fflags[0] == 1'b1, "FCVT.S.W inexact: NX not raised");

        // FCVT.S.WU of 2^24 + 1 -> inexact -> NX = 1
        check(FpuOp::FCVT_S_WU, 64'd16777217);
        clk.next (1);
        $assert  (fflags[0] == 1'b1, "FCVT.S.WU inexact: NX not raised");

        // FCVT.S.LU of 2^24 + 1 -> inexact -> NX = 1
        check(FpuOp::FCVT_S_LU, 64'd16777217);
        clk.next (1);
        $assert  (fflags[0] == 1'b1, "FCVT.S.LU inexact: NX not raised");

        // FCVT.D.L of 2^53 + 1 -> inexact in double -> NX = 1
        check(FpuOp::FCVT_D_L, 64'd9007199254740993);
        clk.next (1);
        $assert  (fflags[0] == 1'b1, "FCVT.D.L inexact: NX not raised");

        // FCVT.D.L of 5 -> exact -> NX = 0
        check(FpuOp::FCVT_D_L, 64'd5);
        clk.next (1);
        $assert  (fflags[0] == 1'b0, "FCVT.D.L exact: NX wrongly raised");

        // FCVT.D.LU of 2^53 + 1 -> inexact -> NX = 1
        check(FpuOp::FCVT_D_LU, 64'd9007199254740993);
        clk.next (1);
        $assert  (fflags[0] == 1'b1, "FCVT.D.LU inexact: NX not raised");

        $display ("test_fpcvt_nx passed");
        $finish  ();
    }
}
