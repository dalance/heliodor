// cfg_w4 with an 8-line store buffer, for test_lsu: its random program never
// holds more than 14 lines in the sb, so the urgent drain of a 16-line sb does
// not fire there. Every other value is cfg_w4's.
pub package cfg_w4_sb8 for core_cfg {
    import opclass_pkg::*;

    const FETCH_W    : u32 = cfg_w4::FETCH_W;
    const RENAME_W   : u32 = cfg_w4::RENAME_W;
    const ISSUE_W    : u32 = cfg_w4::ISSUE_W;
    const MEM_W      : u32 = cfg_w4::MEM_W;
    const COMMIT_W   : u32 = cfg_w4::COMMIT_W;
    const FETCH_BYTES: u32 = cfg_w4::FETCH_BYTES;
    const ROB_N      : u32 = cfg_w4::ROB_N;
    const LQ_N       : u32 = cfg_w4::LQ_N;
    const SQ_N       : u32 = cfg_w4::SQ_N;
    const SB_N       : u32 = 8;
    const FTQ_N      : u32 = cfg_w4::FTQ_N;
    const PRF_INT_N  : u32 = cfg_w4::PRF_INT_N;
    const PRF_FP_N   : u32 = cfg_w4::PRF_FP_N;
    const NUM_CKPT   : u32 = cfg_w4::NUM_CKPT;
    const FBQ_N      : u32 = cfg_w4::FBQ_N;
    const DQ_N       : u32 = cfg_w4::DQ_N;
    const RQ_N       : u32 = cfg_w4::RQ_N;
    const PRED_META_W: u32 = cfg_w4::PRED_META_W;
    const PRED_CKPT_W: u32 = cfg_w4::PRED_CKPT_W;
    const DTLB_N     : u32 = cfg_w4::DTLB_N;
    const ITLB_N     : u32 = cfg_w4::ITLB_N;
    const PTW_D_QN   : u32 = cfg_w4::PTW_D_QN;
    const PTW_I_QN   : u32 = cfg_w4::PTW_I_QN;
    const REISSUE_W  : u32 = cfg_w4::REISSUE_W;
    const DC_NB      : u32 = cfg_w4::DC_NB;
    const MSHR_N     : u32 = cfg_w4::MSHR_N;
    const PORT_FU    : FuSet [ISSUE_W] = cfg_w4::PORT_FU;
    const PORT_IQ    : u32   [ISSUE_W] = cfg_w4::PORT_IQ;
    const N_IQ       : u32 = cfg_w4::N_IQ;
    const MEM_IQ     : u32 = cfg_w4::MEM_IQ;
    const IQ_N       : u32   [N_IQ] = cfg_w4::IQ_N;
    const IQ_NSRC    : u32   [N_IQ] = cfg_w4::IQ_NSRC;
}
