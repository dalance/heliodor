// mc_perf_acc: accumulates heliodor_soc_smp's o_mc_perf (soc_pkg::McPerf).
// Counts, while i_en, the cycles each bit is 1 and prints them once at the
// rising edge of i_dump:
//   PERF 0 <perf_w> <width> 0 0 0 0 0   layout line, core 0 = the SoC's mem_ctrl
//   PB 0 <bit> <count>                  nonzero bits only, bit 0 = LSB of McPerf
//   MC ...                              the scalar counts and, per transaction
//                                       class, the summed latency of its vector
// test/gates/fire_check.py names the PB bits from the struct source.
module mc_perf_acc (
    clk   : input clock          ,
    rst   : input reset          ,
    i_perf: input soc_pkg::McPerf,
    i_en  : input logic          ,
    i_dump: input logic          ,
) {
    const W: u32 = $bits(soc_pkg::McPerf);
    const N: u32 = soc_pkg::MC_PERF_N;

    function ones (
        v: input logic<N>,
    ) -> logic<64> {
        var n: logic<64>;
        n = 64'd0;
        for i in 0..N {
            n += {63'd0, v[i]};
        }
        return n;
    }

    var bits: logic<W>;
    assign bits = i_perf;

    var dump_q: logic;
    always_ff {
        if_reset {
            dump_q = 1'b0;
        } else {
            dump_q = i_dump;
        }
    }
    let dump: logic = i_dump && !dump_q;

    for i in 0..W :g_bit {
        var cnt: logic<64>;
        always_ff {
            if_reset {
                cnt = 64'd0;
            } else if i_en && bits[i] {
                cnt = cnt + 64'd1;
            }
        }
        always_ff {
            if_reset {} else if dump && cnt != 64'd0 {
                $display("PB 0 %d %d", i, cnt);
            }
        }
    }

    var t_line : logic<64>;
    var t_dram1: logic<64>;
    var t_rom  : logic<64>;
    var t_wr   : logic<64>;
    var c_line : logic<64>;
    var c_dram1: logic<64>;
    var c_rom  : logic<64>;
    var c_aw   : logic<64>;
    var c_w    : logic<64>;
    var c_i1   : logic<64>;
    var c_arw  : logic<64>;
    var c_arbp : logic<64>;
    var c_wbf  : logic<64>;
    var c_abort: logic<64>;
    var c_rerr : logic<64>;
    var c_berr : logic<64>;
    always_ff {
        if_reset {
            t_line  = 64'd0;
            t_dram1 = 64'd0;
            t_rom   = 64'd0;
            t_wr    = 64'd0;
            c_line  = 64'd0;
            c_dram1 = 64'd0;
            c_rom   = 64'd0;
            c_aw    = 64'd0;
            c_w     = 64'd0;
            c_i1    = 64'd0;
            c_arw   = 64'd0;
            c_arbp  = 64'd0;
            c_wbf   = 64'd0;
            c_abort = 64'd0;
            c_rerr  = 64'd0;
            c_berr  = 64'd0;
        } else if i_en {
            t_line  += ones(i_perf.lat_line);
            t_dram1 += ones(i_perf.lat_dram1);
            t_rom   += ones(i_perf.lat_rom);
            t_wr    += ones(i_perf.lat_wr);
            c_line  += {63'd0, i_perf.ar_line};
            c_dram1 += {63'd0, i_perf.ar_dram1};
            c_rom   += {63'd0, i_perf.ar_rom};
            c_aw    += {63'd0, i_perf.aw};
            c_w     += {63'd0, i_perf.w_beat};
            c_i1    += {63'd0, i_perf.i1_hold};
            c_arw   += {63'd0, i_perf.ar_wait};
            c_arbp  += {63'd0, i_perf.ar_bp};
            c_wbf   += {63'd0, i_perf.wb_full};
            c_abort += {63'd0, i_perf.inst_abort};
            c_rerr  += {63'd0, i_perf.r_err};
            c_berr  += {63'd0, i_perf.b_err};
        }
    }

    always_ff {
        if_reset {} else if dump {
            $display("PERF 0 %d %d 0 0 0 0 0", W, W);
            $display("MC line=%d line_lat=%d dram1=%d dram1_lat=%d rom=%d rom_lat=%d", c_line, t_line, c_dram1, t_dram1, c_rom,
                t_rom);
            $display("MC aw=%d w_beat=%d wr_lat=%d wb_full=%d i1_hold=%d ar_wait=%d ar_bp=%d inst_abort=%d", c_aw, c_w, t_wr,
                c_wbf, c_i1, c_arw, c_arbp, c_abort);
            $display("MC r_err=%d b_err=%d", c_rerr, c_berr);
        }
    }
}
