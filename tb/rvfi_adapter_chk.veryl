// rvfi_adapter_chk: one hart's retire records and rvfi_adapter's view of
// them, checked against each other and against the record stream itself
// (riscv-formal's register and intr rules).
//
// Prints its counts at i_dump. Instantiated by arch_soc_harness with
// RVFI_CHK.
//   o_err  : sticky, bit 0 a lane differs from its record, bit 1 a source
//            value differs from the last value written to that register,
//            bit 2 rvfi_intr is not set exactly on the first record after a
//            trap record or an interrupt, bit 3 a CSR read differs from the
//            rd it wrote, bit 4 an unused source has a register or value
//   o_idle : registered, no record or no source value checked yet; a run
//            that ends with it set checked nothing and must not pass
module rvfi_adapter_chk #(
    param NRET: u32 = 2,
) (
    clk        : input  clock                             ,
    rst        : input  reset                             ,
    i_retire   : input  retire_pkg::RetireRec      [NRET],
    i_retire_dm: input  logic                             ,
    i_irq_evt  : input  retire_pkg::IrqEvent              ,
    i_dump     : input  logic                             ,
    o_err      : output logic                  <5>        ,
    o_idle     : output logic                             ,
) {
    import retire_pkg::*;

    var valid    : logic<NRET>     ;
    var order    : logic<NRET * 64>;
    var insn     : logic<NRET * 32>;
    var trap     : logic<NRET>     ;
    var intr     : logic<NRET>     ;
    var mode     : logic<NRET * 2> ;
    var rs1_addr : logic<NRET * 5> ;
    var rs2_addr : logic<NRET * 5> ;
    var rs1_rdata: logic<NRET * 64>;
    var rs2_rdata: logic<NRET * 64>;
    var rd_addr  : logic<NRET * 5> ;
    var rd_wdata : logic<NRET * 64>;
    var pc_rdata : logic<NRET * 64>;
    var pc_wdata : logic<NRET * 64>;
    var mem_addr : logic<NRET * 64>;
    var mem_rmask: logic<NRET * 8> ;
    var mem_wmask: logic<NRET * 8> ;
    var mem_rdata: logic<NRET * 64>;
    var mem_wdata: logic<NRET * 64>;
    var csr_addr : logic<NRET * 12>;
    var csr_rmask: logic<NRET * 64>;
    var csr_wmask: logic<NRET * 64>;
    var csr_rdata: logic<NRET * 64>;
    var csr_wdata: logic<NRET * 64>;
    var mst_rdata: logic<NRET * 64>;
    var frs1_addr: logic<NRET * 5> ;
    var frs3_data: logic<NRET * 64>;
    var frd_addr : logic<NRET * 5> ;
    var frd_wdata: logic<NRET * 64>;
    var frs1_rv  : logic<NRET>     ;
    var frd_wv   : logic<NRET>     ;
    var fcs_rmask: logic<NRET * 64>;
    var fcs_rdata: logic<NRET * 64>;
    var satp_wdat: logic<NRET * 64>;

    inst u_rvfi: rvfi_adapter #(
        NRET: NRET,
    ) (
        i_retire                ,
        i_retire_dm             ,
        i_halt                  : '{default: 1'b0},
        rvfi_valid              : valid    ,
        rvfi_order              : order    ,
        rvfi_insn               : insn     ,
        rvfi_trap               : trap     ,
        rvfi_halt               : _        ,
        rvfi_intr               : intr     ,
        rvfi_mode               : mode     ,
        rvfi_ixl                : _        ,
        rvfi_rs1_addr           : rs1_addr ,
        rvfi_rs2_addr           : rs2_addr ,
        rvfi_rs1_rdata          : rs1_rdata,
        rvfi_rs2_rdata          : rs2_rdata,
        rvfi_rd_addr            : rd_addr  ,
        rvfi_rd_wdata           : rd_wdata ,
        rvfi_pc_rdata           : pc_rdata ,
        rvfi_pc_wdata           : pc_wdata ,
        rvfi_mem_addr           : mem_addr ,
        rvfi_mem_rmask          : mem_rmask,
        rvfi_mem_wmask          : mem_wmask,
        rvfi_mem_rdata          : mem_rdata,
        rvfi_mem_wdata          : mem_wdata,
        rvfi_csr_misa_rmask     : _        ,
        rvfi_csr_misa_wmask     : _        ,
        rvfi_csr_misa_rdata     : _        ,
        rvfi_csr_misa_wdata     : _        ,
        rvfi_csr_mstatus_rmask  : _        ,
        rvfi_csr_mstatus_wmask  : _        ,
        rvfi_csr_mstatus_rdata  : mst_rdata,
        rvfi_csr_mstatus_wdata  : _        ,
        rvfi_csr_mtvec_rmask    : _        ,
        rvfi_csr_mtvec_wmask    : _        ,
        rvfi_csr_mtvec_rdata    : _        ,
        rvfi_csr_mtvec_wdata    : _        ,
        rvfi_csr_mscratch_rmask : _        ,
        rvfi_csr_mscratch_wmask : _        ,
        rvfi_csr_mscratch_rdata : _        ,
        rvfi_csr_mscratch_wdata : _        ,
        rvfi_csr_mepc_rmask     : _        ,
        rvfi_csr_mepc_wmask     : _        ,
        rvfi_csr_mepc_rdata     : _        ,
        rvfi_csr_mepc_wdata     : _        ,
        rvfi_csr_mcause_rmask   : _        ,
        rvfi_csr_mcause_wmask   : _        ,
        rvfi_csr_mcause_rdata   : _        ,
        rvfi_csr_mcause_wdata   : _        ,
        rvfi_csr_mcycle_rmask   : _        ,
        rvfi_csr_mcycle_wmask   : _        ,
        rvfi_csr_mcycle_rdata   : _        ,
        rvfi_csr_mcycle_wdata   : _        ,
        rvfi_csr_minstret_rmask : _        ,
        rvfi_csr_minstret_wmask : _        ,
        rvfi_csr_minstret_rdata : _        ,
        rvfi_csr_minstret_wdata : _        ,
        rvfi_csr_satp_rmask     : _        ,
        rvfi_csr_satp_wmask     : _        ,
        rvfi_csr_satp_rdata     : _        ,
        rvfi_csr_satp_wdata     : satp_wdat,
        rvfi_csr_fcsr_rmask     : fcs_rmask,
        rvfi_csr_fcsr_wmask     : _        ,
        rvfi_csr_fcsr_rdata     : fcs_rdata,
        rvfi_csr_fcsr_wdata     : _        ,
        rvfi_csr_addr           : csr_addr ,
        rvfi_csr_rmask          : csr_rmask,
        rvfi_csr_wmask          : csr_wmask,
        rvfi_csr_rdata          : csr_rdata,
        rvfi_csr_wdata          : csr_wdata,
        rvfi_frs1_addr          : frs1_addr,
        rvfi_frs1_rvalid        : frs1_rv  ,
        rvfi_frs1_rdata         : _        ,
        rvfi_frs2_addr          : _        ,
        rvfi_frs2_rvalid        : _        ,
        rvfi_frs2_rdata         : _        ,
        rvfi_frs3_addr          : _        ,
        rvfi_frs3_rvalid        : _        ,
        rvfi_frs3_rdata         : frs3_data,
        rvfi_frd_addr           : frd_addr ,
        rvfi_frd_wvalid         : frd_wv   ,
        rvfi_frd_wdata          : frd_wdata,
        rvfi_fflags             : _        ,
        rvfi_rd2_addr           : _        ,
        rvfi_rd2_wdata          : _        ,
        rvfi_mem_paddr          : _        ,
        rvfi_mem_io             : _        ,
        rvfi_mem_rmask_hi       : _        ,
        rvfi_mem_wmask_hi       : _        ,
        rvfi_mem_rdata_hi       : _        ,
        rvfi_mem_wdata_hi       : _        ,
        rvfi_virt               : _        ,
        rvfi_dm                 : _        ,
        rvfi_v_valid            : _        ,
        rvfi_v_vrf_wcnt         : _        ,
        rvfi_v_vrf_hash         : _        ,
        rvfi_v_vtype            : _        ,
        rvfi_v_vl               : _        ,
        rvfi_v_vstart           : _        ,
    );

    // Shadow register files, written in record order; every register is 0
    // out of reset.
    var xr_q  : logic<64> [32];
    var fr_q  : logic<64> [32];
    var xr    : logic<64> [32];
    var fr    : logic<64> [32];
    var intr_q: logic          ; // the next record is a handler's first
    var nxt_i : logic          ;
    var err   : logic<5>       ;
    var n_rec : logic<32>      ;
    var n_src : logic<32>      ;
    var n_csr : logic<32>      ;
    var n_intr: logic<32>      ;

    function src_ok (
        kind: input RdKind    ,
        addr: input logic<5>  ,
        v   : input logic<64> ,
        xv  : input logic<64> ,
        fv  : input logic<64> ,
    ) -> logic {
        return case kind {
            RdKind::INT: v == xv,
            RdKind::FP : v == fv,
            default    : 1'b1,
        };
    }

    always_comb {
        xr     = xr_q;
        fr     = fr_q;
        nxt_i  = intr_q || i_irq_evt.valid;
        err    = 5'd0;
        n_rec  = 0;
        n_src  = 0;
        n_csr  = 0;
        n_intr = 0;
        for l in 0..NRET {
            let r  : RetireRec = i_retire[l];
            let ok : logic     = r.valid && !r.trap;
            let xrd: logic     = ok && r.rd_kind == RdKind::INT && r.rd_addr != 5'd0;
            let frd: logic     = ok && r.rd_kind == RdKind::FP;
            let mem: logic     = ok && !r.vec_v && (r.mem_rmask | r.mem_wmask) != 16'd0;
            let fm : logic<64> = case r.csr_addr {
                12'h001: 64'h1f,
                12'h002: 64'he0,
                12'h003: 64'hff,
                default: 64'h0,
            };
            let fd: logic<64> = case r.csr_addr {
                12'h001: {59'd0, r.csr_rdata[4:0]},
                12'h002: {56'd0, r.csr_rdata[2:0], 5'd0},
                12'h003: {56'd0, r.csr_rdata[7:0]},
                default: 64'h0,
            };

            if valid[l] != r.valid || (r.valid && (order[l * 64+:64] != r.order || insn[l * 32+:32] != r.insn
                || trap[l] != r.trap || mode[l * 2+:2] != r.priv || pc_rdata[l * 64+:64] != r.pc
                || pc_wdata[l * 64+:64] != r.next_pc)) {
                err[0] = 1'b1;
            }
            if rd_addr[l * 5+:5] != (if xrd ? r.rd_addr : 5'd0) || rd_wdata[l * 64+:64] != (if xrd ? r.rd_wdata : 64'd0)
                || frd_addr[l * 5+:5] != (if frd ? r.rd_addr : 5'd0) || frd_wdata[l * 64+:64] != (if frd ? r.rd_wdata : 64'd0) {
                err[0] = 1'b1;
            }
            if rs1_addr[l * 5+:5] != (if r.rs1_kind == RdKind::INT ? r.rs1_addr : 5'd0)
                || rs2_rdata[l * 64+:64] != (if r.rs2_kind == RdKind::INT ? r.rs2_rdata : 64'd0)
                || frs1_addr[l * 5+:5] != (if r.rs1_kind == RdKind::FP ? r.rs1_addr : 5'd0)
                || frs1_rv[l] != (r.rs1_kind == RdKind::FP) || frd_wv[l] != frd
                || frs3_data[l * 64+:64] != (if r.rs3_kind == RdKind::FP ? r.rs3_rdata : 64'd0) {
                err[0] = 1'b1;
            }
            if mem_addr[l * 64+:64] != (if mem ? r.mem_vaddr : 64'd0) || mem_rmask[l * 8+:8] != (if mem ? r.mem_rmask[7:0] : 8'd0)
                || mem_wmask[l * 8+:8] != (if mem ? r.mem_wmask[7:0] : 8'd0)
                || mem_rdata[l * 64+:64] != (if mem ? r.mem_rdata : 64'd0)
                || mem_wdata[l * 64+:64] != (if mem ? r.mem_wdata : 64'd0) {
                err[0] = 1'b1;
            }
            if ok && (r.csr_read || r.csr_valid) {
                if csr_addr[l * 12+:12] != r.csr_addr || csr_rmask[l * 64+:64] != (if r.csr_read ? 64'hffff_ffff_ffff_ffff : 64'd0)
                    || csr_wmask[l * 64+:64] != (if r.csr_valid ? 64'hffff_ffff_ffff_ffff : 64'd0)
                    || csr_rdata[l * 64+:64] != (if r.csr_read ? r.csr_rdata : 64'd0)
                    || csr_wdata[l * 64+:64] != (if r.csr_valid ? r.csr_new : 64'd0)
                    || mst_rdata[l * 64+:64] != (if r.csr_read && r.csr_addr == 12'h300 ? r.csr_rdata : 64'd0)
                    || satp_wdat[l * 64+:64] != (if r.csr_valid && r.csr_addr == 12'h180 ? r.csr_new : 64'd0)
                    || fcs_rmask[l * 64+:64] != (if r.csr_read ? fm : 64'd0)
                    || fcs_rdata[l * 64+:64] != (if r.csr_read ? fd : 64'd0) {
                    err[0] = 1'b1;
                }
            } else if csr_addr[l * 12+:12] != 12'd0 || csr_rmask[l * 64+:64] != 64'd0 || csr_wmask[l * 64+:64] != 64'd0 {
                err[0] = 1'b1;
            }

            if r.valid {
                n_rec += 1;
                if intr[l] != nxt_i {
                    err[2] = 1'b1;
                }
                n_intr += {31'd0, intr[l]};
                nxt_i = r.trap;
                if ok {
                    if !src_ok(r.rs1_kind, r.rs1_addr, r.rs1_rdata, xr[r.rs1_addr], fr[r.rs1_addr])
                        || !src_ok(r.rs2_kind, r.rs2_addr, r.rs2_rdata, xr[r.rs2_addr], fr[r.rs2_addr])
                        || !src_ok(r.rs3_kind, r.rs3_addr, r.rs3_rdata, xr[r.rs3_addr], fr[r.rs3_addr]) {
                        err[1] = 1'b1;
                    }
                    n_src += {31'd0, r.rs1_kind != RdKind::NONE} + {31'd0, r.rs2_kind != RdKind::NONE}
                        + {31'd0, r.rs3_kind != RdKind::NONE};
                }
                if (r.rs1_kind == RdKind::NONE && (r.rs1_addr != 5'd0 || r.rs1_rdata != 64'd0))
                    || (r.rs2_kind == RdKind::NONE && (r.rs2_addr != 5'd0 || r.rs2_rdata != 64'd0))
                    || (r.rs3_kind == RdKind::NONE && (r.rs3_addr != 5'd0 || r.rs3_rdata != 64'd0)) {
                    err[4] = 1'b1;
                }
                if ok && r.csr_read {
                    n_csr += 1;
                    if xrd && r.csr_rdata != r.rd_wdata {
                        err[3] = 1'b1;
                    }
                }
                if xrd {
                    xr[r.rd_addr] = r.rd_wdata;
                }
                if frd {
                    fr[r.rd_addr] = r.rd_wdata;
                }
                if ok && r.rd2_valid {
                    xr[r.rd_addr + 5'd1] = r.rd2_wdata;
                }
            }
        }
    }

    var c_rec   : logic<32>;
    var c_src   : logic<32>;
    var c_csr   : logic<32>;
    var c_intr  : logic<32>;
    var dumped_q: logic    ;
    assign o_idle = c_rec == 0 || c_src == 0;

    always_ff {
        if_reset {
            xr_q     = '{default: 64'd0};
            fr_q     = '{default: 64'd0};
            intr_q   = 1'b0;
            o_err    = 5'd0;
            c_rec    = 0;
            c_src    = 0;
            c_csr    = 0;
            c_intr   = 0;
            dumped_q = 1'b0;
        } else {
            xr_q   = xr;
            fr_q   = fr;
            intr_q = nxt_i;
            o_err  = o_err | err;
            c_rec  = c_rec + n_rec;
            c_src  = c_src + n_src;
            c_csr  = c_csr + n_csr;
            c_intr = c_intr + n_intr;
            if i_dump && !dumped_q {
                dumped_q = 1'b1;
                $display("rvfi_chk: err=%b records=%d sources=%d csr_reads=%d intr=%d", o_err | err, c_rec + n_rec,
                    c_src + n_src, c_csr + n_csr, c_intr + n_intr);
            }
        }
    }
}
