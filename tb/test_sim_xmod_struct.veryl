// Minimal repro for the v4 AUIPC base.pc+4 cross-module struct-field bug.
//
// Pattern: producer module increments pc_q each cycle and stores it
// into the .pc field of a struct output. Consumer module reads the
// .pc field of the input struct and latches it. Across this combinational
// wire boundary the consumer should see the CURRENT (= old, clock-stable)
// pc_q, not the post-advance new value.
//
// If Veryl JIT sim evaluates the producer's pc_q advance before the
// consumer's read, the consumer latches pc+4 instead of pc.

package test_sim_xmod_pkg {
    struct PcBundle {
        pc:    logic<32>,
        instr: logic<32>,
    }
}

module test_sim_xmod_struct_producer (
    clk    : input  clock                          ,
    rst    : input  reset                          ,
    o_bun  : output test_sim_xmod_pkg::PcBundle    ,
) {
    var pc_q: logic<32>;
    var bun_q: test_sim_xmod_pkg::PcBundle;
    always_ff (clk, rst) {
        if_reset {
            pc_q     = 32'd0;
            bun_q.pc    = 32'd0;
            bun_q.instr = 32'd0;
        } else {
            bun_q.pc    = pc_q;        // latch OLD pc_q
            bun_q.instr = 32'hdeadbeef;
            pc_q        = pc_q + 32'd4;
        }
    }
    assign o_bun = bun_q;
}

module test_sim_xmod_struct_consumer (
    clk         : input  clock                          ,
    rst         : input  reset                          ,
    i_bun       : input  test_sim_xmod_pkg::PcBundle    ,
    o_latched_pc: output logic<32>                      ,
) {
    var latched_pc: logic<32>;
    always_ff (clk, rst) {
        if_reset {
            latched_pc = 32'd0;
        } else {
            // Read the .pc field directly from the input struct.
            // Should see the value bun_q.pc was written to LAST clock edge.
            latched_pc = i_bun.pc;
        }
    }
    assign o_latched_pc = latched_pc;
}

module test_sim_xmod_struct_harness (
    clk          : input  clock     ,
    rst          : input  reset     ,
    o_consumer_pc: output logic<32> ,
    o_producer_pc: output logic<32> ,
    o_correct    : output logic     ,
) {
    var bun_w: test_sim_xmod_pkg::PcBundle;
    var consumer_pc: logic<32>;

    inst p: test_sim_xmod_struct_producer (clk, rst, o_bun: bun_w);
    inst c: test_sim_xmod_struct_consumer (clk, rst, i_bun: bun_w, o_latched_pc: consumer_pc);

    assign o_consumer_pc = consumer_pc;
    assign o_producer_pc = bun_w.pc;
    // After N cycles:
    //   producer's pc_q = 4N (internal, not exposed)
    //   producer's bun_q.pc = 4(N-1)
    //   consumer's latched_pc = 4(N-2)
    // → producer_pc (= bun_w.pc) and consumer_pc differ by 4.
    assign o_correct = (consumer_pc + 32'd4) == bun_w.pc;
}

#[test(test_sim_xmod_struct)]
#[ignore]
module test_sim_xmod_struct {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen(clk);
    var cpc: logic<32>;
    var ppc: logic<32>;
    var ok : logic    ;
    inst h: test_sim_xmod_struct_harness (
        clk                       ,
        rst                       ,
        o_consumer_pc : cpc       ,
        o_producer_pc : ppc       ,
        o_correct     : ok        ,
    );
    initial {
        rst.assert(clk);
        clk.next(10);
        $display("[test_sim_xmod_struct] cy=10 producer_pc=%h consumer_pc=%h ok=%b (expected: producer=0x24 consumer=0x20 ok=1)",
                  ppc, cpc, ok);
        $assert(ok, "cross-module struct field pass-through NBA violation");
        $finish();
    }
}
