// Boot a guest under a bare-metal HS-mode hypervisor on the default core.
//
// The firmware ROM holds the minimal hypervisor firmware (test/hv/hvfw.hex)
// and DRAM holds the HS-mode hypervisor + its guest (test/hv/hv_dram.hex).
// The firmware drops to S-mode (HS) at 0x80000000 where the hypervisor takes
// over, sets up the G-stage, and runs the guest in VS-mode. Pass = x3 reaches
// 0xAA (the hypervisor sets it when the guest issues SBI shutdown).
//
// Marked #[ignore] (long run). The DRAM image is built (not committed, large):
//   make -C test/hv               # -> test/hv/{hvfw.hex, hv_dram.hex}
//   veryl test --ignored --test test_soc_hvlinux
// `make -C test/hv` with no args embeds the bare-metal infra guest (guest_bare);
// pass GUEST=<Image> GUEST_DTB=<dtb> to embed a real Linux guest.
#[test(test_soc_hvlinux)]
#[ignore]
module test_soc_hvlinux {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass   : logic    ;
    var fail   : logic    ;
    var x3     : logic<64>;
    var cycles : logic<64>;
    var instret: logic<64>;
    var last_pc: logic<64>;

    inst u_h: boot_soc_harness #(
        FW_HEX  : "test/hv/hvfw.hex",
        DRAM_HEX: "test/hv/hv_dram.hex",
    ) (
        clk                 ,
        rst                 ,
        o_pass   : pass     ,
        o_fail   : fail     ,
        o_x3     : x3       ,
        o_cycles : cycles   ,
        o_instret: instret  ,
        o_last_pc: last_pc  ,
        o_ret_cnt: _        ,
        o_traps  : _        ,
    );

    initial {
        rst.assert(clk);
        for i in 0..4000 {
            clk.next(10000);
            if pass || fail {
                break;
            }
            if i % 50 == 49 {
                $display("SoC hvlinux probe: cy=%d instret=%d pc=%h x3=%h", cycles, instret, last_pc, x3);
            }
        }
        $display("SoC hvlinux: cy=%d instret=%d x3=%h pass=%b fail=%b", cycles, instret, x3, pass, fail);
        $assert (pass, "SoC hvlinux: did not reach SBI shutdown (x3 != 0xAA)");
        $finish ();
    }
}

// The guest Linux boot under the hypervisor on the new core (W2), pass/fail
// only: the only gate that runs the two-stage translation under load.
#[test(test_w2_hvlinux)]
#[ignore]
module test_w2_hvlinux {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass   : logic    ;
    var fail   : logic    ;
    var x3     : logic<64>;
    var cycles : logic<64>;
    var instret: logic<64>;
    var last_pc: logic<64>;

    inst u_h: boot_soc_harness #(
        FW_HEX  : "test/hv/hvfw.hex"   ,
        DRAM_HEX: "test/hv/hv_dram.hex",
        CORE    : tb_core_sel::CORE_W2 ,
    ) (
        clk                 ,
        rst                 ,
        o_pass   : pass     ,
        o_fail   : fail     ,
        o_x3     : x3       ,
        o_cycles : cycles   ,
        o_instret: instret  ,
        o_last_pc: last_pc  ,
        o_ret_cnt: _        ,
        o_traps  : _        ,
    );

    initial {
        rst.assert(clk);
        for i in 0..4000 {
            clk.next(10000);
            if pass || fail {
                break;
            }
            if i % 50 == 49 {
                $display("w2 hvlinux probe: cy=%d instret=%d pc=%h x3=%h", cycles, instret, last_pc, x3);
            }
        }
        $display("w2 hvlinux: cy=%d instret=%d x3=%h pass=%b fail=%b", cycles, instret, x3, pass, fail);
        $assert (pass, "w2 hvlinux: the guest did not reach SBI shutdown (x3 != 0xAA)");
        $finish ();
    }
}

