// Elaborates the generic common parts with both supported configs: a decode
// to rename queue of OpTag (FETCH_W in, RENAME_W out, RQ_N deep) feeding a
// stage_reg. One full group goes in; the consumer takes all RENAME_W lanes
// and lane 0 must reach the stage_reg output with its tag intact.
module core_elab_harness::<CFG: core_cfg> (
    clk   : input  clock,
    rst   : input  reset,
    i_push: input  logic,
    o_ok  : output logic,
) {
    import core_types::<CFG>::*;

    var iv  : logic [CFG::FETCH_W] ;
    var id  : OpTag [CFG::FETCH_W] ;
    var rdy : logic                ;
    var ov  : logic [CFG::RENAME_W];
    var od  : OpTag [CFG::RENAME_W];
    var kill: Kill                 ;
    var sv  : logic                ;
    var sd  : OpTag                ;

    always_comb {
        for l in 0..CFG::FETCH_W {
            iv[l]         = i_push;
            id[l]         = 0 as OpTag;
            id[l].rob.idx = l + 5;
            id[l].has_rd  = 1'b1;
        }
        kill = 0 as Kill;
    }

    inst q: lane_queue #(
        T    : OpTag        ,
        W_IN : CFG::FETCH_W ,
        W_OUT: CFG::RENAME_W,
        DEPTH: CFG::RQ_N    ,
    ) (
        clk                                  ,
        rst                                  ,
        i_valid: iv                          ,
        i_data : id                          ,
        o_ready: rdy                         ,
        o_valid: ov                          ,
        o_data : od                          ,
        i_take : if ov[0] ? CFG::RENAME_W : 0,
        i_flush: 1'b0                        ,
    );

    inst s: stage_reg::<CFG> #(
        T: OpTag,
    ) (
        clk               ,
        rst               ,
        i_valid: ov[0]    ,
        i_data : od[0]    ,
        i_tag  : od[0].rob,
        i_kill : kill     ,
        o_valid: sv       ,
        o_data : sd       ,
    );

    var seen_q: logic;
    always_ff {
        if_reset {
            seen_q = 1'b0;
        } else if sv && sd.rob.idx == 5 && sd.has_rd {
            seen_q = 1'b1;
        }
    }
    assign o_ok = seen_q && rdy;
}

#[test(test_core_elab)]
module test_core_elab {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var push: logic;
    var ok2 : logic;
    var ok4 : logic;
    inst h2: core_elab_harness::<cfg_w2> (
        clk         ,
        rst         ,
        i_push: push,
        o_ok  : ok2 ,
    );
    inst h4: core_elab_harness::<cfg_w4> (
        clk         ,
        rst         ,
        i_push: push,
        o_ok  : ok4 ,
    );

    initial {
        push = 1'b0;
        rst.assert(clk);
        clk.next(1);
        push = 1'b1;
        clk.next(1);
        push = 1'b0;
        clk.next(4);
        $display("core_elab: w2 ok=%b w4 ok=%b", ok2, ok4);
        $assert(ok2 && ok4, "op did not pass lane_queue and stage_reg");
        $finish();
    }
}
