#[test(test_gm_w2_litmus_2hart_slow_s1)]
#[ignore]
module test_gm_w2_litmus_2hart_slow_s1 {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var pass  : logic    ;
    var fail  : logic    ;
    var cycles: logic<64>;
    inst h: gm_litmus2_harness #(
        CFG : axi4_tb_pkg::SLOW,
        SEED: 32'h1,
    ) (
        clk, rst, o_pass: pass, o_fail: fail, o_cycles: cycles,
    );
    initial {
        rst.assert(clk);
        for _i in 0..6000 {
            clk.next(10000);
            if pass || fail {
                break;
            }
        }
        clk.next(10);
        $display("gm litmus(N=2) slow s1: cycles=%d pass=%b fail=%b", cycles, pass, fail);
        $assert (pass, "gm litmus(N=2) slow s1: forbidden outcome, trap, checker or timeout");
        $finish ();
    }
}

