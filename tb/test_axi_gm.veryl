#[test(test_gm_w2_smp_2hart_bp_s1)]
#[ignore]
module test_gm_w2_smp_2hart_bp_s1 {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var pass   : logic    ;
    var fail   : logic    ;
    var x3     : logic<64>;
    var cycles : logic<64>;
    var instret: logic<64>;
    inst h: gm_smp2_harness #(
        CFG : axi4_tb_pkg::BACKPRESSURE,
        SEED: 32'h1,
    ) (
        clk, rst, o_pass: pass, o_fail: fail, o_x3: x3, o_cycles: cycles, o_instret: instret,
    );
    initial {
        rst.assert(clk);
        for _i in 0..20000 {
            clk.next(10000);
            if pass || fail {
                break;
            }
        }
        clk.next(10);
        $display("gm smp(N=2) bp s1: cycles=%d instret=%d x3=%h pass=%b fail=%b", cycles, instret, x3, pass, fail);
        $assert (pass, "gm smp(N=2) bp s1: checker, hart failure or no SBI shutdown");
        $finish ();
    }
}

