// Gate GM: the GL-B lockstep boot and the N=2 SMP boot behind the tb AXI4
// slave model in its randomized settings. GL-B must keep the FIXED record
// count and hash (mtime advances by retire count, so only cycles may change);
// the SMP boot is pass/fail. The cycle budgets are early-exit bounds sized
// for SLOW, not measured figures.
//
// Run explicitly with:
//   veryl test --ignored --test test_gm_

module gm_lockstep_harness #(
    param CFG : axi4_tb_pkg::SlaveCfg = axi4_tb_pkg::FIXED,
    param SEED: bit<32>               = 32'h1             ,
) (
    clk      : input  clock    ,
    rst      : input  reset    ,
    o_pass   : output logic    ,
    o_fail   : output logic    ,
    o_x3     : output logic<64>,
    o_cycles : output logic<64>,
    o_instret: output logic<64>,
    o_last_pc: output logic<64>,
    o_ret_cnt: output logic<64>,
) {
    inst u_h: boot_soc_harness #(
        CORE     : tb_core_sel::CORE_W2                  ,
        MTIME_SRC: soc_pkg::MTIME_INSTRET                ,
        MTIME_DIV: 10                                    ,
        REPLAY_EN: 1                                     ,
        IRQ_FILE : "test/golden/boot/linux515_n1.irq.hex",
        CK_EN    : 1                                     ,
        CK_FILE  : "test/golden/boot/linux515_n1.ck.hex" ,
        AXI_CFG  : CFG                                   ,
        AXI_SEED : SEED                                  ,
    ) (
        clk       ,
        rst       ,
        o_pass    ,
        o_fail    ,
        o_x3      ,
        o_cycles  ,
        o_instret ,
        o_last_pc ,
        o_ret_cnt ,
        o_traps  : _,
    );
}

module gm_smp2_harness #(
    param CFG : axi4_tb_pkg::SlaveCfg = axi4_tb_pkg::FIXED,
    param SEED: bit<32>               = 32'h1             ,
) (
    clk      : input  clock    ,
    rst      : input  reset    ,
    o_pass   : output logic    ,
    o_fail   : output logic    ,
    o_x3     : output logic<64>,
    o_cycles : output logic<64>,
    o_instret: output logic<64>,
) {
    inst u_h: boot_soc_harness #(
        N_HARTS   : 2                                    ,
        FW_HEX    : "test/hex/linux_boot_fw_2hart.hex"   ,
        DRAM_HEX  : "test/hex/linux_dram_real_2hart.hex" ,
        CORE      : tb_core_sel::CORE_W2                 ,
        PROBE_LOG2: 20                                   ,
        AXI_CFG   : CFG                                  ,
        AXI_SEED  : SEED                                 ,
    ) (
        clk           ,
        rst           ,
        o_pass        ,
        o_fail        ,
        o_x3          ,
        o_cycles      ,
        o_instret     ,
        o_last_pc: _  ,
        o_ret_cnt: _  ,
        o_traps  : _  ,
    );
}

#[test(test_gm_w2_lockstep_slow_s1)]
#[ignore]
module test_gm_w2_lockstep_slow_s1 {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var pass   : logic    ;
    var fail   : logic    ;
    var x3     : logic<64>;
    var cycles : logic<64>;
    var instret: logic<64>;
    var last_pc: logic<64>;
    var ret_cnt: logic<64>;
    inst h: gm_lockstep_harness #(
        CFG : axi4_tb_pkg::SLOW,
        SEED: 32'h1            ,
    ) (
        clk, rst, o_pass: pass, o_fail: fail, o_x3: x3, o_cycles: cycles, o_instret: instret, o_last_pc: last_pc, o_ret_cnt: ret_cnt,
    );
    initial {
        rst.assert(clk);
        for i in 0..12000 {
            clk.next(10000);
            if pass || fail {
                break;
            }
            if i % 100 == 99 {
                $display("gm probe slow_s1: records=%d pc=%h x3=%h", ret_cnt, last_pc, x3);
            }
        }
        clk.next(10);
        $display("gm lockstep slow s1: cycles=%d instret=%d x3=%h pass=%b fail=%b", cycles, instret, x3, pass, fail);
        $assert (pass, "gm lockstep slow s1: mismatch, replay failure or no SBI shutdown");
        $finish ();
    }
}

