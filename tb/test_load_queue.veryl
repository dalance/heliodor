// Load Queue unit test (E1-a skeleton).
// Tests: allocate, addr update, issue, complete, retire.
module test_load_queue_harness (
    clk   : input  clock,
    rst   : input  reset,
    o_pass: output logic,
    o_done: output logic,
) {
    var tc: logic<8>;

    always_ff {
        if_reset {
            tc = 8'd0;
        } else {
            tc = tc + 8'd1;
        }
    }

    var alloc_valid : logic    ;
    var alloc_rob   : logic<5> ;
    var alloc_epoch : logic<2> ;
    var alloc_rd    : logic<5> ;
    var alloc_funct3: logic<3> ;
    var alloc_is_fp : logic    ;
    var alloc_ready : logic    ;
    var alloc_idx   : logic<3> ;

    var addr_valid: logic    ;
    var addr_idx  : logic<3> ;
    var addr_addr : logic<64>;

    var issue_valid : logic    ;
    var issue_addr  : logic<64>;
    var issue_funct3: logic<3> ;
    var issue_rob   : logic<5> ;
    var issue_idx   : logic<3> ;
    var issue_ready : logic    ;

    var complete_valid: logic    ;
    var complete_idx  : logic<3> ;
    var complete_data : logic<64>;

    var retire_valid: logic    ;
    var retire_rob  : logic<5> ;
    var retire_epoch: logic<2> ;
    var retire_rd   : logic<5> ;
    var retire_data : logic<64>;
    var retire_is_fp: logic    ;

    var squash_valid: logic    ;
    var _zero_mask  : logic [32];

    var flush: logic;

    var count: logic<4>;
    var full : logic   ;
    var empty: logic   ;

    inst dut: load_queue (
        clk,
        rst,
        i_alloc_valid   : alloc_valid  ,
        i_alloc_rob     : alloc_rob    ,
        i_alloc_epoch   : alloc_epoch  ,
        i_alloc_rd      : alloc_rd     ,
        i_alloc_funct3  : alloc_funct3 ,
        i_alloc_is_fp   : alloc_is_fp  ,
        o_alloc_ready   : alloc_ready  ,
        o_alloc_idx     : alloc_idx    ,
        i_addr_valid    : addr_valid   ,
        i_addr_idx      : addr_idx     ,
        i_addr_addr     : addr_addr    ,
        o_issue_valid   : issue_valid  ,
        o_issue_addr    : issue_addr   ,
        o_issue_funct3  : issue_funct3 ,
        o_issue_rob     : issue_rob    ,
        o_issue_idx     : issue_idx    ,
        i_issue_ready   : issue_ready  ,
        i_complete_valid: complete_valid,
        i_complete_idx  : complete_idx ,
        i_complete_data : complete_data,
        o_retire_valid  : retire_valid ,
        o_retire_rob    : retire_rob   ,
        o_retire_epoch  : retire_epoch ,
        o_retire_rd     : retire_rd    ,
        o_retire_data   : retire_data  ,
        o_retire_is_fp  : retire_is_fp ,
        i_squash_valid  : squash_valid ,
        i_squash_mask   : _zero_mask   ,
        i_flush         : flush        ,
        o_count         : count        ,
        o_full          : full         ,
        o_empty         : empty        ,
    );

    var failed: logic;

    always_comb {
        alloc_valid    = 1'b0;
        alloc_rob      = 5'd0;
        alloc_epoch    = 2'd0;
        alloc_rd       = 5'd0;
        alloc_funct3   = 3'd0;
        alloc_is_fp    = 1'b0;
        addr_valid     = 1'b0;
        addr_idx       = 3'd0;
        addr_addr      = '0;
        issue_ready    = 1'b0;
        complete_valid = 1'b0;
        complete_idx   = 3'd0;
        complete_data  = '0;
        squash_valid   = 1'b0;
        flush          = 1'b0;

        case tc {
            // tc=2: alloc load rob=5, rd=10, LD (funct3=011)
            8'd2: {
                alloc_valid  = 1'b1;
                alloc_rob    = 5'd5;
                alloc_rd     = 5'd10;
                alloc_funct3 = 3'b011;
            }
            // tc=3: alloc load rob=6, rd=11
            8'd3: {
                alloc_valid  = 1'b1;
                alloc_rob    = 5'd6;
                alloc_rd     = 5'd11;
                alloc_funct3 = 3'b011;
            }
            // tc=4: addr update for entry 0 (rob=5)
            8'd4: {
                addr_valid = 1'b1;
                addr_idx   = 3'd0;
                addr_addr  = 64'hAAAA0000;
            }
            // tc=5: addr update for entry 1 (rob=6)
            8'd5: {
                addr_valid = 1'b1;
                addr_idx   = 3'd1;
                addr_addr  = 64'hBBBB0000;
            }
            // tc=6: complete entry 0 with data
            8'd6: {
                complete_valid = 1'b1;
                complete_idx   = 3'd0;
                complete_data  = 64'hDEADBEEF;
            }
            // tc=7: complete entry 1
            8'd7: {
                complete_valid = 1'b1;
                complete_idx   = 3'd1;
                complete_data  = 64'hCAFEBABE;
            }
            default: {}
        }
    }

    always_ff {
        if_reset {
            failed = 1'b0;
        } else {
            case tc {
                // tc=1: empty after reset
                8'd1: {
                    if !empty || full {
                        failed = 1'b1;
                    }
                }
                // tc=3: alloc rob=5 at tc=2 registered → count=1
                8'd3: {
                    if count != 4'd1 {
                        failed = 1'b1;
                    }
                }
                // tc=4: alloc rob=6 at tc=3 registered → count=2
                //       addr update at tc=4 is combinational (issue enabled)
                8'd4: {
                    if count != 4'd2 {
                        failed = 1'b1;
                    }
                }
                // tc=5: after addr update at tc=4 edge, issue_valid for entry 0
                8'd5: {
                    if !issue_valid || issue_rob != 5'd5 {
                        failed = 1'b1;
                    }
                }
                // tc=7: both entries have addr, entry 0 completes this cycle
                //       retire_valid for entry 0 next cycle
                8'd7: {
                    // complete at tc=6 edge → entry 0 data_ready
                    if !retire_valid || retire_rob != 5'd5 || retire_data != 64'hDEADBEEF {
                        failed = 1'b1;
                    }
                }
                default: {}
            }
        }
    }

    assign o_pass = !failed;
    assign o_done = tc >: 8'd10;
}

#[test(test_load_queue)]
module test_load_queue {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen;

    var pass: logic;
    var done: logic;

    inst harness: test_load_queue_harness (
        clk    : clk ,
        rst    : rst ,
        o_pass : pass,
        o_done : done,
    );

    initial {
        rst.assert(clk);
        for _i: i32 in 0..14 {
            clk.next(1);
        }
        $assert (pass, "load_queue test failed");
        $display("load_queue test passed");
        $finish ();
    }
}
