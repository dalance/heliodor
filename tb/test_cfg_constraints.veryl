// Structural constraints and derived values of every config. A config that
// breaks a constraint is rejected here rather than at elaboration: an
// instantiation of an undefined module fails regardless of the generate
// condition, so the check is a test over core_types::CFG_ERR.
//
// cfg_bad_a and cfg_bad_b (cfg_bad.veryl) must each set their expected bits.
#[test(test_cfg_constraints)]
module test_cfg_constraints {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    initial {
        rst.assert(clk);
        clk.next(2);
        $display(
            "cfg_err: w2=%h w4=%h bad_a=%h bad_b=%h",
            core_types::<cfg_w2>::CFG_ERR,
            core_types::<cfg_w4>::CFG_ERR,
            core_types::<cfg_bad_a>::CFG_ERR,
            core_types::<cfg_bad_b>::CFG_ERR,
        );
        $assert(core_types::<cfg_w2>::CFG_ERR == 0, "cfg_w2 breaks a structural constraint");
        $assert(core_types::<cfg_w4>::CFG_ERR == 0, "cfg_w4 breaks a structural constraint");
        $assert(core_types::<cfg_bad_a>::CFG_ERR == 32'h0000_fc7b, "cfg_bad_a: unexpected constraint bits");
        $assert(core_types::<cfg_bad_b>::CFG_ERR == 32'h0001_0384, "cfg_bad_b: unexpected constraint bits");

        // Derived values of the supported configs.
        $assert(core_types::<cfg_w2>::WB_N == 3 && core_types::<cfg_w4>::WB_N == 8, "WB_N");
        $assert(core_types::<cfg_w2>::RETIRE_CNT_W == 2 && core_types::<cfg_w4>::RETIRE_CNT_W == 3, "RETIRE_CNT_W");
        $assert(core_types::<cfg_w2>::ST_RET_N == 1 && core_types::<cfg_w4>::ST_RET_N == 2, "ST_RET_N");
        $assert(core_types::<cfg_w2>::PUSH_W == 2 && core_types::<cfg_w4>::PUSH_W == 2, "PUSH_W");
        $assert(core_types::<cfg_w2>::WALK_W == 2 && core_types::<cfg_w4>::WALK_W == 4, "WALK_W");
        $assert(core_types::<cfg_w2>::BRU_N == 1 && core_types::<cfg_w4>::BRU_N == 2, "BRU_N");
        $assert(core_types::<cfg_w2>::PREG_W == 7 && core_types::<cfg_w4>::PREG_W == 8, "PREG_W");
        $assert(core_types::<cfg_w2>::FREE_INT_N == 64 && core_types::<cfg_w2>::FREE_FP_N == 32, "FREE_N w2");
        $assert(core_types::<cfg_w4>::FREE_INT_N == 128 && core_types::<cfg_w4>::FREE_FP_N == 64, "FREE_N w4");
        $assert(core_types::<cfg_w2>::ROB_IDX_W == 6 && core_types::<cfg_w4>::ROB_IDX_W == 7, "ROB_IDX_W");
        $assert(core_types::<cfg_w2>::FOFF_W == 3 && core_types::<cfg_w4>::FOFF_W == 4, "FOFF_W");
        $assert(core_types::<cfg_w2>::CKPT_W == 1 && core_types::<cfg_w4>::CKPT_W == 1, "CKPT_W");
        $assert(
            core_types::<cfg_w2>::iq_port_count(0) == 2 && core_types::<cfg_w2>::iq_port_count(1) == 1,
            "iq ports w2",
        );
        $assert(
            core_types::<cfg_w4>::iq_port_count(0) == 4 && core_types::<cfg_w4>::iq_port_count(1) == 2
                && core_types::<cfg_w4>::iq_port_count(2) == 2,
            "iq ports w4",
        );
        $finish();
    }
}
