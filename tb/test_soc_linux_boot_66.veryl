// Linux 6.6 RVA23 verification boot (1-hart) on heliodor_soc_smp, default
// core: the 6.6 kernel + RVA23 DTS (test/hex/linux_dram_66.hex) and the
// RVA23 firmware (menvcfg STCE/PBMTE/ADUE + SBI DBCN,
// test/hex/linux_boot_fw_66.hex). The UART TX is echoed to stdout so the
// kernel's "riscv: ISA extensions ..." printk is visible.
//
// Pass = x3 reaches 0xAA (SBI SRST shutdown after init runs).
// Marked #[ignore] (long run):  veryl test --ignored --test test_soc_66_linux_boot
#[test(test_soc_66_linux_boot)]
#[ignore]
module test_soc_66_linux_boot {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass   : logic    ;
    var fail   : logic    ;
    var x3     : logic<64>;
    var cycles : logic<64>;
    var instret: logic<64>;
    var last_pc: logic<64>;

    inst u_h: boot_soc_harness #(
        FW_HEX  : "test/hex/linux_boot_fw_66.hex",
        DRAM_HEX: "test/hex/linux_dram_66.hex",
    ) (
        clk                 ,
        rst                 ,
        o_pass   : pass     ,
        o_fail   : fail     ,
        o_x3     : x3       ,
        o_cycles : cycles   ,
        o_instret: instret  ,
        o_last_pc: last_pc  ,
        o_ret_cnt: _        ,
        o_traps  : _        ,
    );

    initial {
        rst.assert(clk);
        for i in 0..6100 {
            clk.next(10000);
            if pass || fail {
                break;
            }
            if i % 50 == 49 {
                $display("SoC 6.6 linux boot probe: cy=%d instret=%d pc=%h x3=%h", cycles, instret, last_pc, x3);
            }
        }
        $display("SoC 6.6 linux boot: cy=%d instret=%d x3=%h pass=%b fail=%b", cycles, instret, x3, pass, fail);
        $assert (pass, "SoC 6.6 linux boot: did not reach SBI shutdown (x3 != 0xAA)");
        $finish ();
    }
}

// The 6.6 N=1 boot on the new core (W2), pass/fail only. The 61M-cycle
// budget is an early-exit bound of about 3x the old core's boot (~20.4M), not
// a measured figure.
#[test(test_w2_linux_boot_66)]
#[ignore]
module test_w2_linux_boot_66 {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass   : logic    ;
    var fail   : logic    ;
    var x3     : logic<64>;
    var cycles : logic<64>;
    var instret: logic<64>;
    var last_pc: logic<64>;

    inst u_h: boot_soc_harness #(
        FW_HEX  : "test/hex/linux_boot_fw_66.hex",
        DRAM_HEX: "test/hex/linux_dram_66.hex"   ,
        CORE    : tb_core_sel::CORE_W2          ,
    ) (
        clk                 ,
        rst                 ,
        o_pass   : pass     ,
        o_fail   : fail     ,
        o_x3     : x3       ,
        o_cycles : cycles   ,
        o_instret: instret  ,
        o_last_pc: last_pc  ,
        o_ret_cnt: _        ,
        o_traps  : _        ,
    );

    initial {
        rst.assert(clk);
        for i in 0..6100 {
            clk.next(10000);
            if pass || fail {
                break;
            }
            if i % 50 == 49 {
                $display("w2 6.6 boot probe: cy=%d instret=%d pc=%h x3=%h", cycles, instret, last_pc, x3);
            }
        }
        $display("w2 linux 6.6 boot: cy=%d instret=%d x3=%h pass=%b fail=%b", cycles, instret, x3, pass, fail);
        $assert (pass, "w2 linux 6.6 boot: did not reach SBI shutdown (x3 != 0xAA)");
        $finish ();
    }
}

