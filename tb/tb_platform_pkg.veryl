// tb_platform_pkg: the PMA region tables of the harnesses.
//
// MAP_ARCH (arch, ACT4, bench): no ROM; DRAM is the harness array, 4 MiB at
// 0x8000_0000; CLINT, PLIC and UART are IO. Every other PA is a hole.
// MAP_BOOT (Linux boot): the firmware ROM at 0 is executable and uncached;
// DRAM is 32 MiB.
package tb_platform_pkg {
    import pma_pkg::*;

    const IO_ATTR: PmaAttr = PmaAttr'{target: Target::IO, backed: 1, cacheable: 0, coherent: 0, executable: 0, amo: AmoClass::NONE, idempotent: 0, io_ordered: 1, misaligned_ok: 0, pte_ok: 0, cbo_ok: 0};
    const ROM_ATTR: PmaAttr = PmaAttr'{target: Target::ROM, backed: 1, cacheable: 0, coherent: 0, executable: 1, amo: AmoClass::NONE, idempotent: 1, io_ordered: 0, misaligned_ok: 0, pte_ok: 0, cbo_ok: 0};
    const DRAM_ATTR: PmaAttr = PmaAttr'{target: Target::DRAM, backed: 1, cacheable: 1, coherent: 1, executable: 1, amo: AmoClass::FULL, idempotent: 1, io_ordered: 0, misaligned_ok: 1, pte_ok: 1, cbo_ok: 1};

    const MAP_ARCH_N: u32                    = 4;
    const MAP_ARCH  : PmaRegion [MAP_ARCH_N] = '{
        PmaRegion'{base: 56'h00_0000_0200_0000, mask: 56'hff_ffff_ffff_0000, attr: IO_ATTR},
        PmaRegion'{base: 56'h00_0000_0c00_0000, mask: 56'hff_ffff_ffc0_0000, attr: IO_ATTR},
        PmaRegion'{base: 56'h00_0000_1000_0000, mask: 56'hff_ffff_ffff_f000, attr: IO_ATTR},
        PmaRegion'{base: 56'h00_0000_8000_0000, mask: 56'hff_ffff_ffc0_0000, attr: DRAM_ATTR}
    };

    const MAP_BOOT_N: u32                    = 5;
    const MAP_BOOT  : PmaRegion [MAP_BOOT_N] = '{
        PmaRegion'{base: 56'h00_0000_0000_0000, mask: 56'hff_ffff_ffff_c000, attr: ROM_ATTR},
        PmaRegion'{base: 56'h00_0000_0200_0000, mask: 56'hff_ffff_ffff_0000, attr: IO_ATTR},
        PmaRegion'{base: 56'h00_0000_0c00_0000, mask: 56'hff_ffff_ffc0_0000, attr: IO_ATTR},
        PmaRegion'{base: 56'h00_0000_1000_0000, mask: 56'hff_ffff_ffff_f000, attr: IO_ATTR},
        PmaRegion'{base: 56'h00_0000_8000_0000, mask: 56'hff_ffff_fe00_0000, attr: DRAM_ATTR}
    };
}
