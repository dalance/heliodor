// dm, dm_mem and dmi_apb without a core: dm_seq plays dm_unit.dmi while a
// hart model plays hart 1's side of the debug ROM handshake (HALTED in a
// loop from cycle 40, RESUMING once its RESUME flag is set). o_ok also needs
// hart 0's RESUME flag to stay low.
module test_dm_handshake_harness (
    clk   : input  clock,
    rst   : input  reset,
    o_done: output logic,
    o_ok  : output logic,
) {
    var psel   : logic         ;
    var penable: logic         ;
    var pwrite : logic         ;
    var paddr  : logic<9>      ;
    var pwdata : logic<32>     ;
    var pstrb  : logic<4>      ;
    var pready : logic         ;
    var prdata : logic<32>     ;
    var pslverr: logic         ;
    var done   : logic         ;
    var fail   : logic         ;
    var raddr  : logic<7>      ;
    var rdata  : logic<32>     ;
    var req    : dm_pkg::DmiReq;
    var wevt   : dm_pkg::HartWr;
    var dstrb  : logic<8>      ;
    var go     : logic<2>      ;
    var resume : logic<2>      ;
    var code   : logic<32> [dm_pkg::CODE_N];
    var data   : logic<64>     ;
    var mem_ra : logic<13>     ;
    var mem_rd : logic<64>     ;
    var wen    : logic         ;
    var waddr  : logic<13>     ;

    inst u_seq: dm_seq #(
        FILE: "test/debug/dmi/dm_unit.hex",
    ) (
        clk                ,
        rst                ,
        o_psel   : psel    ,
        o_penable: penable ,
        o_pwrite : pwrite  ,
        o_paddr  : paddr   ,
        o_pwdata : pwdata  ,
        o_pstrb  : pstrb   ,
        i_pready : pready  ,
        i_prdata : prdata  ,
        i_pslverr: pslverr ,
        o_done   : done    ,
        o_fail   : fail    ,
        o_rd_n   : _       ,
        o_wr_n   : _       ,
    );
    inst u_dmi: dmi_apb (
        clk                ,
        rst                ,
        i_psel   : psel    ,
        i_penable: penable ,
        i_pwrite : pwrite  ,
        i_paddr  : paddr   ,
        i_pwdata : pwdata  ,
        i_pstrb  : pstrb   ,
        o_pready : pready  ,
        o_prdata : prdata  ,
        o_pslverr: pslverr ,
        o_raddr  : raddr   ,
        i_rdata  : rdata   ,
        o_req    : req     ,
    );
    inst u_dm: dm #(
        N_HARTS: 2,
    ) (
        clk                  ,
        rst                  ,
        i_dmi_raddr: raddr   ,
        o_dmi_rdata: rdata   ,
        i_dmi      : req     ,
        i_wevt     : wevt    ,
        i_dstrb    : dstrb   ,
        i_dwdata   : 64'd1   ,
        o_haltreq  : _       ,
        o_go       : go      ,
        o_resume   : resume  ,
        o_code     : code    ,
        o_data     : data    ,
        o_obs      : _       ,
        o_active   : _       ,
        o_hobs     : _       ,
        i_sys_idle : 1'b1    ,
        i_quiet    : 2'b00   ,
        o_drain    : _       ,
        o_ndmreset : _       ,
        o_hartreset: _       ,
        o_hart_rst : _       ,
        o_robs     : _       ,
    );
    inst u_mem: dm_mem #(
        N_HARTS: 2,
    ) (
        i_raddr : mem_ra         ,
        o_rdata : mem_rd         ,
        i_wen   : wen            ,
        i_waddr : waddr          ,
        i_wdata : {32'd0, 32'd1} ,
        i_wstrb : 8'h0f          ,
        i_code  : code           ,
        i_data  : data           ,
        i_go    : go             ,
        i_resume: resume         ,
        o_wevt  : wevt           ,
        o_dstrb : dstrb          ,
    );

    // Hart 1: halted from cycle 40 until it acknowledges its RESUME flag.
    var cyc_q   : logic<32>;
    var hhalt_q : logic    ;
    var wen_q   : logic    ;
    var waddr_q : logic<13>;
    var bad_q   : logic    ;
    let flag1: logic = mem_rd[8 + dm_pkg::FLAG_RESUME];
    always_ff {
        if_reset {
            cyc_q   = 32'd0;
            hhalt_q = 1'b0;
            wen_q   = 1'b0;
            waddr_q = 13'd0;
            bad_q   = 1'b0;
        } else {
            cyc_q   = cyc_q + 32'd1;
            wen_q   = 1'b0;
            if cyc_q == 32'd40 {
                hhalt_q = 1'b1;
            }
            if hhalt_q && cyc_q[2:0] == 3'd0 {
                wen_q   = 1'b1;
                waddr_q = dm_pkg::MEM_HALTED;
            }
            if hhalt_q && flag1 {
                hhalt_q = 1'b0;
                wen_q   = 1'b1;
                waddr_q = dm_pkg::MEM_RESUMING;
            }
            if mem_rd[dm_pkg::FLAG_RESUME] {
                bad_q = 1'b1;
            }
        }
    }
    assign wen    = wen_q;
    assign waddr  = waddr_q;
    assign mem_ra = dm_pkg::MEM_FLAGS;
    assign o_done = done;
    assign o_ok   = done && !fail && !bad_q;
}

#[test(test_dm_handshake)]
module test_dm_handshake {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var done: logic;
    var ok  : logic;
    inst h: test_dm_handshake_harness (
        clk           ,
        rst           ,
        o_done: done  ,
        o_ok  : ok    ,
    );
    initial {
        rst.assert(clk);
        for _i in 0..30 {
            clk.next(100);
            if done {
                break;
            }
        }
        $display("dm handshake: done=%b ok=%b", done, ok);
        $assert(ok, "dm handshake failed");
        $finish();
    }
}

// The code region of debug memory reads the ROM words, the abstract command
// words from MEM_ABS and zero elsewhere; the data region reads data0/data1,
// the flag bytes and zero elsewhere.
#[test(test_dm_mem_rom)]
module test_dm_mem_rom {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    const RA  : logic<13> [7] = '{13'h0000, 13'h0008, 13'h0ff8, 13'h1400, 13'h0300, 13'h0350, 13'h1000};
    var rd  : logic<64> [7];
    var code: logic<32> [dm_pkg::CODE_N];
    always_comb {
        for i in 0..dm_pkg::CODE_N {
            code[i] = 32'h100 + i;
        }
    }
    for i in 0..7 :g_rd {
        inst u_mem: dm_mem #(
            N_HARTS: 1,
        ) (
            i_raddr : RA[i]                ,
            o_rdata : rd[i]                ,
            i_wen   : 1'b0                 ,
            i_waddr : 13'd0                ,
            i_wdata : 64'd0                ,
            i_wstrb : 8'd0                 ,
            i_code  : code                 ,
            i_data  : 64'h1122_3344_5566_7788,
            i_go    : 1'b1                 ,
            i_resume: 1'b1                 ,
            o_wevt  : _                    ,
            o_dstrb : _                    ,
        );
    }
    initial {
        rst.assert(clk);
        clk.next(2);
        $assert(rd[0] == {dm_rom_pkg::ROM[1], dm_rom_pkg::ROM[0]}, "ROM dword 0");
        $assert(rd[1] == {dm_rom_pkg::ROM[3], dm_rom_pkg::ROM[2]}, "ROM dword 1");
        $assert(rd[2] == 64'd0, "past the code");
        $assert(rd[3] == 64'h3, "flags: hart 0 GO and RESUME");
        $assert(rd[4] == {32'h101, 32'h100}, "abstract command words 0 and 1");
        $assert(rd[5] == {32'd0, 32'h114}, "the implicit ebreak word, zero after it");
        $assert(rd[6] == 64'h1122_3344_5566_7788, "data0/data1");
        $finish();
    }
}

// Both harness tables are legal with the debug memory regions in them, and
// DM_BASE resolves to the DEBUG code region, DM_BASE + 0x1000 to the data one.
#[test(test_dm_pma_map)]
module test_dm_pma_map {
    import tb_platform_pkg::*;
    const CODE_A: pma_pkg::PmaAttr = pma_check::<MAP_ARCH_N>(DM_BASE, MAP_ARCH);
    const DATA_A: pma_pkg::PmaAttr = pma_check::<MAP_ARCH_N>(DM_BASE + 56'h1000, MAP_ARCH);
    const CODE_B: pma_pkg::PmaAttr = pma_check::<MAP_BOOT_N>(DM_BASE, MAP_BOOT);
    const DATA_B: pma_pkg::PmaAttr = pma_check::<MAP_BOOT_N>(DM_BASE + 56'h1000, MAP_BOOT);
    initial {
        $assert(pma_table_err::<MAP_ARCH_N>(MAP_ARCH) == 0, "MAP_ARCH table error");
        $assert(pma_table_err::<MAP_BOOT_N>(MAP_BOOT) == 0, "MAP_BOOT table error");
        $assert(CODE_A.target == pma_pkg::Target::DEBUG && CODE_A.executable, "MAP_ARCH DM code");
        $assert(DATA_A.target == pma_pkg::Target::DEBUG && DATA_A.io_ordered, "MAP_ARCH DM data");
        $assert(CODE_B.target == pma_pkg::Target::DEBUG && CODE_B.executable, "MAP_BOOT DM code");
        $assert(DATA_B.target == pma_pkg::Target::DEBUG && DATA_B.io_ordered, "MAP_BOOT DM data");
        $finish();
    }
}
