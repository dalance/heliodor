// Dhrystone benchmark with performance measurement.
// Requires: make -C test/c/dhrystone

#[test(test_dhrystone)]
#[ignore]
module test_dhrystone {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen(clk);

    var pass         : logic    ;
    var tohost       : logic<32>;
    var cycle_cnt    : logic<64>;
    var cnt_icache   : logic<64>;
    var cnt_immu     : logic<64>;
    var cnt_stall_if : logic<64>;
    var cnt_stall_id : logic<64>;
    var cnt_stall_ex : logic<64>;
    var cnt_stall_mem: logic<64>;
    var cnt_flush_id : logic<64>;
    var cnt_flush_ex : logic<64>;
    var cnt_instret  : logic<64>;
    var cnt_cause_load_use: logic<64>;
    var cnt_cause_mmu     : logic<64>;
    var cnt_cause_cache   : logic<64>;
    var cnt_cause_rs      : logic<64>;
    var cnt_cause_rob_full: logic<64>;
    var cnt_cause_rs_full_int : logic<64>;
    var cnt_cause_rs_full_fp  : logic<64>;
    var cnt_cause_direct_stall: logic<64>;
    var cnt_cause_irq_wait    : logic<64>;
    var cnt_ds_operand : logic<64>;
    var cnt_ds_op_load : logic<64>;
    var cnt_ds_op_store: logic<64>;
    var cnt_ds_op_bj   : logic<64>;
    var cnt_ds_rs_yield: logic<64>;
    var cnt_ds_rob_full: logic<64>;
    var cnt_ds_drain   : logic<64>;
    var cnt_mispred_branch: logic<64>;
    var cnt_mispred_jalr  : logic<64>;
    var cnt_mispred_jal   : logic<64>;
    var cnt_flush_trap    : logic<64>;
    var cnt_mispred_jalr_return  : logic<64>;
    var cnt_mispred_jalr_indirect: logic<64>;
    var cnt_if_return            : logic<64>;
    var cnt_ras_used             : logic<64>;
    var cnt_ras_push             : logic<64>;
    var cnt_ras_pop              : logic<64>;
    var cnt_lq_issue             : logic<32>;
    var cnt_lq_alloc             : logic<32>;
    var cnt_lq_mshr              : logic<32>;
    var cnt_srs_disp             : logic<32>;
    var cnt_srs_issue            : logic<32>;
    var cnt_srs_drop             : logic<32>;
    var cnt_sb_fwd_hit           : logic<32>;
    var cnt_sb_fwd_partial       : logic<32>;
    var cnt_sb_fwd_mismatch      : logic<32>;
    var cnt_srs_load_drain_unresolved: logic<32>;
    var cnt_p34_spec_violation       : logic<32>;
    var cnt_dual_fetch               : logic<32>;
    var cnt_dual_issue               : logic<32>;

    inst h: test_perf_harness #(
        HEX_FILE  : "test/hex/dhrystone.hex",
        TOHOST_IDX: 1024                    ,
    ) (
        clk                           ,
        rst                           ,
        o_pass         : pass         ,
        o_tohost       : tohost       ,
        o_cycle_cnt    : cycle_cnt    ,
        o_cnt_icache   : cnt_icache   ,
        o_cnt_immu     : cnt_immu     ,
        o_cnt_stall_if : cnt_stall_if ,
        o_cnt_stall_id : cnt_stall_id ,
        o_cnt_stall_ex : cnt_stall_ex ,
        o_cnt_stall_mem: cnt_stall_mem,
        o_cnt_flush_id : cnt_flush_id ,
        o_cnt_flush_ex : cnt_flush_ex ,
        o_cnt_instret  : cnt_instret  ,
        o_cnt_cause_load_use: cnt_cause_load_use,
        o_cnt_cause_mmu     : cnt_cause_mmu     ,
        o_cnt_cause_cache   : cnt_cause_cache   ,
        o_cnt_cause_rs      : cnt_cause_rs      ,
        o_cnt_cause_rob_full: cnt_cause_rob_full,
        o_cnt_cause_rs_full_int : cnt_cause_rs_full_int ,
        o_cnt_cause_rs_full_fp  : cnt_cause_rs_full_fp  ,
        o_cnt_cause_direct_stall: cnt_cause_direct_stall,
        o_cnt_cause_irq_wait    : cnt_cause_irq_wait    ,
        o_cnt_ds_operand  : cnt_ds_operand  ,
        o_cnt_ds_op_load  : cnt_ds_op_load  ,
        o_cnt_ds_op_store : cnt_ds_op_store ,
        o_cnt_ds_op_bj    : cnt_ds_op_bj    ,
        o_cnt_ds_rs_yield : cnt_ds_rs_yield ,
        o_cnt_ds_rob_full : cnt_ds_rob_full ,
        o_cnt_ds_drain    : cnt_ds_drain    ,
        o_cnt_mispred_branch: cnt_mispred_branch,
        o_cnt_mispred_jalr  : cnt_mispred_jalr  ,
        o_cnt_mispred_jal   : cnt_mispred_jal   ,
        o_cnt_flush_trap    : cnt_flush_trap    ,
        o_cnt_mispred_jalr_return  : cnt_mispred_jalr_return  ,
        o_cnt_mispred_jalr_indirect: cnt_mispred_jalr_indirect,
        o_cnt_if_return            : cnt_if_return            ,
        o_cnt_ras_used             : cnt_ras_used             ,
        o_cnt_ras_push             : cnt_ras_push             ,
        o_cnt_ras_pop              : cnt_ras_pop              ,
        o_cnt_lq_issue             : cnt_lq_issue             ,
        o_cnt_lq_alloc             : cnt_lq_alloc             ,
        o_cnt_lq_mshr              : cnt_lq_mshr              ,
        o_cnt_srs_disp             : cnt_srs_disp             ,
        o_cnt_srs_issue            : cnt_srs_issue            ,
        o_cnt_srs_drop             : cnt_srs_drop             ,
        o_cnt_sb_fwd_hit           : cnt_sb_fwd_hit           ,
        o_cnt_sb_fwd_partial       : cnt_sb_fwd_partial       ,
        o_cnt_sb_fwd_mismatch      : cnt_sb_fwd_mismatch      ,
        o_cnt_srs_load_drain_unresolved: cnt_srs_load_drain_unresolved,
        o_cnt_p34_spec_violation       : cnt_p34_spec_violation       ,
        o_cnt_dual_fetch               : cnt_dual_fetch               ,
        o_cnt_dual_issue               : cnt_dual_issue               ,
    );

    initial {
        rst.assert(clk);
        clk.next  (5000000);

        $display("=== Dhrystone Performance Report ===");
        $display("  tohost     = %h", tohost);
        $display("  cycles     = %d", cycle_cnt);
        $display("  instret    = %d", cnt_instret);
        $display("  --- stall breakdown ---");
        $display("  icache     = %d", cnt_icache);
        $display("  immu       = %d", cnt_immu);
        $display("  stall_if   = %d", cnt_stall_if);
        $display("  stall_id   = %d", cnt_stall_id);
        $display("  stall_ex   = %d", cnt_stall_ex);
        $display("  stall_mem  = %d", cnt_stall_mem);
        $display("  flush_id   = %d", cnt_flush_id);
        $display("  flush_ex   = %d", cnt_flush_ex);
        $display("  --- stall_id cause breakdown ---");
        $display("  load_use   = %d", cnt_cause_load_use);
        $display("  mmu        = %d", cnt_cause_mmu);
        $display("  cache      = %d", cnt_cause_cache);
        $display("  rs_full    = %d", cnt_cause_rs);
        $display("  rob_full   = %d", cnt_cause_rob_full);
        $display("  --- rs_stall sub-breakdown ---");
        $display("  rs_int_full  = %d", cnt_cause_rs_full_int);
        $display("  rs_fp_full   = %d", cnt_cause_rs_full_fp);
        $display("  direct_stall = %d", cnt_cause_direct_stall);
        $display("  irq_wait     = %d", cnt_cause_irq_wait);
        $display("  --- direct_stall sub-causes (may overlap) ---");
        $display("  ds_operand   = %d", cnt_ds_operand);
        $display("    ds_op_load   = %d (load blocked on rs1 from RS)", cnt_ds_op_load);
        $display("    ds_op_store  = %d (store blocked on rs1/rs2 from RS)", cnt_ds_op_store);
        $display("    ds_op_bj     = %d (branch/jalr blocked on rs1/rs2)", cnt_ds_op_bj);
        $display("  ds_rs_yield  = %d", cnt_ds_rs_yield);
        $display("  ds_rob_full  = %d", cnt_ds_rob_full);
        $display("  ds_drain     = %d", cnt_ds_drain);
        $display("  --- flush_id sub-causes ---");
        $display("  mispred_branch = %d", cnt_mispred_branch);
        $display("  mispred_jalr   = %d", cnt_mispred_jalr);
        $display("  mispred_jal    = %d", cnt_mispred_jal);
        $display("  flush_trap     = %d", cnt_flush_trap);
        $display("    jalr_return    = %d", cnt_mispred_jalr_return);
        $display("    jalr_indirect  = %d", cnt_mispred_jalr_indirect);
        $display("  --- RAS diagnostics ---");
        $display("  if_return      = %d (IF-stage return detections)", cnt_if_return);
        $display("  ras_used       = %d (RAS predict fired)", cnt_ras_used);
        $display("  ras_push       = %d (RAS pushes at IF)", cnt_ras_push);
        $display("  ras_pop        = %d (RAS pops at IF)", cnt_ras_pop);
        $display("  --- LQ diagnostics ---");
        $display("  lq_alloc       = %d (LQ allocations)", cnt_lq_alloc);
        $display("  lq_mshr        = %d (LQ via MSHR absorb)", cnt_lq_mshr);
        $display("  lq_issue_cyc   = %d (cycles LQ had issue-eligible entry)", cnt_lq_issue);
        $display("  --- SRS diagnostics (SRS-2 observational) ---");
        $display("  srs_disp       = %d (stores dispatched to SRS)", cnt_srs_disp);
        $display("  srs_issue_cyc  = %d (cycles SRS issued)", cnt_srs_issue);
        $display("  srs_drop       = %d (eligible but SRS-full — observation gap)", cnt_srs_drop);
        $display("  --- SB forwarding diagnostics (P3.3) ---");
        $display("  sb_fwd_hit     = %d", cnt_sb_fwd_hit);
        $display("  sb_fwd_partial = %d", cnt_sb_fwd_partial);
        $display("  sb_fwd_mismatch= %d", cnt_sb_fwd_mismatch);
        $display("  --- P3.4 speculation opportunity ---");
        $display("  srs_load_drain_unresolved = %d (load drained solely for unresolved SRS base)", cnt_srs_load_drain_unresolved);
        $display("  p34_spec_violation       = %d (SRS wake aliased a younger in-flight load)", cnt_p34_spec_violation);
        $display("  --- F0 dual issue ---");
        $display("  dual_fetch_cyc = %d (cycles fetch could pair slot0+slot1)", cnt_dual_fetch);
        $display("  dual_issue_cyc = %d (cycles dispatch fired both slots)", cnt_dual_issue);
        $display("====================================");

        $assert (pass, "Dhrystone: did not complete (tohost != 1)");
        $display("Dhrystone benchmark completed");
        $finish ();
    }
}
