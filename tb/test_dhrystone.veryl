// Dhrystone benchmark with performance measurement.
// Requires: make -C test/c/dhrystone

#[test(test_dhrystone)]
#[ignore]
module test_dhrystone {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen;

    var pass         : logic    ;
    var tohost       : logic<32>;
    var cycle_cnt    : logic<64>;
    var cnt_icache   : logic<64>;
    var cnt_immu     : logic<64>;
    var cnt_stall_if : logic<64>;
    var cnt_stall_id : logic<64>;
    var cnt_stall_ex : logic<64>;
    var cnt_stall_mem: logic<64>;
    var cnt_flush_id : logic<64>;
    var cnt_flush_ex : logic<64>;
    var cnt_instret  : logic<64>;
    var cnt_cause_load_use: logic<64>;
    var cnt_cause_mmu     : logic<64>;
    var cnt_cause_cache   : logic<64>;
    var cnt_cause_rs      : logic<64>;
    var cnt_cause_rob_full: logic<64>;
    var cnt_cause_rs_full_int : logic<64>;
    var cnt_cause_rs_full_fp  : logic<64>;
    var cnt_cause_direct_stall: logic<64>;
    var cnt_cause_irq_wait    : logic<64>;
    var cnt_ds_operand : logic<64>;
    var cnt_ds_rs_yield: logic<64>;
    var cnt_ds_rob_full: logic<64>;
    var cnt_ds_drain   : logic<64>;
    var cnt_mispred_branch: logic<64>;
    var cnt_mispred_jalr  : logic<64>;
    var cnt_mispred_jal   : logic<64>;
    var cnt_flush_trap    : logic<64>;

    inst h: test_perf_harness #(
        HEX_FILE  : "test/hex/dhrystone.hex",
        TOHOST_IDX: 1024                    ,
    ) (
        clk                           ,
        rst                           ,
        o_pass         : pass         ,
        o_tohost       : tohost       ,
        o_cycle_cnt    : cycle_cnt    ,
        o_cnt_icache   : cnt_icache   ,
        o_cnt_immu     : cnt_immu     ,
        o_cnt_stall_if : cnt_stall_if ,
        o_cnt_stall_id : cnt_stall_id ,
        o_cnt_stall_ex : cnt_stall_ex ,
        o_cnt_stall_mem: cnt_stall_mem,
        o_cnt_flush_id : cnt_flush_id ,
        o_cnt_flush_ex : cnt_flush_ex ,
        o_cnt_instret  : cnt_instret  ,
        o_cnt_cause_load_use: cnt_cause_load_use,
        o_cnt_cause_mmu     : cnt_cause_mmu     ,
        o_cnt_cause_cache   : cnt_cause_cache   ,
        o_cnt_cause_rs      : cnt_cause_rs      ,
        o_cnt_cause_rob_full: cnt_cause_rob_full,
        o_cnt_cause_rs_full_int : cnt_cause_rs_full_int ,
        o_cnt_cause_rs_full_fp  : cnt_cause_rs_full_fp  ,
        o_cnt_cause_direct_stall: cnt_cause_direct_stall,
        o_cnt_cause_irq_wait    : cnt_cause_irq_wait    ,
        o_cnt_ds_operand  : cnt_ds_operand  ,
        o_cnt_ds_rs_yield : cnt_ds_rs_yield ,
        o_cnt_ds_rob_full : cnt_ds_rob_full ,
        o_cnt_ds_drain    : cnt_ds_drain    ,
        o_cnt_mispred_branch: cnt_mispred_branch,
        o_cnt_mispred_jalr  : cnt_mispred_jalr  ,
        o_cnt_mispred_jal   : cnt_mispred_jal   ,
        o_cnt_flush_trap    : cnt_flush_trap    ,
    );

    initial {
        rst.assert(clk);
        clk.next  (5000000);

        $display("=== Dhrystone Performance Report ===");
        $display("  tohost     = %h", tohost);
        $display("  cycles     = %d", cycle_cnt);
        $display("  instret    = %d", cnt_instret);
        $display("  --- stall breakdown ---");
        $display("  icache     = %d", cnt_icache);
        $display("  immu       = %d", cnt_immu);
        $display("  stall_if   = %d", cnt_stall_if);
        $display("  stall_id   = %d", cnt_stall_id);
        $display("  stall_ex   = %d", cnt_stall_ex);
        $display("  stall_mem  = %d", cnt_stall_mem);
        $display("  flush_id   = %d", cnt_flush_id);
        $display("  flush_ex   = %d", cnt_flush_ex);
        $display("  --- stall_id cause breakdown ---");
        $display("  load_use   = %d", cnt_cause_load_use);
        $display("  mmu        = %d", cnt_cause_mmu);
        $display("  cache      = %d", cnt_cause_cache);
        $display("  rs_full    = %d", cnt_cause_rs);
        $display("  rob_full   = %d", cnt_cause_rob_full);
        $display("  --- rs_stall sub-breakdown ---");
        $display("  rs_int_full  = %d", cnt_cause_rs_full_int);
        $display("  rs_fp_full   = %d", cnt_cause_rs_full_fp);
        $display("  direct_stall = %d", cnt_cause_direct_stall);
        $display("  irq_wait     = %d", cnt_cause_irq_wait);
        $display("  --- direct_stall sub-causes (may overlap) ---");
        $display("  ds_operand   = %d", cnt_ds_operand);
        $display("  ds_rs_yield  = %d", cnt_ds_rs_yield);
        $display("  ds_rob_full  = %d", cnt_ds_rob_full);
        $display("  ds_drain     = %d", cnt_ds_drain);
        $display("  --- flush_id sub-causes ---");
        $display("  mispred_branch = %d", cnt_mispred_branch);
        $display("  mispred_jalr   = %d", cnt_mispred_jalr);
        $display("  mispred_jal    = %d", cnt_mispred_jal);
        $display("  flush_trap     = %d", cnt_flush_trap);
        $display("====================================");

        $assert (pass, "Dhrystone: did not complete (tohost != 1)");
        $display("Dhrystone benchmark completed");
        $finish ();
    }
}
