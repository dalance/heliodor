// RAT (Register Alias Table) unit test.
// Tests: rename, lookup, commit, commit-with-newer-mapping, flush, x0 handling.
module test_rat_harness (
    clk   : input  clock   ,
    rst   : input  reset   ,
    o_pass: output logic   ,
    o_done: output logic   ,
) {
    var tc: logic<8>;

    always_ff {
        if_reset {
            tc = 8'd0;
        } else {
            tc = tc + 8'd1;
        }
    }

    // DUT signals
    var rename_valid: logic    ;
    var rename_rd   : logic<5> ;
    var rename_idx  : logic<3> ;

    var commit_valid: logic    ;
    var commit_rd   : logic<5> ;
    var commit_idx  : logic<3> ;

    var rs1_addr    : logic<5> ;
    var rs1_valid   : logic    ;
    var rs1_rob_idx : logic<3> ;

    var rs2_addr    : logic<5> ;
    var rs2_valid   : logic    ;
    var rs2_rob_idx : logic<3> ;

    var flush       : logic    ;
    var _zero_mask  : logic [8];

    inst dut: rat (
        clk                              ,
        rst                              ,
        i_rename_valid: rename_valid     ,
        i_rename_rd   : rename_rd        ,
        i_rename_idx  : rename_idx       ,
        i_commit_valid: commit_valid     ,
        i_commit_rd   : commit_rd        ,
        i_commit_idx  : commit_idx       ,
        i_rs1_addr    : rs1_addr         ,
        o_rs1_valid   : rs1_valid        ,
        o_rs1_rob_idx : rs1_rob_idx      ,
        i_rs2_addr    : rs2_addr         ,
        o_rs2_valid   : rs2_valid        ,
        o_rs2_rob_idx : rs2_rob_idx      ,
        i_rs3_addr    : 5'd0             ,
        o_rs3_valid   : _                ,
        i_rs4_addr    : 5'd0             ,
        o_rs4_valid   : _                ,
        i_id_rs1_addr    : 5'd0          ,
        o_id_rs1_valid   : _             ,
        o_id_rs1_rob_idx : _             ,
        i_id_rs2_addr    : 5'd0          ,
        o_id_rs2_valid   : _             ,
        o_id_rs2_rob_idx : _             ,
        i_flush          : flush            ,
        i_undo           : 1'b0           ,
        i_squash_valid   : 1'b0           ,
        i_squash_mask    : _zero_mask      ,
        o_undo_valid     : _               ,
        o_undo_rob_idx   : _               ,
    );

    var failed: logic;

    always_comb {
        rename_valid = 1'b0;
        rename_rd    = 5'd0;
        rename_idx   = 3'd0;
        commit_valid = 1'b0;
        commit_rd    = 5'd0;
        commit_idx   = 3'd0;
        rs1_addr     = 5'd0;
        rs2_addr     = 5'd0;
        flush        = 1'b0;

        case tc {
            // tc=1: after reset, all mappings invalid (checked in always_ff)

            // tc=2: rename x5 → ROB idx 2
            8'd2: {
                rename_valid = 1'b1;
                rename_rd    = 5'd5;
                rename_idx   = 3'd2;
            }

            // tc=3: lookup x5 (should be valid, idx=2)
            8'd3: {
                rs1_addr = 5'd5;
                rs2_addr = 5'd10; // not renamed, should be invalid
            }

            // tc=4: rename x10 → ROB idx 4
            8'd4: {
                rename_valid = 1'b1;
                rename_rd    = 5'd10;
                rename_idx   = 3'd4;
            }

            // tc=5: lookup both x5 and x10
            8'd5: {
                rs1_addr = 5'd5;
                rs2_addr = 5'd10;
            }

            // tc=6: commit x5 with idx=2 (matches current mapping → should clear)
            8'd6: {
                commit_valid = 1'b1;
                commit_rd    = 5'd5;
                commit_idx   = 3'd2;
            }

            // tc=7: lookup x5 (should be invalid after commit)
            8'd7: {
                rs1_addr = 5'd5;
            }

            // tc=8: rename x10 → ROB idx 6 (overwrites previous mapping idx=4)
            8'd8: {
                rename_valid = 1'b1;
                rename_rd    = 5'd10;
                rename_idx   = 3'd6;
            }

            // tc=9: commit x10 with idx=4 (stale mapping, should NOT clear)
            8'd9: {
                commit_valid = 1'b1;
                commit_rd    = 5'd10;
                commit_idx   = 3'd4; // old mapping, newer exists (idx=6)
            }

            // tc=10: lookup x10 (should still be valid with idx=6)
            8'd10: {
                rs1_addr = 5'd10;
            }

            // tc=11: rename x0 → should be ignored (x0 always reads 0)
            8'd11: {
                rename_valid = 1'b1;
                rename_rd    = 5'd0;
                rename_idx   = 3'd7;
            }

            // tc=12: lookup x0 (should be invalid regardless)
            8'd12: {
                rs1_addr = 5'd0;
            }

            // tc=13: flush
            8'd13: {
                flush = 1'b1;
            }

            // tc=14: lookup x10 (should be invalid after flush)
            8'd14: {
                rs1_addr = 5'd10;
            }

            default: {}
        }
    }

    always_ff {
        if_reset {
            failed = 1'b0;
        } else {
            case tc {
                // tc=1: all invalid after reset
                8'd1: {
                    // Lookup any register — should be invalid
                    // (rs1_addr=0, rs2_addr=0 by default → invalid because x0)
                }

                // tc=3: x5 renamed to idx 2
                8'd3: {
                    if !rs1_valid || rs1_rob_idx != 3'd2 {
                        $display("FAIL tc=3: x5 expected valid=1 idx=2, got valid=%b idx=%d", rs1_valid, rs1_rob_idx);
                        failed = 1'b1;
                    }
                    if rs2_valid {
                        $display("FAIL tc=3: x10 expected valid=0, got valid=%b", rs2_valid);
                        failed = 1'b1;
                    }
                }

                // tc=5: x5=idx2, x10=idx4
                8'd5: {
                    if !rs1_valid || rs1_rob_idx != 3'd2 {
                        $display("FAIL tc=5: x5 expected valid=1 idx=2, got valid=%b idx=%d", rs1_valid, rs1_rob_idx);
                        failed = 1'b1;
                    }
                    if !rs2_valid || rs2_rob_idx != 3'd4 {
                        $display("FAIL tc=5: x10 expected valid=1 idx=4, got valid=%b idx=%d", rs2_valid, rs2_rob_idx);
                        failed = 1'b1;
                    }
                }

                // tc=7: x5 committed (cleared)
                8'd7: {
                    if rs1_valid {
                        $display("FAIL tc=7: x5 expected valid=0 after commit, got valid=%b", rs1_valid);
                        failed = 1'b1;
                    }
                }

                // tc=10: x10 still valid (stale commit didn't clear newer mapping)
                8'd10: {
                    if !rs1_valid || rs1_rob_idx != 3'd6 {
                        $display("FAIL tc=10: x10 expected valid=1 idx=6, got valid=%b idx=%d", rs1_valid, rs1_rob_idx);
                        failed = 1'b1;
                    }
                }

                // tc=12: x0 always invalid
                8'd12: {
                    if rs1_valid {
                        $display("FAIL tc=12: x0 expected valid=0, got valid=%b", rs1_valid);
                        failed = 1'b1;
                    }
                }

                // tc=14: x10 invalid after flush
                8'd14: {
                    if rs1_valid {
                        $display("FAIL tc=14: x10 expected valid=0 after flush, got valid=%b", rs1_valid);
                        failed = 1'b1;
                    }
                }

                default: {}
            }
        }
    }

    assign o_pass = !failed;
    assign o_done = tc >: 8'd17;
}

#[test(test_rat)]
module test_rat {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen;

    var pass: logic;
    var done: logic;

    inst harness: test_rat_harness (
        clk    : clk ,
        rst    : rst ,
        o_pass : pass,
        o_done : done,
    );

    initial {
        rst.assert(clk);
        for _i: i32 in 0..20 {
            clk.next(1);
        }
        $assert (pass, "RAT test failed");
        $display("RAT test passed");
        $finish ();
    }
}
