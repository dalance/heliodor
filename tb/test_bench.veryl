}

#[test(test_bench_median)]
#[ignore]
module test_bench_median {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass     : logic    ;
    var tohost   : logic<32>;
    var cycles   : logic<64>;
    var instret  : logic<64>;
    var mispred  : logic<32>;
    var redirect : logic<32>;
    var frontidle: logic<32>;
    var early    : logic<32>;
    var dispstall: logic<32>;
    var membusy  : logic<32>;
    var commit0  : logic<32>;
    var loadwait : logic<32>;
    var loadviol : logic<32>;

    inst h: test_perf_harness #(
        HEX_FILE  : "test/hex/bench_median.hex",
        TOHOST_IDX: 1024                       ,
    ) (
        clk                 ,
        rst                 ,
        o_pass     : pass     ,
        o_tohost   : tohost   ,
        o_cycles   : cycles   ,
        o_instret  : instret  ,
        o_mispredict: mispred  ,
        o_redirect  : redirect ,
        o_front_idle: frontidle,
        o_early_mispred: early ,
        o_disp_stall: dispstall,
        o_mem_busy  : membusy  ,
        o_commit0   : commit0  ,
        o_load_wait : loadwait ,
        o_load_viol : loadviol ,
    );

    initial {
        rst.assert(clk);
        for _i in 0..300 {
            clk.next(10000);
            if pass {
                break;
            }
        }
        $display("=== median ===");
        $display("  tohost  = %h", tohost);
        $display("  cycles  = %d", cycles);
        $display("  instret = %d", instret);
        $display("  mispred = %d", mispred);
        $display("  redirect= %d", redirect);
        $display("  frontidl= %d", frontidle);
        $display("  earlymis= %d", early);
        $display("  dispstl = %d", dispstall);
        $display("  membusy = %d", membusy);
        $display("  commit0 = %d", commit0);
        $display("  loadwait= %d", loadwait);
        $display("  loadviol= %d", loadviol);
        $assert (pass, "median: did not complete (tohost != 1)");
        $finish ();
    }
}

#[test(test_coremark)]
#[ignore]
module test_coremark {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass     : logic    ;
    var tohost   : logic<32>;
    var cycles   : logic<64>;
    var instret  : logic<64>;
    var mispred  : logic<32>;
    var redirect : logic<32>;
    var frontidle: logic<32>;
    var early    : logic<32>;
    var dispstall: logic<32>;
    var membusy  : logic<32>;
    var commit0  : logic<32>;
    var loadwait : logic<32>;
    var loadviol : logic<32>;

    inst h: test_perf_harness #(
        HEX_FILE  : "test/hex/coremark.hex",
        TOHOST_IDX: 8192                   ,
    ) (
        clk                 ,
        rst                 ,
        o_pass     : pass     ,
        o_tohost   : tohost   ,
        o_cycles   : cycles   ,
        o_instret  : instret  ,
        o_mispredict: mispred  ,
        o_redirect  : redirect ,
        o_front_idle: frontidle,
        o_early_mispred: early ,
        o_disp_stall: dispstall,
        o_mem_busy  : membusy  ,
        o_commit0   : commit0  ,
        o_load_wait : loadwait ,
        o_load_viol : loadviol ,
    );

    initial {
        rst.assert(clk);
        for _i in 0..1000 {
            clk.next(10000);
            if pass {
                break;
            }
        }
        $display("=== CoreMark (ITERATIONS=1) ===");
        $display("  tohost  = %h", tohost);
        $display("  cycles  = %d", cycles);
        $display("  instret = %d", instret);
        $display("  mispred = %d", mispred);
        $display("  redirect= %d", redirect);
        $display("  frontidl= %d", frontidle);
        $display("  earlymis= %d", early);
        $display("  dispstl = %d", dispstall);
        $display("  membusy = %d", membusy);
        $display("  commit0 = %d", commit0);
        $display("  loadwait= %d", loadwait);
        $display("  loadviol= %d", loadviol);
        $assert (pass, "CoreMark: did not complete (tohost != 1)");
        $finish ();
    }
}
