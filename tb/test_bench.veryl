// Microbenchmarks for the Phase 7 v4 OoO core.
//
// Each benchmark is a bare-metal riscv-tests-style program (hex under
// test/hex/, built from test/c/) that runs to completion and writes
// tohost=1 at PA 0x80001000. The harness drives heliodor_core against a
// 256 KB DRAM (same model as the arch harness) and freezes a cycle counter
// and the core's retired-instruction count (o_dbg_rob_commit_cnt) at the
// completion cycle. IPC = instret / cycles is computed from the printed
// numbers; IPC tuning is not a goal for the 1-wide core — the benchmarks
// exist to track gross cycles/instret across changes.
//
// Run:  veryl test --ignored --test test_dhrystone   (etc.)

module test_perf_harness #(
    param HEX_FILE  : string = ""  ,
    param TOHOST_IDX: u32    = 1024,
) (
    clk        : input  clock     ,
    rst        : input  reset     ,
    o_pass     : output logic     ,
    o_tohost   : output logic<32> ,
    o_cycles   : output logic<64> ,
    o_instret  : output logic<64> ,
    o_mispredict: output logic<32>, // Phase 8 M0: committed branch mispredicts
    o_redirect  : output logic<32>, // total redirect events
    o_front_idle: output logic<32>, // front-end idle (i-fetch bubble) cycles
    o_early_mispred: output logic<32>, // S8.A: execute-time control mispredicts (>= committed)
    o_disp_stall: output logic<32>, // back-end back-pressure (rename blocked) cycles
    o_mem_busy  : output logic<32>, // single memory-port busy cycles
    o_commit0   : output logic<32>, // ROB-head retire-stall cycles
    o_load_wait : output logic<32>, // selected-load-blocked cycles
    o_load_viol : output logic<32>, // Phase 8 S9: memory-order violation events
) {
    var imem_addr      : logic<64>;
    var imem_rdata     : logic<32>;
    var imem_ren       : logic    ;
    var iptw_addr      : logic<64>;
    var iptw_rdata     : logic<64>;
    var dmem_addr      : logic<64>    ;
    var dmemw_addr      : logic<64>    ; // S23: write-channel address
    var dmem_wdata     : logic<64> [8]; // S25: write-channel line lanes
    var dmem_rdata     : logic<64>    ;
    var dmem_rdata_next: logic<64>    ;
    var dmem_wen       : logic        ;
    var dmem_ren       : logic        ;
    var dmem_wstrb     : logic<8>  [8];
    var dmem_wdata_hi  : logic<64>;
    var dmem_wstrb_hi  : logic<8> ;
    var dbg_r_commit   : logic<32>;
    var dbg_mispred    : logic<32>;
    var dbg_redirect   : logic<32>;
    var dbg_idle       : logic<32>;
    var dbg_early_mis  : logic<32>;
    var dbg_disp_stall : logic<32>;
    var dbg_mem_busy   : logic<32>;
    var dbg_commit0    : logic<32>;
    var dbg_load_wait  : logic<32>;
    var dbg_load_viol  : logic<32>;

    inst dut: heliodor_core #(
        RESET_PC: 64'h80000000,
    ) (
        clk                                        ,
        rst                                        ,
        o_imem_addr           : imem_addr          ,
        i_imem_rdata          : imem_rdata         ,
        o_imem_ren            : imem_ren           ,
        o_iptw_addr           : iptw_addr          ,
        o_iptw_req            : _                  ,
        i_iptw_rdata          : iptw_rdata         ,
        o_dmem_addr           : dmem_addr          ,
        o_dmem_wdata          : dmem_wdata         ,
        i_dmem_rdata          : dmem_rdata         ,
        i_dmem_rdata_next     : dmem_rdata_next    ,
        o_dmem_wen            : dmem_wen           ,
        o_dmem_ren            : dmem_ren           ,
        o_dmem_wstrb          : dmem_wstrb         ,
        o_dmemw_addr        : dmemw_addr      , // S23: write channel
        o_dmemw_req         : _               ,
        i_dmemw_grant       : 1'b1            ,
        o_dmem_wdata_hi       : dmem_wdata_hi      ,
        o_dmem_wstrb_hi       : dmem_wstrb_hi      ,
        o_dmem_req            : _                  ,
        i_dmem_grant          : 1'b1               ,
        i_dcache_inv_valid    : 1'b0               ,
        i_dcache_inv_addr     : 64'd0              ,
        i_dcache_inv2_valid     : 1'b0               ,
        i_dcache_inv2_addr      : 64'd0              ,
        o_dmemw_wb      : _              ,
        o_dmem_rfo      : _              ,
        i_dmem_fill_excl     : 1'b1              ,
        i_dcache_probe_v      : 1'b0              ,
        i_dcache_probe_self     : 1'b0              ,
        i_dcache_probe_addr     : 64'd0              ,
        o_dcache_probe_ack      : _              ,
        i_irq_timer_m         : 1'b0               ,
        i_irq_sw_m            : 1'b0               ,
        i_irq_ext_m           : 1'b0               ,
        i_mtime               : 64'd0              ,
        o_dbg_pc              : _                  ,
        o_dbg_regs            : _                  ,
        o_dbg_retire_v_a      : _                  ,
        o_dbg_retire_pc_a     : _                  ,
        o_dbg_retire_rd_v_a   : _                  ,
        o_dbg_retire_rd_a     : _                  ,
        o_dbg_retire_data_a   : _                  ,
        o_dbg_rename_cnt      : _                  ,
        o_dbg_cdb_cnt         : _                  ,
        o_dbg_rob_size        : _                  ,
        o_dbg_if_v            : _                  ,
        o_dbg_if_instr        : _                  ,
        o_dbg_stall_dr        : _                  ,
        o_dbg_head_valid      : _                  ,
        o_dbg_head_rw         : _                  ,
        o_dbg_head_illegal    : _                  ,
        o_dbg_rob_alloc_cnt   : _                  ,
        o_dbg_rob_cdb_cnt     : _                  ,
        o_dbg_rob_commit_cnt  : dbg_r_commit       ,
        o_dbg_rob_head        : _                  ,
        o_dbg_rob_tail        : _                  ,
        o_dbg_sepc            : _                  ,
        o_dbg_mepc            : _                  ,
        o_dbg_priv            : _                  ,
        o_dbg_trap_fire       : _                  ,
        o_dbg_trap_pc         : _                  ,
        o_dbg_trap_cause      : _                  ,
        o_dbg_trap_to_s       : _                  ,
        o_dbg_satp            : _                  ,
        o_dbg_imem_vaddr      : _                  ,
        o_dbg_imem_paddr      : _                  ,
        o_dbg_imem_valid      : _                  ,
        o_dbg_imem_fault      : _                  ,
        o_dbg_csrwr_v         : _                  ,
        o_dbg_csrwr_addr      : _                  ,
        o_dbg_csrwr_wdata     : _                  ,
        o_dbg_ptw_req         : _                  ,
        o_dbg_ptw_addr        : _                  ,
        o_dbg_ptw_data        : _                  ,
        o_dbg_redirect_fire   : _                  ,
        o_dbg_redirect_pc     : _                  ,
        o_dbg_redirect_src_pc : _                  ,
        o_dbg_mispredict_cnt  : dbg_mispred        ,
        o_dbg_redirect_cnt    : dbg_redirect       ,
        o_dbg_front_idle_cnt  : dbg_idle           ,
        o_dbg_early_mispredict_cnt: dbg_early_mis  ,
        o_dbg_disp_stall_cnt  : dbg_disp_stall     ,
        o_dbg_mem_busy_cnt    : dbg_mem_busy       ,
        o_dbg_commit0_cnt     : dbg_commit0        ,
        o_dbg_load_wait_cnt   : dbg_load_wait      ,
        o_dbg_load_viol_cnt   : dbg_load_viol      ,
        o_dbg_alu_pc_out      : _                  ,
        o_dbg_alu_src_a_out   : _                  ,
        o_dbg_alu_src_b_out   : _                  ,
        o_dbg_alu_use_pc_a_out: _                  ,
        o_dbg_alu_rs1_data_out: _                  ,
        o_dbg_alu_valid_out   : _                  ,
        o_dbg_alu_alu_out_out : _                  ,
        o_dbg_alu_instr_out   : _                  ,
        o_dbg_alu_imm_out     : _                  ,
        o_dbg_stval_out       : _                  ,
        o_dbg_mtval_out       : _                  ,
    );

    // 256 KB DRAM at PA 0x80000000.
    var dram: logic<32> [65536];
    initial {
        $readmemh(HEX_FILE, dram);
    }

    let in_dram: logic = dmem_addr[31];

    let in_dram_w : logic = dmemw_addr[31]; // S23
    // Simple UART MMIO at 0x10000000: a byte STORE prints to $write.
    let in_uart      : logic     = dmem_addr[31:28] == 4'h1;
    let in_uart_wch: logic = dmemw_addr[31:28] == 4'h1; // S23
    let dram_imem_idx: logic<16> = imem_addr[17:2];
    let dram_dmem_lo : logic<16> = {dmem_addr[17:3], 1'b0};
    let dram_dmem_hi : logic<16> = {dmem_addr[17:3], 1'b1};
    let dram_dmem_nx_lo: logic<16> = {(dmem_addr[17:3] + 15'd1), 1'b0};
    let dram_dmem_nx_hi: logic<16> = {(dmem_addr[17:3] + 15'd1), 1'b1};
    // S23: write-channel DRAM indices (independent address; S25: the lanes
    // carry the dword offsets, only the misaligned hi-side keeps dword+1).
    let dram_dmw_nx_lo: logic<16> = {(dmemw_addr[17:3] + 15'd1), 1'b0};
    let dram_dmw_nx_hi: logic<16> = {(dmemw_addr[17:3] + 15'd1), 1'b1};
    // S25: an MMIO/slow store is a one-lane line write; pick its dword.
    let uart_w_lane: logic<3>  = dmemw_addr[5:3];
    let uart_wdata : logic<64> = dmem_wdata[uart_w_lane];
    let uart_wstrb : logic<8>  = dmem_wstrb[uart_w_lane];
    assign imem_rdata      = if imem_addr[31] ? dram[dram_imem_idx] : 32'd0;
    assign dmem_rdata      = if in_dram ? {dram[dram_dmem_hi], dram[dram_dmem_lo]} : 64'd0;
    assign dmem_rdata_next = if in_dram ? {dram[dram_dmem_nx_hi], dram[dram_dmem_nx_lo]} : 64'd0;
    let dram_iptw_lo: logic<16> = {iptw_addr[17:3], 1'b0};
    let dram_iptw_hi: logic<16> = {iptw_addr[17:3], 1'b1};
    assign iptw_rdata = if iptw_addr[31] ? {dram[dram_iptw_hi], dram[dram_iptw_lo]} : 64'd0;

    always_ff (clk, rst) {
        if_reset {} else if dmem_wen && in_dram_w {
            // S25: line write — merge every populated lane.
            for l in 0..8 {
                if dmem_wstrb[l] != 8'd0 {
                    let w_lo : logic<16> = {dmemw_addr[17:6], l as 3, 1'b0};
                    let w_hi : logic<16> = {dmemw_addr[17:6], l as 3, 1'b1};
                    let w_old: logic<64> = {dram[w_hi], dram[w_lo]};
                    let w_new: logic<64> = {
                        if dmem_wstrb[l][7] ? dmem_wdata[l][63:56] : w_old[63:56],
                        if dmem_wstrb[l][6] ? dmem_wdata[l][55:48] : w_old[55:48],
                        if dmem_wstrb[l][5] ? dmem_wdata[l][47:40] : w_old[47:40],
                        if dmem_wstrb[l][4] ? dmem_wdata[l][39:32] : w_old[39:32],
                        if dmem_wstrb[l][3] ? dmem_wdata[l][31:24] : w_old[31:24],
                        if dmem_wstrb[l][2] ? dmem_wdata[l][23:16] : w_old[23:16],
                        if dmem_wstrb[l][1] ? dmem_wdata[l][15:8] : w_old[15:8],
                        if dmem_wstrb[l][0] ? dmem_wdata[l][7:0] : w_old[7:0]
                    };
                    dram[w_lo] = w_new[31:0];
                    dram[w_hi] = w_new[63:32];
                }
            }
            if dmem_wstrb_hi[0] {
                dram[dram_dmw_nx_lo][7:0] = dmem_wdata_hi[7:0];
            }
            if dmem_wstrb_hi[1] {
                dram[dram_dmw_nx_lo][15:8] = dmem_wdata_hi[15:8];
            }
            if dmem_wstrb_hi[2] {
                dram[dram_dmw_nx_lo][23:16] = dmem_wdata_hi[23:16];
            }
            if dmem_wstrb_hi[3] {
                dram[dram_dmw_nx_lo][31:24] = dmem_wdata_hi[31:24];
            }
            if dmem_wstrb_hi[4] {
                dram[dram_dmw_nx_hi][7:0] = dmem_wdata_hi[39:32];
            }
            if dmem_wstrb_hi[5] {
                dram[dram_dmw_nx_hi][15:8] = dmem_wdata_hi[47:40];
            }
            if dmem_wstrb_hi[6] {
                dram[dram_dmw_nx_hi][23:16] = dmem_wdata_hi[55:48];
            }
            if dmem_wstrb_hi[7] {
                dram[dram_dmw_nx_hi][31:24] = dmem_wdata_hi[63:56];
            }
        } else if dmem_wen && in_uart_wch {
            if uart_wstrb[0] {
                $write("%c", uart_wdata[7:0]);
            }
            if uart_wstrb[1] {
                $write("%c", uart_wdata[15:8]);
            }
            if uart_wstrb[2] {
                $write("%c", uart_wdata[23:16]);
            }
            if uart_wstrb[3] {
                $write("%c", uart_wdata[31:24]);
            }
            if uart_wstrb[4] {
                $write("%c", uart_wdata[39:32]);
            }
            if uart_wstrb[5] {
                $write("%c", uart_wdata[47:40]);
            }
            if uart_wstrb[6] {
                $write("%c", uart_wdata[55:48]);
            }
            if uart_wstrb[7] {
                $write("%c", uart_wdata[63:56]);
            }
        }
    }

    let tohost_lo: logic<32> = dram[TOHOST_IDX[15:0]];
    let done     : logic     = tohost_lo == 32'd1;
    assign o_tohost = tohost_lo;
    assign o_pass   = done;

    // Freeze the cycle counter and the retired-instruction count at the
    // completion cycle (the program spins after writing tohost, which would
    // otherwise keep inflating both).
    var running   : logic    ;
    var cyc       : logic<64>;
    var iret      : logic<64>;
    var mispred_f : logic<32>;
    var redirect_f: logic<32>;
    var idle_f    : logic<32>;
    var early_f   : logic<32>;
    var disp_f    : logic<32>;
    var membusy_f : logic<32>;
    var commit0_f : logic<32>;
    var loadwait_f: logic<32>;
    var loadviol_f: logic<32>;
    always_ff (clk, rst) {
        if_reset {
            running    = 1'b1;
            cyc        = 64'd0;
            iret       = 64'd0;
            mispred_f  = 32'd0;
            redirect_f = 32'd0;
            idle_f     = 32'd0;
            early_f    = 32'd0;
            disp_f     = 32'd0;
            membusy_f  = 32'd0;
            commit0_f  = 32'd0;
            loadwait_f = 32'd0;
            loadviol_f = 32'd0;
        } else if running {
            if done {
                running = 1'b0;
            } else {
                cyc        = cyc + 64'd1;
                iret       = {32'd0, dbg_r_commit};
                mispred_f  = dbg_mispred;
                redirect_f = dbg_redirect;
                idle_f     = dbg_idle;
                early_f    = dbg_early_mis;
                disp_f     = dbg_disp_stall;
                membusy_f  = dbg_mem_busy;
                commit0_f  = dbg_commit0;
                loadwait_f = dbg_load_wait;
                loadviol_f = dbg_load_viol;
            }
        }
    }
    assign o_cycles   = cyc;
    assign o_instret  = iret;
    assign o_mispredict = mispred_f;
    assign o_redirect   = redirect_f;
    assign o_front_idle = idle_f;
    assign o_early_mispred = early_f;
    assign o_disp_stall = disp_f;
    assign o_mem_busy   = membusy_f;
    assign o_commit0    = commit0_f;
    assign o_load_wait  = loadwait_f;
    assign o_load_viol  = loadviol_f;
}

#[test(test_dhrystone)]
#[ignore]
module test_dhrystone {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass     : logic    ;
    var tohost   : logic<32>;
    var cycles   : logic<64>;
    var instret  : logic<64>;
    var mispred  : logic<32>;
    var redirect : logic<32>;
    var frontidle: logic<32>;
    var early    : logic<32>;
    var dispstall: logic<32>;
    var membusy  : logic<32>;
    var commit0  : logic<32>;
    var loadwait : logic<32>;
    var loadviol : logic<32>;

    inst h: test_perf_harness #(
        HEX_FILE  : "test/hex/dhrystone.hex",
        TOHOST_IDX: 1024                    ,
    ) (
        clk                 ,
        rst                 ,
        o_pass     : pass     ,
        o_tohost   : tohost   ,
        o_cycles   : cycles   ,
        o_instret  : instret  ,
        o_mispredict: mispred  ,
        o_redirect  : redirect ,
        o_front_idle: frontidle,
        o_early_mispred: early ,
        o_disp_stall: dispstall,
        o_mem_busy  : membusy  ,
        o_commit0   : commit0  ,
        o_load_wait : loadwait ,
        o_load_viol : loadviol ,
    );

    initial {
        rst.assert(clk);
        for _i in 0..300 {
            clk.next(10000);
            if pass {
                break;
            }
        }
        $display("=== Dhrystone ===");
        $display("  tohost  = %h", tohost);
        $display("  cycles  = %d", cycles);
        $display("  instret = %d", instret);
        $display("  mispred = %d", mispred);
        $display("  redirect= %d", redirect);
        $display("  frontidl= %d", frontidle);
        $display("  earlymis= %d", early);
        $display("  dispstl = %d", dispstall);
        $display("  membusy = %d", membusy);
        $display("  commit0 = %d", commit0);
        $display("  loadwait= %d", loadwait);
        $display("  loadviol= %d", loadviol);
        $assert (pass, "Dhrystone: did not complete (tohost != 1)");
        $finish ();
    }
}

#[test(test_bench_memcpy)]
#[ignore]
module test_bench_memcpy {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass     : logic    ;
    var tohost   : logic<32>;
    var cycles   : logic<64>;
    var instret  : logic<64>;
    var mispred  : logic<32>;
    var redirect : logic<32>;
    var frontidle: logic<32>;
    var early    : logic<32>;
    var dispstall: logic<32>;
    var membusy  : logic<32>;
    var commit0  : logic<32>;
    var loadwait : logic<32>;
    var loadviol : logic<32>;

    inst h: test_perf_harness #(
        HEX_FILE  : "test/hex/bench_memcpy.hex",
        TOHOST_IDX: 1024                       ,
    ) (
        clk                 ,
        rst                 ,
        o_pass     : pass     ,
        o_tohost   : tohost   ,
        o_cycles   : cycles   ,
        o_instret  : instret  ,
        o_mispredict: mispred  ,
        o_redirect  : redirect ,
        o_front_idle: frontidle,
        o_early_mispred: early ,
        o_disp_stall: dispstall,
        o_mem_busy  : membusy  ,
        o_commit0   : commit0  ,
        o_load_wait : loadwait ,
        o_load_viol : loadviol ,
    );

    initial {
        rst.assert(clk);
        for _i in 0..300 {
            clk.next(10000);
            if pass {
                break;
            }
        }
        $display("=== memcpy ===");
        $display("  tohost  = %h", tohost);
        $display("  cycles  = %d", cycles);
        $display("  instret = %d", instret);
        $display("  mispred = %d", mispred);
        $display("  redirect= %d", redirect);
        $display("  frontidl= %d", frontidle);
        $display("  earlymis= %d", early);
        $display("  dispstl = %d", dispstall);
        $display("  membusy = %d", membusy);
        $display("  commit0 = %d", commit0);
        $display("  loadwait= %d", loadwait);
        $display("  loadviol= %d", loadviol);
        $assert (pass, "memcpy: did not complete (tohost != 1)");
        $finish ();
    }
}

