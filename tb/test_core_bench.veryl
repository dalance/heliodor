// New-core bench wrappers: dhrystone and coremark (integer), fpmm (double
// FMA-bound matrix multiply) and spmv (double sparse matrix-vector, load
// bound) on arch_soc_harness. Pass = tohost 1; arch_soc_harness prints the
// cycles, instret and the perf counter dump. Not a gate: run one config's
// set with e.g.
//   veryl test --ignored --test test_cbench_w2

#[test(test_cbench_w2_dhrystone)]
#[ignore]
module test_cbench_w2_dhrystone {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var pass  : logic    ;
    var fail  : logic    ;
    var tohost: logic<32>;
    inst h: arch_soc_harness #(
        CORE      : tb_core_sel::CORE_W2    ,
        HEX_FILE  : "test/hex/dhrystone.hex",
        TOHOST_IDX: 1024                    ,
    ) (
        clk             ,
        rst             ,
        o_pass  : pass  ,
        o_fail  : fail  ,
        o_tohost: tohost,
    );
    initial {
        rst.assert(clk);
        for _i in 0..2000 {
            clk.next(10000);
            if pass || fail {
                break;
            }
        }
        $display("w2 bench dhrystone: tohost=%h pass=%b", tohost, pass);
        $assert(pass, "w2 bench dhrystone fail");
        $finish();
    }
}

