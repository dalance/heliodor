// The 5.15 N=1 boot (test_w2_linux_boot) under a name no other test
// contains, so the perf sweep can run it alone:
//   veryl test --ignored --test test_cboot_w2
#[test(test_cboot_w2)]
#[ignore]
module test_cboot_w2 {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var pass: logic;
    inst h: boot_soc_harness #(
        CORE: tb_core_sel::CORE_W2,
    ) (
        clk              ,
        rst              ,
        o_pass   : pass  ,
        o_fail   : _     ,
        o_x3     : _     ,
        o_cycles : _     ,
        o_instret: _     ,
        o_last_pc: _     ,
        o_ret_cnt: _     ,
        o_traps  : _     ,
    );
    initial {
        rst.assert(clk);
        for _i in 0..3700 {
            clk.next(10000);
            if pass {
                break;
            }
        }
        $assert(pass, "w2 boot: did not reach SBI shutdown");
        $finish();
    }
}

