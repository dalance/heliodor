// Scalar FP units (fu_fma, fu_fmisc, fu_fdiv) against the old core's
// fpu_wrap as the reference model: random and special-value operands of the
// op's format, every rounding mode, results and fflags bit-exact, random
// kills, and the latency of each unit.
//
// fp_misc deliberately differs from fpu_wrap in a few input windows where
// fpu_wrap is wrong (see known_div); a mismatch inside such a window is
// counted apart, and test_fp_misc_directed checks the correct value there.
package fp_tb_pkg {
    import fpu_pkg::*;

    function mix (
        x: input logic<64>,
    ) -> logic<64> {
        var z: logic<64>;
        z = x + 64'h9e37_79b9_7f4a_7c15;
        z = (z ^ (z >> 30)) * 64'hbf58_476d_1ce4_e5b9;
        z = (z ^ (z >> 27)) * 64'h94d0_49bb_1331_11eb;
        return z ^ (z >> 31);
    }

    // Exponents next to the rounding, overflow and integer-range boundaries
    // of every conversion and of the arithmetic.
    function d_exp (
        i: input logic<5>,
    ) -> logic<11> {
        return case i {
            5'd0   : 11'd0,
            5'd1   : 11'd1,
            5'd2   : 11'd2,
            5'd3   : 11'h7FE,
            5'd4   : 11'h7FF,
            5'd5   : 11'd1023,
            5'd6   : 11'd1022,
            5'd7   : 11'd1021,
            5'd8   : 11'd1024,
            5'd9   : 11'd1053,
            5'd10  : 11'd1054,
            5'd11  : 11'd1055,
            5'd12  : 11'd1075,
            5'd13  : 11'd1076,
            5'd14  : 11'd1074,
            5'd15  : 11'd1085,
            5'd16  : 11'd1086,
            5'd17  : 11'd1087,
            5'd18  : 11'd896,
            5'd19  : 11'd895,
            5'd20  : 11'd897,
            5'd21  : 11'd874,
            5'd22  : 11'd1150,
            5'd23  : 11'd1151,
            5'd24  : 11'd1152,
            5'd25  : 11'd998,
            5'd26  : 11'd999,
            5'd27  : 11'd1008,
            5'd28  : 11'd1007,
            5'd29  : 11'd1037,
            5'd30  : 11'd1038,
            default: 11'd1039,
        };
    }

    function s_exp (
        i: input logic<5>,
    ) -> logic<8> {
        return case i {
            5'd0   : 8'd0,
            5'd1   : 8'd1,
            5'd2   : 8'd2,
            5'd3   : 8'd254,
            5'd4   : 8'd255,
            5'd5   : 8'd127,
            5'd6   : 8'd126,
            5'd7   : 8'd125,
            5'd8   : 8'd128,
            5'd9   : 8'd150,
            5'd10  : 8'd151,
            5'd11  : 8'd149,
            5'd12  : 8'd157,
            5'd13  : 8'd158,
            5'd14  : 8'd159,
            5'd15  : 8'd189,
            5'd16  : 8'd190,
            5'd17  : 8'd191,
            5'd18  : 8'd112,
            5'd19  : 8'd111,
            5'd20  : 8'd113,
            5'd21  : 8'd102,
            5'd22  : 8'd101,
            5'd23  : 8'd103,
            5'd24  : 8'd141,
            5'd25  : 8'd142,
            5'd26  : 8'd143,
            5'd27  : 8'd100,
            5'd28  : 8'd140,
            5'd29  : 8'd160,
            5'd30  : 8'd64,
            default: 8'd192,
        };
    }

    // A fraction pattern: random, zero, all ones, top bit, bottom bit,
    // random with random trailing zeros (exact values and ties), ones with
    // a random tail, and a lone bit at a random position.
    function frac (
        r: input logic<64>,
        k: input logic<3> ,
    ) -> logic<64> {
        return case k {
            3'd0   : r,
            3'd1   : 64'd0,
            3'd2   : '1,
            3'd3   : 64'h8000_0000_0000_0000,
            3'd4   : 64'd1,
            3'd5   : (r >> r[63:58]) << r[63:58],
            3'd6   : {r[7:0] | 8'hF0, 56'hFF_FFFF_FFFF_FFFF} >> r[5:0],
            default: 64'h8000_0000_0000_0000 >> r[63:58],
        };
    }

    // q chooses the class, r supplies the bits.
    function gen_d (
        r: input logic<64>,
        q: input logic<64>,
    ) -> logic<64> {
        let f: logic<64> = frac(r, q[2:0]);
        let e: logic<11> = if q[5:3] <: 3'd3 ? d_exp(q[10:6]) : r[62:52];
        return {q[11], e, f[63:12]};
    }

    function gen_s (
        r: input logic<64>,
        q: input logic<64>,
    ) -> logic<32> {
        let f: logic<64> = frac(r, q[2:0]);
        let e: logic<8>  = if q[5:3] <: 3'd3 ? s_exp(q[10:6]) : r[62:55];
        return {q[11], e, f[63:41]};
    }

    function gen_h (
        r: input logic<64>,
        q: input logic<64>,
    ) -> logic<16> {
        let f: logic<64> = frac(r, q[2:0]);
        let e: logic<5>  = case q[5:3] {
            3'd0   : 5'd0,
            3'd1   : 5'd31,
            3'd2   : 5'd30,
            3'd3   : 5'd1,
            default: r[62:58],
        };
        return {q[11], e, f[63:54]};
    }

    function gen_i (
        r: input logic<64>,
        q: input logic<64>,
    ) -> logic<64> {
        let f: logic<64> = frac(r, q[2:0]);
        return case q[5:3] {
            3'd0: {r[7] repeat 56, r[7:0]},
            3'd1: {f[31] repeat 32, f[31:0]},
            3'd2: {32'd0, f[31:0]},
            3'd3: case r[2:0] {
                3'd0   : 64'h0000_0000_7FFF_FFFF,
                3'd1   : 64'hFFFF_FFFF_8000_0000,
                3'd2   : 64'h0000_0000_FFFF_FFFF,
                3'd3   : 64'h8000_0000_0000_0000,
                3'd4   : 64'h7FFF_FFFF_FFFF_FFFF,
                3'd5   : 64'h0000_0000_0100_0001,
                3'd6   : '1,
                default: 64'd0,
            },
            default: if q[6] ? f : r,
        };
    }

    const SRC_S: logic<2> = 2'd0;
    const SRC_D: logic<2> = 2'd1;
    const SRC_H: logic<2> = 2'd2;
    const SRC_I: logic<2> = 2'd3;

    // Format of rs1 of an op (rs2 and rs3 share it, or are unused).
    function src_fmt (
        op: input FpuOp,
    ) -> logic<2> {
        return case op {
            FpuOp::FCVT_S_W, FpuOp::FCVT_S_WU, FpuOp::FCVT_S_L, FpuOp::FCVT_S_LU, FpuOp::FCVT_D_W, FpuOp::FCVT_D_WU,
            FpuOp::FCVT_D_L, FpuOp::FCVT_D_LU, FpuOp::FMV_W_X, FpuOp::FMV_D_X, FpuOp::FMV_H_X: SRC_I,
            FpuOp::FCVT_S_H, FpuOp::FCVT_D_H, FpuOp::FMV_X_H: SRC_H,
            FpuOp::FADD_D, FpuOp::FSUB_D, FpuOp::FMUL_D, FpuOp::FDIV_D, FpuOp::FSQRT_D, FpuOp::FMIN_D, FpuOp::FMAX_D,
            FpuOp::FSGNJ_D, FpuOp::FSGNJN_D, FpuOp::FSGNJX_D, FpuOp::FCVT_W_D, FpuOp::FCVT_WU_D, FpuOp::FCVT_L_D,
            FpuOp::FCVT_LU_D, FpuOp::FMV_X_D, FpuOp::FEQ_D, FpuOp::FLT_D, FpuOp::FLE_D, FpuOp::FCLASS_D, FpuOp::FMADD_D,
            FpuOp::FMSUB_D, FpuOp::FNMADD_D, FpuOp::FNMSUB_D, FpuOp::FCVT_S_D, FpuOp::FMINM_D, FpuOp::FMAXM_D,
            FpuOp::FLEQ_D, FpuOp::FLTQ_D, FpuOp::FROUND_D, FpuOp::FROUNDNX_D, FpuOp::FCVTMOD_W_D,
            FpuOp::FCVT_H_D: SRC_D,
            default: SRC_S,
        };
    }

    // An operand of format f; one in sixteen single or half operands is
    // left without its NaN box.
    function gen_op (
        f: input logic<2> ,
        r: input logic<64>,
        q: input logic<64>,
    ) -> logic<64> {
        let unboxed: logic = q[15:12] == 4'd0;
        return case f {
            SRC_D  : gen_d(r, q),
            SRC_H  : if unboxed ? r : box_h(gen_h(r, q)),
            SRC_I  : gen_i(r, q),
            default: if unboxed ? r : box_s(gen_s(r, q)),
        };
    }

    const FMA_OPS: u32 = 14;

    function fma_op (
        i: input logic<4>,
    ) -> FpuOp {
        return case i {
            4'd0   : FpuOp::FADD_S,
            4'd1   : FpuOp::FSUB_S,
            4'd2   : FpuOp::FMUL_S,
            4'd3   : FpuOp::FMADD_S,
            4'd4   : FpuOp::FMSUB_S,
            4'd5   : FpuOp::FNMADD_S,
            4'd6   : FpuOp::FNMSUB_S,
            4'd7   : FpuOp::FADD_D,
            4'd8   : FpuOp::FSUB_D,
            4'd9   : FpuOp::FMUL_D,
            4'd10  : FpuOp::FMADD_D,
            4'd11  : FpuOp::FMSUB_D,
            4'd12  : FpuOp::FNMADD_D,
            default: FpuOp::FNMSUB_D,
        };
    }

    const MISC_OPS: u32 = 59;

    function misc_op (
        i: input logic<6>,
    ) -> FpuOp {
        return case i {
            6'd0   : FpuOp::FMIN_S,
            6'd1   : FpuOp::FMAX_S,
            6'd2   : FpuOp::FSGNJ_S,
            6'd3   : FpuOp::FSGNJN_S,
            6'd4   : FpuOp::FSGNJX_S,
            6'd5   : FpuOp::FCVT_W_S,
            6'd6   : FpuOp::FCVT_WU_S,
            6'd7   : FpuOp::FCVT_S_W,
            6'd8   : FpuOp::FCVT_S_WU,
            6'd9   : FpuOp::FCVT_L_S,
            6'd10  : FpuOp::FCVT_LU_S,
            6'd11  : FpuOp::FCVT_S_L,
            6'd12  : FpuOp::FCVT_S_LU,
            6'd13  : FpuOp::FMV_X_W,
            6'd14  : FpuOp::FMV_W_X,
            6'd15  : FpuOp::FEQ_S,
            6'd16  : FpuOp::FLT_S,
            6'd17  : FpuOp::FLE_S,
            6'd18  : FpuOp::FCLASS_S,
            6'd19  : FpuOp::FMIN_D,
            6'd20  : FpuOp::FMAX_D,
            6'd21  : FpuOp::FSGNJ_D,
            6'd22  : FpuOp::FSGNJN_D,
            6'd23  : FpuOp::FSGNJX_D,
            6'd24  : FpuOp::FCVT_W_D,
            6'd25  : FpuOp::FCVT_WU_D,
            6'd26  : FpuOp::FCVT_D_W,
            6'd27  : FpuOp::FCVT_D_WU,
            6'd28  : FpuOp::FCVT_L_D,
            6'd29  : FpuOp::FCVT_LU_D,
            6'd30  : FpuOp::FCVT_D_L,
            6'd31  : FpuOp::FCVT_D_LU,
            6'd32  : FpuOp::FMV_X_D,
            6'd33  : FpuOp::FMV_D_X,
            6'd34  : FpuOp::FEQ_D,
            6'd35  : FpuOp::FLT_D,
            6'd36  : FpuOp::FLE_D,
            6'd37  : FpuOp::FCLASS_D,
            6'd38  : FpuOp::FCVT_S_D,
            6'd39  : FpuOp::FCVT_D_S,
            6'd40  : FpuOp::FMINM_S,
            6'd41  : FpuOp::FMAXM_S,
            6'd42  : FpuOp::FMINM_D,
            6'd43  : FpuOp::FMAXM_D,
            6'd44  : FpuOp::FLEQ_S,
            6'd45  : FpuOp::FLTQ_S,
            6'd46  : FpuOp::FLEQ_D,
            6'd47  : FpuOp::FLTQ_D,
            6'd48  : FpuOp::FCVTMOD_W_D,
            6'd49  : FpuOp::FLI_S,
            6'd50  : FpuOp::FLI_D,
            6'd51  : FpuOp::FCVT_S_H,
            6'd52  : FpuOp::FCVT_H_S,
            6'd53  : FpuOp::FCVT_D_H,
            6'd54  : FpuOp::FCVT_H_D,
            6'd55  : FpuOp::FMV_X_H,
            6'd56  : FpuOp::FMV_H_X,
            6'd57  : FpuOp::FCVT_W_S,
            default: FpuOp::FCVT_S_D,
        };
    }

    function fdiv_op (
        i: input logic<3>,
    ) -> FpuOp {
        return case i {
            3'd0   : FpuOp::FDIV_S,
            3'd1   : FpuOp::FSQRT_S,
            3'd2   : FpuOp::FDIV_D,
            3'd3   : FpuOp::FSQRT_D,
            3'd4   : FpuOp::FROUND_S,
            3'd5   : FpuOp::FROUNDNX_S,
            3'd6   : FpuOp::FROUND_D,
            default: FpuOp::FROUNDNX_D,
        };
    }

    // Static rm field: the five rounding modes and DYN.
    function gen_rm (
        r: input logic<3>,
    ) -> logic<3> {
        return if r >: 3'd4 ? 3'b111 : r;
    }

    // Input windows where fpu_wrap is known to be wrong and fp_misc is not:
    //   FCVT.W.D/FCVTMOD.W.D: |x| in [2^30, 2^32): positive values rounding up
    //     to 2^31 raise NX instead of NV; negative values in (2^31, 2^31 + 1)
    //     that round to -2^31 raise NV instead of NX
    //   FCVT.WU.D: values in [2^31, 2^32) rounding up to 2^32 raise NX, not NV
    //   FCVT.L.D: |x| in [2^53, 2^63) is not shifted left (2^53 gives 2^52)
    //   FCVT.S.D: rounding up to 2^128 does not raise OF; values just below
    //     2^-126 that round to it raise UF (tininess is after rounding)
    //   FCVT.H.D: |x| < 2^-24 always becomes zero, whatever the rounding
    //     mode; values just below 2^-14 that round to it raise UF
    //   FCVT.H.S: values just below 2^-14 that round to it raise UF
    function known_div (
        op: input FpuOp    ,
        a : input logic<64>,
    ) -> logic {
        let de: logic<11> = a[62:52];
        let sv: logic<32> = unbox_s(a);
        let se: logic<8>  = sv[30:23];
        return case op {
            FpuOp::FCVT_W_D, FpuOp::FCVTMOD_W_D: de == 11'd1053 || de == 11'd1054,
            FpuOp::FCVT_WU_D                   : de == 11'd1054,
            FpuOp::FCVT_L_D                    : de >: 11'd1075 && de <: 11'd1086,
            FpuOp::FCVT_S_D                    : de == 11'd896 || de == 11'd1150,
            FpuOp::FCVT_H_D                    : de <: 11'd999 || de == 11'd1008,
            FpuOp::FCVT_H_S                    : se == 8'd112,
            default                            : 1'b0,
        };
    }
}

// fu_fma and fu_fmisc fed a random stream (at most one op per cycle) under
// random kills; each WB packet is checked against fpu_wrap's result for the
// same op LAT cycles earlier.
module fp_pipe_harness::<CFG: core_cfg> #(
    param SEED: logic<64> = 64'd1,
) (
    clk    : input  clock    ,
    rst    : input  reset    ,
    o_cmp  : output logic<32>, // packets compared
    o_err  : output logic<32>, // mismatches outside the known windows
    o_known: output logic<32>, // mismatches inside them
    o_kills: output logic<32>, // ops removed by a kill
    o_e_op : output logic<7> , // first mismatch: op, operands, rm, frm
    o_e_a  : output logic<64>,
    o_e_b  : output logic<64>,
    o_e_c  : output logic<64>,
    o_e_rm : output logic<6> ,
    o_e_exp: output logic<69>, // {fflags, data} expected
    o_e_got: output logic<69>,
) {
    import core_types::<CFG>::*;
    import fpu_pkg::*;
    import fp_tb_pkg::*;

    function next_tag (
        t: input RobTag,
    ) -> RobTag {
        return ((t as ROB_TAG_W) + 1) as RobTag;
    }

    var cyc_q : logic <64>    ;
    var tagc_q: RobTag        ;
    var hist_q: RobTag     [8];
    var kill_q: Kill          ;

    let r0: logic<64> = mix(SEED ^ (cyc_q << 3));
    let r1: logic<64> = mix(r0);
    let r2: logic<64> = mix(r1);
    let r3: logic<64> = mix(r2);
    let r4: logic<64> = mix(r3);
    let r5: logic<64> = mix(r4);
    let r6: logic<64> = mix(r5);
    let r7: logic<64> = mix(r6);

    // ---- Stimulus ----

    let issue : logic     = r0[2:0] != 3'd0 && cyc_q >: 64'd2;
    let to_fma: logic     = r0[4:3] == 2'd0;
    let op_fma: FpuOp     = fma_op((r0[11:8] % FMA_OPS) as 4);
    let op_mis: FpuOp     = misc_op((r0[17:12] % MISC_OPS) as 6);
    let op    : FpuOp     = if to_fma ? op_fma : op_mis;
    let fmt   : logic<2>  = src_fmt(op);
    let a     : logic<64> = gen_op(fmt, r1, r2);
    let b_raw : logic<64> = gen_op(fmt, r3, r4);
    let b     : logic<64> = case r0[23:21] {
        3'd0   : a,
        3'd1   : a ^ (if fmt == SRC_D ? 64'h8000_0000_0000_0000 : 64'h0000_0000_8000_0000),
        default: b_raw,
    };
    let c   : logic <64> = gen_op(fmt, r5, r6);
    let rm  : logic <3>  = gen_rm(r0[26:24]);
    let frm : logic <3>  = (r0[29:27] % 3'd5) as 3;
    let fli : logic <5>  = r7[4:0];
    let keep: RobTag     = if r7[13] ? tagc_q : hist_q[r7[16:14]];

    var tag: ExTag;
    always_comb {
        tag        = 0 as ExTag;
        tag.rob    = tagc_q;
        tag.has_rd = 1'b1;
    }

    // ---- Reference ----

    var ref_cdb: pipeline_pkg::CdbBus   ;
    var ref_ffl: logic               <5>;
    inst u_ref: fpu_wrap (
        clk                        ,
        rst                        ,
        i_issue_valid     : 1'b1   ,
        i_fpu_op          : op     ,
        i_fp_rm           : rm     ,
        i_fli_idx         : fli    ,
        i_frm             : frm    ,
        i_issue_rd_pdst   : 6'd0   ,
        i_issue_rob_idx   : 5'd0   ,
        i_issue_has_rd    : 1'b1   ,
        i_issue_writes_int: 1'b0   ,
        i_s1_data         : a      ,
        i_s2_data         : b      ,
        i_s3_data         : c      ,
        i_int_rs1_data    : a      ,
        i_flush           : 1'b0   ,
        o_fpu_busy        : _      ,
        o_cdb             : ref_cdb,
        o_fflags          : ref_ffl,
        o_fflags_wen      : _      ,
        o_dest_is_fp      : _      ,
    );

    // ---- DUTs ----

    var src3: logic<64> [3];
    always_comb {
        src3[0] = a;
        src3[1] = b;
        src3[2] = c;
    }
    var src2: logic<64> [2];
    always_comb {
        src2[0] = a;
        src2[1] = b;
    }

    var wb_fma : WbPacket;
    var rdy_fma: logic   ;
    inst u_fma: fu_fma::<CFG> (
        clk                     ,
        rst                     ,
        i_valid: issue && to_fma,
        i_op   : op             ,
        i_tag  : tag            ,
        i_src  : src3           ,
        i_rm   : rm             ,
        i_frm  : frm            ,
        i_kill : kill_q         ,
        o_ready: rdy_fma        ,
        o_wb   : wb_fma         ,
    );

    var wb_mis : WbPacket;
    var rdy_mis: logic   ;
    inst u_mis: fu_fmisc::<CFG> (
        clk                      ,
        rst                      ,
        i_valid: issue && !to_fma,
        i_op   : op              ,
        i_tag  : tag             ,
        i_src  : src2            ,
        i_imm  : {27'd0, fli},
        i_rm   : rm              ,
        i_frm  : frm             ,
        i_kill : kill_q          ,
        o_ready: rdy_mis         ,
        o_wb   : wb_mis          ,
    );

    // ---- Expected packets ----

    struct Exp {
        valid: logic     ,
        tag  : RobTag    ,
        data : logic <64>,
        ffl  : logic <5> ,
        op   : FpuOp     ,
        a    : logic <64>,
        b    : logic <64>,
        c    : logic <64>,
        rm   : logic <6> ,
    }

    var now: Exp;
    always_comb {
        now.valid = 1'b0;
        now.tag   = tagc_q;
        now.data  = ref_cdb.data;
        now.ffl   = ref_ffl;
        now.op    = op;
        now.a     = a;
        now.b     = b;
        now.c     = c;
        now.rm    = {rm, frm};
    }

    var e_mis_q : Exp;
    var e_fma1_q: Exp;
    var e_fma2_q: Exp;

    function bad (
        w: input WbPacket,
        e: input Exp     ,
    ) -> logic {
        return w.valid != e.valid
            || (e.valid && (w.tag.rob != e.tag || w.data != e.data || w.fflags != e.ffl || w.exc != 0 || w.br != 0));
    }

    let bad_mis: logic = bad(wb_mis, e_mis_q);
    let bad_fma: logic = bad(wb_fma, e_fma2_q);
    // fu_fmisc mismatches inside a known fpu_wrap window are counted apart.
    let known: logic    = bad_mis && wb_mis.valid && e_mis_q.valid && known_div(e_mis_q.op, e_mis_q.a);
    let e_sel: Exp      = if bad_mis ? e_mis_q : e_fma2_q;
    let w_sel: WbPacket = if bad_mis ? wb_mis : wb_fma;

    var cmp_q  : logic<32>;
    var err_q  : logic<32>;
    var known_q: logic<32>;
    var kills_q: logic<32>;
    var e_op_q : logic<7> ;
    var e_a_q  : logic<64>;
    var e_b_q  : logic<64>;
    var e_c_q  : logic<64>;
    var e_rm_q : logic<6> ;
    var e_exp_q: logic<69>;
    var e_got_q: logic<69>;

    always_ff {
        if_reset {
            cyc_q    = 0;
            tagc_q   = 0 as RobTag;
            hist_q   = '{default: 0 as RobTag};
            kill_q   = 0 as Kill;
            e_mis_q  = 0 as Exp;
            e_fma1_q = 0 as Exp;
            e_fma2_q = 0 as Exp;
            cmp_q    = 0;
            err_q    = 0;
            known_q  = 0;
            kills_q  = 0;
            e_op_q   = 0;
            e_a_q    = 0;
            e_b_q    = 0;
            e_c_q    = 0;
            e_rm_q   = 0;
            e_exp_q  = 0;
            e_got_q  = 0;
        } else {
            cyc_q = cyc_q + 1;
            if issue {
                tagc_q = next_tag(tagc_q);
                for i in 1..8 {
                    hist_q[i] = hist_q[i - 1];
                }
                hist_q[0] = tagc_q;
            }

            // A kill one cycle in eight; a partial kill keeps the op it
            // names and everything older.
            kill_q       = 0 as Kill;
            kill_q.valid = r7[10:8] == 3'd0 && cyc_q >: 64'd2;
            kill_q.full  = r7[12:11] == 2'd0;
            kill_q.keep  = keep;

            e_mis_q        = now;
            e_mis_q.valid  = issue && !to_fma && !killed(kill_q, tagc_q);
            e_fma1_q       = now;
            e_fma1_q.valid = issue && to_fma && !killed(kill_q, tagc_q);
            e_fma2_q       = e_fma1_q;
            e_fma2_q.valid = e_fma1_q.valid && !killed(kill_q, e_fma1_q.tag);
            if (issue && killed(kill_q, tagc_q)) || (e_fma1_q.valid && killed(kill_q, e_fma1_q.tag)) {
                kills_q = kills_q + 1;
            }

            if wb_mis.valid {
                cmp_q = cmp_q + 1;
            }
            if wb_fma.valid {
                cmp_q = cmp_q + 1;
            }
            if known {
                known_q = known_q + 1;
            } else if bad_mis || bad_fma {
                if err_q == 0 {
                    e_op_q  = e_sel.op;
                    e_a_q   = e_sel.a;
                    e_b_q   = e_sel.b;
                    e_c_q   = e_sel.c;
                    e_rm_q  = e_sel.rm;
                    e_exp_q = {e_sel.ffl, e_sel.data};
                    e_got_q = {w_sel.fflags, w_sel.data};
                }
                err_q = err_q + 1;
            }
            if !rdy_fma || !rdy_mis {
                err_q = err_q + 1;
            }
        }
    }

    assign o_cmp   = cmp_q;
    assign o_err   = err_q;
    assign o_known = known_q;
    assign o_kills = kills_q;
    assign o_e_op  = e_op_q;
    assign o_e_a   = e_a_q;
    assign o_e_b   = e_b_q;
    assign o_e_c   = e_c_q;
    assign o_e_rm  = e_rm_q;
    assign o_e_exp = e_exp_q;
    assign o_e_got = e_got_q;
}

// fu_fdiv, one op at a time against fpu_wrap: random hole-fill grant
// offsets, random kills while the op is in the unit, o_ready, and the WB
// cycle (FROUND: A + 4 + offset; never earlier than A + LAT_FDIV).
module fp_fdiv_harness::<CFG: core_cfg> #(
    param SEED: logic<64> = 64'd7,
) (
    clk      : input  clock    ,
    rst      : input  reset    ,
    o_ops    : output logic<32>, // ops completed and compared
    o_err    : output logic<32>,
    o_kills  : output logic<32>, // ops removed by a kill
    o_min_lat: output logic<32>, // smallest A to WB distance seen
    o_chk    : output logic<2> ,
    o_aborts : output logic<32>, // o_perf events
    o_e_op   : output logic<7> ,
    o_e_a    : output logic<64>,
    o_e_b    : output logic<64>,
    o_e_rm   : output logic<6> ,
    o_e_exp  : output logic<69>,
    o_e_got  : output logic<69>,
) {
    import core_types::<CFG>::*;
    import fpu_pkg::*;
    import fp_tb_pkg::*;
    import fu_pkg::*;

    function next_tag (
        t: input RobTag,
    ) -> RobTag {
        return ((t as ROB_TAG_W) + 1) as RobTag;
    }

    var cyc_q : logic <64>;
    var tagc_q: RobTag    ;
    var prev_q: RobTag    ;

    let r0: logic<64> = mix(SEED ^ (cyc_q << 2));
    let r1: logic<64> = mix(r0);
    let r2: logic<64> = mix(r1);
    let r3: logic<64> = mix(r2);
    let r4: logic<64> = mix(r3);
    let r5: logic<64> = mix(r4);

    // ---- The op in flight ----

    var busy_q: logic    ; // an op was issued and is not finished
    var op_q  : FpuOp    ;
    var a_q   : logic<64>;
    var b_q   : logic<64>;
    var rm_q  : logic<3> ;
    var frm_q : logic<3> ;
    var acc_q : logic<64>; // cycle A
    var hf_q  : logic<64>; // cycle of o_hf_req
    var off_q : WbOff    ;
    var dead_q: logic    ; // a kill removed it
    var got_q : logic    ; // its WB packet was seen
    var rgot_q: logic    ; // the reference result was seen
    var rdat_q: logic<64>;
    var rffl_q: logic<5> ;
    var rvalid: logic    ; // reference issue held

    let new_op: FpuOp     = fdiv_op(r0[2:0]);
    let fmt   : logic<2>  = src_fmt(new_op);
    let new_a : logic<64> = gen_op(fmt, r1, r2);
    let new_b : logic<64> = gen_op(fmt, r3, r4);
    let new_rm: logic<3>  = gen_rm(r0[5:3]);
    let new_fr: logic<3>  = (r0[8:6] % 3'd5) as 3;

    var dut_rdy: logic    ;
    let issue  : logic     = !busy_q && dut_rdy && cyc_q >: 64'd2;
    let op     : FpuOp     = if issue ? new_op : op_q;
    let a      : logic<64> = if issue ? new_a : a_q;
    let b      : logic<64> = if issue ? new_b : b_q;
    let rm     : logic<3>  = if issue ? new_rm : rm_q;
    let frm    : logic<3>  = if issue ? new_fr : frm_q;

    // ---- Reference: issue held until its result fires ----

    var ref_cdb: pipeline_pkg::CdbBus   ;
    var ref_ffl: logic               <5>;
    assign rvalid = issue || (busy_q && !rgot_q);
    inst u_ref: fpu_wrap (
        clk                        ,
        rst                        ,
        i_issue_valid     : rvalid ,
        i_fpu_op          : op     ,
        i_fp_rm           : rm     ,
        i_fli_idx         : 5'd0   ,
        i_frm             : frm    ,
        i_issue_rd_pdst   : 6'd0   ,
        i_issue_rob_idx   : 5'd0   ,
        i_issue_has_rd    : 1'b1   ,
        i_issue_writes_int: 1'b0   ,
        i_s1_data         : a      ,
        i_s2_data         : b      ,
        i_s3_data         : 64'd0  ,
        i_int_rs1_data    : a      ,
        i_flush           : 1'b0   ,
        o_fpu_busy        : _      ,
        o_cdb             : ref_cdb,
        o_fflags          : ref_ffl,
        o_fflags_wen      : _      ,
        o_dest_is_fp      : _      ,
    );
    let ref_fire: logic = rvalid && ref_cdb.valid;

    // ---- DUT ----

    var kill_q: Kill         ;
    var src2  : logic<64> [2];
    always_comb {
        src2[0] = a;
        src2[1] = b;
    }
    var tag: ExTag;
    always_comb {
        tag        = 0 as ExTag;
        tag.rob    = tagc_q;
        tag.has_rd = 1'b1;
    }

    var hf_req: logic   ;
    var hf_tag: ExTag   ;
    var grant : WbSlot  ;
    var wb    : WbPacket;
    var perf  : logic   ;
    inst u_dut: fu_fdiv::<CFG> (
        clk                ,
        rst                ,
        i_valid   : issue  ,
        i_op      : op     ,
        i_tag     : tag    ,
        i_src     : src2   ,
        i_rm      : rm     ,
        i_frm     : frm    ,
        i_kill    : kill_q ,
        o_ready   : dut_rdy,
        o_hf_req  : hf_req ,
        o_hf_tag  : hf_tag ,
        i_wb_grant: grant  ,
        o_wb      : wb     ,
        o_perf    : perf   ,
        o_chk              ,
    );

    let off: WbOff = (WAKE_LEAD + r5[1:0]) as WbOff;
    always_comb {
        grant.valid = hf_req;
        grant.off   = off;
    }

    // ---- Checks ----

    let is_fr   : logic     = op_q == FpuOp::FROUND_S || op_q == FpuOp::FROUNDNX_S || op_q == FpuOp::FROUND_D || op_q
        == FpuOp::FROUNDNX_D;
    let lat     : logic<64> = cyc_q - acc_q;
    var wb_dat_q: logic<64>;
    var wb_ffl_q: logic<5> ;
    let res_bad : logic     = rgot_q && got_q && !dead_q && (rdat_q != wb_dat_q || rffl_q != wb_ffl_q);

    var ops_q  : logic<32>;
    var err_q  : logic<32>;
    var kills_q: logic<32>;
    var minl_q : logic<32>;
    var abort_q: logic<32>;
    var e_op_q : logic<7> ;
    var e_a_q  : logic<64>;
    var e_b_q  : logic<64>;
    var e_rm_q : logic<6> ;
    var e_exp_q: logic<69>;
    var e_got_q: logic<69>;

    // Structural faults of the cycle: a WB packet that is not expected or
    // carries the wrong tag or the wrong timing, a hole-fill request at the
    // wrong time, o_ready high while the op is in the unit.
    var fault: logic;
    always_comb {
        fault = 1'b0;
        if wb.valid {
            if !busy_q || dead_q || got_q || wb.tag.rob != tagc_q || wb.exc != 0 || wb.br != 0 {
                fault = 1'b1;
            }
            if cyc_q != hf_q + {60'd0, off_q} || lat <: LAT_FDIV {
                fault = 1'b1;
            }
        }
        if hf_req {
            if !busy_q || dead_q || hf_tag.rob != tagc_q || (is_fr && lat != 64'd4) {
                fault = 1'b1;
            }
        }
        if busy_q && !dead_q && !got_q && cyc_q != acc_q && !wb.valid && dut_rdy {
            fault = 1'b1;
        }
    }

    always_ff {
        if_reset {
            cyc_q    = 0;
            tagc_q   = 0 as RobTag;
            prev_q   = 0 as RobTag;
            kill_q   = 0 as Kill;
            busy_q   = 1'b0;
            op_q     = FpuOp::NONE;
            a_q      = 0;
            b_q      = 0;
            rm_q     = 0;
            frm_q    = 0;
            acc_q    = 0;
            hf_q     = 0;
            off_q    = 0;
            dead_q   = 1'b0;
            got_q    = 1'b0;
            rgot_q   = 1'b0;
            rdat_q   = 0;
            rffl_q   = 0;
            wb_dat_q = 0;
            wb_ffl_q = 0;
            ops_q    = 0;
            err_q    = 0;
            kills_q  = 0;
            minl_q   = '1;
            abort_q  = 0;
            e_op_q   = 0;
            e_a_q    = 0;
            e_b_q    = 0;
            e_rm_q   = 0;
            e_exp_q  = 0;
            e_got_q  = 0;
        } else {
            cyc_q = cyc_q + 1;

            // A kill one cycle in thirty-two while an op is in the unit; a
            // partial kill keeps either the op or only its predecessor.
            kill_q       = 0 as Kill;
            kill_q.valid = r5[6:2] == 5'd0 && (busy_q || issue);
            kill_q.full  = r5[8:7] == 2'd0;
            kill_q.keep  = if r5[9] ? tag.rob : prev_q;

            if issue {
                busy_q = 1'b1;
                op_q   = new_op;
                a_q    = new_a;
                b_q    = new_b;
                rm_q   = new_rm;
                frm_q  = new_fr;
                acc_q  = cyc_q;
                dead_q = killed(kill_q, tagc_q);
                got_q  = 1'b0;
                rgot_q = 1'b0;
                if killed(kill_q, tagc_q) {
                    kills_q = kills_q + 1;
                }
            }
            if ref_fire && (issue || !rgot_q) {
                rgot_q = 1'b1;
                rdat_q = ref_cdb.data;
                rffl_q = ref_ffl;
            }
            if hf_req {
                hf_q  = cyc_q;
                off_q = off;
            }
            if wb.valid {
                got_q    = 1'b1;
                wb_dat_q = wb.data;
                wb_ffl_q = wb.fflags;
                if lat[31:0] <: minl_q {
                    minl_q = lat[31:0];
                }
            } else if busy_q && !got_q && !dead_q && killed(kill_q, tagc_q) {
                dead_q  = 1'b1;
                kills_q = kills_q + 1;
            }
            if perf {
                abort_q = abort_q + 1;
            }

            if fault {
                err_q = err_q + 1;
            }
            // Retire the op once both results are in (or the kill removed it
            // and the reference is done).
            if busy_q && rgot_q && (got_q || dead_q) && !issue {
                if res_bad {
                    if err_q == 0 {
                        e_op_q  = op_q;
                        e_a_q   = a_q;
                        e_b_q   = b_q;
                        e_rm_q  = {rm_q, frm_q};
                        e_exp_q = {rffl_q, rdat_q};
                        e_got_q = {wb_ffl_q, wb_dat_q};
                    }
                    err_q = err_q + 1;
                }
                if !dead_q {
                    ops_q = ops_q + 1;
                }
                busy_q = 1'b0;
                prev_q = tagc_q;
                tagc_q = next_tag(tagc_q);
            }
        }
    }

    assign o_ops     = ops_q;
    assign o_err     = err_q;
    assign o_kills   = kills_q;
    assign o_min_lat = minl_q;
    assign o_aborts  = abort_q;
    assign o_e_op    = e_op_q;
    assign o_e_a     = e_a_q;
    assign o_e_b     = e_b_q;
    assign o_e_rm    = e_rm_q;
    assign o_e_exp   = e_exp_q;
    assign o_e_got   = e_got_q;
}

#[test(test_fp_fu)]
module test_fp_fu {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var p2_cmp  : logic<32>;
    var p2_err  : logic<32>;
    var p2_known: logic<32>;
    var p2_kills: logic<32>;
    var p2_op   : logic<7> ;
    var p2_a    : logic<64>;
    var p2_b    : logic<64>;
    var p2_c    : logic<64>;
    var p2_rm   : logic<6> ;
    var p2_exp  : logic<69>;
    var p2_got  : logic<69>;
    inst p2: fp_pipe_harness::<cfg_w2> (
        clk              ,
        rst              ,
        o_cmp  : p2_cmp  ,
        o_err  : p2_err  ,
        o_known: p2_known,
        o_kills: p2_kills,
        o_e_op : p2_op   ,
        o_e_a  : p2_a    ,
        o_e_b  : p2_b    ,
        o_e_c  : p2_c    ,
        o_e_rm : p2_rm   ,
        o_e_exp: p2_exp  ,
        o_e_got: p2_got  ,
    );

    var p4_cmp  : logic<32>;
    var p4_err  : logic<32>;
    var p4_known: logic<32>;
    var p4_kills: logic<32>;
    inst p4: fp_pipe_harness::<cfg_w4> #(
        SEED: 64'h5eed_0004,
    ) (
        clk              ,
        rst              ,
        o_cmp  : p4_cmp  ,
        o_err  : p4_err  ,
        o_known: p4_known,
        o_kills: p4_kills,
        o_e_op : _       ,
        o_e_a  : _       ,
        o_e_b  : _       ,
        o_e_c  : _       ,
        o_e_rm : _       ,
        o_e_exp: _       ,
        o_e_got: _       ,
    );

    var d2_ops  : logic<32>;
    var d2_err  : logic<32>;
    var d2_kills: logic<32>;
    var d2_minl : logic<32>;
    var d2_chk  : logic<2> ;
    var d2_abort: logic<32>;
    var d2_op   : logic<7> ;
    var d2_a    : logic<64>;
    var d2_b    : logic<64>;
    var d2_rm   : logic<6> ;
    var d2_exp  : logic<69>;
    var d2_got  : logic<69>;
    inst d2: fp_fdiv_harness::<cfg_w2> (
        clk                ,
        rst                ,
        o_ops    : d2_ops  ,
        o_err    : d2_err  ,
        o_kills  : d2_kills,
        o_min_lat: d2_minl ,
        o_chk    : d2_chk  ,
        o_aborts : d2_abort,
        o_e_op   : d2_op   ,
        o_e_a    : d2_a    ,
        o_e_b    : d2_b    ,
        o_e_rm   : d2_rm   ,
        o_e_exp  : d2_exp  ,
        o_e_got  : d2_got  ,
    );

    var d4_ops  : logic<32>;
    var d4_err  : logic<32>;
    var d4_kills: logic<32>;
    var d4_minl : logic<32>;
    var d4_chk  : logic<2> ;
    inst d4: fp_fdiv_harness::<cfg_w4> #(
        SEED: 64'h5eed_0044,
    ) (
        clk                ,
        rst                ,
        o_ops    : d4_ops  ,
        o_err    : d4_err  ,
        o_kills  : d4_kills,
        o_min_lat: d4_minl ,
        o_chk    : d4_chk  ,
        o_aborts : _       ,
        o_e_op   : _       ,
        o_e_a    : _       ,
        o_e_b    : _       ,
        o_e_rm   : _       ,
        o_e_exp  : _       ,
        o_e_got  : _       ,
    );

    initial {
        rst.assert(clk);
        clk.next(40000);
        $display(
            "fp pipe w2: cmp=%d err=%d known=%d kills=%d  w4: cmp=%d err=%d known=%d kills=%d",
            p2_cmp,
            p2_err,
            p2_known,
            p2_kills,
            p4_cmp,
            p4_err,
            p4_known,
            p4_kills,
        );
        $display(
            "fp pipe w2 first error: op=%d a=%h b=%h c=%h rm/frm=%b exp=%h got=%h",
            p2_op,
            p2_a,
            p2_b,
            p2_c,
            p2_rm,
            p2_exp,
            p2_got,
        );
        $display(
            "fp fdiv w2: ops=%d err=%d kills=%d min_lat=%d chk=%b aborts=%d  w4: ops=%d err=%d kills=%d min_lat=%d chk=%b",
            d2_ops,
            d2_err,
            d2_kills,
            d2_minl,
            d2_chk,
            d2_abort,
            d4_ops,
            d4_err,
            d4_kills,
            d4_minl,
            d4_chk,
        );
        $display(
            "fp fdiv w2 first error: op=%d a=%h b=%h rm/frm=%b exp=%h got=%h",
            d2_op,
            d2_a,
            d2_b,
            d2_rm,
            d2_exp,
            d2_got,
        );
        $assert(p2_err == 0 && p4_err == 0, "fu_fma/fu_fmisc mismatch against fpu_wrap");
        $assert(d2_err == 0 && d4_err == 0, "fu_fdiv mismatch against fpu_wrap");
        $assert(p2_kills != 0 && d2_kills != 0 && d2_abort != 0, "kills not exercised");
        $assert(d2_minl == fu_pkg::LAT_FDIV && d4_minl == fu_pkg::LAT_FDIV, "fu_fdiv minimum latency is not LAT_FDIV");
        $assert(d2_chk == 0 && d4_chk == 0, "fu_fdiv checker fired");
        $assert(p2_cmp >: 32'd10000 && d2_ops >: 32'd100, "too few ops compared");
        $finish();
    }
}
