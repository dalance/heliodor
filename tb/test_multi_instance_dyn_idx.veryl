// Reproducer for dynamic-array-index issues in analyze_dependency
// (project_sim_dynamic_index_loop.md, task #222).
//
// Pattern: an `var arr: logic [N]` written by always_ff, read in
// always_comb via `arr[runtime_idx]`. The simulator should recognize
// per-element dependencies but the current analyzer treats the array
// as a single node, which can either:
//   - false-positive comb loop detection
//   - panic at calc_index.unwrap when the comb-context picks a const
//     index >= N for a dynamic-width index
//
// We exercise both heliodor patterns: parameterized N, dynamic index
// of any width, both write and read paths.

module dyn_arr_unit #(
    param N: u32 = 2,
) (
    clk    : input  clock         ,
    rst    : input  reset         ,
    i_widx : input  logic<3>      , // 3-bit can be 0..7 even when N=2
    i_wdata: input  logic<8>      ,
    i_wen  : input  logic         ,
    i_ridx : input  logic<3>      , // 3-bit dyn idx
    o_rval : output logic<8>      ,
) {
    var arr: logic<8> [N];
    always_ff (clk, rst) {
        if_reset {
            for i in 0..N {
                arr[i] = 8'd0;
            }
        } else if i_wen {
            for h in 0..N {
                if i_widx == (h as 3) {
                    arr[h] = i_wdata;
                }
            }
        }
    }

    // Dynamic index read in always_comb (the buggy CLINT pattern: idx wider than N)
    assign o_rval = arr[i_ridx];
}

module test_dyn_idx_harness (
    clk    : input  clock         ,
    rst    : input  reset         ,
    o_pass : output logic         ,
    o_v0   : output logic<8>      ,
    o_v1   : output logic<8>      ,
) {
    var widx : logic<3>;
    var wdata: logic<8>;
    var wen  : logic;
    var ridx : logic<3>;
    var rval : logic<8>;
    var cycle: logic<32>;

    inst u: dyn_arr_unit #(N: 2) (
        clk    : clk  ,
        rst    : rst  ,
        i_widx : widx ,
        i_wdata: wdata,
        i_wen  : wen  ,
        i_ridx : ridx ,
        o_rval : rval ,
    );

    always_ff (clk, rst) {
        if_reset {
            cycle = 32'd0;
        } else {
            cycle = cycle + 32'd1;
        }
    }

    // Cycle 0: write arr[0] = 0xAA
    // Cycle 1: write arr[1] = 0xBB; read arr[0] (should be 0xAA)
    // Cycle 2: read arr[1] (should be 0xBB)
    assign widx  = if cycle == 32'd0 ? 3'd0 : 3'd1;
    assign wdata = if cycle == 32'd0 ? 8'hAA : 8'hBB;
    assign wen   = (cycle <: 32'd2);
    assign ridx  = if cycle == 32'd1 ? 3'd0 : 3'd1;

    var v0: logic<8>;
    var v1: logic<8>;
    var ok: logic;
    always_ff (clk, rst) {
        if_reset {
            v0 = 8'd0;
            v1 = 8'd0;
            ok = 1'b1;
        } else if cycle == 32'd1 {
            // After cycle 0 write of arr[0]=0xAA, on cycle 1 read should be 0xAA
            v0 = rval;
            if rval != 8'hAA {
                ok = 1'b0;
            }
        } else if cycle == 32'd2 {
            // After cycle 1 write of arr[1]=0xBB, on cycle 2 read should be 0xBB
            v1 = rval;
            if rval != 8'hBB {
                ok = 1'b0;
            }
        }
    }

    assign o_pass = ok;
    assign o_v0   = v0;
    assign o_v1   = v1;
}

#[test(test_multi_instance_dyn_idx)]
module test_multi_instance_dyn_idx {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen(clk);

    var pass: logic;
    var v0: logic<8>;
    var v1: logic<8>;

    inst h: test_dyn_idx_harness (
        clk    : clk ,
        rst    : rst ,
        o_pass : pass,
        o_v0   : v0  ,
        o_v1   : v1  ,
    );

    initial {
        rst.assert(clk);
        for _i in 0..6 {
            clk.next(10);
        }
        $display("test_multi_instance_dyn_idx: v0=%h v1=%h pass=%b", v0, v1, pass);
        $assert(pass, "dynamic index read returned wrong value");
        $display("test_multi_instance_dyn_idx: passed");
        $finish();
    }
}
