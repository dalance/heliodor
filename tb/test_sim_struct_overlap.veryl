// Minimal repro for the v4 ALU instr.bit[22] corruption bug.
//
// Pattern: a struct with two fields (a: logic<32>, b: logic<64>) is
// latched in a register, then read across a module boundary. Verify
// that reading a.bit[N] returns the assigned value, independent of
// b's bits.
//
// In v4 the equivalent struct (DecodedOp with instr + imm fields) shows
// instr.bit[22] read returning a value influenced by other fields when
// the full struct passes through producer→register→consumer modules.

package test_sim_overlap_pkg {
    struct Bundle {
        a: logic<32>,
        b: logic<64>,
        c: logic<32>,
    }
}

module test_sim_overlap_producer (
    clk: input  clock                       ,
    rst: input  reset                       ,
    o  : output test_sim_overlap_pkg::Bundle,
) {
    var q: test_sim_overlap_pkg::Bundle;
    always_ff (clk, rst) {
        if_reset {
            q.a = 32'd0;
            q.b = 64'd0;
            q.c = 32'd0;
        } else {
            // The exact ADDI t0, t0, 168 bit pattern from firmware
            q.a = 32'h0a828293;
            // The I-type imm value (0xa8 = 168). Bit 7 of this is 1.
            q.b = 64'h00000000000000a8;
            q.c = 32'hdeadbeef;
        }
    }
    assign o = q;
}

module test_sim_overlap_consumer (
    clk      : input  clock                           ,
    rst      : input  reset                           ,
    i        : input  test_sim_overlap_pkg::Bundle    ,
    o_a_read : output logic                       <32>,
    o_b_read : output logic                       <64>,
    o_a_bit22: output logic                           ,
) {
    assign o_a_read  = i.a;
    assign o_b_read  = i.b;
    assign o_a_bit22 = i.a[22];
}

module test_sim_struct_overlap_harness (
    clk        : input  clock    ,
    rst        : input  reset    ,
    o_a_read   : output logic<32>,
    o_b_read   : output logic<64>,
    o_a_bit22  : output logic    ,
    o_a_correct: output logic    ,
) {
    var bun  : test_sim_overlap_pkg::Bundle    ;
    var a    : logic                       <32>;
    var b    : logic                       <64>;
    var bit22: logic                           ;

    inst p: test_sim_overlap_producer ( clk, rst, o: bun );
    inst c: test_sim_overlap_consumer ( clk, rst, i: bun, o_a_read: a, o_b_read: b, o_a_bit22: bit22 );

    assign o_a_read    = a;
    assign o_b_read    = b;
    assign o_a_bit22   = bit22;
    assign o_a_correct = a == 32'h0a828293;
}

#[test(test_sim_struct_overlap)]
#[ignore]
module test_sim_struct_overlap {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var a    : logic<32>;
    var b    : logic<64>;
    var bit22: logic    ;
    var ok   : logic    ;
    inst h: test_sim_struct_overlap_harness ( clk, rst, o_a_read: a, o_b_read: b, o_a_bit22: bit22, o_a_correct: ok );
    initial {
        rst.assert(clk);
        clk.next  (5);
        $display  (
            "[test_sim_struct_overlap] a=%h b=%h a_bit22=%b ok=%b (expected: a=0x0a828293 b=0x00000000000000a8 bit22=0 ok=1)",
            a,
            b,
            bit22,
            ok,
        );
        $assert   (ok, "struct field corruption: a != 0x0a828293");
        $finish   ();
    }
}
