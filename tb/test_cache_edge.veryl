// Cache edge case unit test for dcache.
// Focuses on conflict miss + write-through eviction recovery.
//
// The dcache is direct-mapped: addr[9:6] = index. Two addresses with
// the same index but different tags map to the same set; the second
// access evicts the first. Because the cache is write-through, the
// evicted line's data is still in main memory and a subsequent read
// must refill correctly.
module test_cache_edge_harness (
    clk   : input  clock    ,
    rst   : input  reset    ,
    o_pass: output logic    ,
    o_r1  : output logic<64>,
    o_r2  : output logic<64>,
    o_r3  : output logic<64>,
) {
    var addr     : logic<64>;
    var wdata    : logic<64>;
    var wen      : logic    ;
    var ren      : logic    ;
    var wstrb    : logic<8> ;
    var rdata    : logic<64>;
    var stall    : logic    ;
    var mem_addr : logic<64>;
    var memw_addr: logic<64>; // S23: write channel
    var mem_wdata: logic<64>;
    var mem_rdata: logic<64>;
    var mem_wen  : logic    ;
    var mem_ren  : logic    ;
    var mem_wstrb: logic<8> ;

    inst dut: dcache #( INDEX_W: 4 ) (
        clk                   ,
        rst                   ,
        i_addr     : addr     ,
        i_wdata    : wdata    ,
        i_wen      : wen      ,
        i_ren      : ren      ,
        i_uncached : 1'b0     ,
        i_wstrb    : wstrb    ,
        i_wstrb_hi : 8'd0     ,
        i_load_next: 1'b0     ,
        i_amo_read : 1'b0     ,
        o_rdata    : rdata    ,
        o_stall    : stall    ,
        o_memr_addr : mem_addr ,
        o_memr_ren  : mem_ren  ,
        i_mem_rdata : mem_rdata,
        o_memw_addr : memw_addr,
        o_memw_wdata: mem_wdata,
        o_memw_wstrb: mem_wstrb,
        o_memw_wen  : mem_wen  ,
        i_inv_valid: 1'b0     ,
        i_inv_addr : 64'd0    ,
        i_inv2_valid : 1'b0 ,
        i_inv2_addr : 64'd0,
        o_memr_rfo : _,
        i_fill_excl : 1'b1,
        o_memw_wb : _,
        i_probe_v : 1'b0,
        i_probe_self : 1'b0,
        i_probe_addr : 64'd0,
        o_probe_ack : _,
        i_flush_req : 1'b0,
        o_flush_done : _,
        i_chk_addr : 64'd0,
        o_chk_present : _,
        i_chk2_addr : 64'd0,
        o_chk2_present : _,
        o_evict1_v : _,
        o_evict1_addr : _,
        o_evict2_v : _,
        o_evict2_addr : _,
        i_memr_grant: 1'b1    ,
        i_memw_grant: 1'b1    ,
    );

    // Backing memory (256 doublewords). Pre-init two different lines:
    // addr 0x040 (mem[8])  = 0xAAAA
    // addr 0x440 (mem[136]) = 0xBBBB  (same dcache index 1, different tag)
    var mem: logic<64> [256];
    assign mem_rdata = mem[mem_addr[10:3]];

    var rstep  : logic<2> ; // which of the 3 reads (0..2), 3 = done
    var busy  : logic    ; // a read is in flight (i_ren held until !stall)
    var r1_val: logic<64>;
    var r2_val: logic<64>;
    var r3_val: logic<64>;

    always_ff (clk, rst) {
        if_reset {
            rstep   = 2'd0;
            busy   = 1'b0;
            addr   = '0;
            wdata  = '0;
            wen    = 1'b0;
            ren    = 1'b0;
            wstrb  = '0;
            r1_val = '0;
            r2_val = '0;
            r3_val = '0;

            for i in 0..256 {
                mem[i] = 64'd0;
            }
            mem[8]   = 64'h0000_0000_0000_AAAA; // addr 0x040 (index 1, tag A)
            mem[136] = 64'h0000_0000_0000_BBBB; // addr 0x440 (index 1, tag B)
        } else {
            wen = 1'b0;

            if mem_wen {
                mem[memw_addr[10:3]] = mem_wdata;
            }

            // Realistic-SRAM read model (§14.9): the dcache no longer serves a
            // combinational held-address read at i_ren=0 (that fake-flop is what the
            // 1R1W SRAM removes). A non-folded read drives i_ren=1 and completes when
            // o_stall drops — the demand fills, then the +1 nf registered-read handshake
            // delivers o_rdata. So sample o_rdata WHILE the read is driven (i_ren=1) on
            // the completion cycle. Each rstep issues one read, holds i_ren until !stall,
            // samples, then advances. This exercises the same conflict-miss + eviction +
            // refill sequence as the old tc-timed version.
            if !busy {
                ren = 1'b1;
                case rstep {
                    2'd0: { addr = 64'h040; } // read 0x040 (miss → fill AAAA)
                    2'd1: { addr = 64'h440; } // read 0x440 (same index → evict 0x040, fill BBBB)
                    2'd2: { addr = 64'h040; } // read 0x040 again (evicted → refill AAAA from mem)
                    default: { ren = 1'b0; }  // rstep 3: done
                }
                if rstep != 2'd3 {
                    busy = 1'b1;
                }
            } else {
                ren = 1'b1; // hold the driven read across the fill + nf handshake
                if !stall {
                    case rstep {
                        2'd0: { r1_val = rdata; } // expect 0xAAAA
                        2'd1: { r2_val = rdata; } // expect 0xBBBB
                        2'd2: { r3_val = rdata; } // expect 0xAAAA
                        default: {}
                    }
                    busy = 1'b0;
                    rstep = rstep + 2'd1;
                    ren  = 1'b0;
                }
            }
        }
    }

    assign o_r1   = r1_val;
    assign o_r2   = r2_val;
    assign o_r3   = r3_val;
    assign o_pass = r1_val == 64'h0000_0000_0000_AAAA && r2_val == 64'h0000_0000_0000_BBBB && r3_val
        == 64'h0000_0000_0000_AAAA;
}

#[test(test_cache_edge)]
module test_cache_edge {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass: logic    ;
    var r1  : logic<64>;
    var r2  : logic<64>;
    var r3  : logic<64>;

    inst harness: test_cache_edge_harness ( clk: clk, rst: rst, o_pass: pass, o_r1: r1, o_r2: r2, o_r3: r3 );

    initial {
        rst.assert(clk);
        clk.next  (200);
        $display  ("r1=%h r2=%h r3=%h pass=%b", r1, r2, r3, pass);
        $assert   (pass, "cache_edge: conflict miss + write-through eviction failed");
        $display  ("cache_edge test passed");
        $finish   ();
    }
}
