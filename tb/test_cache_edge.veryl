// Cache edge case unit test for dcache.
// Focuses on conflict miss + write-through eviction recovery.
//
// The dcache is direct-mapped: addr[9:6] = index. Two addresses with
// the same index but different tags map to the same set; the second
// access evicts the first. Because the cache is write-through, the
// evicted line's data is still in main memory and a subsequent read
// must refill correctly.
module test_cache_edge_harness (
    clk   : input  clock    ,
    rst   : input  reset    ,
    o_pass: output logic    ,
    o_r1  : output logic<64>,
    o_r2  : output logic<64>,
    o_r3  : output logic<64>,
) {
    var addr     : logic<64>;
    var wdata    : logic<64>;
    var wen      : logic    ;
    var ren      : logic    ;
    var wstrb    : logic<8> ;
    var rdata    : logic<64>;
    var stall    : logic    ;
    var mem_addr : logic<64>;
    var mem_wdata: logic<64>;
    var mem_rdata: logic<64>;
    var mem_wen  : logic    ;
    var mem_ren  : logic    ;
    var mem_wstrb: logic<8> ;

    inst dut: dcache (
        clk                   ,
        rst                   ,
        i_addr     : addr     ,
        i_wdata    : wdata    ,
        i_wen      : wen      ,
        i_ren      : ren      ,
        i_wstrb    : wstrb    ,
        o_rdata    : rdata    ,
        o_stall    : stall    ,
        o_mem_addr : mem_addr ,
        o_mem_wdata: mem_wdata,
        i_mem_rdata: mem_rdata,
        o_mem_wen  : mem_wen  ,
        o_mem_ren  : mem_ren  ,
        o_mem_wstrb: mem_wstrb,
    );

    // Backing memory (256 doublewords). Pre-init two different lines:
    // addr 0x040 (mem[8])  = 0xAAAA
    // addr 0x440 (mem[136]) = 0xBBBB  (same dcache index 1, different tag)
    var mem      : logic<64> [256];
    assign mem_rdata = mem[mem_addr[10:3]];

    var tc    : logic<8> ;
    var r1_val: logic<64>;
    var r2_val: logic<64>;
    var r3_val: logic<64>;

    always_ff (clk, rst) {
        if_reset {
            tc     = 8'd0;
            addr   = '0;
            wdata  = '0;
            wen    = 1'b0;
            ren    = 1'b0;
            wstrb  = '0;
            r1_val = '0;
            r2_val = '0;
            r3_val = '0;

            for i in 0..256 {
                mem[i] = 64'd0;
            }
            mem[8]   = 64'h0000_0000_0000_AAAA; // addr 0x040 (index 1, tag A)
            mem[136] = 64'h0000_0000_0000_BBBB; // addr 0x440 (index 1, tag B)
        } else {
            wen = 1'b0;
            ren = 1'b0;

            if mem_wen {
                mem[mem_addr[10:3]] = mem_wdata;
            }

            // Hold the request during a fill stall
            if stall {
                if addr == 64'h040 || addr == 64'h440 {
                    ren = 1'b1;
                }
            }

            if !stall {
                tc = tc + 8'd1;
            }

            case tc {
                // Phase 1: read addr 0x040 (miss → fill from mem[8] = AAAA)
                8'd1: {
                    addr = 64'h040;
                    ren  = 1'b1;
                }
                // tc=2 DONE→IDLE transition; tc=3 sample
                8'd3: {
                    r1_val = rdata; // expect 0xAAAA
                }
                // Phase 2: read addr 0x440 (same index, different tag → evict)
                8'd4: {
                    addr = 64'h440;
                    ren  = 1'b1;
                }
                8'd6: {
                    r2_val = rdata; // expect 0xBBBB
                }
                // Phase 3: read addr 0x040 again. The original line was
                // evicted; with write-through, the backing memory still
                // has 0xAAAA, so the refill must produce that value.
                8'd7: {
                    addr = 64'h040;
                    ren  = 1'b1;
                }
                8'd9: {
                    r3_val = rdata; // expect 0xAAAA again
                }
                default: {}
            }
        }
    }

    assign o_r1   = r1_val;
    assign o_r2   = r2_val;
    assign o_r3   = r3_val;
    assign o_pass = r1_val == 64'h0000_0000_0000_AAAA && r2_val == 64'h0000_0000_0000_BBBB && r3_val == 64'h0000_0000_0000_AAAA;
}

#[test(test_cache_edge)]
module test_cache_edge {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen(clk);

    var pass: logic    ;
    var r1  : logic<64>;
    var r2  : logic<64>;
    var r3  : logic<64>;

    inst harness: test_cache_edge_harness (
        clk   : clk ,
        rst   : rst ,
        o_pass: pass,
        o_r1  : r1  ,
        o_r2  : r2  ,
        o_r3  : r3  ,
    );

    initial {
        rst.assert(clk);
        clk.next  (200);
        $display  ("r1=%h r2=%h r3=%h pass=%b", r1, r2, r3, pass);
        $assert   (pass, "cache_edge: conflict miss + write-through eviction failed");
        $display  ("cache_edge test passed");
        $finish   ();
    }
}
