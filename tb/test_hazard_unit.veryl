// Hazard detection unit test.
// Pure combinational module — drive input vectors and check outputs.
module test_hazard_unit_harness (
    clk   : input  clock   ,
    rst   : input  reset   ,
    o_pass: output logic   ,
    o_done: output logic   ,
    o_tc  : output logic<8>,
) {
    var tc: logic<8>;

    always_ff {
        if_reset {
            tc = 8'd0;
        } else {
            tc = tc + 8'd1;
        }
    }

    // DUT inputs
    var idex_mem_ren    : logic   ;
    var idex_rd         : logic<5>;
    var idex_fp_reg_wen : logic   ;
    var id_fp_reg_wen   : logic   ;
    var id_rd           : logic<5>;
    var exmem_mem_ren   : logic   ;
    var exmem_rd        : logic<5>;
    var exmem_fp_reg_wen: logic   ;
    var ifid_rs1        : logic<5>;
    var ifid_rs2        : logic<5>;
    var ifid_fp_read    : logic   ;
    var branch_taken    : logic   ;
    var is_jal          : logic   ;
    var is_jalr         : logic   ;
    var trap_taken      : logic   ;
    var mret_taken      : logic   ;
    var mmu_stall       : logic   ;
    var icache_stall    : logic   ;
    var dcache_stall    : logic   ;

    // DUT outputs
    var stall_if : logic;
    var stall_id : logic;
    var stall_ex : logic;
    var stall_mem: logic;
    var flush_id : logic;
    var flush_ex : logic;

    var sb_stall: logic;

    inst dut: hazard_unit (
        i_idex_mem_ren    : idex_mem_ren    ,
        i_idex_rd         : idex_rd         ,
        i_idex_fp_reg_wen : idex_fp_reg_wen ,
        i_id_fp_reg_wen   : id_fp_reg_wen   ,
        i_id_rd           : id_rd           ,
        i_exmem_mem_ren   : exmem_mem_ren   ,
        i_exmem_rd        : exmem_rd        ,
        i_exmem_fp_reg_wen: exmem_fp_reg_wen,
        i_mem_fp_reg_wen  : 1'b0            ,
        i_mem_fp_rd       : 5'd0            ,
        i_ifid_rs1        : ifid_rs1        ,
        i_ifid_rs2        : ifid_rs2        ,
        i_ifid_fp_read    : ifid_fp_read    ,
        i_s1_ifid_rs1     : 5'd0            ,
        i_s1_ifid_rs2     : 5'd0            ,
        i_s1_ifid_valid   : 1'b0            ,
        i_sb_stall        : sb_stall        ,
        i_branch_taken    : branch_taken    ,
        i_misprediction   : branch_taken    , // unit test: misprediction == branch_taken (no predictor)
        i_is_jal          : is_jal          ,
        i_is_jalr         : is_jalr         ,
        i_trap_taken      : trap_taken      ,
        i_mret_taken      : mret_taken      ,
        i_mmu_stall       : mmu_stall       ,
        i_icache_stall    : icache_stall    ,
        i_dcache_stall    : dcache_stall    ,
        i_mshr_wb_stall   : 1'b0            ,
        i_div_busy        : 1'b0            ,
        i_rob_full        : 1'b0            ,
        i_rs_stall        : 1'b0            ,
        o_stall_if        : stall_if        ,
        o_stall_id        : stall_id        ,
        o_stall_ex        : stall_ex        ,
        o_stall_mem       : stall_mem       ,
        o_flush_id        : flush_id        ,
        o_flush_ex        : flush_ex        ,
        o_load_use        : _               ,
    );

    // Expected outputs
    var exp_stall_if : logic;
    var exp_stall_id : logic;
    var exp_stall_ex : logic;
    var exp_stall_mem: logic;
    var exp_flush_id : logic;
    var exp_flush_ex : logic;

    var valid: logic;

    // Test vectors. Each tc sets all inputs and the expected outputs.
    always_comb {
        idex_mem_ren     = 1'b0;
        idex_rd          = 5'd0;
        idex_fp_reg_wen  = 1'b0;
        id_fp_reg_wen    = 1'b0;
        id_rd            = 5'd0;
        exmem_mem_ren    = 1'b0;
        exmem_rd         = 5'd0;
        exmem_fp_reg_wen = 1'b0;
        ifid_rs1         = 5'd0;
        ifid_rs2         = 5'd0;
        ifid_fp_read     = 1'b0;
        branch_taken     = 1'b0;
        is_jal           = 1'b0;
        is_jalr          = 1'b0;
        trap_taken       = 1'b0;
        mret_taken       = 1'b0;
        mmu_stall        = 1'b0;
        icache_stall     = 1'b0;
        dcache_stall     = 1'b0;
        sb_stall         = 1'b0;

        exp_stall_if  = 1'b0;
        exp_stall_id  = 1'b0;
        exp_stall_ex  = 1'b0;
        exp_stall_mem = 1'b0;
        exp_flush_id  = 1'b0;
        exp_flush_ex  = 1'b0;
        valid         = 1'b1;

        case tc {
            // tc=1: all inputs zero → all outputs zero
            8'd1: {}
            // tc=2: scoreboard stall (sb_stall=1, simulates load-use)
            8'd2: {
                sb_stall     = 1'b1;
                exp_stall_if = 1'b1;
                exp_stall_id = 1'b1;
                exp_flush_id = 1'b1;
            }
            // tc=3: scoreboard stall (same, different test vector)
            8'd3: {
                sb_stall     = 1'b1;
                exp_stall_if = 1'b1;
                exp_stall_id = 1'b1;
                exp_flush_id = 1'b1;
            }
            // tc=4: no scoreboard stall → no stall
            8'd4: {
                sb_stall = 1'b0;
            }
            // tc=5: no scoreboard stall → no stall
            8'd5: {
                sb_stall = 1'b0;
            }
            // tc=6: scoreboard stall (simulates MEM-stage load-use)
            8'd6: {
                sb_stall      = 1'b1;
                exp_stall_if  = 1'b1;
                exp_stall_id  = 1'b1;
                exp_flush_id  = 1'b1;
            }
            // tc=7: branch_taken → redirect, all stalls cleared, flush_id=1
            8'd7: {
                branch_taken = 1'b1;
                exp_flush_id = 1'b1;
            }
            // tc=8: trap_taken → flush_id, flush_ex
            8'd8: {
                trap_taken   = 1'b1;
                exp_flush_id = 1'b1;
                exp_flush_ex = 1'b1;
            }
            // tc=9: mret_taken → flush_id, flush_ex
            8'd9: {
                mret_taken   = 1'b1;
                exp_flush_id = 1'b1;
                exp_flush_ex = 1'b1;
            }
            // tc=10: icache_stall → stall everything (cache_stall holds EX/MEM too)
            8'd10: {
                icache_stall  = 1'b1;
                exp_stall_if  = 1'b1;
                exp_stall_id  = 1'b1;
                exp_stall_ex  = 1'b1;
                exp_stall_mem = 1'b1;
            }
            // tc=11: dcache_stall → stall everything, no flush
            8'd11: {
                dcache_stall  = 1'b1;
                exp_stall_if  = 1'b1;
                exp_stall_id  = 1'b1;
                exp_stall_ex  = 1'b1;
                exp_stall_mem = 1'b1;
            }
            // tc=12: mmu_stall → stall everything
            8'd12: {
                mmu_stall     = 1'b1;
                exp_stall_if  = 1'b1;
                exp_stall_id  = 1'b1;
                exp_stall_ex  = 1'b1;
                exp_stall_mem = 1'b1;
            }
            // tc=13: trap_taken during dmmu stall — trap clears IF/ID stall,
            // EX/MEM stay stalled. flush_ex still asserted by trap.
            8'd13: {
                trap_taken    = 1'b1;
                mmu_stall     = 1'b1;
                exp_stall_ex  = 1'b1;
                exp_stall_mem = 1'b1;
                exp_flush_id  = 1'b1;
                exp_flush_ex  = 1'b1;
            }
            // tc=14: branch_taken during dcache stall — redirect blocked,
            // pipeline stays stalled, no flush yet.
            8'd14: {
                branch_taken  = 1'b1;
                dcache_stall  = 1'b1;
                exp_stall_if  = 1'b1;
                exp_stall_id  = 1'b1;
                exp_stall_ex  = 1'b1;
                exp_stall_mem = 1'b1;
            }
            // tc=15: FP RAW (ID stage writes fa1, IF/ID reads fa1 as rs1).
            // Producer is in ID, consumer is in IFID. Producer must advance to EX
            // so IFID can use EX_MEM forwarding next cycle. Only IFID stalls.
            // stall_id=0 and flush_id=0 so producer is not held/destroyed.
            8'd15: {
                id_fp_reg_wen = 1'b1;
                id_rd         = 5'd11; // fa1
                ifid_fp_read  = 1'b1;
                ifid_rs1      = 5'd11;
                exp_stall_if  = 1'b1;
            }
            // tc=16: FP RAW (EX stage writes fa2) — forwarded, no stall
            8'd16: {
                idex_fp_reg_wen = 1'b1;
                idex_rd         = 5'd12;
                ifid_fp_read    = 1'b1;
                ifid_rs2        = 5'd12;
                // No stall: EX/MEM forwarding handles this
            }
            // tc=17: FP RAW (MEM stage) — forwarded, no stall
            8'd17: {
                exmem_fp_reg_wen = 1'b1;
                exmem_rd         = 5'd13;
                ifid_fp_read     = 1'b1;
                ifid_rs1         = 5'd13;
                // No stall: MEM/WB forwarding handles this
            }
            // tc=18: FP write but consumer doesn't read FP → no hazard
            8'd18: {
                idex_fp_reg_wen = 1'b1;
                idex_rd         = 5'd5;
                ifid_fp_read    = 1'b0;
                ifid_rs1        = 5'd5;
            }
            default: {
                valid = 1'b0;
            }
        }
    }

    var failed: logic;
    always_ff {
        if_reset {
            failed = 1'b0;
        } else if valid && (stall_if != exp_stall_if || stall_id != exp_stall_id || stall_ex != exp_stall_ex || stall_mem != exp_stall_mem || flush_id != exp_flush_id || flush_ex != exp_flush_ex) {
            failed = 1'b1;
        }
    }

    assign o_tc   = tc;
    assign o_pass = !failed;
    assign o_done = tc >: 8'd20;
}

#[test(test_hazard_unit)]
module test_hazard_unit {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen;

    var pass: logic   ;
    var done: logic   ;
    var tc  : logic<8>;

    inst harness: test_hazard_unit_harness (
        clk   : clk ,
        rst   : rst ,
        o_pass: pass,
        o_done: done,
        o_tc  : tc  ,
    );

    initial {
        rst.assert(clk);
        for _i: i32 in 0..22 {
            clk.next(1);
        }
        $assert (pass, "hazard_unit test failed");
        $display("hazard_unit test passed");
        $finish ();
    }
}
