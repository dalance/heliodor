// Self-test of the retire observation tb: rvfi_tracer and retire_mon fed with
// a synthetic record stream.
//
// rvfi_selftest_drv emits records 0..N_REC-1 from a fixed table, LANES at a
// time with a per-cycle group size, cutting groups before a trap or an
// interrupt point so traps stay on lane 0 and IrqEvents get cycles of their
// own. VARIANT=1 changes only fields that the tracer masks or normalizes
// away; GLITCH=1 breaks the retire contract (an order gap and traps on any
// lane) to exercise chk_retire.
module rvfi_selftest_drv #(
    param LANES     : u32       = 2    ,
    param VARIANT   : bit       = 0    ,
    param GLITCH    : bit       = 0    ,
    param TOHOST_VAL: logic<32> = 32'd1,
) (
    clk      : input  clock                        ,
    rst      : input  reset                        ,
    o_retire : output retire_pkg::RetireRec [LANES],
    o_irq_evt: output retire_pkg::IrqEvent         ,
) {
    import retire_pkg::*;

    const N_REC: u32       = 44;
    const IRQ_A: logic<64> = 64'd17;
    const IRQ_B: logic<64> = 64'd30;

    function rec_pc (
        i: input logic<64>,
    ) -> logic<64> {
        return 64'h8000_0000 + (i << 2);
    }

    function mk_rec (
        i: input logic<64>,
    ) -> RetireRec {
        var r         : RetireRec;
        r          = 0 as RetireRec;
        r.valid    = 1'b1;
        r.order    = if GLITCH && i >= 64'd25 ? i + 64'd1 : i;
        r.pc       = rec_pc(i);
        r.next_pc  = rec_pc(i) + 64'd4;
        r.insn     = 32'h0050_0513;
        r.priv     = 2'd3;
        r.rd_kind  = RdKind::INT;
        r.rd_addr  = 5'd10 + i[2:0];
        r.rd_wdata = i * 64'h0101_0101_0101;
        if i == 64'd0 {
            r.insn     = 32'h0110_0093;
            r.rd_addr  = 5'd1;
            r.rd_wdata = 64'h11;
        } else if i == 64'd1 {
            r.insn     = 32'h0011_0113;
            r.is_rvc   = 1'b1;
            r.next_pc  = r.pc + 64'd2;
            r.rd_addr  = 5'd2;
            r.rd_wdata = 64'h22;
        } else if i == 64'd2 {
            r.rd_addr  = 5'd0;
            r.rd_wdata = if VARIANT ? 64'hdead : 64'hbeef;
        } else if i == 64'd3 {
            r.insn     = 32'h0020_72d3;
            r.rd_kind  = RdKind::FP;
            r.rd_addr  = 5'd5;
            r.rd_wdata = 64'hffff_ffff_3f80_0000;
            r.fflags   = 5'd1;
        } else if i == 64'd4 {
            r.insn      = 32'h00b5_3023;
            r.rd_kind   = RdKind::NONE;
            r.rd_addr   = 5'd0;
            r.rd_wdata  = 64'd0;
            r.mem_size  = 3'd3;
            r.mem_paddr = 64'h8000_2000;
            r.mem_vaddr = 64'h8000_2000;
            r.mem_wmask = 16'h00ff;
            r.mem_wdata = 64'h1122_3344_5566_7788;
        } else if i == 64'd5 {
            r.insn      = 32'h00b5_0023;
            r.rd_kind   = RdKind::NONE;
            r.rd_addr   = 5'd0;
            r.rd_wdata  = 64'd0;
            r.mem_size  = 3'd0;
            r.mem_paddr = 64'h8000_2003;
            r.mem_vaddr = 64'h8000_2003;
            r.mem_wmask = 16'h0001;
            r.mem_wdata = if VARIANT ? 64'h34ab : 64'h12ab;
        } else if i == 64'd6 {
            r.insn      = 32'h3402_9073;
            r.rd_kind   = RdKind::NONE;
            r.rd_addr   = 5'd0;
            r.rd_wdata  = 64'd0;
            r.csr_valid = 1'b1;
            r.csr_addr  = 12'h340;
            r.csr_wdata = 64'h5a5a;
        } else if i == 64'd7 {
            r.insn     = 32'hb000_22f3;
            r.rd_addr  = 5'd5;
            r.rd_wdata = if VARIANT ? 64'd2000 : 64'd1000;
        } else if i == 64'd8 {
            r.insn     = 32'h3440_2373;
            r.rd_addr  = 5'd6;
            r.rd_wdata = if VARIANT ? 64'h2080 : 64'h0080;
        } else if i == 64'd9 {
            r.trap     = 1'b1;
            r.cause    = 6'd12;
            r.tval     = 64'h8000_0024;
            r.insn     = if VARIANT ? 32'hffff_ffff : 32'h0;
            r.is_rvc   = VARIANT;
            r.next_pc  = 64'd0;
            r.rd_kind  = RdKind::NONE;
            r.rd_addr  = 5'd0;
            r.rd_wdata = 64'd0;
        } else if i == 64'd10 {
            r.insn      = 32'h2805_b42f;
            r.rd_addr   = 5'd8;
            r.rd_wdata  = 64'h0123_4567;
            r.rd2_valid = 1'b1;
            r.rd2_wdata = 64'h89ab_cdef;
        } else if i == 64'd11 {
            r.insn      = 32'h00b5_0023;
            r.rd_kind   = RdKind::NONE;
            r.rd_addr   = 5'd0;
            r.rd_wdata  = 64'd0;
            r.mem_size  = 3'd0;
            r.mem_paddr = 64'h1000_0000;
            r.mem_vaddr = 64'h1000_0000;
            r.mem_io    = 1'b1;
            r.mem_wmask = 16'h0001;
            r.mem_wdata = 64'h41;
        } else if i == 64'd12 {
            r.insn         = 32'h00b5_4027;
            r.rd_kind      = RdKind::NONE;
            r.rd_addr      = 5'd0;
            r.rd_wdata     = 64'd0;
            r.mem_size     = 3'd4;
            r.mem_paddr    = 64'h8000_2010;
            r.mem_vaddr    = 64'h8000_2010;
            r.mem_wmask    = 16'hffff;
            r.mem_wdata    = 64'h0706_0504_0302_0100;
            r.mem_wdata_hi = 64'h0f0e_0d0c_0b0a_0908;
        } else if i == 64'd13 {
            r.trap     = 1'b1;
            r.cause    = 6'd2;
            r.is_rvc   = 1'b1;
            r.insn     = if VARIANT ? 32'h0000_0000 : 32'h0000_0001;
            r.tval     = if VARIANT ? 64'd0 : 64'h0001;
            r.next_pc  = 64'd0;
            r.rd_kind  = RdKind::NONE;
            r.rd_addr  = 5'd0;
            r.rd_wdata = 64'd0;
        } else if i == 64'd14 {
            r.trap     = 1'b1;
            r.cause    = 6'd3;
            r.insn     = 32'h0010_0073;
            r.tval     = if VARIANT ? 64'd0 : rec_pc(i);
            r.next_pc  = 64'd0;
            r.rd_kind  = RdKind::NONE;
            r.rd_addr  = 5'd0;
            r.rd_wdata = 64'd0;
        } else if i == 64'd15 || i == 64'd18 {
            r.insn      = 32'h1805_1073;
            r.priv      = 2'd1;
            r.rd_kind   = RdKind::NONE;
            r.rd_addr   = 5'd0;
            r.rd_wdata  = 64'd0;
            r.csr_valid = 1'b1;
            r.csr_addr  = 12'h180;
            r.csr_wdata = if i == 64'd15 ? 64'h8000_0000_0008_0123 : 64'h8000_0000_0008_0456;
        } else if i == 64'd16 || i == 64'd19 {
            r.insn      = 32'h00b5_3023;
            r.priv      = 2'd1;
            r.rd_kind   = RdKind::NONE;
            r.rd_addr   = 5'd0;
            r.rd_wdata  = 64'd0;
            r.mem_size  = 3'd3;
            r.mem_vaddr = 64'hffff_ffc0_0020_0000;
            r.mem_paddr = if i == 64'd16 && VARIANT ? 64'h0020_0000 : 64'h8020_0000;
            r.mem_wmask = 16'h00ff;
            r.mem_wdata = 64'h600d;
        } else if i == 64'd17 {
            r.priv = 2'd1;
        } else if i == 64'd20 {
            r.insn      = 32'h0205_7087;
            r.rd_kind   = RdKind::NONE;
            r.rd_addr   = 5'd0;
            r.rd_wdata  = 64'd0;
            r.vec_v     = 1'b1;
            r.vrf_wcnt  = 8'd1;
            r.vrf_hash  = vrf_hash_step(64'd0, 5'd1, 128'h0f0e_0d0c_0b0a_0908_0706_0504_0302_0100);
            r.vtype     = 64'h18;
            r.vl        = 64'd4;
            r.mem_size  = 3'd2;
            r.mem_paddr = if VARIANT ? 64'h8000_3000 : 64'h8000_4000;
            r.mem_wmask = 16'h000f;
            r.mem_wdata = if VARIANT ? 64'h1 : 64'h2;
        } else if i == 64'd21 {
            r.insn     = 32'h0aa0_0193;
            r.rd_addr  = 5'd3;
            r.rd_wdata = 64'haa;
        } else if i == 64'd38 {
            r.insn      = 32'h00a1_a023;
            r.rd_kind   = RdKind::NONE;
            r.rd_addr   = 5'd0;
            r.rd_wdata  = 64'd0;
            r.mem_size  = 3'd2;
            r.mem_paddr = 64'h8000_1000;
            r.mem_vaddr = 64'h8000_1000;
            r.mem_wmask = 16'h000f;
            r.mem_wdata = {32'd0, TOHOST_VAL};
        }
        return r;
    }

    var ptr_q: logic    <64>        ;
    var cyc_q: logic    <32>        ;
    var irq_q: logic    <2>         ;
    var ret_q: RetireRec     [LANES];
    var evt_q: IrqEvent             ;

    let grp    : logic<32> = (cyc_q * 32'd13 + 32'd5) % (LANES + 1);
    let irq_a  : logic     = ptr_q == IRQ_A && !irq_q[0];
    let irq_b  : logic     = ptr_q == IRQ_B && !irq_q[1];
    let irq_now: logic     = irq_a || irq_b;

    var en : logic         [LANES + 1];
    var nxt: logic    <64> [LANES + 1];
    var rec: RetireRec     [LANES]    ;
    var vld: logic         [LANES]    ;
    assign en[0]  = !irq_now;
    assign nxt[0] = ptr_q;

    for j in 0..LANES :g_lane {
        let idx : logic<64> = ptr_q + j;
        let cut : logic     = j != 0 && ((rec[j].trap && !GLITCH) || idx == IRQ_A || idx == IRQ_B);
        let here: logic     = en[j] && j <: grp && idx <: N_REC && !cut;
        assign rec[j]     = mk_rec(idx);
        assign vld[j]     = here;
        assign en[j + 1]  = here && (GLITCH || !rec[j].trap);
        assign nxt[j + 1] = if here ? idx + 64'd1 : nxt[j];
    }

    always_ff {
        if_reset {
            ptr_q = 64'd0;
            cyc_q = 32'd0;
            irq_q = 2'd0;
            ret_q = '{default: 0 as RetireRec};
            evt_q = 0 as IrqEvent;
        } else {
            cyc_q = cyc_q + 32'd1;
            ptr_q = nxt[LANES];
            for j in 0..LANES {
                ret_q[j]       = rec[j];
                ret_q[j].valid = vld[j];
            }
            evt_q.valid = irq_now;
            evt_q.cause = if irq_a ? 6'd5 : 6'd7;
            evt_q.epc   = rec_pc(ptr_q);
            evt_q.order = ptr_q;
            irq_q       = irq_q | {irq_b, irq_a};
        }
    }

    assign o_retire  = ret_q;
    assign o_irq_evt = evt_q;
}

// One tracer + monitor pair over one driver.
module rvfi_selftest_unit #(
    param LANES     : u32        = 2    ,
    param VARIANT   : bit        = 0    ,
    param GLITCH    : bit        = 0    ,
    param TOHOST_VAL: logic <32> = 32'd1,
    param PASS_BY_X3: bit        = 0    ,
    param CK_EN     : bit        = 0    ,
    param CK_FILE   : string     = ""   ,
    param CK_PRINT  : bit        = 0    ,
    param TRACE_EN  : bit        = 0    ,
) (
    clk       : input  clock                           ,
    rst       : input  reset                           ,
    i_flush   : input  logic                           ,
    o_count   : output logic<64>                       ,
    o_hash    : output logic<64>                       ,
    o_final   : output logic                           ,
    o_mismatch: output logic                           ,
    o_stale   : output logic                           ,
    o_pass    : output logic                           ,
    o_fail    : output logic                           ,
    o_done    : output logic                           ,
    o_tohost  : output logic<32>                       ,
    o_x3      : output logic<64>                       ,
    o_instret : output logic<64>                       ,
    o_trap_cnt: output logic<64>                       ,
    o_ret_cnt : output logic<64>                       ,
    o_last_pc : output logic<64>                       ,
    o_chk     : output logic<1 + retire_pkg::CHK_RET_W>,
) {
    var rr  : retire_pkg::RetireRec     [LANES];
    var ev  : retire_pkg::IrqEvent             ;
    var stop: logic                     [LANES];
    var mm  : logic                            ;
    var cy  : logic                <64>        ;

    inst u_drv: rvfi_selftest_drv #(
        LANES     : LANES     ,
        VARIANT   : VARIANT   ,
        GLITCH    : GLITCH    ,
        TOHOST_VAL: TOHOST_VAL,
    ) (
        clk          ,
        rst          ,
        o_retire : rr,
        o_irq_evt: ev,
    );

    inst u_trc: rvfi_tracer #(
        LANES   : LANES   ,
        CK_EN   : CK_EN   ,
        CK_FILE : CK_FILE ,
        CK_LOG2 : 3       ,
        CK_DEPTH: 16      ,
        CK_PRINT: CK_PRINT,
        TRACE_EN: TRACE_EN,
    ) (
        clk                     ,
        rst                     ,
        i_retire       : rr     ,
        i_irq_evt      : ev     ,
        i_stop         : stop   ,
        i_flush                 ,
        o_count                 ,
        o_hash                  ,
        o_final_valid  : o_final,
        o_hash_mismatch: mm     ,
        o_ck_stale     : o_stale,
    );

    inst u_mon: retire_mon #(
        LANES     : LANES     ,
        PASS_BY_X3: PASS_BY_X3,
        CHK_W     : 1         ,
    ) (
        clk                  ,
        rst                  ,
        i_retire       : rr  ,
        i_irq_evt      : ev  ,
        i_chk          : 1'b0,
        i_hash_mismatch: mm  ,
        o_stop         : stop,
        o_x3                 ,
        o_tohost             ,
        o_pass               ,
        o_fail               ,
        o_done               ,
        o_cycles       : cy  ,
        o_instret            ,
        o_last_pc            ,
        o_ret_cnt            ,
        o_trap_cnt           ,
        o_chk                ,
    );

    assign o_mismatch = mm;
    let _unused_cy: logic = cy[0];
}

#[test(test_rvfi_tracer_selftest)]
module test_rvfi_tracer_selftest {
    import retire_pkg::*;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var flush: logic;

    // a: 2 lanes, golden checkpoints that match, trace printed.
    // e: 4 lanes, same stream. b: 4 lanes, masked-field variant, one wrong
    // checkpoint. f: stale checkpoint file. c: boot-style pass on x3.
    // d: tohost=3 with contract glitches.
    var a_cnt : logic<64>           ;
    var a_hash: logic<64>           ;
    var a_fin : logic               ;
    var a_mm  : logic               ;
    var a_st  : logic               ;
    var a_pass: logic               ;
    var a_fail: logic               ;
    var a_done: logic               ;
    var a_th  : logic<32>           ;
    var a_x3  : logic<64>           ;
    var a_ins : logic<64>           ;
    var a_trp : logic<64>           ;
    var a_ret : logic<64>           ;
    var a_pc  : logic<64>           ;
    var a_chk : logic<1 + CHK_RET_W>;

    var e_cnt : logic<64>           ;
    var e_hash: logic<64>           ;
    var e_fin : logic               ;
    var e_mm  : logic               ;
    var e_st  : logic               ;
    var e_pass: logic               ;
    var e_fail: logic               ;
    var e_done: logic               ;
    var e_th  : logic<32>           ;
    var e_x3  : logic<64>           ;
    var e_ins : logic<64>           ;
    var e_trp : logic<64>           ;
    var e_ret : logic<64>           ;
    var e_pc  : logic<64>           ;
    var e_chk : logic<1 + CHK_RET_W>;

    var b_cnt : logic<64>           ;
    var b_hash: logic<64>           ;
    var b_fin : logic               ;
    var b_mm  : logic               ;
    var b_st  : logic               ;
    var b_pass: logic               ;
    var b_fail: logic               ;
    var b_done: logic               ;
    var b_th  : logic<32>           ;
    var b_x3  : logic<64>           ;
    var b_ins : logic<64>           ;
    var b_trp : logic<64>           ;
    var b_ret : logic<64>           ;
    var b_pc  : logic<64>           ;
    var b_chk : logic<1 + CHK_RET_W>;

    var f_cnt : logic<64>           ;
    var f_hash: logic<64>           ;
    var f_fin : logic               ;
    var f_mm  : logic               ;
    var f_st  : logic               ;
    var f_pass: logic               ;
    var f_fail: logic               ;
    var f_done: logic               ;
    var f_th  : logic<32>           ;
    var f_x3  : logic<64>           ;
    var f_ins : logic<64>           ;
    var f_trp : logic<64>           ;
    var f_ret : logic<64>           ;
    var f_pc  : logic<64>           ;
    var f_chk : logic<1 + CHK_RET_W>;

    var c_cnt : logic<64>           ;
    var c_hash: logic<64>           ;
    var c_fin : logic               ;
    var c_mm  : logic               ;
    var c_st  : logic               ;
    var c_pass: logic               ;
    var c_fail: logic               ;
    var c_done: logic               ;
    var c_th  : logic<32>           ;
    var c_x3  : logic<64>           ;
    var c_ins : logic<64>           ;
    var c_trp : logic<64>           ;
    var c_ret : logic<64>           ;
    var c_pc  : logic<64>           ;
    var c_chk : logic<1 + CHK_RET_W>;

    var d_cnt : logic<64>           ;
    var d_hash: logic<64>           ;
    var d_fin : logic               ;
    var d_mm  : logic               ;
    var d_st  : logic               ;
    var d_pass: logic               ;
    var d_fail: logic               ;
    var d_done: logic               ;
    var d_th  : logic<32>           ;
    var d_x3  : logic<64>           ;
    var d_ins : logic<64>           ;
    var d_trp : logic<64>           ;
    var d_ret : logic<64>           ;
    var d_pc  : logic<64>           ;
    var d_chk : logic<1 + CHK_RET_W>;

    inst u_a: rvfi_selftest_unit #(
        LANES   : 2                                    ,
        CK_EN   : 1                                    ,
        CK_FILE : "test/golden/selftest/rvfi_ok.ck.hex",
        CK_PRINT: 1                                    ,
        TRACE_EN: 1                                    ,
    ) (
        clk               ,
        rst               ,
        i_flush   : flush ,
        o_count   : a_cnt ,
        o_hash    : a_hash,
        o_final   : a_fin ,
        o_mismatch: a_mm  ,
        o_stale   : a_st  ,
        o_pass    : a_pass,
        o_fail    : a_fail,
        o_done    : a_done,
        o_tohost  : a_th  ,
        o_x3      : a_x3  ,
        o_instret : a_ins ,
        o_trap_cnt: a_trp ,
        o_ret_cnt : a_ret ,
        o_last_pc : a_pc  ,
        o_chk     : a_chk ,
    );
    inst u_e: rvfi_selftest_unit #(
        LANES: 4,
    ) (
        clk               ,
        rst               ,
        i_flush   : flush ,
        o_count   : e_cnt ,
        o_hash    : e_hash,
        o_final   : e_fin ,
        o_mismatch: e_mm  ,
        o_stale   : e_st  ,
        o_pass    : e_pass,
        o_fail    : e_fail,
        o_done    : e_done,
        o_tohost  : e_th  ,
        o_x3      : e_x3  ,
        o_instret : e_ins ,
        o_trap_cnt: e_trp ,
        o_ret_cnt : e_ret ,
        o_last_pc : e_pc  ,
        o_chk     : e_chk ,
    );
    inst u_b: rvfi_selftest_unit #(
        LANES  : 4                                     ,
        VARIANT: 1                                     ,
        CK_EN  : 1                                     ,
        CK_FILE: "test/golden/selftest/rvfi_bad.ck.hex",
    ) (
        clk               ,
        rst               ,
        i_flush   : flush ,
        o_count   : b_cnt ,
        o_hash    : b_hash,
        o_final   : b_fin ,
        o_mismatch: b_mm  ,
        o_stale   : b_st  ,
        o_pass    : b_pass,
        o_fail    : b_fail,
        o_done    : b_done,
        o_tohost  : b_th  ,
        o_x3      : b_x3  ,
        o_instret : b_ins ,
        o_trap_cnt: b_trp ,
        o_ret_cnt : b_ret ,
        o_last_pc : b_pc  ,
        o_chk     : b_chk ,
    );
    inst u_f: rvfi_selftest_unit #(
        LANES  : 2                                       ,
        CK_EN  : 1                                       ,
        CK_FILE: "test/golden/selftest/rvfi_stale.ck.hex",
    ) (
        clk               ,
        rst               ,
        i_flush   : flush ,
        o_count   : f_cnt ,
        o_hash    : f_hash,
        o_final   : f_fin ,
        o_mismatch: f_mm  ,
        o_stale   : f_st  ,
        o_pass    : f_pass,
        o_fail    : f_fail,
        o_done    : f_done,
        o_tohost  : f_th  ,
        o_x3      : f_x3  ,
        o_instret : f_ins ,
        o_trap_cnt: f_trp ,
        o_ret_cnt : f_ret ,
        o_last_pc : f_pc  ,
        o_chk     : f_chk ,
    );
    inst u_c: rvfi_selftest_unit #(
        LANES     : 4,
        PASS_BY_X3: 1,
    ) (
        clk               ,
        rst               ,
        i_flush   : flush ,
        o_count   : c_cnt ,
        o_hash    : c_hash,
        o_final   : c_fin ,
        o_mismatch: c_mm  ,
        o_stale   : c_st  ,
        o_pass    : c_pass,
        o_fail    : c_fail,
        o_done    : c_done,
        o_tohost  : c_th  ,
        o_x3      : c_x3  ,
        o_instret : c_ins ,
        o_trap_cnt: c_trp ,
        o_ret_cnt : c_ret ,
        o_last_pc : c_pc  ,
        o_chk     : c_chk ,
    );
    inst u_d: rvfi_selftest_unit #(
        LANES     : 2    ,
        GLITCH    : 1    ,
        TOHOST_VAL: 32'd3,
    ) (
        clk               ,
        rst               ,
        i_flush   : flush ,
        o_count   : d_cnt ,
        o_hash    : d_hash,
        o_final   : d_fin ,
        o_mismatch: d_mm  ,
        o_stale   : d_st  ,
        o_pass    : d_pass,
        o_fail    : d_fail,
        o_done    : d_done,
        o_tohost  : d_th  ,
        o_x3      : d_x3  ,
        o_instret : d_ins ,
        o_trap_cnt: d_trp ,
        o_ret_cnt : d_ret ,
        o_last_pc : d_pc  ,
        o_chk     : d_chk ,
    );

    // 44 records, 3 traps; the tohost store is record 38, x3 := 0xAA is 21.
    let a_ok: logic = a_pass && !a_fail && a_done && !a_mm && !a_st && a_fin && a_cnt == 64'd39 && a_th == 32'd1 && a_x3
        == 64'haa && a_ins == 64'd36 && a_trp == 64'd3 && a_ret == 64'd41 && a_pc == 64'h8000_00ac && a_chk == '0;
    let e_ok: logic = e_pass && e_fin && e_cnt == 64'd39 && e_hash == a_hash && e_ins == 64'd36 && e_chk == '0;
    let b_ok: logic = b_mm && !b_st && b_fail && !b_pass && b_done && b_fin && b_hash == a_hash && b_ins == 64'd36
        && b_chk == '0;
    let f_ok: logic = f_mm && f_st && f_fail && !f_pass && f_hash == a_hash;
    let c_ok: logic = c_pass && !c_fail && c_fin && c_cnt == 64'd22 && c_ins == 64'd19 && c_x3 == 64'haa && c_chk == '0;
    let d_ok: logic = d_fail && !d_pass && d_th == 32'd3 && d_chk[CHK_RET_ORDER] && d_chk[CHK_RET_TRAP_LN] && d_hash
        != a_hash;

    initial {
        flush = 1'b0;
        rst.assert(clk);
        clk.next(120);
        flush = 1'b1;
        clk.next(2);
        $display(
            "selftest a: cnt=%d hash=%h pass=%b fail=%b mm=%b ins=%d trp=%d ret=%d pc=%h chk=%b",
            a_cnt,
            a_hash,
            a_pass,
            a_fail,
            a_mm,
            a_ins,
            a_trp,
            a_ret,
            a_pc,
            a_chk,
        );
        $display("selftest e: cnt=%d hash=%h pass=%b ins=%d chk=%b", e_cnt, e_hash, e_pass, e_ins, e_chk);
        $display("selftest b: cnt=%d hash=%h mm=%b stale=%b fail=%b chk=%b", b_cnt, b_hash, b_mm, b_st, b_fail, b_chk);
        $display("selftest f: hash=%h mm=%b stale=%b", f_hash, f_mm, f_st);
        $display("selftest c: cnt=%d hash=%h pass=%b ins=%d x3=%h chk=%b", c_cnt, c_hash, c_pass, c_ins, c_x3, c_chk);
        $display("selftest d: hash=%h fail=%b tohost=%h chk=%b", d_hash, d_fail, d_th, d_chk);
        $display("selftest ok: a=%b e=%b b=%b f=%b c=%b d=%b", a_ok, e_ok, b_ok, f_ok, c_ok, d_ok);
        $assert(a_ok && e_ok && b_ok && f_ok && c_ok && d_ok, "rvfi_tracer/retire_mon self-test failed");
        $finish();
    }
}
