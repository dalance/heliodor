// D-Cache invalidate unit test (Phase 4 prep).
// Verify that an external invalidate (i_inv_valid + i_inv_addr) drops a
// previously-cached line so the next access misses and re-fills with the
// current backing-memory value. Also verify that a normal hit afterwards
// still works (no spurious flush of unrelated lines).
module test_dcache_inv_harness (
    clk   : input  clock    ,
    rst   : input  reset    ,
    o_pass: output logic    ,
    o_r1  : output logic<64>,
    o_r2  : output logic<64>,
    o_r3  : output logic<64>,
) {
    var addr     : logic<64>;
    var wdata    : logic<64>;
    var wen      : logic    ;
    var ren      : logic    ;
    var wstrb    : logic<8> ;
    var rdata    : logic<64>;
    var stall    : logic    ;
    var mem_addr : logic<64>;
    var mem_wdata: logic<64>;
    var mem_rdata: logic<64>;
    var mem_wen  : logic    ;
    var mem_ren  : logic    ;
    var mem_wstrb: logic<8> ;
    var inv_valid: logic    ;
    var inv_addr : logic<64>;

    inst dut: dcache (
        clk                   ,
        rst                   ,
        i_addr     : addr     ,
        i_wdata    : wdata    ,
        i_wen      : wen      ,
        i_ren      : ren      ,
        i_wstrb    : wstrb    ,
        o_rdata    : rdata    ,
        o_stall    : stall    ,
        o_mem_addr : mem_addr ,
        o_mem_wdata: mem_wdata,
        i_mem_rdata: mem_rdata,
        o_mem_wen  : mem_wen  ,
        o_mem_ren  : mem_ren  ,
        o_mem_wstrb: mem_wstrb,
        i_inv_valid: inv_valid,
        i_inv_addr : inv_addr ,
        i_mem_grant: 1'b1     ,
    );

    var mem: logic<64> [256];
    assign mem_rdata = mem[mem_addr[10:3]];

    var tc    : logic<8> ;
    var r1_val: logic<64>;
    var r2_val: logic<64>;
    var r3_val: logic<64>;

    always_ff (clk, rst) {
        if_reset {
            tc        = 8'd0;
            addr      = '0;
            wdata     = '0;
            wen       = 1'b0;
            ren       = 1'b0;
            wstrb     = '0;
            inv_valid = 1'b0;
            inv_addr  = '0;
            r1_val    = '0;
            r2_val    = '0;
            r3_val    = '0;
            for i in 0..256 {
                if i == 0 {
                    mem[i] = 64'h0000_0000_0000_AAAA;
                } else {
                    mem[i] = 64'd0;
                }
            }
        } else {
            wen       = 1'b0;
            ren       = 1'b0;
            inv_valid = 1'b0;

            if mem_wen {
                mem[mem_addr[10:3]] = mem_wdata;
            }

            // Hold ren during stall (fill in progress)
            if stall {
                ren = 1'b1;
            }

            if !stall {
                tc = tc + 8'd1;
            }

            case tc {
                // Phase 1: First read of addr 0x0 (miss → fill from mem=AAAA)
                8'd1: {
                    addr = 64'h0;
                    ren  = 1'b1;
                }
                // tc=2: DONE→IDLE; tc=3: re-read same addr (now hits)
                8'd3: {
                    addr = 64'h0;
                    ren  = 1'b1;
                }
                8'd4: {
                    r1_val = rdata; // expect AAAA from cache hit
                }

                // Phase 2: invalidate that line, and rewrite backing memory.
                // Direct mem[] write is testbench-only (simulating a foreign
                // store that bypasses this dcache).
                8'd5: {
                    inv_valid = 1'b1;
                    inv_addr  = 64'h0;
                    mem[0]    = 64'h0000_0000_0000_CCCC;
                }

                // Phase 3: re-read addr 0x0 → must miss (line was invalidated)
                // → re-fill from mem[0]=CCCC
                8'd7: {
                    addr = 64'h0;
                    ren  = 1'b1;
                }
                // After fill+DONE+IDLE, tc advances; re-read for hit value
                8'd9: {
                    addr = 64'h0;
                    ren  = 1'b1;
                }
                8'd10: {
                    r2_val = rdata; // expect CCCC
                }

                // Phase 4: subsequent hit on same line still works
                8'd12: {
                    addr = 64'h0;
                    ren  = 1'b1;
                }
                8'd13: {
                    r3_val = rdata; // expect CCCC
                }

                default: {}
            }
        }
    }

    assign o_r1   = r1_val;
    assign o_r2   = r2_val;
    assign o_r3   = r3_val;
    assign o_pass = r1_val == 64'h0000_0000_0000_AAAA && r2_val == 64'h0000_0000_0000_CCCC && r3_val
        == 64'h0000_0000_0000_CCCC;
}

#[test(test_dcache_inv)]
module test_dcache_inv {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var pass: logic    ;
    var r1  : logic<64>;
    var r2  : logic<64>;
    var r3  : logic<64>;
    inst harness: test_dcache_inv_harness ( clk: clk, rst: rst, o_pass: pass, o_r1: r1, o_r2: r2, o_r3: r3 );
    initial {
        rst.assert(clk);
        clk.next  (80);
        $display  (r1, r2, r3, pass);
        $assert   (pass, "D-Cache invalidate test failed");
        $display  ("D-Cache invalidate test passed");
        $finish   ();
    }
}
