// Integer divider unit test.
// Tests: unsigned div/rem, signed div/rem, div-by-zero, signed overflow, W variants.
module test_int_div_harness (
    clk   : input  clock,
    rst   : input  reset,
    o_pass: output logic,
    o_done: output logic,
) {
    var tc: logic<8>;

    always_ff {
        if_reset {
            tc = 8'd0;
        } else {
            tc = tc + 8'd1;
        }
    }

    var req_valid: logic    ;
    var req_a    : logic<64>;
    var req_b    : logic<64>;
    var req_sign : logic    ;
    var req_rem  : logic    ;
    var req_word : logic    ;
    var flush    : logic    ;

    var res_result: logic<64>;
    var res_valid : logic    ;
    var res_busy  : logic    ;

    inst dut: int_divider (
        clk                 ,
        rst                 ,
        i_valid : req_valid ,
        i_a     : req_a     ,
        i_b     : req_b     ,
        i_signed: req_sign  ,
        i_rem   : req_rem   ,
        i_word  : req_word  ,
        i_flush : flush     ,
        o_result: res_result,
        o_valid : res_valid ,
        o_busy  : res_busy  ,
    );

    var failed  : logic    ;
    var test_num: logic<8> ;
    var expected: logic<64>;
    var waiting : logic    ;

    always_ff {
        if_reset {
            failed    = 1'b0;
            test_num  = 8'd0;
            waiting   = 1'b0;
            req_valid = 1'b0;
            req_a     = '0;
            req_b     = '0;
            req_sign  = 1'b0;
            req_rem   = 1'b0;
            req_word  = 1'b0;
            flush     = 1'b0;
            expected  = '0;
        } else {
            req_valid = 1'b0;
            flush     = 1'b0;

            if res_valid && waiting {
                // Check result
                if res_result != expected {
                    $display("FAIL test %d: expected %h got %h", test_num, expected, res_result);
                    failed   = 1'b1;
                }
                waiting  = 1'b0;
                test_num = test_num + 8'd1;
            }

            if !waiting && !res_busy {
                case test_num {
                    // Test 0: 7 / 3 = 2 (unsigned)
                    8'd0: {
                        req_valid = 1'b1;
                        req_a     = 64'd7;
                        req_b     = 64'd3;
                        req_sign  = 1'b0;
                        req_rem   = 1'b0;
                        req_word  = 1'b0;
                        expected  = 64'd2;
                        waiting   = 1'b1;
                    }
                    // Test 1: 7 % 3 = 1 (unsigned)
                    8'd1: {
                        req_valid = 1'b1;
                        req_a     = 64'd7;
                        req_b     = 64'd3;
                        req_sign  = 1'b0;
                        req_rem   = 1'b1;
                        req_word  = 1'b0;
                        expected  = 64'd1;
                        waiting   = 1'b1;
                    }
                    // Test 2: -7 / 3 = -2 (signed, truncate toward zero)
                    8'd2: {
                        req_valid = 1'b1;
                        req_a     = ~64'd7 + 64'd1;
                        req_b     = 64'd3; // -7
                        req_sign  = 1'b1;
                        req_rem   = 1'b0;
                        req_word  = 1'b0;
                        expected  = ~64'd2 + 64'd1; // -2
                        waiting   = 1'b1;
                    }
                    // Test 3: -7 % 3 = -1 (signed)
                    8'd3: {
                        req_valid = 1'b1;
                        req_a     = ~64'd7 + 64'd1;
                        req_b     = 64'd3;
                        req_sign  = 1'b1;
                        req_rem   = 1'b1;
                        req_word  = 1'b0;
                        expected  = ~64'd1 + 64'd1; // -1
                        waiting   = 1'b1;
                    }
                    // Test 4: div by zero (unsigned) → all-ones
                    8'd4: {
                        req_valid = 1'b1;
                        req_a     = 64'd42;
                        req_b     = 64'd0;
                        req_sign  = 1'b0;
                        req_rem   = 1'b0;
                        req_word  = 1'b0;
                        expected  = 64'hFFFFFFFF_FFFFFFFF;
                        waiting   = 1'b1;
                    }
                    // Test 5: rem by zero → dividend
                    8'd5: {
                        req_valid = 1'b1;
                        req_a     = 64'd42;
                        req_b     = 64'd0;
                        req_sign  = 1'b0;
                        req_rem   = 1'b1;
                        req_word  = 1'b0;
                        expected  = 64'd42;
                        waiting   = 1'b1;
                    }
                    // Test 6: signed overflow -2^63 / -1 → -2^63
                    8'd6: {
                        req_valid = 1'b1;
                        req_a     = 64'h80000000_00000000;
                        req_b     = 64'hFFFFFFFF_FFFFFFFF;
                        req_sign  = 1'b1;
                        req_rem   = 1'b0;
                        req_word  = 1'b0;
                        expected  = 64'h80000000_00000000;
                        waiting   = 1'b1;
                    }
                    // Test 7: signed overflow remainder → 0
                    8'd7: {
                        req_valid = 1'b1;
                        req_a     = 64'h80000000_00000000;
                        req_b     = 64'hFFFFFFFF_FFFFFFFF;
                        req_sign  = 1'b1;
                        req_rem   = 1'b1;
                        req_word  = 1'b0;
                        expected  = 64'd0;
                        waiting   = 1'b1;
                    }
                    // Test 8: DIVW 7 / 3 = 2 (32-bit, sign-extended)
                    8'd8: {
                        req_valid = 1'b1;
                        req_a     = 64'd7;
                        req_b     = 64'd3;
                        req_sign  = 1'b1;
                        req_rem   = 1'b0;
                        req_word  = 1'b1;
                        expected  = 64'd2;
                        waiting   = 1'b1;
                    }
                    // Test 9: DIVUW large / small
                    8'd9: {
                        req_valid = 1'b1;
                        req_a     = 64'h00000000_80000000;
                        req_b     = 64'd3;
                        req_sign  = 1'b0;
                        req_rem   = 1'b0;
                        req_word  = 1'b1;
                        expected  = {32'h00000000, 32'h2AAAAAAA}; // 0x80000000/3 = 0x2AAAAAAA, sign-ext bit31=0
                        waiting   = 1'b1;
                    }
                    default: {}
                }
            }
        }
    }

    assign o_pass = !failed;
    assign o_done = test_num >: 8'd9 && !waiting;
}

#[test(test_int_div)]
module test_int_div {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass: logic;
    var done: logic;

    inst harness: test_int_div_harness ( clk: clk, rst: rst, o_pass: pass, o_done: done );

    initial {
        rst.assert(clk);
        for _i in 0..800 {
            clk.next(1);
        }
        $assert (pass, "Integer divider test failed");
        $assert (done, "Integer divider test did not complete in time");
        $display("Integer divider test passed");
        $finish ();
    }
}
