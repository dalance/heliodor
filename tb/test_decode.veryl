// decode: directed vectors for op classification, operand use, legality and
// exception records, checked lane by lane in both configs, plus the DQ take
// rule and the pred_taken checker. Lanes whose vector needs a different CSR
// state from lane 0 are not checked in that cycle (the state is shared).
package decode_tb_pkg {
    struct Vec {
        insn : logic<32>,
        fu   : logic<4> ,
        rd   : logic    ,
        fprd : logic    ,
        exc  : logic    ,
        cause: logic<6> ,
        tval : logic<32>,
        fl   : logic<2> ,
        alone: logic    ,
        ns   : logic    ,
        dr   : logic    ,
        ldb  : logic    ,
        cw   : logic    ,
        u    : logic<3> ,
        c    : logic<2> ,
        lq   : logic    ,
        sq   : logic    ,
        tvm  : logic    ,
        priv : logic<2> ,
        tsr  : logic    ,
        virt : logic    ,
        rvc  : logic    ,
        cinsn: logic<16>,
        fexc : logic    ,
        pt   : logic    ,
    }
}

module decode_harness::<CFG: core_cfg> (
    clk   : input  clock   ,
    rst   : input  reset   ,
    o_pass: output logic   ,
    o_done: output logic   ,
