                x.virt  = 1'b0;
                x.rvc   = 1'b1;
                x.cinsn = 16'h1234;
                x.fexc  = 1'b0;
                x.pt    = 1'b0;
            }
            8'd45: { // fetch fault
                x.insn  = 32'h00000000;
                x.fu    = 4'd0;
                x.rd    = 1'b0;
                x.fprd  = 1'b0;
                x.exc   = 1'b1;
                x.cause = 6'd1;
                x.tval  = 32'h80000000;
                x.fl    = 2'd0;
                x.alone = 1'b0;
                x.ns    = 1'b0;
                x.dr    = 1'b0;
                x.ldb   = 1'b0;
                x.cw    = 1'b0;
                x.u     = 3'b000;
                x.c     = 2'b00;
                x.lq    = 1'b0;
                x.sq    = 1'b0;
                x.priv  = 2'd3;
                x.tvm   = 1'b0;
                x.tsr   = 1'b0;
                x.virt  = 1'b0;
                x.rvc   = 1'b0;
                x.cinsn = 16'h0000;
                x.fexc  = 1'b1;
                x.pt    = 1'b0;
            }
            8'd46: { // vadd.vv
                x.insn  = 32'h02000057;
                x.fu    = 4'd0;
                x.rd    = 1'b0;
                x.fprd  = 1'b0;
                x.exc   = 1'b1;
                x.cause = 6'd2;
                x.tval  = 32'h02000057;
                x.fl    = 2'd0;
                x.alone = 1'b0;
                x.ns    = 1'b0;
                x.dr    = 1'b0;
                x.ldb   = 1'b0;
                x.cw    = 1'b0;
                x.u     = 3'b000;
                x.c     = 2'b00;
                x.lq    = 1'b0;
                x.sq    = 1'b0;
                x.priv  = 2'd3;
                x.tvm   = 1'b0;
                x.tsr   = 1'b0;
                x.virt  = 1'b0;
                x.rvc   = 1'b0;
                x.cinsn = 16'h0000;
                x.fexc  = 1'b0;
                x.pt    = 1'b0;
            }
            8'd47: { // sfence.vma
                x.insn  = 32'h12208073;
                x.fu    = 4'd8;
                x.rd    = 1'b0;
                x.fprd  = 1'b0;
                x.exc   = 1'b0;
                x.cause = 6'd0;
                x.tval  = 32'h00000000;
                x.fl    = 2'd1;
                x.alone = 1'b1;
                x.ns    = 1'b1;
                x.dr    = 1'b1;
                x.ldb   = 1'b0;
                x.cw    = 1'b0;
                x.u     = 3'b011;
                x.c     = 2'b00;
                x.lq    = 1'b0;
                x.sq    = 1'b0;
                x.priv  = 2'd3;
                x.tvm   = 1'b0;
                x.tsr   = 1'b0;
                x.virt  = 1'b0;
                x.rvc   = 1'b0;
                x.cinsn = 16'h0000;
                x.fexc  = 1'b0;
                x.pt    = 1'b0;
            }
            8'd48: { // add with stray pred_taken
                x.insn  = 32'h002082b3;
                x.fu    = 4'd1;
                x.rd    = 1'b1;
                x.fprd  = 1'b0;
                x.exc   = 1'b0;
                x.cause = 6'd0;
                x.tval  = 32'h00000000;
                x.fl    = 2'd0;
                x.alone = 1'b0;
                x.ns    = 1'b0;
                x.dr    = 1'b0;
                x.ldb   = 1'b0;
                x.cw    = 1'b0;
                x.u     = 3'b011;
                x.c     = 2'b00;
                x.lq    = 1'b0;
                x.sq    = 1'b0;
                x.priv  = 2'd3;
                x.tvm   = 1'b0;
                x.tsr   = 1'b0;
                x.virt  = 1'b0;
                x.rvc   = 1'b0;
                x.cinsn = 16'h0000;
                x.fexc  = 1'b0;
                x.pt    = 1'b1;
            }
            8'd49: { // csrr fflags (unserved)
                x.insn  = 32'h001022f3;
                x.fu    = 4'd0;
                x.rd    = 1'b0;
                x.fprd  = 1'b0;
                x.exc   = 1'b1;
                x.cause = 6'd2;
                x.tval  = 32'h001022f3;
                x.fl    = 2'd0;
                x.alone = 1'b0;
                x.ns    = 1'b0;
                x.dr    = 1'b0;
                x.ldb   = 1'b0;
                x.cw    = 1'b0;
                x.u     = 3'b000;
                x.c     = 2'b00;
                x.lq    = 1'b0;
                x.sq    = 1'b0;
                x.priv  = 2'd3;
                x.tvm   = 1'b0;
                x.tsr   = 1'b0;
                x.virt  = 1'b0;
                x.rvc   = 1'b0;
                x.cinsn = 16'h0000;
                x.fexc  = 1'b0;
                x.pt    = 1'b0;
            }
            8'd50: { // hlv.w (unserved)
                x.insn  = 32'h6800c2f3;
                x.fu    = 4'd0;
                x.rd    = 1'b0;
                x.fprd  = 1'b0;
                x.exc   = 1'b1;
                x.cause = 6'd2;
                x.tval  = 32'h6800c2f3;
                x.fl    = 2'd0;
                x.alone = 1'b0;
                x.ns    = 1'b0;
                x.dr    = 1'b0;
                x.ldb   = 1'b0;
                x.cw    = 1'b0;
                x.u     = 3'b000;
                x.c     = 2'b00;
                x.lq    = 1'b0;
                x.sq    = 1'b0;
                x.priv  = 2'd3;
                x.tvm   = 1'b0;
                x.tsr   = 1'b0;
                x.virt  = 1'b0;
                x.rvc   = 1'b0;
                x.cinsn = 16'h0000;
                x.fexc  = 1'b0;
                x.pt    = 1'b0;
            }
            8'd51: { // cbo.zero (unserved)
                x.insn  = 32'h0040a00f;
                x.fu    = 4'd0;
                x.rd    = 1'b0;
                x.fprd  = 1'b0;
                x.exc   = 1'b1;
                x.cause = 6'd2;
                x.tval  = 32'h0040a00f;
                x.fl    = 2'd0;
                x.alone = 1'b0;
                x.ns    = 1'b0;
                x.dr    = 1'b0;
                x.ldb   = 1'b0;
                x.cw    = 1'b0;
                x.u     = 3'b000;
                x.c     = 2'b00;
                x.lq    = 1'b0;
                x.sq    = 1'b0;
                x.priv  = 2'd3;
                x.tvm   = 1'b0;
                x.tsr   = 1'b0;
                x.virt  = 1'b0;
                x.rvc   = 1'b0;
                x.cinsn = 16'h0000;
                x.fexc  = 1'b0;
                x.pt    = 1'b0;
            }
            8'd52: { // sfence.vma in S, TVM
                x.insn  = 32'h12208073;
                x.fu    = 4'd0;
                x.rd    = 1'b0;
                x.fprd  = 1'b0;
                x.exc   = 1'b1;
                x.cause = 6'd2;
                x.tval  = 32'h12208073;
                x.fl    = 2'd0;
                x.alone = 1'b0;
                x.ns    = 1'b0;
                x.dr    = 1'b0;
                x.ldb   = 1'b0;
                x.cw    = 1'b0;
                x.u     = 3'b000;
                x.c     = 2'b00;
                x.lq    = 1'b0;
                x.sq    = 1'b0;
                x.priv  = 2'd1;
                x.tvm   = 1'b1;
                x.tsr   = 1'b0;
                x.virt  = 1'b0;
                x.rvc   = 1'b0;
                x.cinsn = 16'h0000;
                x.fexc  = 1'b0;
                x.pt    = 1'b0;
            }
            8'd53: { // csrr satp in S, TVM
                x.insn  = 32'h180022f3;
                x.fu    = 4'd0;
                x.rd    = 1'b0;
                x.fprd  = 1'b0;
                x.exc   = 1'b1;
                x.cause = 6'd2;
                x.tval  = 32'h180022f3;
                x.fl    = 2'd0;
                x.alone = 1'b0;
                x.ns    = 1'b0;
                x.dr    = 1'b0;
                x.ldb   = 1'b0;
                x.cw    = 1'b0;
                x.u     = 3'b000;
                x.c     = 2'b00;
                x.lq    = 1'b0;
                x.sq    = 1'b0;
                x.priv  = 2'd1;
                x.tvm   = 1'b1;
                x.tsr   = 1'b0;
                x.virt  = 1'b0;
                x.rvc   = 1'b0;
                x.cinsn = 16'h0000;
                x.fexc  = 1'b0;
                x.pt    = 1'b0;
            }
            8'd54: { // csrr satp in S
                x.insn  = 32'h180022f3;
                x.fu    = 4'd8;
                x.rd    = 1'b1;
                x.fprd  = 1'b0;
                x.exc   = 1'b0;
                x.cause = 6'd0;
                x.tval  = 32'h00000000;
                x.fl    = 2'd0;
                x.alone = 1'b1;
                x.ns    = 1'b1;
                x.dr    = 1'b0;
                x.ldb   = 1'b0;
                x.cw    = 1'b0;
                x.u     = 3'b001;
                x.c     = 2'b00;
                x.lq    = 1'b0;
                x.sq    = 1'b0;
                x.priv  = 2'd1;
                x.tvm   = 1'b0;
                x.tsr   = 1'b0;
                x.virt  = 1'b0;
                x.rvc   = 1'b0;
                x.cinsn = 16'h0000;
                x.fexc  = 1'b0;
                x.pt    = 1'b0;
            }
            default: {}
        }
        return x;
    }

    var base_q: logic<8> ;
    var lfsr  : logic<64>;
    var cnt   : logic<16>;
    var ok    : logic    ;
    var bad_q : logic<8> ;
    var cov_q : logic<3> ;
    var seen_q: logic    ; // the stray pred_taken vector has been presented

    let nv   : logic<DT_W> = (lfsr[11:8] % (W + 1)) as DT_W;
    let rq_rd: logic       = lfsr[20];

    var xv : Vec      [W];
    var iv : logic    [W];
    var xop: XOp      [W];
    var idx: logic<8> [W];
    always_comb {
        for l in 0..W {
            idx[l]            = ((base_q + l) % NV) as 8;
            xv[l]             = vec(idx[l]);
            iv[l]             = l <: nv;
            xop[l]            = 0 as XOp;
            xop[l].insn       = xv[l].insn;
            xop[l].is_rvc     = xv[l].rvc;
            xop[l].cinsn      = xv[l].cinsn;
            xop[l].pred_taken = xv[l].pt;
            xop[l].exc.valid  = xv[l].fexc;
            xop[l].exc.cause  = 6'd1;
            xop[l].exc.tval   = 64'h8000_0000;
        }
    }

    var ov  : logic         [W];
    var od  : DecOp         [W];
    var take: logic  <DT_W>    ;
    var perf: DecPerf          ;
    var chk : logic            ;
    inst dut: decode::<CFG> (
        clk                                            ,
        rst                                            ,
        i_valid      : iv                              ,
        i_xop        : xop                             ,
        i_rq_ready   : rq_rd                           ,
        o_valid      : ov                              ,
        o_dec        : od                              ,
        o_dq_take    : take                            ,
        i_priv       : xv[0].priv as csr_pkg::PrivLevel,
        i_virt       : xv[0].virt                      ,
        i_mstatus_tsr: xv[0].tsr                       ,
        i_mstatus_tvm: xv[0].tvm                       ,
        o_perf       : perf                            ,
        o_chk        : chk                             ,
    );

    var lane_bad: logic<W>;
    var stray   : logic<W>;
    always_comb {
        for l in 0..W {
            let x          : Vec   = xv[l];
            let d          : DecOp = od[l];
            let st_eq      : logic = x.priv == xv[0].priv && x.tsr == xv[0].tsr && x.tvm == xv[0].tvm && x.virt == xv[0].virt;
            var e          : logic;
            e           = d.cls.fu != x.fu || d.dst.has_rd != (x.rd || x.fprd)
                || (d.dst.has_rd && (d.dst.rcls == RegClass::FP) != x.fprd) || d.exc.valid != x.exc
                || (x.exc && (d.exc.cause != x.cause || d.exc.tval != {32'd0, x.tval})) || d.cls.flush != x.fl
                || d.cls.alone != x.alone || d.cls.nonspec != x.ns || d.cls.drain != x.dr || d.cls.ld_barrier != x.ldb
                || d.cls.csr_wr != x.cw || d.rs1.used != x.u[0] || d.rs2.used != x.u[1] || d.rs3.used != x.u[2]
                || (x.u[0] && (d.rs1.rcls == RegClass::FP) != x.c[0])
                || (x.u[1] && (d.rs2.rcls == RegClass::FP) != x.c[1]) || d.cls.budget.lq != x.lq || d.cls.budget.sq
                != x.sq || d.insn != x.insn
                || (d.cls.fu == opclass_pkg::FuKind::NONE && d.dst.has_rd);
            lane_bad[l] = iv[l] && st_eq && (e || ov[l] != iv[l]);
            stray[l]    = iv[l] && x.pt && x.fu != 4'd2 && !x.exc;
        }
    }
    let take_bad: logic = take != (if rq_rd ? nv : 0);

    always_ff {
        if_reset {
            base_q = 0;
            lfsr   = 64'h0f1e_2d3c_4b5a_6978;
            cnt    = 0;
            ok     = 1'b1;
            bad_q  = 8'hff;
            cov_q  = 0;
            seen_q = 1'b0;
        } else {
            if |lane_bad || take_bad || chk != seen_q {
                ok = 1'b0;
            }
            for l in 0..W {
                if lane_bad[l] && bad_q == 8'hff {
                    bad_q = idx[l];
                }
            }
            if |stray {
                seen_q = 1'b1;
            }
            if perf.illegal {
                cov_q[0] = 1'b1;
            }
            if perf.rq_full {
                cov_q[1] = 1'b1;
            }
            if chk {
                cov_q[2] = 1'b1;
            }
            base_q = ((base_q + nv) % NV) as 8;
            var t     : logic<64>;
            t      = lfsr ^ (lfsr << 13);
            t      = t ^ (t >> 7);
            t      = t ^ (t << 17);
            lfsr   = t;
            cnt    = cnt + 1;
        }
    }

    assign o_pass = ok;
    assign o_done = cnt >= 16'd600;
    assign o_bad  = bad_q;
    assign o_cov  = cov_q;
}

#[test(test_decode)]
module test_decode {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var pass2: logic   ;
    var done2: logic   ;
    var bad2 : logic<8>;
    var cov2 : logic<3>;
    var pass4: logic   ;
    var done4: logic   ;
    var bad4 : logic<8>;
    var cov4 : logic<3>;
    inst h2: decode_harness::<cfg_w2> (
        clk          ,
        rst          ,
        o_pass: pass2,
        o_done: done2,
        o_bad : bad2 ,
        o_cov : cov2 ,
    );
    inst h4: decode_harness::<cfg_w4> (
        clk          ,
        rst          ,
        o_pass: pass4,
        o_done: done4,
        o_bad : bad4 ,
        o_cov : cov4 ,
    );

    initial {
        rst.assert(clk);
        clk.next(620);
        $display("decode: w2 pass=%b bad=%d cov=%b  w4 pass=%b bad=%d cov=%b", pass2, bad2, cov2, pass4, bad4, cov4);
        $assert(done2 && done4, "decode test did not run enough cycles");
        $assert(pass2 && pass4, "decode output differs from the expected vector");
        $assert(cov2 == 3'b111 && cov4 == 3'b111, "decode scenario not covered");
        $finish();
    }
}
