// IEEE 754 double-precision corner case test for the FP datapath.
// Covers ±0, ±Inf, NaN propagation, divide-by-zero, invalid operations,
// and a couple of normal-value sanity vectors. Each test drives one of
// {fp_adder, fp_multiplier, fp_divider, fp_sqrt} and checks both the
// result and the fflags vector.
//
// fp_divider and fp_sqrt are multi-cycle (D1). Each test case is held
// for CYCLES_PER_TC cycles so the divider/sqrt has time to present its
// result before tc advances. The divider/sqrt o_valid pulses are latched
// into *_res_q / *_flg_q for stable comparison.
module test_fp_corner_harness (
    clk   : input  clock   ,
    rst   : input  reset   ,
    o_pass: output logic   ,
    o_done: output logic   ,
    o_tc  : output logic<8>,
) {
    // Latency per test case: must exceed fp_divider / fp_sqrt latency
    // (~57 cycles). 80 gives plenty of margin for the check to settle.
    const CYCLES_PER_TC: logic<8> = 8'd80;

    var tc      : logic<8>;
    var wait_cnt: logic<8>;

    always_ff (clk, rst) {
        if_reset {
            tc       = 8'd0;
            wait_cnt = 8'd0;
        } else if wait_cnt == 8'd0 {
            tc       = tc + 8'd1;
            wait_cnt = CYCLES_PER_TC;
        } else {
            wait_cnt = wait_cnt - 8'd1;
        }
    }

    // Pulse on the first cycle of each new test case.
    let tc_start_pulse: logic = wait_cnt == CYCLES_PER_TC;

    // ==== adder ====
    var add_a    : logic<64>;
    var add_b    : logic<64>;
    var add_sub  : logic    ;
    var add_rm   : logic<3> ;
    var add_res  : logic<64>;
    var add_flags: logic<5> ;

    inst u_add: fp_adder (
        i_a     : add_a    ,
        i_b     : add_b    ,
        i_sub   : add_sub  ,
        i_rm    : add_rm   ,
        o_result: add_res  ,
        o_fflags: add_flags,
    );

    // ==== multiplier ====
    var mul_a    : logic<64>;
    var mul_b    : logic<64>;
    var mul_rm   : logic<3> ;
    var mul_res  : logic<64>;
    var mul_flags: logic<5> ;

    inst u_mul: fp_multiplier (
        i_a     : mul_a    ,
        i_b     : mul_b    ,
        i_rm    : mul_rm   ,
        o_result: mul_res  ,
        o_fflags: mul_flags,
    );

    // ==== divider (multi-cycle) ====
    var div_a      : logic<64>;
    var div_b      : logic<64>;
    var div_rm     : logic<3> ;
    var div_res    : logic<64>;
    var div_flags  : logic<5> ;
    var div_valid_w: logic    ;
    var div_busy_w : logic    ;

    // ==== sqrt (multi-cycle) ====
    var sqrt_a      : logic<64>;
    var sqrt_rm     : logic<3> ;
    var sqrt_res    : logic<64>;
    var sqrt_flags  : logic<5> ;
    var sqrt_valid_w: logic    ;
    var sqrt_busy_w : logic    ;

    // Helpful constants
    const F_PZERO: logic<64> = 64'h0000_0000_0000_0000;
    const F_NZERO: logic<64> = 64'h8000_0000_0000_0000;
    const F_PONE : logic<64> = 64'h3FF0_0000_0000_0000;
    const F_NONE : logic<64> = 64'hBFF0_0000_0000_0000;
    const F_PTWO : logic<64> = 64'h4000_0000_0000_0000;
    const F_PFOUR: logic<64> = 64'h4010_0000_0000_0000;
    const F_PINF : logic<64> = 64'h7FF0_0000_0000_0000;
    const F_NINF : logic<64> = 64'hFFF0_0000_0000_0000;
    const F_QNAN : logic<64> = 64'h7FF8_0000_0000_0000;
    // Round-nearest-even default
    const RM_RNE: logic<3> = 3'b000;
    // Flag bit positions: {NV, DZ, OF, UF, NX} → bit4..bit0
    const FLAG_NV  : logic<5> = 5'b10000;
    const FLAG_DZ  : logic<5> = 5'b01000;
    const FLAG_NX  : logic<5> = 5'b00001;
    const FLAG_NONE: logic<5> = 5'b00000;

    // Each test selects ONE op and provides expected result+flags.
    // op_sel encodes which DUT we are checking.
    enum OpSel: logic<2> {
        ADD = 2'd0,
        MUL = 2'd1,
        DIV = 2'd2,
        SQRT = 2'd3,
    }

    var op_sel : OpSel    ;
    var exp_res: logic<64>;
    var exp_flg: logic<5> ;
    var nan_ok : logic    ; // 1 = treat any qNaN result as a match
    var valid  : logic    ;

    always_comb {
        add_a   = F_PZERO;
        add_b   = F_PZERO;
        add_sub = 1'b0;
        add_rm  = RM_RNE;
        mul_a   = F_PZERO;
        mul_b   = F_PZERO;
        mul_rm  = RM_RNE;
        div_a   = F_PZERO;
        div_b   = F_PZERO;
        div_rm  = RM_RNE;
        sqrt_a  = F_PZERO;
        sqrt_rm = RM_RNE;
        op_sel  = OpSel::ADD;
        exp_res = F_PZERO;
        exp_flg = FLAG_NONE;
        nan_ok  = 1'b0;
        valid   = 1'b1;

        case tc {
            // ---------- adder ----------
            8'd1: {
                // 0 + 0 = +0
                op_sel  = OpSel::ADD;
                add_a   = F_PZERO;
                add_b   = F_PZERO;
                exp_res = F_PZERO;
            }
            8'd2: {
                // 1 + 1 = 2
                op_sel  = OpSel::ADD;
                add_a   = F_PONE;
                add_b   = F_PONE;
                exp_res = F_PTWO;
            }
            8'd3: {
                // 1 + (-1) = +0
                op_sel  = OpSel::ADD;
                add_a   = F_PONE;
                add_b   = F_NONE;
                exp_res = F_PZERO;
            }
            8'd4: {
                // +Inf + (-Inf) = NaN, invalid
                op_sel  = OpSel::ADD;
                add_a   = F_PINF;
                add_b   = F_NINF;
                nan_ok  = 1'b1;
                exp_flg = FLAG_NV;
            }
            8'd5: {
                // qNaN + 1 = qNaN (no flag for qNaN)
                op_sel = OpSel::ADD;
                add_a  = F_QNAN;
                add_b  = F_PONE;
                nan_ok = 1'b1;
            }
            // ---------- multiplier ----------
            8'd6: {
                // 0 * 0 = +0
                op_sel  = OpSel::MUL;
                mul_a   = F_PZERO;
                mul_b   = F_PZERO;
                exp_res = F_PZERO;
            }
            8'd7: {
                // 1 * 1 = 1
                op_sel  = OpSel::MUL;
                mul_a   = F_PONE;
                mul_b   = F_PONE;
                exp_res = F_PONE;
            }
            8'd8: {
                // 0 * Inf = NaN, invalid
                op_sel  = OpSel::MUL;
                mul_a   = F_PZERO;
                mul_b   = F_PINF;
                nan_ok  = 1'b1;
                exp_flg = FLAG_NV;
            }
            8'd9: {
                // 2 * Inf = +Inf
                op_sel  = OpSel::MUL;
                mul_a   = F_PTWO;
                mul_b   = F_PINF;
                exp_res = F_PINF;
            }
            // ---------- divider ----------
            8'd10: {
                // 1 / 1 = 1, no flags
                op_sel  = OpSel::DIV;
                div_a   = F_PONE;
                div_b   = F_PONE;
                exp_res = F_PONE;
                exp_flg = FLAG_NONE;
            }
            8'd20: {
                // 10 / 5 = 2, no flags
                op_sel  = OpSel::DIV;
                div_a   = 64'h4024_0000_0000_0000;
                div_b   = 64'h4014_0000_0000_0000;
                exp_res = F_PTWO;
                exp_flg = FLAG_NONE;
            }
            8'd21: {
                // 3 / 2 = 1.5, no flags
                op_sel  = OpSel::DIV;
                div_a   = 64'h4008_0000_0000_0000;
                div_b   = F_PTWO;
                exp_res = 64'h3FF8_0000_0000_0000;
                exp_flg = FLAG_NONE;
            }
            8'd22: {
                // 4 / 2 = 2, no flags
                op_sel  = OpSel::DIV;
                div_a   = 64'h4010_0000_0000_0000;
                div_b   = F_PTWO;
                exp_res = F_PTWO;
                exp_flg = FLAG_NONE;
            }
            8'd19: {
                // 1 / 0 = +Inf, divide-by-zero
                op_sel  = OpSel::DIV;
                div_a   = F_PONE;
                div_b   = F_PZERO;
                exp_res = F_PINF;
                exp_flg = FLAG_DZ;
            }
            8'd11: {
                // 0 / 0 = NaN, invalid
                op_sel  = OpSel::DIV;
                div_a   = F_PZERO;
                div_b   = F_PZERO;
                nan_ok  = 1'b1;
                exp_flg = FLAG_NV;
            }
            8'd12: {
                // -1 / 0 = -Inf, divide-by-zero
                op_sel  = OpSel::DIV;
                div_a   = F_NONE;
                div_b   = F_PZERO;
                exp_res = F_NINF;
                exp_flg = FLAG_DZ;
            }
            // ---------- sqrt ----------
            8'd13: {
                // sqrt(0) = +0
                op_sel  = OpSel::SQRT;
                sqrt_a  = F_PZERO;
                exp_res = F_PZERO;
            }
            8'd14: {
                // sqrt(4) = 2
                op_sel  = OpSel::SQRT;
                sqrt_a  = F_PFOUR;
                exp_res = F_PTWO;
            }
            8'd15: {
                // sqrt(-1) = NaN, invalid
                op_sel  = OpSel::SQRT;
                sqrt_a  = F_NONE;
                nan_ok  = 1'b1;
                exp_flg = FLAG_NV;
            }
            default: {
                valid = 1'b0;
            }
        }
    }

    // Drive i_valid to divider / sqrt on the first cycle of a DIV/SQRT case.
    inst u_div: fp_divider (
        clk                                                      ,
        rst                                                      ,
        i_valid : tc_start_pulse && valid && op_sel == OpSel::DIV,
        i_a     : div_a                                          ,
        i_b     : div_b                                          ,
        i_rm    : div_rm                                         ,
        i_flush : 1'b0                                           ,
        o_result: div_res                                        ,
        o_fflags: div_flags                                      ,
        o_valid : div_valid_w                                    ,
        o_busy  : div_busy_w                                     ,
    );

    inst u_sqrt: fp_sqrt (
        clk                                                       ,
        rst                                                       ,
        i_valid : tc_start_pulse && valid && op_sel == OpSel::SQRT,
        i_a     : sqrt_a                                          ,
        i_rm    : sqrt_rm                                         ,
        i_flush : 1'b0                                            ,
        o_result: sqrt_res                                        ,
        o_fflags: sqrt_flags                                      ,
        o_valid : sqrt_valid_w                                    ,
        o_busy  : sqrt_busy_w                                     ,
    );

    // Latch multi-cycle results so they're available at end-of-test check.
    // Cleared at the start of each new test case.
    var div_res_q : logic<64>;
    var div_flg_q : logic<5> ;
    var div_done_q: logic    ;
    var sqrt_res_q : logic<64>;
    var sqrt_flg_q : logic<5> ;
    var sqrt_done_q: logic    ;
    always_ff (clk, rst) {
        if_reset {
            div_res_q   = '0;
            div_flg_q   = '0;
            div_done_q  = 1'b0;
            sqrt_res_q  = '0;
            sqrt_flg_q  = '0;
            sqrt_done_q = 1'b0;
        } else if tc_start_pulse {
            div_done_q  = 1'b0;
            sqrt_done_q = 1'b0;
        } else {
            if div_valid_w {
                div_res_q  = div_res;
                div_flg_q  = div_flags;
                div_done_q = 1'b1;
            }
            if sqrt_valid_w {
                sqrt_res_q  = sqrt_res;
                sqrt_flg_q  = sqrt_flags;
                sqrt_done_q = 1'b1;
            }
        }
    }

    // Pick the op output that this test is checking.
    var got_res: logic<64>;
    var got_flg: logic<5> ;
    var got_rdy: logic    ; // for ADD/MUL this is always true
    always_comb {
        got_res = F_PZERO;
        got_flg = FLAG_NONE;
        got_rdy = 1'b1;
        case op_sel {
            OpSel::ADD: {
                got_res = add_res;
                got_flg = add_flags;
            }
            OpSel::MUL: {
                got_res = mul_res;
                got_flg = mul_flags;
            }
            OpSel::DIV: {
                got_res = div_res_q;
                got_flg = div_flg_q;
                got_rdy = div_done_q;
            }
            OpSel::SQRT: {
                got_res = sqrt_res_q;
                got_flg = sqrt_flg_q;
                got_rdy = sqrt_done_q;
            }
            default: {}
        }
    }

    // qNaN detector: exponent all-ones AND mantissa nonzero
    let is_nan: logic = got_res[62:52] == 11'h7FF && got_res[51:0] != 52'd0;

    var ok: logic;
    always_comb {
        ok = 1'b1;
        // Only check at end of each test case — multi-cycle results need
        // time to settle, and we want the check to reflect the latched
        // result rather than the default F_PZERO during the pre-valid
        // window.
        if valid && wait_cnt == 8'd1 {
            if !got_rdy {
                ok = 1'b0;
            }
            if got_flg != exp_flg {
                ok = 1'b0;
            }
            if nan_ok {
                if !is_nan {
                    ok = 1'b0;
                }
            } else {
                if got_res != exp_res {
                    ok = 1'b0;
                }
            }
        }
    }

    var failed: logic;
    always_ff {
        if_reset {
            failed = 1'b0;
        } else if !ok {
            failed = 1'b1;
        }
    }

    assign o_tc   = tc;
    assign o_pass = !failed;
    assign o_done = tc >: 8'd24;
}

#[test(test_fp_corner)]
module test_fp_corner {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen;

    var pass: logic   ;
    var done: logic   ;
    var tc  : logic<8>;

    inst harness: test_fp_corner_harness (
        clk   : clk ,
        rst   : rst ,
        o_pass: pass,
        o_done: done,
        o_tc  : tc  ,
    );

    initial {
        rst.assert(clk);
        // ~25 test cases × 80 cycles each = 2000 cycles; use 2200 margin.
        for _i: i32 in 0..2200 {
            clk.next(1);
        }
        $assert (pass, "fp_corner test failed");
        $display("fp_corner test passed");
        $finish ();
    }
}
