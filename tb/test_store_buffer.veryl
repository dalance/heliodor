// Store Buffer unit test.
// Tests: enqueue/drain FIFO, commit gating, exact-match forwarding,
// partial-overlap stall, squash (no mask hit), flush.
module test_store_buffer_harness (
    clk   : input  clock,
    rst   : input  reset,
    o_pass: output logic,
    o_done: output logic,
) {
    var tc: logic<8>;

    always_ff {
        if_reset {
            tc = 8'd0;
        } else {
            tc = tc + 8'd1;
        }
    }

    var enq_valid : logic    ;
    var enq_rob   : logic<5> ;
    var enq_epoch : logic<2> ;
    var enq_addr  : logic<64>;
    var enq_data  : logic<64>;
    var enq_wstrb : logic<8> ;
    var enq_size  : logic<2> ;
    var enq_is_sc : logic    ;
    var enq_is_amo: logic    ;
    var enq_ready : logic    ;

    var commit_valid: logic    ;
    var commit_rob  : logic<5> ;
    var commit_epoch: logic<2> ;

    var drain_valid : logic    ;
    var drain_addr  : logic<64>;
    var drain_data  : logic<64>;
    var drain_wstrb : logic<8> ;
    var drain_size  : logic<2> ;
    var drain_is_sc : logic    ;
    var drain_is_amo: logic    ;
    var drain_rob   : logic<5> ;
    var drain_ready : logic    ;

    var fwd_valid  : logic    ;
    var fwd_addr   : logic<64>;
    var fwd_size   : logic<2> ;
    var fwd_hit    : logic    ;
    var fwd_data   : logic<64>;
    var fwd_partial: logic    ;

    var squash_valid: logic    ;
    var _zero_mask  : logic [32]; // unused: squash test skipped for skeleton

    var flush: logic;

    var count: logic<4>;
    var full : logic   ;
    var empty: logic   ;

    inst dut: store_buffer (
        clk,
        rst,
        i_enq_valid   : enq_valid    ,
        i_enq_rob     : enq_rob      ,
        i_enq_epoch   : enq_epoch    ,
        i_enq_addr    : enq_addr     ,
        i_enq_data    : enq_data     ,
        i_enq_wstrb   : enq_wstrb    ,
        i_enq_size    : enq_size     ,
        i_enq_is_sc   : enq_is_sc    ,
        i_enq_is_amo  : enq_is_amo   ,
        o_enq_ready   : enq_ready    ,
        i_commit_valid: commit_valid ,
        i_commit_rob  : commit_rob   ,
        i_commit_epoch: commit_epoch ,
        o_drain_valid : drain_valid  ,
        o_drain_addr  : drain_addr   ,
        o_drain_data  : drain_data   ,
        o_drain_wstrb : drain_wstrb  ,
        o_drain_size  : drain_size   ,
        o_drain_is_sc : drain_is_sc  ,
        o_drain_is_amo: drain_is_amo ,
        o_drain_rob   : drain_rob    ,
        i_drain_ready : drain_ready  ,
        i_fwd_valid   : fwd_valid    ,
        i_fwd_addr    : fwd_addr     ,
        i_fwd_size    : fwd_size     ,
        o_fwd_hit     : fwd_hit      ,
        o_fwd_data    : fwd_data     ,
        o_fwd_partial : fwd_partial  ,
        i_squash_valid: squash_valid ,
        i_squash_mask : _zero_mask   ,
        i_flush       : flush        ,
        i_inval_valid : 1'b0         ,
        i_inval_addr  : 64'd0        ,
        o_count       : count        ,
        o_full        : full         ,
        o_empty       : empty        ,
    );

    var failed: logic;

    always_comb {
        enq_valid    = 1'b0;
        enq_rob      = 5'd0;
        enq_epoch    = 2'd0;
        enq_addr     = '0;
        enq_data     = '0;
        enq_wstrb    = 8'd0;
        enq_size     = 2'd0;
        enq_is_sc    = 1'b0;
        enq_is_amo   = 1'b0;
        commit_valid = 1'b0;
        commit_rob   = 5'd0;
        commit_epoch = 2'd0;
        drain_ready  = 1'b0;
        fwd_valid    = 1'b0;
        fwd_addr     = '0;
        fwd_size     = 2'd0;
        squash_valid = 1'b0;
        flush        = 1'b0;

        case tc {
            // tc=2: enqueue SD to 0x1000, rob=3
            8'd2: {
                enq_valid = 1'b1;
                enq_rob   = 5'd3;
                enq_addr  = 64'h1000;
                enq_data  = 64'hDEADBEEFCAFEBABE;
                enq_wstrb = 8'hFF;
                enq_size  = 2'd3;
            }
            // tc=3: enqueue SD to 0x2000, rob=4
            8'd3: {
                enq_valid = 1'b1;
                enq_rob   = 5'd4;
                enq_addr  = 64'h2000;
                enq_data  = 64'h1122334455667788;
                enq_wstrb = 8'hFF;
                enq_size  = 2'd3;
            }
            // tc=4: forwarding probe for 0x1000, size=D → full match
            8'd4: {
                fwd_valid = 1'b1;
                fwd_addr  = 64'h1000;
                fwd_size  = 2'd3;
            }
            // tc=5: forwarding probe 0x1000, size=W → partial
            8'd5: {
                fwd_valid = 1'b1;
                fwd_addr  = 64'h1000;
                fwd_size  = 2'd2;
            }
            // tc=6: forwarding probe 0x3000 → miss
            8'd6: {
                fwd_valid = 1'b1;
                fwd_addr  = 64'h3000;
                fwd_size  = 2'd3;
            }
            // tc=7: commit rob=3
            8'd7: {
                commit_valid = 1'b1;
                commit_rob   = 5'd3;
            }
            // tc=8: drain the first entry
            8'd8: {
                drain_ready = 1'b1;
            }
            // tc=9: commit rob=4 (separate from drain to avoid same-cycle race)
            8'd9: {
                commit_valid = 1'b1;
                commit_rob   = 5'd4;
            }
            // tc=10: drain second (after commit registered)
            8'd10: {
                drain_ready  = 1'b1;
            }
            // tc=12: flush while empty → no-op
            8'd12: {
                flush = 1'b1;
            }
            default: {}
        }
    }

    always_ff {
        if_reset {
            failed = 1'b0;
        } else {
            case tc {
                // tc=1: after reset, empty
                8'd1: {
                    if !empty || full {
                        failed = 1'b1;
                    }
                }
                // tc=3: enq rob=3 at tc=2 registered → count=1
                8'd3: {
                    if count != 4'd1 {
                        failed = 1'b1;
                    }
                }
                // tc=4: enq rob=4 at tc=3 registered → count=2
                //       also fwd probe at tc=4 is combinational
                8'd4: {
                    if count != 4'd2 {
                        failed = 1'b1;
                    }
                    if !fwd_hit || fwd_data != 64'hDEADBEEFCAFEBABE {
                        failed = 1'b1;
                    }
                }
                // tc=5: fwd probe size=W → partial
                8'd5: {
                    if !fwd_partial || fwd_hit {
                        failed = 1'b1;
                    }
                }
                // tc=6: fwd probe 0x3000 → miss
                8'd6: {
                    if fwd_hit || fwd_partial {
                        failed = 1'b1;
                    }
                }
                // tc=8: commit rob=3 at tc=7 registered → drain_valid=1
                8'd8: {
                    if !drain_valid || drain_rob != 5'd3 {
                        failed = 1'b1;
                    }
                }
                // tc=9: drain at tc=8 registered → count=1
                8'd9: {
                    if count != 4'd1 {
                        failed = 1'b1;
                    }
                }
                // tc=10: commit rob=4 registered, drain_valid on rob=4
                8'd10: {
                    if !drain_valid || drain_rob != 5'd4 {
                        failed = 1'b1;
                    }
                }
                // tc=11: drain rob=4 registered → empty
                8'd11: {
                    if !empty {
                        failed = 1'b1;
                    }
                }
                // tc=13: flush while empty is a no-op
                8'd13: {
                    if !empty {
                        failed = 1'b1;
                    }
                }
                default: {}
            }
        }
    }

    assign o_pass = !failed;
    assign o_done = tc >: 8'd14;
}

#[test(test_store_buffer)]
module test_store_buffer {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen;

    var pass: logic;
    var done: logic;

    inst harness: test_store_buffer_harness (
        clk    : clk ,
        rst    : rst ,
        o_pass : pass,
        o_done : done,
    );

    initial {
        rst.assert(clk);
        for _i: i32 in 0..18 {
            clk.next(1);
        }
        $assert (pass, "store_buffer test failed");
        $display("store_buffer test passed");
        $finish ();
    }
}
