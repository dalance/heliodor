# MD gate GD: the N=1 debug directed tests (verification plan 9.1), pass/fail
# on W2 and W4. Each entry runs a DMI script (test/debug/dmi, make -C test/debug)
# against a hart program (test/debug/prog).
#   test/gates/gen_core_tests.py --core w2 --no-lockstep test/gates/md_dbg.list
dbg/dmi_selftest hex=test/debug/prog/spin.hex dmi=test/debug/dmi/selftest.hex lockstep=0 budget=20000
dbg/halt_resume hex=test/debug/prog/halt_resume.hex dmi=test/debug/dmi/halt_resume.hex lockstep=0 budget=200000
dbg/dm_abs hex=test/debug/prog/dm_abs.hex dmi=test/debug/dmi/dm_abs.hex lockstep=0 budget=1000000
dbg/dm_progbuf hex=test/debug/prog/dm_progbuf.hex dmi=test/debug/dmi/dm_progbuf.hex lockstep=0 budget=1000000
dbg/dm_step hex=test/debug/prog/dm_step.hex dmi=test/debug/dmi/dm_step.hex lockstep=0 budget=1000000
dbg/dm_counters hex=test/debug/prog/dm_counters.hex dmi=test/debug/dmi/dm_counters.hex lockstep=0 budget=1000000
