# M5 vector gate: the V directed tests of the old core's default suite, run
# pass/fail on the new core in W2 and W4 (the retire record carries the VRF
# write count and hash, so GX compares the two widths).
# Format: <suite>/<name> [budget=<cycles>] [hex=<path>] [tohost=<word index>] [lockstep=0|1]
vec/vadd budget=100000 hex=test/vadd/vadd_test.hex lockstep=0
vec/vmem budget=100000 hex=test/vmem/vmem_test.hex lockstep=0
vec/vwrm budget=100000 hex=test/vwrm/vwrm_test.hex lockstep=0
vec/vidx budget=100000 hex=test/vidx/vidx_test.hex lockstep=0
vec/vperm budget=300000 hex=test/vperm/vperm_test.hex lockstep=0
vec/vstr budget=100000 hex=test/vstr/vstr_test.hex lockstep=0
vec/vsetvl budget=100000 hex=test/vsetvl/vsetvl_test.hex lockstep=0
vec/vseg budget=100000 hex=test/vseg/vseg_test.hex lockstep=0
vec/vmisa budget=100000 hex=test/vmisa/vmisa_test.hex lockstep=0
vec/vleff budget=100000 hex=test/vleff/vleff_test.hex lockstep=0
vec/varith budget=100000 hex=test/varith/varith_test.hex lockstep=0
vec/vcmp budget=100000 hex=test/vcmp/vcmp_test.hex lockstep=0
vec/vmuldiv budget=100000 hex=test/vmuldiv/vmuldiv_test.hex lockstep=0
vec/vlmul budget=100000 hex=test/vlmul/vlmul_test.hex lockstep=0
vec/vlmulc budget=100000 hex=test/vlmulc/vlmulc_test.hex lockstep=0
vec/vlmem budget=100000 hex=test/vlmem/vlmem_test.hex lockstep=0
vec/vwiden budget=100000 hex=test/vwiden/vwiden_test.hex lockstep=0
vec/vnarrow budget=100000 hex=test/vnarrow/vnarrow_test.hex lockstep=0
vec/vwidenw budget=100000 hex=test/vwidenw/vwidenw_test.hex lockstep=0
vec/vfarith budget=100000 hex=test/vfarith/vfarith_test.hex lockstep=0
