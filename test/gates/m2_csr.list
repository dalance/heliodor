rv64mi/lh_misaligned hex=test/riscv-arch-test/build/rv64mi/lh-misaligned.hex
rv64mi/lw_misaligned hex=test/riscv-arch-test/build/rv64mi/lw-misaligned.hex
rv64mi/sd_misaligned hex=test/riscv-arch-test/build/rv64mi/sd-misaligned.hex
rv64mi/sh_misaligned hex=test/riscv-arch-test/build/rv64mi/sh-misaligned.hex
rv64mi/sw_misaligned hex=test/riscv-arch-test/build/rv64mi/sw-misaligned.hex
