# MD gate GD4: the N=4 debug directed tests (verification plan 9.1), pass/fail
# on W2 and W4, run with --ignored. Each entry runs a DMI script
# (test/debug/dmi, make -C test/debug) against a hart program run by every
# hart (test/debug/prog).
#   test/gates/gen_core_tests.py --core w2 --no-lockstep --ignored test/gates/md_dbg4.list
dbg4/dm_smp_select hex=test/debug/prog/dm_smp.hex dmi=test/debug/dmi/dm_smp_select.hex lockstep=0 harts=4 budget=300000
dbg4/dm_smp_group hex=test/debug/prog/dm_smp.hex dmi=test/debug/dmi/dm_smp_group.hex lockstep=0 harts=4 budget=300000
dbg4/dm_smp_stoptime hex=test/debug/prog/dm_smp.hex dmi=test/debug/dmi/dm_smp_stoptime.hex lockstep=0 harts=4 budget=300000
dbg4/dm_smp_sba_coh hex=test/debug/prog/sba_coh4.hex dmi=test/debug/dmi/sba_coh4.hex lockstep=0 harts=4 budget=300000
