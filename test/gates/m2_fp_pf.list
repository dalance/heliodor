# M2 scalar FP self-checking probes, pass/fail on W2 and W4. Each writes
# tohost 1 for the specified behaviour and 0xB000 + n where it shows the old
# core's deviation Bn (verification plan, appendix B), so the golden cannot
# run them in lockstep; the new core must pass every one. b04_frm and
# b26_fs_off_fault print to the UART on every path, and this build faults
# non-cacheable accesses, so they join once IO is served.
# Format: <suite>/<name> [budget=<cycles>] [hex=<path>] [tohost=<word index>]
fprobe/b20_fdiv_fadd budget=200000 hex=test/directed/b20_fdiv_fadd.hex
fprobe/b27_fs_dirty budget=200000 hex=test/directed/b27_fs_dirty.hex
fprobe/b28_fs_off_csr budget=200000 hex=test/directed/b28_fs_off_csr.hex
fprobe/b30_reserved_enc budget=200000 hex=test/directed/b30_reserved_enc.hex
fprobe/b49_fcvt_l_d budget=200000 hex=test/directed/b49_fcvt_l_d.hex
fprobe/b50_fcvt_w_d budget=200000 hex=test/directed/b50_fcvt_w_d.hex
fprobe/b51_fcvt_wu_d budget=200000 hex=test/directed/b51_fcvt_wu_d.hex
fprobe/b52_fcvt_s_d_of budget=200000 hex=test/directed/b52_fcvt_s_d_of.hex
fprobe/b53_fcvt_h_d_tiny budget=200000 hex=test/directed/b53_fcvt_h_d_tiny.hex
fprobe/b54_fcvt_tininess budget=200000 hex=test/directed/b54_fcvt_tininess.hex
