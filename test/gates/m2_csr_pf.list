# M2 privileged-architecture tests run pass/fail only. rv64mi/csr, mcsr and
# ma_fetch read misa, which now names what this build serves (the golden
# model reads another value; ma_fetch then takes another path); rv64mi/illegal
# takes an interrupt, whose position needs the schedule replay. The privd
# tests (Sstc, Zihpm, Sscofpmf, test/priv) are interrupt- or counter-dependent.
rv64mip/csr hex=test/riscv-arch-test/build/rv64mi/csr.hex
rv64mip/mcsr hex=test/riscv-arch-test/build/rv64mi/mcsr.hex
rv64mip/ma_fetch hex=test/riscv-arch-test/build/rv64mi/ma_fetch.hex
rv64mip/illegal hex=test/riscv-arch-test/build/rv64mi/illegal.hex
privd/sstc hex=test/sstc/sstc_test.hex budget=100000
privd/hpm hex=test/hpm/hpm_test.hex budget=100000
privd/sscofpmf hex=test/sscofpmf/sscofpmf_test.hex budget=200000
privd/priv hex=test/priv/priv_test.hex budget=100000
