# M2 self-checking directed probes for the appendix B deviations outside
# FP, pass/fail on W2 and W4. Each writes tohost 1 for the specified
# behaviour and 0xB000 + n where it shows the old core's deviation Bn, so the
# golden cannot run them in lockstep; the new core must pass every one.
# b46_uart reads the device-side UART write count at UART + 0x100 (the SoC's
# UART_WRCNT). Not listed: b39_amo_vle (vector, M5).
# Format: <suite>/<name> [budget=<cycles>] [hex=<path>] [tohost=<word index>]
probe/b03_satp_shadow budget=200000 hex=test/directed/b03_satp_shadow.hex
probe/b05_sc budget=200000 hex=test/directed/b05_sc.hex
probe/b07_ma_pagex budget=200000 hex=test/directed/b07_ma_pagex.hex
probe/b10_amo_vm budget=200000 hex=test/directed/b10_amo_vm.hex
probe/b12_xret_priv budget=200000 hex=test/directed/b12_xret_priv.hex
probe/b13_csrrd budget=200000 hex=test/directed/b13_csrrd.hex
probe/b14_minstret budget=200000 hex=test/directed/b14_minstret.hex
probe/b17_ebreak_tval budget=200000 hex=test/directed/b17_ebreak_tval.hex
probe/b19_straddle budget=200000 hex=test/directed/b19_straddle.hex
probe/b21_pmp_barrier budget=200000 hex=test/directed/b21_pmp_barrier.hex
probe/b22_sfence_refetch budget=200000 hex=test/directed/b22_sfence_refetch.hex
probe/b24_mprv_xret budget=200000 hex=test/directed/b24_mprv_xret.hex
probe/b35_pmp_straddle budget=200000 hex=test/directed/b35_pmp_straddle.hex
probe/b36_amocas_svinval budget=200000 hex=test/directed/b36_amocas_svinval.hex
probe/b46_uart budget=200000 hex=test/directed/b46_uart.hex
