rv64ui_v/slliw
rv64ui_v/sllw
rv64ui_v/slt
rv64ui_v/slti
rv64ui_v/sltiu
rv64ui_v/sltu
rv64ui_v/sra
rv64ui_v/srai
rv64ui_v/sraiw
