rv64ui_v/bge
rv64ui_v/bgeu
rv64ui_v/blt
rv64ui_v/bltu
rv64ui_v/bne
rv64ui_v/fence_i
rv64ui_v/jal
rv64ui_v/jalr
rv64ui_v/lb
rv64ui_v/lbu
rv64ui_v/ld
rv64ui_v/ld_st
rv64ui_v/lh
rv64ui_v/lhu
rv64ui_v/lui
rv64ui_v/lw
rv64ui_v/lwu
rv64ui_v/ma_data
rv64ui_v/or
rv64ui_v/ori
rv64ui_v/sb
rv64ui_v/sd
rv64ui_v/sh
rv64ui_v/simple
rv64ui_v/sll
