# M5 H gate: the H directed tests of the old core's default suite, run
# pass/fail on the new core in W2 and W4 (golden lockstep is not used: the
# golden's V = 1 deviations, appendix B B11, B23, B25 and B40, would diverge;
# GX compares the two widths).
# Format: <suite>/<name> [budget=<cycles>] [hex=<path>] [tohost=<word index>] [lockstep=0|1]
h/htwostage budget=100000 hex=test/htwostage/htwostage_test.hex lockstep=0
h/hvstrap budget=100000 hex=test/hvstrap/hvstrap_test.hex lockstep=0
h/hvirq budget=100000 hex=test/hvirq/hvirq_test.hex lockstep=0
h/hgpf budget=100000 hex=test/hgpf/hgpf_test.hex lockstep=0
h/hgpfns budget=100000 hex=test/hgpfns/hgpfns_test.hex lockstep=0
h/higpf budget=100000 hex=test/higpf/higpf_test.hex lockstep=0
h/hlv budget=100000 hex=test/hlv/hlv_test.hex lockstep=0
h/hvinst budget=100000 hex=test/hvinst/hvinst_test.hex lockstep=0
h/hconf budget=100000 hex=test/hconf/hconf_test.hex lockstep=0
h/hmtval2 budget=100000 hex=test/hmtval2/hmtval2_test.hex lockstep=0
h/hvscsr budget=100000 hex=test/hvscsr/hvscsr_test.hex lockstep=0
h/hvtvm budget=100000 hex=test/hvtvm/hvtvm_test.hex lockstep=0
h/hvsirq budget=100000 hex=test/hvsirq/hvsirq_test.hex lockstep=0
h/hsstc budget=100000 hex=test/hsstc/hsstc_test.hex lockstep=0
h/hmini budget=100000 hex=test/hmini/hmini_test.hex lockstep=0
h/hvtiny budget=100000 hex=test/hvtiny/hvtiny_test.hex lockstep=0
h/hvtmr budget=100000 hex=test/hvtmr/hvtmr_test.hex lockstep=0
