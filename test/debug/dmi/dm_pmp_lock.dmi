# Debug through a locked PMP entry over debug memory on a 1-hart SoC
# (prog/dm_pmp_lock.S): halt, Access Register, the program buffer and resume
# all run from the DM regions, which PMP does not check in Debug Mode, three
# times while the program counts. References: Debug Spec 1.0 section 4.1
# ("spec"), design doc D.8 ("D.8").
SYMS prog/dm_pmp_lock.elf

MARK 1
WR   dmcontrol  0x00000001
WAIT 2000
WR   progbuf0   0x00198993                  # addi s3, s3, 1
WR   progbuf1   0x00100073                  # ebreak

MARK 2                                      # three halts under the lock (D.8)
WR   dmcontrol  0x80000001
POLL dmstatus   0x00000300 0x00000300 2000
WR   dmcontrol  0x00000001
ARDM pmpcfg0    0x00000098 0x000000ff       # still locked
ARD  gp         4          0                # in the loop, past the fault check
ACMD 0x00040000                             # postexec: the program buffer
ARD  s3         1          0
WR   dmcontrol  0x40000001
POLL dmstatus   0x00030000 0x00030000 2000
WAIT 500

MARK 3
WR   dmcontrol  0x80000001
POLL dmstatus   0x00000300 0x00000300 2000
WR   dmcontrol  0x00000001
ACMD 0x00040000
ARD  s3         2          0
WR   dmcontrol  0x40000001
POLL dmstatus   0x00030000 0x00030000 2000
WAIT 500

MARK 4
WR   dmcontrol  0x80000001
POLL dmstatus   0x00000300 0x00000300 2000
WR   dmcontrol  0x00000001
ACMD 0x00040000
ARD  s3         3          0
WR   dmcontrol  0x40000001
POLL dmstatus   0x00030000 0x00030000 2000
END
