# Execute triggers on a 1-hart SoC (prog/dm_trig_exec.S): the trigger CSRs
# from Debug Mode, mcontrol6 match 0-3 and chain with action 1 (enter Debug
# Mode, cause 2, dpc the matching op), a 16-bit op on an odd halfword, a
# 32-bit op carried across a fetch block, the hit bit, and an op on the wrong
# path that does not halt. References: Debug Spec 1.0 sections 5.5 and
# 5.7.2-5.7.4 ("spec"), design doc D.6 and D.14 ("D.6", "D.14").
SYMS prog/dm_trig_exec.elf

MARK 1                                      # trigger CSRs (D.14)
WR   dmcontrol  0x00000001
WAIT 200
WR   dmcontrol  0x80000001
POLL dmstatus   0x00000300 0x00000300 2000
WR   dmcontrol  0x00000001
ARD  tinfo      0x01008048 0                # version 1, types 15, 6, 3
AWR  tselect    1
AWR  tselect    4                           # beyond TRIG_N: ignored (spec WARL)
ARD  tselect    1          0
AWR  tselect    0
ARD  tdata1     0          0xf0000000       # disabled after reset
AWR  tdata1     0x00001044 0x28000000       # type 2 is not supported: disabled, dmode kept
ARD  tdata1     0          0xf8000000
AWR  tdata3     0x00001234
ARD  tdata3     0          0                # no textra (D.6)
AWR  tdata1     0          0
ARD  tdata1     0          0xf0000000

MARK 2                                      # match 0 on a 32-bit op
AWR  a0         0
AWR  tdata2     @eq_tgt
AWR  tdata1     0x00001044 0x68000000       # mcontrol6, dmode, action 1, m, execute
ARD  tdata1     0x00001044 0x68000000
AWR  dpc        @seg_eq
RESHALT
ARD  dpc        @eq_tgt    0                # timing before (spec)
ARDM dcsr       0x00000080 0x000001c0       # cause 2
ARD  a0         1          0
ARD  tdata1     0x00401044 0x68000000       # hit0 (spec)
AWR  tdata1     0x00001044 0x68000000

MARK 3                                      # a 16-bit op on an odd halfword
AWR  a0         0
AWR  tdata2     @rvc_tgt
AWR  dpc        @seg_rvc
RESHALT
ARD  dpc        @rvc_tgt   0
ARD  a0         1          0

MARK 4                                      # a 32-bit op across a fetch block (D.6)
AWR  a0         0
AWR  tdata2     @st_tgt
AWR  dpc        @seg_st
RESHALT
ARD  dpc        @st_tgt    0
ARD  a0         15         0

MARK 5                                      # match 1: the 16-byte NAPOT region
AWR  a0         0
AWR  tdata2     @region+7
AWR  tdata1     0x000010c4 0x68000000
AWR  dpc        @seg_lin
RESHALT
ARD  dpc        @region    0
ARD  a0         4          0

MARK 6                                      # match 2: at or above tdata2
AWR  a0         0
AWR  tdata2     @region+4
AWR  tdata1     0x00001144 0x68000000
AWR  dpc        @seg_lin
RESHALT
ARD  dpc        @region+4  0
ARD  a0         5          0

MARK 7                                      # match 3: below tdata2
AWR  a0         0
AWR  tdata2     @lt_start
AWR  tdata1     0x000011c4 0x68000000
AWR  dpc        @lt_start
RESHALT
ARD  dpc        @lt_dest   0
ARD  a0         1          0

MARK 8                                      # chain: [region+4, region+8) (spec chain)
AWR  a0         0
AWR  tdata2     @region+4
AWR  tdata1     0x00001944 0x68000000       # match 2, chain
AWR  tselect    1
AWR  tdata2     @region+8
AWR  tdata1     0x000011c4 0x68000000       # match 3
AWR  dpc        @seg_lin                    # trigger 1 alone matches seg_lin: no halt
RESHALT
ARD  dpc        @region+4  0
ARD  a0         5          0
ARD  tdata1     0x004011c4 0x68000000       # both triggers of the chain hit
AWR  tdata1     0          0
AWR  tselect    0
ARD  tdata1     0x00401944 0x68000000

MARK 9                                      # the wrong path does not halt (D.6)
AWR  a0         0
AWR  a1         0
AWR  tdata2     @wp_tgt
AWR  tdata1     0x00001044 0x68000000
AWR  dpc        @seg_wp
WR   dmcontrol  0x40000001
POLL dmstatus   0x00030000 0x00030000 4000
WAIT 500
WR   dmcontrol  0x80000001
POLL dmstatus   0x00000300 0x00000300 2000
WR   dmcontrol  0x00000001
ARDM dcsr       0x000000c0 0x000001c0       # cause 3: the haltreq
ARD  a0         0          0
ARD  a1         1          0
ARD  tdata1     0x00001044 0x68000000       # no hit

MARK 10
AWR  tdata1     0          0
AWR  dpc        @done
WR   dmcontrol  0x40000001
POLL dmstatus   0x00030000 0x00030000 4000
END
