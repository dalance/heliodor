# Hart selection on a 4-hart SoC (prog/dm_smp.S): hartsel, hasel and the
# hart array mask, dmstatus over the selected harts, haltsum0, haltreq and
# resumereq on every selected hart, and an abstract command on hartsel alone.
# References: Debug Spec 1.0 sections 3.3 and 3.14 ("spec"), design doc D.12
# ("D.12").
SYMS prog/dm_smp.elf

MARK 1                                      # registers
WR   dmcontrol  0x00000001
WR   dmcontrol  0x03ff0001                  # hartsello all ones: WARL, 2 bits for N = 4 (D.12)
RD   dmcontrol  0x00030001
WR   dmcontrol  0x0000ffc1                  # hartselhi all ones: reads 0
RD   dmcontrol  0x00000001
WR   dmcontrol  0x04000001                  # spec hasel: WARL, the mask is supported
RD   dmcontrol  0x04000001
WR   hawindowsel 0xffffffff                 # one window (D.12)
RD   hawindowsel 0x00000000
WR   hawindow   0xffffffff                  # one bit per hart
RD   hawindow   0x0000000f
RD   dmstatus   0x004c0ca3                  # all four run: allrunning, anyrunning, havereset
WR   dmcontrol  0x14000001                  # ackhavereset on the four (spec)
RD   dmstatus   0x00400ca3
RD   haltsum0   0x00000000
WR   hawindow   0x00000000
RD   dmstatus   0x00400ca3                  # hart 0 alone
WR   sbaddress1 0
WR   sbcs       0x00040000
WR   sbaddress0 @go
WR   sbdata0    1
POLL sbcs       0x00000000 0x00200000 100

MARK 2                                      # haltreq on the mask and hartsel
WAIT 500
WR   hawindow   0x00000004
WR   dmcontrol  0x84010001                  # haltreq, hasel, hartsel 1: harts 1 and 2
POLL dmstatus   0x00000300 0x00000300 2000  # allhalted over {1, 2}
RD   haltsum0   0x00000006                  # spec haltsum0: bit h is hart h
WR   dmcontrol  0x04010001                  # haltreq = 0 on both
RD   dmstatus   0x004003a3
WR   hawindow   0x00000005                  # {0, 1, 2}: mixed
RD   dmstatus   0x004005a3                  # anyhalted, anyrunning, no all*
WR   dmcontrol  0x00030001                  # hasel = 0: the mask no longer counts
RD   dmstatus   0x00400ca3
WR   dmcontrol  0x00020001
RD   dmstatus   0x004003a3
WAIT 300
RD   haltsum0   0x00000006                  # haltreq dropped while halted: they stay halted

MARK 3                                      # a command runs on hartsel only (spec)
WR   hawindow   0x00000006
WR   dmcontrol  0x04020001
ARD  s2         2          0
WR   dmcontrol  0x04010001
ARD  s2         1          0
WR   dmcontrol  0x04030001                  # hart 3 runs: cmderr 4 although the mask holds halted harts
ACMD 0x00321012 4
WR   abstractcs 0x00000700

MARK 4                                      # resumereq on the mask
WR   dmcontrol  0x44010001
POLL dmstatus   0x00030000 0x00030000 4000  # allresumeack over {1, 2}
RD   dmstatus   0x00430ca3
RD   haltsum0   0x00000000

MARK 5                                      # halt all, resume one, then the rest
WR   hawindow   0x0000000f
WR   dmcontrol  0x84000001
POLL haltsum0   0x0000000f 0x0000000f 2000
WR   dmcontrol  0x04000001
RD   dmstatus   0x004103a3                  # anyresumeack: harts 1 and 2 still ack their last resume
WR   dmcontrol  0x40030001                  # resumereq on hart 3 alone
POLL dmstatus   0x00030000 0x00030000 4000
RD   dmstatus   0x00430ca3
RD   haltsum0   0x00000007
WR   hawindow   0x00000007
WR   dmcontrol  0x44000001
POLL dmstatus   0x00030000 0x00030000 4000
RD   haltsum0   0x00000000
WR   hawindow   0x0000000f
WR   dmcontrol  0x04000001
RD   dmstatus   0x00430ca3                  # all four run and acked

MARK 6
WAIT 3000                                   # every hart counts before stop
WR   dmcontrol  0x00000001
WR   sbcs       0x00040000
WR   sbaddress0 @stop
WR   sbdata0    1
POLL sbcs       0x00000000 0x00200000 100
END
