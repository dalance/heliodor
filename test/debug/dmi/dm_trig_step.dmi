# Triggers and single step on a 1-hart SoC (prog/dm_trig_step.S): a step onto
# an op that matches an execute or load trigger enters with cause 2 before
# the op, and an icount trigger that expires on the stepped op wins over the
# step (cause 2, trigger above step). References: Debug Spec 1.0 sections
# 4.9.1 and 5.7 ("spec"), design doc D.5 ("D.5").
SYMS prog/dm_trig_step.elf

MARK 1
WR   dmcontrol  0x00000001
WAIT 200
WR   dmcontrol  0x80000001
POLL dmstatus   0x00000300 0x00000300 2000
WR   dmcontrol  0x00000001
AWR  a0         0
AWR  a1         @data
AWR  a2         0x5a

MARK 2                                      # execute trigger on the stepped op
AWR  tdata2     @seg
AWR  tdata1     0x00001044 0x68000000
AWR  dcsr       0x00008007                  # ebreakm, step
AWR  dpc        @seg
RESHALT
ARD  dpc        @seg       0
ARDM dcsr       0x00000080 0x000001c0       # cause 2 (D.5)
ARD  a0         0          0

MARK 3                                      # no trigger: one op (cause 4)
AWR  tdata1     0          0
RESHALT
ARD  dpc        @seg+4     0
ARDM dcsr       0x00000100 0x000001c0
ARD  a0         1          0

MARK 4                                      # load trigger on the stepped load
AWR  tdata2     @data
AWR  tdata1     0x00001041 0x68000000
RESHALT
ARD  dpc        @seg+4     0
ARDM dcsr       0x00000080 0x000001c0
ARD  a2         0x5a       0

MARK 5                                      # icount 1 expires on the stepped op
AWR  tdata1     0x00000601 0x38000000
RESHALT
ARD  dpc        @seg+8     0
ARDM dcsr       0x00000080 0x000001c0       # trigger before step (spec cause priority)
ARD  a2         0x77       0
ARD  tdata1     0x01000201 0x38000000

MARK 6                                      # the spent icount: a plain step
RESHALT
ARD  dpc        @seg+12    0
ARDM dcsr       0x00000100 0x000001c0
ARD  a0         2          0

MARK 7
AWR  tdata1     0          0
AWR  dcsr       0x00000003
AWR  dpc        @done
WR   dmcontrol  0x40000001
POLL dmstatus   0x00030000 0x00030000 4000
END
