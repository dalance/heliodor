# System Bus Access on a running 1-hart SoC (prog/dm_sba.S): sbcs, every
# access size, sbautoincrement, sbreadonaddr, sbreadondata, the errors and
# sbbusyerror, device registers, and coherence with lines the hart holds
# dirty. References: Debug Spec 1.0 sections 3.10 and 3.14.22-3.14.29
# ("spec"), design doc D.11 ("D.11").
# sbcs: sbversion 1 (0x20000000), sbasize 56 and accesses of 8-64 bits
# (0x70f); sbreadonaddr 0x100000, sbaccess << 17, sbautoincrement 0x10000,
# sbreadondata 0x8000, sberror 0x7000, sbbusy 0x200000, sbbusyerror 0x400000.
SYMS prog/dm_sba.elf

MARK 1
WR   dmcontrol  0x00000001
WAIT 2000                                   # the program has stored src and dst
RD   sbcs       0x2004070f                  # reset: sbaccess 2 (spec)
WR   sbcs       0x001f8000                  # WARL: every writable field
RD   sbcs       0x201f870f
WR   dmcontrol  0x00000000                  # dmactive = 0 resets sbcs
WR   dmcontrol  0x00000001
RD   sbcs       0x2004070f
RD   sbaddress2 0x00000000                  # sbasize 56: sbaddress2/3 and sbdata2/3 absent
RD   sbdata2    0x00000000

MARK 2                                      # reads of a line the hart holds dirty (D.11 recall)
WR   sbaddress1 0
WR   sbcs       0x00160000                  # sbreadonaddr, 64 bits
WR   sbaddress0 @src
POLL sbcs       0x00000000 0x00200000 100
RD   sbcs       0x2016070f
RD   sbdata0    0x89abcdef
RD   sbdata1    0x01234567
RD   sbaddress0 @src                        # no sbautoincrement
WR   sbcs       0x00100000                  # 8 bits
WR   sbaddress0 @src+1
POLL sbcs       0x00000000 0x00200000 100
RD   sbdata0    0x000000cd
RD   sbdata1    0x00000000                  # zero-extended (D.11)
WR   sbcs       0x00120000                  # 16 bits
WR   sbaddress0 @src+10
POLL sbcs       0x00000000 0x00200000 100
RD   sbdata0    0x00007654
WR   sbcs       0x00140000                  # 32 bits
WR   sbaddress0 @src+12
POLL sbcs       0x00000000 0x00200000 100
RD   sbdata0    0xfedcba98

MARK 3                                      # sbautoincrement and sbreadondata (spec)
WR   sbcs       0x00158000                  # sbreadonaddr, 32 bits, autoincrement, sbreadondata
WR   sbaddress0 @src
POLL sbcs       0x00000000 0x00200000 100
RD   sbaddress0 @src+4
RD   sbdata0    0x89abcdef                  # returns the value, then reads src+4
POLL sbcs       0x00000000 0x00200000 100
RD   sbaddress0 @src+8
RD   sbdata0    0x01234567
POLL sbcs       0x00000000 0x00200000 100
RD   sbaddress0 @src+12
RD   sbdata1    0x00000000                  # sbdata1 starts nothing
RD   sbaddress0 @src+12
WR   sbcs       0x00150000                  # sbreadondata off
RD   sbdata0    0x76543210
RD   sbaddress0 @src+12

MARK 4                                      # writes of every size to a dirty line (D.11 recall)
WR   sbcs       0x00060000                  # 64 bits
WR   sbaddress0 @dst
WR   sbdata1    0x11223344
WR   sbdata0    0x55667788                  # starts the write
POLL sbcs       0x00000000 0x00200000 100
RD   sbaddress0 @dst
WR   sbcs       0x00000000                  # 8 bits
WR   sbaddress0 @dst+8
WR   sbdata1    0xffffffff                  # only the access size is written
WR   sbdata0    0xffffffa5
POLL sbcs       0x00000000 0x00200000 100
WR   sbcs       0x00020000                  # 16 bits
WR   sbaddress0 @dst+10
WR   sbdata0    0xffffbeef
POLL sbcs       0x00000000 0x00200000 100
WR   sbcs       0x00040000                  # 32 bits
WR   sbaddress0 @dst+12
WR   sbdata0    0xcafef00d
POLL sbcs       0x00000000 0x00200000 100
WR   sbcs       0x00050000                  # 32 bits, autoincrement
WR   sbaddress0 @dst+16
WR   sbdata0    0x00000001
POLL sbcs       0x00000000 0x00200000 100
WR   sbdata0    0x00000002
POLL sbcs       0x00000000 0x00200000 100
RD   sbaddress0 @dst+24
WR   sbcs       0x00160000                  # read them back
WR   sbaddress0 @dst
POLL sbcs       0x00000000 0x00200000 100
RD   sbdata0    0x55667788
RD   sbdata1    0x11223344
WR   sbaddress0 @dst+8
POLL sbcs       0x00000000 0x00200000 100
RD   sbdata0    0xbeef00a5
RD   sbdata1    0xcafef00d
WR   sbaddress0 @dst+16
POLL sbcs       0x00000000 0x00200000 100
RD   sbdata0    0x00000001
RD   sbdata1    0x00000002

MARK 5                                      # bad address: a hole, both DM regions (D.11: sberror 2)
WR   sbcs       0x00170000                  # sbreadonaddr, 64 bits, autoincrement
WR   sbaddress0 0x00000000
POLL sbcs       0x00000000 0x00200000 100
RD   sbcs       0x2017270f                  # sberror 2
RD   sbaddress0 0x00000000                  # a failed access does not increment
WR   sbaddress0 @src                        # sberror set: the write starts nothing (spec)
RD   sbcs       0x2017270f
RD   sbdata0    0x00000001                  # still the last read's value
WR   sbcs       0x00177000                  # W1C
RD   sbcs       0x2017070f
WR   sbaddress1 0x00000001                   # 0x1_0000_0000: sbaddress1 reaches the hole
WR   sbaddress0 0x00000000
POLL sbcs       0x00000000 0x00200000 100
RD   sbcs       0x2017270f
RD   sbaddress1 0x00000001
WR   sbaddress1 0x00000000
WR   sbcs       0x00167000
WR   sbaddress0 0x00004000                  # the DM code region
POLL sbcs       0x00000000 0x00200000 100
RD   sbcs       0x2016270f
WR   sbcs       0x00067000                  # write to the DM data region
WR   sbaddress0 0x00005000
WR   sbdata0    0x12345678
POLL sbcs       0x00000000 0x00200000 100
RD   sbcs       0x2006270f
WR   sbcs       0x00067000

MARK 6                                      # alignment (sberror 3) and size (sberror 4)
WR   sbcs       0x00140000                  # sbreadonaddr, 32 bits
WR   sbaddress0 @src+2
RD   sbcs       0x2014370f
RD   sbdata0    0x12345678                  # nothing was read; sbdata0 kept the dropped write's value
WR   sbcs       0x00127000                  # 16 bits at an odd address
WR   sbaddress0 @src+1
RD   sbcs       0x2012370f
WR   sbcs       0x00167000                  # 64 bits at a 4-byte boundary
WR   sbaddress0 @src+4
RD   sbcs       0x2016370f
WR   sbcs       0x00087000                  # 128 bits: unsupported (sbaccess128 = 0)
WR   sbaddress0 @dst
WR   sbdata0    0xdeadbeef
RD   sbcs       0x2008470f
WR   sbcs       0x001a7000                  # 5: reserved
WR   sbaddress0 @src
RD   sbcs       0x201a470f
WR   sbcs       0x00167000

MARK 7                                      # sbbusyerror (spec sbcs)
WR   sbaddress0 @src                        # a read takes the AXI latency
WR   sbaddress0 @src+8                      # while busy: sbbusyerror, dropped
RD   sbcs       0x20560000 0xffdff000
POLL sbcs       0x00000000 0x00200000 100
RD   sbcs       0x2056070f
RD   sbaddress0 @src
RD   sbdata0    0x89abcdef                  # the first read finished
WR   sbaddress0 @src+8                      # sbbusyerror set: nothing starts (spec)
RD   sbcs       0x2056070f
RD   sbaddress0 @src+8
RD   sbdata0    0x89abcdef
WR   sbcs       0x00560000                  # W1C
RD   sbcs       0x2016070f
WR   sbaddress0 @src+8                      # a read of src+8 ...
WR   sbdata0    0x00000000                  # ... and a write while it is busy: dropped
POLL sbcs       0x00000000 0x00200000 100
RD   sbcs       0x2056070f
RD   sbdata0    0x76543210                  # the read's value
RD   sbdata1    0xfedcba98
WR   sbcs       0x00560000
WR   sbaddress0 @src+8                      # src+8 kept its value
POLL sbcs       0x00000000 0x00200000 100
RD   sbdata0    0x76543210
RD   sbcs       0x2016070f

MARK 8                                      # devices: CLINT mtime, msip and mtimecmp
WR   sbcs       0x00160000
WR   sbaddress0 0x0200bff8                  # mtime
POLL sbcs       0x00000000 0x00200000 100
RDS  sbdata0    0
WR   sbaddress0 0x0200bff8
POLL sbcs       0x00000000 0x00200000 100
RDNE sbdata0    0                           # mtime advanced
WR   sbcs       0x00060000
WR   sbaddress0 0x02004000                  # mtimecmp of hart 0
WR   sbdata1    0x00000012
WR   sbdata0    0x34567890
POLL sbcs       0x00000000 0x00200000 100
WR   sbcs       0x00160000
WR   sbaddress0 0x02004000
POLL sbcs       0x00000000 0x00200000 100
RD   sbdata0    0x34567890
RD   sbdata1    0x00000012
WR   sbcs       0x00140000
WR   sbaddress0 0x02000000                  # msip of hart 0
POLL sbcs       0x00000000 0x00200000 100
RD   sbdata0    0x00000000
WR   sbcs       0x00040000
WR   sbdata0    0x00000001
POLL sbcs       0x00000000 0x00200000 100
WR   sbcs       0x00140000
WR   sbaddress0 0x02000000
POLL sbcs       0x00000000 0x00200000 100
RD   sbdata0    0x00000001
WR   sbcs       0x00040000
WR   sbdata0    0x00000000
POLL sbcs       0x00000000 0x00200000 100

MARK 9                                      # the spinning hart's dirty counter (D.10, D.11)
WR   sbcs       0x00160000
WR   sbaddress0 @hot
POLL sbcs       0x00000000 0x00200000 100
RDS  sbdata0    1
WAIT 200
WR   sbaddress0 @hot
POLL sbcs       0x00000000 0x00200000 100
RDNE sbdata0    1                           # it kept counting between the two reads
WR   sbcs       0x00040000
WR   sbaddress0 @hot+8
WR   sbdata0    0x00005a5a                  # the flag ends the spin
POLL sbcs       0x00000000 0x00200000 100
RD   sbcs       0x2004070f
END
