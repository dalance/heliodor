# icount triggers with action 1 on a 1-hart SoC (prog/dm_icount.S): the
# count of retired ops, a trap counting as one, the mode bits (M and U), a
# pending written by the debugger, and the hit bit. Entry is cause 2 with dpc
# the next op to run. References: Debug Spec 1.0 section 5.7.13 ("spec"),
# design doc D.5 and D.6 ("D.5", "D.6").
SYMS prog/dm_icount.elf

MARK 1
WR   dmcontrol  0x00000001
WAIT 200
WR   dmcontrol  0x80000001
POLL dmstatus   0x00000300 0x00000300 2000
WR   dmcontrol  0x00000001
AWR  dcsr       0x00008003                  # ebreakm

MARK 2                                      # count 3 in M
AWR  a0         0
AWR  tdata1     0x00000e01 0x38000000       # icount, dmode, count 3, m, action 1
ARD  tdata1     0x00000e01 0x38000000
AWR  dpc        @seg_cnt
RESHALT
ARD  dpc        @seg_cnt+12 0
ARDM dcsr       0x00000080 0x000001c0       # cause 2
ARD  a0         3          0
ARD  tdata1     0x01000201 0x38000000       # hit, count 0, not pending (spec)

MARK 3                                      # count 1
AWR  a0         0
AWR  tdata1     0x00000601 0x38000000
AWR  dpc        @seg_cnt
RESHALT
ARD  dpc        @seg_cnt+4 0
ARD  a0         1          0

MARK 4                                      # a trap counts: entry before the handler
AWR  a0         0
AWR  a1         0
AWR  tdata1     0x00000a01 0x38000000       # count 2
AWR  dpc        @seg_trap
RESHALT
ARD  dpc        @handler   0
ARDM dcsr       0x00000080 0x000001c0
ARD  a0         1          0
ARD  a1         0          0
ARD  mcause     2          0
ARD  mepc       @seg_trap+4 0

MARK 5                                      # U only: M-mode ops do not count
AWR  a0         0
AWR  tdata1     0x00000c41 0x38000000       # count 3, u
AWR  dpc        @seg_cnt
RESHALT
ARD  dpc        @seg_cnt+32 0
ARDM dcsr       0x00000040 0x000001c0       # cause 1: the ebreak
ARD  a0         8          0
ARD  tdata1     0x00000c41 0x38000000

MARK 6                                      # in U-mode
AWR  0x3b0      0xffffffff 0xffffffff       # pmpaddr0: all, NAPOT RWX
AWR  0x3a0      0x0000001f
AWR  a0         0
AWR  dcsr       0x00008000                  # prv U
AWR  dpc        @seg_u
RESHALT
ARD  dpc        @seg_u+12  0
ARDM dcsr       0x00000080 0x000001c3       # cause 2, prv U
ARD  a0         3          0
AWR  dcsr       0x00008003

MARK 7                                      # pending written by the debugger fires first
AWR  a0         0
AWR  tdata1     0x00000301 0x38000000       # count 0, m, pending, action 1
AWR  dpc        @seg_cnt
RESHALT
ARD  dpc        @seg_cnt   0
ARDM dcsr       0x00000080 0x000001c0
ARD  a0         0          0
ARD  tdata1     0x01000201 0x38000000

MARK 8
AWR  tdata1     0          0
AWR  dcsr       0x00000003
AWR  dpc        @done
WR   dmcontrol  0x40000001
POLL dmstatus   0x00030000 0x00030000 4000
END
