# dm_seq self-test against the Debug Module registers of a 1-hart SoC
# (dmcontrol, dmstatus, hartinfo, hart selection, dmactive, the abstract
# command registers). The hart runs prog/spin.S and is never halted
# (dbg/halt_resume halts it). References:
# Debug Spec 1.0 section 3.14 ("spec"), design doc section D ("D").

MARK 1
RD   dmstatus   0x00000083 0x000000ff   # spec dmstatus: version 3 (1.0), authenticated (D.1)
RD   dmcontrol  0x00000000              # spec dmcontrol: dmactive resets to 0
WR   dmcontrol  0x00010000              # dmactive = 0: hartsel is not applied (spec dmactive)
RD   dmcontrol  0x00000000
WR   dmcontrol  0x00000001
RD   dmcontrol  0x00000001
RD   dmstatus   0x00400c83              # spec: the selected hart runs (allrunning, anyrunning)
RD   hartinfo   0x00100000              # D.7: nscratch 1, no memory-mapped data registers
POLL dmstatus   0x00000c00 0x00000c00 4

MARK 2
WR   dmcontrol  0x03ff0001              # spec hartsel: WARL, keeps idx_w(N_HARTS) bits (D.12)
RD   dmcontrol  0x00010001
RD   dmstatus   0x0040c083              # spec: hart 1 does not exist (allnonexistent, anynonexistent)
WR   dmcontrol  0x80010001              # haltreq to the missing hart 1; spec: haltreq reads 0
RD   dmcontrol  0x00010001
WR   dmcontrol  0x40010001              # resumereq to it: nothing happens (spec resumereq)
RD   dmstatus   0x0040c083
WR   dmcontrol  0x00000001
RD   dmstatus   0x00400c83              # hart 0 still runs

MARK 3                                  # abstract command registers, hart running
RD   abstractcs 0x08000002              # D.7: progbufsize 8, datacount 2
RD   dmstatus   0x00400000 0x00400000   # D.7: impebreak
WR   data0      0x12345678
WR   data1      0x9abcdef0
RD   data0      0x12345678
RD   data1      0x9abcdef0
WR   progbuf0   0x00000013
WR   progbuf7   0xfedcba98
RD   progbuf0   0x00000013
RD   progbuf7   0xfedcba98
WR   abstractauto 0xffffffff
RD   abstractauto 0x00ff0003            # spec abstractauto: WARL, 8 progbuf and 2 data bits
WR   abstractauto 0x00000000
WR   command    0x00321008              # read s0 of a running hart: cmderr 4 (spec)
RD   abstractcs 0x08000402
RD   command    0x00000000              # D.7: command reads 0
WR   abstractcs 0x00000400              # spec: W1C
RD   abstractcs 0x08000002
WR   command    0x01000000              # Quick Access: cmderr 2 (D.1)
RD   abstractcs 0x08000202
WR   command    0x00321008              # ignored while cmderr is set (spec)
RD   abstractcs 0x08000202
WR   abstractcs 0x00000700
RD   abstractcs 0x08000002

MARK 4
WR   dmcontrol  0x00010001
WR   dmcontrol  0x00000000              # spec dmactive = 0 resets the DM: hartsel back to 0
RD   dmcontrol  0x00000000
WR   dmcontrol  0x00000001
RD   dmcontrol  0x00000001
RD   data0      0x00000000              # and data, progbuf
RD   progbuf7   0x00000000
WR   dmcontrol  0x00010001 0x3          # D.3: a partial-strobe write is dropped with pslverr
RD   dmcontrol  0x00000001
RD   0x7f       0x00000000              # spec: a nonexistent DM register reads 0
WAIT 5
END
