# Debug Mode with the H extension on a 1-hart SoC (prog/dm_h.S): dret into VS
# and VU (dcsr.prv and dcsr.v) and entries from them (dcsr.v kept, cause and
# prv), dcsr.ebreakvs/ebreakvu, mcontrol6 vs/vu, HLV/HSV matched in the mode
# they access (hstatus.SPVP), MPRV with MPV in Debug Mode under mprven, and a
# load trigger on a vector element (halts with vstart at that element).
# References: Debug Spec 1.0 sections 4.9.1 and 5.7.4 ("spec"), design doc
# D.16 ("D.16"), U39.
SYMS prog/dm_h.elf

MARK 1
WR   dmcontrol  0x00000001
WAIT 300
WR   dmcontrol  0x80000001
POLL dmstatus   0x00000300 0x00000300 2000
WR   dmcontrol  0x00000001
ARD  dpc        @park      0

MARK 2                                      # dret into VS, ebreakvs (spec)
AWR  vsscratch  0x1111
AWR  sscratch   0x2222
AWR  dpc        @seg_rd
AWR  dcsr       0x00020021                  # ebreakvs, v, prv S
RESHALT
ARD  dpc        @seg_rd+4  0
ARDM dcsr       0x00020061 0x000301e3       # cause 1, v, prv S
ARD  a3         0x1111     0                # sscratch read vsscratch: V = 1

MARK 3                                      # haltreq in VS
AWR  dpc        @seg_loop
AWR  dcsr       0x00020021
WR   dmcontrol  0x40000001
POLL dmstatus   0x00030000 0x00030000 2000
WAIT 300
WR   dmcontrol  0x80000001
POLL dmstatus   0x00000300 0x00000300 2000
WR   dmcontrol  0x00000001
ARD  dpc        @seg_loop  0
ARDM dcsr       0x000000e1 0x000001e3       # cause 3, v, prv S

MARK 4                                      # VU, ebreakvu
AWR  a3         5
AWR  dpc        @seg_u
AWR  dcsr       0x00010020                  # ebreakvu, v, prv U
RESHALT
ARD  dpc        @seg_u+4   0
ARDM dcsr       0x00010060 0x000301e3
ARD  a3         6          0

MARK 5                                      # VS without ebreakvs: a breakpoint exception to M
AWR  mcause     0
AWR  mepc       0
AWR  dpc        @seg_u
AWR  dcsr       0x00018021                  # ebreakm, ebreakvu, v, prv S
WR   dmcontrol  0x40000001
POLL dmstatus   0x00030000 0x00030000 2000
WAIT 500
WR   dmcontrol  0x80000001
POLL dmstatus   0x00000300 0x00000300 2000
WR   dmcontrol  0x00000001
ARD  dpc        @hpark     0
ARDM dcsr       0x000000c3 0x000001e3       # cause 3, v 0, prv M
ARD  mcause     3          0
ARD  mepc       @seg_u+4   0
ARD  mtval      @seg_u+4   0
ARDM mstatus    0x00000800 0x00001800       # MPP S
ARDH mstatus    0x000000c0 0x000000c0       # MPV, GVA

MARK 6                                      # mcontrol6 vs and vu (spec)
AWR  tdata2     @seg_u
AWR  tdata1     0x01001004 0x68000000       # mcontrol6, dmode, vs, action 1, execute
AWR  a3         0
AWR  dpc        @seg_u
AWR  dcsr       0x00010020                  # VU: no match
RESHALT
ARD  dpc        @seg_u+4   0
ARDM dcsr       0x00000060 0x000001e3
ARD  a3         1          0
AWR  dpc        @seg_u
AWR  dcsr       0x00020021                  # VS: a match, before the instruction
RESHALT
ARD  dpc        @seg_u     0
ARDM dcsr       0x000000a1 0x000001e3       # cause 2, v, prv S
ARD  a3         1          0
ARD  tdata1     0x01401004 0x68000000       # hit
AWR  tdata1     0x01001004 0x68000000
AWR  dpc        @seg_u
AWR  dcsr       0x00002001                  # HS (s clear): no match
RESHALT
ARD  dpc        @seg_u+4   0
ARDM dcsr       0x00000041 0x000001e3
ARD  a3         2          0
AWR  tdata1     0x00801004 0x68000000       # vu
AWR  dpc        @seg_u
AWR  dcsr       0x00010020
RESHALT
ARD  dpc        @seg_u     0
ARDM dcsr       0x000000a0 0x000001e3       # cause 2, v, prv U
ARD  a3         2          0

MARK 7                                      # HLV/HSV match in the mode they access (D.16)
AWR  hstatus    0x00000100                  # SPVP: VS
AWR  a0         @buf+8
AWR  a2         0x5a5a
AWR  tdata2     @buf+8
AWR  tdata1     0x01001001 0x68000000       # vs, load
AWR  dpc        @seg_hlv
AWR  dcsr       0x00008003                  # ebreakm, prv M
RESHALT
ARD  dpc        @seg_hlv   0
ARDM dcsr       0x00000083 0x000001e3
ARD  a2         0x5a5a     0
AWR  tdata1     0x00001041 0x68000000       # m, load: not the mode of an HLV
AWR  dpc        @seg_hlv
RESHALT
ARD  dpc        @seg_hlv+4 0
ARD  a2         0x11110002 0x11110003
AWR  hstatus    0                           # SPVP: VU
AWR  tdata1     0x01001001 0x68000000       # vs, load: no match
AWR  dpc        @seg_hlv
RESHALT
ARD  dpc        @seg_hlv+4 0
AWR  tdata1     0x00801002 0x68000000       # vu, store
AWR  a1         0xdeadbeef 0xdeadbeef
AWR  dpc        @seg_hsv
RESHALT
ARD  dpc        @seg_hsv   0
ARDM dcsr       0x00000083 0x000001e3
AWR  tdata1     0          0
AWR  dpc        @seg_hlv
RESHALT
ARD  a2         0x11110002 0x11110003       # memory unchanged

MARK 8                                      # MPRV and MPV in Debug Mode (D.16)
AWR  mstatus    0x00020a00 0x00000080       # MPRV, MPP S, MPV, VS Initial
AWR  dcsr       0x00008013                  # mprven
WR   progbuf0   0x00053603                  # ld a2, 0(a0)
WR   progbuf1   0x00100073                  # ebreak
AWR  a2         0
AWR  a0         @buf+0x40000008             # GPA 3 GiB + 8 maps to HPA buf + 8
ACMD 0x00040000
ARD  a2         0x11110002 0x11110003
AWR  dcsr       0x00008003                  # mprven clear: the PA is a hole
ACMD 0x00040000 3
WR   abstractcs 0x00000700
AWR  mstatus    0x00020a00 0x00000000       # MPV clear: S-mode Bare, a hole again
AWR  dcsr       0x00008013
ACMD 0x00040000 3
WR   abstractcs 0x00000700
AWR  mstatus    0x00000200 0x00000000

MARK 9                                      # a load trigger on a vector element (U39)
ARD  0xc20      4          0                # vl
AWR  dcsr       0x00008003
AWR  a0         @vbuf
AWR  tdata2     @vbuf+16
AWR  tdata1     0x00001041 0x68000000       # m, load
AWR  dpc        @seg_vle
RESHALT
ARD  dpc        @seg_vle   0
ARDM dcsr       0x00000083 0x000001e3
ARD  vstart     2          0                # elements 0 and 1 done
AWR  tdata1     0          0
AWR  dpc        @seg_vle
RESHALT
ARD  dpc        @seg_vle+4 0
ARD  vstart     0          0
AWR  a1         @vout
AWR  dpc        @seg_vchk
RESHALT
ARD  a3         0x00000000 0x22220000
ARD  a4         0x00000002 0x22220000
ARD  a5         0x00000003 0x22220000

MARK 10
AWR  dcsr       0x00000003
AWR  dpc        @done
WR   dmcontrol  0x40000001
POLL dmstatus   0x00030000 0x00030000 4000
END
