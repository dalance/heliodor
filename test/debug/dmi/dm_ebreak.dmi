# ebreak from M, S and U on a 1-hart SoC (prog/dm_ebreak.S): with
# dcsr.ebreakm/s/u for the privilege the ebreak enters Debug Mode with cause 1
# and dpc at the ebreak, keeping dcsr.prv; without it the ebreak is a
# breakpoint exception to M (mcause 3, mepc and mtval the ebreak's pc).
# References: Debug Spec 1.0 section 4.9.1 ("spec"), design doc D.4 ("D.4").
SYMS prog/dm_ebreak.elf

MARK 1
WR   dmcontrol  0x00000001
WAIT 300
WR   dmcontrol  0x80000001
POLL dmstatus   0x00000300 0x00000300 2000
WR   dmcontrol  0x00000001
ARD  dpc        @park      0

MARK 2                                      # M: ebreakm (spec)
AWR  dpc        @seg_eb    0
AWR  dcsr       0x00008003                  # ebreakm, prv M
RESHALT
ARD  dpc        @seg_eb    0
ARDM dcsr       0x00008043 0x0000f1c3       # cause 1, prv M (D.4)

MARK 3                                      # S: ebreaks
AWR  dpc        @seg_eb    0
AWR  dcsr       0x00002001                  # ebreaks, prv S
RESHALT
ARD  dpc        @seg_eb    0
ARDM dcsr       0x00002041 0x0000f1c3       # cause 1, prv S

MARK 4                                      # U: ebreaku
AWR  dpc        @seg_eb    0
AWR  dcsr       0x00001000                  # ebreaku, prv U
RESHALT
ARD  dpc        @seg_eb    0
ARDM dcsr       0x00001040 0x0000f1c3       # cause 1, prv U

MARK 5                                      # U without ebreaku: a breakpoint exception
AWR  mcause     0          0
AWR  dpc        @seg_eb    0
AWR  dcsr       0x0000a000                  # ebreakm and ebreaks only, prv U
WR   dmcontrol  0x40000001
POLL dmstatus   0x00030000 0x00030000 2000
WAIT 500
WR   dmcontrol  0x80000001
POLL dmstatus   0x00000300 0x00000300 2000
WR   dmcontrol  0x00000001
ARD  dpc        @hpark     0
ARDM dcsr       0x000000c3 0x000001c3       # cause 3 (haltreq), prv M
ARD  mcause     3          0
ARD  mepc       @seg_eb    0
ARD  mtval      @seg_eb    0

MARK 6                                      # S without ebreaks
AWR  mcause     0          0
AWR  mepc       0          0
AWR  dpc        @seg_eb    0
AWR  dcsr       0x00009001                  # ebreakm and ebreaku only, prv S
WR   dmcontrol  0x40000001
POLL dmstatus   0x00030000 0x00030000 2000
WAIT 500
WR   dmcontrol  0x80000001
POLL dmstatus   0x00000300 0x00000300 2000
WR   dmcontrol  0x00000001
ARD  dpc        @hpark     0
ARD  mcause     3          0
ARD  mepc       @seg_eb    0

MARK 7                                      # M without ebreakm
AWR  mcause     0          0
AWR  mepc       0          0
AWR  dpc        @seg_eb    0
AWR  dcsr       0x00003003                  # ebreaks and ebreaku only, prv M
WR   dmcontrol  0x40000001
POLL dmstatus   0x00030000 0x00030000 2000
WAIT 500
WR   dmcontrol  0x80000001
POLL dmstatus   0x00000300 0x00000300 2000
WR   dmcontrol  0x00000001
ARD  dpc        @hpark     0
ARD  mcause     3          0
ARD  mepc       @seg_eb    0

MARK 8
AWR  dcsr       0x00000003
AWR  dpc        @done      0
WR   dmcontrol  0x40000001
POLL dmstatus   0x00030000 0x00030000 4000
END
