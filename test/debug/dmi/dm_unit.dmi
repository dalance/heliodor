# Halt/resume handshake of dm and dm_mem with a hart model (tb/test_dm.veryl,
# N_HARTS = 2): hart 1 writes HALTED in a loop and RESUMING when it sees its
# RESUME flag, as the debug ROM does. References: Debug Spec 1.0 section 3.14
# ("spec"), design doc section D.7 ("D.7").

WR   dmcontrol  0x00010001                  # select hart 1
POLL dmstatus   0x00000300 0x00000300 200   # D.7: HALTED sets halted (allhalted, anyhalted)
RD   dmstatus   0x00400383                  # spec: halted, no resumeack yet
WR   dmcontrol  0xc0010001                  # resumereq with haltreq: ignored (spec resumereq)
WAIT 20
RD   dmstatus   0x00400383
WR   dmcontrol  0x40010001                  # resumereq: RESUME flag, resumeack cleared (spec)
POLL dmstatus   0x00030000 0x00030000 50    # D.7: RESUMING sets resumeack and clears halted
RD   dmstatus   0x00430c83
WR   dmcontrol  0x00000001                  # hart 0 never halted
RD   dmstatus   0x00400c83
WR   dmcontrol  0x40000001                  # resumereq to running hart 0: no RESUME flag
WAIT 20
RD   dmstatus   0x00400c83
END
