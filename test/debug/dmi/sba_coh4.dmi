# System Bus Access coherence on a running 4-hart SoC (prog/sba_coh4.S): a
# write to a line all four L1s share invalidates every copy, and a read and a
# write of a line another hart holds dirty recall it first, for each of harts
# 1-3. Reference: design doc D.11.
SYMS prog/sba_coh4.elf

MARK 1
WR   dmcontrol  0x00000001
WAIT 3000                                   # all harts spin on shr
WR   sbaddress1 0
WR   sbcs       0x00060000                  # 64 bits
WR   sbaddress0 @shr
WR   sbdata1    0x01234567
WR   sbdata0    0x89abcdef
POLL sbcs       0x00000000 0x00200000 100
RD   sbcs       0x2006070f

MARK 2
WAIT 2000                                   # hart 1 counts in its line
WR   sbcs       0x00160000                  # sbreadonaddr, 64 bits
WR   sbaddress0 @own+64
POLL sbcs       0x00000000 0x00200000 100
RDS  sbdata0    0
WAIT 200
WR   sbaddress0 @own+64
POLL sbcs       0x00000000 0x00200000 100
RDNE sbdata0    0                           # hart 1 kept counting between the reads
WR   sbcs       0x00040000                  # 32 bits
WR   sbaddress0 @own+72
WR   sbdata0    0x00000077                  # the flag ends hart 1's spin
POLL sbcs       0x00000000 0x00200000 100
RD   sbcs       0x2004070f

MARK 3
WAIT 2000                                   # hart 2 counts in its line
WR   sbcs       0x00160000                  # sbreadonaddr, 64 bits
WR   sbaddress0 @own+128
POLL sbcs       0x00000000 0x00200000 100
RDS  sbdata0    0
WAIT 200
WR   sbaddress0 @own+128
POLL sbcs       0x00000000 0x00200000 100
RDNE sbdata0    0                           # hart 2 kept counting between the reads
WR   sbcs       0x00040000                  # 32 bits
WR   sbaddress0 @own+136
WR   sbdata0    0x00000077                  # the flag ends hart 2's spin
POLL sbcs       0x00000000 0x00200000 100
RD   sbcs       0x2004070f

MARK 4
WAIT 2000                                   # hart 3 counts in its line
WR   sbcs       0x00160000                  # sbreadonaddr, 64 bits
WR   sbaddress0 @own+192
POLL sbcs       0x00000000 0x00200000 100
RDS  sbdata0    0
WAIT 200
WR   sbaddress0 @own+192
POLL sbcs       0x00000000 0x00200000 100
RDNE sbdata0    0                           # hart 3 kept counting between the reads
WR   sbcs       0x00040000                  # 32 bits
WR   sbaddress0 @own+200
WR   sbdata0    0x00000077                  # the flag ends hart 3's spin
POLL sbcs       0x00000000 0x00200000 100
RD   sbcs       0x2004070f
END
