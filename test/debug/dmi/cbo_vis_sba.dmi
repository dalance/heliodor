# System Bus Access reads of the lines test/cmo/cbo_vis.S stores (N = 2),
# after the tb's backdoor checks of DRAM: SBA is coherent (design doc D.11),
# so it must see the stored values whether or not the CMOs wrote them back.

MARK 1
WR   dmcontrol  0x00000001
WAIT 35000                                  # the program is done, DRAM checked
WR   sbaddress1 0
WR   sbcs       0x00160000                  # sbreadonaddr, 64 bits
WR   sbaddress0 0x80000800                  # A: hart 0 stored, cbo.clean
POLL sbcs       0x00000000 0x00200000 100
RD   sbdata0    0xa1a1a1a1
RD   sbdata1    0xa1a1a1a1
WR   sbaddress0 0x80000840                  # B: hart 0 stored, cbo.flush
POLL sbcs       0x00000000 0x00200000 100
RD   sbdata0    0xb1b1b1b1
RD   sbdata1    0xb1b1b1b1

MARK 2
WR   sbaddress0 0x800008c0                  # D: hart 1 stored, hart 0 cbo.flush
POLL sbcs       0x00000000 0x00200000 100
RD   sbdata0    0xd1d1d1d1
RD   sbdata1    0xd1d1d1d1
WR   sbaddress0 0x80000900                  # E: hart 1 stored, hart 0 cbo.clean
POLL sbcs       0x00000000 0x00200000 100
RD   sbdata0    0xe1e1e1e1
RD   sbdata1    0xe1e1e1e1
RD   sbcs       0x2016070f                  # no sberror
END
