# dcsr.stoptime on a 4-hart SoC (prog/dm_smp.S): the shared CLINT mtime,
# read through System Bus Access, runs while any hart runs or is halted with
# stoptime = 0, and stops only while every hart is halted with stoptime = 1.
# References: Debug Spec 1.0 section 4.9.1 ("spec"), design doc D.9 ("D.9").
SYMS prog/dm_smp.elf

MARK 1                                      # halt all, stoptime = 1 on each
WR   dmcontrol  0x00000001
WR   sbaddress1 0
WR   sbcs       0x00040000
WR   sbaddress0 @go
WR   sbdata0    1
POLL sbcs       0x00000000 0x00200000 100
WAIT 300
WR   hawindow   0x0000000f
WR   dmcontrol  0x84000001
POLL haltsum0   0x0000000f 0x0000000f 2000
WR   dmcontrol  0x04000001
WR   dmcontrol  0x00000001
AWR  dcsr       0x00000203
WR   dmcontrol  0x00010001
AWR  dcsr       0x00000203
WR   dmcontrol  0x00020001
AWR  dcsr       0x00000203
WR   sbcs       0x00160000                  # sbreadonaddr, 64 bits

MARK 2                                      # three of four with stoptime: mtime runs (D.9)
WR   sbaddress0 0x0200bff8
POLL sbcs       0x00000000 0x00200000 100
RDS  sbdata0    0
WAIT 300
WR   sbaddress0 0x0200bff8
POLL sbcs       0x00000000 0x00200000 100
RDNE sbdata0    0
WR   dmcontrol  0x00030001
AWR  dcsr       0x00000203

MARK 3                                      # all four: mtime stops
WR   sbaddress0 0x0200bff8
POLL sbcs       0x00000000 0x00200000 100
RDS  sbdata0    1
WAIT 300
WR   sbaddress0 0x0200bff8
POLL sbcs       0x00000000 0x00200000 100
RDEQ sbdata0    1

MARK 4                                      # hart 3 runs: mtime runs
WR   dmcontrol  0x40030001
POLL dmstatus   0x00030000 0x00030000 4000
WR   sbaddress0 0x0200bff8
POLL sbcs       0x00000000 0x00200000 100
RDS  sbdata0    1
WAIT 300
WR   sbaddress0 0x0200bff8
POLL sbcs       0x00000000 0x00200000 100
RDNE sbdata0    1
WR   dmcontrol  0x80030001
POLL dmstatus   0x00000300 0x00000300 2000
WR   dmcontrol  0x00030001
WR   sbaddress0 0x0200bff8
POLL sbcs       0x00000000 0x00200000 100
RDS  sbdata0    2
WAIT 300
WR   sbaddress0 0x0200bff8
POLL sbcs       0x00000000 0x00200000 100
RDEQ sbdata0    2

MARK 5                                      # harts 0-2 run, hart 3 halted: mtime runs
WR   hawindow   0x00000007
WR   dmcontrol  0x44000001
POLL dmstatus   0x00030000 0x00030000 4000
WR   sbaddress0 0x0200bff8
POLL sbcs       0x00000000 0x00200000 100
RDS  sbdata0    2
WAIT 300
WR   sbaddress0 0x0200bff8
POLL sbcs       0x00000000 0x00200000 100
RDNE sbdata0    2
WR   dmcontrol  0x40030001
POLL dmstatus   0x00030000 0x00030000 4000

MARK 6
WAIT 3000                                   # every hart counts before stop
WR   dmcontrol  0x00000001
WR   sbcs       0x00040000
WR   sbaddress0 @stop
WR   sbdata0    1
POLL sbcs       0x00000000 0x00200000 100
END
