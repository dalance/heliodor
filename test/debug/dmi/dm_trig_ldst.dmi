# Load and store triggers on a 1-hart SoC (prog/dm_trig_ldst.S), mcontrol6
# with action 1: a match halts before the access with cause 2, leaves rd and
# memory unchanged, and compares every byte of the access. Covers a byte
# inside the access, the load/store select, a line-crossing load matched in
# either half, AMO (load or store), LR, SC, CBO.ZERO (its line), and IO
# accesses that never reach the device. References: Debug Spec 1.0 sections
# 5.5 and 5.7.4 ("spec"), design doc D.6 ("D.6").
SYMS prog/dm_trig_ldst.elf

MARK 1
WR   dmcontrol  0x00000001
WAIT 200
WR   dmcontrol  0x80000001
POLL dmstatus   0x00000300 0x00000300 2000
WR   dmcontrol  0x00000001
AWR  dcsr       0x00008003                  # ebreakm: every sequence ends in Debug Mode

MARK 2                                      # a load at the address
AWR  a0         @buf+8
AWR  a2         0x5a5a
AWR  tdata2     @buf+8
AWR  tdata1     0x00001041 0x68000000       # mcontrol6, dmode, action 1, m, load
AWR  dpc        @seg_lw
RESHALT
ARD  dpc        @seg_lw    0
ARDM dcsr       0x00000080 0x000001c0       # cause 2, before the load (spec)
ARD  a2         0x5a5a     0
ARD  tdata1     0x00401041 0x68000000
AWR  tdata1     0x00001041 0x68000000

MARK 3                                      # a byte inside the access (D.6)
AWR  a0         @buf+16
AWR  tdata2     @buf+18
AWR  dpc        @seg_lw
RESHALT
ARD  dpc        @seg_lw    0
ARD  a2         0x5a5a     0

MARK 4                                      # past the access: no match
AWR  tdata2     @buf+20
AWR  dpc        @seg_lw
RESHALT
ARD  dpc        @seg_lw+4  0
ARDM dcsr       0x00000040 0x000001c0       # cause 1: the ebreak
ARD  a2         0x11110004 0

MARK 5                                      # a store trigger does not match a load
AWR  a2         0x5a5a
AWR  tdata2     @buf+16
AWR  tdata1     0x00001042 0x68000000
AWR  dpc        @seg_lw
RESHALT
ARD  dpc        @seg_lw+4  0
ARD  a2         0x11110004 0

MARK 6                                      # a store: memory unchanged
AWR  a0         @buf+24
AWR  a1         0xdeadbeef
AWR  tdata2     @buf+24
AWR  dpc        @seg_sw
RESHALT
ARD  dpc        @seg_sw    0
ARDM dcsr       0x00000080 0x000001c0
AWR  tdata1     0          0
AWR  dpc        @seg_chk
RESHALT
ARD  a3         0x11110006 0

MARK 7                                      # a line-crossing load (buf+60..67)
AWR  a0         @buf+60
AWR  a2         0x5a5a
AWR  tdata2     @buf+65                     # in the upper line only
AWR  tdata1     0x00001041 0x68000000
AWR  dpc        @seg_ld
RESHALT
ARD  dpc        @seg_ld    0
ARDM dcsr       0x00000080 0x000001c0
ARD  a2         0x5a5a     0
AWR  tdata2     @buf+61                     # in the lower line only
AWR  dpc        @seg_ld
RESHALT
ARD  dpc        @seg_ld    0
ARD  a2         0x5a5a     0
AWR  tdata2     @buf+68                     # past the access
AWR  dpc        @seg_ld
RESHALT
ARD  dpc        @seg_ld+4  0
ARD  a2         0x1111000f 0x11110010

MARK 8                                      # an AMO matches as a load and as a store (D.6)
AWR  a0         @buf+32
AWR  a1         1
AWR  a2         0x5a5a
AWR  tdata2     @buf+32
AWR  dpc        @seg_amo
RESHALT
ARD  dpc        @seg_amo   0
ARD  a2         0x5a5a     0
AWR  tdata1     0x00001042 0x68000000
AWR  dpc        @seg_amo
RESHALT
ARD  dpc        @seg_amo   0
ARD  a2         0x5a5a     0
AWR  tdata1     0          0
AWR  dpc        @seg_chk
RESHALT
ARD  a3         0x11110008 0

MARK 9                                      # LR is a load, SC a store (D.6)
AWR  tdata1     0x00001042 0x68000000
AWR  dpc        @seg_lr
RESHALT
ARD  dpc        @seg_lr+4  0
ARD  a2         0x11110008 0
AWR  a2         0x5a5a
AWR  dpc        @seg_sc
RESHALT
ARD  dpc        @seg_sc    0
ARDM dcsr       0x00000080 0x000001c0
ARD  a2         0x5a5a     0
AWR  tdata1     0x00001041 0x68000000
AWR  dpc        @seg_lr
RESHALT
ARD  dpc        @seg_lr    0
ARD  a2         0x5a5a     0

MARK 10                                     # IO: the device sees nothing
AWR  a0         0x02004000                  # mtimecmp of hart 0
AWR  a1         0
AWR  tdata2     0x02004000
AWR  tdata1     0x00001042 0x68000000
AWR  dpc        @seg_sw
RESHALT
ARD  dpc        @seg_sw    0
AWR  tdata1     0          0
AWR  dpc        @seg_chk
RESHALT
ARD  a3         0xffffffff 0xffffffff
AWR  a0         0x0200bff8                  # mtime
AWR  tdata2     0x0200bff8
AWR  tdata1     0x00001041 0x68000000
AWR  dpc        @seg_lw
RESHALT
ARD  dpc        @seg_lw    0
ARD  a2         0x5a5a     0

MARK 11                                     # CBO.ZERO is a store of its line
AWR  a0         @buf+64
AWR  tdata2     @buf+100
AWR  tdata1     0x00001042 0x68000000
AWR  dpc        @seg_cbz
RESHALT
ARD  dpc        @seg_cbz   0
ARDM dcsr       0x00000080 0x000001c0
AWR  tdata1     0          0
AWR  a0         @buf+100
AWR  dpc        @seg_chk
RESHALT
ARD  a3         0x11110019 0

MARK 12
AWR  dcsr       0x00000003
AWR  dpc        @done
WR   dmcontrol  0x40000001
POLL dmstatus   0x00030000 0x00030000 4000
END
