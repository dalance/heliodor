# Program buffer, postexec, autoexecdata/autoexecprogbuf, a faulting program
# buffer and busy on a halted 1-hart SoC (prog/dm_progbuf.S). References:
# Debug Spec 1.0 sections 3.6, 3.7 and 3.14 ("spec"), design doc D.7 ("D.7").
SYMS prog/dm_progbuf.elf

MARK 1
WR   dmcontrol  0x00000001
WAIT 300
WR   dmcontrol  0x80000001
POLL dmstatus   0x00000300 0x00000300 2000
WR   dmcontrol  0x00000001
WR   progbuf0   0x00150513                  # addi a0, a0, 1
WR   progbuf1   0x00100073                  # ebreak
RD   progbuf0   0x00150513
AWR  a0         5
ACMD 0x00040000                             # postexec only
ARD  a0         6          0
WR   data0      10
WR   data1      0
ACMD 0x0037100a                             # write a0, then postexec (spec order)
ARD  a0         11         0
ACMD 0x0036100a                             # read a0, then postexec
RD   data0      11
ARD  a0         12         0
WR   progbuf1   0x00150513                  # all 8 words: the implicit ebreak ends it (D.7)
WR   progbuf2   0x00150513
WR   progbuf3   0x00150513
WR   progbuf4   0x00150513
WR   progbuf5   0x00150513
WR   progbuf6   0x00150513
WR   progbuf7   0x00150513
ACMD 0x00040000
ARD  a0         20         0

MARK 2                                      # exceptions (D.7: cmderr 3, no CSR changes)
AWR  mepc       @park      0
AWR  mcause     11         0
WR   progbuf0   0x00000000                  # illegal instruction
ACMD 0x00040000 3
WR   abstractcs 0x00000700
WR   progbuf0   0x00003683                  # ld a3, 0(zero): a hole, access fault
ACMD 0x00040000 3
WR   abstractcs 0x00000700
ARD  mepc       @park      0
ARD  mcause     11         0
ARD  a0         20         0
AWR  s0         100
AWR  s1         200
WR   progbuf0   0x00140413                  # addi s0, s0, 1
WR   progbuf1   0x00148493                  # addi s1, s1, 1
WR   progbuf2   0x00000000                  # then fault
ACMD 0x00040000 3
WR   abstractcs 0x00000700
ARD  s0         101        0                # the exception entry kept the new s0/s1
ARD  s1         201        0

MARK 3                                      # autoexecdata on writes (spec abstractauto)
WR   progbuf0   0x00a5b023                  # sd a0, 0(a1)
WR   progbuf1   0x00858593                  # addi a1, a1, 8
WR   progbuf2   0x00100073                  # ebreak
AWR  a1         @buf       0
WR   data0      0x11111111
WR   data1      0x11111111
ACMD 0x0037100a
WR   abstractauto 0xffffffff
RD   abstractauto 0x00ff0003                # WARL: 8 progbuf bits, 2 data bits
WR   abstractauto 0x00000001
WR   data1      0x22222222                  # data1 does not autoexec
RD   abstractcs 0x08000002
WR   data0      0x22222222
POLL abstractcs 0x00000000 0x00001000 4000
WR   data1      0x33333333
WR   data0      0x33333333
POLL abstractcs 0x00000000 0x00001000 4000
WR   abstractauto 0
RD   abstractcs 0x08000002
ARD  a1         @buf+24    0

MARK 4                                      # autoexecdata on reads
WR   progbuf0   0x0005b503                  # ld a0, 0(a1)
AWR  a1         @buf       0
ACMD 0x00040000
ACMD 0x0036100a
WR   abstractauto 0x00000001
RD   data0      0x11111111                  # the read returns, then reruns the command
POLL abstractcs 0x00000000 0x00001000 4000
RD   data0      0x22222222
POLL abstractcs 0x00000000 0x00001000 4000
WR   abstractauto 0
RD   data0      0x33333333
RD   abstractcs 0x08000002

MARK 5                                      # autoexecprogbuf
AWR  a2         0
WR   progbuf1   0x00100073
ACMD 0x00040000                             # command = postexec only (runs ld once more)
WR   abstractauto 0x00010000
WR   progbuf0   0x00160613                  # addi a2, a2, 1; the write autoexecs
POLL abstractcs 0x00000000 0x00001000 4000
RD   progbuf0   0x00160613                  # so does a read
POLL abstractcs 0x00000000 0x00001000 4000
WR   progbuf1   0x00100073                  # progbuf1 does not autoexec
WR   abstractauto 0
RD   abstractcs 0x08000002
ARD  a2         2          0

MARK 6                                      # busy (spec cmderr 1)
WR   progbuf0   0x06400713                  # li a4, 100
WR   progbuf1   0xfff70713                  # 1: addi a4, a4, -1
WR   progbuf2   0xfe071ee3                  # bnez a4, 1b
WR   progbuf3   0x00100073
WR   command    0x00040000
RD   abstractcs 0x08001002                  # busy
RD   data0      0x00000000 0x00000000       # a data access while busy
RD   abstractcs 0x08001102
WR   data0      0x00000055                  # dropped
WR   command    0x0036100a                  # dropped
WR   abstractcs 0x00000700                  # dropped while busy
POLL abstractcs 0x00000000 0x00001000 4000
RD   abstractcs 0x08000102                  # cmderr 1 is sticky
WR   abstractcs 0x00000700
RD   abstractcs 0x08000002
RD   data0      0x00000002                  # the last ARD's value: the busy write was dropped
ARD  a4         0          0

MARK 7
AWR  dpc        @done      0
WR   dmcontrol  0x40000001
POLL dmstatus   0x00030000 0x00030000 4000
END
