# Halt and resume groups on a 4-hart SoC (prog/dm_smp.S): harts 0 and 1 in
# halt group 1, harts 2 and 3 in halt group 2 and resume group 1. A halt of
# one member, by haltreq or by an execute trigger, halts the others with
# cause 3; a resumereq on one member of a resume group resumes the others;
# group 0 is no group. References: Debug Spec 1.0 sections 3.6 and 3.14.29
# ("spec"), design doc D.4 and D.12 ("D.4", "D.12").
SYMS prog/dm_smp.elf

MARK 1                                      # dmcs2 (spec)
WR   dmcontrol  0x00000001
RD   dmcs2      0x00000000
WR   hawindow   0x00000003
WR   dmcontrol  0x04000001
WR   dmcs2      0x00000006                  # hgwrite: halt group 1 for {0, 1}
WR   hawindow   0x0000000c
WR   dmcontrol  0x04020001
WR   dmcs2      0x0000000a                  # halt group 2 for {2, 3}
WR   dmcs2      0x00000806                  # resume group 1 for {2, 3}
RD   dmcs2      0x00000804                  # group of hartsel; hgwrite reads 0
WR   dmcs2      0x0000081a                  # group 6 > N_HARTS: no change (D.12)
RD   dmcs2      0x00000804
WR   dmcs2      0x00000807                  # hgselect = 1: no external triggers, ignored
RD   dmcs2      0x00000804
WR   dmcontrol  0x00000001
WR   dmcs2      0x00000000                  # grouptype 0: halt groups
RD   dmcs2      0x00000004
WR   dmcontrol  0x00030001
RD   dmcs2      0x00000008
WR   dmcs2      0x00000800
RD   dmcs2      0x00000804
WR   dmcontrol  0x00010001
RD   dmcs2      0x00000800                  # hart 1 is in resume group 0
WR   dmcs2      0x00000000

MARK 2                                      # haltreq on hart 2 halts hart 3 (spec)
WR   dmcontrol  0x80020001
POLL haltsum0   0x0000000c 0x0000000f 2000
WAIT 300
RD   haltsum0   0x0000000c                  # group 1 runs on
WR   dmcontrol  0x00020001
ARDM dcsr       0x000000c0 0x000001c0       # cause 3
WR   dmcontrol  0x00030001
RD   dmstatus   0x00400383
ARDM dcsr       0x000000c0 0x000001c0       # halt group: cause 3 (D.4)

MARK 3                                      # resume group: resumereq on hart 2 resumes hart 3
WR   dmcontrol  0x00020001
AWR  tselect    0
AWR  tdata2     @tpoint
AWR  tdata1     0x00001044 0x68000000       # execute trigger on hart 2 at tpoint, action 1
WR   dmcontrol  0x40020001
POLL dmstatus   0x00030000 0x00030000 4000
WR   dmcontrol  0x00030001
POLL dmstatus   0x00030000 0x00030000 4000  # hart 3 resumed and acked
RD   haltsum0   0x00000000

MARK 4                                      # a trigger on hart 2 halts hart 3
WR   sbaddress1 0
WR   sbcs       0x00040000
WR   sbaddress0 @go
WR   sbdata0    1
POLL sbcs       0x00000000 0x00200000 100
POLL haltsum0   0x0000000c 0x0000000f 2000
WAIT 300
RD   haltsum0   0x0000000c
WR   dmcontrol  0x00020001
ARD  dpc        @tpoint    0
ARDM dcsr       0x00000080 0x000001c0       # cause 2
AWR  tdata1     0          0
WR   dmcontrol  0x00030001
ARDM dcsr       0x000000c0 0x000001c0       # cause 3

MARK 5                                      # halt group 1; harts 0 and 1 share no resume group
WR   dmcontrol  0x80010001
POLL haltsum0   0x0000000f 0x0000000f 2000
WR   dmcontrol  0x00010001
WR   dmcontrol  0x40000001
POLL dmstatus   0x00030000 0x00030000 4000
WAIT 300
RD   haltsum0   0x0000000e

MARK 6                                      # resumereq on {1, 2} also resumes hart 3
WR   hawindow   0x00000006
WR   dmcontrol  0x44010001
POLL dmstatus   0x00030000 0x00030000 4000
WR   dmcontrol  0x00030001
POLL dmstatus   0x00030000 0x00030000 4000
RD   haltsum0   0x00000000

MARK 7                                      # group 0 is no group (spec)
WR   dmcs2      0x00000002                  # hart 3 to halt group 0
WR   dmcontrol  0x80020001
POLL haltsum0   0x00000004 0x0000000f 2000
WAIT 300
RD   haltsum0   0x00000004
WR   dmcontrol  0x40020001                  # hart 3 is still in resume group 1 but running
POLL dmstatus   0x00030000 0x00030000 4000
RD   haltsum0   0x00000000

MARK 8
WAIT 3000                                   # every hart counts before stop
WR   dmcontrol  0x00000001
WR   sbcs       0x00040000
WR   sbaddress0 @stop
WR   sbdata0    1
POLL sbcs       0x00000000 0x00200000 100
END
