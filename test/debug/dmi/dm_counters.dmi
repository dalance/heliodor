# dcsr.stopcount and dcsr.stoptime on a halted 1-hart SoC
# (prog/dm_counters.S): with N = 1 the SoC's AND of the harts' stoptime stops
# the shared mtime. References: Debug Spec 1.0 section 4.9.1 ("spec"),
# design doc D.9 ("D.9").
SYMS prog/dm_counters.elf

MARK 1
WR   dmcontrol  0x00000001
WAIT 200
WR   dmcontrol  0x80000001
POLL dmstatus   0x00000300 0x00000300 2000
WR   dmcontrol  0x00000001
WR   progbuf0   0x0200c537                  # lui a0, 0x200c
WR   progbuf1   0xff853503                  # ld a0, -8(a0): the CLINT mtime
WR   progbuf2   0x00100073

MARK 2                                      # stopcount = 0: the counters run
ARDS mcycle     0
WAIT 300
ARDNE mcycle    0
ARDS minstret   1
WAIT 300
ARDNE minstret  1

MARK 3                                      # stopcount = 1 (spec, D.9)
AWR  dcsr       0x00000403
ARDS mcycle     0
WAIT 300
ARDEQ mcycle    0
ARDS minstret   1
WAIT 300
ARDEQ minstret  1

MARK 4                                      # stoptime = 0: mtime runs
ARDS time       2
WAIT 300
ARDNE time      2
ACMD 0x00040000
ARDS a0         3
WAIT 300
ACMD 0x00040000
ARDNE a0        3

MARK 5                                      # stoptime = 1 (D.9: N = 1 stops mtime)
AWR  dcsr       0x00000603
ARDS time       2
WAIT 300
ARDEQ time      2
ACMD 0x00040000
ARDS a0         3
WAIT 300
ACMD 0x00040000
ARDEQ a0        3
ARDEQ time      3                           # the CSR and the CLINT agree

MARK 6
AWR  dpc        @done      0                # the program checks mtime runs again
WR   dmcontrol  0x40000001
POLL dmstatus   0x00030000 0x00030000 4000
END
