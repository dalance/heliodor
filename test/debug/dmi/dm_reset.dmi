# Resets of a 1-hart SoC (prog/dm_reset.S): havereset and ackhavereset,
# ndmreset (the platform drains its AXI port first, the DM and DRAM keep
# their state, an SBA access survives it), resethaltreq (the hart halts
# before its first instruction), hartreset (latched, held while 1, the
# D-cache keeps its lines) and dmactive = 0. References: Debug Spec 1.0
# sections 3.2, 3.14.1 and 3.14.2 ("spec"), design doc D.13 ("D.13").
# dmcontrol: ndmreset 0x2, clrresethaltreq 0x4, setresethaltreq 0x8,
# ackhavereset 0x10000000, hartreset 0x20000000. dmstatus: hasresethaltreq
# 0x20, any/allunavail 0x3000, any/allhavereset 0xc0000.
# sbcs: sbaccess 3 is 0x60000, sbreadonaddr 0x100000, sbbusy 0x200000.
SYMS prog/dm_reset.elf

MARK 1                                      # power-on havereset (spec)
WR   dmcontrol  0x00000001
RD   dmstatus   0x004c0ca3                  # running, havereset from power-on (D.13)
WR   dmcontrol  0x10000001                  # ackhavereset
RD   dmstatus   0x00400ca3
WR   dmcontrol  0x00000009                  # setresethaltreq: write-only, reads 0
RD   dmcontrol  0x00000001
WAIT 2000                                   # boots = 1

MARK 2                                      # ndmreset right after an SBA write (D.13)
WR   sbaddress1 0
WR   sbcs       0x00060000
WR   sbaddress0 @keep
WR   sbdata1    0x0badc0de
WR   sbdata0    0x600df00d                  # the write starts
WR   data0      0x0000cafe
WR   progbuf0   0x12345678
WR   dmcontrol  0x00000003                  # ndmreset
RD   dmcontrol  0x00000003                  # reads back (spec)
POLL dmstatus   0x00003000 0x00003000 200   # held in reset: unavailable
RD   dmstatus   0x004c30a3                  # neither halted nor running, havereset
RD   data0      0x0000cafe                  # the DM keeps its state (spec ndmreset)
RD   progbuf0   0x12345678
WR   dmcontrol  0x00000001                  # release
POLL dmstatus   0x00000300 0x00000300 2000  # resethaltreq: halted
RD   dmstatus   0x004c03a3
ARD  dpc        @_start 0                   # before the first instruction (D.13)
ARDM dcsr       0x000000c0 0x000001c0       # cause 3 (D.4)
WR   sbcs       0x00160000
WR   sbaddress0 @keep
POLL sbcs       0x00000000 0x00200000 300
RD   sbdata0    0x600df00d                  # the drain sent the write to DRAM
RD   sbdata1    0x0badc0de

MARK 3                                      # SBA accesses across ndmreset (D.13)
WR   sbcs       0x00060000
WR   dmcontrol  0x00000003
POLL dmstatus   0x00003000 0x00003000 200
WR   sbdata1    0x11111111
WR   sbdata0    0x22222222                  # a write starts while the platform is in reset
WAIT 50
RD   sbcs       0x2026070f                  # sbbusy: held off until the release
WR   dmcontrol  0x00000001
POLL sbcs       0x00000000 0x00200000 300
WR   sbcs       0x00160000
WR   dmcontrol  0x00000003
POLL dmstatus   0x00003000 0x00003000 200
WR   sbaddress0 @keep                       # a read starts in reset
WAIT 50
RD   sbcs       0x2036070f
WR   dmcontrol  0x00000001
POLL sbcs       0x00000000 0x00200000 300
RD   sbdata0    0x22222222
RD   sbdata1    0x11111111
WR   sbaddress0 @boots                      # a read just before ndmreset
WR   dmcontrol  0x00000003
WR   dmcontrol  0x00000001
POLL sbcs       0x00000000 0x00200000 300
RD   sbcs       0x2016070f                  # no sberror
POLL dmstatus   0x00000300 0x00000300 2000
RD   dmstatus   0x004c03a3
WR   sbcs       0x00060000
WR   dmcontrol  0x00000003
POLL dmstatus   0x00003000 0x00003000 200
WR   sbaddress0 0x02004000                  # CLINT mtimecmp
WR   sbdata1    0
WR   sbdata0    0x00001234                  # a device write is held off, not lost to the reset
WR   dmcontrol  0x00000001
POLL sbcs       0x00000000 0x00200000 300
WR   sbcs       0x00160000
WR   sbaddress0 0x02004000
POLL sbcs       0x00000000 0x00200000 300
RD   sbdata0    0x00001234
POLL dmstatus   0x00000300 0x00000300 2000

MARK 4                                      # hartreset of the halted hart (D.13)
WR   sbcs       0x00060000
WR   sbaddress0 @boots
WR   sbdata1    0
WR   sbdata0    5
POLL sbcs       0x00000000 0x00200000 300
WR   dmcontrol  0x10000001
RD   dmstatus   0x004003a3
WR   dmcontrol  0x20000001                  # hartreset
RD   dmcontrol  0x20000001                  # reads back: supported (spec)
POLL dmstatus   0x00003000 0x00003000 2000  # quiesced and in reset
RD   dmstatus   0x004c30a3
WAIT 100
RD   dmstatus   0x004c30a3                  # held while hartreset is 1
WR   dmcontrol  0x00000001
POLL dmstatus   0x00000300 0x00000300 2000  # resethaltreq: halted again
ARD  dpc        @_start 0
WR   dmcontrol  0x10000005                  # ackhavereset, clrresethaltreq
RD   dmstatus   0x004003a3
WR   dmcontrol  0x40000001
POLL dmstatus   0x00030000 0x00030000 2000
WAIT 1000
WR   sbcs       0x00160000
WR   sbaddress0 @boots
POLL sbcs       0x00000000 0x00200000 300
RD   sbdata0    0x00000006                  # one start since the SBA write

MARK 5                                      # hartreset pulses (D.13)
WR   dmcontrol  0x80000001
POLL dmstatus   0x00000300 0x00000300 2000
WR   dmcontrol  0x20000001                  # hartreset of the halted hart
WR   dmcontrol  0x00000001                  # latched: the reset still happens once
POLL dmstatus   0x00040000 0x00040000 2000
POLL dmstatus   0x00000c00 0x00000c00 2000
RD   dmstatus   0x004f0ca3                  # runs (no resethaltreq); resumeack stays
WAIT 1000                                   # boots = 7, dirty in the D-cache
WR   dmcontrol  0x10000001
WR   dmcontrol  0x20000001                  # a pulse on the running hart: it quiesces after its miss
WR   dmcontrol  0x00000001
POLL dmstatus   0x00040000 0x00040000 2000
POLL dmstatus   0x00000c00 0x00000c00 2000
WAIT 1000
WR   sbaddress0 @boots
POLL sbcs       0x00000000 0x00200000 300
RD   sbdata0    0x00000008                  # the dirty line survived in the D-cache (U32)
WR   dmcontrol  0x10000001
RD   dmstatus   0x00430ca3

MARK 6                                      # ndmreset pulse on the running hart
WR   dmcontrol  0x00000003
WR   dmcontrol  0x00000001                  # latched like hartreset
POLL dmstatus   0x00040000 0x00040000 2000
POLL dmstatus   0x00000c00 0x00000c00 2000
RD   dmstatus   0x004f0ca3

MARK 7                                      # dmactive = 0 (spec dmactive)
WR   dmcontrol  0x0000000b                  # setresethaltreq, ndmreset
POLL dmstatus   0x00003000 0x00003000 200
WR   dmcontrol  0x00000000                  # releases ndmreset, clears resethaltreq
WR   dmcontrol  0x00000001
RD   dmcontrol  0x00000001
POLL dmstatus   0x00000c00 0x00000c00 2000  # runs: resethaltreq was cleared
RD   dmstatus   0x004c0ca3                  # dmactive = 0 keeps havereset

MARK 8
WAIT 1000
WR   sbcs       0x00060000
WR   sbaddress0 @phase
WR   sbdata1    0
WR   sbdata0    9                           # the program writes tohost = 1
POLL sbcs       0x00000000 0x00200000 300
WAIT 2000
END
