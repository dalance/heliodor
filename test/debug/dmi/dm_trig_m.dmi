# Triggers from M-mode software on a 1-hart SoC (prog/dm_trig_m.S): the
# script gives trigger 1 to Debug Mode (dmode 1) and lets the program run its
# checks of dmode, action 0, the mstatus.MIE reentrancy rule and icount; the program ends in an
# ebreak. References: Debug Spec 1.0 sections 5.4 and 5.7 ("spec"), design
# doc D.6 ("D.6").
SYMS prog/dm_trig_m.elf

MARK 1
WR   dmcontrol  0x00000001
WAIT 200
WR   dmcontrol  0x80000001
POLL dmstatus   0x00000300 0x00000300 2000
WR   dmcontrol  0x00000001
AWR  dcsr       0x00008003                  # ebreakm
AWR  tselect    1
AWR  tdata2     0x00001234
AWR  tdata1     0x00001044 0x68000000       # dmode: written only in Debug Mode (spec)
AWR  tselect    0
AWR  s9         1
WR   dmcontrol  0x40000001
POLL dmstatus   0x00030000 0x00030000 4000

MARK 2                                      # the program's checks passed
POLL dmstatus   0x00000300 0x00000300 400000
ARD  dpc        @fin       0
ARDM dcsr       0x00000040 0x000001c0
ARD  gp         13         0

MARK 3
AWR  dcsr       0x00000003
AWR  dpc        @done
WR   dmcontrol  0x40000001
POLL dmstatus   0x00030000 0x00030000 4000
END
