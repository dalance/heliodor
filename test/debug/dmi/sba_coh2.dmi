# System Bus Access coherence on a running 2-hart SoC (prog/sba_coh2.S): a
# write to a line both L1s share invalidates both copies, and a read and a
# write of a line another hart holds dirty recall it first. Reference:
# design doc D.11.
SYMS prog/sba_coh2.elf

MARK 1
WR   dmcontrol  0x00000001
WAIT 3000                                   # both harts spin on shr
WR   sbaddress1 0
WR   sbcs       0x00060000                  # 64 bits
WR   sbaddress0 @shr
WR   sbdata1    0x01234567
WR   sbdata0    0x89abcdef
POLL sbcs       0x00000000 0x00200000 100
RD   sbcs       0x2006070f

MARK 2
WAIT 2000                                   # hart 1 counts in own
WR   sbcs       0x00160000                  # sbreadonaddr, 64 bits
WR   sbaddress0 @own
POLL sbcs       0x00000000 0x00200000 100
RDS  sbdata0    0
WAIT 200
WR   sbaddress0 @own
POLL sbcs       0x00000000 0x00200000 100
RDNE sbdata0    0                           # hart 1 kept counting between the reads
WR   sbcs       0x00040000                  # 32 bits
WR   sbaddress0 @own+8
WR   sbdata0    0x00000077                  # the flag ends hart 1's spin
POLL sbcs       0x00000000 0x00200000 100
RD   sbcs       0x2004070f
END
