# Code written through System Bus Access on a halted 1-hart SoC
# (prog/dm_sba_code.S): func is rewritten and a software breakpoint is set
# and removed the way a debugger does it, with the hart resumed between.
# The new code runs only because the resume path executes fence.i (D.10).
# References: Debug Spec 1.0 sections 3.10 and 4.8.1 ("spec"), design doc
# D.7, D.10 and D.11.
SYMS prog/dm_sba_code.elf

MARK 1
WR   dmcontrol  0x00000001
WAIT 1000                                   # func ran once and is in the I-cache
WR   dmcontrol  0x80000001
POLL dmstatus   0x00000300 0x00000300 2000
WR   dmcontrol  0x00000001
ARD  dpc        @park      0

MARK 2                                      # the code as the hart sees it
WR   sbcs       0x00140000                  # sbreadonaddr, 32 bits
WR   sbaddress0 @func
POLL sbcs       0x00000000 0x00200000 100
RD   sbdata0    0x00100513                  # li a0, 1
WR   sbaddress0 @bkpt
POLL sbcs       0x00000000 0x00200000 100
RD   sbdata0    0x00748493                  # addi s1, s1, 7

MARK 3                                      # rewrite func, set a breakpoint
WR   sbcs       0x00040000                  # 32 bits
WR   sbaddress0 @func
WR   sbdata0    0x00200513                  # li a0, 2
POLL sbcs       0x00000000 0x00200000 100
WR   sbaddress0 @bkpt
WR   sbdata0    0x00100073                  # ebreak
POLL sbcs       0x00000000 0x00200000 100
WR   sbcs       0x00140000
WR   sbaddress0 @func
POLL sbcs       0x00000000 0x00200000 100
RD   sbdata0    0x00200513
RD   sbcs       0x2014070f
AWR  dcsr       0x00008003                  # ebreakm, prv M
AWR  dpc        @after     0
RESHALT                                     # runs the new func, then halts at the ebreak
ARD  dpc        @bkpt      0
ARDM dcsr       0x00000040 0x000001c0       # cause 1 (spec dcsr)
ARD  a0         2          0
ARD  s1         0          0

MARK 4                                      # remove the breakpoint and resume
WR   sbcs       0x00040000
WR   sbaddress0 @bkpt
WR   sbdata0    0x00748493
POLL sbcs       0x00000000 0x00200000 100
AWR  dcsr       0x00000003
WR   dmcontrol  0x40000001
POLL dmstatus   0x00030000 0x00030000 4000
RD   sbcs       0x2004070f
END
