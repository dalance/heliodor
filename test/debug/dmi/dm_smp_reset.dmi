# Per-hart reset state on a 4-hart SoC (prog/dm_smp_reset.S): havereset and
# ackhavereset over the selection, resethaltreq per hart across ndmreset,
# hartreset of one hart while the others count on a shared line (U32: the
# reset hart's D-cache keeps answering), and hartreset of the hart array
# mask with dmstatus over a mixed selection. References: Debug Spec 1.0
# sections 3.3, 3.14.1 and 3.14.2 ("spec"), design doc D.12 and D.13
# ("D.12", "D.13"). dmcontrol: ndmreset 0x2, clrresethaltreq 0x4,
# setresethaltreq 0x8, hasel 0x4000000, ackhavereset 0x10000000, hartreset
# 0x20000000. dmstatus: any/allunavail 0x3000, any/allhavereset 0xc0000.
SYMS prog/dm_smp_reset.elf

MARK 1                                      # havereset per hart (D.12, D.13)
WR   dmcontrol  0x00000001
WR   hawindow   0x00000006
WR   dmcontrol  0x14010001                  # ackhavereset on {1, 2}
RD   dmstatus   0x00400ca3
WR   hawindow   0x00000007
WR   dmcontrol  0x04010001                  # {0, 1, 2}: anyhavereset only
RD   dmstatus   0x00440ca3
WR   dmcontrol  0x00030001
RD   dmstatus   0x004c0ca3                  # hart 3 not acknowledged
WR   dmcontrol  0x00020001
RD   dmstatus   0x00400ca3
WR   hawindow   0x0000000f
WR   dmcontrol  0x14000001
RD   dmstatus   0x00400ca3

MARK 2                                      # resethaltreq on {2, 3} across ndmreset
WR   hawindow   0x0000000c
WR   dmcontrol  0x04020009                  # setresethaltreq on the selection
WR   dmcontrol  0x04020003                  # ndmreset resets every hart
POLL dmstatus   0x00003000 0x00003000 200
WR   dmcontrol  0x04020001
POLL dmstatus   0x00000300 0x00000300 3000  # {2, 3} halt before their first instruction
RD   dmstatus   0x004c03a3
RD   haltsum0   0x0000000c                  # harts 0 and 1 run
WR   hawindow   0x00000003
WR   dmcontrol  0x04000001
RD   dmstatus   0x004c0ca3
WR   dmcontrol  0x00020001
ARD  dpc        @_start 0
WR   dmcontrol  0x00030001
ARD  dpc        @_start 0
WR   hawindow   0x0000000f
WR   dmcontrol  0x14000005                  # clrresethaltreq, ackhavereset on all
WR   hawindow   0x0000000c
WR   dmcontrol  0x44020001                  # resume {2, 3}
POLL dmstatus   0x00030000 0x00030000 4000
WR   hawindow   0x0000000f
WR   dmcontrol  0x04000001
RD   dmstatus   0x00410ca3                  # all run; only 2 and 3 acked a resume

MARK 3                                      # hartreset of hart 1 while the others count (U32)
WR   sbaddress1 0
WR   sbcs       0x00060000
WR   sbaddress0 @go
WR   sbdata1    0
WR   sbdata0    1
POLL sbcs       0x00000000 0x00200000 300
WAIT 2000
WR   sbcs       0x00160000
WR   sbaddress0 @boots+64
POLL sbcs       0x00000000 0x00200000 300
RDS  sbdata0    1                           # boots of hart 1
WR   sbaddress0 @boots
POLL sbcs       0x00000000 0x00200000 300
RDS  sbdata0    2                           # boots of hart 0
WR   dmcontrol  0x20010001                  # hartreset of hart 1, held
POLL dmstatus   0x00003000 0x00003000 3000
RD   dmstatus   0x004c30a3
WR   sbaddress0 @shared
POLL sbcs       0x00000000 0x00200000 300
RDS  sbdata0    0
WAIT 500
WR   sbaddress0 @shared
POLL sbcs       0x00000000 0x00200000 300
RDNE sbdata0    0                           # the others keep counting on shared
WR   dmcontrol  0x00010001                  # release
POLL dmstatus   0x00000c00 0x00000c00 3000
RD   dmstatus   0x004c0ca3
WAIT 500
WR   sbaddress0 @boots+64
POLL sbcs       0x00000000 0x00200000 300
RDNE sbdata0    1                           # hart 1 started again
WR   sbaddress0 @boots
POLL sbcs       0x00000000 0x00200000 300
RDEQ sbdata0    2                           # hart 0 did not
WR   dmcontrol  0x10010001
RD   dmstatus   0x00400ca3

MARK 4                                      # hartreset of the mask {2, 3} (D.12)
WR   hawindow   0x0000000c
WR   dmcontrol  0x24020001
POLL dmstatus   0x00003000 0x00003000 3000  # allunavail over {2, 3}
RD   dmcontrol  0x24020001
WR   hawindow   0x00000001                  # selection {0, 2}
RD   dmstatus   0x004514a3                  # anyunavail, anyrunning, anyhavereset, no all*
WR   hawindow   0x0000000c
WR   dmcontrol  0x04020001                  # release {2, 3}
POLL dmstatus   0x00000c00 0x00000c00 3000
RD   dmstatus   0x004f0ca3                  # resumeack survives a reset
WR   dmcontrol  0x14020001
RD   dmstatus   0x00430ca3
WR   hawindow   0x00000003
WR   dmcontrol  0x04000001
RD   dmstatus   0x00400ca3                  # harts 0 and 1: no new havereset

MARK 5
WAIT 2000
WR   dmcontrol  0x00000001
WR   sbcs       0x00060000
WR   sbaddress0 @stop
WR   sbdata1    0
WR   sbdata0    1                           # hart 0 checks shared against the own lines
POLL sbcs       0x00000000 0x00200000 300
END
