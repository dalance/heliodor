# Access Register on a halted 1-hart SoC (prog/dm_abs.S): GPR, FPR and CSR
# round trips at both sizes, s0/s1 (kept in dscratch by the generated
# program), errors and the sticky cmderr. References: Debug Spec 1.0
# sections 3.7.1 and 3.14 ("spec"), design doc D.7 ("D.7").
SYMS prog/dm_abs.elf

MARK 1
WR   dmcontrol  0x00000001
RD   abstractcs 0x08000002                  # D.7: progbufsize 8, datacount 2, not busy
ACMD 0x00321008 4                           # spec cmderr 4: the hart is running
RD   abstractcs 0x08000402
WR   abstractcs 0x00000700                  # spec: cmderr is W1C
RD   abstractcs 0x08000002
WAIT 300
WR   dmcontrol  0x80000001
POLL dmstatus   0x00000300 0x00000300 2000
WR   dmcontrol  0x00000001
ARD  dpc        @park      0                # D.4: dpc of a haltreq is the next pc
ARD  dcsr       0x400000c3 0                # debugver 4, cause 3 (haltreq), prv M

MARK 2                                      # GPRs (spec 3.7.1.1)
ARD  s0         0x89abcdef 0x01234567       # D.7: the hart's s0/s1, not the ROM's
ARD  s1         0x76543210 0x7edcba98
ARD  x0         0          0
AWR  a1         0x55667788 0x11223344
ARD  a1         0x55667788 0x11223344
AWR  s0         0xdeadbeef 0x01234567
ARD  s0         0xdeadbeef 0x01234567
ARD  s1         0x76543210 0x7edcba98
AWR  s1         0xcafef00d 0x89abcdef
ARD  s1         0xcafef00d 0x89abcdef
ARD  s0         0xdeadbeef 0x01234567
AWR  x0         1          1
ARD  x0         0          0
AWR  a2.w       0x80000001                  # size 2
WR   data1      0x00000077
ARD  a2.w       0x80000001 0x00000077       # spec: a 32-bit read leaves data1
ARDM a2         0x80000001 0xffffffff

MARK 3                                      # CSRs
AWR  mscratch   0x13579bdf 0x2468ace0
ARD  mscratch   0x13579bdf 0x2468ace0
ARD  mscratch.w 0x13579bdf
ARD  mhartid    0          0
WR   data0      5
ACMD 0x00330f14 3                           # write mhartid (read-only): exception (D.7)
WR   abstractcs 0x00000700
ACMD 0x003207c0 3                           # a CSR that does not exist
WR   data0      0x00000005                  # cmderr 3 is still set: command ignored (spec)
WR   data1      0
WR   command    0x0033100d                  # write a3
RD   abstractcs 0x08000302
WR   abstractcs 0x00000700
ARD  a3         0x33       0                # a3 was not written
ARD  s0         0xdeadbeef 0x01234567       # the exception entry kept s0/s1 (D.7)
ARD  s1         0xcafef00d 0x89abcdef
AWR  dcsr       0x00008003                  # ebreakm; cause and debugver are read-only
ARD  dcsr       0x400080c3 0
AWR  dcsr       0x00000003
AWR  dpc        @done      0
ARD  dpc        @done      0

MARK 4                                      # FPRs (D.7: FS = Off faults)
ACMD 0x00321025 3                           # read f5
WR   abstractcs 0x00000700
ARD  mstatus    0x00000000 0x0000000a       # the program cleared mstatus; UXL/SXL read 2
AWR  mstatus    0x00002000 0x0000000a       # FS = Initial
AWR  f5         0x89abcdef 0x01234567
ARD  f5         0x89abcdef 0x01234567
AWR  f6.w       0x3f800000
ARD  f6         0x3f800000 0xffffffff       # flw NaN-boxes
ARD  f6.w       0x3f800000
ARD  s0         0xdeadbeef 0x01234567

MARK 5                                      # not supported: cmderr 2 (spec, D.1, D.7)
ACMD 0x00421008 2                           # aarsize 4
WR   abstractcs 0x00000700
ACMD 0x00121008 2                           # aarsize 1
WR   abstractcs 0x00000700
ACMD 0x003a1008 2                           # aarpostincrement
WR   abstractcs 0x00000700
ACMD 0x01000000 2                           # Quick Access
WR   abstractcs 0x00000700
ACMD 0x02000000 2                           # Access Memory
WR   abstractcs 0x00000700
ACMD 0x0032c000 2                           # a register outside GPR/FPR/CSR
WR   abstractcs 0x00000700
ACMD 0x0030c000                             # no transfer, no postexec: regno ignored
WR   data0      0x5a5a5a5a                  # dscratch0/1 hold s0/s1 during a command
WR   data1      0xa5a5a5a5
ACMD 0x003307b2 2                           # write dscratch0
WR   abstractcs 0x00000700
ACMD 0x003307b3 2                           # write dscratch1
WR   abstractcs 0x00000700
ACMD 0x003207b2 2                           # read dscratch0
WR   abstractcs 0x00000700
ACMD 0x003207b3 2                           # read dscratch1
WR   abstractcs 0x00000700
ARD  s0         0xdeadbeef 0x01234567
ARD  s1         0xcafef00d 0x89abcdef

MARK 6
WR   dmcontrol  0x40000001                  # dpc = done: the program checks the writes
POLL dmstatus   0x00030000 0x00030000 4000
END
