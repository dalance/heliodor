# Halt and resume of a 1-hart SoC through the debug ROM, twice, while the hart
# runs prog/halt_resume.S; the program checks that it resumed where it was
# halted and writes tohost = 1. References: Debug Spec 1.0 sections 3.14 and
# 4.5 ("spec"), design doc section D ("D").

MARK 1
WR   dmcontrol  0x00000001
WR   dmcontrol  0x40000001                  # resumereq to a running hart: no resumeack (spec resumereq)
RD   dmstatus   0x00400c83                  # spec: allrunning, anyrunning
WAIT 1000

MARK 2
WR   dmcontrol  0x80000001                  # haltreq (spec), cause 3 (D.4)
POLL dmstatus   0x00000300 0x00000300 2000  # D.7: the ROM wrote HALTED
RD   dmstatus   0x00400383                  # spec: allhalted, anyhalted, no resumeack
WAIT 300
RD   dmstatus   0x00400383                  # haltreq kept high: the hart stays halted (D.4 M4-3)
WR   dmcontrol  0x40000001                  # resumereq, haltreq cleared (spec)
POLL dmstatus   0x00030000 0x00030000 2000  # D.7: the ROM wrote RESUMING before dret
RD   dmstatus   0x00430c83                  # spec: allresumeack, allrunning
WAIT 500
RD   dmstatus   0x00430c83                  # the RESUME flag dropped: no second resume

MARK 3
WR   dmcontrol  0x80000001
POLL dmstatus   0x00000300 0x00000300 2000
RD   dmstatus   0x00430383                  # spec: resumeack stays until the next resumereq
WR   dmcontrol  0x00000001                  # haltreq cleared: still halted (spec haltreq)
WAIT 300
RD   dmstatus   0x00430383
WR   dmcontrol  0x40000001
POLL dmstatus   0x00030000 0x00030000 2000
RD   dmstatus   0x00430c83
END
