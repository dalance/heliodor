# Single step on a 1-hart SoC (prog/dm_step.S): one record per step from a
# group of independent ops, a trapping op, the timer interrupt with stepie 0
# and 1, branch and jumps, WFI, a CSR write, an IO store and load and an
# ebreak; dcsr.cause and dpc are read with Access Register. References:
# Debug Spec 1.0 sections 4.5 and 4.9.1 ("spec"), design doc D.5 ("D.5").
SYMS prog/dm_step.elf

MARK 1
WR   dmcontrol  0x00000001
WAIT 300
WR   dmcontrol  0x80000001
POLL dmstatus   0x00000300 0x00000300 2000
WR   dmcontrol  0x00000001
ARD  dpc        @park      0
ARDM dcsr       0x000000c0 0x000001c0       # cause 3

MARK 2                                      # one record per step (D.5)
AWR  a0         0
AWR  a1         0
AWR  a2         0
AWR  dpc        @seg_alu   0
AWR  dcsr       0x00000007                  # step
RESHALT
ARD  dpc        @seg_alu+4 0
ARDM dcsr       0x00000104 0x000001c4       # cause 4 (spec), step still set
ARD  a0         1          0
ARD  a1         0          0
RESHALT
ARD  dpc        @seg_alu+8 0
ARD  a1         1          0
ARD  a2         0          0

MARK 3                                      # a trapping op stops at the handler (D.5)
AWR  dpc        @seg_trap  0
RESHALT
ARD  dpc        @handler   0
ARDM dcsr       0x00000100 0x000001c0
ARD  mcause     2          0
ARD  mepc       @seg_trap  0

MARK 4                                      # timer interrupt pending, stepie 0 then 1
AWR  mie        0x00000080
AWR  mstatus    0x00000008                  # MIE
AWR  a0         0
AWR  dpc        @seg_irq   0
RESHALT
ARD  dpc        @seg_irq+4 0                # stepie = 0: not taken (spec)
ARD  a0         1          0
ARDM dcsr       0x00000100 0x000001c0
AWR  dcsr       0x00000807                  # stepie
RESHALT
ARD  dpc        @handler   0                # taken: the step ends at the handler (D.5)
ARD  a0         1          0
ARD  mcause     0x00000007 0x80000000
ARD  mepc       @seg_irq+4 0
ARDM dcsr       0x00000100 0x000001c0
AWR  mie        0
AWR  dcsr       0x00000007

MARK 5                                      # branch, jal, jalr
AWR  dpc        @seg_br    0
RESHALT
ARD  dpc        @br_tgt    0
RESHALT
ARD  dpc        @j_tgt     0
ARD  ra         @br_tgt+4  0
RESHALT
ARD  dpc        @br_tgt+4  0

MARK 6                                      # WFI is a no-op: the step ends after it (D.5)
AWR  dpc        @seg_wfi   0
RESHALT
ARD  dpc        @seg_wfi+4 0
ARDM dcsr       0x00000100 0x000001c0

MARK 7                                      # a CSR write
AWR  a0         0x600df00d
AWR  mscratch   0
AWR  dpc        @seg_csr   0
RESHALT
ARD  dpc        @seg_csr+4 0
ARD  mscratch   0x600df00d 0

MARK 8                                      # an IO store, then an IO load
AWR  a0         0x12345678
AWR  a1         0x02004000                  # mtimecmp of hart 0
AWR  a2         0
AWR  dpc        @seg_io    0
RESHALT
ARD  dpc        @seg_io+4  0
ARD  a2         0          0
RESHALT
ARD  dpc        @seg_io+8  0
ARD  a2         0x12345678 0

MARK 9                                      # a stepped ebreak with ebreakm: cause 1 (D.5)
AWR  dcsr       0x00008007
AWR  dpc        @seg_eb    0
RESHALT
ARD  dpc        @seg_eb    0
ARDM dcsr       0x00000040 0x000001c0

MARK 10
AWR  dcsr       0x00000003
AWR  dpc        @done      0
WR   dmcontrol  0x40000001
POLL dmstatus   0x00030000 0x00030000 4000
END
