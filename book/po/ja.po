msgstr "`ST_RET_N` (1 サイクルにリタイアされるストア数)"

#: src/configuration.md:112
msgid "`WALK_W` (rename walk width)"
msgstr "`WALK_W` (リネームウォーク幅)"

#: src/configuration.md:113
msgid "`PREG_W` (physical register index width)"
msgstr "`PREG_W` (物理レジスタインデックス幅)"

#: src/configuration.md:113
