# Pinned prebuilt toolchain components for heliodor.
#
# Single source of truth for `fetch.sh`. Each tool declares the GitHub repo, the
# release tag, and a glob that selects the release asset. Optionally pin a
# sha256 (recommended once known — run `fetch.sh <tool>` once, copy the printed
# digest here, then re-runs are verified).
#
# Platform note: these are Linux x86_64 prebuilts. The riscv-collab GCC archives
# are the **ubuntu-22.04** builds on purpose — they link against glibc 2.34 and
# run on EL9 (glibc 2.34). The ubuntu-24.04 builds need glibc 2.39 and do NOT
# run on EL9. Keep the 22.04 variant when bumping the tag.

# ---- riscv64-unknown-elf (newlib, bare-metal) -------------------------------
# Used by: ACT4, riscv-tests (test/riscv-arch-test), directed tests, bare hex.
# Needs GCC >= 15 (ACT4 framework requirement) and binutils >= 2.38 (RVV `as`).
# The 2026.06.06 nightly ships GCC 16.1.0 + binutils 2.43.
ELF_REPO="riscv-collab/riscv-gnu-toolchain"
ELF_TAG="2026.06.06"
ELF_GLOB="riscv64-elf-ubuntu-22.04-gcc.tar.xz"
ELF_SHA256="231ba19378a27f19724805cf5e8b5917064ea9b89f87d7829009fd514369e2ef"
ELF_STRIP=1          # leading path components to strip on extract (archive has a top "riscv/" dir)

# ---- riscv64-unknown-linux-gnu (glibc) --------------------------------------
# Used by: the Linux kernel + userspace /init build (test/linux).
# Must have binutils >= 2.38 so that:
#   * `ld -shared` builds the vDSO,
#   * Kconfig TOOLCHAIN_HAS_V auto-detects (LD >= 2.38),
#   * RVV `as` is available.
# A single recent linux-gnu toolchain satisfies all of these, replacing the old
# elf-CC + linux-LD-2.37 mix and the TOOLCHAIN_HAS_V LD_VERSION patch.
LINUX_REPO="riscv-collab/riscv-gnu-toolchain"
LINUX_TAG="2026.06.06"
LINUX_GLOB="riscv64-glibc-ubuntu-22.04-gcc.tar.xz"
LINUX_SHA256="8fcc28dd80604cc774ff4934f1ade36c24c93efa234c71042da1bd39620b142e"
LINUX_STRIP=1

# ---- Sail RISC-V reference model (ACT4 golden reference) ---------------------
SAIL_REPO="riscv/sail-riscv"
SAIL_TAG="0.12"
SAIL_GLOB="sail-riscv-Linux-x86_64.tar.gz"
SAIL_SHA256="7cb129d831384ed9dcb47f25f9866254a673834aa692499c87b1d5a91d110c0f"
SAIL_STRIP=1   # archive has a top sail-riscv-Linux-x86_64/ dir → strip to expose bin/

# ---- uv (Python env manager for the ACT4 framework) -------------------------
UV_REPO="astral-sh/uv"
UV_TAG="0.5.18"
UV_GLOB="uv-x86_64-unknown-linux-gnu.tar.gz"
UV_SHA256="1dbaeffc5cfac769f99700c0fc8c4ef4494a339720c6bf8b79367b1acd701b46"
UV_STRIP=1
