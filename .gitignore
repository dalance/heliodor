# Veryl compiler: a local clone, NOT a git submodule (keeps heliodor
# self-contained). Clone veryl-lang/veryl into ./veryl/ to build — see CLAUDE.md
# "Veryl Toolchain".
/veryl/

# Veryl build artifacts
*.sv
*.sv.map
*.f
*.vcd
.build/
dependencies/

# Verilator build outputs
sim/verilator/build_*/
sim/verilator/*.log

# Hand-written Verilator testbenches must override the *.sv ignore above
!sim/verilator/*.sv
# ...except the per-test wrapper regenerated by run_pmp_all.sh (transient)
sim/verilator/tb_act_pmps_gen.sv

# riscv-tests integration: upstream clone is not committed.
# Generated .hex files under build/ ARE committed so that `veryl test`
# can run the arch suites without requiring a riscv64 toolchain.
# Only the intermediate .elf / .bin artifacts are ignored.
test/riscv-arch-test/upstream/
test/riscv-arch-test/build/**/*.elf
test/riscv-arch-test/build/**/*.bin

# Directed tests: the committed .S source + .hex (loaded by the testbench) are
# tracked; the intermediate .elf / .bin assembler artifacts are ignored. One
# pattern for every test/<name>/ directory (Phase 10/11 added many: hlv, hmini,
# hvtiny, zfa, svadu, ... — their .bin/.elf were left untracked before this).
test/*/*.elf
test/*/*.bin

# ACT4 (riscv-arch-test) generated suites: the .hex images are large (~600 KB
# each, hundreds of files) and are regenerated from the off-repo ACT4 framework,
# so they are not committed. See doc + tb/test_act_*.veryl (work-in-progress).
test/hex/act_*.hex

# Prebuilt cross toolchains (fetched by toolchain/fetch.sh). Only the scripts
# and version pins under toolchain/ are committed; the binaries are not.
/toolchain/elf/
/toolchain/linux/
/toolchain/sail/
/toolchain/uv/
/toolchain/.uv-cache/
/toolchain/.bundle/

# ACT4 (test/act): upstream framework clone + generated ELF/bin, and the
# generated per-test Veryl modules. The .hex images are already ignored above.
test/act/upstream/
test/act/build/
tb/test_act_*.veryl

# Linux boot image build (test/linux): kernel source tree + build outputs.
# The committed boot .hex under test/hex/ are the test inputs and stay tracked.
test/linux/src/
test/linux/build/
__pycache__/
